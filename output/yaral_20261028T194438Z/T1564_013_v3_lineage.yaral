/*
  MITRE Technique : T1564.013 - Bind Mounts
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:33:50.990418+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_013_Bind_Mount_From_Service_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the mount binary performing a bind or rbind operation when its parent is a web server, application server, or database service. These services have no legitimate reason to remap filesystem paths. This is consistent with an exploited service overlaying a malicious process's /proc entry with a benign one to hide it from ps and top. The detection pivots on process lineage (unexpected parent to mount) and does not depend on specific mount targets."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.013"
    mitre_technique_name = "Hide Artifacts: Bind Mounts"
    log_prerequisites = "Linux EDR or auditd execve telemetry normalised to UDM PROCESS_LAUNCH with populated parent (principal.process) and child (target.process) file paths and child command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Java or Node.js based deployment and CI agents that mount volumes; database or web service pre-start hooks that bind-mount data directories; container-aware application servers; admin troubleshooting via a service-owned shell."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools, add expected automation accounts to %global_allowed_service_accounts, and remove generic runtimes (java, node) from the parent regex if a client's deployment tooling legitimately runs mount from them. Lineage is evaluated only one level deep: where telemetry does not show the service as the direct parent, pair this rule with a process-ancestry enrichment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/mount$/
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|caddy|php-fpm[0-9.]*|php[0-9.]*|tomcat[0-9]*|catalina|java|node|mysqld|mariadbd|postgres|mongod|redis-server|gunicorn|uwsgi|ruby|perl|python[0-9.]*)$/ nocase
    $proc.target.process.command_line = /(\s-[a-zA-Z]*[BR]\b|\s--r?bind\b|[\s,=]r?bind\b)/
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1564.013")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $mount_command = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
