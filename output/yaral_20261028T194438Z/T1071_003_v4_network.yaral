/*
  MITRE Technique : T1071.003 - Mail Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:08:14.197364+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_003_Linux_Suspicious_Process_External_Mail_Protocol {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux host making an outbound connection to an external address on a mail protocol port (SMTP/SMTPS/submission, POP3/POP3S, IMAP/IMAPS) from a process that is not a mail transfer agent or mail client. The process is either an interpreter or network utility, or it runs from a world-writable staging directory (/tmp, /var/tmp, /dev/shm, /run/user). This is characteristic of mail-protocol command and control or exfiltration blending into normal mail traffic. The rule is network-side and complements existing command-line detections."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.003"
    mitre_technique_name = "Application Layer Protocol: Mail Protocols"
    log_prerequisites = "Requires Linux endpoint network telemetry (EDR socket/connect events or auditd connect records) that populates the principal process path, target.ip and target.port on NETWORK_CONNECTION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Cron or monitoring scripts (python/perl/bash) that send alert email directly to an external relay; backup or reporting jobs using openssl or curl for SMTP; administrators testing mail connectivity with telnet or nc; application servers (php, node, python) sending transactional mail to an external provider."
    tuning_guidance = "Add approved scripting parents or processes to %global_allowed_script_hosts, approved tooling to %global_allowed_admin_tools, and known mail-sending hosts to %global_allowed_service_accounts or %global_allowed_mgmt_sources as needed. Add legitimate mail providers to %global_allowed_domains. If the endpoint telemetry does not populate target.hostname, restrict by destination IP instead. Extend the mail agent exclusion regex for locally installed mail clients."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 25 or
      $net.target.port = 110 or
      $net.target.port = 143 or
      $net.target.port = 465 or
      $net.target.port = 587 or
      $net.target.port = 993 or
      $net.target.port = 995
    )
    $net.principal.process.file.full_path = /^(\/tmp|\/var\/tmp|\/dev\/shm|\/run\/user)\/|\/(python[0-9.]*|perl|ruby|php[0-9.\-]*|node|bash|sh|dash|nc|ncat|socat|openssl|curl|wget|telnet)$/ nocase
    not $net.principal.process.file.full_path = /\/(postfix|master|smtp|smtpd|sendmail|exim4?|dovecot|opendkim|amavisd?|clamd|thunderbird|evolution|geary|kmail|msmtp|mutt)$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_script_hosts
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1071.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $source_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
