/*
  MITRE Technique : T1120 - Peripheral Device Discovery
  Tactic(s)       : Discovery
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:27:18.310887+00:00
  Reference       : https://attack.mitre.org/techniques/T1120
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1120_Unexpected_Parent_Peripheral_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, script interpreter or WMI command-line client running peripheral or device discovery commands (PnP, USB, disk, printer, smart card enumeration) when spawned by an Office application, web server, print spooler or database service. These parents do not normally enumerate attached hardware, so the lineage suggests macro, web shell, or service exploitation hands-on-keyboard activity."
    mitre_tactic = "Discovery"
    mitre_technique = "T1120"
    mitre_technique_name = "Peripheral Device Discovery"
    log_prerequisites = "Requires Windows endpoint process telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office add-ins or macros that enumerate printers or drives (for example print or label tools, document management plugins); web applications that legitimately call WMI to list printers or disks; database maintenance jobs that run xp_cmdshell for disk-space checks; print management software launched from the spooler; vendor hardware inventory agents."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts and approved inventory or management binaries to %global_allowed_admin_tools. Review the matched parent and child paths in the alert and adjust the parent regex to match the client's own server estate. Exclude known service accounts via %global_allowed_service_accounts if a database or web application runs sanctioned hardware checks."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat\d*|php-cgi|spoolsv|sqlservr|mysqld|postgres|oracle)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|wmic)\.exe$/ nocase
    $proc.target.process.command_line = /(Win32_(PnPEntity|PnPSignedDriver|USBControllerDevice|USBHub|DiskDrive|LogicalDisk|CDROMDrive|Printer|Keyboard|PointingDevice|DesktopMonitor|SmartCardReader|VideoController|SoundDevice)|\b(logicaldisk|diskdrive|cdrom)\b|Get-PnpDevice|Get-Disk\b|Get-Volume\b|Get-Printer\b|pnputil(\.exe)?\s+\/enum-devices|fsutil(\.exe)?\s+fsinfo\s+drives|USBSTOR|Enum\\USB)/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1120")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
