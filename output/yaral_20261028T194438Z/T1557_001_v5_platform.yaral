/*
  MITRE Technique : T1557.001 - Name Resolution Poisoning and SMB Relay
  Tactic(s)       : Credential Access, Collection
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:32:06.627344+00:00
  Reference       : https://attack.mitre.org/techniques/T1557/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1557_001_LLMNR_Response_Crossing_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an LLMNR response (UDP source port 5355 to a non-service destination port) sent to a non-internal address. LLMNR is a link-local protocol and should never leave the local segment. A unicast LLMNR answer crossing the perimeter indicates a spoofed or poisoned name-resolution response, a misconfigured or compromised responder, or an LLMNR-based credential-capture attempt. Complements endpoint command-line detections by using perimeter network telemetry only. Limitation: poisoning that stays inside a single L2 segment never reaches a firewall. This rule covers traffic that crosses the monitored boundary."
    mitre_tactic = "Credential Access, Collection"
    mitre_technique = "T1557.001"
    mitre_technique_name = "Adversary-in-the-Middle: LLMNR/NBT-NS Poisoning and SMB Relay"
    log_prerequisites = "Requires firewall or perimeter logs that record UDP flows with source and destination ports populated in UDM (principal.port, target.port), and an internal-address reference list populated for the tenant."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Misconfigured Windows hosts or VPN and tunnel clients that leak LLMNR responses to remote networks; vulnerability scanners and authorised security testing that elicit LLMNR responses; split-tunnel or routed lab and test networks; NAT or log-normalisation artefacts where the internal address is recorded as a public address."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners. Add sanctioned management or jump-host destinations to %global_allowed_mgmt_sources. Confirm %rfc1918_internal covers all internal and VPN client ranges for the tenant. Where LLMNR is disabled by policy (the recommended hardening), any hit is high-fidelity and can be raised to Critical."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "UDP"
    $net.principal.port = 5355
    $net.target.port > 1023
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1557.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
