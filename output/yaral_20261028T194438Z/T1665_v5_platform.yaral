/*
  MITRE Technique : T1665 - Hide Infrastructure
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:05:39.821005+00:00
  Reference       : https://attack.mitre.org/techniques/T1665
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1665_Network_Device_DNS_Long_Label_TXT_NULL_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries seen at network device resolvers or forwarders that combine an abnormally long subdomain label with a TXT or NULL record type, for a domain outside the known-good list. This pattern is typical of C2 channels that hide infrastructure behind encoded, algorithmically generated or masked hostnames."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1665"
    mitre_technique_name = "Hide Infrastructure"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name and network.dns.questions.type populated. The source can be a network device DNS proxy, forwarder or resolver."
    platform = "Network Devices"
    log_source = "dns"
    false_positives = "DKIM/SPF/DMARC and other TXT lookups with long selector labels, CDN and cloud vendor hostnames with long generated labels, anti-spam DNSBL lookups, software licensing and telemetry services that encode data in subdomains, and security products doing DNS-based file reputation lookups."
    tuning_guidance = "Add the registered domains of legitimate vendors to %global_allowed_domains. Add authorised DNS testing or scanning sources to %global_allowed_scanners. Raise or lower the label length threshold in the regex ({45,}) to suit client traffic volumes."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /[a-z0-9_-]{45,}\./ nocase
    (
      $dns.network.dns.questions.type = 16 or
      $dns.network.dns.questions.type = 10
    )
    $apex = re.capture($dns.network.dns.questions.name, `([^.]+\.[^.]+)\.?$`)
    not $apex in %global_allowed_domains
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1665")
    $primary_entity = array_distinct($dns.principal.hostname)
    $source_ips = array_distinct($dns.principal.ip)
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $query_types = array_distinct($dns.network.dns.questions.type)

  condition:
    $dns
}
