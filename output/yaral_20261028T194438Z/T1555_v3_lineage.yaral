/*
  MITRE Technique : T1555 - Credentials from Password Stores
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:52:33.430279+00:00
  Reference       : https://attack.mitre.org/techniques/T1555
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_Unexpected_Parent_Spawns_Credential_Store_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office application, web server, print spooler or database service spawning a script interpreter or built-in credential utility that touches Windows credential stores (Credential Manager/Vault, DPAPI credential folders, browser credential databases, password-manager vault files). Server-side and document-borne processes have no legitimate reason to enumerate credential stores, so this is a strong indicator of post-exploitation or a malicious macro."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555"
    mitre_technique_name = "Credentials from Password Stores"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing) populating parent and child process paths and the command line."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Line-of-business apps or Office add-ins that legitimately call cmdkey or VaultCmd for service credential provisioning, web or database maintenance jobs that run scripts touching credential folders, IT deployment tooling launched from a database or web service, and security assessments."
    tuning_guidance = "Add approved parent processes to %global_allowed_admin_tools or %global_allowed_script_hosts, and add expected automation accounts to %global_allowed_service_accounts. If a specific parent family is noisy in a client environment, remove it from the parent regex for that client only after reviewing the child command lines."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Unexpected parent: Office, web server, print spooler, database service
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat\d*|php-cgi|spoolsv|sqlservr|mysqld|postgres)\.exe$/ nocase

    (
      // Branch 1: parent spawns an interpreter that references a credential store
      (
        $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32)\.exe$/ nocase and
        $proc.target.process.command_line = /(vaultcmd|cmdkey|vaultcli|credwiz|Microsoft\\Vault|Microsoft\\Credentials|Protect\\S-1-5|Login Data|logins\.json|key[34]\.db|signons|\.kdbx|PasswordVault|CredentialManager|Get-StoredCredential)/ nocase
      ) or
      // Branch 2: parent directly spawns a built-in credential enumeration utility
      (
        $proc.target.process.file.full_path = /\\(vaultcmd|cmdkey|credwiz)\.exe$/ nocase
      )
    )

    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
