/*
  MITRE Technique : T1601 - Modify System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:11:32.485134+00:00
  Reference       : https://attack.mitre.org/techniques/T1601
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_Firewall_External_TFTP_Image_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects TFTP (UDP/69) sessions seen at the network perimeter that involve an external destination and originate from a source not on the approved management-source list. TFTP is the standard unauthenticated transport for loading or replacing operating system images on embedded network devices. An internal device pulling an image from, or pushing a configuration or image to, an external TFTP endpoint is a strong network-observable indicator of system image tampering."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1601"
    mitre_technique_name = "Modify System Image"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs that normalise to UDM NETWORK_CONNECTION with principal.ip, target.ip, target.port and network.ip_protocol populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate firmware upgrades by network engineers using an externally hosted TFTP server, vendor-managed or MSP-managed device lifecycle operations, PXE or network-boot provisioning across sites, lab or staging devices behind the perimeter, and misconfigured devices backing up configurations to a remote TFTP host."
    tuning_guidance = "Add approved admin jump hosts and device management subnets (as plain address strings) to %global_allowed_mgmt_sources. Add approved vendor update domains to %global_allowed_domains. Confirm the firewall logs the destination port for UDP sessions; if TFTP data-channel traffic is logged on ephemeral ports, the control session on port 69 is still sufficient to trigger. Raise severity if the source is a known network infrastructure device."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    $net.network.ip_protocol = "UDP"
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1601")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
