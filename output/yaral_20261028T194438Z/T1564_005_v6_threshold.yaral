/*
  MITRE Technique : T1564.005 - Hidden File System
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:21:59.290071+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_005_Bulk_Disk_Image_Container_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects several virtual disk or partition-image container files (VHD, VHDX, VMDK, VDI, QCOW2, IMG) created in user-writable or staging locations on a single host within 10 minutes. Adversaries drop portable disk images on top of the host file system to hold a hidden file system for payloads and data. One image is often benign, but repeated creation in staging paths by a non-approved process is unusual."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.005"
    mitre_technique_name = "Hide Artifacts: Hidden File System"
    log_prerequisites = "Requires EDR or Sysmon-equivalent file creation telemetry (Sysmon Event ID 11 or equivalent) normalised to FILE_CREATION with target.file.full_path and principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Hypervisor and virtualisation software (Hyper-V, VMware, VirtualBox), developer and test VM workflows, disk imaging and backup tools, forensic acquisition tools, and OS or app deployment that stages .img or .vhd files in ProgramData or Temp."
    tuning_guidance = "Add approved imaging, deployment, or virtualisation binaries to %global_allowed_admin_tools and backup or imaging software to %global_allowed_backup_processes. Raise the #file threshold on VDI, developer, or lab hosts. The hypervisor process-name exclusion in the rule can be extended per environment."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(vhd|vhdx|vmdk|vdi|qcow2|img)$/ nocase
    $file.target.file.full_path = /(\\users\\[^\\]+\\(appdata|downloads|desktop|documents)\\|\\users\\public\\|\\programdata\\|\\windows\\temp\\|\\temp\\|\\perflogs\\|\$recycle\.bin\\)/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path = /\\(vmms|vmwp|vmware-vmx|vmware|VBoxSVC|VirtualBoxVM|vmconnect|MsMpEng)\.exe$/ nocase

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($file.target.file.full_path = /\.(vhd|vhdx|vmdk)$/ nocase, 75, 60))
    $mitre_technique_id = array_distinct("T1564.005")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $image_paths = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
