/*
  MITRE Technique : T1666 - Modify Cloud Resource Hierarchy
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:06:28.028460+00:00
  Reference       : https://attack.mitre.org/techniques/T1666
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1666_Cloud_Org_Hierarchy_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects control-plane API calls that sever, move, or transfer an account, subscription, or project within the cloud resource hierarchy (organization, management group, folder). Examples are leaving an organization, removing or moving an account, moving a project or folder, and transferring or re-parenting a subscription. Adversaries use these changes to escape inherited guardrails, logging and policy controls, or to hijack subscriptions."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1666"
    mitre_technique_name = "Modify Cloud Resource Hierarchy"
    log_prerequisites = "Cloud control-plane audit logs ingested and normalised to UDM, with the API or operation name in metadata.product_event_type. Organization-level or management-group-level audit logging must be enabled, such as an organization trail, tenant-level activity log, or organization log sink."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Planned account onboarding or offboarding, landing-zone and account-vending automation, organization restructuring or migration projects, M&A activity, and sanctioned subscription or project moves by cloud platform teams."
    tuning_guidance = "Add landing-zone automation and approved identities to %global_allowed_cloud_principals or %global_allowed_service_accounts. Add named cloud platform administrators to %global_allowed_admin_users. If your environment frequently creates or reorganises units, narrow the operation regex to the severing and transfer operations only. Alert on any hit outside change windows."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /^(LeaveOrganization|RemoveAccountFromOrganization|MoveAccount|DeleteOrganizationalUnit|MoveProject|MoveFolder|.*managementGroups\/subscriptions\/(write|delete)|.*Microsoft\.Subscription\/(aliases\/write|subscriptions\/cancel|changeTenantRequest.*))$/ nocase
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1666")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $operation = array_distinct($cloud.metadata.product_event_type)
    $target_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
