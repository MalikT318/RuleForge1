/*
  MITRE Technique : T1104 - Multi-Stage Channels
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:59:52.326712+00:00
  Reference       : https://attack.mitre.org/techniques/T1104
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1104_Windows_UserWritable_Process_NonStandard_Port_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows process running from a user-writable staging location (AppData, ProgramData, Temp, Public) that opens an outbound connection to an external address on a non-standard high port. This is typical of a dropped first-stage or second-stage implant calling back to a separate C2 channel. The rule observes the network side and does not depend on binary names or hashes."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1104"
    mitre_technique_name = "Multi-Stage Channels"
    log_prerequisites = "Requires endpoint network telemetry that records the initiating process path (EDR or Sysmon Event ID 3), normalised to NETWORK_CONNECTION with principal.process.file.full_path and target.port populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-user collaboration and media clients using high UDP/TCP ports (Teams, Zoom, Webex), game launchers, P2P or sync clients installed under AppData, software updaters running from ProgramData or Temp, developer tools and local test servers, and portable admin utilities."
    tuning_guidance = "Add approved tooling executables to %global_allowed_admin_tools, %global_allowed_remote_mgmt or %global_allowed_security_tools, and known-good external destinations to %global_allowed_domains. Raise or lower the port threshold per client. Suppress noisy collaboration clients by executable name; do not suppress by install directory."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(users\\[^\\]+\\appdata\\|programdata\\|users\\public\\|windows\\temp\\|temp\\)/ nocase
    $net.target.port >= 1024
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path = /\\(teams|ms-teams|zoom|webex|slack|onedrive|msedge|chrome|firefox|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1104")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
