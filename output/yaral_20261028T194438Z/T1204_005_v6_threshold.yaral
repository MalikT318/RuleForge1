/*
  MITRE Technique : T1204.005 - Malicious Library
  Tactic(s)       : Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:07:23.584080+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_005_Package_Manager_Bulk_Staging_Writes {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A language package manager or interpreter runtime (pip, npm, node, python) creates several executable, script, shared-object or hidden files in world-writable staging directories or persistence locations (cron, systemd, profile.d, ld.so.preload, autostart) on one host within 10 minutes. A single file drop is common during builds, but bulk drops of this kind suggest a malicious library running install-time hooks (setup.py, postinstall) to stage payloads or persist."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.005"
    mitre_technique_name = "User Execution: Malicious Library"
    log_prerequisites = "Linux EDR or auditd file-creation telemetry with the creating process path populated (principal.process.file.full_path)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate native-module builds (node-gyp, pip wheel compilation), CI/CD build agents, developer workstations installing packages with compiled extensions, and Python virtualenv or npm cache population under /tmp."
    tuning_guidance = "Add build tooling and CI runners to %global_allowed_admin_tools and CI/service accounts to %global_allowed_service_accounts. Raise the #file threshold on developer or build hosts. Severity scales through $risk_score: 85 if any persistence path was written, 60 for staging-only writes."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(pip|pip3|pip3\.[0-9]+|npm|npx|yarn|pnpm|node|nodejs|python|python3|python3\.[0-9]+)$/ nocase
    $file.target.file.full_path = /^\/((tmp|var\/tmp|dev\/shm)\/(.*\/)?(\.[^\/]+|[^\/]+\.(so|sh|elf|bin|py|pl))|etc\/(cron[^\/]*|systemd\/system|init\.d|profile\.d|ld\.so\.preload)(\/.*)?|(home\/[^\/]+|root)\/\.config\/(systemd\/user|autostart)\/.*)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($file.target.file.full_path = /^\/(etc\/(cron|systemd|init\.d|profile\.d|ld\.so\.preload)|(home\/[^\/]+|root)\/\.config\/)/ nocase, 85, 60))
    $mitre_technique_id = array_distinct("T1204.005")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $dropped_paths = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 5
}
