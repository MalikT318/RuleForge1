/*
  MITRE Technique : T1059 - Command and Scripting Interpreter
  Tactic(s)       : Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:07:03.042081+00:00
  Reference       : https://attack.mitre.org/techniques/T1059
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_Network_Device_External_CLI_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external (non-internal) source opening a connection to the remote CLI ports (SSH/Telnet) of an internal host. On network devices, an interactive CLI session is the interpreter an adversary uses to run commands (T1059.008, Network Device CLI). This rule uses perimeter connection telemetry only, so it does not rely on endpoint process fields and does not duplicate command-line rules."
    mitre_tactic = "Execution"
    mitre_technique = "T1059"
    mitre_technique_name = "Command and Scripting Interpreter"
    log_prerequisites = "Requires firewall or perimeter connection logs normalized to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Reference lists %rfc1918_internal and %global_allowed_mgmt_sources must be maintained per client."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Vendor or MSP remote support over SSH, authorised penetration tests and vulnerability scanners, administrators connecting from home or VPN egress addresses not yet allow-listed, and cloud-hosted jump hosts."
    tuning_guidance = "Add approved administrative source addresses to %global_allowed_mgmt_sources and authorised scanner sources to %global_allowed_scanners. Where a client intentionally publishes SSH to the internet, scope the rule by excluding those sources, or raise the severity for Telnet (port 23) only."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 22 or $net.target.port = 23)
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1059")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
