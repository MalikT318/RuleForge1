/*
  MITRE Technique : T1134.001 - Token Impersonation/Theft
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:54:38.625145+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_001_Token_Theft_Repeated_SystemProcess_Handle_Opens {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A non-allowlisted process repeatedly opens handles to SYSTEM-context core Windows processes (winlogon, lsass, services, wininit, spoolsv) on a single host within 10 minutes. Token theft and impersonation (OpenProcess followed by OpenProcessToken/DuplicateTokenEx) depends on obtaining handles to these high-privilege processes. A single handle open is routine, but repeated opens by one non-system, non-security-tool process are not. Severity is scaled in outcome by the number of distinct target processes."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.001"
    mitre_technique_name = "Access Token Manipulation: Token Impersonation/Theft"
    log_prerequisites = "Requires EDR or Sysmon process-access telemetry (Sysmon Event ID 10 or equivalent) normalised to PROCESS_OPEN with populated principal and target process paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Unlisted EDR/AV or DLP agents, backup and imaging software, system monitoring and performance tools, remote management agents, and administrators using process-inspection tools (Process Explorer, debuggers) during troubleshooting."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools, backup agents to %global_allowed_backup_processes, and IT tooling to %global_allowed_admin_tools. Raise the #proc threshold on noisy hosts such as servers running monitoring agents. If svchost.exe is a source of benign noise, it is already excluded; review for abuse by other means."

  events:
    $proc.metadata.event_type = "PROCESS_OPEN"
    $proc.target.process.file.full_path = /\\(winlogon|lsass|services|wininit|spoolsv)\.exe$/ nocase
    $proc.principal.process.file.full_path != ""
    $proc.principal.process.file.full_path != $proc.target.process.file.full_path
    not $proc.principal.process.file.full_path = /\\(System32|SysWOW64)\\(csrss|wininit|services|lsass|winlogon|svchost|smss)\.exe$/ nocase
    not $proc.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|SenseCncProxy)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $event_count = count($proc.metadata.id)
    $distinct_targets = count_distinct($proc.target.process.file.full_path)
    $risk_score = if($distinct_targets >= 3, 85, 60)
    $mitre_technique_id = array_distinct("T1134.001")
    $primary_entity = array_distinct($host)
    $source_processes = array_distinct($proc.principal.process.file.full_path)
    $target_processes = array_distinct($proc.target.process.file.full_path)
    $source_users = array_distinct($proc.principal.user.userid)

  condition:
    #proc >= 5
}
