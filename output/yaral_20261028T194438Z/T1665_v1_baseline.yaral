/*
  MITRE Technique : T1665 - Hide Infrastructure
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:04:25.522489+00:00
  Reference       : https://attack.mitre.org/techniques/T1665
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1665_DNS_Long_Encoded_Label_Hidden_C2 {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries seen by network-device resolvers or forwarders whose subdomain contains an abnormally long alphanumeric label or a long hex-encoded label. Adversaries hiding C2 infrastructure behind masked or algorithmically generated domains, DNS redirectors, or DNS tunnelling commonly encode session or routing data in these labels. Queries to domains on the known-good list are excluded."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1665"
    mitre_technique_name = "Hide Infrastructure"
    log_prerequisites = "DNS query or resolver logs from network devices (DNS forwarders, firewalls with DNS logging, resolver appliances) normalised to UDM NETWORK_DNS with network.dns.questions.name populated. Populate %global_allowed_domains with client CDN, vendor and update domains."
    platform = "Network Devices"
    log_source = "dns"
    false_positives = "CDN and cloud-storage hostnames with long generated labels, DNS-based blocklist or reputation lookups (DNSBL, antivirus cloud lookups), email authentication and DKIM-style lookups, software update services, and certificate or OCSP validation hosts using hash-based labels."
    tuning_guidance = "Add known-good domains to %global_allowed_domains. If the list holds apex domains only, extend it with the exact names of noisy long-label hosts. Raise the label length thresholds in the regex if CDN noise persists. Consider raising severity when the same source repeats the pattern against one parent domain."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(?i)(^|\.)([a-z0-9_\-]{50,}|[a-f0-9]{32,})\.[^.]+\.[^.]+$/ nocase
    not $dns.network.dns.questions.name = /(?i)\.(arpa|local|internal|lan)$/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1665")
    $primary_entity = array_distinct($dns.principal.hostname)
    $source_ips = array_distinct($dns.principal.ip)
    $queried_domains = array_distinct($dns.network.dns.questions.name)

  condition:
    $dns
}
