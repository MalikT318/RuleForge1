/*
  MITRE Technique : T1102 - Web Service
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:51:58.937381+00:00
  Reference       : https://attack.mitre.org/techniques/T1102
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1102_Linux_Scripted_Client_Web_Service_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP POST/PUT requests with a command-line or scripting-library user agent (curl, wget, python, Go, perl, etc.) to an external host that is not on the known-good domain list. Observed at the proxy or firewall, this is characteristic of a compromised Linux host relaying C2 data or exfiltrating through a legitimate third-party web service such as a paste site, cloud storage, chat or collaboration API."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1102"
    mitre_technique_name = "Web Service"
    log_prerequisites = "Requires proxy or firewall logs with HTTP inspection (TLS inspection or explicit proxy) normalised to UDM NETWORK_HTTP, populating network.http.method, network.http.user_agent and target.hostname. Without TLS inspection, user agent is not visible for HTTPS traffic."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Package managers and configuration management agents calling vendor APIs, monitoring and telemetry agents, CI/CD runners, backup agents uploading to cloud storage, developer or admin scripts calling SaaS APIs, and cloud-init or provisioning scripts."
    tuning_guidance = "Add sanctioned SaaS, vendor and update domains to %global_allowed_domains. Add servers that legitimately run automation to %global_allowed_script_hosts. Raise severity for servers that should have no direct internet egress."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT)$/ nocase
    $net.network.http.user_agent = /(?i)^(curl|wget|python-requests|python-urllib|python|go-http-client|libwww-perl|perl|ruby|okhttp|java|node-fetch|axios)([\/\s-]|$)/
    $net.target.hostname != ""
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1102")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_host = array_distinct($net.target.hostname)
    $destination_ip = array_distinct($net.target.ip)
    $user_agent = array_distinct($net.network.http.user_agent)
    $http_method = array_distinct($net.network.http.method)

  condition:
    $net
}
