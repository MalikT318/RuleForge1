/*
  MITRE Technique : T1555.004 - Windows Credential Manager
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:58:13.103894+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_004_Credential_Manager_Utility_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a native Windows Credential Manager utility (vault enumeration, stored-credential management, or the keymgr UI loaded via rundll32) making an outbound connection to a non-internal address. These components operate purely on the local credential store and have no legitimate reason to talk to the internet. A connection indicates proxy execution, process hollowing/injection into the binary, or credential-store data being staged or exfiltrated. This is network-side coverage that complements process command-line rules."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.004"
    mitre_technique_name = "Credentials from Password Stores: Windows Credential Manager"
    log_prerequisites = "Requires Windows endpoint network telemetry that attributes each connection to its originating process (EDR network events or Sysmon Event ID 3) and populates principal.process.file.full_path. The principal.process.command_line field is only needed for the rundll32/keymgr branch."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Credential Manager UI opened from a remote-support or VDI session whose telemetry reports the session or broker address as the target; EDR sensors that attribute connections to the wrong process; admins running credential tooling over a remote-management channel that resolves to a non-RFC1918 address; proxy or VPN setups that report an external gateway IP as the target."
    tuning_guidance = "Add approved IT users to %global_allowed_admin_users and approved management tooling to %global_allowed_admin_tools. If the client uses a non-RFC1918 internal range, extend %rfc1918_internal. For VDI or remote-support environments, review the destination IPs in the outcome and exclude the verified broker by user or tooling rather than by address."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.principal.process.file.full_path = /\\(vaultcmd|cmdkey|credwiz)\.exe$/ nocase or
      (
        $net.principal.process.file.full_path = /\\rundll32\.exe$/ nocase and
        $net.principal.process.command_line = /keymgr(\.dll)?/ nocase
      )
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.user.userid in %global_allowed_admin_users
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1555.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $source_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
