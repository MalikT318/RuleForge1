/*
  MITRE Technique : T1556.001 - Domain Controller Authentication
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:14:36.218725+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_001_LSASS_Handle_Then_Logon_On_DC {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a non-allowlisted process opening a handle to lsass.exe on a host, followed within 10 minutes by a user logon on the same host. This sequence is consistent with in-memory patching of domain controller authentication (Skeleton Key style), where a backdoor password is injected into LSASS and then used to authenticate as arbitrary domain users."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.001"
    mitre_technique_name = "Modify Authentication Process: Domain Controller Authentication"
    log_prerequisites = "Requires EDR or Sysmon process-access telemetry (Sysmon Event ID 10 equivalent) normalised to PROCESS_OPEN, and Windows Security logon events (4624) normalised to USER_LOGIN, both ingested from domain controllers."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "EDR/AV agents and backup software not yet allowlisted, credential-management or monitoring agents that read LSASS, memory diagnostic tools used by administrators, and crash-dump collection during troubleshooting."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools, backup agents to %global_allowed_backup_processes, and IT tooling to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Scope deployment to domain controller assets only for best fidelity. If your logon parser populates principal.hostname instead of target.hostname for the authenticating host, adjust the join field."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\lsass\.exe$/ nocase
    not $open.principal.process.file.full_path = /\\(lsass|csrss|wininit|services|svchost|smss|winlogon|MsMpEng|MsSense|SenseIR|taskmgr|werfault)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    $open.principal.hostname = $hostname

    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.hostname = $hostname
    $auth.target.user.userid != ""
    not $auth.target.user.userid = /\$$/
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users

    $open.metadata.event_timestamp.seconds <= $auth.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1556.001")
    $primary_entity = array_distinct($hostname)
    $accessing_processes = array_distinct($open.principal.process.file.full_path)
    $logon_accounts = array_distinct($auth.target.user.userid)
    $logon_count = count($auth.metadata.id)

  condition:
    $open and $auth
}
