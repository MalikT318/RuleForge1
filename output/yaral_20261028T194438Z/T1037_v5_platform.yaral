/*
  MITRE Technique : T1037 - Boot or Logon Initialization Scripts
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:19:08.852755+00:00
  Reference       : https://attack.mitre.org/techniques/T1037
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_ESXi_Boot_Init_Script_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects ESXi shell commands that write to or alter boot-time initialization scripts (/etc/rc.local.d/local.sh, /etc/rc.local, /etc/init.d/*). ESXi runs these scripts as root at every boot, so attackers use them to persist implants, such as backdoors, SSH key re-injection or ransomware launchers, after a reboot."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037"
    mitre_technique_name = "Boot or Logon Initialization Scripts"
    log_prerequisites = "ESXi shell command logging (shell.log / hostd) forwarded and parsed into UDM PROCESS_LAUNCH events with target.process.command_line populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators legitimately adding startup commands to local.sh (for example NTP, network tuning, or driver and VIB post-install steps), host configuration or automation tooling that edits init scripts, and vendor VIB or agent installers that register services in /etc/init.d."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and approved configuration or deployment tooling to %global_allowed_admin_tools. Correlate hits with a recent SSH enablement or root login event for the same host. Any unexpected change outside a change window should be treated as suspicious."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /\/etc\/(rc\.local\.d\/[^\s;|&]*|rc\.local|init\.d\/[^\s;|&]*)/ nocase
    $proc.target.process.command_line = /(>|\btee\b|\bsed\s+-\w*i|\b(cp|mv|ln|vi|vim|chmod|install|printf)\b)/ nocase
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1037")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
