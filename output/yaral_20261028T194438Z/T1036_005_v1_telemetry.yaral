/*
  MITRE Technique : T1036.005 - Match Legitimate Resource Name or Location
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:04:12.759741+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_005_K8s_Resource_Masquerading_System_Component {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a container or Kubernetes resource whose name imitates a core cluster system component (kube-proxy, coredns, etcd, CNI agents and similar) when the creator is not a recognised controller, automation account or administrator. Attackers use trusted-looking names to hide backdoor DaemonSets, pods and deployments from defenders (Kubernetes backdoor masquerading). The rule works at the control-plane resource-creation layer, not the command line."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.005"
    mitre_technique_name = "Masquerading: Match Legitimate Resource Name or Location"
    log_prerequisites = "Requires container runtime and Kubernetes audit logs ingested and normalised to UDM RESOURCE_CREATION, with target.resource.name and principal.user.userid populated. Audit policy must record create verbs at Metadata level or higher."
    platform = "Linux"
    log_source = "container"
    false_positives = "Cluster upgrades and add-on installers (CNI, DNS, metrics) run by a human administrator or CI/CD pipeline; managed-Kubernetes control planes that create system components under unlisted identities; GitOps controllers redeploying system add-ons."
    tuning_guidance = "Add GitOps, CI/CD and add-on installer identities to %global_allowed_service_accounts, cluster administrators to %global_allowed_admin_users, and managed control-plane identities to %global_allowed_cloud_principals. Extend the component-name regex with local add-on names if needed. Built-in controller and node identities with the 'system:' prefix are already excluded."

  events:
    $res.metadata.event_type = "RESOURCE_CREATION"
    $res.target.resource.name = /^(kube-(proxy|apiserver|controller-manager|scheduler|dns|system|state-metrics|router)|coredns|etcd|calico-node|cilium|aws-node|azure-ip-masq-agent|metrics-server|node-local-dns|konnectivity-agent|csi-[a-z]+-(node|controller))([-_.][a-z0-9]+)*$/ nocase
    $res.principal.user.userid != ""
    not $res.principal.user.userid = /^system:/ nocase
    not $res.principal.user.userid in %global_allowed_service_accounts
    not $res.principal.user.userid in %global_allowed_admin_users
    not $res.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1036.005")
    $primary_entity = array_distinct(strings.coalesce($res.principal.user.userid, $res.principal.hostname))
    $created_resource_names = array_distinct($res.target.resource.name)
    $source_ips = array_distinct($res.principal.ip)

  condition:
    $res
}
