/*
  MITRE Technique : T1134.002 - Create Process with Token
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:55:51.542876+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_002_Runas_Explicit_Credentials_Launch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects runas.exe launched with an explicit target account (/user:) combined with either cached-credential reuse (/savecred) or a script/shell parent process. Both patterns indicate a process being created in another user's security context, a common route to privilege escalation. Matches on the OS binary and its flag combination, not on any payload."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.002"
    mitre_technique_name = "Access Token Manipulation: Create Process with Token"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with full command line and parent process path (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators running elevated tools interactively or via helper scripts, IT support scripts that use runas for delegated tasks, legacy logon scripts and scheduled jobs that rely on /savecred, and software packaging or testing workflows."
    tuning_guidance = "Add approved admin tooling to %global_allowed_admin_tools, approved script host parents to %global_allowed_script_hosts, and named administrators to %global_allowed_admin_users. Raise severity if the parent is an Office application or a script host launched from a user-writable location."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\runas\.exe$/ nocase
    $proc.target.process.command_line = /\/user:/ nocase
    (
      $proc.target.process.command_line = /\/savecred/ nocase or
      $proc.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|wmiprvse|winword|excel|powerpnt|outlook)\.exe$/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1134.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
