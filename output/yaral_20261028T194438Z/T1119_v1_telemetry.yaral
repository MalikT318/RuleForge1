/*
  MITRE Technique : T1119 - Automated Collection
  Tactic(s)       : Collection
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:25:08.698408+00:00
  Reference       : https://attack.mitre.org/techniques/T1119
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1119_SaaS_Identity_App_Credential_Or_Consent_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects configuration changes in the identity provider that enable programmatic, non-interactive access to SaaS data: OAuth consent or permission grants, app role assignments, and new credentials (secret, certificate, key) added to an application or service principal. Adversaries use these persistent API identities to run automated, scheduled collection of mail, files and directory data through cloud APIs. The rule detects the resulting configuration state change, not a command line."
    mitre_tactic = "Collection"
    mitre_technique = "T1119"
    mitre_technique_name = "Automated Collection"
    log_prerequisites = "Requires identity provider directory audit logs that record application, service principal and consent changes, normalized to SETTING_MODIFICATION with metadata.description populated."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Legitimate application onboarding by IT or developers, scheduled secret and certificate rotation, SaaS integrations being connected, and automated app-registration pipelines."
    tuning_guidance = "Add automation identities to %global_allowed_cloud_principals and approved administrators to %global_allowed_admin_users. Raise severity if the actor is a non-admin user or the change occurs outside change windows. Adjust the metadata.description regex to the client's identity provider audit wording if coverage gaps appear."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.description = /(consent|oauth2permissiongrant|app\s*role\s*assignment|(add|update|create)\w*\s+(service\s*principal|application|app)\b.*(credential|secret|certificate|key))/ nocase
    not $setting.principal.user.userid in %global_allowed_cloud_principals
    not $setting.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1119")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $change_description = array_distinct($setting.metadata.description)
    $target_resource = array_distinct($setting.target.resource.name)

  condition:
    $setting
}
