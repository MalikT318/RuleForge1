/*
  MITRE Technique : T1518.002 - Backup Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:23:39.959898+00:00
  Reference       : https://attack.mitre.org/techniques/T1518/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_002_Backup_Discovery_Then_Recovery_Inhibition {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a host where a built-in utility is used to enumerate backup software (registry, service, process, WMI or file listing with backup-related keywords) and, within 10 minutes, a recovery-inhibiting command is run (shadow copy deletion, backup catalog deletion, boot recovery disabled). This sequence is typical of pre-ransomware staging where the adversary first learns what backup tooling exists and then destroys recovery options."
    mitre_tactic = "Discovery"
    mitre_technique = "T1518.002"
    mitre_technique_name = "Software Discovery: Backup Software Discovery"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with full command lines (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup administrators auditing agent installs and then pruning old shadow copies or catalogs; storage-maintenance scripts; software deployment or RMM tooling doing inventory and cleanup; disk-space clean-up scripts that run vssadmin or wbadmin after a service query."
    tuning_guidance = "Add approved backup agents and software to %global_allowed_backup_processes. Add approved IT tooling and maintenance parent processes to %global_allowed_admin_tools. Add known maintenance accounts to %global_allowed_admin_users. Widen the correlation window or tighten the keyword list on the discovery side if a client runs frequent legitimate backup audits."

  events:
    // Stage 1 - backup software discovery
    $disc.metadata.event_type = "PROCESS_LAUNCH"
    $disc.target.process.file.full_path = /\\(reg|sc|tasklist|wmic|powershell|pwsh|cmd)\.exe$/ nocase
    $disc.target.process.command_line = /(\bquery\b|\btasklist\b|get-service|get-process|get-wmiobject|get-ciminstance|get-childitem|\bwmic\b|\bdir\b|\bfindstr\b).*(veeam|acronis|paragon|commvault|veritas|backup\s?exec|arcserve|cohesity|rubrik|datto|shadowprotect|networker|bacula|backup)/ nocase
    not $disc.principal.process.file.full_path in %global_allowed_backup_processes
    not $disc.principal.process.file.full_path in %global_allowed_admin_tools
    not $disc.principal.user.userid in %global_allowed_admin_users
    $disc.principal.hostname = $hostname

    // Stage 2 - recovery inhibition
    $inhib.metadata.event_type = "PROCESS_LAUNCH"
    $inhib.target.process.file.full_path = /\\(vssadmin|wbadmin|bcdedit|wmic)\.exe$/ nocase
    $inhib.target.process.command_line = /(delete\s+shadows|shadowcopy.*delete|delete\s+(catalog|backup|systemstatebackup)|recoveryenabled\s+(no|off)|bootstatuspolicy\s+ignoreallfailures|resize\s+shadowstorage)/ nocase
    not $inhib.principal.process.file.full_path in %global_allowed_backup_processes
    not $inhib.principal.process.file.full_path in %global_allowed_admin_tools
    not $inhib.principal.user.userid in %global_allowed_admin_users
    $inhib.principal.hostname = $hostname

    // Discovery must precede or coincide with inhibition
    $disc.metadata.event_timestamp.seconds <= $inhib.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1518.002")
    $primary_entity = array_distinct($hostname)
    $discovery_commands = array_distinct($disc.target.process.command_line)
    $inhibit_commands = array_distinct($inhib.target.process.command_line)
    $affected_users = array_distinct($disc.principal.user.userid)
    $discovery_event_count = count($disc.metadata.id)
    $inhibit_event_count = count($inhib.metadata.id)

  condition:
    $disc and $inhib
}
