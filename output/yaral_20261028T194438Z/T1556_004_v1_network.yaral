/*
  MITRE Technique : T1556.004 - Network Device Authentication
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:18:47.006876+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_004_External_Mgmt_Plane_Access_To_Network_Device {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a connection from a non-internal source address to a device management-plane port (Telnet, SSH, NETCONF-over-SSH) as seen by the perimeter. A network device implanted with a hard-coded backdoor password (patched system image) is reached by the adversary over remote management protocols from outside the trusted management network. Legitimate management normally originates from approved management sources, so external sources reaching these ports are an indicator of backdoored-authentication use or probing."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.004"
    mitre_technique_name = "Modify Authentication Process: Network Device Authentication"
    log_prerequisites = "Firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Management-plane flows must traverse the logging perimeter."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Third-party managed-service or vendor support access, remote administrators on VPN pools or home or carrier addresses not yet allowlisted, authorised external penetration tests or vulnerability scanners, cloud-hosted monitoring or NMS platforms, internet-exposed devices receiving routine SSH brute-force noise (which should be fixed rather than tuned away)."
    tuning_guidance = "Add approved management source addresses (jump hosts, VPN egress, MSP and NMS sources) to %global_allowed_mgmt_sources. Add authorised scanners to %global_allowed_scanners. Make sure %rfc1918_internal reflects the customer's internal address space. Raise severity for devices that must never be reachable externally. If a customer legitimately exposes these services, scope the exclusion to the source, not the port."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 830
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1556.004")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $mgmt_ports = array_distinct($net.target.port)

  condition:
    $net
}
