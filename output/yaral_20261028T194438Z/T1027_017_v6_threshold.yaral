/*
  MITRE Technique : T1027.017 - SVG Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:06:42.028085+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/017
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_017_SVG_Direct_Fetch_Volume_Linux {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single Linux host retrieves several SVG files directly (GET, no referring page, successful response) from external, non-allowlisted destinations within ten minutes. Normal web pages pull SVG icons and images as sub-resources with a referrer, so repeated direct SVG navigation or download is characteristic of SVG smuggling lures that carry embedded script or payload-assembly content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.017"
    mitre_technique_name = "Obfuscated Files or Information: SVG Smuggling"
    log_prerequisites = "Requires forward or transparent proxy or firewall HTTP logging that populates network.http.method, network.http.response_code, network.http.user_agent, target.url and target.hostname. TLS inspection is needed to see full URLs for HTTPS traffic."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Linux desktop users browsing design or documentation sites, direct opening of logo or diagram links, package or documentation mirrors serving SVG assets, web scrapers, CI jobs that fetch SVG badges, and proxies that strip the Referer header."
    tuning_guidance = "Add trusted CDNs and vendor domains to %global_allowed_domains. Raise the #http threshold on hosts with heavy browsing. If the proxy does not log hostnames, change the grouping field to principal.ip. If the user agent is not logged, remove the user agent filter and scope to Linux clients by source network instead."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET"
    $http.network.http.response_code = 200
    $http.target.url = /\.svg(\?[^\s]*)?$/ nocase
    $http.network.http.user_agent = /(linux|x11)/ nocase
    $http.network.http.referral_url = ""
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    $http.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($http.metadata.id)
    $mitre_technique_id = array_distinct("T1027.017")
    $primary_entity = array_distinct($host)
    $svg_urls = array_distinct($http.target.url)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)

  condition:
    #http >= 3
}
