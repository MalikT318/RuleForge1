/*
  MITRE Technique : T1217 - Browser Information Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:39:21.995322+00:00
  Reference       : https://attack.mitre.org/techniques/T1217
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1217_Linux_NonBrowser_Reads_Browser_Profile_Data {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a non-browser process reading browser profile data stores (history, bookmarks, cookies, saved logins, form data) on Linux. Adversaries enumerate these files to learn about user activity, internal resources, and cached credentials. This rule uses file-access telemetry (FILE_READ), not process command lines, so it also catches in-process readers such as scripts, implants and sqlite libraries."
    mitre_tactic = "Discovery"
    mitre_technique = "T1217"
    mitre_technique_name = "Browser Information Discovery"
    log_prerequisites = "Requires Linux EDR file-access telemetry or auditd file watch rules (-w on browser profile directories with -p r) normalised to UDM FILE_READ with principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup and imaging agents, endpoint security scanners, desktop search indexers, browser-sync or profile-migration utilities, DLP agents, IT support tooling copying user profiles."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes, EDR/AV scanners to %global_allowed_security_tools, and approved IT tooling to %global_allowed_admin_tools. Confirm auditd watches are scoped to browser profile directories to limit volume. Add further browser binary names to the exclusion regex if the fleet uses other browsers."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /\/(\.config\/(google-chrome|chromium|BraveSoftware|microsoft-edge|vivaldi|opera)|\.mozilla\/firefox|snap\/(firefox|chromium)\/common)\/.*\/(History|Login Data|Cookies|Bookmarks|Web Data|Favicons|Top Sites|places\.sqlite|cookies\.sqlite|formhistory\.sqlite|logins\.json|key4\.db)$/ nocase
    $file.principal.process.file.full_path != ""
    not $file.principal.process.file.full_path = /\/(google-chrome|google-chrome-stable|chrome|chromium|chromium-browser|firefox|firefox-bin|firefox-esr|brave|brave-browser|msedge|microsoft-edge|opera|vivaldi|vivaldi-bin)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1217")
    $primary_entity = array_distinct($file.principal.hostname)
    $accessing_process = array_distinct($file.principal.process.file.full_path)
    $accessed_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
