/*
  MITRE Technique : T1564.008 - Email Hiding Rules
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:27:18.337999+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_008_Outlook_Rules_Registry_Tampering_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several registry modifications to Outlook rule-related settings (rules and alerts, client-side mail rule policy) are made by a non-Outlook process on one host within ten minutes. Programmatic tampering with these settings can be used to enable or conceal mailbox rules that hide, move or delete inbound mail."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.008"
    mitre_technique_name = "Hide Artifacts: Email Hiding Rules"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events) with registry key and value name populated. Server-side inbox rules (New-InboxRule or Set-InboxRule on Exchange Online) are not visible here and need mailbox audit logs."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy or Intune/MDM pushing Outlook configuration, Office installation or upgrade, profile migration tooling, and IT scripts that standardise Outlook rule settings."
    tuning_guidance = "Add deployment and configuration tooling to %global_allowed_admin_tools and named administrators to %global_allowed_admin_users. Raise the #reg threshold if GPO refresh cycles generate bursts. Lower it to 2 in environments with strict Office baselines."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Software\\(Policies\\)?Microsoft\\Office\\[0-9.]+\\Outlook\\/ nocase
    $reg.target.registry.registry_value_name = /(rules|alerts)/ nocase
    not $reg.principal.process.file.full_path = /\\outlook\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_admin_users
    $reg.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1564.008")
    $primary_entity = array_distinct($host)
    $event_count = count($reg.metadata.id)
    $users = array_distinct($reg.principal.user.userid)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $registry_keys = array_distinct($reg.target.registry.registry_key)

  condition:
    #reg >= 3
}
