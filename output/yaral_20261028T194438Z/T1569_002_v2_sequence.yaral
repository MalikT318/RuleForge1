/*
  MITRE Technique : T1569.002 - Service Execution
  Tactic(s)       : Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:11:25.605896+00:00
  Reference       : https://attack.mitre.org/techniques/T1569/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_002_Remote_Service_Binary_Drop_Then_SCM_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An executable is written to the root of the Windows directory, System32 or Windows\\Temp and, within 10 minutes, the service control manager (services.exe) launches that same file as a process. This is the file-drop-then-service-start pattern of PsExec-style remote service execution and of manually created malicious services. It correlates file creation with SCM-parented execution of the identical path, not command-line matching."
    mitre_tactic = "Execution"
    mitre_technique = "T1569.002"
    mitre_technique_name = "System Services: Service Execution"
    log_prerequisites = "Requires EDR or Sysmon-equivalent telemetry that populates FILE_CREATION (with target file path) and PROCESS_LAUNCH (with parent process path) for Windows endpoints."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters that drop a service binary and start it immediately, RMM and deployment agents, authorised PsExec use by administrators, and vendor driver or agent setup routines."
    tuning_guidance = "Add approved deployment and RMM binary paths to %global_allowed_admin_tools and approved remote execution tooling to %global_allowed_remote_mgmt. Extend the writer-process exclusion regex if a servicing component in your estate is noisy. Review the writer_processes outcome: an empty value or a System-level writer suggests a remote SMB write to ADMIN$."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^[a-z]:\\windows\\(system32\\|temp\\)?[^\\]+\.exe$/ nocase
    not $file.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|msiexec|wuauclt|MoUsoCoreWorker|MsMpEng|MpSigStub)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname
    $path = strings.to_lower($file.target.file.full_path)

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\services\.exe$/ nocase
    $proc.target.process.file.full_path = /^[a-z]:\\windows\\(system32\\|temp\\)?[^\\]+\.exe$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_remote_mgmt
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname
    $path = strings.to_lower($proc.target.process.file.full_path)

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1569.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $dropped_paths = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $service_children = array_distinct($proc.target.process.file.full_path)
    $service_command_lines = array_distinct($proc.target.process.command_line)
    $affected_users = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
