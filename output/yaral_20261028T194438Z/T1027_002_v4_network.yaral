/*
  MITRE Technique : T1027.002 - Software Packing
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:40:22.967572+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_002_Linux_Staging_Dir_Binary_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side proxy for packed or self-decompressing payloads on Linux. Packed binaries are usually dropped to a world-writable staging location (/tmp, /var/tmp, /dev/shm), run from an anonymous in-memory file (memfd), or run from a deleted file after unpacking. A process running from one of those locations that connects to an external address is flagged. There is no network signature for packing itself, so this detects the behaviour that typically follows it. The rule complements process-creation rules and does not replace them."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.002"
    mitre_technique_name = "Obfuscated Files or Information: Software Packing"
    log_prerequisites = "Requires Linux EDR or auditd network telemetry (connect events) normalised to NETWORK_CONNECTION, with principal.process.file.full_path populated. %rfc1918_internal should also cover loopback and link-local addresses."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Build and CI jobs that run test binaries from /tmp, self-extracting installers or package post-install scripts that fetch content from /tmp, containerised or ephemeral workloads that unpack to /dev/shm, language runtimes using memfd for JIT, and developers testing tools."
    tuning_guidance = "Add approved installer, deployment and build tooling to %global_allowed_admin_tools. Add EDR and AV agents to %global_allowed_security_tools. Add approved script-running parents to %global_allowed_script_hosts. Make sure %rfc1918_internal includes loopback so local IPC is not flagged. Build and CI hosts may need a per-client exclusion, or a lower severity in the SOAR playbook."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/memfd:)|\(deleted\)$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.parent_process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1027.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_binary = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
