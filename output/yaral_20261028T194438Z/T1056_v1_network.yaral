/*
  MITRE Technique : T1056 - Input Capture
  Tactic(s)       : Collection, Credential Access
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:44:18.395816+00:00
  Reference       : https://attack.mitre.org/techniques/T1056
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1056_Credential_Post_To_Raw_IP_Web_Portal_Capture {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an HTTP POST with credential-style URL content sent to an external host addressed by a raw IP literal rather than a domain name. This is the network footprint of web portal capture pages and keylogger or credential-harvester exfiltration, which usually post to bare infrastructure. It is observed from the network side and does not depend on endpoint process telemetry."
    mitre_tactic = "Collection, Credential Access"
    mitre_technique = "T1056"
    mitre_technique_name = "Input Capture"
    log_prerequisites = "Requires firewall or web proxy logs that populate NETWORK_HTTP with network.http.method and target.url. TLS inspection is needed to see URLs for HTTPS traffic; without it only cleartext HTTP is covered."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Embedded devices, appliances and legacy line-of-business applications that authenticate to an external service by IP address. Vendor cloud management consoles addressed by IP. Penetration tests and red team exercises. Misconfigured software posting login requests to an IP-based update or licensing server."
    tuning_guidance = "Add known-good external destinations to %global_allowed_domains. Add authorised testing sources to %global_allowed_scanners. Keep %rfc1918_internal current for each client so internal portals are excluded. If clients have no TLS inspection, expect coverage of cleartext HTTP only."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.url = /^https?:\/\/\d{1,3}(\.\d{1,3}){3}(:\d+)?\// nocase
    $net.target.url = /(login|logon|signin|auth|passw|pwd|cred)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1056")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_urls = array_distinct($net.target.url)

  condition:
    $net
}
