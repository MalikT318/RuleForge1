/*
  MITRE Technique : T1078.003 - Local Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:32:41.987506+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_003_Linux_Local_Login_Then_Credential_File_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A local account logs in to a Linux host and, within one hour, the same account modifies a credential or privilege file (/etc/passwd, /etc/shadow, /etc/sudoers, sudoers.d, or an authorized_keys file). This sequence indicates abuse of a local account to establish persistence or escalate privileges, and is a login-then-file-change join rather than command-line matching."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.003"
    mitre_technique_name = "Valid Accounts: Local Accounts"
    log_prerequisites = "Requires Linux login telemetry (sshd, PAM, auditd USER_LOGIN) normalised to USER_LOGIN with target.hostname and target.user.userid, plus file-integrity or auditd watch telemetry normalised to FILE_MODIFICATION with principal.user.userid populated. Audit watches on /etc/passwd, /etc/shadow, /etc/sudoers and authorized_keys are recommended."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators who log in to change passwords, sudo rules or SSH keys; configuration management and provisioning run under an interactive account; user self-service SSH key rotation; onboarding or offboarding workflows; password changes via passwd run by the user."
    tuning_guidance = "Add automation and provisioning accounts to %global_allowed_service_accounts, named administrators to %global_allowed_admin_users, and approved configuration-management binaries to %global_allowed_admin_tools. If authorized_keys noise is high for developer hosts, restrict the path regex to /etc files only."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.hostname = $hostname
    $auth.target.user.userid = $user
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users

    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^(\/etc\/(passwd|shadow|gshadow|sudoers)|\/etc\/sudoers\.d\/.+|.*\/\.ssh\/authorized_keys2?)$/ nocase
    $file.principal.hostname = $hostname
    $file.principal.user.userid = $user
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

    $auth.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname, $user over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1078.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $account = array_distinct($user)
    $login_source_ips = array_distinct($auth.principal.ip)
    $modified_files = array_distinct($file.target.file.full_path)
    $modifying_processes = array_distinct($file.principal.process.file.full_path)
    $modification_count = count($file.metadata.id)

  condition:
    $auth and $file
}
