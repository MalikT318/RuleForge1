/*
  MITRE Technique : T1659 - Content Injection
  Tactic(s)       : Initial Access, Command and Control
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:02:05.250235+00:00
  Reference       : https://attack.mitre.org/techniques/T1659
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1659_Linux_Cleartext_Payload_Download_CLI_Agent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a command-line or scripting HTTP client (curl, wget, python, perl, Go) fetching an executable, script or package file over unencrypted HTTP from an external destination. Cleartext transfers can be modified in transit by an on-path or on-side attacker (content injection) to deliver payloads to Linux hosts, so this surfaces both injected payload delivery and unsafe cleartext tool retrieval."
    mitre_tactic = "Initial Access, Command and Control"
    mitre_technique = "T1659"
    mitre_technique_name = "Content Injection"
    log_prerequisites = "Requires firewall or web proxy logs normalized to UDM NETWORK_HTTP with target.url and network.http.user_agent populated. Plain HTTP must be visible to the perimeter device. Encrypted traffic is out of scope unless TLS inspection is enabled."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legacy package mirrors and repositories served over HTTP, internal or vendor artifact servers on HTTP, OS installers and kickstart/preseed workflows, admin scripts fetching installers from vendor sites over HTTP, and CI/CD agents."
    tuning_guidance = "Add known-good vendor, mirror and repository domains to %global_allowed_domains. Exclude internal addresses with %rfc1918_internal. If the proxy logs response codes, add a 2xx check to require a successful download. Extend the user-agent or file-extension regex to match local conventions."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /^http:\/\// nocase
    $net.target.url = /\.(sh|bash|elf|bin|run|so|deb|rpm|py|pl|appimage)(\?.*)?$/ nocase
    $net.network.http.user_agent = /^(curl|wget|python-requests|python-urllib|libwww-perl|go-http-client)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1659")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
