/*
  MITRE Technique : T1485.001 - Lifecycle-Triggered Deletion
  Tactic(s)       : Impact
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:37:56.817725+00:00
  Reference       : https://attack.mitre.org/techniques/T1485/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1485_001_Cloud_Bucket_Lifecycle_Policy_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a control-plane API call that creates or replaces the lifecycle or management policy of a cloud object-storage bucket or account. Adversaries abuse this to expire and delete every object, for extortion or to destroy log buckets. The rule matches the policy-write API itself, so it fires regardless of the tool, credentials or source infrastructure used."
    mitre_tactic = "Impact"
    mitre_technique = "T1485.001"
    mitre_technique_name = "Data Destruction: Lifecycle-Triggered Deletion"
    log_prerequisites = "Cloud control-plane audit logs ingested and parsed to UDM with metadata.product_event_type populated. Requires management-event logging, and for AWS also bucket-level configuration events, to be enabled."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Storage or platform teams applying cost-optimisation tiering or retention policies; infrastructure-as-code pipelines (Terraform, CloudFormation, Bicep) applying lifecycle rules; compliance automation; newly provisioned buckets receiving a baseline policy. On GCS the bucket update/patch methods are generic, so any bucket metadata change (labels, versioning, CORS) also matches."
    tuning_guidance = "Add IaC pipeline roles and automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Add named storage administrators to %global_allowed_admin_users. If GCS bucket update/patch volume is too high, remove the storage.buckets alternation from the regex. Raise severity to Critical for buckets that hold audit logs or backups, using a client-specific copy of this rule."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /^(PutBucketLifecycle|PutBucketLifecycleConfiguration|PutLifecycleConfiguration|storage\.buckets\.(update|patch)|.*storage\/storageaccounts\/managementpolicies\/write)$/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1485.001")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_call = array_distinct($cloud.metadata.product_event_type)
    $target_bucket = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
