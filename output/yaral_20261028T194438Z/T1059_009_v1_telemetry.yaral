/*
  MITRE Technique : T1059.009 - Cloud API
  Tactic(s)       : Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:19:00.796363+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_009_Identity_Setting_Change_Via_Programmatic_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a security-relevant tenant configuration change (authentication, MFA, federation, conditional access, password or policy settings) made through a scripted or SDK/CLI-style API client rather than an interactive browser session. This catches the resulting configuration state change from Cloud API abuse, so it still fires when command-line or shell logging is evaded."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.009"
    mitre_technique_name = "Command and Scripting Interpreter: Cloud API"
    log_prerequisites = "Requires identity provider directory/admin audit logs normalized to UDM SETTING_MODIFICATION, with metadata.product_event_type and network.http.user_agent populated."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Infrastructure-as-code pipelines, identity governance and provisioning automation, administrators using approved scripting modules for planned policy changes, and managed-service tooling performing baseline hardening."
    tuning_guidance = "Add automation and pipeline identities to %global_allowed_service_accounts and %global_allowed_cloud_principals. Add approved administrator accounts to %global_allowed_admin_users if scripted changes are routine. Narrow the product_event_type regex if the tenant produces noisy low-risk setting events."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(policy|mfa|multifactor|authenticat|conditional|federat|password|security|consent|credential|trust)/ nocase
    $setting.network.http.user_agent = /(python-requests|python-urllib|aiohttp|powershell|curl\/|wget|go-http-client|okhttp|java\/|node-fetch|axios|libwww|sdk|\bcli\b)/ nocase
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_cloud_principals
    not $setting.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1059.009")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $changed_setting = array_distinct($setting.metadata.product_event_type)
    $client_user_agent = array_distinct($setting.network.http.user_agent)
    $source_ip = array_distinct($setting.principal.ip)

  condition:
    $setting
}
