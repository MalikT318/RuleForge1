/*
  MITRE Technique : T1218.005 - Mshta
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:49:13.073109+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_005_Mshta_Repeated_External_Connections {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects mshta.exe making repeated outbound network connections to external addresses from a single host within ten minutes. A single connection can be benign, but repeated external connections from the HTA host indicate remote payload retrieval, staged script downloads or C2 beaconing. This covers network behaviour and does not rely on process-creation command-line matching."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.005"
    mitre_technique_name = "System Binary Proxy Execution: Mshta"
    log_prerequisites = "Requires Windows endpoint network telemetry that attributes each connection to its originating process (EDR or Sysmon Event ID 3), normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy line-of-business applications built on HTA files that call external web services, vendor installers or support tools that use mshta.exe to render HTML UI, and internal portals that resolve to public addresses."
    tuning_guidance = "Add approved hosts that legitimately run HTA applications to %global_allowed_script_hosts and known-good destination domains to %global_allowed_domains. Raise the #net threshold in the condition for noisy environments. Internal address space is excluded through %rfc1918_internal."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\mshta\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.target.hostname in %global_allowed_domains
    $net.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(75)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1218.005")
    $primary_entity = array_distinct($host)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ports = array_distinct($net.target.port)
    $affected_users = array_distinct($net.principal.user.userid)

  condition:
    #net >= 3
}
