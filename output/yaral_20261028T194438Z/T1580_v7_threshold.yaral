/*
  MITRE Technique : T1580 - Cloud Infrastructure Discovery
  Tactic(s)       : Discovery
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:59:03.015027+00:00
  Reference       : https://attack.mitre.org/techniques/T1580
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1580_Cloud_Infrastructure_Discovery_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single cloud identity issues a high volume of read-only describe, list or head style control-plane API calls within ten minutes. Each call is benign on its own, but a burst of them across services is typical of an adversary enumerating instances, storage, databases and snapshots after gaining access to an IaaS environment."
    mitre_tactic = "Discovery"
    mitre_technique = "T1580"
    mitre_technique_name = "Cloud Infrastructure Discovery"
    log_prerequisites = "Requires cloud control-plane audit logs with management read events enabled, normalised to USER_RESOURCE_ACCESS with metadata.product_event_type (API operation name) and principal.user.userid populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Infrastructure-as-code tooling and CI/CD pipelines running plan or refresh operations, cloud posture and asset-inventory scanners, cost and FinOps tooling, monitoring agents, CMDB sync jobs, and administrators using the web console, which issues many list calls per page load."
    tuning_guidance = "Add automation and inventory identities to %global_allowed_service_accounts, %global_allowed_cloud_principals or %global_allowed_admin_users. Raise or lower the #cloud threshold per client baseline (default 30 events in 10m). Severity scales through $risk_score at 100 or more calls. Extend the operation-name regex if the client's log normalisation uses different API naming."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /^(Describe|List|Head)[A-Z]|\.(list|aggregatedList)$|\/read$/ nocase
    $cloud.principal.user.userid != ""
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $event_count = count($cloud.metadata.id)
    $risk_score = max(if($event_count >= 100, 80, 50))
    $mitre_technique_id = array_distinct("T1580")
    $primary_entity = array_distinct($user)
    $api_operations = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    #cloud >= 30
}
