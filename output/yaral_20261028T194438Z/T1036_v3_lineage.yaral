/*
  MITRE Technique : T1036 - Masquerading
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:55:20.304284+00:00
  Reference       : https://attack.mitre.org/techniques/T1036
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_Svchost_Unexpected_Parent_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process named svchost.exe launched by any parent other than the Windows Service Control Manager (services.exe). On Windows, genuine svchost instances are always started by services.exe, so a different parent indicates a renamed or dropped binary masquerading as a core system process. The detection uses process lineage rather than command-line content, so it still fires if the attacker changes arguments, payload, or file hash."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036"
    mitre_technique_name = "Masquerading"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry (EDR or Sysmon Event ID 1, or Security Event 4688 with parent process info) that populates both the parent and child process image paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "EDR/Sysmon sources that record a wrong or truncated parent image path (for example, early boot processes or parent PID reuse); security products or forensic tools that deliberately spawn svchost.exe in a sandbox or test harness; Windows servicing or hot-patching components on rare builds; developer or lab hosts testing service-host behaviour."
    tuning_guidance = "First confirm that the telemetry source populates principal.process.file.full_path reliably, since parent-path gaps are the main noise source. Add approved security agents to %global_allowed_security_tools and approved deployment or administration tooling to %global_allowed_admin_tools. If a specific agent legitimately spawns svchost.exe in your environment, add its executable to one of those lists rather than excluding by install directory."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\svchost\.exe$/ nocase
    $proc.principal.process.file.full_path != ""
    not $proc.principal.process.file.full_path = /\\services\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1036")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
