/*
  MITRE Technique : T1053.006 - Systemd Timers
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:18:22.147312+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_006_Systemd_Spawned_Process_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side detection of systemd timer abuse. A process whose parent is systemd (the usual lineage of a timer-triggered .service unit) makes an outbound connection to a non-internal address. The process either runs from a world-writable or hidden user path, or is a shell, interpreter or downloader. This catches timer-driven beaconing, payload staging and callbacks without relying on process command-line or unit-file telemetry."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.006"
    mitre_technique_name = "Scheduled Task/Job: Systemd Timers"
    log_prerequisites = "Linux EDR or auditd network telemetry that populates NETWORK_CONNECTION with principal process path and parent process path (parent_process.file.full_path) and the destination IP."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate timer-driven services such as package update checks, certificate renewal (certbot), backup or sync scripts using curl or wget, monitoring and inventory agents, and configuration management runs launched by systemd timers."
    tuning_guidance = "Add approved update, backup and monitoring binaries to %global_allowed_admin_tools or %global_allowed_backup_processes. Add known-good vendor and update destinations to %global_allowed_domains. Add hosts that legitimately run scripted timers to %global_allowed_script_hosts. Raise severity for servers that should never initiate outbound traffic from shells."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.parent_process.file.full_path = /\/systemd$/ nocase
    $net.principal.process.file.full_path = /(^\/(tmp|var\/tmp|dev\/shm)\/)|(\/\.[^\/]+\/[^\/]+$)|(\/(curl|wget|nc|ncat|socat|bash|sh|dash|zsh|python[0-9.]*|perl|ruby|php)$)/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1053.006")
    $primary_entity = array_distinct($net.principal.hostname)
    $process_paths = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
