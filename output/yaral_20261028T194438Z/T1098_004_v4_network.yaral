/*
  MITRE Technique : T1098.004 - SSH Authorized Keys
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:46:00.638826+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_004_ESXi_External_Inbound_SSH_Session {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an SSH connection (TCP/22) to an ESXi host from a source outside internal address space and outside approved management sources. ESXi SSH should only be reachable from management networks or jump hosts. An external source reaching the SSH service is the network-side result of authorized_keys persistence (/etc/ssh/keys-<user>/authorized_keys): the adversary returns with a planted key from their own infrastructure. This is network-side coverage and complements endpoint command-line detections."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.004"
    mitre_technique_name = "Account Manipulation: SSH Authorized Keys"
    log_prerequisites = "Requires network connection telemetry for ESXi management interfaces (firewall, flow logs, or host connection logs) that populates principal.ip, target.hostname and target.port, normalised to NETWORK_CONNECTION."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Remote administrators connecting through a VPN or NAT egress address not yet in the allowlist, MSP or vendor support access, authorised external vulnerability scanners or penetration tests, and out-of-band management or backup servers on public addressing."
    tuning_guidance = "Add jump hosts, VPN egress and NAT addresses to %global_allowed_mgmt_sources. Add authorised scanner sources to %global_allowed_scanners. Because the rule keys on source address rather than key use, correlate hits with endpoint authorized_keys modification events on the same host. Any hit where SSH is exposed to the internet should be treated as a configuration finding in its own right."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 22
    $net.target.hostname != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1098.004")
    $primary_entity = array_distinct($net.target.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
