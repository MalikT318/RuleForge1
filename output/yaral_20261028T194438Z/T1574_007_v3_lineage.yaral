/*
  MITRE Technique : T1574.007 - Path Interception by PATH Environment Variable
  Tactic(s)       : Stealth, Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:34:24.476432+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_007_Native_Utility_Name_From_NonSystem_Path_Anomalous_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office application, web server, print spooler or database service spawning a child whose image name matches a native Windows system utility or interpreter, but whose file path is outside the trusted Windows system directories. This is the observable result of PATH search-order hijacking (T1574.007), where a planted binary such as net.exe is resolved ahead of the genuine System32 copy. The rule pivots on process lineage and image path, not on command-line content."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.007"
    mitre_technique_name = "Hijack Execution Flow: Path Interception by PATH Environment Variable"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry (EDR, Sysmon Event ID 1 or Security Event 4688 with full image paths) populating both the parent and child process file paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Portable or third-party builds of common utilities (for example Git for Windows, Cygwin or MSYS tools) launched by a web application or database job; legitimate application installers or updaters spawned by Office add-ins; side-by-side copies of cmd.exe or powershell.exe in application folders; web or database applications that ship their own helper binaries with native utility names."
    tuning_guidance = "Add approved parent processes to %global_allowed_admin_tools or %global_allowed_script_hosts. Extend the parent regex with environment-specific application servers. If a vendor legitimately ships a utility with a native name, allowlist its parent executable rather than the install directory."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Unexpected parent: Office, web server, print spooler, database service
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|spoolsv|sqlservr|mysqld|postgres|oracle)\.exe$/ nocase

    // Child image name matches a native Windows utility or interpreter
    $proc.target.process.file.full_path = /\\(net|net1|ipconfig|whoami|systeminfo|tasklist|nltest|netstat|hostname|cmd|powershell|schtasks|sc|reg|wmic|certutil|cscript|wscript|mshta|rundll32|regsvr32|bitsadmin|arp|nslookup|quser|query)\.exe$/ nocase

    // ...but it is not running from a trusted Windows system location
    not $proc.target.process.file.full_path = /\\windows\\(system32|syswow64|sysnative|winsxs)\\/ nocase

    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1574.007")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
