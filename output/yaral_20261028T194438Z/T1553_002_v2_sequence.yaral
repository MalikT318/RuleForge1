/*
  MITRE Technique : T1553.002 - Code Signing
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:00:47.948137+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_002_Cert_Material_Staged_Then_Trust_Store_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a certificate/private-key container file (.pfx, .p12, .pvk, .spc) being written on a host, followed within 10 minutes by a modification of the machine or user Root, TrustedPublisher or TrustedPeople certificate store on the same host. This pattern is consistent with an adversary staging stolen or self-made code signing material and making it trusted so signed malware passes signature-based execution controls. It does not rely on process command lines."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.002"
    mitre_technique_name = "Subvert Trust Controls: Code Signing"
    log_prerequisites = "Requires EDR or Sysmon file creation telemetry (Sysmon EID 11) and registry modification telemetry (Sysmon EID 12/13) with the writing process populated. Registry auditing of HKLM and HKU SystemCertificates keys must be enabled if the source does not capture it by default."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or PKI enrolment tooling that exports a PFX and imports a certificate into the trust store; software installers that deploy a vendor publisher certificate; Group Policy or MDM certificate deployment; developer workstations that create test code signing certificates; Windows root certificate auto-update (excluded for svchost)."
    tuning_guidance = "Add PKI, MDM and deployment tooling executables to %global_allowed_admin_tools. Add EDR and AV agents to %global_allowed_security_tools. Add PKI administrator accounts to %global_allowed_admin_users. For developer or build hosts, consider tightening the file path filter or scoping the rule away from those hosts via the allowlists."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(pfx|p12|pvk|spc)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SystemCertificates\\(Root|TrustedPublisher|TrustedPeople)\\Certificates\\/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path = /\\(svchost|MsMpEng)\.exe$/ nocase
    not $reg.principal.user.userid in %global_allowed_admin_users
    $reg.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1553.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $staged_cert_files = array_distinct($file.target.file.full_path)
    $file_writer_processes = array_distinct($file.principal.process.file.full_path)
    $trust_store_keys = array_distinct($reg.target.registry.registry_key)
    $registry_writer_processes = array_distinct($reg.principal.process.file.full_path)
    $acting_users = array_distinct($reg.principal.user.userid)

  condition:
    $file and $reg
}
