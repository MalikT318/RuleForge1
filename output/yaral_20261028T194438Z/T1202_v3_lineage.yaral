/*
  MITRE Technique : T1202 - Indirect Command Execution
  Tactic(s)       : Stealth
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:53:48.357614+00:00
  Reference       : https://attack.mitre.org/techniques/T1202
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1202_Indirect_Exec_Utility_From_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a built-in indirect command execution utility (forfiles, pcalua, scriptrunner, ssh, wsl, bash) launched with command-execution switches by a parent that should not spawn it: an Office application, web server worker, print spooler or database service. Pivots on process lineage, not on the payload."
    mitre_tactic = "Stealth"
    mitre_technique = "T1202"
    mitre_technique_name = "Indirect Command Execution"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent and child image paths and full command lines (EDR, Sysmon Event ID 1 or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros or add-ins in legitimate line-of-business workflows that call forfiles or ssh. Web applications that deliberately shell out to ssh or forfiles for maintenance jobs. Database maintenance jobs (SQL Agent) calling forfiles to purge old backups. Developer workstations where Office or IDE tooling invokes wsl or bash."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts or %global_allowed_admin_tools. Add EDR/AV parents to %global_allowed_security_tools. Add known maintenance hosts to %global_allowed_script_hosts. To narrow the parent set, edit the parent regex. Raise severity for internet-facing web server parents."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|php-cgi|tomcat\d*|spoolsv|sqlservr|mysqld|postgres|oracle)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(forfiles|pcalua|scriptrunner|ssh|wsl|bash)\.exe$/ nocase
    $proc.target.process.command_line = /(\s\/c\s|\s-a\s|-appvscript|proxycommand|localcommand|\s(-e|--exec|-c)\s)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1202")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
