/*
  MITRE Technique : T1552.008 - Chat Messages
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:56:59.773474+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_008_Chat_Read_Permission_Grant_To_Application {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an identity-provider permission or consent change that grants an application or user delegated rights to read chat, channel, direct-message or mailbox content. This is the configuration change adversaries make to harvest credentials shared in chat (T1552.008) through rogue OAuth apps or integrations. It targets the resulting permission state, not any command line."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.008"
    mitre_technique_name = "Unsecured Credentials: Chat Messages"
    log_prerequisites = "Identity provider directory/audit logs that record app consent and permission grants, with granted scopes or permission names normalised into UDM target.permissions.name."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Legitimate onboarding of approved collaboration, archiving, eDiscovery, DLP, chatbot or helpdesk integrations; administrators pre-consenting enterprise applications; migration projects."
    tuning_guidance = "Add approved integration or service-principal identifiers to %global_allowed_cloud_principals and administrators who legitimately grant consent to %global_allowed_admin_users. Add approved automation accounts to %global_allowed_service_accounts. If the scope regex is too broad, remove Mail.Read from it."

  events:
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.target.permissions.name = /(Chat\.Read|ChatMessage\.Read|ChannelMessage\.Read|Mail\.Read|channels:history|groups:history|im:history|mpim:history|search:read)/ nocase
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.target.application in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1552.008")
    $primary_entity = array_distinct($perm.principal.user.userid)
    $granted_permissions = array_distinct($perm.target.permissions.name)
    $target_application = array_distinct($perm.target.application)
    $source_ips = array_distinct($perm.principal.ip)

  condition:
    $perm
}
