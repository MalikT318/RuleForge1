/*
  MITRE Technique : T1599.001 - Network Address Translation Traversal
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:01:48.929857+00:00
  Reference       : https://attack.mitre.org/techniques/T1599/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1599_001_NAT_Traversal_External_To_Internal_Admin_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a perimeter connection from an external (non-internal) source address to an internal address on a remote-administration or file-sharing port. Internal addresses are not Internet-routable, so a connection that reaches one from outside suggests a malicious NAT, port-forward, or destination-translation rule on the boundary device. Such a rule would let an adversary bridge the untrusted and trusted networks."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1599.001"
    mitre_technique_name = "Network Boundary Bridging: Network Address Translation Traversal"
    log_prerequisites = "Firewall or perimeter connection logs that record the post-NAT (translated) destination IP and port, or the internal-side view of the session, normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Pre-NAT-only logs will not expose the translated internal destination."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate published services using approved port forwarding or DNAT, such as VPN concentrators, jump hosts or bastions, and remote-support gateways. Authorised vulnerability scanners and penetration tests. Partner or MSP management connectivity. Firewall logs that record the internal address as the destination for load-balanced services."
    tuning_guidance = "Add approved external management sources to %global_allowed_mgmt_sources and authorised scanners to %global_allowed_scanners. Keep the destination ports to the admin services that should never be reachable from outside. Use per-client baselining of intentionally published services, and exclude them by source list rather than by hardcoded address."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 135 or
      $net.target.port = 139 or
      $net.target.port = 445 or
      $net.target.port = 3389 or
      $net.target.port = 5985 or
      $net.target.port = 5986 or
      $net.target.port = 5900
    )
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1599.001")
    $primary_entity = array_distinct($net.target.ip)
    $external_sources = array_distinct($net.principal.ip)
    $internal_targets = array_distinct($net.target.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
