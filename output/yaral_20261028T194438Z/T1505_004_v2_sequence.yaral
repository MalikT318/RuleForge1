/*
  MITRE Technique : T1505.004 - IIS Components
  Tactic(s)       : Persistence
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:31:26.386462+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_004_IIS_Native_Module_Dropped_Then_Config_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a DLL written into an IIS program or web content directory, followed within ten minutes on the same host by a modification of the IIS configuration files (applicationHost.config or administration.config) by a non-approved process. This sequence is typical of installing a malicious ISAPI extension, filter or native IIS module for persistence."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.004"
    mitre_technique_name = "Server Software Component: IIS Components"
    log_prerequisites = "Requires EDR or Sysmon file creation and file modification telemetry (Sysmon Event IDs 11 and 2/23 equivalents) with target.file.full_path and principal.process.file.full_path populated on IIS servers."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IIS role or feature installation, Windows servicing and cumulative updates, web application deployment pipelines that publish DLLs and update site bindings, IIS administrators using management tooling, third-party IIS modules such as URL Rewrite, WAF agents and APM agents during install or upgrade."
    tuning_guidance = "Add approved deployment and IIS management binaries to %global_allowed_admin_tools, security agent updaters to %global_allowed_security_tools, and CI/CD or deployment accounts to %global_allowed_service_accounts. Adjust the DLL path regex if web content roots are customised in the client environment."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(inetsrv|inetpub|wwwroot)\\.*\.dll$/ nocase
    not $file.target.file.full_path = /\\Temporary ASP\.NET Files\\/ nocase
    not $file.principal.process.file.full_path = /\\(TiWorker|TrustedInstaller|msiexec|wuauclt|w3wp)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    $cfg.metadata.event_type = "FILE_MODIFICATION"
    $cfg.target.file.full_path = /\\inetsrv\\config\\(applicationHost|administration)\.config$/ nocase
    not $cfg.principal.process.file.full_path = /\\(TiWorker|TrustedInstaller|msiexec|wuauclt)\.exe$/ nocase
    not $cfg.principal.process.file.full_path in %global_allowed_admin_tools
    not $cfg.principal.user.userid in %global_allowed_service_accounts
    $cfg.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $cfg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1505.004")
    $primary_entity = array_distinct($hostname)
    $dropped_dlls = array_distinct($file.target.file.full_path)
    $dropper_processes = array_distinct($file.principal.process.file.full_path)
    $modified_configs = array_distinct($cfg.target.file.full_path)
    $config_writers = array_distinct($cfg.principal.process.file.full_path)
    $acting_users = array_distinct($cfg.principal.user.userid)

  condition:
    $file and $cfg
}
