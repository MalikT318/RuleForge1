/*
  MITRE Technique : T1195.001 - Compromise Software Dependencies and Development Tools
  Tactic(s)       : Initial Access
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:40:37.723176+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_001_Package_Manager_Fetch_From_Unapproved_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows developer or build host whose package manager client (npm, pip, yarn, pnpm, NuGet, etc.) makes an outbound HTTP request to a destination outside the approved domain list. The proxy or firewall sees the package-client user agent, so this is a network-side signal of dependency retrieval from a typosquatted, hijacked, or attacker-hosted registry or mirror."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.001"
    mitre_technique_name = "Supply Chain Compromise: Compromise Software Dependencies and Development Tools"
    log_prerequisites = "Requires proxy or firewall logs with HTTP inspection that populate network.http.user_agent and target.hostname (for HTTPS, TLS interception or an explicit proxy). Populate %global_allowed_domains with the client's legitimate package registries and mirrors."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Developers legitimately using a new or private registry, vendor SDK download sites, language-ecosystem CDNs not yet in the allowlist, self-hosted artifact mirrors, and new CI build agents."
    tuning_guidance = "Add legitimate registries and mirrors (public and private artifact repositories, vendor CDNs) to %global_allowed_domains. Add known build servers and developer workstations to %global_allowed_script_hosts. Internal destinations are excluded via %rfc1918_internal. To reduce volume further, require a package-file URL pattern on target.url if the proxy logs full URLs."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /(^|[\s\/(])(npm|pip|yarn|pnpm|nuget|poetry|pipenv|conda|bower|composer|gem|cargo|go-http-client)(\/|\s|$|\()/ nocase
    $net.network.http.user_agent = /(win32|windows|nuget|dotnet|msbuild)/ nocase
    $net.target.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1195.001")
    $primary_entity = array_distinct($net.principal.ip)
    $source_hostnames = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $user_agents = array_distinct($net.network.http.user_agent)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
