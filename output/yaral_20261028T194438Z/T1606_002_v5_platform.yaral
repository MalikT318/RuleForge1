/*
  MITRE Technique : T1606.002 - SAML Tokens
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:25:55.780205+00:00
  Reference       : https://attack.mitre.org/techniques/T1606/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1606_002_Federation_Trust_Or_Token_Signing_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects identity provider directory audit events that change federation settings, domain authentication, trusted realms, or token-signing certificates. Attackers who plan to forge SAML tokens (Golden SAML) must first obtain the token-signing certificate or add a federation trust that accepts their own certificate. This rule uses identity control-plane telemetry only and does not rely on endpoint process fields."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1606.002"
    mitre_technique_name = "Forge Web Credentials: SAML Tokens"
    log_prerequisites = "Requires identity provider directory audit logs normalized to UDM with metadata.product_event_type and principal.user.userid populated. Federation and domain authentication audit categories must be enabled."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Planned federation onboarding or migration, scheduled token-signing certificate rollover, domain verification or authentication-type changes by the identity team, and identity automation tooling."
    tuning_guidance = "Add named identity administrators to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Tighten the product_event_type regex to match the operation names your identity provider emits if the log source uses different wording."

  events:
    $idp.metadata.event_type = "SETTING_MODIFICATION"
    $idp.metadata.product_event_type = /(set\s+federation\s+settings|set\s+domain\s+authentication|(add|new|set|update|create)\s+.*(federation|trusted\s*realm|token[\s_-]?signing))/ nocase
    $idp.principal.user.userid != ""
    not $idp.principal.user.userid in %global_allowed_admin_users
    not $idp.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1606.002")
    $primary_entity = array_distinct($idp.principal.user.userid)
    $operation = array_distinct($idp.metadata.product_event_type)
    $source_ips = array_distinct($idp.principal.ip)
    $target_resource = array_distinct($idp.target.resource.name)

  condition:
    $idp
}
