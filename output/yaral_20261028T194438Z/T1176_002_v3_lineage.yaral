/*
  MITRE Technique : T1176.002 - IDE Extensions
  Tactic(s)       : Persistence
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:29:11.498148+00:00
  Reference       : https://attack.mitre.org/techniques/T1176/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_002_Linux_IDE_Host_Spawns_Suspicious_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an IDE or IDE extension-host process (VS Code family, code-server, JetBrains runtime, Eclipse) spawning a shell or script interpreter whose command line shows download-and-execute, encoded payload decoding, reverse-shell or staged-binary behaviour. A malicious or abused IDE extension runs inside the IDE process tree, so this lineage anomaly indicates extension-based persistence or code execution."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176.002"
    mitre_technique_name = "Software Extensions: IDE Extensions"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry with parent process path and full child command line populated in UDM PROCESS_LAUNCH events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers running legitimate extension install or build scripts, language-server bootstrap scripts that download toolchains via curl or wget, dev-container or remote-development setup scripts, and IDE-integrated terminals running admin one-liners."
    tuning_guidance = "Add approved IDE parent processes or build tooling to %global_allowed_script_hosts or %global_allowed_admin_tools. Add sanctioned developer or automation accounts to %global_allowed_admin_users. Narrow or extend the command-line regex to match the client's developer workflow."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Parent: IDE binary, remote/server extension host (node), or JetBrains runtime
    (
      $proc.principal.process.file.full_path = /\/(\.vscode-server|\.vscode-oss|\.vscode|\.cursor-server|\.windsurf-server|vscode-server|code-server)\/.*\/node$/ nocase or
      $proc.principal.process.file.full_path = /\/(code|code-oss|codium|vscodium|code-server|cursor|windsurf|eclipse)$/ nocase or
      $proc.principal.process.file.full_path = /\/(idea|pycharm|goland|webstorm|clion|rubymine|phpstorm|rider|datagrip)[^\/]*\/jbr\/bin\/java$/ nocase
    )

    // Child: shell or script interpreter
    $proc.target.process.file.full_path = /\/(ba|da|z|k|a)?sh$|\/(python[0-9.]*|perl|ruby)$/ nocase

    // Child command line: suspicious combination of behaviours
    (
      $proc.target.process.command_line = /(curl|wget)\s[^|;]*\|\s*(\/\S+\/)?(ba|da|z)?sh\b/ nocase or
      $proc.target.process.command_line = /base64\s+(-d|--decode)/ nocase or
      $proc.target.process.command_line = /\/dev\/(tcp|udp)\// nocase or
      $proc.target.process.command_line = /\bnc(at)?\b.*\s-e\s/ nocase or
      $proc.target.process.command_line = /\bmkfifo\b/ nocase or
      $proc.target.process.command_line = /chmod\s+(\+x|[0-7]*7[0-7]*)\s+\/(tmp|dev\/shm|var\/tmp)\// nocase or
      $proc.target.process.command_line = /(python[0-9.]*|perl|ruby)\s+-(c|e)\s.*(socket|exec|system)/ nocase
    )

    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1176.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
