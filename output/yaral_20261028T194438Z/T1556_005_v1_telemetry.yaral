/*
  MITRE Technique : T1556.005 - Reversible Encryption
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:20:36.851507+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_005_Security_Policy_Template_Modified_Reversible_Encryption {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects modification of the Windows security policy template (GptTmpl.inf, the SecEdit section of a local or domain GPO) by a process that is not an approved admin tool, security tool, or replication service. The 'Store passwords using reversible encryption' policy (ClearTextPassword = 1 under [System Access]) is persisted in this file whether set through the Local Group Policy Editor, GPMC, or a scripted import. This rule works at the file-artifact layer, so it still fires when command-line logging is evaded. UDM does not expose file contents. Analysts must inspect the file for ClearTextPassword = 1 and review any AllowReversiblePasswordEncryption change on accounts."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.005"
    mitre_technique_name = "Modify Authentication Process: Reversible Encryption"
    log_prerequisites = "Requires EDR or Sysmon file-modification telemetry (Sysmon Event ID 11/23 or EDR equivalent) covering the Windows directory and SYSVOL paths on domain controllers and member servers."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate GPO edits by domain administrators through GPMC or gpedit, security baseline or compliance tooling (CIS/STIG hardening), configuration management agents pushing security templates, DFSR replication of SYSVOL, and image build or golden-image processes."
    tuning_guidance = "Add approved GPO editing or hardening tool binaries to %global_allowed_admin_tools, named GPO administrators to %global_allowed_admin_users, and EDR agents to %global_allowed_security_tools. Run first in alert-only mode on domain controllers to baseline normal GPO change windows. Escalate when the writer is not an admin tool, or when the file content contains ClearTextPassword = 1."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\\microsoft\\windows nt\\secedit\\gpttmpl\.inf$/ nocase
    not $file.principal.process.file.full_path = /\\(dfsrs|trustedinstaller|tiworker)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1556.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
