/*
  MITRE Technique : T1210 - Exploitation of Remote Services
  Tactic(s)       : Lateral Movement
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:16:40.361555+00:00
  Reference       : https://attack.mitre.org/techniques/T1210
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1210_ESXi_Untrusted_Login_Then_Host_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a login to an ESXi host from a source outside the approved management sources, followed within 10 minutes by a security-relevant host configuration change on the same host. Changes include enabling the SSH or shell service, altering shell timeouts, suppressing shell warnings, changing the firewall SSH ruleset, lockdown mode, account lockout or password policy, or syslog forwarding. This pattern fits exploitation of an exposed management service (hostd, SLP, authentication bypass) used for lateral movement, followed by preparation for persistence or defence evasion. It works from authentication and setting-change telemetry rather than process command lines."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1210"
    mitre_technique_name = "Exploitation of Remote Services"
    log_prerequisites = "ESXi hostd and shell/auth logs forwarded to Chronicle and parsed into USER_LOGIN and SETTING_MODIFICATION events, with the source address in principal.ip, the account in target.user.userid, the ESXi host in target.hostname, and the changed setting or service name in target.resource.name."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators connecting from a new jump host or VPN range not yet in the management source list; vCenter, automation or patching workflows that log in and change SSH or shell settings; planned maintenance or troubleshooting windows; host build or remediation scripts."
    tuning_guidance = "Add approved management, jump host and vCenter source addresses to %global_allowed_mgmt_sources. Add named admin accounts to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. If the parser places the ESXi host name in principal.hostname rather than target.hostname for either event, adjust the join fields on both events to match. Extend the setting name regex with local hardening baselines as needed."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.hostname = $hostname
    $auth.principal.ip != ""
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.target.user.userid in %global_allowed_service_accounts

    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.target.hostname = $hostname
    $setting.target.resource.name = /(TSM|ESXiShell|SuppressShellWarning|sshServer|DcuiTimeOut|lockdown|AccountLockFailures|AccountUnlockTime|PasswordQualityControl|Syslog\.global|SSH)/ nocase
    not $setting.principal.user.userid in %global_allowed_service_accounts

    $auth.metadata.event_timestamp.seconds <= $setting.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1210")
    $primary_entity = array_distinct($setting.target.hostname)
    $source_ips = array_distinct($auth.principal.ip)
    $login_users = array_distinct($auth.target.user.userid)
    $changed_settings = array_distinct($setting.target.resource.name)
    $setting_count = count($setting.metadata.id)

  condition:
    $auth and $setting
}
