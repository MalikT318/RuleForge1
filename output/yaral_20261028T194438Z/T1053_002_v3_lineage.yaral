/*
  MITRE Technique : T1053.002 - At
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:12:49.990938+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_002_Linux_At_Spawned_By_Service_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the at/batch job scheduling binary being launched by a web server, application server, or database service process. These services have no legitimate need to schedule at jobs, so this lineage suggests a web shell, injection, or compromised service account using at for deferred execution or persistence. Detection relies on process lineage (parent and child image paths), not command-line content."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.002"
    mitre_technique_name = "Scheduled Task/Job: At"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records normalized to UDM PROCESS_LAUNCH with populated parent and child process paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Self-hosted application stacks (CMS, backup or report plugins, hosting control panels) that schedule deferred jobs via at from PHP or Java. Database maintenance wrappers run under a service parent. Application servers launched via java or node that run legitimate admin scripts."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts. Add approved scheduling wrappers to %global_allowed_admin_tools. If the java or node parent alternatives are too noisy, remove them from the parent regex for that tenant."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(at|batch)$/ nocase
    $proc.principal.process.file.full_path = /\/(httpd|apache2|nginx|lighttpd|php-fpm[0-9.]*|php[0-9.]*|gunicorn|uwsgi|tomcat[0-9]*|java|node|mysqld|mariadbd|postgres|mongod|redis-server)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1053.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
