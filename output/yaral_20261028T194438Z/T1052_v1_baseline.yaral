/*
  MITRE Technique : T1052 - Exfiltration Over Physical Medium
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:40:45.964972+00:00
  Reference       : https://attack.mitre.org/techniques/T1052
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1052_Bulk_Copy_To_NonSystem_Drive_Letter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a native copy utility or script interpreter (robocopy, xcopy, cmd copy/move, PowerShell Copy-Item/Move-Item) that copies data from the system drive (C:) to another drive letter. This is the usual mechanism for staging data onto removable media (USB or external disk) as exfiltration over a physical medium. Detection keys on the command-line combination of copy verb, C: source and non-C: destination, not on tool names alone."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1052"
    mitre_technique_name = "Exfiltration Over Physical Medium"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command lines (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and imaging jobs, administrators moving data to secondary internal volumes or mapped drives, software deployment scripts, user profile migrations, developers copying build output to a data partition."
    tuning_guidance = "Add approved backup tooling to %global_allowed_backup_processes, IT and deployment tooling to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and named administrators to %global_allowed_admin_users. On hosts with a secondary fixed data volume, tune by allowlisting the parent process or the account. To raise fidelity, pair this rule with removable-device insertion telemetry."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(robocopy|xcopy|cmd|powershell|pwsh)\.exe$/ nocase
    $proc.target.process.command_line = /\b(robocopy|xcopy|copy-item|copy|move-item|move|cp)\b/ nocase
    $proc.target.process.command_line = /\s["']?c:\\[^\r\n]*\s["']?[d-z]:\\/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1052")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
