/*
  MITRE Technique : T1059.013 - Container CLI/API
  Tactic(s)       : Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:26:30.619242+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_013_K8s_API_Pod_Exec_Attach {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects use of the Kubernetes API to open an interactive exec or attach session into a running pod. Adversaries with stolen credentials or tokens use this control-plane path to run arbitrary commands inside containers without touching the node or relying on in-container process telemetry."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.013"
    mitre_technique_name = "Command and Scripting Interpreter: Container CLI/API"
    log_prerequisites = "Kubernetes API server audit logging enabled at Metadata level or higher, covering the pods/exec and pods/attach subresources. Logs must be ingested and normalised to UDM USER_RESOURCE_ACCESS."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Developers and SREs debugging workloads, break-glass incident response, CI/CD or GitOps jobs running smoke tests with exec, and approved remote-management or debugging tooling."
    tuning_guidance = "Add named administrators to %global_allowed_admin_users, automation identities to %global_allowed_service_accounts, and approved cloud or cluster principals to %global_allowed_cloud_principals. Add trusted source addresses to %global_allowed_mgmt_sources. Consider raising severity for production namespaces or for first-time users."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    (
      $cloud.target.resource.name = /pods\/([^\/]+\/)?(exec|attach)/ nocase or
      $cloud.target.url = /pods\/[^\/]+\/(exec|attach)/ nocase
    )
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid = /^system:node:/ nocase
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1059.013")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $target_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
