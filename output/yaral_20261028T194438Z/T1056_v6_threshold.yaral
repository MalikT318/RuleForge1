/*
  MITRE Technique : T1056 - Input Capture
  Tactic(s)       : Collection, Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:45:37.605438+00:00
  Reference       : https://attack.mitre.org/techniques/T1056
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1056_003_Repeated_External_POST_Single_Host_Destination {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source sends a high volume of HTTP POST requests to one external destination within ten minutes. Each POST is benign on its own. A sustained burst to the same unrecognised external endpoint is consistent with captured user input (credentials or keystrokes) being submitted to a spoofed web portal or a collection server (T1056.003 Web Portal Capture, T1056.001 Keylogging exfiltration)."
    mitre_tactic = "Collection, Credential Access"
    mitre_technique = "T1056"
    mitre_technique_name = "Input Capture"
    log_prerequisites = "Firewall or proxy logs that normalise to NETWORK_HTTP with network.http.method, principal.ip and target.ip populated. Requires TLS inspection or a proxy that logs the HTTP method for HTTPS traffic."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Web applications and SaaS platforms that post frequently to a single backend (chat, collaboration, telemetry, analytics beacons), API integrations and automation, browser-based form-heavy business apps, authorised vulnerability scanners and penetration tests, software update or crash-report uploaders."
    tuning_guidance = "Add known-good vendor and SaaS domains to %global_allowed_domains. Add scanner and test sources to %global_allowed_scanners. Raise the #http threshold (default 20) in high-chatter environments, or lower it for high-security segments. Review the destination_ips and destination_hosts outcome values to confirm the destination is unknown or newly seen before escalating."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.principal.ip = $src
    $http.target.ip = $dst
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  match:
    $src, $dst over 10m

  outcome:
    $risk_score = max(55)
    $event_count = count($http.metadata.id)
    $mitre_technique_id = array_distinct("T1056")
    $primary_entity = array_distinct($src)
    $destination_ips = array_distinct($dst)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ports = array_distinct($http.target.port)

  condition:
    #http >= 20
}
