/*
  MITRE Technique : T1082 - System Information Discovery
  Tactic(s)       : Discovery
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:49:22.820231+00:00
  Reference       : https://attack.mitre.org/techniques/T1082
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1082_Windows_Scripted_Client_External_Host_Lookup {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows scripting or command-line HTTP client, such as PowerShell, WinHTTP or curl, requesting an external host-identification or geolocation style URL path. Proxy or firewall logs show this when an adversary or malware profiles a compromised host (public IP, geography, network context) to decide on follow-on actions. It is the network-side counterpart of endpoint system-discovery rules and does not depend on process or command-line telemetry."
    mitre_tactic = "Discovery"
    mitre_technique = "T1082"
    mitre_technique_name = "System Information Discovery"
    log_prerequisites = "Requires proxy or firewall logs with HTTP inspection (URL path and user-agent) normalised to UDM NETWORK_HTTP. Pure L3/L4 firewall logs without URL visibility will not trigger this rule."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Administrator or RMM scripts that check the public IP for inventory or DDNS updates, monitoring or health-check scripts using PowerShell or curl, software installers that run geolocation checks, and developer workstations testing APIs."
    tuning_guidance = "Add approved external vendor and update domains to %global_allowed_domains. Add admin or automation hosts to %global_allowed_script_hosts. If the proxy does not populate target.hostname, tune on target.url instead. Raise severity when the source host is a server or the event is paired with endpoint discovery alerts."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /(WindowsPowerShell|PowerShell|WinHttp|curl)/ nocase
    $net.target.url = /\/(ip|myip|my-ip|geo|geoip|whoami|checkip|ipinfo|ifconfig|country|location)(\.php|\.txt|\.json)?\/?(\?.*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1082")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
