/*
  MITRE Technique : T1003.005 - Cached Domain Credentials
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:45:06.086800+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_005_Linux_Service_Parent_Spawns_Cred_Cache_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server, database, print or file-sharing service process spawning a child process that references the SSSD or Quest Authentication Services cached credential stores. These services should never launch processes that touch the domain credential cache. This lineage usually means a compromised service (webshell, SQL command execution, RCE) is being used to harvest cached domain credential hashes for offline cracking."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.005"
    mitre_technique_name = "OS Credential Dumping: Cached Domain Credentials"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry normalized to UDM PROCESS_LAUNCH with populated parent process path (principal.process.file.full_path), child process path and command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Rare. Possible sources are custom health-check or monitoring scripts launched by an application service that inspect SSSD cache files, configuration management or backup hooks started from a database or Java service, and authorised penetration tests."
    tuning_guidance = "Add approved monitoring or hook binaries to %global_allowed_admin_tools (parent path) and backup tooling to %global_allowed_backup_processes (child path). Extend the parent service regex if the client runs other internet-facing services that should never touch the credential cache."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|php-fpm[0-9.]*|php-cgi|tomcat[0-9]*|java|node|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|smbd)$/ nocase
    $proc.target.process.command_line = /(\/var\/lib\/sss\/(db|secrets)\/|\/var\/opt\/quest\/vas\/authcache\/|cache_[^\s\/]+\.ldb|vas_auth\.vdb)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1003.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
