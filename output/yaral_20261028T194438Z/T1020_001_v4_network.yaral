/*
  MITRE Technique : T1020.001 - Traffic Duplication
  Tactic(s)       : Exfiltration
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:32:00.910253+00:00
  Reference       : https://attack.mitre.org/techniques/T1020/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1020_001_Mirroring_Encapsulation_To_External_Destination {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects perimeter-observed traffic-mirroring encapsulation (GRE/ERSPAN, VXLAN, Geneve, or TZSP packet-sniffer streaming) sent to a non-internal destination. Legitimate mirroring normally terminates on internal analyzers. A mirror session that leaves the network suggests that an adversary reconfigured a network device or cloud mirror session to duplicate traffic to infrastructure they control."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1020.001"
    mitre_technique_name = "Automated Exfiltration: Traffic Duplication"
    log_prerequisites = "Requires firewall or perimeter connection logs that populate network.ip_protocol and target.port, with egress traffic logged for GRE and UDP encapsulation ports (4789, 6081, 37008)."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Managed network monitoring or NDR services that receive mirrored traffic over an approved tunnel; SD-WAN or site-to-site GRE tunnels to external peers; cloud-hosted security analytics sensors; overlay networks (VXLAN/Geneve) spanning sites over public transit."
    tuning_guidance = "Add approved external analyzer or tunnel-peer hostnames to %global_allowed_domains. Confirm that %rfc1918_internal covers all internal address space for the client. For GRE-based WAN tunnels, review the peers and allowlist them by target hostname. If the client does not use the listed UDP overlay ports for other purposes, consider raising severity."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.network.ip_protocol = "GRE" or
      $net.target.port = 4789 or
      $net.target.port = 6081 or
      $net.target.port = 37008
    )
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1020.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $ip_protocols = array_distinct($net.network.ip_protocol)

  condition:
    $net
}
