/*
  MITRE Technique : T1059.008 - Network Device CLI
  Tactic(s)       : Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:18:45.075259+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_008_Network_Device_Mgmt_CLI_Port_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single source opens a high volume of connections to remote CLI management ports (telnet, SSH, NETCONF over SSH) within ten minutes, and the source is not an approved management source or scanner. Each connection is benign on its own. The volume suggests brute-forcing, scripted CLI access or automated command execution against network devices."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.008"
    mitre_technique_name = "Command and Scripting Interpreter: Network Device CLI"
    log_prerequisites = "Firewall or perimeter connection logs that record source IP, destination IP and destination port, normalised to NETWORK_CONNECTION. Management-plane traffic must traverse the logging firewall."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Network automation platforms (config backup, compliance checks, orchestration), NMS/monitoring pollers, jump hosts, and admins running scripted bulk changes. Authorised vulnerability scanners that are not yet in the allowlist."
    tuning_guidance = "Add automation, NMS and jump-host source addresses to %global_allowed_mgmt_sources and approved scanners to %global_allowed_scanners. Raise the threshold in the condition for environments with heavy automation. Add or remove management ports in the events block to match the client's device estate."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 22 or $net.target.port = 23 or $net.target.port = 830
    $net.principal.ip = $src_ip
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src_ip over 10m

  outcome:
    $event_count = count($net.metadata.id)
    $risk_score = max(if(count($net.metadata.id) >= 100, 80, if(count($net.metadata.id) >= 40, 65, 50)))
    $mitre_technique_id = array_distinct("T1059.008")
    $primary_entity = array_distinct($src_ip)
    $target_devices = array_distinct($net.target.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    #net >= 20
}
