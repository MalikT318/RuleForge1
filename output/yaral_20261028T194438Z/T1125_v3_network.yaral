/*
  MITRE Technique : T1125 - Video Capture
  Tactic(s)       : Collection
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:33:20.234333+00:00
  Reference       : https://attack.mitre.org/techniques/T1125
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1125_Linux_Outbound_Video_Stream_Protocols_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host opening an outbound connection to an external address on a standard video-streaming port (RTSP 554/8554 or RTMP 1935). A compromised Linux host that has captured webcam or video-device output may push the stream or recorded footage to attacker infrastructure using these protocols. Perimeter logs do not identify the initiating process or the host OS, so the rule is best applied to Linux server and workstation segments where outbound video streaming is not expected."
    mitre_tactic = "Collection"
    mitre_technique = "T1125"
    mitre_technique_name = "Video Capture"
    log_prerequisites = "Requires firewall or proxy perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. The %rfc1918_internal reference list must be populated."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Authorised IP camera or CCTV cloud-relay services, video conferencing or live-streaming appliances, media or broadcast servers publishing RTMP to a CDN, and developers testing streaming software."
    tuning_guidance = "Add known-good streaming vendor and CDN domains to %global_allowed_domains. Scope the rule to Linux server and workstation address groups where outbound streaming is not business-expected. Review the bytes_out outcome to prioritise sustained uploads over short probes."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 554 or
      $net.target.port = 8554 or
      $net.target.port = 1935
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1125")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $bytes_out = max($net.network.sent_bytes)

  condition:
    $net
}
