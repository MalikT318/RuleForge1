/*
  MITRE Technique : T1486 - Data Encrypted for Impact
  Tactic(s)       : Impact
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 1h
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:02:01.030210+00:00
  Reference       : https://attack.mitre.org/techniques/T1486
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1486_Mass_User_File_Modification_By_Single_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single process on a single host modified a large number of common user-data files (documents, databases, images, archives, VM disks) within one hour. Each modification is benign on its own. The volume from one non-allowlisted process matches the bulk in-place encryption phase of ransomware, whatever the binary is named or what extension is appended."
    mitre_tactic = "Impact"
    mitre_technique = "T1486"
    mitre_technique_name = "Data Encrypted for Impact"
    log_prerequisites = "Requires endpoint file-modification telemetry (EDR or Sysmon-equivalent) that populates principal.process.file.full_path and target.file.full_path for FILE_MODIFICATION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and imaging agents, bulk document migration or conversion tools, file-sync clients doing initial sync, archive or compression utilities, antivirus remediation, developer build tools touching archives, and bulk-edit scripts run by administrators."
    tuning_guidance = "Add approved backup software to %global_allowed_backup_processes, EDR/AV agents to %global_allowed_security_tools, and deployment or migration tooling to %global_allowed_admin_tools. Raise the #file threshold (200) for file servers or sync-heavy hosts, and lower it for workstations with low baseline file churn."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\.(docx?|xlsx?|pptx?|pdf|rtf|odt|txt|csv|jpe?g|png|gif|bmp|psd|mp3|mp4|mov|avi|zip|7z|rar|sql|mdb|accdb|sqlite|bak|vmdk|vhdx|pst|ost)$/ nocase
    $file.principal.hostname = $host
    $file.principal.process.file.full_path = $actor
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|OneDrive|SearchIndexer|TiWorker|TrustedInstaller)\.exe$/ nocase

  match:
    $host, $actor over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1486")
    $primary_entity = array_distinct($host)
    $actor_process = array_distinct($actor)
    $modified_file_count = count($file.metadata.id)
    $affected_users = array_distinct($file.principal.user.userid)
    $sample_files = array_distinct($file.target.file.full_path)

  condition:
    #file >= 200
}
