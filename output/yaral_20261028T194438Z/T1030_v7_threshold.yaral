/*
  MITRE Technique : T1030 - Data Transfer Size Limits
  Tactic(s)       : Exfiltration
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:53:02.327104+00:00
  Reference       : https://attack.mitre.org/techniques/T1030
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1030_Linux_Repeated_Data_Chunking_Commands {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated use of native Linux chunking utilities (split with byte-size flags, dd with skip offsets) on a single host within 10 minutes. Each invocation is benign alone. Repeated fixed-size splitting or offset reads are consistent with staging data into uniform chunks to stay under network transfer-size alerting."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1030"
    mitre_technique_name = "Data Transfer Size Limits"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to UDM PROCESS_LAUNCH with full command-line capture."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup and imaging jobs, log-rotation or archive scripts, database dump splitting, ISO or disk image handling, developers splitting large files for upload limits, and forensic imaging with dd."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes. Add approved IT tooling to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Raise the #proc threshold on hosts that run frequent legitimate data-processing pipelines."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(split|dd)$/ nocase
    $proc.target.process.command_line = /(\s-[bC]\s*\d+[kKmMgG]?[bB]?(\s|$)|\s--(bytes|line-bytes)[=\s]\d+|\sskip=\d+)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(55)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1030")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $chunk_commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 5
}
