/*
  MITRE Technique : T1498.002 - Reflection Amplification
  Tactic(s)       : Impact
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:13:53.410854+00:00
  Reference       : https://attack.mitre.org/techniques/T1498/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_002_Reflection_Amplification_Multi_Reflector_Inbound {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the victim-side pattern of a reflection amplification DoS against a protected Windows host. Unsolicited inbound UDP traffic arrives from external addresses on well-known amplification source ports (DNS, NTP, SNMP, CLDAP, SSDP, memcached, chargen). It is followed within 10 minutes by a large UDP response from a different external reflector to the same destination host. Two or more distinct reflectors converging on one internal host is the signature of reflected traffic rather than a normal client-server exchange."
    mitre_tactic = "Impact"
    mitre_technique = "T1498.002"
    mitre_technique_name = "Network Denial of Service: Reflection Amplification"
    log_prerequisites = "Perimeter firewall or flow logs with UDP flow records, including source port, destination IP and bytes sent, parsed into UDM NETWORK_FLOW. Inbound traffic must be logged, including permitted and sampled flows."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate DNS, NTP or SNMP replies to a host that recently sent queries to several external servers (for example a Windows DNS server doing recursive resolution, a domain controller syncing time with several external NTP peers, or a monitoring server polling SNMP devices through the perimeter). Authorised vulnerability or load-testing sources. Firewall flow logs that log reply traffic as a separate inbound flow."
    tuning_guidance = "Add authorised scanners and test sources to %global_allowed_scanners. For recursive DNS servers or NTP clients that legitimately talk to many external servers, raise the byte threshold or exclude those destination IPs through client-specific enrichment. Adjust the amplification port list to match the protocols exposed in the environment."

  events:
    $amp1.metadata.event_type = "NETWORK_FLOW"
    $amp1.network.ip_protocol = "UDP"
    (
      $amp1.principal.port = 19 or
      $amp1.principal.port = 53 or
      $amp1.principal.port = 123 or
      $amp1.principal.port = 161 or
      $amp1.principal.port = 389 or
      $amp1.principal.port = 1900 or
      $amp1.principal.port = 11211
    )
    not $amp1.principal.ip in %rfc1918_internal
    not $amp1.principal.ip in %global_allowed_scanners
    $amp1.target.ip = $victim

    $amp2.metadata.event_type = "NETWORK_FLOW"
    $amp2.network.ip_protocol = "UDP"
    (
      $amp2.principal.port = 19 or
      $amp2.principal.port = 53 or
      $amp2.principal.port = 123 or
      $amp2.principal.port = 161 or
      $amp2.principal.port = 389 or
      $amp2.principal.port = 1900 or
      $amp2.principal.port = 11211
    )
    $amp2.network.sent_bytes >= 1000
    not $amp2.principal.ip in %rfc1918_internal
    not $amp2.principal.ip in %global_allowed_scanners
    $amp2.target.ip = $victim

    $amp1.principal.ip != $amp2.principal.ip
    $amp1.metadata.event_timestamp.seconds <= $amp2.metadata.event_timestamp.seconds

  match:
    $victim over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1498.002")
    $primary_entity = array_distinct($victim)
    $reflector_ips_first = array_distinct($amp1.principal.ip)
    $reflector_ips_second = array_distinct($amp2.principal.ip)
    $reflector_ports = array_distinct($amp2.principal.port)
    $largest_response_bytes = max($amp2.network.sent_bytes)
    $inbound_flow_count = count($amp1.metadata.id)

  condition:
    $amp1 and $amp2
}
