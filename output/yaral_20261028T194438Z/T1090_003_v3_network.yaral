/*
  MITRE Technique : T1090.003 - Multi-hop Proxy
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:30:46.018747+00:00
  Reference       : https://attack.mitre.org/techniques/T1090/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1090_003_Linux_DNS_Onion_Resolution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects DNS queries for the .onion special-use TLD, including the common pattern of a .onion label followed by a gateway suffix (for example .onion.<tld>). Legitimate resolvers never resolve .onion names. A query reaching DNS logs indicates a Tor-aware client, a Tor-to-web gateway lookup, or a proxy chain that leaks name resolution, all of which are characteristic of multi-hop proxy use for C2 or exfiltration. Detection is network-side only and is additive to endpoint command-line rules."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1090.003"
    mitre_technique_name = "Proxy: Multi-hop Proxy"
    log_prerequisites = "Requires DNS query or resolver logs normalized to UDM NETWORK_DNS with network.dns.questions.name populated. Logs should come from the recursive resolver serving Linux servers and workstations."
    platform = "Linux"
    log_source = "dns"
    false_positives = "Security researchers or threat-intelligence analysts investigating onion services, authorised red-team or penetration-test activity, security tooling that checks Tor or darknet reachability, and DNS sinkhole or monitoring tests that deliberately query .onion names."
    tuning_guidance = "Add known-good domains to %global_allowed_domains. Add the hostnames of authorised research or testing hosts to %global_allowed_scanners. The %rfc1918_internal exclusion is not applied to the target address because the target of a DNS query is normally an internal resolver. If your DNS logs record the client in principal.hostname, scope exclusions there. If a client resolves .onion names through a forwarder, review the forwarder's upstream logs."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /\.onion(\.[a-z]{2,10})?\.?$/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1090.003")
    $primary_entity = array_distinct($dns.principal.hostname)
    $client_ip = array_distinct($dns.principal.ip)
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $resolver_ip = array_distinct($dns.target.ip)

  condition:
    $dns
}
