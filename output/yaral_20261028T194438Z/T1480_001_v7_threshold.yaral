/*
  MITRE Technique : T1480.001 - Environmental Keying
  Tactic(s)       : Stealth
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:26:30.334767+00:00
  Reference       : https://attack.mitre.org/techniques/T1480/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1480_001_Env_Value_Harvest_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of host and domain identity queries (hardware UUID, volume serial, MAC, domain, computer name) issued by script interpreters on a single host within ten minutes. Each query is benign alone. Gathering several environment-specific values in quick succession is consistent with a payload deriving a decryption key from the target environment (environmental keying) before it executes."
    mitre_tactic = "Stealth"
    mitre_technique = "T1480.001"
    mitre_technique_name = "Execution Guardrails: Environmental Keying"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command lines (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT inventory and asset-collection scripts, RMM health checks, software licensing and activation checks, login scripts that read %USERDOMAIN% or %COMPUTERNAME%, administrators troubleshooting from a shell, imaging and provisioning tasks."
    tuning_guidance = "Add inventory, RMM and deployment tooling parent processes to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Raise the #proc threshold on noisy hosts such as admin jump boxes and build servers. Review the $command_lines outcome to see which environment values were queried."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(\bwmic\b.*\b(csproduct|bios|baseboard|diskdrive|logicaldisk|volume|computersystem|nic|nicconfig)\b|\bwmic\b.*\bget\b.*(uuid|serialnumber|domain)|\bgetmac\b|\bvol(\.exe)?\s+[a-z]:|\bnltest\b.*\/(dsgetdc|dclist|domain_trusts)|\bnet(1)?\s+config\s+(workstation|server)|%(userdomain|computername|logonserver|userdnsdomain)%|\bwhoami\b.*\/(upn|fqdn|user)|\bsysteminfo\b|\bipconfig\b.*\/all)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($proc.target.process.command_line = /(uuid|serialnumber|%(userdomain|userdnsdomain|logonserver)%|dsgetdc|domain_trusts|\bvol(\.exe)?\s+[a-z]:)/ nocase, 70, 50))
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1480.001")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 5
}
