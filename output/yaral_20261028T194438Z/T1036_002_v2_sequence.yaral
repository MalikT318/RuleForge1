/*
  MITRE Technique : T1036.002 - Right-to-Left Override
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:58:56.891991+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_002_Linux_RTLO_File_Dropped_Then_Executed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a file whose path contains the Unicode right-to-left override character (U+202E) being created and then executed from that same path on the same Linux host within 10 minutes. This is the dropped-then-run pattern of RTLO filename masquerading (for example a payload disguised as a document or image). The join is on the file path, not the command line, so it complements command-line-based rules."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.002"
    mitre_technique_name = "Masquerading: Right-to-Left Override"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that populates both FILE_CREATION (target.file.full_path) and PROCESS_LAUNCH (target.process.file.full_path) with Unicode-preserved paths. If the pipeline escapes non-ASCII characters, the \\u202e and \\xe2\\x80\\xae forms are also matched."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Users or applications legitimately handling files with right-to-left language names (Arabic or Hebrew) that contain a U+202E control character, such as archive extraction, file sync clients, or browser downloads. Security testing and red-team exercises. Software build or packaging tools handling test fixtures that contain bidi characters."
    tuning_guidance = "Add approved file-creating tooling to %global_allowed_admin_tools and approved script or interpreter parents to %global_allowed_script_hosts. For environments with heavy RTL-language usage, add a directory restriction on the execution path, such as /tmp, /var/tmp, /dev/shm or user download folders, to limit noise."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)(\x{202e}|\\u202e|\\xe2\\x80\\xae)/
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $path
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /(?i)(\x{202e}|\\u202e|\\xe2\\x80\\xae)/
    $proc.principal.hostname = $hostname
    $proc.target.process.file.full_path = $path
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1036.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $rtlo_paths = array_distinct($path)
    $dropper_processes = array_distinct($file.principal.process.file.full_path)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $users = array_distinct($proc.principal.user.userid)
    $exec_command_lines = array_distinct($proc.target.process.command_line)
    $first_seen = min($file.metadata.event_timestamp.seconds)
    $last_seen = max($proc.metadata.event_timestamp.seconds)

  condition:
    $file and $proc
}
