/*
  MITRE Technique : T1615 - Group Policy Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:41:09.483295+00:00
  Reference       : https://attack.mitre.org/techniques/T1615
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1615_GPO_SYSVOL_Policies_Access_Via_Network_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects HTTP/WebDAV-style requests observed at the network perimeter for the SYSVOL Policies path (\\SYSVOL\\<domain>\\Policies\\), where Group Policy Objects are stored, directed at a non-internal destination. SYSVOL is a domain-internal share, so access to its policy path across the perimeter indicates Group Policy enumeration or GPO retrieval from a pivoted, tunnelled or externally exposed host."
    mitre_tactic = "Discovery"
    mitre_technique = "T1615"
    mitre_technique_name = "Group Policy Discovery"
    log_prerequisites = "Requires proxy or firewall logs with URL inspection (SSL inspection or WebDAV/HTTP visibility) normalised to UDM NETWORK_HTTP with target.url and target.ip populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Remote or VPN-split-tunnel clients applying Group Policy through an approved gateway, WebDAV-published file services, vendor GPO backup or migration services, authorised AD assessment or audit tooling operating through the proxy."
    tuning_guidance = "Add known-good policy or file-service domains to %global_allowed_domains, add approved gateway or audit source addresses to %global_allowed_mgmt_sources, and add vulnerability or assessment sources to %global_allowed_scanners. Confirm that the internal address list %rfc1918_internal is populated for each client."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /[\\\/]sysvol[\\\/][^\\\/]+[\\\/]policies([\\\/]|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1615")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
