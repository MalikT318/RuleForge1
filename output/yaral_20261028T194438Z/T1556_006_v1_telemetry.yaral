/*
  MITRE Technique : T1556.006 - Multi-Factor Authentication
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:22:18.028018+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_006_M365_MFA_Setting_Disabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects configuration changes in the Office Suite audit log that weaken or remove multi-factor authentication. Covered operations: disabling strong authentication for a user, deleting a user's registered security info (MFA methods), and modifying or deleting conditional access policies. The detection works at the tenant/identity configuration layer, so it is independent of process or command-line telemetry."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.006"
    mitre_technique_name = "Modify Authentication Process: Multi-Factor Authentication"
    log_prerequisites = "Requires unified audit log ingestion with directory and identity-protection operations (user, policy and authentication-method changes) normalised to SETTING_MODIFICATION, with the operation name in metadata.product_event_type."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Help-desk MFA resets when a user loses a device or phone number, scheduled conditional access policy maintenance by identity administrators, user offboarding or account recycling workflows, identity governance automation, and tenant migrations or MFA vendor transitions."
    tuning_guidance = "Add named identity administrators to %global_allowed_admin_users, automation accounts to %global_allowed_service_accounts, and approved identity service principals to %global_allowed_cloud_principals. If help-desk MFA resets are noisy, raise severity only when the actor is not on the admin list or when the actor and target user are the same account (self-service removal after a compromise)."

  events:
    $set.metadata.event_type = "SETTING_MODIFICATION"
    $set.metadata.product_event_type = /^(disable strong authentication|(admin|user) deleted (all )?security info|(update|delete|set|remove) (a )?conditional access policy|delete (user )?authentication method)/ nocase
    $set.principal.user.userid != ""
    not $set.principal.user.userid in %global_allowed_admin_users
    not $set.principal.user.userid in %global_allowed_service_accounts
    not $set.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1556.006")
    $primary_entity = array_distinct(strings.coalesce($set.target.user.userid, $set.principal.user.userid))
    $actor = array_distinct($set.principal.user.userid)
    $operation = array_distinct($set.metadata.product_event_type)
    $source_ip = array_distinct($set.principal.ip)

  condition:
    $set
}
