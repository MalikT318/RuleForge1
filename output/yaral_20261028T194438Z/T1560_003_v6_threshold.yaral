/*
  MITRE Technique : T1560.003 - Archive via Custom Method
  Tactic(s)       : Collection
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:02:07.136572+00:00
  Reference       : https://attack.mitre.org/techniques/T1560/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1560_003_Custom_Archive_Mass_Opaque_File_Staging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a single host where a process running from a user-writable location creates many files with opaque, non-standard container extensions inside staging directories within 10 minutes. Custom archive or encryption routines (XOR or stream ciphers, home-grown compressors) write their output as generic .dat/.bin/.enc-style blobs rather than standard zip/7z/rar formats. Each file creation is benign on its own, but the volume from an unusual writer is not."
    mitre_tactic = "Collection"
    mitre_technique = "T1560.003"
    mitre_technique_name = "Archive Collected Data: Archive via Custom Method"
    log_prerequisites = "Requires EDR or Sysmon-equivalent file creation telemetry (Sysmon Event ID 11 or equivalent) with the writing process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers or updaters unpacking .dat/.bin/.tmp payloads, application caches and telemetry spools, game or launcher patchers, build and compile tooling, and developer test harnesses that run from user profile paths."
    tuning_guidance = "Add approved installers, deployment agents and build tooling to %global_allowed_admin_tools. Add imaging and backup software to %global_allowed_backup_processes and security agents to %global_allowed_security_tools. Raise the #file threshold on developer or build hosts, or extend the executable-name exclusion for noisy per-tenant applications. Review $sample_paths and $writer_processes in the outcome to decide whether a hit is staging or application noise."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.hostname = $host
    $file.target.file.full_path = /\\(users\\[^\\]+\\appdata\\(local|roaming)|users\\public|programdata|windows\\temp|perflogs|\$recycle\.bin)\\.*\.(dat|bin|enc|crypt|pak|blob|dmp|out|chk|tmp|part[0-9]*)$/ nocase
    $file.principal.process.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents|music|videos)|users\\public|programdata|windows\\temp|perflogs)\\/ nocase
    not $file.principal.process.file.full_path = /\\(chrome|msedge|firefox|brave|opera|teams|ms-teams|onedrive|msiexec|trustedinstaller|tiworker|svchost|msmpeng|mssense|senseir|searchindexer|wermgr|werfault)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1560.003")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $sample_paths = array_distinct($file.target.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 25
}
