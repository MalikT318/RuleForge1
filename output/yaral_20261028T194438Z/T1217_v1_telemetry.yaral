/*
  MITRE Technique : T1217 - Browser Information Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:37:59.566477+00:00
  Reference       : https://attack.mitre.org/techniques/T1217
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1217_Linux_Browser_Profile_Data_Staged {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a browser profile database (history, bookmarks, cookies, saved logins, form data, NSS key store) in a world-writable staging location such as /tmp, /var/tmp, /dev/shm or /run/user by a process that is not a browser. This file artifact is what remains after an adversary copies browser data for offline enumeration of browsing history, bookmarks and cached credentials. It is independent of the command line used to copy the files."
    mitre_tactic = "Discovery"
    mitre_technique = "T1217"
    mitre_technique_name = "Browser Information Discovery"
    log_prerequisites = "Requires Linux endpoint file-creation telemetry (EDR file events or auditd PATH/SYSCALL records normalised to UDM FILE_CREATION) with the creating process path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Browser automation frameworks (Selenium, Puppeteer, Playwright) that build temporary profiles, user-initiated profile backups or migrations, forensic and IT support collection, backup agents snapshotting home directories, and sandboxed or packaged browsers that stage profile files in /tmp through a helper process."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes, approved IT tooling to %global_allowed_admin_tools, and automation or test-runner accounts to %global_allowed_service_accounts. If a client runs browser test farms, also allowlist the CI runner process path in %global_allowed_script_hosts. Raise severity when the creating process is an interpreter or a network-capable binary."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/user\/[0-9]+)\/(.*\/)?(places\.sqlite|cookies\.sqlite|formhistory\.sqlite|key[0-9]\.db|logins\.json|login data|web data|cookies|history|bookmarks|favicons|top sites)(\.[a-z0-9~_-]+)?$/ nocase
    not $file.principal.process.file.full_path = /\/(firefox|firefox-bin|firefox-esr|chrome|google-chrome|chromium|chromium-browser|brave|brave-browser|opera|vivaldi|vivaldi-bin|microsoft-edge|msedge|epiphany|chrome_crashpad_handler)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1217")
    $primary_entity = array_distinct($file.principal.hostname)
    $staged_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
