/*
  MITRE Technique : T1059.005 - Visual Basic
  Tactic(s)       : Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:13:41.840230+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_005_Script_Host_Or_Office_Drops_VBScript_File {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a VBScript-family file (.vbs, .vbe, .wsf, .wsh) in a user-writable location by an Office application or a Windows script host. This is the file-write stage of macro droppers and multi-stage VBS loaders. It is based on FILE_CREATION telemetry, not process command lines, so it complements command-line rules. Note: the requested Linux/macOS/cloud pivot was not applied because the mandatory target platform is Windows. The additive angle here is file-creation telemetry instead of PROCESS_LAUNCH."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.005"
    mitre_technique_name = "Command and Scripting Interpreter: Visual Basic"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with the initiating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate login or logon scripts written by IT tooling, Office add-ins or macro-enabled business workbooks that generate scripts, software installers staging .wsf/.vbs helpers, and admin automation that writes scripts through a script host."
    tuning_guidance = "Add approved parent or script-host binaries to %global_allowed_script_hosts, deployment and RMM tooling to %global_allowed_admin_tools, and EDR agents to %global_allowed_security_tools. If a known business macro legitimately writes scripts, exclude it by its initiating process path."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|wscript|cscript|mshta)\.exe$/ nocase
    $file.target.file.full_path = /\.(vbs|vbe|wsf|wsh)$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|programdata|windows\\temp|temp)\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_files = array_distinct($file.target.file.full_path)
    $dropper_processes = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
