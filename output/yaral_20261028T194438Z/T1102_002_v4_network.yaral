/*
  MITRE Technique : T1102.002 - Bidirectional Communication
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:56:33.701652+00:00
  Reference       : https://attack.mitre.org/techniques/T1102/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1102_002_Linux_Scripted_Process_Outbound_Web_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux interpreter, shell, command-line HTTP client, or a binary running from a world-writable staging directory (/tmp, /var/tmp, /dev/shm) sending an HTTP write (POST/PUT/PATCH) to an external named host. Scripted processes writing data back to a web service are a network-side sign of bidirectional C2 over a legitimate web service, where output is posted to a paste site, repository, document, or social platform."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1102.002"
    mitre_technique_name = "Web Service: Bidirectional Communication"
    log_prerequisites = "Requires Linux endpoint network telemetry that populates NETWORK_HTTP with the originating process path (EDR network sensor, eBPF/auditd connect events enriched with HTTP metadata, or a TLS-inspecting proxy that maps flows to the host process)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Monitoring and telemetry scripts posting metrics to SaaS APIs, CI/CD runners and build scripts calling webhooks or artifact APIs, configuration management and cloud-init scripts, backup scripts reporting to external health-check services, and developer or admin scripts calling REST APIs."
    tuning_guidance = "Add approved automation parents or binaries to %global_allowed_script_hosts and %global_allowed_admin_tools. Add sanctioned SaaS API domains to %global_allowed_domains. Add service accounts that legitimately post to web APIs to %global_allowed_service_accounts. For noisy hosts such as build servers, tighten the process regex or suppress by host."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT|PATCH)$/ nocase
    $net.principal.process.file.full_path = /(^\/(tmp|var\/tmp|dev\/shm)\/)|(\/(python[0-9.]*|perl|ruby|php|node|bash|sh|dash|zsh|curl|wget)$)/ nocase
    $net.target.hostname = /\./
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_script_hosts
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1102.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $source_user = array_distinct($net.principal.user.userid)
    $destination_hosts = array_distinct($net.target.hostname)
    $http_methods = array_distinct($net.network.http.method)

  condition:
    $net
}
