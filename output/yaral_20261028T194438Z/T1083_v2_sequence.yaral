/*
  MITRE Technique : T1083 - File and Directory Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:23:26.146749+00:00
  Reference       : https://attack.mitre.org/techniques/T1083
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1083_Linux_Discovery_Output_Staged_To_Temp {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A file-search utility (find, locate, tree) runs with filesystem-wide or sensitive-directory scope, then the same user on the same host creates an output file in a world-writable staging directory (/tmp, /var/tmp, /dev/shm) within 10 minutes. This pairs the discovery with the staging of its results, which is typical of hands-on-keyboard or scripted reconnaissance. Detection requires both events and does not rely on command-line matching alone."
    mitre_tactic = "Discovery"
    mitre_technique = "T1083"
    mitre_technique_name = "File and Directory Discovery"
    log_prerequisites = "Linux EDR or auditd execve telemetry normalised to PROCESS_LAUNCH, plus file-creation telemetry normalised to FILE_CREATION. Both must populate principal.hostname and principal.user.userid."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators or support staff running inventory or troubleshooting searches and saving results to /tmp; configuration management and compliance scanning agents; developers or build scripts that locate files and cache the list in a temp directory; locate/updatedb-style housekeeping."
    tuning_guidance = "Add approved inventory, RMM, and configuration management binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Add vulnerability and compliance scanning tools to %global_allowed_scanners. If noisy, narrow the staging file extensions or require a sensitive directory in the search command line. For higher severity, raise the risk score for non-interactive or newly seen users."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(find|locate|mlocate|plocate|tree)$/ nocase
    $proc.target.process.command_line = /(\s-(i?name|i?regex|perm|user|writable|mtime|newer)\s)|(\s\/(\s|$))|(\s\/(home|root|etc|var|opt|srv|mnt|proc)\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path in %global_allowed_scanners
    $proc.principal.hostname = $host
    $proc.principal.user.userid = $user

    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+\.(txt|log|lst|list|out|dat|tmp)$/ nocase
    $file.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|find|locate|mlocate|plocate|tree|tee)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $host
    $file.principal.user.userid = $user

    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $host, $user over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1083")
    $primary_entity = array_distinct($host)
    $acting_user = array_distinct($user)
    $discovery_commands = array_distinct($proc.target.process.command_line)
    $staged_files = array_distinct($file.target.file.full_path)
    $discovery_event_count = count($proc.metadata.id)

  condition:
    $proc and $file
}
