/*
  MITRE Technique : T1547.004 - Winlogon Helper DLL
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:29:09.631348+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_004_Winlogon_Process_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects winlogon.exe or userinit.exe initiating an outbound connection to a non-internal address. These logon-chain processes do not normally make external connections. A connection suggests a malicious helper DLL or payload loaded through modified Winlogon Notify, Userinit or Shell registry values is beaconing or fetching a second stage. This is a network-side detection that complements registry and command-line coverage."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.004"
    mitre_technique_name = "Boot or Logon Autostart Execution: Winlogon Helper DLL"
    log_prerequisites = "Requires endpoint network telemetry that populates the initiating process path (EDR network events or Sysmon Event ID 3), normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path set."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare. Possible sources are certificate revocation or time-sync lookups made in the winlogon process context, cloud-identity or Windows Hello sign-in flows on hybrid-joined devices, and EDR or DLP agents that inject into winlogon.exe and make their own cloud connections."
    tuning_guidance = "Add known-good external destination domains to %global_allowed_domains. If a security agent injects into winlogon.exe and produces noise, confirm it is expected and add its destinations to %global_allowed_domains. Confirm %rfc1918_internal covers all internal ranges used by the client. Any hit should be validated against HKLM and HKCU Winlogon Shell, Userinit and Notify registry values on the host."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(winlogon|userinit)\.exe$/ nocase
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $affected_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
