/*
  MITRE Technique : T1564.014 - Extended Attributes
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:35:47.117455+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_014_Xattr_Payload_Interpreter_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an interpreter or shell process that makes a network connection to an external address while its own command line reads or writes extended attributes in the user. or trusted. namespace (setfattr, getfattr, or the set/get xattr syscall wrappers). This is the network side of staging a second-stage payload in an xattr: the script fetches content from the network and stores it in file metadata, or a loader reads the xattr and then calls out. Coverage is deliberately narrow and covers only one-liners and scripts whose command line exposes the xattr call. Separate endpoint rules are needed for xattr writes performed by compiled binaries."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.014"
    mitre_technique_name = "Hide Artifacts: Extended Attributes"
    log_prerequisites = "Requires Linux EDR or auditd-derived NETWORK_CONNECTION events with principal.process.file.full_path and principal.process.command_line populated. Events without process attribution will not match."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup or sync scripts that preserve xattrs while talking to remote storage, configuration management runs (Ansible, Puppet, Salt) that set SELinux or user. attributes and call external repositories, file-integrity or tagging tools implemented as Python or Perl scripts, and developer scripts testing xattr APIs against external services."
    tuning_guidance = "Add approved automation parents or binaries to %global_allowed_admin_tools and approved script hosts to %global_allowed_script_hosts. Backup tooling that legitimately preserves xattrs goes in %global_allowed_backup_processes. Add known-good external destinations to %global_allowed_domains if the destination is populated as a domain. Narrow the interpreter regex if a client uses other runtimes."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|python[0-9.]*|perl|ruby|php|node|lua|pwsh)$/ nocase
    $net.principal.process.command_line = /(setfattr|getfattr|[lf]?setxattr|[lf]?getxattr)/ nocase
    $net.principal.process.command_line = /\b(user|trusted)\.[a-z0-9_.\-]+/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_script_hosts
    not $net.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1564.014")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $process_command_line = array_distinct($net.principal.process.command_line)

  condition:
    $net
}
