/*
  MITRE Technique : T1053 - Scheduled Task/Job
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:11:50.170661+00:00
  Reference       : https://attack.mitre.org/techniques/T1053
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_ESXi_Cron_And_Startup_Script_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of ESXi scheduled-execution and boot-persistence locations: the root crontab, cron.d, rc.local, rc.local.d startup scripts and init.d. This is file-integrity coverage of the scheduling mechanism itself, not command-line matching. Ransomware and backdoor operators use these paths to survive reboots, because ESXi reverts most other changes on restart."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053"
    mitre_technique_name = "Scheduled Task/Job"
    log_prerequisites = "ESXi shell and file-integrity telemetry forwarded to Chronicle, normalised to FILE_MODIFICATION with target.file.full_path populated. Principal user and hostname should be populated where available."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators legitimately adding startup scripts to /etc/rc.local.d/local.sh. Host profile or configuration-management remediation. Third-party agent or driver installers (backup, monitoring, storage) that register init scripts. Patching or upgrades that rewrite init.d entries."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Add approved deployment, patching and agent installer processes to %global_allowed_admin_tools. Review hosts with frequent legitimate changes and exclude them via the approved tooling lists rather than by path."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/(var\/spool\/cron\/crontabs\/|etc\/cron\.[a-z]+\/|etc\/rc\.local\.d\/|etc\/rc\.local$|etc\/init\.d\/)/ nocase
    $file.principal.hostname != ""
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1053")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)
    $acting_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
