/*
  MITRE Technique : T1025 - Data from Removable Media
  Tactic(s)       : Collection
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:48:17.016670+00:00
  Reference       : https://attack.mitre.org/techniques/T1025
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1025_PowerShell_Removable_Drive_Enumeration_Collection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a PowerShell process whose command line enumerates logical disks or volumes, filters for removable media (DriveType 2 or 'Removable'), and then lists, copies or archives content. This pattern is used to find and stage files from USB or optical media before exfiltration. Written for Windows endpoints. The requested alternate-platform angle was not applied because the target platform is fixed to Windows."
    mitre_tactic = "Collection"
    mitre_technique = "T1025"
    mitre_technique_name = "Data from Removable Media"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 / Windows Event 4688 with full command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT inventory and asset scripts, backup or DLP agent scripts, helpdesk technicians checking USB drives, endpoint-management health checks that query disk types."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts, approved tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. If inventory scripts are noisy, require the copy or archive verbs by removing 'ls|dir|gci' from the final regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
    $proc.target.process.command_line = /(win32_logicaldisk|get-volume|get-psdrive|get-disk|logicaldisk)/ nocase
    $proc.target.process.command_line = /(drivetype\s*(=|-eq)\s*\W?2\b|removable)/ nocase
    $proc.target.process.command_line = /(get-childitem|\bgci\b|\bls\b|\bdir\b|copy-item|\bcopy\b|\bcp\b|robocopy|xcopy|compress-archive)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1025")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
