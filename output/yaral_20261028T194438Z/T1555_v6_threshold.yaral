/*
  MITRE Technique : T1555 - Credentials from Password Stores
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:53:29.750999+00:00
  Reference       : https://attack.mitre.org/techniques/T1555
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_Credential_Store_File_Read_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of file reads against Windows credential stores on a single host within 10 minutes. Targets include DPAPI master keys, the Credential Manager and Vault folders, and browser or Firefox password databases and their key files. The reading process is not a browser, security agent, or backup tool. A single read is normal, but repeated reads of several stores suggest credential harvesting."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555"
    mitre_technique_name = "Credentials from Password Stores"
    log_prerequisites = "Requires EDR or Sysmon-equivalent file access telemetry (FILE_READ) with the reading process path populated. File-read auditing must be enabled for user profile credential locations."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and imaging agents, EDR/AV scanners, profile migration or user-state migration tools, browser sync or enterprise password management agents, forensic or e-discovery collection by IT, and DPAPI-aware management software."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes, EDR/AV agents to %global_allowed_security_tools, and IT migration or inventory tooling to %global_allowed_admin_tools. Add known automation accounts to %global_allowed_service_accounts. Raise the #file threshold in noisy environments. Browser processes are excluded by executable name, not path."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /\\Users\\[^\\]+\\AppData\\(Local|Roaming)\\(Microsoft\\(Credentials|Protect|Vault)\\|.+\\(Login Data|Local State|logins\.json|key[34]\.db)$)/ nocase
    not $file.principal.process.file.full_path = /\\(chrome|msedge|firefox|brave|opera|iexplore|MsMpEng|MsSense|SenseIR|lsass)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = if(count($file.metadata.id) >= 20, 85, 65)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1555")
    $primary_entity = array_distinct($host)
    $reading_processes = array_distinct($file.principal.process.file.full_path)
    $accessed_files = array_distinct($file.target.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 5
}
