/*
  MITRE Technique : T1005 - Data from Local System
  Tactic(s)       : Collection
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:11:44.219270+00:00
  Reference       : https://attack.mitre.org/techniques/T1005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1005_Outbound_TFTP_Config_Transfer_To_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a perimeter connection to an external address on the TFTP port (69). Network devices use unauthenticated, unencrypted TFTP to copy local files such as running or startup configuration, credential material and flash contents off the device (for example a 'copy running-config tftp:' style CLI command). Legitimate TFTP between a device and external infrastructure is rare, so this is a high-signal network-side indicator of collection from a device's local file system. It complements endpoint and command-line detections."
    mitre_tactic = "Collection"
    mitre_technique = "T1005"
    mitre_technique_name = "Data from Local System"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION, with principal.ip, target.ip and target.port populated. Management-plane traffic from network devices must traverse a logging perimeter."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Remote branch devices that back up configuration or firmware to a cloud-hosted or provider-managed TFTP server; ISP or managed-service provisioning of CPE and voice devices; zero-touch provisioning that fetches images or config over TFTP from an off-net server; PXE/network boot services that cross the perimeter."
    tuning_guidance = "Add approved config-backup and provisioning source addresses to %global_allowed_mgmt_sources. Add sanctioned off-net provisioning servers to your client-specific copy of this rule only if a suitable existing list applies. Review the matched source device first. A core router, switch or firewall as principal.ip is more suspicious than a branch CPE."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    $net.principal.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1005")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
