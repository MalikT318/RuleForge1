/*
  MITRE Technique : T1059.006 - Python
  Tactic(s)       : Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:14:46.481383+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_006_Python_Spawned_By_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Python interpreter launched by a parent process that should not normally start scripting runtimes: Office applications, PDF readers, web server worker processes, the print spooler, SQL Server, or legacy script hosts (mshta, wscript, cscript). This pivots on process lineage rather than command-line content. It indicates macro or document-based execution, web shell activity, or exploitation of a service that results in Python-based payload execution."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.006"
    mitre_technique_name = "Command and Scripting Interpreter: Python"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry that populates both parent (principal.process.file.full_path) and child (target.process.file.full_path) image paths, from an EDR or Sysmon Event ID 1."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office add-ins or VBA macros that call Python deliberately (for example Excel-to-Python integrations or data-science plugins), IIS or Tomcat applications that shell out to Python for legitimate backend jobs, SQL Server external scripts or ETL jobs that start Python, and developer or analyst workstations with sanctioned automation."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts or %global_allowed_admin_tools. Add build servers, data-science workstations, and application servers that legitimately run Python to the host entries of %global_allowed_script_hosts. If a web server or database parent is routine in an environment, exclude by parent path and host rather than widening the child filter."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|onenote|mspub|visio|msaccess|acrord32|acrobat|foxitreader|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|sqlservr|spoolsv|mshta|wscript|cscript)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(py|pyw|pythonw?|python[0-9][0-9.]*)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.006")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
