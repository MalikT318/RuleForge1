/*
  MITRE Technique : T1027.007 - Dynamic API Resolution
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:49:12.366821+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_007_Anomalous_Parent_Spawns_Shellcode_Host_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a document, web server, print spooler or database service process launching a script interpreter or a signed binary commonly abused to host loader code. Loaders that resolve APIs at runtime (hashed export lookups, manual PEB/export-table walking) are typically delivered through this lineage because the stub has no import table to inspect. This rule is lineage-based and does not match command-line content. It is a proxy for the delivery stage, not direct evidence of API hashing."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.007"
    mitre_technique_name = "Obfuscated Files or Information: Dynamic API Resolution"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry (EDR or Sysmon Event ID 1) with the parent process image path populated in principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office add-ins or macros used by finance and reporting teams that call cmd or powershell; the print spooler launching rundll32 during printer driver installation; SQL Server xp_cmdshell or SQL Agent jobs run by DBAs; IIS application pools that invoke scripts for legacy web applications; Tomcat or Apache wrappers that launch cmd for service scripts; software deployment tools triggered from Outlook."
    tuning_guidance = "Add approved parent process paths and known script-hosting servers to %global_allowed_script_hosts. Add RMM and deployment binaries to %global_allowed_admin_tools. Add service accounts that legitimately run these chains to %global_allowed_service_accounts. If the spooler-to-rundll32 chain is noisy, add print server hostnames to %global_allowed_script_hosts rather than removing spoolsv from the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|onenote|visio|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|spoolsv|sqlservr|mysqld|oracle|postgres)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|msbuild|installutil|regasm|regsvcs|cmstp|msiexec)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.hostname in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1027.007")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
