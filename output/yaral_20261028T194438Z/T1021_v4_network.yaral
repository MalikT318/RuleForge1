/*
  MITRE Technique : T1021 - Remote Services
  Tactic(s)       : Lateral Movement
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:33:28.617630+00:00
  Reference       : https://attack.mitre.org/techniques/T1021
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_ESXi_External_Inbound_SSH_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an inbound SSH (TCP/22) connection to a hypervisor host from a source outside internal address space and outside approved management sources. ESXi management interfaces should only be reachable from internal jump hosts or management networks. An external source reaching SSH indicates a flat or exposed management network, a VPN or pivot path, or an adversary using valid accounts to move laterally into the hypervisor. This is the network-side view and complements endpoint command-line detections."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021"
    mitre_technique_name = "Remote Services"
    log_prerequisites = "Requires ESXi network connection telemetry (firewall, vmkernel or shell connection logs) normalised to UDM NETWORK_CONNECTION with principal.ip, target.hostname and target.port populated. Populate %rfc1918_internal and %global_allowed_mgmt_sources for each client."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators connecting over a VPN or NAT whose egress address is not in the internal list, third-party support or managed-service jump hosts, vulnerability scanners, remote backup or replication tooling that uses SSH, and cloud-hosted management bastions."
    tuning_guidance = "Add approved jump host and management source addresses to %global_allowed_mgmt_sources. Add authorised scanners to %global_allowed_scanners. Ensure %rfc1918_internal covers the client's internal and VPN pool ranges as plain strings. Consider raising severity where the ESXi host is internet-facing."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 22
    $net.target.hostname != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1021")
    $primary_entity = array_distinct($net.target.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
