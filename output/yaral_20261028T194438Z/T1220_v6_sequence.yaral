/*
  MITRE Technique : T1220 - XSL Script Processing
  Tactic(s)       : Stealth
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:13:04.008196+00:00
  Reference       : https://attack.mitre.org/techniques/T1220
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1220_XSL_File_Drop_Then_Script_Processing_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An XSL/XSLT stylesheet is written to a user-writable location and, within ten minutes on the same host, a built-in transformation or WMI command-line utility is launched referencing an XSL file or a remote stylesheet via /format:. This sequence indicates XSL script processing used to run embedded script code and bypass application control."
    mitre_tactic = "Stealth"
    mitre_technique = "T1220"
    mitre_technique_name = "XSL Script Processing"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry and process-launch telemetry with full command lines (EDR or Sysmon Event IDs 11 and 1)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software packaging or build tools that generate XSL stylesheets, developers working with XML/XSLT transformations, RMM or inventory scripts using wmic with /format: and local stylesheets, and installers that unpack XSL templates to temp folders."
    tuning_guidance = "Add approved packaging, deployment and inventory tooling to %global_allowed_admin_tools. Add trusted parent processes that legitimately run scripts to %global_allowed_script_hosts. If developer workstations are noisy, scope the rule by host group in the downstream SIEM."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.xslt?$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|programdata|windows\\temp|temp)\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(wmic|msxsl)\.exe$/ nocase
    $proc.target.process.command_line = /(\.xslt?\b|\/format:\s*["']?https?:)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1220")
    $primary_entity = array_distinct($hostname)
    $dropped_xsl_files = array_distinct($file.target.file.full_path)
    $dropping_processes = array_distinct($file.principal.process.file.full_path)
    $executing_command_lines = array_distinct($proc.target.process.command_line)
    $executing_users = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
