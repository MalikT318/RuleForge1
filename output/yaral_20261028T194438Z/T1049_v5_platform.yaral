/*
  MITRE Technique : T1049 - System Network Connections Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:40:07.151414+00:00
  Reference       : https://attack.mitre.org/techniques/T1049
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1049_ESXi_Network_Connection_Discovery_Via_Management_API {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects enumeration of live network connections, neighbour tables, or virtual switch port and VM network mappings on an ESXi host through the host management API (hostd task and API-invocation records). This covers the remote and API-driven path, where the command never appears as a local shell process launch, and complements existing PROCESS_LAUNCH command-line coverage. Attackers who have obtained management credentials use this path to map connected systems and lateral movement targets without opening an interactive shell."
    mitre_tactic = "Discovery"
    mitre_technique = "T1049"
    mitre_technique_name = "System Network Connections Discovery"
    log_prerequisites = "ESXi hostd logs forwarded and parsed into UDM as USER_RESOURCE_ACCESS, with the invoked API or task name populated in target.resource.name and the caller in principal.user.userid or principal.ip. Hostd task records (haTask entries for esxcli network namespaces) must be enabled at the default info log level or higher."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Infrastructure monitoring and capacity-management integrations that poll host networking, administrators troubleshooting connectivity, patch and compliance scanners that audit network configuration, and automation run from the central management server."
    tuning_guidance = "Add named administrators to %global_allowed_admin_users, polling and automation accounts to %global_allowed_service_accounts, and management or monitoring server addresses to %global_allowed_mgmt_sources. Add authorised scanners to %global_allowed_scanners. If a client's parser stores the task name in a different field, adjust only the target.resource.name line."

  events:
    $acc.metadata.event_type = "USER_RESOURCE_ACCESS"
    $acc.target.resource.name = /esxcli\.network\.(ip\.(connection|neighbor|netstack)|vm\.(list|port)|nic\.list)/ nocase
    not $acc.principal.user.userid in %global_allowed_admin_users
    not $acc.principal.user.userid in %global_allowed_service_accounts
    not $acc.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1049")
    $primary_entity = array_distinct($acc.principal.hostname)
    $calling_users = array_distinct($acc.principal.user.userid)
    $source_ips = array_distinct($acc.principal.ip)
    $invoked_operations = array_distinct($acc.target.resource.name)

  condition:
    $acc
}
