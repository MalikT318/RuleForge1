/*
  MITRE Technique : T1518 - Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:37:21.866854+00:00
  Reference       : https://attack.mitre.org/techniques/T1518
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_Software_Inventory_Then_Security_Product_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects installed-software enumeration (WMI Win32_Product, Uninstall registry key query, Get-Package) followed within ten minutes by security-product discovery (SecurityCenter2 / AntiVirusProduct WMI queries, Get-MpComputerStatus) on the same host. This sequence is typical of automated discovery that profiles installed software and defences before follow-on actions."
    mitre_tactic = "Discovery"
    mitre_technique = "T1518"
    mitre_technique_name = "Software Discovery"
    log_prerequisites = "Requires EDR or Sysmon process telemetry (PROCESS_LAUNCH) with full command-line capture, or Windows Event 4688 with command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT asset inventory and compliance scripts, RMM and patching agents, vulnerability scanner credentialed checks, software deployment tooling, and administrators troubleshooting endpoint protection."
    tuning_guidance = "Add approved inventory and RMM binaries to %global_allowed_admin_tools and security agents to %global_allowed_security_tools. Consider lengthening the window or raising severity for non-administrator users. Review the $users and $inventory_commands outcome values for context."

  events:
    $inv.metadata.event_type = "PROCESS_LAUNCH"
    $inv.target.process.file.full_path = /\\(wmic|reg|powershell|pwsh|cmd)\.exe$/ nocase
    $inv.target.process.command_line = /(wmic(\.exe)?\s.*\bproduct\b|\\CurrentVersion\\Uninstall|win32_product|get-package\b|win32reg_addremoveprograms)/ nocase
    not $inv.principal.process.file.full_path in %global_allowed_admin_tools
    $inv.principal.hostname = $hostname

    $sec.metadata.event_type = "PROCESS_LAUNCH"
    $sec.target.process.file.full_path = /\\(wmic|powershell|pwsh|cmd)\.exe$/ nocase
    $sec.target.process.command_line = /(antivirusproduct|antispywareproduct|firewallproduct|securitycenter2|get-mpcomputerstatus)/ nocase
    not $sec.principal.process.file.full_path in %global_allowed_security_tools
    not $sec.principal.process.file.full_path in %global_allowed_admin_tools
    $sec.principal.hostname = $hostname

    $inv.metadata.event_timestamp.seconds <= $sec.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1518")
    $primary_entity = array_distinct($hostname)
    $users = array_distinct($inv.principal.user.userid)
    $inventory_commands = array_distinct($inv.target.process.command_line)
    $security_discovery_commands = array_distinct($sec.target.process.command_line)
    $first_seen = min($inv.metadata.event_timestamp.seconds)
    $last_seen = max($sec.metadata.event_timestamp.seconds)

  condition:
    $inv and $sec
}
