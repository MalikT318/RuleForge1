/*
  MITRE Technique : T1546.001 - Change Default File Association
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:00:15.998654+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_001_File_Association_Handler_Registry_Hijack {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry write to a file-type handler command key (HKCR or Software\\Classes\\<handler>\\shell\\<action>\\command) whose value points to a script interpreter, proxy-execution binary or user-writable location. This is the registry state change that makes a file association run attacker content when a file of that type is opened. It does not depend on command-line logging, so it also catches direct API writes and the assoc/ftype utilities."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.001"
    mitre_technique_name = "Event Triggered Execution: Change Default File Association"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon registry events) with registry key and value data populated, normalised to REGISTRY_MODIFICATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters registering or repairing handlers for their own document types, portable apps pointing handlers at a user-writable path, developer tools registering script handlers, RMM or deployment agents, and admins customising handlers by hand."
    tuning_guidance = "Add approved deployment and installer process paths to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. Add approved service accounts to %global_allowed_service_accounts if a managed deployment account writes handlers. If a user-writable path is common in the estate, narrow the value-data path branch."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(\\software\\classes|^hkey_classes_root|^hkcr)\\[^\\]+\\shell\\[^\\]+\\command$/ nocase
    (
      $reg.target.registry.registry_value_data = /\b(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|msbuild|bitsadmin|certutil)(\.exe)?\b/ nocase or
      $reg.target.registry.registry_value_data = /\\(appdata|temp|programdata|users\\public|windows\\temp|windows\\tasks|perflogs)\\/ nocase
    )
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|MsMpEng)\.exe$/ nocase

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $handler_key = array_distinct($reg.target.registry.registry_key)
    $handler_command = array_distinct($reg.target.registry.registry_value_data)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $writer_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
