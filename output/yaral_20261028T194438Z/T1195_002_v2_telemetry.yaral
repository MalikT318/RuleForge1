/*
  MITRE Technique : T1195.002 - Compromise Software Supply Chain
  Tactic(s)       : Initial Access
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:42:07.847061+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_002_Linux_Package_Source_Or_Trust_Config_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a package repository definition, package signing key/keyring, or package-manager client config (apt, yum/dnf, zypper, pip, npm) by a process that is not a recognised package manager or approved admin tool. Adversaries who redirect a host to a malicious repository or add a rogue signing key can deliver trojanised software updates. This rule detects the resulting file artifact and does not depend on command-line logging."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.002"
    mitre_technique_name = "Supply Chain Compromise: Compromise Software Supply Chain"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules (-w /etc/apt, /etc/yum.repos.d, /etc/pki/rpm-gpg, /etc/pip.conf, /etc/npmrc -p wa) that populate the principal process path and target file path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management (Ansible, Puppet, Chef, Salt) writing repo files; cloud-init or image-build provisioning; vendor installers that register their own repository (e.g. via a shell postinstall script); developers configuring private pip/npm mirrors in home directories."
    tuning_guidance = "Add approved config-management and provisioning binaries to %global_allowed_admin_tools, and service accounts that legitimately manage repositories to %global_allowed_service_accounts. Clone the rule with event_type FILE_MODIFICATION to also cover edits of existing repo files. Review the matched file path and writing process first: unexpected shells, interpreters, or processes launched from /tmp or /dev/shm are high-confidence."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/etc\/(apt\/(sources\.list|sources\.list\.d\/.+|trusted\.gpg\.d\/.+|keyrings\/.+|apt\.conf\.d\/.+)|yum\.repos\.d\/.+\.repo|dnf\/.+\.conf|zypp\/repos\.d\/.+\.repo|pki\/rpm-gpg\/.+|pip\.conf|pip\/pip\.conf|npmrc)|\/(home\/[^\/]+|root)\/(\.npmrc|\.pip\/pip\.conf|\.config\/pip\/pip\.conf))$/ nocase
    not $file.principal.process.file.full_path = /\/(apt|apt-get|aptitude|dpkg|unattended-upgrade|yum|dnf|rpm|zypper|packagekitd|snapd|subscription-manager|cloud-init|add-apt-repository)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1195.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
