/*
  MITRE Technique : T1055.013 - Process Doppelgänging
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:01:30.311830+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_013_Anomalous_Parent_Spawns_Shell_Or_SystemProcess_Masquerade {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process launch where an Office application, web server, print spooler or database service spawns a shell, script interpreter, LOLBin proxy, or a core Windows system process image. Process doppelgänging loaders (TxF-backed section, NtCreateProcessEx) running inside document-handling or network-facing services typically surface as an unexpected lineage, such as a web server worker spawning svchost or lsass, or an Office process spawning an interpreter. The rule pivots on parent-child lineage rather than command-line content."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.013"
    mitre_technique_name = "Process Injection: Process Doppelgänging"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry that populates both the parent (principal.process) and child (target.process) image paths, from an EDR, Sysmon Event ID 1, or Security Event 4688 with parent info."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Line-of-business web applications that legitimately shell out from w3wp or Tomcat; SQL Server jobs using xp_cmdshell; Office macros or add-ins in sanctioned automation; print drivers or print management software launching rundll32 from the spooler; document-management or ERP integrations."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts and sanctioned deployment or IT tooling to %global_allowed_admin_tools. Add EDR or AV agents to %global_allowed_security_tools. If a specific web application legitimately spawns cmd, exclude it by parent executable name rather than install directory."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat\d*|php-cgi|spoolsv|sqlservr|mysqld|postgres|oracle)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|regsvr32|rundll32|wmic|bitsadmin|certutil|svchost|lsass|csrss|smss|wininit|winlogon|services|taskhostw|dllhost)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1055.013")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
