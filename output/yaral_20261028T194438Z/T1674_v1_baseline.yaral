/*
  MITRE Technique : T1674 - Input Injection
  Tactic(s)       : Execution
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:17:39.977507+00:00
  Reference       : https://attack.mitre.org/techniques/T1674
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1674_Scripted_Keystroke_Injection_Via_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows script interpreter launched with inline code that synthesises keyboard input, either through the SendKeys/SendWait .NET and WScript.Shell methods or through the user32 keybd_event/SendInput APIs. Adversary tooling uses these calls to type commands, open consoles or drive GUI applications on behalf of the user. This is the OS input-synthesis mechanism that T1674 depends on, so the rule does not depend on tool names, payloads or infrastructure."
    mitre_tactic = "Execution"
    mitre_technique = "T1674"
    mitre_technique_name = "Input Injection"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 / Windows Event 4688 with command-line auditing enabled. Interpreter command lines must be captured in full."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "UI automation and test frameworks, helpdesk or onboarding scripts that use SendKeys, accessibility tooling, kiosk and VDI automation, and admins prototyping automation in a PowerShell console."
    tuning_guidance = "Add approved automation parents (test runners, RMM agents, kiosk managers) to %global_allowed_script_hosts or %global_allowed_admin_tools. Add named automation operators to %global_allowed_admin_users and service accounts to %global_allowed_service_accounts. Scripts run with -File are not matched here because their content is absent from the command line. Pair with script-block logging for coverage of those cases."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|powershell_ise)\.exe$/ nocase
    $proc.target.process.command_line = /(\bsendkeys\b|\bsendwait\b|\bkeybd_event\b|\bsendinput\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1674")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
