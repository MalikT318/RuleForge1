/*
  MITRE Technique : T1539 - Steal Web Session Cookie
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:39:48.876845+00:00
  Reference       : https://attack.mitre.org/techniques/T1539
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1539_SaaS_Session_Replay_Multi_Geo_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects one user identity authenticating from two different external source IPs in two different countries within 10 minutes. This pattern is consistent with a stolen web session cookie or token being replayed from attacker infrastructure, for example by an adversary-in-the-middle phishing proxy, while the legitimate session is still active."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1539"
    mitre_technique_name = "Steal Web Session Cookie"
    log_prerequisites = "Identity provider sign-in logs normalised to USER_LOGIN with principal.ip, principal.location.country_or_region and target.user.userid populated. IP geolocation enrichment must be enabled in the SIEM."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Corporate VPN or proxy egress points in different countries, users travelling and signing in from mobile and Wi-Fi networks at once, privacy or relay services, cloud-hosted virtual desktops, and geolocation database inaccuracies."
    tuning_guidance = "Add automation and shared accounts to %global_allowed_service_accounts. Add corporate VPN and proxy egress ranges to the internal address handling, or filter them out upstream. If the rule is noisy for travelling staff, tighten the window or require a failed MFA or new-device indicator once the tenant's authentication detail fields are confirmed."

  events:
    $auth1.metadata.event_type = "USER_LOGIN"
    $auth1.target.user.userid = $user
    $auth1.principal.location.country_or_region != ""
    not $auth1.principal.ip in %rfc1918_internal
    not $auth1.target.user.userid in %global_allowed_service_accounts

    $auth2.metadata.event_type = "USER_LOGIN"
    $auth2.target.user.userid = $user
    $auth2.principal.location.country_or_region != ""
    not $auth2.principal.ip in %rfc1918_internal
    not $auth2.target.user.userid in %global_allowed_service_accounts

    $auth1.principal.ip != $auth2.principal.ip
    $auth1.principal.location.country_or_region != $auth2.principal.location.country_or_region

    $auth1.metadata.event_timestamp.seconds <= $auth2.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1539")
    $primary_entity = array_distinct($user)
    $first_login_ips = array_distinct($auth1.principal.ip)
    $second_login_ips = array_distinct($auth2.principal.ip)
    $first_countries = array_distinct($auth1.principal.location.country_or_region)
    $second_countries = array_distinct($auth2.principal.location.country_or_region)
    $login_count = count($auth2.metadata.id)

  condition:
    $auth1 and $auth2
}
