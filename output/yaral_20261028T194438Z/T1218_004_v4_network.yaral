/*
  MITRE Technique : T1218.004 - InstallUtil
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:47:15.805339+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_004_InstallUtil_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects InstallUtil.exe, a signed .NET installer utility that normally has no reason to talk to the internet, initiating a network connection to an external address. This is characteristic of proxy execution of a malicious .NET assembly that downloads a payload, beacons to C2 or exfiltrates data. The rule observes the network behaviour of the process and does not depend on process-creation command-line matching."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.004"
    mitre_technique_name = "System Binary Proxy Execution: InstallUtil"
    log_prerequisites = "Requires endpoint network telemetry that attributes outbound connections to the originating process (EDR network events or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Authenticode certificate revocation (CRL/OCSP) or timestamp lookups when InstallUtil loads a signed assembly; legitimate .NET service installers that perform licensing, activation or telemetry callbacks during install; software deployment pipelines that install .NET services from remote build or artifact servers."
    tuning_guidance = "Add known-good vendor, certificate and update domains to %global_allowed_domains. Add deployment or build service accounts to %global_allowed_service_accounts. Add approved deployment tooling to %global_allowed_admin_tools. Review the destination IP and the parent process of the InstallUtil instance on the host to confirm."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\installutil\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.process.parent_process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $process_command_line = array_distinct($net.principal.process.command_line)

  condition:
    $net
}
