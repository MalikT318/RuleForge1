/*
  MITRE Technique : T1558 - Steal or Forge Kerberos Tickets
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:38:16.095684+00:00
  Reference       : https://attack.mitre.org/techniques/T1558
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_Linux_Kerberos_Ccache_Keytab_Copy_Or_Encode {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a native copy, read, archive, encode or transfer utility being run against a Kerberos credential cache (krb5cc_*, *.ccache) or keytab file on Linux. Adversaries who steal these files can reuse the tickets or keys elsewhere (Pass the Ticket) without knowing the password. Matches on the combination of a file-handling utility and a Kerberos credential artifact, so it does not depend on any named attacker tool."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558"
    mitre_technique_name = "Steal or Forge Kerberos Tickets"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to UDM PROCESS_LAUNCH with full command-line capture."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators backing up or migrating keytabs, configuration management (Ansible, Puppet, Chef) distributing keytabs, SSSD/Kerberos troubleshooting by support staff, backup agents reading /tmp or /var/lib/, and users copying their own ccache for legitimate job-submission workflows (HPC, Hadoop)."
    tuning_guidance = "Add approved configuration-management and deployment binaries to %global_allowed_admin_tools, backup agents to %global_allowed_backup_processes, and automation accounts to %global_allowed_service_accounts. If a client has known keytab distribution jobs, exclude the parent process through the admin tools list. Raise severity when the destination is outside the host (scp, curl, nc) or the user is not the ticket owner."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(cp|mv|cat|scp|sftp|rsync|base64|xxd|od|tar|zip|gzip|curl|wget|nc|ncat|socat|dd|openssl)$/ nocase
    $proc.target.process.command_line = /(krb5cc_|\.ccache\b|\.keytab\b|\/krb5\.keytab)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1558")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $utility = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
