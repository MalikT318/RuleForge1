/*
  MITRE Technique : T1668 - Exclusive Control
  Tactic(s)       : Persistence
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:11:18.623815+00:00
  Reference       : https://attack.mitre.org/techniques/T1668
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1668_Linux_Chattr_Immutable_Persistence_Files {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects chattr being used to set the immutable attribute (+i) on files that control persistence and remote access on Linux, such as SSH authorized_keys, cron spool and drop-in directories, systemd unit paths, ld.so.preload and sudoers. Adversaries lock these files after planting their own foothold so that other actors, and defenders, cannot add or remove persistence entries. This is a common 'closing the door' behaviour for exclusive control."
    mitre_tactic = "Persistence"
    mitre_technique = "T1668"
    mitre_technique_name = "Exclusive Control"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records that populate the full process path and command line (PROCESS_LAUNCH)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Hardening baselines and CIS or STIG remediation scripts that make authorized_keys, sudoers or cron files immutable; configuration management agents (Ansible, Puppet, Chef, Salt); administrators locking down bastion hosts or jump boxes."
    tuning_guidance = "Add approved configuration-management and hardening tooling to %global_allowed_admin_tools, and named administrators who legitimately lock these files to %global_allowed_admin_users. Review hosts that fire repeatedly, since baseline scripts typically run at a predictable cadence and parent process. Severity can be raised when the user is not root-owned automation or the host is internet-facing."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/chattr$/ nocase
    $proc.target.process.command_line = /\s\+[a-z]*i[a-z]*(\s|$)/ nocase
    $proc.target.process.command_line = /(authorized_keys|\.ssh|\/var\/spool\/cron|\/etc\/cron|\/etc\/crontab|\/etc\/systemd|\/usr\/lib\/systemd|\/etc\/ld\.so\.preload|\/etc\/sudoers|\/etc\/rc\.local|\/etc\/init\.d)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1668")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
