/*
  MITRE Technique : T1546 - Event Triggered Execution
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:58:54.994173+00:00
  Reference       : https://attack.mitre.org/techniques/T1546
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_Login_Then_Automation_Trigger_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A user signs in and, within ten minutes, the same account creates or modifies an event-triggered automation in the tenant (mailbox inbox rule, mail transport rule, or workflow automation flow). Adversaries use these triggers to run persistent, event-driven actions such as forwarding, deleting or exfiltrating data after gaining access to an account."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546"
    mitre_technique_name = "Event Triggered Execution"
    log_prerequisites = "Unified audit logs from the collaboration suite ingested into Chronicle with sign-in events normalised to USER_LOGIN and rule/flow/setting changes normalised to SETTING_MODIFICATION, with metadata.product_event_type populated with the operation name."
    platform = "SaaS"
    log_source = "m365"
    false_positives = "Users creating legitimate inbox rules for filing or out-of-office handling shortly after signing in; business users building approved workflow automations; helpdesk or IT staff configuring rules on behalf of users; onboarding scripts run by automation accounts."
    tuning_guidance = "Add automation and service identities to %global_allowed_service_accounts and administrators who routinely manage mailbox or flow configuration to %global_allowed_admin_users. Tighten the product_event_type regex to the operation names emitted in the client's tenant, and raise severity where the login source is anomalous."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.principal.user.userid = $user
    not $login.principal.ip in %rfc1918_internal
    not $login.principal.user.userid in %global_allowed_service_accounts
    not $login.principal.user.userid in %global_allowed_admin_users

    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(New-InboxRule|Set-InboxRule|UpdateInboxRules|New-TransportRule|Set-TransportRule|CreateFlow|EditFlow|New-Flow|Create flow|Edit flow)/ nocase
    $setting.principal.user.userid = $user
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_admin_users

    $login.metadata.event_timestamp.seconds <= $setting.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546")
    $primary_entity = array_distinct($user)
    $login_source_ips = array_distinct($login.principal.ip)
    $trigger_operations = array_distinct($setting.metadata.product_event_type)
    $trigger_event_count = count($setting.metadata.id)

  condition:
    $login and $setting
}
