/*
  MITRE Technique : T1560.003 - Archive via Custom Method
  Tactic(s)       : Collection
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:00:38.547695+00:00
  Reference       : https://attack.mitre.org/techniques/T1560/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1560_003_Linux_Custom_Archive_Artifact_In_Staging_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of an archive-like or encrypted container file in a world-writable staging directory (/tmp, /var/tmp, /dev/shm) by a process that is not a standard archiver and is either executing from a staging directory or is a scripting interpreter. This is the file artifact left by custom compression or encryption routines (XOR or stream ciphers, hand-rolled compressors) that never invoke tar, gzip or zip. It does not depend on command-line logging."
    mitre_tactic = "Collection"
    mitre_technique = "T1560.003"
    mitre_technique_name = "Archive Collected Data: Archive via Custom Method"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry that populates principal.process.file.full_path and target.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers and build tooling written in Python, Perl or Ruby that create temporary archives in /tmp; developer scripts and CI runners; application installers that unpack from a temp directory; backup agents not yet in the allowlist."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools and backup software to %global_allowed_backup_processes. If interpreter noise is high on build or CI hosts, scope those hosts out through the rule exclusions in the SIEM, or remove the interpreter branch from the process-path regex."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+\.(zip|7z|rar|tar|gz|tgz|bz2|xz|lzma|zst|enc|crypt|aes|pak)$/ nocase
    $file.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/|\/(python[0-9.]*|perl|ruby|php[0-9.]*)$/ nocase
    not $file.principal.process.file.full_path = /\/(tar|gzip|pigz|bzip2|xz|zip|7z|7za|7zr|zstd|rar|cpio|dpkg|rpm|apt|apt-get|yum|dnf)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1560.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_files = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    $file
}
