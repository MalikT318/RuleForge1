/*
  MITRE Technique : T1037.001 - Logon Script (Windows)
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:19:54.829185+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_001_Unexpected_Parent_Sets_Logon_Script {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, script interpreter, or registry utility launched by an unexpected parent process (Office application, web server, database service, print spooler, or script-host binary) whose command line sets the UserInitMprLogonScript logon-script persistence value. Pivots on process lineage rather than the registry write itself."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.001"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Logon Script (Windows)"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers or management agents that set a per-user logon script and are launched from a web-based or database-driven deployment console; administrators using Office macros or web-hosted admin portals for user provisioning; custom line-of-business applications that configure logon scripts at user onboarding."
    tuning_guidance = "Add approved deployment or provisioning parent binaries to %global_allowed_admin_tools and approved script-host parents to %global_allowed_script_hosts. Add named provisioning accounts to %global_allowed_admin_users. Extend the parent-process regex with customer-specific web or database service binaries if needed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|onenote|visio|w3wp|httpd|nginx|tomcat\d*|java|php-cgi|sqlservr|mysqld|spoolsv|wmiprvse|mshta)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|reg|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /UserInitMprLogonScript/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1037.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
