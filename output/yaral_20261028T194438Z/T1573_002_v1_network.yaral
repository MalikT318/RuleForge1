/*
  MITRE Technique : T1573.002 - Asymmetric Cryptography
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:24:25.775107+00:00
  Reference       : https://attack.mitre.org/techniques/T1573/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1573_002_Outbound_TLS_NonStandard_Port_IPS {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side detection of an outbound TLS/SSL session, which relies on asymmetric key exchange, to an external destination on a non-standard port. Malware commonly wraps C2 in TLS on unusual ports to hide it from port-based controls. The IDS/IPS or network security appliance observes this independently of endpoint telemetry."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1573.002"
    mitre_technique_name = "Encrypted Channel: Asymmetric Cryptography"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION with network.tls.version populated (TLS inspection or handshake metadata) and network.direction set."
    platform = "Windows"
    log_source = "ips"
    false_positives = "Line-of-business applications using TLS on custom ports, VPN and remote-access clients, collaboration and cloud-sync clients using alternate ports, mail and directory services on non-listed TLS ports, developer and test tooling."
    tuning_guidance = "Add approved destination domains to %global_allowed_domains and authorised scanning sources to %global_allowed_scanners. Extend the numeric port exclusions for TLS services common in the client estate. Scope to Windows hosts through the client's asset-to-subnet mapping or by adding an asset platform filter if the appliance populates it. For higher fidelity, raise severity when the destination is rare across the estate."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.direction = "OUTBOUND"
    $net.network.tls.version = /.+/
    $net.target.port > 0
    $net.target.port != 443
    $net.target.port != 8443
    $net.target.port != 993
    $net.target.port != 995
    $net.target.port != 465
    $net.target.port != 587
    $net.target.port != 636
    $net.target.port != 853
    $net.target.port != 989
    $net.target.port != 990
    $net.target.port != 3269
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1573.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $tls_versions = array_distinct($net.network.tls.version)

  condition:
    $net
}
