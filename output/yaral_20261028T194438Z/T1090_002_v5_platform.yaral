/*
  MITRE Technique : T1090.002 - External Proxy
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:29:31.146419+00:00
  Reference       : https://attack.mitre.org/techniques/T1090/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1090_002_Outbound_Proxy_Port_Redirector_Firewall {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host making an outbound connection to an external address on a TCP port conventionally used for SOCKS, forward-proxy or Tor-style relays (1080, 3128, 9050, 9150). Port redirectors and external proxies such as HTRAN-style relays commonly sit on these ports to forward C2 traffic. The rule uses only perimeter connection telemetry and no endpoint process fields."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1090.002"
    mitre_technique_name = "Proxy: External Proxy"
    log_prerequisites = "Firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip or principal.hostname, target.ip and target.port populated. Egress traffic must be logged, including allowed sessions."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Sanctioned forward proxies or cloud secure web gateways that listen on 3128 or 1080, developer or QA hosts using SOCKS tunnels, privacy-tool users where policy allows, and vulnerability scanners probing proxy ports."
    tuning_guidance = "Add approved external proxy or gateway domains to %global_allowed_domains, and add scanner source hosts to %global_allowed_scanners. Populate %rfc1918_internal with the client's internal address space so internal destinations are excluded. If the firewall logs only IPs, make sure the list entries match the normalised string form. Raise severity for server subnets where any outbound proxy traffic is abnormal."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 1080 or
      $net.target.port = 3128 or
      $net.target.port = 9050 or
      $net.target.port = 9150
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1090.002")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
