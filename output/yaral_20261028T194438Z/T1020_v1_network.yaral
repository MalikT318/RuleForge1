/*
  MITRE Technique : T1020 - Automated Exfiltration
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:29:38.346856+00:00
  Reference       : https://attack.mitre.org/techniques/T1020
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1020_Large_Outbound_Transfer_Nonstandard_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a single perimeter-observed outbound connection from an internal host to an external address that sends more than 100 MB over a port other than 80 or 443. Large uploads over non-web ports are characteristic of automated bulk exfiltration, such as scripted or scheduled staging-and-send jobs. The rule uses network-side telemetry only and does not depend on endpoint process data."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1020"
    mitre_technique_name = "Automated Exfiltration"
    log_prerequisites = "Requires firewall or perimeter connection logs that populate network.sent_bytes, network.direction, target.ip and target.port. Connection-close or session-summary logs are needed to get byte counts."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Offsite backup and replication jobs on custom ports, SFTP/FTPS or managed file transfer to partners, cloud storage sync clients on non-standard ports, large software or media uploads, database log shipping, and legitimate VPN or tunnelled traffic."
    tuning_guidance = "Add known-good destination domains (backup vendors, partner SFTP endpoints) to %global_allowed_domains. Adjust the byte threshold (104857600) per client based on normal egress baselines. Extend the port exclusions for client-approved services. Use a Threshold or Sequence variant for repeated smaller transfers."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.direction = "OUTBOUND"
    $net.network.sent_bytes > 104857600
    $net.target.port != 443
    $net.target.port != 80
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1020")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
