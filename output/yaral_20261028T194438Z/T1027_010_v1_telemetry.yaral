/*
  MITRE Technique : T1027.010 - Command Obfuscation
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:53:12.584057+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_010_Linux_Obfuscated_Artifact_Name_In_Temp_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a file or directory in world-writable staging locations (/tmp, /var/tmp, /dev/shm) whose path contains two or more shell metacharacters ($ & ; | ` < > \\ ! { }). This is the filesystem artifact left by globbing, quoting and symbol-based command obfuscation, such as creating '/tmp/:&$NiA'. It works at the file-state layer, so it still fires when command-line logging is evaded or the command line is itself obfuscated."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.010"
    mitre_technique_name = "Obfuscated Files or Information: Command Obfuscation"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-creation events (PATH records) normalised to UDM FILE_CREATION with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Build and CI tooling that generates temp files with templated names, package managers and installers that use scratch directories, developer scripts that create files containing '$' or ';' in the name, and desktop applications (e.g. browsers or editors) that create lock or backup files with unusual names."
    tuning_guidance = "Add approved build, deployment and installer binaries to %global_allowed_admin_tools, and approved interpreters or automation parent processes to %global_allowed_script_hosts. To reduce noise further, raise the metacharacter count in the regex from two to three, or add noisy service accounts to %global_allowed_service_accounts."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.*[\$&;|`<>\\!\{\}].*[\$&;|`<>\\!\{\}]/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.010")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_paths = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
