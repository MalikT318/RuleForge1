/*
  MITRE Technique : T1120 - Peripheral Device Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:26:40.662686+00:00
  Reference       : https://attack.mitre.org/techniques/T1120
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1120_Windows_PnP_Peripheral_Enumeration_CommandLine {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects built-in Windows interpreters or utilities (PowerShell, WMIC, pnputil) launched with command-line arguments that enumerate Plug and Play, USB, input, or printer devices. These are the native OS interfaces used to discover attached peripherals. Matching on the combination of host binary and device-class enumeration arguments means renaming a payload or changing its hash does not evade the rule."
    mitre_tactic = "Discovery"
    mitre_technique = "T1120"
    mitre_technique_name = "Peripheral Device Discovery"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with full command-line capture (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT inventory and asset-management scripts, RMM and endpoint-management agents, driver or hardware troubleshooting by administrators, device-control or DLP agents checking USB state, helpdesk scripts for printer or peripheral issues, and hardware vendor update utilities."
    tuning_guidance = "Add approved inventory, RMM, and deployment tooling to %global_allowed_admin_tools (matched on parent process path). Add approved automation accounts to %global_allowed_service_accounts. Add approved EDR or device-control agents to %global_allowed_security_tools. Add known management script hosts to %global_allowed_script_hosts. If volume remains high, restrict the regex to USB and removable-storage classes only, or raise severity when the parent is an Office application, browser, or script interpreter."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|wmic|pnputil)\.exe$/ nocase
    (
      $proc.target.process.command_line = /get-pnpdevice(property)?\b/ nocase or
      $proc.target.process.command_line = /win32_(pnpentity|usbcontrollerdevice|usbhub|usbcontroller|pointingdevice|keyboard|printer|pnpsigneddriver)/ nocase or
      $proc.target.process.command_line = /pnputil(\.exe)?"?\s+[\/-]enum-?(devices|interfaces)/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1120")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
