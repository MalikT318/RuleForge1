/*
  MITRE Technique : T1602.002 - Network Device Configuration Dump
  Tactic(s)       : Collection
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:19:48.998874+00:00
  Reference       : https://attack.mitre.org/techniques/T1602/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_002_External_Source_To_Device_Config_Services {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a connection from a non-internal source address to a network-device management service commonly abused to dump device configuration: SNMP (161), TFTP (69) or Cisco Smart Install (4786). These protocols are used to read or export running and startup configurations and should never be reachable from outside the organisation. The rule is based on perimeter connection telemetry and does not depend on endpoint process data."
    mitre_tactic = "Collection"
    mitre_technique = "T1602.002"
    mitre_technique_name = "Data from Configuration Repository: Network Device Configuration Dump"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs must cover inbound traffic on the internet-facing interface, including traffic the firewall permitted."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Managed-service-provider or ISP monitoring platforms polling SNMP over the internet, authorised external vulnerability or penetration-test scanners, remote-site network operations centres reaching devices over a public address, and Internet-wide scanner traffic if the firewall logs denied or dropped connections as NETWORK_CONNECTION."
    tuning_guidance = "Add approved monitoring and NOC source addresses to %global_allowed_mgmt_sources. Add authorised scanner sources to %global_allowed_scanners. If dropped internet background noise creates volume, scope the firewall log feed to permitted traffic only, or raise severity only for sources that also appear in other alerts."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 161 or $net.target.port = 69 or $net.target.port = 4786)
    $net.principal.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1602.002")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
