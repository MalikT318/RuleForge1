/*
  MITRE Technique : T1556 - Modify Authentication Process
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:13:19.409030+00:00
  Reference       : https://attack.mitre.org/techniques/T1556
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_Linux_Service_Parent_Spawns_Shell_Touching_Auth_Config {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing service or application runtime (web server, application server, database, print or file-sharing daemon) spawning a shell or script interpreter whose command line references Linux authentication components such as PAM configuration and modules, shadow and passwd files, sshd configuration, NSS configuration or sudoers. Service processes do not normally launch interpreters to change authentication mechanisms, so this pattern indicates web shell or service compromise followed by authentication tampering."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556"
    mitre_technique_name = "Modify Authentication Process"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry normalised to UDM PROCESS_LAUNCH with parent process path (principal.process.file.full_path), child process path and command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Application installers or configuration-management hooks run under a service account, web-based admin panels (hosting control panels, webmin-style tools) that legitimately manage users, database maintenance jobs that call shell helpers, and Java-based provisioning or identity tooling."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts, approved automation accounts to %global_allowed_service_accounts, and EDR or security agents to %global_allowed_security_tools. If the java or node parent is noisy, add the specific launcher to the allowlists rather than removing it from the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|php-fpm[0-9.]*|lighttpd|tomcat[0-9]*|java|node|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|smbd)$/ nocase
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|csh|tcsh|ash|python[0-9.]*|perl|ruby|php[0-9.]*)$/ nocase
    $proc.target.process.command_line = /(\/etc\/pam\.d|pam_[a-z0-9_]+\.so|\/lib(64)?\/security|\/security\/pam_|\/etc\/shadow|\/etc\/passwd|\/etc\/ssh\/sshd_config|\/etc\/nsswitch\.conf|\/etc\/sudoers|\/etc\/security\/)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1556")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
