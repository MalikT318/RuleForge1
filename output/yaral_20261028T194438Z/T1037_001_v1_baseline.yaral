/*
  MITRE Technique : T1037.001 - Logon Script (Windows)
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:19:29.731209+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_001_UserInitMprLogonScript_Registry_Set {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a write to the UserInitMprLogonScript value under a user's Environment registry key. Windows runs the script named in this value at every logon for that user, so adversaries use it for persistence and execution at logon initialization."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.001"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Logon Script (Windows)"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon Event ID 12/13/14) that populates target.registry.registry_key and target.registry.registry_value_name. HKCU is typically normalised to HKEY_USERS\\<SID>\\Environment."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy enterprise logon-script deployment by IT through scripts or software deployment tools, user-profile migration tools, RMM or desktop-management agents, and administrators configuring a per-user logon script manually."
    tuning_guidance = "Add approved deployment or management binaries to %global_allowed_admin_tools, and automation or service accounts that legitimately set logon scripts to %global_allowed_service_accounts. Named administrators can be added to %global_allowed_admin_users. Review the registry value data in the outcome to confirm the script path and its location."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_value_name = /^UserInitMprLogonScript$/ nocase
    $reg.target.registry.registry_key = /\\Environment$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1037.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $user = array_distinct($reg.principal.user.userid)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $writer_command_line = array_distinct($reg.principal.process.command_line)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $script_value = array_distinct($reg.target.registry.registry_value_data)

  condition:
    $reg
}
