/*
  MITRE Technique : T1011 - Exfiltration Over Other Network Medium
  Tactic(s)       : Exfiltration
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:20:10.827784+00:00
  Reference       : https://attack.mitre.org/techniques/T1011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1011_Linux_Large_Outbound_Transfer_NonWeb_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a single large outbound transfer from an internal host to an external address on a port other than web, DNS or NTP. Bulk uploads over alternate ports or egress paths are a network-side indicator of exfiltration over a medium other than the primary C2 or proxy channel. Intended for firewall zones that contain Linux servers."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1011"
    mitre_technique_name = "Exfiltration Over Other Network Medium"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to NETWORK_CONNECTION with network.sent_bytes, network.direction, target.ip and target.port populated. Scope ingestion or the rule to firewall zones and segments that hold Linux servers, because perimeter logs carry no operating system or process context."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Off-site backup and replication jobs, database or log shipping to external services, large software mirror or repository syncs, SFTP/SCP transfers to partners, and vulnerability scanner or penetration test traffic."
    tuning_guidance = "Add known sync and replication destinations to %global_allowed_domains. Add authorised scanner sources to %global_allowed_scanners. Raise or lower the sent_bytes threshold (default about 50 MB) to match each client's baseline. Extend the excluded port list if the client has more standard egress ports. Consider promoting to Threshold style grouping per source IP if single-flow volumes are too noisy."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.direction = "OUTBOUND"
    $net.network.sent_bytes > 52428800
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 53
    $net.target.port != 123
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1011")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
