/*
  MITRE Technique : T1102 - Web Service
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:52:37.337032+00:00
  Reference       : https://attack.mitre.org/techniques/T1102
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1102_Scripted_Client_API_Posts_To_External_Web_Service {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP(S) POST/PUT/PATCH requests to external API-style URL paths from a scripting or runtime-library user agent, as seen at the perimeter. This is the network-side signature of malware or scripts using a legitimate web service (code hosting, messaging, cloud storage, collaboration APIs) as a C2 or data-relay channel. It requires no endpoint process fields and does not depend on specific service domains."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1102"
    mitre_technique_name = "Web Service"
    log_prerequisites = "Requires proxy or firewall logs with HTTP inspection (TLS decryption or explicit proxy) that populate network.http.method, network.http.user_agent and target.url. Without HTTP-layer visibility the rule will not evaluate."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate automation: IT scripts and RMM or monitoring agents calling SaaS APIs, CI/CD or build agents, developer workstations using SDKs, backup and telemetry agents, and in-house line-of-business applications built on Java, Python or Go that call cloud APIs."
    tuning_guidance = "Add known-good SaaS and vendor API domains to %global_allowed_domains. Add automation or build hosts to %global_allowed_script_hosts. Raise severity for servers and workstations that do not normally run scripts. Consider adding a volume or beaconing threshold variant if the rule is noisy."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT|PATCH)$/ nocase
    $net.network.http.user_agent = /(windowspowershell|powershell|python-requests|python-urllib|aiohttp|go-http-client|winhttp|libcurl|curl\/|okhttp|java\/[0-9]|wininet-scripted|microsoft-cryptoapi-scripted)/ nocase
    $net.target.url = /\/(api|rest|graphql|webhook|webhooks|bot[0-9a-z:_-]+|v[0-9]+(\.[0-9]+)?)\// nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1102")
    $primary_entity = array_distinct($net.principal.ip)
    $source_hostname = array_distinct($net.principal.hostname)
    $destination_host = array_distinct($net.target.hostname)
    $destination_ip = array_distinct($net.target.ip)
    $request_url = array_distinct($net.target.url)
    $user_agent = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
