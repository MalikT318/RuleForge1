/*
  MITRE Technique : T1030 - Data Transfer Size Limits
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:51:12.871944+00:00
  Reference       : https://attack.mitre.org/techniques/T1030
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1030_Linux_Fixed_Size_Outbound_Chunk_Below_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a one-directional outbound flow to an external destination whose sent byte count sits just below a common transfer-size alert threshold (about 1, 5 or 10 MiB) while almost nothing is returned. This is the network footprint of data staged on a Linux host and sent in fixed-size chunks to stay under volumetric alerting. Each matching flow is one chunk. Repeated hits from the same source can be correlated downstream through $primary_entity."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1030"
    mitre_technique_name = "Data Transfer Size Limits"
    log_prerequisites = "Perimeter firewall or proxy flow logs normalised to UDM NETWORK_FLOW with network.sent_bytes and network.received_bytes populated. Linux scoping comes from placing the rule on log feeds covering Linux server segments, because firewall logs carry no process or OS fields."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Backup and replication jobs that use fixed block sizes, log shipping agents, package mirror syncs, object storage multipart uploads with fixed part sizes, CI/CD artifact pushes, telemetry uploads from monitoring agents."
    tuning_guidance = "Add known-good external destinations to %global_allowed_domains and authorised scanner or test sources to %global_allowed_scanners. Adjust the byte bands to sit just below the volumetric thresholds in each client's environment. If a client has no existing thresholds, narrow the bands or add a destination port filter. For stronger fidelity, apply a downstream threshold on repeat hits per source within a time window."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    $net.network.received_bytes < 10240
    (
      ($net.network.sent_bytes >= 996000 and $net.network.sent_bytes <= 1048576) or
      ($net.network.sent_bytes >= 4980000 and $net.network.sent_bytes <= 5242880) or
      ($net.network.sent_bytes >= 9960000 and $net.network.sent_bytes <= 10485760)
    )
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1030")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
