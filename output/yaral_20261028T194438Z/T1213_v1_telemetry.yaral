/*
  MITRE Technique : T1213 - Data from Information Repositories
  Tactic(s)       : Collection
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:21:24.726002+00:00
  Reference       : https://attack.mitre.org/techniques/T1213
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_SaaS_Repository_External_Sharing_Setting_Loosened {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change on a SaaS information repository (document, wiki, file-share or collaboration tenant) that exposes content to anonymous, public, guest or external audiences. Adversaries with a foothold in a SaaS tenant weaken sharing controls to mine or stage repository content for access outside the organisation (T1213, related to T1537). The rule pivots on the resulting configuration state change, not on client-side commands or process creation."
    mitre_tactic = "Collection"
    mitre_technique = "T1213"
    mitre_technique_name = "Data from Information Repositories"
    log_prerequisites = "SaaS or cloud control-plane audit logs that record tenant, site or workspace sharing and access configuration changes, normalised to UDM SETTING_MODIFICATION with a populated metadata.product_event_type or target.resource.name."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Planned external collaboration with partners or vendors, marketing or public documentation sites, administrators onboarding guest users, tenant migrations, and automation that manages sharing policy."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and approved automation or identity principals to %global_allowed_cloud_principals. Add service accounts that manage sharing policy to %global_allowed_service_accounts. If a client uses different setting names, extend the keyword groups in the regex. Raise severity for repositories holding regulated data."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    (
      $setting.metadata.product_event_type = /(anonymous|public|external|guest|anyone|everyone|domain_wide).*(shar|link|access|invite|collaborat)|(shar|link|invite|collaborat).*(anonymous|public|external|guest|anyone|everyone)/ nocase or
      $setting.target.resource.name = /(anonymous|public|external|guest|anyone|everyone|domain_wide).*(shar|link|access|invite|collaborat)|(shar|link|invite|collaborat).*(anonymous|public|external|guest|anyone|everyone)/ nocase
    )
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_cloud_principals
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1213")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $changed_setting = array_distinct($setting.target.resource.name)
    $source_ips = array_distinct($setting.principal.ip)

  condition:
    $setting
}
