/*
  MITRE Technique : T1571 - Non-Standard Port
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:16:43.749325+00:00
  Reference       : https://attack.mitre.org/techniques/T1571
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1571_ESXi_Shell_Tunnel_Or_Listener_NonStandard_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi host shell launching a native network binary in a mode that creates a port-forwarding tunnel (ssh/dbclient with -R, -L or -D) or a raw listener or exec channel (nc, ncat, socat with listen or exec options). Adversaries use these to carry C2 or proxy traffic over arbitrary ports from the hypervisor, since protocol/port pairings on ESXi are normally fixed and well known."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1571"
    mitre_technique_name = "Non-Standard Port"
    log_prerequisites = "ESXi shell command auditing (shell.log or hostd) forwarded to Chronicle and parsed into UDM PROCESS_LAUNCH events with the target process path and command line populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators building temporary SSH tunnels to reach isolated management networks, vendor support sessions, approved troubleshooting with nc to test port reachability in listen mode, and orchestration or backup scripts that use SSH port forwarding."
    tuning_guidance = "Add approved automation parent binaries to %global_allowed_admin_tools and named administrators to %global_allowed_admin_users. Add service accounts that legitimately tunnel to %global_allowed_service_accounts. Any hit from an interactive session outside change windows should be treated as suspicious."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $proc.target.process.file.full_path = /\/(ssh|dbclient)$/ nocase and
        $proc.target.process.command_line = /\s-[RLD]\s?\S*\d{2,5}/
      ) or
      (
        $proc.target.process.file.full_path = /\/(nc|ncat|netcat|socat)$/ nocase and
        $proc.target.process.command_line = /(\s-[a-z]*[le][a-z]*\s|tcp4?-listen|exec:)/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1571")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $process_path = array_distinct($proc.target.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
