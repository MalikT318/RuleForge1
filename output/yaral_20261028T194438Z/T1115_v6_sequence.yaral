/*
  MITRE Technique : T1115 - Clipboard Data
  Tactic(s)       : Collection
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:24:36.808331+00:00
  Reference       : https://attack.mitre.org/techniques/T1115
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1115_Linux_Clipboard_Read_Then_Upload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Linux clipboard-read utility being run to dump clipboard contents, followed within 10 minutes by the same user on the same host launching an HTTP client with data-upload options. This sequence indicates clipboard collection followed by exfiltration."
    mitre_tactic = "Collection"
    mitre_technique = "T1115"
    mitre_technique_name = "Clipboard Data"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry that populates full process paths, command lines, and the user ID for PROCESS_LAUNCH events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers or admins piping clipboard content to a paste service or internal API with curl; desktop automation scripts; accessibility or clipboard-manager tools that read the clipboard and post to a local service; user-authored shell aliases."
    tuning_guidance = "Add approved automation parents and tooling to %global_allowed_admin_tools, and automation identities to %global_allowed_service_accounts. Both events already require the same host and user. If the rule is noisy on developer workstations, add the upload process parents to %global_allowed_script_hosts."

  events:
    $clip.metadata.event_type = "PROCESS_LAUNCH"
    $clip.target.process.file.full_path = /\/(xclip|xsel|wl-paste)$/ nocase
    $clip.target.process.command_line = /(xclip.*\s-(o|out)\b|xsel.*\s(-o|--output|-b|--clipboard)\b|wl-paste)/
    not $clip.principal.process.file.full_path in %global_allowed_admin_tools
    not $clip.principal.user.userid in %global_allowed_service_accounts
    $clip.principal.hostname = $hostname
    $clip.principal.user.userid = $user

    $exfil.metadata.event_type = "PROCESS_LAUNCH"
    $exfil.target.process.file.full_path = /\/(curl|wget)$/ nocase
    $exfil.target.process.command_line = /(\s-d\s|\s-d@|--data|--upload-file|\s-T\s|\s-F\s|--form|--post-data|--post-file|--body-data|--body-file)/
    not $exfil.principal.process.file.full_path in %global_allowed_script_hosts
    not $exfil.principal.user.userid in %global_allowed_service_accounts
    $exfil.principal.hostname = $hostname
    $exfil.principal.user.userid = $user

    $clip.metadata.event_timestamp.seconds <= $exfil.metadata.event_timestamp.seconds

  match:
    $hostname, $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1115")
    $primary_entity = array_distinct($clip.principal.hostname)
    $affected_user = array_distinct($clip.principal.user.userid)
    $clipboard_commands = array_distinct($clip.target.process.command_line)
    $upload_commands = array_distinct($exfil.target.process.command_line)
    $event_count = count($exfil.metadata.id)

  condition:
    $clip and $exfil
}
