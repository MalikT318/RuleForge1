/*
  MITRE Technique : T1083 - File and Directory Discovery
  Tactic(s)       : Discovery
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:23:41.970106+00:00
  Reference       : https://attack.mitre.org/techniques/T1083
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1083_Network_External_Access_To_FileShare_Protocols {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a connection from a non-internal source address to file-sharing and file-transfer service ports (SMB, NetBIOS session, NFS, rsync, FTP, TFTP) as seen by a perimeter device. Adversaries use these protocols to enumerate shares, directories and files on remote systems. The network side of T1083 is visible here when file-service enumeration crosses the perimeter, which gives coverage independent of endpoint command-line telemetry."
    mitre_tactic = "Discovery"
    mitre_technique = "T1083"
    mitre_technique_name = "File and Directory Discovery"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Permitted (accepted) traffic logging must be enabled for the rule to evaluate."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Internet background scanners if denied traffic is logged; authorised vulnerability scanners; approved partner or branch file transfers over SMB, NFS, FTP or TFTP; remote administrators reaching management file services; backup or replication jobs from external sites; device firmware or config transfers over TFTP/FTP from approved management hosts."
    tuning_guidance = "Add approved management or partner source addresses to %global_allowed_mgmt_sources, and authorised scanner addresses to %global_allowed_scanners. If the firewall logs denied traffic, restrict the data feed to allowed connections before deployment to cut internet scan noise. Remove ports 21 and 69 from the rule where FTP/TFTP is routinely used for approved device file transfers."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 445 or
      $net.target.port = 139 or
      $net.target.port = 2049 or
      $net.target.port = 873 or
      $net.target.port = 21 or
      $net.target.port = 69
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1083")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
