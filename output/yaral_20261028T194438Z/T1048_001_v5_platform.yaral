/*
  MITRE Technique : T1048.001 - Exfiltration Over Symmetric Encrypted Non-C2 Protocol
  Tactic(s)       : Exfiltration
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:34:56.067530+00:00
  Reference       : https://attack.mitre.org/techniques/T1048/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1048_001_Linux_Large_Outbound_SSH_SFTP_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a large volume of data sent from an internal host to an external destination over SSH/SFTP/SCP ports (22, 2222). These are the symmetric-encrypted, non-C2 channels native to Linux and Unix servers, and they are commonly used to exfiltrate staged archives. Detection relies on perimeter-observable behaviour only: external destination, SSH-family port and outbound byte volume. It works even when the attacker renames scp/sftp/rsync or uses a custom client."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1048.001"
    mitre_technique_name = "Exfiltration Over Alternative Protocol: Exfiltration Over Symmetric Encrypted Non-C2 Protocol"
    log_prerequisites = "Requires firewall or proxy session logs normalised to NETWORK_CONNECTION with network.sent_bytes populated (session-end or accounting logs). Sessions logged only at start have no byte counts and will not match. Where possible, enrich Linux server assets so the alert can be scoped to Linux hosts."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Offsite backup or replication jobs over SFTP/rsync-over-SSH, software mirroring and artifact publishing from build servers, managed file transfer to partners, admins copying large files to cloud VMs over SSH, and Git-over-SSH pushes of large repositories."
    tuning_guidance = "Add known partner or vendor SFTP endpoints to %global_allowed_domains and bastion or backup source addresses to %global_allowed_mgmt_sources. Raise or lower the 50 MB (52428800 byte) threshold per customer baseline. To restrict the rule to Linux servers, add a principal.platform or asset-based filter if the tenant enriches firewall logs with asset data. Extend the port list if the client runs SSH on other approved non-standard ports."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 22 or $net.target.port = 2222)
    $net.network.sent_bytes > 52428800
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1048.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
