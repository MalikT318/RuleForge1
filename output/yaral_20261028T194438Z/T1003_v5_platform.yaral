/*
  MITRE Technique : T1003 - OS Credential Dumping
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:36:40.528057+00:00
  Reference       : https://attack.mitre.org/techniques/T1003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_Credential_Store_Dump_File_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a file on disk that is a credential-store artefact: an LSASS memory dump, an NTDS.dit copy, or an exported SAM/SECURITY/SYSTEM registry hive. These files are written when credentials are dumped by any tool, including renamed binaries, comsvcs-style DLL abuse, Task Manager dumps, ntdsutil/IFM and hive export. The rule keys on the resulting file artefact rather than on process command lines, so it complements process-creation rules. The platform is Windows, as the target platform requires. No non-Windows variant is written because the target-platform constraints are mandatory."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003"
    mitre_technique_name = "OS Credential Dumping"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with the writing process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and imaging software copying the SAM/SYSTEM hives or NTDS.dit; Windows Error Reporting or crash-dump tooling writing LSASS dumps; authorised red-team or forensic collection; AD migration and IFM media creation by domain admins."
    tuning_guidance = "Add approved backup or imaging executables to %global_allowed_backup_processes and EDR/forensic agents to %global_allowed_security_tools. If crash-dump tooling is noisy, add its process path to %global_allowed_admin_tools. Consider adding legitimate AD maintenance hosts through a hostname exclusion on a per-client basis."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(lsass[^\\]*\.(dmp|mdmp)|ntds\.dit|(sam|security|system)\.(save|bak|hiv|hive))$/ nocase
    not $file.target.file.full_path = /\\windows\\(ntds|system32\\config)\\[^\\]*$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1003")
    $primary_entity = array_distinct($file.principal.hostname)
    $dump_file_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
