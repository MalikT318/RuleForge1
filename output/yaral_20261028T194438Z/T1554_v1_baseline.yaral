/*
  MITRE Technique : T1554 - Compromise Host Software Binary
  Tactic(s)       : Persistence
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:10:42.652010+00:00
  Reference       : https://attack.mitre.org/techniques/T1554
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1554_Program_Files_Binary_Modified_By_NonInstaller {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of an existing executable or DLL under Program Files by a process that is not a recognised installer, servicing component or approved admin tool. Adversaries patch or replace legitimate application binaries to gain persistence, because the trojanised binary runs again whenever the user or a service launches the application."
    mitre_tactic = "Persistence"
    mitre_technique = "T1554"
    mitre_technique_name = "Compromise Host Software Binary"
    log_prerequisites = "Requires EDR or Sysmon file-modification telemetry (for example Sysmon Event ID 11/23 or EDR file-write events) with the writing process populated in principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Third-party application auto-updaters and self-patching agents, software deployment tooling, developer builds written into Program Files, backup or restore jobs, and AV or EDR agents updating their own components."
    tuning_guidance = "Add approved deployment and patching tools to %global_allowed_admin_tools and security agents to %global_allowed_security_tools. Add recovery or imaging software to %global_allowed_backup_processes. Add updater service identities to %global_allowed_service_accounts. Extend the installer-name regex only for per-client servicing binaries that are verified as legitimate."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^[a-z]:\\program files( \(x86\))?\\.+\.(exe|dll)$/ nocase
    not $file.principal.process.file.full_path = /\\(msiexec|trustedinstaller|tiworker|wusa|dism|dismhost|musnotification|usoclient|wuauclt)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1554")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_binary = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_command_line = array_distinct($file.principal.process.command_line)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
