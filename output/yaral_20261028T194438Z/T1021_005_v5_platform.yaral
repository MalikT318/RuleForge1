/*
  MITRE Technique : T1021.005 - VNC
  Tactic(s)       : Lateral Movement
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:42:32.370549+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_005_Linux_VNC_Server_Config_Or_Persistence_File_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of VNC server credential, session-startup or service/autostart files on a Linux host (per-user .vnc passwd/xstartup/config, systemd units, init scripts or XDG autostart entries referencing VNC, and the tigervnc user mapping file). These artefacts are written when a VNC server is provisioned or made persistent, which adversaries do after obtaining valid accounts to enable remote desktop control and lateral movement. The rule keys on the file-write mechanism rather than process command lines, so it complements existing PROCESS_LAUNCH detections."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.005"
    mitre_technique_name = "Remote Services: VNC"
    log_prerequisites = "Requires Linux endpoint file-creation telemetry (EDR file events or auditd watches on /etc/systemd/system, /etc/init.d, /etc/xdg/autostart and user home .vnc directories) normalised to UDM FILE_CREATION with principal.process and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate administrators or desktop-support staff provisioning VNC on workstations or jump hosts; configuration management and provisioning tools deploying VNC units; users setting up a VNC password for approved remote support; VDI/golden-image build pipelines."
    tuning_guidance = "Add approved deployment or configuration tooling executables to %global_allowed_admin_tools, approved remote support tooling to %global_allowed_remote_mgmt, and sanctioned administrator accounts to %global_allowed_admin_users. Add automation accounts to %global_allowed_service_accounts. If VNC is a sanctioned standard in an environment, scope by lowering severity or restricting to non-approved host groups."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(\/\.vnc\/(passwd|xstartup|config)|\/etc\/systemd\/system\/[^\/]*vnc[^\/]*\.service|\/etc\/(xdg\/autostart|init\.d)\/[^\/]*vnc[^\/]*|\/etc\/tigervnc\/vncserver\.users)$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|rpm|apt|apt-get|yum|dnf|zypper|packagekitd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1021.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
