/*
  MITRE Technique : T1070.008 - Clear Mailbox Data
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:10:36.571450+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_008_Mailbox_Export_File_Created_Then_Deleted {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a mailbox data file (PST/OST/NST) created on a Windows host and then deleted at the same path within 10 minutes, by a process other than the mail client. This pattern matches an adversary exporting mailbox content (for example via an Exchange mailbox export request) and then removing the export to hide evidence of email collection. The rule uses file telemetry only, so it does not depend on command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.008"
    mitre_technique_name = "Indicator Removal: Clear Mailbox Data"
    log_prerequisites = "Requires EDR or Sysmon file telemetry (FILE_CREATION and FILE_DELETION) with populated target.file.full_path and principal.process.file.full_path. On Exchange servers, ensure file events are collected for the export staging shares and volumes."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup or archival software that stages and cleans up PST files; eDiscovery or legal-hold export workflows that delete the temporary export after copying it; IT mailbox migration tooling; users deleting a PST they just created through a file manager; help-desk profile rebuilds."
    tuning_guidance = "Add approved backup and archival binaries to %global_allowed_backup_processes. Add migration and export tooling to %global_allowed_admin_tools. Add named mailbox administrators to %global_allowed_admin_users. Raise severity for Exchange server hosts, where unattended PST creation is rare."

  events:
    $create.metadata.event_type = "FILE_CREATION"
    $create.target.file.full_path = /\.(pst|ost|nst)$/ nocase
    not $create.principal.process.file.full_path = /\\outlook\.exe$/ nocase
    not $create.principal.process.file.full_path in %global_allowed_backup_processes
    $create.principal.hostname = $hostname
    $create.target.file.full_path = $path

    $delete.metadata.event_type = "FILE_DELETION"
    $delete.target.file.full_path = /\.(pst|ost|nst)$/ nocase
    not $delete.principal.process.file.full_path in %global_allowed_admin_tools
    not $delete.principal.process.file.full_path in %global_allowed_backup_processes
    not $delete.principal.user.userid in %global_allowed_admin_users
    $delete.principal.hostname = $hostname
    $delete.target.file.full_path = $path

    $create.metadata.event_timestamp.seconds <= $delete.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1070.008")
    $primary_entity = array_distinct($hostname)
    $mailbox_file = array_distinct($path)
    $creating_processes = array_distinct($create.principal.process.file.full_path)
    $deleting_processes = array_distinct($delete.principal.process.file.full_path)
    $deleting_users = array_distinct($delete.principal.user.userid)
    $event_count = count($delete.metadata.id)

  condition:
    $create and $delete
}
