/*
  MITRE Technique : T1574.008 - Path Interception by Search Order Hijacking
  Tactic(s)       : Stealth, Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:35:34.630536+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_008_Search_Order_Hijack_SystemBinary_Dropped {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of an executable file bearing the name of a core Windows system binary (for example net.exe, cmd.exe, reg.exe) outside the trusted OS binary directories. Programs that invoke these tools without a full path will search their own directory first, so a planted look-alike executable is the file-system artifact of search order hijacking. Works at the FILE_CREATION layer and does not depend on command-line logging."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.008"
    mitre_technique_name = "Hijack Execution Flow: Path Interception by Search Order Hijacking"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR file write events or Sysmon Event ID 11) populating target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Portable admin or developer toolkits that bundle copies of system utilities, software installers or updaters that stage helper binaries, Windows servicing and feature-update staging directories, backup or restore jobs that copy OS files, and application packaging or build pipelines."
    tuning_guidance = "Add approved deployment, patching or packaging writer processes to %global_allowed_admin_tools. Add EDR/AV writers to %global_allowed_security_tools. Extend the writer-process regex or the trusted-directory exclusions for servicing paths specific to the client. For noisy build servers, exclude the writer process via the reference lists rather than relaxing the filename set."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(net|net1|cmd|powershell|pwsh|ipconfig|whoami|tasklist|systeminfo|reg|sc|schtasks|wmic|certutil|nslookup|ping|taskkill|netsh|find|findstr|mshta|rundll32|regsvr32|cscript|wscript|bitsadmin|nltest|arp|hostname|route|netstat)\.exe$/ nocase

    // Exclude trusted OS binary locations
    not $file.target.file.full_path = /^[a-z]:\\windows\\(system32|syswow64|winsxs|servicing|softwaredistribution|systemapps)\\/ nocase
    not $file.target.file.full_path = /^[a-z]:\\\$windows\.~(bt|ws)\\/ nocase
    not $file.target.file.full_path = /^[a-z]:\\windows\\system32\\dllcache\\/ nocase

    // Exclude OS servicing and security writers by executable name
    not $file.principal.process.file.full_path = /\\(TiWorker|TrustedInstaller|MoUsoCoreWorker|MsMpEng|MpCmdRun|SenseIR|wuauclt|usoclient)\.exe$/ nocase

    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1574.008")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
