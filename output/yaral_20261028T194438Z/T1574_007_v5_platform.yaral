/*
  MITRE Technique : T1574.007 - Path Interception by PATH Environment Variable
  Tactic(s)       : Stealth, Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:34:57.870515+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_007_PATH_Environment_Registry_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects modification of the persistent PATH environment variable in the registry (system-wide Session Manager\\Environment or per-user Environment key). Adversaries alter PATH to put an attacker-controlled directory ahead of legitimate system directories, so that binaries or DLLs called by name are hijacked. This rule is registry-based and is additive to command-line detections: it also catches changes made through APIs, scripts or tools that never expose a PATH-related command line. The requested alternate-platform angle conflicts with the mandatory Windows platform requirement, so Windows is kept and the telemetry pivots from process launch to registry modification."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.007"
    mitre_technique_name = "Hijack Execution Flow: Path Interception by PATH Environment Variable"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR registry events or Sysmon Event ID 12/13) with registry key path, value name and the modifying process populated in UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and uninstallers (MSI packages, runtimes, SDKs, language toolchains, developer tools) that append to PATH; RMM and configuration-management agents; administrators editing environment variables through System Properties; user profile provisioning at first logon."
    tuning_guidance = "Add approved deployment and configuration tooling executables to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and EDR/AV agents to %global_allowed_security_tools. In developer-heavy estates, expect installer noise and consider raising the threshold by pairing with a user-writable-path check on the value data if your parser populates it. Alert triage should review the new PATH value and the modifying process lineage."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Environment$/ nocase
    $reg.target.registry.registry_value_name = /^path$/ nocase
    $reg.principal.hostname != ""
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1574.007")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
