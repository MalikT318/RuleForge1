/*
  MITRE Technique : T1218.008 - Odbcconf
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:51:53.142142+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_008_Odbcconf_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects odbcconf.exe, the Windows ODBC configuration utility, making a network connection to a non-internal address. Legitimate odbcconf use is local driver and DSN configuration, so outbound traffic from it suggests it is being abused to proxy execution of a remote payload (for example a REGSVR load of a DLL from a remote share or web server) or to stage a download. This is the network-side complement to command-line detections and still fires if the command line is obfuscated or the DLL is renamed."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.008"
    mitre_technique_name = "System Binary Proxy Execution: Odbcconf"
    log_prerequisites = "Requires Windows endpoint network telemetry that attributes each connection to its originating process (EDR network events or Sysmon Event ID 3), normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Database administrators configuring ODBC drivers or DSNs against external or cloud-hosted database servers; software installers that call odbcconf.exe to register drivers fetched from vendor or CDN locations; RMM or deployment tooling that wraps odbcconf.exe."
    tuning_guidance = "Add approved deployment or RMM binaries to %global_allowed_admin_tools. Add known-good vendor or database endpoints to %global_allowed_domains. Extend %rfc1918_internal if the tenant uses other internal ranges, and consider raising severity when the destination is a raw IP with no hostname."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\odbcconf\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.008")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $destination_hosts = array_distinct($net.target.hostname)
    $process_command_line = array_distinct($net.principal.process.command_line)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
