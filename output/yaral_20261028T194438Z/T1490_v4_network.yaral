/*
  MITRE Technique : T1490 - Inhibit System Recovery
  Tactic(s)       : Impact
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:41:22.290936+00:00
  Reference       : https://attack.mitre.org/techniques/T1490
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1490_ESXi_External_Mgmt_Plane_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network connection from a non-internal source address to an ESXi host management-plane service (SSH, HTTPS/SDK API, host agent port). Adversaries who reach these services from outside the environment can delete snapshots, remove backup-related VMs, or disable recovery features before encryption. Network-side coverage that complements endpoint command-line detections. This rule observes the access channel used to inhibit recovery, not the destructive action itself."
    mitre_tactic = "Impact"
    mitre_technique = "T1490"
    mitre_technique_name = "Inhibit System Recovery"
    log_prerequisites = "Requires ESXi or hypervisor firewall/connection telemetry normalised to NETWORK_CONNECTION, with principal.ip as the connecting source and target.hostname/target.port identifying the ESXi host and service."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Remote administrators on VPN or NAT egress addresses not in the allowed management sources list, managed-service or backup providers connecting from public addresses, external vulnerability scanners, and cloud-hosted management or backup appliances."
    tuning_guidance = "Add legitimate admin, VPN egress and provider source addresses to %global_allowed_mgmt_sources. Add authorised scanner addresses to %global_allowed_scanners. Confirm %rfc1918_internal covers the client's internal ranges. Where hosts are legitimately internet-exposed, raise severity only for connections followed by SETTING_MODIFICATION or USER_LOGIN events on the same host."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.hostname != ""
    (
      $net.target.port = 22 or
      $net.target.port = 443 or
      $net.target.port = 902
    )
    $net.principal.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1490")
    $primary_entity = array_distinct($net.target.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
