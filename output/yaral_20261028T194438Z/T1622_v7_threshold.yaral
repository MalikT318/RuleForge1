/*
  MITRE Technique : T1622 - Debugger Evasion
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:49:05.154143+00:00
  Reference       : https://attack.mitre.org/techniques/T1622
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1622_Linux_Repeated_TracerPid_Debugger_Checks {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated launches of commands that read the TracerPid field from /proc/<pid>/status on a single Linux host within 10 minutes. Querying TracerPid is a common debugger and tracer detection technique used by malware and implants to decide whether to disengage or hide functionality. One lookup is benign; repeated lookups from a single host point to automated anti-analysis logic."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1622"
    mitre_technique_name = "Debugger Evasion"
    log_prerequisites = "Requires Linux EDR process-launch telemetry or auditd EXECVE records with full command-line arguments, normalised to UDM PROCESS_LAUNCH with target.process.command_line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers and SREs debugging with gdb, strace or ltrace wrappers; performance and observability agents that read /proc/<pid>/status; container runtime health checks; anti-cheat or licensing software; troubleshooting scripts run by administrators."
    tuning_guidance = "Add approved monitoring, debugging and inventory tooling to %global_allowed_admin_tools and EDR or security agents to %global_allowed_security_tools. Hosts used for software development may need a higher threshold (for example #proc >= 10) or may be excluded through %global_allowed_script_hosts. Raise the threshold on noisy hosts before disabling the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /tracerpid/ nocase
    $proc.target.process.command_line = /\/proc\/(self|\d+|\$\$|\$\{?[a-z_]+\}?|\*)\/status/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1622")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $sample_commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
