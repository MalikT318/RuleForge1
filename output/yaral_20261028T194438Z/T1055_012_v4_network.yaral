/*
  MITRE Technique : T1055.012 - Process Hollowing
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:59:59.111025+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_012_Hollowed_Process_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows process that normally never initiates external network connections (Notepad, Calculator, Paint, WordPad, Character Map, DllHost, ConHost) making an outbound connection to a non-internal address. Process hollowing commonly places C2 or downloader code inside such a benign host process, and the network connection is the visible result. This is a network-side observation and does not rely on process-creation command lines."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.012"
    mitre_technique_name = "Process Injection: Process Hollowing"
    log_prerequisites = "Requires endpoint network telemetry (EDR or Sysmon Event ID 3 equivalent) that populates principal.process.file.full_path on NETWORK_CONNECTION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Notepad or other legacy utilities opening a URL or update check through a plugin; DllHost COM surrogate activity that uses cloud-backed shell extensions (thumbnail or preview handlers for cloud storage); remote-support or accessibility tooling that launches these binaries; sandbox or detonation hosts."
    tuning_guidance = "Add approved tooling parent binaries to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. Add approved remote-support tooling to %global_allowed_remote_mgmt. If DllHost is noisy for a client, remove it from the process regex for that client. Confirm that %rfc1918_internal is populated so internal traffic is excluded."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(notepad|calc|mspaint|wordpad|charmap|dllhost|conhost)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1055.012")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
