/*
  MITRE Technique : T1685.005 - Clear Windows Event Logs
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:24:34.054223+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_005_Mass_EVTX_Log_File_Deletion_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects multiple Windows event log (.evtx) files deleted from the winevt\\Logs directory on a single host within 10 minutes. Deleting one log file can be routine maintenance, but removing several channels in a short window indicates log clearing by file deletion to hide intrusion activity. This is file-telemetry based and is not tied to any particular tool or command line."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.005"
    mitre_technique_name = "Clear Windows Event Logs"
    log_prerequisites = "Requires Windows endpoint file-deletion telemetry (EDR or Sysmon Event ID 23/26) covering the system32\\winevt\\Logs directory, normalised to UDM FILE_DELETION with principal.hostname and target.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Event log automatic archive/rotation cleanup, imaging or sysprep/golden-image preparation, OS reinstall or in-place upgrade, IT log-maintenance scripts, backup or disk-cleanup tools, forensic or lab machine resets."
    tuning_guidance = "Add approved maintenance, imaging and cleanup tooling to %global_allowed_admin_tools, backup software to %global_allowed_backup_processes, and security agents to %global_allowed_security_tools. Raise the #file threshold if hosts routinely rotate archived logs. Exclude known imaging or build hosts via %global_allowed_script_hosts only if they are controlled."

  events:
    $file.metadata.event_type = "FILE_DELETION"
    $file.target.file.full_path = /\\windows\\system32\\winevt\\logs\\[^\\]+\.evtx$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685.005")
    $primary_entity = array_distinct($host)
    $deleted_log_count = count($file.metadata.id)
    $deleted_log_files = array_distinct($file.target.file.full_path)
    $deleting_processes = array_distinct($file.principal.process.file.full_path)
    $deleting_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
