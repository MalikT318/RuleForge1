/*
  MITRE Technique : T1220 - XSL Script Processing
  Tactic(s)       : Stealth
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:12:44.910939+00:00
  Reference       : https://attack.mitre.org/techniques/T1220
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1220_XSL_Stylesheet_Dropped_User_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of an XSL/XSLT stylesheet file in a user-writable or staging directory by a non-approved process. Embedded-script stylesheets are staged this way before being executed by a transformation utility such as msxsl or wmic /format. This is the Windows file-staging angle for T1220. The target platform is Windows only, because XSL script processing via msxsl/wmic/MSXML is a Windows mechanism, so no non-Windows variant is written."
    mitre_tactic = "Stealth"
    mitre_technique = "T1220"
    mitre_technique_name = "XSL Script Processing"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Browsers saving XSL files from legitimate downloads, developers and XML tooling (IDEs, build agents), report-generation or document-conversion software writing temporary stylesheets, and software installers extracting XSLT templates."
    tuning_guidance = "Add approved tooling executables to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, and trusted script hosts or build agents to %global_allowed_script_hosts. If noise remains on developer hosts, exclude those hosts' parent processes via %global_allowed_script_hosts. Pair with a process-launch rule for msxsl/wmic /format execution to raise confidence."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.xslt?$/ nocase
    $file.target.file.full_path = /(\\users\\[^\\]+\\(appdata|downloads|desktop|documents)\\|\\programdata\\|\\windows\\temp\\|\\users\\public\\)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR)\.exe$/ nocase

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1220")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
