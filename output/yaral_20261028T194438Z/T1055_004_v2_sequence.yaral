/*
  MITRE Technique : T1055.004 - Asynchronous Procedure Call
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:50:55.458910+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_004_APC_Process_Handle_Then_Injection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a process opening a handle to a different, commonly abused host process and then performing a process-injection operation against the same target process on the same host within five minutes. This is the handle-acquisition then code-queueing pattern of APC injection (OpenThread/QueueUserAPC, Early Bird, AtomBombing). It uses handle and injection telemetry, not command lines."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.004"
    mitre_technique_name = "Process Injection: Asynchronous Procedure Call"
    log_prerequisites = "Requires endpoint telemetry that reports process handle access (PROCESS_OPEN) and injection events (PROCESS_INJECTION), for example EDR sensors or Sysmon Event IDs 10 and 8, with populated principal and target process paths and PIDs."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Endpoint security agents, application-compatibility shims, accessibility and input-method software, game overlays, debuggers and profilers, and RMM or patching tools that legitimately open and inject into system or user-session processes."
    tuning_guidance = "Add security agents to %global_allowed_security_tools. Add approved deployment or patching tooling to %global_allowed_admin_tools. Add approved backup or imaging software to %global_allowed_backup_processes. If the target-process list is too narrow or too broad for a client, adjust the target regex in both events together."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\(explorer|svchost|notepad|rundll32|dllhost|werfault|spoolsv|winlogon|taskhostw|sihost|runtimebroker|searchindexer|wmiprvse|msiexec)\.exe$/ nocase
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    $open.principal.hostname = $hostname
    $open.principal.process.pid = $src_pid
    $open.target.process.pid = $tgt_pid

    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.target.process.file.full_path = /\\(explorer|svchost|notepad|rundll32|dllhost|werfault|spoolsv|winlogon|taskhostw|sihost|runtimebroker|searchindexer|wmiprvse|msiexec)\.exe$/ nocase
    $inj.principal.process.file.full_path != $inj.target.process.file.full_path
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes
    $inj.principal.hostname = $hostname
    $inj.principal.process.pid = $src_pid
    $inj.target.process.pid = $tgt_pid

    $open.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname, $src_pid, $tgt_pid over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.004")
    $primary_entity = array_distinct($hostname)
    $injecting_process = array_distinct($inj.principal.process.file.full_path)
    $target_process = array_distinct($inj.target.process.file.full_path)
    $injecting_user = array_distinct($inj.principal.user.userid)
    $handle_event_count = count($open.metadata.id)
    $injection_event_count = count($inj.metadata.id)

  condition:
    $open and $inj
}
