/*
  MITRE Technique : T1547.002 - Authentication Package
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:26:02.321090+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_002_LSA_Authentication_Packages_Registry_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a write to the LSA 'Authentication Packages' registry value that sets anything other than the default msv1_0 package. LSA loads every listed DLL at boot, so a new entry gives persistence inside lsass.exe. T1547.002 exists only on Windows, so the alternate-platform angle was not applicable. This rule gives registry-based coverage instead of process command-line matching."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.002"
    mitre_technique_name = "Boot or Logon Autostart Execution: Authentication Package"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR registry events or Sysmon Event ID 12/13/14) that populates target.registry.registry_key and, ideally, registry_value_name and registry_value_data."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate third-party authentication packages (smart card, MFA or credential provider vendors, some SSO agents) at install or upgrade; OS servicing or in-place upgrades; approved IT deployment tooling."
    tuning_guidance = "Add approved installer or deployment binaries to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. Review the value data in the alert and confirm the referenced DLL is signed and expected. If a client's authentication package is legitimate, validate it and exclude its writer process."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      $reg.target.registry.registry_key = /\\Control\\Lsa\\Authentication Packages$/ nocase or
      (
        $reg.target.registry.registry_key = /\\Control\\Lsa$/ nocase and
        $reg.target.registry.registry_value_name = /^Authentication Packages$/ nocase
      )
    )
    not $reg.target.registry.registry_value_data = /^\s*msv1_0\s*$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1547.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_data = array_distinct($reg.target.registry.registry_value_data)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
