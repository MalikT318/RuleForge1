/*
  MITRE Technique : T1189 - Drive-by Compromise
  Tactic(s)       : Initial Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:34:42.709955+00:00
  Reference       : https://attack.mitre.org/techniques/T1189
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1189_IdP_ExternalLogin_Then_PrivilegeChange {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the post-exploitation result of a drive-by compromise against an identity provider. A user sign-in from an external address is followed within 10 minutes by a permission or role change performed by that same account. Stolen session tokens or credentials harvested from a browser-delivered exploit are typically used this way to escalate privileges and persist."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1189"
    mitre_technique_name = "Drive-by Compromise"
    log_prerequisites = "Requires identity provider sign-in logs normalised to USER_LOGIN (with principal.ip and target.user.userid) and directory audit logs normalised to USER_CHANGE_PERMISSIONS (with principal.user.userid)."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Administrators working remotely or over VPN or ISP addresses who change roles right after signing in; helpdesk staff delegating permissions; onboarding automation using personal accounts; privileged identity management role activations that are logged as permission changes."
    tuning_guidance = "Add named administrators to %global_allowed_admin_users and automation identities to %global_allowed_service_accounts. Add corporate egress or VPN addresses to %global_allowed_mgmt_sources. Add privileged-role-activation workflows to the allow lists if they generate frequent matches. Raise the risk score where the permission change targets a privileged role or group."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.user.userid != ""
    $auth.target.user.userid = $user
    $auth.principal.ip != ""
    not $auth.principal.ip in %rfc1918_internal
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users

    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.principal.user.userid = $user
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_admin_users

    $auth.metadata.event_timestamp.seconds <= $perm.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1189")
    $primary_entity = array_distinct($user)
    $source_ips = array_distinct($auth.principal.ip)
    $login_count = count($auth.metadata.id)
    $permission_change_count = count($perm.metadata.id)
    $permission_targets = array_distinct($perm.target.user.userid)

  condition:
    $auth and $perm
}
