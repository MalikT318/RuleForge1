/*
  MITRE Technique : T1003.005 - Cached Domain Credentials
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:45:33.629684+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_005_Registry_Hive_Tool_Outbound_SMB {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows host making an outbound SMB connection (TCP 445) to a non-internal address from the native registry utility, or from a process whose command line saves or exports the SECURITY, SAM or SYSTEM hives. This is the network footprint of dumping cached domain credentials (DCC2/MS-Cache v2) straight to a remote share or exfiltrating hive copies. It complements process command-line rules by keying on the network side effect."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.005"
    mitre_technique_name = "OS Credential Dumping: Cached Domain Credentials"
    log_prerequisites = "Requires endpoint network telemetry that records the initiating process path and, preferably, its command line, for example EDR network events or Sysmon Event ID 3. Ingestion must be mapped to UDM NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators running reg.exe against a remote or off-network file server for backup or export of non-sensitive keys. Approved backup or migration tooling that exports registry data to an external SMB share. Cloud-hosted file shares reached by SMB over a VPN whose address space is missing from the internal list."
    tuning_guidance = "Add approved admin or backup binaries to %global_allowed_admin_tools. Make sure %rfc1918_internal covers all client internal and VPN-assigned ranges so legitimate internal file server traffic is excluded. Raise severity or enable alerting only for servers and domain-joined hosts if workstation noise is high."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 445
    (
      $net.principal.process.file.full_path = /\\reg\.exe$/ nocase or
      $net.principal.process.command_line = /\b(save|export)\b.*\bhk(lm|ey_local_machine)\\(security|sam|system)\b/ nocase
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1003.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $initiating_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
