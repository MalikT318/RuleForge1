/*
  MITRE Technique : T1185 - Browser Session Hijacking
  Tactic(s)       : Collection
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:31:06.094791+00:00
  Reference       : https://attack.mitre.org/techniques/T1185
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1185_Browser_Hijack_Flags_From_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web browser launched with session-manipulation switches (remote debugging, extension sideloading, forced proxy, disabled web security, headless or automation mode) by an unexpected parent process such as an Office application, web server, print spooler, database service or script host. Legitimate users start browsers from the shell, so this lineage suggests browser session hijacking or man-in-the-browser setup."
    mitre_tactic = "Collection"
    mitre_technique = "T1185"
    mitre_technique_name = "Browser Session Hijacking"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and full command line (EDR, Sysmon Event ID 1 or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web application test automation on build or QA servers (headless browsers launched by service hosts), report-rendering or HTML-to-PDF services run by web server or database processes, Office add-ins or macros that open a browser with a proxy for approved workflows, IT kiosk or managed-browser deployment scripts run through script hosts."
    tuning_guidance = "Add approved automation parents and script hosts to %global_allowed_script_hosts, approved deployment or test tooling to %global_allowed_admin_tools, and known automation accounts to %global_allowed_service_accounts. Widen or narrow the parent process regex to match the client's server estate."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|onenote|msaccess|mspub|visio|acrord32|acrobat|w3wp|httpd|nginx|tomcat\d*|php-cgi|sqlservr|spoolsv|wscript|cscript|mshta|wmiprvse)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(chrome|msedge|firefox|brave|opera|vivaldi|iexplore)\.exe$/ nocase
    $proc.target.process.command_line = /(^|\s)--?(remote-debugging-(port|pipe)|load-extension|proxy-server|disable-web-security|headless|marionette)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1185")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
