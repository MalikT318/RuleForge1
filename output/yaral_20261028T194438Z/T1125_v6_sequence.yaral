/*
  MITRE Technique : T1125 - Video Capture
  Tactic(s)       : Collection
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:34:17.938268+00:00
  Reference       : https://attack.mitre.org/techniques/T1125
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1125_Windows_Outbound_Video_Stream_Upload_Sequence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a possible network-side sign of captured video or camera feeds leaving a Windows host. An internal host opens an outbound connection to an external destination on a live-streaming control or ingest port (RTSP or RTMP), then uploads a large volume of data to the same destination within 10 minutes. This is a perimeter-level proxy for T1125 and does not observe the camera API or the capturing process."
    mitre_tactic = "Collection"
    mitre_technique = "T1125"
    mitre_technique_name = "Video Capture"
    log_prerequisites = "Requires firewall or proxy connection logs and flow logs with source IP, destination IP, destination port and sent-byte counts, normalised to UDM NETWORK_CONNECTION and NETWORK_FLOW. Windows endpoint IP-to-host mapping is recommended for triage."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate video conferencing or webcast encoders, IP camera and CCTV systems streaming to approved cloud services, live-streaming and broadcast workstations, and remote support tools that stream screen or camera content."
    tuning_guidance = "Add known-good streaming and conferencing vendor domains to %global_allowed_domains. Raise or lower the sent_bytes threshold to suit client bandwidth baselines. Exclude known broadcast or CCTV segments by adding the source or destination to a client-specific scoped exclusion. Review the port list if the client legitimately uses RTSP or RTMP."

  events:
    $conn.metadata.event_type = "NETWORK_CONNECTION"
    ($conn.target.port = 1935 or $conn.target.port = 554 or $conn.target.port = 8554)
    not $conn.target.ip in %rfc1918_internal
    not $conn.target.hostname in %global_allowed_domains
    $conn.principal.ip = $src_ip
    $conn.target.ip = $dst_ip

    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.network.sent_bytes > 5000000
    not $flow.target.ip in %rfc1918_internal
    not $flow.target.hostname in %global_allowed_domains
    $flow.principal.ip = $src_ip
    $flow.target.ip = $dst_ip

    $conn.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $src_ip, $dst_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1125")
    $primary_entity = array_distinct($src_ip)
    $destination_ips = array_distinct($dst_ip)
    $destination_ports = array_distinct($conn.target.port)
    $max_sent_bytes = max($flow.network.sent_bytes)
    $source_hostnames = array_distinct($conn.principal.hostname)

  condition:
    $conn and $flow
}
