/*
  MITRE Technique : T1016.001 - Internet Connection Discovery
  Tactic(s)       : Discovery
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:45:47.441517+00:00
  Reference       : https://attack.mitre.org/techniques/T1016/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_001_Linux_CLI_HTTP_Client_Connectivity_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Network-side detection of a scripted or command-line HTTP client (curl, wget, python, perl user agents) issuing a bare GET to the root or a well-known connectivity-check path of an external host. This is the typical Linux internet connectivity check performed before C2 contact. It covers the same behavior as endpoint command-line rules by observing the HTTP traffic, not the process creation."
    mitre_tactic = "Discovery"
    mitre_technique = "T1016.001"
    mitre_technique_name = "System Network Configuration Discovery: Internet Connection Discovery"
    log_prerequisites = "Requires NETWORK_HTTP telemetry with user agent, method and URL populated (web proxy, egress firewall with HTTP inspection, or an EDR/network sensor that decodes HTTP)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package manager and configuration management health checks, monitoring and uptime scripts, container or cloud-init readiness probes, NTP/proxy reachability tests run by admins, CI/CD runners checking connectivity."
    tuning_guidance = "Add sanctioned update, monitoring and vendor destinations to %global_allowed_domains. Add approved automation hosts to %global_allowed_script_hosts. Add approved tooling binaries to %global_allowed_admin_tools. Consider raising severity for servers that should have no direct internet egress."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET"
    $net.network.http.user_agent = /^(curl|wget|python-requests|python-urllib|libwww-perl)/ nocase
    $net.target.url = /^https?:\/\/[^\/?#]+(\/|\/generate_204|\/gen_204|\/success\.txt|\/connecttest\.txt)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1016.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
