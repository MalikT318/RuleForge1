/*
  MITRE Technique : T1613 - Container and Resource Discovery
  Tactic(s)       : Discovery
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:36:34.568116+00:00
  Reference       : https://attack.mitre.org/techniques/T1613
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1613_Container_Resource_Discovery_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single identity issues a high volume of list/get requests against Kubernetes control-plane discovery endpoints (pods, nodes, namespaces, deployments, services, secrets, configmaps) within 10 minutes. Each request is benign on its own; the volume suggests enumeration of the cluster by a compromised account or service-account token."
    mitre_tactic = "Discovery"
    mitre_technique = "T1613"
    mitre_technique_name = "Container and Resource Discovery"
    log_prerequisites = "Kubernetes API server audit logging enabled at Metadata level or higher, with the verb mapped to metadata.product_event_type and the request URI mapped to target.url. The requesting identity must be populated in principal.user.userid."
    platform = "Containers"
    log_source = "container"
    false_positives = "CI/CD and GitOps controllers, monitoring and observability agents, cluster autoscalers, admission controllers, kubectl or dashboard use by administrators, and inventory or compliance scanners that enumerate cluster objects."
    tuning_guidance = "Add expected automation identities to %global_allowed_service_accounts, administrators to %global_allowed_admin_users, and approved scanners to %global_allowed_scanners. Raise or lower the #access threshold per tenant after observing a baseline. Make sure kube-system and node identities are not already excluded upstream."

  events:
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.metadata.product_event_type = /^(list|get)$/ nocase
    $access.target.url = /\/(api|apis)\/([^\/]+\/)*(pods|nodes|namespaces|deployments|daemonsets|replicasets|statefulsets|services|configmaps|secrets|cronjobs|jobs|serviceaccounts)(\/|\?|$)/ nocase
    $access.principal.user.userid = $user
    not $access.principal.user.userid = /^system:(node|kube-|apiserver|serviceaccount:kube-system)/ nocase
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_admin_users
    not $access.principal.ip in %global_allowed_scanners

  match:
    $user over 10m

  outcome:
    $risk_score = max(if($access.target.url = /(secrets|nodes|serviceaccounts)/ nocase, 70, 45))
    $mitre_technique_id = array_distinct("T1613")
    $primary_entity = array_distinct($user)
    $event_count = count($access.metadata.id)
    $distinct_endpoints = count_distinct($access.target.url)
    $source_ips = array_distinct($access.principal.ip)
    $sample_urls = array_distinct($access.target.url)

  condition:
    #access >= 25
}
