/*
  MITRE Technique : T1565 - Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:37:47.734447+00:00
  Reference       : https://attack.mitre.org/techniques/T1565
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_001_Linux_Direct_Datastore_File_Tampering {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects built-in Linux utilities (sed -i, truncate, dd of=, shred, tee) launched against on-disk database or datastore directories such as /var/lib/mysql or /var/lib/postgresql. Editing datastore files directly bypasses the database engine's integrity controls, transaction logs and audit trails. It is a stored-data manipulation technique for altering records, or destroying them, without leaving normal application-level evidence."
    mitre_tactic = "Impact"
    mitre_technique = "T1565"
    mitre_technique_name = "Data Manipulation"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to PROCESS_LAUNCH with full command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "DBAs performing approved manual recovery or maintenance, backup, restore or migration scripts that use dd or tee against data directories, configuration management runs that relocate datastores, storage decommissioning that uses shred or truncate on retired volumes."
    tuning_guidance = "Add backup and restore tooling to %global_allowed_backup_processes. Add approved DBA or maintenance tooling to %global_allowed_admin_tools. Add automation and orchestration accounts to %global_allowed_service_accounts. Extend the datastore directory list if clients run other engines in non-default locations."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(sed|truncate|dd|shred|tee)$/ nocase
    $proc.target.process.command_line = /(\bsed\b.*\s-[a-z]*i|\btruncate\b.*\s(-s|--size)|\bdd\b.*\bof=|\bshred\b|\btee\b).*\/var\/lib\/(mysql|mariadb|postgresql|pgsql|mongodb|mongo|redis|couchdb|influxdb|elasticsearch|cassandra)\// nocase
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1565")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $tamper_command = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
