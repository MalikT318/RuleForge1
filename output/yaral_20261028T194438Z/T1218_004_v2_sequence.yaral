/*
  MITRE Technique : T1218.004 - InstallUtil
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:46:45.613370+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_004_InstallUtil_Launch_Then_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "InstallUtil.exe is launched against an assembly in a user-writable location and the same host then sees InstallUtil.exe make an outbound connection to an external address within 10 minutes. This indicates proxy execution of a .NET payload with command-and-control or staging behaviour, not routine installer activity. The rule correlates process and network telemetry rather than matching a command line alone."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.004"
    mitre_technique_name = "System Binary Proxy Execution: InstallUtil"
    log_prerequisites = "Requires endpoint telemetry that populates both PROCESS_LAUNCH and NETWORK_CONNECTION events with the initiating process path (EDR or Sysmon Event IDs 1 and 3)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers or developer builds that run InstallUtil from a user profile or temp directory and download components or licences. Internal build and deployment pipelines. Admins installing .NET services from a staging folder."
    tuning_guidance = "Add approved deployment tooling to %global_allowed_admin_tools (matched against the parent process path). Add deployment and service accounts to %global_allowed_service_accounts. Exclude known vendor update destinations through %global_allowed_domains if network events carry a domain. Widen or narrow the path regex on the launch event to match the client's software staging conventions."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\installutil\.exe$/ nocase
    $proc.target.process.command_line = /(\\users\\|\\temp\\|\\appdata\\|\\programdata\\|\\downloads\\|\\public\\)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\installutil\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    $net.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1218.004")
    $primary_entity = array_distinct($hostname)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $installutil_command_lines = array_distinct($proc.target.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $proc and $net
}
