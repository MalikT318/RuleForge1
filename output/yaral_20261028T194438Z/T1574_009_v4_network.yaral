/*
  MITRE Technique : T1574.009 - Path Interception by Unquoted Path
  Tactic(s)       : Stealth, Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:38:19.428557+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_009_Unquoted_Path_Hijack_Binary_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound external network connection made by an executable sitting at a drive root (e.g. C:\\Program.exe) or directly inside a Program Files directory. These are the truncated-path locations Windows probes when resolving an unquoted service or shortcut path containing spaces. Legitimate software installs into a vendor subfolder, so a process running from these locations that reaches an external address strongly suggests a planted path-interception binary calling back after being launched by a service or shortcut."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.009"
    mitre_technique_name = "Hijack Execution Flow: Path Interception by Unquoted Path"
    log_prerequisites = "Requires endpoint network telemetry (EDR or Sysmon Event ID 3 equivalent) that populates principal.process.file.full_path on NETWORK_CONNECTION events, and target.ip."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy line-of-business applications installed directly to the drive root or directly in Program Files without a vendor subfolder, portable utilities run from C:\\, hardware vendor tools, and home-grown agents that phone home."
    tuning_guidance = "Add approved binaries to %global_allowed_admin_tools or %global_allowed_remote_mgmt, and EDR/AV agents to %global_allowed_security_tools. Add legitimate external destinations to %global_allowed_domains if target hostname is populated in your telemetry. Validate hits by checking whether a service ImagePath on the host is unquoted and contains spaces."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^[a-z]:\\([^\\]+\.exe|program files( \(x86\))?\\[^\\]+\.exe)$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1574.009")
    $primary_entity = array_distinct($net.principal.hostname)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $process_user = array_distinct($net.principal.user.userid)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
