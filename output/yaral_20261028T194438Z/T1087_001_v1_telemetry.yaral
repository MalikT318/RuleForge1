/*
  MITRE Technique : T1087.001 - Local Account
  Tactic(s)       : Discovery
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:51:59.086254+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_001_Account_Enumeration_Output_File_Staged {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects a script host or command interpreter writing a file whose name indicates local user or group enumeration output (for example the redirected result of a local account listing) into a user-writable staging location. This detects the resulting file artifact rather than the command line, so it still fires when command-line logging is evaded or the command is obfuscated."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.001"
    mitre_technique_name = "Account Discovery: Local Account"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating principal.process.file.full_path and target.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT inventory or audit scripts that export local user and group lists, RMM health checks, administrators documenting local accounts, and compliance tooling writing account reports to temp or ProgramData."
    tuning_guidance = "Add approved audit and inventory tooling to %global_allowed_admin_tools, trusted automation hosts to %global_allowed_script_hosts, and administrator accounts to %global_allowed_admin_users. Raise severity when the same host also shows other discovery or credential-access alerts."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|wmic|mshta)\.exe$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata\\local\\temp|downloads|desktop|documents)|users\\public|programdata|windows\\temp|temp|perflogs)\\([^\\]+\\)*[^\\]*(local[_\-. ]?(users?|accounts?|groups?|admins?)|net[_\-. ]?(user|localgroup)|(user|account)s?[_\-. ]?(list|enum|dump|output)|userlist|acctlist)[^\\]*\.(txt|csv|log|out|dat)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.hostname in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1087.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $user = array_distinct($file.principal.user.userid)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $created_file = array_distinct($file.target.file.full_path)

  condition:
    $file
}
