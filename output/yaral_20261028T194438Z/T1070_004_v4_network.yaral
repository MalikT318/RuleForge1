/*
  MITRE Technique : T1070.004 - File Deletion
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:05:16.985006+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_004_Linux_Deleted_Staging_Binary_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound connection to a non-internal address from a process whose executable has been deleted from a world-writable staging directory (/tmp, /var/tmp, /dev/shm). Linux marks the executable path of a running process as '(deleted)' after the binary is unlinked. This is the network-side footprint of self-deleting malware or a dropper that removes its payload after launch (T1070.004) and keeps beaconing from memory."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.004"
    mitre_technique_name = "Indicator Removal: File Deletion"
    log_prerequisites = "Requires Linux endpoint network telemetry (EDR or auditd with socket/connect auditing) that populates the principal process executable path as resolved from /proc/<pid>/exe, including the '(deleted)' suffix. Hosts whose agents strip this suffix will not generate matches."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Installers or self-updating agents that run from /tmp and remove themselves while still communicating; software build or CI jobs that clean their work directories mid-run; admin scripts that unlink a helper binary after launch; package or RMM tooling that unpacks to /tmp or /var/tmp."
    tuning_guidance = "Add approved updater, deployment or RMM binaries to %global_allowed_admin_tools, EDR and AV agents to %global_allowed_security_tools, and approved automation hosts to %global_allowed_script_hosts. Add known-good destination domains to %global_allowed_domains if the telemetry carries a hostname. To widen coverage, extend the directory alternation in the path regex with other writable paths used in the environment, such as /run/user."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.*\s\(deleted\)$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1070.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $deleted_binary_path = array_distinct($net.principal.process.file.full_path)
    $process_command_line = array_distinct($net.principal.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
