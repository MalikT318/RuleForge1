/*
  MITRE Technique : T1552.008 - Chat Messages
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:57:49.548776+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_008_SaaS_Chat_Read_Scope_Granted_To_App {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an identity-provider permission or consent grant that gives an application or integration the ability to read chat, channel or conversation message content (for example message-history or chat-read scopes). Adversaries abuse OAuth consent or integration tokens to harvest credentials, API keys and tokens that users share in collaboration platforms."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.008"
    mitre_technique_name = "Unsecured Credentials: Chat Messages"
    log_prerequisites = "Identity provider directory and audit logs that record consent, delegated-permission or app-role grants, with scope names carried in metadata.description or target.resource.name, and mapped to USER_CHANGE_PERMISSIONS."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Sanctioned productivity, archiving, compliance/eDiscovery, DLP and chat-bot integrations onboarded by IT; admins pre-consenting approved apps tenant-wide; helpdesk or workflow automation that legitimately reads channel history."
    tuning_guidance = "Add approved integration or application identifiers to %global_allowed_cloud_principals, onboarding admins to %global_allowed_admin_users, and automation identities to %global_allowed_service_accounts. Tighten the scope regex if a client uses non-standard scope naming. Review grants made by non-admin users or to newly registered apps first."

  events:
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.metadata.product_event_type = /(consent|grant|oauth|delegat|app.?role|permission|authori[sz]e)/ nocase
    (
      $perm.target.resource.name = /\b(chat|channelmessage|messages?|conversations?|channels|groups|im|mpim|search)[._:](read|history)/ nocase or
      $perm.metadata.description = /\b(chat|channelmessage|messages?|conversations?|channels|groups|im|mpim|search)[._:](read|history)/ nocase
    )
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.target.application in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1552.008")
    $primary_entity = array_distinct($perm.principal.user.userid)
    $granted_application = array_distinct($perm.target.application)
    $granted_scope = array_distinct($perm.target.resource.name)
    $source_ip = array_distinct($perm.principal.ip)

  condition:
    $perm
}
