/*
  MITRE Technique : T1204 - User Execution
  Tactic(s)       : Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:56:53.690706+00:00
  Reference       : https://attack.mitre.org/techniques/T1204
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_Container_Pod_Created_By_Interactive_Identity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a pod directly by an interactive (human or API-token) identity in the container control plane audit log, rather than by a controller or system account. This is the state change produced when a user is tricked into, or an adversary with a stolen identity chooses to, run an arbitrary container workload (T1204 User Execution of a container). It is detected at the resource-creation layer, so it does not depend on command-line logging inside the container."
    mitre_tactic = "Execution"
    mitre_technique = "T1204"
    mitre_technique_name = "User Execution"
    log_prerequisites = "Kubernetes API server audit logging (or managed-cluster control plane audit logs) ingested into Chronicle and normalised to RESOURCE_CREATION with target.resource.resource_type populated as POD and principal.user.userid set to the calling identity."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Developers and SREs running ad-hoc debug pods or one-off jobs; CI/CD pipelines authenticating with a human-style or federated identity; GitOps tooling that authenticates as a named user; break-glass administrator activity."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users, automation identities to %global_allowed_service_accounts, and approved federated pipeline principals to %global_allowed_cloud_principals. If dev or sandbox clusters are noisy, scope them out per client at the ingestion or rule-override level. Raise severity for production clusters."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.target.resource.resource_type = "POD"
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid = /^(system|eks|gke|aks):/ nocase
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1204")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $pod_names = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
