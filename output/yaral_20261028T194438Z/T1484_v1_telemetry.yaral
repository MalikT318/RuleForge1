/*
  MITRE Technique : T1484 - Domain or Tenant Policy Modification
  Tactic(s)       : Defense Impairment, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:30:28.431301+00:00
  Reference       : https://attack.mitre.org/techniques/T1484
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1484_Identity_Federation_Trust_Setting_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change to domain or tenant federation, trust, or external identity-provider settings in an identity platform's directory audit log. Adversaries who modify these settings can add an attacker-controlled federation trust, forge tokens accepted by the tenant, or weaken authentication policy tenant-wide. The rule pivots on the resulting configuration state change (SETTING_MODIFICATION), not on commands or processes."
    mitre_tactic = "Defense Impairment, Privilege Escalation"
    mitre_technique = "T1484"
    mitre_technique_name = "Domain or Tenant Policy Modification"
    log_prerequisites = "Identity provider directory/admin audit logs ingested and parsed to UDM with SETTING_MODIFICATION events. metadata.product_event_type must carry the audit operation name, and principal.user.userid the acting administrator."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Planned federation onboarding or migration projects, merger and acquisition domain consolidation, certificate rollover on an existing federation trust, approved identity-provider integrations (SSO for new SaaS apps), and automation accounts that sync identity configuration."
    tuning_guidance = "Add named administrators who own federation and trust changes to %global_allowed_admin_users. Add identity-sync and automation accounts to %global_allowed_service_accounts. Where the audit log uses different operation names, extend the product_event_type regex. During planned migrations, temporarily downgrade severity rather than disabling the rule."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(federat|domain.?authentication|domain.?trust|cross.?tenant|trust.?(relationship|setting)|idp\.lifecycle|identity.?provider|external.?identity|token.?(signing|issuance).?polic)/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1484")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $operation_names = array_distinct($setting.metadata.product_event_type)
    $target_resources = array_distinct($setting.target.resource.name)
    $source_ips = array_distinct($setting.principal.ip)

  condition:
    $setting
}
