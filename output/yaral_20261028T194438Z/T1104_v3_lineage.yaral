/*
  MITRE Technique : T1104 - Multi-Stage Channels
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:59:32.472177+00:00
  Reference       : https://attack.mitre.org/techniques/T1104
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1104_ESXi_Daemon_Spawns_Shell_Staging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi management or network service daemon (hostd, vpxa, sfcb, openwsman, slpd, rhttpproxy, envoy, snmpd) spawning a shell or script interpreter whose command line fetches a payload or opens a socket. Daemons do not normally launch interactive shells. This lineage anomaly points to exploitation of a management service, followed by a second-stage download or reverse shell, which is the multi-stage C2 pattern."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1104"
    mitre_technique_name = "Multi-Stage Channels"
    log_prerequisites = "ESXi shell and process execution logging forwarded to Chronicle and parsed into UDM PROCESS_LAUNCH events with parent and child process paths and command lines (for example, auditd-style or shell.log process telemetry from the host)."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Vendor or partner management plug-ins and CIM providers that run helper shell scripts; host profile, patching, or lifecycle tooling that runs wrapper scripts through hostd or vpxa; monitoring agents that call curl or wget through a shell for health checks; backup agents that run scripts from a management daemon."
    tuning_guidance = "Add approved parent binaries (for example, vendor plug-in launchers) to %global_allowed_admin_tools. Add sanctioned monitoring or EDR parents to %global_allowed_security_tools. If a daemon legitimately runs a download helper, narrow the parent regex or add the parent to the allowlist rather than loosening the command-line match."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(hostd|vpxa|sfcbd|sfcb-[a-z0-9_-]+|openwsmand|rhttpproxy|envoy|slpd|snmpd|vmware-fdm)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|ash|bash|dash|busybox|python[0-9.]*|perl)$/ nocase
    $proc.target.process.command_line = /(\b(wget|curl|nc|ncat|netcat|tftp|ftpget)\b.*(http|ftp|:\/\/|\s[0-9]{1,3}(\.[0-9]{1,3}){3}\b|\s-e\s)|\/dev\/(tcp|udp)\/|mkfifo|socket\.socket|\|\s*(sh|bash|ash)\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1104")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
