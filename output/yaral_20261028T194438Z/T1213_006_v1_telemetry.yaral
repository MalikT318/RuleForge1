/*
  MITRE Technique : T1213.006 - Databases
  Tactic(s)       : Collection
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:30:14.139365+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_006_Database_Snapshot_Sharing_Permission_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a permission change on a managed database snapshot or backup that grants access to another account or to the public. Attackers with cloud credentials use this to copy database contents into an environment they control, collecting the data without querying the database. The rule fires on the control-plane permission change rather than on any host command line."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.006"
    mitre_technique_name = "Data from Information Repositories: Databases"
    log_prerequisites = "Cloud control-plane audit logging (management/admin write events) must be enabled and ingested into UDM with metadata.product_event_type populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Planned cross-account snapshot sharing for DR, migrations or dev/test refreshes; backup and DR automation roles; DBA teams copying snapshots into approved analytics or sandbox accounts."
    tuning_guidance = "Add automation and DR identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named DBAs to %global_allowed_admin_users. Raise severity to Critical if the snapshot is shared publicly. Review the destination account against the client's known account inventory."

  events:
    $perm.metadata.event_type = "RESOURCE_PERMISSIONS_CHANGE"
    $perm.metadata.product_event_type = /^(Modify(DB|DBCluster)SnapshotAttribute|(Share|Modify)(Database|DB)?Snapshot(Permission|Attribute|Access)s?)$/ nocase
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_cloud_principals
    not $perm.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1213.006")
    $primary_entity = array_distinct($perm.principal.user.userid)
    $snapshot_resources = array_distinct($perm.target.resource.name)
    $source_ips = array_distinct($perm.principal.ip)
    $api_calls = array_distinct($perm.metadata.product_event_type)

  condition:
    $perm
}
