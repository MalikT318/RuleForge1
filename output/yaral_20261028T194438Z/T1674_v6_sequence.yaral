/*
  MITRE Technique : T1674 - Input Injection
  Tactic(s)       : Execution
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:19:10.038508+00:00
  Reference       : https://attack.mitre.org/techniques/T1674
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1674_Linux_Virtual_Input_Device_Then_Shell_Exec {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a process referencing the Linux virtual input device interface (uinput) to synthesise keyboard or mouse input, followed within 10 minutes by an interactive shell launching a binary from a world-writable directory (/tmp, /var/tmp, /dev/shm) under the same user on the same host. This pattern is consistent with simulated keystrokes being used to run attacker-supplied payloads."
    mitre_tactic = "Execution"
    mitre_technique = "T1674"
    mitre_technique_name = "Input Injection"
    log_prerequisites = "Requires Linux EDR or auditd process telemetry normalised to UDM PROCESS_LAUNCH, with populated command line, parent process path, hostname and user fields. The uinput stage relies on the command line referencing the uinput device or library; direct file-descriptor opens without a command-line reference are not visible."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Remote desktop and screen-sharing servers, accessibility and on-screen keyboard software, game and input remapping utilities, KVM-over-IP agents, UI test automation frameworks, and developers building or testing from /tmp shortly after using input tooling."
    tuning_guidance = "Add approved remote desktop and support tooling to %global_allowed_remote_mgmt, IT automation binaries to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and legitimate build or test shells to %global_allowed_script_hosts. If UI test hosts are noisy, exclude them by adding the test runner to %global_allowed_admin_tools."

  events:
    $inj.metadata.event_type = "PROCESS_LAUNCH"
    $inj.target.process.command_line = /(\/dev\/(input\/)?uinput|\buinput\b)/ nocase
    not $inj.target.process.file.full_path = /\/(modprobe|insmod|lsmod|depmod|udevadm|systemd-modules-load|kmod)$/ nocase
    not $inj.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.user.userid in %global_allowed_service_accounts
    $inj.principal.hostname = $hostname
    $inj.principal.user.userid = $user

    $exec.metadata.event_type = "PROCESS_LAUNCH"
    $exec.principal.process.file.full_path = /\/(bash|zsh|sh|dash|fish|ksh)$/ nocase
    $exec.target.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+/ nocase
    not $exec.principal.process.file.full_path in %global_allowed_script_hosts
    not $exec.principal.user.userid in %global_allowed_service_accounts
    $exec.principal.hostname = $hostname
    $exec.principal.user.userid = $user

    $inj.metadata.event_timestamp.seconds <= $exec.metadata.event_timestamp.seconds

  match:
    $hostname, $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1674")
    $primary_entity = array_distinct($inj.principal.hostname)
    $affected_user = array_distinct($user)
    $input_commands = array_distinct($inj.target.process.command_line)
    $executed_payloads = array_distinct($exec.target.process.file.full_path)
    $payload_command_lines = array_distinct($exec.target.process.command_line)
    $injection_event_count = count($inj.metadata.id)
    $exec_event_count = count($exec.metadata.id)

  condition:
    $inj and $exec
}
