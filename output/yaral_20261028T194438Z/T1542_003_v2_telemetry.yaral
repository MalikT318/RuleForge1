/*
  MITRE Technique : T1542.003 - Bootkit
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:46:24.332230+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_003_ESP_Bootloader_File_Modified_By_Untrusted_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects modification of a UEFI boot loader binary (.efi) located under an \\EFI\\ directory on the EFI System Partition by a process that is not a known OS servicing component, approved admin tool or security tool. Patching or replacing ESP boot files is the core file-level artifact of a UEFI bootkit, and it is visible regardless of how the attacker hid their command line."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.003"
    mitre_technique_name = "Pre-OS Boot: Bootkit"
    log_prerequisites = "Requires endpoint file-write telemetry that covers the EFI System Partition (EDR, or Sysmon Event ID 11/23 with the ESP mounted or visible as a volume path). The ESP is not mounted by default on Windows, so coverage depends on the sensor seeing volume-level paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows cumulative updates and feature upgrades that rewrite bootmgfw.efi; Secure Boot DB/DBX or boot manager revocation updates (for example the BlackLotus mitigations); dual-boot or Linux installers that write shim/GRUB to the ESP; OEM firmware and driver update utilities; disk imaging and OS deployment tooling; hypervisor or recovery media tools."
    tuning_guidance = "Add approved deployment, imaging and firmware-update tool binaries to %global_allowed_admin_tools and endpoint security agents to %global_allowed_security_tools. Extend the servicing process regex if the client uses other in-box OS servicing executables. Review hits on hosts mid-OS-upgrade or patching before escalating."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /(^|\\)EFI\\.+\.efi$/ nocase
    not $file.principal.process.file.full_path = /\\(TiWorker|TrustedInstaller|bcdboot|SetupHost|SetupPrep|MoUsoCoreWorker|bootim)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1542.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
