/*
  MITRE Technique : T1573.001 - Symmetric Cryptography
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:23:47.796260+00:00
  Reference       : https://attack.mitre.org/techniques/T1573/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1573_001_ESXi_SSH_Client_Or_Tunnel_Enablement {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi host configuration change that enables the outbound SSH client firewall ruleset or turns on SSH TCP forwarding, tunnelling or gateway ports. These changes let a compromised hypervisor build AES-encrypted SSH tunnels for C2 or pivoting. The rule targets the setting change on the host, not a process command line."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1573.001"
    mitre_technique_name = "Encrypted Channel: Symmetric Cryptography"
    log_prerequisites = "ESXi hostd and shell logs forwarded and parsed into UDM as SETTING_MODIFICATION, with the event description carrying the firewall ruleset or sshd configuration change text."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators temporarily enabling the SSH client for host-to-host file transfer or troubleshooting. Host profile or desired-state remediation, lifecycle tooling, and automation that reapplies sshd or firewall settings during build or patching."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Treat any hit outside a change window as high priority. Correlate with a following outbound NETWORK_CONNECTION on port 22 from the same host."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.principal.hostname != ""
    (
      $setting.metadata.description = /(rule\s?set.{0,40}ssh\s?client|ssh\s?client.{0,60}(enable|allowed))/ nocase or
      $setting.metadata.description = /(AllowTcpForwarding|PermitTunnel|GatewayPorts)\s*[="]?\s*(yes|all|true|local|remote)/ nocase or
      $setting.security_result.description = /(rule\s?set.{0,40}ssh\s?client|ssh\s?client.{0,60}(enable|allowed))/ nocase or
      $setting.security_result.description = /(AllowTcpForwarding|PermitTunnel|GatewayPorts)\s*[="]?\s*(yes|all|true|local|remote)/ nocase
    )
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1573.001")
    $primary_entity = array_distinct($setting.principal.hostname)
    $acting_user = array_distinct($setting.principal.user.userid)

  condition:
    $setting
}
