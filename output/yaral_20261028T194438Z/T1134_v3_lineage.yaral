/*
  MITRE Technique : T1134 - Access Token Manipulation
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:51:31.384178+00:00
  Reference       : https://attack.mitre.org/techniques/T1134
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_Unexpected_Parent_Spawns_Shell_Privileged_Token {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter launched by a parent process that should never spawn one (Office application, web server worker, print spooler, database service) where the child runs in a SYSTEM security context or the command line uses runas-style alternate credentials. A child holding a more privileged token than its exposed parent suggests token theft, impersonation, or create-process-with-token activity after exploitation."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134"
    mitre_technique_name = "Access Token Manipulation"
    log_prerequisites = "Requires Windows endpoint process telemetry (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing) populating parent process path, child process path, command line, and the launching user."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Print-management or driver-install workflows where the spooler legitimately launches cmd or rundll32 helpers; SQL Server agent jobs or xp_cmdshell used by approved maintenance; web applications that intentionally shell out for deployment or health checks; Office macros and add-ins in managed line-of-business workflows; administrators using runas from a scripted Office or web-hosted tool."
    tuning_guidance = "Add approved parent binaries to %global_allowed_script_hosts and approved IT tooling to %global_allowed_admin_tools. Add known automation accounts to %global_allowed_service_accounts. If spoolsv or sqlservr is noisy in a given client environment, check the command line first and then allowlist the specific parent through the reference lists instead of removing it from the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|w3wp|httpd|nginx|tomcat\d*|php-cgi|spoolsv|sqlservr|mysqld)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    (
      $proc.principal.user.userid = /^((nt authority\\)?system|s-1-5-18)$/ nocase or
      $proc.target.process.command_line = /\brunas\b.*\/(savecred|netonly|user)/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1134")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $launching_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
