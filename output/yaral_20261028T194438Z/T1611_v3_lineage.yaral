/*
  MITRE Technique : T1611 - Escape to Host
  Tactic(s)       : Privilege Escalation
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:31:19.537256+00:00
  Reference       : https://attack.mitre.org/techniques/T1611
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1611_ESXi_VM_Process_Spawns_Host_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects a shell or script interpreter launched directly by a virtual machine userworld process (vmx) or by a network-facing host management daemon (reverse proxy, CIM broker, WS-Management). Guest workloads and these daemons should never spawn an interactive shell on the hypervisor. This lineage is a strong indicator of a guest-to-host escape or exploitation of an exposed management service."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1611"
    mitre_technique_name = "Escape to Host"
    log_prerequisites = "ESXi shell and process execution telemetry forwarded to Chronicle and parsed to UDM PROCESS_LAUNCH, with parent and child process paths populated. Requires a log forwarder or agent that records process lineage on the host."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "CIM providers or hardware monitoring agents that call shell wrapper scripts via the CIM broker; management daemons running approved health-check or maintenance scripts; monitoring or backup agents launched through management services; short-lived troubleshooting sessions during vendor support."
    tuning_guidance = "Add approved parent binaries to %global_allowed_script_hosts. Add known automation accounts to %global_allowed_service_accounts. If a CIM or monitoring agent triggers the rule consistently, allowlist its parent path rather than widening the child regex. Confirm that the parent path field is populated for your forwarder before deployment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(vmx|vmx-debug|vmx-stats|rhttpproxy|sfcbd|openwsmand)$/ nocase
    $proc.target.process.file.full_path = /\/(ash|sh|bash|dash|busybox|python[0-9.]*|perl)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1611")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
