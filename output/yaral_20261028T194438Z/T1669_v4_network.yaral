/*
  MITRE Technique : T1669 - Wi-Fi Networks
  Tactic(s)       : Initial Access
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:13:11.443977+00:00
  Reference       : https://attack.mitre.org/techniques/T1669
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1669_Linux_IPS_Wireless_Access_Attack_Verdict {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects IDS/IPS verdicts on network connections that describe wireless-network attack behaviour: rogue access point or evil twin, deauthentication, ARP poisoning, rogue DHCP, or adversary-in-the-middle. These are the network-side signs of an adversary using Wi-Fi access (T1669) from a Linux host. The rule matches signature rule names and descriptions, not the verdict action, because vendor mapping of security_result.action is inconsistent."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1669"
    mitre_technique_name = "Wi-Fi Networks"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION with security_result.rule_name or security_result.description populated. Sensors must cover wireless or guest VLAN segments and Linux server or workstation subnets."
    platform = "Linux"
    log_source = "ips"
    false_positives = "Authorised wireless penetration tests and red-team exercises, wireless IDS or WIPS self-test traffic, vulnerability scanners probing Wi-Fi gateways, lab networks used for wireless security training, benign signatures that match the generic keywords wifi or wireless in their descriptions."
    tuning_guidance = "Add authorised scanner and pentest source IPs to %global_allowed_scanners and approved management sources to %global_allowed_mgmt_sources. If the IPS does not populate security_result.rule_name, rely on the description branch. Per client, narrow the signature regex to the vendor's wireless or MITM signature categories if the generic keywords are noisy. Monitored segments should include Linux hosts that bridge wired and wireless interfaces (dual-homed)."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.security_result.rule_name = /(arp.?(spoof|poison|cache)|rogue.?(ap|access.?point|dhcp)|evil.?twin|deauth|wi-?fi|wireless|802\.?11|man.in.the.middle|mitm)/ nocase or
      $net.security_result.description = /(arp.?(spoof|poison|cache)|rogue.?(ap|access.?point|dhcp)|evil.?twin|deauth|wi-?fi|wireless|802\.?11|man.in.the.middle|mitm)/ nocase
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1669")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $signature_names = array_distinct($net.security_result.rule_name)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
