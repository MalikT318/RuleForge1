/*
  MITRE Technique : T1053.006 - Systemd Timers
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:18:53.447758+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_006_Systemd_Timer_Unit_Mass_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects multiple systemd .timer unit files created on a single Linux host within one hour, in system-level or user-level systemd unit directories. Creating one timer is routine, but several in a short window suggests persistence staging or scheduled-execution abuse. Package-manager writes and approved admin tooling are excluded."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.006"
    mitre_technique_name = "Scheduled Task/Job: Systemd Timers"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry (watches on /etc/systemd, /usr/lib/systemd, and user .config/systemd) normalized to UDM FILE_CREATION with principal.hostname and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package installs and upgrades that ship timers (apt, dpkg, rpm, dnf, yum, zypper, pacman), configuration management runs (Ansible, Puppet, Chef, Salt), image build or provisioning pipelines, and administrators migrating cron jobs to timers."
    tuning_guidance = "Add configuration-management and deployment binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Raise the condition threshold on build or provisioning hosts. Severity is fixed at Medium; the risk_score rises to 80 when a timer is written to a user-level systemd directory."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(etc\/systemd\/(system|user)|usr\/lib\/systemd\/(system|user)|lib\/systemd\/(system|user)|run\/systemd\/(system|user)|(home\/[^\/]+|root)\/\.config\/systemd\/user)\/[^\/]+\.timer$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|yum|dnf|zypper|pacman|snapd|packagekitd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $host

  match:
    $host over 1h

  outcome:
    $risk_score = max(if($file.target.file.full_path = /\/\.config\/systemd\/user\//, 80, 65))
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1053.006")
    $primary_entity = array_distinct($host)
    $timer_paths = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $writer_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
