/*
  MITRE Technique : T1132 - Data Encoding
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:44:14.480061+00:00
  Reference       : https://attack.mitre.org/techniques/T1132
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1132_Network_Base64_Encoded_Payload_In_Outbound_URL {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP(S) requests, as seen by a proxy or perimeter device, whose URL carries a long Base64-style encoded blob. The blob is either a padded run in the path or query, or a very long unpadded value in a query parameter. This is the network-observable result of C2 beaconing or tasking that encodes data in URLs (T1132.001). It does not depend on the initiating process or its command line."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1132"
    mitre_technique_name = "Data Encoding"
    log_prerequisites = "Requires proxy or firewall logs with full URL visibility (explicit proxy or TLS inspection) normalised to UDM NETWORK_HTTP with target.url populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Web apps and SaaS that pass tokens, session state, SAML or OAuth blobs, or tracking or telemetry IDs as Base64 in URLs. Software update and licensing checks, AV or EDR cloud lookups, CDN signed URLs, and browser safe-browsing queries."
    tuning_guidance = "Add known-good vendor and SaaS domains to %global_allowed_domains. Add authorised scanners or egress test sources to %global_allowed_scanners. Raise the length thresholds (48 and 120 characters) if noise is high, or lower them for higher sensitivity. Review the sample URLs and destination hosts in the outcome fields before escalating."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    (
      $http.target.url = /[A-Za-z0-9+\/_-]{48,}(=|%3D){1,2}($|[&#?])/ nocase or
      $http.target.url = /[?&][^=&]{1,32}=[A-Za-z0-9+\/_-]{120,}($|[&#])/ nocase
    )
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1132")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $sample_urls = array_distinct($http.target.url)

  condition:
    $http
}
