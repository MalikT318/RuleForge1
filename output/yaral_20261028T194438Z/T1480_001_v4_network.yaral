/*
  MITRE Technique : T1480.001 - Environmental Keying
  Tactic(s)       : Stealth
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:25:34.686917+00:00
  Reference       : https://attack.mitre.org/techniques/T1480/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1480_001_Linux_Untrusted_Process_External_IP_Lookup {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux process running from a world-writable directory (/tmp, /var/tmp, /dev/shm) or an interpreter binary that issues an HTTP request to an external host using a public-IP-discovery URL pattern. Malware uses this lookup to derive environmental keys (external IP) that decrypt or gate its payload. The rule matches the behaviour (untrusted process, external destination, IP-echo path) and does not hardcode any lookup service domain."
    mitre_tactic = "Stealth"
    mitre_technique = "T1480.001"
    mitre_technique_name = "Execution Guardrails: Environmental Keying"
    log_prerequisites = "Requires Linux endpoint network telemetry that populates the initiating process path and the HTTP URL (EDR network sensor or proxy logs enriched with process context) normalised to NETWORK_HTTP."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Admin or monitoring scripts in Python/Perl/PHP that check the public IP (dynamic DNS updaters, VPN or firewall health checks), cloud-init and provisioning scripts, developer tooling running from temp directories, and package or CI jobs that execute from /tmp."
    tuning_guidance = "Add legitimate IP-check scripts and agents to %global_allowed_script_hosts or %global_allowed_admin_tools by process path. Add trusted destinations to %global_allowed_domains. Review %rfc1918_internal to confirm the client's internal ranges are covered. If interpreter noise is high, narrow the process-path regex to the writable-directory branch only."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.principal.process.file.full_path = /(^\/(tmp|var\/tmp|dev\/shm)\/|\/(python[0-9.]*|perl|ruby|php[0-9.]*)$)/ nocase
    $net.target.url = /\/(ip|myip|my-ip|getip|checkip|whatismyip|ifconfig|ipinfo|json)(\/|\?|$)/ nocase
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_script_hosts
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1480.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $requested_url = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
