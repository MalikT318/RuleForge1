/*
  MITRE Technique : T1102.003 - One-Way Communication
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:58:09.546896+00:00
  Reference       : https://attack.mitre.org/techniques/T1102/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1102_003_ESXi_Host_Outbound_Web_Fetch_CLI_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a hypervisor host making an outbound HTTP GET request to an external, non-allowlisted web service using a command-line or scripting HTTP client user agent. ESXi hosts normally talk only to management, update, and time services. A one-way fetch of content from a public web service by a shell-style client matches the retrieval of C2 instructions from a legitimate external site, with no response sent back over the same channel."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1102.003"
    mitre_technique_name = "Web Service: One-Way Communication"
    log_prerequisites = "Requires network or proxy telemetry normalized to NETWORK_HTTP with the ESXi host as principal (egress proxy, firewall with HTTP inspection, or host network sensor). Requires user agent and target hostname to be populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators running curl or wget from the ESXi shell to download patches, VIBs, or offline bundles from vendor or internal mirrors. Scripted health checks or monitoring agents using a scripting HTTP client. Third-party hardware vendor update tooling."
    tuning_guidance = "Add approved vendor, patch and mirror domains to %global_allowed_domains. Add approved management or patching binaries to %global_allowed_admin_tools. Scope the rule to ESXi hosts via asset labelling or the log source in the deployment if the NETWORK_HTTP feed also covers non-ESXi hosts."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.network.http.user_agent = /^(curl|wget|python|libwww|go-http-client|busybox|fetch)/ nocase
    $net.target.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1102.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
