/*
  MITRE Technique : T1218.003 - CMSTP
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:45:57.880774+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_003_CMSTP_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Connection Manager Profile Installer (cmstp.exe) opening a network connection to a non-internal address. Legitimate profile installs are local, so an external connection indicates a malicious INF fetching a remote DLL or COM scriptlet (SCT) payload, or C2 from a proxied process. CMSTP is Windows-only, so no Linux, macOS or cloud equivalent exists. This rule therefore uses network telemetry rather than a process-creation command line, giving coverage that does not depend on command-line visibility."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.003"
    mitre_technique_name = "System Binary Proxy Execution: CMSTP"
    log_prerequisites = "Requires Windows endpoint network-connection telemetry that records the initiating process path (EDR or Sysmon Event ID 3)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare. VPN or Connection Manager profile deployment that retrieves phonebook or profile content from an external corporate endpoint, and software packaging or testing on lab hosts."
    tuning_guidance = "Add approved deployment or VPN tooling parent paths to %global_allowed_admin_tools. Add known-good destination domains to %global_allowed_domains if the telemetry exposes the target hostname. Review the destination IPs in the outcome to confirm whether the connection fetched a payload."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\cmstp\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.parent_process.file.full_path in %global_allowed_admin_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
