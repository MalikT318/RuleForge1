/*
  MITRE Technique : T1059.010 - AutoHotKey & AutoIT
  Tactic(s)       : Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:21:51.044277+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_010_AutoIt_AHK_Script_Drop_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several AutoIT or AutoHotkey script files (.ahk, .au3, .a3x) are written to user-writable or staging locations on a single host within ten minutes. One script drop is often benign, but repeated drops in these locations match staged loader and modular malware delivery (for example phishing payloads or keylogger components). This is file-creation based and complements process command-line detections."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.010"
    mitre_technique_name = "Command and Scripting Interpreter: AutoHotKey & AutoIT"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) normalised to UDM FILE_CREATION with principal.hostname and target.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Power users or developers who write AutoHotkey or AutoIT automation, IT departments deploying AutoIT-based packaging or login scripts, software installers that unpack .au3/.ahk helper scripts, QA test automation hosts, archive extraction of legitimate script collections."
    tuning_guidance = "Add approved deployment and packaging tools to %global_allowed_admin_tools and approved scripting or automation hosts to %global_allowed_script_hosts. Raise the #file threshold on developer or QA workstations. Reduce it to 2 on locked-down kiosk or server estates, where any script drop is suspicious."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(ahk|au3|a3x)$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|users\\public|programdata|windows\\temp|temp)\\/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $file_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1059.010")
    $primary_entity = array_distinct($host)
    $dropped_files = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
