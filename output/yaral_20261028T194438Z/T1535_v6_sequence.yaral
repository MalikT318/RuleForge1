/*
  MITRE Technique : T1535 - Unused/Unsupported Cloud Regions
  Tactic(s)       : Stealth
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:34:54.471428+00:00
  Reference       : https://attack.mitre.org/techniques/T1535
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1535_Region_Enabled_Then_Compute_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an identity enabling or opting in a cloud region (account or region setting change) and then creating compute or serverless resources within 10 minutes. This sequence is consistent with an adversary activating an unused region to run workloads where monitoring is thin, such as cryptomining."
    mitre_tactic = "Stealth"
    mitre_technique = "T1535"
    mitre_technique_name = "Unused/Unsupported Cloud Regions"
    log_prerequisites = "Cloud control-plane audit logs (management or admin activity events) ingested and normalised to UDM. SETTING_MODIFICATION events must populate metadata.product_event_type and principal.user.userid. RESOURCE_CREATION events must populate metadata.product_event_type, principal.user.userid and target.location.name."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Planned expansion into a new region by cloud platform or infrastructure teams, Infrastructure-as-Code pipelines or landing-zone automation that enable regions and deploy baseline resources, new compliance or data-residency projects, and disaster recovery build-outs."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users, and automation identities (IaC pipelines, landing-zone tooling) to %global_allowed_service_accounts or %global_allowed_cloud_principals. If your cloud uses different API names for region enablement or compute creation, extend the product_event_type regexes. Consider raising severity when the created resource is a large compute instance or GPU type."

  events:
    $region_change.metadata.event_type = "SETTING_MODIFICATION"
    $region_change.metadata.product_event_type = /(EnableRegion|RegionOptIn|OptInRegion|AccountRegion|RegionSetting|EnableGeo)/ nocase
    $region_change.principal.user.userid = $user
    not $region_change.principal.user.userid in %global_allowed_admin_users
    not $region_change.principal.user.userid in %global_allowed_service_accounts
    not $region_change.principal.user.userid in %global_allowed_cloud_principals

    $create.metadata.event_type = "RESOURCE_CREATION"
    $create.metadata.product_event_type = /(RunInstances|CreateVirtualMachine|virtualMachines\/write|instances\.insert|CreateFunction|CreateCluster|CreateAutoScalingGroup)/ nocase
    $create.principal.user.userid = $user
    not $create.principal.user.userid in %global_allowed_admin_users
    not $create.principal.user.userid in %global_allowed_service_accounts
    not $create.principal.user.userid in %global_allowed_cloud_principals

    $region_change.metadata.event_timestamp.seconds <= $create.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1535")
    $primary_entity = array_distinct($user)
    $created_regions = array_distinct($create.target.location.name)
    $source_ips = array_distinct($create.principal.ip)
    $region_change_actions = array_distinct($region_change.metadata.product_event_type)
    $create_actions = array_distinct($create.metadata.product_event_type)
    $creation_count = count($create.metadata.id)

  condition:
    $region_change and $create
}
