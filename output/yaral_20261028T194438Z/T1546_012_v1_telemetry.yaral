/*
  MITRE Technique : T1546.012 - Image File Execution Options Injection
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:16:09.096465+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_012_IFEO_Debugger_Registry_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modification that sets an Image File Execution Options Debugger value, or a SilentProcessExit MonitorProcess value, for any executable. Both hijack the launch or exit of a target process to run an attacker-chosen binary, giving persistence or privilege escalation. The rule works on the registry state change, so it fires whichever tool made the change (reg.exe, GFlags, PowerShell, WMI, direct API calls) and does not depend on command-line logging."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.012"
    mitre_technique_name = "Event Triggered Execution: Image File Execution Options Injection"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR registry-write events, or Sysmon Event ID 12/13 with IFEO and SilentProcessExit keys in scope of the Sysmon config) normalised to REGISTRY_MODIFICATION with target.registry.registry_key and registry_value_name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developers or IT staff attaching a debugger (WinDbg, Visual Studio, Application Verifier) for troubleshooting; software installers that register a debugger replacement (e.g. Task Manager replacement tools, crash-dump collectors such as Sysinternals ProcDump or Process Explorer); WER/diagnostic or EDR tooling configuring SilentProcessExit monitoring for crash analysis."
    tuning_guidance = "Add approved installer, deployment or debugging tool executable paths to %global_allowed_admin_tools, and EDR/AV agent binaries to %global_allowed_security_tools. Add automation accounts that legitimately configure IFEO to %global_allowed_service_accounts. Review hits on developer workstations separately from servers; on servers any hit should be treated as high fidelity."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      (
        $reg.target.registry.registry_key = /\\Image File Execution Options\\[^\\]+/ nocase
        and $reg.target.registry.registry_value_name = /^Debugger$/ nocase
      )
      or
      (
        $reg.target.registry.registry_key = /\\SilentProcessExit\\[^\\]+/ nocase
        and $reg.target.registry.registry_value_name = /^MonitorProcess$/ nocase
      )
    )
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1546.012")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_name)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $modifying_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
