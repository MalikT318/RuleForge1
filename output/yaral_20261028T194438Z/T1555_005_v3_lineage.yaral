/*
  MITRE Technique : T1555.005 - Password Managers
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:59:35.933311+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_005_Linux_Service_Parent_Spawns_Shell_Targeting_Password_Manager {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing service or database daemon (web server, PHP-FPM, database, cache) spawning a shell or script interpreter whose command line references password manager stores or databases (KeePass .kdb/.kdbx, pass/gopass store, Bitwarden, 1Password, LastPass, GNOME keyring). Service daemons have no legitimate reason to touch a user's password vault. This pattern indicates a compromised service (web shell or injection) harvesting credentials."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.005"
    mitre_technique_name = "Credentials from Password Stores: Password Managers"
    log_prerequisites = "Linux EDR or auditd execve telemetry normalised to UDM PROCESS_LAUNCH with populated parent (principal.process) and child (target.process) paths and command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup or migration scripts launched by a service daemon that copy home directories; web-based password manager servers (self-hosted vault apps) whose backend legitimately shells out to its own data stores; developer or test hosts running password manager integration tests under a web server account."
    tuning_guidance = "Add approved parent binaries or hosts to %global_allowed_script_hosts and approved backup or deployment tooling to %global_allowed_admin_tools. For self-hosted vault servers, add the specific parent process path to %global_allowed_script_hosts. Extend the parent regex with additional service daemons in your estate if needed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|php-fpm[0-9.]*|mysqld|mariadbd|postgres|redis-server|mongod|tomcat[0-9]*)$/ nocase
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|python[0-9.]*|perl|ruby|php[0-9.]*)$/ nocase
    $proc.target.process.command_line = /(\.kdbx?\b|\.password-store|keepassxc?|gopass|bitwarden|1password|lastpass|\.local\/share\/keyrings)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1555.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
