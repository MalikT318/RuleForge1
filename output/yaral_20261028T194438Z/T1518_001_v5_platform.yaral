/*
  MITRE Technique : T1518.001 - Security Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:20:42.697800+00:00
  Reference       : https://attack.mitre.org/techniques/T1518/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_001_WMI_SecurityCenter_Product_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a script host or shell querying the Windows Security Center WMI namespace (AntiVirusProduct, AntiSpywareProduct, FirewallProduct) to enumerate installed security software. Matches the combination of a WMI query mechanism and the Security Center namespace or class, so it still fires if the binary is renamed or the query is wrapped in another interpreter."
    mitre_tactic = "Discovery"
    mitre_technique = "T1518.001"
    mitre_technique_name = "Software Discovery: Security Software Discovery"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 / Windows Event 4688 with command-line auditing enabled, normalised to UDM PROCESS_LAUNCH."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Inventory and compliance scripts, RMM health checks, endpoint posture assessment agents, helpdesk scripts verifying AV status, and some software installers checking for conflicting AV products."
    tuning_guidance = "Add approved inventory and RMM binaries to %global_allowed_admin_tools, security agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Raise severity when the same host also shows defence evasion activity."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(wmic|powershell|pwsh|cmd|cscript|wscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /\b(wmic|get-wmiobject|get-ciminstance|gwmi|gcim|invoke-wmimethod|win32_|cim_)/ nocase
    $proc.target.process.command_line = /(securitycenter2|\b(antivirus|antispyware|firewall)product\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1518.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
