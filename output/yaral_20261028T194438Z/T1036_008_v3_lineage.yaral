/*
  MITRE Technique : T1036.008 - Masquerade File Type
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:09:29.948438+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_008_Unexpected_Parent_Launches_NonExecutable_Extension_Image {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process whose executable image carries a document, image, archive or data file extension (for example .jpg, .txt, .pdf, .dat), launched by a parent that should not spawn such a child (Office application, web server, print spooler, database service). This lineage anomaly indicates a masqueraded payload whose extension was changed to look benign. The rule does not depend on command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.008"
    mitre_technique_name = "Masquerading: Masquerade File Type"
    log_prerequisites = "Requires Windows endpoint process telemetry (EDR or Sysmon Event ID 1) that populates both the parent and child process image paths in PROCESS_LAUNCH events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Document-management or reporting add-ins that run helper binaries with unusual extensions, web applications that legitimately execute uploaded or generated content, database jobs that launch vendor utilities, and software packagers that stage renamed binaries."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts. Add EDR/AV agents that launch scan helpers to %global_allowed_security_tools. To widen coverage, add further parent process names to the parent regex. To reduce noise, remove generic extensions such as .dat from the child extension regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat\d*|php|php-cgi|spoolsv|sqlservr|mysqld|postgres)\.exe$/ nocase
    $proc.target.process.file.full_path = /\.(txt|jpg|jpeg|jpe|png|gif|bmp|ico|svg|pdf|doc|docx|xls|xlsx|ppt|pptx|rtf|csv|log|dat|db|mp3|mp4|wav|zip|rar|7z)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1036.008")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
