/*
  MITRE Technique : T1218.001 - Compiled HTML File
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:42:10.005788+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_001_CHM_Dropped_Then_HH_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A .chm (Compiled HTML Help) file is written to a host and, within 10 minutes, the HTML Help executable (hh.exe) makes a connection to an external IP address on the same host. hh.exe rarely makes outbound connections, so this pattern indicates CHM content fetching a payload or beaconing. It is detected from file-creation and network telemetry rather than process command lines."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.001"
    mitre_technique_name = "System Binary Proxy Execution: Compiled HTML File"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event 11 equivalent) and network-connection telemetry (Sysmon Event 3 equivalent) with the initiating process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers that unpack .chm help files and then open online help; applications that launch hh.exe to display online help content; IT staff opening vendor documentation; deployment tooling staging .chm files."
    tuning_guidance = "Add approved deployment and installer binaries to %global_allowed_admin_tools (file-writer exclusion). Add known-good vendor documentation domains to %global_allowed_domains. If the environment commonly uses online CHM help, consider raising severity only when the .chm was written by a browser, mail client, or archive tool."

  events:
    $chm.metadata.event_type = "FILE_CREATION"
    $chm.target.file.full_path = /\.chm$/ nocase
    not $chm.principal.process.file.full_path in %global_allowed_admin_tools
    $chm.principal.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\hh\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    $net.principal.hostname = $hostname

    $chm.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.001")
    $primary_entity = array_distinct($hostname)
    $chm_files = array_distinct($chm.target.file.full_path)
    $chm_writer_processes = array_distinct($chm.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $connection_count = count($net.metadata.id)

  condition:
    $chm and $net
}
