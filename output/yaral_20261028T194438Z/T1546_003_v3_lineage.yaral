/*
  MITRE Technique : T1546.003 - Windows Management Instrumentation Event Subscription
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:04:18.055045+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_003_WMI_Consumer_Host_Spawns_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the WMI event consumer host (scrcons.exe) or WMI Provider Host (WmiPrvSe.exe) spawning a shell, script interpreter or proxy-execution binary. This lineage is how a malicious WMI event subscription (CommandLineEventConsumer or ActiveScriptEventConsumer) executes its payload, usually as SYSTEM. The rule pivots on the unexpected parent-child relationship, not on command-line content."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.003"
    mitre_technique_name = "Event Triggered Execution: Windows Management Instrumentation Event Subscription"
    log_prerequisites = "Requires endpoint process-creation telemetry with parent process path populated (EDR, Sysmon Event ID 1 or Windows Security Event 4688 with parent process logging)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Remote WMI process creation by administrators (for example wmic or Invoke-CimMethod, which also overlaps T1047), RMM and patching tools that run commands through WMI, inventory and monitoring agents, and legacy management scripts that use WMI consumers."
    tuning_guidance = "Add approved management tooling executables to %global_allowed_admin_tools, which is matched against the child process path. Add hosts with legitimate WMI-driven automation, such as management servers, to %global_allowed_script_hosts. Review any residual hits for the WMI subscription registered on the host, since scrcons.exe as a parent is very rarely legitimate."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(scrcons|wmiprvse)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|powershell_ise|pwsh|wscript|cscript|mshta|rundll32|regsvr32|msbuild|installutil|bitsadmin|certutil)\.exe$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1546.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
