/*
  MITRE Technique : T1563.002 - RDP Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:10:51.146057+00:00
  Reference       : https://attack.mitre.org/techniques/T1563/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_002_RDP_Outbound_NonStandard_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows host opening an outbound RDP (TCP 3389) connection to a non-internal address from a process that is not a native RDP client. Network-side view of RDP hijacking and lateral movement: tunnelled, relayed or scripted RDP sessions are usually driven by an unexpected process (tunnelling utility, script host, injected process, service binary) rather than the standard Remote Desktop client. This rule covers only the network side of the technique. It does not see tscon.exe session takeover on the local host, which needs endpoint process-launch coverage."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1563.002"
    mitre_technique_name = "Remote Service Session Hijacking: RDP Hijacking"
    log_prerequisites = "Requires Windows endpoint network telemetry that populates the initiating process path (EDR network events or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Approved remote support or RMM tools that wrap RDP, third-party RDP clients or connection managers, jump-host and PAM session brokers, admin scripts or monitoring checks probing port 3389 on external hosts, cloud-hosted VDI gateways."
    tuning_guidance = "Add approved remote support and RDP wrapper binaries to %global_allowed_remote_mgmt, and automation or brokering accounts to %global_allowed_service_accounts. Ensure %rfc1918_internal is populated for the client's address space. If the client legitimately uses RDP to cloud VMs, onboard those initiating hosts or processes into the allowlists."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 3389
    $net.principal.hostname != ""
    $net.principal.process.file.full_path != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path = /\\(mstsc|msrdc|wksprt|rdpclip)\.exe$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1563.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $initiating_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
