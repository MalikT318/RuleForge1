/*
  MITRE Technique : T1546 - Event Triggered Execution
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:59:38.534781+00:00
  Reference       : https://attack.mitre.org/techniques/T1546
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_004_Linux_Shell_Profile_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects modification of Linux shell startup and profile files (system-wide /etc/profile, /etc/profile.d scripts, bashrc/zshrc variants, and per-user dotfiles such as .bashrc, .bash_profile, .profile, .zshrc). Adversaries append commands to these files so their code runs on every login or interactive shell, giving persistence and, when a privileged user's profile is altered, privilege escalation. This rule is file-event based and complements existing process command-line coverage."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.004"
    mitre_technique_name = "Event Triggered Execution: Unix Shell Configuration Modification"
    log_prerequisites = "Requires Linux endpoint file-modification telemetry (EDR file events or auditd watches on /etc/profile, /etc/profile.d, /etc/bash.bashrc and user home dotfiles) normalised to UDM FILE_MODIFICATION with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators or developers editing their own .bashrc or .profile through a non-excluded tool; configuration management or image-build scripts that write to /etc/profile.d; environment managers (language version managers, cloud CLI installers) appending PATH or completion lines to dotfiles; first-login provisioning scripts."
    tuning_guidance = "Add configuration management and deployment tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Package managers and common interactive editors are excluded by executable name, so edits made with an editor are a known blind spot; remove the editor names from the regex if the environment has few interactive Linux users. Pair with a FILE_CREATION variant for new /etc/profile.d scripts if needed."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^(\/root|\/home\/[^\/]+)\/\.(bashrc|bash_profile|bash_login|bash_logout|profile|zshrc|zprofile|zshenv|zlogin|zlogout)$|^\/etc\/(profile|bashrc|bash\.bashrc|zshrc|zshenv|zprofile|zsh\/[a-z]+)$|^\/etc\/profile\.d\/[^\/]+$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|rpm|yum|dnf|apt|apt-get|zypper|useradd|usermod|adduser|ansible|puppet|chef-client|salt-minion|vim|vi|nano|emacs)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)
    $writer_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
