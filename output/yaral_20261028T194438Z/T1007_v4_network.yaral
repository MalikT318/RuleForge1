/*
  MITRE Technique : T1007 - System Service Discovery
  Tactic(s)       : Discovery
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:14:51.775701+00:00
  Reference       : https://attack.mitre.org/techniques/T1007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1007_Linux_Remote_Systemctl_Over_SSH_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an outbound SSH connection to a non-internal address that was launched by systemctl's remote mode (systemctl -H user@host), which tunnels systemd-stdio-bridge over SSH. This lets a host enumerate or query the services of a remote system and is a network-visible form of System Service Discovery. Legitimate administration normally targets internal hosts, so an external destination is anomalous."
    mitre_tactic = "Discovery"
    mitre_technique = "T1007"
    mitre_technique_name = "System Service Discovery"
    log_prerequisites = "Requires Linux EDR or auditd network telemetry that populates the principal process path, command line and parent process for outbound connections (NETWORK_CONNECTION)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators managing internet-hosted or cloud-hosted servers with systemctl -H from a jump host; configuration management or orchestration that uses remote systemctl; internal ranges not covered by the internal-address list (for example CGNAT or public address space used internally)."
    tuning_guidance = "Add approved jump-host or bastion destination addresses to %global_allowed_mgmt_sources, named administrator accounts to %global_allowed_admin_users, and approved management tooling to %global_allowed_admin_tools. Confirm %rfc1918_internal covers all internal address space used by the client."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/ssh$/ nocase
    (
      $net.principal.process.command_line = /systemd-stdio-bridge/ nocase or
      $net.principal.process.parent_process.file.full_path = /\/systemctl$/ nocase
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.principal.user.userid in %global_allowed_admin_users
    not $net.principal.process.parent_process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1007")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $acting_users = array_distinct($net.principal.user.userid)
    $ssh_command_lines = array_distinct($net.principal.process.command_line)

  condition:
    $net
}
