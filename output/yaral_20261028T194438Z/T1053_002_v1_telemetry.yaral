/*
  MITRE Technique : T1053.002 - At
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:12:16.312178+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_002_Linux_At_Job_Spool_File_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a job file in the Linux at/atd spool directories (/var/spool/cron/atjobs, /var/spool/atjobs, /var/spool/at). This is the persistent state artifact written when a task is scheduled with at or batch, and it is observed even when command-line logging is evaded, for example through renamed binaries, direct API calls, or wrapper scripts. The sequence file (.SEQ) that atd maintains is excluded."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.002"
    mitre_technique_name = "Scheduled Task/Job: At"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules (-w /var/spool/cron/atjobs -p wa and -w /var/spool/at -p wa) normalised to UDM FILE_CREATION with principal process and user populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators or developers legitimately scheduling one-off jobs with at or batch; configuration management and patching tools that schedule deferred reboots or maintenance; application installers and backup or maintenance scripts that use at for delayed tasks."
    tuning_guidance = "Add approved scheduling tools or parent processes to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Scope the auditd watch to atjobs directories only to limit volume. Review hosts where at is normally disabled (no atd service) first, since any hit there is high-value."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/var\/spool\/(cron\/atjobs|atjobs|at)\/[^\/]+$/ nocase
    not $file.target.file.full_path = /\/\.SEQ$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1053.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $user = array_distinct($file.principal.user.userid)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $at_job_file = array_distinct($file.target.file.full_path)

  condition:
    $file
}
