/*
  MITRE Technique : T1574.010 - Services File Permissions Weakness
  Tactic(s)       : Stealth, Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:40:30.136899+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_010_Service_Binary_Overwritten_By_Unprivileged_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification (overwrite) of an executable or DLL under Program Files or ProgramData by a non-SYSTEM, non-installer process. This is the file-level result of abusing weak file or directory permissions to replace a service binary. It does not depend on command-line matching and complements process-creation coverage. Note: T1574.010 is a Windows-only technique, so this rule is written for Windows rather than an alternate platform."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.010"
    mitre_technique_name = "Hijack Execution Flow: Services File Permissions Weakness"
    log_prerequisites = "Requires Windows endpoint file-modification telemetry with principal user and process populated (EDR file write events or Sysmon Event ID 11/23-equivalent normalised to UDM FILE_MODIFICATION)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "User-context self-updaters for software installed under ProgramData or Program Files, developer builds writing into those directories, portable-application deployment scripts, and software deployment run under a named admin account."
    tuning_guidance = "Add approved updater or deployment executables to %global_allowed_admin_tools, expected automation accounts to %global_allowed_service_accounts, and named administrators to %global_allowed_admin_users. Add endpoint security agents to %global_allowed_security_tools. Corroborate hits by checking whether the modified file is an image path of an installed service."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^[a-z]:\\(program files( \(x86\))?|programdata)\\.+\.(exe|dll)$/ nocase
    $file.principal.user.userid != ""
    not $file.principal.user.userid = /^(system|local service|network service|nt authority\\system|nt authority\\local service|nt authority\\network service)$/ nocase
    not $file.principal.user.userid = /\$$/
    not $file.principal.process.file.full_path = /\\(msiexec|TrustedInstaller|TiWorker|MsMpEng|MpCmdRun|MsSense|SenseIR|wuauclt|usoclient|setup|installer|updater|update)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1574.010")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
