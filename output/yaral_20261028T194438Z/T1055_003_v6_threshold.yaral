/*
  MITRE Technique : T1055.003 - Thread Execution Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:50:19.692494+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_003_Repeated_Cross_Process_Injection_Per_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of cross-process injection events (remote thread, thread context or memory manipulation into another live process) on a single host within 10 minutes. One such event can be benign, but repeated injection into other processes is consistent with thread execution hijacking (OpenThread, SuspendThread, WriteProcessMemory, SetThreadContext, ResumeThread). The rule does not depend on command lines or tool names."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.003"
    mitre_technique_name = "Process Injection: Thread Execution Hijacking"
    log_prerequisites = "Requires Windows endpoint telemetry that reports cross-process injection or thread manipulation and normalises it to PROCESS_INJECTION (EDR or Sysmon-equivalent with remote thread / process access events)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "EDR/AV agents and DLP or monitoring agents hooking processes, backup and imaging software, application compatibility shims, accessibility and input-method software, game overlays, debuggers and developer tooling (Visual Studio, WinDbg), and RMM agents."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools, backup software to %global_allowed_backup_processes, and approved IT tooling to %global_allowed_admin_tools. Raise the threshold (#inj) on hosts with developer or debugging activity. Consider shortening the window or lowering the threshold in high-assurance environments."

  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.hostname = $host
    $inj.principal.process.file.full_path != ""
    $inj.target.process.file.full_path != ""
    $inj.principal.process.pid != $inj.target.process.pid
    not $inj.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|SenseCnCProxy|csrss|wininit|services|lsass|smss)\.exe$/ nocase
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($inj.metadata.id)
    $mitre_technique_id = array_distinct("T1055.003")
    $primary_entity = array_distinct($host)
    $injecting_processes = array_distinct($inj.principal.process.file.full_path)
    $victim_processes = array_distinct($inj.target.process.file.full_path)
    $injecting_users = array_distinct($inj.principal.user.userid)

  condition:
    #inj >= 5
}
