/*
  MITRE Technique : T1217 - Browser Information Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:38:18.535643+00:00
  Reference       : https://attack.mitre.org/techniques/T1217
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1217_Browser_Data_Multi_Browser_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a single non-browser process reading profile data (history, bookmarks, saved logins, cookies) from a Chromium-family browser and then from a Gecko-family (Firefox) browser on the same host within 10 minutes. Legitimate software rarely touches the profile stores of several unrelated browsers, so this pattern points to browser information discovery or credential harvesting tooling."
    mitre_tactic = "Discovery"
    mitre_technique = "T1217"
    mitre_technique_name = "Browser Information Discovery"
    log_prerequisites = "Requires EDR or Sysmon-equivalent file access telemetry that normalises to FILE_READ with principal.process.file.full_path and target.file.full_path populated. File read auditing of browser profile directories may need to be enabled on some sensors."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and imaging agents, endpoint security scanners, enterprise browser migration or profile-import utilities, DLP and forensic collection tools, and user-initiated data-migration wizards."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes, EDR/AV agents to %global_allowed_security_tools, and migration or IT tooling to %global_allowed_admin_tools. The rule fires only when the Chromium-family read precedes the Firefox read, so a process that reads in the reverse order will not match. If the sensor does not log reads of these files, the rule will not fire. Extend the browser executable exclusion regex if additional legitimate browsers are deployed."

  events:
    $chromium.metadata.event_type = "FILE_READ"
    $chromium.target.file.full_path = /\\users\\[^\\]+\\appdata\\local\\(google\\chrome|microsoft\\edge|bravesoftware\\brave-browser|chromium|vivaldi)\\user data\\[^\\]+\\(history|bookmarks|login data|web data|cookies|network\\cookies|top sites|favicons)$/ nocase
    not $chromium.principal.process.file.full_path = /\\(chrome|msedge|brave|vivaldi|firefox|opera|iexplore|msedgewebview2|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $chromium.principal.process.file.full_path in %global_allowed_backup_processes
    not $chromium.principal.process.file.full_path in %global_allowed_security_tools
    not $chromium.principal.process.file.full_path in %global_allowed_admin_tools
    $chromium.principal.hostname = $hostname
    $chromium.principal.process.file.full_path = $proc_path

    $gecko.metadata.event_type = "FILE_READ"
    $gecko.target.file.full_path = /\\users\\[^\\]+\\appdata\\roaming\\mozilla\\firefox\\profiles\\[^\\]+\\(places\.sqlite|logins\.json|key4\.db|cookies\.sqlite|formhistory\.sqlite)$/ nocase
    not $gecko.principal.process.file.full_path = /\\(chrome|msedge|brave|vivaldi|firefox|opera|iexplore|msedgewebview2|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $gecko.principal.process.file.full_path in %global_allowed_backup_processes
    not $gecko.principal.process.file.full_path in %global_allowed_security_tools
    not $gecko.principal.process.file.full_path in %global_allowed_admin_tools
    $gecko.principal.hostname = $hostname
    $gecko.principal.process.file.full_path = $proc_path

    $chromium.metadata.event_timestamp.seconds <= $gecko.metadata.event_timestamp.seconds

  match:
    $hostname, $proc_path over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1217")
    $primary_entity = array_distinct($hostname)
    $acting_process = array_distinct($proc_path)
    $acting_user = array_distinct($chromium.principal.user.userid)
    $chromium_files = array_distinct($chromium.target.file.full_path)
    $gecko_files = array_distinct($gecko.target.file.full_path)
    $files_read_count = count($chromium.metadata.id)

  condition:
    $chromium and $gecko
}
