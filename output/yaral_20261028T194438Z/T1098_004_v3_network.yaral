/*
  MITRE Technique : T1098.004 - SSH Authorized Keys
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:45:44.952138+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_004_External_SSH_To_Network_Device_Mgmt {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a perimeter-observed connection from a non-internal source address to an SSH management service (TCP 22 or NETCONF-over-SSH 830). After an adversary plants an authorized_keys entry on a network device, ESXi host or Linux-based appliance, they return over key-based SSH from outside the network. This rule surfaces that return access from the network side, independent of endpoint process telemetry."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.004"
    mitre_technique_name = "Account Manipulation: SSH Authorized Keys"
    log_prerequisites = "Firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs must record inbound (internet to internal) traffic."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised vendor or MSP remote support over SSH, jump hosts or bastions with public addresses not yet in the allowlist, external vulnerability scanners, NETCONF automation platforms hosted outside the network, and internet-wide scan or brute-force noise if SSH is exposed (which is itself a finding)."
    tuning_guidance = "Add approved management source addresses to %global_allowed_mgmt_sources and authorised scanner sources to %global_allowed_scanners. Ensure %rfc1918_internal is populated for the client. Any remaining hits mean SSH management is exposed to the internet and should be restricted at the perimeter. Raise severity for devices known to hold sensitive roles."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 22 or $net.target.port = 830)
    $net.principal.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1098.004")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
