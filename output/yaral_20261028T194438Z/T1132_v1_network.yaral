/*
  MITRE Technique : T1132 - Data Encoding
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:43:33.567109+00:00
  Reference       : https://attack.mitre.org/techniques/T1132
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1132_Base64_Encoded_HTTP_Query_Exfil_C2 {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP requests to external destinations whose URL query string carries a long Base64-style encoded parameter value. Linux implants and shell-based C2 commonly pipe data through base64 and send it in GET parameters. The rule works from firewall or proxy URL telemetry only and does not depend on endpoint process data."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1132"
    mitre_technique_name = "Data Encoding"
    log_prerequisites = "Requires a firewall, secure web gateway or proxy that logs full HTTP URLs (including query strings) and normalises them to UDM NETWORK_HTTP with target.url populated. Plain HTTP or TLS-inspected traffic only."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Web apps and APIs that pass signed or serialised state in query parameters (OAuth/SAML redirects, CDN signed URLs, analytics beacons, telemetry from package managers or monitoring agents, JWT-style tokens in URLs). Cloud storage pre-signed links."
    tuning_guidance = "Add known-good external domains (CDNs, SaaS, update services) to %global_allowed_domains. Add sanctioned scanner or test sources to %global_allowed_scanners. Raise the minimum length quantifiers in the regex for noisy environments, or lower them for higher sensitivity. Consider adding a user-agent filter for server fleets that should not use browsers."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /[?&][^=&#]{1,32}=([A-Za-z0-9+\/_-]{48,}(=|%3[dD]){1,2}|[A-Za-z0-9+\/_-]{200,})(&|#|$)/
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1132")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)

  condition:
    $http
}
