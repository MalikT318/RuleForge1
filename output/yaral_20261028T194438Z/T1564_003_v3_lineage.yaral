/*
  MITRE Technique : T1564.003 - Hidden Window
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:17:31.357341+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_003_Linux_Service_Parent_Spawns_Hidden_Display_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application-server or database service process launching a virtual-display or headless-GUI child (virtual framebuffer, VNC X server, or a headless browser). Network-facing service daemons have no legitimate reason to start invisible GUI sessions. This pattern suggests a compromised service running GUI-based tooling or a browser out of sight of the console user. Detection pivots on parent-child lineage, not on command-line content alone."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.003"
    mitre_technique_name = "Hide Artifacts: Hidden Window"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records normalised to UDM PROCESS_LAUNCH with populated parent (principal.process) and child (target.process) file paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web applications that render PDFs or screenshots with a headless browser (report generators, HTML-to-image services); CI or test runners hosted under an application server; monitoring or synthetic-transaction probes launched by a service account; PHP or Node apps driving browser automation."
    tuning_guidance = "Add legitimate parent binaries or interpreter hosts to %global_allowed_script_hosts and approved child tooling to %global_allowed_admin_tools. If a specific application legitimately renders pages, allowlist its parent path. Extend the parent regex with additional client-specific service daemons if needed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9.]*|php-cgi|mysqld|mariadbd|postgres|mongod|redis-server|memcached|named|smbd|cupsd)$/ nocase
    (
      $proc.target.process.file.full_path = /\/(Xvfb|xvfb-run|Xvnc|Xephyr|Xdummy)$/ nocase or
      (
        $proc.target.process.file.full_path = /\/(chrome|chromium|chromium-browser|google-chrome|firefox|firefox-esr)$/ nocase and
        $proc.target.process.command_line = /--headless/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1564.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
