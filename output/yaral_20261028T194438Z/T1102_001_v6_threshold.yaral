/*
  MITRE Technique : T1102.001 - Dead Drop Resolver
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:55:24.206685+00:00
  Reference       : https://attack.mitre.org/techniques/T1102/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1102_001_ESXi_Repeated_External_Web_Service_Contact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single ESXi host makes repeated outbound web-port (80/443) connections to non-internal destinations that are not on the known-good domain list within ten minutes. A hypervisor management plane normally talks only to internal infrastructure and a few vendor update endpoints. Repeated polling of external web services is consistent with a dead drop resolver lookup, where malware on the host retrieves an encoded C2 address from a legitimate public web service."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1102.001"
    mitre_technique_name = "Web Service: Dead Drop Resolver"
    log_prerequisites = "ESXi host network or firewall telemetry (vmkernel/dvfilter or forwarded connection logs) normalized to UDM NETWORK_CONNECTION with principal.hostname and target.ip populated. ESXi syslog must be forwarded to Chronicle."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Host patching or VIB downloads from a vendor depot or internal proxy not yet in the allowlist, online depot or Lifecycle Manager updates, NTP or time-sync over web ports, cloud-connected licensing or telemetry features, and approved backup or monitoring agents reaching cloud endpoints."
    tuning_guidance = "Add vendor update, depot and proxy domains to %global_allowed_domains. Add approved agent binaries to %global_allowed_admin_tools. Raise the #net threshold on hosts that are legitimately cloud-connected. Review the distinct destination IPs in the outcome and look for the same destinations contacted at regular intervals."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname = $host
    ($net.target.port = 443 or $net.target.port = 80)
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1102.001")
    $primary_entity = array_distinct($host)
    $event_count = count($net.metadata.id)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 15
}
