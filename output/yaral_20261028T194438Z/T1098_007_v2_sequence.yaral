/*
  MITRE Technique : T1098.007 - Additional Local or Domain Groups
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:50:26.758805+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_007_New_Account_Added_To_Privileged_Group {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A new local or domain account is created and the same actor then adds a member to a privileged group (Administrators, Domain Admins, Remote Desktop Users and similar) on the same host within 10 minutes. This is account-creation-then-group-membership telemetry, so it does not rely on process command lines and complements net localgroup / net group command-line rules."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.007"
    mitre_technique_name = "Account Manipulation: Additional Local or Domain Groups"
    log_prerequisites = "Requires Windows Security event log ingestion normalised to UDM (user creation 4720 and group member added 4728/4732/4756) from endpoints and domain controllers, with principal.user.userid and principal.hostname populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Help desk or IAM onboarding workflows that create and immediately elevate accounts, server build and deployment automation, break-glass account provisioning, lab and test environments."
    tuning_guidance = "Add approved provisioning accounts to %global_allowed_admin_users or %global_allowed_service_accounts. Adjust the privileged group regex to match client-specific sensitive groups (for example VPN access groups). Increase severity for Domain Admins or Enterprise Admins."

  events:
    $usr.metadata.event_type = "USER_CREATION"
    $usr.principal.hostname = $hostname
    $usr.principal.user.userid = $actor
    not $usr.principal.user.userid in %global_allowed_admin_users
    not $usr.principal.user.userid in %global_allowed_service_accounts

    $grp.metadata.event_type = "GROUP_MODIFICATION"
    $grp.target.group.group_display_name = /^(administrators|remote desktop users|remote management users|domain admins|enterprise admins|schema admins|backup operators|account operators|server operators|dnsadmins|group policy creator owners)$/ nocase
    $grp.principal.hostname = $hostname
    $grp.principal.user.userid = $actor
    not $grp.principal.user.userid in %global_allowed_admin_users
    not $grp.principal.user.userid in %global_allowed_service_accounts

    $usr.metadata.event_timestamp.seconds <= $grp.metadata.event_timestamp.seconds

  match:
    $hostname, $actor over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1098.007")
    $primary_entity = array_distinct($hostname)
    $acting_user = array_distinct($actor)
    $created_accounts = array_distinct($usr.target.user.userid)
    $modified_groups = array_distinct($grp.target.group.group_display_name)
    $group_event_count = count($grp.metadata.id)

  condition:
    $usr and $grp
}
