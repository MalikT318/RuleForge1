/*
  MITRE Technique : T1480.001 - Environmental Keying
  Tactic(s)       : Stealth
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:25:16.159860+00:00
  Reference       : https://attack.mitre.org/techniques/T1480/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1480_001_Unexpected_Parent_Spawns_Env_Keyed_Decrypt_Script {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office application, web server, database service or print spooler spawning a shell or script interpreter whose command line both reads host or domain identity values (computer name, user domain, volume or WMI system properties) and performs decryption or key-derivation. This combination is typical of environmentally keyed payloads, where the decryption key is derived from the target environment so the payload only unpacks on the intended victim."
    mitre_tactic = "Stealth"
    mitre_technique = "T1480.001"
    mitre_technique_name = "Execution Guardrails: Environmental Keying"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry (EDR, Sysmon Event ID 1 or Security Event 4688 with command-line auditing enabled) normalised to UDM PROCESS_LAUNCH, with parent process path and full command line populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Line-of-business Office macros or add-ins that decrypt licence or config data keyed to the machine or domain name; web applications or IIS and Tomcat-hosted software that shell out to PowerShell for encrypted credential handling; database maintenance jobs launched from the database service that use DPAPI or SecureString; software-licensing agents; admin scripts launched from an application parent."
    tuning_guidance = "Add legitimate parent process paths to %global_allowed_script_hosts and approved deployment or management tooling to %global_allowed_admin_tools. If one parent process is noisy for a single client, add it to the list rather than editing the rule. To widen coverage, extend the parent or child regex alternations. To reduce noise further, require a specific decryption primitive in the second command-line condition."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|onenote|visio|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|sqlservr|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|powershell_ise|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(\$env:(userdomain|userdnsdomain|computername|username|logonserver)|\[environment\]::(userdomainname|machinename|username)|%(userdomain|userdnsdomain|computername|username|logonserver)%|win32_(computersystem|volume|logicaldisk|bios|baseboard|networkadapterconfiguration)|getcomputerdomain|get-addomain|gethostname|getvolumeinformation)/ nocase
    $proc.target.process.command_line = /(createdecryptor|transformfinalblock|rfc2898derivebytes|pbkdf2|computehash|convertto-securestring|system\.security\.cryptography|decrypt)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1480.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
