/*
  MITRE Technique : T1686.002 - Network Device Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:31:07.279567+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_002_Network_Device_Firewall_Policy_Weakened {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a management-plane configuration change on a network perimeter device that disables or removes firewall policy, ACL or security-zone enforcement, or adds a permit-any style rule. This is the network-device side of defense impairment, observed from device configuration audit logs instead of endpoint process telemetry."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.002"
    mitre_technique_name = "Network Device Firewall"
    log_prerequisites = "Firewall or perimeter device configuration-audit logs forwarded to Chronicle and parsed to SETTING_MODIFICATION, with the change text populated in metadata.description. Requires the administrative user (principal.user.userid) to be populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Planned change-window rule clean-up, firewall migration or rule-base optimisation projects, network automation and orchestration pipelines, HA failover config sync, and vendor-assisted troubleshooting that temporarily relaxes a policy."
    tuning_guidance = "Add automation and orchestration accounts to %global_allowed_service_accounts. If the client has a small named admin team that regularly edits policy, add a 'not $cfg.principal.user.userid in %global_allowed_admin_users' exclusion after confirming change-ticket correlation. Review the metadata.description wording for the client's device parser and adjust the object or action keyword groups if needed."

  events:
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.metadata.description = /(firewall|fw[-_ ]?polic|security[-_ ]?polic|security[-_ ]?rule|access[-_ ]?list|access[-_ ]?group|\bacl\b|rulebase|security[-_ ]?zone|packet[-_ ]?filter)/ nocase
    $cfg.metadata.description = /(disable[ds]?|deactivat|delet|remov|\bno\s+(access|ip|security)|permit\s+(ip\s+)?any|allow\s+any|any\s+any\s+(permit|allow|accept)|action[ =:]+(permit|allow|accept)[^\n]*any|default[-_ ]?action[ =:]+(permit|allow|accept)|policy[-_ ]?(off|bypass)|set\s+status\s+disable)/ nocase
    not $cfg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1686.002")
    $primary_entity = array_distinct(strings.coalesce($cfg.target.hostname, $cfg.principal.hostname))
    $admin_user = array_distinct($cfg.principal.user.userid)
    $change_text = array_distinct($cfg.metadata.description)

  condition:
    $cfg
}
