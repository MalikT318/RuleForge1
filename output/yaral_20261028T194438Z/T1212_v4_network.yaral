/*
  MITRE Technique : T1212 - Exploitation for Credential Access
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:20:36.234638+00:00
  Reference       : https://attack.mitre.org/techniques/T1212
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1212_Outbound_Kerberos_Auth_To_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows host opening a Kerberos (88) or Kerberos password-change (464) connection to a non-internal address. Domain authentication traffic should stay inside the enterprise. Outbound Kerberos to external space is characteristic of forged-ticket or authentication-exploitation attempts (e.g. MS14-068-style abuse) aimed at attacker-controlled or exposed KDCs, and of misrouted credential material."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1212"
    mitre_technique_name = "Exploitation for Credential Access"
    log_prerequisites = "Requires network connection telemetry (firewall, NDR, or EDR network events) normalised to NETWORK_CONNECTION with principal.hostname, target.ip and target.port populated. Authentication context comes from the identity/directory log source; this rule uses only network fields and no endpoint process fields."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Hybrid or cross-forest trusts and partner realms reached over public IPs; roaming laptops using always-on VPN or DirectAccess that reach domain controllers through a public-facing address; cloud-hosted domain controllers or Kerberos proxies on public address space; authorised external penetration tests."
    tuning_guidance = "Add authorised scanners and red-team sources to %global_allowed_scanners. Add known cross-forest or hybrid KDC addresses to %global_allowed_mgmt_sources. Add known service hosts to %global_allowed_admin_tools if the principal is matched by hostname. If %rfc1918_internal does not cover internal NAT or CGNAT ranges, extend it."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 88 or $net.target.port = 464)
    $net.principal.hostname != ""
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1212")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
