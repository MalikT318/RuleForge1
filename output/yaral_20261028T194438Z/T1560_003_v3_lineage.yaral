/*
  MITRE Technique : T1560.003 - Archive via Custom Method
  Tactic(s)       : Collection
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:01:16.232207+00:00
  Reference       : https://attack.mitre.org/techniques/T1560/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1560_003_Linux_Service_Parent_Spawns_Interpreter_Staging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server, database, or print service spawning a shell or script interpreter that runs inline code or references a world-writable staging directory. This lineage is typical of post-exploitation data collection, where custom compression or XOR/stream-cipher archiving is scripted (for example Python, Perl or PHP one-liners) before exfiltration. The rule detects the unexpected parent-child relationship, not an archiver binary."
    mitre_tactic = "Collection"
    mitre_technique = "T1560.003"
    mitre_technique_name = "Archive Collected Data: Archive via Custom Method"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records normalised to UDM PROCESS_LAUNCH with populated parent (principal.process) and child (target.process) paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "PostgreSQL archive_command or backup hooks, Tomcat/Java application servers shelling out to maintenance scripts, PHP applications that legitimately call system(), CUPS filters, and web-hosting control panels that run inline interpreter commands."
    tuning_guidance = "Add approved parent binaries to %global_allowed_script_hosts or %global_allowed_admin_tools. If Java or PHP parents are too noisy for a client, add their specific launcher paths to the exclusion list rather than removing the rule. Consider raising severity for internet-facing hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /(^|\/)(apache2|httpd|nginx|php-fpm[0-9.]*|lighttpd|tomcat[0-9]*|java|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|gunicorn|uwsgi)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|ash|zsh|python[0-9.]*|perl|ruby|php[0-9.]*|lua)$/ nocase
    $proc.target.process.command_line = /(\s-[ce]\s|\/tmp\/|\/dev\/shm\/|\/var\/tmp\/)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1560.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
