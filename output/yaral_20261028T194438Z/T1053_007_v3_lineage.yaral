/*
  MITRE Technique : T1053.007 - Container Orchestration Job
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:19:47.730345+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_007_Container_AppServer_Spawns_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter spawned by an unexpected parent process (web server, application server or database service) inside a container. This lineage is a typical sign of a compromised workload being used to run commands, including kubectl or API calls that create Kubernetes CronJobs or Jobs for scheduled execution and persistence. The rule detects the abnormal parent-child relationship, not the command content, and complements command-line based detections."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.007"
    mitre_technique_name = "Scheduled Task/Job: Container Orchestration Job"
    log_prerequisites = "Requires container runtime or node-level process telemetry (in-container PROCESS_LAUNCH) that populates both the parent and child process paths. Kubernetes audit logs alone are not sufficient."
    platform = "Containers"
    log_source = "container"
    false_positives = "Container entrypoint or health-check scripts launched by the web server or database process, application frameworks that shell out for legitimate tasks (image processing, PDF generation, report exports), database maintenance or backup hooks, and engineers debugging in non-production containers."
    tuning_guidance = "Add approved parent binaries or wrapper entrypoints to %global_allowed_script_hosts, approved admin and automation tooling to %global_allowed_admin_tools, and noisy workload hostnames to %global_allowed_script_hosts. For noisy runtime parents such as node or java, review the baseline per client before adding them to the parent regex. Raise the risk score for production namespaces."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|httpd|apache2|php-fpm[0-9.]*|tomcat[0-9.]*|catalina|gunicorn|uwsgi|java|mysqld|mariadbd|postgres|mongod|redis-server|memcached)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|ash|zsh|ksh|python[0-9.]*|perl|ruby)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.hostname in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1053.007")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
