/*
  MITRE Technique : T1546.016 - Installer Packages
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:23:16.052594+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_016_Linux_Package_Script_Drops_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux package maintainer script (dpkg preinst/postinst/prerm/postrm or rpm scriptlet) creating a file in a sensitive persistence or privilege location such as ld.so.preload, sudoers.d, rc.local, cron directories, init.d, profile.d, systemd service/timer units, XDG autostart, or SSH authorized_keys. Installer scripts run as root, so a trojanised package can use them to plant persistence with elevated privileges. This is file-creation based and complements process-creation or command-line detections."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.016"
    mitre_technique_name = "Event Triggered Execution: Installer Packages"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry (FILE_CREATION) that populates the principal process path or command line and target.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate packages that ship cron jobs, init scripts, sudoers drop-ins, profile.d snippets or systemd units in /etc/systemd/system from their postinst scripts (monitoring agents, backup agents, web servers, container runtimes, VPN clients). Configuration-management-driven package installs and first-boot provisioning. Vendor packages are common on freshly built hosts or during bulk patch windows."
    tuning_guidance = "Add approved package or deployment tooling and script paths to %global_allowed_admin_tools. Add approved automation hosts to %global_allowed_script_hosts. Remove /etc/systemd/system, cron.d, and init.d from the target path regex if they are too noisy for the estate. Keep ld.so.preload, sudoers.d, authorized_keys, and rc.local as high-fidelity paths. Consider scheduling baseline suppression during patch windows."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    (
      $file.principal.process.file.full_path = /(\/var\/lib\/dpkg\/info\/[^\/]+\.(preinst|postinst|prerm|postrm)|\/var\/tmp\/rpm-tmp\.[A-Za-z0-9]+)$/ nocase or
      $file.principal.process.command_line = /(\/var\/lib\/dpkg\/info\/[^\/]+\.(preinst|postinst|prerm|postrm)|\/var\/tmp\/rpm-tmp\.[A-Za-z0-9]+)(\s|$)/ nocase
    )
    $file.target.file.full_path = /^(\/etc\/(ld\.so\.preload|rc\.local|cron\.allow|sudoers\.d\/.+|profile\.d\/.+|cron\.(d|hourly|daily|weekly|monthly)\/.+|init\.d\/.+|systemd\/system\/.+\.(service|timer)|xdg\/autostart\/.+)|\/(root|home\/[^\/]+)\/\.ssh\/authorized_keys2?)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546.016")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $installer_script = array_distinct($file.principal.process.command_line)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
