/*
  MITRE Technique : T1564.006 - Run Virtual Instance
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:23:12.955243+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_006_ESXi_Host_Outbound_Remote_Access_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi host initiating an outbound connection to a non-internal address on a remote-access or tunnelling port (SSH, Telnet, RDP, VNC, SOCKS). Hypervisors normally talk only to internal management, storage, NTP and syslog peers. Outbound interactive-access traffic suggests a rogue virtual instance bridged to the host uplink, or a tunnel/reverse shell staged from the hypervisor. Adversaries use these to hide activity from guest-blind security tooling and to make traffic harder to trace back to the compromised host."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.006"
    mitre_technique_name = "Hide Artifacts: Run Virtual Instance"
    log_prerequisites = "ESXi host or perimeter flow/firewall telemetry normalised to UDM NETWORK_CONNECTION with principal.hostname populated for the ESXi host and target.ip and target.port populated. The reference list %rfc1918_internal must be populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators using the ESXi host as an SSH jump point to a remote or cloud site, remote support sessions from the host, offsite backup or replication tools using SSH, vendor support access, DR-site management over routed public addressing, and ESXi hosts that legitimately use public-IP management networks."
    tuning_guidance = "Add approved remote management destinations or sources to %global_allowed_mgmt_sources, approved external hostnames to %global_allowed_domains, and approved administrative accounts to %global_allowed_admin_users. If hosts use public addressing for internal management, populate %rfc1918_internal accordingly or scope the log source to exclude those hosts. Extend or trim the port list to match the environment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname != ""
    $net.target.ip != ""
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 3389 or
      $net.target.port = 5900 or
      $net.target.port = 5901 or
      $net.target.port = 5902 or
      $net.target.port = 1080
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1564.006")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
