/*
  MITRE Technique : T1048.003 - Exfiltration Over Unencrypted Non-C2 Protocol
  Tactic(s)       : Exfiltration
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:38:09.602538+00:00
  Reference       : https://attack.mitre.org/techniques/T1048/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1048_003_Linux_Cleartext_Protocol_Bulk_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a large outbound transfer to an external address over a cleartext file-transfer protocol port (FTP 21, TFTP 69, rsync daemon 873), as seen at the network perimeter. These unencrypted protocols are rarely used for legitimate bulk egress from servers, so a high sent-byte volume is a strong exfiltration signal. The rule is network-side only and complements endpoint command-line detections. Scope to Linux server segments through the source-address tuning below."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1048.003"
    mitre_technique_name = "Exfiltration Over Alternative Protocol: Exfiltration Over Unencrypted Non-C2 Protocol"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with target.ip, target.port and network.sent_bytes populated. Session-close or periodic accounting logs are needed for byte counts."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legacy vendor FTP/SFTP-gateway uploads, scheduled partner file drops over FTP, rsync mirroring to approved external mirrors, network device config or firmware TFTP backups to external hosts, and sanctioned penetration tests."
    tuning_guidance = "Add known-good external partner or vendor domains to %global_allowed_domains. Add authorised scanner or test source addresses to %global_allowed_scanners. Raise or lower the network.sent_bytes threshold (1 MiB) per client baseline. Restrict to Linux server subnets through client-level rule scoping, since firewall logs do not carry OS context."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 21 or $net.target.port = 69 or $net.target.port = 873)
    $net.network.sent_bytes > 1048576
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1048.003")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
