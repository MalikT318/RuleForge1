/*
  MITRE Technique : T1123 - Audio Capture
  Tactic(s)       : Collection
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:30:30.173172+00:00
  Reference       : https://attack.mitre.org/techniques/T1123
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1123_Audio_Capture_Command_Then_Audio_File_Written {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a process launched with command-line indicators of microphone or audio-capture API use (waveIn, MCI waveaudio, MediaCapture, AudioGraph, DirectShow audio input), followed within 10 minutes on the same host by creation of an audio file in a user-writable staging location. This pairing suggests audio being recorded and staged for exfiltration."
    mitre_tactic = "Collection"
    mitre_technique = "T1123"
    mitre_technique_name = "Audio Capture"
    log_prerequisites = "Requires EDR or Sysmon process telemetry with full command lines (Sysmon Event ID 1 or Security Event 4688 with command-line auditing) and file creation telemetry (Sysmon Event ID 11 or EDR equivalent). PowerShell script-block logging helps but is not required."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Voice-recording or dictation tools, accessibility software, call-center and softphone clients, meeting-recording utilities, developer or QA scripts exercising audio APIs, and media-production workstations."
    tuning_guidance = "Add approved recording tools or their parent launchers to %global_allowed_admin_tools and %global_allowed_script_hosts. Add approved automation hosts to %global_allowed_script_hosts. For endpoints with a legitimate recording role, such as call-center or media workstations, exclude by hostname through a tenant-level rule exclusion. Widen or narrow the staging-directory regex to suit client profile layouts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(mciSendString|waveaudio|waveIn(Open|Start|Prepare|AddBuffer|GetDevCaps)|Windows\.Media\.Capture|MediaCapture|AudioGraph|IAudioCaptureClient|-f\s+dshow.{0,60}audio\s*=)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(wav|mp3|m4a|wma|aac|ogg|flac|amr|opus)$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents|music)|programdata|windows\\temp|users\\public)\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    $file.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1123")
    $primary_entity = array_distinct($proc.principal.hostname)
    $capture_commands = array_distinct($proc.target.process.command_line)
    $capture_processes = array_distinct($proc.target.process.file.full_path)
    $audio_files = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $affected_users = array_distinct($proc.principal.user.userid)
    $audio_file_count = count($file.metadata.id)

  condition:
    $proc and $file
}
