/*
  MITRE Technique : T1105 - Ingress Tool Transfer
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:13:36.589943+00:00
  Reference       : https://attack.mitre.org/techniques/T1105
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1105_ESXi_Outbound_Client_Firewall_Ruleset_Enabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects enabling of an outbound client firewall ruleset (HTTP, FTP, TFTP, SSH client) on an ESXi host through the host configuration plane. These rulesets are blocked by default. Enabling one is a prerequisite for pulling tools onto the hypervisor with wget, curl, scp or similar utilities, so this detects the enabling step rather than the download command line."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1105"
    mitre_technique_name = "Ingress Tool Transfer"
    log_prerequisites = "ESXi hostd and shell logs forwarded and parsed into UDM as SETTING_MODIFICATION. The firewall configuration change message text must be populated in metadata.description."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators temporarily enabling httpClient or sshClient for patching, VIB or offline bundle installs, or log and config export. Lifecycle management tooling and automation accounts. Scripted host build and provisioning workflows."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and automation or lifecycle accounts to %global_allowed_service_accounts. During planned maintenance windows, suppress per host. Alert severity can be raised if the same host later shows a SSH login from an unexpected source."

  events:
    $set.metadata.event_type = "SETTING_MODIFICATION"
    $set.metadata.description = /firewall.*(enable|enabled|allowed).*(httpClient|ftpClient|tftpClient|sshClient)/ nocase
    not $set.principal.user.userid in %global_allowed_admin_users
    not $set.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1105")
    $primary_entity = array_distinct($set.principal.hostname)
    $acting_user = array_distinct($set.principal.user.userid)
    $change_detail = array_distinct($set.metadata.description)

  condition:
    $set
}
