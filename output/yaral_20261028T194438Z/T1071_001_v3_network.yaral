/*
  MITRE Technique : T1071.001 - Web Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:04:31.291803+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_001_Network_Raw_IP_HTTP_POST_NonBrowser {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP POST from an internal client to an external server addressed by a raw IP literal in the URL, using a non-browser or empty User-Agent. Legitimate web traffic nearly always uses a DNS name and a browser-style User-Agent. This pattern is typical of implants that blend into web protocols for C2 check-in and data return, and the rule does not depend on any specific domain, IP, or tool."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.001"
    mitre_technique_name = "Application Layer Protocol: Web Protocols"
    log_prerequisites = "Requires firewall or proxy logs that populate NETWORK_HTTP with the full URL, HTTP method and User-Agent (explicit proxy or TLS-inspecting perimeter). Without TLS inspection, HTTPS URLs and methods are not visible and the rule only covers cleartext HTTP or proxied CONNECT-decrypted traffic."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Software updaters, IoT and OT devices, and monitoring agents that call vendor endpoints by IP. Internal tooling, health checks, or APIs hosted on public IPs. Vulnerability scanners and authorised security testing. Some legitimate CLI or SDK clients that use non-browser User-Agents."
    tuning_guidance = "Add known-good destination domains to %global_allowed_domains and scanner or test source addresses to %global_allowed_scanners. If a specific client population (for example IoT VLAN) is noisy, exclude it by source address through the appropriate allowlist. To broaden coverage, drop the POST restriction. To tighten it, require a target port outside 80 and 443."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /^https?:\/\/(\d{1,3}\.){3}\d{1,3}(:\d+)?(\/|$)/ nocase
    not $http.network.http.user_agent = /^Mozilla\// nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1071.001")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_ips = array_distinct($http.target.ip)
    $destination_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
