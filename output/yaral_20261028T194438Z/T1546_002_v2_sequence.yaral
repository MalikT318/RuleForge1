/*
  MITRE Technique : T1546.002 - Screensaver
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:02:17.914200+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_002_Screensaver_Dropped_Then_Registry_Set {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a .scr executable written outside the standard Windows system directories, followed within 10 minutes on the same host by a write to the SCRNSAVE.EXE value under the Control Panel\\Desktop registry key. This sequence indicates screensaver-based persistence (a malicious PE staged and registered as the user's screensaver). The rule uses file and registry telemetry, not process command lines."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.002"
    mitre_technique_name = "Event Triggered Execution: Screensaver"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11) and registry value-set telemetry (Sysmon Event ID 13) normalised to UDM FILE_CREATION and REGISTRY_MODIFICATION, with principal.hostname populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate custom or corporate-branded screensaver deployments (GPO, login scripts, software deployment tools), users installing third-party screensavers, and IT imaging or profile-provisioning scripts that stage a .scr and set it as the default."
    tuning_guidance = "Add approved deployment and RMM binaries to %global_allowed_admin_tools (matched against the process that writes the file or registry value). The .scr must be created within the 10-minute window before the registry write, so a payload staged earlier is not correlated. If the screensaver is already on disk, pair this rule with a standalone registry-only rule. If sanctioned corporate screensavers are common, extend the path exclusion in the rule to the approved share or folder pattern."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.scr$/ nocase
    not $file.target.file.full_path = /\\windows\\(system32|syswow64|winsxs)\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control Panel\\Desktop$/ nocase
    $reg.target.registry.registry_value_name = /^SCRNSAVE\.EXE$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    $reg.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1546.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $dropped_scr_paths = array_distinct($file.target.file.full_path)
    $file_writer_processes = array_distinct($file.principal.process.file.full_path)
    $registry_writer_processes = array_distinct($reg.principal.process.file.full_path)
    $affected_users = array_distinct($reg.principal.user.userid)
    $registry_keys = array_distinct($reg.target.registry.registry_key)

  condition:
    $file and $reg
}
