/*
  MITRE Technique : T1565.002 - Transmitted Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:41:43.222429+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_002_Script_Host_External_Data_Protocol_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows scripting host or living-off-the-land binary opening an outbound connection to an external address on a port used for data-bearing protocols (FTP, SMTP, SMB, MSSQL, Oracle, MySQL, PostgreSQL). Native interpreters rarely speak these protocols to the internet, so the connection can indicate interception, relaying or tampering with data in transit, or staging for it. This is the network-side view of Transmitted Data Manipulation."
    mitre_tactic = "Impact"
    mitre_technique = "T1565.002"
    mitre_technique_name = "Data Manipulation: Transmitted Data Manipulation"
    log_prerequisites = "Requires endpoint network telemetry that populates the initiating process path (EDR network events or Sysmon Event ID 3), normalised to UDM NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators running PowerShell to query remote cloud-hosted databases or SMB shares, ETL and reporting scripts, mail-relay test scripts using Send-MailMessage, SaaS migration tooling, authorised penetration tests."
    tuning_guidance = "Add approved admin and automation binaries to %global_allowed_admin_tools. Add approved scripting hosts to %global_allowed_script_hosts. Add security agents to %global_allowed_security_tools. Source hosts and accounts that legitimately reach external databases can be excluded with %global_allowed_service_accounts. Extend the port list to match protocols the client uses for transmitted business data."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|msbuild|installutil|regasm|regsvcs)\.exe$/ nocase
    (
      $net.target.port = 21 or
      $net.target.port = 25 or
      $net.target.port = 445 or
      $net.target.port = 587 or
      $net.target.port = 1433 or
      $net.target.port = 1521 or
      $net.target.port = 3306 or
      $net.target.port = 5432
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_script_hosts
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1565.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $source_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
