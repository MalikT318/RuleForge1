/*
  MITRE Technique : T1620 - Reflective Code Loading
  Tactic(s)       : Stealth
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:44:14.448244+00:00
  Reference       : https://attack.mitre.org/techniques/T1620
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1620_Linux_Fileless_Exec_From_Memfd {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process launched directly from an anonymous in-memory file (memfd) or from a /proc/<pid>/fd/<n> file descriptor path. This is the Linux mechanism for reflectively loading ELF payloads via memfd_create() followed by fexecve() or execve(), so that no file-backed binary exists on disk."
    mitre_tactic = "Stealth"
    mitre_technique = "T1620"
    mitre_technique_name = "Reflective Code Loading"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to UDM PROCESS_LAUNCH with target.process.file.full_path and command_line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Container runtimes re-executing themselves from a sealed memfd (runc/containerd clone of /proc/self/exe), some software installers and updaters, sandboxing frameworks, and legitimate security or EDR agents performing in-memory execution. Developers testing memfd-based loaders may also trigger it."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools and %global_allowed_security_tools. Confirm the container runtime memfd exclusion fits the environment. Allowlist known-good hosts with %global_allowed_script_hosts only after review, because memfd execution has few legitimate uses outside container runtimes."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $proc.target.process.file.full_path = /^\/memfd:/ nocase or
      $proc.target.process.file.full_path = /^\/proc\/(self|thread-self|[0-9]+)\/fd\/[0-9]+/ nocase or
      $proc.target.process.command_line = /^\/proc\/(self|thread-self|[0-9]+)\/fd\/[0-9]+/ nocase or
      $proc.target.process.command_line = /^\/memfd:/ nocase
    )
    not $proc.target.process.file.full_path = /^\/memfd:runc/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1620")
    $primary_entity = array_distinct($proc.principal.hostname)
    $executing_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $launched_path = array_distinct($proc.target.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
