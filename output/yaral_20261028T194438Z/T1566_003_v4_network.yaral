/*
  MITRE Technique : T1566.003 - Spearphishing via Service
  Tactic(s)       : Initial Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:51:00.283393+00:00
  Reference       : https://attack.mitre.org/techniques/T1566/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1566_003_Referred_Risky_File_Download_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP GET through a proxy or firewall for a file type commonly used to deliver malware (disk images, shortcuts, scripts, installers, archives, macro documents). The download must come from an external, non-allowlisted host and carry a referring URL, meaning the user followed a link from another page, such as a webmail, social media or messaging web client. This is the network-side footprint of a link delivered through a third-party service (T1566.003)."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1566.003"
    mitre_technique_name = "Phishing: Spearphishing via Service"
    log_prerequisites = "Requires proxy or firewall HTTP logging with URL inspection (target.url and network.http.referral_url populated). HTTPS inspection or a URL-aware proxy is needed for visibility. Without them, the rule will not fire."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate software or driver downloads reached from vendor portals or search engines, internal portals linking to external installers, SaaS and file-sharing links used for business, and IT staff downloading ISO or archive files."
    tuning_guidance = "Add known-good vendor, CDN and update domains to %global_allowed_domains (exact hostname match, so list the specific download hosts). Trim the extension list for environments where archives or installers are routinely downloaded. If the proxy does not log referral URLs, this rule will not fire and a different network-side approach is needed. Raise severity when the same source host also shows a subsequent endpoint execution alert."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.target.url = /\.(iso|img|lnk|hta|js|jse|vbs|vbe|wsf|scr|msi|cab|zip|rar|7z|one|docm|xlsm|exe|dll)(\?.*)?$/ nocase
    $http.network.http.referral_url != ""
    $http.target.hostname != ""
    not $http.target.hostname in %global_allowed_domains
    not $http.target.ip in %rfc1918_internal

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1566.003")
    $primary_entity = array_distinct(strings.coalesce($http.principal.hostname, $http.principal.user.userid))
    $source_ips = array_distinct($http.principal.ip)
    $download_hosts = array_distinct($http.target.hostname)
    $download_urls = array_distinct($http.target.url)
    $referrers = array_distinct($http.network.http.referral_url)

  condition:
    $http
}
