/*
  MITRE Technique : T1547.008 - LSASS Driver
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:34:12.619092+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_008_Unexpected_Parent_Spawns_LSA_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an unexpected parent process (Office application, web server, database service, print spooler, document reader) spawning a shell, script interpreter or registry utility whose command line targets the LSA registry configuration (Security Packages, Authentication Packages, Notification Packages). These values control which DLLs are loaded into lsass.exe, so an exploited or macro-driven parent touching them indicates LSASS driver persistence."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.008"
    mitre_technique_name = "Boot or Logon Autostart Execution: LSASS Driver"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers that register authentication or notification packages (smart card, MFA or credential provider agents, password filter products, third-party SSO) launched via a database or web-hosted deployment service; IT automation run through a script host; vulnerability or compliance scanners querying LSA settings."
    tuning_guidance = "Add approved parent binaries to %global_allowed_script_hosts and deployment or management tooling to %global_allowed_admin_tools. Add named admin accounts that legitimately manage LSA packages to %global_allowed_admin_users. Add known MFA or credential-provider installers to %global_allowed_admin_tools. Narrow or extend the parent regex per customer application stack."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|onenote|visio|mspub|acrord32|w3wp|httpd|nginx|php-cgi|tomcat[0-9]*|sqlservr|mysqld|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|reg|regedit)\.exe$/ nocase
    $proc.target.process.command_line = /\\Control\\Lsa/ nocase
    $proc.target.process.command_line = /(Security Packages|Authentication Packages|Notification Packages|OSConfig)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1547.008")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
