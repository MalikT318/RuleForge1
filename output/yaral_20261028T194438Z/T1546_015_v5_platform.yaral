/*
  MITRE Technique : T1546.015 - Component Object Model Hijacking
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:21:20.238934+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_015_COM_TypeLib_Hijack_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry write that points a COM TypeLib win32/win64 registration at a script moniker or a user-writable location. This is the TypeLib variant of COM hijacking, where a legitimate COM object is redirected to attacker content. It is registry-based, not process command-line based, so it complements existing PROCESS_LAUNCH rules. COM hijacking is a Windows-only mechanism, so no Linux, macOS or cloud equivalent exists and the rule targets Windows."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.015"
    mitre_technique_name = "Event Triggered Execution: Component Object Model Hijacking"
    log_prerequisites = "Requires Windows registry value-set telemetry with registry key and value data populated (EDR registry events or Sysmon Event ID 13), covering both HKLM and per-user HKU hives."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-user applications that register their own type libraries under user profile paths (collaboration clients, browsers, cloud sync clients, developer tools), MSI installers and updaters, and software packaging or deployment tooling."
    tuning_guidance = "Add approved installer, deployment and RMM binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Review the first 7 days of alerts to identify per-user applications that legitimately register type libraries and exclude them by writing process name. Optionally extend the process-name exclusion regex for client-specific updaters."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\software\\classes\\(wow6432node\\)?typelib\\\{[0-9a-f\-]+\}\\[^\\]+\\[0-9]+\\(win32|win64)$/ nocase
    $reg.target.registry.registry_value_data = /^\s*(script:|scriptlet:|new:)|\\users\\[^\\]+\\(appdata|downloads|desktop)\\|\\users\\public\\|\\programdata\\|\\windows\\temp\\|\\temp\\/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path = /\\(msiexec|trustedinstaller|tiworker)\.exe$/ nocase

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546.015")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_data)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
