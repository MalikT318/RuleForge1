/*
  MITRE Technique : T1037.001 - Logon Script (Windows)
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:20:25.276062+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_001_UserInitMprLogonScript_Registry_Set {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of the UserInitMprLogonScript value under a user's Environment registry key. Windows runs the script referenced by this value at every logon for that user, so adversaries use it for persistence and execution at logon. Legitimate use is rare in modern environments."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.001"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Logon Script (Windows)"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events) normalised to REGISTRY_MODIFICATION, covering HKCU/HKU Environment keys."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy enterprise logon-script deployments that write this value directly, IT onboarding or profile-provisioning scripts, RMM and software deployment tooling, and administrators testing logon scripts."
    tuning_guidance = "Add approved deployment and RMM binaries to %global_allowed_admin_tools, and named administrators to %global_allowed_admin_users. Add service accounts that legitimately provision profiles to %global_allowed_service_accounts. Review the registry value data in the outcome to confirm the script path is not user-writable (AppData, Temp, Public, ProgramData)."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Environment$/ nocase
    $reg.target.registry.registry_value_name = /^UserInitMprLogonScript$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_admin_users
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1037.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $acting_user = array_distinct($reg.principal.user.userid)
    $acting_process = array_distinct($reg.principal.process.file.full_path)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $logon_script_value = array_distinct($reg.target.registry.registry_value_data)

  condition:
    $reg
}
