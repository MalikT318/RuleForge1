/*
  MITRE Technique : T1546.016 - Installer Packages
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:23:35.451821+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_016_Installer_Package_Bulk_Executable_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "The Windows Installer engine (msiexec) writes a high volume of executable or script files into user-writable or staging locations (AppData, ProgramData, Temp, Users\\Public) on one host within ten minutes. A single dropped file is normal installer behaviour, but bulk drops outside Program Files can indicate a trojanised installer package using its elevated install context to stage persistence payloads."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.016"
    mitre_technique_name = "Event Triggered Execution: Installer Packages"
    log_prerequisites = "Requires EDR or Sysmon-equivalent file creation telemetry (Sysmon Event ID 11 or equivalent) with the creating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-user application installers deployed as MSI (collaboration clients, browsers, Electron-based apps), software deployment and patching platforms, legitimate vendor installers that stage runtimes or drivers under ProgramData, and golden image or build pipelines."
    tuning_guidance = "Add approved deployment tooling parent processes to %global_allowed_admin_tools and deployment or SCCM service accounts to %global_allowed_service_accounts. The default threshold of 10 is conservative; raise it in noisy estates with heavy per-user MSI deployment, or lower it for high-value servers. Triage higher file_count values first, and pay particular attention to script extensions (.ps1, .vbs, .hta) or an interactive user context."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\msiexec\.exe$/ nocase
    $file.target.file.full_path = /\\(Users\\[^\\]+\\AppData|ProgramData|Windows\\Temp|Users\\Public)\\.*\.(exe|dll|scr|bat|cmd|ps1|vbs|js|hta)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.parent_process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1546.016")
    $primary_entity = array_distinct($host)
    $file_count = count($file.metadata.id)
    $dropped_paths = array_distinct($file.target.file.full_path)
    $installing_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 10
}
