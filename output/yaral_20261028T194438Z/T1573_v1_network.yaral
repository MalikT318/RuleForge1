/*
  MITRE Technique : T1573 - Encrypted Channel
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:20:40.265828+00:00
  Reference       : https://attack.mitre.org/techniques/T1573
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1573_Firewall_Encrypted_Channel_NonStandard_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Perimeter telemetry shows an outbound connection to an external address that was classified as TLS/HTTPS by the firewall's application identification but uses a destination port other than the standard HTTPS ports. Malware often wraps C2 traffic in TLS on unusual ports to evade port-based filtering and conceal its content. Detection relies on network-side protocol classification and the destination port, not on the process, tool name or destination."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1573"
    mitre_technique_name = "Encrypted Channel"
    log_prerequisites = "Firewall or proxy logs normalised to UDM NETWORK_CONNECTION with network.application_protocol populated by application identification or TLS inspection, plus target.ip and target.port."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Vendor SaaS and agent platforms using TLS on custom ports, VPN and remote access gateways, alternate admin web consoles, mail and messaging services on non-standard TLS ports, developer test servers, and legitimate software update services."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains. Add vulnerability scanners and security testing sources to %global_allowed_scanners. Add approved management or egress sources to %global_allowed_mgmt_sources. Extend the excluded standard port list (443, 8443) to match each client's approved TLS services. Raise severity if the destination is rare across the estate or the source host is a server."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.application_protocol = "HTTPS"
    $net.target.port > 0
    $net.target.port != 443
    $net.target.port != 8443
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1573")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
