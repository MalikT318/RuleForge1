/*
  MITRE Technique : T1055.005 - Thread Local Storage
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:53:42.933266+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_005_TLS_Callback_Injection_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated cross-process injection events from non-excluded source processes into common legitimate host processes on a single Windows host within 10 minutes. TLS callback injection writes to another process's memory and redirects a PE TLS callback pointer so the code runs before the entry point. One injection event is often benign, but a burst is a strong indicator of injection tradecraft. Severity is raised when the target is a credential or logon process."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.005"
    mitre_technique_name = "Process Injection: Thread Local Storage"
    log_prerequisites = "Requires Windows endpoint telemetry that reports cross-process memory write, remote thread, or injection events, normalised to PROCESS_INJECTION (EDR or Sysmon-equivalent)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Accessibility and screen-reader software, application compatibility shims, game overlays and anti-cheat, DLP and endpoint agents that hook processes, legitimate debuggers and developer tooling, and backup or imaging software."
    tuning_guidance = "Add approved EDR/AV agents to %global_allowed_security_tools, backup agents to %global_allowed_backup_processes, and IT tooling to %global_allowed_admin_tools. Raise the #inj threshold on hosts where developer or debugging activity is common. Review the target process list if coverage needs to be widened."

  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.hostname = $host
    $inj.target.process.file.full_path = /\\(svchost|explorer|notepad|rundll32|dllhost|regsvr32|werfault|taskhostw|sihost|searchindexer|spoolsv|winlogon|lsass|services|wininit|conhost|msiexec)\.exe$/ nocase
    $inj.principal.process.pid != $inj.target.process.pid
    not $inj.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|SenseCnC)\.exe$/ nocase
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($inj.target.process.file.full_path = /(?i)\\(winlogon|lsass)\.exe$/, 85, 70))
    $event_count = count($inj.metadata.id)
    $mitre_technique_id = array_distinct("T1055.005")
    $primary_entity = array_distinct($host)
    $source_processes = array_distinct($inj.principal.process.file.full_path)
    $target_processes = array_distinct($inj.target.process.file.full_path)
    $source_users = array_distinct($inj.principal.user.userid)

  condition:
    #inj >= 5
}
