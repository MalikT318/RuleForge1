/*
  MITRE Technique : T1218.013 - Mavinject
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:59:15.651235+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_013_Mavinject_Injection_Then_Suspicious_Module_Load {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects mavinject.exe performing a remote-thread/process injection into another process, followed within 10 minutes on the same host by a DLL being loaded from a user-writable location. This correlates the injection primitive with its payload-load result rather than relying on mavinject command-line arguments."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.013"
    mitre_technique_name = "System Binary Proxy Execution: Mavinject"
    log_prerequisites = "Requires endpoint telemetry that records process injection (e.g. CreateRemoteThread) and image/module load events, normalised to PROCESS_INJECTION and PROCESS_MODULE_LOAD."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Microsoft App-V packaging or sequencing activity; software deployment tooling that uses App-V injection; security agents that load their own DLLs from ProgramData."
    tuning_guidance = "Add approved App-V or deployment parent processes to %global_allowed_admin_tools. Add EDR/AV agents that load modules from ProgramData to %global_allowed_security_tools. Narrow the user-writable path regex if a client has benign DLL loads from those locations."

  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.process.file.full_path = /\\mavinject(32)?\.exe$/ nocase
    not $inj.principal.process.parent_process.file.full_path in %global_allowed_admin_tools
    $inj.principal.hostname = $hostname

    $mod.metadata.event_type = "PROCESS_MODULE_LOAD"
    $mod.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop)|users\\public|programdata|windows\\temp|perflogs)\\.*\.dll$/ nocase
    not $mod.principal.process.file.full_path in %global_allowed_security_tools
    not $mod.principal.process.file.full_path in %global_allowed_admin_tools
    $mod.principal.hostname = $hostname

    $inj.metadata.event_timestamp.seconds <= $mod.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1218.013")
    $primary_entity = array_distinct($hostname)
    $injected_targets = array_distinct($inj.target.process.file.full_path)
    $loaded_dlls = array_distinct($mod.target.file.full_path)
    $loading_processes = array_distinct($mod.principal.process.file.full_path)
    $injection_count = count($inj.metadata.id)

  condition:
    $inj and $mod
}
