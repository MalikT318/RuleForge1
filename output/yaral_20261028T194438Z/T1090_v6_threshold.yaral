/*
  MITRE Technique : T1090 - Proxy
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:26:07.906497+00:00
  Reference       : https://attack.mitre.org/techniques/T1090
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1090_ESXi_Network_Config_Change_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of network-exposure setting changes (firewall rule sets, TCP/IP stack, virtual switches, port groups, VMkernel interfaces) on a single ESXi host within ten minutes. Repeated changes of this kind can indicate an adversary turning the hypervisor into a proxy or relay for command and control traffic, for example by opening firewall rule sets, adding listeners or building traffic-redirection paths. A single change is routine; a burst is not."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1090"
    mitre_technique_name = "Proxy"
    log_prerequisites = "ESXi hostd and shell logs forwarded to Chronicle and parsed into SETTING_MODIFICATION events, with the setting description populated in metadata.description."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Planned host provisioning or rebuilds, network engineers migrating virtual switches or port groups, automated host-profile remediation, and orchestration tooling applying configuration baselines."
    tuning_guidance = "Add expected administrator accounts to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Raise the #set threshold for environments with frequent automated host-profile remediation. Exclude maintenance windows through client-specific rule exclusions."

  events:
    $set.metadata.event_type = "SETTING_MODIFICATION"
    $set.metadata.description = /(firewall|rule\s?set|tcpip|netstack|vmknic|vmkernel\s+(nic|interface)|vswitch|port\s?group)/ nocase
    $set.principal.hostname = $host
    not $set.principal.user.userid in %global_allowed_admin_users
    not $set.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($set.metadata.id)
    $mitre_technique_id = array_distinct("T1090")
    $primary_entity = array_distinct($host)
    $acting_users = array_distinct($set.principal.user.userid)
    $source_ips = array_distinct($set.principal.ip)

  condition:
    #set >= 5
}
