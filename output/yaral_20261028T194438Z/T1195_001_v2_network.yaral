/*
  MITRE Technique : T1195.001 - Compromise Software Dependencies and Development Tools
  Tactic(s)       : Initial Access
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:40:00.641103+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_001_Package_Manager_Client_To_Unapproved_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a software package-manager client (npm, pip, NuGet, Maven, Cargo, gem, Composer and similar) fetching content over HTTP from an external host that is not on the approved domain list. This is the network-side signature of a typosquatted, hijacked or dependency-confused package source being pulled into a build or developer workstation."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.001"
    mitre_technique_name = "Supply Chain Compromise: Compromise Software Dependencies and Development Tools"
    log_prerequisites = "Requires proxy or firewall logs with HTTP inspection (TLS inspection for HTTPS) that populate network.http.user_agent and target.hostname. Without TLS inspection only plain HTTP traffic is visible."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Developers or build agents using legitimate public registries not yet in the allowlist, newly adopted private or vendor registries, internal artifact mirrors fronted by an external CDN, and package managers used by approved CI hosts."
    tuning_guidance = "Add approved registry and mirror domains (public registries, private feeds, CDN hostnames) to %global_allowed_domains. Add known build-server and CI hostnames to %global_allowed_script_hosts. Review the user-agent regex if client coverage needs to be widened or narrowed."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /\b(npm|pnpm|yarn|pip|nuget|maven|gradle|cargo|rubygems|bundler|composer|poetry)\b/ nocase
    $net.target.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1195.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $registry_hosts = array_distinct($net.target.hostname)
    $client_user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
