/*
  MITRE Technique : T1011 - Exfiltration Over Other Network Medium
  Tactic(s)       : Exfiltration
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:21:18.336018+00:00
  Reference       : https://attack.mitre.org/techniques/T1011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1011_Linux_Wireless_Bluetooth_Egress_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of wireless or Bluetooth connection, tethering and transfer utilities launched with connect, hotspot, bind, listen or send style arguments on a single Linux host within 10 minutes. A single invocation is routine, but repeated use suggests data being staged to an alternate network medium (WiFi hotspot, Bluetooth OBEX/RFCOMM, cellular modem) that bypasses the primary monitored egress path."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1011"
    mitre_technique_name = "Exfiltration Over Other Network Medium"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records (SYSCALL/EXECVE) normalised to UDM PROCESS_LAUNCH with command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Laptop users joining WiFi or pairing Bluetooth devices, NetworkManager helper scripts, field or IoT devices that dial cellular modems at boot, IT provisioning scripts, and developers testing wireless hardware."
    tuning_guidance = "Add approved provisioning and network management parent binaries to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Raise the #proc threshold for laptop-heavy fleets, or for servers with no wireless hardware lower it to 2, since any use there is anomalous."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(nmcli|iw|iwconfig|wpa_cli|wpa_supplicant|rfcomm|bluetoothctl|hcitool|hciconfig|obexftp|obexpushd|bluetooth-sendto|ussp-push|mmcli|wvdial|pppd)$/ nocase
    $proc.target.process.command_line = /(connect|hotspot|ibss|\bap\b|bind|listen|--put|\bput\b|send|push|dial|--simple-connect|\bup\b)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1011")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $tools = array_distinct($proc.target.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
