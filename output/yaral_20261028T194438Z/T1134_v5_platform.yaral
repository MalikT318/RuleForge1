/*
  MITRE Technique : T1134 - Access Token Manipulation
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:52:00.071003+00:00
  Reference       : https://attack.mitre.org/techniques/T1134
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_Runas_Savecred_Netonly_Token_Context {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects the built-in runas utility launching a process under an alternate account using cached credentials (/savecred) or a network-only logon token (/netonly). Both flags let a user or adversary run code in a different security context without an interactive logon, and /savecred persists credentials for reuse. Written for Windows endpoint telemetry. The requested non-Windows angle was not applied because the mandatory platform requirement for this variant is Windows."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134"
    mitre_technique_name = "Access Token Manipulation"
    log_prerequisites = "Requires EDR process telemetry, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators using runas /netonly to test domain credentials from non-domain-joined workstations, helpdesk staff running tools as a secondary admin account, legacy logon scripts that use /savecred, and developers testing application behaviour under a different identity."
    tuning_guidance = "Add approved IT tooling parent processes to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Review recurring admin usage and consider adding named administrators to %global_allowed_admin_users. Raise severity where /savecred is used by non-administrative users."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\runas\.exe$/ nocase
    $proc.target.process.command_line = /\/(savecred|netonly)\b/ nocase
    $proc.target.process.command_line = /\/user:/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1134")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
