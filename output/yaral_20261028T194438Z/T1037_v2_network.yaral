/*
  MITRE Technique : T1037 - Boot or Logon Initialization Scripts
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:18:13.373534+00:00
  Reference       : https://attack.mitre.org/techniques/T1037
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_Outbound_SMB_Logon_Script_Retrieval {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows host connecting to an external (non-internal) address on SMB ports 445 or 139. Boot or logon initialization scripts (GPO logon scripts, NETLOGON-style UNC paths, or scripts planted to run at logon) can be pointed at an attacker-controlled UNC share, so the host fetches and runs the payload at every boot or logon and leaks NTLM authentication in the process. SMB to the internet is almost never legitimate, so this observes the persistence mechanism from the network perimeter without relying on endpoint process fields."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037"
    mitre_technique_name = "Boot or Logon Initialization Scripts"
    log_prerequisites = "Requires firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with populated principal.ip or principal.hostname, target.ip and target.port. Outbound SMB must not be blocked before logging, or the denied connection attempt must still be logged."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Cloud file services reached over SMB (for example Azure Files over 445), site-to-site or VPN-routed partner file shares that appear as public addresses, hosted backup or migration tooling, misconfigured clients, and external vulnerability scanning that is logged with the internal host as the source."
    tuning_guidance = "Add approved SMB destination addresses (cloud file services, partner shares) to %global_allowed_mgmt_sources. Add known-good destination hostnames to %global_allowed_domains. Confirm %rfc1918_internal covers all internal address space for the tenant. For hits, review the source host for logon script changes (GPO scripts, UserInitMprLogonScript, Startup folder)."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 445 or $net.target.port = 139)
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1037")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
