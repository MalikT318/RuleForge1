/*
  MITRE Technique : T1070 - Indicator Removal
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:02:42.624588+00:00
  Reference       : https://attack.mitre.org/techniques/T1070
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_PSReadLine_History_File_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects deletion of a PowerShell PSReadLine command-history file from a user profile. This is the Windows counterpart of shell-history wiping, and it is detected from file-deletion telemetry rather than process command lines, so it complements existing PROCESS_LAUNCH rules. The Linux/macOS/cloud pivot was not applied because the target platform for this deliverable is fixed to Windows."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070"
    mitre_technique_name = "Indicator Removal"
    log_prerequisites = "Requires EDR or Sysmon file-deletion telemetry (e.g. Sysmon Event ID 23/26) normalised to UDM FILE_DELETION, with principal.process and target.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or users manually resetting PSReadLine history, profile cleanup or user-profile deletion by IT tooling, VDI/golden-image sanitisation, endpoint hygiene or privacy tools, OS reimaging scripts."
    tuning_guidance = "Add approved cleanup or imaging tools to %global_allowed_admin_tools, named administrators to %global_allowed_admin_users, and EDR/AV agents to %global_allowed_security_tools. If VDI logoff scripts cause noise, scope them out by adding the script host to %global_allowed_script_hosts."

  events:
    $file.metadata.event_type = "FILE_DELETION"
    $file.target.file.full_path = /\\appdata\\roaming\\microsoft\\windows\\powershell\\psreadline\\[^\\]+$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1070")
    $primary_entity = array_distinct($file.principal.hostname)
    $acting_user = array_distinct($file.principal.user.userid)
    $acting_process = array_distinct($file.principal.process.file.full_path)
    $deleted_file = array_distinct($file.target.file.full_path)

  condition:
    $file
}
