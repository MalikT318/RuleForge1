/*
  MITRE Technique : T1027.015 - Compression
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:03:17.679731+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_015_Linux_Mass_Archive_Creation_In_Staging_Dirs {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of compressed archive files (zip, gz, bz2, xz, 7z, rar, zst) created in world-writable staging directories (/tmp, /var/tmp, /dev/shm) on a single Linux host within ten minutes. One archive is benign, but many in a short window suggests payload packing, data staging, or unpacking of compressed content to obfuscate files. This is file-creation volume logic and does not depend on command-line matching."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.015"
    mitre_technique_name = "Obfuscated Files or Information: Compression"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry normalised to UDM FILE_CREATION with principal.process.file.full_path and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Log rotation or crash-dump collection into temp directories, CI/build agents, package managers and software updaters, backup or diagnostic bundle scripts (sosreport, support bundles), developers compressing artifacts."
    tuning_guidance = "Add approved backup tooling to %global_allowed_backup_processes, deployment/CI tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Raise the #file threshold for build servers."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.*\.(zip|gz|tgz|bz2|xz|7z|rar|zst|lz4|lzma)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|dnf|yum|snapd|unattended-upgrade|logrotate|systemd-coredump)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1027.015")
    $primary_entity = array_distinct($host)
    $archive_paths = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 8
}
