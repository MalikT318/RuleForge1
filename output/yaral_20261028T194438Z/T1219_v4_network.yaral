/*
  MITRE Technique : T1219 - Remote Access Tools
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:04:53.269145+00:00
  Reference       : https://attack.mitre.org/techniques/T1219
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1219_Remote_Access_Protocol_External_From_UserWritable_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound connection to an external address on a well-known remote desktop or remote-control port (RDP, VNC, and common commercial remote-support relay ports) initiated by a process running from a user-writable location such as a user profile, ProgramData or a Temp directory. Remote access tools that are dropped and run in place (portable or unsigned binaries), or malware using back-connect remote control, usually run from these paths. Approved remote management software is normally installed under Program Files or a system path."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1219"
    mitre_technique_name = "Remote Access Tools"
    log_prerequisites = "Requires endpoint network telemetry that records the initiating process path (EDR or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path and target.port populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Portable remote support tools approved by the client and run from Downloads or AppData, per-user installs of sanctioned remote support software, helpdesk staff running vendor quick-support executables, admin scripts using RDP or VNC from a temp folder, and software installers that perform connectivity checks on these ports."
    tuning_guidance = "Add sanctioned remote support and RMM executable paths to %global_allowed_remote_mgmt and %global_allowed_admin_tools. Add approved destination relay addresses to %global_allowed_mgmt_sources if used. Populate %rfc1918_internal for the client's internal address space. For clients that approve per-user installs of a remote tool, allowlist it by executable path in %global_allowed_remote_mgmt rather than by directory."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 3389 or
      $net.target.port = 5500 or
      $net.target.port = 5900 or
      $net.target.port = 5901 or
      $net.target.port = 5938 or
      $net.target.port = 6568 or
      $net.target.port = 7070
    )
    $net.principal.process.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|programdata|windows\\temp|temp|users\\public)\\/ nocase
    not $net.principal.process.file.full_path = /\\(mstsc|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1219")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
