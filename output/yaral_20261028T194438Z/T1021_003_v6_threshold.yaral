/*
  MITRE Technique : T1021.003 - Distributed Component Object Model
  Tactic(s)       : Lateral Movement
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:39:42.152710+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_003_DCOM_RPC_Endpoint_Mapper_Fanout {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single Windows host opens many connections to the RPC endpoint mapper (TCP/135) on internal systems within ten minutes. DCOM remote activation starts with an RPC endpoint mapper exchange, so this volume can indicate DCOM-based lateral movement or sweeping. One connection is benign; the fan-out is not."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.003"
    mitre_technique_name = "Remote Services: Distributed Component Object Model"
    log_prerequisites = "Requires endpoint network connection telemetry with process attribution (EDR or Sysmon Event ID 3, or equivalent) normalised to UDM NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Vulnerability scanners, RMM and software deployment tooling, domain controllers or management servers that poll many hosts over RPC, WMI-based inventory and monitoring servers, and administrators running remote MMC snap-ins against many servers."
    tuning_guidance = "Add approved management tools to %global_allowed_admin_tools or %global_allowed_remote_mgmt, scanner hosts to %global_allowed_scanners, and security agents to %global_allowed_security_tools. Raise the #net threshold on noisy server segments, or lower it for high-value segments. Review $distinct_target_ips in the outcome to separate a broad sweep from repeated connections to a few hosts."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 135
    $net.target.ip in %rfc1918_internal
    $net.principal.hostname = $host
    not $net.principal.hostname in %global_allowed_scanners
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR)\.exe$/ nocase

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1021.003")
    $primary_entity = array_distinct($host)
    $distinct_target_ips = array_distinct($net.target.ip)
    $source_processes = array_distinct($net.principal.process.file.full_path)
    $source_users = array_distinct($net.principal.user.userid)

  condition:
    #net >= 10
}
