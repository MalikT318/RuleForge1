/*
  MITRE Technique : T1137.006 - Add-ins
  Tactic(s)       : Persistence
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:23:11.518424+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_006_Office_Addin_Download_Over_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office client (identified by its HTTP user-agent) retrieving an Office add-in file (XLL, WLL, XLA/XLAM, PPAM, VSTO) from an external source. Add-ins are loaded when the Office application starts, so a remotely fetched add-in is a common way to stage persistence."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.006"
    mitre_technique_name = "Office Application Startup: Add-ins"
    log_prerequisites = "Requires NETWORK_HTTP events with target.url and network.http.user_agent populated, such as web proxy, secure web gateway, or EDR HTTP telemetry normalised to UDM. Events must arrive via the windows_endpoint log source mapping."
    platform = "Office Suite"
    log_source = "windows_endpoint"
    false_positives = "Corporate add-in distribution from external vendor CDNs, such as finance or analytics Excel add-ins. Legitimate VSTO or ClickOnce deployments hosted outside the corporate network. Admins or developers testing add-ins. Third-party SaaS Office integrations that download XLAM or XLA files."
    tuning_guidance = "Add approved vendor and add-in hosting domains to %global_allowed_domains. Add administrator accounts that deploy add-ins to %global_allowed_admin_users. Confirm the proxy or EDR populates network.http.user_agent, because the rule will not evaluate without it. Escalate when the add-in file is later written to an Office startup location on the same host."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\.(xll|wll|xlam|xla|ppam|vsto)([?#].*)?$/ nocase
    $net.network.http.user_agent = /(microsoft (office|excel|word|outlook|powerpoint)|\bms-office\b)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1137.006")
    $primary_entity = array_distinct($net.principal.hostname)
    $addin_urls = array_distinct($net.target.url)
    $destination_hosts = array_distinct($net.target.hostname)
    $users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
