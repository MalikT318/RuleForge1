/*
  MITRE Technique : T1071.005 - Publish/Subscribe Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:10:48.003611+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_005_Outbound_PubSub_Broker_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an outbound connection from an internal host to an external destination on a well-known publish/subscribe broker port (MQTT, AMQP, STOMP, XMPP server-to-server). Adversaries use pub/sub brokers for command and control because the traffic blends in with legitimate messaging and IoT traffic. This is a network-side detection that does not depend on endpoint process telemetry."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.005"
    mitre_technique_name = "Application Layer Protocol: Publish/Subscribe Protocols"
    log_prerequisites = "Firewall, proxy or perimeter connection logs normalized to UDM NETWORK_CONNECTION with target.ip and target.port populated. Egress traffic must be logged."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate use of cloud IoT or messaging brokers by business applications, SaaS integrations that use AMQP or MQTT, developer workstations testing message queues, and building-management or telemetry agents."
    tuning_guidance = "Add known-good broker domains to %global_allowed_domains. Narrow or widen the port list to match the client's egress policy. Where clients have approved messaging workloads, consider a client-specific severity override for those source hosts."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 1883 or
      $net.target.port = 8883 or
      $net.target.port = 5672 or
      $net.target.port = 5671 or
      $net.target.port = 61613 or
      $net.target.port = 61614 or
      $net.target.port = 5222 or
      $net.target.port = 5269
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1071.005")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
