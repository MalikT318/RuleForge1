/*
  MITRE Technique : T1071.004 - DNS
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:10:00.270803+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_004_Firewall_DNS_Tunnel_Long_Label_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries observed at the network perimeter that carry an abnormally long encoded-looking subdomain label (40+ characters of base32/base64/hex-style data) sent to an external resolver. This is characteristic of data encoded into DNS queries for C2 or tunneling. The rule uses only network-observable DNS fields, so it complements endpoint command-line detections."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.004"
    mitre_technique_name = "Application Layer Protocol: DNS"
    log_prerequisites = "Firewall, DNS-inspection or proxy logs normalised to UDM NETWORK_DNS with network.dns.questions.name populated. Perimeter must log client queries sent to external resolvers."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "CDN and cloud services using long hashed hostnames; DNS-based blocklist/reputation lookups (email security, AV cloud lookups); DKIM/DMARC and other long TXT-style lookups; software update and telemetry services; DNSSEC or service-discovery names; some anti-malware cloud lookups."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains. Because %global_allowed_domains is matched against the full query name, add the exact names of noisy services. Raise the label length threshold (for example {50,}) if hashed CDN names are noisy. Queries sent to internal resolvers (target.ip in %rfc1918_internal) are excluded; to cover those, move this rule to the resolver's own DNS logs instead of perimeter logs."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(^|\.)[a-z0-9_-]{40,}(\.[a-z0-9_-]+){2,}$/ nocase
    not $dns.target.ip in %rfc1918_internal
    not $dns.network.dns.questions.name in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1071.004")
    $primary_entity = array_distinct($dns.principal.ip)
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $resolver_ips = array_distinct($dns.target.ip)

  condition:
    $dns
}
