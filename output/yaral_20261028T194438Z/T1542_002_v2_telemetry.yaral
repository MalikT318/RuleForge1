/*
  MITRE Technique : T1542.002 - Component Firmware
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:44:20.114147+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_002_Linux_Firmware_Artifact_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of component firmware artifacts on Linux: firmware blobs under the kernel firmware directories, the sysfs firmware-loading data interface, PCI expansion ROM write interfaces, and raw MTD flash devices. Detection is based on the resulting file state change rather than command-line content, so it is independent of the tool used to flash or stage the firmware."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.002"
    mitre_technique_name = "Pre-OS Boot: Component Firmware"
    log_prerequisites = "Linux endpoint telemetry that records file modification events with the acting process (EDR file-write events or auditd watch rules on /lib/firmware, /usr/lib/firmware, /sys/class/firmware, /sys/bus/pci/devices/*/rom and /dev/mtd*), normalised to UDM FILE_MODIFICATION."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate firmware updates delivered by OS package managers (dpkg, rpm, apt, dnf, yum), fwupd-driven vendor firmware updates, initramfs and dracut regeneration, udev firmware loading, kernel and driver installs, and administrator-run hardware maintenance such as NIC, RAID or flash updates."
    tuning_guidance = "Add approved firmware update and deployment tooling paths to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Validate package-manager exclusions against the clients patch windows. If auditd is the sole source, ensure watch rules exist for the monitored paths, otherwise the rule will not fire."

  events:
    $fw.metadata.event_type = "FILE_MODIFICATION"
    $fw.target.file.full_path = /^\/(usr\/)?lib\/firmware\/.+|^\/sys\/class\/firmware\/[^\/]+\/(data|loading)$|^\/sys\/bus\/pci\/devices\/[^\/]+\/rom$|^\/dev\/mtd(block)?[0-9]+(ro)?$/ nocase
    $fw.principal.hostname = $hostname
    not $fw.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|dnf|yum|zypper|packagekitd|fwupd|fwupdmgr|fwupdtool|systemd-udevd|udevd|dracut|update-initramfs|mkinitcpio|depmod|kmod)$/ nocase
    not $fw.principal.process.file.full_path in %global_allowed_admin_tools
    not $fw.principal.user.userid in %global_allowed_service_accounts

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1542.002")
    $primary_entity = array_distinct($hostname)
    $modified_paths = array_distinct($fw.target.file.full_path)
    $acting_processes = array_distinct($fw.principal.process.file.full_path)
    $acting_users = array_distinct($fw.principal.user.userid)
    $modification_count = count($fw.metadata.id)

  condition:
    $fw
}
