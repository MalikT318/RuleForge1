/*
  MITRE Technique : T1677 - Poisoned Pipeline Execution
  Tactic(s)       : Execution
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:22:40.625907+00:00
  Reference       : https://attack.mitre.org/techniques/T1677
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1677_Pipeline_Runner_External_Upload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a CI/CD build runner or pipeline agent sending an outbound HTTP POST/PUT with a scripted-client user agent to an external destination outside the known-good domain list. This is the network-side result of a poisoned pipeline exfiltrating build secrets or tokens (direct, indirect or public pipeline execution)."
    mitre_tactic = "Execution"
    mitre_technique = "T1677"
    mitre_technique_name = "Poisoned Pipeline Execution"
    log_prerequisites = "Requires HTTP egress telemetry from CI/CD runners or pipeline agents (proxy, egress gateway or runner network logs) normalised to UDM NETWORK_HTTP, delivered alongside the cloud control-plane audit feed. Runner hostnames must follow a recognisable naming convention (runner, build, agent, ci, pipeline). Without runner egress visibility this rule will not fire."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Build steps that publish artifacts, packages or container images to external registries not in the allowlist; deployment steps calling vendor APIs; webhook or notification steps (chat, ticketing); legitimate dependency downloads that use POST; security scanners uploading results to vendor SaaS."
    tuning_guidance = "Add approved publishing, registry and vendor API domains to %global_allowed_domains. Add known automation identities to %global_allowed_cloud_principals. Add scanner egress sources to %global_allowed_scanners if scanners run on runner-named hosts. Adjust the runner hostname regex to the client's naming convention during onboarding."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT)$/ nocase
    $net.network.http.user_agent = /(curl|wget|python-requests|python-urllib|go-http-client|powershell|node-fetch|axios)/ nocase
    $net.principal.hostname = /(runner|build|agent|pipeline|(^|[-_.])ci([-_.]|$)|jenkins|action)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_cloud_principals
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1677")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
