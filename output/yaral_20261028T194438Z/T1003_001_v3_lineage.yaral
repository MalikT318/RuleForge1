/*
  MITRE Technique : T1003.001 - LSASS Memory
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:37:44.185887+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_001_Unexpected_Parent_Spawns_LSASS_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects an Office application, web server, database service, or print spooler spawning a shell, script interpreter, or rundll32 whose command line targets LSASS or the comsvcs MiniDump mechanism. These parents should never legitimately start a process that touches LSASS memory, so the lineage anomaly strongly suggests exploitation (webshell, malicious macro, service compromise) followed by credential dumping."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.001"
    mitre_technique_name = "OS Credential Dumping: LSASS Memory"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with populated parent process path, child process path, and command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Database maintenance jobs or agents launched by the database service that inspect running processes; IIS or application-pool health scripts that enumerate processes including lsass; EDR or backup agents spawned from an unusual parent; admin troubleshooting through a web-based management console."
    tuning_guidance = "Add approved parent binaries to %global_allowed_security_tools, %global_allowed_backup_processes, or %global_allowed_admin_tools. Add known-good automation accounts to %global_allowed_service_accounts or named administrators to %global_allowed_admin_users. Extend the parent regex with client-specific line-of-business server processes if needed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|onenote|visio|mspub|w3wp|httpd|nginx|tomcat\d*|php-cgi|sqlservr|mysqld|postgres|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|wmic|regsvr32)\.exe$/ nocase
    $proc.target.process.command_line = /(lsass|comsvcs|minidump)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1003.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
