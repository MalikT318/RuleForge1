/*
  MITRE Technique : T1542.001 - System Firmware
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:42:43.253374+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_001_Outbound_TFTP_Firmware_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a perimeter-observed TFTP connection (port 69) from an internal source to an external destination. Network devices commonly fetch or push firmware, ROMMON and boot images over TFTP, which has no authentication or encryption. Outbound TFTP to the internet is rarely legitimate and is consistent with staging a tampered firmware image on a network device (T1542.001)."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.001"
    mitre_technique_name = "Pre-OS Boot: System Firmware"
    log_prerequisites = "Firewall, proxy or perimeter connection logs that populate principal.ip, target.ip and target.port, ingested as NETWORK_CONNECTION. Logging of permitted and denied traffic on the egress interface is recommended."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Approved firmware or configuration backups to a vendor or managed-service TFTP server, legacy PXE or provisioning workflows crossing the perimeter, lab or staging devices, and authorised vendor support sessions."
    tuning_guidance = "Add approved management or provisioning source addresses to %global_allowed_mgmt_sources. Confirm %rfc1918_internal covers the client's internal address space. For clients that legitimately use external TFTP, scope an exception by source device through %global_allowed_mgmt_sources instead of disabling the rule."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1542.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
