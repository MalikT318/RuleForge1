/*
  MITRE Technique : T1684 - Social Engineering
  Tactic(s)       : Stealth
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:29:42.134850+00:00
  Reference       : https://attack.mitre.org/techniques/T1684
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1684_Admin_Initiated_Password_Reset_HelpDesk_SE {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a directory-level password reset or change performed by one identity on a different user account. This is the state change that results when an attacker socially engineers a help desk or administrator into resetting a victim's credentials. The rule fires on the resulting identity-store change, so it does not depend on endpoint command-line logging. Resets by approved admins and service accounts are excluded."
    mitre_tactic = "Stealth"
    mitre_technique = "T1684"
    mitre_technique_name = "Social Engineering"
    log_prerequisites = "Requires identity provider or Active Directory directory audit logs (for example Windows Security events 4724/4723 or equivalent IdP audit events) normalised to USER_CHANGE_PASSWORD, with both principal.user.userid (actor) and target.user.userid (subject) populated."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Legitimate help desk password resets, onboarding and offboarding workflows, identity governance or self-service reset tooling that acts through a delegated account, and scheduled credential rotation by admins not yet allow-listed."
    tuning_guidance = "Add help desk and IAM administrator accounts to %global_allowed_admin_users and automation or identity-governance accounts to %global_allowed_service_accounts. Review the first week of alerts per client to baseline normal help desk volume. Consider raising severity when the target is a privileged user or the reset is followed by an MFA change."

  events:
    $auth.metadata.event_type = "USER_CHANGE_PASSWORD"
    $auth.principal.user.userid != ""
    $auth.target.user.userid != ""
    $auth.principal.user.userid != $auth.target.user.userid
    not $auth.target.user.userid = /\$$/
    not $auth.principal.user.userid in %global_allowed_admin_users
    not $auth.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1684")
    $primary_entity = array_distinct($auth.target.user.userid)
    $acting_user = array_distinct($auth.principal.user.userid)
    $source_ips = array_distinct($auth.principal.ip)

  condition:
    $auth
}
