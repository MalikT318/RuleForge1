/*
  MITRE Technique : T1053.006 - Systemd Timers
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:17:46.250499+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_006_Systemd_Timer_And_Service_Unit_Dropped {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a matching pair of systemd .service and .timer unit files written to a systemd unit directory on the same host within one hour. The .service file is written first and the .timer file with the same unit name follows, which is the sequence needed to establish scheduled persistence. The rule uses file-creation telemetry only, so it adds coverage beyond systemctl command-line detections."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.006"
    mitre_technique_name = "Scheduled Task/Job: Systemd Timers"
    log_prerequisites = "Requires Linux EDR file-creation telemetry or auditd file-write watches on /etc/systemd, /usr/lib/systemd, /lib/systemd, /run/systemd and ~/.config/systemd, normalised to UDM FILE_CREATION with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers installing software that ships timers (apt, dpkg, rpm, dnf, yum, zypper, pacman, snap); configuration management agents (Ansible, Puppet, Chef, Salt) deploying units; administrators creating legitimate maintenance timers; container or image build pipelines."
    tuning_guidance = "Add approved deployment and configuration-management binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. If the EDR logs unit writes as FILE_MODIFICATION rather than FILE_CREATION, clone the rule for that event type. Add further package-manager executable names to the regex exclusion if your fleet uses others."

  events:
    $svc.metadata.event_type = "FILE_CREATION"
    $svc.target.file.full_path = /^(\/etc\/systemd\/(system|user)\/|\/usr\/lib\/systemd\/(system|user)\/|\/lib\/systemd\/(system|user)\/|\/run\/systemd\/(system|transient)\/|\/home\/[^\/]+\/\.config\/systemd\/user\/|\/root\/\.config\/systemd\/user\/).+\.service$/
    $unit = re.capture($svc.target.file.full_path, "([^/]+)\\.service$")
    $svc.principal.hostname = $hostname
    not $svc.principal.process.file.full_path in %global_allowed_admin_tools
    not $svc.principal.user.userid in %global_allowed_service_accounts
    not $svc.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|dnf|yum|zypper|pacman|snapd|packagekitd|unattended-upgrade)$/

    $timer.metadata.event_type = "FILE_CREATION"
    $timer.target.file.full_path = /^(\/etc\/systemd\/(system|user)\/|\/usr\/lib\/systemd\/(system|user)\/|\/lib\/systemd\/(system|user)\/|\/run\/systemd\/(system|transient)\/|\/home\/[^\/]+\/\.config\/systemd\/user\/|\/root\/\.config\/systemd\/user\/).+\.timer$/
    $unit = re.capture($timer.target.file.full_path, "([^/]+)\\.timer$")
    $timer.principal.hostname = $hostname
    not $timer.principal.process.file.full_path in %global_allowed_admin_tools
    not $timer.principal.user.userid in %global_allowed_service_accounts
    not $timer.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|dnf|yum|zypper|pacman|snapd|packagekitd|unattended-upgrade)$/

    $svc.metadata.event_timestamp.seconds <= $timer.metadata.event_timestamp.seconds

  match:
    $hostname, $unit over 1h

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1053.006")
    $primary_entity = array_distinct($hostname)
    $unit_name = array_distinct($unit)
    $timer_paths = array_distinct($timer.target.file.full_path)
    $service_paths = array_distinct($svc.target.file.full_path)
    $writer_processes = array_distinct($timer.principal.process.file.full_path)
    $writer_users = array_distinct($timer.principal.user.userid)
    $event_count = count($timer.metadata.id)

  condition:
    $svc and $timer
}
