/*
  MITRE Technique : T1578.001 - Create Snapshot
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:50:51.798024+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_001_Snapshot_Created_Then_Shared_Or_Accessed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A single cloud identity creates a disk or volume snapshot and then, within 10 minutes, shares it, changes its permissions, or requests access to its contents. This pattern is used to copy data out of an environment or to mount the copy on an attacker-controlled instance, bypassing controls on the original compute resource."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578.001"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Create Snapshot"
    log_prerequisites = "Cloud control-plane audit logs ingested and normalised to UDM, with metadata.product_event_type, principal.user.userid and target.resource.name populated. Management or write-event logging must be enabled for the compute service."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Backup and disaster-recovery automation that snapshots and then shares to a recovery account or region. Cloud migration projects. Administrators cloning volumes for troubleshooting or forensics. Image-build pipelines. Scheduled lifecycle tooling running under a named identity."
    tuning_guidance = "Add automation and backup identities to %global_allowed_service_accounts and %global_allowed_cloud_principals. Add named administrators who legitimately share snapshots to %global_allowed_admin_users, and consider an exclusion for that list on both events. If the tenant uses other API names for snapshot creation or sharing, extend the product_event_type regexes. For high-noise tenants, lengthen the sequence requirement by tightening the share regex to cross-account or public sharing only."

  events:
    $snap.metadata.event_type = "RESOURCE_CREATION"
    $snap.metadata.product_event_type = /(CreateSnapshot|CreateSnapshots|snapshots\.insert|snapshots\/write|disks\.createSnapshot)/ nocase
    $snap.principal.user.userid = $user
    not $snap.principal.user.userid in %global_allowed_service_accounts
    not $snap.principal.user.userid in %global_allowed_cloud_principals

    $share.metadata.event_type = "RESOURCE_PERMISSIONS_CHANGE"
    $share.metadata.product_event_type = /(ModifySnapshotAttribute|ModifySnapshotTier|snapshots\.setIamPolicy|snapshots\/beginGetAccess|snapshots\/grantAccess|snapshots\/write)/ nocase
    $share.principal.user.userid = $user
    not $share.principal.user.userid in %global_allowed_service_accounts
    not $share.principal.user.userid in %global_allowed_cloud_principals

    $snap.metadata.event_timestamp.seconds <= $share.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1578.001")
    $primary_entity = array_distinct($snap.principal.user.userid)
    $snapshot_resources = array_distinct($snap.target.resource.name)
    $shared_resources = array_distinct($share.target.resource.name)
    $source_ips = array_distinct($snap.principal.ip)
    $snapshot_api_calls = array_distinct($snap.metadata.product_event_type)
    $share_api_calls = array_distinct($share.metadata.product_event_type)
    $first_snapshot_time = min($snap.metadata.event_timestamp.seconds)

  condition:
    $snap and $share
}
