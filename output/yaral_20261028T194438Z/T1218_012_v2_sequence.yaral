/*
  MITRE Technique : T1218.012 - Verclsid
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:57:51.348190+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_012_Verclsid_UserCLSID_Registration_Then_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a per-user COM CLSID registration (InprocServer32, LocalServer32, TreatAs or ScriptletURL under the user's Software\\Classes\\CLSID hive) followed within 10 minutes by verclsid.exe opening a network connection to an external address on the same host. verclsid.exe normally makes no outbound connections, so this pairing indicates a hijacked or rogue COM object being loaded through verclsid.exe, for example a remote scriptlet. The rule does not depend on command-line matching."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.012"
    mitre_technique_name = "System Binary Proxy Execution: Verclsid"
    log_prerequisites = "Requires EDR or Sysmon registry modification telemetry (HKCU/HKU hive writes) and process-attributed network connection telemetry (Sysmon Event ID 13 and 3, or EDR equivalent)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Applications that register per-user COM servers and then trigger a shell extension verification that reaches a network location (rare), for example some cloud-storage clients, shell-extension installers, or Office add-in deployments. Admin tooling that registers COM classes in user hives."
    tuning_guidance = "Add approved installer, packaging and deployment tooling to %global_allowed_admin_tools (matched on the registry-writing process path). Add known-good external destinations to %global_allowed_domains. Where the EDR emits REGISTRY_CREATION rather than REGISTRY_MODIFICATION for new CLSID keys, clone the rule with that event type for the registry side."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /^(HKU\\[^\\]+|HKEY_USERS\\[^\\]+|HKCU|HKEY_CURRENT_USER)\\Software\\Classes\\CLSID\\\{[0-9a-f\-]{36}\}\\(InprocServer32|LocalServer32|TreatAs|ScriptletURL)/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    $reg.principal.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\verclsid\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    $net.principal.hostname = $hostname

    $reg.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1218.012")
    $primary_entity = array_distinct($net.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_writers = array_distinct($reg.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $affected_users = array_distinct($reg.principal.user.userid)
    $network_event_count = count($net.metadata.id)

  condition:
    $reg and $net
}
