/*
  MITRE Technique : T1071.002 - File Transfer Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:05:42.679464+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_002_Linux_FTP_Client_Staging_File_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a file-transfer protocol client (FTP, TFTP, SMB family) writing a file into a world-writable staging directory (/tmp, /var/tmp, /dev/shm). The rule pivots on the resulting file artifact rather than on command-line arguments, so it still fires when command-line logging is evaded or arguments are obfuscated. Adversaries commonly use these protocols to pull tooling or tasking from attacker-controlled servers, and the downloaded file lands in a writable staging path."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.002"
    mitre_technique_name = "Application Layer Protocol: File Transfer Protocols"
    log_prerequisites = "Requires Linux EDR or auditd file telemetry that populates the writing process path (principal.process.file.full_path) and the created file path (target.file.full_path) for FILE_CREATION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators or automation staging patches, firmware, or configuration files through FTP/TFTP (for example network device firmware or PXE provisioning), backup or ETL jobs that use lftp or smbclient with /tmp as scratch space, and install scripts that fetch packages over FTP."
    tuning_guidance = "Add legitimate service accounts to %global_allowed_service_accounts and approved deployment or provisioning tooling to %global_allowed_admin_tools. If a particular host class legitimately stages files in /tmp (for example a provisioning server), exclude those hosts with a hostname exclusion or raise the severity only for non-server assets."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(ftp|tftp|lftp|pftp|ncftp|ncftpget|smbclient)$/ nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1071.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $staged_files = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
