/*
  MITRE Technique : T1496.003 - SMS Pumping
  Tactic(s)       : Impact
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:55:49.890274+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_003_SMS_Spend_Limit_Or_Geo_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change to messaging or SMS delivery settings, such as spend limits, quotas, sandbox or verification restrictions, or destination country and region permissions. SMS pumping actors with control-plane access raise these limits or widen geographic reach so that abusing OTP or verification flows costs the victim more and pays the actor more. This rule detects the state change in the control plane, not the OTP request traffic."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.003"
    mitre_technique_name = "Resource Hijacking: SMS Pumping"
    log_prerequisites = "Cloud control-plane audit logs ingested and normalised to UDM SETTING_MODIFICATION events with metadata.product_event_type populated with the API or operation name and principal.user.userid populated."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Planned increases to SMS spend limits or quotas for marketing campaigns or seasonal OTP volume, onboarding of a new customer region, moving out of an SMS sandbox, infrastructure-as-code pipelines applying messaging settings, and routine admin reconfiguration."
    tuning_guidance = "Add IaC and deployment identities to %global_allowed_service_accounts, and named change owners to %global_allowed_admin_users. Add automation roles to %global_allowed_cloud_principals. Tighten the product_event_type regex if the client's messaging services use different operation names. Pair with a change-management ticket check in the SOAR playbook."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(setsmsattributes|sms.*(spend|limit|quota|sandbox|geo|country|region|origination)|(spend|limit|quota|geo|country|region).*sms|(text.?messag|messaging).*(spend|limit|quota|geo|country|region))/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1496.003")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $operation = array_distinct($setting.metadata.product_event_type)
    $source_ips = array_distinct($setting.principal.ip)
    $target_resources = array_distinct($setting.target.resource.name)

  condition:
    $setting
}
