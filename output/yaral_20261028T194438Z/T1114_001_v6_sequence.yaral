/*
  MITRE Technique : T1114.001 - Local Email Collection
  Tactic(s)       : Collection
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:18:54.107072+00:00
  Reference       : https://attack.mitre.org/techniques/T1114/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_001_Mail_Data_File_Staging_Then_External_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A non-Outlook process copies, moves or archives Outlook data files (.pst/.ost) via its command line, and within 10 minutes a shell, script host or transfer LOLBin on the same host makes an external network connection. This pattern indicates local email collection followed by possible exfiltration."
    mitre_tactic = "Collection"
    mitre_technique = "T1114.001"
    mitre_technique_name = "Email Collection: Local Email Collection"
    log_prerequisites = "Requires EDR or Sysmon process launch telemetry with command lines, plus network connection telemetry that includes the initiating process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Approved mailbox migration or archiving scripts, IT staff moving a user's PST to a new profile, backup or imaging tasks that copy mail files, and eDiscovery collection by authorised administrators, if these also make external connections within 10 minutes."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes, migration and admin tooling to %global_allowed_admin_tools, and approved remote support tooling to %global_allowed_remote_mgmt. Add accounts that legitimately handle mail files to %global_allowed_admin_users."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /\.(pst|ost)\b/ nocase
    $proc.target.process.command_line = /(\bcopy\b|\bxcopy\b|\brobocopy\b|copy-item|move-item|\bmove\b|compress-archive|\bmakecab\b|\btar\b|\bexpand\b|\bcompact\b|\bzip\b|\barchive\b)/ nocase
    not $proc.principal.process.file.full_path = /\\outlook\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users
    $proc.principal.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(powershell|pwsh|cmd|curl|bitsadmin|certutil|ftp|wscript|cscript|mshta)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    $net.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1114.001")
    $primary_entity = array_distinct($hostname)
    $staging_commands = array_distinct($proc.target.process.command_line)
    $staging_users = array_distinct($proc.principal.user.userid)
    $transfer_processes = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $connection_count = count($net.metadata.id)

  condition:
    $proc and $net
}
