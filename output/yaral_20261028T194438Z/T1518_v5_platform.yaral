/*
  MITRE Technique : T1518 - Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:37:03.861375+00:00
  Reference       : https://attack.mitre.org/techniques/T1518
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_ESXi_Software_Inventory_Via_Esxcli {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects enumeration of installed software on an ESXi host from the shell by running esxcli or localcli software namespace list/get commands (VIBs, image profiles, components, base images, add-ons). Attackers use this to find installed security agents, drivers and vulnerable component versions before tailoring follow-on actions such as ransomware deployment."
    mitre_tactic = "Discovery"
    mitre_technique = "T1518"
    mitre_technique_name = "Software Discovery"
    log_prerequisites = "ESXi shell command auditing forwarded to Chronicle and parsed into PROCESS_LAUNCH events with target.process.command_line populated (shell.log or auth/syslog forwarding, with the hypervisor parser applied)."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Lifecycle and patch-compliance tooling, host profile or image compliance checks, administrators verifying VIB versions before or after patching, and vendor support collecting diagnostics."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users, automation accounts to %global_allowed_service_accounts, and patching or compliance tooling parent processes to %global_allowed_admin_tools. If the environment has frequent legitimate use, raise to alert only when combined with SSH enablement or an unusual source login."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /\b(esxcli|localcli)\b.*\bsoftware\s+(vib|profile|component|baseimage|addon)\s+(list|get)\b/ nocase
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1518")
    $primary_entity = array_distinct($proc.principal.hostname)
    $actor_user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
