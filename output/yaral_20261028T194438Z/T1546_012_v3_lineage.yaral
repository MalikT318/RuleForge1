/*
  MITRE Technique : T1546.012 - Image File Execution Options Injection
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:16:58.418576+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_012_IFEO_Registry_Write_Unexpected_Process_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry write to an Image File Execution Options or SilentProcessExit key (Debugger, GlobalFlag, MonitorProcess, VerifierDlls) where the writing process, or its parent, is one that should never configure IFEO. This covers Office applications, web server workers, the print spooler, database services, and script hosts. It pivots on process lineage rather than command-line content, so it also catches API-based writes that bypass reg.exe and gflags.exe."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.012"
    mitre_technique_name = "Event Triggered Execution: Image File Execution Options Injection"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR registry events or Sysmon Event ID 12/13/14) populating the writing process and, ideally, its parent process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developers or support staff configuring just-in-time debuggers or Application Verifier through a script host. Software installers that register a debugger replacement (for example a Task Manager replacement) through a scripted installer. Crash-dump and diagnostics tooling that sets GlobalFlag or SilentProcessExit values. Database or web application diagnostics that enable heap or page-heap flags."
    tuning_guidance = "Add approved debugging, deployment and diagnostics tooling to %global_allowed_admin_tools. Add EDR and AV agents that touch IFEO keys to %global_allowed_security_tools. If a script host is legitimately used for IFEO changes in a client environment, add it to %global_allowed_admin_tools rather than loosening the regexes."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(Image File Execution Options|SilentProcessExit)\\/ nocase
    $reg.target.registry.registry_value_name = /^(Debugger|GlobalFlag|MonitorProcess|ReportingMode|VerifierDlls)$/ nocase
    (
      $reg.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|onenote|visio|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|spoolsv|sqlservr|mysqld|oracle|postgres|mshta|wscript|cscript|cmd|powershell|pwsh)\.exe$/ nocase or
      $reg.principal.process.parent_process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|onenote|visio|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|spoolsv|sqlservr|mysqld|oracle|postgres|mshta|wscript|cscript)\.exe$/ nocase
    )
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1546.012")
    $primary_entity = array_distinct($reg.principal.hostname)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $writer_parent_process = array_distinct($reg.principal.process.parent_process.file.full_path)
    $ifeo_key = array_distinct($reg.target.registry.registry_key)
    $ifeo_value_name = array_distinct($reg.target.registry.registry_value_name)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
