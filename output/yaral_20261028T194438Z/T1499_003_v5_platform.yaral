/*
  MITRE Technique : T1499.003 - Application Exhaustion Flood
  Tactic(s)       : Impact
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:21:23.986614+00:00
  Reference       : https://attack.mitre.org/techniques/T1499/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1499_003_Linux_AppServer_Crash_Dump_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a core dump or crash report for a network-facing application server (web server, application runtime, reverse proxy) on Linux. Application-layer exhaustion floods that hit resource-intensive features can crash or OOM-kill the service, and the crash artefact in the systemd-coredump, apport or /var/crash directories is the host-side result of that DoS. This is not a command-line rule; it detects the effect of the attack on the application."
    mitre_tactic = "Impact"
    mitre_technique = "T1499.003"
    mitre_technique_name = "Endpoint Denial of Service: Application Exhaustion Flood"
    log_prerequisites = "Linux EDR or auditd file-creation telemetry covering /var/lib/systemd/coredump, /var/crash and /var/lib/apport/coredump. Core dump handling (systemd-coredump or apport) must be enabled on the host."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Application bugs or bad deployments that crash the service, developers and QA hosts that crash services deliberately, load or stress testing, memory-limit misconfiguration (cgroup or ulimit OOM kills), and admins capturing dumps with debugging tools."
    tuning_guidance = "Add debugging and diagnostic tooling that legitimately writes dumps to %global_allowed_admin_tools. Correlate alerts with web access logs or load balancer metrics for request spikes before escalating. Extend the process-name alternation for client-specific application servers. For noisy dev or test fleets, scope the rule to production host groups at deployment time."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/var\/(lib\/systemd\/coredump|crash|lib\/apport\/coredump)\/.*(^|[._\/-])(nginx|apache2|httpd|php-fpm[0-9.]*|php[0-9.]+-fpm|tomcat[0-9]*|gunicorn|uwsgi|haproxy|node|java|envoy)([._-]|$)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1499.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $crash_artifact = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
