/*
  MITRE Technique : T1127.002 - ClickOnce
  Tactic(s)       : Stealth, Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:39:09.974495+00:00
  Reference       : https://attack.mitre.org/techniques/T1127/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1127_002_ClickOnce_Dfsvc_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects the ClickOnce deployment service (dfsvc.exe) opening an outbound network connection to a non-internal destination. dfsvc.exe retrieves .application and deployment manifests and application payloads from web or file-share locations, so an external connection from it indicates ClickOnce delivery of remote code. This is network-side coverage that complements process-creation rules."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1127.002"
    mitre_technique_name = "Trusted Developer Utilities Proxy Execution: ClickOnce"
    log_prerequisites = "Requires endpoint network telemetry (EDR or Sysmon Event ID 3) that populates the initiating process path for outbound connections."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate line-of-business ClickOnce applications hosted externally (SaaS vendors, internal apps published through a CDN or cloud storage), vendor updaters that use ClickOnce, and developer testing of ClickOnce deployments."
    tuning_guidance = "Add the domains of approved ClickOnce publishers to %global_allowed_domains. Add approved deployment or management tooling to %global_allowed_admin_tools. Where hosts are known to run approved ClickOnce apps, review the destination_hosts outcome to build the allowlist before widening exclusions."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\dfsvc\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.parent_process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1127.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ports = array_distinct($net.target.port)
    $affected_users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
