/*
  MITRE Technique : T1134.003 - Make and Impersonate Token
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:58:39.744938+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_003_Repeated_NewCredentials_Logon_Token_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated NewCredentials (logon type 9) sessions on a single host within 10 minutes. This logon type is produced when LogonUser is called with LOGON32_LOGON_NEW_CREDENTIALS, or by runas /netonly, to create a new token carrying alternate credentials. One such event is common admin behaviour, but a burst on one host suggests an adversary creating and impersonating tokens with harvested credentials."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.003"
    mitre_technique_name = "Access Token Manipulation: Make and Impersonate Token"
    log_prerequisites = "Requires Windows Security event 4624 (logon type 9) normalised to USER_LOGIN with extensions.auth.mechanism populated, from an EDR or the Windows Security log."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators using runas /netonly or similar tools for remote administration, IT automation and RMM agents that authenticate with alternate credentials, SQL or backup tooling that uses alternate credentials for network access, and scripted deployment jobs."
    tuning_guidance = "Add approved service accounts to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Add approved administrative tooling to %global_allowed_admin_tools. Raise the #auth threshold on hosts used by administrators, such as jump servers. Lower the threshold or raise severity for servers that are not admin workstations."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.extensions.auth.mechanism = "NEW_CREDENTIALS"
    $auth.target.hostname = $host
    not $auth.target.user.userid = /\$$/
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.principal.process.file.full_path in %global_allowed_admin_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($auth.metadata.id)
    $mitre_technique_id = array_distinct("T1134.003")
    $primary_entity = array_distinct($host)
    $target_users = array_distinct($auth.target.user.userid)
    $source_processes = array_distinct($auth.principal.process.file.full_path)

  condition:
    #auth >= 5
}
