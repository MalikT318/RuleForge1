/*
  MITRE Technique : T1211 - Exploitation for Stealth
  Tactic(s)       : Stealth
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:19:32.657861+00:00
  Reference       : https://attack.mitre.org/techniques/T1211
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1211_IaaS_Audit_Logging_Tampering_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single cloud identity performs several logging, audit-trail, flow-log, log-sink or threat-detector disable, delete or suspend operations within ten minutes. One such change can be routine maintenance. A burst from one principal matches an adversary blinding cloud telemetry, including after exploiting a flaw in a control-plane service to evade audit trails."
    mitre_tactic = "Stealth"
    mitre_technique = "T1211"
    mitre_technique_name = "Exploitation for Stealth"
    log_prerequisites = "Cloud control-plane audit logs ingested and normalised to UDM with metadata.product_event_type (API action name) and principal.user.userid populated. Management/administrative write events must be enabled."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Infrastructure-as-code pipelines re-provisioning logging configuration, planned log-pipeline migrations or retention changes, account decommissioning, cloud landing-zone automation, and security engineering rotating log sinks."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, approved platform or IaC principals to %global_allowed_cloud_principals, and named cloud administrators to %global_allowed_admin_users. Raise the #cloud threshold for tenants with heavy IaC churn. Lower it to 2 for high-sensitivity accounts."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /(stop|delete|disable|suspend|remove|detach).*(trail|logging|log_?sink|sink|flow_?log|diagnostic|audit_?config|detector|log_?group|retention)/ nocase
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(75)
    $event_count = count($cloud.metadata.id)
    $actions = array_distinct($cloud.metadata.product_event_type)
    $affected_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)
    $mitre_technique_id = array_distinct("T1211")
    $primary_entity = array_distinct($user)

  condition:
    #cloud >= 3
}
