/*
  MITRE Technique : T1496.003 - SMS Pumping
  Tactic(s)       : Impact
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:56:59.468967+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_003_SMS_Pumping_Volume_Per_Identity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a single identity invoking SMS or text-message send APIs an abnormal number of times within 10 minutes. Each call is benign on its own, but sustained volume from one caller is consistent with SMS pumping abuse of OTP or verification flows."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.003"
    mitre_technique_name = "Resource Hijacking: SMS Pumping"
    log_prerequisites = "Cloud control-plane or data-plane audit logs that record messaging API calls (SMS, text message, OTP or verification sends) and populate metadata.product_event_type and principal.user.userid."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate bulk notification or marketing campaigns, MFA enrolment drives or password-reset waves after an incident, load and integration testing of messaging workflows, and batch alerting jobs running under a service identity."
    tuning_guidance = "Add approved bulk-messaging identities to %global_allowed_cloud_principals and named administrators to %global_allowed_admin_users. Raise or lower the #cloud threshold per client based on baseline OTP volume. Do not allowlist the identity behind a public sign-up or verification form without first confirming its normal volume."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /(sms|text_?message|send_?otp|send_?verification|send_?voice)/ nocase
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1496.003")
    $primary_entity = array_distinct($user)
    $event_count = count($cloud.metadata.id)
    $api_calls = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)
    $targets = array_distinct($cloud.target.resource.name)

  condition:
    #cloud >= 50
}
