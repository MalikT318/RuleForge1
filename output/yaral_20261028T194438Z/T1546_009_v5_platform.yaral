/*
  MITRE Technique : T1546.009 - AppCert DLLs
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:12:24.577610+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_009_AppCertDLLs_Registry_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a value being written under the Session Manager AppCertDLLs registry key. DLLs listed there are loaded into every process that calls CreateProcess-family APIs, which gives an attacker persistence and privilege escalation. AppCertDLLs is a Windows-only mechanism with no Linux, macOS or cloud equivalent, so this rule uses registry telemetry on Windows instead of a process command-line match."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.009"
    mitre_technique_name = "Event Triggered Execution: AppCert DLLs"
    log_prerequisites = "Requires EDR or Sysmon registry-value-set telemetry (Sysmon Event ID 13 or equivalent) normalised to REGISTRY_MODIFICATION, with the registry key path and the writing process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare. Legitimate sources are third-party application-control or endpoint security products that register a certification DLL, and software installers or deployment tooling that does the same."
    tuning_guidance = "Add approved installer or deployment binaries to %global_allowed_admin_tools and security agents to %global_allowed_security_tools. The key is almost never used legitimately, so keep exclusions narrow. Also confirm that the sensor logs registry writes under HKLM\\System\\CurrentControlSet\\Control\\Session Manager, including the ControlSet001 alias."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control\\Session Manager\\AppCertDLLs/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1546.009")
    $primary_entity = array_distinct($reg.principal.hostname)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $writer_user = array_distinct($reg.principal.user.userid)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $registry_value_data = array_distinct($reg.target.registry.registry_value_data)

  condition:
    $reg
}
