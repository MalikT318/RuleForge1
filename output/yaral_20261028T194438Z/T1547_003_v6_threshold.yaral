/*
  MITRE Technique : T1547.003 - Time Providers
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:28:00.910150+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_003_TimeProvider_Registry_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Multiple modifications to W32Time time provider registration values (DllName, Enabled, InputProvider) under Services\\W32Time\\TimeProviders on a single host within ten minutes. A single change can be routine time configuration, but repeated changes to provider DLL registration values suggest persistence through a malicious time provider DLL."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.003"
    mitre_technique_name = "Boot or Logon Autostart Execution: Time Providers"
    log_prerequisites = "Requires Windows endpoint registry modification telemetry (EDR or Sysmon Event ID 12/13/14) normalised to UDM REGISTRY_MODIFICATION with target.registry.registry_key and registry_value_name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Domain time hierarchy reconfiguration by admins or GPO, third-party NTP or time-sync agents (hardware clock or PTP software) registering their own provider, Windows servicing and feature upgrades, and imaging or golden-image build scripts."
    tuning_guidance = "Add approved time-sync and deployment tooling to %global_allowed_admin_tools and security agents to %global_allowed_security_tools. Raise the threshold above 3 if GPO-driven reconfiguration is noisy. Any DllName change should be reviewed by validating the referenced DLL path and signature."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\services\\w32time\\timeproviders\\/ nocase
    $reg.target.registry.registry_value_name = /^(DllName|Enabled|InputProvider)$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($reg.target.registry.registry_value_name = /^DllName$/ nocase, 90, 70))
    $event_count = count($reg.metadata.id)
    $mitre_technique_id = array_distinct("T1547.003")
    $primary_entity = array_distinct($host)
    $modified_keys = array_distinct($reg.target.registry.registry_key)
    $modified_values = array_distinct($reg.target.registry.registry_value_name)
    $modifying_processes = array_distinct($reg.principal.process.file.full_path)
    $acting_users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 3
}
