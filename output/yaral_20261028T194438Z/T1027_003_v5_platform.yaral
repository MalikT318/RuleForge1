/*
  MITRE Technique : T1027.003 - Steganography
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:42:26.198570+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_003_Linux_Media_File_Staged_In_Volatile_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of an image or audio file in a volatile staging location on Linux (any media file in /dev/shm, or a hidden dot-prefixed media file in /tmp or /var/tmp) by a shell, script interpreter, or network transfer utility. Media files carrying hidden payloads (steganography) are typically fetched or written by scripts and parked in memory-backed or world-writable directories before a later extraction step. Media files are almost never legitimately created in these locations by such processes."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.003"
    mitre_technique_name = "Obfuscated Files or Information: Steganography"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-write events (FILE_CREATION) with populated principal process path and target file path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Desktop thumbnailers or screenshot tools writing to /tmp, browser or package-manager temp downloads, CI/build jobs generating test images, web application image-processing scripts, and admin scripts that stage media in /dev/shm."
    tuning_guidance = "Add approved interpreters, build agents, or script parents to %global_allowed_script_hosts, and approved deployment or IT tooling to %global_allowed_admin_tools. Trusted accounts can be suppressed with %global_allowed_service_accounts. If /dev/shm use is common on a client, restrict the regex to the hidden-file branch."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(dev\/shm\/(.*\/)?[^\/]+|(tmp|var\/tmp)\/(.*\/)?\.[^\/]+)\.(png|jpe?g|bmp|gif|ico|webp|tiff?|wav|mp3|ogg|flac)$/ nocase
    $file.principal.process.file.full_path = /\/(curl|wget|python[0-9.]*|perl|ruby|php|node|bash|sh|dash|zsh|nc|ncat|socat)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1027.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $media_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
