/*
  MITRE Technique : T1578.001 - Create Snapshot
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:49:52.604163+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_001_Cloud_Snapshot_Created_By_Unapproved_Principal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation or copying of a compute disk/volume or database snapshot through the cloud control plane by a principal that is not an approved service account, automation principal or administrator. Adversaries snapshot a victim volume so they can mount it on an instance they control and read data or evade restrictions on the original workload. Matches the API operation names for snapshot creation across AWS, Azure and GCP audit logs."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578.001"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Create Snapshot"
    log_prerequisites = "Cloud control-plane audit logging enabled and ingested with management/admin write events (AWS CloudTrail management events, Azure Activity Log, GCP Admin Activity audit logs). Events must be normalised to RESOURCE_CREATION with metadata.product_event_type populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Backup and disaster-recovery tooling not yet in the allowlists, lifecycle or snapshot-scheduling automation, administrators taking pre-change snapshots before patching or migrations, CI/CD pipelines building machine images, and cross-region copy jobs for DR."
    tuning_guidance = "Add automation and backup identities to %global_allowed_service_accounts, approved IaC and workload identities to %global_allowed_cloud_principals, and named administrators to %global_allowed_admin_users. Raise severity or add a follow-on correlation (snapshot shared, copied cross-account, or new instance created) for high-value accounts. Review principals that appear for the first time."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /(CreateSnapshots?|CopySnapshot|CreateDBSnapshot|CreateDBClusterSnapshot|snapshots\.insert|disks\.createSnapshot|snapshots\/write)/ nocase
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1578.001")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_operation = array_distinct($cloud.metadata.product_event_type)
    $snapshot_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
