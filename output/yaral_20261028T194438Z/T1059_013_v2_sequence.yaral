/*
  MITRE Technique : T1059.013 - Container CLI/API
  Tactic(s)       : Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:25:47.187469+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_013_Container_Create_Then_Exec_Same_Identity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects one identity creating a workload (pod/container) through the orchestration control-plane API and then opening an exec or attach session into a workload within five minutes. This create-then-run-commands pattern is how adversaries abuse the container API or CLI to execute commands. It complements process command-line detections by using API audit telemetry."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.013"
    mitre_technique_name = "Command and Scripting Interpreter: Container CLI/API"
    log_prerequisites = "Requires Kubernetes or container orchestration control-plane audit logs ingested through the cloud audit pipeline, with request-level audit for pod create and pods/exec or pods/attach subresources, and a populated principal.user.userid."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Developers and CI/CD pipelines that deploy a debug pod and then exec into it, break-glass troubleshooting by SRE staff, GitOps or deployment controllers that run post-deploy checks, and interactive debug tooling that creates ephemeral pods."
    tuning_guidance = "Add automation and CI identities to %global_allowed_service_accounts, trusted cloud or identity principals to %global_allowed_cloud_principals, and named platform administrators to %global_allowed_admin_users. If it is still noisy, scope to production clusters through the ingestion label or namespace after confirming the field is populated in the tenant."

  events:
    $create.metadata.event_type = "RESOURCE_CREATION"
    $create.metadata.product_event_type = /\.pods\.create$/ nocase
    $create.principal.user.userid != ""
    $create.principal.user.userid = $user
    not $create.principal.user.userid in %global_allowed_service_accounts
    not $create.principal.user.userid in %global_allowed_cloud_principals
    not $create.principal.user.userid in %global_allowed_admin_users

    $exec.metadata.event_type = "USER_RESOURCE_ACCESS"
    $exec.metadata.product_event_type = /\.pods\.(exec|attach)\.create$/ nocase
    $exec.principal.user.userid != ""
    $exec.principal.user.userid = $user
    not $exec.principal.user.userid in %global_allowed_service_accounts
    not $exec.principal.user.userid in %global_allowed_cloud_principals
    not $exec.principal.user.userid in %global_allowed_admin_users

    $create.metadata.event_timestamp.seconds <= $exec.metadata.event_timestamp.seconds

  match:
    $user over 5m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1059.013")
    $primary_entity = array_distinct($user)
    $created_resources = array_distinct($create.target.resource.name)
    $exec_targets = array_distinct($exec.target.resource.name)
    $source_ips = array_distinct($exec.principal.ip)
    $exec_event_count = count($exec.metadata.id)

  condition:
    $create and $exec
}
