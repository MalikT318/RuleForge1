/*
  MITRE Technique : T1027.007 - Dynamic API Resolution
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:48:54.501557+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_007_Staged_Runtime_Library_Load_Then_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A process running from a user-writable staging location (Temp, Downloads, Public, ProgramData, roaming profile) loads networking or crypto libraries at runtime, then makes an external network connection from the same process within 5 minutes. Malware that resolves its APIs dynamically (hashed exports, LoadLibrary/GetProcAddress, manual PEB walking) has no static import table. Its network and crypto capability therefore only appears as module-load events at runtime, followed by outbound traffic. This rule is module-load and network based and does not match command lines."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.007"
    mitre_technique_name = "Obfuscated Files or Information: Dynamic API Resolution"
    log_prerequisites = "Requires EDR or Sysmon module-load telemetry (image load, Sysmon Event ID 7) with the loaded module path in target.file.full_path, plus network connection telemetry (Sysmon Event ID 3 or EDR equivalent) with process PID populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Portable applications run from Downloads or Temp, software installers and updaters that download payloads, per-user deployment tools staged in ProgramData, game launchers, and developer-built binaries. Remote support tools run from the Downloads folder are also a source."
    tuning_guidance = "Add approved installers, RMM and deployment binaries to %global_allowed_admin_tools, EDR and AV agents to %global_allowed_security_tools, and approved remote support tools to %global_allowed_remote_mgmt. Trusted vendor domains can be excluded through %global_allowed_domains if the telemetry carries a hostname for the destination. Narrow or widen the staging-path regex per client."

  events:
    $mod.metadata.event_type = "PROCESS_MODULE_LOAD"
    $mod.principal.process.file.full_path = /(?i)(\\users\\[^\\]+\\(downloads|appdata\\roaming|appdata\\local\\temp|desktop)\\|\\windows\\temp\\|\\users\\public\\|\\programdata\\)/
    $mod.target.file.full_path = /(?i)\\(wininet|winhttp|ws2_32|dnsapi|crypt32|bcrypt|webio|mswsock)\.dll$/
    not $mod.principal.process.file.full_path in %global_allowed_admin_tools
    not $mod.principal.process.file.full_path in %global_allowed_security_tools
    not $mod.principal.process.file.full_path in %global_allowed_remote_mgmt
    $mod.principal.hostname = $hostname
    $mod.principal.process.pid = $pid

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /(?i)(\\users\\[^\\]+\\(downloads|appdata\\roaming|appdata\\local\\temp|desktop)\\|\\windows\\temp\\|\\users\\public\\|\\programdata\\)/
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    $net.principal.hostname = $hostname
    $net.principal.process.pid = $pid

    $mod.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $pid over 5m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1027.007")
    $primary_entity = array_distinct($hostname)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $loaded_modules = array_distinct($mod.target.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $module_load_count = count($mod.metadata.id)

  condition:
    $mod and $net
}
