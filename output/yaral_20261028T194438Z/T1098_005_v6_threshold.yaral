/*
  MITRE Technique : T1098.005 - Device Registration
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:48:12.631297+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_005_Device_Registration_Registry_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of registry modifications to Windows device registration and enrollment state (Entra ID join info, workplace join, MDM enrollments) on a single host within ten minutes. A single write is normal housekeeping. Repeated writes outside approved tooling suggest manual or scripted device registration to an adversary-controlled tenant or account."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.005"
    mitre_technique_name = "Account Manipulation: Device Registration"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry value-set events) that populates target.registry.registry_key and principal.hostname."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Autopilot or Intune enrollment of new devices, hybrid Entra join tasks on first boot or after a re-image, MDM re-enrollment, OS feature updates, and IT staff re-joining devices to the tenant."
    tuning_guidance = "Add approved enrollment and deployment tooling to %global_allowed_admin_tools and %global_allowed_remote_mgmt. Add provisioning and automation accounts to %global_allowed_service_accounts. Raise the #reg threshold in environments with frequent device provisioning. Suppress hosts during planned rollout windows."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(CloudDomainJoin\\JoinInfo|Microsoft\\Enrollments|WorkplaceJoin)(\\|$)/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($reg.target.registry.registry_key = /CloudDomainJoin\\JoinInfo/ nocase, 75, 60))
    $mitre_technique_id = array_distinct("T1098.005")
    $primary_entity = array_distinct($host)
    $event_count = count($reg.metadata.id)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $writing_processes = array_distinct($reg.principal.process.file.full_path)
    $users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 6
}
