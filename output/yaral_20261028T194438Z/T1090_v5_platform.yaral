/*
  MITRE Technique : T1090 - Proxy
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:25:50.833338+00:00
  Reference       : https://attack.mitre.org/techniques/T1090
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1090_Perimeter_Outbound_Proxy_Port_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host opening an outbound connection through the perimeter to an external destination on a TCP port conventionally used by SOCKS, HTTP-proxy and onion-routing relays (1080, 3128, 8118, 9050, 9150). Internal hosts normally reach the internet through the sanctioned egress path on 80/443, so a direct connection to an external proxy-service port suggests an adversary-controlled relay or multi-hop proxy chain used to hide C2 infrastructure."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1090"
    mitre_technique_name = "Proxy"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated for allowed (permitted) sessions."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Sanctioned corporate or cloud forward proxies reached on 3128 or 1080, VPN and secure-web-gateway agents that tunnel over proxy ports, privacy tooling used by security researchers, developer or CI hosts using external package proxies, and authorised penetration tests."
    tuning_guidance = "Add approved remote-management or gateway hosts to %global_allowed_remote_mgmt, and add known-good external proxy or vendor domains to %global_allowed_domains. If the client's firewall logs lack target.hostname, the domain exclusion is inert, so rely on the host exclusion. The port set can be trimmed per client, for example by dropping 3128 where an external proxy service is sanctioned."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 1080 or
      $net.target.port = 3128 or
      $net.target.port = 8118 or
      $net.target.port = 9050 or
      $net.target.port = 9150
    )
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_remote_mgmt
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1090")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
