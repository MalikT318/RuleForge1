/*
  MITRE Technique : T1558.003 - Kerberoasting
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:44:23.820397+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_003_Kerberos_KDC_Traffic_From_NonLsass_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network connection to the Kerberos service (TCP/UDP 88) initiated by a user-mode process other than LSASS. On Windows, native Kerberos ticket requests are made by lsass.exe through SSPI. Kerberoasting tooling that builds its own TGS-REQ messages (for example, to request RC4 service tickets for offline cracking) opens its own socket to the KDC from the tool's process. This is network-side coverage that does not depend on command-line content, tool names, or Event 4769 encryption-type fields."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.003"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Kerberoasting"
    log_prerequisites = "Requires endpoint network telemetry that attributes each connection to the initiating process (EDR or Sysmon Event ID 3), with target.port and principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Java or other JVM-based applications using their own GSS/Kerberos stack, MIT Kerberos for Windows clients, third-party SSO or password-sync agents, Linux-interop tools such as curl or Python with GSSAPI, vulnerability scanners and authorised red-team or AD health-check tooling, and RMM agents that talk Kerberos directly."
    tuning_guidance = "Add known-good Kerberos client binaries to %global_allowed_admin_tools or %global_allowed_security_tools, and authorised testing sources to %global_allowed_scanners. Internal address space is deliberately NOT excluded with %rfc1918_internal because domain controllers are internal, so excluding internal destinations would blind the rule. Scope noise down by process path, or by source host with %global_allowed_script_hosts, rather than by destination."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 88
    $net.principal.process.file.full_path = /\.exe$/ nocase
    not $net.principal.process.file.full_path = /\\lsass\.exe$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_scanners
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1558.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $kdc_ips = array_distinct($net.target.ip)
    $source_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
