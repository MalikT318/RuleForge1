/*
  MITRE Technique : T1553.005 - Mark-of-the-Web Bypass
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:06:37.981030+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_005_MOTW_Protection_Disabled_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry changes that disable Mark-of-the-Web handling: the Attachment Manager SaveZoneInformation policy (stops Zone.Identifier streams being written to downloaded files) or the Office Protected View 'Disable*InPV' settings (lets MOTW-tagged Office files open without Protected View). Detection is on the resulting registry state change, not the command line, so it still fires when the change is made through scripts, APIs or renamed tools."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.005"
    mitre_technique_name = "Subvert Trust Controls: Mark-of-the-Web Bypass"
    log_prerequisites = "Requires endpoint registry modification telemetry (EDR or Sysmon Event ID 13) covering HKCU and HKLM policy keys, normalised to UDM REGISTRY_MODIFICATION with registry_key and registry_value_name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy application that deliberately sets SaveZoneInformation or Protected View options; enterprise Office deployment and hardening tools (Office Customization Tool, Intune, SCCM); admins who relax Protected View for line-of-business macro or file workflows; login scripts applying standard desktop baselines."
    tuning_guidance = "Add approved deployment and configuration binaries to %global_allowed_admin_tools. Add named administrators to %global_allowed_admin_users. Add automation or service accounts that push GPO or Office baselines to %global_allowed_service_accounts. If Group Policy writes these values through a system process in your environment, scope the exclusion by account or tool list rather than excluding the process broadly."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      (
        $reg.target.registry.registry_key = /\\Microsoft\\Windows\\CurrentVersion\\Policies\\Attachments$/ nocase
        $reg.target.registry.registry_value_name = /^SaveZoneInformation$/ nocase
      )
      or
      (
        $reg.target.registry.registry_key = /\\Microsoft\\Office\\[0-9.]+\\[a-z]+\\Security\\ProtectedView$/ nocase
        $reg.target.registry.registry_value_name = /^Disable(InternetFilesInPV|AttachmentsInPV|UnsafeLocationsInPV)$/ nocase
      )
    )
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_admin_users
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1553.005")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value = array_distinct($reg.target.registry.registry_value_name)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
