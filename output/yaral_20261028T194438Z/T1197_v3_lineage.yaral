/*
  MITRE Technique : T1197 - BITS Jobs
  Tactic(s)       : Stealth, Persistence, Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:46:42.134897+00:00
  Reference       : https://attack.mitre.org/techniques/T1197
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1197_BITS_Transfer_From_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the BITS command-line client, or PowerShell invoking BITS transfer cmdlets, launched by a parent process that should never manage BITS jobs: Office applications, script hosts, web server workers, print spooler or database services. Detection pivots on process lineage rather than on BITS job arguments. Such lineage is typical of macro, web shell, or exploited-service payload staging and persistence."
    mitre_tactic = "Stealth, Persistence, Execution"
    mitre_technique = "T1197"
    mitre_technique_name = "BITS Jobs"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry that populates both parent (principal.process) and child (target.process) image paths, from an EDR, Sysmon Event ID 1, or Security Event 4688 with parent process enrichment."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Line-of-business or Office add-ins that legitimately download content via BITS, software deployment or patching agents launched from a script host, and web or database applications with a documented BITS-based update workflow. Developers testing BITS from an IDE or scripting host can also trigger it."
    tuning_guidance = "Add approved deployment or management parent binaries to %global_allowed_admin_tools. Add approved script-host parents to %global_allowed_script_hosts. Add automation accounts that legitimately drive BITS to %global_allowed_service_accounts. If a legitimate Office add-in uses BITS, scope the exclusion to that add-in's host or account rather than removing the Office parent from the regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Unexpected parent: Office, script host, web server, print spooler, database service
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|wscript|cscript|mshta|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|spoolsv|sqlservr|mysqld|postgres|oracle)\.exe$/ nocase

    // Child: BITS client, or PowerShell invoking BITS transfer cmdlets
    (
      $proc.target.process.file.full_path = /\\bitsadmin\.exe$/ nocase
      or
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
        and $proc.target.process.command_line = /(start-bitstransfer|add-bitsfile|resume-bitstransfer|complete-bitstransfer|bitstransfer)/ nocase
      )
    )

    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1197")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
