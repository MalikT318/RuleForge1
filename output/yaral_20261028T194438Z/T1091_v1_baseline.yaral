/*
  MITRE Technique : T1091 - Replication Through Removable Media
  Tactic(s)       : Lateral Movement, Initial Access
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:33:35.997639+00:00
  Reference       : https://attack.mitre.org/techniques/T1091
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1091_Autorun_Inf_Created_On_Non_System_Drive {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of an autorun.inf file in the root of a non-system drive letter (D: through Z:). Writing autorun.inf to the root of removable media is the core OS mechanism adversaries use to replicate malware through removable media and trigger execution when the media is inserted into another host. The rule matches the Autorun configuration file itself, not a specific payload name, so it still fires if the dropped malware is renamed or recompiled."
    mitre_tactic = "Lateral Movement, Initial Access"
    mitre_technique = "T1091"
    mitre_technique_name = "Replication Through Removable Media"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with full target file paths and the initiating process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy software installers or ISO/CD authoring tools that write autorun.inf to a drive root, IT staff preparing approved USB media or recovery drives, imaging and deployment tools, and secondary fixed or mapped drives that legitimately host an autorun.inf."
    tuning_guidance = "Add approved media-preparation or deployment tooling to %global_allowed_admin_tools and trusted EDR/AV agents to %global_allowed_security_tools. If the client's OS volume is not C:, review the drive-letter range in the path regex. Fixed secondary data drives that create autorun.inf legitimately can be handled by excluding the writing process through the reference lists."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^[d-z]:\\autorun\.inf$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1091")
    $primary_entity = array_distinct($file.principal.hostname)
    $autorun_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $writing_command_line = array_distinct($file.principal.process.command_line)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
