/*
  MITRE Technique : T1499.001 - OS Exhaustion Flood
  Tactic(s)       : Impact
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:17:46.745874+00:00
  Reference       : https://attack.mitre.org/techniques/T1499/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1499_001_Inbound_Connection_Flood_Windows_Service_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a high-volume burst of TCP connection attempts from one external source to one destination on a Windows-native service port (SMB, RPC, NetBIOS, RDP, WinRM). This is the network-observable footprint of a SYN/ACK state-exhaustion flood against a Windows host's connection limits. Uses firewall telemetry, not endpoint process data, so it complements process-creation coverage. Single-event logic cannot express volume, so the rule is a Threshold over a one-minute window."
    mitre_tactic = "Impact"
    mitre_technique = "T1499.001"
    mitre_technique_name = "Endpoint Denial of Service: OS Exhaustion Flood"
    log_prerequisites = "Firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip, target.port and network.ip_protocol populated. Each connection attempt, including denied or half-open ones, must be logged."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and penetration tests, misconfigured clients retrying SMB or RDP in a tight loop, NAT or proxy gateways aggregating many users behind one source IP, bulk file-server migrations, and RDP gateway or load-balancer health checks."
    tuning_guidance = "Add scanner and pen-test source addresses to %global_allowed_scanners. Raise or lower the #net threshold and the match window to fit client connection volume. Extend the port list with other Windows-exposed services in use. If the perimeter logs post-NAT addresses, review high-volume gateways before enabling."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "TCP"
    (
      $net.target.port = 445 or
      $net.target.port = 139 or
      $net.target.port = 135 or
      $net.target.port = 3389 or
      $net.target.port = 5985 or
      $net.target.port = 5986
    )
    $net.principal.ip = $src_ip
    $net.target.ip = $dst_ip
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src_ip, $dst_ip over 1m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1499.001")
    $primary_entity = array_distinct($dst_ip)
    $source_ips = array_distinct($src_ip)
    $targeted_ports = array_distinct($net.target.port)
    $connection_count = count($net.metadata.id)

  condition:
    #net >= 300
}
