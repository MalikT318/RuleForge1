/*
  MITRE Technique : T1222 - File and Directory Permissions Modification
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:15:40.322846+00:00
  Reference       : https://attack.mitre.org/techniques/T1222
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_Linux_Sensitive_Path_Permission_Tamper {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects chmod, setfacl or chattr run against sensitive Linux authentication, privilege, persistence or SSH paths in a way that weakens protection. This covers world-writable modes, setuid/setgid bits, permissive ACL entries for 'other', and removal of the immutable attribute. Attackers use these changes to modify protected files, plant persistence or escalate privileges."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1222"
    mitre_technique_name = "File and Directory Permissions Modification"
    log_prerequisites = "Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to PROCESS_LAUNCH with full command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package manager maintainer scripts (dpkg, rpm, apt, dnf, yum, zypper), configuration management agents (Ansible, Puppet, Chef, Salt), image build and hardening scripts, administrators repairing permissions or temporarily clearing the immutable flag for planned changes, and container or first-boot provisioning."
    tuning_guidance = "Add approved config-management and deployment binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Extend the package manager parent-process exclusion for distribution-specific installers. Narrow or widen the sensitive path regex to match local hardening baselines."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(chmod|setfacl|chattr)$/ nocase
    $proc.target.process.command_line = /(\s0?[0-7]{2}[2367](\s|$)|\s[2467][0-7]{3}(\s|$)|\s(o|a)[+=][rwxXt]*w|\s[ugoa]*[+=][rwxXt]*s|setfacl\s.*\b(o|other)::[r-]w|chattr\s+(-\S+\s+)*-\S*i)/ nocase
    $proc.target.process.command_line = /(\/etc\/(passwd|shadow|gshadow|sudoers|ld\.so\.preload|cron|crontab|ssh|pam\.d|profile|init\.d|rc\.local|systemd)|\/var\/spool\/cron|\/root\/\.ssh|\.ssh\/authorized_keys|\/lib\/systemd|\/usr\/lib\/systemd|\/\.bashrc|\/\.profile)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path = /\/(dpkg|rpm|apt|apt-get|yum|dnf|zypper|snapd)$/ nocase
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1222")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
