/*
  MITRE Technique : T1218.002 - Control Panel
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:44:21.857395+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_002_Control_Panel_CPL_Registry_Registration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry write under the Control Panel 'Cpls' autoload key (HKCU/HKLM, including Wow6432Node). Windows loads modules registered here whenever Control Panel starts, so adversaries use the key to register a malicious CPL for proxy execution and persistence through control.exe. This is registry-based coverage that complements process command-line rules. T1218.002 is a Windows-only technique with no Linux, macOS or cloud equivalent, so this variant pivots on registry telemetry on Windows."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.002"
    mitre_technique_name = "System Binary Proxy Execution: Control Panel"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR registry events or Sysmon Event IDs 12/13/14) with registry key paths and the writing process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Hardware vendor driver and utility installers that register their own Control Panel applets (audio, GPU, printer and touchpad software), enterprise software deployment and RMM agents, and administrators registering approved legacy CPL applets."
    tuning_guidance = "Add approved installer and deployment binaries to %global_allowed_admin_tools, EDR and security agents to %global_allowed_security_tools, and approved accounts to %global_allowed_admin_users. Review the registered value name and the writing process path; legitimate applets typically point to signed binaries under system or Program Files directories."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\control panel\\cpls(\\|$)/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1218.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_value_names = array_distinct($reg.target.registry.registry_value_name)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
