/*
  MITRE Technique : T1568.001 - Fast Flux DNS
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:04:42.546975+00:00
  Reference       : https://attack.mitre.org/techniques/T1568/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1568_001_Linux_FastFlux_LowTTL_External_DNS_Answer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side detection of fast-flux DNS behaviour from a Linux host. A DNS response resolves a non-allowlisted domain to external A/AAAA addresses with a very short TTL, the round-robin, rapidly rotating record pattern used to hide C2 infrastructure. Internal and private answers, internal-only suffixes and known-good domains are excluded."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1568.001"
    mitre_technique_name = "Dynamic Resolution: Fast Flux DNS"
    log_prerequisites = "Requires DNS response telemetry (resolver logs, passive DNS sensor or endpoint DNS events) normalised to NETWORK_DNS with network.dns.answers populated (type, ttl, data) and principal.hostname identifying the Linux client."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "CDNs, cloud load balancers, GeoDNS and global traffic managers, DDoS-protection fronts, dynamic DNS for remote workers, and SaaS or telemetry endpoints that deliberately use short TTLs."
    tuning_guidance = "Add recurring benign CDN, SaaS and vendor domains to %global_allowed_domains. Add resolver or agent processes that generate noisy lookups to %global_allowed_security_tools. Tighten the TTL threshold (e.g. <= 30) to reduce volume, or loosen it (e.g. <= 300) for wider coverage. Pair this alert with repeated-domain, new-domain or domain-entropy enrichment for triage."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.principal.platform = "LINUX"
    $dns.network.dns.response = true
    $dns.network.dns.answers.type = 1 or $dns.network.dns.answers.type = 28
    $dns.network.dns.answers.ttl > 0
    $dns.network.dns.answers.ttl <= 120
    not $dns.network.dns.answers.data in %rfc1918_internal
    not $dns.network.dns.questions.name in %global_allowed_domains
    not re.regex($dns.network.dns.questions.name, `(?i)\.(local|lan|internal|arpa|localdomain|home)$`)
    not $dns.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1568.001")
    $primary_entity = array_distinct($dns.principal.hostname)
    $queried_domains = array_distinct($dns.network.dns.questions.name)
    $resolved_addresses = array_distinct($dns.network.dns.answers.data)
    $observed_ttls = array_distinct($dns.network.dns.answers.ttl)

  condition:
    $dns
}
