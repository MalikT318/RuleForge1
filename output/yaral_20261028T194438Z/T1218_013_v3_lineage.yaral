/*
  MITRE Technique : T1218.013 - Mavinject
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:59:30.551478+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_013_Mavinject_Unexpected_Parent_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects mavinject.exe (Microsoft Application Virtualization Injector) launched by a parent process that should never start it, such as an Office application, web server worker, database service, print spooler, WMI provider host, or script interpreter. Legitimate App-V use does not spawn mavinject.exe from these parents, so the lineage is a strong indicator of DLL injection proxied through a signed Microsoft binary. The rule matches on process lineage only and does not depend on command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.013"
    mitre_technique_name = "System Binary Proxy Execution: Mavinject"
    log_prerequisites = "Requires Windows process creation telemetry with parent process path populated (EDR process events, Sysmon Event ID 1, or Windows Security Event 4688 with parent process logging)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare. App-V deployment or sequencing scripts run through PowerShell or cmd by IT; software packaging and virtualization tooling; security products that test injection behavior; red team and purple team exercises."
    tuning_guidance = "Add approved App-V, packaging, or deployment parent binaries to %global_allowed_admin_tools. Add EDR or AV agents that perform injection testing to %global_allowed_security_tools. Add known automation accounts to %global_allowed_service_accounts. If script interpreters are noisy in a specific client, remove them from the parent regex or scope them with %global_allowed_script_hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\mavinject(32)?\.exe$/ nocase
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|onenote|msaccess|mspub|visio|w3wp|httpd|nginx|tomcat[0-9]*|sqlservr|spoolsv|wmiprvse|wscript|cscript|mshta|powershell|pwsh|cmd|rundll32|regsvr32|msiexec|wmic|msedge|chrome|firefox|acrord32|acrobat)\.exe$/ nocase
    not $proc.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1218.013")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
