/*
  MITRE Technique : T1564.010 - Process Argument Spoofing
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:29:03.323483+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_010_Repeated_Memory_Write_Into_System_Processes {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated cross-process memory-write/injection activity from non-approved processes into native Windows system binaries on a single host within 10 minutes. Process argument spoofing (PEB command-line overwrite) requires writing into another process's memory after it is created suspended. A single event can be benign, but several in a short window on one host indicate spoofing or hollowing. This rule is based on process-injection telemetry, not command-line matching, so it still fires when the spoofed arguments look benign."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.010"
    mitre_technique_name = "Hide Artifacts: Process Argument Spoofing"
    log_prerequisites = "Requires Windows endpoint telemetry that reports remote memory write or injection into a target process (EDR or Sysmon-equivalent) and is normalised to PROCESS_INJECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Security agents and EDR sensors, backup and imaging software, application-compatibility shims, debuggers and developer tooling, accessibility or overlay software, and some RMM or deployment agents."
    tuning_guidance = "Add approved injectors to %global_allowed_security_tools, %global_allowed_backup_processes or %global_allowed_admin_tools. Raise the #inj threshold on hosts with developer or debugging activity. Severity is scaled in outcome: injection into common script and proxy-execution hosts scores higher."

  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.target.process.file.full_path = /\\windows\\(system32|syswow64)\\[^\\]+\.exe$/ nocase
    $inj.principal.process.file.full_path != $inj.target.process.file.full_path
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    $inj.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($inj.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|svchost)\.exe$/ nocase, 85, 65))
    $mitre_technique_id = array_distinct("T1564.010")
    $primary_entity = array_distinct($host)
    $event_count = count($inj.metadata.id)
    $injecting_processes = array_distinct($inj.principal.process.file.full_path)
    $target_processes = array_distinct($inj.target.process.file.full_path)
    $affected_users = array_distinct($inj.principal.user.userid)

  condition:
    #inj >= 3
}
