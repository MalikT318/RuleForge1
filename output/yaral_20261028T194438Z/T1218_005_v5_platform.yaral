/*
  MITRE Technique : T1218.005 - Mshta
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:48:59.586208+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_005_Mshta_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects mshta.exe making an outbound network connection to a non-internal address. Legitimate HTA execution is almost always local, so a connection from the host process indicates remote HTA/script retrieval or script-driven C2 (T1218.005). This rule uses network telemetry rather than process-creation command lines, so it still fires when command-line obfuscation defeats string matching. Mshta is Windows-only, so the platform stays Windows even though the alternate-platform angle was requested."
    mitre_tactic = "Defense Evasion, Execution"
    mitre_technique = "T1218.005"
    mitre_technique_name = "System Binary Proxy Execution: Mshta"
    log_prerequisites = "Requires Windows endpoint network telemetry that records the originating process path (EDR network events or Sysmon Event ID 3)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy line-of-business HTA applications that call internal-facing or vendor web services; software deployment or kiosk frontends built on HTA; IT automation that fetches content via mshta."
    tuning_guidance = "Add approved destination domains to %global_allowed_domains, hosts that legitimately run HTA applications to %global_allowed_script_hosts, and approved deployment tooling paths to %global_allowed_admin_tools."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\mshta\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
