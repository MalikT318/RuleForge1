/*
  MITRE Technique : T1029 - Scheduled Transfer
  Tactic(s)       : Exfiltration
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:49:57.388107+00:00
  Reference       : https://attack.mitre.org/techniques/T1029
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1029_Linux_OffHours_Large_Outbound_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a large outbound transfer to an external destination over file-transfer protocols (SSH/SCP/SFTP, rsync, FTP/FTPS) during off-hours, as observed by the network perimeter. The pattern is typical of cron- or timer-scheduled exfiltration from Linux servers, which uses quiet hours to blend in. The rule is network-side only and does not rely on process fields."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1029"
    mitre_technique_name = "Scheduled Transfer"
    log_prerequisites = "Requires firewall, proxy, or perimeter connection logs normalised to UDM NETWORK_CONNECTION with network.sent_bytes populated, and with Linux server egress traversing the perimeter."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Off-hours offsite backups and replication (rsync/SFTP) to third-party storage, scheduled log shipping, software mirror synchronisation, and data-warehouse or partner file feeds that run overnight."
    tuning_guidance = "The off-hours window is evaluated in UTC (hours 00:00-05:59); adjust the hour bound to match the client's local quiet hours. Tune the sent_bytes threshold (default about 50 MB) to the environment's baseline. Add known-good vendor and backup destinations to %global_allowed_domains. Add approved sources to %global_allowed_mgmt_sources if backup servers are the main source of noise."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.sent_bytes > 52428800
    (
      $net.target.port = 21 or
      $net.target.port = 22 or
      $net.target.port = 873 or
      $net.target.port = 990 or
      $net.target.port = 2222
    )
    timestamp.get_hour($net.metadata.event_timestamp.seconds, "UTC") < 6
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1029")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
