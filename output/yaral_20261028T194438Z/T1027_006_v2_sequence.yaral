/*
  MITRE Technique : T1027.006 - HTML Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:46:57.434921+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_006_Linux_HTML_Landing_Then_Shell_Stager_Fetch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A Linux client fetches an external HTML landing page through a browser and, within five minutes, the same source address pulls an executable or script stager from an external host using a command-line HTTP client. This pattern is consistent with an HTML smuggling lure followed by second-stage staging. The smuggled payload itself is assembled in the browser and never crosses the perimeter, so the rule detects the network-observable lure and follow-on staging."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.006"
    mitre_technique_name = "Obfuscated Files or Information: HTML Smuggling"
    log_prerequisites = "Requires forward-proxy or firewall HTTP logging that populates network.http.user_agent, target.url, target.hostname, and principal.ip (for example, TLS-inspecting proxy or NGFW URL logs). Not detectable from connection-only logs without URL visibility."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Developers or administrators who browse a vendor page and then curl or wget an installer script (for example package repositories, install.sh bootstrap scripts, or CI tooling). Software deployment from unlisted vendor domains. Internal build servers that fetch both web pages and artifacts."
    tuning_guidance = "Add trusted vendor and package distribution domains to %global_allowed_domains. Add vulnerability scanners and authorised test sources to %global_allowed_scanners, and approved jump hosts or build servers' source addresses to %global_allowed_mgmt_sources. Adjust the stager extension list per client baseline. Widen the 5m window only if the client has a high-latency proxy pipeline."

  events:
    $html.metadata.event_type = "NETWORK_HTTP"
    $html.network.http.method = "GET"
    $html.network.http.user_agent = /(X11|Linux)/ nocase
    $html.target.url = /\.(html?|xhtml|shtml)(\?.*)?$/ nocase
    not $html.target.ip in %rfc1918_internal
    not $html.target.hostname in %global_allowed_domains
    not $html.principal.ip in %global_allowed_scanners
    $html.principal.ip = $src_ip

    $dl.metadata.event_type = "NETWORK_HTTP"
    $dl.network.http.method = "GET"
    $dl.network.http.user_agent = /^(curl|wget)/ nocase
    $dl.target.url = /\.(sh|bin|elf|run|appimage|deb|rpm|py|pl)(\?.*)?$/ nocase
    not $dl.target.ip in %rfc1918_internal
    not $dl.target.hostname in %global_allowed_domains
    not $dl.principal.ip in %global_allowed_scanners
    $dl.principal.ip = $src_ip

    $html.metadata.event_timestamp.seconds <= $dl.metadata.event_timestamp.seconds

  match:
    $src_ip over 5m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.006")
    $primary_entity = array_distinct($src_ip)
    $landing_urls = array_distinct($html.target.url)
    $stager_urls = array_distinct($dl.target.url)
    $stager_hosts = array_distinct($dl.target.hostname)
    $html_event_count = count($html.metadata.id)
    $stager_event_count = count($dl.metadata.id)

  condition:
    $html and $dl
}
