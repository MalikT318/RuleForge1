/*
  MITRE Technique : T1498.001 - Direct Network Flood
  Tactic(s)       : Impact
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:10:00.375240+00:00
  Reference       : https://attack.mitre.org/techniques/T1498/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_001_Unidirectional_Inbound_UDP_ICMP_Flood {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a single firewall flow record in which an external source sends a very large volume of UDP or ICMP traffic to an internal destination with almost no return traffic. This one-directional volumetric pattern is characteristic of a direct network flood (DoS/DDoS) against a Windows-hosted service."
    mitre_tactic = "Impact"
    mitre_technique = "T1498.001"
    mitre_technique_name = "Network Denial of Service: Direct Network Flood"
    log_prerequisites = "Requires firewall or perimeter flow/session logs normalized to UDM NETWORK_FLOW with network.sent_bytes, network.received_bytes and network.ip_protocol populated. Flow records must be emitted at session close or at periodic intervals."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Inbound UDP media or VoIP streams, site-to-site replication or backup traffic over UDP, syslog/NetFlow/telemetry collectors receiving from external senders, authorised load or stress tests, and externally hosted monitoring probes using ICMP or UDP."
    tuning_guidance = "Raise or lower the sent_bytes threshold to match each client's baseline inbound volume per flow record. Add authorised testing sources to %global_allowed_scanners and trusted external peers to %global_allowed_mgmt_sources. Where flow records are emitted at short intervals, lower the threshold to match the interval."

  events:
    $flow.metadata.event_type = "NETWORK_FLOW"
    ($flow.network.ip_protocol = "UDP" or $flow.network.ip_protocol = "ICMP")
    $flow.network.sent_bytes >= 100000000
    $flow.network.received_bytes < 1024
    $flow.target.ip != ""
    not $flow.principal.ip in %rfc1918_internal
    not $flow.principal.ip in %global_allowed_scanners
    not $flow.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1498.001")
    $primary_entity = array_distinct($flow.target.ip)
    $source_ips = array_distinct($flow.principal.ip)
    $target_ports = array_distinct($flow.target.port)
    $protocols = array_distinct($flow.network.ip_protocol)
    $max_sent_bytes = max($flow.network.sent_bytes)

  condition:
    $flow
}
