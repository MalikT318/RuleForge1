/*
  MITRE Technique : T1557.004 - Evil Twin
  Tactic(s)       : Credential Access, Collection
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:36:56.669630+00:00
  Reference       : https://attack.mitre.org/techniques/T1557/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1557_004_Evil_Twin_Cleartext_Web_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Network-side proxy for Evil Twin Wi-Fi exposure. A single internal client makes a high volume of cleartext HTTP (TCP/80) connections to external destinations within 10 minutes. Clients on a rogue access point are often exposed to traffic downgrade, interception or captive-portal credential harvesting, so they show unusual cleartext web volume at the perimeter. A firewall cannot see the radio layer, so this is a low-fidelity indicator that needs analyst triage. Corroborate with wireless controller rogue-AP alerts."
    mitre_tactic = "Credential Access, Collection"
    mitre_technique = "T1557.004"
    mitre_technique_name = "Adversary-in-the-Middle: Evil Twin"
    log_prerequisites = "Firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Egress logging must be enabled for allowed traffic."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legacy applications and IoT devices using plain HTTP, OS and package update mechanisms, captive-portal checks on guest or BYOD segments, web crawlers, patch and software distribution clients, and vulnerability scanners."
    tuning_guidance = "Raise the #net threshold for noisy environments. Add scanner sources to %global_allowed_scanners and update or CDN domains to %global_allowed_domains. Scope the rule to wireless or guest client segments where the client log source can identify them. Adjust the risk_score step in outcome per client."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 80
    $net.principal.ip = $src
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  match:
    $src over 10m

  outcome:
    $event_count = count($net.metadata.id)
    $risk_score = max(if($event_count >= 300, 65, 40))
    $mitre_technique_id = array_distinct("T1557.004")
    $primary_entity = array_distinct($src)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)

  condition:
    #net >= 100
}
