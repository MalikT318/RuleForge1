/*
  MITRE Technique : T1053 - Scheduled Task/Job
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:10:56.454253+00:00
  Reference       : https://attack.mitre.org/techniques/T1053
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_005_Task_File_Written_Outside_Scheduler_Service {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a scheduled task definition file being created in the Windows Task Scheduler store (System32\\Tasks, SysWOW64\\Tasks, Tasks_Migrated or legacy Windows\\Tasks) by a process other than the Task Scheduler service host. Tasks created through schtasks, the COM/RPC API or PowerShell cmdlets are written to disk by the Schedule service running in svchost.exe. A different writing process suggests the task XML was dropped directly to bypass the API and command-line logging, a technique used for persistence and hidden-task creation. This is a file-artifact detection and does not depend on command-line telemetry."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.005"
    mitre_technique_name = "Scheduled Task/Job: Scheduled Task"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon Event ID 11 equivalent) with the writing process path populated and coverage of the C:\\Windows\\System32\\Tasks directory."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup or system-imaging restore operations, OS servicing and in-place upgrade processes, golden-image or deployment tooling that copies task XML directly, profile or migration tools, and EDR or AV agents quarantining or restoring task files."
    tuning_guidance = "Add approved deployment, imaging and migration tooling to %global_allowed_admin_tools, restore and imaging software to %global_allowed_backup_processes, and security agents to %global_allowed_security_tools. If OS servicing processes are noisy in a given tenant, add them to %global_allowed_admin_tools by full path."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\windows\\(system32\\tasks|syswow64\\tasks|system32\\tasks_migrated|tasks)\\[^\\]+/ nocase
    $file.principal.process.file.full_path != ""
    not $file.principal.process.file.full_path = /\\svchost\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1053.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $task_file_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
