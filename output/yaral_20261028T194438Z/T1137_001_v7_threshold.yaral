/*
  MITRE Technique : T1137.001 - Office Template Macros
  Tactic(s)       : Persistence
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:15:35.288927+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_001_Macro_Template_Bulk_Cloud_Upload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single user creates or modifies several macro-enabled Office template or add-in files (.dotm, .xltm, .xlam, .potm, .ppam) in cloud storage within ten minutes. One such file is routine. A burst can mean an adversary is staging macro-bearing templates for Office persistence, for example a shared or global template location that Office clients load at startup."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.001"
    mitre_technique_name = "Office Application Startup: Office Template Macros"
    log_prerequisites = "Unified audit logs for cloud file activity (file uploaded, modified or created in SharePoint, OneDrive or Drive) ingested into UDM with principal.user.userid and target.file.full_path populated."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Template authors and corporate branding or document-automation teams publishing template libraries. Add-in developers. Bulk migrations or restores of document libraries. Sync clients re-uploading template folders after a profile rebuild."
    tuning_guidance = "Add automation and migration accounts to %global_allowed_service_accounts and template-owner administrators to %global_allowed_admin_users. Raise the #file threshold for tenants with active template publishing. Lower it to 2 for high-sensitivity tenants. Review the matched file paths for unusual locations such as personal OneDrive folders or externally shared sites."

  events:
    $file.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"
    $file.target.file.full_path = /\.(dotm|xltm|xlam|potm|ppam)$/ nocase
    $file.principal.user.userid = $user
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($file.metadata.id)
    $template_files = array_distinct($file.target.file.full_path)
    $source_ips = array_distinct($file.principal.ip)
    $mitre_technique_id = array_distinct("T1137.001")
    $primary_entity = array_distinct($user)

  condition:
    #file >= 3
}
