/*
  MITRE Technique : T1218 - System Binary Proxy Execution
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:41:19.425883+00:00
  Reference       : https://attack.mitre.org/techniques/T1218
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_Signed_Binary_Loads_Module_From_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows signed proxy-execution binary (rundll32, regsvr32, odbcconf, regsvcs, regasm, installutil, mshta) loading a DLL, OCX or CPL module from a user-writable location such as a user profile, Temp, Public or ProgramData. Detection is based on module-load telemetry, not process command lines, so it complements command-line rules and still fires when arguments are obfuscated or the payload is renamed."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218"
    mitre_technique_name = "System Binary Proxy Execution"
    log_prerequisites = "Requires EDR or Sysmon-equivalent module-load telemetry (Sysmon Event ID 7 or EDR image-load events) normalised to PROCESS_MODULE_LOAD, with target.file.full_path populated for the loaded module."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and uninstallers that run regsvr32 or rundll32 against DLLs staged in Temp or AppData, per-user application shell extensions or COM registration, developer workstations registering freshly built COM components, and .NET deployment tooling (regasm, regsvcs, installutil) used by build pipelines."
    tuning_guidance = "Add approved installer, deployment and RMM binaries to %global_allowed_admin_tools. Add EDR and AV agents to %global_allowed_security_tools. For developer or build hosts, add the proxy binary's parent process to %global_allowed_script_hosts. Narrow or widen the writable-path regex to match the client's profile layout."

  events:
    $mod.metadata.event_type = "PROCESS_MODULE_LOAD"
    $mod.principal.process.file.full_path = /\\(rundll32|regsvr32|odbcconf|regsvcs|regasm|installutil|mshta)\.exe$/ nocase
    $mod.target.file.full_path = /\.(dll|ocx|cpl)$/ nocase
    $mod.target.file.full_path = /(\\Users\\[^\\]+\\(AppData|Downloads|Desktop|Documents)\\|\\Users\\Public\\|\\Windows\\Temp\\|\\ProgramData\\)/ nocase
    not $mod.target.file.full_path = /\\AppData\\Local\\Microsoft\\(OneDrive|Teams|Edge)\\/ nocase
    not $mod.principal.process.file.full_path in %global_allowed_admin_tools
    not $mod.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1218")
    $primary_entity = array_distinct($mod.principal.hostname)
    $proxy_binary = array_distinct($mod.principal.process.file.full_path)
    $loaded_module = array_distinct($mod.target.file.full_path)
    $acting_user = array_distinct($mod.principal.user.userid)

  condition:
    $mod
}
