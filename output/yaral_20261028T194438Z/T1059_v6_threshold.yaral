/*
  MITRE Technique : T1059 - Command and Scripting Interpreter
  Tactic(s)       : Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Command and Scripting Interpreter
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:07:22.194599+00:00
  Reference       : https://attack.mitre.org/techniques/T1059
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_ESXi_Excessive_Shell_Session_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of SSH or ESXi Shell logins by a single account to a single ESXi host within ten minutes. One interactive session is routine administration. Repeated sessions suggest scripted or automated command execution over the shell, such as attacker tooling pushing commands to the hypervisor or a compromised account being used for hands-on-keyboard activity."
    mitre_tactic = "Execution"
    mitre_technique = "T1059"
    mitre_technique_name = "Command and Scripting Interpreter"
    log_prerequisites = "ESXi shell, auth and hostd logs forwarded to Chronicle and parsed into USER_LOGIN events with target.hostname, target.user.userid and a populated metadata.description."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Configuration management or patching automation that opens many SSH sessions, backup and monitoring tools that log in over SSH, vendor health-check scripts, and admins running several parallel terminals during maintenance windows."
    tuning_guidance = "Add automation and monitoring accounts to %global_allowed_service_accounts and approved jump hosts or management subnets to %global_allowed_mgmt_sources. Raise the #auth threshold on hosts with heavy automation. Lower it for high-value hosts."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.metadata.description = /(ssh|shell)/ nocase
    $auth.target.hostname = $host
    $auth.target.user.userid = $user
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.principal.ip in %global_allowed_mgmt_sources

  match:
    $host, $user over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($auth.metadata.id)
    $source_ips = array_distinct($auth.principal.ip)
    $mitre_technique_id = array_distinct("T1059")
    $primary_entity = array_distinct($host)

  condition:
    #auth >= 5
}
