/*
  MITRE Technique : T1671 - Cloud Application Integration
  Tactic(s)       : Persistence
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:14:36.995369+00:00
  Reference       : https://attack.mitre.org/techniques/T1671
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1671_SaaS_OAuth_App_Consent_Or_Credential_Grant {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects configuration changes in the SaaS tenant that grant an OAuth application access or give it new credentials. Covers user or admin consent, delegated permission grants, app role assignments, new service principals, and new secrets or certificates on an existing application. Attackers use these to keep access to tenant data after the original account is disabled or its password is reset. The rule works from the resulting tenant configuration change, not from any endpoint command line."
    mitre_tactic = "Persistence"
    mitre_technique = "T1671"
    mitre_technique_name = "Cloud Application Integration"
    log_prerequisites = "Requires unified audit logs for directory and application management activity ingested and normalised to UDM SETTING_MODIFICATION, with metadata.product_event_type holding the audit operation name and principal.user.userid populated."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate user consent to sanctioned productivity add-ins; IT onboarding of new SaaS integrations; application owners rotating secrets or certificates; automated provisioning of enterprise applications; migration projects."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users. Add automation identities and deployment pipelines to %global_allowed_service_accounts, and sanctioned integration principals to %global_allowed_cloud_principals. Consider raising the score when target.application is unfamiliar or when the grant happens outside business hours."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /^(consent to application|add delegated permission grant|add oauth2permissiongrant|add app role assignment (grant )?to (user|service principal)|add service principal( credentials)?|update application.{1,5}certificates and secrets management)/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1671")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $operation = array_distinct($setting.metadata.product_event_type)
    $target_app = array_distinct($setting.target.application)
    $target_resource = array_distinct($setting.target.resource.name)
    $source_ip = array_distinct($setting.principal.ip)

  condition:
    $setting
}
