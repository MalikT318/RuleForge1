/*
  MITRE Technique : T1140 - Deobfuscate/Decode Files or Information
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : ESXi
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:10:38.666340+00:00
  Reference       : https://attack.mitre.org/techniques/T1140
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1140_ESXi_Bulk_Decode_Utility_Activity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of decode/decompress utility executions (base64 -d, xxd -r, openssl enc -d, uudecode) on a single ESXi host within ten minutes. One invocation is routine; repeated decoding is consistent with staging of an encoded payload or script on the host."
    mitre_tactic = "Stealth"
    mitre_technique = "T1140"
    mitre_technique_name = "Deobfuscate/Decode Files or Information"
    log_prerequisites = "ESXi shell and process execution telemetry (hostd, shell.log, auditd-style process events) ingested and normalised to UDM PROCESS_LAUNCH with principal.hostname and target.process.command_line populated."
    platform = "ESXi"
    // NOTE: log_source value is the identifier supplied in the request; the telemetry itself is ESXi host process logs.
    log_source = "macos_endpoint"
    false_positives = "Admin troubleshooting scripts, VMware/OEM support bundle collection, vendor VIB or patch installers that decode embedded data, automation that handles base64-encoded configuration or certificates."
    tuning_guidance = "Add approved parent tooling to %global_allowed_admin_tools, trusted automation hosts/parents to %global_allowed_script_hosts, and automation accounts to %global_allowed_service_accounts. Raise the #proc threshold on hosts with heavy scripted maintenance."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $proc.target.process.file.full_path = /\/(base64|xxd|openssl)$/ nocase and
        $proc.target.process.command_line = /(\s(-d|--decode|-r)(\s|$)|\benc\b.*\s-d(\s|$))/ nocase
      ) or
      $proc.target.process.file.full_path = /\/uudecode$/ nocase
    )
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($proc.metadata.id)
    $decoders_used = array_distinct($proc.target.process.file.full_path)
    $users = array_distinct($proc.principal.user.userid)
    $mitre_technique_id = array_distinct("T1140")
    $primary_entity = array_distinct($host)

  condition:
    #proc >= 5
}
