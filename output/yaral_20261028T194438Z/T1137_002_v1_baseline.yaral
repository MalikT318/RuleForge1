/*
  MITRE Technique : T1137.002 - Office Test
  Tactic(s)       : Persistence
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:15:46.723767+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_002_Office_Test_Perf_Registry_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a write to the Office Test 'Special\\Perf' registry key (HKCU or HKLM). This key is not created by default and lets an arbitrary DLL load each time an Office application starts, so it is a known persistence mechanism."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.002"
    mitre_technique_name = "Office Application Startup: Office Test"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR registry events or Sysmon Event ID 12/13/14) normalized to UDM REGISTRY_MODIFICATION with target.registry.registry_key populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare. Office developers or QA engineers using the Office Test debugging feature, legacy Office performance or test tooling, and software deployment or RMM tools that set this key as part of authorised testing."
    tuning_guidance = "Add approved deployment or RMM binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Developer workstations that legitimately use the key can be scoped out by adding the writing process to %global_allowed_admin_tools. If your pipeline maps new-key creation to REGISTRY_CREATION, deploy a copy of this rule with that event type."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\software\\microsoft\\office test\\special\\perf/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1137.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_value_names = array_distinct($reg.target.registry.registry_value_name)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $writer_command_lines = array_distinct($reg.principal.process.command_line)
    $users = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
