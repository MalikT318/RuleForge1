/*
  MITRE Technique : T1136.002 - Domain Account
  Tactic(s)       : Persistence
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:09:02.792195+00:00
  Reference       : https://attack.mitre.org/techniques/T1136/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_002_Linux_Domain_Account_Creation_CLI {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux host running directory-management command-line syntax that creates an account in a domain directory (Active Directory via Samba or net ads, adcli, or FreeIPA). Adversaries with sufficient privileges can use this to create a domain account for persistent, credentialed access that needs no implant on the host. Matching is on the command-line action combination, not the binary path, so a renamed or relocated binary is still caught."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136.002"
    mitre_technique_name = "Create Account: Domain Account"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records with full command-line arguments, normalized to UDM PROCESS_LAUNCH with target.process.command_line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Identity and directory administrators onboarding users with samba-tool, ipa, adcli or net ads; HR or IAM provisioning automation run from a Linux jump host; configuration management (Ansible, Puppet, Salt) provisioning directory users; lab or test domain builds."
    tuning_guidance = "Add approved provisioning tooling or parent processes to %global_allowed_admin_tools, IAM automation accounts to %global_allowed_service_accounts, and named directory administrators to %global_allowed_admin_users. Hosts that legitimately act as identity management servers can be handled by adding their provisioning parent processes to %global_allowed_admin_tools."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(\bsamba-tool\s+(-\S+\s+)*user\s+(create|add)\b|\bipa\s+(-\S+\s+)*(stage)?user-add\b|\bnet\s+(-\S+\s+)*ads\s+user\s+add\b|\badcli\s+(-\S+\s+)*create-user\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1136.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
