/*
  MITRE Technique : T1621 - Multi-Factor Authentication Request Generation
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:47:08.390584+00:00
  Reference       : https://attack.mitre.org/techniques/T1621
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1621_IdP_MFA_Push_Denied_Or_Reported {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an identity provider authentication event showing that a user denied, rejected, ignored or reported a multi-factor push, phone or SMS challenge as unexpected. A user rejecting a challenge they never started means someone else holds the account password and is generating MFA prompts. This is the MFA-fatigue precursor to the user eventually approving a request. The same event also appears when a self-service password reset triggers the challenge. It works on identity provider sign-in telemetry only and has no dependency on endpoint process data."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1621"
    mitre_technique_name = "Multi-Factor Authentication Request Generation"
    log_prerequisites = "Requires identity provider sign-in or authentication audit logs normalised to USER_LOGIN, with MFA challenge outcome text populated in security_result.summary or security_result.description."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Users who mistype or accidentally decline a legitimate MFA prompt, users who miss a push because of poor mobile connectivity or a new device, and users who enrolled a new authenticator and are testing it. Automated synthetic login monitors and helpdesk-assisted password resets can also trigger it."
    tuning_guidance = "Add automation and synthetic-monitoring accounts to %global_allowed_service_accounts. Raise severity or escalate when the same target user also has a later successful USER_LOGIN from a new source. If the client's identity provider uses different wording for MFA outcomes, extend the two regexes accordingly. For volume-based MFA-fatigue detection, pair this rule with a separate threshold rule."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    (
      $auth.security_result.summary = /(mfa|multi.?factor|2fa|two.?factor|push|authenticator|otp|verification (code|request)|second factor)/ nocase or
      $auth.security_result.description = /(mfa|multi.?factor|2fa|two.?factor|push|authenticator|otp|verification (code|request)|second factor)/ nocase
    )
    (
      $auth.security_result.summary = /(den(y|ied)|reject(ed)?|declin(e|ed)|not approved|no response|timed?.?out|expired|ignored|suspicious|fraud|not me|did not initiate|reported)/ nocase or
      $auth.security_result.description = /(den(y|ied)|reject(ed)?|declin(e|ed)|not approved|no response|timed?.?out|expired|ignored|suspicious|fraud|not me|did not initiate|reported)/ nocase
    )
    $auth.target.user.userid != ""
    not $auth.target.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1621")
    $primary_entity = array_distinct($auth.target.user.userid)
    $source_ips = array_distinct($auth.principal.ip)
    $challenge_detail = array_distinct($auth.security_result.summary)

  condition:
    $auth
}
