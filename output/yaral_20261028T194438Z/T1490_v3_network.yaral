/*
  MITRE Technique : T1490 - Inhibit System Recovery
  Tactic(s)       : Impact
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:41:00.520963+00:00
  Reference       : https://attack.mitre.org/techniques/T1490
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1490_Network_Backup_Snapshot_Deletion_API {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an internal client sending a backup, snapshot or recovery-point deletion request to an external destination. The request is seen in decrypted proxy or firewall HTTP logs, either as a deletion API action in the URL or as an HTTP DELETE against a snapshot, backup vault or recovery-point resource path. This is the network-side view of inhibiting system recovery through cloud or off-site backup destruction, and it complements endpoint command-line detections."
    mitre_tactic = "Impact"
    mitre_technique = "T1490"
    mitre_technique_name = "Inhibit System Recovery"
    log_prerequisites = "Requires firewall or secure web gateway HTTP logs with full URL and HTTP method populated (TLS inspection enabled for cloud API destinations), normalised to NETWORK_HTTP."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate backup retention and lifecycle jobs, cloud administrators pruning old snapshots, infrastructure-as-code pipelines, and backup vendor agents purging expired recovery points."
    tuning_guidance = "Add automation and backup service accounts to %global_allowed_service_accounts, named cloud or backup administrators to %global_allowed_admin_users, and trusted backup vendor domains to %global_allowed_domains. Use the outcome variables to baseline normal deletion volume per client. Without TLS inspection the URL is not visible and the rule will not fire."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    not $http.target.ip in %rfc1918_internal
    (
      $http.target.url = /(?i)action=delete(db|dbcluster)?snapshot|action=delete(backupvault|recoverypoint|backupplan|backup)/
      or
      (
        $http.network.http.method = "DELETE" nocase
        and $http.target.url = /(?i)\/(snapshots|backupvaults|recoverypoints|restorepoints|backuppolicies|backups)\//
      )
    )
    not $http.principal.user.userid in %global_allowed_service_accounts
    not $http.principal.user.userid in %global_allowed_admin_users
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1490")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $request_urls = array_distinct($http.target.url)
    $http_methods = array_distinct($http.network.http.method)

  condition:
    $http
}
