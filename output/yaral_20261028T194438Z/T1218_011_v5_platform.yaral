/*
  MITRE Technique : T1218.011 - Rundll32
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:56:55.144971+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_011_Rundll32_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects rundll32.exe itself initiating a network connection to a non-internal address. Legitimate rundll32 use rarely involves direct outbound connections, so this indicates a proxied DLL payload, a remotely loaded script or scriptlet, or C2 beaconing from a rundll32 host process. This rule is deliberately based on NETWORK_CONNECTION telemetry, not process-creation command lines, so it complements existing PROCESS_LAUNCH rules. The requested alternate-platform angle was not applied because rundll32.exe exists only on Windows and the mandatory target platform is Windows."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.011"
    mitre_technique_name = "System Binary Proxy Execution: Rundll32"
    log_prerequisites = "Requires Windows endpoint network telemetry that attributes each connection to its originating process (EDR network events or Sysmon Event ID 3), normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate shell and control panel components that fetch content over the network (for example shell extensions or Internet Explorer/Edge-related DLL functions), software installers and updaters that launch rundll32 for setup DLLs, VPN and endpoint agents that proxy network calls through rundll32, and RMM or deployment tooling."
    tuning_guidance = "Add approved parent processes (deployment and patching tools) to %global_allowed_admin_tools. Add known-good destination hostnames (vendor and update services) to %global_allowed_domains. Review recurring benign parent/destination pairs per client and allowlist them rather than disabling the rule."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\rundll32\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.parent_process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1218.011")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $parent_processes = array_distinct($net.principal.process.parent_process.file.full_path)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
