/*
  MITRE Technique : T1546.013 - PowerShell Profile
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:18:55.358731+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_013_PowerShell_Profile_Tamper_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an unexpected parent process (Office application, web server, print spooler, database service) spawning a shell or script interpreter whose command line writes to a PowerShell profile script. This is a lineage anomaly consistent with persistence via PowerShell profile modification, which executes on every later PowerShell session."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.013"
    mitre_technique_name = "Event Triggered Execution: PowerShell Profile"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing) that populates parent process path, child process path and command line."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web-based administration or deployment portals that legitimately configure PowerShell profiles through w3wp or Java services, database maintenance jobs that run PowerShell via sqlservr, Office macros in IT-built provisioning tools, and software installers that customise user profiles."
    tuning_guidance = "Add approved parent processes (full path) to %global_allowed_script_hosts or %global_allowed_admin_tools. Add known automation accounts to %global_allowed_service_accounts. Extend the parent regex with environment-specific server or application processes if required."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Unexpected parent: Office, web server, print spooler or database service
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|w3wp|httpd|nginx|tomcat[0-9]*|java|php-cgi|spoolsv|sqlservr|mysqld|postgres|oracle)\.exe$/ nocase

    // Child: shell or script interpreter
    $proc.target.process.file.full_path = /\\(powershell|pwsh|powershell_ise|cmd|wscript|cscript|mshta)\.exe$/ nocase

    // Child command line references a PowerShell profile script with a write operation
    $proc.target.process.command_line = /(\$profile\b|[a-z_.]*profile\.ps1)/ nocase
    $proc.target.process.command_line = /(add-content|set-content|out-file|new-item|copy-item|move-item|writeall|\becho\b|>)/ nocase

    $proc.principal.hostname != ""

    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1546.013")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
