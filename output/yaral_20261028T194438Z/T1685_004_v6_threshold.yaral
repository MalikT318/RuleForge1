/*
  MITRE Technique : T1685.004 - Disable or Modify Linux Audit System Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:22:44.818367+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_004_Audit_Config_Repeated_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated modification of Linux Audit configuration, rule and plugin files (auditd.conf, audit.rules, rules.d, audisp/plugins, libaudit.conf) on a single host within 10 minutes. A single edit is routine administration; several edits in a short window suggest an adversary weakening or removing audit rules to hide activity."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.004"
    mitre_technique_name = "Disable or Modify Linux Audit System Log"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch events (for example a watch on /etc/audit/) normalised to FILE_MODIFICATION with principal.hostname and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management runs (Ansible, Puppet, Chef, Salt) pushing audit rule sets; package upgrades of the audit package; compliance hardening scripts (CIS/STIG baselines); `augenrules --load` regenerating audit.rules from rules.d; administrators tuning rules during an authorised change window."
    tuning_guidance = "Add configuration-management and package-manager binaries to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Raise the threshold in the condition if hardening baselines routinely touch several audit files at once. Hosts under active compliance remediation can be tuned out temporarily."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/(audit\/|audisp\/|libaudit\.conf$)/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1685.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $event_count = count($file.metadata.id)
    $modified_files = array_distinct($file.target.file.full_path)
    $modifying_processes = array_distinct($file.principal.process.file.full_path)
    $acting_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
