/*
  MITRE Technique : T1127.003 - JamPlus
  Tactic(s)       : Stealth, Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:41:25.004226+00:00
  Reference       : https://attack.mitre.org/techniques/T1127/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1127_003_JamPlus_Jam_File_Staging_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several .jam build-script files are written to user-writable or staging locations on one host within ten minutes. JamPlus can proxy script execution from .jam files, so a burst of such files outside a developer workflow suggests staging for build-utility proxy execution. This rule uses file-creation telemetry only and does not rely on process command lines."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1127.003"
    mitre_technique_name = "Trusted Developer Utilities Proxy Execution: JamPlus"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Game or asset pipeline developers, build agents that extract source archives into temp or profile directories, IDE and workspace generators, and package or source-control checkouts into user profile folders."
    tuning_guidance = "Add approved build, IDE and deployment tooling to %global_allowed_admin_tools. Add trusted automation hosts or parent processes to %global_allowed_script_hosts. Add EDR and AV agents to %global_allowed_security_tools. Raise the threshold on developer-heavy estates, or exclude build agents using %global_allowed_service_accounts."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.jam$/ nocase
    $file.target.file.full_path = /(\\users\\[^\\]+\\(appdata|downloads|desktop|documents)\\|\\users\\public\\|\\programdata\\|\\windows\\temp\\|\\temp\\)/ nocase
    not $file.principal.process.file.full_path = /\\(devenv|msbuild|git|code)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $file_count = count($file.metadata.id)
    $risk_score = max(if($file_count >= 10, 80, 55))
    $mitre_technique_id = array_distinct("T1127.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $jam_files = array_distinct($file.target.file.full_path)
    $creator_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
