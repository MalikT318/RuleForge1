/*
  MITRE Technique : T1106 - Native API
  Tactic(s)       : Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:02:06.751109+00:00
  Reference       : https://attack.mitre.org/techniques/T1106
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1106_Ntdll_Loaded_From_Nonstandard_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process loading a copy of ntdll.dll from outside the trusted Windows system locations. Adversaries map a fresh or private copy of ntdll to call Native API functions and syscall stubs directly, bypassing user-mode API hooks. This is module-load telemetry rather than command-line matching, so it complements process-creation coverage of T1106."
    mitre_tactic = "Execution"
    mitre_technique = "T1106"
    mitre_technique_name = "Native API"
    log_prerequisites = "Requires EDR module-load telemetry or Sysmon Event ID 7 (Image Loaded) with ntdll.dll image loads not filtered out at the sensor."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software that loads ntdll from its own folder (some game anti-cheat engines, application compatibility shims, and virtualisation or sandbox products), forensic and debugging tools that parse ntdll images, and offline servicing or imaging tools mounting a Windows image."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools and approved deployment or imaging tooling to %global_allowed_admin_tools. Extend the trusted-path regex if the client mounts Windows images at a known system location. Review the loading process lineage before suppressing."

  events:
    $mod.metadata.event_type = "PROCESS_MODULE_LOAD"
    $mod.target.file.full_path = /\\ntdll\.dll$/ nocase
    not $mod.target.file.full_path = /^[a-z]:\\windows\\(system32|syswow64|winsxs)\\/ nocase
    not $mod.principal.process.file.full_path in %global_allowed_security_tools
    not $mod.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1106")
    $primary_entity = array_distinct($mod.principal.hostname)
    $loading_process = array_distinct($mod.principal.process.file.full_path)
    $ntdll_path = array_distinct($mod.target.file.full_path)
    $user = array_distinct($mod.principal.user.userid)

  condition:
    $mod
}
