/*
  MITRE Technique : T1543 - Create or Modify System Process
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:53:23.739092+00:00
  Reference       : https://attack.mitre.org/techniques/T1543
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_Windows_Service_Registry_Config_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of service configuration writes (ImagePath, ServiceDll or FailureCommand) under the Services registry hive on a single host within 10 minutes. One service change is routine. Several in a short window suggest service-based persistence or privilege escalation, such as malware installing multiple services or hijacking existing ones."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543"
    mitre_technique_name = "Create or Modify System Process"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 12/13/14 equivalent) normalised to REGISTRY_MODIFICATION with target.registry.registry_key and registry_value_name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and upgrades, driver installation, RMM or patch deployment agents, golden image builds, and endpoint security product updates that register or reconfigure several services."
    tuning_guidance = "Add deployment and patching binaries to %global_allowed_admin_tools, security agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Raise the #reg threshold for noisy build or imaging hosts. Windows servicing (TrustedInstaller, TiWorker) and Defender engine processes are excluded by executable name."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(CurrentControlSet|ControlSet\d{3})\\Services\\[^\\]+(\\Parameters)?$/ nocase
    $reg.target.registry.registry_value_name = /^(ImagePath|ServiceDll|FailureCommand)$/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($reg.metadata.id)
    $mitre_technique_id = array_distinct("T1543")
    $primary_entity = array_distinct($host)
    $modified_service_keys = array_distinct($reg.target.registry.registry_key)
    $modified_values = array_distinct($reg.target.registry.registry_value_name)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $acting_users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 4
}
