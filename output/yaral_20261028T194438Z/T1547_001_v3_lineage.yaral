/*
  MITRE Technique : T1547.001 - Registry Run Keys / Startup Folder
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:23:48.224634+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_001_Unexpected_Parent_Spawns_RunKey_Writer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process that should never manage persistence (Office application, web server worker, print spooler, or database service) spawning a shell, script interpreter or registry utility whose command line writes to a Run, RunOnce or RunOnceEx autostart key. The parent-child lineage is the primary signal. It indicates exploitation, macro execution or webshell activity establishing logon persistence."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.001"
    mitre_technique_name = "Boot or Logon Autostart Execution: Registry Run Keys / Startup Folder"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing and parent process name)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office add-ins or installers that register a startup entry through a helper shell, database or web application installers and updaters that write Run keys during setup, and legitimate line-of-business applications hosted under a web server or print spooler service that configure autostart entries."
    tuning_guidance = "Add approved deployment or installer parents to %global_allowed_admin_tools, trusted automation hosts to %global_allowed_script_hosts, and EDR/AV agents to %global_allowed_security_tools. If a specific database or web application legitimately registers autostart entries, add its parent process path to the appropriate list rather than loosening the parent regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat\d*|php-cgi|spoolsv|sqlservr|mysqld|postgres|oracle)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(reg|regedit|powershell|pwsh|cmd|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /\\CurrentVersion\\(Run|RunOnce|RunOnceEx)(\\|\s|"|'|$)/ nocase
    $proc.target.process.command_line = /(\sadd\s|\simport\s|new-itemproperty|set-itemproperty|\ssetvalue|\s\/v\s|\s-name\s|\s-value\s)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1547.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
