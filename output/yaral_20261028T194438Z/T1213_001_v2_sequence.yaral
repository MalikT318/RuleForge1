/*
  MITRE Technique : T1213.001 - Confluence
  Tactic(s)       : Collection
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:23:24.034200+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_001_Wiki_Login_Then_Bulk_Page_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A user logs in from an external source address and then accesses a high number of wiki/knowledge-base content pages within ten minutes. This pattern is consistent with an adversary using a compromised or newly authenticated account to mine collaboration repositories for credentials, architecture documentation and internal links."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.001"
    mitre_technique_name = "Data from Information Repositories: Confluence"
    log_prerequisites = "Requires SaaS collaboration application audit logs that include both authentication events (USER_LOGIN) and page or content view events (USER_RESOURCE_ACCESS with target.url populated), ingested and normalised into UDM."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Documentation migration or content-audit projects, search indexers and crawlers using user tokens, new employees onboarding and reading many pages, knowledge managers doing bulk reviews, and sanctioned security testing."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, named administrators to %global_allowed_admin_users, and authorised crawlers or scanners to %global_allowed_scanners. Raise or lower the #access threshold in the condition to match the client's normal page-view volume. Adjust the target.url path regex if the client's wiki uses a custom context path."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.principal.user.userid = $user
    not $login.principal.ip in %rfc1918_internal
    not $login.principal.user.userid in %global_allowed_service_accounts
    not $login.principal.user.userid in %global_allowed_admin_users

    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.principal.user.userid = $user
    $access.target.url = /\/(wiki|confluence)\/(spaces|display|pages|rest\/api\/content|download\/attachments)/ nocase
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_admin_users
    not $access.principal.ip in %global_allowed_scanners

    $login.metadata.event_timestamp.seconds <= $access.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1213.001")
    $primary_entity = array_distinct($user)
    $page_access_count = count($access.metadata.id)
    $accessed_urls = array_distinct($access.target.url)
    $source_ips = array_distinct($login.principal.ip)

  condition:
    $login and #access >= 15
}
