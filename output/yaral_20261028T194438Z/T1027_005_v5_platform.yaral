/*
  MITRE Technique : T1027.005 - Indicator Removal from Tools
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:46:00.155396+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_005_Linux_Binary_Tampering_In_Staging_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a binary-manipulation utility (strip, objcopy, patchelf, upx, hex editors) modifying a file inside a world-writable Linux staging directory (/tmp, /var/tmp, /dev/shm). Adversaries re-work payloads this way to remove or alter byte patterns, symbols and metadata that security tooling flagged, then redeploy the altered payload. This is file-modification coverage, not process command-line matching."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.005"
    mitre_technique_name = "Obfuscated Files or Information: Indicator Removal from Tools"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry that populates the acting process path (principal.process.file.full_path) and the modified file path (target.file.full_path) on FILE_MODIFICATION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers or CI/build jobs that compile and strip binaries under /tmp; package build systems (rpmbuild, dpkg-buildpackage, container image builds) using /var/tmp as scratch space; software packers run by release engineering; admins stripping debug symbols from test builds."
    tuning_guidance = "Add approved build and deployment tooling paths to %global_allowed_admin_tools, build and CI accounts to %global_allowed_service_accounts, and EDR or AV agents to %global_allowed_security_tools. Build servers can be excluded by hostname through a client-specific copy of the rule. Raise severity if the same host also shows the modified file being executed."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.principal.process.file.full_path = /\/(strip|sstrip|objcopy|patchelf|upx|xxd|hexedit|bbe)$/ nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    not $file.target.file.full_path = /\.(txt|log|conf|cfg|json|xml|csv|yaml|yml|lock|pid|swp)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_files = array_distinct($file.target.file.full_path)
    $acting_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
