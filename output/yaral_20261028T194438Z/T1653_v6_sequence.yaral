/*
  MITRE Technique : T1653 - Power Settings
  Tactic(s)       : Persistence
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:57:57.728120+00:00
  Reference       : https://attack.mitre.org/techniques/T1653
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1653_NetDev_Untrusted_Login_Then_Power_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A login to a network device from a source outside the approved management sources is followed within 10 minutes by a configuration change that cancels or disables scheduled reloads, shutdowns, power-save or sleep behaviour on the same device. This can indicate an adversary keeping a compromised device running to extend access."
    mitre_tactic = "Persistence"
    mitre_technique = "T1653"
    mitre_technique_name = "Power Settings"
    log_prerequisites = "Network device syslog or AAA/command-accounting logs parsed to UDM. Requires USER_LOGIN events with target.hostname populated and SETTING_MODIFICATION events with the configuration command text in metadata.description and target.hostname populated."
    platform = "Network Devices"
    log_source = "macos_endpoint"
    false_positives = "Planned maintenance windows where engineers cancel a scheduled reload; initial device provisioning or staging; PoE or power-redundancy changes during hardware work; logins from a new jump host that is not yet in the approved management sources list."
    tuning_guidance = "Add approved jump hosts and management addresses to %global_allowed_mgmt_sources. Add automation accounts to %global_allowed_service_accounts. Add change-window engineers to %global_allowed_admin_users. Both events join on target.hostname, so confirm the parser populates it on both event types. NOTE: log_source is set to the identifier supplied by the pipeline, but this rule uses network device management-plane telemetry. Confirm the log source mapping for the client before deployment."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.hostname != ""
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.target.user.userid in %global_allowed_service_accounts
    $auth.target.hostname = $device

    $set.metadata.event_type = "SETTING_MODIFICATION"
    $set.metadata.description = /(reload\s+cancel|no\s+reload|no\s+scheduler\s+(allocate|interval)|power\s+inline\s+never|no\s+power\s+redundancy|systemctl\s+mask\s+\S*(sleep|hibernate|suspend|poweroff|reboot)\.target|shutdown\s+-c)/ nocase
    not $set.principal.user.userid in %global_allowed_admin_users
    not $set.principal.user.userid in %global_allowed_service_accounts
    $set.target.hostname = $device

    $auth.metadata.event_timestamp.seconds <= $set.metadata.event_timestamp.seconds

  match:
    $device over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1653")
    $primary_entity = array_distinct($device)
    $login_source_ips = array_distinct($auth.principal.ip)
    $login_users = array_distinct($auth.target.user.userid)
    $config_users = array_distinct($set.principal.user.userid)
    $config_commands = array_distinct($set.metadata.description)
    $change_count = count($set.metadata.id)

  condition:
    $auth and $set
}
