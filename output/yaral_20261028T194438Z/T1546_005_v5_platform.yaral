/*
  MITRE Technique : T1546.005 - Trap
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:08:09.652740+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_005_Linux_Shell_Startup_File_Modified_Trap_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects modification of Linux shell startup and logout files (.bashrc, .bash_profile, .profile, .bash_logout, .zshrc, /etc/profile, /etc/profile.d/*.sh and similar) by a process other than a package manager, account-management utility, interactive editor or approved admin tool. Adversaries plant 'trap' statements in these files so their commands run on shell signals, exit or logout, giving persistence and sometimes privilege escalation when a privileged user starts a shell. This is file-integrity coverage for the trap persistence location. It does not depend on command-line matching of the trap builtin, so it complements process-creation rules."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.005"
    mitre_technique_name = "Event Triggered Execution: Trap"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules (-w on /etc/profile, /etc/profile.d, /etc/bash.bashrc, /etc/zsh and user home shell rc files) normalised to FILE_MODIFICATION with principal.process.file.full_path populated. Without file-write auditing on home directories, user-level rc files will not be seen."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators or users editing rc files through a shell redirect or an editor not covered by the name exclusion; configuration management (Ansible, Puppet, Chef, Salt) pushing profile changes; developer tooling that appends to .bashrc or .profile (nvm, pyenv, conda, sdkman, rustup, cloud CLI installers); user provisioning scripts that populate home directories; OS upgrades."
    tuning_guidance = "Add configuration-management and deployment binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. If developer-tool installers are noisy, extend the process-name exclusion for the environment. Content inspection is not possible on file events, so triage should check the file for 'trap' lines and for commands that run on EXIT, DEBUG, ERR, INT or SIGTERM."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /(^|\/)(\.bashrc|\.bash_profile|\.bash_login|\.bash_logout|\.profile|\.zshrc|\.zshenv|\.zprofile|\.zlogin|\.zlogout)$|^\/etc\/(profile|bash\.bashrc|bashrc|bash\.bash_logout|zsh\/(zshrc|zshenv|zprofile|zlogin|zlogout)|profile\.d\/[^\/]+\.sh)$/ nocase
    not $file.target.file.full_path = /^\/etc\/skel\// nocase
    not $file.principal.process.file.full_path = /\/(dpkg|rpm|yum|dnf|apt|apt-get|aptitude|zypper|snapd|packagekitd|useradd|adduser|usermod|vipw|vi|vim|nvim|nano|emacs|pico)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1546.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
