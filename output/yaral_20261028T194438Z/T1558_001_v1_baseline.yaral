/*
  MITRE Technique : T1558.001 - Golden Ticket
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:39:20.837439+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_001_Golden_Ticket_Forge_Command_Line {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects a process launch whose command line combines the arguments needed to forge a Kerberos TGT: KRBTGT or Kerberos key material (RC4/NT hash or AES key), the domain SID, and the user or domain to impersonate. This is the direct behavioral signature of golden ticket creation and does not depend on the binary name, file hash or hosting infrastructure."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.001"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Golden Ticket"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with full command-line capture (EDR, Sysmon Event ID 1 or Windows Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Authorised red team or purple team exercises, penetration tests, and security validation tooling that forges tickets in a lab or production domain. Detection engineering teams replaying adversary simulations. Silver ticket forging tools use similar argument sets and will also match (T1558.002 overlap)."
    tuning_guidance = "Add approved security testing tooling to %global_allowed_security_tools and approved administrative tooling to %global_allowed_admin_tools. Exclude authorised test hosts through the parent process path. Treat any hit outside a scheduled test window as a confirmed incident: reset the KRBTGT password twice and review domain controller logs for Event 4769 and 4624 anomalies."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(\/|--?)(krbtgt|rc4|aes256|aes128|nthash|aeskey)[:=\s]/ nocase
    $proc.target.process.command_line = /(\/|--?)(sid|domain-sid)[:=\s]/ nocase
    $proc.target.process.command_line = /(\/|--?)(user|domain)[:=\s]/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1558.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $forging_process = array_distinct($proc.target.process.file.full_path)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
