/*
  MITRE Technique : T1484 - Domain or Tenant Policy Modification
  Tactic(s)       : Defense Impairment, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:31:49.604337+00:00
  Reference       : https://attack.mitre.org/techniques/T1484
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1484_Bulk_Directory_Policy_Changes_By_Single_Account {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single account makes several modifications to domain-level policy objects (Group Policy containers, GPO link attributes, domain trust objects) within ten minutes. One change is routine administration. A burst from one account suggests mass GPO tampering, trust manipulation, or defence impairment through centrally managed policy."
    mitre_tactic = "Defense Impairment, Privilege Escalation"
    mitre_technique = "T1484"
    mitre_technique_name = "Domain or Tenant Policy Modification"
    log_prerequisites = "Requires Active Directory directory-service change auditing (Windows Security events such as 5136/5137/5141 and 4739) from domain controllers, normalised to UDM SETTING_MODIFICATION with principal.user.userid and target.resource.name holding the directory object name or DN."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Planned GPO rollouts and baseline updates by domain administrators, GPO migration or backup-restore jobs, identity governance tooling syncing policy objects, and domain functional-level or trust maintenance windows."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation or sync accounts to %global_allowed_service_accounts. Raise the #dir threshold for estates with frequent GPO changes. Review target.resource.name values in the outcome to confirm which policy objects were touched."

  events:
    $dir.metadata.event_type = "SETTING_MODIFICATION"
    $dir.target.resource.name = /(groupPolicyContainer|CN=Policies,CN=System|gPLink|gPCFileSysPath|gPCMachineExtensionNames|trustedDomain|CN=System,DC=)/ nocase
    $dir.principal.user.userid = $user
    not $dir.principal.user.userid in %global_allowed_admin_users
    not $dir.principal.user.userid in %global_allowed_service_accounts

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1484")
    $primary_entity = array_distinct($user)
    $change_count = count($dir.metadata.id)
    $modified_objects = array_distinct($dir.target.resource.name)
    $source_hosts = array_distinct($dir.principal.hostname)

  condition:
    #dir >= 5
}
