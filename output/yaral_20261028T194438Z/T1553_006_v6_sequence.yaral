/*
  MITRE Technique : T1553.006 - Code Signing Policy Modification
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:10:01.323817+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_006_Signing_Enforcement_Disabled_Then_Driver_Service {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A boot configuration change that disables driver signature enforcement (test signing or disabled integrity checks) is followed within ten minutes by a kernel driver service (.sys ImagePath) being registered on the same host. This pairing is a strong sign that an unsigned or self-signed driver is being staged after code signing policy was weakened."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.006"
    mitre_technique_name = "Subvert Trust Controls: Code Signing Policy Modification"
    log_prerequisites = "Requires EDR or Sysmon process creation telemetry with full command lines (or Windows Event 4688 with command-line auditing), and registry modification telemetry covering HKLM\\SYSTEM\\CurrentControlSet\\Services."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Driver developers and QA labs that enable test signing, hardware or kernel-driver test automation, OS imaging and provisioning scripts, and legitimate vendor driver installers run by IT on a test-signed machine."
    tuning_guidance = "Add approved deployment and driver tooling to %global_allowed_admin_tools (applied to both events). Exclude developer or lab hosts by scoping the rule at deployment. Raise severity to Critical for hosts that are not in a development group."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /\/?set\s+.*(testsigning\s+(on|yes|1|true)|nointegritychecks\s+(on|yes|1|true)|loadoptions\s+\W*d?disable_integrity_checks)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\services\\/ nocase
    $reg.target.registry.registry_value_name = "ImagePath" nocase
    $reg.target.registry.registry_value_data = /\.sys/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    $reg.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1553.006")
    $primary_entity = array_distinct($hostname)
    $policy_change_commands = array_distinct($proc.target.process.command_line)
    $driver_service_keys = array_distinct($reg.target.registry.registry_key)
    $driver_image_paths = array_distinct($reg.target.registry.registry_value_data)
    $acting_users = array_distinct($proc.principal.user.userid)

  condition:
    $proc and $reg
}
