/*
  MITRE Technique : T1505.005 - Terminal Services DLL
  Tactic(s)       : Persistence
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:32:48.538299+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_005_TermService_ServiceDll_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry modification of the ServiceDll value under the TermService Parameters key where the new value does not point to the genuine termsrv.dll in the Windows System32 directory. Hijacking this value makes svchost load an attacker-controlled DLL each time Remote Desktop Services starts, giving persistence. This is a registry state-change detection, so it fires regardless of the command line or tool used to make the change."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.005"
    mitre_technique_name = "Server Software Component: Terminal Services DLL"
    log_prerequisites = "Requires Windows registry modification telemetry that includes the registry key, value name and value data (EDR registry events or Sysmon Event ID 13), with the registry audit/collection scope covering HKLM\\SYSTEM\\CurrentControlSet\\Services."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Third-party RDP enhancement or multi-session software that legitimately redirects the TermService ServiceDll; RDP wrapper-style tools used by administrators; enterprise remote-access or VDI agents that install their own terminal services component; OS in-place upgrades that rewrite the value with a differently expanded path."
    tuning_guidance = "Add the approved modifying process path to %global_allowed_admin_tools or %global_allowed_remote_mgmt. Add endpoint security agent processes to %global_allowed_security_tools. If a client legitimately uses a custom TermService DLL, extend the value-data exclusion regex for that client's approved path rather than disabling the rule."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\services\\termservice\\parameters/ nocase
    $reg.target.registry.registry_value_name = "ServiceDll" nocase
    not $reg.target.registry.registry_value_data = /^("?)(%systemroot%|%windir%|[a-z]:\\windows)\\system32\\termsrv\.dll("?)$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1505.005")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $new_service_dll = array_distinct($reg.target.registry.registry_value_data)
    $modifying_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
