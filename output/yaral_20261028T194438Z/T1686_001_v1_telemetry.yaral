/*
  MITRE Technique : T1686.001 - Cloud Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:28:19.886686+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_001_Cloud_Firewall_Rule_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a control-plane configuration change that creates, modifies or deletes a cloud firewall construct (security group rules, network ACL entries, VPC firewall rules, network security group rules or firewall policies). Adversaries use these changes to open ingress to cloud workloads or remove network restrictions for C2 or cryptomining. This is a configuration-state detection on cloud audit logs and does not rely on process or command-line telemetry."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.001"
    mitre_technique_name = "Cloud Firewall"
    log_prerequisites = "Cloud control-plane audit logging (management/admin activity events) must be enabled and normalised to UDM with metadata.product_event_type populated and principal.user.userid mapped."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Infrastructure-as-code pipelines (Terraform, CloudFormation, Deployment Manager), platform and network engineering teams making approved changes, autoscaling or load-balancer automation managing rules, new environment build-outs, and break-glass troubleshooting."
    tuning_guidance = "Add pipeline and automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named network administrators to %global_allowed_admin_users. Consider raising severity for changes that open ingress from any source address if your parser exposes request parameters, and add that condition as a client-specific tuning step."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /(AuthorizeSecurityGroup(Ingress|Egress)|ModifySecurityGroupRules|CreateNetworkAclEntry|ReplaceNetworkAclEntry|DeleteNetworkAclEntry|DeleteSecurityGroup|CreateFirewallRule|compute\.firewalls\.(insert|patch|update|delete)|networkSecurityGroups\/securityRules\/(write|delete)|networkSecurityGroups\/(write|delete)|firewallPolicies\/(write|delete)|firewallPolicies\/rules\/(write|delete))/ nocase
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1686.001")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_calls = array_distinct($cloud.metadata.product_event_type)
    $target_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
