/*
  MITRE Technique : T1021.007 - Cloud Services
  Tactic(s)       : Lateral Movement
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:44:55.785810+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_007_External_SaaS_Login_Then_Permission_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an account that signs in to a cloud/SaaS service from an external (non-internal) source address and then performs a permission or role change within ten minutes. This pattern fits an adversary using valid or federated credentials to reach the cloud control plane and then expanding access. The rule uses identity audit events only, not process command lines."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.007"
    mitre_technique_name = "Remote Services: Cloud Services"
    log_prerequisites = "Requires identity provider sign-in logs (USER_LOGIN) and directory/audit logs (USER_CHANGE_PERMISSIONS) normalised to UDM, with principal.user.userid and principal.ip populated on both event types."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Administrators working remotely or over VPN split-tunnel who sign in and promptly adjust roles; helpdesk staff delegating access; onboarding automation using user-context tokens; just-in-time privileged access tools that grant roles immediately after sign-in."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users, automation identities to %global_allowed_service_accounts, and approved cloud service principals to %global_allowed_cloud_principals. Populate %rfc1918_internal with the address space of the client, since it is used to decide what counts as an external login. Raise the severity or risk score if the permission change targets privileged roles."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid = $user
    not $auth.principal.ip in %rfc1918_internal
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_cloud_principals

    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.principal.user.userid = $user
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_cloud_principals

    $auth.metadata.event_timestamp.seconds <= $perm.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1021.007")
    $primary_entity = array_distinct($user)
    $login_source_ips = array_distinct($auth.principal.ip)
    $perm_source_ips = array_distinct($perm.principal.ip)
    $permission_change_count = count($perm.metadata.id)

  condition:
    $auth and $perm
}
