/*
  MITRE Technique : T1558.001 - Golden Ticket
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:39:49.219074+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_001_Golden_Ticket_Unexpected_Parent_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects an Office application, web server, database service or print spooler spawning a shell or script interpreter whose command line references the krbtgt account together with ticket-forging parameters (encryption key type, SID, pass-the-ticket, ticket lifetime). This lineage plus argument combination indicates Golden Ticket forging launched from an exploited or abused process, and does not depend on a specific tool name."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.001"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Golden Ticket"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with full parent and child image paths and command lines (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Authorised red team or purple team exercises; AD administrators running KRBTGT password-reset scripts that are launched from a web-based admin portal or a database-driven automation job; identity management or PAM products that wrap PowerShell from a service host; security validation tooling."
    tuning_guidance = "Add approved automation parent processes to %global_allowed_script_hosts and approved admin tooling to %global_allowed_admin_tools. Scanners and authorised testing sources can be added to %global_allowed_scanners and the rule extended with an exclusion on them. For a specific web-based admin portal, exclude the parent by process name rather than by install path."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|sqlservr|mysqld|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /krbtgt/ nocase
    $proc.target.process.command_line = /[\/\-](rc4|aes256|aes128|ptt|sid|ticket|endin|renewmax|sids)\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1558.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
