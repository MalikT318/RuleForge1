/*
  MITRE Technique : T1518.002 - Backup Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:23:18.775893+00:00
  Reference       : https://attack.mitre.org/techniques/T1518/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_002_Linux_Backup_Software_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux process launch in which a filesystem search, package query, service listing, process listing or crontab command is combined with the names of common backup products (enterprise agents, open-source backup tools, snapshot tools). Adversaries, ransomware operators in particular, enumerate backup software before deleting or encrypting backups. The rule matches the combination of an enumeration utility or shell with a backup-product keyword, not a single payload."
    mitre_tactic = "Discovery"
    mitre_technique = "T1518.002"
    mitre_technique_name = "Software Discovery: Backup Software Discovery"
    log_prerequisites = "Requires Linux EDR or auditd (execve) process telemetry that populates target.process.command_line, target.process.file.full_path and the parent process path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup administrators checking agent status, configuration management and inventory agents (package and service audits), compliance and asset-discovery scripts, monitoring checks that verify backup services are running, and engineers troubleshooting backup jobs."
    tuning_guidance = "Add approved inventory, patching and configuration-management parent binaries to %global_allowed_admin_tools, backup agent parent processes to %global_allowed_backup_processes, and automation accounts to %global_allowed_service_accounts. Extend the keyword list only with products present in the client estate. Raise severity for hosts that do not run backup software or for interactive sessions from non-admin users."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|find|locate|mlocate|plocate|which|whereis|ls|grep|dpkg|rpm|apt|apt-cache|yum|dnf|snap|systemctl|pgrep|ps|crontab|docker)$/ nocase
    $proc.target.process.command_line = /\b(find|locate|mlocate|plocate|which|whereis|ls|grep|dpkg|rpm|apt|apt-cache|yum|dnf|snap|systemctl|pgrep|ps|crontab|docker)\b.*\b(veeam|veritas|netbackup|bacula|bareos|amanda|rsnapshot|restic|borg|borgbackup|duplicity|duplicati|timeshift|acronis|commvault|cohesity|rubrik|networker|dsmc|urbackup|backintime|clonezilla|vzdump)/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1518.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
