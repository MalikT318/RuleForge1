/*
  MITRE Technique : T1654 - Log Enumeration
  Tactic(s)       : Discovery
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:59:45.409611+00:00
  Reference       : https://attack.mitre.org/techniques/T1654
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1654_Linux_Log_Read_Then_Archive_Staging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a Linux host where a log-reading utility is run against sensitive system logs (authentication, audit, login records), followed within ten minutes by an archive or compression utility writing an archive into a world-writable staging directory (/tmp, /var/tmp, /dev/shm). This pattern indicates log enumeration followed by collection for exfiltration or offline analysis."
    mitre_tactic = "Discovery"
    mitre_technique = "T1654"
    mitre_technique_name = "Log Enumeration"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry with full command lines (PROCESS_LAUNCH), plus file creation telemetry with the creating process populated (FILE_CREATION)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators troubleshooting authentication problems and saving logs for a support ticket, log collection scripts run by support staff, sosreport or support-bundle generation, incident responders collecting evidence, and logrotate-style housekeeping jobs run manually."
    tuning_guidance = "Add approved admin and RMM binaries to %global_allowed_admin_tools, EDR and log agents to %global_allowed_security_tools, backup software to %global_allowed_backup_processes, and automation accounts to %global_allowed_service_accounts. Add named administrators to %global_allowed_admin_users. Widen or narrow the log path list in the first event to suit the client's logging layout."

  events:
    $log.metadata.event_type = "PROCESS_LAUNCH"
    $log.target.process.file.full_path = /\/(cat|grep|egrep|fgrep|zgrep|zcat|tail|head|less|more|strings|awk|sed|ausearch|aureport|utmpdump|lastb|last|lastlog)$/ nocase
    $log.target.process.command_line = /\/var\/log\/(auth\.log|secure|audit\/|syslog|messages|wtmp|btmp|lastlog|kern\.log|faillog|journal\/)|\/run\/log\/journal/ nocase
    not $log.principal.process.file.full_path in %global_allowed_admin_tools
    not $log.principal.process.file.full_path in %global_allowed_security_tools
    not $log.principal.user.userid in %global_allowed_service_accounts
    not $log.principal.user.userid in %global_allowed_admin_users
    $log.principal.hostname = $hostname

    $stage.metadata.event_type = "FILE_CREATION"
    $stage.principal.process.file.full_path = /\/(tar|zip|gzip|bzip2|xz|7z|7za|7zr|zstd)$/ nocase
    $stage.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+\.(tar|tgz|gz|zip|7z|bz2|xz|zst)$/ nocase
    not $stage.principal.process.file.full_path in %global_allowed_backup_processes
    not $stage.principal.process.file.full_path in %global_allowed_admin_tools
    not $stage.principal.user.userid in %global_allowed_service_accounts
    $stage.principal.hostname = $hostname

    $log.metadata.event_timestamp.seconds <= $stage.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1654")
    $primary_entity = array_distinct($hostname)
    $log_read_commands = array_distinct($log.target.process.command_line)
    $log_read_count = count($log.metadata.id)
    $staged_files = array_distinct($stage.target.file.full_path)
    $archive_tools = array_distinct($stage.principal.process.file.full_path)
    $acting_users = array_distinct($log.principal.user.userid)

  condition:
    $log and $stage
}
