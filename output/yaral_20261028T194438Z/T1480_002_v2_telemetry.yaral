/*
  MITRE Technique : T1480.002 - Mutual Exclusion
  Tactic(s)       : Stealth
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:27:03.457622+00:00
  Reference       : https://attack.mitre.org/techniques/T1480/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1480_002_Mutex_Marker_File_From_UserWritable_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a lock, mutex, or PID marker file in a user-writable location by a process that itself runs from a user-writable directory. Malware uses such marker files as a filesystem-based execution guard so only one instance runs per host. This detects the resulting file artifact rather than command-line activity or named mutex objects."
    mitre_tactic = "Stealth"
    mitre_technique = "T1480.002"
    mitre_technique_name = "Execution Guardrails: Mutual Exclusion"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with the initiating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-user installed applications that keep single-instance lock files (Electron-based apps, chat and collaboration clients, browser profile locks, developer tools, package managers, Git index locks), portable software run from Downloads or Desktop, and software installers staging lock files in ProgramData."
    tuning_guidance = "Add approved tools to %global_allowed_admin_tools and %global_allowed_security_tools. Extend the process-name exclusion regex with line-of-business apps seen in the client environment. Raise severity if the process is unsigned or recently created, or if the same host also shows suspicious network activity."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(programdata|users\\public|windows\\temp|users\\[^\\]+\\appdata\\(local|roaming|locallow))\\.*\.(lock|lck|mutex|mtx|pid|running)$/ nocase
    $file.principal.process.file.full_path = /\\(programdata|users\\public|windows\\temp|users\\[^\\]+\\(appdata|downloads|desktop))\\.*\.exe$/ nocase
    not $file.principal.process.file.full_path = /\\(chrome|msedge|firefox|brave|code|teams|ms-teams|slack|discord|onedrive|git|node|npm|python|pip)\.exe$/ nocase
    not $file.target.file.full_path = /\\(lockfile|parent\.lock|index\.lock|singletonlock)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1480.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $marker_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
