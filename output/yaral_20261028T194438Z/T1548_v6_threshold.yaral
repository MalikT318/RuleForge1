/*
  MITRE Technique : T1548 - Abuse Elevation Control Mechanism
  Tactic(s)       : Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:27:52.530528+00:00
  Reference       : https://attack.mitre.org/techniques/T1548
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_IaaS_Excessive_Permission_Changes_By_Single_Identity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single identity performs repeated permission or role changes in cloud audit logs within ten minutes. Individual permission changes are routine, but a burst from one actor is consistent with abuse of elevation controls, such as granting itself or other accounts higher privileges or assuming elevated roles, after account compromise."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548"
    mitre_technique_name = "Abuse Elevation Control Mechanism"
    log_prerequisites = "Requires cloud and identity audit logs (IAM or directory role and permission change events) normalised to UDM USER_CHANGE_PERMISSIONS with principal.user.userid populated."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Planned IAM or access-review clean-ups, onboarding or offboarding waves, infrastructure-as-code pipelines applying role bindings, identity governance automation, and break-glass administrators during change windows."
    tuning_guidance = "Add expected administrators to %global_allowed_admin_users, automation and pipeline identities to %global_allowed_service_accounts, and approved cloud service principals to %global_allowed_cloud_principals. Raise the #perm threshold for tenants with heavy IAM automation, or lower it for tenants with few administrators."

  events:
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.principal.user.userid != ""
    $perm.principal.user.userid = $user
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_cloud_principals

  match:
    $user over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1548")
    $primary_entity = array_distinct($user)
    $event_count = count($perm.metadata.id)
    $affected_users = array_distinct($perm.target.user.userid)
    $source_ips = array_distinct($perm.principal.ip)

  condition:
    #perm >= 5
}
