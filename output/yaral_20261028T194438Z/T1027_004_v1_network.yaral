/*
  MITRE Technique : T1027.004 - Compile After Delivery
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:43:01.767551+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_004_Source_Code_Download_For_Local_Compile {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host fetching uncompiled source or build-project files (C#, VB, IL, C/C++, MSBuild project files) over HTTP(S) from an external destination. Compile After Delivery payloads are shipped as text so they avoid binary scrutiny, then built locally with native compilers. This is the network-side delivery step. Risk is raised when the request comes from a scripting or command-line HTTP client rather than a browser."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.004"
    mitre_technique_name = "Obfuscated Files or Information: Compile After Delivery"
    log_prerequisites = "Requires forward-proxy or perimeter firewall logs with URL visibility (explicit proxy or TLS inspection) normalised to NETWORK_HTTP, including target.url and target.ip. User-agent is used for scoring only and is optional."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Developers and build engineers pulling source from public code-hosting or package sites, CI agents, software vendors distributing source samples, and admins fetching MSBuild or project files."
    tuning_guidance = "Add known-good code hosting, vendor and package domains to %global_allowed_domains. Add approved developer or build-server hostnames to %global_allowed_admin_tools if your parser populates principal.hostname. Developer subnets can be handled by a scoped exception. Review the user-agent outcome to separate scripted downloads (higher score) from browser downloads."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.target.url = /\.(cs|vb|il|cpp|cxx|cc|c|csproj|vbproj|proj|targets)(\?.*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_admin_tools

  outcome:
    $risk_score = max(if(re.regex($http.network.http.user_agent, /(?i)(powershell|bits|certutil|curl|wget|winhttp|python|go-http-client|java\/|msbuild|dotnet)/), 80, 55))
    $mitre_technique_id = array_distinct("T1027.004")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $destination_ips = array_distinct($http.target.ip)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
