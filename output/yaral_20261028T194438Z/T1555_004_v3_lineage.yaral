/*
  MITRE Technique : T1555.004 - Windows Credential Manager
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:57:57.401048+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_004_Anomalous_Parent_Credential_Manager_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects Windows Credential Manager enumeration or access launched from an unexpected parent process such as an Office application, web server worker, print spooler or database service. Native credential utilities or shells and script interpreters referencing Credential Locker or vault APIs spawned from these parents indicate document-macro, web-shell or service-exploitation tradecraft."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.004"
    mitre_technique_name = "Credentials from Password Stores: Windows Credential Manager"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path, child process path and command line populated (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Line-of-business Office add-ins or macros that legitimately read stored credentials, web applications or IIS-hosted admin tools that call credential utilities, database maintenance jobs run via a SQL service, and IT automation launched from these parents."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools and named administrators to %global_allowed_admin_users. Extend the parent regex with environment-specific web, database or print service executables if required."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Unexpected parent: Office, web server / app server, print spooler, database service
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|java|sqlservr|mysqld|spoolsv)\.exe$/ nocase

    // Child: native credential utility, or a shell/interpreter referencing credential store access
    (
      $proc.target.process.file.full_path = /\\(vaultcmd|cmdkey)\.exe$/ nocase or
      (
        $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|rundll32|mshta)\.exe$/ nocase and
        $proc.target.process.command_line = /(vaultcmd|cmdkey|PasswordVault|Windows\.Security\.Credentials|CredEnumerate|CredRead|vaultcli|keymgr|\.vcrd|Policy\.vpol)/ nocase
      )
    )

    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1555.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
