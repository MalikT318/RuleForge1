/*
  MITRE Technique : T1027.017 - SVG Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:06:22.832309+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/017
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_017_SVG_Large_Direct_Download_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows client browser directly fetching an unusually large SVG file (no referrer) from an external host that is not on the known-good domain list. Legitimate SVG icons and logos are small and are normally loaded as sub-resources of a page, so they carry a referrer. A large SVG with no referrer suggests a user following a phishing link to an SVG carrying embedded script or an encoded payload. This is network-level coverage that complements endpoint command-line rules and does not rely on process telemetry. The Windows scope is inferred from the client user-agent."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.017"
    mitre_technique_name = "Obfuscated Files or Information: SVG Smuggling"
    log_prerequisites = "Requires proxy or secure web gateway logs with URL, HTTP user-agent, referrer and received-bytes fields populated. TLS inspection is needed for HTTPS visibility into full URLs."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Design or marketing teams downloading large vector artwork, SaaS diagrams or infographics exported as SVG, internal documentation sites, direct navigation to SVG assets from bookmarks, and CDN-hosted maps."
    tuning_guidance = "Add trusted vendor and CDN domains to %global_allowed_domains. Raise or lower the received_bytes threshold to match each client's baseline for vector assets. Add known design or creative-team egress sources to %global_allowed_mgmt_sources if they cause recurring noise."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET"
    $net.network.http.response_code = 200
    $net.target.url = /\.svgz?(\?|#|$)/ nocase
    $net.network.http.user_agent = /Windows NT/ nocase
    $net.network.http.referral_url = ""
    $net.network.received_bytes > 150000
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1027.017")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $svg_urls = array_distinct($net.target.url)
    $destination_hosts = array_distinct($net.target.hostname)
    $max_received_bytes = max($net.network.received_bytes)

  condition:
    $net
}
