/*
  MITRE Technique : T1601.002 - Downgrade System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:15:55.533886+00:00
  Reference       : https://attack.mitre.org/techniques/T1601/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_002_Image_Transfer_Ports_Volume_Firewall {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single source repeatedly opens connections to external destinations on file-transfer ports typically used to pull OS images onto network devices (TFTP 69, FTP 21, FTPS 990) within 10 minutes. A device fetching an older image from an external server is a precursor to a system image downgrade. A single connection is benign, but repeated transfers from one source are not."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1601.002"
    mitre_technique_name = "Modify System Image: Downgrade System Image"
    log_prerequisites = "Firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Network device management traffic must traverse a logging enforcement point."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate vendor firmware upgrades fetched from external repositories during approved maintenance windows, scheduled configuration backups over FTP/TFTP to offsite servers, vulnerability scanners probing file-transfer ports, and legacy file-transfer integrations."
    tuning_guidance = "Add approved management or maintenance source hostnames to %global_allowed_mgmt_sources, and scanner sources to %global_allowed_scanners. Raise the #net threshold for environments with frequent offsite FTP backups. Correlate hits with device configuration-change logs (boot system or image changes) before escalating."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 69 or $net.target.port = 21 or $net.target.port = 990)
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_mgmt_sources
    not $net.principal.hostname in %global_allowed_scanners
    $net.principal.ip = $src

  match:
    $src over 10m

  outcome:
    $risk_score = max(if($net.target.port = 69, 80, 60))
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1601.002")
    $primary_entity = array_distinct($src)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 3
}
