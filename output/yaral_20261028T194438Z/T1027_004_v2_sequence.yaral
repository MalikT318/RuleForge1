/*
  MITRE Technique : T1027.004 - Compile After Delivery
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:43:21.368496+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_004_Linux_Source_Download_Then_Outbound_Callback {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a host that downloads raw source code (.c, .cpp, .go, .rs, .s and similar) over HTTP with a scripted client, then opens an outbound connection to an external address on a non-standard high port within five minutes. This pattern is consistent with a payload delivered as uncompiled code, compiled locally and then calling back. It uses perimeter telemetry only and does not depend on process command lines."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.004"
    mitre_technique_name = "Obfuscated Files or Information: Compile After Delivery"
    log_prerequisites = "Requires firewall or proxy logs normalised to UDM NETWORK_HTTP (with URL, method and user agent) and NETWORK_CONNECTION with a populated principal.ip. TLS-inspecting proxy is needed to see URLs for HTTPS downloads."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Developers and build servers fetching source files from external repositories or mirrors, CI/CD runners, package maintainers, and admins pulling code before connecting to a service on a high port, such as a dev or test API."
    tuning_guidance = "Add known-good source repositories and mirrors to %global_allowed_domains. Add build servers, CI runners and authorised scanners to %global_allowed_scanners, which excludes them by source IP. Adjust the allowed high ports in the connection event to match client service conventions."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET"
    $http.target.url = /\.(c|cc|cpp|cxx|go|rs|s|asm|m|swift)(\?.*)?$/ nocase
    $http.network.http.user_agent = /(curl|wget|python-requests|python-urllib|go-http-client|libwww-perl)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners
    $http.principal.ip = $src_ip

    $conn.metadata.event_type = "NETWORK_CONNECTION"
    not $conn.target.ip in %rfc1918_internal
    $conn.target.port > 1024
    $conn.target.port != 8080
    $conn.target.port != 8443
    not $conn.principal.ip in %global_allowed_scanners
    $conn.principal.ip = $src_ip

    $http.metadata.event_timestamp.seconds <= $conn.metadata.event_timestamp.seconds

  match:
    $src_ip over 5m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.004")
    $primary_entity = array_distinct($src_ip)
    $source_urls = array_distinct($http.target.url)
    $download_hosts = array_distinct($http.target.hostname)
    $callback_ips = array_distinct($conn.target.ip)
    $callback_ports = array_distinct($conn.target.port)
    $connection_count = count($conn.metadata.id)

  condition:
    $http and $conn
}
