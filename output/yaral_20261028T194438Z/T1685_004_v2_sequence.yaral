/*
  MITRE Technique : T1685.004 - Disable or Modify Linux Audit System Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:21:39.493419+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_004_Audit_Config_Tamper_Then_Audit_Log_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a modification of Linux Audit configuration or rule files (auditd.conf, audit.rules, rules.d, plugins.d) followed within 10 minutes by deletion of audit log files on the same host. The pairing indicates an adversary weakening audit coverage and then removing the evidence. The rule is file-telemetry based and does not rely on process command lines."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.004"
    mitre_technique_name = "Disable or Modify Linux Audit System Log"
    log_prerequisites = "Requires Linux EDR or auditd file telemetry that produces FILE_MODIFICATION and FILE_DELETION events with target.file.full_path and principal process populated. Watches on /etc/audit and /var/log/audit must be enabled."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management tools (Ansible, Puppet, Chef, Salt) pushing audit rules; package upgrades of the audit package; administrators rebuilding audit policy and manually purging old logs; log housekeeping scripts; CIS/STIG hardening runs."
    tuning_guidance = "Add approved configuration management and housekeeping binaries to %global_allowed_admin_tools, backup or imaging agents to %global_allowed_backup_processes, and automation accounts to %global_allowed_service_accounts. Auditd's own rotation (auditd, logrotate) is excluded by executable name."

  events:
    $cfg.metadata.event_type = "FILE_MODIFICATION"
    $cfg.target.file.full_path = /^\/etc\/(audit\/(auditd\.conf|audit\.rules|rules\.d\/[^\/]+|plugins\.d\/[^\/]+)|libaudit\.conf)$/ nocase
    not $cfg.principal.process.file.full_path in %global_allowed_admin_tools
    not $cfg.principal.user.userid in %global_allowed_service_accounts
    $cfg.principal.hostname = $hostname

    $del.metadata.event_type = "FILE_DELETION"
    $del.target.file.full_path = /^\/var\/log\/audit\/audit\.log(\.\d+)?$/ nocase
    not $del.principal.process.file.full_path = /\/(auditd|logrotate)$/ nocase
    not $del.principal.process.file.full_path in %global_allowed_admin_tools
    not $del.principal.process.file.full_path in %global_allowed_backup_processes
    $del.principal.hostname = $hostname

    $cfg.metadata.event_timestamp.seconds <= $del.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1685.004")
    $primary_entity = array_distinct($cfg.principal.hostname)
    $modified_config_files = array_distinct($cfg.target.file.full_path)
    $deleted_audit_logs = array_distinct($del.target.file.full_path)
    $config_modifying_processes = array_distinct($cfg.principal.process.file.full_path)
    $deleting_processes = array_distinct($del.principal.process.file.full_path)
    $acting_users = array_distinct($del.principal.user.userid)
    $deletion_count = count($del.metadata.id)

  condition:
    $cfg and $del
}
