/*
  MITRE Technique : T1048.001 - Exfiltration Over Symmetric Encrypted Non-C2 Protocol
  Tactic(s)       : Exfiltration
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:33:59.537776+00:00
  Reference       : https://attack.mitre.org/techniques/T1048/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1048_001_Linux_Multi_Destination_Encrypted_Upload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A single internal source host pushes large outbound volumes over SSH-family encrypted transfer ports (SSH/SCP/SFTP, alternate SSH, FTPS) to one external address and then, within 10 minutes, to a second, different external address. This pattern suggests bulk exfiltration over an encrypted non-C2 protocol to an alternate network location. Detection is purely network-observable and does not depend on process or command-line telemetry."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1048.001"
    mitre_technique_name = "Exfiltration Over Alternative Protocol: Exfiltration Over Symmetric Encrypted Non-C2 Protocol"
    log_prerequisites = "Perimeter firewall or proxy logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip, target.port and network.sent_bytes populated. Egress from Linux servers must traverse the logging device."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Offsite backup or replication jobs using SFTP/rsync over SSH to multiple providers, software mirror synchronisation, CI/CD artifact publishing, managed file transfer gateways, and administrators migrating data between cloud hosts."
    tuning_guidance = "Add approved backup, mirror and file-transfer source addresses to %global_allowed_mgmt_sources, and known-good destination hostnames to %global_allowed_domains. Raise or lower the sent_bytes thresholds per client baseline. Scope the rule to Linux server subnets via the client's asset context if the firewall also carries non-Linux egress."

  events:
    $a.metadata.event_type = "NETWORK_CONNECTION"
    ($a.target.port = 22 or $a.target.port = 2222 or $a.target.port = 990)
    $a.network.sent_bytes >= 5000000
    not $a.target.ip in %rfc1918_internal
    not $a.principal.ip in %global_allowed_mgmt_sources
    not $a.target.hostname in %global_allowed_domains
    $a.principal.ip = $src_ip

    $b.metadata.event_type = "NETWORK_CONNECTION"
    ($b.target.port = 22 or $b.target.port = 2222 or $b.target.port = 990)
    $b.network.sent_bytes >= 5000000
    not $b.target.ip in %rfc1918_internal
    not $b.principal.ip in %global_allowed_mgmt_sources
    not $b.target.hostname in %global_allowed_domains
    $b.principal.ip = $src_ip

    $a.target.ip != $b.target.ip
    $a.metadata.event_timestamp.seconds <= $b.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1048.001")
    $primary_entity = array_distinct($src_ip)
    $destination_ips_first = array_distinct($a.target.ip)
    $destination_ips_second = array_distinct($b.target.ip)
    $destination_ports = array_distinct($b.target.port)
    $max_bytes_sent_first = max($a.network.sent_bytes)
    $max_bytes_sent_second = max($b.network.sent_bytes)

  condition:
    $a and $b
}
