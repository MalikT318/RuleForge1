/*
  MITRE Technique : T1074 - Data Staged
  Tactic(s)       : Collection
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:16:49.034135+00:00
  Reference       : https://attack.mitre.org/techniques/T1074
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_ESXi_Shell_Transfer_Tool_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi host shell utility (scp, sftp, curl, wget, nc, ncat) opening an outbound connection to an external address. Hypervisors do not normally push data to the internet from an interactive shell. This is characteristic of staged datastore, VM or configuration data being moved off-host once collection and staging are complete."
    mitre_tactic = "Collection"
    mitre_technique = "T1074"
    mitre_technique_name = "Data Staged"
    log_prerequisites = "ESXi host network connection telemetry attributed to the originating process (e.g. host agent or syslog-forwarded shell and network events normalised to UDM NETWORK_CONNECTION with principal.process populated)."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators pulling patches, VIBs or ISO images with wget/curl from external repositories; support staff uploading diagnostic bundles to a vendor; approved backup or replication jobs; scripted monitoring that uses curl to reach an external SaaS endpoint."
    tuning_guidance = "Add approved backup and replication binaries to %global_allowed_backup_processes, approved management or jump sources to %global_allowed_mgmt_sources, automation accounts to %global_allowed_service_accounts, and approved admin tooling to %global_allowed_admin_tools. Consider restricting alerting to hosts where SSH or the shell is not expected to be enabled."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(scp|sftp|curl|wget|nc|ncat|netcat)$/ nocase
    $net.principal.hostname != ""
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1074")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $transfer_process = array_distinct($net.principal.process.file.full_path)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
