/*
  MITRE Technique : T1055.009 - Proc Memory
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:56:22.003730+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_009_Service_Parent_Spawns_Proc_Memory_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing or data-tier service process (web server, application server, database, print or file service) spawning dd, a shell or a script interpreter whose arguments reference /proc/<pid>/mem or /proc/<pid>/maps. Service processes do not normally launch children that read or write another process's memory through procfs. This lineage indicates proc memory injection (ROP stack overwrite via dd) following exploitation of the service."
    mitre_tactic = "Defense Evasion (Stealth), Privilege Escalation"
    mitre_technique = "T1055.009"
    mitre_technique_name = "Process Injection: Proc Memory"
    log_prerequisites = "Requires Linux EDR or auditd (execve) process-launch telemetry with parent process path, child process path and full command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Application servers or Java/Node runtimes running diagnostic or profiling scripts that read /proc/<pid>/maps, database or web-stack health-check scripts launched by the service, memory-debugging tools started by a service wrapper, and crash-dump handlers."
    tuning_guidance = "Add approved diagnostic or monitoring parents to %global_allowed_admin_tools or %global_allowed_script_hosts, and EDR or monitoring agents to %global_allowed_security_tools. If a runtime parent such as java or node is noisy, exclude it by parent path through a reference list rather than editing the regex. Review $parent_process and $child_command_line in the outcome during triage."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9.]*|php-cgi|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|smbd)$/ nocase
    $proc.target.process.file.full_path = /\/(dd|bash|sh|dash|zsh|ksh|python[0-9.]*|perl|ruby)$/ nocase
    $proc.target.process.command_line = /\/proc\/(self|thread-self|[0-9]+)\/(mem|maps)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.009")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
