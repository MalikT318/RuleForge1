/*
  MITRE Technique : T1557.004 - Evil Twin
  Tactic(s)       : Credential Access, Collection
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:35:58.775688+00:00
  Reference       : https://attack.mitre.org/techniques/T1557/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1557_004_Evil_Twin_Client_DNS_Bypass_To_External_Resolver {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a client sending DNS (UDP/TCP 53) or DNS-over-TLS (853) directly to an external address through the perimeter. Clients that associate with an evil twin Wi-Fi access point often receive attacker-controlled DHCP and DNS settings, or have their resolution redirected to a rogue resolver. The result is DNS traffic that bypasses the corporate resolvers and is seen at the firewall. This is a network-side indicator of the post-association behaviour, not proof of a rogue access point. Treat it as a lead to correlate with wireless controller rogue-AP alerts and the client's recent DHCP and association history."
    mitre_tactic = "Credential Access, Collection"
    mitre_technique = "T1557.004"
    mitre_technique_name = "Adversary-in-the-Middle: Evil Twin"
    log_prerequisites = "Firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Egress DNS must be logged. The rule is only meaningful where the corporate policy forces DNS through internal resolvers."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Roaming or remote users on split-tunnel VPN using public or ISP resolvers, BYOD or guest segments allowed to use public DNS, internal recursive resolvers forwarding to upstream DNS, IoT or printer devices with hardcoded public resolvers, DNS monitoring and health-check probes."
    tuning_guidance = "Add the addresses of internal recursive resolvers, DNS forwarders and approved guest or BYOD gateways to %global_allowed_mgmt_sources. Keep %rfc1918_internal current so internal-to-internal DNS is excluded. Where policy permits public DNS from some segments, scope the rule to corporate segments or suppress by source range in the SIEM. Correlate hits with wireless controller rogue-AP or deauthentication events."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 53 or $net.target.port = 853)
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1557.004")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
