/*
  MITRE Technique : T1027.012 - LNK Icon Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:57:03.144700+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_012_LNK_Dropped_Then_Explorer_External_Icon_Fetch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a .lnk shortcut written to a user-writable delivery location (Downloads, Temp, mail or browser cache) followed within 5 minutes by explorer.exe opening an outbound HTTP or SMB connection to an external address on the same host. Explorer renders the shortcut icon and fetches a remote icon location (URL or UNC path), which is the behaviour behind LNK icon smuggling. This is file and network correlation, not command-line matching."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.012"
    mitre_technique_name = "Obfuscated Files or Information: LNK Icon Smuggling"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon EID 11) and network-connection telemetry (Sysmon EID 3) with process attribution for explorer.exe."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Shortcuts extracted from legitimate archives or installers that reference remote icon or share resources; users browsing external WebDAV or SMB shares; explorer.exe connections to cloud storage providers on port 80 or 445 shortly after a shortcut is saved; software deployment tools that drop shortcuts."
    tuning_guidance = "Add approved deployment or packaging tools that write .lnk files to %global_allowed_admin_tools. Add known-good external destination domains to %global_allowed_domains. If port 80 is noisy in a client environment, narrow the network event to port 445 only."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.lnk$/ nocase
    $file.target.file.full_path = /\\users\\[^\\]+\\(downloads\\|appdata\\local\\temp\\|appdata\\local\\microsoft\\windows\\inetcache\\|appdata\\local\\microsoft\\windows\\temporary internet files\\|appdata\\local\\microsoft\\outlook\\)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\explorer\.exe$/ nocase
    ($net.target.port = 80 or $net.target.port = 445)
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    $net.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1027.012")
    $primary_entity = array_distinct($hostname)
    $lnk_paths = array_distinct($file.target.file.full_path)
    $lnk_writer_processes = array_distinct($file.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $affected_users = array_distinct($file.principal.user.userid)

  condition:
    $file and $net
}
