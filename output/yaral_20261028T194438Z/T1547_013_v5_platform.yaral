/*
  MITRE Technique : T1547.013 - XDG Autostart Entries
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:41:03.433447+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_013_XDG_Autostart_Desktop_File_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a .desktop file in a system-wide (/etc/xdg/autostart) or per-user (~/.config/autostart) XDG autostart directory by a process other than a package manager or approved admin tooling. Adversaries use these entries to run a payload each time the user's desktop session loads. This rule uses file-creation telemetry rather than process command lines, so it also catches entries written by scripts, editors, or custom implants."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.013"
    mitre_technique_name = "Boot or Logon Autostart Execution: XDG Autostart Entries"
    log_prerequisites = "Requires Linux EDR file-event telemetry or auditd watches (-w /etc/xdg/autostart -p wa) with file creation events normalised to UDM FILE_CREATION. Per-user paths require visibility of /home and /root."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers installing desktop applications (dpkg, rpm, apt, dnf, snap, flatpak); desktop environment tools such as gnome-tweaks or session settings dialogs when users enable 'start at login'; user-installed applications (chat clients, cloud sync, VPN clients) registering their own autostart entry on first run; configuration management (Ansible, Puppet, Chef) deploying approved autostart files; VDI or golden-image build pipelines."
    tuning_guidance = "Add approved deployment or configuration-management binaries to %global_allowed_admin_tools. Add approved IT automation hosts to %global_allowed_script_hosts. Extend the package-manager and desktop-tool regex with client-specific installers. Raise severity for /etc/xdg/autostart or /root/.config/autostart, or for servers where no desktop session is expected."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/etc\/xdg\/autostart\/|\/home\/[^\/]+\/\.config\/autostart\/|\/root\/\.config\/autostart\/).+\.desktop$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|rpm|apt|apt-get|aptitude|dnf|yum|zypper|packagekitd|snapd|flatpak|gnome-tweaks|gnome-session-properties|systemd-xdg-autostart-generator)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1547.013")
    $primary_entity = array_distinct($file.principal.hostname)
    $autostart_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_command_line = array_distinct($file.principal.process.command_line)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
