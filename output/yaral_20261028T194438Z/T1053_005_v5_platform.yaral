/*
  MITRE Technique : T1053.005 - Scheduled Task
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:16:57.926813+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_005_TaskCache_Registry_Write_By_NonScheduler {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process other than the Task Scheduler service writing to the Task Scheduler TaskCache registry hive (Tree, Tasks, Plain, Logon, Boot). Legitimate task registration is performed by the Schedule service hosted in svchost. Writes from any other process indicate scheduled-task creation or tampering that bypasses schtasks.exe, such as direct registry manipulation, a .NET or COM wrapper, WMI, or an injected implant. This rule is registry-based and has no command-line dependency, so it complements existing process-creation rules. Scoped to Windows endpoint telemetry because the platform requirement is mandatory."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.005"
    mitre_technique_name = "Scheduled Task/Job: Scheduled Task"
    log_prerequisites = "Requires Windows endpoint telemetry with registry modification auditing (EDR or Sysmon registry events) that populates the writing process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters that register tasks through unusual host processes, system servicing (TiWorker, TrustedInstaller), imaging or profile-migration tools, RMM and deployment agents, and EDR agents that restore or inspect the task cache."
    tuning_guidance = "Add approved deployment and RMM binary paths to %global_allowed_admin_tools and endpoint security agents to %global_allowed_security_tools. Review the writing process and task name in the outcome fields. Tune the process-name exclusion regex if the environment has a legitimate servicing process that registers tasks."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Schedule\\TaskCache\\(Tree|Tasks|Plain|Logon|Boot|Maintenance)\\/ nocase
    $reg.principal.process.file.full_path != ""
    not $reg.principal.process.file.full_path = /\\(svchost|taskhostw|services|TiWorker|TrustedInstaller|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1053.005")
    $primary_entity = array_distinct($reg.principal.hostname)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
