/*
  MITRE Technique : T1036.007 - Double File Extension
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:07:23.547866+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_007_Double_Extension_Executable_File_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a file on disk whose name ends in a document, image or archive extension immediately followed by an executable or script extension (for example Invoice.pdf.exe or Report.docx .scr). This is the file artifact left behind by double-extension masquerading, and it fires regardless of how the file was written or what the command line looked like."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.007"
    mitre_technique_name = "Masquerading: Double File Extension"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software packagers or build pipelines that produce files such as readme.txt.exe; installers that extract renamed helpers; email gateways or archive utilities writing quarantined or extracted attachments; developers testing file-type handling; security awareness or phishing simulation tooling."
    tuning_guidance = "Add approved build, packaging and deployment binaries to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. If a client has a recurring legitimate naming pattern, narrow it by adding the writing process to the allowlist rather than weakening the extension regex. Consider raising severity when the file is created under user-writable download, temp or desktop locations."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(doc|docx|docm|xls|xlsx|xlsm|ppt|pptx|rtf|txt|csv|pdf|jpg|jpeg|png|gif|bmp|mp3|mp4|zip|htm|html)\s*\.(exe|scr|com|pif|bat|cmd|js|jse|vbs|vbe|wsf|hta|ps1|jar)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1036.007")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
