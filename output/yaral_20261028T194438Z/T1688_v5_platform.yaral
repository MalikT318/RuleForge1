/*
  MITRE Technique : T1688 - Safe Mode Boot
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:36:15.859302+00:00
  Reference       : https://attack.mitre.org/techniques/T1688
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1688_SafeBoot_Registry_Minimal_Service_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modification of the SafeBoot Minimal/Network service lists or the SafeBoot AlternateShell value. Adversaries use these changes so a malicious service or shell still loads after the host is forced into safe mode, where EDR and other defenses may not start. This is registry-based coverage and does not depend on process command lines such as bcdedit."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1688"
    mitre_technique_name = "Safe Mode Boot"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon registry events) normalised to REGISTRY_MODIFICATION, covering HKLM\\SYSTEM\\*\\Control\\SafeBoot."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Security or backup agents registering their driver/service to load in safe mode, driver installers, Windows servicing (TrustedInstaller, msiexec), and admins deliberately setting AlternateShell for recovery."
    tuning_guidance = "Add legitimate security agents to %global_allowed_security_tools and deployment or driver-install tooling to %global_allowed_admin_tools. Add trusted installer accounts to %global_allowed_service_accounts. Review recurring hits by writing process before excluding."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      $reg.target.registry.registry_key = /\\Control\\SafeBoot\\(Minimal|Network)\\[^\\]+/ nocase
      or
      (
        $reg.target.registry.registry_key = /\\Control\\SafeBoot$/ nocase
        and $reg.target.registry.registry_value_name = "AlternateShell" nocase
      )
    )
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|msiexec)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1688")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_name)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $acting_users = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
