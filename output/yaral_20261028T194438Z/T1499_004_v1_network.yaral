/*
  MITRE Technique : T1499.004 - Application or System Exploitation
  Tactic(s)       : Impact
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:22:01.588530+00:00
  Reference       : https://attack.mitre.org/techniques/T1499/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1499_004_Inbound_Anomalous_DNS_Query_Type_Server_Crash {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source sending DNS queries with question types that should never appear in normal client lookups (TKEY, TSIG, OPT in the question section). These meta-type queries are characteristic of attempts to trigger assertion failures or parser crashes in DNS server software (application or system exploitation for DoS). Observed from the network side only, with no endpoint process data."
    mitre_tactic = "Impact"
    mitre_technique = "T1499.004"
    mitre_technique_name = "Endpoint Denial of Service: Application or System Exploitation"
    log_prerequisites = "Requires firewall, DNS-aware perimeter or DNS proxy logs normalised to UDM NETWORK_DNS with network.dns.questions.type populated. The perimeter device must see inbound DNS traffic towards Linux-hosted DNS servers."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and DNS conformance or fuzz testing, legitimate dynamic-update or secret-key negotiation (TKEY/TSIG) between trusted external DNS peers, and misconfigured or experimental third-party resolvers."
    tuning_guidance = "Add authorised scanner and test source addresses to %global_allowed_scanners. Add trusted external DNS peers that legitimately use TKEY/TSIG to %global_allowed_mgmt_sources. If perimeter logs are NATed, confirm principal.ip holds the original external client address. Raise severity where the target is a known authoritative or recursive DNS server."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    (
      $dns.network.dns.questions.type = 249 or
      $dns.network.dns.questions.type = 250 or
      $dns.network.dns.questions.type = 41
    )
    not $dns.principal.ip in %rfc1918_internal
    not $dns.principal.ip in %global_allowed_scanners
    not $dns.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1499.004")
    $primary_entity = array_distinct($dns.target.ip)
    $source_ips = array_distinct($dns.principal.ip)
    $query_types = array_distinct($dns.network.dns.questions.type)

  condition:
    $dns
}
