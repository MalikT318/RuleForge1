/*
  MITRE Technique : T1665 - Hide Infrastructure
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:05:00.636762+00:00
  Reference       : https://attack.mitre.org/techniques/T1665
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1665_DNS_Long_HighEntropy_Label_Hidden_Infra {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries for names containing a very long, machine-generated-looking subdomain label (32+ characters with a long run of consonants and digits). This is characteristic of algorithmically generated or per-victim unique hostnames used to mask C2 infrastructure, evade reputation lookups and defeat blocklists. Known-good parent domains are excluded via reference list."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1665"
    mitre_technique_name = "Hide Infrastructure"
    log_prerequisites = "DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name populated. Answer data (network.dns.answers.data) improves internal-resolution filtering but is not required."
    platform = "Windows"
    log_source = "dns"
    false_positives = "CDN and cloud-provider hostnames with long hash-like labels, DKIM/DMARC and other security-service lookups, software update and telemetry services, anti-malware cloud lookups, email security gateways, and DNS-based blocklist queries."
    tuning_guidance = "Add legitimate parent domains (for example CDN or vendor domains) to %global_allowed_domains. Add resolvers, scanners and sensors that legitimately generate such lookups to %global_allowed_scanners. Raise the label length threshold from 32 to 40 or more for noisy tenants."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(^|\.)[a-z0-9-]{32,}\./ nocase
    $dns.network.dns.questions.name = /[bcdfghjklmnpqrstvwxyz0-9]{10,}/ nocase
    $domain = re.capture(strings.to_lower($dns.network.dns.questions.name), "([^.]+[.][^.]+)$")
    not $domain in %global_allowed_domains
    not $dns.network.dns.answers.data in %rfc1918_internal
    not $dns.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1665")
    $primary_entity = array_distinct(strings.coalesce($dns.principal.hostname, $dns.principal.ip))
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $parent_domains = array_distinct($domain)

  condition:
    $dns
}
