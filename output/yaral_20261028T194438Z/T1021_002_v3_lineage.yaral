/*
  MITRE Technique : T1021.002 - SMB/Windows Admin Shares
  Tactic(s)       : Lateral Movement
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:36:38.125607+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_002_Remote_Exec_Parent_Spawns_Shell_Admin_Share {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a remote-execution parent process (WMI provider host, Service Control Manager or MMC/DCOM) spawning a shell or script interpreter whose command line references a UNC administrative share (C$, ADMIN$, IPC$, or another drive-letter share). This lineage matches SMB-based lateral movement where output or payloads are staged over admin shares (WMI-style or service-based remote execution). The rule keys on the unexpected parent-child relationship and requires the admin-share reference as a lateral-movement discriminator."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.002"
    mitre_technique_name = "Remote Services: SMB/Windows Admin Shares"
    log_prerequisites = "Requires EDR or Sysmon process-creation telemetry with parent process path and full child command line populated (Sysmon Event ID 1 or Windows Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate remote administration, software deployment and patching agents that run through WMI or services and write output to admin shares; vulnerability scanners with authenticated checks; admin scripts using remote WMI; backup or monitoring agents that run shell wrappers against UNC paths."
    tuning_guidance = "Add approved deployment, RMM and patching parent binaries to %global_allowed_admin_tools or %global_allowed_remote_mgmt. Add automation accounts to %global_allowed_service_accounts. If a specific parent is noisy, narrow the parent regex or exclude it by executable name rather than path."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(wmiprvse|services|mmc)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /\\\\[^\\\s"']+\\(admin|ipc|[a-z])\$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1021.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
