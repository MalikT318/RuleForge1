/*
  MITRE Technique : T1140 - Deobfuscate/Decode Files or Information
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:10:01.460780+00:00
  Reference       : https://attack.mitre.org/techniques/T1140
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1140_Certutil_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Windows certificate utility (certutil) initiating a network connection to a non-internal address. Adversaries use certutil to pull down encoded payloads (for example via -urlcache or -verifyctl) and then decode them locally with -decode. Legitimate certutil network use is rare and mostly limited to CRL/AIA retrieval, so an outbound connection from this binary is a strong staging indicator. This is the network-side view and complements endpoint command-line detections."
    mitre_tactic = "Stealth"
    mitre_technique = "T1140"
    mitre_technique_name = "Deobfuscate/Decode Files or Information"
    log_prerequisites = "Requires EDR or Sysmon network telemetry (Sysmon Event ID 3 equivalent) that populates the initiating process path on NETWORK_CONNECTION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Certificate revocation list (CRL) or AIA chain retrieval during certificate validation, PKI administrators running certutil -urlcache or -ping against public CAs, certificate enrollment and troubleshooting scripts, software packaging or deployment tasks."
    tuning_guidance = "Add approved PKI and administrator accounts to %global_allowed_admin_users. Add known public CA, CRL and OCSP domains to %global_allowed_domains. Ensure %rfc1918_internal covers all internal address space for the client. If CRL noise is high, consider restricting to non-standard destination ports or correlating with endpoint command-line detections."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\certutil\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.user.userid in %global_allowed_admin_users
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1140")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_user = array_distinct($net.principal.user.userid)
    $process_command_line = array_distinct($net.principal.process.command_line)

  condition:
    $net
}
