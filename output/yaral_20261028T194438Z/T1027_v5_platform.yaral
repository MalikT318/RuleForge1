/*
  MITRE Technique : T1027 - Obfuscated Files or Information
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Network Devices
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:37:11.568561+00:00
  Reference       : https://attack.mitre.org/techniques/T1027
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_IPS_Obfuscated_HTTP_Request_URL {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects HTTP requests seen by a network security appliance whose URL carries obfuscated content in transit: repeated double URL-encoding (%25xx sequences) used to evade inspection signatures, or an oversized base64-style blob embedded in the path or query string. Covers obfuscation on the wire for Network Devices rather than on the endpoint."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027"
    mitre_technique_name = "Obfuscated Files or Information"
    log_prerequisites = "Requires IDS/IPS or network security appliance HTTP inspection logs normalised to UDM NETWORK_HTTP with target.url populated (URL logging or SSL inspection enabled)."
    platform = "Network Devices"
    log_source = "ips"
    false_positives = "Web applications that legitimately pass signed tokens (JWT, SAML, OAuth state), tracking or analytics beacons with large encoded parameters, CDN and software-update URLs with long opaque identifiers, and web application scanners or penetration tests."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains and authorised scanner sources to %global_allowed_scanners. If token-heavy SaaS traffic is noisy, raise the base64 length from 256 or the double-encoding repeat count from 3."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url != ""
    (
      $net.target.url = /(%25[0-9a-f]{2}.*){3,}/ nocase or
      $net.target.url = /[A-Za-z0-9+\/_-]{256,}={0,2}/
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1027")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
