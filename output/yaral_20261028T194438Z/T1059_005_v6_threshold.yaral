/*
  MITRE Technique : T1059.005 - Visual Basic
  Tactic(s)       : Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:13:58.590087+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_005_Linux_VBScript_Staging_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several VBScript-family files (.vbs, .vbe, .wsf, .vba) are created in world-writable, user-writable or web-served staging locations on one Linux host within ten minutes. Any single drop is rare and often benign, but a burst indicates payload staging for a Windows-script interpreter on Linux (for example Wine-hosted wscript/cscript), or a Linux host being used as a staging or relay point for VB payloads."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.005"
    mitre_technique_name = "Command and Scripting Interpreter: Visual Basic"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-creation events normalised to UDM FILE_CREATION with target.file.full_path and principal.hostname populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers or admins who handle Windows script samples or Windows deployment content on Linux file servers; web or file-share hosts storing legitimate .vbs or .wsf content for Windows clients; Wine or Mono development workflows; Windows software repositories or sync jobs; security researchers and malware analysis sandboxes."
    tuning_guidance = "Add approved deployment or sync tooling to %global_allowed_admin_tools, and approved script-handling hosts or parent processes to %global_allowed_script_hosts. Raise the #file threshold for file-server or build hosts, and drop /srv or /var/www from the path regex on hosts that legitimately serve Windows scripts."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/user|home|root|var\/www|srv)\/.*\.(vbs|vbe|wsf|vba)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|yum|dnf|snapd|unattended-upgrade)$/ nocase

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1059.005")
    $primary_entity = array_distinct($host)
    $file_count = count($file.metadata.id)
    $distinct_files = count_distinct($file.target.file.full_path)
    $sample_paths = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
