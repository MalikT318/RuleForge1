/*
  MITRE Technique : T1552.003 - Shell History
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:49:49.850114+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_003_Linux_Shell_History_Mass_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects multiple reads of shell history files (bash, zsh, sh, ksh, fish) on a single Linux host within ten minutes by a process other than an interactive shell. A single read is routine, but repeated reads indicate harvesting of credentials typed on command lines."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.003"
    mitre_technique_name = "Unsecured Credentials: Shell History"
    log_prerequisites = "Requires Linux EDR file-read telemetry or auditd file-watch rules (-w on history files, or openat/read syscall auditing) normalised to UDM FILE_READ."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup and imaging agents, endpoint security agents scanning home directories, configuration management or inventory tooling, forensic or compliance collection scripts, and admins auditing history files."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes, EDR/AV binaries to %global_allowed_security_tools, RMM and inventory tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Raise the #file threshold on hosts with heavy legitimate scanning. Escalate severity when the reading account differs from the history file owner."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /\/(\.(bash|zsh|sh|ksh)_history|\.local\/share\/fish\/fish_history)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\/(bash|zsh|sh|dash|ksh|fish)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1552.003")
    $primary_entity = array_distinct($host)
    $history_files_read = array_distinct($file.target.file.full_path)
    $reading_processes = array_distinct($file.principal.process.file.full_path)
    $reading_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
