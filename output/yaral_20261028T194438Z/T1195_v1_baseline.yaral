/*
  MITRE Technique : T1195 - Supply Chain Compromise
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:37:24.860841+00:00
  Reference       : https://attack.mitre.org/techniques/T1195
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_Linux_Package_Manager_Spawns_Download_Execute_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a package manager or language dependency installer (npm, pip, gem, dpkg, rpm, etc.) spawning a shell whose command line performs download-and-execute, encoded payload decoding into a shell, a reverse shell, or staging from world-writable directories. This is the typical execution stage of a trojanized package or poisoned dependency install hook."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195"
    mitre_technique_name = "Supply Chain Compromise"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve events that populate the parent process path, child process path and full command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate packages whose install scripts fetch installers with curl or wget piped to a shell (some vendor repo setup scripts, language toolchain bootstrappers), CI/CD build agents, and developer workstations installing tooling."
    tuning_guidance = "Add approved package tooling or build wrapper paths to %global_allowed_admin_tools, CI/build service accounts to %global_allowed_service_accounts, and build or developer hosts to %global_allowed_script_hosts. Review the command line outcome to identify recurring benign install hooks before excluding."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(npm|npx|yarn|pnpm|node|pip|pip3|python|python3|gem|bundle|composer|cargo|go|dpkg|apt|apt-get|yum|dnf|rpm|zypper|snap)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ash)$/ nocase
    (
      $proc.target.process.command_line = /(curl|wget)\s[^|;]*\|\s*(sudo\s+)?(\/\S*\/)?(ba|da|z|a)?sh\b/ nocase or
      $proc.target.process.command_line = /base64\s+(-d|--decode)[^|]*\|\s*(sudo\s+)?(\/\S*\/)?(ba|da|z|a)?sh\b/ nocase or
      $proc.target.process.command_line = /\/dev\/(tcp|udp)\// nocase or
      $proc.target.process.command_line = /\b(nc|ncat|netcat)\b.*\s-(e|c)\s/ nocase or
      $proc.target.process.command_line = /(curl|wget)\s.*(\/tmp|\/var\/tmp|\/dev\/shm)\/\S+.*(chmod\s+\+?[0-7]*x|;\s*\/(tmp|var\/tmp|dev\/shm)\/)/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1195")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
