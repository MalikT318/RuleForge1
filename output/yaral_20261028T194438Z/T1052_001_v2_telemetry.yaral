/*
  MITRE Technique : T1052.001 - Exfiltration over USB
  Tactic(s)       : Exfiltration
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:42:39.764549+00:00
  Reference       : https://attack.mitre.org/techniques/T1052/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1052_001_Archive_Staged_To_Removable_Drive_Letter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of archive, database, mailbox, credential-vault or disk-image files on a non-system drive letter (D: to Z:), the typical state change when data is staged or copied to a USB removable volume. Works at the file-artifact layer, so it still fires when command-line logging is evaded (drag-and-drop in Explorer, API-based copy, renamed tooling)."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1052.001"
    mitre_technique_name = "Exfiltration Over Physical Medium: Exfiltration over USB"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) that populates target.file.full_path with the drive-letter path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and imaging software writing to secondary or external disks, users saving archives to secondary fixed partitions or mapped network drives, IT staff building deployment media, software installers extracting to a data drive, and approved USB-based file transfer workflows."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes, IT tooling to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. On hosts where D: or later letters are fixed data volumes, tune by host or by the writing process, or restrict the drive-letter range to the removable-media letters used in the environment."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^[d-z]:\\.+\.(zip|rar|7z|tar|gz|tgz|pst|ost|bak|sql|mdb|accdb|kdbx|vhd|vhdx|csv)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1052.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $user = array_distinct($file.principal.user.userid)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $staged_file = array_distinct($file.target.file.full_path)

  condition:
    $file
}
