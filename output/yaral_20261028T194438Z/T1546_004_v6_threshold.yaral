/*
  MITRE Technique : T1546.004 - Unix Shell Configuration Modification
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:06:40.741342+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_004_Shell_Config_Mass_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated modification of Unix shell startup and logout configuration files (/etc/profile, /etc/profile.d/*, /etc/bash.bashrc, ~/.bashrc, ~/.bash_profile, ~/.profile, ~/.zshrc, etc.) on a single Linux host within 10 minutes. A single edit is routine, but a burst of writes across these files indicates persistence being planted so that commands run at every shell launch or login. Risk score is raised when system-wide files under /etc are touched."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.004"
    mitre_technique_name = "Event Triggered Execution: Unix Shell Configuration Modification"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules (-w on /etc/profile, /etc/profile.d, /etc/bash.bashrc, and home-directory shell rc files) normalised to UDM FILE_MODIFICATION with principal.hostname and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers updating /etc/profile.d scripts, configuration management runs (Ansible, Puppet, Chef, Salt) pushing shell profiles, administrators or developers editing dotfiles, dotfile sync tools, user provisioning and onboarding scripts, environment managers (nvm, pyenv, conda, sdkman) appending init lines to rc files."
    tuning_guidance = "Add approved configuration management and deployment binaries to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and EDR/AV agents to %global_allowed_security_tools. Raise the #file threshold for developer workstations or hosts with frequent dotfile syncing. Lower it on servers where shell configs rarely change."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /(^|\/)\.(bashrc|bash_profile|bash_login|bash_logout|profile|zshrc|zshenv|zprofile|zlogin|zlogout|kshrc|cshrc|tcshrc)$|^\/etc\/(profile|bash\.bashrc|bashrc|bash\.bash_logout|zshrc|zshenv|zprofile|zlogin|zsh\/[a-z_]+|csh\.cshrc|csh\.login)$|^\/etc\/profile\.d\/[^\/]+$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|yum|dnf|zypper|snapd|packagekitd|unattended-upgrade)$/ nocase

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($file.target.file.full_path = /^\/etc\//, 80, 60))
    $event_count = count($file.metadata.id)
    $modified_files = array_distinct($file.target.file.full_path)
    $modifying_processes = array_distinct($file.principal.process.file.full_path)
    $modifying_users = array_distinct($file.principal.user.userid)
    $mitre_technique_id = array_distinct("T1546.004")
    $primary_entity = array_distinct($host)

  condition:
    #file >= 4
}
