/*
  MITRE Technique : T1574.011 - Services Registry Permissions Weakness
  Tactic(s)       : Stealth, Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:42:46.998271+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_011_Service_Registry_ImagePath_Modification_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Several modifications to Windows service execution parameters (ImagePath, ServiceDll, FailureCommand) under the Services registry hive occur on a single host within ten minutes. A single change is routine, but repeated changes by a non-approved process indicate service registry hijacking for persistence or privilege escalation. Scales with the number of distinct service keys touched."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.011"
    mitre_technique_name = "Hijack Execution Flow: Services Registry Permissions Weakness"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event IDs 12/13/14 equivalent) normalised to REGISTRY_MODIFICATION with registry key and, where available, value name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters, driver installation, patching and deployment tooling, RMM agents, and administrators reconfiguring services in bulk, such as during application upgrades or image builds."
    tuning_guidance = "Add approved deployment, patching and RMM binaries to %global_allowed_admin_tools and endpoint security agents to %global_allowed_security_tools. Raise the #reg threshold for build or imaging hosts. Review the initiating process and the distinct service keys in the outcome fields."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(CurrentControlSet|ControlSet00\d)\\Services\\[^\\]+/ nocase
    (
      $reg.target.registry.registry_value_name = /^(ImagePath|ServiceDll|FailureCommand)$/ nocase or
      $reg.target.registry.registry_key = /\\(ImagePath|ServiceDll|FailureCommand)$/ nocase
    )
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1574.011")
    $primary_entity = array_distinct($host)
    $event_count = count($reg.metadata.id)
    $distinct_service_keys = count_distinct($reg.target.registry.registry_key)
    $modified_keys = array_distinct($reg.target.registry.registry_key)
    $initiating_processes = array_distinct($reg.principal.process.file.full_path)
    $initiating_users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 3
}
