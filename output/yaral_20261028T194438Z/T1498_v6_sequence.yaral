/*
  MITRE Technique : T1498 - Network Denial of Service
  Tactic(s)       : Impact
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:09:22.988194+00:00
  Reference       : https://attack.mitre.org/techniques/T1498
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_Container_Egress_Connection_Burst_Then_Volumetric_Flow {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a container, pod or node source address that opens a burst of outbound connections to a single external destination and then sends a large volume of data to that same destination within 10 minutes. This pattern is consistent with a compromised containerized workload acting as a network DoS (flood) source. Detection is based only on perimeter firewall telemetry."
    mitre_tactic = "Impact"
    mitre_technique = "T1498"
    mitre_technique_name = "Network Denial of Service"
    log_prerequisites = "Requires perimeter firewall or proxy connection and flow logs normalized to UDM, including source IP, destination IP and sent bytes. Container or pod egress must be visible to the firewall, either with the pod IP preserved or through the node or NAT gateway IP."
    platform = "Containers"
    log_source = "firewall"
    false_positives = "Legitimate bulk egress from containers such as image registry pushes or pulls, backup or log shipping jobs, CI/CD artifact uploads, data replication, load or performance testing, and web crawlers or API integrators that open many connections to one external service."
    tuning_guidance = "Add approved load-test and security-scanner source addresses to %global_allowed_scanners. Raise the connection count in the condition (#conn) or the sent_bytes threshold for high-egress environments. If the node NAT address hides pod identity, tune per cluster egress IP. Internal destinations are already excluded via %rfc1918_internal."

  events:
    $conn.metadata.event_type = "NETWORK_CONNECTION"
    $conn.network.ip_protocol = "TCP"
    not $conn.target.ip in %rfc1918_internal
    not $conn.principal.ip in %global_allowed_scanners
    $conn.principal.ip = $src
    $conn.target.ip = $dst

    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.network.sent_bytes > 10000000
    not $flow.target.ip in %rfc1918_internal
    not $flow.principal.ip in %global_allowed_scanners
    $flow.principal.ip = $src
    $flow.target.ip = $dst

    $conn.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $src, $dst over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1498")
    $primary_entity = array_distinct($src)
    $destination_ips = array_distinct($dst)
    $connection_count = count($conn.metadata.id)
    $flow_count = count($flow.metadata.id)
    $peak_flow_bytes = max($flow.network.sent_bytes)
    $total_sent_bytes = sum($flow.network.sent_bytes)
    $destination_ports = array_distinct($conn.target.port)

  condition:
    #conn >= 100 and $flow
}
