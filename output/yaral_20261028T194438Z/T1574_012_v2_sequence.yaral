/*
  MITRE Technique : T1574.012 - COR_PROFILER
  Tactic(s)       : Stealth, Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:43:23.958334+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_012_COR_PROFILER_Dll_Drop_Then_Env_Registration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a DLL written to a user-writable location followed within ten minutes, on the same host, by a registry write that sets a COR_PROFILER, COR_PROFILER_PATH or COR_ENABLE_PROFILING environment variable. This sequence is the persistence or privilege-escalation setup for .NET CLR profiler hijacking. The rule uses file and registry telemetry only and does not depend on process command lines."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.012"
    mitre_technique_name = "Hijack Execution Flow: COR_PROFILER"
    log_prerequisites = "Requires EDR or Sysmon file creation telemetry (Sysmon Event 11) and registry value set telemetry (Sysmon Events 12/13) normalised to UDM FILE_CREATION and REGISTRY_MODIFICATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developers and performance engineers using .NET profilers or APM agents (IDE profilers, application performance monitoring agents, code coverage tools) that set COR_* variables in the registry after unpacking a profiler DLL; software installers that register .NET instrumentation; CI/build agents."
    tuning_guidance = "Add approved profiler or APM installer binaries to %global_allowed_admin_tools and endpoint agent binaries to %global_allowed_security_tools. Add developer or build service accounts to %global_allowed_service_accounts. If developer workstations are noisy, scope the rule to servers or raise the threshold on the DLL path filter."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(Users\\[^\\]+\\AppData\\|Users\\Public\\|ProgramData\\|Windows\\Temp\\|Temp\\).*\.dll$/ nocase
    $file.principal.hostname = $hostname
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      $reg.target.registry.registry_value_name = /^COR_(PROFILER|PROFILER_PATH|ENABLE_PROFILING)$/ nocase or
      $reg.target.registry.registry_key = /\\Environment\\COR_(PROFILER|PROFILER_PATH|ENABLE_PROFILING)$/ nocase
    )
    $reg.target.registry.registry_key = /\\Environment(\\|$)/ nocase
    $reg.principal.hostname = $hostname
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1574.012")
    $primary_entity = array_distinct($reg.principal.hostname)
    $dropped_dlls = array_distinct($file.target.file.full_path)
    $dll_writer_processes = array_distinct($file.principal.process.file.full_path)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_writer_processes = array_distinct($reg.principal.process.file.full_path)
    $affected_users = array_distinct($reg.principal.user.userid)
    $event_count = count($reg.metadata.id)

  condition:
    $file and $reg
}
