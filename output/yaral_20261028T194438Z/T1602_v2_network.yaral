/*
  MITRE Technique : T1602 - Data from Configuration Repository
  Tactic(s)       : Collection
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:16:23.336282+00:00
  Reference       : https://attack.mitre.org/techniques/T1602
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_External_Access_To_Config_Repository_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a connection from outside internal address space to a network device on a protocol used to expose or retrieve device configuration data: SNMP (161), TFTP (69), Cisco Smart Install (4786) or NETCONF over SSH (830). These services give direct access to device configuration repositories and should never be reachable from untrusted networks. The rule matches the network behaviour (port and external source), not a specific tool."
    mitre_tactic = "Collection"
    mitre_technique = "T1602"
    mitre_technique_name = "Data from Configuration Repository"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. The firewall must log both permitted and denied inbound traffic for full coverage."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Managed service provider or NMS platforms polling SNMP from external or cloud-hosted addresses; authorised external vulnerability scans or penetration tests; ISP or carrier monitoring; internet-wide scanner noise against exposed devices (denied traffic); remote offices whose address space is not covered by %rfc1918_internal."
    tuning_guidance = "Add legitimate external monitoring and management source addresses to %global_allowed_mgmt_sources. Add authorised scanner source addresses to %global_allowed_mgmt_sources as well, since %global_allowed_scanners holds process or tool identifiers rather than addresses. Confirm %rfc1918_internal covers the client's private and VPN address ranges. If internet scan noise is high, filter on allowed firewall actions in a client-specific copy of this rule."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 161 or
      $net.target.port = 69 or
      $net.target.port = 4786 or
      $net.target.port = 830
    )
    $net.principal.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1602")
    $primary_entity = array_distinct(strings.coalesce($net.target.hostname, $net.target.ip))
    $source_ips = array_distinct($net.principal.ip)
    $target_ips = array_distinct($net.target.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
