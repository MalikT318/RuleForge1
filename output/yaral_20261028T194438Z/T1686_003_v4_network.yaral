/*
  MITRE Technique : T1686.003 - Windows Host Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:33:07.843826+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_003_Inbound_External_Mgmt_Port_Host_Firewall_Bypass {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Network-side observation of a Windows host firewall that is disabled or opened. An inbound connection from a non-internal source reaches a remote-administration or file-sharing port (RDP, SMB, RPC, WinRM) on a Windows endpoint. A correctly enforced host firewall normally blocks this traffic from external sources, so a successful connection suggests the firewall profile was disabled or an allow rule was added. This is a behavioural result-of-impairment detection and does not depend on the command line used to change the firewall."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.003"
    mitre_technique_name = "Defense Impairment: Windows Host Firewall"
    log_prerequisites = "Requires endpoint network telemetry that records inbound connections with network.direction populated (EDR network events or Sysmon Event ID 3), or Windows Filtering Platform events (5156) normalised to NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Intentionally internet-exposed RDP, SMB or WinRM services such as jump hosts, DMZ servers and lab systems. Vendor or MSP remote support arriving from public addresses. NAT or VPN concentrators that present public or non-RFC1918 source addresses for internal users. Authorised external vulnerability scans."
    tuning_guidance = "Add approved management source addresses to %global_allowed_mgmt_sources and authorised scanners to %global_allowed_scanners. Extend %rfc1918_internal if the tenant uses CGNAT or other private ranges that appear as sources. Add intentionally exposed hosts to %global_allowed_admin_tools or suppress by hostname per client. Pair with endpoint firewall-change detections for higher confidence."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.direction = "INBOUND"
    (
      $net.target.port = 3389 or
      $net.target.port = 445 or
      $net.target.port = 135 or
      $net.target.port = 5985 or
      $net.target.port = 5986
    )
    $net.target.hostname != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1686.003")
    $primary_entity = array_distinct($net.target.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
