/*
  MITRE Technique : T1685 - Disable or Modify Tools
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:14:08.812980+00:00
  Reference       : https://attack.mitre.org/techniques/T1685
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_Cloud_Audit_Logging_Config_Tampering {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change in the cloud control plane that stops, suspends, disables or reduces the scope of audit logging, threat detection, configuration recording or flow logging. The rule matches the resulting setting-change API event rather than any command line, so it fires whichever tool, SDK, console or script issued the call."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685"
    mitre_technique_name = "Disable or Modify Tools"
    log_prerequisites = "Cloud control-plane audit logs (management and write events) ingested and parsed to UDM SETTING_MODIFICATION with metadata.product_event_type and principal.user.userid populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Planned logging migrations, trail or sink consolidation by cloud platform teams, infrastructure-as-code pipelines re-applying logging configuration, temporary suspension of detectors or recorders during account decommissioning, and sandbox or lab accounts."
    tuning_guidance = "Add pipeline and automation identities to %global_allowed_service_accounts, approved cloud service principals to %global_allowed_cloud_principals, and named cloud platform administrators to %global_allowed_admin_users. If a client uses different API naming, extend the product_event_type regex. Consider raising severity for production accounts."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /^(Stop|Disable|Suspend|Pause)[A-Za-z]*(Logging|Recorder|Detector|Monitoring|Auditing|Sink|Insights|FlowLogs)|^(UpdateTrail|PutEventSelectors|PutInsightSelectors|UpdateDetector|StopConfigurationRecorder|DeleteFlowLogs|UpdateSink)$/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_actions = array_distinct($cloud.metadata.product_event_type)
    $affected_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
