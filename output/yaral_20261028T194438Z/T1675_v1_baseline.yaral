/*
  MITRE Technique : T1675 - ESXi Administration Command
  Tactic(s)       : Execution
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:19:45.844649+00:00
  Reference       : https://attack.mitre.org/techniques/T1675
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1675_ESXi_Guest_Operation_Command_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects hypervisor guest-operation API calls that run programs, list processes or files, or transfer files inside a hosted guest VM (StartProgramInGuest, ListProcessesInGuest, ListFilesInGuest, InitiateFileTransferFromGuest and similar). Attackers use these calls to execute commands on guests through the tools daemon without touching the guest network stack. Accounts, admin users and management source addresses on the allowlists are excluded."
    mitre_tactic = "Execution"
    mitre_technique = "T1675"
    mitre_technique_name = "ESXi Administration Command"
    log_prerequisites = "ESXi hostd logs (task and guest operation events) forwarded to Chronicle and parsed to UDM USER_RESOURCE_ACCESS with the operation text in metadata.description or security_result.description. Parsing of the acting user and source IP is recommended."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Backup and snapshot quiescing agents, patching and configuration-management orchestration, monitoring or inventory tooling that uses guest operations, VDI and cloud automation, and administrators running approved maintenance scripts inside guests."
    tuning_guidance = "Add automation and orchestration accounts to %global_allowed_service_accounts, named administrators to %global_allowed_admin_users, and vCenter, automation or jump host addresses to %global_allowed_mgmt_sources. Review the operation list in the regex if the environment uses read-only guest operations such as ListProcessesInGuest heavily, and consider narrowing it to StartProgramInGuest and file transfer calls."

  events:
    $guest.metadata.event_type = "USER_RESOURCE_ACCESS"
    (
      $guest.metadata.description = /(StartProgramInGuest|StartProgramInGuestEx|ListProcessesInGuest|ListFilesInGuest|ListFileInGuest|InitiateFileTransferFromGuest|InitiateFileTransferToGuest|ReadEnvironmentVariableInGuest|TerminateProcessInGuest|CreateTemporaryFileInGuest|CreateTemporaryDirectoryInGuest)/ nocase or
      $guest.security_result.description = /(StartProgramInGuest|StartProgramInGuestEx|ListProcessesInGuest|ListFilesInGuest|ListFileInGuest|InitiateFileTransferFromGuest|InitiateFileTransferToGuest|ReadEnvironmentVariableInGuest|TerminateProcessInGuest|CreateTemporaryFileInGuest|CreateTemporaryDirectoryInGuest)/ nocase
    )
    not $guest.principal.user.userid in %global_allowed_service_accounts
    not $guest.principal.user.userid in %global_allowed_admin_users
    not $guest.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1675")
    $primary_entity = array_distinct(strings.coalesce($guest.target.hostname, $guest.principal.hostname))
    $acting_user = array_distinct($guest.principal.user.userid)
    $source_ips = array_distinct($guest.principal.ip)

  condition:
    $guest
}
