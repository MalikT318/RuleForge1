/*
  MITRE Technique : T1497 - Virtualization/Sandbox Evasion
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:59:15.042282+00:00
  Reference       : https://attack.mitre.org/techniques/T1497
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_Hypervisor_Guest_Artifact_Registry_Tampering {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a registry write to hypervisor guest-integration keys (VMware Tools, VirtualBox Guest Additions, Hyper-V Guest Parameters, or hypervisor guest driver service keys) by a process that is not a recognised guest-tools, installer or management binary. Malware and evasion tooling write to or alter these artifacts to spoof, hide or mimic virtualization state, so that its own VM/sandbox checks, or an analyst's checks, produce a chosen result. Detection is based on the registry state change rather than the command line."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1497"
    mitre_technique_name = "Virtualization/Sandbox Evasion"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event IDs 12/13/14 or equivalent) that populates target.registry.registry_key and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Guest tools install, upgrade or repair outside the excluded installer binaries; P2V/V2V conversion tooling; VDI golden-image builds; malware-analysis labs and sandboxes that intentionally edit these keys; hypervisor vendor update agents running under non-standard binary names."
    tuning_guidance = "Add approved deployment, patching and image-build binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Review hosts that legitimately run as VMs and tune the process-name exclusion regex for client-specific guest-tools agents. Consider suppressing known lab or sandbox hosts at the SOAR layer."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(VMware, Inc\.\\VMware Tools|Oracle\\VirtualBox Guest Additions|Microsoft\\Virtual Machine\\Guest|Services\\(VBoxGuest|VBoxService|VBoxMouse|VBoxVideo|VBoxSF|vmci|vmhgfs|vmmouse|vmvga|vmware tools|vmtools|vmicheartbeat|vmicshutdown|vmickvpexchange))(\\|$)/ nocase
    $reg.principal.hostname != ""

    not $reg.principal.process.file.full_path = /\\(vmtoolsd|vmwaretray|vmwareuser|VBoxService|VBoxTray|vmicsvc|msiexec|TrustedInstaller|TiWorker|svchost|wmiprvse|services|System)\.exe$/ nocase
    not $reg.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1497")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_name)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
