/*
  MITRE Technique : T1499 - Endpoint Denial of Service
  Tactic(s)       : Impact
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:15:47.117935+00:00
  Reference       : https://attack.mitre.org/techniques/T1499
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1499_Inbound_Connection_Flood_Windows_Services {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a high volume of inbound connections from external sources to a single host on commonly exposed Windows service ports (SMB, RDP, RPC, WinRM) within ten minutes. A single connection is benign, but this volume suggests a resource-exhaustion denial of service against the endpoint's services."
    mitre_tactic = "Impact"
    mitre_technique = "T1499"
    mitre_technique_name = "Endpoint Denial of Service"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with populated principal.ip, target.ip and target.port. Logs must capture traffic from external sources to internal hosts."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and penetration tests, brute-force or password-spray noise against exposed RDP, busy remote-access gateways or jump hosts, file servers behind NAT with many legitimate clients, and misconfigured clients retrying aggressively."
    tuning_guidance = "Add approved scanner sources to %global_allowed_scanners and management or jump-host sources to %global_allowed_mgmt_sources. Raise the #net threshold for high-traffic gateways or file servers, or lower it for hosts that should see little inbound traffic. Dedicated remote-access gateways can be handled with a client-specific exclusion."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 445 or
      $net.target.port = 3389 or
      $net.target.port = 135 or
      $net.target.port = 5985 or
      $net.target.port = 5986
    )
    $net.target.ip = $dst
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $dst over 10m

  outcome:
    $risk_score = max(if($net.target.port = 3389 or $net.target.port = 445, 70, 60))
    $mitre_technique_id = array_distinct("T1499")
    $primary_entity = array_distinct($dst)
    $connection_count = count($net.metadata.id)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    #net >= 500
}
