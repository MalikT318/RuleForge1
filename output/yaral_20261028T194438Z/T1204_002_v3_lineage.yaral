/*
  MITRE Technique : T1204.002 - Malicious File
  Tactic(s)       : Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:01:04.572929+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_002_Linux_Document_App_Spawns_Shell_Or_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux office suite, document/PDF viewer, or desktop mail client spawning a shell, script interpreter, or download utility. This lineage is the typical result of a user opening a malicious document or attachment that achieves code execution (macro, embedded script, or viewer exploit). Detection is based on parent-child process lineage rather than command-line content."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.002"
    mitre_technique_name = "User Execution: Malicious File"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd (execve) records normalized to UDM PROCESS_LAUNCH, with both parent (principal.process) and child (target.process) executable paths populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Mail clients and viewers handing links or files to the desktop via xdg-open (partly excluded by the anchored command-line exclusion), office suites running approved Python/Basic macro extensions, desktop document-management or conversion workflows (headless soffice batch conversion by approved scripts), and developer workstations with plugin tooling."
    tuning_guidance = "Add approved parent binaries or automation wrappers to %global_allowed_script_hosts and approved tooling to %global_allowed_admin_tools. Extend the parent regex with client-specific document applications if used. Consider adding browsers as parents only in environments where browser-spawned shells are rare."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(soffice\.bin|soffice|oosplash|libreoffice[0-9.]*|lowriter|localc|loimpress|onlyoffice|desktopeditors|wps|wpp|et|evince|okular|atril|xreader|zathura|mupdf|foxitreader|thunderbird|evolution|kmail|geary)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ksh|csh|tcsh|fish|python[0-9.]*|perl|ruby|php|lua|node|curl|wget|nc|ncat|socat)$/ nocase
    not $proc.target.process.command_line = /^(\/\S+\/)?(sh|bash|dash)\s+(\/\S+\/)?xdg-(open|email)(\s|$)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1204.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)

  condition:
    $proc
}
