/*
  MITRE Technique : T1027 - Obfuscated Files or Information
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:37:30.637581+00:00
  Reference       : https://attack.mitre.org/techniques/T1027
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_ESXi_Encode_Decode_Utility_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of encoding, decoding and decompression utilities launched from an interactive shell on a single ESXi host within 10 minutes. One invocation is routine. Repeated use suggests staged payload unpacking or obfuscated script and payload handling on the hypervisor. The rule keys on the utility binary path, not on command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027"
    mitre_technique_name = "Obfuscated Files or Information"
    log_prerequisites = "ESXi shell and hostd logs forwarded and parsed into UDM as PROCESS_LAUNCH with principal.hostname, principal.user.userid and target.process.file.full_path populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators unpacking VIB or offline bundles, support-bundle handling, patching or driver installation scripts, automation that decompresses logs or configuration archives, and approved deployment tooling."
    tuning_guidance = "Add approved admin tooling parents to %global_allowed_admin_tools and named administrators to %global_allowed_admin_users. Raise the #proc threshold on hosts with frequent scripted maintenance. Severity scales in outcome (risk_score) when openssl, base64 or uudecode is used."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(sh|ash|bash|busybox)$/ nocase
    $proc.target.process.file.full_path = /\/(base64|uudecode|xxd|openssl|gunzip|zcat|bzcat|unxz|xzcat|hexdump)$/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(re.regex($proc.target.process.file.full_path, `(?i)/(openssl|base64|uudecode)$`), 70, 50))
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1027")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $utilities = array_distinct($proc.target.process.file.full_path)

  condition:
    #proc >= 6
}
