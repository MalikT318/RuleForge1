/*
  MITRE Technique : T1114.002 - Remote Email Collection
  Tactic(s)       : Collection
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:19:27.088101+00:00
  Reference       : https://attack.mitre.org/techniques/T1114/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_002_Mailbox_Content_Search_Or_Export {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of mailbox content searches, mailbox export requests, or export of search results in the unified audit log. These are the native tenant mechanisms for bulk collection of email content, and adversaries with a compromised privileged account use them to harvest mail remotely without touching an endpoint."
    mitre_tactic = "Collection"
    mitre_technique = "T1114.002"
    mitre_technique_name = "Email Collection: Remote Email Collection"
    log_prerequisites = "Requires unified audit log ingestion with Exchange admin audit and compliance/eDiscovery (search) activity enabled. The operation name must be populated in metadata.product_event_type. Confirm that the client's parser maps these operations to USER_RESOURCE_ACCESS."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legal, HR, and compliance teams running authorised eDiscovery or litigation-hold searches; IT migrations using mailbox export; records-retention and DLP investigations; approved third-party archiving or migration service accounts."
    tuning_guidance = "Add named eDiscovery or compliance administrators to %global_allowed_admin_users. Add migration and archiving automation identities to %global_allowed_service_accounts. Correlate with the ticketing system for legal or HR holds. Raise severity if the actor was recently the subject of a risky sign-in alert."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /^(New-ComplianceSearch|New-ComplianceSearchAction|New-MailboxExportRequest|New-MailboxSearch|Start-ComplianceSearch|SearchCreated|SearchExported|SearchStarted)$/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1114.002")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $operations = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
