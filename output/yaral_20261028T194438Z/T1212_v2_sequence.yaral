/*
  MITRE Technique : T1212 - Exploitation for Credential Access
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:20:15.313073+00:00
  Reference       : https://attack.mitre.org/techniques/T1212
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1212_Linux_Service_Shell_Then_Credential_File_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a network-facing service daemon spawning a shell, followed within 10 minutes on the same host by a shell or file-reader utility reading a credential store (/etc/shadow, /etc/gshadow, /etc/security/opasswd or SSH private keys). This sequence is consistent with exploitation of a service vulnerability that yields code execution and then credential harvesting. It relies on process lineage and file access rather than command-line matching."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1212"
    mitre_technique_name = "Exploitation for Credential Access"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to UDM, with PROCESS_LAUNCH events including parent process path and FILE_READ events (for example auditd watches on /etc/shadow and SSH key paths)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web or application servers that legitimately run shell wrappers (CGI scripts, deployment hooks, database archive commands); configuration management or password-audit tooling reading /etc/shadow; backup agents reading /etc and home directories; PAM or user-management scripts invoked by a service."
    tuning_guidance = "Add approved parent daemons and hosts to %global_allowed_script_hosts. Add backup agents to %global_allowed_backup_processes, EDR and AV agents to %global_allowed_security_tools, and configuration management or audit tooling to %global_allowed_admin_tools. Extend the daemon regex if the client runs other internet-facing services."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|php-fpm[0-9.]*|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|postgres|redis-server|smbd|named|vsftpd|proftpd)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ash|ksh)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.hostname in %global_allowed_script_hosts
    $proc.principal.hostname = $hostname

    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /^(\/etc\/(shadow|gshadow|security\/opasswd)|\/(root|home\/[^\/]+)\/\.ssh\/id_(rsa|dsa|ecdsa|ed25519))$/ nocase
    $file.principal.process.file.full_path = /\/(sh|bash|dash|zsh|ash|ksh|cat|head|tail|less|more|cp|dd|python[0-9.]*|perl|ruby)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1212")
    $primary_entity = array_distinct($hostname)
    $parent_services = array_distinct($proc.principal.process.file.full_path)
    $spawned_shells = array_distinct($proc.target.process.file.full_path)
    $accessed_files = array_distinct($file.target.file.full_path)
    $reader_processes = array_distinct($file.principal.process.file.full_path)
    $affected_users = array_distinct($file.principal.user.userid)

  condition:
    $proc and $file
}
