/*
  MITRE Technique : T1667 - Email Bombing
  Tactic(s)       : Impact
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:08:16.237474+00:00
  Reference       : https://attack.mitre.org/techniques/T1667
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1667_Email_Bombing_High_Volume_Inbound_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a single mailbox receiving an abnormally high number of messages within ten minutes, the core signature of email bombing (list-signup floods or mass spam used to bury security alerts). A single event cannot express volume, so this rule aggregates EMAIL_TRANSACTION events per recipient. It is the closest single-event-variable form of this detection."
    mitre_tactic = "Impact"
    mitre_technique = "T1667"
    mitre_technique_name = "Email Bombing"
    log_prerequisites = "Requires mail transaction or message trace telemetry normalised to UDM EMAIL_TRANSACTION with network.email.to and network.email.from populated."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate newsletters or marketing blasts to a shared mailbox, ticketing or alerting mailboxes, monitoring and SIEM notification mailboxes, helpdesk queues, bulk onboarding or migration notifications, mailing-list digests."
    tuning_guidance = "Add known-good sender domains to %global_allowed_domains and automation or shared mailbox identifiers to %global_allowed_service_accounts. Raise or lower the #mail threshold (50 per 10m) to match the tenant's mail baseline. A high $distinct_senders value indicates a list-signup style bombing; a single sender suggests direct spam."

  events:
    $mail.metadata.event_type = "EMAIL_TRANSACTION"
    $mail.network.email.to = $recipient
    $mail.network.email.from != ""
    $sender_domain = re.capture($mail.network.email.from, "@(.+)$")
    not $sender_domain in %global_allowed_domains
    not $recipient in %global_allowed_service_accounts

  match:
    $recipient over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1667")
    $primary_entity = array_distinct($recipient)
    $message_count = count($mail.metadata.id)
    $distinct_senders = count_distinct($mail.network.email.from)
    $sender_domains = array_distinct($sender_domain)

  condition:
    #mail >= 50
}
