/*
  MITRE Technique : T1070.004 - File Deletion
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:04:21.369447+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_004_Linux_Log_History_File_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects deletion of active Linux system logs (auth, syslog, audit, wtmp/btmp/lastlog) or per-user shell history files, observed as a FILE_DELETION state change rather than a command line. Adversaries remove these artifacts to erase evidence of their activity, and detecting the file-level result still works if the command line is obfuscated, aliased or run from a custom binary."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.004"
    mitre_technique_name = "Indicator Removal: File Deletion"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules (unlink/unlinkat syscalls) covering /var/log and user home directories, normalized to UDM FILE_DELETION with principal.process and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "logrotate or log-management agents removing active logs, systemd-tmpfiles or package post-install scripts, admins clearing history during maintenance or account offboarding, image-build and cleanup scripts, user-management tools removing home directories."
    tuning_guidance = "Add approved log-management or cleanup tooling to %global_allowed_admin_tools, EDR and agent processes to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. If rotated or compressed logs are noisy, they are already excluded, so tune further by adding trusted process names to the process-name exclusion regex."

  events:
    $file.metadata.event_type = "FILE_DELETION"
    $file.target.file.full_path = /^(\/var\/log\/(auth\.log|secure|syslog|messages|kern\.log|cron|wtmp|btmp|lastlog|faillog|audit\/audit\.log)|\/(root|home\/[^\/]+)\/\.(bash_history|zsh_history|sh_history|history|python_history|lesshst|viminfo|mysql_history|psql_history))$/ nocase
    not $file.principal.process.file.full_path = /\/(logrotate|rsyslogd|syslog-ng|systemd-journald|systemd-tmpfiles|anacron)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1070.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $deleted_files = array_distinct($file.target.file.full_path)
    $acting_users = array_distinct($file.principal.user.userid)
    $acting_processes = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
