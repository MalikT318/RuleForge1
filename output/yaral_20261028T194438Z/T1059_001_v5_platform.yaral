/*
  MITRE Technique : T1059.001 - PowerShell
  Tactic(s)       : Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:08:47.127338+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_001_PowerShell_Engine_Loaded_By_Non_PowerShell_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the PowerShell engine assembly (System.Management.Automation) being loaded into a process that is not a standard PowerShell host. This is the module-load signature of PowerShell execution without powershell.exe, such as unmanaged or .NET-hosted runspaces, injected loaders, and scripting hosts. It is additive to command-line rules because it never inspects process creation or command lines."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.001"
    mitre_technique_name = "Command and Scripting Interpreter: PowerShell"
    log_prerequisites = "Requires endpoint telemetry that reports image/module loads (Sysmon Event ID 7 or equivalent EDR module-load events) normalised to PROCESS_MODULE_LOAD with principal.process and target.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate .NET applications that embed PowerShell runspaces (IDEs such as Visual Studio, management consoles like mmc.exe, Exchange and Server Manager tooling, RMM and deployment agents, backup software, SCCM/Intune agents, build servers)."
    tuning_guidance = "Add approved embedding applications to %global_allowed_admin_tools or %global_allowed_script_hosts. Add EDR and security agents to %global_allowed_security_tools. Add automation identities to %global_allowed_service_accounts. Extend the host-process regex exclusion for any additional Microsoft-signed PowerShell hosts seen in the environment, and baseline noisy processes per client before enabling alerting."

  events:
    $mod.metadata.event_type = "PROCESS_MODULE_LOAD"
    $mod.target.file.full_path = /\\system\.management\.automation(\.ni)?\.dll$/ nocase
    $mod.principal.process.file.full_path != ""
    not $mod.principal.process.file.full_path = /\\(powershell|pwsh|powershell_ise|wsmprovhost|sdiagnhost)\.exe$/ nocase
    not $mod.principal.process.file.full_path in %global_allowed_admin_tools
    not $mod.principal.process.file.full_path in %global_allowed_script_hosts
    not $mod.principal.process.file.full_path in %global_allowed_security_tools
    not $mod.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1059.001")
    $primary_entity = array_distinct($mod.principal.hostname)
    $host_process = array_distinct($mod.principal.process.file.full_path)
    $loaded_module = array_distinct($mod.target.file.full_path)
    $user = array_distinct($mod.principal.user.userid)

  condition:
    $mod
}
