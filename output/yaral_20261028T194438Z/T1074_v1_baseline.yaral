/*
  MITRE Technique : T1074 - Data Staged
  Tactic(s)       : Collection
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:16:18.946645+00:00
  Reference       : https://attack.mitre.org/techniques/T1074
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_Bulk_Copy_To_Staging_Directory {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a built-in copy or move utility (robocopy, xcopy, cmd copy/move, PowerShell Copy-Item/Move-Item) run with bulk or recursive options. The command line references both a user-data or network-share source and a common local staging location, such as the Public profile, ProgramData, Windows Temp, PerfLogs or the Recycle Bin. This is the typical way adversaries gather collected files in one place before archiving and exfiltration."
    mitre_tactic = "Collection"
    mitre_technique = "T1074"
    mitre_technique_name = "Data Staged"
    log_prerequisites = "Requires EDR process telemetry (or Sysmon Event ID 1 / Windows Event 4688 with command-line auditing enabled) populating target.process.command_line."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT migration or profile-backup scripts, software deployment staging into ProgramData, user-data backup jobs not covered by the backup allowlist, RMM-driven file collection, and developers or admins copying document sets to temporary folders."
    tuning_guidance = "Add approved parent or tooling binaries to %global_allowed_admin_tools, backup and imaging software to %global_allowed_backup_processes, and automation accounts to %global_allowed_service_accounts. If ProgramData is noisy in a given environment, narrow the destination regex for that client."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(robocopy|xcopy|cmd|powershell|pwsh)\.exe$/ nocase
    $proc.target.process.command_line = /(robocopy|xcopy|\bcopy\b|\bmove\b|copy-item|move-item)/ nocase
    $proc.target.process.command_line = /(\s\/(s|e|mir|move)\b|-recurse|\*\.[a-z0-9]+|\*\.\*)/ nocase
    $proc.target.process.command_line = /(\\documents|\\desktop|\\downloads|\\\\[a-z0-9._$-]+\\[a-z0-9._$-]+|\.(docx?|xlsx?|pptx?|pdf|pst|ost|kdbx|csv)\b)/ nocase
    $proc.target.process.command_line = /(\\users\\public\\|\\programdata\\|\\windows\\temp\\|\\perflogs\\|\$recycle\.bin|\\windows\\debug\\|\\windows\\tasks\\|\\appdata\\local\\temp\\)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1074")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $copy_command = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
