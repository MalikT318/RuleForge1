/*
  MITRE Technique : T1011 - Exfiltration Over Other Network Medium
  Tactic(s)       : Exfiltration
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:20:29.724746+00:00
  Reference       : https://attack.mitre.org/techniques/T1011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1011_Large_Outbound_Transfer_Nonstandard_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a single large outbound transfer (over 50 MB sent) from an internal host to an external destination on a port other than common web, DNS or time ports. A perimeter device cannot see the physical medium (WiFi, cellular, Bluetooth), so this rule detects the network-observable result: bulk data leaving over a non-standard channel, which is typical of exfiltration that is separate from normal web egress."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1011"
    mitre_technique_name = "Exfiltration Over Other Network Medium"
    log_prerequisites = "Firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with network.sent_bytes, target.ip and target.port populated. Pair with endpoint coverage for Windows process attribution."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Off-site backup and replication jobs, software and VM image uploads, VPN or tunnel traffic on custom ports, video conferencing or media streaming on high ports, large file transfers to partners over SFTP or FTPS."
    tuning_guidance = "Add known-good destination domains to %global_allowed_domains. The 50 MB threshold (52428800 bytes) and the excluded standard ports can be adjusted per client. Where firewall logs lack target.hostname, the domain exclusion has no effect and tuning should be done by raising the threshold."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.sent_bytes > 52428800
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 53
    $net.target.port != 123
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1011")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
