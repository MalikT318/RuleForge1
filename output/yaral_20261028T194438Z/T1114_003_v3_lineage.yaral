/*
  MITRE Technique : T1114.003 - Email Forwarding Rule
  Tactic(s)       : Collection
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:21:40.358425+00:00
  Reference       : https://attack.mitre.org/techniques/T1114/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_003_Linux_Mail_Forward_Config_From_Service_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, script interpreter or mail-admin utility spawned by a web server, application server, database or print service parent that touches mail forwarding mechanisms (.forward, /etc/aliases, procmail or sieve rules, MTA BCC and virtual alias settings). Services such as these should never configure mail forwarding, so this lineage indicates web shell or service-exploitation activity setting up mail collection."
    mitre_tactic = "Collection"
    mitre_technique = "T1114.003"
    mitre_technique_name = "Email Collection: Email Forwarding Rule"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry with parent process path and full child command line (execve auditing enabled)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Webmail or hosting control panels that manage .forward, aliases or sieve rules through a CGI or PHP backend; self-service mail administration portals; configuration management run through an application server; legitimate database-triggered mail maintenance scripts."
    tuning_guidance = "Add approved parent binaries (control panel daemons, deployment agents) to %global_allowed_admin_tools or %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts. If a mail hosting platform legitimately manages forwarding via its web stack, allowlist its parent path rather than loosening the command-line regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|php-fpm[0-9.]*|php-cgi|lighttpd|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|cupsd)$/ nocase
    $proc.target.process.file.full_path = /\/(ba|da|a|z|k|c|tc|fi)?sh$|\/(python[0-9.]*|perl|php[0-9.]*|ruby|postconf|newaliases|postmap|maildrop)$/ nocase
    $proc.target.process.command_line = /(\.forward\b|\/etc\/(mail\/)?aliases|\.procmailrc|\.qmail|\.dovecot\.sieve|\/sieve\/|always_bcc|recipient_bcc_maps|sender_bcc_maps|virtual_alias_maps|\/virtual\b|\bnewaliases\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1114.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
