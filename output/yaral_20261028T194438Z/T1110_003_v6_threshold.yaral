/*
  MITRE Technique : T1110.003 - Password Spraying
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:08:07.224041+00:00
  Reference       : https://attack.mitre.org/techniques/T1110/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1110_003_Password_Spray_Failed_Logins_Single_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single source address generates a high volume of failed interactive or network sign-ins against many different accounts within ten minutes. This is the signature of password spraying, where one or a few passwords are tried across many users to stay below per-account lockout limits."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1110.003"
    mitre_technique_name = "Brute Force: Password Spraying"
    log_prerequisites = "Requires identity provider or Active Directory authentication logs (for example Windows Security 4625/4771/4776 or equivalent directory sign-in logs) normalised to USER_LOGIN with security_result.action populated (BLOCK for failures), principal.ip and target.user.userid."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Misconfigured service or application with stale credentials retrying across accounts, vulnerability scanners and authorised password-audit tools, NAT or proxy gateways aggregating many users behind one address, mass password-expiry events, and VPN or RDS gateways relaying logins for many users."
    tuning_guidance = "Add authorised scanners and testing sources to %global_allowed_scanners and automation accounts to %global_allowed_service_accounts. Raise the #auth threshold for tenants with large NAT or gateway egress addresses. Review the distinct_users outcome: a high distinct account count against a low attempts-per-account ratio confirms spraying rather than brute force."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.security_result.action = "BLOCK"
    $auth.principal.ip = $src_ip
    $auth.target.user.userid != ""
    not $auth.principal.ip in %global_allowed_scanners
    not $auth.target.user.userid in %global_allowed_service_accounts

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1110.003")
    $primary_entity = array_distinct($src_ip)
    $failed_attempts = count($auth.metadata.id)
    $distinct_users = count_distinct($auth.target.user.userid)
    $targeted_users = array_distinct($auth.target.user.userid)
    $target_hosts = array_distinct($auth.target.hostname)

  condition:
    #auth >= 15
}
