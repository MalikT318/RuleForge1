/*
  MITRE Technique : T1222.002 - Linux and Mac Permissions
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:21:21.629011+00:00
  Reference       : https://attack.mitre.org/techniques/T1222/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_002_Linux_Chmod_SetID_Bit_In_Writable_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects chmod setting the setuid or setgid bit, in numeric or symbolic form, on a file in a world-writable staging directory (/tmp, /var/tmp, /dev/shm). Adversaries use this to build SUID backdoors or privilege-escalation helpers. Legitimate software rarely sets SUID bits on files in these directories."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1222.002"
    mitre_technique_name = "File and Directory Permissions Modification: Linux and Mac File and Directory Permissions Modification"
    log_prerequisites = "Linux EDR or auditd (execve) process telemetry with full command-line capture, normalised to UDM PROCESS_LAUNCH."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software installers or build systems that stage SUID helpers in /tmp during compilation or packaging, CI/CD runners, container image builds, and admins testing SUID behaviour."
    tuning_guidance = "Add approved installer, build and configuration-management parent processes to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Extend the directory list in the command_line regex if staging directories differ per client."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/chmod$/ nocase
    // Numeric mode with setuid/setgid digit (e.g. 4755, 2755, 06755) or symbolic mode (u+s, g+s, +s)
    $proc.target.process.command_line = /\s(0?[2-7][0-7]{3}|[ugoa]*[+=][rwxXt]*s[rwxXt]*)(\s|$)/ nocase
    // Target file located in a world-writable staging directory
    $proc.target.process.command_line = /\s\/(tmp|var\/tmp|dev\/shm)\// nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1222.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $chmod_command = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
