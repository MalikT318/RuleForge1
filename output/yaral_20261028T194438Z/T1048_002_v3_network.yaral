/*
  MITRE Technique : T1048.002 - Exfiltration Over Asymmetric Encrypted Non-C2 Protocol
  Tactic(s)       : Exfiltration
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:36:13.135026+00:00
  Reference       : https://attack.mitre.org/techniques/T1048/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1048_002_Large_Outbound_Encrypted_Transfer_NonWeb_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a single large outbound transfer from an internal host to an external address over a port normally used for SSH/SFTP/SCP or FTPS rather than web browsing. Perimeter telemetry sees the encrypted session volume, which is characteristic of bulk data exfiltration over an asymmetrically keyed non-C2 protocol. Applies to egress from Windows endpoints and servers and uses no endpoint process fields."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1048.002"
    mitre_technique_name = "Exfiltration Over Alternative Protocol: Exfiltration Over Asymmetric Encrypted Non-C2 Protocol"
    log_prerequisites = "Requires firewall or perimeter connection logs with per-session bytes sent populated (network.sent_bytes), source and destination IP, and destination port. Logs must be recorded at session close or in periodic updates so byte counts are present."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Approved SFTP or SCP file transfers to business partners, off-site backup or replication jobs over SSH, developers pushing to external Git over SSH, managed file transfer gateways, and cloud migration tooling."
    tuning_guidance = "Add known jump hosts, backup servers and MFT gateways to %global_allowed_mgmt_sources (source IPs). Add approved partner destinations to %global_allowed_domains. Adjust the byte threshold (10485760 = 10 MB) to the client baseline, and add or remove ports in the port list to match client policy."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 22 or $net.target.port = 2222 or $net.target.port = 990 or $net.target.port = 989)
    $net.network.sent_bytes > 10485760
    $net.principal.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1048.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
