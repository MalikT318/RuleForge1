/*
  MITRE Technique : T1114 - Email Collection
  Tactic(s)       : Collection
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:16:41.917993+00:00
  Reference       : https://attack.mitre.org/techniques/T1114
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_Mailbox_Delegate_Access_Granted {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a mailbox permission grant (delegate or full-access) recorded in the unified audit log, either by an administrator or by an account acting through a compromised session. Adversaries use this to read a victim's email without the victim's credentials and with little endpoint footprint. Complements endpoint-based email collection coverage by pivoting on the cloud control plane."
    mitre_tactic = "Collection"
    mitre_technique = "T1114"
    mitre_technique_name = "Email Collection"
    log_prerequisites = "Requires the unified audit log (admin audit for mailbox management cmdlets) to be ingested and normalised so that the operation name is in metadata.product_event_type and the acting identity is in principal.user.userid."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Help desk or messaging admins granting access for shared mailboxes, executive assistants, mailbox migrations, legal hold or eDiscovery access, and onboarding or offboarding automation."
    tuning_guidance = "Add approved admin identities to %global_allowed_admin_users and automation or migration accounts to %global_allowed_service_accounts. Add approved cloud service principals to %global_allowed_cloud_principals. If shared-mailbox provisioning is noisy, filter on the target mailbox naming convention in a client-specific copy of the rule."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /^(Add-MailboxPermission|Add-MailboxFolderPermission|Set-MailboxFolderPermission)$/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1114")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $operation = array_distinct($cloud.metadata.product_event_type)
    $target_user = array_distinct($cloud.target.user.userid)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
