/*
  MITRE Technique : T1102 - Web Service
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:53:29.115061+00:00
  Reference       : https://attack.mitre.org/techniques/T1102
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1102_Web_Service_High_Volume_POST_To_Single_External_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal host sends a high volume of HTTP POST requests to one external, non-allowlisted web host within ten minutes. Each request is benign on its own; the sustained volume to one destination is consistent with C2 relayed through a legitimate web service (polling, tasking, or data return via a cloud or social platform)."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1102"
    mitre_technique_name = "Web Service"
    log_prerequisites = "Requires firewall or proxy logs normalised to UDM NETWORK_HTTP with principal.hostname, target.hostname, target.ip and network.http.method populated. TLS inspection is needed for HTTPS visibility; without it, only the host-level destination may be available."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "SaaS and collaboration clients, telemetry and analytics agents, cloud backup or sync clients, web-based line-of-business apps, and browsers on interactive web apps that post frequently to one host."
    tuning_guidance = "Add known-good vendor and SaaS domains to %global_allowed_domains. Add scanners or test hosts to %global_allowed_scanners. Raise the #net threshold in noisy tenants, or lower it for high-security segments. Review $destination_hosts and $total_bytes_sent in the outcome to prioritise."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.principal.hostname = $host
    $net.target.hostname = $dest
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners

  match:
    $host, $dest over 10m

  outcome:
    $risk_score = max(if($net.network.sent_bytes > 10000, 75, 55))
    $mitre_technique_id = array_distinct("T1102")
    $primary_entity = array_distinct($host)
    $destination_hosts = array_distinct($dest)
    $destination_ips = array_distinct($net.target.ip)
    $event_count = count($net.metadata.id)
    $total_bytes_sent = sum($net.network.sent_bytes)

  condition:
    #net >= 30
}
