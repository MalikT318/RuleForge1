/*
  MITRE Technique : T1078.003 - Local Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:33:41.772747+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_003_Local_Account_High_Volume_Logins_Across_Hosts {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single non-machine account generates a high volume of logins within one hour. Each login is benign on its own, but the volume suggests credential reuse, password spraying or lateral movement with a local or shared account. Outcome variables list the distinct hosts and the number of hosts touched so analysts can see how widely the account was used."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.003"
    mitre_technique_name = "Valid Accounts: Local Accounts"
    log_prerequisites = "Requires normalized Windows authentication events (logon success/failure, e.g. Event IDs 4624/4625) or directory sign-in logs mapped to USER_LOGIN with target.user.userid and target.hostname populated."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Shared kiosk or lab accounts, helpdesk or break-glass accounts used during incidents, monitoring and inventory tooling that authenticates repeatedly, jump hosts, and automation accounts not yet in the service account list."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts and approved administrators to %global_allowed_admin_users. Raise or lower the #auth threshold per client based on baseline login volume. Review $distinct_host_count to prioritise accounts that touched many hosts."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.user.userid = $user
    $auth.target.user.userid != ""
    $auth.target.hostname != ""
    not $auth.target.user.userid = /\$$/
    not $auth.target.user.userid = /^(anonymous logon|system|local service|network service|dwm-\d+|umfd-\d+)$/ nocase
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users

  match:
    $user over 1h

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1078.003")
    $primary_entity = array_distinct($user)
    $login_count = count($auth.metadata.id)
    $distinct_host_count = count_distinct($auth.target.hostname)
    $target_hosts = array_distinct($auth.target.hostname)
    $source_ips = array_distinct($auth.principal.ip)

  condition:
    #auth >= 15
}
