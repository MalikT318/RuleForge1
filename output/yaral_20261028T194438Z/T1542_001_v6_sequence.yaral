/*
  MITRE Technique : T1542.001 - System Firmware
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:43:34.742406+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_001_Firmware_Image_Download_Then_Upload_Same_Dest {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A host downloads a firmware or UEFI image-type file (capsule, ROM, EFI, flash image) over HTTP(S) from an external destination outside the known-good domain list, then sends POST/PUT data to the same destination within ten minutes. Firmware-image retrieval from non-vendor infrastructure followed by a return upload to that server can indicate staging of a malicious firmware implant, such as a tampered UEFI capsule, and operator check-in. This is a network-side approximation: perimeter logs cannot see the flashing itself, so correlate with endpoint telemetry when it fires."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.001"
    mitre_technique_name = "Pre-OS Boot: System Firmware"
    log_prerequisites = "Requires firewall or proxy logs normalised to UDM NETWORK_HTTP with principal.ip, target.hostname, target.url and network.http.method populated. TLS inspection is needed to see URLs on HTTPS traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate OEM or vendor BIOS/UEFI update downloads from domains missing from the allowlist, hardware lifecycle tooling, driver and firmware management portals that download an image and report status back, and IT staff manually updating firmware."
    tuning_guidance = "Add OEM, vendor and update-service domains to %global_allowed_domains. Exclude internal management or patch-staging destinations by adding source addresses to %global_allowed_mgmt_sources. Raise or lower severity by narrowing the file-extension regex to the firmware image types used in the client environment."

  events:
    $dl.metadata.event_type = "NETWORK_HTTP"
    $dl.network.http.method = /^GET$/ nocase
    $dl.target.url = /\.(cap|rom|fd|efi|wph|bio)(\?.*)?$/ nocase
    not $dl.target.hostname in %global_allowed_domains
    not $dl.target.ip in %rfc1918_internal
    not $dl.principal.ip in %global_allowed_mgmt_sources
    $dl.principal.ip = $src_ip
    $dl.target.hostname = $dest

    $up.metadata.event_type = "NETWORK_HTTP"
    $up.network.http.method = /^(POST|PUT)$/ nocase
    not $up.target.hostname in %global_allowed_domains
    not $up.target.ip in %rfc1918_internal
    $up.principal.ip = $src_ip
    $up.target.hostname = $dest

    $dl.metadata.event_timestamp.seconds <= $up.metadata.event_timestamp.seconds

  match:
    $src_ip, $dest over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1542.001")
    $primary_entity = array_distinct($src_ip)
    $destination_host = array_distinct($dest)
    $downloaded_urls = array_distinct($dl.target.url)
    $upload_count = count($up.metadata.id)

  condition:
    $dl and $up
}
