/*
  MITRE Technique : T1127.002 - ClickOnce
  Tactic(s)       : Stealth, Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:39:42.664573+00:00
  Reference       : https://attack.mitre.org/techniques/T1127/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1127_002_ClickOnce_Cache_Binary_Drop_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of executable or library files (.exe, .dll) written into the per-user ClickOnce application cache (AppData\\Local\\Apps\\2.0) by the ClickOnce deployment service (dfsvc.exe) on a single host within 10 minutes. A single file write is normal for ClickOnce, but a volume of binary drops indicates an application being installed and staged for proxied execution. This is file-creation based and complements process-launch and command-line detections."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1127.002"
    mitre_technique_name = "Trusted Developer Utilities Proxy Execution: ClickOnce"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent) with the writing process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate line-of-business ClickOnce applications being installed or updated, VSTO and Office add-in deployments, internal tools published through ClickOnce, and developer machines testing ClickOnce publishing."
    tuning_guidance = "Add known ClickOnce deployment or packaging accounts to %global_allowed_service_accounts and %global_allowed_admin_users. If a business ClickOnce application causes noise, raise the #file threshold or exclude the owning user group. Review the sample paths in the outcome to identify the application."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\dfsvc\.exe$/ nocase
    $file.target.file.full_path = /\\AppData\\Local\\Apps\\2\.0\\.*\.(exe|dll)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($file.target.file.full_path = /\.exe$/ nocase, 75, 55))
    $mitre_technique_id = array_distinct("T1127.002")
    $primary_entity = array_distinct($host)
    $file_count = count($file.metadata.id)
    $users = array_distinct($file.principal.user.userid)
    $sample_paths = array_distinct($file.target.file.full_path)

  condition:
    #file >= 10
}
