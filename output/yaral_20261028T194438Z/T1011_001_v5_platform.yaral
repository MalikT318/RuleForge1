/*
  MITRE Technique : T1011.001 - Exfiltration Over Bluetooth
  Tactic(s)       : Exfiltration
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:22:44.365404+00:00
  Reference       : https://attack.mitre.org/techniques/T1011/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1011_001_PowerShell_Bluetooth_API_Data_Transmit {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a PowerShell host launched with a command line that combines Windows Bluetooth/RFCOMM/OBEX API namespaces with data-transmit operations (stream writers, connect/send calls). This is the scripted way to push data to a nearby Bluetooth device outside the routed network path. Note: the requested alternate-platform angle was not applied because the mandatory target platform and log source for this rule are Windows (windows_endpoint)."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1011.001"
    mitre_technique_name = "Exfiltration Over Other Network Medium: Exfiltration Over Bluetooth"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 / Windows Event 4688 with command-line auditing enabled. Script-block logging is a useful complement but is not required."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developers or IT staff testing Bluetooth device integrations, hardware vendor provisioning scripts, kiosk or point-of-sale peripheral setup, accessibility tooling, lab and test automation hosts."
    tuning_guidance = "Add approved parent processes or script hosts to %global_allowed_script_hosts, approved tooling to %global_allowed_admin_tools, and named engineers to %global_allowed_admin_users. Raise severity on servers or hosts with no Bluetooth hardware. Scripts that load the Bluetooth APIs from a file will not expose them on the command line, so pair this rule with script-block logging detections."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|powershell_ise)\.exe$/ nocase
    $proc.target.process.command_line = /(Windows\.Devices\.Bluetooth|Windows\.Devices\.Radios|Rfcomm(Device)?Service|System\.Net\.Bluetooth|BluetoothDevice|BluetoothClient|ObexFile|ObexClient)/ nocase
    $proc.target.process.command_line = /(DataWriter|StoreAsync|StreamSocket|ConnectAsync|SendFile|OpenWrite|WriteAsync|WriteBytes|\.Write\()/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1011.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
