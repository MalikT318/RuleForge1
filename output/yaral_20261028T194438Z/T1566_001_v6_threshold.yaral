/*
  MITRE Technique : T1566.001 - Spearphishing Attachment
  Tactic(s)       : Initial Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:48:11.854015+00:00
  Reference       : https://attack.mitre.org/techniques/T1566/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1566_001_Office_Agent_External_HTTP_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal Windows host makes repeated outbound HTTP(S) requests to non-allowlisted external destinations using an Office or Outlook client user-agent within 10 minutes. A lone request is routine, but repeated external fetches from document-client agents are consistent with a spearphishing attachment that has been opened and is retrieving a remote template, payload, or staged content. Detection is based on perimeter proxy/firewall HTTP telemetry only, with no endpoint process fields."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1566.001"
    mitre_technique_name = "Phishing: Spearphishing Attachment"
    log_prerequisites = "Requires proxy or firewall HTTP logs normalised to NETWORK_HTTP with network.http.user_agent, target.hostname, target.ip and principal.hostname populated. TLS inspection is needed to see user-agents on HTTPS traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Office add-ins and cloud-document features (online templates, clip art, update checks, telemetry, licensing), SharePoint/OneDrive-linked documents, CRM or ERP plug-ins in Outlook, and third-party signature or e-sign add-ins calling vendor APIs."
    tuning_guidance = "Add vendor and Microsoft service domains to %global_allowed_domains. Raise the #net threshold in high-noise tenants. Add sanctioned proxy or gateway hosts to %global_allowed_mgmt_sources if they generate Office-agent traffic. Review the destination_domains outcome to identify recurring benign add-in destinations."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /(microsoft office|ms-office|msoffice|officeclicktorun|\b(winword|excel|powerpnt|outlook)\b)/ nocase
    $net.principal.hostname = $host
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1566.001")
    $primary_entity = array_distinct($host)
    $destination_domains = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    #net >= 3
}
