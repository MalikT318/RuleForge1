/*
  MITRE Technique : T1098.002 - Additional Email Delegate Permissions
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:42:41.619036+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_002_Login_Then_Mailbox_Delegation_Grant {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A user signs in from an external address and, within 10 minutes, the same account grants mailbox, mailbox-folder or recipient permissions (for example Add-MailboxPermission or Add-MailboxFolderPermission). This is a common persistence and BEC pattern after account takeover: the attacker grants themselves or another account delegate access to maintain mailbox access."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.002"
    mitre_technique_name = "Account Manipulation: Additional Email Delegate Permissions"
    log_prerequisites = "Microsoft 365 unified audit logs with Azure AD sign-in events and Exchange admin audit events (mailbox and folder permission operations) ingested and normalised to UDM. The operation name must be populated in metadata.product_event_type."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Helpdesk or IT staff granting delegate or shared-mailbox access shortly after signing in remotely, onboarding or offboarding automation, executive-assistant delegation requests, and mailbox migration tooling that signs in and sets permissions in one session."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users, automation accounts to %global_allowed_service_accounts, and approved identity or migration principals to %global_allowed_cloud_principals. If remote helpdesk sign-ins are common, narrow the login side further, for example by requiring an unfamiliar source country. If the Exchange operation is mapped to a different UDM event type in your tenant, adjust the event type on the permission event."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.principal.user.userid = $user
    not $login.principal.ip in %rfc1918_internal
    not $login.principal.user.userid in %global_allowed_service_accounts

    $perm.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"
    $perm.metadata.product_event_type = /^(Add-MailboxPermission|Add-MailboxFolderPermission|Set-MailboxFolderPermission|Add-RecipientPermission)$/ nocase
    $perm.principal.user.userid = $user
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_cloud_principals

    $login.metadata.event_timestamp.seconds <= $perm.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1098.002")
    $primary_entity = array_distinct($user)
    $login_source_ips = array_distinct($login.principal.ip)
    $permission_operations = array_distinct($perm.metadata.product_event_type)
    $affected_mailboxes = array_distinct($perm.target.user.userid)
    $permission_event_count = count($perm.metadata.id)

  condition:
    $login and $perm
}
