/*
  MITRE Technique : T1027.007 - Dynamic API Resolution
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:49:39.317839+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_007_Core_DLL_Loaded_From_NonSystem_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process loading a core Windows API library (ntdll, kernel32, kernelbase, win32u) from outside the trusted OS directories. Malware that resolves APIs or syscalls dynamically often maps a private, unhooked copy of these libraries to walk the export table and avoid monitored functions. This rule watches module-load telemetry, so it complements command-line detections."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.007"
    mitre_technique_name = "Obfuscated Files or Information: Dynamic API Resolution"
    log_prerequisites = "Requires EDR or Sysmon-equivalent image/module-load telemetry (Sysmon Event ID 7) normalised to PROCESS_MODULE_LOAD with target.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "OS servicing and offline image tools (DISM, Windows Update staging), application virtualisation or sandbox products, software installers that stage system DLLs, developer debugging and symbol tooling, and EDR or AV products that load clean library copies for integrity checks."
    tuning_guidance = "Add legitimate loading processes to %global_allowed_security_tools (EDR/AV) or %global_allowed_admin_tools (servicing and deployment). Module-load telemetry volume varies by client, so confirm the sensor reports full module paths before deployment. If servicing or virtualisation noise is high, extend the trusted-directory regex with the client's approved staging locations."

  events:
    $mod.metadata.event_type = "PROCESS_MODULE_LOAD"
    $mod.target.file.full_path = /\\(ntdll|kernel32|kernelbase|win32u)\.dll$/ nocase
    not $mod.target.file.full_path = /^[a-z]:\\windows\\(system32|syswow64|winsxs|servicing)\\/ nocase
    not $mod.principal.process.file.full_path in %global_allowed_security_tools
    not $mod.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1027.007")
    $primary_entity = array_distinct($mod.principal.hostname)
    $loading_process = array_distinct($mod.principal.process.file.full_path)
    $loaded_module_path = array_distinct($mod.target.file.full_path)
    $user = array_distinct($mod.principal.user.userid)

  condition:
    $mod
}
