/*
  MITRE Technique : T1176 - Software Extensions
  Tactic(s)       : Persistence
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:24:57.591344+00:00
  Reference       : https://attack.mitre.org/techniques/T1176
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_Linux_Extension_Package_Download_Unapproved_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux client (browser or command-line downloader) fetching a browser or IDE extension package (.crx, .vsix, .xpi) over HTTP(S) from an external host that is not in the approved domain list. Fetching a package from an unapproved source is a network-observable step in side-loading a malicious extension for persistence."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176"
    mitre_technique_name = "Software Extensions"
    log_prerequisites = "Proxy or firewall logs with URL visibility (TLS inspection or explicit proxy) normalised to NETWORK_HTTP, with target.url and the user agent populated. Plain firewall logs without URL data will not trigger this rule."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Developers installing IDE extensions from alternative or self-hosted registries, internal extension mirrors with an external CDN, enterprise-managed browser extension deployment from vendor-hosted update servers, and security teams analysing extension samples."
    tuning_guidance = "Add approved marketplace, CDN, and vendor extension-hosting domains to %global_allowed_domains. Internal traffic is excluded through %rfc1918_internal. If the proxy does not populate the user agent, remove the user-agent condition and rely on the extension-package URL pattern alone."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET"
    $net.target.url = /\.(crx|vsix|xpi)([?#].*)?$/ nocase
    $net.network.http.user_agent = /(X11|Linux|curl|wget|python-requests|Go-http-client)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1176")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
