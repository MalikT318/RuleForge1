/*
  MITRE Technique : T1059.010 - AutoHotKey & AutoIT
  Tactic(s)       : Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:20:28.213854+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_010_AutoScript_File_Dropped_UserWritable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of AutoHotkey (.ahk) or AutoIt (.au3, .a3x) script files in user-writable or staging directories (AppData, Downloads, Desktop, ProgramData, Public, Windows\\Temp). Attackers drop these scripts to run payloads, keyloggers or modular malware. The rule keys on the file artifact written to disk, so it still fires when command-line logging is evaded or the interpreter binary is renamed or portable."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.010"
    mitre_technique_name = "Command and Scripting Interpreter: AutoHotKey & AutoIT"
    log_prerequisites = "Requires EDR or Sysmon-equivalent file-creation telemetry (Sysmon Event ID 11 or EDR file-write events) with target.file.full_path and the creating process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Power users and hobbyists who write or download AutoHotkey or AutoIt macros, IT automation and packaging teams (SCCM/Intune packages that use AutoIt wrappers), legitimate software installers that unpack .au3 or .ahk helpers into Temp or ProgramData, and developers using code editors."
    tuning_guidance = "Add approved deployment or packaging tools to %global_allowed_admin_tools and trusted parent or host processes to %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts. If the client has an approved AutoHotkey or AutoIt user base, raise the signal by pairing this rule with a creator-process filter such as browsers, archivers, Office or script engines."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(ahk|au3|a3x)$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop)|programdata|users\\public|windows\\temp)\\/ nocase
    not $file.principal.process.file.full_path = /\\(code|notepad\+\+|scite)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1059.010")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
