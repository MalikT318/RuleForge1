/*
  MITRE Technique : T1546.018 - Python Startup Hooks
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:25:36.614374+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/018
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_018_Python_Startup_Hook_Download_Then_Python_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Network-side detection of Python startup-hook staging. A host downloads a Python startup-hook file (.pth, sitecustomize.py or usercustomize.py) from an external source, then a Python HTTP client on the same source address makes an outbound request to a non-allowlisted external destination within 10 minutes. This is consistent with a staged hook being installed and Python then calling out. It is a perimeter-only view: it cannot see the file write itself, so pair it with endpoint file and process detections."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1546.018"
    mitre_technique_name = "Event Triggered Execution: Python Startup Hooks"
    log_prerequisites = "Requires proxy or firewall logs normalised to NETWORK_HTTP with target.url, network.http.user_agent, principal.ip and target.hostname populated. TLS inspection is needed to see URLs and user agents on HTTPS traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Developers or build agents downloading .pth or sitecustomize.py from internal or public repositories, Python-based automation and monitoring agents calling external APIs, and package mirrors that expose .pth files."
    tuning_guidance = "Add trusted package and vendor domains to %global_allowed_domains. Add expected developer and build-host addresses to %global_allowed_mgmt_sources. If a client does not inspect TLS, expect little or no coverage and consider disabling the rule for that client."

  events:
    $dl.metadata.event_type = "NETWORK_HTTP"
    $dl.target.url = /(sitecustomize|usercustomize)\.py([?#]|$)|\.pth([?#]|$)/ nocase
    not $dl.target.hostname in %global_allowed_domains
    not $dl.target.ip in %rfc1918_internal
    not $dl.principal.ip in %global_allowed_mgmt_sources
    $dl.principal.ip = $src_ip

    $beacon.metadata.event_type = "NETWORK_HTTP"
    $beacon.network.http.user_agent = /^(python-requests|python-urllib|python-httpx|aiohttp|urllib3)|^Python/ nocase
    not $beacon.target.hostname in %global_allowed_domains
    not $beacon.target.ip in %rfc1918_internal
    not $beacon.principal.ip in %global_allowed_mgmt_sources
    $beacon.principal.ip = $src_ip

    $dl.metadata.event_timestamp.seconds <= $beacon.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546.018")
    $primary_entity = array_distinct($src_ip)
    $hook_urls = array_distinct($dl.target.url)
    $beacon_hosts = array_distinct($beacon.target.hostname)
    $beacon_ips = array_distinct($beacon.target.ip)
    $beacon_count = count($beacon.metadata.id)

  condition:
    $dl and $beacon
}
