/*
  MITRE Technique : T1134.001 - Token Impersonation/Theft
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:53:59.679430+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_001_PowerShell_Token_Duplication_API_Interop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a PowerShell host launched with a command line that combines native token-manipulation API names (DuplicateToken/DuplicateTokenEx, ImpersonateLoggedOnUser, SetThreadToken, ImpersonateNamedPipeClient) with inline native-interop indicators (Add-Type, DllImport, advapi32, GetProcAddress, delegate marshalling). This is the in-memory scripted way to duplicate and impersonate another user's token. The rule is written for Windows only: token impersonation via these Win32 APIs has no Linux or macOS equivalent, so an alternate-platform variant is not applicable."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.001"
    mitre_technique_name = "Access Token Manipulation: Token Impersonation/Theft"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 / Windows Event 4688 with command-line auditing enabled, normalised to UDM PROCESS_LAUNCH with target.process.command_line populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or developers testing impersonation code in PowerShell; authorised red-team and penetration-test activity; legitimate PowerShell modules that wrap advapi32 token APIs (for example privilege-management or PAM tooling); software deployment scripts that impersonate a service account."
    tuning_guidance = "Add approved parent tooling to %global_allowed_admin_tools, %global_allowed_script_hosts and %global_allowed_security_tools. Add authorised testing hosts or parents to %global_allowed_scanners. Coverage gap: commands passed as -EncodedCommand or loaded from script files hide the API names from the command line, so pair this rule with script-block logging detections. Tighten by requiring a non-interactive parent if the environment is noisy."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|powershell_ise)\.exe$/ nocase
    $proc.target.process.command_line = /(DuplicateToken(Ex)?|ImpersonateLoggedOnUser|SetThreadToken|ImpersonateNamedPipeClient)/ nocase
    $proc.target.process.command_line = /(Add-Type|DllImport|advapi32|GetProcAddress|GetDelegateForFunctionPointer|Marshal\]::)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR)\.exe$/ nocase

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1134.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
