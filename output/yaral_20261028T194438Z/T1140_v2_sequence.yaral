/*
  MITRE Technique : T1140 - Deobfuscate/Decode Files or Information
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:09:26.213021+00:00
  Reference       : https://attack.mitre.org/techniques/T1140
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1140_Linux_Decoded_File_Dropped_Then_Executed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A native decoding or decompression utility (base64, xxd, uudecode, openssl, gpg, gunzip and similar) writes a file into a world-writable staging directory (/tmp, /var/tmp, /dev/shm), and that same file path is then executed on the same host within five minutes. This is the result of deobfuscation (decode, then run) and does not depend on command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1140"
    mitre_technique_name = "Deobfuscate/Decode Files or Information"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that populates both file creation events (with the writing process path) and process launch events (with the executed binary path)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software installers and package post-install scripts that decompress helper binaries into /tmp and run them; CI/CD runners and build agents; configuration management tools (Ansible, Puppet, Chef) staging decoded payloads; self-extracting vendor installers; admin troubleshooting."
    tuning_guidance = "Add approved deployment and configuration-management binaries to %global_allowed_admin_tools (matched against the decoding process path). Add approved parent processes and hosts, such as build agents and CI runners, to %global_allowed_script_hosts. If gunzip/zcat/unxz are noisy in a given estate, remove them from the decoder regex for that client."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(base64|xxd|uudecode|openssl|gpg|gunzip|zcat|bunzip2|unxz)$/ nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/./ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $path

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/./ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname
    $proc.target.process.file.full_path = $path

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1140")
    $primary_entity = array_distinct($hostname)
    $decoder_processes = array_distinct($file.principal.process.file.full_path)
    $executed_paths = array_distinct($proc.target.process.file.full_path)
    $executing_users = array_distinct($proc.principal.user.userid)
    $first_file_write = min($file.metadata.event_timestamp.seconds)
    $last_execution = max($proc.metadata.event_timestamp.seconds)

  condition:
    $file and $proc
}
