/*
  MITRE Technique : T1651 - Cloud Administration Command
  Tactic(s)       : Execution
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:53:13.437274+00:00
  Reference       : https://attack.mitre.org/techniques/T1651
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1651_Cloud_Run_Command_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects configuration changes in the cloud control plane that enable remote command execution on virtual machines. This covers creating or modifying scheduled command associations, command document content or sharing, maintenance window command tasks, VM run-command or extension definitions, automation runbook or webhook changes, and instance metadata changes that can carry startup scripts. These state changes persist even when the individual command invocation is not logged."
    mitre_tactic = "Execution"
    mitre_technique = "T1651"
    mitre_technique_name = "Cloud Administration Command"
    log_prerequisites = "Cloud provider management-plane audit logging must be enabled and ingested with write/management events, with metadata.product_event_type populated with the API operation name."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Infrastructure-as-code pipelines, patch management and configuration-management automation, cloud operations teams maintaining command documents or runbooks, autoscaling and image-build workflows that set instance metadata."
    tuning_guidance = "Add CI/CD and automation identities to %global_allowed_cloud_principals or %global_allowed_service_accounts, and named cloud administrators to %global_allowed_admin_users. Narrow or remove the instance metadata alternative in the regex if it is too noisy for a client."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /^(CreateAssociation|UpdateAssociation|RegisterTaskWithMaintenanceWindow|UpdateDocument|UpdateDocumentDefaultVersion|ModifyDocumentPermission)$|microsoft\.compute\/virtualmachines\/(runcommands|extensions)\/write|microsoft\.automation\/automationaccounts\/(runbooks|webhooks)\/(write|publish\/action)|compute\.instances\.setMetadata$/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1651")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_operations = array_distinct($cloud.metadata.product_event_type)
    $target_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
