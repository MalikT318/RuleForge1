/*
  MITRE Technique : T1485 - Data Destruction
  Tactic(s)       : Impact
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:36:13.973858+00:00
  Reference       : https://attack.mitre.org/techniques/T1485
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1485_Linux_Service_Parent_Spawns_Data_Destruction {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server or database service process (or a container workload running one) spawning a data-destruction utility or a shell running one. Examples are secure-erase tools, recursive deletion of system or data directories, and zero/random overwrite with dd. Web, application and database services should never launch these tools, so this lineage points to webshell, RCE or injection-driven data destruction."
    mitre_tactic = "Impact"
    mitre_technique = "T1485"
    mitre_technique_name = "Data Destruction"
    log_prerequisites = "Requires Linux process-launch telemetry with parent and child executable paths, from container runtime or node-level EDR, or auditd execve records normalised to UDM PROCESS_LAUNCH. Parent process paths must be populated (principal.process.file.full_path)."
    platform = "Linux"
    log_source = "container"
    false_positives = "Application cache or temp-file cleanup by PHP/CGI handlers using rm -rf on application directories; database maintenance scripts launched by the database service; deployment hooks run by the web server user; secure-delete features in document management apps."
    tuning_guidance = "Add approved parent processes and maintenance wrappers to %global_allowed_script_hosts, and sanctioned administration or cleanup tooling to %global_allowed_admin_tools. Extend the parent regex with local service names (for example application-specific launchers). Narrow the rm target-directory list if application data lives under /var or /opt and is routinely cleaned."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Unexpected parent: network-facing or data-tier service process
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|caddy|php-fpm[0-9.]*|php-cgi|php[0-9.]*|tomcat[0-9.]*|catalina|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|memcached|elasticsearch)$/ nocase

    // Child: destructive utility, or a shell/interpreter launching one
    (
      $proc.target.process.file.full_path = /\/(shred|srm|wipefs|blkdiscard|sfill|secure-delete)$/ nocase
      or
      (
        $proc.target.process.file.full_path = /\/rm$/ nocase and
        $proc.target.process.command_line = /\s-[a-z]*r[a-z]*\s+(-\S+\s+)*\/(etc|var|home|srv|opt|data|boot|usr|root|mnt|lib|bin|sbin|\*)?(\s|\/|$)/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\/dd$/ nocase and
        $proc.target.process.command_line = /\bif=\/dev\/(zero|urandom|random)\b/ nocase and
        $proc.target.process.command_line = /\bof=\// nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\/(ba|da|a|z|k)?sh$/ nocase and
        $proc.target.process.command_line = /\b(shred|srm|wipefs|blkdiscard)\b|\brm\s+-[a-z]*r[a-z]*\s+(-\S+\s+)*\/(etc|var|home|srv|opt|data|boot|usr|root|mnt|\*)|\bdd\s+if=\/dev\/(zero|urandom|random)/ nocase
      )
    )

    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1485")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
