/*
  MITRE Technique : T1219 - Remote Access Tools
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:04:34.349194+00:00
  Reference       : https://attack.mitre.org/techniques/T1219
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1219_Linux_Server_Process_Spawns_Remote_Access_Channel {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, database, or print service process spawning a tunnelling or remote-session capable utility (ssh, socat, netcat family, telnet), or a shell opening a /dev/tcp or /dev/udp socket. Server daemons do not normally launch interactive remote-access channels. This pattern indicates a web shell or exploited service establishing a back-connect or remote access channel. Detection is based on process lineage, not on a named remote access product."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1219"
    mitre_technique_name = "Remote Access Tools"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records normalised to UDM PROCESS_LAUNCH with populated parent (principal.process) and child (target.process) file paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Database or application health-check scripts that call nc or telnet for port checks, PostgreSQL or MySQL replication and backup wrappers that tunnel over ssh, web applications that deliberately shell out to ssh for deployment, CUPS backends, and administrators debugging from a service account."
    tuning_guidance = "Add approved parent daemon paths to %global_allowed_script_hosts, approved tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Remove daemon names from the parent regex if a client legitimately uses them for remote tunnelling."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|php-fpm[0-9.]*|lighttpd|caddy|tomcat[0-9]*|catalina|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|cupsd)$/ nocase
    (
      $proc.target.process.file.full_path = /\/(ssh|autossh|socat|ncat|nc|netcat|nc\.openbsd|nc\.traditional|telnet)$/ nocase
      or
      (
        $proc.target.process.file.full_path = /\/(ba|da|z|k|c|tc)?sh$/ nocase
        and $proc.target.process.command_line = /\/dev\/(tcp|udp)\// nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1219")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
