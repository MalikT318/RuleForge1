/*
  MITRE Technique : T1572 - Protocol Tunneling
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:20:25.516700+00:00
  Reference       : https://attack.mitre.org/techniques/T1572
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1572_ESXi_Repeated_SSH_Sessions_Tunnel_Indicator {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of SSH logins to a single ESXi host within ten minutes from sources outside the approved management list. SSH port forwarding and SOCKS tunnelling through a hypervisor typically need repeated or long-lived SSH sessions. Each login is benign on its own, but the volume suggests the host is being used as a tunnel or pivot."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1572"
    mitre_technique_name = "Protocol Tunneling"
    log_prerequisites = "ESXi auth and shell logs (sshd entries in auth.log / shell.log, hostd) forwarded and parsed to UDM USER_LOGIN events with the source address in principal.ip and the ESXi host in target.hostname."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators or automation (backup, patching, monitoring, inventory scripts) making repeated SSH connections from unlisted jump hosts; troubleshooting sessions with several reconnects; vendor support access."
    tuning_guidance = "Add jump hosts and management stations to %global_allowed_mgmt_sources. Add named administrators to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Raise the threshold on hosts with heavy scripted SSH usage. Review the outcome source_ips and users for a single external or unusual source."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.application = /ssh/ nocase
    $auth.target.hostname = $host
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.target.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1572")
    $primary_entity = array_distinct($host)
    $login_count = count($auth.metadata.id)
    $source_ips = array_distinct($auth.principal.ip)
    $users = array_distinct($auth.target.user.userid)

  condition:
    #auth >= 5
}
