/*
  MITRE Technique : T1204.003 - Malicious Image
  Tactic(s)       : Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:02:22.923634+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_003_Cloud_Machine_Image_Sharing_Permission_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a permission or sharing change on a virtual machine or container image in the cloud control plane (image launch-permission change, image IAM policy change, image gallery share). Adversaries publish or share backdoored images so that other users deploy instances from them. This rule detects the configuration state change rather than any command line."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.003"
    mitre_technique_name = "User Execution: Malicious Image"
    log_prerequisites = "Cloud control-plane audit logging (management events) ingested and normalised to UDM, with metadata.product_event_type populated with the API operation name."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Image build pipelines sharing golden images with other accounts or projects, platform teams publishing approved images to a shared gallery, and administrators sharing images between sibling accounts or subscriptions."
    tuning_guidance = "Add CI/CD and image-pipeline identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and platform administrators to %global_allowed_admin_users. Raise severity if your environment never shares images outside its organisation."

  events:
    $cloud.metadata.event_type = "RESOURCE_PERMISSIONS_CHANGE"
    $cloud.metadata.product_event_type = /(ModifyImageAttribute|ResetImageAttribute|images\.setIamPolicy|compute\.images\.setIamPolicy|galleries\/share\/action|galleries\/images\/.*(share|write))/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1204.003")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $operation = array_distinct($cloud.metadata.product_event_type)
    $image_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
