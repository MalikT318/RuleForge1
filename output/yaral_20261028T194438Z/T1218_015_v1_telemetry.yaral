/*
  MITRE Technique : T1218.015 - Electron Applications
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:02:01.438642+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_015_Electron_App_Package_Tampering {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of an Electron application's code package (resources\\app.asar) or loose JavaScript under resources\\app\\ by a process other than approved installers or management tooling. Adversaries plant or backdoor JavaScript inside trusted Electron apps such as chat and collaboration clients so that malicious code runs under a signed, trusted host process. This rule works on the resulting file artifact rather than command lines, so it is independent of process-creation logging and of how the file was written."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.015"
    mitre_technique_name = "System Binary Proxy Execution: Electron Applications"
    log_prerequisites = "Requires endpoint file-write telemetry (EDR or Sysmon Event ID 11/2 equivalent) that populates target.file.full_path and the writing process path, and normalised to FILE_MODIFICATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Electron application auto-updaters (Squirrel Update.exe, built-in updaters), MSI or MSIX installers and patching tools, developers building or debugging Electron apps, software deployment agents pushing app updates, and the Electron app itself replacing its own package during a self-update."
    tuning_guidance = "Add approved deployment, patching and updater binaries to %global_allowed_admin_tools. Add endpoint security agents that rewrite application files to %global_allowed_security_tools. Developer workstations that build Electron apps may need a host-scoped exclusion, or the writer process added to %global_allowed_script_hosts. If a managed Electron app self-updates frequently, exclude its updater executable name in the regex below."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\\resources\\(app\.asar|app\\[^\\]+\.(js|cjs|mjs))$/ nocase
    $file.principal.process.file.full_path != ""
    not $file.principal.process.file.full_path = /\\(Update|msiexec|TrustedInstaller|TiWorker|MsMpEng|setup|installer)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1218.015")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
