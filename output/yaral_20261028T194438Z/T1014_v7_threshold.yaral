/*
  MITRE Technique : T1014 - Rootkit
  Tactic(s)       : Stealth
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:27:06.637366+00:00
  Reference       : https://attack.mitre.org/techniques/T1014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1014_Windows_Rootkit_Driver_Loading_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of kernel-driver loading and driver-integrity tampering commands on a single Windows host within 10 minutes. The commands covered are creating or configuring kernel, file-system or recognizer driver services with sc, loading minifilters with fltmc, enabling test-signing or disabling integrity checks with bcdedit, and staging drivers with pnputil. One such command is common administration. Several in a short window on one host match how rootkits install and load kernel-mode components that hide processes, files, and network connections."
    mitre_tactic = "Stealth"
    mitre_technique = "T1014"
    mitre_technique_name = "Rootkit"
    log_prerequisites = "Requires EDR process telemetry, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Hardware or peripheral driver installers, virtualization and VPN client installs, anti-cheat or DRM software, driver developers and kernel debugging labs, imaging and OS deployment tasks, and patching or RMM tooling that stages drivers."
    tuning_guidance = "Add approved deployment, driver management and RMM parent processes to %global_allowed_admin_tools. Add security agent parent processes to %global_allowed_security_tools. Raise the #proc threshold on build, lab or VDI hosts that routinely install drivers. Correlate with unsigned driver loads or new .sys files in user-writable paths before escalating."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(sc|fltmc|bcdedit|pnputil)\.exe$/ nocase
    $proc.target.process.command_line = /((create|config)\s.*\btype\s*=\s*(kernel|filesys|recognizer)\b|\bload\s+\S+|testsigning\s+(on|yes)|nointegritychecks\s+(on|yes)|DDISABLE_INTEGRITY_CHECKS|\/add-driver\s.*\.sys|-a\s.*\.sys)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    $proc.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1014")
    $primary_entity = array_distinct($host)
    $event_count = count($proc.metadata.id)
    $commands = array_distinct($proc.target.process.command_line)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)

  condition:
    #proc >= 3
}
