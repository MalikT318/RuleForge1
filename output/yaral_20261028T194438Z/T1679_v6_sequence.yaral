/*
  MITRE Technique : T1679 - Selective Exclusion
  Tactic(s)       : Stealth
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:27:35.461653+00:00
  Reference       : https://attack.mitre.org/techniques/T1679
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1679_Selective_Exclusion_Args_Then_Ransom_Note {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A process running from a user-writable location is launched with command-line arguments that exclude executable-type extensions (.exe, .dll, .lnk) from processing. Within 10 minutes the same image drops a ransom-note-style file (readme, decrypt, restore, recover, ransom, how-to .txt/.html/.hta) on the same host. This indicates ransomware selectively excluding system-critical file types so the host stays usable for the ransom note."
    mitre_tactic = "Stealth"
    mitre_technique = "T1679"
    mitre_technique_name = "Selective Exclusion"
    log_prerequisites = "Requires Windows EDR or Sysmon process launch telemetry with command lines (Sysmon EID 1, Security 4688 with command-line auditing) and file creation telemetry (Sysmon EID 11 or EDR equivalent) with the creating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup, copy or sync utilities (robocopy-style /XF switches, archivers) run from user-writable paths; portable admin tools or installers with exclusion switches that also write a readme or restore text file; developer build scripts run from user profile directories."
    tuning_guidance = "Add approved backup and imaging binaries to %global_allowed_backup_processes. Add approved admin or deployment tooling and script parents to %global_allowed_admin_tools. Add known-good script hosts to %global_allowed_script_hosts. If readme-style files cause noise, narrow the ransom-note filename regex on the file event."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(Users\\[^\\]+|ProgramData|Windows\\Temp|Temp|AppData|Public)\\.*\.exe$/ nocase
    $proc.target.process.command_line = /(exclude|skip|ignore|omit|except|bypass|avoid)\w*[\s=:"']+.{0,80}\.(exe|dll|lnk)\b/ nocase
    $proc.target.process.command_line = /\.(exe|dll|lnk)\b.{0,80}\.(exe|dll|lnk)\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_backup_processes
    $proc.principal.hostname = $hostname
    $proc.target.process.file.full_path = $proc_path

    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(decrypt|restore|recover|ransom|read[_\-\s]?me|how[_\-\s]?to)[^\\]*\.(txt|html|hta)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname
    $file.principal.process.file.full_path = $proc_path

    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname, $proc_path over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1679")
    $primary_entity = array_distinct($hostname)
    $exclusion_command_lines = array_distinct($proc.target.process.command_line)
    $ransom_note_paths = array_distinct($file.target.file.full_path)
    $ransom_note_count = count($file.metadata.id)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc and $file
}
