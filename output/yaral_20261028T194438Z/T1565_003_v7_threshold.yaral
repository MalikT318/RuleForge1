/*
  MITRE Technique : T1565.003 - Runtime Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:44:44.294544+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_003_Bulk_File_Association_Handler_Changes {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects several file association or shell open-command handler registry changes on a single Windows host within ten minutes. Adversaries hijack file handlers so that data is opened and displayed by a trojanised or altered application, which manipulates what the end user sees at runtime. A single handler change is routine, but a burst of them from one host is not."
    mitre_tactic = "Impact"
    mitre_technique = "T1565.003"
    mitre_technique_name = "Data Manipulation: Runtime Data Manipulation"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events) normalised to REGISTRY_MODIFICATION with target.registry.registry_key populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters registering file types, default-application changes made by users or deployment tooling, Office or PDF reader installs and repairs, RMM and software deployment agents, and profile migration tools."
    tuning_guidance = "Add deployment and RMM binaries to %global_allowed_admin_tools, EDR and AV agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Raise the #reg threshold on hosts where installers run frequently, such as build servers or VDI golden images."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(Software\\Classes\\[^\\]+\\shell\\[^\\]+\\command|Explorer\\FileExts\\\.[^\\]+\\UserChoice)(\\|$)/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($reg.metadata.id)
    $mitre_technique_id = array_distinct("T1565.003")
    $primary_entity = array_distinct($host)
    $modified_keys = array_distinct($reg.target.registry.registry_key)
    $modifying_processes = array_distinct($reg.principal.process.file.full_path)
    $users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 5
}
