/*
  MITRE Technique : T1570 - Lateral Tool Transfer
  Tactic(s)       : Lateral Movement
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:16:19.205406+00:00
  Reference       : https://attack.mitre.org/techniques/T1570
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1570_Remote_Executable_Drops_By_SMB_Server_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of executable, script or driver file creations on one host that are written by the kernel/System context. On Windows, files copied in over SMB (admin shares such as ADMIN$ or C$) are written by the System process rather than by a user-mode process. Any single drop is benign; five or more within 10 minutes on one host indicates lateral staging of tools."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1570"
    mitre_technique_name = "Lateral Tool Transfer"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with the creating process populated. The SMB server writes as the System process (PID 4)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software deployment and patching platforms pushing installers over SMB, RMM agents, SCCM/Intune distribution points, golden-image or profile roaming copies, backup restores, and file servers hosting installer shares."
    tuning_guidance = "Add deployment and patching service accounts to %global_allowed_service_accounts, and approved deployment tooling to %global_allowed_admin_tools. Raise the #file threshold on software distribution servers or file servers. Hosts that legitimately receive bulk installers can be scoped out by adding their administrators to %global_allowed_admin_users."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /(^|\\)(system|ntoskrnl\.exe)$/ nocase
    $file.target.file.full_path = /\\(windows|programdata|temp|perflogs|users\\[^\\]+\\appdata|users\\public)\\.*\.(exe|dll|sys|ps1|bat|cmd|vbs|js|msi|scr|hta)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $file_count = count($file.metadata.id)
    $dropped_files = array_distinct($file.target.file.full_path)
    $mitre_technique_id = array_distinct("T1570")
    $primary_entity = array_distinct($host)

  condition:
    #file >= 5
}
