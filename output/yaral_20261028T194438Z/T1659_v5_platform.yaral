/*
  MITRE Technique : T1659 - Content Injection
  Tactic(s)       : Initial Access, Command and Control
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:03:25.267152+00:00
  Reference       : https://attack.mitre.org/techniques/T1659
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1659_Linux_Plaintext_HTTP_Executable_Fetch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects Linux client tooling (package managers, curl, wget) retrieving packages, scripts or binaries over unencrypted HTTP from an external host, as seen at the network perimeter. Plaintext delivery of executable content can be tampered with by an on-path or on-the-side adversary (content injection). Linux clients are identified from the HTTP user-agent because firewall logs carry no process fields."
    mitre_tactic = "Initial Access, Command and Control"
    mitre_technique = "T1659"
    mitre_technique_name = "Content Injection"
    log_prerequisites = "Requires firewall or proxy logs with HTTP inspection, normalised to NETWORK_HTTP with network.http.user_agent, target.url and target.port populated. Not visible for TLS-encrypted traffic unless decrypted."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legacy or mirror-based package repositories served over HTTP, internal-style mirrors on external addresses, vendor installers that fetch scripts over HTTP, and admin ad-hoc downloads with curl or wget."
    tuning_guidance = "Add trusted repository and mirror domains to %global_allowed_domains. Tune the extension list to your environment. Prioritise hits where the same client later shows new outbound C2-like connections."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.port = 80
    $http.network.http.user_agent = /(apt-http|debian apt|libzypp|zypp|yum|dnf|urlgrabber|libcurl|curl\/|wget|python-requests|python-urllib|go-http-client)/ nocase
    $http.target.url = /\.(deb|rpm|sh|run|bin|elf|so|apk|pl|py|tar\.gz|tgz)(\?.*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1659")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_host = array_distinct($http.target.hostname)
    $destination_ip = array_distinct($http.target.ip)
    $requested_url = array_distinct($http.target.url)
    $user_agent = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
