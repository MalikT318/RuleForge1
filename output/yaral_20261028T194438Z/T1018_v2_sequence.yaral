/*
  MITRE Technique : T1018 - Remote System Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:27:50.904282+00:00
  Reference       : https://attack.mitre.org/techniques/T1018
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1018_ESXi_Login_Then_Remote_System_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A user logs in to an ESXi host (SSH or shell session) from a source not on the management allowlist. Within 10 minutes, at least two network-neighbour or host-reachability discovery commands run on the same host. Examples are esxcli network ip neighbor, esxcli network diag ping, arp, nslookup, traceroute, ping and reads of /etc/hosts. This session-to-discovery sequence indicates an adversary mapping reachable systems for lateral movement from the hypervisor."
    mitre_tactic = "Discovery"
    mitre_technique = "T1018"
    mitre_technique_name = "Remote System Discovery"
    log_prerequisites = "ESXi syslog (hostd, shell, auth) forwarded and parsed into UDM. Requires USER_LOGIN events for ESXi authentication and PROCESS_LAUNCH events from shell logging. The ESXi host name must populate principal.hostname on both event types."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators from unlisted jump hosts troubleshooting connectivity, patching or migration (vMotion, vSAN or storage network checks), backup and monitoring agents that log in over SSH and run ping or arp, and automation or orchestration that validates network reachability after login."
    tuning_guidance = "Add approved jump host and management source addresses to %global_allowed_mgmt_sources. Add named administrators to %global_allowed_admin_users. Add automation accounts to %global_allowed_service_accounts. Add approved tooling parent binaries to %global_allowed_admin_tools. Raise the #proc threshold (currently 2) in noisy environments."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $hostname
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.target.user.userid in %global_allowed_service_accounts

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.hostname = $hostname
    $proc.target.process.command_line = /(esxcli\s+network\s+(ip\s+neighbor|diag\s+ping)|\barp\s+-[an]|\b(nslookup|traceroute|ping6?)\s|\/etc\/hosts)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

    $auth.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1018")
    $primary_entity = array_distinct($hostname)
    $login_users = array_distinct($auth.target.user.userid)
    $login_source_ips = array_distinct($auth.principal.ip)
    $discovery_commands = array_distinct($proc.target.process.command_line)
    $discovery_count = count($proc.metadata.id)

  condition:
    $auth and #proc >= 2
}
