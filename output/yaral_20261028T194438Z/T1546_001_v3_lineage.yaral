/*
  MITRE Technique : T1546.001 - Change Default File Association
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:00:51.116740+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_001_Unexpected_Parent_Changes_File_Association {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, script interpreter or reg.exe launched by a parent that should not be spawning shells (Office application, web server, print spooler, database service) where the child command line modifies file association handlers (assoc, ftype, shell\\open\\command under Classes/HKCR, FileExts/UserChoice). Pivots on anomalous process lineage rather than on the command line alone."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.001"
    mitre_technique_name = "Event Triggered Execution: Change Default File Association"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and child command line (EDR, Sysmon Event ID 1 or Windows Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office add-ins or installers that register custom file handlers through a spawned shell, web-hosted application installers or deployment tooling running under a web server or database service account, and software packaging or migration scripts launched from Office macros in managed environments."
    tuning_guidance = "Add approved deployment or packaging parent binaries to %global_allowed_admin_tools, trusted script-launching parents to %global_allowed_script_hosts, security agents to %global_allowed_security_tools, and named administrators to %global_allowed_admin_users. Adjust the parent process regex if the client runs additional line-of-business services that legitimately spawn shells."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|spoolsv|sqlservr|mysqld|oracle)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|reg)\.exe$/ nocase
    $proc.target.process.command_line = /(\bassoc\s+\.[a-z0-9_-]+\s*=|\bftype\s+[^\s=]+\s*=|(hkcr|hkey_classes_root|software\\classes)\\[^\s"]*shell\\[^\s"]*\\command|\\fileexts\\\.[a-z0-9_-]+|\buserchoice\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1546.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
