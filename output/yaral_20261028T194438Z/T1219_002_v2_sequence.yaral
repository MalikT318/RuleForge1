/*
  MITRE Technique : T1219.002 - Remote Desktop Software
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:08:08.649566+00:00
  Reference       : https://attack.mitre.org/techniques/T1219/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1219_002_Outbound_Remote_Desktop_Session_Established {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects an internal host that opens an outbound connection to an external address on a well-known remote desktop or remote support port, followed within 10 minutes by a flow to the same external address on those ports with substantial data transfer. This indicates an established interactive remote-control session over the perimeter rather than a single probe or blocked attempt."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1219.002"
    mitre_technique_name = "Remote Access Tools: Remote Desktop Software"
    log_prerequisites = "Requires firewall or perimeter logs normalised to UDM NETWORK_CONNECTION and NETWORK_FLOW with principal.ip, target.ip, target.port and network.sent_bytes / network.received_bytes populated. The flow or session-end log must carry byte counters."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Approved helpdesk or RMM tooling that uses these ports, administrators using RDP or VNC to external hosted systems, vendor support sessions, and cloud-hosted jump hosts reached over RDP."
    tuning_guidance = "Add approved source addresses (helpdesk workstations, jump hosts) to %global_allowed_mgmt_sources and authorised testing sources to %global_allowed_scanners. Raise or lower the byte thresholds to match the client's baseline. If a port is noisy in a given client (for example 7070), remove it from both event blocks."

  events:
    $conn.metadata.event_type = "NETWORK_CONNECTION"
    (
      $conn.target.port = 3389 or
      $conn.target.port = 5900 or
      $conn.target.port = 5938 or
      $conn.target.port = 7070 or
      $conn.target.port = 5650
    )
    not $conn.target.ip in %rfc1918_internal
    not $conn.principal.ip in %global_allowed_mgmt_sources
    not $conn.principal.ip in %global_allowed_scanners
    $conn.principal.ip = $src_ip
    $conn.target.ip = $dst_ip

    $flow.metadata.event_type = "NETWORK_FLOW"
    (
      $flow.target.port = 3389 or
      $flow.target.port = 5900 or
      $flow.target.port = 5938 or
      $flow.target.port = 7070 or
      $flow.target.port = 5650
    )
    (
      $flow.network.sent_bytes > 100000 or
      $flow.network.received_bytes > 100000
    )
    not $flow.target.ip in %rfc1918_internal
    not $flow.principal.ip in %global_allowed_mgmt_sources
    not $flow.principal.ip in %global_allowed_scanners
    $flow.principal.ip = $src_ip
    $flow.target.ip = $dst_ip

    $conn.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $src_ip, $dst_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1219.002")
    $primary_entity = array_distinct($src_ip)
    $destination_ips = array_distinct($dst_ip)
    $destination_ports = array_distinct($flow.target.port)
    $total_sent_bytes = sum($flow.network.sent_bytes)
    $total_received_bytes = sum($flow.network.received_bytes)

  condition:
    $conn and $flow
}
