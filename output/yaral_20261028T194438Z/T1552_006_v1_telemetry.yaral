/*
  MITRE Technique : T1552.006 - Group Policy Preferences
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:53:35.052802+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_006_GPP_XML_Artifact_Written_Outside_Policy_Store {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a Group Policy Preferences XML file (Groups, Services, ScheduledTasks, DataSources, Printers, Drives) outside the legitimate SYSVOL and Group Policy client-cache locations. GPP XML files can contain AES-encrypted cpassword values that any domain user can decrypt. A copy of one onto a workstation, user profile, temp folder or staging share indicates credential harvesting from SYSVOL. This rule works on the resulting file artifact, so it does not depend on command-line logging."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.006"
    mitre_technique_name = "Unsecured Credentials: Group Policy Preferences"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with the initiating process populated. Cannot see file content or reads performed directly over SMB without a local write."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators backing up or migrating GPOs to local folders, GPO backup and reporting tools, configuration-management or RMM agents that stage policy files, security assessment tooling (for example AD health checks), and file-sync clients copying admin shares."
    tuning_guidance = "Add approved admin, GPO backup and assessment tooling executables to %global_allowed_admin_tools, backup or imaging software to %global_allowed_backup_processes, and named GPO administrators to %global_allowed_admin_users. If administrators legitimately export GPOs to a known share, extend the path exclusion with that location per client."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(groups|services|scheduledtasks|datasources|printers|drives)\.xml$/ nocase
    not $file.target.file.full_path = /\\(sysvol|group policy\\history)\\/ nocase
    not $file.principal.process.file.full_path = /\\(svchost|dfsrs|gpmc|mmc|msiexec|trustedinstaller)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1552.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $file_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
