/*
  MITRE Technique : T1569 - System Services
  Tactic(s)       : Execution
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:10:42.721627+00:00
  Reference       : https://attack.mitre.org/techniques/T1569
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_Linux_Burst_Service_Start_Or_Transient_Unit {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of systemctl start/restart or systemd-run launches on a single Linux host within 10 minutes. A single service start is routine, but a high volume in a short window can indicate an adversary using system services or transient units to execute payloads (T1569 System Services)."
    mitre_tactic = "Execution"
    mitre_technique = "T1569"
    mitre_technique_name = "System Services"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records normalised to UDM PROCESS_LAUNCH with populated target.process.file.full_path and target.process.command_line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management (Ansible, Puppet, Chef, Salt) runs, package installs and upgrades restarting services, container or orchestration node bootstrap, patching windows, and admins restarting several services during maintenance."
    tuning_guidance = "Add approved automation and deployment binaries to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Add trusted parent shells or hosts to %global_allowed_script_hosts. Raise the #proc threshold on noisy hosts such as build servers or orchestrator nodes."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(systemctl|systemd-run|service)$/ nocase
    $proc.target.process.command_line = /(systemd-run|\b(start|restart|try-restart|reload-or-restart)\b|enable\s+--now)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1569")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 10
}
