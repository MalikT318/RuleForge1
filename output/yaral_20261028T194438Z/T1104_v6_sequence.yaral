/*
  MITRE Technique : T1104 - Multi-Stage Channels
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:00:29.253504+00:00
  Reference       : https://attack.mitre.org/techniques/T1104
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1104_ESXi_Download_Then_Exec_Staged_Payload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a multi-stage command-and-control pattern on an ESXi host: the shell first uses wget or curl to pull a remote payload into a writable staging directory (/tmp, /scratch, /var/tmp, /dev/shm, /var/run), and within 10 minutes a binary is executed from one of those directories. This is the first-stage loader fetching and launching a second-stage implant."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1104"
    mitre_technique_name = "Multi-Stage Channels"
    log_prerequisites = "Requires ESXi shell and process execution logging forwarded to Chronicle and parsed into UDM PROCESS_LAUNCH events with principal.hostname, target.process.file.full_path and target.process.command_line populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators manually downloading VIBs, patches, scripts or diagnostic tools to /tmp or /scratch and running them; vendor support staff running health-check binaries; automation or lifecycle tooling that stages and executes helper binaries from /tmp."
    tuning_guidance = "Add approved admin tooling and wrapper scripts to %global_allowed_admin_tools, and named administrator accounts to %global_allowed_admin_users. Narrow the staging directory regex if the environment legitimately executes from a specific directory, and raise or lower the 10m window to suit local change-window behaviour."

  events:
    $dl.metadata.event_type = "PROCESS_LAUNCH"
    $dl.target.process.file.full_path = /(^|\/)(wget|curl)$/ nocase
    $dl.target.process.command_line = /https?:\/\// nocase
    $dl.target.process.command_line = /\/(tmp|scratch|var\/tmp|dev\/shm|var\/run)\// nocase
    not $dl.principal.process.file.full_path in %global_allowed_admin_tools
    $dl.principal.hostname = $hostname

    $exec.metadata.event_type = "PROCESS_LAUNCH"
    $exec.target.process.file.full_path = /^\/(tmp|scratch|var\/tmp|dev\/shm|var\/run)\/[^\/]+/ nocase
    not $exec.target.process.file.full_path = /(^|\/)(wget|curl)$/ nocase
    not $exec.principal.process.file.full_path in %global_allowed_admin_tools
    not $exec.principal.user.userid in %global_allowed_admin_users
    $exec.principal.hostname = $hostname

    $dl.metadata.event_timestamp.seconds <= $exec.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1104")
    $primary_entity = array_distinct($hostname)
    $download_commands = array_distinct($dl.target.process.command_line)
    $executed_binaries = array_distinct($exec.target.process.file.full_path)
    $executing_users = array_distinct($exec.principal.user.userid)
    $exec_event_count = count($exec.metadata.id)

  condition:
    $dl and $exec
}
