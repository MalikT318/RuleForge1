/*
  MITRE Technique : T1495 - Firmware Corruption
  Tactic(s)       : Impact
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:48:19.152752+00:00
  Reference       : https://attack.mitre.org/techniques/T1495
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1495_Firmware_Image_Download_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal Windows client fetching a firmware or BIOS/UEFI image or flasher from a non-allowlisted external destination, as seen in proxy or firewall HTTP telemetry. Firmware corruption has no direct network signature, so this rule covers only the staging step, where a firmware image or flash utility is pulled onto a host before it is written to flash. The rule matches the combination of a firmware-related URL keyword and a firmware or flasher payload extension. It uses no vendor, domain or filename indicators."
    mitre_tactic = "Impact"
    mitre_technique = "T1495"
    mitre_technique_name = "Firmware Corruption"
    log_prerequisites = "Requires firewall or web-proxy logs normalised to UDM NETWORK_HTTP with target.url populated (URL-aware inspection or TLS interception). Without URL visibility the rule will not fire."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate OEM BIOS/UEFI/BMC firmware updates fetched directly from vendor sites by IT staff or driver-update agents; hardware lab and imaging staging; developers downloading firmware for embedded devices; network teams downloading device firmware through a Windows jump host."
    tuning_guidance = "Add OEM and update-service domains to %global_allowed_domains. Match is on exact target.hostname, so list each hostname or the exact CDN names. Add patch-management or software-distribution server addresses to %global_allowed_mgmt_sources. Raise severity for servers and domain controllers, or where the source is not an IT workstation subnet. Correlate with endpoint telemetry on firmware-flash tool execution."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /(bios|uefi|firmware|bmc|flashrom|biosflash)/ nocase
    $net.target.url = /\.(rom|cap|fd|wph|bio|bin|exe|zip)([?#].*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1495")
    $primary_entity = array_distinct($net.principal.ip)
    $requested_urls = array_distinct($net.target.url)
    $destination_hosts = array_distinct($net.target.hostname)

  condition:
    $net
}
