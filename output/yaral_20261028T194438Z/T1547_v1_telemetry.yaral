/*
  MITRE Technique : T1547 - Boot or Logon Autostart Execution
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Network Devices
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:21:03.497798+00:00
  Reference       : https://attack.mitre.org/techniques/T1547
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

// NOTE: the request pairs a Network Devices platform with the macos_endpoint log_source identifier.
// log_source is set to the identifier supplied, but the logic only applies to network-device management-plane telemetry.
// Confirm the log-source mapping before deploying, because macOS endpoint tenants will never produce these events.
rule MSSP_T1547_NetDevice_Boot_Startup_Config_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a management-plane configuration change on a network device that alters boot or startup behaviour: boot image or boot config selection, startup-config writes, scheduled or event-triggered on-device jobs, or init-script style entries. These changes cause attacker-supplied code or configuration to run at device boot or on a trigger, and are logged as configuration state changes rather than process activity."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547"
    mitre_technique_name = "Boot or Logon Autostart Execution"
    log_prerequisites = "Requires network device syslog or AAA/command-accounting logs normalised to SETTING_MODIFICATION, with the configuration command or setting name populated in target.resource.name or metadata.description. Note: log_source is set to the supplied identifier; the telemetry itself is network-device management-plane logging."
    platform = "Network Devices"
    log_source = "macos_endpoint"
    false_positives = "Planned firmware upgrades that change the boot image, authorised admins saving running-config to startup-config, network automation pushing scheduled jobs or event-triggered scripts, and ZTP/provisioning during device onboarding."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation or provisioning accounts to %global_allowed_service_accounts. Correlate alerts with change-management windows. If the command text is mapped to a different UDM field in your parser, adjust the field reference in the regex condition."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    (
      $setting.target.resource.name = /^\s*(no\s+)?(boot\s+(system|config|host|bootstrap|variable|markers?|-start)|event\s+manager\s+applet|kron\s+(policy-list|occurrence)|scheduler\s+(job|schedule)|(copy|write)\s+\S*\s*\S*startup-config|startup-config|rc\.local|init\.d|init[-_ ]script)/ nocase
      or
      $setting.metadata.description = /(boot\s+(system|config|host|variable)|event\s+manager\s+applet|kron\s+(policy-list|occurrence)|scheduler\s+(job|schedule)|startup-config\s+(modified|updated|written)|copy\s+\S+\s+startup-config)/ nocase
    )
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1547")
    $primary_entity = array_distinct(strings.coalesce($setting.principal.hostname, $setting.target.hostname))
    $changed_setting = array_distinct($setting.target.resource.name)
    $acting_user = array_distinct($setting.principal.user.userid)
    $source_ip = array_distinct($setting.principal.ip)

  condition:
    $setting
}
