/*
  MITRE Technique : T1548.002 - Bypass User Account Control
  Tactic(s)       : Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:30:58.135733+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_002_AutoElevate_Binary_Spawns_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows auto-elevating binary (the kind abused for UAC bypass via registry hijack, COM or INF handling) acting as the parent of a command shell, script interpreter or script-hosting binary. These binaries do not normally spawn interactive shells, so the lineage indicates a hijacked elevation path. The rule keys on parent-child lineage rather than command-line content, so it complements command-line detections."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.002"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Bypass User Account Control"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 / Windows Event 4688 with parent process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Help-desk or admin troubleshooting that deliberately launches a shell from an elevated system utility, software installers or repair tools that chain from slui/changepk during licensing or edition upgrades, and security testing or red-team exercises."
    tuning_guidance = "Add known admin or test hosts to %global_allowed_script_hosts. Add approved deployment or repair tooling to %global_allowed_admin_tools. Add administrator accounts that legitimately perform this activity to %global_allowed_admin_users. To widen coverage, add further child interpreters to the child regex; to reduce noise, remove slui or changepk from the parent list."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(fodhelper|computerdefaults|eventvwr|sdclt|wsreset|slui|cmstp|changepk|pkgmgr|migwiz|osk)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|powershell_ise|pwsh|wscript|cscript|mshta|regsvr32)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.hostname in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1548.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)

  condition:
    $proc
}
