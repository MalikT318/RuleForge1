/*
  MITRE Technique : T1505.002 - Transport Agent
  Tactic(s)       : Persistence
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:29:07.887779+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_002_Exchange_Transport_Agent_Binary_Drops {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Multiple assembly, executable or configuration files are created under the Exchange TransportRoles directory tree on a single host within 10 minutes. A single file write there can be benign, but a burst of drops by an unapproved process matches staging and registration of a malicious transport agent for persistence (for example a .NET agent DLL plus its config)."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.002"
    mitre_technique_name = "Server Software Component: Transport Agent"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 equivalent) from Exchange servers, with full target file paths populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Exchange cumulative updates and security patches, approved third-party transport agents (anti-spam, DLP, journaling, email signature products) during install or upgrade, and configuration management or backup restore jobs."
    tuning_guidance = "Add approved deployment and patching tools to %global_allowed_admin_tools and the matching service accounts to %global_allowed_service_accounts. Raise the #file threshold on servers with frequent patching. Scope the rule to Exchange servers if the tenant has an asset-role mapping."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\TransportRoles\\.*\.(dll|exe|config)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\\(Setup|ExSetup|EdgeTransport|MSExchangeTransport)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1505.002")
    $primary_entity = array_distinct($host)
    $dropped_files = array_distinct($file.target.file.full_path)
    $writing_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
