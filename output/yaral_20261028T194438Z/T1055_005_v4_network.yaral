/*
  MITRE Technique : T1055.005 - Thread Local Storage
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:53:05.931382+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_005_Network_Silent_Process_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound connection to an external address from a Windows binary that has no legitimate reason to talk to the internet (simple GUI utilities and core session or system processes). TLS callback injection and related hollowing or injection techniques run attacker code under such host processes, and the first visible symptom is often C2 or staging traffic from the hijacked process. This is a network-side behavioural proxy for the technique, not a direct observation of the TLS callback modification."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.005"
    mitre_technique_name = "Process Injection: Thread Local Storage"
    log_prerequisites = "Requires endpoint network telemetry that attributes each connection to the originating process image path (EDR or Sysmon Event ID 3 equivalent) and populates target.ip."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Modern Notepad and Paint builds with cloud or AI features, Store-delivered app updates, licence or telemetry checks, certificate revocation (CRL/OCSP) lookups, EDR or proxy products that attribute traffic to the wrong process, lsass authentication to cloud identity providers in hybrid-join environments."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools, %global_allowed_remote_mgmt or %global_allowed_security_tools (matched on process image path). Add known-good destinations to %global_allowed_domains. If lsass or other system processes are noisy in hybrid-identity tenants, remove them from the process regex per client."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(notepad|calc|mspaint|wordpad|write|charmap|smss|csrss|wininit|conhost|lsass)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1055.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
