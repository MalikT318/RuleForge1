/*
  MITRE Technique : T1550 - Use Alternate Authentication Material
  Tactic(s)       : Lateral Movement
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:35:33.304143+00:00
  Reference       : https://attack.mitre.org/techniques/T1550
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1550_K8s_Token_Access_Then_Pod_Exec {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Kubernetes identity reading secrets or minting a service-account token and then exec'ing or attaching into a pod within 10 minutes. This pattern indicates stolen or replayed alternate authentication material (service-account tokens) being used to move laterally into workloads. It is based on API audit telemetry rather than process command lines."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1550"
    mitre_technique_name = "Use Alternate Authentication Material"
    log_prerequisites = "Requires Kubernetes API server audit logs at Metadata level or higher, ingested and normalised to UDM USER_RESOURCE_ACCESS with principal.user.userid populated with the authenticated username and target.url populated with the API request URI. Audit policy must record secrets, serviceaccounts/token and pods/exec requests."
    platform = "Linux"
    log_source = "container"
    false_positives = "CI/CD deployers and GitOps controllers that read secrets and then exec into pods; cluster administrators debugging workloads; operators and controllers that mint tokens and then exec for health checks; break-glass troubleshooting sessions."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts and named cluster administrators to %global_allowed_admin_users. Raise severity if the exec event comes from a source IP different from the token-read event (see $exec_source_ips and $token_source_ips in the outcome). Restrict the secrets pattern to sensitive namespaces if volume is high."

  events:
    $tok.metadata.event_type = "USER_RESOURCE_ACCESS"
    $tok.target.url = /\/(serviceaccounts\/[^\/?]+\/token|secrets)(\/|\?|$)/ nocase
    $tok.principal.user.userid = $user
    not $tok.principal.user.userid in %global_allowed_service_accounts
    not $tok.principal.user.userid in %global_allowed_admin_users
    not $tok.principal.user.userid = /^system:(node:|kube-|apiserver|serviceaccount:kube-system:)/ nocase

    $exec.metadata.event_type = "USER_RESOURCE_ACCESS"
    $exec.target.url = /\/pods\/[^\/?]+\/(exec|attach)(\?|$)/ nocase
    $exec.principal.user.userid = $user
    not $exec.principal.user.userid in %global_allowed_service_accounts
    not $exec.principal.user.userid in %global_allowed_admin_users

    $tok.metadata.event_timestamp.seconds <= $exec.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1550")
    $primary_entity = array_distinct($user)
    $token_requests = array_distinct($tok.target.url)
    $exec_requests = array_distinct($exec.target.url)
    $token_source_ips = array_distinct($tok.principal.ip)
    $exec_source_ips = array_distinct($exec.principal.ip)
    $token_event_count = count($tok.metadata.id)
    $exec_event_count = count($exec.metadata.id)

  condition:
    $tok and $exec
}
