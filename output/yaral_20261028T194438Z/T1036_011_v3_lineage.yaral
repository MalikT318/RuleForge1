/*
  MITRE Technique : T1036.011 - Overwrite Process Arguments
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:14:37.840011+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_011_Service_Parent_Spawns_Interpreter_Argv_Mismatch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing service or database daemon (web server, PHP-FPM, database, print daemon) spawning a shell or script interpreter whose argv[0] in the recorded command line does not match the executable actually launched. This lineage anomaly combined with a spoofed argv[0] is consistent with process argument overwriting or masquerading (T1036.011) by a webshell or compromised service, as seen with BPFDoor and XorDdos-style implants."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.011"
    mitre_technique_name = "Masquerading: Overwrite Process Arguments"
    log_prerequisites = "Linux EDR or auditd execve telemetry populating parent process path, child process path and full command line (argv) for process launches."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web applications or CMS plugins that shell out via wrappers using custom argv[0]; database maintenance or backup hooks invoked by the database daemon; busybox-style multi-call binaries where the symlink name differs from the resolved binary; init or health-check scripts launched by service managers; containers whose runtimes report resolved paths differently from argv[0]."
    tuning_guidance = "Add approved parent binaries to %global_allowed_script_hosts and approved wrapper or deployment tooling to %global_allowed_admin_tools. Extend the parent regex with local application servers (e.g. java or node based services) if they are not expected to spawn interpreters. If the EDR records resolved symlink targets (e.g. dash or busybox), add the relevant argv[0] aliases to the exclusion."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|php-fpm[0-9.]*|lighttpd|caddy|tomcat[0-9]*|mysqld|mariadbd|postgres|mongod|redis-server|cupsd)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|ash|zsh|ksh|csh|tcsh|python[0-9.]*|perl[0-9.]*|ruby|php[0-9.]*|node|lua)$/ nocase
    $child_name = re.capture($proc.target.process.file.full_path, "([^/]*?[a-z])[0-9.]*$")
    $argv0_name = re.capture($proc.target.process.command_line, "^\"?(?:[^\\s\"/]*/)*([^\\s\"/]*?[a-z])[0-9.]*(?:[\\s\"]|$)")
    $argv0_name != ""
    $argv0_name != "sh"
    $child_name != $argv0_name
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1036.011")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $spoofed_argv0 = array_distinct($argv0_name)
    $command_lines = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
