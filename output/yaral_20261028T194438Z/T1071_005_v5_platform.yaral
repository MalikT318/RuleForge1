/*
  MITRE Technique : T1071.005 - Publish/Subscribe Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:11:47.869682+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_005_Linux_PubSub_Broker_Connection_From_Staging_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux process executing from a world-writable or memory-backed staging location (/tmp, /var/tmp, /dev/shm, memfd) opening an outbound connection to a well-known publish/subscribe broker port (MQTT, AMQP, STOMP, XMPP, NATS). Legitimate brokers clients are installed in system paths, so a staged binary or script talking to an external broker is a strong indicator of pub/sub C2. The rule uses network telemetry and process image location, not command-line matching, and is additive to process-creation rules."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.005"
    mitre_technique_name = "Application Layer Protocol: Publish/Subscribe Protocols"
    log_prerequisites = "Requires Linux endpoint network connection telemetry (EDR or auditd connect syscall records) that populates principal.process.file.full_path, target.ip and target.port."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers or IoT engineers testing MQTT/AMQP clients from /tmp, CI/CD build agents running test suites in /tmp, containers or sandboxes that extract binaries to /tmp or /dev/shm, and self-extracting installers for agent software that phone home to a cloud IoT broker."
    tuning_guidance = "Add approved tooling parent or image paths to %global_allowed_admin_tools and EDR or monitoring agents to %global_allowed_security_tools. Add known build or CI hosts to %global_allowed_script_hosts. Known-good external broker domains cannot be matched on IP, so add approved destination processes to the allow lists above. Extend the port list if the client environment runs brokers on non-standard ports."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/memfd:|\/proc\/self\/fd\/)/ nocase
    (
      $net.target.port = 1883 or
      $net.target.port = 8883 or
      $net.target.port = 5672 or
      $net.target.port = 5671 or
      $net.target.port = 61613 or
      $net.target.port = 61614 or
      $net.target.port = 5222 or
      $net.target.port = 5223 or
      $net.target.port = 4222
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1071.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
