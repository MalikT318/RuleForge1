/*
  MITRE Technique : T1546.015 - Component Object Model Hijacking
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:20:22.457044+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_015_COM_Hijack_DLL_Drop_Then_CLSID_Registration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a DLL or OCX written to a user-writable location followed, on the same host within 10 minutes, by a CLSID InprocServer32 or LocalServer32 registry value pointing to a user-writable path. This sequence is typical of COM hijacking for persistence. It uses file and registry telemetry, so it adds coverage beyond command-line process rules."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.015"
    mitre_technique_name = "Event Triggered Execution: Component Object Model Hijacking"
    log_prerequisites = "Requires EDR or Sysmon file creation telemetry (Sysmon Event ID 11) and registry value set telemetry (Sysmon Event ID 13) with registry_value_data populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-user software installers and updaters that register COM servers under HKCU (collaboration clients, browsers, Office add-ins, developer tooling), and software packaging or deployment tools registering COM components from ProgramData or temp staging folders."
    tuning_guidance = "Add approved installer or deployment binaries to %global_allowed_admin_tools. Add EDR or AV agents to %global_allowed_security_tools. Narrow the user-writable path regex for environments where per-user COM registration is standard."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|users\\public|programdata|windows\\temp)\\.*\.(dll|ocx)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\software\\classes\\(wow6432node\\)?clsid\\\{[0-9a-f\-]+\}\\(inprocserver32|localserver32)$/ nocase
    $reg.target.registry.registry_value_data = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|users\\public|programdata|windows\\temp)\\.*\.(dll|ocx|exe)/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1546.015")
    $primary_entity = array_distinct($hostname)
    $dropped_files = array_distinct($file.target.file.full_path)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_data)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $first_seen = min($file.metadata.event_timestamp.seconds)
    $last_seen = max($reg.metadata.event_timestamp.seconds)

  condition:
    $file and $reg
}
