/*
  MITRE Technique : T1546.017 - Udev Rules
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:24:42.094459+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/017
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_017_Udev_Worker_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external network connection initiated by the udev daemon or a process whose direct parent is the udev daemon. systemd-udevd normally runs RUN+= actions in a sandbox that blocks network access and should never contact external hosts, so this pattern indicates a malicious udev rule (RUN+=) acting as a persistence trigger and fetching a payload or calling out to C2 when a device event fires."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1546.017"
    mitre_technique_name = "Event Triggered Execution: Udev Rules"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that produces NETWORK_CONNECTION events with principal process and parent process paths populated. Use this rule alongside endpoint coverage of udev rule file writes."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Custom udev helper scripts that call a licensing, provisioning or asset-registration service on device plug-in; hardware vendor agents that phone home from a udev-triggered action; network-boot or thin-client provisioning workflows; USB or storage management software that reports to a cloud console."
    tuning_guidance = "Add approved vendor or update domains to %global_allowed_domains. Internal destinations are excluded through %rfc1918_internal. If a legitimate hardware agent is triggered by udev, record its destination hostname in %global_allowed_domains. Confirm any alert by reviewing recent changes to /etc/udev/rules.d/, /run/udev/rules.d/, /usr/lib/udev/rules.d/, /usr/local/lib/udev/rules.d/ and /lib/udev/rules.d/ on the host."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.principal.process.file.full_path = /\/(systemd-)?udevd$/ nocase or
      $net.principal.process.parent_process.file.full_path = /\/(systemd-)?udevd$/ nocase
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1546.017")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $source_command_line = array_distinct($net.principal.process.command_line)

  condition:
    $net
}
