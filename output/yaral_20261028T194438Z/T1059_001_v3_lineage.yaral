/*
  MITRE Technique : T1059.001 - PowerShell
  Tactic(s)       : Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:08:11.936587+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_001_Unexpected_Parent_Spawns_PowerShell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a PowerShell host (powershell, pwsh, powershell_ise) launched by a parent process that should never spawn an interpreter: an Office application, web server worker, database service, or print spooler. This is a lineage anomaly typical of macro execution, web shell activity, SQL injection with xp_cmdshell, or spooler exploitation. The detection keys on the parent-child relationship and does not inspect command-line content."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.001"
    mitre_technique_name = "Command and Scripting Interpreter: PowerShell"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with parent process path populated (EDR, Sysmon Event ID 1, or Security Event 4688 with parent process logging)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "SQL Server Agent jobs using the PowerShell job step type; Office add-ins or VBA automation that legitimately call PowerShell; IIS-hosted admin or deployment applications that shell out to PowerShell; print driver or print management installers invoked by the spooler; Outlook rules or add-ins from approved vendors."
    tuning_guidance = "Add approved parent executable paths (for example management agents or deployment tooling) to %global_allowed_admin_tools or %global_allowed_script_hosts. For SQL Agent or IIS-hosted automation, allowlist the parent executable on the specific hosts through %global_allowed_script_hosts rather than removing the parent from the regex. Narrow or extend the parent regex per client as needed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat\d*|php-cgi|sqlservr|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(powershell|pwsh|powershell_ise)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1059.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
