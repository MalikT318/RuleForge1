/*
  MITRE Technique : T1036.001 - Invalid Code Signature
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:57:24.057416+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_001_Unexpected_Parent_Spawns_Masqueraded_System_Binary {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office application, web server, database service or print spooler launching a process that carries the name of a core Windows system binary from outside the trusted system directories. A binary that copies the name and metadata of a signed Windows component but has an invalid signature has to run from a non-system location. Launching it from one of these parents is a strong lineage anomaly. This rule does not validate the signature itself. It detects the lineage and location combination that masquerading binaries produce."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.001"
    mitre_technique_name = "Masquerading: Invalid Code Signature"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry from an EDR, Sysmon Event ID 1, or Security Event 4688 with parent process and full image paths populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Portable or vendor application suites that ship their own helper binaries with system-like names. Web applications or database jobs that legitimately launch bundled utilities. Sandboxed or virtualised Office add-ins. Software updaters that stage binaries in temporary directories."
    tuning_guidance = "Add approved parent process paths to %global_allowed_admin_tools. Add endpoint security agents that proxy launches to %global_allowed_security_tools. Extend the parent regex with client-specific line-of-business applications that should never spawn system binaries."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|onenote|visio|acrord32|w3wp|httpd|nginx|tomcat\d*|php-cgi|sqlservr|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(svchost|lsass|csrss|smss|wininit|services|winlogon|spoolsv|taskhostw|dllhost|conhost|runtimebroker|searchindexer|wmiprvse|audiodg)\.exe$/ nocase
    not $proc.target.process.file.full_path = /^[a-z]:\\windows\\(system32|syswow64|sysnative|winsxs)\\/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1036.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
