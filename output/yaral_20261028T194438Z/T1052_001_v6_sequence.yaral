/*
  MITRE Technique : T1052.001 - Exfiltration over USB
  Tactic(s)       : Exfiltration
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:43:45.721621+00:00
  Reference       : https://attack.mitre.org/techniques/T1052/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1052_001_USB_Device_Registry_Then_Copy_To_Removable {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects Windows recording a USB storage or portable device registry artifact on a host, followed within 10 minutes by a copy, move or compress command on the same host that writes to a non-system drive letter. This is the staging-and-copy pattern of exfiltration to a USB device."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1052.001"
    mitre_technique_name = "Exfiltration Over Physical Medium: Exfiltration over USB"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (USBSTOR and Windows Portable Devices keys) and process creation telemetry with command lines (Sysmon EID 1/13 or Windows Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Users backing up their own files to personal or corporate USB drives, IT staff imaging or provisioning machines, approved encrypted-USB workflows, copy commands to secondary fixed or mapped drives (D: to Z:) that coincide with a USB insertion, and software installers that copy files to non-C: drives."
    tuning_guidance = "Add approved copy and deployment tooling to %global_allowed_admin_tools, backup software to %global_allowed_backup_processes, and approved administrators to %global_allowed_admin_users. Service accounts that copy to secondary data drives go in %global_allowed_service_accounts. In environments with many fixed secondary drives, narrow the destination drive-letter regex or lengthen the observation baseline before enabling alerting."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(CurrentControlSet|ControlSet\d+)\\Enum\\USBSTOR\\|\\Microsoft\\Windows Portable Devices\\Devices\\/ nocase
    $reg.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(robocopy|xcopy|cmd|powershell|pwsh)\.exe$/ nocase
    $proc.target.process.command_line = /\b(robocopy|xcopy|copy|move|copy-item|move-item|compress-archive)\b/ nocase
    $proc.target.process.command_line = /(^|\s|"|')[d-z]:\\/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    $reg.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1052.001")
    $primary_entity = array_distinct($hostname)
    $usb_registry_keys = array_distinct($reg.target.registry.registry_key)
    $copy_commands = array_distinct($proc.target.process.command_line)
    $acting_users = array_distinct($proc.principal.user.userid)
    $copy_event_count = count($proc.metadata.id)

  condition:
    $reg and $proc
}
