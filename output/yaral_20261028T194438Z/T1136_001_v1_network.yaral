/*
  MITRE Technique : T1136.001 - Local Account
  Tactic(s)       : Persistence
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:07:17.806789+00:00
  Reference       : https://attack.mitre.org/techniques/T1136/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_001_NetDevice_External_Mgmt_Account_Creation_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an HTTP(S) POST or PUT from an external (non-RFC1918) source to a network device management-plane URI that creates or modifies local user or administrator accounts. Observed on the network side by a firewall, proxy or perimeter inspection point, this indicates possible creation of a rogue local or super-admin account on a firewall or network device management console for persistence."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136.001"
    mitre_technique_name = "Create Account: Local Account"
    log_prerequisites = "Requires firewall, reverse-proxy or TLS-inspecting perimeter logs normalised to NETWORK_HTTP with network.http.method and target.url populated. Management-plane traffic must traverse an inspection point, with TLS decryption or a management-plane proxy if it is encrypted."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised administrators or MSP engineers managing devices remotely from external or VPN-NAT egress addresses, cloud-managed device orchestration platforms, zero-touch provisioning, IaC automation (API-driven user provisioning), and identity-sync tools that legitimately manage local device users."
    tuning_guidance = "Add known management source addresses (jump hosts, MSP egress, orchestration platforms) to %global_allowed_mgmt_sources. Confirm %rfc1918_internal covers the customer's internal space. If URI conventions differ per device family, extend the target.url regex. Where the proxy logs response codes, correlate with 2xx responses during triage to confirm the account was actually created."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(POST|PUT)$/ nocase
    $http.target.url = /\/(api|rest|restapi|cgi-bin|mgmt|config|admin|management)[^?#]*\/(users?|admins?|accounts?|local-?users?|administrators?|adduser|useradd|createuser|create-user|add-user)(\/|\?|#|$)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1136.001")
    $primary_entity = array_distinct($http.target.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $target_urls = array_distinct($http.target.url)
    $http_methods = array_distinct($http.network.http.method)

  condition:
    $http
}
