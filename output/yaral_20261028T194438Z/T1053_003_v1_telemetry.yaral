/*
  MITRE Technique : T1053.003 - Cron
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:13:55.832677+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_003_Linux_Cron_File_Artifact_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a file in a cron persistence location (user crontab spool, /etc/cron.d, /etc/cron.hourly|daily|weekly|monthly, /etc/crontab, /etc/anacrontab). This catches the resulting file artifact regardless of how the file was written (crontab binary, shell redirection, script, or a renamed or custom tool), so it is independent of command-line logging. Covers Linux and ESXi-style crontab paths such as /var/spool/cron/crontabs/root."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.003"
    mitre_technique_name = "Scheduled Task/Job: Cron"
    log_prerequisites = "Requires Linux endpoint file-creation telemetry from EDR or auditd with file watches on /etc/cron*, /etc/crontab, and /var/spool/cron. Ensure principal.process.file.full_path is populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package installs or upgrades that drop cron jobs (logrotate, sysstat, certbot, antivirus, backup agents), configuration management runs (Puppet, Chef, Ansible, Salt), legitimate admins editing crontabs, and first-boot provisioning or image build pipelines."
    tuning_guidance = "Add approved config-management and deployment binaries to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and approved script-running parents to %global_allowed_script_hosts. Clone this rule against FILE_MODIFICATION for in-place appends to existing crontab files, since a single rule cannot cover both event types. Suppress build or golden-image hosts in the SIEM rather than editing the rule."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(var\/spool\/cron(\/crontabs)?\/[^\/]+|etc\/cron\.(d|hourly|daily|weekly|monthly)\/[^\/]+|etc\/crontab|etc\/anacrontab)$/ nocase
    not $file.target.file.full_path = /\/\.placeholder$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|yum|dnf|zypper|snapd|unattended-upgrade|packagekitd|esxcli|vmware-hostd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1053.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $cron_file_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
