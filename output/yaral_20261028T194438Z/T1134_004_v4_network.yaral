/*
  MITRE Technique : T1134.004 - Parent PID Spoofing
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:00:06.414701+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_004_PPID_Spoof_Bare_Proxy_Process_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external network connection from a Windows binary that normally runs with arguments (rundll32, regsvr32, svchost, dllhost) but is running with a bare command line while its parent is a commonly spoofed process (explorer, svchost, winlogon and similar). Spawning a sacrificial process under a spoofed PPID with no arguments, then injecting a payload that beacons out, is a common PPID-spoofing tradecraft pattern. The detection is network-side and depends on the endpoint telemetry populating process command line and parent process on the connection event."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.004"
    mitre_technique_name = "Access Token Manipulation: Parent PID Spoofing"
    log_prerequisites = "Requires EDR or Sysmon-equivalent network telemetry (Sysmon Event ID 3 or equivalent) normalised to NETWORK_CONNECTION, with principal.process.command_line and principal.process.parent_process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare legitimate software launching rundll32 or regsvr32 without arguments and then connecting externally, installers or updaters that spawn a bare helper process, EDR or sandbox hooking that rewrites command lines, and vendor agents that host network code in dllhost."
    tuning_guidance = "Add approved parent process paths (software deployment or RMM agents) to %global_allowed_admin_tools. Add known-good destination domains to %global_allowed_domains. Confirm with the client that the EDR populates command line and parent process on network events; if it does not, the rule will not fire."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(rundll32|regsvr32|svchost|dllhost)\.exe$/ nocase
    $net.principal.process.command_line = /^"?([a-z]:)?[^"]*\\(rundll32|regsvr32|svchost|dllhost)\.exe"?\s*$/ nocase
    $net.principal.process.parent_process.file.full_path = /\\(explorer|svchost|winlogon|wininit|spoolsv|taskhostw|sihost)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.parent_process.file.full_path in %global_allowed_admin_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1134.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $user = array_distinct($net.principal.user.userid)
    $child_process = array_distinct($net.principal.process.file.full_path)
    $parent_process = array_distinct($net.principal.process.parent_process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
