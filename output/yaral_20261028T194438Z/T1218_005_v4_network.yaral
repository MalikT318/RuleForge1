/*
  MITRE Technique : T1218.005 - Mshta
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:48:47.047447+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_005_Mshta_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects mshta.exe, the Microsoft HTML Application host, making an outbound network connection to a non-internal address. Legitimate mshta.exe use rarely involves network access. Remote .hta or .sct retrieval and inline script payloads that fetch staged content are the characteristic network behaviour of T1218.005. This detection is network-side and is independent of command-line matching, so it still fires when the command line is obfuscated, the binary is renamed to launch from a different name, or the payload host changes."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.005"
    mitre_technique_name = "System Binary Proxy Execution: Mshta"
    log_prerequisites = "Requires Windows endpoint network telemetry (EDR or Sysmon Event ID 3) that attributes each outbound connection to the initiating process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy line-of-business applications delivered as HTA files from external or SaaS-hosted locations, vendor installers or updaters that use mshta.exe for UI, and security or sandbox detonation hosts."
    tuning_guidance = "Add known-good vendor or CDN domains to %global_allowed_domains. Add sandbox, detonation, or legacy HTA application hosts to %global_allowed_script_hosts. Confirm that %rfc1918_internal covers the client's internal address space."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\mshta\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ports = array_distinct($net.target.port)
    $source_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
