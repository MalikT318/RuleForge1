/*
  MITRE Technique : T1546.002 - Screensaver
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:01:59.245638+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_002_Screensaver_Registry_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry write to the SCRNSAVE.EXE value under the per-user Control Panel\\Desktop key (or its Group Policy equivalent) where the configured screensaver is not a .scr file in the Windows System32/SysWOW64 directory. This is the state change produced when an adversary sets a malicious PE as the screensaver for persistence, regardless of how the change was made (reg.exe, PowerShell, API call, or direct hive edit)."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.002"
    mitre_technique_name = "Event Triggered Execution: Screensaver"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 12/13, or equivalent EDR registry-write events) with registry key, value name, and value data populated. HKCU writes must be normalized under HKEY_USERS\\<SID> or HKCU."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Corporate screensaver deployment through Group Policy, logon scripts, or RMM tools; branded or vendor screensavers installed outside System32 (for example in Program Files); users selecting third-party screensavers; removal or reset of the value, which leaves empty value data."
    tuning_guidance = "Add approved deployment tooling to %global_allowed_admin_tools and EDR/security agents to %global_allowed_security_tools. If the organisation deploys a sanctioned branded screensaver from a fixed location, extend the value-data exclusion regex for that location in the client-specific copy of the rule."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control Panel\\Desktop$/ nocase
    $reg.target.registry.registry_value_name = /^SCRNSAVE\.EXE$/ nocase
    not $reg.target.registry.registry_value_data = /^([a-z]:\\windows|%systemroot%|%windir%)\\(system32|syswow64)\\[a-z0-9_\-\.]+\.scr$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $user = array_distinct($reg.principal.user.userid)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $screensaver_value = array_distinct($reg.target.registry.registry_value_data)

  condition:
    $reg
}
