/*
  MITRE Technique : T1105 - Ingress Tool Transfer
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:12:41.777038+00:00
  Reference       : https://attack.mitre.org/techniques/T1105
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1105_Proxy_Executable_Download_Then_Unusual_Outbound {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A Windows client downloads an executable or script payload over HTTP using a built-in Windows downloader user agent (PowerShell, CryptoAPI/certutil, BITS, WinHTTP), then opens an outbound connection to an external address on a non-standard port within 5 minutes. This is the network-observable pattern of ingress tool transfer followed by callback or staging."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1105"
    mitre_technique_name = "Ingress Tool Transfer"
    log_prerequisites = "Requires proxy or firewall HTTP logs with URL and user agent populated (NETWORK_HTTP), plus perimeter connection logs with destination IP and port (NETWORK_CONNECTION). Source IP must be consistent across both log types."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Software deployment or patching that fetches installers with BITS or WinHTTP from vendor CDNs, admin scripts downloading installers, and developer workstations pulling packages followed by connections to custom-port services."
    tuning_guidance = "Add known-good vendor and CDN domains to %global_allowed_domains. Internal traffic is excluded by %rfc1918_internal. If the client's logs use NAT, the source IP join will be noisy, so scope the rule to pre-NAT log feeds. Adjust the extension list or the port threshold per client."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\.(exe|dll|msi|scr|ps1|bat|hta|vbs|jar|cab)(\?|$)/ nocase
    $http.network.http.user_agent = /(WindowsPowerShell|Microsoft-CryptoAPI|Microsoft BITS|WinHttp)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    $http.principal.ip = $src_ip

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port > 1024
    not $net.target.ip in %rfc1918_internal
    $net.principal.ip = $src_ip

    $http.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $src_ip over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1105")
    $primary_entity = array_distinct($src_ip)
    $download_urls = array_distinct($http.target.url)
    $download_hosts = array_distinct($http.target.hostname)
    $user_agents = array_distinct($http.network.http.user_agent)
    $callback_ips = array_distinct($net.target.ip)
    $callback_ports = array_distinct($net.target.port)

  condition:
    $http and $net
}
