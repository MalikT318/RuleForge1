/*
  MITRE Technique : T1082 - System Information Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:48:44.893569+00:00
  Reference       : https://attack.mitre.org/techniques/T1082
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1082_NetDev_MgmtAccess_Then_SNMP_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A single source connects to a network device's remote management plane (SSH, Telnet or NETCONF) and then queries the same device over SNMP within ten minutes. This is the network-observable footprint of an adversary profiling a device's version, platform and configuration (equivalent to 'show version' or an SNMP sysDescr walk) after gaining or probing management access. Sources on the approved management and scanner lists are excluded."
    mitre_tactic = "Discovery"
    mitre_technique = "T1082"
    mitre_technique_name = "System Information Discovery"
    log_prerequisites = "Requires firewall, perimeter or flow telemetry normalised to UDM NETWORK_CONNECTION events with principal.ip, target.ip and target.port populated. The firewall must log traffic to the device management interfaces, including SNMP on UDP 161."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Network monitoring systems and NMS pollers, authorised vulnerability scanners, network engineers working from an unlisted jump host or workstation, configuration backup and compliance tooling, and MSSP monitoring collectors."
    tuning_guidance = "Add approved NMS, jump host and automation source addresses to %global_allowed_mgmt_sources. Add authorised scanners to %global_allowed_scanners. If a client uses non-standard management ports, adjust the port values in the $mgmt block. If volume is high, shorten the match window or restrict the rule to specific management VLAN devices via a client-level copy."

  events:
    $mgmt.metadata.event_type = "NETWORK_CONNECTION"
    ($mgmt.target.port = 22 or $mgmt.target.port = 23 or $mgmt.target.port = 830)
    $mgmt.principal.ip = $src_ip
    $mgmt.target.ip = $dst_ip
    not $mgmt.principal.ip in %global_allowed_mgmt_sources
    not $mgmt.principal.ip in %global_allowed_scanners

    $snmp.metadata.event_type = "NETWORK_CONNECTION"
    $snmp.target.port = 161
    $snmp.principal.ip = $src_ip
    $snmp.target.ip = $dst_ip
    not $snmp.principal.ip in %global_allowed_mgmt_sources
    not $snmp.principal.ip in %global_allowed_scanners

    $mgmt.metadata.event_timestamp.seconds <= $snmp.metadata.event_timestamp.seconds

  match:
    $src_ip, $dst_ip over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1082")
    $primary_entity = array_distinct($mgmt.target.ip)
    $source_ips = array_distinct($mgmt.principal.ip)
    $mgmt_ports = array_distinct($mgmt.target.port)
    $mgmt_event_count = count($mgmt.metadata.id)
    $snmp_event_count = count($snmp.metadata.id)

  condition:
    $mgmt and $snmp
}
