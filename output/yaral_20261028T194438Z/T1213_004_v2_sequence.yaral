/*
  MITRE Technique : T1213.004 - Customer Relationship Management Software
  Tactic(s)       : Collection
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:27:52.681073+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_004_CRM_Access_Grant_Then_SSO_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A user is granted a CRM or customer-data related role, group or application assignment and then signs in to a CRM application within 10 minutes. This sequence indicates privilege staging for bulk collection of customer data (PII, contacts, purchase and support history) from CRM software."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.004"
    mitre_technique_name = "Data from Information Repositories: Customer Relationship Management Software"
    log_prerequisites = "Identity provider directory audit logs (permission, role and application assignment changes) and sign-in/SSO logs with the target application name populated, ingested into UDM."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Legitimate onboarding of sales, support or marketing staff who are given CRM access and sign in straight away; helpdesk-driven role changes; access-request or governance workflows that auto-provision and then test access; contractors starting a new engagement."
    tuning_guidance = "Add provisioning admins and identity governance automation to %global_allowed_admin_users and %global_allowed_service_accounts. Add approved federation or automation principals to %global_allowed_cloud_principals. Adjust the CRM keyword regexes to match the application and role naming conventions used by each client. Raise severity where the granted user is not in the expected business unit."

  events:
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.target.resource.name = /(crm|sales|customer|contact|helpdesk|service[-_ ]?desk)/ nocase
    $perm.target.user.userid = $user
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_service_accounts

    $login.metadata.event_type = "USER_LOGIN"
    $login.target.application = /(crm|sales|customer|contact|helpdesk|service[-_ ]?desk)/ nocase
    $login.principal.user.userid = $user
    not $login.principal.user.userid in %global_allowed_service_accounts
    not $login.principal.user.userid in %global_allowed_cloud_principals

    $perm.metadata.event_timestamp.seconds <= $login.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1213.004")
    $primary_entity = array_distinct($user)
    $granting_actor = array_distinct($perm.principal.user.userid)
    $granted_resource = array_distinct($perm.target.resource.name)
    $crm_application = array_distinct($login.target.application)
    $source_ips = array_distinct($login.principal.ip)
    $login_count = count($login.metadata.id)

  condition:
    $perm and $login
}
