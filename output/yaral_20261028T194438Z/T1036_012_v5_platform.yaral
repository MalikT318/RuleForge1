/*
  MITRE Technique : T1036.012 - Browser Fingerprint
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:17:21.261978+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_012_Linux_Host_Spoofed_NonLinux_Browser_UserAgent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP requests from a host identified as Linux whose User-Agent claims a Windows, macOS or iOS browser. A Linux host presenting a non-Linux browser identity is a strong sign of User-Agent spoofing by implants, scripts or tunnelling tools that are blending into normal web traffic. This is a network-side detection and does not rely on process or command-line telemetry."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.012"
    mitre_technique_name = "Masquerading: Browser Fingerprint"
    log_prerequisites = "Requires firewall or web proxy logs that parse the HTTP User-Agent into network.http.user_agent (NETWORK_HTTP, for example from TLS-inspecting or explicit proxies). The source asset must be enriched with principal.platform (for example from an asset inventory or CMDB feed). Without that enrichment the rule will not match."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Linux hosts running headless browsers or automated test tooling (Selenium, Puppeteer) that set a Windows or macOS User-Agent on purpose; web scrapers and SEO or monitoring agents; Linux hosts acting as forward proxies or NAT gateways where the logged source is the gateway and not the client; Linux jump hosts, VDI hosts or developer workstations running Windows or macOS browsers through a VM or remote display; inaccurate asset platform enrichment."
    tuning_guidance = "Add known automation and scraping hosts to %global_allowed_scanners, matched on principal.hostname. Add trusted external destinations to %global_allowed_domains. Check that principal.platform enrichment is accurate for the client. Exclude Linux proxy or gateway hosts, where the logged source is not the real client, by adding them to %global_allowed_scanners. Raise severity for servers that have no business browsing the web."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.principal.platform = "LINUX"
    $net.principal.hostname != ""
    $net.network.http.user_agent = /^Mozilla\/\d/ nocase
    $net.network.http.user_agent = /(Windows NT|Macintosh|Mac OS X|iPhone|iPad|Windows Phone)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1036.012")
    $primary_entity = array_distinct($net.principal.hostname)
    $spoofed_user_agents = array_distinct($net.network.http.user_agent)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
