/*
  MITRE Technique : T1548 - Abuse Elevation Control Mechanism
  Tactic(s)       : Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:26:33.619823+00:00
  Reference       : https://attack.mitre.org/techniques/T1548
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_Elevation_Control_Policy_Setting_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change to the controls that govern privileged role elevation (role management policy, just-in-time activation rules, approval or justification requirements) in the cloud identity plane. Weakening these controls lets an adversary elevate to a privileged role without approval or oversight. The rule works from the resulting setting change and does not depend on process or command-line telemetry."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548"
    mitre_technique_name = "Abuse Elevation Control Mechanism"
    log_prerequisites = "Requires identity provider directory/audit logs normalised to UDM SETTING_MODIFICATION events with principal.user.userid, target.resource.name and metadata.product_event_type populated."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Planned changes to privileged access governance by identity or security administrators, onboarding of new privileged role groups, IaC or automation pipelines that manage role policies, and tenant baseline hardening projects."
    tuning_guidance = "Add approved identity administrators to %global_allowed_admin_users, and automation or pipeline identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. If the target.resource.name values in your tenant differ, extend the resource regex. To reduce noise during planned governance changes, restrict the operation regex to disable/delete/remove verbs."

  events:
    $set.metadata.event_type = "SETTING_MODIFICATION"
    $set.target.resource.name = /(role.?management|privileged.?role|privileged.?access|role.?assignment.?polic|role.?setting|elevation|activation.?(rule|polic|setting)|just.?in.?time|jit.?access)/ nocase
    $set.metadata.product_event_type = /(update|set|modify|change|patch|disable|delete|remove)/ nocase
    $set.principal.user.userid != ""
    not $set.principal.user.userid in %global_allowed_admin_users
    not $set.principal.user.userid in %global_allowed_service_accounts
    not $set.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1548")
    $primary_entity = array_distinct($set.principal.user.userid)
    $modified_setting = array_distinct($set.target.resource.name)
    $operation = array_distinct($set.metadata.product_event_type)
    $source_ips = array_distinct($set.principal.ip)

  condition:
    $set
}
