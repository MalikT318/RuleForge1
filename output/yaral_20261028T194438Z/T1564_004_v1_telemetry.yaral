/*
  MITRE Technique : T1564.004 - NTFS File Attributes
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:18:39.758227+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_004_NTFS_Alternate_Data_Stream_File_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a named NTFS Alternate Data Stream (file.ext:streamname) on a file in a user-writable or commonly abused staging location. This pivots on the resulting file artifact (stream-creation telemetry) rather than command lines, so it still fires when command-line logging is evaded or obfuscated. Well-known benign streams such as Zone.Identifier (Mark-of-the-Web) are excluded."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.004"
    mitre_technique_name = "Hide Artifacts: NTFS File Attributes"
    log_prerequisites = "Requires endpoint telemetry that records NTFS stream creation as a file event with the stream name in target.file.full_path (for example Sysmon FileCreateStreamHash or equivalent EDR file telemetry) normalised to FILE_CREATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Browsers and download managers writing metadata streams, cloud sync clients (OneDrive, Dropbox), Office and Windows Search/indexing, backup and AV products storing stream metadata, software installers and deployment agents."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools, approved deployment or RMM tooling to %global_allowed_admin_tools, and backup software to %global_allowed_backup_processes. Extend the benign stream-name exclusion regex if a customer application writes its own named streams. Widen or narrow the monitored directory list to suit the environment."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    // Named stream on a file in a user-writable or staging location: <drive>:\dir\...\file.ext:stream[:type]
    $file.target.file.full_path = /^[a-z]:\\(users\\|programdata\\|windows\\(temp|tasks|debug)\\|perflogs\\|\$recycle\.bin\\)[^:]*:[^\\:]+(:[^\\:]+)?$/ nocase
    // Exclude well-known benign streams
    not $file.target.file.full_path = /:(Zone\.Identifier|SmartScreen|encryptable|favicon|OECustomProperty|AFP_AfpInfo|\$CmdTcID)(:\$DATA)?$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1564.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $stream_paths = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
