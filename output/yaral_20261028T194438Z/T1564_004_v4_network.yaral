/*
  MITRE Technique : T1564.004 - NTFS File Attributes
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:19:44.728379+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_004_NTFS_ADS_Process_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process making an outbound connection to a non-internal address while its own command line references an NTFS Alternate Data Stream (file.ext:streamname). This is network-side evidence of payload staging or C2 from hidden NTFS attributes, for example a script host or LOLBin running content out of an ADS and then beaconing or downloading. It matches the stream-path structure rather than any tool or filename."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.004"
    mitre_technique_name = "Hide Artifacts: NTFS File Attributes"
    log_prerequisites = "Windows endpoint network telemetry that records the originating process command line on NETWORK_CONNECTION events (EDR or Sysmon Event ID 3 enriched with process data). Internal address space must be populated in %rfc1918_internal."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup, sync, or DLP agents that reference stream paths on the command line; software installers that read or write Zone.Identifier or other metadata streams while calling home; legitimate administrative scripts that deliberately use ADS for storing metadata; browsers or download managers with stream-style arguments; EDR or AV agents scanning ADS."
    tuning_guidance = "Add approved agents and tooling to %global_allowed_admin_tools, %global_allowed_backup_processes, or %global_allowed_security_tools. If a vendor product keeps matching, allowlist its executable name rather than its install path. Make sure %rfc1918_internal covers all internal address space for the client, and add approved script-running parents to %global_allowed_script_hosts."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    $net.principal.process.command_line = /[a-z]:\\(?:[^\\\/:*?"<>|\r\n]+\\)*[^\\\/:*?"<>|\s]+\.[a-z0-9]{1,5}:[a-z0-9_$.\-]+/ nocase
    not $net.principal.process.command_line = /:Zone\.Identifier/ nocase
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1564.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $remote_ips = array_distinct($net.target.ip)
    $remote_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $initiating_cmdline = array_distinct($net.principal.process.command_line)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
