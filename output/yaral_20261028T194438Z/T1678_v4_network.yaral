/*
  MITRE Technique : T1678 - Delay Execution
  Tactic(s)       : Stealth
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:24:47.832993+00:00
  Reference       : https://attack.mitre.org/techniques/T1678
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1678_Linux_Sleep_Delayed_Outbound_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external network connection made by a shell or scripting interpreter whose command line chains a sleep/time.sleep delay with a network-capable tool or socket (curl, wget, nc, socat, /dev/tcp, Python sockets). This is the network-side footprint of delayed-execution tradecraft used to outlast sandbox timeouts."
    mitre_tactic = "Stealth"
    mitre_technique = "T1678"
    mitre_technique_name = "Delay Execution"
    log_prerequisites = "Requires Linux EDR or auditd network connection telemetry that records the originating process path and command line, normalised to UDM NETWORK_CONNECTION."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Health-check and retry loops in deployment or provisioning scripts, container entrypoint scripts that wait before calling an API, monitoring or heartbeat shell loops, package or configuration management bootstrap scripts, and admins running ad hoc sleep and curl one-liners."
    tuning_guidance = "Add approved automation binaries to %global_allowed_admin_tools, approved service accounts to %global_allowed_service_accounts, and approved CI/provisioning hosts or script parents to %global_allowed_script_hosts. Exclude approved vendor destinations via %global_allowed_domains if the log source populates target.hostname. Raise severity for connections from /tmp, /dev/shm or /var/tmp."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(ba|da|z|k|a)?sh$|\/(python[0-9.]*|perl|ruby)$/ nocase
    $net.principal.process.command_line = /(sleep\s+[0-9.]+[smhd]?\s*(;|&&|\|\||\|)[^\n]*(\/dev\/(tcp|udp)\/|curl|wget|\bnc\b|ncat|socat))|((\/dev\/(tcp|udp)\/|curl|wget|\bnc\b|ncat|socat)[^\n]*(;|&&|\|\|)\s*sleep\s+[0-9.]+)|(time\.sleep\([0-9.]+\)[\s\S]*socket)/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_script_hosts
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1678")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $command_lines = array_distinct($net.principal.process.command_line)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
