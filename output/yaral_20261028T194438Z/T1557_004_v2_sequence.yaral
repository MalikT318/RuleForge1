/*
  MITRE Technique : T1557.004 - Evil Twin
  Tactic(s)       : Credential Access, Collection
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:35:41.982360+00:00
  Reference       : https://attack.mitre.org/techniques/T1557/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1557_004_Rogue_External_DNS_Then_Cleartext_POST {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a client that sends DNS directly to an external resolver (port 53 to a non-internal address) and then submits a cleartext HTTP POST to an external host within 10 minutes. This pattern is consistent with a device that has joined an evil-twin or rogue Wi-Fi network. Such a network hands out attacker-controlled DNS via DHCP and redirects users to captive-portal or credential-harvesting pages. The perimeter only sees this when the victim's traffic later transits the monitored egress, for example after the device reconnects through a VPN or branch link."
    mitre_tactic = "Credential Access, Collection"
    mitre_technique = "T1557.004"
    mitre_technique_name = "Adversary-in-the-Middle: Evil Twin"
    log_prerequisites = "Requires firewall or proxy logs normalised to UDM with NETWORK_CONNECTION (destination port and target IP) and NETWORK_HTTP (method, target hostname, port) events, with principal.ip populated on both."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Roaming users or guest and BYOD devices using public DNS resolvers and then posting to HTTP-only legacy sites; split-tunnel VPN clients; IoT or kiosk devices with hardcoded public DNS; legitimate captive portals on hotel or guest networks; vendor update or telemetry agents using cleartext POST."
    tuning_guidance = "Add known-good external destination domains to %global_allowed_domains. Add approved scanner or test source addresses to %global_allowed_scanners. If the organisation sanctions specific external resolvers, add them to %global_allowed_mgmt_sources. Raise severity for user VLANs or SSIDs where public DNS is blocked by policy."

  events:
    $dns.metadata.event_type = "NETWORK_CONNECTION"
    $dns.target.port = 53
    not $dns.target.ip in %rfc1918_internal
    not $dns.target.ip in %global_allowed_mgmt_sources
    not $dns.principal.ip in %global_allowed_scanners
    $dns.principal.ip = $client_ip

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.port = 80
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners
    $http.principal.ip = $client_ip

    $dns.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $client_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1557.004")
    $primary_entity = array_distinct($client_ip)
    $external_resolvers = array_distinct($dns.target.ip)
    $post_destination_hosts = array_distinct($http.target.hostname)
    $post_destination_ips = array_distinct($http.target.ip)
    $dns_event_count = count($dns.metadata.id)
    $post_event_count = count($http.metadata.id)

  condition:
    $dns and $http
}
