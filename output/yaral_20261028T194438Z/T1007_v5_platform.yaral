/*
  MITRE Technique : T1007 - System Service Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:15:09.611116+00:00
  Reference       : https://attack.mitre.org/techniques/T1007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

// NOTE: The requested "alternate platform" angle conflicts with the mandatory Windows target and the windows_endpoint log source. The mandatory constraints win, so this rule stays on Windows and pivots on the PowerShell/WMI/CIM service-enumeration mechanism, not sc.exe or net start.
rule MSSP_T1007_Windows_PowerShell_WMI_Service_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects enumeration of registered Windows services through PowerShell (Get-Service) or WMI/CIM (Win32_Service, wmic service get/list). Adversaries use these to find security tooling and vulnerable or hijackable services, bypassing the more commonly monitored sc.exe and net.exe utilities."
    mitre_tactic = "Discovery"
    mitre_technique = "T1007"
    mitre_technique_name = "System Service Discovery"
    log_prerequisites = "Requires EDR or Sysmon process-creation telemetry (or Windows Event 4688 with command-line auditing enabled) that populates the target process path and command line."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT inventory and health-check scripts, RMM and monitoring agents, software deployment tooling, administrators troubleshooting services, and configuration management runs."
    tuning_guidance = "Add approved tooling parent processes to %global_allowed_admin_tools, %global_allowed_script_hosts or %global_allowed_security_tools. Add automation accounts to %global_allowed_service_accounts. For noisy environments, consider raising severity only when the parent is an Office application, browser or script host, or pair with a threshold or correlation rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|wmic)\.exe$/ nocase
    $proc.target.process.command_line = /(\bget-service\b|win32_service|\bservice\s+(get|list)\b)/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1007")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
