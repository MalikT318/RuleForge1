/*
  MITRE Technique : T1195.003 - Compromise Hardware Supply Chain
  Tactic(s)       : Initial Access
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:44:52.348892+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_003_Firmware_Injected_Binary_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external network connection from a process that firmware planted through the Windows Platform Binary Table (WPBT) mechanism. Firmware-level implants from a compromised hardware supply chain use WPBT to have the Session Manager (smss.exe) drop and launch a native binary at boot, which then calls out to attacker infrastructure. Two signals are covered: the OS-defined WPBT execution name in System32, and any process spawned directly by smss.exe other than the standard boot-time session binaries. The outbound connection is the network-side proof that a firmware-delivered payload is active."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.003"
    mitre_technique_name = "Supply Chain Compromise: Compromise Hardware Supply Chain"
    log_prerequisites = "Requires EDR or Sysmon-equivalent network connection telemetry with the originating process path populated. The parent process path (principal.process.parent_process.file.full_path) is needed for the smss.exe lineage branch. The WPBT name branch works without it."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate OEM or enterprise anti-theft and asset-recovery agents that deliver themselves through WPBT (for example OEM persistence modules). Vendor firmware management utilities on newly provisioned devices. Security agents that start early in the boot sequence."
    tuning_guidance = "Add approved OEM persistence or security agent executable paths to %global_allowed_security_tools or %global_allowed_admin_tools. Add known-good vendor destinations to %global_allowed_domains. Keep %rfc1918_internal current so only external destinations alert. Where a fleet legitimately uses WPBT agents, scope the allowlist by process path, not by host."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname != ""
    (
      $net.principal.process.file.full_path = /\\wpbbin\.exe$/ nocase
      or
      (
        $net.principal.process.parent_process.file.full_path = /\\smss\.exe$/ nocase
        and not $net.principal.process.file.full_path = /\\(smss|csrss|wininit|winlogon|autochk|autocheck)\.exe$/ nocase
      )
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1195.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
