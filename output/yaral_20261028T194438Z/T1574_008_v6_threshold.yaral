/*
  MITRE Technique : T1574.008 - Path Interception by Search Order Hijacking
  Tactic(s)       : Stealth, Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:37:12.263892+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_008_Masqueraded_System_Binaries_Dropped_Outside_System_Dirs {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Multiple executables named after built-in Windows system utilities are written to disk outside the standard Windows system directories on a single host within 10 minutes. Adversaries plant these files next to a vulnerable program so that the program launches the planted binary through search order resolution instead of the genuine utility. One such file write can be benign; several in a short window indicate staging for search order hijacking."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.008"
    mitre_technique_name = "Hijack Execution Flow: Path Interception by Search Order Hijacking"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating target.file.full_path and principal.hostname."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers, portable tool bundles, developer build output, Windows servicing and feature-update staging, RMM or patching agents copying utilities, and administrators backing up or copying system binaries."
    tuning_guidance = "Add deployment, patching and RMM binaries to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. Raise the #file threshold in noisy developer or build environments. Add further servicing directories to the path exclusion regex if feature-update staging causes noise."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(net|net1|cmd|powershell|pwsh|ping|ipconfig|whoami|tasklist|systeminfo|nltest|reg|sc|schtasks|wmic|certutil|mshta|rundll32|regsvr32|taskkill|findstr|netstat|hostname|quser|arp|nslookup|bitsadmin|cscript|wscript|msiexec|wusa)\.exe$/ nocase
    not $file.target.file.full_path = /^[a-z]:\\(windows\\(system32|syswow64|sysnative|winsxs|servicing|softwaredistribution|systemapps|installer)|\$windows\.~(bt|ws))\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $event_count = count($file.metadata.id)
    $distinct_names = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $risk_score = max(if($event_count >= 6, 85, 65))
    $mitre_technique_id = array_distinct("T1574.008")
    $primary_entity = array_distinct($host)

  condition:
    #file >= 3
}
