/*
  MITRE Technique : T1036.011 - Overwrite Process Arguments
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:14:06.622452+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_011_Staged_Binary_Spoofed_Argv_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a process launched from a world-writable staging directory (/tmp, /var/tmp, /dev/shm) that later makes a network connection while its recorded command line (argv[0]) looks like a kernel thread or a system daemon. Both events share the same host and PID. A staged binary presenting a benign name after launch is the result of overwriting process arguments in memory, as seen in BPFDoor and XorDdos."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.011"
    mitre_technique_name = "Masquerading: Overwrite Process Arguments"
    log_prerequisites = "Requires Linux EDR or auditd process launch telemetry and network connection telemetry. Both must populate process PID and the executable path (/proc/<pid>/exe). The network event must carry the live command line (/proc/<pid>/cmdline)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software installers or build systems that run helper binaries from /tmp and rename themselves via setproctitle; containers or CI runners that unpack daemons into /tmp; developer test builds of daemons run from staging directories; some EDR or monitoring agents that self-extract to /tmp."
    tuning_guidance = "Add approved installer, CI and deployment parent processes to %global_allowed_admin_tools. Add known script-hosting build hosts to %global_allowed_script_hosts if they dominate alerts. If EDR records the original launch command line in the network event, the command-line regex will not match, so confirm that the sensor reads the live cmdline."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname
    $proc.target.process.pid = $pid

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    $net.principal.process.command_line = /^(\[[^\]]+\]|(\/usr)?\/s?bin\/[a-z0-9_.-]+|\/(usr\/)?lib(exec)?\/systemd\/[a-z0-9_.-]+|(sshd|crond|cron|udevd|rsyslogd|dbus-daemon|agetty|systemd[a-z0-9-]*)(\s.*)?$)/ nocase
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    $net.principal.hostname = $hostname
    $net.principal.process.pid = $pid

    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $pid over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1036.011")
    $primary_entity = array_distinct($proc.principal.hostname)
    $staged_binary_paths = array_distinct($proc.target.process.file.full_path)
    $spoofed_command_lines = array_distinct($net.principal.process.command_line)
    $remote_ips = array_distinct($net.target.ip)
    $users = array_distinct($proc.principal.user.userid)

  condition:
    $proc and $net
}
