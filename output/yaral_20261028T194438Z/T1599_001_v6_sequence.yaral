/*
  MITRE Technique : T1599.001 - Network Address Translation Traversal
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:03:04.086290+00:00
  Reference       : https://attack.mitre.org/techniques/T1599/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1599_001_External_Mgmt_Access_Then_Inbound_To_Internal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An external source connects to a network-device management port and, within ten minutes, the same external source has a flow to an internal (RFC1918) host on a lateral-movement or administrative port. This pattern suggests the boundary device was accessed and its NAT or translation rules altered to expose a protected network."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1599.001"
    mitre_technique_name = "Network Boundary Bridging: Network Address Translation Traversal"
    log_prerequisites = "Requires perimeter firewall or proxy connection and flow logs with normalised source IP, destination IP and destination port. Flow logs must record the post-translation (internal) destination address for inbound sessions."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised vendor or MSP remote administration followed by legitimate published services; VPN concentrators or published services (RDP gateways, jump hosts) legitimately reachable from the internet; unapproved vulnerability scanners and penetration tests."
    tuning_guidance = "Add approved administrative source addresses to %global_allowed_mgmt_sources and scanner or pen-test sources to %global_allowed_scanners. If a client intentionally publishes services on the destination ports, restrict the second event's target.ip or port list per tenant. Adjust the management and internal port lists to the client's environment."

  events:
    $mgmt.metadata.event_type = "NETWORK_CONNECTION"
    not $mgmt.principal.ip in %rfc1918_internal
    (
      $mgmt.target.port = 22 or
      $mgmt.target.port = 23 or
      $mgmt.target.port = 443 or
      $mgmt.target.port = 8443 or
      $mgmt.target.port = 161
    )
    not $mgmt.principal.ip in %global_allowed_mgmt_sources
    not $mgmt.principal.ip in %global_allowed_scanners
    $mgmt.principal.ip = $src_ip

    $flow.metadata.event_type = "NETWORK_FLOW"
    not $flow.principal.ip in %rfc1918_internal
    $flow.target.ip in %rfc1918_internal
    (
      $flow.target.port = 22 or
      $flow.target.port = 445 or
      $flow.target.port = 1433 or
      $flow.target.port = 3389 or
      $flow.target.port = 5985 or
      $flow.target.port = 5986
    )
    not $flow.principal.ip in %global_allowed_mgmt_sources
    not $flow.principal.ip in %global_allowed_scanners
    $flow.principal.ip = $src_ip

    $mgmt.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1599.001")
    $primary_entity = array_distinct($src_ip)
    $mgmt_ports = array_distinct($mgmt.target.port)
    $internal_targets = array_distinct($flow.target.ip)
    $internal_ports = array_distinct($flow.target.port)
    $flow_count = count($flow.metadata.id)

  condition:
    $mgmt and $flow
}
