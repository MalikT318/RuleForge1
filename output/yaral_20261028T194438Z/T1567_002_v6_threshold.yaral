/*
  MITRE Technique : T1567.002 - Exfiltration to Cloud Storage
  Tactic(s)       : Exfiltration
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:58:33.798411+00:00
  Reference       : https://attack.mitre.org/techniques/T1567/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_002_Bulk_Upload_To_Cloud_Storage_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single internal source sends repeated large HTTP POST/PUT uploads to external storage-style destinations within ten minutes. Each upload is benign alone, but sustained volume suggests staged data exfiltration to cloud storage. Detection uses perimeter network telemetry only and matches generic storage/upload hostname patterns, not specific providers."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567.002"
    mitre_technique_name = "Exfiltration Over Web Service: Exfiltration to Cloud Storage"
    log_prerequisites = "Firewall or proxy logs normalised to NETWORK_HTTP with HTTP method, target hostname, and sent byte counts populated. TLS inspection or SNI/hostname logging is required for hostname visibility."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Approved cloud backup and file-sync clients, software publishers uploading build artifacts, users sharing large files via sanctioned collaboration platforms, telemetry or crash-dump uploads, and developers pushing to artifact or object storage."
    tuning_guidance = "Add sanctioned storage and sync destinations to %global_allowed_domains. Raise the #net threshold or the sent_bytes floor for high-volume environments. Review the source IP against asset inventory to identify Windows endpoints. Severity scales in outcome with per-upload size."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT)$/ nocase
    $net.network.sent_bytes > 1000000
    $net.target.hostname = /(storage|upload|blob|bucket|drive|files|share|objects|backup|cdn-?content)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    $net.principal.ip = $src_ip

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(if($net.network.sent_bytes > 50000000, 85, 65))
    $mitre_technique_id = array_distinct("T1567.002")
    $primary_entity = array_distinct($src_ip)
    $upload_count = count($net.metadata.id)
    $total_bytes_sent = sum($net.network.sent_bytes)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    #net >= 5
}
