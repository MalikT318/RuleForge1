/*
  MITRE Technique : T1557.004 - Evil Twin
  Tactic(s)       : Credential Access, Collection
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:36:36.949450+00:00
  Reference       : https://attack.mitre.org/techniques/T1557/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1557_004_Client_DNS_To_External_Resolver_Evil_Twin {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client sending DNS (port 53) directly to an external resolver instead of the sanctioned internal resolvers or forwarders. An evil twin access point typically hands victims a DHCP lease with attacker-controlled DNS, or a public resolver, to redirect or intercept name resolution. This is a network-side proxy indicator of a client that joined a rogue wireless network, not direct observation of the rogue access point."
    mitre_tactic = "Credential Access, Collection"
    mitre_technique = "T1557.004"
    mitre_technique_name = "Adversary-in-the-Middle: Evil Twin"
    log_prerequisites = "Firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Wireless client segments must route egress through the monitored perimeter. Populate %global_allowed_mgmt_sources with the internal DNS resolvers and forwarders that legitimately query external DNS."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Devices with hardcoded public DNS (IoT, guest Wi-Fi, BYOD), VPN clients or roaming laptops using their own resolver, DNS-over-UDP monitoring or health-check tooling, and internal resolvers or forwarders not yet in the allowlist."
    tuning_guidance = "Add internal DNS resolvers and forwarders to %global_allowed_mgmt_sources (matched on source address). Add authorised scanners and test sources to %global_allowed_scanners. Enforce DNS egress control on guest and BYOD segments, or scope this rule to corporate wireless client address space. Once baselined, raise severity for repeat hits from the same client."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 53
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %rfc1918_internal_placeholder_unused_guard
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1557.004")
    $primary_entity = array_distinct($net.principal.ip)
    $external_resolvers = array_distinct($net.target.ip)

  condition:
    $net
}
