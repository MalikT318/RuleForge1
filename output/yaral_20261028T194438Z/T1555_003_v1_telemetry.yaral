/*
  MITRE Technique : T1555.003 - Credentials from Web Browsers
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:55:23.640520+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_003_Linux_Browser_Credential_Store_Staged {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a copy of a web browser credential store (Chromium-family Login Data, Firefox logins.json, key3.db/key4.db, signons.sqlite) inside a world-writable staging directory (/tmp, /var/tmp, /dev/shm). Browsers never write these files to staging locations. A copy there indicates credential harvesting, either to avoid locking issues while querying the SQLite database or to stage it for exfiltration. This pivots on the resulting file artifact rather than command-line syntax, so it still fires when command-line logging is evaded."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.003"
    mitre_technique_name = "Credentials from Password Stores: Credentials from Web Browsers"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch/creation events normalised to UDM FILE_CREATION with target.file.full_path and principal.process populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup or imaging agents snapshotting user profiles through a temp directory, IT profile migration or forensic collection scripts, browser sync or profile-repair tools, and developers or QA testing browser automation with copied profiles."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes, approved IT tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. If automated browser testing is common, scope exclusions to the specific test hosts or service accounts rather than the staging path."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    $file.target.file.full_path = /\/(login data( for account)?(-journal)?|logins\.json|key[34]\.db|signons\.sqlite)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1555.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $staged_file = array_distinct($file.target.file.full_path)
    $acting_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
