/*
  MITRE Technique : T1020 - Automated Exfiltration
  Tactic(s)       : Exfiltration
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:30:13.456137+00:00
  Reference       : https://attack.mitre.org/techniques/T1020
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1020_Large_Asymmetric_Outbound_Transfer_Flow {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a single network flow in which a large volume of data leaves the internal network for an external destination with almost no data returned. This one-way push pattern is characteristic of scripted or scheduled bulk exfiltration observed from the perimeter. It is independent of the initiating process, so it adds network-side coverage alongside endpoint command-line detections."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1020"
    mitre_technique_name = "Automated Exfiltration"
    log_prerequisites = "Requires perimeter firewall or proxy flow/connection logs normalised to UDM NETWORK_FLOW with network.sent_bytes and network.received_bytes populated. Byte counters are often only present on session-close or flow-summary records."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Cloud backup and replication jobs, offsite log shipping and SIEM forwarding, software publishing and CI/CD artifact uploads, large email or file-sharing uploads by users, video conferencing and live-stream uploads, and database replication to cloud providers."
    tuning_guidance = "Add known-good destination hostnames (backup vendors, SaaS, CDNs) to %global_allowed_domains. Adjust the sent_bytes threshold (default 50 MB) and the received_bytes ceiling (default 1 MB) per client baseline. For clients with known scheduled transfer windows, raise severity only outside those windows. Confirm the client's firewall populates byte counters on the flow records it sends."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    $net.network.sent_bytes >= 52428800
    $net.network.received_bytes < 1048576
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1020")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
