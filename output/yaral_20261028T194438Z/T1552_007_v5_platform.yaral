/*
  MITRE Technique : T1552.007 - Container API
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:56:28.725010+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_007_K8s_API_Secrets_Read_By_ServiceAccount {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Kubernetes API server audit event in which a workload service account identity reads Secret objects (get or list) through the Kubernetes API. Pod service-account tokens used from inside a compromised container to harvest secrets are a common credential-access path. Cluster-internal control-plane accounts and allow-listed accounts are excluded. This is an audit-log (control plane) detection and does not rely on process command lines."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.007"
    mitre_technique_name = "Unsecured Credentials: Container API"
    log_prerequisites = "Kubernetes API server audit logging enabled at Metadata level or higher for the secrets resource, ingested and normalized to UDM USER_RESOURCE_ACCESS with the request URI in target.url and the authenticated identity in principal.user.userid."
    platform = "Containers"
    log_source = "container"
    false_positives = "Operators and controllers that legitimately read secrets (secret-sync or external-secrets controllers, ingress and certificate controllers, service meshes, GitOps agents, CI/CD deployers, monitoring stacks with scrape credentials), and application pods that load their own secrets through the API at startup."
    tuning_guidance = "Add expected workload service accounts (system:serviceaccount:<ns>:<name>) to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. If your audit parser populates a different field for the request URI, adjust the target.url match. Consider raising severity for secrets access outside the pod's own namespace."

  events:
    $k8s.metadata.event_type = "USER_RESOURCE_ACCESS"
    $k8s.target.url = /\/api\/v1\/(namespaces\/[^\/]+\/)?secrets(\/|\?|$)/ nocase
    $k8s.principal.user.userid = /^system:serviceaccount:/ nocase
    not $k8s.principal.user.userid = /^system:serviceaccount:(kube-system|kube-public|kube-node-lease):/ nocase
    not $k8s.principal.user.userid in %global_allowed_service_accounts
    not $k8s.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1552.007")
    $primary_entity = array_distinct($k8s.principal.user.userid)
    $accessed_urls = array_distinct($k8s.target.url)
    $secret_names = array_distinct($k8s.target.resource.name)
    $source_ips = array_distinct($k8s.principal.ip)

  condition:
    $k8s
}
