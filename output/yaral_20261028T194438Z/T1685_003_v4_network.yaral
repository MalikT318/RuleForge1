/*
  MITRE Technique : T1685.003 - Modify or Spoof Tool UI
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:20:28.888097+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_003_Fake_Security_UI_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process masquerading as a Windows security UI component (security health tray, Defender UI, or Windows Security app) that makes an external network connection from outside the trusted OS and Defender locations. Genuine security UI binaries are local presentation components that do not normally beacon to external hosts. A lookalike binary in a user-writable path that reaches the internet suggests a spoofed security interface, as used by ransomware operators, with a command-and-control channel behind it."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.003"
    mitre_technique_name = "Modify or Spoof Tool UI"
    log_prerequisites = "Requires EDR or Sysmon network connection telemetry (Sysmon Event ID 3 equivalent) with the initiating process image path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Security product installers or updaters that stage UI components in temporary directories, custom-deployed endpoint agents with UI names resembling Windows components, and Windows servicing or feature updates staging binaries outside System32 or SystemApps."
    tuning_guidance = "Add approved security agent binaries to %global_allowed_security_tools. Add approved deployment or patching tooling to %global_allowed_admin_tools. If a client's endpoint security agent legitimately uses a similar UI name, add its full path to %global_allowed_security_tools rather than widening the name regex."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(SecurityHealthSystray|SecurityHealthHost|SecurityHealthService|MSASCuiL|SecHealthUI|WindowsSecurity|WindowsDefender|DefenderUI)\.exe$/ nocase
    not $net.principal.process.file.full_path = /^[a-z]:\\(windows\\(system32|syswow64|systemapps)|program files( \(x86\))?\\windows defender|programdata\\microsoft\\windows defender)\\/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1685.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $masquerading_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
