/*
  MITRE Technique : T1574.006 - Dynamic Linker Hijacking
  Tactic(s)       : Stealth, Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:32:34.549566+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_006_Daemon_Parent_Spawns_Shell_With_Linker_Hijack {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing or service daemon (web server, application server, database, print or file service) spawning a shell, script interpreter or the dynamic loader itself with dynamic linker hijack indicators (LD_PRELOAD, LD_AUDIT, LD_LIBRARY_PATH, ld.so.preload, loader --preload). Daemons do not normally launch interpreters with linker overrides, so this lineage points to post-exploitation (webshell, injection, RCE) staging a malicious shared library."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.006"
    mitre_technique_name = "Hijack Execution Flow: Dynamic Linker Hijacking"
    log_prerequisites = "Linux EDR or auditd (execve) telemetry with parent process path, child process path and command line populated, normalised to UDM PROCESS_LAUNCH."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Application servers or CGI handlers launched with legitimate LD_LIBRARY_PATH wrappers (Oracle, Java or PHP vendor startup scripts), database init or backup scripts exporting LD_LIBRARY_PATH, memory allocator preloads such as jemalloc or tcmalloc configured by admins, and profiling or debugging sessions on application hosts."
    tuning_guidance = "Add approved parent daemons or wrapper binaries to %global_allowed_script_hosts or %global_allowed_admin_tools. If a vendor startup script legitimately sets LD_LIBRARY_PATH, exclude its parent by path in those lists rather than loosening the command-line indicators."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(httpd|apache2|nginx|php-fpm[0-9.]*|php-cgi|lighttpd|tomcat[0-9]*|catalina|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|smbd|named)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ksh|csh|tcsh|python[0-9.]*|perl|ruby|php[0-9.]*|ld-linux[^\/]*\.so(\.[0-9]+)?|ld\.so)$/ nocase
    $proc.target.process.command_line = /(LD_PRELOAD|LD_AUDIT|LD_LIBRARY_PATH)=|ld\.so\.preload|--preload|--library-path/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1574.006")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
