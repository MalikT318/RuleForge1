/*
  MITRE Technique : T1568 - Dynamic Resolution
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:02:45.917674+00:00
  Reference       : https://attack.mitre.org/techniques/T1568
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1568_DGA_Style_DNS_Then_External_Connect {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A non-browser process on a Windows host resolves several algorithmically generated looking domain names (long, random-looking single labels with consonant runs) and then opens a connection to an external address within ten minutes. This pattern suggests dynamic resolution of C2 infrastructure (DGA) by malware. It is a DNS and network behavioural rule and does not depend on process command lines."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1568"
    mitre_technique_name = "Dynamic Resolution"
    log_prerequisites = "Requires endpoint DNS query telemetry (e.g. Sysmon Event ID 22 or EDR DNS events) and endpoint network connection telemetry, both with the initiating process path populated and normalised to UDM NETWORK_DNS and NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "CDN and cloud services using hash-like hostnames, software update clients, telemetry agents, peer-to-peer or sync clients, developer tooling hitting ephemeral test hosts, and email or anti-spam lookups with encoded labels."
    tuning_guidance = "Add known-good domains to %global_allowed_domains, update and management tooling to %global_allowed_admin_tools, and EDR/AV agents to %global_allowed_security_tools. Raise the #dns threshold in the condition for noisy environments. Add further browser or updater process names to the process-name exclusions if needed."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /^[a-z0-9]{12,40}\.[a-z]{2,10}$/ nocase
    $dns.network.dns.questions.name = /[bcdfghjklmnpqrstvwxz]{6,}/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.process.file.full_path = /\\(chrome|msedge|firefox|iexplore|brave|opera)\.exe$/ nocase
    not $dns.principal.process.file.full_path in %global_allowed_security_tools
    not $dns.principal.process.file.full_path in %global_allowed_admin_tools
    $dns.principal.process.file.full_path != ""
    $dns.principal.hostname = $hostname
    $dns.principal.process.file.full_path = $proc_path

    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path = /\\(chrome|msedge|firefox|iexplore|brave|opera)\.exe$/ nocase
    $net.principal.hostname = $hostname
    $net.principal.process.file.full_path = $proc_path

    $dns.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $proc_path over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1568")
    $primary_entity = array_distinct($hostname)
    $process_path = array_distinct($proc_path)
    $generated_domains = array_distinct($dns.network.dns.questions.name)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $dns_event_count = count($dns.metadata.id)

  condition:
    #dns >= 3 and $net
}
