/*
  MITRE Technique : T1204.005 - Malicious Library
  Tactic(s)       : Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:06:45.089159+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_005_Linux_Package_Install_Nonstandard_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux package-install process (pip, npm, yarn, pnpm, setup.py, easy_install) making an outbound connection to an external address on a port other than 80, 443 or 22. Package managers normally reach public registries over HTTPS. A malicious library's install hook (postinstall script, setup.py payload) often beacons, downloads a second stage or exfiltrates over a raw or non-standard port. This is a network-side detection that complements process-creation rules."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.005"
    mitre_technique_name = "User Execution: Malicious Library"
    log_prerequisites = "Requires Linux EDR or auditd network telemetry (NETWORK_CONNECTION) that populates principal.process.command_line, target.ip and target.port."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Self-hosted package mirrors or registries on external IPs with custom ports (Nexus, Artifactory, Verdaccio, devpi), package installs from git over the git:// protocol (port 9418), builds downloading native binaries from CDNs on non-standard ports, and corporate proxies listening on ports such as 3128 or 8080."
    tuning_guidance = "Add approved package mirror hostnames to %global_allowed_domains. Add approved build and deployment tooling to %global_allowed_admin_tools. Extend the port exclusions if the client runs a known external mirror on a fixed port. Consider raising severity for build servers that should never egress to unknown hosts."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.command_line = /(\b(npm|yarn|pnpm)\s+(install|i|add|ci)\b|\bpip[0-9.]*\s+(install|download)\b|\bsetup\.py\s+(install|develop|bdist_wheel)\b|\beasy_install\b)/ nocase
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 22
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1204.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $install_command = array_distinct($net.principal.process.command_line)
    $install_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
