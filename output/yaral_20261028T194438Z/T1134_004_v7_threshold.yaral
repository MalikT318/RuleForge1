/*
  MITRE Technique : T1134.004 - Parent PID Spoofing
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:01:14.608685+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_004_Parent_PID_Spoofing_System_Parent_Spawn_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated launches of interpreters or proxy-execution LOLBins on a single host within 10 minutes, where the parent is a core Windows system or shell-host process that does not normally spawn them (for example spoolsv, winlogon, lsass, services, dwm, taskhostw). One such launch can be benign, but a burst is a strong indicator of Parent PID spoofing (CreateProcess with PROC_THREAD_ATTRIBUTE_PARENT_PROCESS) used to hide the true parent, or of exploitation of those system processes."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.004"
    mitre_technique_name = "Access Token Manipulation: Parent PID Spoofing"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 (or Windows Event 4688 with parent process name) populating principal.process.file.full_path (parent) and target.process.file.full_path (child)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Print spooler or driver installers spawning rundll32, services.exe launching cmd or PowerShell for legitimate service wrappers, accessibility or recovery tooling launched from winlogon, software deployment and RMM agents, and EDR agents with unusual lineage reporting."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools, %global_allowed_script_hosts or %global_allowed_security_tools. Raise the #proc threshold for noisy hosts such as print servers or build servers. Scope the parent regex down if a client has legitimate service wrappers that launch shells."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(spoolsv|winlogon|wininit|lsass|services|csrss|smss|dwm|fontdrvhost|audiodg|searchindexer|runtimebroker|taskhostw|sihost)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd|rundll32|regsvr32|mshta|wscript|cscript|msbuild|installutil)\.exe$/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(re.regex($proc.target.process.file.full_path, /(?i)\\(mshta|regsvr32|msbuild|installutil)\.exe$/), 85, 70))
    $mitre_technique_id = array_distinct("T1134.004")
    $primary_entity = array_distinct($host)
    $event_count = count($proc.metadata.id)
    $spoofed_parents = array_distinct($proc.principal.process.file.full_path)
    $child_processes = array_distinct($proc.target.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)
    $users = array_distinct($proc.principal.user.userid)

  condition:
    #proc >= 3
}
