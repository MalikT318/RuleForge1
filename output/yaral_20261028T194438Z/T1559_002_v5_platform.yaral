/*
  MITRE Technique : T1559.002 - Dynamic Data Exchange
  Tactic(s)       : Execution
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:54:48.134231+00:00
  Reference       : https://attack.mitre.org/techniques/T1559/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_002_Office_DDE_Registry_Enabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry changes that re-enable Dynamic Data Exchange in Microsoft Office. Examples are setting AllowDDE to a non-zero value in the Word security key, or setting the Excel DisableDDEServerLaunch/DisableDDEServerLookup values to 0. DDE is disabled by default in current Office builds, and re-enabling it is a prerequisite for DDE-based command execution from poisoned documents. DDE exists only on Windows, so this variant targets the Windows registry mechanism rather than process lineage."
    mitre_tactic = "Execution"
    mitre_technique = "T1559.002"
    mitre_technique_name = "Inter-Process Communication: Dynamic Data Exchange"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event IDs 12/13 equivalents) populating registry key, value name and, preferably, value data."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy line-of-business Office integrations or finance macros that depend on DDE, GPO or MDM baselines applied by IT, Office installers or repair operations, and administrators testing compatibility."
    tuning_guidance = "Add approved deployment and configuration tooling to %global_allowed_admin_tools. Add GPO or MDM service identities to %global_allowed_service_accounts. If registry value data is not populated for a client, remove the value-data conditions and alert on the value name only."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\software\\(policies\\)?microsoft\\office\\[0-9.]+\\(word|excel)\\(security|options)/ nocase
    (
      (
        $reg.target.registry.registry_value_name = /^AllowDDE$/ nocase
        and not $reg.target.registry.registry_value_data = /^(DWORD \()?(0x)?0+\)?$/ nocase
      )
      or
      (
        $reg.target.registry.registry_value_name = /^(DisableDDEServerLaunch|DisableDDEServerLookup)$/ nocase
        and $reg.target.registry.registry_value_data = /^(DWORD \()?(0x)?0+\)?$/ nocase
      )
    )
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1559.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_name)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
