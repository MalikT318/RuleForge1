/*
  MITRE Technique : T1614.001 - System Language Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:40:28.721091+00:00
  Reference       : https://attack.mitre.org/techniques/T1614/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1614_001_Language_Discovery_Then_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A script interpreter or reg.exe queries system language, locale or keyboard layout settings, and within 10 minutes a script interpreter on the same host makes an external network connection. This pattern matches malware that checks the victim's language before downloading a payload or beaconing."
    mitre_tactic = "Discovery"
    mitre_technique = "T1614.001"
    mitre_technique_name = "System Location Discovery: System Language Discovery"
    log_prerequisites = "Requires EDR or Sysmon process-launch telemetry with full command lines (or Windows Event 4688 with command-line auditing), plus endpoint network connection telemetry attributed to the originating process."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Localization-aware installers and deployment scripts, RMM and inventory agents collecting locale data, admin scripts that set regional settings and then fetch content, and software that checks the UI culture before downloading language packs."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts, inventory and deployment tooling to %global_allowed_admin_tools, and known-good update or vendor destinations to %global_allowed_domains. If noise remains, narrow the interpreter list on the network event."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd|reg|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(control\\nls\\language|control panel\\international|get-winsystemlocale|get-uiculture|get-winuserlanguagelist|get-culture|installeduiculture|getuserdefaultuilanguage|getsystemdefaultuilanguage|getkeyboardlayoutlist|getuserdefaultlangid)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    $net.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1614.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $discovery_commands = array_distinct($proc.target.process.command_line)
    $discovery_user = array_distinct($proc.principal.user.userid)
    $destination_ips = array_distinct($net.target.ip)
    $network_event_count = count($net.metadata.id)

  condition:
    $proc and $net
}
