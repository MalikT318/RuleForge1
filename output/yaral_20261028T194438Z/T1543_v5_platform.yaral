/*
  MITRE Technique : T1543 - Create or Modify System Process
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:53:05.970267+00:00
  Reference       : https://attack.mitre.org/techniques/T1543
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_Container_K8s_DaemonSet_Created_By_Unapproved_Identity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a Kubernetes DaemonSet by an identity that is not an approved administrator or service account. A DaemonSet schedules a pod on every node and recreates it automatically, so an attacker with API access can use it as a persistent, cluster-wide system process. It can also be used to escalate to node level when the pod spec mounts host paths or runs privileged. This rule covers the control plane (Kubernetes audit) and complements process-creation detections."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543"
    mitre_technique_name = "Create or Modify System Process"
    log_prerequisites = "Requires Kubernetes API server audit logs ingested and normalised to UDM as RESOURCE_CREATION, with the audit resource path in target.resource.name and the authenticated identity in principal.user.userid. Audit policy must record create requests at Metadata level or higher."
    platform = "Containers"
    log_source = "container"
    false_positives = "Legitimate platform tooling that deploys node agents (CNI plugins, log shippers, monitoring and security agents, CSI drivers) via CI/CD pipelines or GitOps controllers; cluster upgrades and Helm releases run by human administrators who are not yet allowlisted."
    tuning_guidance = "Add GitOps controller, CI/CD and operator identities to %global_allowed_service_accounts and named cluster administrators to %global_allowed_admin_users. If the environment deploys many DaemonSets, raise severity only for creations outside change windows or in sensitive namespaces."

  events:
    $res.metadata.event_type = "RESOURCE_CREATION"
    $res.target.resource.name = /(^|\/)daemonsets(\/|$)/ nocase
    $res.principal.user.userid != ""
    not $res.principal.user.userid = /^system:(kube-controller-manager|kube-scheduler|node:)/ nocase
    not $res.principal.user.userid in %global_allowed_service_accounts
    not $res.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1543")
    $primary_entity = array_distinct($res.principal.user.userid)
    $daemonset_resource = array_distinct($res.target.resource.name)
    $source_ips = array_distinct($res.principal.ip)

  condition:
    $res
}
