/*
  MITRE Technique : T1568.003 - DNS Calculation
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:08:30.184005+00:00
  Reference       : https://attack.mitre.org/techniques/T1568/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1568_003_Linux_Staged_Binary_Outbound_Nonstandard_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux process running from a world-writable staging location (/tmp, /var/tmp, /dev/shm) or an anonymous memfd mapping that opens an outbound connection to an external IP on a non-standard high port. DNS-calculation C2 (T1568.003) derives its destination port and IP from DNS answer octets, so the connection lands on an arbitrary high port that no static egress rule anticipates. Detection is on the network result of the calculation, not on command-line content or specific indicators, so it complements existing process-creation rules."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1568.003"
    mitre_technique_name = "Dynamic Resolution: DNS Calculation"
    log_prerequisites = "Linux EDR or auditd (connect syscall auditing) producing NETWORK_CONNECTION events with principal process path, target IP and target port populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developer or CI builds that run test binaries from /tmp and call external services; package managers or installers that unpack and run helpers from /tmp; peer-to-peer or game clients on high ports; containerised workloads with tmpfs-mounted binaries; self-extracting vendor agents."
    tuning_guidance = "Add approved RMM, deployment and update binaries to %global_allowed_admin_tools, EDR and agent binaries to %global_allowed_security_tools, and trusted script hosts to %global_allowed_script_hosts. Extend the excluded alternate-web port list for client-specific services. Raise the port floor (for example above 10000) in noisy developer environments. Validate against the DNS answer for the destination to confirm the calculation pattern."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/|^\/memfd:/ nocase
    $net.principal.hostname != ""
    $net.target.ip != ""
    $net.target.port > 1024
    $net.target.port != 8080
    $net.target.port != 8443
    $net.target.port != 8000
    $net.target.port != 8888
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1568.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $staged_process = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
