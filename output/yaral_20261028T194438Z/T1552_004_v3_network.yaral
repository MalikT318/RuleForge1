/*
  MITRE Technique : T1552.004 - Private Keys
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:50:51.371890+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_004_Network_Private_Key_File_Upload_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an HTTP(S) upload (PUT/POST) to an external destination where the requested URL points to a private key or key-container file (.key, .pem, .pfx, .p12, .ppk, .pgp, .gpg). This is the network-side view of private key exfiltration, for example a key exported from a host or network device and pushed to external infrastructure."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.004"
    mitre_technique_name = "Unsecured Credentials: Private Keys"
    log_prerequisites = "Requires firewall or proxy logs normalised to UDM NETWORK_HTTP with network.http.method and target.url populated. For HTTPS, TLS inspection must be enabled or the URL will not be visible."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Administrators uploading certificates or keys to external certificate authorities, SaaS key-management portals, or cloud load-balancer and CDN consoles; vendor support case uploads; automated certificate-provisioning workflows reaching external ACME or PKI services."
    tuning_guidance = "Add approved vendor, CA, and PKI service domains to %global_allowed_domains. Add trusted internal egress or management sources to %global_allowed_mgmt_sources. Add automation accounts to %global_allowed_service_accounts. If a client has no TLS inspection, expect coverage only for cleartext HTTP."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(PUT|POST)$/ nocase
    $net.target.url = /\.(key|pem|pfx|p12|ppk|pgp|gpg)([?#;].*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1552.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
