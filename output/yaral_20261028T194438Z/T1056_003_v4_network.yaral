/*
  MITRE Technique : T1056.003 - Web Portal Capture
  Tactic(s)       : Collection, Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:49:43.193721+00:00
  Reference       : https://attack.mitre.org/techniques/T1056/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1056_003_Portal_Server_Outbound_Credential_POST {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a small outbound HTTP POST from an internal host to an external destination that is addressed by raw IP or sent to a non-standard port, and is not on the known-good domain list. A trojanised externally facing login portal (VPN, OWA, ADFS or a web application) typically relays captured credentials this way. The normal traffic pattern for such servers is inbound requests with only allow-listed outbound calls, so a credential-sized POST to an unlisted external collector is anomalous."
    mitre_tactic = "Collection, Credential Access"
    mitre_technique = "T1056.003"
    mitre_technique_name = "Input Capture: Web Portal Capture"
    log_prerequisites = "Requires firewall or web proxy logs normalised to NETWORK_HTTP with HTTP method, target URL or hostname, target port and sent bytes populated. Proxy or SSL-inspection visibility is needed to see the HTTP method on port 443."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Server applications calling webhooks, payment or notification APIs by IP or on non-standard ports. Monitoring and telemetry agents. SaaS integrations or license checks. Developer and test hosts posting to external services. Security or vulnerability scanners generating POST traffic."
    tuning_guidance = "Add legitimate external API and vendor domains to %global_allowed_domains. Add scanner sources to %global_allowed_scanners. Add approved management sources to %global_allowed_mgmt_sources. If the rule is noisy, scope it to the DMZ or portal server segment through client-side log routing, or raise or lower the sent_bytes ceiling to match local POST sizes."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    $net.network.sent_bytes > 0
    $net.network.sent_bytes < 4096
    (
      re.regex($net.target.url, `^(https?://)?[0-9]{1,3}(\.[0-9]{1,3}){3}([:/]|$)`) or
      ($net.target.port != 80 and $net.target.port != 443)
    )

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1056.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $destination_urls = array_distinct($net.target.url)

  condition:
    $net
}
