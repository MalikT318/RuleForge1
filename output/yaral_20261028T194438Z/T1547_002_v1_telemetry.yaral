/*
  MITRE Technique : T1547.002 - Authentication Package
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:24:55.248004+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_002_LSA_Authentication_Packages_Registry_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry write to the LSA 'Authentication Packages' value under Control\\Lsa where the new data is not just the default msv1_0 package. Adversaries add a DLL name here so LSASS loads it at boot for persistence and SYSTEM-level code execution. The rule triggers on the resulting registry state change and does not depend on command-line logging, so it also catches API, script and in-memory tooling."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.002"
    mitre_technique_name = "Boot or Logon Autostart Execution: Authentication Package"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events) that populates target.registry.registry_key and ideally registry_value_name and registry_value_data."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows servicing (TrustedInstaller/TiWorker) and OS upgrades; installers for legitimate third-party authentication packages (smart-card, MFA, credential providers, password filters, endpoint security with LSA integration); IT deployment tooling or GPO scripts that manage LSA settings."
    tuning_guidance = "Add approved deployment or installer binaries to %global_allowed_admin_tools (matched on the writing process path). If the telemetry does not populate registry_value_data, the default-package exclusion has no effect and every write to this value will alert; review the first hits and add approved writers to the list. Review any newly added DLL name in registry_value_data against the files present in System32."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      $reg.target.registry.registry_key = /\\Control\\Lsa\\Authentication Packages$/ nocase or
      (
        $reg.target.registry.registry_key = /\\Control\\Lsa$/ nocase and
        $reg.target.registry.registry_value_name = /^Authentication Packages$/ nocase
      )
    )
    not $reg.target.registry.registry_value_data = /^\s*"?msv1_0"?\s*$/ nocase
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1547.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $writer_user = array_distinct($reg.principal.user.userid)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_data = array_distinct($reg.target.registry.registry_value_data)

  condition:
    $reg
}
