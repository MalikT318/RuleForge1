/*
  MITRE Technique : T1222 - File and Directory Permissions Modification
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:17:15.186199+00:00
  Reference       : https://attack.mitre.org/techniques/T1222
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_Takeown_Then_Icacls_Grant {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a process taking ownership of files with takeown.exe followed, on the same host within 10 minutes, by icacls.exe granting full, modify or inheritable access or changing ownership. This ownership-then-ACL-rewrite chain is used to gain access to protected files, replace system binaries, tamper with security tooling and prepare ransomware encryption."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1222"
    mitre_technique_name = "File and Directory Permissions Modification"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command lines (EDR, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators repairing broken permissions, software installers and updaters resetting ACLs, imaging and deployment scripts, RMM and patching tools, and profile migration scripts."
    tuning_guidance = "Add approved deployment and RMM parent processes to %global_allowed_admin_tools and named administrator accounts to %global_allowed_admin_users. If a client's installers are noisy, require the icacls side to target system paths or raise the match threshold to multiple icacls executions."

  events:
    $take.metadata.event_type = "PROCESS_LAUNCH"
    $take.target.process.file.full_path = /\\takeown\.exe$/ nocase
    $take.target.process.command_line = /\/f\s/ nocase
    not $take.principal.process.file.full_path in %global_allowed_admin_tools
    not $take.principal.user.userid in %global_allowed_admin_users
    $take.principal.hostname = $hostname

    $acl.metadata.event_type = "PROCESS_LAUNCH"
    $acl.target.process.file.full_path = /\\icacls\.exe$/ nocase
    $acl.target.process.command_line = /\/(grant(:[rf])?\s+.+:\(?(f|m|oi|ci)|setowner)/ nocase
    not $acl.principal.process.file.full_path in %global_allowed_admin_tools
    not $acl.principal.user.userid in %global_allowed_admin_users
    $acl.principal.hostname = $hostname

    $take.metadata.event_timestamp.seconds <= $acl.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1222")
    $primary_entity = array_distinct($acl.principal.hostname)
    $users = array_distinct($acl.principal.user.userid)
    $takeown_commands = array_distinct($take.target.process.command_line)
    $icacls_commands = array_distinct($acl.target.process.command_line)
    $acl_event_count = count($acl.metadata.id)

  condition:
    $take and $acl
}
