/*
  MITRE Technique : T1550.001 - Application Access Token
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:36:43.842761+00:00
  Reference       : https://attack.mitre.org/techniques/T1550/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1550_001_Token_Policy_Or_AppCredential_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change to token-handling settings in the cloud identity plane: token or session lifetime and expiry policy, refresh-token or revocation behaviour, OAuth consent or grant settings, and secrets or certificates added to an application or service identity. Adversaries who hold stolen application access tokens make these changes to lengthen token validity, or add a durable credential to the compromised application so access outlives the stolen token. The rule alerts on the resulting setting change, not on the client or command used to make it."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1550.001"
    mitre_technique_name = "Use Alternate Authentication Material: Application Access Token"
    log_prerequisites = "Requires identity provider directory/audit logs, ingested alongside cloud control-plane audit logs, that are normalised to UDM SETTING_MODIFICATION with metadata.product_event_type and an acting principal in principal.user.userid."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Planned identity-governance or security-hardening changes to token and session lifetime policy; application owners rotating secrets or certificates; CI/CD and infrastructure-as-code pipelines that manage application registrations; onboarding of new SaaS or enterprise applications; identity administrators during migrations."
    tuning_guidance = "Add approved admin accounts to %global_allowed_admin_users, automation and pipeline identities to %global_allowed_service_accounts, and approved cloud or identity service principals to %global_allowed_cloud_principals. If secret rotation is noisy, scope the allowlists to the rotation identities rather than loosening the regex. Increase severity when the actor is not an administrator or the source IP is unusual for that user."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /(token|oauth|refresh|session|consent|grant|credential|secret|certificate|key).*(lifetime|expir|revoc|revoke|policy|setting|add|update|create|grant|configur)|(lifetime|expir|policy|add|update|create|grant|configur).*(token|oauth|refresh|session|consent|credential|secret|certificate)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1550.001")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $source_ips = array_distinct($cloud.principal.ip)
    $changed_settings = array_distinct($cloud.metadata.product_event_type)
    $target_resources = array_distinct($cloud.target.resource.name)

  condition:
    $cloud
}
