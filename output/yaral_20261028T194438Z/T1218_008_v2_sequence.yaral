/*
  MITRE Technique : T1218.008 - Odbcconf
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:51:24.521488+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_008_Odbcconf_Launch_Then_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects odbcconf.exe executing with action or response-file switches and then making an outbound connection to a non-internal address from the same host within ten minutes. This indicates proxy execution of a DLL or payload that reaches out to external infrastructure. The network leg is the key signal, because legitimate ODBC driver configuration does not normally contact the internet."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.008"
    mitre_technique_name = "System Binary Proxy Execution: Odbcconf"
    log_prerequisites = "Requires EDR or Sysmon process-launch telemetry (Sysmon EID 1) and network-connection telemetry with process attribution (Sysmon EID 3), both normalised to UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Database or application installers that configure ODBC drivers and fetch components or licences online, RMM or software deployment tooling that scripts odbcconf and downloads packages, and developers testing ODBC data sources against cloud-hosted databases."
    tuning_guidance = "Add approved deployment or installer parents to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. If a client legitimately uses odbcconf against external database endpoints, scope the exclusion to the specific parent process or service account rather than disabling the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\odbcconf\.exe$/ nocase
    $proc.target.process.command_line = /(\s|^)[\/-](a|f|s)(\s|$)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\odbcconf\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    $net.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1218.008")
    $primary_entity = array_distinct($hostname)
    $odbcconf_command_lines = array_distinct($proc.target.process.command_line)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $connection_count = count($net.metadata.id)

  condition:
    $proc and $net
}
