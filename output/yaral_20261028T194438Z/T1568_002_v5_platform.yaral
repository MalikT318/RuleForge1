/*
  MITRE Technique : T1568.002 - Domain Generation Algorithms
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:06:55.795643+00:00
  Reference       : https://attack.mitre.org/techniques/T1568/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1568_002_Windows_DGA_Like_DNS_Query_From_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows endpoint process resolving a DGA-like domain: a long, random-looking second-level label containing a run of five or more consecutive consonants. This uses endpoint DNS telemetry rather than process command lines, so it covers the DGA lookup itself even when the malware is injected, renamed or fileless. Browsers, security tools and known-good domains are excluded."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1568.002"
    mitre_technique_name = "Dynamic Resolution: Domain Generation Algorithms"
    log_prerequisites = "Requires endpoint DNS query telemetry with the originating process populated (for example Sysmon DNS query events or EDR DNS events) normalised to NETWORK_DNS."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software update and telemetry services using hashed or random subdomains or SLDs, CDN and cloud storage endpoints, anti-spam and reputation lookups, developer tooling, and non-English words transliterated with consonant clusters."
    tuning_guidance = "Add known-good domains to %global_allowed_domains and EDR/AV agents to %global_allowed_security_tools. Add approved scripted or management hosts to %global_allowed_script_hosts or %global_allowed_admin_tools. The browser exclusion is by executable name, so extend the regex for other approved user-agent processes. Raise the label length (12) or the consonant run (5) to reduce noise, or lower them for more sensitivity. Pair with a threshold rule on NXDOMAIN volume where the DNS logs include response codes."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.principal.process.file.full_path = /^[a-z]:\\/ nocase
    $dns.network.dns.questions.name = /^([a-z0-9-]+\.)*[a-z0-9]{12,}\.[a-z]{2,}$/ nocase
    $dns.network.dns.questions.name = /(^|\.)[a-z0-9]*[bcdfghjklmnpqrstvwxz]{5,}[a-z0-9]*\.[a-z]{2,}$/ nocase
    not $dns.network.dns.questions.name = /\.(local|lan|internal|arpa|corp|home|localdomain)$/ nocase
    not $dns.principal.process.file.full_path = /\\(chrome|msedge|firefox|brave|iexplore|opera|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.process.file.full_path in %global_allowed_security_tools
    not $dns.principal.process.file.full_path in %global_allowed_admin_tools
    not $dns.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1568.002")
    $primary_entity = array_distinct($dns.principal.hostname)
    $queried_domains = array_distinct($dns.network.dns.questions.name)
    $source_process = array_distinct($dns.principal.process.file.full_path)
    $source_user = array_distinct($dns.principal.user.userid)

  condition:
    $dns
}
