/*
  MITRE Technique : T1558.001 - Golden Ticket
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:40:07.625853+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_001_Kerberos_KDC_Contact_External_Address {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows endpoint opening a Kerberos (TCP/UDP 88) connection to a non-internal address. Legitimate KDCs are domain controllers on internal address space, so Kerberos traffic leaving the internal range suggests a forged-ticket (golden ticket) workflow. Examples include an attacker tunnelling KDC traffic through a pivot or an off-domain host requesting service tickets with forged TGT material. It can also indicate a rogue KDC or Kerberos proxy. Network-side complement to endpoint-based golden ticket detections."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.001"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Golden Ticket"
    log_prerequisites = "Requires Windows endpoint network telemetry (EDR or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION with target.port and target.ip populated. Populate %rfc1918_internal with the full internal address space of the client."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Cross-realm or forest trusts reachable over public or NATed addresses, domain controllers hosted in cloud or colocation networks addressed outside the internal list, Azure AD Domain Services over VPN, MIT Kerberos or WSL clients, vulnerability scanners and authorised Kerberos testing."
    tuning_guidance = "Add all legitimate internal and routed address space to %rfc1918_internal. Add known-good KDC hostnames of trusted partner realms to %global_allowed_domains. Add EDR or security agent binaries to %global_allowed_security_tools. Add approved scanner and testing hosts to %global_allowed_scanners."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 88
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1558.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_user = array_distinct($net.principal.user.userid)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $kdc_target_ip = array_distinct($net.target.ip)

  condition:
    $net
}
