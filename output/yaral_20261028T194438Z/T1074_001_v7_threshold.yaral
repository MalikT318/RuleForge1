/*
  MITRE Technique : T1074.001 - Local Data Staging
  Tactic(s)       : Collection
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:19:36.210402+00:00
  Reference       : https://attack.mitre.org/techniques/T1074/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_001_ESXi_Local_Data_Staging_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated use of copy, move, archive or imaging commands on an ESXi host that write into world-writable or volatile staging locations (/tmp, /var/tmp, /scratch, /dev/shm) within ten minutes. Each command is benign alone. A burst on one host indicates data being collected and consolidated before exfiltration."
    mitre_tactic = "Collection"
    mitre_technique = "T1074.001"
    mitre_technique_name = "Data Staged: Local Data Staging"
    log_prerequisites = "ESXi shell command auditing (shell.log or an equivalent) forwarded and normalised to UDM PROCESS_LAUNCH with target.process.command_line and principal.hostname populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators collecting support bundles or logs, patching and upgrade scripts, host profile and configuration backup jobs, VM migration or cloning scripts, and backup agents that stage data in /scratch or /tmp."
    tuning_guidance = "Add approved admin tooling to %global_allowed_admin_tools, backup software to %global_allowed_backup_processes, and automation accounts to %global_allowed_service_accounts. Raise the #proc threshold on hosts with heavy scripted maintenance. Lower it to 3 on hosts that should never be touched interactively."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(^|\/|\s)(tar|cp|mv|gzip|bzip2|zip|dd|vmkfstools)\s/ nocase
    $proc.target.process.command_line = /(\s|=)(\/tmp|\/var\/tmp|\/scratch|\/dev\/shm)(\/|\s|$)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1074.001")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 5
}
