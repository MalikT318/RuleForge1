/*
  MITRE Technique : T1092 - Communication Through Removable Media
  Tactic(s)       : Command and Control
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:37:04.305169+00:00
  Reference       : https://attack.mitre.org/techniques/T1092
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1092_Removable_Media_Staged_File_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of script, command or data-type file creations on non-system drive letters (a typical mount point for removable media) by one host within ten minutes. This can indicate command or data files being staged on removable media to relay instructions between an air-gapped host and an Internet-connected host (T1092). A single file write is benign; the volume is the signal."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1092"
    mitre_technique_name = "Communication Through Removable Media"
    log_prerequisites = "Requires EDR or Sysmon-equivalent file creation telemetry (FILE_CREATION) with populated principal.hostname, target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Users copying documents or scripts to USB drives, mapped network drives or secondary data volumes, software installers extracting to secondary disks, developers writing build output to a non-system drive, backup or imaging tools not yet in the allowlist."
    tuning_guidance = "Add backup agents to %global_allowed_backup_processes, deployment and RMM tooling to %global_allowed_admin_tools, and EDR/AV agents to %global_allowed_security_tools. Raise the #file threshold on hosts with a secondary data volume, such as file servers and build servers. If a client's system drive is not C:, adjust the drive-letter regex accordingly."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^[d-z]:\\/ nocase
    $file.target.file.full_path = /\.(bat|cmd|ps1|vbs|vbe|js|jse|wsf|hta|lnk|dll|dat|cfg|ini|txt|enc|bin|tmp)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|TiWorker|TrustedInstaller)\.exe$/ nocase

  match:
    $host over 10m

  outcome:
    $risk_score = max(55)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1092")
    $primary_entity = array_distinct($host)
    $writing_processes = array_distinct($file.principal.process.file.full_path)
    $sample_files = array_distinct($file.target.file.full_path)

  condition:
    #file >= 10
}
