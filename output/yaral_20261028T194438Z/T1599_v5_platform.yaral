/*
  MITRE Technique : T1599 - Network Boundary Bridging
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:00:30.998170+00:00
  Reference       : https://attack.mitre.org/techniques/T1599
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1599_Inbound_Session_To_Internal_Restricted_Services {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an established, bidirectional flow from an external source address to an internal host on a service port that perimeter policy normally blocks from untrusted networks (telnet, SMB, RPC, RDP, WinRM, SNMP, database). Return traffic means the session was permitted, which can indicate a compromised or reconfigured boundary device bridging the trust boundary."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1599"
    mitre_technique_name = "Network Boundary Bridging"
    log_prerequisites = "Firewall or perimeter flow logs normalised to UDM NETWORK_FLOW with principal.ip, target.ip, target.port and network.received_bytes populated. Logs must come from the device enforcing the boundary, and sessions must be logged at close or on interval so byte counters exist."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Intentionally published services (VPN-fronted or NAT-published management), partner or MSP access paths, authorised external vulnerability scans, and cloud-hosted monitoring probes reaching internal SNMP or database ports. Asymmetric logging can also produce spurious return bytes."
    tuning_guidance = "Add known-good external source addresses to %global_allowed_mgmt_sources and authorised scanners to %global_allowed_scanners. Adjust the port list if a client legitimately exposes one of these services. If a client's logs do not populate network.received_bytes, tune or remove that condition and rely on the port and direction logic."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    not $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    (
      $net.target.port = 23 or
      $net.target.port = 135 or
      $net.target.port = 139 or
      $net.target.port = 161 or
      $net.target.port = 445 or
      $net.target.port = 1433 or
      $net.target.port = 3306 or
      $net.target.port = 3389 or
      $net.target.port = 5985 or
      $net.target.port = 5986
    )
    $net.network.received_bytes > 0
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1599")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
