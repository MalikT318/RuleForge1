/*
  MITRE Technique : T1018 - Remote System Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:29:04.355137+00:00
  Reference       : https://attack.mitre.org/techniques/T1018
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1018_Network_Device_Internal_Discovery_Protocol_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal source connecting to an internal destination on a service-discovery port (SNMP 161, NetBIOS name service 137, WS-Discovery 3702). These ports are used to enumerate hosts and network infrastructure, such as ARP/CDP/neighbor tables and device inventories, for lateral movement planning. The rule is based on perimeter and internal firewall telemetry. It does not rely on endpoint process data."
    mitre_tactic = "Discovery"
    mitre_technique = "T1018"
    mitre_technique_name = "Remote System Discovery"
    log_prerequisites = "Firewall or network perimeter connection logs that populate principal.ip, target.ip and target.port, with internal east-west traffic logged (not just internet-bound traffic). Populate %rfc1918_internal with the internal address strings for the client."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Network monitoring and NMS platforms polling SNMP, asset-inventory and CMDB discovery jobs, vulnerability scanners, legacy Windows hosts using NetBIOS name resolution, printer and IoT discovery via WS-Discovery, and admin jump hosts performing device audits."
    tuning_guidance = "Add monitoring, inventory and scanner source addresses to %global_allowed_scanners and %global_allowed_mgmt_sources. Add admin or service source identifiers to %global_allowed_admin_tools if they are logged in the source field. If NetBIOS or WS-Discovery is noisy, remove port 137 or 3702 from the rule. If the tenant has no east-west logging, the rule will not fire."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 161 or
      $net.target.port = 137 or
      $net.target.port = 3702
    )
    $net.principal.ip != ""
    $net.target.ip in %rfc1918_internal
    $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_admin_tools

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1018")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
