/*
  MITRE Technique : T1018 - Remote System Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:29:22.856444+00:00
  Reference       : https://attack.mitre.org/techniques/T1018
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1018_ESXi_Burst_Remote_System_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of network discovery activity on a single ESXi host within 10 minutes. The activity is ICMP/ARP/DNS probing tools and esxcli neighbour, connection or diag-ping queries. Any single probe is routine, but a repeated sweep from one host's shell suggests an adversary mapping reachable systems for lateral movement, for example before ransomware deployment."
    mitre_tactic = "Discovery"
    mitre_technique = "T1018"
    mitre_technique_name = "Remote System Discovery"
    log_prerequisites = "ESXi shell and hostd logs forwarded to Chronicle and parsed into UDM PROCESS_LAUNCH events with principal.hostname and target.process fields populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators troubleshooting vmkernel networking or storage connectivity, vmkping MTU checks after network changes, monitoring or automation scripts run from the host shell, and host deployment or patching workflows."
    tuning_guidance = "Add approved automation parent processes to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Raise the #proc threshold for noisy environments, or lower it for hosts that should never have interactive shell use."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $proc.target.process.file.full_path = /\/(ping|ping6|vmkping|arp|nslookup|traceroute|traceroute6)$/ nocase
      or
      (
        $proc.target.process.file.full_path = /\/esxcli$/ nocase
        and $proc.target.process.command_line = /network\s+(ip\s+(neighbor|connection)|diag\s+ping)/ nocase
      )
    )
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $command_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1018")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $tools = array_distinct($proc.target.process.file.full_path)

  condition:
    #proc >= 8
}
