/*
  MITRE Technique : T1098 - Account Manipulation
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:39:54.170904+00:00
  Reference       : https://attack.mitre.org/techniques/T1098
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_ESXi_Account_Change_Anomalous_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi local account, password or permission management utility spawned by an anomalous parent. Legitimate account changes come from an interactive shell, SSH session or the host management daemon. This rule fires when the parent runs from a writable staging location (/tmp, /var/tmp, /dev/shm, /scratch, /var/run or a datastore under /vmfs/volumes) or is a scripting or download utility. That lineage indicates a dropped script or implant creating accounts, resetting passwords or granting permissions for persistence."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098"
    mitre_technique_name = "Account Manipulation"
    log_prerequisites = "ESXi shell and process execution logging forwarded to Chronicle and parsed into UDM PROCESS_LAUNCH with populated principal.process.file.full_path (parent) and target.process.file.full_path (child). Requires hostd/shell auth log forwarding via syslog."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrator provisioning scripts run from /tmp or a datastore, configuration management or host-profile remediation scripts, lockdown-mode or break-glass automation, and vendor lifecycle or patching scripts that set service account passwords."
    tuning_guidance = "Add approved automation parents to %global_allowed_script_hosts or %global_allowed_admin_tools. Add named administrators to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. If datastore-hosted admin scripts are common, remove /vmfs/volumes from the parent path regex for that client."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(esxcli|vim-cmd|passwd|adduser|useradd|usermod|chpasswd|deluser|userdel)$/ nocase
    $proc.target.process.command_line = /(system\s+(account|permission)|vimsvc\/auth|permission_(add|set)|\bpasswd\b|adduser|useradd|usermod|chpasswd|deluser|userdel)/ nocase
    (
      $proc.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|scratch|var\/run|vmfs\/volumes)\// nocase or
      $proc.principal.process.file.full_path = /\/(python[0-9.]*|perl|wget|curl|nc|ncat|busybox)$/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1098")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
