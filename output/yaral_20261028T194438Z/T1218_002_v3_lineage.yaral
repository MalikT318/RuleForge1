/*
  MITRE Technique : T1218.002 - Control Panel
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:43:53.109975+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_002_ControlPanel_Unexpected_Parent_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects control.exe (Control Panel host) launched by a parent process that would not normally start it, such as an Office application, web server worker, database service, print spooler, WMI provider host or script host. Malicious CPL payloads are commonly proxied through control.exe from phishing documents, web shells and script droppers. Detection pivots on process lineage rather than command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.002"
    mitre_technique_name = "System Binary Proxy Execution: Control Panel"
    log_prerequisites = "Windows endpoint process-launch telemetry (EDR or Sysmon Event ID 1) populating both parent (principal.process) and child (target.process) executable paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office add-ins or macros that open Control Panel applets for legitimate configuration tasks, IT logon scripts run through wscript/cscript that open settings panels, helpdesk or RMM automation launching control.exe, and software installers that run through script hosts and open Control Panel items."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts and approved automation or RMM binaries to %global_allowed_admin_tools. Review the parent_process outcome to identify recurring benign parents per client before adding exclusions. Extend or trim the parent regex per client environment (for example add powershell or cmd where that is not baseline behaviour)."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\control\.exe$/ nocase
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|onenote|visio|w3wp|httpd|nginx|tomcat\d*|java|sqlservr|spoolsv|wscript|cscript|mshta|wmiprvse)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
