/*
  MITRE Technique : T1011.001 - Exfiltration Over Bluetooth
  Tactic(s)       : Exfiltration
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:22:06.187965+00:00
  Reference       : https://attack.mitre.org/techniques/T1011/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1011_001_Anomalous_Parent_Spawns_Bluetooth_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an unexpected parent process (Office application, web server, print spooler or database service) launching the Windows Bluetooth file transfer wizard, or launching a shell or script interpreter whose command line references Bluetooth or OBEX transfer APIs. Such lineage is not normal user behaviour and may indicate staged data exfiltration over a Bluetooth channel."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1011.001"
    mitre_technique_name = "Exfiltration Over Other Network Medium: Exfiltration Over Bluetooth"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and command line (EDR, Sysmon Event ID 1 or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros or add-ins from legitimate line-of-business workflows that pair or transfer to Bluetooth devices, hardware or peripheral management scripts launched by a database or web application, and IT diagnostic scripts that query Bluetooth radio state."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts and approved tooling to %global_allowed_admin_tools. Extend the parent regex with additional internal service host names where needed. If the estate has no Bluetooth hardware policy, consider raising severity."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|w3wp|httpd|nginx|tomcat\d*|spoolsv|sqlservr|mysqld|postgres)\.exe$/ nocase
    (
      $proc.target.process.file.full_path = /\\fsquirt\.exe$/ nocase
      or
      (
        $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
        and $proc.target.process.command_line = /(bluetooth|fsquirt|\bobex\b|bthprops|Windows\.Devices\.(Bluetooth|Radios)|BluetoothSetServiceState)/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1011.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
