/*
  MITRE Technique : T1207 - Rogue Domain Controller
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:14:47.295759+00:00
  Reference       : https://attack.mitre.org/techniques/T1207
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1207_Outbound_AD_Directory_RPC_To_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a perimeter connection from an internal source to a non-internal destination on Active Directory RPC endpoint mapper or LDAP/Global Catalog ports (135, 389, 636, 3268, 3269). DCShadow needs the rogue DC to be reachable by legitimate DCs for replication (RPC/DRSUAPI), and LDAP access to the Configuration partition. A DC or domain member reaching an external host on these ports can indicate replication with an attacker-hosted rogue DC or directory manipulation outside the trust boundary. Domain-controller traffic should not normally cross the perimeter."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1207"
    mitre_technique_name = "Rogue Domain Controller"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with populated principal.ip, target.ip and target.port. The %rfc1918_internal list must be populated for the tenant."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Cloud-hosted or hybrid directory services using LDAP/LDAPS (for example managed directory or LDAP-based SaaS integrations), legitimate DCs in a remote datacenter reached through a public address, third-party applications authenticating via LDAPS to a vendor, external vulnerability scanners and penetration tests, and misconfigured clients."
    tuning_guidance = "Add authorised scanners' and management hosts' source addresses to %global_allowed_mgmt_sources. Add known-good external directory service destinations to %global_allowed_domains. Review %rfc1918_internal for each client, since a missing private range, such as a site-to-site VPN subnet, will cause false positives. Port 389/636 may be dropped on tenants with heavy LDAP SaaS integrations while retaining 135 and 3268/3269."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 135 or
      $net.target.port = 389 or
      $net.target.port = 636 or
      $net.target.port = 3268 or
      $net.target.port = 3269
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1207")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
