/*
  MITRE Technique : T1546.013 - PowerShell Profile
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:19:31.882327+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_013_PowerShell_Profile_File_Written {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a PowerShell profile script (profile.ps1 or a host-specific *_profile.ps1) in a per-user, all-users or PowerShell 7 profile location. Windows only: the Linux/macOS/cloud pivot was not applied because the requirement fixes the platform to Windows. This is file-telemetry coverage that complements process/command-line rules. It catches the persistence artefact itself, regardless of which tool or process wrote the file."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.013"
    mitre_technique_name = "Event Triggered Execution: PowerShell Profile"
    log_prerequisites = "Requires EDR or Sysmon-equivalent file creation telemetry (Sysmon Event ID 11 or equivalent) with the writing process populated in principal.process."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or IT onboarding scripts that provision standard profiles; software installers that deploy PowerShell modules (posh-git, oh-my-posh, Azure/AWS tooling, Conda init); user profile roaming or migration tools; developers customising their own shell; golden-image and VDI build pipelines."
    tuning_guidance = "Add approved deployment, configuration-management and RMM binaries to %global_allowed_admin_tools. Add automation accounts that legitimately provision profiles to %global_allowed_service_accounts. Add endpoint security agents to %global_allowed_security_tools. For all-users profiles under the PowerShell install directory (an elevated-privilege path), consider raising severity. To also cover edits to existing profiles, clone this rule with metadata.event_type = FILE_MODIFICATION."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(windowspowershell(\\v1\.0)?|powershell(\\7)?)\\([a-z.]+_)?profile\.ps1$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546.013")
    $primary_entity = array_distinct($file.principal.hostname)
    $profile_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_command_line = array_distinct($file.principal.process.command_line)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
