/*
  MITRE Technique : T1667 - Email Bombing
  Tactic(s)       : Impact
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:09:50.373762+00:00
  Reference       : https://attack.mitre.org/techniques/T1667
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1667_Email_Bombing_Mailbox_Flood {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a single mailbox receiving an abnormally high volume of email transactions within ten minutes. Each message is benign on its own, but the volume is characteristic of email bombing, where an adversary subscribes a victim address to many mailing lists to bury security alerts or prepare a follow-up social-engineering call."
    mitre_tactic = "Impact"
    mitre_technique = "T1667"
    mitre_technique_name = "Email Bombing"
    log_prerequisites = "Requires Microsoft 365 or Google Workspace mail audit or message-trace logs normalized to UDM EMAIL_TRANSACTION, with the recipient mapped to target.user.userid."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate bulk mail to shared or distribution mailboxes (helpdesk, abuse, invoices), marketing or newsletter campaigns, ticketing and monitoring systems that send automated notifications, and internal mass communications."
    tuning_guidance = "Add automation and notification sender accounts to %global_allowed_service_accounts. Raise or lower the #mail threshold per client based on mailbox baselines, and consider a higher threshold for shared mailboxes. Scale severity in outcome for mailboxes belonging to executives or administrators."

  events:
    $mail.metadata.event_type = "EMAIL_TRANSACTION"
    $mail.target.user.userid != ""
    $mail.target.user.userid = $recipient
    not $mail.principal.user.userid in %global_allowed_service_accounts
    not $mail.target.user.userid in %global_allowed_service_accounts

  match:
    $recipient over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1667")
    $primary_entity = array_distinct($recipient)
    $email_count = count($mail.metadata.id)
    $distinct_senders = array_distinct($mail.principal.user.userid)
    $sender_hosts = array_distinct($mail.principal.hostname)

  condition:
    #mail >= 100
}
