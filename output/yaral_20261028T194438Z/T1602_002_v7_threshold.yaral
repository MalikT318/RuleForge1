/*
  MITRE Technique : T1602.002 - Network Device Configuration Dump
  Tactic(s)       : Collection
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:21:04.767514+00:00
  Reference       : https://attack.mitre.org/techniques/T1602/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_002_Network_Device_Mgmt_Protocol_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single source opens many connections within ten minutes to ports used to pull configuration from network devices: SNMP (161), TFTP (69) and Cisco Smart Install (4786). Each connection is benign on its own, but the volume suggests a configuration dump or enumeration sweep. Severity is scaled in outcome, with Smart Install scored highest because it is rarely used legitimately and is a known abuse path."
    mitre_tactic = "Collection"
    mitre_technique = "T1602.002"
    mitre_technique_name = "Data from Configuration Repository: Network Device Configuration Dump"
    log_prerequisites = "Firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Traffic to device management ports must traverse a logged inspection point."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Network monitoring and NMS polling (SNMP), configuration backup tools (TFTP), network provisioning and zero-touch deployment (Smart Install, TFTP), vulnerability scanners and authorised pentests, new device rollouts."
    tuning_guidance = "Add NMS, backup and provisioning server addresses to %global_allowed_mgmt_sources. Add scanner source addresses to %global_allowed_scanners. Raise the #net threshold (default 10) in environments with heavy legitimate SNMP polling, or lower it where management traffic is normally rare."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 161 or
      $net.target.port = 69 or
      $net.target.port = 4786
    )
    $net.principal.ip = $src_ip
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(if($net.target.port = 4786, 90, if($net.target.port = 69, 80, 65)))
    $mitre_technique_id = array_distinct("T1602.002")
    $primary_entity = array_distinct($src_ip)
    $event_count = count($net.metadata.id)
    $targeted_devices = array_distinct($net.target.ip)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    #net >= 10
}
