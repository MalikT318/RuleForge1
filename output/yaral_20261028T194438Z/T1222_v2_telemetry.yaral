/*
  MITRE Technique : T1222 - File and Directory Permissions Modification
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:15:57.565071+00:00
  Reference       : https://attack.mitre.org/techniques/T1222
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_ESXi_Host_Permission_Change_Setting {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a host-level permission or role assignment change recorded as a configuration change in ESXi management-plane logs (hostd). This is the resulting access-control state change, so it fires even when command-line logging is evaded or the change is made through the API or host client. Adversaries use it to grant themselves or another account rights over datastores, VMs, or host configuration."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1222"
    mitre_technique_name = "File and Directory Permissions Modification"
    log_prerequisites = "ESXi hostd logs forwarded to Chronicle and parsed into UDM SETTING_MODIFICATION events, with the audit message text populated in metadata.description and the acting account in principal.user.userid."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Planned onboarding or offboarding of administrators, host-profile or automation remediation that reapplies permissions, backup or monitoring service accounts being granted read-only or datastore roles, and routine lockdown-mode exception user changes during maintenance."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation or provisioning accounts to %global_allowed_service_accounts. If the parser places the audit text in a different field, adjust the metadata.description match. Consider suppressing during approved change windows."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.description = /(?i)(permissions?\s+(rule\s+)?(added|created|updated|changed|modified|assigned|removed|deleted)|(add|set|update|remove|reset)(Entity)?Permissions?|role\s+(assigned|changed|updated|modified)|(entity|datastore|folder)\s+permissions?\s+(changed|modified))/
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1222")
    $primary_entity = array_distinct($setting.principal.hostname)
    $acting_user = array_distinct($setting.principal.user.userid)
    $change_detail = array_distinct($setting.metadata.description)
    $source_ip = array_distinct($setting.principal.ip)

  condition:
    $setting
}
