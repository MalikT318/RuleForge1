/*
  MITRE Technique : T1021.001 - Remote Desktop Protocol
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:34:21.726905+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_001_RDP_Enablement_Registry_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry changes that enable inbound Remote Desktop or weaken its authentication. This covers fDenyTSConnections under the Terminal Server key, and UserAuthentication (NLA) or SecurityLayer under the RDP-Tcp WinStation key. Attackers make these changes to open an RDP path for lateral movement with valid accounts. The rule works on the resulting state change, so it fires whether the change came from reg.exe, PowerShell, WMI, a script or a custom tool, and it does not depend on command-line logging."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.001"
    mitre_technique_name = "Remote Services: Remote Desktop Protocol"
    log_prerequisites = "Requires Windows registry modification telemetry from an EDR or Sysmon (Event ID 12/13), with registry key and value name populated in UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy applying RDP settings, IT provisioning or golden-image build scripts, RMM and remote support tooling enabling RDP, administrators enabling RDP on servers, and Windows feature or role installation. The rule also matches writes that set fDenyTSConnections back to 1 (RDP disabled), because registry value data is not used as core logic."
    tuning_guidance = "Add approved deployment or RMM binaries to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. If registry_value_data is reliably populated for the client, add a condition so that fDenyTSConnections only matches the value 0. Consider scoping or raising severity for servers and workstations that should never accept RDP."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      (
        $reg.target.registry.registry_key = /\\SYSTEM\\(CurrentControlSet|ControlSet\d+)\\Control\\Terminal Server$/ nocase
        $reg.target.registry.registry_value_name = /^fDenyTSConnections$/ nocase
      )
      or
      (
        $reg.target.registry.registry_key = /\\SYSTEM\\(CurrentControlSet|ControlSet\d+)\\Control\\Terminal Server\\WinStations\\RDP-Tcp$/ nocase
        $reg.target.registry.registry_value_name = /^(UserAuthentication|SecurityLayer)$/ nocase
      )
    )
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1021.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_name)
    $actor_process = array_distinct($reg.principal.process.file.full_path)
    $actor_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
