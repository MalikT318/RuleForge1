/*
  MITRE Technique : T1016.001 - Internet Connection Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:45:11.833478+00:00
  Reference       : https://attack.mitre.org/techniques/T1016/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_001_ESXi_Shell_Login_Then_Connectivity_Check {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A remote SSH login to an ESXi host is followed within 10 minutes by launch of a connectivity-testing utility (ping, vmkping, traceroute, wget, curl, or esxcli network diag ping) on the same host. Hypervisors have no business reaching the Internet, so this pairing suggests an adversary with a fresh shell checking outbound reachability before staging C2 or tooling. The login context is what makes this additive to command-line-only coverage."
    mitre_tactic = "Discovery"
    mitre_technique = "T1016.001"
    mitre_technique_name = "System Network Configuration Discovery: Internet Connection Discovery"
    log_prerequisites = "ESXi authentication logs (hostd/SSH) and shell/process execution logs forwarded to Chronicle, with both parsed into UDM and carrying the same principal.hostname. Process telemetry depends on shell logging being forwarded to syslog."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators testing network or NTP/DNS reachability after maintenance, vmkping used to validate vMotion/vSAN/NFS VMkernel connectivity, patching or VIB downloads via wget/curl, monitoring or automation scripts that log in over SSH, and vendor support sessions."
    tuning_guidance = "Add admin accounts to %global_allowed_admin_users, approved jump hosts to %global_allowed_mgmt_sources, and approved tooling or automation parents to %global_allowed_admin_tools. If SSH logins are parsed without network.application_protocol, remove that filter and rely on the allowlists. Consider removing vmkping if storage/network teams use it routinely."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.network.application_protocol = "SSH"
    $auth.principal.hostname = $hostname
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.principal.ip in %global_allowed_mgmt_sources

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $proc.target.process.file.full_path = /\/(ping|ping6|vmkping|traceroute|traceroute6|wget|curl)$/ nocase
      or (
        $proc.target.process.file.full_path = /\/esxcli$/ nocase
        and $proc.target.process.command_line = /network\s+diag\s+ping/ nocase
      )
    )
    $proc.principal.hostname = $hostname
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    $auth.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1016.001")
    $primary_entity = array_distinct($hostname)
    $login_users = array_distinct($auth.target.user.userid)
    $login_source_ips = array_distinct($auth.principal.ip)
    $tools_launched = array_distinct($proc.target.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)
    $tool_launch_count = count($proc.metadata.id)

  condition:
    $auth and $proc
}
