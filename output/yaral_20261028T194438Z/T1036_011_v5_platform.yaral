/*
  MITRE Technique : T1036.011 - Overwrite Process Arguments
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:15:20.918660+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_011_Linux_Proc_Mem_Write_Argv_Overwrite {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process writing to a /proc/<pid>/mem pseudo-file, the user-space route to overwrite another process's (or its own) argv memory region and spoof the name shown in /proc/<pid>/cmdline and ps. This covers T1036.011 through file-modification telemetry on the /proc interface and does not depend on process-launch command-line matching. Debuggers, crash handlers and approved security or admin tooling are excluded."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.011"
    mitre_technique_name = "Masquerading: Overwrite Process Arguments"
    log_prerequisites = "Requires Linux file-write telemetry covering the /proc filesystem, from an EDR sensor with file-modification events or auditd watch rules on writes to /proc/*/mem. Many default sensor and auditd configurations do not report /proc writes, so confirm that coverage before deployment."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Debuggers and tracers (gdb, lldb, rr, strace), crash-dump and checkpoint/restore tools (criu), live-patching and APM or profiler agents that write to process memory, and developer workstations running memory-instrumentation tools."
    tuning_guidance = "Add approved agents and profilers to %global_allowed_security_tools or %global_allowed_admin_tools. Extend the debugger executable-name regex for tooling specific to the environment. Prioritise hits where the writing process runs from /tmp, /dev/shm, /var/tmp or a hidden directory, and where the process then shows a cmdline that differs from its executable. On developer fleets, consider routing the alert to a lower-severity queue."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/proc\/(self|[0-9]+)(\/task\/[0-9]+)?\/mem$/
    $file.principal.process.file.full_path != ""
    not $file.principal.process.file.full_path = /\/(gdb|gdbserver|lldb|lldb-server|rr|strace|ltrace|criu|perf|dlv)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1036.011")
    $primary_entity = array_distinct($file.principal.hostname)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)
    $target_proc_file = array_distinct($file.target.file.full_path)

  condition:
    $file
}
