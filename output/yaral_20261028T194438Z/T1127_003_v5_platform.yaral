/*
  MITRE Technique : T1127.003 - JamPlus
  Tactic(s)       : Stealth, Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:41:08.763148+00:00
  Reference       : https://attack.mitre.org/techniques/T1127/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1127_003_JamPlus_Jam_File_Dropped_By_Delivery_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a JamPlus build script (.jam) in a user-writable location by a delivery-type process (browser, mail client, Office, archiver, Explorer extraction, script host, or download utility). Legitimate .jam files normally come from source control or an IDE, not from these processes in Downloads, Desktop, AppData, ProgramData, or Temp. This is file-creation coverage that complements existing process-launch command-line detections, so it fires before JamPlus runs and whatever the binary is named. JamPlus is Windows-only, so the Linux, macOS and cloud pivot is not applicable and this rule targets Windows."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1127.003"
    mitre_technique_name = "Trusted Developer Utilities Proxy Execution: JamPlus"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry with populated target.file.full_path and the creating process path (EDR file events or Sysmon Event ID 11)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developers or game-build engineers downloading or extracting JamPlus projects from a browser or archive; build engineers pulling samples via curl or PowerShell; software packages that ship .jam files and are unpacked by Explorer or an archiver on developer workstations."
    tuning_guidance = "Add approved developer tooling or build-agent processes to %global_allowed_admin_tools and approved automation hosts to %global_allowed_script_hosts. On developer or build-engineering hosts, scope the rule down or lower its severity. Extend the delivery-process regex if clients use other browsers or archivers."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\[^\\]+\\(downloads|desktop|documents|appdata)|users\\public|programdata|windows\\temp)\\.*\.jam$/ nocase
    $file.principal.process.file.full_path = /\\(chrome|msedge|firefox|brave|opera|outlook|olk|winword|excel|powerpnt|7z|7zg|7zfm|winrar|explorer|powershell|pwsh|cmd|wscript|cscript|mshta|curl|bitsadmin|certutil)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1127.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $jam_file_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
