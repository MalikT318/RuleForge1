/*
  MITRE Technique : T1003.002 - Security Account Manager
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:40:21.524112+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_002_SAM_Hive_Repeated_Read_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Multiple reads of the SAM, SYSTEM or SECURITY registry hive files (live config directory, repair directory, or volume shadow copy paths) by a non-allowlisted process on a single host within 10 minutes. A single hive access can be benign, but repeated access is characteristic of offline credential extraction (reg save, shadow-copy copy, or in-memory dumpers reading hive files)."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.002"
    mitre_technique_name = "OS Credential Dumping: Security Account Manager"
    log_prerequisites = "Requires Windows endpoint telemetry that records file read or access events against system files (EDR file-access telemetry or Sysmon-equivalent) normalized to UDM FILE_READ."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and imaging agents, EDR/AV scanners, forensic or IR collection tooling, system recovery utilities, and Windows servicing processes touching the config directory."
    tuning_guidance = "Add backup agents to %global_allowed_backup_processes, EDR/AV agents to %global_allowed_security_tools, and IT/IR tooling to %global_allowed_admin_tools. Raise the #file threshold on hosts where backup or imaging software is unmanaged. Add maintenance service accounts to %global_allowed_service_accounts."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /\\(system32\\config|windows\\repair)\\(sam|system|security)(\.(save|bak|old))?$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|vssvc|TiWorker|TrustedInstaller|lsass)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($file.target.file.full_path = /\\sam(\.(save|bak|old))?$/ nocase, 90, 70))
    $mitre_technique_id = array_distinct("T1003.002")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $hive_paths = array_distinct($file.target.file.full_path)
    $reading_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
