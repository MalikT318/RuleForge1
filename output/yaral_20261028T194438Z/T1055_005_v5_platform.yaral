/*
  MITRE Technique : T1055.005 - Thread Local Storage
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:53:24.477852+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_005_Remote_Process_Injection_From_UserWritable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process running from a user-writable location injecting code into a different process. This is the memory-write and thread-manipulation stage of TLS callback injection and related techniques such as process hollowing. It uses PROCESS_INJECTION telemetry, not process-launch command lines. T1055.005 is Windows-only, so the requested non-Windows platform pivot is not applicable and this variant covers the Windows injection API layer instead."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.005"
    mitre_technique_name = "Process Injection: Thread Local Storage"
    log_prerequisites = "Requires endpoint telemetry that reports cross-process memory write or remote thread events and normalises them to PROCESS_INJECTION (EDR or Sysmon event IDs 8 and 25 equivalents)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Game anti-cheat and overlay software, accessibility tools, user-installed application updaters running from AppData, per-user installed security or DLP agents, debuggers and developer tooling."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools, backup and imaging agents to %global_allowed_backup_processes, and IT or deployment tools to %global_allowed_admin_tools. Review recurring injector paths per client and allowlist by executable name, not by directory."

  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.process.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop)|programdata|windows\\temp|users\\public)\\/ nocase
    $inj.target.process.file.full_path != ""
    $inj.principal.process.file.full_path != $inj.target.process.file.full_path
    not $inj.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.005")
    $primary_entity = array_distinct($inj.principal.hostname)
    $injector_path = array_distinct($inj.principal.process.file.full_path)
    $victim_path = array_distinct($inj.target.process.file.full_path)
    $injecting_user = array_distinct($inj.principal.user.userid)

  condition:
    $inj
}
