/*
  MITRE Technique : T1187 - Forced Authentication
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:33:04.530773+00:00
  Reference       : https://attack.mitre.org/techniques/T1187
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1187_Outbound_SMB_To_External_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an internal Windows host opening an SMB/NetBIOS session (TCP 445 or 139) to an external, non-internal address as seen at the network perimeter. Windows automatically sends NTLM credential material when it connects to an SMB resource, so outbound SMB to the internet is the characteristic network signature of forced authentication (for example UNC links in phishing documents, template injection, or crafted shortcut/icon files). Perimeter policy normally blocks this traffic, so any permitted or logged attempt is high-signal."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1187"
    mitre_technique_name = "Forced Authentication"
    log_prerequisites = "Requires firewall or network perimeter logs normalised to UDM NETWORK_CONNECTION with populated principal.ip, target.ip and target.port. Egress logging must include blocked and allowed connections, because the attempt itself is the detection."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "SMB over the internet to cloud file services (for example Azure Files), site-to-site or VPN-tunnelled traffic logged with public addresses, branch offices reaching file servers over public IPs, authorised external vulnerability scanners and penetration tests, and misrouted traffic from NAT or hairpin configurations."
    tuning_guidance = "Add known-good external SMB endpoints (for example cloud storage account FQDNs) to %global_allowed_domains. Add authorised scanner or testing hosts to %global_allowed_scanners. Confirm %rfc1918_internal covers all client internal and VPN address space. Raise severity where egress SMB is explicitly blocked by policy but the host keeps attempting connections."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 445 or $net.target.port = 139)
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1187")
    $primary_entity = array_distinct($net.principal.ip)
    $source_hostname = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
