/*
  MITRE Technique : T1573 - Encrypted Channel
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:21:18.932681+00:00
  Reference       : https://attack.mitre.org/techniques/T1573
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1573_Encrypted_Channel_TLS_NonStandard_Port_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Perimeter telemetry shows an outbound connection to an external address that the firewall classifies as TLS/HTTPS-encrypted web traffic but which uses a destination port other than the standard HTTPS ports. Adversaries often run encrypted C2 channels over non-standard ports to avoid port-based proxy and inspection policy. This is a network-side detection that does not depend on endpoint process or command-line data."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1573"
    mitre_technique_name = "Encrypted Channel"
    log_prerequisites = "Firewall or perimeter logs with application identification (network.application_protocol) and traffic direction populated, normalised to UDM NETWORK_CONNECTION. Requires the firewall to perform application-layer classification (App-ID or equivalent)."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate SaaS, VPN, or vendor services that serve HTTPS on alternate ports (e.g. management consoles, custom APIs, development servers); remote support tools; security scanners. Firewalls that mislabel traffic as HTTPS will also produce noise."
    tuning_guidance = "Add known-good destination domains to %global_allowed_domains, authorised scanner or management source addresses to %global_allowed_mgmt_sources, and approved remote support sources to %global_allowed_remote_mgmt. Extend the port exclusions with customer-specific approved HTTPS ports if needed. Consider raising severity when the same source repeatedly reaches the same external IP."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.application_protocol = "HTTPS"
    $net.network.direction = "OUTBOUND"
    $net.target.port > 0
    $net.target.port != 443
    $net.target.port != 8443
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1573")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
