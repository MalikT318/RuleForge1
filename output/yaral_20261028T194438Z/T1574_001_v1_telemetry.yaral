/*
  MITRE Technique : T1574.001 - DLL
  Tactic(s)       : Stealth, Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:28:11.742761+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_001_DLL_Planted_In_System_Directory {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a DLL file directly inside the Windows System32 or SysWOW64 directory by a process that is not a recognised OS servicing or installer component. Planting a DLL here is the file-system result of phantom DLL hijacking and search-order hijacking: a malicious library is placed where a trusted binary will load it. The rule is based on the resulting file artifact, not on command lines, so it still fires when the dropper is renamed or its command line is hidden."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.001"
    mitre_technique_name = "Hijack Execution Flow: DLL"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) that populates the creating process path and the target file path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Third-party software installers and updaters that write shared runtime DLLs into System32 or SysWOW64. Driver and hardware vendor setup utilities. OS feature-on-demand or servicing components not covered by the built-in executable-name exclusion. Software deployment and patching agents. Legitimate svchost-hosted update activity is not excluded by default, so it may surface in some environments."
    tuning_guidance = "Add approved deployment and patching binaries to %global_allowed_admin_tools and endpoint protection agents to %global_allowed_security_tools. Extend the servicing-component exclusion regex only after confirming the process by name and signer. Tune by executable name, not install directory."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^[a-z]:\\windows\\(system32|syswow64)\\[^\\]+\.dll$/ nocase
    $file.principal.process.file.full_path != ""
    not $file.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|msiexec|wusa|dism|DismHost|SetupHost|MoUsoCoreWorker|wuauclt|usoclient|poqexec|MsMpEng|MpCmdRun|MsSense|SenseIR)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1574.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_dll_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $creating_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
