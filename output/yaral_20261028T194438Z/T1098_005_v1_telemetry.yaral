/*
  MITRE Technique : T1098.005 - Device Registration
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:46:44.784544+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_005_IdP_MFA_Device_Registration_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a configuration change in the identity provider audit trail that registers, enrolls or activates an MFA factor, authenticator or device against an account. This is the state change an adversary produces when using stolen credentials to enroll an attacker-controlled device for persistence or to bypass MFA and conditional access. It works at the control-plane setting layer, not the process or command-line layer."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.005"
    mitre_technique_name = "Account Manipulation: Device Registration"
    log_prerequisites = "Requires identity provider directory/audit logs (MFA factor, authentication method and device registration events) ingested and normalised to UDM SETTING_MODIFICATION with metadata.product_event_type and principal.user.userid populated."
    platform = "Identity Provider"
    log_source = "cloud_audit"
    false_positives = "Legitimate user self-service MFA enrollment (new hire onboarding, phone replacement), helpdesk-assisted enrollment, bulk MFA rollout or migration projects, device provisioning and autopilot/MDM enrollment workflows, and automation accounts that provision authenticators."
    tuning_guidance = "Add helpdesk and onboarding administrators to %global_allowed_admin_users, provisioning automation to %global_allowed_service_accounts, and approved identity automation principals to %global_allowed_cloud_principals. If your identity provider normalises enrollment to a different event type, deploy a sibling rule for that type. During planned MFA rollouts, raise the severity only when combined with risky sign-in context."

  events:
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.metadata.product_event_type = /(register|enroll|activate|add|create).*(device|factor|authenticator|mfa|security.?info|auth.?method)|(device|factor|authenticator|mfa|security.?info|auth.?method).*(register|enroll|activate|add|create)/ nocase
    not $cfg.metadata.product_event_type = /(deactivat|delet|remov|unenroll|disable|reset|revoke)/ nocase
    $cfg.principal.user.userid != ""
    not $cfg.principal.user.userid in %global_allowed_admin_users
    not $cfg.principal.user.userid in %global_allowed_service_accounts
    not $cfg.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1098.005")
    $primary_entity = array_distinct($cfg.principal.user.userid)
    $event_names = array_distinct($cfg.metadata.product_event_type)
    $source_ips = array_distinct($cfg.principal.ip)
    $target_users = array_distinct($cfg.target.user.userid)

  condition:
    $cfg
}
