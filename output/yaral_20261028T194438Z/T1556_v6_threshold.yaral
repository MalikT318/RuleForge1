/*
  MITRE Technique : T1556 - Modify Authentication Process
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:13:53.956121+00:00
  Reference       : https://attack.mitre.org/techniques/T1556
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_SaaS_Auth_Config_Change_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single user made several modifications to authentication-related settings (MFA, SSO/federation, conditional access, password or authentication policy, trusted locations) within ten minutes. One change is routine administration. A burst can mean an adversary is weakening or bypassing authentication controls for persistence or credential access."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556"
    mitre_technique_name = "Modify Authentication Process"
    log_prerequisites = "SaaS or identity audit logs normalised to UDM SETTING_MODIFICATION, with target.resource.name or metadata.product_event_type populated with the setting or operation name and principal.user.userid populated."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Planned identity migrations, SSO or federation onboarding projects, scheduled MFA rollouts, bulk policy clean-up by administrators, IaC or identity-governance automation applying authentication settings."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users, automation identities to %global_allowed_service_accounts, and approved integration principals to %global_allowed_cloud_principals. Raise the #auth threshold for tenants with frequent bulk changes. Narrow the regex if a SaaS app uses overly generic setting names."

  events:
    $auth.metadata.event_type = "SETTING_MODIFICATION"
    (
      $auth.target.resource.name = /(mfa|multi.?factor|two.?factor|2fa|sso|saml|federat|conditional.?access|authentication.?(policy|method|provider|setting)|password.?policy|identity.?provider|trusted.?(ip|location|network))/ nocase or
      $auth.metadata.product_event_type = /(mfa|multi.?factor|two.?factor|2fa|sso|saml|federat|conditional.?access|authentication.?(policy|method|provider|setting)|password.?policy|identity.?provider|trusted.?(ip|location|network))/ nocase
    )
    $auth.principal.user.userid = $user
    not $auth.principal.user.userid in %global_allowed_admin_users
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_cloud_principals

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($auth.metadata.id)
    $mitre_technique_id = array_distinct("T1556")
    $primary_entity = array_distinct($user)
    $changed_settings = array_distinct($auth.target.resource.name)
    $source_ips = array_distinct($auth.principal.ip)

  condition:
    #auth >= 3
}
