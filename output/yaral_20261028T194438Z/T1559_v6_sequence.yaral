/*
  MITRE Technique : T1559 - Inter-Process Communication
  Tactic(s)       : Execution
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:50:59.332214+00:00
  Reference       : https://attack.mitre.org/techniques/T1559
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_Linux_Named_Pipe_Then_Interactive_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a named pipe (FIFO) being created in a world-writable directory (/tmp, /var/tmp, /dev/shm) followed within 10 minutes by an interactive shell launched on the same host. This is the classic IPC-based reverse or bind shell pattern, where a FIFO is used to wire shell input and output to a network or relay process."
    mitre_tactic = "Execution"
    mitre_technique = "T1559"
    mitre_technique_name = "Inter-Process Communication"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry (execve) with full command lines, normalised to PROCESS_LAUNCH."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators or developers using mkfifo for legitimate inter-process testing, software build and test pipelines, installers and configuration management scripts that create FIFOs in /tmp, and troubleshooting sessions that open an interactive shell shortly afterwards."
    tuning_guidance = "Add approved tooling binaries to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and approved parent processes or hosts (CI runners, jump hosts) to %global_allowed_script_hosts. If the rule is noisy on build servers, scope those hosts out via %global_allowed_script_hosts."

  events:
    $mk.metadata.event_type = "PROCESS_LAUNCH"
    $mk.target.process.file.full_path = /\/(mkfifo|mknod)$/ nocase
    $mk.target.process.command_line = /(mkfifo\s|mknod\s.*\sp(\s|$))/ nocase
    $mk.target.process.command_line = /\/(tmp|var\/tmp|dev\/shm)\// nocase
    not $mk.principal.process.file.full_path in %global_allowed_admin_tools
    not $mk.principal.user.userid in %global_allowed_service_accounts
    $mk.principal.hostname = $hostname

    $sh.metadata.event_type = "PROCESS_LAUNCH"
    $sh.target.process.file.full_path = /\/(ba|da|z|k|a)?sh$/ nocase
    $sh.target.process.command_line = /(^|\s|\/)(ba|da|z|k|a)?sh\s+(-[a-z]*i[a-z]*)(\s|$)/ nocase
    not $sh.principal.process.file.full_path in %global_allowed_script_hosts
    not $sh.principal.process.file.full_path in %global_allowed_admin_tools
    not $sh.principal.user.userid in %global_allowed_service_accounts
    $sh.principal.hostname = $hostname

    $mk.metadata.event_timestamp.seconds <= $sh.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1559")
    $primary_entity = array_distinct($hostname)
    $fifo_commands = array_distinct($mk.target.process.command_line)
    $shell_commands = array_distinct($sh.target.process.command_line)
    $shell_parents = array_distinct($sh.principal.process.file.full_path)
    $users = array_distinct($sh.principal.user.userid)

  condition:
    $mk and $sh
}
