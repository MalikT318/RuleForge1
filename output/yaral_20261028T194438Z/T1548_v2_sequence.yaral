/*
  MITRE Technique : T1548 - Abuse Elevation Control Mechanism
  Tactic(s)       : Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:26:49.058636+00:00
  Reference       : https://attack.mitre.org/techniques/T1548
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_Privileged_Group_Add_Then_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an account being added to a highly privileged directory group by a non-approved actor, followed within 10 minutes by a login from the same account. This pattern indicates elevation control being abused through directory changes, with the new privileges used immediately."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548"
    mitre_technique_name = "Abuse Elevation Control Mechanism"
    log_prerequisites = "Requires directory audit logs that normalise group membership changes to GROUP_MODIFICATION (with target.group.group_display_name and target.user.userid populated) and authentication logs normalised to USER_LOGIN with target.user.userid."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Planned onboarding of new administrators, helpdesk or break-glass procedures, privileged access management tools that grant temporary membership, and migration projects."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and automation or PAM accounts to %global_allowed_service_accounts. Adjust the privileged group regex to match local naming conventions. Shorten the window or require a non-internal login source if volumes are high."

  events:
    $grp.metadata.event_type = "GROUP_MODIFICATION"
    $grp.target.group.group_display_name = /(domain admins|enterprise admins|schema admins|administrators|account operators|backup operators|server operators|dnsadmins|group policy creator owners)/ nocase
    $grp.target.user.userid != ""
    not $grp.principal.user.userid in %global_allowed_admin_users
    not $grp.principal.user.userid in %global_allowed_service_accounts
    not $grp.target.user.userid in %global_allowed_service_accounts
    $grp.target.user.userid = $user

    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.user.userid != ""
    not $auth.target.user.userid in %global_allowed_service_accounts
    $auth.target.user.userid = $user

    $grp.metadata.event_timestamp.seconds <= $auth.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1548")
    $primary_entity = array_distinct($user)
    $privileged_groups = array_distinct($grp.target.group.group_display_name)
    $modifying_actors = array_distinct($grp.principal.user.userid)
    $login_hosts = array_distinct($auth.principal.hostname)
    $login_count = count($auth.metadata.id)

  condition:
    $grp and $auth
}
