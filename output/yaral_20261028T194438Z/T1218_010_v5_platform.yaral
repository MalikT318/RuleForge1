/*
  MITRE Technique : T1218.010 - Regsvr32
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:55:24.082289+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_010_Regsvr32_COM_Registration_UserWritable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects regsvr32.exe writing a COM server registration (InprocServer32 or LocalServer32) whose target is a DLL in a user-writable location or on a remote share/URL. This is a registry-based view of Regsvr32 proxy execution and COM persistence. It does not depend on command-line matching and still fires when regsvr32.exe is renamed or copied, because it keys on the registry write itself."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.010"
    mitre_technique_name = "System Binary Proxy Execution: Regsvr32"
    log_prerequisites = "Requires endpoint registry telemetry with the writing process and registry value data populated (EDR or Sysmon Event ID 12/13)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-user installers and updaters that register COM components from AppData or ProgramData (collaboration clients, browser plug-ins, Office add-ins), developers registering freshly built DLLs from Downloads or temp build folders, and software packaging or deployment scripts."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Add approved installer and deployment tooling to %global_allowed_admin_tools and security agents to %global_allowed_security_tools. Extend the user-writable path regex only if a client has a sanctioned per-user COM registration location."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.principal.process.file.full_path = /\\regsvr32\.exe$/ nocase
    $reg.target.registry.registry_key = /\\CLSID\\\{[0-9a-f\-]+\}\\(InprocServer32|LocalServer32)$/ nocase
    $reg.target.registry.registry_value_data = /(\\users\\[^\\]+\\appdata\\|\\users\\public\\|\\programdata\\|\\windows\\temp\\|\\temp\\|\\downloads\\|^\\\\|^https?:)/ nocase
    not $reg.principal.user.userid in %global_allowed_admin_users
    not $reg.principal.user.userid in %global_allowed_service_accounts
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1218.010")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registered_servers = array_distinct($reg.target.registry.registry_value_data)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
