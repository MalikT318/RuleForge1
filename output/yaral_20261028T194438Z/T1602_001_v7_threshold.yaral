/*
  MITRE Technique : T1602.001 - SNMP (MIB Dump)
  Tactic(s)       : Collection
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:19:20.223239+00:00
  Reference       : https://attack.mitre.org/techniques/T1602/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_001_SNMP_MIB_Dump_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single source opens an unusually high number of SNMP (UDP/161) sessions within ten minutes. Each query is benign on its own, but the volume matches an SNMP sweep or MIB walk used to collect device configuration, routing and interface data from network devices."
    mitre_tactic = "Collection"
    mitre_technique = "T1602.001"
    mitre_technique_name = "Data from Configuration Repository: SNMP (MIB Dump)"
    log_prerequisites = "Firewall or perimeter connection logs that record UDP destination port 161 sessions, normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip, target.port and network.ip_protocol populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Network monitoring systems and SNMP pollers, network discovery or inventory scans, vulnerability scanners with SNMP checks, and administrators troubleshooting with snmpwalk."
    tuning_guidance = "Add approved NMS/poller source addresses to %global_allowed_mgmt_sources and authorised scanner sources to %global_allowed_scanners. Raise the #net threshold in noisy environments, or lower it where firewalls log one session per SNMP request. Sources that are not approved management systems and generate high volume warrant escalation."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 161
    $net.network.ip_protocol = "UDP"
    $net.principal.ip = $src_ip
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1602.001")
    $primary_entity = array_distinct($src_ip)
    $target_devices = array_distinct($net.target.ip)

  condition:
    #net >= 20
}
