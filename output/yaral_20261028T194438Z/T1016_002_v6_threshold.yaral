/*
  MITRE Technique : T1016.002 - Wi-Fi Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:48:04.020779+00:00
  Reference       : https://attack.mitre.org/techniques/T1016/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_002_Linux_WiFi_Profile_Mass_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a non-network-manager process reading multiple stored Wi-Fi profile or credential files (NetworkManager system-connections, wpa_supplicant configs, iwd PSK files) on a single Linux host within 10 minutes. Reading one profile is routine, but bulk reads by an unrelated process indicate Wi-Fi credential and network discovery. The rule uses file-access telemetry and does not depend on command-line matching."
    mitre_tactic = "Discovery"
    mitre_technique = "T1016.002"
    mitre_technique_name = "System Network Configuration Discovery: Wi-Fi Discovery"
    log_prerequisites = "Requires Linux EDR file-read telemetry or auditd watch rules (-w on /etc/NetworkManager/system-connections, /etc/wpa_supplicant, /var/lib/iwd) normalised to UDM FILE_READ with principal.process populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management agents (Ansible, Puppet, Chef), backup and imaging software, security or compliance scanners, inventory agents, and admins copying or auditing connection profiles during workstation migration."
    tuning_guidance = "Add approved configuration, inventory and RMM binaries to %global_allowed_admin_tools, backup software to %global_allowed_backup_processes, and EDR or compliance agents to %global_allowed_security_tools. Raise the #file threshold on fleets with many saved profiles. Extend the NetworkManager/wpa_supplicant/iwd process exclusion if the distribution uses other network daemons."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /^\/etc\/NetworkManager\/system-connections\/|^\/etc\/wpa_supplicant\/[^\/]*\.conf$|^\/var\/lib\/iwd\/[^\/]+\.(psk|8021x|open)$/ nocase
    not $file.principal.process.file.full_path = /\/(NetworkManager|wpa_supplicant|iwd|nm-dispatcher)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(75)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1016.002")
    $primary_entity = array_distinct($host)
    $accessed_files = array_distinct($file.target.file.full_path)
    $reading_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
