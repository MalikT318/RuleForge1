/*
  MITRE Technique : T1216 - System Script Proxy Execution
  Tactic(s)       : Stealth
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:31:59.537885+00:00
  Reference       : https://attack.mitre.org/techniques/T1216
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1216_Signed_Script_Proxy_Remote_Script_Moniker {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows script host (cscript/wscript) running a .vbs or .wsf script with a script: moniker argument that points to a remote URL, UNC path or drive path. This is the signature pattern of proxying execution through a Microsoft-signed administrative script such as the printer publishing script, so a malicious remote or local scriptlet runs under a trusted, signed script and bypasses application control."
    mitre_tactic = "Stealth"
    mitre_technique = "T1216"
    mitre_technique_name = "System Script Proxy Execution"
    log_prerequisites = "Requires Windows process launch telemetry with full command line from an EDR, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate administrative automation that calls signed Windows admin scripts with a script: argument (rare). Printer deployment or migration tooling and RMM or software deployment agents that wrap Windows scripts. Admins testing scripting behaviour."
    tuning_guidance = "Add approved deployment or RMM parent processes to %global_allowed_admin_tools. Add hosts or parent processes that legitimately run script hosts to %global_allowed_script_hosts. Add approved automation accounts to %global_allowed_service_accounts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(cscript|wscript)\.exe$/ nocase
    $proc.target.process.command_line = /\.(vbs|wsf)["']?\s+.*\bscript:\s*["']?(https?:\/\/|ftp:\/\/|\\\\|[a-z]:\\)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1216")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
