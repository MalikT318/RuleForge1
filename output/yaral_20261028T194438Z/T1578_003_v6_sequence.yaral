/*
  MITRE Technique : T1578.003 - Delete Cloud Instance
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:53:49.961605+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_003_Cloud_Instance_Created_Then_Deleted {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "The same cloud identity creates a compute instance and then deletes or terminates an instance within ten minutes. This short-lived instance pattern is consistent with an adversary using disposable infrastructure and removing forensic evidence afterwards."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578.003"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Delete Cloud Instance"
    log_prerequisites = "Requires cloud control-plane audit logs with management (write) events enabled and normalised to UDM RESOURCE_CREATION and RESOURCE_DELETION. metadata.product_event_type and principal.user.userid must be populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Autoscaling groups and managed instance groups, CI/CD pipelines and ephemeral build runners, infrastructure-as-code test runs (create then destroy), developers testing images, and automation that replaces unhealthy instances."
    tuning_guidance = "Add automation, autoscaling and CI/CD identities to %global_allowed_service_accounts, and approved cloud service principals to %global_allowed_cloud_principals. Add named administrators who routinely run short-lived test instances to %global_allowed_admin_users. Shorten or lengthen the 10m window per client."

  events:
    $create.metadata.event_type = "RESOURCE_CREATION"
    $create.metadata.product_event_type = /(RunInstances|compute\.instances\.insert|virtualMachines\/write)/ nocase
    $create.principal.user.userid = $user
    not $create.principal.user.userid in %global_allowed_service_accounts
    not $create.principal.user.userid in %global_allowed_cloud_principals
    not $create.principal.user.userid in %global_allowed_admin_users

    $delete.metadata.event_type = "RESOURCE_DELETION"
    $delete.metadata.product_event_type = /(TerminateInstances|compute\.instances\.delete|virtualMachines\/delete)/ nocase
    $delete.principal.user.userid = $user
    not $delete.principal.user.userid in %global_allowed_service_accounts
    not $delete.principal.user.userid in %global_allowed_cloud_principals
    not $delete.principal.user.userid in %global_allowed_admin_users

    $create.metadata.event_timestamp.seconds <= $delete.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1578.003")
    $primary_entity = array_distinct($user)
    $source_ips = array_distinct($delete.principal.ip)
    $create_actions = array_distinct($create.metadata.product_event_type)
    $delete_actions = array_distinct($delete.metadata.product_event_type)
    $deleted_resources = array_distinct($delete.target.resource.name)
    $delete_count = count($delete.metadata.id)

  condition:
    $create and $delete
}
