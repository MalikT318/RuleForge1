/*
  MITRE Technique : T1550.003 - Pass the Ticket
  Tactic(s)       : Lateral Movement
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:40:59.502026+00:00
  Reference       : https://attack.mitre.org/techniques/T1550/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1550_003_Kerberos_Traffic_To_External_KDC {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows host opening a Kerberos (TCP/UDP 88) connection to a non-internal address. Legitimate Kerberos authentication stays inside the corporate address space and goes to domain controllers. A Kerberos exchange with an external address suggests tickets are being requested or replayed through a tunnel, a redirector, or an attacker-controlled KDC, which is network-side evidence of pass-the-ticket and forged-ticket tradecraft."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1550.003"
    mitre_technique_name = "Use Alternate Authentication Material: Pass the Ticket"
    log_prerequisites = "Requires endpoint network telemetry (EDR or Sysmon Event ID 3, or equivalent) that populates target.ip, target.port and principal.process.file.full_path for outbound connections."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Hybrid or cross-forest trusts where the KDC is reached over a public or carrier-NAT address; domain controllers hosted in a cloud network that is not in the internal address list; split-tunnel VPN clients authenticating to a remote domain; authorised security testing."
    tuning_guidance = "Populate %rfc1918_internal with every internal and VPN-assigned range the client uses so only truly external destinations match. Add approved security or test tooling to %global_allowed_security_tools, and approved remote access clients to %global_allowed_remote_mgmt. Raise severity if the initiating process is not lsass."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 88
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1550.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $source_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
