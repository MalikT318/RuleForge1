/*
  MITRE Technique : T1621 - Multi-Factor Authentication Request Generation
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:46:27.335953+00:00
  Reference       : https://attack.mitre.org/techniques/T1621
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1621_IaaS_MFA_Fatigue_Denials_Then_Success {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects MFA push fatigue against a cloud or identity account: five or more denied, rejected or timed-out MFA challenges for one user, followed within 10 minutes by a successful login for that same user. The pattern suggests the user eventually approved a prompt the attacker generated with stolen credentials."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1621"
    mitre_technique_name = "Multi-Factor Authentication Request Generation"
    log_prerequisites = "Identity provider sign-in logs, ingested to Chronicle and normalised to USER_LOGIN. Failed MFA challenges must populate security_result.summary with MFA or push wording and the outcome (denied, rejected, timeout). Successful logins must populate security_result.action. Applies to identities that federate to cloud consoles (AWS, Azure, GCP)."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Users who repeatedly mistype or ignore push prompts and then log in successfully (new phone, poor connectivity, travel). Helpdesk-assisted MFA re-enrolment. Misconfigured clients or mobile apps that retry authentication with stale tokens. Shared accounts with several people responding to prompts."
    tuning_guidance = "Add automation and break-glass identities to %global_allowed_service_accounts. Add named administrators who legitimately re-enrol MFA devices to %global_allowed_admin_users. Raise or lower the #fail threshold per client to match baseline MFA failure rates. If a client's identity provider words MFA failures differently, adjust the two security_result.summary regexes in the $fail event."

  events:
    $fail.metadata.event_type = "USER_LOGIN"
    $fail.security_result.summary = /(mfa|multi.?factor|two.?factor|2fa|push|authenticator|otp)/ nocase
    $fail.security_result.summary = /(denied|deny|reject|declin|timed.?out|timeout|no response|not approved|fail)/ nocase
    $fail.target.user.userid = $user
    not $fail.target.user.userid in %global_allowed_service_accounts
    not $fail.target.user.userid in %global_allowed_admin_users

    $succ.metadata.event_type = "USER_LOGIN"
    $succ.security_result.action = "ALLOW"
    $succ.target.user.userid = $user
    not $succ.target.user.userid in %global_allowed_service_accounts
    not $succ.target.user.userid in %global_allowed_admin_users

    $fail.metadata.event_timestamp.seconds <= $succ.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1621")
    $primary_entity = array_distinct($user)
    $failed_mfa_count = count($fail.metadata.id)
    $failed_source_ips = array_distinct($fail.principal.ip)
    $success_source_ips = array_distinct($succ.principal.ip)
    $first_failure_time = min($fail.metadata.event_timestamp.seconds)
    $success_time = max($succ.metadata.event_timestamp.seconds)

  condition:
    #fail >= 5 and $succ
}
