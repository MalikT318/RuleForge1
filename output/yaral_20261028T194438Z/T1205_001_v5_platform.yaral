/*
  MITRE Technique : T1205.001 - Port Knocking
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:11:21.312309+00:00
  Reference       : https://attack.mitre.org/techniques/T1205/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_001_Inbound_Zero_Reply_HighPort_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an inbound connection attempt from an external source to an internal host on a non-well-known port. The attempt carries almost no payload and gets no reply. This is the signature of a single knock packet sent at a closed port as part of a port-knocking sequence. A single record cannot prove a sequence, so treat the alert as a lead. Pivot on the source IP and look for several distinct closed ports hit in a short window, followed by a successful connection from the same source."
    mitre_tactic = "Stealth, Persistence, Command and Control"
    mitre_technique = "T1205.001"
    mitre_technique_name = "Traffic Signaling: Port Knocking"
    log_prerequisites = "Perimeter firewall or network flow logs that record denied and dropped inbound connections, normalised to NETWORK_CONNECTION with network.direction, network.sent_bytes, network.received_bytes and target.port populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Internet background scanning and backscatter, authorised vulnerability scanners or external attack-surface monitors, NAT or asymmetric-routing artefacts that hide the reply, half-open TCP health checks from load balancers or uptime monitors, and misconfigured peers retrying a service that is down."
    tuning_guidance = "Add authorised scanner sources to %global_allowed_scanners and trusted source addresses to %global_allowed_mgmt_sources. If internet noise is high, scope the rule to critical assets, or raise the target.port floor or sent_bytes ceiling. Pair this rule with a threshold variant that counts distinct target ports per source over a short window to confirm a knock sequence."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.direction = "INBOUND"
    $net.network.ip_protocol = "TCP"
    $net.target.port > 1023
    $net.network.sent_bytes <= 100
    $net.network.received_bytes = 0
    not $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1205.001")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $probed_ports = array_distinct($net.target.port)

  condition:
    $net
}
