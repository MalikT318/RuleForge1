/*
  MITRE Technique : T1025 - Data from Removable Media
  Tactic(s)       : Collection
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:47:30.482524+00:00
  Reference       : https://attack.mitre.org/techniques/T1025
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1025_Linux_Removable_Media_Data_Staged_To_Temp {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a file-creation artifact where an archive is written to a world-writable staging location (/tmp, /var/tmp, /dev/shm) by a process whose arguments reference a removable-media mount point (/media or /run/media). This pattern indicates data collected from a USB, optical or other removable device being staged for exfiltration. Detection is based on the resulting file artifact rather than process-creation logging."
    mitre_tactic = "Collection"
    mitre_technique = "T1025"
    mitre_technique_name = "Data from Removable Media"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd (PATH/CWD/SYSCALL records) normalised to UDM FILE_CREATION events with principal.process.command_line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Users copying or compressing documents from their own USB drive via a file manager or archive tool, backup or imaging jobs reading from external drives, IT staff performing data migration or forensic acquisition, and desktop auto-archive features."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes and approved admin or migration tooling to %global_allowed_admin_tools. Add service account names to %global_allowed_service_accounts. Extend the staging directory regex if the environment uses a different scratch location, and extend the mount-point regex to include /mnt where it is used only for removable devices."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+\.(zip|tar|tgz|gz|bz2|xz|7z|rar|cpio|zst)$/ nocase
    $file.principal.process.command_line = /\/(run\/)?media\// nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1025")
    $primary_entity = array_distinct($file.principal.hostname)
    $staged_file = array_distinct($file.target.file.full_path)
    $acting_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
