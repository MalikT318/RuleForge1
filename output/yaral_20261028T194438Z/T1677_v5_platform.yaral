/*
  MITRE Technique : T1677 - Poisoned Pipeline Execution
  Tactic(s)       : Execution
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:22:58.900523+00:00
  Reference       : https://attack.mitre.org/techniques/T1677
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1677_Fork_Pipeline_Trust_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a SaaS control-plane setting change that alters how CI/CD pipelines or workflows treat forked or external pull and merge requests (for example, approval policy, secret exposure, or token permissions for fork-triggered runs). Relaxing these controls is a precondition for Public Pipeline Execution, where an unprivileged contributor's code runs in a pipeline with access to secrets."
    mitre_tactic = "Execution"
    mitre_technique = "T1677"
    mitre_technique_name = "Poisoned Pipeline Execution"
    log_prerequisites = "Requires source-control or CI/CD SaaS audit logs ingested and normalised to UDM SETTING_MODIFICATION, with the audit action name populated in metadata.product_event_type. Organisation- and repository-level settings audit events must be enabled at the SaaS tenant."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Platform or DevOps teams legitimately enabling fork-based contribution workflows for open-source or inner-source projects; initial repository or organisation onboarding; approved migrations of CI policy; automation that manages CI settings as code."
    tuning_guidance = "Add approved DevOps administrators to %global_allowed_admin_users, and automation or infrastructure-as-code identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Review the matched audit action name in $setting_action; if a client's SaaS emits noisy action names, tighten the second regex to that tenant's relevant action names. Raise severity for production or secret-bearing repositories."

  events:
    $set.metadata.event_type = "SETTING_MODIFICATION"
    $set.metadata.product_event_type = /(fork|pull_request_target|external_contrib|outside_collab)/ nocase
    $set.metadata.product_event_type = /(workflow|pipeline|action|build|ci_|runner|approval|secret|token)/ nocase
    $set.principal.user.userid != ""
    not $set.principal.user.userid in %global_allowed_admin_users
    not $set.principal.user.userid in %global_allowed_service_accounts
    not $set.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1677")
    $primary_entity = array_distinct($set.principal.user.userid)
    $setting_action = array_distinct($set.metadata.product_event_type)
    $target_resource = array_distinct($set.target.resource.name)
    $source_ip = array_distinct($set.principal.ip)

  condition:
    $set
}
