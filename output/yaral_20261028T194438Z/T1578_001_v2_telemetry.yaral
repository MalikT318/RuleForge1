/*
  MITRE Technique : T1578.001 - Create Snapshot
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:50:10.155804+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_001_Cloud_Snapshot_Access_Or_Sharing_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change on a cloud disk or volume snapshot that grants access to it: sharing with another account or project, changing its permissions or IAM policy, or issuing an export or access grant. Adversaries create a snapshot to bypass restrictions on the original compute resource. They then expose it to an account they control, so they can mount it on an attacker-owned instance. This rule pivots on the resulting control-plane state change rather than the snapshot-creation call itself."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578.001"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Create Snapshot"
    log_prerequisites = "Cloud control-plane audit logs ingested and normalised to UDM, with metadata.product_event_type and principal.user.userid populated. Management-plane (admin activity) logging must be enabled for compute and storage services."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Approved backup, disaster-recovery and cross-account replication workflows; golden-image or AMI publishing pipelines; authorised migration projects; administrators sharing snapshots with a sister account or project for troubleshooting or forensics."
    tuning_guidance = "Add approved automation identities to %global_allowed_cloud_principals or %global_allowed_service_accounts, and named administrators to %global_allowed_admin_users. Prioritise alerts where the destination account or project is not part of the customer's organisation. Review $api_action and $snapshot_resource in the outcome."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /snapshot/ nocase
    $cloud.metadata.product_event_type = /(modify|setiam|share|permission|attribute|acl|getaccess|grantaccess)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1578.001")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_action = array_distinct($cloud.metadata.product_event_type)
    $snapshot_resource = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
