/*
  MITRE Technique : T1053.007 - Container Orchestration Job
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:20:04.445161+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_007_External_Source_Creates_K8s_CronJob_Via_API {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Kubernetes API request from a non-internal source address that creates or modifies a CronJob or Job object (POST/PUT/PATCH on the batch API group). Legitimate scheduling normally comes from in-cluster controllers, CI/CD runners or admin jump hosts on internal address space. An external caller scheduling container jobs suggests an exposed API server or stolen credentials being used for scheduled execution and persistence."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.007"
    mitre_technique_name = "Scheduled Task/Job: Container Orchestration Job"
    log_prerequisites = "Requires Kubernetes API server request telemetry (audit log or API gateway/proxy logs) normalised to NETWORK_HTTP with network.http.method, target.url and principal.ip populated. principal.ip must be the real client address (honour X-Forwarded-For or sourceIPs in audit events)."
    platform = "Containers"
    log_source = "container"
    false_positives = "Remote CI/CD or GitOps SaaS runners that deploy over the public API endpoint; admins working remotely through a VPN or NAT that presents a non-internal source address; managed-cluster provider control-plane components; approved external security testing."
    tuning_guidance = "Add known external deployer or VPN egress addresses to %global_allowed_mgmt_sources, deployment and automation identities to %global_allowed_service_accounts, and named cluster admins to %global_allowed_admin_users. If the cluster API server is only reachable internally, any hit is high confidence and should be escalated."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT|PATCH)$/ nocase
    $net.target.url = /\/apis\/batch\/v[0-9a-z]+\/namespaces\/[^\/]+\/(cronjobs|jobs)(\/[^\/?]+)?(\?.*)?$/ nocase
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1053.007")
    $primary_entity = array_distinct($net.principal.ip)
    $api_target = array_distinct($net.target.url)
    $api_server = array_distinct($net.target.hostname)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
