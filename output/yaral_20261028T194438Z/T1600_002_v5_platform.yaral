/*
  MITRE Technique : T1600.002 - Disable Crypto Hardware
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:09:35.832299+00:00
  Reference       : https://attack.mitre.org/techniques/T1600/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_002_Network_Device_Crypto_Hardware_Disabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change on a network device (firewall, router, VPN gateway) that disables dedicated hardware encryption, crypto engines or crypto offload. This forces encryption onto general-purpose CPU software and can precede cipher-weakening or traffic-collection activity. The rule matches the management-plane configuration-change event, not process activity."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1600.002"
    mitre_technique_name = "Weaken Encryption: Disable Crypto Hardware"
    log_prerequisites = "Requires device configuration-change or audit syslog forwarded to Chronicle and normalized to SETTING_MODIFICATION, with the configuration command or setting text in metadata.description or target.resource.name. Flow and connection records alone cannot observe this behaviour."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Planned hardware replacement or RMA, crypto module troubleshooting, firmware or OS upgrades that reset crypto offload, lab or staging devices, and approved network engineers working under change control."
    tuning_guidance = "Add approved network administrator accounts to %global_allowed_admin_users and automation or orchestration accounts to %global_allowed_service_accounts. Verify that the client's device syslog parser populates metadata.description or target.resource.name with the configuration text. If it does not, extend the field coverage in a client-specific copy of the rule. Correlate hits with change tickets."

  events:
    $set.metadata.event_type = "SETTING_MODIFICATION"
    (
      $set.metadata.description = /(\bno\s+crypto\s+(engine|accelerator|hardware)|crypto[\s_-]*(engine|accelerator|offload|module)[^\n]{0,60}(disable|disabled|off|software)|(hardware|hw)[\s_-]*(crypto|encryption|encrypt|offload|acceleration)[^\n]{0,60}(disable|disabled|off|bypass)|(disable|disabled|no)\s+[^\n]{0,40}(hardware|hw)[\s_-]*(crypto|encryption|accelerat))/ nocase or
      $set.target.resource.name = /(\bno\s+crypto\s+(engine|accelerator|hardware)|crypto[\s_-]*(engine|accelerator|offload|module)[^\n]{0,60}(disable|disabled|off|software)|(hardware|hw)[\s_-]*(crypto|encryption|encrypt|offload|acceleration)[^\n]{0,60}(disable|disabled|off|bypass)|(disable|disabled|no)\s+[^\n]{0,40}(hardware|hw)[\s_-]*(crypto|encryption|accelerat))/ nocase
    )
    not $set.principal.user.userid in %global_allowed_admin_users
    not $set.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1600.002")
    $primary_entity = array_distinct($set.principal.hostname)
    $acting_user = array_distinct($set.principal.user.userid)
    $source_ips = array_distinct($set.principal.ip)

  condition:
    $set
}
