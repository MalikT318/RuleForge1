/*
  MITRE Technique : T1070.006 - Timestomp
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:08:54.196198+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_006_ESXi_Bulk_Timestamp_Manipulation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of file timestamp modifications on a single ESXi host within ten minutes, using explicit time or reference-file options (-r, -t, -d, --reference, --date). One such command is routine, but repeated use points to bulk timestomping to blend dropped files, modified binaries or tampered logs and configs with legitimate files. This complements single-command detections by alerting on volume per host."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.006"
    mitre_technique_name = "Indicator Removal: Timestomp"
    log_prerequisites = "ESXi shell command auditing (shell.log or equivalent) forwarded to Chronicle and parsed into UDM PROCESS_LAUNCH events with principal.hostname and target.process.command_line populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators or scripts that restore file times after patching or VIB installs, backup and restore scripts preserving timestamps, build or deployment automation touching many files with a reference time, and troubleshooting sessions."
    tuning_guidance = "Add approved automation parents to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Raise the #proc threshold on hosts where scripted timestamp handling is normal. Lower it to 3 for high-value hosts. Severity can be scaled downstream using $command_count."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(^|\s|\/)touch\s+.*\s(-[a-zA-Z]*[rtd]|--(reference|date))/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $command_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1070.006")
    $users = array_distinct($proc.principal.user.userid)
    $primary_entity = array_distinct($host)

  condition:
    #proc >= 5
}
