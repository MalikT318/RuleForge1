/*
  MITRE Technique : T1037.003 - Network Logon Script
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:22:21.492152+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_003_GPO_Logon_Script_Config_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a Group Policy user logon script configuration file (scripts.ini / psscripts.ini) in a SYSVOL policy folder or the local GroupPolicy folder. Adversaries use these files to assign a network logon script that runs at every logon of the affected users. The rule targets the policy-file mechanism rather than script names or content. Written for Windows only, because T1037.003 network logon scripts have no Linux, macOS or cloud equivalent."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.003"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Network Logon Script"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) on domain controllers, file servers hosting SYSVOL, and workstations (local GPO). File auditing on SYSVOL is recommended."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate administrators creating or editing GPO logon scripts through the Group Policy Management Console, GPO backup/restore or migration jobs, SYSVOL replication (DFSR) staging, and software deployment tooling that manages logon scripts."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users, GPO automation accounts to %global_allowed_service_accounts, and deployment or GPO management binaries to %global_allowed_admin_tools. On domain controllers, check that the writing process and user match change-management records. To also catch edits to an existing scripts.ini, clone the rule with metadata.event_type = FILE_MODIFICATION."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(Policies\\\{[0-9a-f\-]{36}\}|GroupPolicy)\\User\\Scripts\\(scripts|psscripts)\.ini$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1037.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $script_config_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
