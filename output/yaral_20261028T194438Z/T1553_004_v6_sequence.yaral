/*
  MITRE Technique : T1553.004 - Install Root Certificate
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:05:43.455415+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_004_Linux_CA_Anchor_Drop_Then_Trust_Store_Update {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a certificate file written into a Linux system CA trust-anchor directory by a non-package-manager process, followed within 10 minutes on the same host by execution of the trust store refresh utility. This sequence installs a new root CA into the system-wide trust store."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.004"
    mitre_technique_name = "Subvert Trust Controls: Install Root Certificate"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that populates FILE_CREATION (with principal process and target file path) and PROCESS_LAUNCH (with target process path) events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management (Ansible, Puppet, Chef, Salt) deploying corporate or internal PKI roots; administrators installing a private CA manually; container image builds and provisioning scripts; MDM or enterprise onboarding scripts; proxy or TLS-inspection agent deployment."
    tuning_guidance = "Add approved config management, provisioning and certificate deployment binaries to %global_allowed_admin_tools. The package manager exclusion is by executable name; extend the regex if the client uses other package tooling. Add approved script parents to %global_allowed_script_hosts if needed. Consider raising severity on hosts that are internet-facing or hold sensitive data."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(usr\/local\/share\/ca-certificates|etc\/pki\/ca-trust\/source\/anchors|etc\/pki\/trust\/anchors|usr\/share\/pki\/ca-trust-source\/anchors|etc\/ca-certificates\/trust-source\/anchors)\/.+\.(crt|pem|cer|cert)$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|yum|dnf|zypper|packagekitd|pacman)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(update-ca-certificates|update-ca-trust)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1553.004")
    $primary_entity = array_distinct($hostname)
    $cert_files = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $writer_users = array_distinct($file.principal.user.userid)
    $refresh_command_lines = array_distinct($proc.target.process.command_line)
    $refresh_parents = array_distinct($proc.principal.process.file.full_path)

  condition:
    $file and $proc
}
