/*
  MITRE Technique : T1505.005 - Terminal Services DLL
  Tactic(s)       : Persistence
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:33:55.221829+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_005_TermService_ServiceDll_Registry_Hijack {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry write to the TermService Parameters ServiceDll value that sets it to anything other than the default termsrv.dll in System32. This is the result of Terminal Services DLL hijacking, where a malicious or patched DLL is loaded by svchost for persistent RDP access. It covers the registry-telemetry angle, not process command lines. T1505.005 applies only to Windows, so this rule targets Windows."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.005"
    mitre_technique_name = "Server Software Component: Terminal Services DLL"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events) that populates registry key, value name, and ideally value data."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare legitimate use: RDP wrappers or concurrent-session tooling deployed by admins, Windows servicing or in-place upgrades rewriting the value, and RMM or deployment agents that reconfigure Remote Desktop Services."
    tuning_guidance = "Add approved deployment or RMM binaries to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. If the value data field is not populated by your EDR, the default-value exclusion will not apply, so rely on the process allowlists."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\services\\TermService\\Parameters$/ nocase
    $reg.target.registry.registry_value_name = /^ServiceDll$/ nocase
    not $reg.target.registry.registry_value_data = /^(%SystemRoot%|[a-z]:\\windows)\\system32\\termsrv\.dll$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1505.005")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $new_service_dll = array_distinct($reg.target.registry.registry_value_data)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
