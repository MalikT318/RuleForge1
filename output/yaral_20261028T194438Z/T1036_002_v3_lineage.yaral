/*
  MITRE Technique : T1036.002 - Right-to-Left Override
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:59:13.292557+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_002_RTLO_Executable_From_Delivery_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process whose image path contains the Unicode right-to-left override character (U+202E) being launched by a user-facing delivery application such as an Office app, mail client, browser, PDF reader, archive utility or Explorer. A legitimate parent launching an executable with a bidi override in its own file path is a strong indicator of a disguised file extension (for example a .scr or .exe masquerading as a document) delivered via phishing."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.002"
    mitre_technique_name = "Masquerading: Right-to-Left Override"
    log_prerequisites = "Requires Windows endpoint process telemetry (EDR or Sysmon Event ID 1) that populates both parent and child process image paths with full Unicode fidelity (no sanitising of non-printing characters)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software or documents with legitimately right-to-left language (Arabic, Hebrew) file names that include U+202E for display purposes, and security awareness or phishing simulation exercises. Both are rare for executable image paths."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_security_tools. In environments with Arabic or Hebrew locale users, review hits for legitimate RTL file naming and exclude by parent process. The parent list can be narrowed to remove Explorer if only application-spawned lineage is wanted."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\x{202e}/
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|onenote|acrord32|acrobat|foxitreader|chrome|msedge|firefox|iexplore|brave|opera|thunderbird|winrar|7zfm|7zg|explorer)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1036.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
