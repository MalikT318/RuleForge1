/*
  MITRE Technique : T1036.010 - Masquerade Account Name
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:13:23.520821+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_010_Container_Masquerade_Account_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single identity creates several cluster resources (such as service accounts or users) whose names mimic privileged, system or cluster-management identities (admin, root, kube-system, system:*, cluster-admin, backup and similar) within ten minutes. One such creation can be benign. A burst by one principal suggests masquerading accounts being staged to blend in with legitimate cluster identities."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.010"
    mitre_technique_name = "Masquerading: Masquerade Account Name"
    log_prerequisites = "Kubernetes audit logs or cloud control-plane audit logs for managed container clusters, normalised to UDM RESOURCE_CREATION with target.resource.name and principal.user.userid populated."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "GitOps controllers and Helm or operator installs that legitimately create service accounts named after system components (cert-manager, ingress, monitoring, backup, operator); cluster bootstrap and upgrade automation; platform engineers provisioning a new namespace baseline."
    tuning_guidance = "Add deployment pipelines and controller identities to %global_allowed_service_accounts, and approved platform principals to %global_allowed_cloud_principals. Raise the threshold (#res) in noisy clusters, or lower it to 2 in tightly controlled production clusters. Extend or trim the name regex to match local naming conventions."

  events:
    $res.metadata.event_type = "RESOURCE_CREATION"
    $res.target.resource.name = /^(system[:_-]|kube[-_]?(system|admin|public|proxy|apiserver|controller|scheduler|dns)|cluster[-_]?admin|admin|administrator|root|default|master|support|help|backup|helm|tiller|argocd|flux|operator|monitoring|prometheus)/ nocase
    $res.principal.user.userid = $user
    not $res.principal.user.userid in %global_allowed_service_accounts
    not $res.principal.user.userid in %global_allowed_cloud_principals

  match:
    $user over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($res.metadata.id)
    $mitre_technique_id = array_distinct("T1036.010")
    $primary_entity = array_distinct($user)
    $created_names = array_distinct($res.target.resource.name)
    $source_ips = array_distinct($res.principal.ip)

  condition:
    #res >= 3
}
