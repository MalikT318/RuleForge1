/*
  MITRE Technique : T1574.005 - Executable Installer File Permissions Weakness
  Tactic(s)       : Stealth, Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:31:12.676608+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_005_SYSTEM_Temp_Subdir_Binary_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an executable running as SYSTEM from an installer-style unpack subdirectory under a Windows temp location (Windows\\Temp or the SYSTEM profile temp) that opens a network connection to an external address. This is the network-side result of installer binary hijacking, where a binary planted or overwritten in a weakly permissioned installer temp directory is executed with elevated privileges and beacons out or pulls a payload. Installer unpack directories are normally used only for local setup steps."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.005"
    mitre_technique_name = "Hijack Execution Flow: Executable Installer File Permissions Weakness"
    log_prerequisites = "Requires endpoint network connection telemetry (EDR or Sysmon Event ID 3 equivalent) that populates the initiating process path and user, and normalised to NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate installers or updaters running as SYSTEM that unpack a helper executable into a temp subdirectory and download components or check licences; software deployment and patching agents; RMM agents staging binaries; security agent self-updaters."
    tuning_guidance = "Add approved deployment, patching and RMM binaries to %global_allowed_admin_tools and security agents to %global_allowed_security_tools. Add known-good vendor update destinations to %global_allowed_domains. Extend %rfc1918_internal if additional internal space needs excluding."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(windows\\temp|systemprofile\\appdata\\local\\temp)\\[^\\]+\\([^\\]+\\)*[^\\]+\.exe$/ nocase
    $net.principal.user.userid = /(^|\\)system$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1574.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
