/*
  MITRE Technique : T1649 - Steal or Forge Authentication Certificates
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:52:22.240061+00:00
  Reference       : https://attack.mitre.org/techniques/T1649
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1649_Linux_Cert_Key_Access_Then_Staging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a copy, archive or export utility touching Linux certificate or private-key stores (TLS private keys, Let's Encrypt material, PKCS#12 bundles), followed on the same host within 10 minutes by creation of a certificate, key or archive file in a world-writable staging directory (/tmp, /var/tmp, /dev/shm). This sequence indicates authentication certificate theft staged for exfiltration."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1649"
    mitre_technique_name = "Steal or Forge Authentication Certificates"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry with command lines (PROCESS_LAUNCH) and file creation events (FILE_CREATION) with the creating process populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Certificate renewal and deployment automation (certbot hooks, config management), admins migrating certificates between servers, backup jobs archiving /etc/ssl or /etc/letsencrypt, and web server or load balancer provisioning scripts."
    tuning_guidance = "Add approved automation binaries to %global_allowed_admin_tools, certificate-management service accounts to %global_allowed_service_accounts, and backup software to %global_allowed_backup_processes. If noise persists, restrict the staging path regex to the directories used by your tenant's hardened baseline."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(cp|tar|zip|7z|7za|gzip|rsync|scp|base64|openssl|xxd|dd|cat)$/ nocase
    $proc.target.process.command_line = /(\/etc\/ssl\/private|\/etc\/pki\/[^ ]*private|\/etc\/letsencrypt\/(live|archive)|\/var\/lib\/[^ ]*\/(private|certs)|\.pfx|\.p12|\.key\b|pkcs12)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.*\.(pfx|p12|pem|key|crt|cer|tar|tgz|gz|zip|b64)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1649")
    $primary_entity = array_distinct($hostname)
    $users = array_distinct($proc.principal.user.userid)
    $commands = array_distinct($proc.target.process.command_line)
    $staged_files = array_distinct($file.target.file.full_path)
    $staged_file_count = count($file.metadata.id)

  condition:
    $proc and $file
}
