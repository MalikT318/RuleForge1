/*
  MITRE Technique : T1599.001 - Network Address Translation Traversal
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:02:43.754353+00:00
  Reference       : https://attack.mitre.org/techniques/T1599/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1599_001_External_To_Internal_Admin_Port_Via_Border_NAT {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a connection from an external source address to an internal (private) destination on a remote-administration or lateral-movement port, seen in perimeter firewall logs. Private destinations are normally unreachable from the Internet, so this is a network-observable result of a new or modified inbound NAT or port-forward rule that bridges the untrusted and trusted networks. It does not rely on NAT configuration-change logs, which many perimeter devices do not forward."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1599.001"
    mitre_technique_name = "Network Boundary Bridging: Network Address Translation Traversal"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION. principal.ip must be the pre-NAT external source and target.ip the post-DNAT internal destination (or the inside address recorded for the session). Logs that record only the translated public address for the destination will not match."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Intentionally published services such as a VPN concentrator, jump host or bastion, or an SFTP server, that sit behind a sanctioned port-forward. Also vendor remote support, authorised external penetration tests or scanners, and sites that log pre-NAT addresses inconsistently."
    tuning_guidance = "Add approved external scanner and test sources to %global_allowed_scanners. Add approved external management or partner source addresses to %global_allowed_mgmt_sources. Per-client sanctioned port-forwards are best handled by adding the source to those lists, or by narrowing the port set for the client. Review any hit against the device's current NAT table and change history."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 135 or
      $net.target.port = 445 or
      $net.target.port = 3389 or
      $net.target.port = 5985 or
      $net.target.port = 5986 or
      $net.target.port = 5900
    )
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1599.001")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
