/*
  MITRE Technique : T1546.016 - Installer Packages
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:22:56.349299+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_016_MsiExec_External_Package_Fetch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects the Windows Installer engine (msiexec.exe) opening a web connection to an external destination. This is the network footprint of a remotely hosted installer package being pulled and run (msiexec /i <remote package>), which an adversary can use to run malicious install actions or custom actions with elevated rights. Complements command-line detections by observing the network behaviour rather than the process arguments."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.016"
    mitre_technique_name = "Event Triggered Execution: Installer Packages"
    log_prerequisites = "Requires Windows endpoint network telemetry (EDR or Sysmon Event ID 3) that populates the initiating process path, destination IP and destination port."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software deployment and patching workflows that install MSI packages directly from vendor URLs, certificate revocation or signature checks by msiexec, user-initiated vendor installs, and packaging or RMM tooling run under service accounts."
    tuning_guidance = "Add known-good vendor and CDN domains to %global_allowed_domains (matched against target.hostname). Add deployment or automation accounts to %global_allowed_service_accounts. Review internal software distribution points that sit outside the %rfc1918_internal list. Consider raising severity when the connecting user is an interactive, non-admin account."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\msiexec\.exe$/ nocase
    ($net.target.port = 80 or $net.target.port = 443 or $net.target.port = 8080 or $net.target.port = 8443)
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1546.016")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $initiating_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
