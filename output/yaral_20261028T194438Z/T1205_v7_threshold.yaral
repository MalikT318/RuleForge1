/*
  MITRE Technique : T1205 - Traffic Signaling
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:09:44.417217+00:00
  Reference       : https://attack.mitre.org/techniques/T1205
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_Port_Knock_Sequence_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source makes many connection attempts to a single internal or protected destination across multiple distinct ports within ten minutes. This pattern is consistent with port knocking or other traffic signaling used to unlock a hidden service. Any one connection is benign, but the volume and port diversity are not."
    mitre_tactic = "Stealth, Persistence, Command and Control"
    mitre_technique = "T1205"
    mitre_technique_name = "Traffic Signaling"
    log_prerequisites = "Requires firewall or perimeter connection logs (allowed and denied) normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Denied or dropped connections must be logged for the closed-port knock sequence to be visible."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "External vulnerability or attack-surface scanners not yet allowlisted, internet-wide research scanners, uptime or monitoring probes that check multiple service ports, partner or customer systems with multi-port application flows, and clients retrying after connection failures."
    tuning_guidance = "Add authorised scanner and monitoring source IPs to %global_allowed_scanners. Raise the #net threshold in noisy internet-facing environments. Review the distinct_port_count and ports_contacted outcomes: a small, ordered set of ports (3-8) followed by a connection to a normally closed service port is more indicative of a knock than a broad sweep. Consider scoping to inbound traffic by restricting target.ip with a tenant-approved list."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src
    $net.target.ip = $dst
    $net.target.port > 0
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src, $dst over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1205")
    $primary_entity = array_distinct($src)
    $target_host = array_distinct($dst)
    $connection_count = count($net.metadata.id)
    $distinct_port_count = count_distinct($net.target.port)
    $ports_contacted = array_distinct($net.target.port)

  condition:
    #net >= 8
}
