/*
  MITRE Technique : T1059.003 - Windows Command Shell
  Tactic(s)       : Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:09:53.666013+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_003_Unexpected_Parent_Spawns_Cmd {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects cmd.exe launched by a parent process that should not normally spawn a command shell, such as an Office application, web server worker, print spooler or database service. This is a lineage-based detection and does not depend on command-line content. It typically indicates macro execution, web shell activity, or exploitation of a service."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.003"
    mitre_technique_name = "Command and Scripting Interpreter: Windows Command Shell"
    log_prerequisites = "Requires EDR or Sysmon process-creation telemetry (Sysmon Event ID 1 or equivalent) with parent process image path populated in UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office add-ins or legacy macros that call cmd.exe, web applications that intentionally shell out (older CMS plugins, deployment hooks, IIS-hosted admin tools), database jobs using xp_cmdshell for maintenance, print drivers or print-management software that run helper batch files, and software installers launched from Office or a browser-based workflow."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts and approved IT tooling to %global_allowed_admin_tools. Add EDR or AV agents to %global_allowed_security_tools. If a specific web or database application legitimately shells out, allowlist its parent path in %global_allowed_script_hosts instead of removing the parent from the regex. Review the parent_command_lines and child_command_lines outcome fields during triage."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\cmd\.exe$/ nocase
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|spoolsv|sqlservr|mysqld)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $parent_command_lines = array_distinct($proc.principal.process.command_line)
    $child_command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
