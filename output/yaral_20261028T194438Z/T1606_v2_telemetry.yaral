/*
  MITRE Technique : T1606 - Forge Web Credentials
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:21:35.418133+00:00
  Reference       : https://attack.mitre.org/techniques/T1606
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1606_IdP_Federation_Token_Signing_Setting_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change to identity provider federation, SAML or token-signing settings (for example a new token-signing certificate, a changed federation trust or a changed domain authentication mode). Changes to these settings are the state change that lets an adversary forge SAML assertions or tokens (Golden SAML style) without touching any endpoint."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1606"
    mitre_technique_name = "Forge Web Credentials"
    log_prerequisites = "Requires identity provider directory/admin audit logs ingested and normalised to UDM SETTING_MODIFICATION with metadata.product_event_type and principal.user.userid populated."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Planned certificate rollover for federation or SSO, onboarding or offboarding a federated domain, SSO application integration by the identity team, and migration projects between identity providers."
    tuning_guidance = "Add named administrators who own federation to %global_allowed_admin_users and automation or certificate-rotation accounts to %global_allowed_service_accounts. Add approved cloud or identity service principals to %global_allowed_cloud_principals. Review the product_event_type values seen in the tenant and narrow the regexes if one is noisy."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(federat|token.?signing|signing.?cert|idp.?(trust|config)|saml.?(cert|config|setting)|domain.?authentication)/ nocase
    $setting.metadata.product_event_type = /(set|update|add|modif|chang|creat|replac|roll|remov|delet)/ nocase
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1606")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $event_names = array_distinct($setting.metadata.product_event_type)
    $changed_resource = array_distinct($setting.target.resource.name)
    $source_ips = array_distinct($setting.principal.ip)

  condition:
    $setting
}
