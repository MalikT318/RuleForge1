/*
  MITRE Technique : T1563 - Remote Service Session Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:06:59.116858+00:00
  Reference       : https://attack.mitre.org/techniques/T1563
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_Remote_Session_Protocol_Across_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects RDP (3389) or Telnet (23) connections crossing the network perimeter to or from a non-internal address. Remote interactive session protocols should not traverse the perimeter, and doing so is the network footprint of session hijacking, tunnelled RDP pivoting, and exposed remote-service abuse. Hijacking itself is not visible at the network layer, so this rule flags the perimeter crossing and relies on endpoint rules to confirm the hijack."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1563"
    mitre_technique_name = "Remote Service Session Hijacking"
    log_prerequisites = "Firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Approved vendor or third-party remote support over RDP, administrators working remotely through a bastion or VPN, cloud-hosted Windows servers managed over RDP, legacy Telnet to network gear or OT equipment, and authorised penetration tests."
    tuning_guidance = "Add approved management source addresses to %global_allowed_mgmt_sources. Add known-good external endpoints to %global_allowed_domains. Keep %rfc1918_internal current so internal traffic stays excluded. Raise severity if the destination is a critical server segment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 3389 or $net.target.port = 23)
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1563")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
