/*
  MITRE Technique : T1218.004 - InstallUtil
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:46:28.390484+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_004_InstallUtil_Artifact_UserWritable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects InstallUtil writing its .InstallLog or .InstallState artifacts into a user-writable or staging directory. InstallUtil produces these files next to the .NET assembly it executes, so their presence in such a location indicates a proxy-execution attempt on an assembly staged there. This does not depend on command-line logging."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.004"
    mitre_technique_name = "System Binary Proxy Execution: InstallUtil"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with the writing process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developers testing .NET installer classes from build or output folders, software packaging and deployment pipelines that run InstallUtil from temp directories, and legacy .NET service installers executed from a download or extraction folder."
    tuning_guidance = "Add approved deployment and packaging parent processes to %global_allowed_admin_tools. Add build or service accounts to %global_allowed_service_accounts. Narrow or extend the staging-directory regex per client. Review the matched target file path to find the assembly that was executed."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\installutil\.exe$/ nocase
    $file.target.file.full_path = /\.(installlog|installstate)$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|users\\public|programdata|windows\\temp|perflogs|temp)\\/ nocase
    not $file.principal.process.parent_process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1218.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $artifact_paths = array_distinct($file.target.file.full_path)
    $acting_users = array_distinct($file.principal.user.userid)

  condition:
    $file
}
