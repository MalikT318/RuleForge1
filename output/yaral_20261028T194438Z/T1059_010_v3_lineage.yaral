/*
  MITRE Technique : T1059.010 - AutoHotKey & AutoIT
  Tactic(s)       : Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:21:07.397415+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_010_AutoIt_AHK_From_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an AutoIt or AutoHotkey interpreter, or any process running an .au3/.ahk/.a3x script, launched by a parent that should not start automation scripting. Parents covered are Office applications, PDF readers, browsers, web server and application server processes, database services, the print spooler, script hosts and archive tools. This lineage is typical of phishing payloads, web shell activity and exploited services delivering AutoIt/AHK loaders or keyloggers."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.010"
    mitre_technique_name = "Command and Scripting Interpreter: AutoHotKey & AutoIT"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with parent process path populated (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate AutoIt/AutoHotkey installers or self-extracting packages run from a browser or archive tool; internal Office macros or add-ins that drive AutoIt automation; web or database based IT automation that invokes AutoIt; helpdesk or QA test harnesses launched from script hosts."
    tuning_guidance = "Add approved automation launchers or parent process paths to %global_allowed_script_hosts or %global_allowed_admin_tools. If browsers or archive tools are noisy because of software-install workflows, remove them from the parent regex for that tenant, or allowlist the specific parent path in the reference lists."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|onenote|visio|acrord32|acrobat|foxitreader|w3wp|httpd|nginx|tomcat\d*|php-cgi|sqlservr|spoolsv|mshta|wscript|cscript|msedge|chrome|firefox|iexplore|winrar|7zfm)\.exe$/ nocase
    (
      $proc.target.process.file.full_path = /\\autohotkey[a-z0-9_]*\.exe$/ nocase or
      $proc.target.process.file.full_path = /\\autoit3(_x64)?\.exe$/ nocase or
      $proc.target.process.command_line = /\.(ahk|au3|a3x)\b/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.010")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
