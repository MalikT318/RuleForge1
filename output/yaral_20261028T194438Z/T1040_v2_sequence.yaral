/*
  MITRE Technique : T1040 - Network Sniffing
  Tactic(s)       : Credential Access, Discovery
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:27:02.793044+00:00
  Reference       : https://attack.mitre.org/techniques/T1040
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1040_Cloud_Traffic_Mirror_Target_Then_Session {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "The same cloud identity creates a traffic mirror target or filter and then, within 10 minutes, creates the mirror session (or equivalent packet capture/mirroring resource) that starts copying network traffic to that destination. This is the cloud equivalent of enabling promiscuous mode or a SPAN port, and can be used to passively capture credentials and data in transit."
    mitre_tactic = "Credential Access, Discovery"
    mitre_technique = "T1040"
    mitre_technique_name = "Network Sniffing"
    log_prerequisites = "Cloud control-plane audit logging (management/admin write events) ingested and normalised to UDM RESOURCE_CREATION, with metadata.product_event_type and principal.user.userid populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Network or security engineering teams deploying approved traffic inspection (IDS/NDR sensors, packet brokers), troubleshooting or forensic captures run under a change ticket, and infrastructure-as-code pipelines that provision mirroring for monitoring tools."
    tuning_guidance = "Add approved NDR/IDS deployment pipelines and automation identities to %global_allowed_cloud_principals, and named network/security engineers to %global_allowed_admin_users. The first event is tied to filter/target creation; other providers' single-step mirroring or capture creation is covered by the second event only if it is preceded by a matching setup event. Extend the product_event_type patterns if the tenant normalises API names differently."

  events:
    $setup.metadata.event_type = "RESOURCE_CREATION"
    $setup.metadata.product_event_type = /CreateTrafficMirror(Target|Filter|FilterRule)/ nocase
    $setup.principal.user.userid = $user
    not $setup.principal.user.userid in %global_allowed_cloud_principals
    not $setup.principal.user.userid in %global_allowed_admin_users

    $session.metadata.event_type = "RESOURCE_CREATION"
    $session.metadata.product_event_type = /(CreateTrafficMirrorSession|packetMirrorings\.(insert|patch)|packetCaptures)/ nocase
    $session.principal.user.userid = $user
    not $session.principal.user.userid in %global_allowed_cloud_principals
    not $session.principal.user.userid in %global_allowed_admin_users

    $setup.metadata.event_timestamp.seconds <= $session.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1040")
    $primary_entity = array_distinct($user)
    $source_ips = array_distinct($session.principal.ip)
    $setup_actions = array_distinct($setup.metadata.product_event_type)
    $session_actions = array_distinct($session.metadata.product_event_type)
    $mirrored_resources = array_distinct($session.target.resource.name)
    $session_event_count = count($session.metadata.id)

  condition:
    $setup and $session
}
