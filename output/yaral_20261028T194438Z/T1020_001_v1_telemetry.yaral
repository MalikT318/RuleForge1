/*
  MITRE Technique : T1020.001 - Traffic Duplication
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:31:17.093406+00:00
  Reference       : https://attack.mitre.org/techniques/T1020/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1020_001_Cloud_Traffic_Mirror_Resource_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of a cloud traffic mirroring session, target, filter or tap (AWS Traffic Mirroring, GCP Packet Mirroring, Azure Virtual Network TAP) by a principal that is not an approved network or security administrator. Mirroring duplicates workload traffic to a destination the actor controls, so it can be used for stealthy, continuous exfiltration. The rule works from the control-plane configuration change and does not depend on any endpoint telemetry."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1020.001"
    mitre_technique_name = "Automated Exfiltration: Traffic Duplication"
    log_prerequisites = "Cloud control-plane audit logging must be enabled and ingested with management/write events: AWS CloudTrail management events, GCP Admin Activity audit logs, and Azure Activity Log (Administrative category). metadata.product_event_type must be populated with the API operation name."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Network or security engineering teams deploying approved traffic analysis, IDS/NDR sensors or troubleshooting captures; infrastructure-as-code pipelines and automation roles deploying monitoring stacks; managed security or NDR vendor onboarding."
    tuning_guidance = "Add approved network and security administrators to %global_allowed_admin_users, IaC and automation identities to %global_allowed_service_accounts, and approved cloud roles or service principals to %global_allowed_cloud_principals. Review the mirror target resource: destinations outside the organisation's own accounts, subscriptions or projects should be escalated immediately. Tune per tenant if the mirroring feature is not used at all, in which case any hit is high-fidelity."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /(CreateTrafficMirror(Session|Target|Filter|FilterRule)|ModifyTrafficMirror(Session|Filter)|packetMirrorings\.(insert|patch)|virtualNetworkTaps\/write|networkInterfaceTapConfigurations\/write)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1020.001")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_operation = array_distinct($cloud.metadata.product_event_type)
    $target_resource = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
