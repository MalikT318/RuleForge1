/*
  MITRE Technique : T1036.012 - Browser Fingerprint
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:17:02.753598+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_012_Spoofed_Legacy_Browser_UserAgent_External_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP requests whose User-Agent claims to be a mainstream browser (Mozilla/ prefix) but carries markers of a spoofed or hard-coded string. Markers are a bare 'Mozilla/x.x' token with no platform details, an obsolete MSIE 2-8 engine, a Windows NT 4/5/6.0 platform token, or a Chrome/Firefox major version below 100. Malware and C2 frameworks often hard-code these strings to blend into proxy traffic. Observed from the network perimeter, so no endpoint process fields are used."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.012"
    mitre_technique_name = "Masquerading: Browser Fingerprint"
    log_prerequisites = "Requires proxy or firewall logs with HTTP inspection (TLS decryption or explicit proxy) that populate network.http.user_agent, normalised to NETWORK_HTTP."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legacy line-of-business applications, embedded or IoT devices, kiosks and thin clients pinned to old browser engines, and unpatched legacy Windows hosts. Also vendor update agents or scrapers that send a bare Mozilla token, and compatibility-mode Internet Explorer in intranet-proxy scenarios."
    tuning_guidance = "Add known-good destination domains to %global_allowed_domains and legacy or scanner source hostnames to %global_allowed_scanners. If the customer still runs old browsers, narrow the regex by removing the Windows NT 5/6.0 or major-version branches. Source hostname must be populated by the proxy or DHCP enrichment; otherwise tune on principal.ip."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.user_agent = /(^Mozilla\/\d\.\d\s*$|^Mozilla\/.*(MSIE [2-8]\.|Windows NT (4|5|6\.0)|Chrome\/\d{1,2}\.|Firefox\/\d{1,2}\.))/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1036.012")
    $primary_entity = array_distinct($http.principal.ip)
    $source_hostname = array_distinct($http.principal.hostname)
    $destination_host = array_distinct($http.target.hostname)
    $destination_ip = array_distinct($http.target.ip)
    $user_agent = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
