/*
  MITRE Technique : T1543.002 - Systemd Service
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:54:52.554087+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_002_Systemd_Unit_File_Written_By_NonPackage_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a systemd service unit file or service drop-in override in a system-level or user-level unit directory by a process that is not a package manager or an approved administrative tool. Adversaries drop .service files to persist payloads via ExecStart directives and to escalate privileges when the unit is system-level. This rule covers file-write telemetry and is additive to command-line based detections."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.002"
    mitre_technique_name = "Create or Modify System Process: Systemd Service"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry (watches on /etc/systemd, /usr/lib/systemd, /lib/systemd and user .config/systemd directories) with the writing process path populated in principal.process.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package installs and upgrades through unlisted package managers, configuration management agents (Ansible, Puppet, Chef, Salt), container or image build pipelines, administrators hand-writing units or running systemctl edit, and developers creating user-level units in their home directories."
    tuning_guidance = "Add configuration management and deployment binaries to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and approved administrators to %global_allowed_admin_users. Extend the package manager regex if the estate uses a distribution-specific installer. Consider raising severity for writers running from /tmp, /dev/shm or /var/tmp, or for shell and interpreter writers."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/(etc|usr\/lib|lib|usr\/local\/lib|run)\/systemd\/(system|user)|\/(home\/[^\/]+|root)\/\.config\/systemd\/user)\/([^\/]+\.service|[^\/]+\.service\.d\/[^\/]+\.conf)$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|yum|dnf|zypper|pacman|apk|snapd|packagekitd|unattended-upgrade)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1543.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $unit_file_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
