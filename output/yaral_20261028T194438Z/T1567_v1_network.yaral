/*
  MITRE Technique : T1567 - Exfiltration Over Web Service
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:53:34.528614+00:00
  Reference       : https://attack.mitre.org/techniques/T1567
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_Large_Outbound_Web_Upload_Firewall {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a single large outbound web-port (HTTPS/HTTP) session from an internal Windows client to an external destination, where bytes sent far exceed normal browsing. This is the network-side signature of bulk data staged to a legitimate external web or cloud-storage service. It does not depend on destination names, process names or command lines."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567"
    mitre_technique_name = "Exfiltration Over Web Service"
    log_prerequisites = "Firewall or proxy perimeter logs normalised to UDM NETWORK_CONNECTION with network.sent_bytes populated, and source host or IP attribution for Windows clients. Session-close or byte-count logging must be enabled on the web-port policy."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Cloud backup and sync clients (OneDrive, SharePoint, Google Drive, Dropbox), software publishers or developers pushing build artifacts, video conferencing screen-share or recording uploads, large email attachments sent via web mail, endpoint telemetry or crash-dump uploads to vendor clouds, and approved migration projects."
    tuning_guidance = "Raise or lower the sent_bytes threshold (default 50 MB) per client baseline. Add sanctioned cloud or vendor destinations to %global_allowed_domains. Add service accounts that run bulk transfers to %global_allowed_service_accounts. Where the firewall does not log the destination hostname, the domain exclusion has no effect, so tune the byte threshold instead."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 443
    $net.network.sent_bytes > 52428800
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1567")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $max_bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
