/*
  MITRE Technique : T1204.004 - Malicious Copy and Paste
  Tactic(s)       : Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:05:16.442233+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_004_Linux_Downloader_Drops_Staged_Payload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a command-line downloader (curl, wget, fetch) writing a hidden file or a script/binary-type file into a world-writable staging directory (/tmp, /var/tmp, /dev/shm). This is the file-creation artifact of a ClickFix-style paste, where a user is socially engineered into pasting a one-liner into a Linux terminal that pulls down a second stage. It uses file-creation telemetry rather than process command-line matching, so it complements existing command-line rules and still fires when the pasted command is obfuscated."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.004"
    mitre_technique_name = "User Execution: Malicious Copy and Paste"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry that records the writing process (principal.process.file.full_path) and the created path (target.file.full_path)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers and admins downloading installers or scripts to /tmp, package-manager helper scripts, CI/CD runners, configuration management agents, and vendor install scripts that stage files in /tmp before running them."
    tuning_guidance = "Add approved deployment and RMM binaries to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and build or jump hosts to %global_allowed_script_hosts. If CI/CD noise is high, scope exclusions per client by adding the runner user to %global_allowed_service_accounts."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(curl|wget|fetch)$/ nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/(\.[^\/]+|[^\/]+\.(sh|bash|py|pl|rb|elf|bin|run|so))$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1204.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_files = array_distinct($file.target.file.full_path)
    $downloader = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
