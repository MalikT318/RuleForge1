/*
  MITRE Technique : T1027.011 - Fileless Storage
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:56:26.647190+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_011_Linux_Shared_Memory_File_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of file creations in RAM-backed shared memory directories (/dev/shm, /run/shm) on a single Linux host within ten minutes. Individual writes to these directories are common, but many files created in a short window can indicate staging of payloads, tooling or data in fileless storage to evade disk-based scanning."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.011"
    mitre_technique_name = "Obfuscated Files or Information: Fileless Storage"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry (FILE_CREATION) with the principal process, user and hostname populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Browsers and Electron apps (Chromium/Firefox shared memory segments), PostgreSQL and other databases using POSIX shared memory, PulseAudio/PipeWire, container runtimes, MPI and HPC workloads, build systems using tmpfs scratch space, and configuration management or deployment agents."
    tuning_guidance = "Add legitimate writer binaries to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Raise the threshold (#file >= 10) on hosts running databases or HPC workloads. Extend the application-specific filename exclusion regex for noisy software."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(dev\/shm|run\/shm)\/./ nocase
    not $file.target.file.full_path = /^\/(dev\/shm|run\/shm)\/(\.org\.chromium\.|\.com\.google\.|pulse-shm-|sem\.|PostgreSQL\.|lttng-|ICE-)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1027.011")
    $primary_entity = array_distinct($host)
    $file_count = count($file.metadata.id)
    $created_paths = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 10
}
