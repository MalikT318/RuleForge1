/*
  MITRE Technique : T1553.005 - Mark-of-the-Web Bypass
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:06:18.602972+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_005_MOTW_SaveZoneInformation_Disabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of the Attachment Manager policy value SaveZoneInformation, which controls whether Windows writes the Zone.Identifier alternate data stream (Mark-of-the-Web) to downloaded files. Setting it to a non-enforcing value stops MOTW tagging, so SmartScreen and Office Protected View are bypassed for all later downloads. The rule fires on any write to this value except an explicit enforcing value of 2, in case the value data is not populated."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.005"
    mitre_technique_name = "Subvert Trust Controls: Mark-of-the-Web Bypass"
    log_prerequisites = "Requires Windows registry modification telemetry from EDR or Sysmon (Event ID 12/13), with the Policies\\Attachments key in scope for collection."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy or MDM baselines that deliberately configure Attachment Manager (for example, to suppress file-open warnings for internal file shares), software deployment and RMM tooling, and hardening or compliance scripts run by administrators."
    tuning_guidance = "Add approved deployment and configuration tooling to %global_allowed_admin_tools and approved administrator accounts to %global_allowed_admin_users. If the client manages this value through Group Policy, review the writing process (usually the Group Policy client service host) and the account, then allowlist by user or tool rather than disabling the rule. Treat writes by interactive user processes, script interpreters, or Office and browser child processes as high priority."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      $reg.target.registry.registry_key = /\\Policies\\Attachments\\SaveZoneInformation$/ nocase or
      (
        $reg.target.registry.registry_key = /\\Policies\\Attachments$/ nocase and
        $reg.target.registry.registry_value_name = "SaveZoneInformation" nocase
      )
    )
    not $reg.target.registry.registry_value_data = /^(2|0x0*2|DWORD \(0x0*2\))$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1553.005")
    $primary_entity = array_distinct($reg.principal.hostname)
    $acting_user = array_distinct($reg.principal.user.userid)
    $acting_process = array_distinct($reg.principal.process.file.full_path)
    $registry_key = array_distinct($reg.target.registry.registry_key)

  condition:
    $reg
}
