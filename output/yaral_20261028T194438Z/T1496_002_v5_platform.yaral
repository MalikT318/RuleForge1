/*
  MITRE Technique : T1496.002 - Bandwidth Hijacking
  Tactic(s)       : Impact
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:54:35.579836+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_002_High_Volume_Outbound_Flow_NonStandard_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a single outbound firewall flow from an internal source to an external destination on a non-standard (>=1024) port that carries a very large volume of sent data. This pattern is consistent with bandwidth hijacking such as proxyjacking or proxyware relaying, botnet DoS traffic, and torrent seeding. The detection uses only network-observable telemetry, so it is independent of the endpoint operating system. The platform is set to Windows per the engagement requirement, but a perimeter firewall cannot identify the source OS. Platform-specific variants (Linux, macOS, cloud) would need endpoint or cloud audit telemetry and are not covered by this rule."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.002"
    mitre_technique_name = "Resource Hijacking: Bandwidth Hijacking"
    log_prerequisites = "Requires perimeter firewall or proxy flow logs normalised to UDM NETWORK_FLOW with network.sent_bytes, principal.ip, target.ip and target.port populated. Flow records must be emitted at session close or at periodic intervals so that byte counts are present."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Offsite or cloud backup and replication jobs, large software or media uploads, video conferencing and streaming on high ports, game servers, content creators uploading to CDNs, legitimate peer-to-peer software distribution, and vulnerability scanners or authorised security tests."
    tuning_guidance = "Add known-good external destination domains to %global_allowed_domains. Raise or lower the sent_bytes threshold per client based on the baseline egress profile. If the client uses a dedicated backup or replication egress, exclude it by adding the source or destination to the relevant allow lists, or add a port exclusion. Internal-to-internal traffic is already excluded through %rfc1918_internal. Pair alerts with a per-host volume review to confirm sustained usage."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    $net.network.sent_bytes > 1073741824
    $net.target.port >= 1024
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1496.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
