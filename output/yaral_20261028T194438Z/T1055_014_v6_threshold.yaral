/*
  MITRE Technique : T1055.014 - VDSO Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:04:06.525921+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_014_Proc_Mem_Write_Volume_VDSO_Hijack {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Repeated writes to other processes' /proc/<pid>/mem pseudo-files from a single host within ten minutes. VDSO hijacking works by writing into a live process's memory, patching the vdso syscall stubs or GOT entries so the target process maps and runs a malicious shared object. A single write can be benign (debuggers, profilers), but a burst of writes to /proc/<pid>/mem, especially across several PIDs, indicates cross-process code injection. The rule uses file-modification telemetry, not process command lines, so it complements command-line detections."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.014"
    mitre_technique_name = "Process Injection: VDSO Hijacking"
    log_prerequisites = "Linux EDR or auditd file-write telemetry covering /proc (for example auditd watches on openat/write to /proc/*/mem) normalised to UDM FILE_MODIFICATION with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Interactive debuggers (gdb, lldb), live-patching and hot-fix agents, JIT or runtime instrumentation and profiling tools, crash-dump collectors, EDR or security agents performing memory inspection, and container or checkpoint/restore tooling (CRIU)."
    tuning_guidance = "Add approved debuggers, patching and profiling binaries to %global_allowed_admin_tools. Add EDR or other security agents to %global_allowed_security_tools. Add backup or checkpoint tooling to %global_allowed_backup_processes. Raise the #proc threshold on developer or build hosts where debugging is routine. Scale severity using $event_count and $targeted_mem_files in SOAR."

  events:
    $proc.metadata.event_type = "FILE_MODIFICATION"
    $proc.target.file.full_path = /^\/proc\/[0-9]+\/mem$/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path = /\/(gdb|gdbserver|lldb|strace|ltrace)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1055.014")
    $primary_entity = array_distinct($host)
    $writer_processes = array_distinct($proc.principal.process.file.full_path)
    $targeted_mem_files = array_distinct($proc.target.file.full_path)
    $users = array_distinct($proc.principal.user.userid)

  condition:
    #proc >= 3
}
