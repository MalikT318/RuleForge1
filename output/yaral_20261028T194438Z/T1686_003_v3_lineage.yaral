/*
  MITRE Technique : T1686.003 - Windows Host Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:32:52.097146+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_003_Firewall_Change_From_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, script interpreter or netsh instance referencing Windows Firewall configuration that was spawned by a parent process which should never administer the host firewall (Office applications, web server workers, database services, print spooler, PDF readers). The lineage is the primary signal. A broad firewall keyword check only ties it to this technique. It does not require specific flags, so it still fires on variations in syntax."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.003"
    mitre_technique_name = "Windows Host Firewall"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and command line populated (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web-based management consoles or installers hosted under IIS or Tomcat that legitimately open firewall ports; database installers or setup routines run by the database service; Office add-ins or macros in managed environments that deploy software; vendor print-driver installers launched through the spooler."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts. Review parent process names in the regex against the client's application estate and extend the list if needed (for example, in-house application servers)."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat\d*|php-cgi|sqlservr|mysqld|spoolsv|acrord32|acrobat)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|netsh|wscript|cscript|mshta|wmic)\.exe$/ nocase
    $proc.target.process.command_line = /(advfirewall|netsh.{0,40}firewall|NetFirewall|MpsSvc|FirewallPolicy|FirewallAPI|firewall\.cpl)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1686.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
