/*
  MITRE Technique : T1110.002 - Password Cracking
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:06:16.573946+00:00
  Reference       : https://attack.mitre.org/techniques/T1110/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1110_002_Privileged_Account_Password_Logon_External_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a successful password-based or NTLM logon to a privileged-looking or service-type directory account from a non-internal source address. This is an identity-plane detection of the RESULT of offline password cracking (use of a recovered plaintext credential). It does not depend on endpoint process or command-line telemetry, so it complements any cracking-tool process rule. The platform is Windows because the identity events come from Active Directory-style directory authentication."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1110.002"
    mitre_technique_name = "Brute Force: Password Cracking"
    log_prerequisites = "Requires identity provider or directory sign-in logs normalised to USER_LOGIN with principal.ip, target.user.userid, extensions.auth.mechanism and security_result.action populated for successful sign-ins."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Administrators working remotely over a VPN or from home without a registered egress address, third-party vendors with legitimate privileged access, cloud-hosted automation using service-type accounts, and travelling staff."
    tuning_guidance = "Add expected service accounts to %global_allowed_service_accounts, named administrators who legitimately sign in from outside to %global_allowed_admin_users, and approved external egress or jump-host addresses to %global_allowed_mgmt_sources. Adjust the account-name regex to match the client's naming convention for privileged and service accounts."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.security_result.action = "ALLOW"
    $auth.extensions.auth.mechanism = /^(USERNAME_PASSWORD|NTLM|NETWORK|REMOTE_INTERACTIVE)$/ nocase
    $auth.target.user.userid = /(admin|adm[_\-.]|svc|service|sql|backup|root|krbtgt)/ nocase
    $auth.principal.ip != ""
    not $auth.principal.ip in %rfc1918_internal
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1110.002")
    $primary_entity = array_distinct($auth.target.user.userid)
    $source_ips = array_distinct($auth.principal.ip)
    $target_hosts = array_distinct($auth.target.hostname)

  condition:
    $auth
}
