/*
  MITRE Technique : T1538 - Cloud Service Dashboard
  Tactic(s)       : Discovery
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:37:13.355944+00:00
  Reference       : https://attack.mitre.org/techniques/T1538
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1538_SaaS_Dashboard_Access_Setting_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a configuration change (SETTING_MODIFICATION) to a management dashboard, admin portal or console access, visibility or sharing setting in a SaaS or identity tenant. After stealing credentials, an adversary can relax portal restrictions or widen dashboard visibility so the GUI can be used for discovery of services, resources and security findings without making API calls. The rule looks at the resulting configuration state change, not at command lines, so it still fires when client-side logging is evaded."
    mitre_tactic = "Discovery"
    mitre_technique = "T1538"
    mitre_technique_name = "Cloud Service Dashboard"
    log_prerequisites = "Requires identity provider or SaaS directory audit logs normalised to UDM SETTING_MODIFICATION, with the changed setting populated in target.resource.name and the actor in principal.user.userid."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Authorised tenant administrators changing portal access policy, planned dashboard sharing for SOC or operations teams, onboarding or delegated-admin projects, automation that provisions dashboards, and tenant baseline or configuration-as-code deployments."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users, and add automation or deployment identities to %global_allowed_service_accounts. If a client's audit logs use different setting naming, extend the two target.resource.name regexes. For stricter coverage, raise severity when the actor is not a member of a privileged group."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.target.resource.name = /(dashboard|admin[ _-]?(portal|center|centre|console)|management[ _-]?(portal|console)|command[ _-]?center|service[ _-]?console)/ nocase
    $setting.target.resource.name = /(access|restrict|visibility|sharing|share|permission|allow|enable|disable|public)/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1538")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $source_ips = array_distinct($setting.principal.ip)
    $changed_setting = array_distinct($setting.target.resource.name)

  condition:
    $setting
}
