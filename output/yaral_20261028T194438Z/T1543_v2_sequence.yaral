/*
  MITRE Technique : T1543 - Create or Modify System Process
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:52:08.612365+00:00
  Reference       : https://attack.mitre.org/techniques/T1543
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_Container_Persistent_Workload_Then_Exec {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A single identity creates a persistence-capable Kubernetes workload (DaemonSet or CronJob) and then execs into a pod within ten minutes. This pattern fits an adversary who deploys a node-wide or recurring system process and then interacts with the container to stage or verify the payload."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543"
    mitre_technique_name = "Create or Modify System Process"
    log_prerequisites = "Requires Kubernetes API server audit logs ingested and normalised to UDM, with the request URI populated in target.url and the caller identity in principal.user.userid. Audit policy must record create requests and pod exec subresource requests at Metadata level or higher."
    platform = "Containers"
    log_source = "container"
    false_positives = "Platform engineers deploying a DaemonSet or CronJob and immediately exec-ing into a pod to validate it, GitOps or CI/CD identities that are not yet allowlisted, and cluster add-on installers such as logging agents, CNI plugins and monitoring agents that are followed by troubleshooting."
    tuning_guidance = "Add CI/CD, GitOps and operator identities to %global_allowed_service_accounts. Add named platform administrators to %global_allowed_admin_users. If a client's audit pipeline records the request path in a different field, adjust the target.url regexes to match."

  events:
    $create.metadata.event_type = "RESOURCE_CREATION"
    $create.target.url = /\/apis\/(apps\/v1\/namespaces\/[^\/]+\/daemonsets|batch\/v1(beta1)?\/namespaces\/[^\/]+\/cronjobs)(\/|\?|$)/ nocase
    $create.principal.user.userid != ""
    $create.principal.user.userid = $user
    not $create.principal.user.userid in %global_allowed_service_accounts
    not $create.principal.user.userid in %global_allowed_admin_users

    $exec.metadata.event_type = "USER_RESOURCE_ACCESS"
    $exec.target.url = /\/api\/v1\/namespaces\/[^\/]+\/pods\/[^\/]+\/exec(\?|$)/ nocase
    $exec.principal.user.userid = $user
    not $exec.principal.user.userid in %global_allowed_service_accounts
    not $exec.principal.user.userid in %global_allowed_admin_users

    $create.metadata.event_timestamp.seconds <= $exec.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1543")
    $primary_entity = array_distinct($user)
    $created_workload_urls = array_distinct($create.target.url)
    $exec_target_urls = array_distinct($exec.target.url)
    $source_ips = array_distinct($exec.principal.ip)
    $exec_count = count($exec.metadata.id)

  condition:
    $create and $exec
}
