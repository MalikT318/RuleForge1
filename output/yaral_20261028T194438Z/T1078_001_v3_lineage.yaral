/*
  MITRE Technique : T1078.001 - Default Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:29:27.847643+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_001_ESXi_Root_Shell_From_Mgmt_Daemon {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter running as the built-in root account and spawned by a hypervisor management or service daemon (host agent, reverse proxy, CIM/WS-Man broker, SNMP, SLP) instead of the normal SSH daemon or console. This lineage anomaly suggests the default root account or a management-plane service was abused to get a command shell, rather than an interactive administrator session."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.001"
    mitre_technique_name = "Valid Accounts: Default Accounts"
    log_prerequisites = "ESXi shell and host-agent logs forwarded to Chronicle and parsed into UDM PROCESS_LAUNCH events with principal.process.file.full_path (parent), target.process.file.full_path (child) and principal.user.userid populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Vendor or backup plug-ins that run helper scripts from the host agent; management or monitoring integrations that invoke shell wrappers through the host agent or CIM broker; lifecycle and patching tooling run from the management plane; hardware vendor health-check scripts launched by the CIM broker."
    tuning_guidance = "Add approved parent daemons or wrapper binaries to %global_allowed_script_hosts or %global_allowed_admin_tools. Review the parent_process outcome field to identify which daemon spawned the shell. Where a known integration is noisy, allowlist its parent path rather than loosening the child interpreter match."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.user.userid = "root" nocase
    $proc.principal.process.file.full_path = /\/(hostd|hostd-worker|vpxa|rhttpproxy|sfcbd|sfcb-[A-Za-z_]+|openwsman|slpd|snmpd|vmsyslogd|vobd)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|ash|bash|dash|busybox|python|python3|perl)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1078.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $account = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
