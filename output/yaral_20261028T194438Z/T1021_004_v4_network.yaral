/*
  MITRE Technique : T1021.004 - SSH
  Tactic(s)       : Lateral Movement
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:40:40.862724+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_004_ESXi_Inbound_SSH_From_External_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network connection to the SSH service (TCP/22) on an ESXi host from a source address outside internal address space and outside approved management sources. Attackers with valid credentials use externally reachable ESXi SSH, often enabled just before ransomware staging, to log in and pivot. This rule observes the network side and complements endpoint process and command-line detections."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.004"
    mitre_technique_name = "Remote Services: SSH"
    log_prerequisites = "Requires network connection telemetry (firewall, flow or host firewall logs) normalised to NETWORK_CONNECTION with the ESXi host populated as target.hostname, alongside ESXi host logs. Populate %rfc1918_internal and %global_allowed_mgmt_sources for each client."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators connecting through a VPN or NAT egress address that is not yet allowlisted, vendor or MSP remote support from public addresses, authorised external vulnerability scanners, cloud-hosted jump hosts or bastions."
    tuning_guidance = "Add approved bastion, VPN egress and MSP source addresses to %global_allowed_mgmt_sources. Confirm %rfc1918_internal covers every client's internal ranges. Where ESXi SSH should never be reachable from outside, raise severity and route to the SOAR containment playbook."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 22
    $net.target.hostname != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.hostname in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1021.004")
    $primary_entity = array_distinct($net.target.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
