/*
  MITRE Technique : T1218.007 - Msiexec
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:49:46.117263+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_007_Msiexec_External_Connection_Then_Child_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects msiexec.exe making an outbound connection to an external address and then, on the same host within 10 minutes, spawning a script host, shell or proxy-execution LOLBin as a child. This pattern is consistent with msiexec fetching a remote MSI or DLL and running its payload. The rule uses network and process-lineage behaviour, not command-line matching, so it adds coverage beyond a command-line rule."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.007"
    mitre_technique_name = "System Binary Proxy Execution: Msiexec"
    log_prerequisites = "Requires EDR or Sysmon process-launch telemetry with parent process populated, plus network connection telemetry with the initiating process path (for example Sysmon Event ID 3)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software deployment and patching agents that download MSI packages and run custom actions through cmd or PowerShell; vendor installers that fetch content during installation; RMM tooling; IT-run installation scripts."
    tuning_guidance = "Add approved deployment or RMM child binaries to %global_allowed_admin_tools. Add known-good vendor and update domains to %global_allowed_domains. Add approved automation accounts to %global_allowed_service_accounts. If installer noise remains, narrow the child process regex or raise the window sensitivity per client."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\msiexec\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    $net.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\msiexec\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin)\.exe$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    $net.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.007")
    $primary_entity = array_distinct($hostname)
    $destination_ips = array_distinct($net.target.ip)
    $child_processes = array_distinct($proc.target.process.file.full_path)
    $child_command_lines = array_distinct($proc.target.process.command_line)
    $affected_users = array_distinct($proc.principal.user.userid)

  condition:
    $net and $proc
}
