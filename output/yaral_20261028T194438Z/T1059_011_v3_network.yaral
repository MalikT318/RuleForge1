/*
  MITRE Technique : T1059.011 - Lua
  Tactic(s)       : Execution
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:22:37.177027+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_011_Lua_Script_Download_External_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP request to an external destination for a Lua script or compiled Lua bytecode (.lua / .luac), as seen in perimeter proxy or firewall URL logs. Adversaries stage Lua payloads over HTTP for embedded or standalone interpreters. This is the network-side view, additive to endpoint command-line coverage."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.011"
    mitre_technique_name = "Command and Scripting Interpreter: Lua"
    log_prerequisites = "Requires firewall or web proxy logs with URL inspection (SSL decryption where applicable) that populate network.http fields and target.url."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Games, game-engine and embedded-device updaters that fetch Lua assets, OpenResty/nginx-Lua or Redis/Wireshark/NMAP script distribution, developer package managers (e.g. LuaRocks) and IoT firmware or config pulls."
    tuning_guidance = "Add trusted vendor or package-repository domains to %global_allowed_domains. Verify that %rfc1918_internal is populated for the tenant. Correlate hits with endpoint telemetry for lua interpreter execution on the requesting host."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\.luac?([?#]|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1059.011")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
