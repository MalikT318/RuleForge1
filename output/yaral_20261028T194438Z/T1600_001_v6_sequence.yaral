/*
  MITRE Technique : T1600.001 - Reduce Key Space
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:07:44.422771+00:00
  Reference       : https://attack.mitre.org/techniques/T1600/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_001_Mgmt_Access_Then_Weak_Crypto_Session {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a management-plane connection (SSH, Telnet, HTTPS admin ports) to a network device from a source outside the approved management list, followed within 10 minutes by a TLS/SSL session terminating on the same device that negotiated a weak cipher (export, NULL, RC4, DES, anonymous) or a deprecated protocol version (SSLv3, TLS 1.0/1.1). This is the network-observable result of an adversary reducing cipher strength or key space on a compromised device. The firewall cannot see the configuration change itself, so the rule detects the unauthorised access and the resulting downgrade in negotiated crypto."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1600.001"
    mitre_technique_name = "Weaken Encryption: Reduce Key Space"
    log_prerequisites = "Firewall, proxy or perimeter logs that record connections to device management ports, with TLS inspection or session metadata populating network.tls.cipher or network.tls.version. Requires target.ip and target.port on NETWORK_CONNECTION events."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legacy clients or appliances that legitimately negotiate old TLS versions or weak ciphers after an authorised admin session. Unlisted jump hosts or new admin workstations. Vulnerability scanners or compliance checks probing weak ciphers. Maintenance windows where cipher suites are deliberately changed."
    tuning_guidance = "Add approved admin jump hosts and management subnets to %global_allowed_mgmt_sources. Add scanner sources to %global_allowed_scanners. Adjust the management port list or the weak cipher and version regexes to match the client's baseline. If legacy TLS is widespread, remove the version clause and keep only the cipher clause."

  events:
    $mgmt.metadata.event_type = "NETWORK_CONNECTION"
    (
      $mgmt.target.port = 22 or
      $mgmt.target.port = 23 or
      $mgmt.target.port = 443 or
      $mgmt.target.port = 8443
    )
    not $mgmt.principal.ip in %global_allowed_mgmt_sources
    $mgmt.target.ip = $device

    $tls.metadata.event_type = "NETWORK_CONNECTION"
    (
      $tls.network.tls.cipher = /(export|null|rc4|des|anon|md5)/ nocase or
      $tls.network.tls.version = /^(SSL.*|TLS\s?v?1(\.[01])?)$/ nocase
    )
    not $tls.principal.ip in %global_allowed_scanners
    $tls.target.ip = $device

    $mgmt.metadata.event_timestamp.seconds <= $tls.metadata.event_timestamp.seconds

  match:
    $device over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1600.001")
    $primary_entity = array_distinct($device)
    $mgmt_source_ips = array_distinct($mgmt.principal.ip)
    $mgmt_ports = array_distinct($mgmt.target.port)
    $weak_ciphers = array_distinct($tls.network.tls.cipher)
    $tls_versions = array_distinct($tls.network.tls.version)
    $weak_session_count = count($tls.metadata.id)

  condition:
    $mgmt and $tls
}
