/*
  MITRE Technique : T1601.002 - Downgrade System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:15:02.827941+00:00
  Reference       : https://attack.mitre.org/techniques/T1601/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_002_Downgrade_Image_External_TFTP_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network device or internal host opening a TFTP session (UDP/69) to an external address. TFTP is the usual protocol for pulling an operating system image onto an embedded network device. A transfer to or from a non-internal destination suggests an adversary staging an older, weaker system image for a downgrade. The rule keys on the protocol and destination pattern, not on image filenames or vendors."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1601.002"
    mitre_technique_name = "Modify System Image: Downgrade System Image"
    log_prerequisites = "Firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with target.ip and target.port populated. The firewall must log permitted and denied UDP sessions that cross the perimeter."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Planned firmware upgrades by network engineers pulling images from a vendor or staging server, legacy PXE or network-boot setups using an external TFTP host, lab or test devices, and managed service providers performing device maintenance."
    tuning_guidance = "Add approved management or staging source addresses to %global_allowed_mgmt_sources. Add sanctioned maintenance-window source accounts or hosts to the same list used by the client. Correlate hits with change tickets. Clients that have no legitimate external TFTP use can raise severity to Critical."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1601.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
