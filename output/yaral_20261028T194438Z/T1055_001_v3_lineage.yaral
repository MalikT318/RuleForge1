/*
  MITRE Technique : T1055.001 - Dynamic-link Library Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:46:06.208170+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_001_Unexpected_Parent_Spawns_DLL_Loader_Or_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process-lineage anomaly in which an Office application, web server worker, print spooler, or database service spawns a DLL-loading LOLBin (rundll32, regsvr32) or a shell/script interpreter. These parents have no routine reason to start such children. The lineage is a common sign of code running inside a hijacked or injected host process, including DLL injection and its post-exploitation follow-on. The rule matches on parent and child image names only, not command-line content, so it complements command-line detections for this technique."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.001"
    mitre_technique_name = "Process Injection: Dynamic-link Library Injection"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry (EDR, Sysmon Event ID 1, or Security Event 4688 with parent process name populated) normalised to UDM PROCESS_LAUNCH with principal.process.file.full_path (parent) and target.process.file.full_path (child)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office add-ins or macros in legitimate line-of-business workflows that launch cmd or PowerShell; SQL Server jobs using xp_cmdshell for approved maintenance; IIS or PHP applications that shell out for report generation or image processing; print drivers or print-management software that call rundll32 from the spooler; software installers that launch regsvr32 from a web or database service context; admin troubleshooting on servers."
    tuning_guidance = "Add approved parent binaries (for example a known line-of-business web application host) to %global_allowed_script_hosts or %global_allowed_admin_tools. Add EDR/AV agents that spawn helpers from these parents to %global_allowed_security_tools. If a specific server role legitimately uses the lineage, narrow the parent regex for that tenant instead of disabling the rule. Raise severity for server-class assets that hold web or database roles."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|spoolsv|sqlservr|httpd|nginx|php-cgi|php|tomcat\d*)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(rundll32|regsvr32|cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
