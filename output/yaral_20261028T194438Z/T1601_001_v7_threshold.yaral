/*
  MITRE Technique : T1601.001 - Patch System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:13:55.025369+00:00
  Reference       : https://attack.mitre.org/techniques/T1601/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_001_Repeated_Image_Transfer_Protocol_Sessions {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single source opens repeated TFTP (UDP/69) or FTP control (TCP/21) sessions within 10 minutes. These are the classic protocols for pushing or pulling network device OS images. A single session is normal; repeated sessions from one source suggest an adversary staging, retrieving or replacing a device image, or a device repeatedly fetching a tampered image for a future boot."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1601.001"
    mitre_technique_name = "Modify System Image: Patch System Image"
    log_prerequisites = "Firewall or perimeter connection and flow logs that populate principal.ip, target.ip and target.port. TFTP and FTP traffic to and from network device management segments must traverse a logging enforcement point."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Planned firmware or IOS upgrade windows, network configuration backup and orchestration tooling, PXE or zero-touch provisioning servers, lab or staging networks, legacy file transfer jobs."
    tuning_guidance = "Add approved network management, provisioning and backup server addresses to %global_allowed_mgmt_sources. Raise the #net threshold in noisy environments, or schedule suppression for approved change windows. Scope firewall sensors to management-plane segments where possible."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 69 or $net.target.port = 21)
    $net.principal.ip = $src_ip
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1601.001")
    $primary_entity = array_distinct($src_ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 5
}
