/*
  MITRE Technique : T1218.008 - Odbcconf
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:51:40.913436+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_008_Odbcconf_Unexpected_Parent_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects odbcconf.exe launched by a parent process that should never spawn it: Office applications, web server or application server workers, database services, the print spooler, WMI provider host, or script hosts. Legitimate ODBC configuration is performed by installers, administrators or deployment tooling, not by document, web or database processes. Detection is based on process lineage only, not on odbcconf command-line content, so it complements command-line rules for REGSVR abuse."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.008"
    mitre_technique_name = "System Binary Proxy Execution: Odbcconf"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry (EDR, Sysmon Event ID 1 or Security Event 4688 with parent process populated) normalised to UDM PROCESS_LAUNCH with principal.process (parent) and target.process (child) paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers or database client setup scripts launched via a script host (wscript/cscript); RMM or deployment agents configuring ODBC DSNs; database administrators using a SQL service-launched maintenance job; legacy line-of-business applications that configure ODBC from an Office macro."
    tuning_guidance = "Add approved deployment or RMM parent binaries to %global_allowed_admin_tools. Add approved script-hosting parents or automation hosts to %global_allowed_script_hosts. Add known ODBC-provisioning service accounts to %global_allowed_service_accounts. If a client legitimately provisions DSNs from a specific parent, exclude that parent by executable name rather than install path."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\odbcconf\.exe$/ nocase
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|onenote|visio|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|sqlservr|spoolsv|wmiprvse|wscript|cscript|mshta)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.008")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
