/*
  MITRE Technique : T1684.002 - Email Spoofing
  Tactic(s)       : Stealth
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:33:58.549362+00:00
  Reference       : https://attack.mitre.org/techniques/T1684/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1684_002_Email_From_Domain_Mismatch_Envelope_And_ReplyTo {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an email transaction where the header From domain differs from both the envelope sender (bounce address) domain and the Reply-To domain. This pattern is typical of spoofed sender identity, where the displayed sender is forged and replies are redirected to an attacker-controlled mailbox."
    mitre_tactic = "Stealth"
    mitre_technique = "T1684.002"
    mitre_technique_name = "Email Spoofing"
    log_prerequisites = "Requires Microsoft 365 or Google Workspace mail audit or message-trace logs normalised to UDM EMAIL_TRANSACTION, with network.email.from, network.email.bounce_address and network.email.reply_to populated."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Bulk mail and marketing platforms, CRM and ticketing systems, helpdesk tools, mailing-list software, and SaaS notification services that send on behalf of a brand with a different envelope and Reply-To domain. Legitimate third-party senders authorised through SPF or DKIM delegation."
    tuning_guidance = "Add known-good sending domains (approved marketing, ticketing and SaaS platforms) to %global_allowed_domains. Add automation or shared-mailbox senders to %global_allowed_service_accounts. Raise severity for recipients in high-risk groups, such as finance and executives, in the SOAR playbook."

  events:
    $mail.metadata.event_type = "EMAIL_TRANSACTION"
    $mail.network.email.from != ""
    $mail.network.email.bounce_address != ""
    $mail.network.email.reply_to != ""

    $from_domain = strings.to_lower(re.capture($mail.network.email.from, "@([^>\\s]+)"))
    $bounce_domain = strings.to_lower(re.capture($mail.network.email.bounce_address, "@([^>\\s]+)"))
    $reply_domain = strings.to_lower(re.capture($mail.network.email.reply_to, "@([^>\\s]+)"))

    $from_domain != ""
    $bounce_domain != ""
    $reply_domain != ""
    $from_domain != $bounce_domain
    $from_domain != $reply_domain

    not $from_domain in %global_allowed_domains
    not $bounce_domain in %global_allowed_domains
    not $mail.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1684.002")
    $primary_entity = array_distinct($mail.network.email.from)
    $envelope_sender = array_distinct($mail.network.email.bounce_address)
    $reply_to_address = array_distinct($mail.network.email.reply_to)
    $email_subject = array_distinct($mail.network.email.subject)
    $sender_ip = array_distinct($mail.principal.ip)

  condition:
    $mail
}
