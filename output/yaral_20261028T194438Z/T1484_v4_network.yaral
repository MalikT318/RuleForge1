/*
  MITRE Technique : T1484 - Domain or Tenant Policy Modification
  Tactic(s)       : Defense Impairment, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:31:12.035984+00:00
  Reference       : https://attack.mitre.org/techniques/T1484
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1484_Network_Tenant_Policy_Write_API {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a state-changing HTTP request (POST/PATCH/PUT/DELETE) from an internal Windows host to an external identity-management API path that configures domain federation or trust, cross-tenant access policy, or conditional access policy. This is the network-side view of domain or tenant policy tampering (for example, adding a federated domain or loosening cross-tenant trust). It is independent of the process or command line used on the endpoint, so it still fires if the attacker changes tooling or scripting method."
    mitre_tactic = "Defense Impairment, Privilege Escalation"
    mitre_technique = "T1484"
    mitre_technique_name = "Domain or Tenant Policy Modification"
    log_prerequisites = "Requires NETWORK_HTTP telemetry with target.url and network.http.method populated, from a TLS-inspecting proxy, secure web gateway or EDR network sensor on Windows hosts. Identity-provider audit logs alone do not emit NETWORK_HTTP, so this rule only works where URL-level web telemetry is also ingested for the tenant. Without that telemetry it will not fire."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Authorised identity administrators or IaC pipelines changing federation, cross-tenant or conditional access settings. Planned domain onboarding or migration projects. Identity governance and posture-management tooling that writes policy via API."
    tuning_guidance = "Add approved admin accounts to %global_allowed_admin_users and automation identities to %global_allowed_service_accounts. Run in alert-only mode for 14 days and review which accounts and hosts legitimately change tenant policy. Remove path alternatives from the URL regex if a policy type is changed routinely in your environment."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(POST|PATCH|PUT|DELETE)$/ nocase
    $http.target.url = /\/(domains\/[^\/?#]+\/federationConfiguration|directory\/federationConfigurations|policies\/crossTenantAccessPolicy|identity\/conditionalAccess\/policies|domainFederation|setDomainAuthentication)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.principal.user.userid in %global_allowed_admin_users
    not $http.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1484")
    $primary_entity = array_distinct($http.principal.hostname)
    $acting_users = array_distinct($http.principal.user.userid)
    $requested_urls = array_distinct($http.target.url)
    $destination_ips = array_distinct($http.target.ip)
    $http_methods = array_distinct($http.network.http.method)

  condition:
    $http
}
