/*
  MITRE Technique : T1553.003 - SIP and Trust Provider Hijacking
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:02:51.817654+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_003_SIP_Trust_Provider_Tamper_From_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, script interpreter or registry utility launched by an unexpected parent (Office application, web server, print spooler or database service) whose command line references SIP or trust provider registry locations and DLL function values (CryptSIPDll*, Cryptography OID EncodingType, Providers Trust FinalPolicy). This pattern indicates SIP and trust provider hijacking to subvert Authenticode signature validation, launched from a likely-compromised service or document."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.003"
    mitre_technique_name = "Subvert Trust Controls: SIP and Trust Provider Hijacking"
    log_prerequisites = "Requires Windows process launch telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Application installers or vendor update routines launched by a database or web service that register custom SIP or trust providers (code-signing and PKI products), Office macros or add-ins used by legitimate PKI or document-signing software, and administrators running trust configuration scripts through a web-based management console."
    tuning_guidance = "Add approved deployment or PKI tooling parent processes to %global_allowed_admin_tools, approved script-hosting parents to %global_allowed_script_hosts, and known administrator accounts to %global_allowed_admin_users. If a client legitimately runs signing software from a database or web service parent, exclude that parent path through the reference lists rather than editing the regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|w3wp|httpd|nginx|tomcat\d*|php-cgi|spoolsv|sqlservr|mysqld|postgres|oracle)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|reg|regedit)\.exe$/ nocase
    $proc.target.process.command_line = /(CryptSIPDll(GetSignedDataMsg|PutSignedDataMsg|RemoveSignedDataMsg|CreateIndirectData|VerifyIndirectData|IsMyFileType2?|GetCaps)|Cryptography\\+OID\\+EncodingType|Cryptography\\+Providers\\+Trust|Trust\\+FinalPolicy|\\FinalPolicy\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1553.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
