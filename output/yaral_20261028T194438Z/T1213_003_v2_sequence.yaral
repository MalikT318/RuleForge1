/*
  MITRE Technique : T1213.003 - Code Repositories
  Tactic(s)       : Collection
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:26:19.520418+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_003_External_Login_Then_Repo_Bulk_Archive_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A user logs in to a SaaS code-repository service from a non-internal source address and, within 10 minutes, repeatedly accesses repository clone, fetch or archive/download endpoints. This pattern suggests bulk collection of source code or embedded secrets using a hijacked or abused account."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.003"
    mitre_technique_name = "Data from Information Repositories: Code Repositories"
    log_prerequisites = "Requires SaaS audit logs from the code-hosting platform, normalised to UDM USER_LOGIN and USER_RESOURCE_ACCESS with principal.user.userid, principal.ip and target.url populated."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Developers working remotely or on VPN who clone several repositories after login; CI/CD and build automation using personal tokens; onboarding of new engineers; repository migration or backup jobs; security code-scanning tools."
    tuning_guidance = "Add automation and integration identities to %global_allowed_service_accounts. Add trusted admin or release-engineering accounts to %global_allowed_admin_users. Add approved scanners to %global_allowed_scanners. Raise or lower the #repo threshold in the condition to match the client's normal clone volume."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.principal.user.userid = $user
    $login.principal.ip != ""
    not $login.principal.ip in %rfc1918_internal
    not $login.principal.user.userid in %global_allowed_service_accounts
    not $login.principal.user.userid in %global_allowed_admin_users

    $repo.metadata.event_type = "USER_RESOURCE_ACCESS"
    $repo.principal.user.userid = $user
    $repo.target.url = /(git-upload-pack|\/archive\/|\/zipball\/|\/tarball\/|\/clone(\/|\?|$)|\.git(\/|$)|\.(zip|tar\.gz|tgz)$)/ nocase
    not $repo.principal.user.userid in %global_allowed_service_accounts
    not $repo.principal.user.userid in %global_allowed_admin_users
    not $repo.principal.ip in %global_allowed_scanners

    $login.metadata.event_timestamp.seconds <= $repo.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1213.003")
    $primary_entity = array_distinct($user)
    $source_ips = array_distinct($login.principal.ip)
    $accessed_urls = array_distinct($repo.target.url)
    $repo_access_count = count($repo.metadata.id)

  condition:
    $login and #repo >= 3
}
