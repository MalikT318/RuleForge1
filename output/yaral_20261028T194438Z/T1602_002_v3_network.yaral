/*
  MITRE Technique : T1602.002 - Network Device Configuration Dump
  Tactic(s)       : Collection
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:20:00.954423+00:00
  Reference       : https://attack.mitre.org/techniques/T1602/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_002_External_Access_To_Device_Config_Services {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects connections from non-internal sources to network device management services commonly abused to dump device configurations: SNMP (161), TFTP (69) and Cisco Smart Install (4786). Perimeter or firewall telemetry showing an external host reaching these services indicates attempted configuration collection or exposure of the management plane."
    mitre_tactic = "Collection"
    mitre_technique = "T1602.002"
    mitre_technique_name = "Data from Configuration Repository: Network Device Configuration Dump"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip and target.port populated. Allowed connections must be logged, not only denied ones."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "External vulnerability scanners and attack-surface monitoring services; managed service provider or carrier SNMP monitoring over public addresses; remote-site NMS platforms reaching devices over non-RFC1918 transit; internet-wide scanning noise hitting exposed management ports."
    tuning_guidance = "Add authorised monitoring and NMS source addresses to %global_allowed_mgmt_sources. Add approved scanner sources to %global_allowed_scanners. Confirm %rfc1918_internal covers the customer's internal space. Any hit on an internet-exposed device should also be handled as an exposure finding."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 161 or
      $net.target.port = 69 or
      $net.target.port = 4786
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1602.002")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
