/*
  MITRE Technique : T1102.002 - Bidirectional Communication
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:55:40.901346+00:00
  Reference       : https://attack.mitre.org/techniques/T1102/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1102_002_Linux_WebClient_Drops_Tasking_File {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a network-capable utility or interpreter (curl, wget, python, perl, ruby, node, php) creating a script or hidden file in a world-writable staging location (/dev/shm, /tmp, /var/tmp). Implants that use a legitimate web service for bidirectional C2 commonly write fetched tasking or command output to these locations. This rule detects the resulting file artifact rather than the command line, so it still fires if command-line logging is evaded or the invocation is obfuscated."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1102.002"
    mitre_technique_name = "Web Service: Bidirectional Communication"
    log_prerequisites = "Linux EDR or auditd file telemetry that populates principal.process.file.full_path and target.file.full_path on FILE_CREATION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Installer and bootstrap scripts that download helper scripts to /tmp; CI/CD runners and build agents; configuration management (Ansible, Puppet, Chef) staging temporary modules; developers running Python or Node tooling that writes temp scripts; package post-install hooks; cloud-init or provisioning downloads."
    tuning_guidance = "Add approved deployment, CI, and configuration-management binaries to %global_allowed_admin_tools. Add approved agents to %global_allowed_security_tools. Add automation accounts to %global_allowed_service_accounts. If build servers are noisy, add the interpreter or runner path to %global_allowed_admin_tools. Raise severity for hosts exposed to the internet or for activity in /dev/shm."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(curl|wget|python[0-9.]*|perl|ruby|node|php)$/ nocase
    $file.target.file.full_path = /^\/(dev\/shm\/.+|(tmp|var\/tmp)\/(.*\/)?(\.[^\/]+|[^\/]+\.(sh|py|pl|rb|php)))$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1102.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $dropped_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
