/*
  MITRE Technique : T1010 - Application Window Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:18:04.585720+00:00
  Reference       : https://attack.mitre.org/techniques/T1010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1010_Linux_Window_Enumeration_Then_Temp_Output_Staging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a window-enumeration utility (window tree, window list, active-window or client-list queries) run on a Linux host, followed within 10 minutes by the same user's shell or interpreter writing a file into a world-writable staging directory (/tmp, /var/tmp, /dev/shm). The pairing suggests window discovery results are being captured for later review or exfiltration, rather than interactive desktop use. This is a sequence rule and adds coverage beyond single-event command-line matching."
    mitre_tactic = "Discovery"
    mitre_technique = "T1010"
    mitre_technique_name = "Application Window Discovery"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that populates PROCESS_LAUNCH (with command line) and FILE_CREATION events, including principal.user.userid, principal.hostname and the acting process path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Desktop automation and GUI test frameworks, accessibility tooling, kiosk or digital-signage management scripts, window-manager helper scripts, and developers debugging X11 applications who redirect output to /tmp."
    tuning_guidance = "Add approved automation parents or tooling paths to %global_allowed_admin_tools, test or kiosk service accounts to %global_allowed_service_accounts, and approved backup or imaging processes to %global_allowed_backup_processes. Hosts without a graphical session should rarely produce this activity, so consider raising severity on headless servers."

  events:
    $win.metadata.event_type = "PROCESS_LAUNCH"
    $win.target.process.file.full_path = /\/(xwininfo|wmctrl|xdotool|xprop)$/ nocase
    $win.target.process.command_line = /(xwininfo\s.*-(root|tree|all)|wmctrl\s.*-[a-z]*[lp]|xdotool\s+(search|getactivewindow|getwindowname|getwindowfocus)|xprop\s.*-root.*_NET_(CLIENT_LIST|ACTIVE_WINDOW))/ nocase
    not $win.principal.process.file.full_path in %global_allowed_admin_tools
    not $win.principal.user.userid in %global_allowed_service_accounts
    $win.principal.hostname = $host
    $win.principal.user.userid = $user

    $stage.metadata.event_type = "FILE_CREATION"
    $stage.principal.process.file.full_path = /\/(bash|sh|dash|zsh|python[0-9.]*|perl|ruby)$/ nocase
    $stage.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/([^\/]*\.(txt|log|out|dat|lst|json|tmp)|\.[^\/]+)$/ nocase
    not $stage.principal.process.file.full_path in %global_allowed_backup_processes
    not $stage.principal.user.userid in %global_allowed_service_accounts
    $stage.principal.hostname = $host
    $stage.principal.user.userid = $user

    $win.metadata.event_timestamp.seconds <= $stage.metadata.event_timestamp.seconds

  match:
    $host, $user over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1010")
    $primary_entity = array_distinct($host)
    $acting_user = array_distinct($user)
    $window_commands = array_distinct($win.target.process.command_line)
    $staged_files = array_distinct($stage.target.file.full_path)
    $enumeration_count = count($win.metadata.id)

  condition:
    $win and $stage
}
