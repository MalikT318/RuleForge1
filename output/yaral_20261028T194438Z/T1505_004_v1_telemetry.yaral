/*
  MITRE Technique : T1505.004 - IIS Components
  Tactic(s)       : Persistence
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:31:07.782110+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_004_IIS_Component_DLL_Dropped_To_IIS_Paths {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a DLL inside IIS installation (inetsrv) or web content (inetpub) directories by a process other than a trusted installer or servicing component. Malicious ISAPI extensions, ISAPI filters and native IIS modules must exist as DLLs on disk before they can be registered, so this catches the file artifact left by the persistence step whatever tool or command line was used to stage it."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.004"
    mitre_technique_name = "Server Software Component: IIS Components"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) covering IIS servers, with the creating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate IIS module installs (URL Rewrite, ARR, WebDeploy, WAF or APM agents), Windows servicing and cumulative updates, application deployments that publish .NET assemblies to inetpub, and admin-driven ISAPI installs."
    tuning_guidance = "Add approved deployment and installer binaries to %global_allowed_admin_tools and approved deployment accounts to %global_allowed_admin_users. Investigate any hit where the creating process is w3wp.exe, a script host, or a remote shell. Correlate with later changes to applicationHost.config."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(inetsrv|inetpub)\\.*\.dll$/ nocase
    not $file.target.file.full_path = /\\inetpub\\temp\\/ nocase
    not $file.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|msiexec|wusa|wuauclt|musnotification|usoclient)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1505.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_dll = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
