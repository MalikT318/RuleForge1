/*
  MITRE Technique : T1505.001 - SQL Stored Procedures
  Tactic(s)       : Persistence
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:25:43.121219+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_001_SQL_Server_Process_Drops_Executable_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the SQL Server engine or SQL Agent service process creating an executable, library, or script/web-shell file on disk. The database engine normally writes only data, log, backup, and trace files. A DLL, EXE, script, or web page written by the engine is the file-system result of stored procedure abuse, such as xp_cmdshell output redirection, CLR assembly export, OLE automation file writes, or Agent job payload staging. The rule pivots on the file artifact rather than the command line, so it still fires when command-line logging is evaded or obfuscated."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.001"
    mitre_technique_name = "Server Software Component: SQL Stored Procedures"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with the creating process path populated in principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "SQL Server patching or in-place upgrades; legitimate CLR assembly deployment that exports DLLs; third-party SQL extensions or monitoring agents that load helper DLLs through the engine; developer or DBA scripts that export .bat or .ps1 maintenance files; SSIS or Agent jobs that generate script files by design."
    tuning_guidance = "Add approved deployment or patching process paths to %global_allowed_admin_tools. Where a server legitimately generates scripts (for example a DBA jump host), add a target-path exclusion for that specific directory on that client. Narrow or widen the extension list to match the client's SQL estate. Review the sqlservr.exe or sqlagent.exe parent and the creating user before closing."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(sqlservr|sqlagent)\.exe$/ nocase
    $file.target.file.full_path = /\.(dll|exe|sys|scr|ps1|psm1|bat|cmd|vbs|vbe|js|jse|hta|wsf|asp|aspx|ashx|asmx|php|jsp)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1505.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $creating_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
