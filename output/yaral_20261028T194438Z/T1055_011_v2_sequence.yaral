/*
  MITRE Technique : T1055.011 - Extra Window Memory Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:57:29.338174+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_011_Handle_Open_Then_Injection_Into_Shell_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a process that opens a handle to the Windows shell host (explorer.exe, the classic Extra Window Memory injection target via the Shell_TrayWnd window class) and then performs a process injection into it within five minutes. Uses process-access and injection telemetry rather than command lines, so it complements command-line detections for this technique."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.011"
    mitre_technique_name = "Process Injection: Extra Window Memory Injection"
    log_prerequisites = "Requires endpoint telemetry that reports process-access (handle open) events and remote-thread or memory-write injection events with source and target process paths, for example Sysmon Event IDs 8 and 10 or equivalent EDR sensors."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Accessibility and screen-reader software, shell extensions and desktop customisation tools, application-compatibility shims, endpoint security or DLP agents not yet allowlisted, remote support tooling that interacts with the desktop session."
    tuning_guidance = "Add EDR/AV agent paths to %global_allowed_security_tools, backup or imaging agents to %global_allowed_backup_processes, and approved IT or accessibility tooling to %global_allowed_admin_tools. Review the src_process outcome to identify recurring benign injectors before allowlisting."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\explorer\.exe$/ nocase
    not $open.principal.process.file.full_path = /\\(explorer|csrss|wininit|winlogon|services|lsass|svchost|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    $open.principal.hostname = $hostname
    $open.principal.process.file.full_path = $src_proc

    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.target.process.file.full_path = /\\explorer\.exe$/ nocase
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes
    $inj.principal.hostname = $hostname
    $inj.principal.process.file.full_path = $src_proc

    $open.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname, $src_proc over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.011")
    $primary_entity = array_distinct($hostname)
    $src_process = array_distinct($src_proc)
    $target_process = array_distinct($inj.target.process.file.full_path)
    $source_user = array_distinct($inj.principal.user.userid)
    $open_count = count($open.metadata.id)
    $first_open_time = min($open.metadata.event_timestamp.seconds)

  condition:
    $open and $inj
}
