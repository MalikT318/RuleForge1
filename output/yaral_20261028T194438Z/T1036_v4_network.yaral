/*
  MITRE Technique : T1036 - Masquerading
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:55:39.458668+00:00
  Reference       : https://attack.mitre.org/techniques/T1036
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_Linux_Masqueraded_Process_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound connection to a non-internal address from a process that masquerades as a kernel thread or core system daemon. Two masquerade patterns are covered. First, a disk-backed binary whose command line is forged to look like a kernel thread (for example '[kworker/0:1]'). Real kernel threads have no executable and never open network sockets. Second, a binary named like a system daemon (systemd, sshd, crond, kworker, dockerd and similar) that runs from a world-writable staging directory (/tmp, /var/tmp, /dev/shm). Detection is based on the network behaviour of the disguised process, so it complements process-creation command-line rules."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036"
    mitre_technique_name = "Masquerading"
    log_prerequisites = "Container runtime or node-level network telemetry that populates principal.process.file.full_path and principal.process.command_line on NETWORK_CONNECTION events (for example an eBPF or runtime sensor on the host or in the container). %rfc1918_internal must be populated."
    platform = "Linux"
    log_source = "container"
    false_positives = "Software installers or CI jobs that run a daemon-named binary from /tmp and call out during a build or test. Legitimate daemons relaunched from a temporary directory in ephemeral containers. Some agents that rewrite their process title to a bracketed form for cosmetic reasons."
    tuning_guidance = "Add approved admin and deployment tooling to %global_allowed_admin_tools and security agents to %global_allowed_security_tools. Build or CI hosts that legitimately execute binaries from /tmp can be excluded by principal.hostname. Expand %rfc1918_internal with any additional private ranges used by the client. Extend the daemon-name alternation if the client uses custom naming."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    (
      (
        $net.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/shm|var\/run\/shm)\/(.*\/)?(kworker[^\/]*|kthreadd|ksoftirqd[^\/]*|migration[^\/]*|systemd[^\/]*|sshd|crond?|rsyslogd|dbus-daemon|udevd|dockerd|containerd[^\/]*|kubelet)$/ nocase
      )
      or
      (
        $net.principal.process.command_line = /^\[[^\]\/]+(\/[0-9:]+)?\]/ nocase
        $net.principal.process.file.full_path = /^\/.+/
      )
    )

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1036")
    $primary_entity = array_distinct($net.principal.hostname)
    $masquerading_process = array_distinct($net.principal.process.file.full_path)
    $process_command_line = array_distinct($net.principal.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
