/*
  MITRE Technique : T1219.003 - Remote Access Hardware
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:11:24.382589+00:00
  Reference       : https://attack.mitre.org/techniques/T1219/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1219_003_Linux_USB_HID_Device_Enumeration_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of udev device-database file creations for USB, HID and input-class devices on a single Linux host within 10 minutes. IP-KVM and remote access hardware presents to the target as a USB keyboard, mouse or HID device. Repeated enumeration (re-attach, firmware re-presentation, multiple virtual HID interfaces) produces many of these events. A single device event is normal; the volume on one host is the signal."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1219.003"
    mitre_technique_name = "Remote Access Tools: Remote Access Hardware"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry covering /run/udev/data (or equivalent udev database writes) normalised to FILE_CREATION with target.file.full_path and principal.hostname populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Docking stations, USB hubs, KVM switches, headsets and webcams being attached, hosts booting with many USB devices, USB-over-IP and virtualisation hosts passing devices through, lab or kiosk machines with frequent device churn."
    tuning_guidance = "Raise the threshold (#file >= 6) on workstations with heavy peripheral churn. Add approved device-management tooling to %global_allowed_admin_tools. Prioritise servers and locked-down hosts, where USB HID attach events are rare and an unexpected burst is far more suspicious."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/run\/udev\/data\/(\+input:|\+hid:|\+usb:|c13:)/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1219.003")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $device_paths = array_distinct($file.target.file.full_path)

  condition:
    #file >= 6
}
