/*
  MITRE Technique : T1048.003 - Exfiltration Over Unencrypted Non-C2 Protocol
  Tactic(s)       : Exfiltration
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:37:51.481213+00:00
  Reference       : https://attack.mitre.org/techniques/T1048/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1048_003_Large_Outbound_Cleartext_Protocol_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a large outbound transfer to an external address over a cleartext file-transfer or mail protocol port (FTP, TFTP, SMTP), as seen in firewall or perimeter logs. Complements endpoint command-line detections by observing the exfiltration on the wire, whatever tool or process produced it. The firewall does not know the initiating process, so the Windows scope depends on the internal source being a Windows host."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1048.003"
    mitre_technique_name = "Exfiltration Over Alternative Protocol: Exfiltration Over Unencrypted Non-C2 Protocol"
    log_prerequisites = "Firewall, proxy or perimeter logs normalised to UDM NETWORK_CONNECTION with target.port, target.ip and network.sent_bytes populated for outbound sessions."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legacy business-to-business FTP/SFTP-fallback file feeds, vendor-managed FTP drops, application servers relaying bulk mail through external SMTP, firmware or configuration uploads via TFTP to external partners, and backup or archive jobs that use FTP."
    tuning_guidance = "Add approved source addresses (for example mail relays and managed file-transfer gateways) to %global_allowed_mgmt_sources and approved service hosts to %global_allowed_admin_tools. Adjust the sent_bytes threshold (default 1 MB) per client baseline. Add or remove cleartext ports to match the client's protocol inventory."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 21 or $net.target.port = 69 or $net.target.port = 25 or $net.target.port = 20)
    $net.network.sent_bytes > 1048576
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.hostname in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1048.003")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
