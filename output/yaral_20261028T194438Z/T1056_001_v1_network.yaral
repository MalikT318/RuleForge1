/*
  MITRE Technique : T1056.001 - Keylogging
  Tactic(s)       : Collection, Credential Access
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:45:57.297144+00:00
  Reference       : https://attack.mitre.org/techniques/T1056/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1056_001_Keystroke_Exfil_Small_POST_To_Raw_IP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects small HTTP POST requests to an external destination addressed by raw IP rather than a domain name, as observed at a perimeter firewall or proxy. Keyloggers, including implants on network devices or modified system images, typically exfiltrate captured keystrokes as small, frequent POST bodies to infrastructure that has no DNS name. This is network-side coverage that complements endpoint process and command-line rules."
    mitre_tactic = "Collection, Credential Access"
    mitre_technique = "T1056.001"
    mitre_technique_name = "Input Capture: Keylogging"
    log_prerequisites = "Firewall or proxy logs with HTTP inspection (URL, method, and sent bytes populated) normalised to NETWORK_HTTP. Plain HTTP, or TLS-inspected traffic, is required to see the method and URL."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legacy applications or IoT/OT devices that post telemetry to hard-coded IP addresses, software licensing and update checks, monitoring agents, and internal tooling reached over public IP space such as cloud-hosted APIs addressed by IP."
    tuning_guidance = "Add known-good destination domains to %global_allowed_domains and approved scanner or automation sources to %global_allowed_scanners. Adjust the network.sent_bytes ceiling (default 2048) to match the client's baseline. Repeated hits from one source in a short window raise confidence."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.url = /^https?:\/\/\d{1,3}(\.\d{1,3}){3}(:\d+)?(\/|$)/ nocase
    $net.network.sent_bytes > 0
    $net.network.sent_bytes < 2048
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1056.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_urls = array_distinct($net.target.url)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
