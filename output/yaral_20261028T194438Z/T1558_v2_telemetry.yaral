/*
  MITRE Technique : T1558 - Steal or Forge Kerberos Tickets
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:37:26.791499+00:00
  Reference       : https://attack.mitre.org/techniques/T1558
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_Kerberos_Ticket_File_Written_To_Disk {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a file in a Kerberos credential-cache or ticket-export format (.kirbi, .ccache, krb5cc_*) on a Windows host. Windows does not normally write Kerberos tickets to disk, since the LSA keeps them in memory. A ticket file therefore indicates that a TGT or service ticket was extracted from LSASS or forged and saved for Pass-the-Ticket reuse. The rule matches the file artifact, not the command line, so it still fires when the tool is renamed or its command-line logging is evaded."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558"
    mitre_technique_name = "Steal or Forge Kerberos Tickets"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating target.file.full_path and the writing process."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Security assessment and red-team exercises, Kerberos troubleshooting or training by administrators, cross-platform Kerberos tooling (MIT Kerberos for Windows, WSL or Impacket-based admin scripts) that legitimately writes credential caches, and EDR or forensic collection agents that stage ticket files."
    tuning_guidance = "Add approved admin tooling binaries to %global_allowed_admin_tools, EDR/forensic agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Authorised pentest hosts can be handled by suppression at the host level. If MIT Kerberos for Windows is deployed, allowlist its executable name in %global_allowed_admin_tools."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(\.kirbi|\.ccache|\\krb5cc_[^\\]+)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1558")
    $primary_entity = array_distinct($file.principal.hostname)
    $ticket_file_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
