/*
  MITRE Technique : T1565.003 - Runtime Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:42:58.030483+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_003_FileAssoc_Handler_Hijack_Data_Viewer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of the shell open/command handler for a file type or ProgID used to display data (text, CSV, log, JSON, XML, HTML, PDF, Office documents) so that it launches a script interpreter, LOLBin, or binary in a user-writable location. Adversaries use this to manipulate how data is displayed to the end user (runtime data manipulation via changed default file association). The rule keys on the registry handler mechanism, not on any specific payload or tool."
    mitre_tactic = "Impact"
    mitre_technique = "T1565.003"
    mitre_technique_name = "Data Manipulation: Runtime Data Manipulation"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events) that populates target.registry.registry_key, target.registry.registry_value_data and principal.process.file.full_path, with registry event coverage for HKCU/HKU Software\\Classes and HKLM Software\\Classes."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Users or installers legitimately associating a portable or per-user application (alternative text editors, PDF readers, browsers) with a file type from AppData or ProgramData; software deployment agents; RMM tooling; developers who set scripts as handlers."
    tuning_guidance = "Add approved installers, deployment and RMM binaries to %global_allowed_admin_tools and security agents to %global_allowed_security_tools. If per-user application installs under AppData are common in the client environment, narrow the value-data regex to interpreter and LOLBin names only. Extend the handler list with client-specific business-critical viewers if needed."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(\\Classes|HKEY_CLASSES_ROOT|HKCR)\\(txtfile|inifile|logfile|csvfile|jsonfile|xmlfile|htmlfile|chromehtml|msedgehtm|acroexch\.document[^\\]*|excel\.sheet[^\\]*|word\.document[^\\]*|\.(txt|csv|log|pdf|xlsx?|docx?|json|xml|html?))\\shell\\[^\\]+\\command$/ nocase
    $reg.target.registry.registry_value_data = /(\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32)\.exe|\\users\\[^\\]+\\(appdata|downloads|desktop)\\|\\windows\\temp\\|\\programdata\\|\\users\\public\\|\\temp\\)/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1565.003")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $handler_command = array_distinct($reg.target.registry.registry_value_data)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
