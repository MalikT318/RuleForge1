/*
  MITRE Technique : T1491.001 - Internal Defacement
  Tactic(s)       : Impact
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:44:27.398172+00:00
  Reference       : https://attack.mitre.org/techniques/T1491/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_001_Linux_Service_Parent_Spawns_Shell_Defaces_Login_Banner {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, database, print, or file-sharing service process spawning a shell or script interpreter whose command line writes to login banner, MOTD, profile.d, or desktop wallpaper locations. This lineage is abnormal for service daemons and indicates internal defacement (T1491.001) after compromise of the service."
    mitre_tactic = "Impact"
    mitre_technique = "T1491.001"
    mitre_technique_name = "Defacement: Internal Defacement"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to PROCESS_LAUNCH with parent process path and full command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web-based admin panels (for example hosting control panels) that legitimately update the MOTD or SSH banner, configuration management hooks launched from a service daemon, and application installers or upgrade scripts run under a database or web service."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools and approved script-hosting parents to %global_allowed_script_hosts. Extend the parent regex with in-house service daemons if they should never spawn shells. Review hosting control panel parents first when triaging noise."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|tomcat[0-9]*|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|smbd|vsftpd|proftpd)$/ nocase
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|csh|tcsh|python[0-9.]*|perl|php[0-9.]*|ruby)$/ nocase
    $proc.target.process.command_line = /(\/etc\/(motd|issue|issue\.net|update-motd\.d\/|ssh\/[a-z_]*banner[a-z_]*|profile\.d\/)|gsettings\s+set\s+org\.(gnome|cinnamon|mate)\S*\s+(picture-uri|picture-uri-dark|primary-color|background)|\/usr\/share\/(backgrounds|wallpapers)\/)/ nocase
    $proc.target.process.command_line = /(>|>>|\btee\b|\bsed\s+-[a-z]*i|\bcp\b|\bmv\b|\binstall\b|\bdd\b|\bln\b|\btruncate\b|gsettings\s+set)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1491.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
