/*
  MITRE Technique : T1542.005 - TFTP Boot
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:50:40.943435+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_005_Outbound_TFTP_To_External_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a TFTP connection (destination port 69) crossing the network perimeter to a non-internal address. Network devices that netboot from a TFTP server, or fetch images or configuration over TFTP, normally use a server on the internal management network. An outbound TFTP session to external address space can indicate a device configured to load an unauthorized image from an adversary-controlled server (T1542.005, often paired with T1601), or image and config staging and exfiltration."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.005"
    mitre_technique_name = "Pre-OS Boot: TFTP Boot"
    log_prerequisites = "Firewall, proxy or perimeter connection logs normalized to UDM NETWORK_CONNECTION with target.ip and target.port populated. The firewall must log permitted and denied UDP/69 traffic at the egress boundary."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate vendor or ISP-hosted TFTP provisioning, such as zero-touch provisioning for remote branch devices and IP phones. Managed-service or carrier-operated config and image repositories. Admins on a VPN or jump host who pull firmware from an external TFTP server. Internet background scanning of UDP/69, which appears only if inbound-to-outbound reply flows are logged as separate connections."
    tuning_guidance = "Add approved source addresses (management hosts, provisioning gateways, device management subnets) to %global_allowed_mgmt_sources. Make sure %rfc1918_internal covers all internal and private address space for each client. Where scanning noise appears, restrict the rule to connections initiated from the internal side by enforcing the allowlist and verifying direction in the firewall log mapping."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1542.005")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_port = array_distinct($net.target.port)

  condition:
    $net
}
