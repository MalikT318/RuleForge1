/*
  MITRE Technique : T1021.002 - SMB/Windows Admin Shares
  Tactic(s)       : Lateral Movement
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:37:40.953862+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_002_Excessive_Network_Logons_By_Single_Account {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single non-service account generates an unusually high number of network (SMB-style) logons within ten minutes. Individual network logons are routine, but a burst suggests an adversary using valid credentials to reach administrative shares (C$, ADMIN$, IPC$) across systems."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.002"
    mitre_technique_name = "Remote Services: SMB/Windows Admin Shares"
    log_prerequisites = "Requires Windows Security log (Event 4624, logon type 3) or EDR authentication telemetry normalised to USER_LOGIN with extensions.auth.mechanism = NETWORK. The Security log must be collected from servers and workstations, not only domain controllers."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "File server and DFS users, backup and software deployment accounts, vulnerability scanners, monitoring agents, helpdesk staff running remote administration, and users with many mapped drives reconnecting after VPN or sleep resume."
    tuning_guidance = "Add service accounts to %global_allowed_service_accounts, administrators to %global_allowed_admin_users, and approved jump hosts or scanner source addresses to %global_allowed_mgmt_sources. Raise the #auth threshold if file-server-heavy environments are noisy."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.extensions.auth.mechanism = "NETWORK"
    $auth.target.user.userid = $user
    $auth.target.user.userid != ""
    not $auth.target.user.userid = /\$$/ nocase
    not $auth.target.user.userid = /^(anonymous logon|local service|network service|system)$/ nocase
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.principal.ip in %global_allowed_mgmt_sources

  match:
    $user over 10m

  outcome:
    $risk_score = max(65)
    $logon_count = count($auth.metadata.id)
    $distinct_target_hosts = count_distinct($auth.target.hostname)
    $mitre_technique_id = array_distinct("T1021.002")
    $primary_entity = array_distinct($user)
    $source_ips = array_distinct($auth.principal.ip)
    $target_hosts = array_distinct($auth.target.hostname)

  condition:
    #auth >= 15
}
