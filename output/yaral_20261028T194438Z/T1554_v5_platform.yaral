/*
  MITRE Technique : T1554 - Compromise Host Software Binary
  Tactic(s)       : Persistence
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:11:55.363216+00:00
  Reference       : https://attack.mitre.org/techniques/T1554
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1554_Linux_System_Binary_Modified_By_NonPackage_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of a file in a standard Linux system binary directory (/bin, /sbin, /usr/bin, /usr/sbin, /usr/local/bin, /usr/local/sbin, OpenSSH helper directories) by a process that is not a package manager or an approved administrative tool. Legitimate binaries change through the package manager. Direct writes from shells, interpreters, or unknown processes can indicate a trojanised SSH client, sudo, login, or other host binary planted for persistence or credential theft."
    mitre_tactic = "Persistence"
    mitre_technique = "T1554"
    mitre_technique_name = "Compromise Host Software Binary"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules (write/attribute change on /bin, /sbin, /usr/bin, /usr/sbin, /usr/local/bin, /usr/local/sbin) normalised to FILE_MODIFICATION with the principal process populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers and updaters not covered by the name exclusion, configuration management agents (Ansible, Puppet, Chef, Salt) pushing binaries, software deployment tooling, container or image build processes, administrators manually installing or patching binaries, and in-place live-patching tools."
    tuning_guidance = "Add approved deployment and configuration management binaries to %global_allowed_admin_tools, and EDR/AV agents that touch binaries to %global_allowed_security_tools. Extend the package manager regex for distribution-specific updaters. If /usr/local/bin is noisy for developer workstations, narrow the target path regex for those clients."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/(usr\/(local\/)?)?s?bin\/[^\/]+$|^\/usr\/lib(exec|64)?\/openssh\/[^\/]+$/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|yum|dnf|zypper|packagekitd|unattended-upgr|unattended-upgrade|snapd|pacman|apk)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1554")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $modifying_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
