/*
  MITRE Technique : T1497 - Virtualization/Sandbox Evasion
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:58:52.636955+00:00
  Reference       : https://attack.mitre.org/techniques/T1497
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_Linux_VM_Artifact_Discovery_Commandline {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux process whose command line combines a hardware or virtualization discovery source (DMI tables, /proc/cpuinfo, /proc/scsi/scsi, /sys/hypervisor, dmidecode, systemd-detect-virt, virt-what, lscpu, lspci) with a hypervisor vendor or artifact string (VMware, VirtualBox, QEMU, KVM, Xen, Hyper-V and others). This is the typical way malware or an operator checks for a VM or sandbox before deploying a payload or altering behavior."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1497"
    mitre_technique_name = "Virtualization/Sandbox Evasion"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to UDM PROCESS_LAUNCH, with target.process.command_line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management and inventory tooling (Ansible, Puppet, Chef, facter, cloud-init), hypervisor guest agent and tools installers, cloud provisioning scripts, monitoring and asset discovery agents, and admins checking whether a host is virtual during troubleshooting."
    tuning_guidance = "Add approved inventory, configuration management and deployment tooling to %global_allowed_admin_tools (matched on the parent process path). Add authorised scanners to %global_allowed_scanners. Add EDR and security agents to %global_allowed_security_tools. Add automation accounts to %global_allowed_service_accounts. Hosts running legitimate provisioning scripts can be handled through %global_allowed_script_hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(dmidecode|\/sys\/class\/dmi\/id|\/sys\/devices\/virtual\/dmi|\/sys\/hypervisor|\/proc\/scsi\/scsi|\/proc\/cpuinfo|systemd-detect-virt|virt-what|lscpu|lspci)/ nocase
    $proc.target.process.command_line = /(vmware|virtualbox|vbox|qemu|kvm|xen|hyper-?v|parallels|bochs|innotek|bhyve|hypervisor)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_scanners
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1497")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
