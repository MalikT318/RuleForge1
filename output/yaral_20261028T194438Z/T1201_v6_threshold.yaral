/*
  MITRE Technique : T1201 - Password Policy Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:52:49.964878+00:00
  Reference       : https://attack.mitre.org/techniques/T1201
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1201_IaaS_Repeated_Password_Policy_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single cloud identity repeatedly queries the account or directory password policy through control-plane APIs within 10 minutes. One lookup is routine; repeated lookups by the same principal suggest reconnaissance ahead of password guessing or spraying that stays within lockout and complexity limits."
    mitre_tactic = "Discovery"
    mitre_technique = "T1201"
    mitre_technique_name = "Password Policy Discovery"
    log_prerequisites = "Cloud control-plane audit logging, including read-only management API calls, must be enabled and ingested into UDM with metadata.product_event_type and principal.user.userid populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Compliance and posture-management scanners, infrastructure-as-code drift detection, CIS benchmark audits, identity governance tooling, and administrators reviewing IAM settings in the console."
    tuning_guidance = "Add automation and posture-scanning identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Add trusted administrators to %global_allowed_admin_users. Raise the #cloud threshold if a client runs frequent scheduled audits. Lower it to 2 for high-security tenants."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /(Get|Describe|List|Read)[A-Za-z]*(Account)?Password(Polic(y|ies)|Settings)/ nocase
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1201")
    $primary_entity = array_distinct($user)
    $event_count = count($cloud.metadata.id)
    $api_calls = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    #cloud >= 3
}
