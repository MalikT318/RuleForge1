/*
  MITRE Technique : T1496.002 - Bandwidth Hijacking
  Tactic(s)       : Impact
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:54:06.019133+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_002_Linux_Staged_Binary_Drops_Persistence_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a persistence artifact (systemd unit, cron entry, init script or rc.local) by a process running from a world-writable staging directory (/tmp, /var/tmp, /dev/shm). This is the file-level footprint left when a dropped bandwidth-hijacking payload (proxyware, botnet or torrent-seeding agent) installs itself to keep consuming host bandwidth, including inside containers or on hosts with container workloads. The rule detects the state change rather than command lines, so it still fires if command-line logging is evaded. Specificity is moderate because the file telemetry carries no content. Treat as a lead for triage of outbound traffic volume and the dropped binary."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.002"
    mitre_technique_name = "Resource Hijacking: Bandwidth Hijacking"
    log_prerequisites = "Requires container-runtime or host-level file telemetry (EDR or auditd file-write events) normalised to UDM FILE_CREATION with principal.process.file.full_path and target.file.full_path populated."
    platform = "Linux"
    log_source = "container"
    false_positives = "Installers or self-updating software that unpack to /tmp and then register a service or cron job; CI/CD build containers; configuration-management bootstrap scripts; admin troubleshooting; package post-install scripts run from a temp directory."
    tuning_guidance = "Add approved installer or deployment binaries to %global_allowed_admin_tools, approved automation accounts to %global_allowed_service_accounts, and approved bootstrap hosts or parent interpreters to %global_allowed_script_hosts. Pair with network-volume telemetry from the same host for triage. If build containers are noisy, scope exclusions to those service accounts rather than loosening the paths."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(etc\/systemd\/system\/|usr\/lib\/systemd\/system\/|lib\/systemd\/system\/|etc\/cron\.(d|hourly|daily|weekly|monthly)\/|var\/spool\/cron\/|etc\/init\.d\/|etc\/rc\.local$|(root|home\/[^\/]+)\/\.config\/systemd\/user\/)/ nocase
    $file.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/shm)\// nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|yum|dnf|zypper|apk|systemd|snapd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1496.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_artifact = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
