/*
  MITRE Technique : T1687 - Exploitation for Defense Impairment
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:34:22.467760+00:00
  Reference       : https://attack.mitre.org/techniques/T1687
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1687_IaaS_External_Login_Then_Security_Role_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an identity sign-in from a non-internal source address followed within 10 minutes by a permission or role change, made by the same account, that targets a security, logging, or monitoring role or resource. This is the post-exploitation result of defense impairment: an identity-plane or cloud-control-plane flaw is abused to gain access and the account then alters the privileges that govern defensive tooling. It does not depend on any CVE payload."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1687"
    mitre_technique_name = "Exploitation for Defense Impairment"
    log_prerequisites = "Requires identity provider sign-in logs and directory/permission audit logs normalised to UDM (USER_LOGIN and USER_CHANGE_PERMISSIONS) with principal.user.userid populated on both event types. Cloud control-plane audit logs forwarded through the identity pipeline also work if they populate the same fields."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Administrators on VPN or remote networks legitimately re-scoping security-team or audit roles; onboarding of new SOC or compliance staff; scheduled access reviews; privileged access management tooling granting just-in-time security roles; break-glass account use during incidents."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and automation or PAM identities to %global_allowed_service_accounts. Add known corporate egress or VPN addresses to %global_allowed_mgmt_sources. Adjust the role/resource name regex to match the client's naming of security roles. Lengthen or shorten the 10m window to suit the client's change cadence."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.principal.user.userid != ""
    not $login.principal.ip in %rfc1918_internal
    not $login.principal.ip in %global_allowed_mgmt_sources
    not $login.principal.user.userid in %global_allowed_admin_users
    not $login.principal.user.userid in %global_allowed_service_accounts
    $login.principal.user.userid = $user

    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.target.resource.name = /(security|audit|logging|log\s?analytics|monitor|defender|guard|compliance|siem|threat|firewall|detect)/ nocase
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_service_accounts
    $perm.principal.user.userid = $user

    $login.metadata.event_timestamp.seconds <= $perm.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1687")
    $primary_entity = array_distinct($perm.principal.user.userid)
    $source_ips = array_distinct($login.principal.ip)
    $changed_resources = array_distinct($perm.target.resource.name)
    $target_users = array_distinct($perm.target.user.userid)
    $permission_change_count = count($perm.metadata.id)

  condition:
    $login and $perm
}
