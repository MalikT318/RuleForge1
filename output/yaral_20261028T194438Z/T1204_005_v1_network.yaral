/*
  MITRE Technique : T1204.005 - Malicious Library
  Tactic(s)       : Execution
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:05:53.227561+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_005_Package_Manager_Client_Unapproved_Destination {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects HTTP traffic observed at the proxy or firewall perimeter whose client signature identifies a software package manager (npm, pip, yarn, pnpm, NuGet, poetry) talking to an external destination that is not in the approved known-good domain list. This catches installation of libraries from typosquatted, attacker-hosted or raw-IP registries without relying on endpoint process or command-line telemetry."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.005"
    mitre_technique_name = "User Execution: Malicious Library"
    log_prerequisites = "Requires proxy or firewall logs with HTTP inspection that populate network.http.user_agent and target.hostname (TLS inspection or explicit proxy for HTTPS). %global_allowed_domains must include the legitimate public and internal package registries used by the client."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Developers or build servers using private or mirror registries not yet in the allowlist, new legitimate registry or CDN hostnames, package managers pulling from vendor-hosted feeds, and CI/CD runners fetching dependencies."
    tuning_guidance = "Add approved package registries, mirrors and artifact feeds to %global_allowed_domains. Ensure internal addresses are covered in %rfc1918_internal. If dev and build networks are noisy, scope the rule per client using a source network exclusion in the SIEM rule configuration."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /^(npm|pip|yarn|pnpm|nuget|poetry)[\/ ]/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1204.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
