/*
  MITRE Technique : T1572 - Protocol Tunneling
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:18:54.368563+00:00
  Reference       : https://attack.mitre.org/techniques/T1572
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1572_Firewall_Outbound_Tunnel_Prone_Protocol_To_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an internal host making an outbound connection to an external address on a protocol that is normally internal-only or is commonly tunneled (SSH, Telnet, SMB, RDP, VNC, WinRM). This is the network-side signature of SSH port forwarding, RDP or SMB encapsulation, and reverse tunnels that carry otherwise filtered traffic through the perimeter. Observed at the perimeter, so it does not depend on endpoint process telemetry."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1572"
    mitre_technique_name = "Protocol Tunneling"
    log_prerequisites = "Requires firewall or perimeter NETWORK_CONNECTION logs with principal.ip, target.ip and target.port populated. Source addresses should map to Windows hosts or segments; the firewall does not identify the process."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Administrators using SSH or RDP to cloud-hosted or vendor-managed systems, approved vendor remote support, developers using SSH to external Git hosting, site-to-site arrangements that use public addressing, and authorised external scanners."
    tuning_guidance = "Add approved management or jump host source addresses to %global_allowed_mgmt_sources. Add authorised scanner sources to %global_allowed_scanners. Narrow the port list per client if SSH to external Git hosting is routine. Scope the rule to Windows client and server segments if the firewall log lacks host platform context."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 445 or
      $net.target.port = 3389 or
      $net.target.port = 5900 or
      $net.target.port = 5985
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %rfc1918_internal_placeholder_removed
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1572")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
