/*
  MITRE Technique : T1686.002 - Network Device Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:30:25.654713+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_002_External_Source_To_Device_Mgmt_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network connection from a non-internal source address to a typical network-device management-plane port (SSH, Telnet, NETCONF over SSH, or alternate HTTPS admin ports). Adversaries who reach a firewall or perimeter device management interface can disable the firewall or edit ACLs, security zones, and policy rules to permit blocked traffic. This is a network-side view of that access and does not depend on endpoint telemetry."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.002"
    mitre_technique_name = "Network Device Firewall"
    log_prerequisites = "Firewall, proxy, or perimeter connection and flow logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs must record accepted inbound connections to the device or its management interfaces."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Managed-service-provider or vendor support access from public addresses, remote administrators working from home or travelling, external vulnerability scanners and attack-surface monitoring, internet-wide scanning that reaches an exposed admin port, and legitimate non-management services on alternate HTTPS ports (8443, 9443, 10443)."
    tuning_guidance = "Add approved administrator and MSP egress addresses to %global_allowed_mgmt_sources. Add authorised scanner addresses to %global_allowed_scanners. If the customer legitimately serves applications on 8443, 9443, or 10443, remove those ports from the rule for that tenant. Pair this rule with management-plane SETTING_MODIFICATION and USER_LOGIN rules on the device itself for confirmation of rule or ACL changes. Best deployed where the firewall log records only permitted traffic, or with deny events filtered out upstream."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 830 or
      $net.target.port = 4443 or
      $net.target.port = 8443 or
      $net.target.port = 9443 or
      $net.target.port = 10443
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1686.002")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
