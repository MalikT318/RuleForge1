/*
  MITRE Technique : T1568.003 - DNS Calculation
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:07:54.387559+00:00
  Reference       : https://attack.mitre.org/techniques/T1568/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1568_003_ESXi_Mgmt_Daemon_Spawns_Shell_Or_NetTool {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi management or VM-runtime daemon (hostd, vpxa, rhttpproxy, vmx, sfcbd and similar) spawning a shell, scripting interpreter or network-capable utility. These daemons do not normally launch interactive shells or network clients. This lineage anomaly is a pre-condition for staging a C2 implant that resolves DNS and calculates its own destination IP or port (T1568.003). It also indicates exploitation of a management service or a guest-to-host escape. Detection is based on process lineage, not command-line content."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1568.003"
    mitre_technique_name = "Dynamic Resolution: DNS Calculation"
    log_prerequisites = "ESXi shell and hostd process-execution events forwarded and normalised to UDM PROCESS_LAUNCH with both parent (principal.process) and child (target.process) file paths populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Management daemons legitimately spawning helper shells (health probes, host profile or remediation scripts), vendor VIB or agent scripts launched via hostd, backup or monitoring integrations that call out through hostd, and administrator-initiated diagnostics via the management API."
    tuning_guidance = "Add approved parent daemons or wrapper scripts to %global_allowed_script_hosts, approved tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Review hits per host for recurring benign hostd child processes before widening exclusions."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(hostd|vpxa|rhttpproxy|vmx|vmx-debug|vmx-stats|sfcbd|sfcb-[a-z_]+|openwsmand|slpd|vobd|fdm|vmsyslogd|storageRM|netcpa-daemon)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|ash|bash|dash|busybox|python[0-9.]*|perl|nc|ncat|netcat|wget|curl|nslookup|openssl|telnet)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1568.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
