/*
  MITRE Technique : T1574.014 - AppDomainManager
  Tactic(s)       : Stealth, Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:47:39.037703+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_014_DotNet_Framework_Host_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a built-in .NET Framework host or compiler binary (MSBuild, InstallUtil, RegAsm, RegSvcs, csc, vbc, jsc and similar) making an outbound connection to a non-internal address. These binaries almost never initiate external network traffic. External traffic from them is characteristic of a hijacked AppDomainManager, where a config file or environment variable loads an attacker assembly into the trusted .NET process and that assembly then calls out for C2 or payload staging."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.014"
    mitre_technique_name = "Hijack Execution Flow: AppDomainManager"
    log_prerequisites = "Requires endpoint network telemetry that populates the initiating process path (EDR or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developer workstations and build servers where MSBuild or csc restore packages from external feeds; software installers that run InstallUtil or RegAsm and fetch content; ClickOnce or .NET-based deployment tooling; sandboxed malware analysis hosts."
    tuning_guidance = "Add approved build and deployment tooling paths to %global_allowed_admin_tools, add known-good package feeds and vendor update domains to %global_allowed_domains, and add authorised scanning or testing hosts to %global_allowed_scanners. For build servers, consider scoping the rule by asset group in the SIEM rather than loosening the process list."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\Microsoft\.NET\\Framework(64)?\\v[0-9.]+\\(msbuild|installutil|regasm|regsvcs|regsvr|jsc|csc|vbc|aspnet_compiler|ilasm|addinprocess|addinprocess32|addinutil|ngen|caspol)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1574.014")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $initiating_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
