/*
  MITRE Technique : T1127.003 - JamPlus
  Tactic(s)       : Stealth, Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:39:58.227452+00:00
  Reference       : https://attack.mitre.org/techniques/T1127/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1127_003_JamPlus_Jam_Script_Dropped_To_Staging_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a JamPlus build script (.jam) in a user-writable staging location (Downloads, Desktop, Temp, AppData, Public, ProgramData) by a delivery or unpacking process such as a browser, mail client, Office application, archiver, Explorer extraction or script interpreter. Adversaries drop a .jam file and then use JamPlus as a trusted developer tool to proxy malicious script execution and bypass application control. This rule detects the file artifact, so it fires regardless of how JamPlus is later invoked, renamed or whether command lines are logged."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1127.003"
    mitre_technique_name = "Trusted Developer Utilities Proxy Execution: JamPlus"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) that populates the target file path and the creating process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Game and asset-pipeline developers who download or extract JamPlus projects from repositories or archives; build engineers unpacking SDKs; software teams that use Jam-based build systems; IDE or project-generator tooling writing .jam files to temp folders."
    tuning_guidance = "Add approved build or deployment tooling to %global_allowed_admin_tools and approved developer hosts or script-running parents to %global_allowed_script_hosts. On clients with active Jam-based development, scope the rule by excluding developer workstation hostnames through a client-side exclusion, or raise the initiator filter to only browsers, mail clients and Office applications."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\[^\\]+\\(downloads|desktop|documents|appdata\\local\\temp|appdata\\local|appdata\\roaming)|users\\public|programdata|windows\\temp|temp)\\(.*\\)?[^\\]+\.jam$/ nocase
    $file.principal.process.file.full_path = /\\(chrome|msedge|firefox|brave|opera|iexplore|outlook|olk|thunderbird|winword|excel|powerpnt|onenote|7z|7zg|7zfm|winrar|rar|unrar|explorer|powershell|pwsh|cmd|wscript|cscript|mshta|curl|bitsadmin|certutil|msiexec)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1127.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $jam_file_path = array_distinct($file.target.file.full_path)
    $creator_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
