/*
  MITRE Technique : T1482 - Domain Trust Discovery
  Tactic(s)       : Discovery
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:29:11.020129+00:00
  Reference       : https://attack.mitre.org/techniques/T1482
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1482_Domain_Trust_Discovery_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects domain trust enumeration (nltest, netdom, dsquery, or PowerShell/.NET trust APIs) launched by a process that should never perform AD reconnaissance: an Office application, web server worker, print spooler, or database service. This lineage anomaly typically indicates macro execution, a webshell, or exploitation of a service, followed by hands-on-keyboard discovery."
    mitre_tactic = "Discovery"
    mitre_technique = "T1482"
    mitre_technique_name = "Domain Trust Discovery"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Database maintenance jobs or agents that shell out to nltest or PowerShell for domain health checks; web applications with AD integration that query trusts; print or Office management add-ins; admin troubleshooting through a web-based management console running under a web server process."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts and approved management tooling to %global_allowed_admin_tools. Add known automation accounts to %global_allowed_service_accounts. Review the parent_process and command_line outcome values to identify recurring benign lineage per customer."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|mspub|visio|onenote|w3wp|httpd|nginx|tomcat\d*|php-cgi|spoolsv|sqlservr|sqlagent|mysqld|postgres|oracle)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(nltest|netdom|dsquery|cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(domain_trusts|trusted_domains|netdom(\.exe)?\s+trust|dsquery.*trusteddomain|objectcategory=trusteddomain|get-adtrust|get-domaintrust|getalltrustrelationships|dsenumeratedomaintrusts|get-addomain.*trust)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1482")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
