/*
  MITRE Technique : T1204 - User Execution
  Tactic(s)       : Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:57:30.722088+00:00
  Reference       : https://attack.mitre.org/techniques/T1204
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_Linux_UserApp_Spawns_Shell_Or_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a user-facing application (office suite, document or PDF viewer, mail client, or web browser) spawning a shell or script interpreter. On Linux hosts and in containers that run desktop or GUI workloads, this lineage is a strong indicator that a user opened a malicious document, attachment, or download and it executed code. The rule matches only the parent-child process relationship and does not inspect command lines."
    mitre_tactic = "Execution"
    mitre_technique = "T1204"
    mitre_technique_name = "User Execution"
    log_prerequisites = "Requires container runtime or host process-launch telemetry (EDR or auditd execve) that populates both the parent (principal.process.file.full_path) and child (target.process.file.full_path) executable paths."
    platform = "Linux"
    log_source = "container"
    false_positives = "Browser or mail client wrapper scripts (snap/flatpak launchers, xdg-open helpers), office suite macros or extensions that run approved scripts, browser native-messaging hosts written in Python or shell, developer workstations running browser-based IDEs or test automation, and containerised headless browser or document-conversion workers that deliberately fork shells."
    tuning_guidance = "Add approved parent executables or hosts for headless browser or document-conversion workers to %global_allowed_script_hosts. Review the $parent_process and $child_process outcome values to identify launcher wrappers. If a wrapper is benign, allowlist the parent path rather than loosening the child regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(soffice(\.bin)?|oosplash|libreoffice[0-9.]*|onlyoffice-desktopeditors|desktopeditors|wps|thunderbird(-bin)?|evolution|evince|okular|atril|xreader|zathura|firefox(-bin|-esr)?|chrome|chromium(-browser)?|google-chrome(-stable)?|brave(-browser)?|opera|epiphany)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ksh|csh|tcsh|fish|python[0-9.]*|perl|ruby|node|php|lua)$/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1204")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
