/*
  MITRE Technique : T1218.003 - CMSTP
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:46:11.661029+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_003_CMSTP_Repeated_External_Network_Connections {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "The Connection Manager Profile Installer (cmstp.exe) makes repeated outbound connections to non-internal addresses from a single host within ten minutes. Legitimate profile installs are normally local, so repeated external connections suggest a malicious INF fetching remote DLLs or COM scriptlets (SCT), or staging payloads. This is network-behaviour coverage and does not depend on command-line matching."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.003"
    mitre_technique_name = "System Binary Proxy Execution: CMSTP"
    log_prerequisites = "Requires Windows endpoint network telemetry that records the originating process path for outbound connections (EDR network events or Sysmon Event ID 3), normalised to UDM NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Corporate VPN or Connection Manager profile deployments that fetch phonebook or profile data from external vendor endpoints, software deployment or RMM tooling that installs connection profiles, and administrators testing remote-access profiles."
    tuning_guidance = "Add approved deployment or RMM parent processes to %global_allowed_admin_tools. Add automation accounts that install VPN profiles to %global_allowed_service_accounts. If a client legitimately uses Connection Manager profiles over the internet, raise the threshold from 3 to a higher value for that tenant."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\cmstp\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.process.parent_process.file.full_path in %global_allowed_admin_tools
    $net.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1218.003")
    $primary_entity = array_distinct($host)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $users = array_distinct($net.principal.user.userid)

  condition:
    #net >= 3
}
