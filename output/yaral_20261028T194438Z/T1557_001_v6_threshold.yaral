/*
  MITRE Technique : T1557.001 - Name Resolution Poisoning and SMB Relay
  Tactic(s)       : Credential Access, Collection
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:32:31.060777+00:00
  Reference       : https://attack.mitre.org/techniques/T1557/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1557_001_NameResolution_Poisoning_Response_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single internal host sends many unicast UDP replies sourced from the LLMNR (5355), NBT-NS (137) or mDNS (5353) service ports to many different clients within ten minutes. One reply is normal name resolution. A high volume of replies from one non-infrastructure source is the network signature of a poisoner such as Responder answering broadcast and multicast name queries to capture or relay credentials."
    mitre_tactic = "Credential Access, Collection"
    mitre_technique = "T1557.001"
    mitre_technique_name = "Adversary-in-the-Middle: LLMNR/NBT-NS Poisoning and SMB Relay"
    log_prerequisites = "Requires internal-segment firewall, network-flow or perimeter telemetry that records UDP source and destination ports with the source IP. Needs east-west visibility, such as inter-VLAN firewalls or flow logs, because poisoning happens on the local segment."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "WINS or NetBIOS name servers, Windows file or print servers answering many NBT-NS queries, mDNS-heavy devices (printers, Apple devices, Chromecast, conferencing hardware), network discovery or inventory scanners, and wireless controllers proxying mDNS."
    tuning_guidance = "Add known name servers and discovery appliances to %global_allowed_mgmt_sources, and add authorised scanners to %global_allowed_scanners. If mDNS is noisy in the environment, raise the threshold or remove the 5353 branch for that client. Raise the threshold on large flat networks. Correlate hits with hosts that have LLMNR/NBT-NS enabled."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "UDP"
    (
      ($net.principal.port = 5355 and $net.target.port > 1023) or
      ($net.principal.port = 137 and $net.target.port = 137) or
      ($net.principal.port = 5353 and $net.target.port > 1023 and $net.target.port != 5353)
    )
    $net.principal.ip = $src_ip
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1557.001")
    $primary_entity = array_distinct($src_ip)
    $event_count = count($net.metadata.id)
    $victim_ips = array_distinct($net.target.ip)
    $source_ports = array_distinct($net.principal.port)
    $source_hostnames = array_distinct($net.principal.hostname)

  condition:
    #net >= 15
}
