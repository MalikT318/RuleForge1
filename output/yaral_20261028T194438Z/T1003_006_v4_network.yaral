/*
  MITRE Technique : T1003.006 - DCSync
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:47:30.811501+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_006_DCSync_External_RPC_Endpoint_Mapper_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a connection from a non-internal source address to the RPC endpoint mapper (TCP 135) on an internal host. The DRSUAPI replication interface that DCSync abuses is reached by first querying the endpoint mapper, so this exposure is a precondition for remote DCSync or NetSync against a domain controller. A perimeter log cannot see the RPC interface UUID, so this rule flags the reachable-from-outside condition and not confirmed replication. Internal-to-internal DCSync is out of scope and must be covered by endpoint and domain controller telemetry."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.006"
    mitre_technique_name = "OS Credential Dumping: DCSync"
    log_prerequisites = "Requires firewall or perimeter NETWORK_CONNECTION logs with populated principal.ip, target.ip and target.port, deployed at a boundary where external, VPN-assigned or partner traffic reaches internal address space. Reference list %rfc1918_internal must be populated for the tenant."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Site-to-site or partner links that use public addressing to reach domain controllers, cloud-hosted domain controllers replicating over public addresses, authorised external vulnerability scans, and legitimate remote administration over VPN pools that use non-private addressing."
    tuning_guidance = "Add authorised scanner sources to %global_allowed_scanners. Add approved VPN, jump host and replication partner source addresses to %global_allowed_mgmt_sources. If the tenant uses public address space internally, extend %rfc1918_internal with those ranges as plain strings."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 135
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1003.006")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_hosts = array_distinct($net.target.hostname)

  condition:
    $net
}
