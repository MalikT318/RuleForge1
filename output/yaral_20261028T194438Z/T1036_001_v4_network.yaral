/*
  MITRE Technique : T1036.001 - Invalid Code Signature
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:57:41.883219+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_001_Fake_Signed_Binary_Name_Writable_Path_External_Net {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Network-side detection of a binary posing as a signed Windows system component (svchost, lsass, explorer, etc.) that makes an external network connection while running from a user-writable location. Genuine signed system binaries run from System32, SysWOW64 or WinSxS, so a lookalike in a writable path is a strong sign of a signature-mimicking or unsigned implant beaconing out."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.001"
    mitre_technique_name = "Masquerading: Invalid Code Signature"
    log_prerequisites = "Requires endpoint network telemetry that populates the initiating process path (EDR or Sysmon Event ID 3 equivalent) normalised to UDM NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Portable or per-user software installers that legitimately ship binaries with system-like names; software developers testing builds in user directories; sandboxed or detonation hosts; EDR and backup agents that stage helper binaries in ProgramData or Temp."
    tuning_guidance = "Add approved agents and tooling to %global_allowed_security_tools and %global_allowed_admin_tools (matched on the initiating process path). Add known-good destinations to %global_allowed_domains. Internal traffic is excluded via %rfc1918_internal. If noise persists from a specific host class, exclude it at the client level. Do not widen the process name list without review."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(svchost|lsass|services|csrss|winlogon|wininit|smss|spoolsv|taskhostw|dllhost|runtimebroker|conhost|explorer|searchindexer|fontdrvhost|sihost|ctfmon)\.exe$/ nocase
    $net.principal.process.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents|music|pictures|videos)|users\\public|programdata|windows\\temp|temp|\$recycle\.bin|perflogs)\\/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1036.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $masquerading_process_path = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $affected_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
