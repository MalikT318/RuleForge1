/*
  MITRE Technique : T1565.001 - Stored Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:39:21.459201+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_001_Unexpected_Parent_Spawns_Shell_Modifying_Data {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter spawned by a process that should not launch one (Office application, web server, database service, or print spooler) whose command line modifies or deletes data files or runs SQL data-manipulation statements. This lineage anomaly indicates stored data manipulation after exploitation, macro abuse, a web shell, or xp_cmdshell abuse."
    mitre_tactic = "Impact"
    mitre_technique = "T1565.001"
    mitre_technique_name = "Data Manipulation: Stored Data Manipulation"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Database maintenance jobs that call cmd or PowerShell from the database service; web applications that legitimately write export files via a shell; Office macros or add-ins in finance or reporting workflows that save CSV or XML data; print-management scripts launched by the spooler; software deployment tied to a web server process."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts and approved admin tooling to %global_allowed_admin_tools. Add known automation accounts to %global_allowed_service_accounts. To narrow the rule on noisy hosts, remove broad parent names from the parent regex or tighten the data-extension list. To widen it, add environment-specific data file extensions."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|w3wp|httpd|nginx|php-cgi|tomcat\d*|sqlservr|mysqld|postgres|oracle|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|sqlcmd|osql)\.exe$/ nocase
    $proc.target.process.command_line = /((set-content|add-content|out-file|clear-content|remove-item|\bdel\b|\berase\b|\bcopy\b|\bmove\b|\bren\b|\brename\b|>>?).{0,200}\.(xlsx?|xlsm|docx?|csv|mdb|accdb|mdf|ndf|sqlite3?|db|bak|pst|ost|json|xml|sql)\b|\.(xlsx?|xlsm|docx?|csv|mdb|accdb|mdf|ndf|sqlite3?|db|bak|pst|ost|json|xml|sql)\b.{0,300}(-replace|\|\s*(set-content|out-file)|>>?)|\b(update\s+\S+\s+set|delete\s+from|insert\s+into|drop\s+(table|database)|truncate\s+table)\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1565.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
