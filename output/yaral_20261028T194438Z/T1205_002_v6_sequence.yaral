/*
  MITRE Technique : T1205.002 - Socket Filters
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:13:39.906749+00:00
  Reference       : https://attack.mitre.org/techniques/T1205/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_002_Linux_BPF_Magic_Filter_Then_Reverse_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the pattern of a passive socket-filter backdoor on Linux. A packet-capture utility is launched with a BPF magic-byte filter expression or dumps compiled BPF bytecode (-dd/-ddd), and a shell with reverse-shell characteristics starts on the same host within 10 minutes. This is the trigger-then-callback behaviour of backdoors that use libpcap or SO_ATTACH_FILTER."
    mitre_tactic = "Stealth, Persistence, Command and Control"
    mitre_technique = "T1205.002"
    mitre_technique_name = "Traffic Signaling: Socket Filters"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records (with full command lines) normalised to UDM PROCESS_LAUNCH."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Network engineers debugging with BPF byte-offset filters, packet-capture troubleshooting scripts, NDR/IDS sensor bootstrap scripts, administrators using bash -i over automation frameworks, and legitimate orchestration that opens /dev/tcp for health checks."
    tuning_guidance = "Add approved capture tooling or parent processes to %global_allowed_admin_tools, approved security sensors to %global_allowed_security_tools, and known automation hosts or parent shells to %global_allowed_script_hosts. Add named engineers to %global_allowed_admin_users. Tighten the time window or require a staging-path parent if noise persists."

  events:
    $pcap.metadata.event_type = "PROCESS_LAUNCH"
    $pcap.target.process.file.full_path = /\/(tcpdump|tshark|dumpcap)$/ nocase
    $pcap.target.process.command_line = /(\[[^\]]{1,60}\]\s*={1,2}\s*0x[0-9a-f]+|\s-d{2,3}(\s|$))/ nocase
    not $pcap.principal.process.file.full_path in %global_allowed_admin_tools
    not $pcap.principal.process.file.full_path in %global_allowed_security_tools
    not $pcap.principal.user.userid in %global_allowed_admin_users
    $pcap.principal.hostname = $hostname

    $shell.metadata.event_type = "PROCESS_LAUNCH"
    $shell.target.process.file.full_path = /\/(ba|da|z|k|c|a)?sh$/ nocase
    $shell.target.process.command_line = /(\/dev\/(tcp|udp)\/|\bmkfifo\b|\b(ba|da|z)?sh\s+-i\b|\bnc(at)?\b.*\s-e\s)/ nocase
    not $shell.principal.process.file.full_path in %global_allowed_script_hosts
    not $shell.principal.user.userid in %global_allowed_admin_users
    $shell.principal.hostname = $hostname

    $pcap.metadata.event_timestamp.seconds <= $shell.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1205.002")
    $primary_entity = array_distinct($pcap.principal.hostname)
    $capture_commands = array_distinct($pcap.target.process.command_line)
    $shell_commands = array_distinct($shell.target.process.command_line)
    $shell_parents = array_distinct($shell.principal.process.file.full_path)
    $users = array_distinct($shell.principal.user.userid)

  condition:
    $pcap and $shell
}
