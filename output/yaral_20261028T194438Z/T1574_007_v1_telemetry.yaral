/*
  MITRE Technique : T1574.007 - Path Interception by PATH Environment Variable
  Tactic(s)       : Stealth, Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:33:44.195674+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_007_Path_Env_Registry_Writable_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry modification of the user or system PATH environment variable whose new value contains a user-writable directory (AppData, Temp, Public, ProgramData, Downloads or an expandable profile variable). Adversaries add such directories to PATH so that a planted binary is resolved before the legitimate system binary. This detects the persistent registry state change rather than the command line that produced it."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.007"
    mitre_technique_name = "Hijack Execution Flow: Path Interception by PATH Environment Variable"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon EID 12/13) with registry key, value name and value data populated in UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developer toolchain installers (Python, Node, Go, Chocolatey, Scoop) that add per-user or ProgramData directories to PATH; software installers and RMM or deployment agents; users configuring portable tools manually."
    tuning_guidance = "Add approved installer or deployment binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Add named administrators to %global_allowed_admin_users. If ProgramData-based toolchains are common, remove the ProgramData alternative from the value data regex for that client. Raise severity if the host is a server."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(Session Manager\\Environment|^(HKEY_USERS|HKU|HKEY_CURRENT_USER|HKCU)\\([^\\]+\\)?Environment)$/ nocase
    $reg.target.registry.registry_value_name = /^path$/ nocase
    $reg.target.registry.registry_value_data = /(\\users\\[^\\;]+\\appdata\\|\\users\\public\\|\\windows\\temp|\\temp\\|\\tmp\\|\\programdata\\|\\downloads\\|%(temp|tmp|appdata|localappdata|userprofile|public)%)/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1574.007")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $modifying_user = array_distinct($reg.principal.user.userid)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $new_path_value = array_distinct($reg.target.registry.registry_value_data)

  condition:
    $reg
}
