/*
  MITRE Technique : T1218.012 - Verclsid
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:58:04.291757+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_012_Verclsid_Anomalous_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects verclsid.exe (Extension CLSID Verification Host) launched by a parent process that should never start it, such as an Office application, script interpreter, LOLBin proxy, web server, database service or print spooler. In normal operation verclsid.exe is spawned by the Windows shell (explorer.exe) or COM/system hosts while verifying shell extensions. Launch from these parents indicates proxy execution of a COM payload."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.012"
    mitre_technique_name = "System Binary Proxy Execution: Verclsid"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with parent process path populated (EDR, Sysmon Event ID 1, or Security Event 4688 with parent process logging)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers or packaging tools that invoke verclsid.exe to validate shell extensions; administrator scripts or RMM tooling that call verclsid.exe from cmd or PowerShell; application-compatibility or QA test harnesses; Office add-ins that interact with shell extensions (rare)."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts. To widen coverage, extend the parent regex with additional internet-facing or line-of-business service executables. Because verclsid.exe is normally launched by explorer.exe, any new allowlist entry should be reviewed carefully."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\verclsid\.exe$/ nocase
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|cmd|powershell|powershell_ise|pwsh|wscript|cscript|mshta|rundll32|regsvr32|wmiprvse|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|sqlservr|spoolsv|java|node)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.012")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
