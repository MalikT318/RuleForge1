/*
  MITRE Technique : T1055.003 - Thread Execution Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:48:52.113329+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_003_Untrusted_Path_Process_Opens_Common_Injection_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process handle request (PROCESS_OPEN) where the requesting process runs from a user-writable location (profile, temp, ProgramData, Public) and the target is a long-lived Windows system or shell process commonly used as a thread-hijacking victim. Thread hijacking requires a handle to the victim before SuspendThread, SetThreadContext and ResumeThread are called, so this catches the technique at the handle-acquisition layer rather than the command line."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.003"
    mitre_technique_name = "Process Injection: Thread Execution Hijacking"
    log_prerequisites = "Requires endpoint telemetry that records process handle or access events (EDR process-open events or Sysmon Event ID 10) normalised to PROCESS_OPEN with populated principal and target process paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-user installed applications and updaters that interact with explorer or shell hosts (accessibility tools, screen readers, overlay and screen-capture utilities, game launchers), software installers running from Temp, unlisted EDR/AV or DLP agents, and developer debuggers run from user directories."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools, backup or imaging agents to %global_allowed_backup_processes, and IT tooling (RMM, deployment) to %global_allowed_admin_tools or %global_allowed_remote_mgmt. Review the first week of hits per client and extend the exclusion lists with the parent executable path of confirmed-benign sources. To tighten, narrow the target regex to the processes most relevant in your estate."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.process.file.full_path = /(?i)\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|users\\public|programdata|windows\\temp|temp)\\.+\.exe$/
    $open.target.process.file.full_path = /(?i)\\(explorer|svchost|notepad|spoolsv|dllhost|taskhostw|runtimebroker|sihost|rundll32|werfault|searchindexer|ctfmon|fontdrvhost|conhost)\.exe$/
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1055.003")
    $primary_entity = array_distinct($open.principal.hostname)
    $source_process = array_distinct($open.principal.process.file.full_path)
    $victim_process = array_distinct($open.target.process.file.full_path)
    $acting_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
