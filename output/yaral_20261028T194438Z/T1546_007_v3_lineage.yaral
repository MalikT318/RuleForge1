/*
  MITRE Technique : T1546.007 - Netsh Helper DLL
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:09:10.835337+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_007_Netsh_Helper_DLL_Anomalous_Child_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects netsh.exe acting as the parent of a shell, script interpreter or proxy-execution LOLBin. Netsh normally runs as a short-lived leaf process. When a registered netsh helper DLL is loaded, its code runs inside netsh.exe and commonly spawns child processes. This rule pivots on process lineage rather than command-line content."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.007"
    mitre_technique_name = "Event Triggered Execution: Netsh Helper DLL"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry that populates parent (principal.process) and child (target.process) image paths, from any EDR, Sysmon Event ID 1 or Security Event 4688 with parent process logging."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate VPN or network-management software that shells out through netsh.exe; admin or deployment scripts that launch netsh and then run helper commands; network diagnostic tooling and some endpoint hardening or provisioning agents."
    tuning_guidance = "Add approved admin tooling child binaries to %global_allowed_admin_tools. Add hosts that run known network-provisioning or VPN software to %global_allowed_script_hosts. Add authorised administrators to %global_allowed_admin_users. Review any alert whose host also shows a recent HKLM\\SOFTWARE\\Microsoft\\Netsh registry change or a new DLL in System32."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\netsh\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|wmic|bitsadmin|certutil|msiexec|installutil|regasm|regsvcs)\.exe$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.hostname in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1546.007")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
