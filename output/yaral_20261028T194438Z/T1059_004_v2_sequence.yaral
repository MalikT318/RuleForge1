/*
  MITRE Technique : T1059.004 - Unix Shell
  Tactic(s)       : Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:11:16.270460+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_004_Linux_Script_Download_Then_Outbound_Callback {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A Linux host fetches a shell script over HTTP from an external server using a command-line downloader, then opens an outbound connection to an external address on a non-standard high port within five minutes. This pattern is typical of a download-and-execute shell script that starts a reverse shell or C2 channel. It is detected purely from perimeter telemetry."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.004"
    mitre_technique_name = "Command and Scripting Interpreter: Unix Shell"
    log_prerequisites = "Requires firewall or proxy logs normalised to UDM with NETWORK_HTTP (URL and user agent populated, for example via TLS inspection or explicit proxy) and NETWORK_CONNECTION events, both with principal.ip populated."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate installers and bootstrap scripts (package repos, configuration management, cloud-init, vendor install one-liners) followed by an agent calling back on a high port. Developer and build servers pulling scripts and then reaching external services on custom ports. Authorised vulnerability scanners or red team sources."
    tuning_guidance = "Add known-good download sources and vendor domains to %global_allowed_domains. Add approved build, automation or bootstrap hosts to %global_allowed_script_hosts. Adjust the port exclusions or the user agent regex to fit local proxy behaviour. Extend the window only if the client's proxy logs are delayed."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\.(sh|bash)(\?.*)?$/ nocase
    $http.network.http.user_agent = /^(curl|wget)\// nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_script_hosts
    $http.principal.ip = $src_ip

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "TCP"
    $net.target.port > 1024
    not $net.target.port = 8080
    not $net.target.port = 8443
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts
    $net.principal.ip = $src_ip

    $http.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $src_ip over 5m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1059.004")
    $primary_entity = array_distinct($src_ip)
    $script_urls = array_distinct($http.target.url)
    $download_ips = array_distinct($http.target.ip)
    $callback_ips = array_distinct($net.target.ip)
    $callback_ports = array_distinct($net.target.port)
    $callback_count = count($net.metadata.id)

  condition:
    $http and $net
}
