/*
  MITRE Technique : T1016.002 - Wi-Fi Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:47:01.187770+00:00
  Reference       : https://attack.mitre.org/techniques/T1016/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_002_Linux_WiFi_Profile_Read_Then_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a non-network-manager process reading stored Wi-Fi profile or supplicant configuration files (which hold SSIDs and pre-shared keys) and the same host then making an external network connection from a shell, interpreter or transfer utility within 10 minutes. This indicates Wi-Fi credential discovery followed by possible exfiltration or staging. It is file-access based and does not depend on command-line matching."
    mitre_tactic = "Discovery"
    mitre_technique = "T1016.002"
    mitre_technique_name = "System Network Configuration Discovery: Wi-Fi Discovery"
    log_prerequisites = "Requires Linux file-read telemetry (auditd watch rules or EDR file-access events) on /etc/NetworkManager/system-connections/ and /etc/wpa_supplicant/, plus EDR or auditd network connection events with process attribution."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup agents and configuration management reading /etc; administrators troubleshooting Wi-Fi who then run curl, ssh or scp on the same host; provisioning or fleet-management scripts that collect network configuration and report to an external service; EDR or compliance agents scanning /etc."
    tuning_guidance = "Add backup agents to %global_allowed_backup_processes, EDR and compliance scanners to %global_allowed_security_tools, and config-management or provisioning tooling to %global_allowed_admin_tools. Add known-good script hosts to %global_allowed_script_hosts. Confirm that the auditd watch rules or EDR file-access policy cover the Wi-Fi profile directories, otherwise the file-read leg will not fire. Consider joining on the process path as well if volume is high on shared hosts."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /^\/etc\/(NetworkManager\/system-connections\/|wpa_supplicant\/)/ nocase
    not $file.principal.process.file.full_path = /\/(NetworkManager|wpa_supplicant|nm-[a-z-]+|systemd|systemd-networkd|netplan|dhclient|connmand|iwd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(curl|wget|nc|ncat|netcat|socat|openssl|scp|sftp|ssh|bash|sh|dash|zsh|python[0-9.]*|perl|ruby|php)$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    $net.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1016.002")
    $primary_entity = array_distinct($hostname)
    $wifi_files_read = array_distinct($file.target.file.full_path)
    $reading_processes = array_distinct($file.principal.process.file.full_path)
    $reading_users = array_distinct($file.principal.user.userid)
    $connecting_processes = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $file_read_count = count($file.metadata.id)

  condition:
    $file and $net
}
