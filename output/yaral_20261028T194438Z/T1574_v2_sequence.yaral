/*
  MITRE Technique : T1574 - Hijack Execution Flow
  Tactic(s)       : Stealth, Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:26:40.265452+00:00
  Reference       : https://attack.mitre.org/techniques/T1574
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_COM_Hijack_DLL_Drop_Then_Registry_Redirect {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A DLL is written to a user-writable location and, within ten minutes on the same host, a per-user COM class registration (InprocServer32/LocalServer32 under Software\\Classes\\CLSID) is set to point at a DLL in a user-writable path. This is the COM hijack variant of Hijack Execution Flow, used for persistence and defense evasion."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574"
    mitre_technique_name = "Hijack Execution Flow"
    log_prerequisites = "Requires EDR or Sysmon file creation telemetry (Sysmon EID 11) and registry value-set telemetry with value data (Sysmon EID 13) normalised to UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-user software installers and updaters that register COM servers under HKCU (some Office add-ins, collaboration clients, browser components, developer tooling such as Visual Studio or Python COM registration); portable applications run from AppData."
    tuning_guidance = "Add approved installer and deployment binaries to %global_allowed_admin_tools. Add known per-user COM registrars to %global_allowed_script_hosts or extend the process-name exclusion. If registry_value_data is not populated by the EDR, validate normalisation before deploying."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\[^\\]+\\appdata\\|programdata\\|windows\\temp\\|users\\public\\)([^\\]+\\)*[^\\]+\.dll$/ nocase
    not $file.principal.process.file.full_path = /\\(msiexec|TrustedInstaller|MsMpEng|svchost)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Software\\Classes\\CLSID\\\{[0-9a-f\-]+\}\\(InprocServer32|LocalServer32)$/ nocase
    $reg.target.registry.registry_value_data = /\\(users\\[^\\]+\\appdata|programdata|windows\\temp|users\\public)\\.*\.dll/ nocase
    not $reg.principal.process.file.full_path = /\\(msiexec|TrustedInstaller|MsMpEng)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    $reg.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1574")
    $primary_entity = array_distinct($reg.principal.hostname)
    $dropped_dlls = array_distinct($file.target.file.full_path)
    $hijacked_keys = array_distinct($reg.target.registry.registry_key)
    $registered_payloads = array_distinct($reg.target.registry.registry_value_data)
    $acting_processes = array_distinct($reg.principal.process.file.full_path)
    $acting_users = array_distinct($reg.principal.user.userid)

  condition:
    $file and $reg
}
