/*
  MITRE Technique : T1480 - Execution Guardrails
  Tactic(s)       : Stealth
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:23:07.877866+00:00
  Reference       : https://attack.mitre.org/techniques/T1480
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1480_Anomalous_Parent_Environment_Guardrail_Check {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter spawned by an Office application, web or application server, print spooler or database service whose command line compares host environment values (domain, computer name, logon server) against an expected value before continuing. This is typical of execution guardrails, where a payload only runs on the intended victim. The detection pivots on the unexpected parent-child lineage plus the environment-keyed conditional logic."
    mitre_tactic = "Stealth"
    mitre_technique = "T1480"
    mitre_technique_name = "Execution Guardrails"
    log_prerequisites = "Requires Windows process creation telemetry with full parent and child image paths and command lines (EDR, Sysmon Event ID 1 or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Office macros or add-ins that adapt behaviour to the user's domain; web or database applications that shell out to run domain-aware maintenance scripts; software deployment or inventory wrappers launched from application servers; login scripts triggered by Outlook-based tooling."
    tuning_guidance = "Add approved parent processes (for example internal application servers that legitimately shell out) to %global_allowed_script_hosts and approved tooling to %global_allowed_admin_tools. Exclude known service accounts via %global_allowed_service_accounts. If the parent list is too broad for a client, trim it per environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|sqlservr|mysqld|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(\bif\s+(\/i\s+)?["']?%(userdomain|userdnsdomain|computername|logonserver|username)%|\$env:(userdomain|userdnsdomain|computername|logonserver)\b.*-(eq|ne|ceq|like|notlike|match|notmatch)\b|-(eq|ne|ceq|like|notlike|match|notmatch)\b.*\$env:(userdomain|userdnsdomain|computername|logonserver)\b|win32_computersystem.*\bdomain\b|getcomputerdomain|get-addomain|nltest.*\/(dsgetdc|domain_trusts)|net\s+config\s+workstation.*\b(find|findstr)\b|userdomain.*(findstr|find\s)|%userdnsdomain%.*(findstr|find\s))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1480")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
