/*
  MITRE Technique : T1569 - System Services
  Tactic(s)       : Execution
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:09:38.921975+00:00
  Reference       : https://attack.mitre.org/techniques/T1569
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_Linux_Service_Daemon_Spawns_Service_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application runtime, database or file-sharing daemon spawning systemctl, service, systemd-run, or a shell whose command line starts, restarts or enables a service or transient unit. These daemons do not normally manage system services. This lineage typically follows web shell, injection or database-abuse exploitation, where the attacker uses system services to execute payloads or gain persistence."
    mitre_tactic = "Execution"
    mitre_technique = "T1569"
    mitre_technique_name = "System Services"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records normalised to UDM PROCESS_LAUNCH, with parent process path and child command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web or database administration panels that restart services by design, application self-update or deployment hooks run from the daemon, database maintenance or archive hooks that call service managers, and control scripts launched by a daemon for graceful reload (for example reloading nginx or php-fpm after a certificate renewal)."
    tuning_guidance = "Add approved deployment or management parent binaries to %global_allowed_admin_tools. Add known-good hosts or parent script hosts to %global_allowed_script_hosts. If a specific daemon legitimately reloads services in your environment, narrow the child command-line verbs or exclude the parent through the allowlists rather than removing the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9.]*|php-cgi|php|tomcat[0-9]*|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|smbd|cupsd)$/ nocase
    $proc.target.process.file.full_path = /\/(systemctl|service|systemd-run|sh|bash|dash|zsh|ksh|ash)$/ nocase
    $proc.target.process.command_line = /(\bsystemctl\b.*\b(start|restart|enable|daemon-reload|link)\b|\bservice\s+\S+\s+(start|restart)\b|\bsystemd-run\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1569")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
