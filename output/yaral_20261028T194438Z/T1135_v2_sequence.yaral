/*
  MITRE Technique : T1135 - Network Share Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:03:58.794914+00:00
  Reference       : https://attack.mitre.org/techniques/T1135
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1135_Linux_SMB_Then_NFS_Share_Probe_Same_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A single non-approved Linux process connects to internal hosts on SMB (139/445) and then on NFS/rpcbind (2049/111) within ten minutes. This multi-protocol file-share probing from one process on one host is characteristic of network share discovery. It is detected from network telemetry rather than process command lines, so it still fires if the tool is renamed or run through a wrapper script."
    mitre_tactic = "Discovery"
    mitre_technique = "T1135"
    mitre_technique_name = "Network Share Discovery"
    log_prerequisites = "Requires Linux EDR or auditd network connection telemetry with process attribution (principal.process.file.full_path populated on NETWORK_CONNECTION events)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup agents, file-sync or migration jobs, configuration management runs, autofs/automount helpers, internal vulnerability scanners and asset-inventory tooling, and admins troubleshooting file-server connectivity."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools, %global_allowed_backup_processes, %global_allowed_scanners or %global_allowed_remote_mgmt (keyed on process path). Add approved automation hosts to %global_allowed_script_hosts if they are keyed on process path. If noisy on file-server-heavy hosts, extend the mount-helper exclusion regex or shorten the window."

  events:
    $smb.metadata.event_type = "NETWORK_CONNECTION"
    ($smb.target.port = 445 or $smb.target.port = 139)
    $smb.target.ip in %rfc1918_internal
    $smb.principal.process.file.full_path != ""
    not $smb.principal.process.file.full_path = /\/(mount\.cifs|mount\.nfs|mount\.nfs4|mount|umount|automount|autofs|systemd)$/ nocase
    not $smb.principal.process.file.full_path in %global_allowed_admin_tools
    not $smb.principal.process.file.full_path in %global_allowed_backup_processes
    not $smb.principal.process.file.full_path in %global_allowed_scanners
    not $smb.principal.process.file.full_path in %global_allowed_remote_mgmt
    $smb.principal.hostname = $hostname
    $smb.principal.process.file.full_path = $proc_path

    $nfs.metadata.event_type = "NETWORK_CONNECTION"
    ($nfs.target.port = 2049 or $nfs.target.port = 111)
    $nfs.target.ip in %rfc1918_internal
    $nfs.principal.process.file.full_path != ""
    not $nfs.principal.process.file.full_path = /\/(mount\.cifs|mount\.nfs|mount\.nfs4|mount|umount|automount|autofs|systemd)$/ nocase
    not $nfs.principal.process.file.full_path in %global_allowed_admin_tools
    not $nfs.principal.process.file.full_path in %global_allowed_backup_processes
    not $nfs.principal.process.file.full_path in %global_allowed_scanners
    not $nfs.principal.process.file.full_path in %global_allowed_remote_mgmt
    $nfs.principal.hostname = $hostname
    $nfs.principal.process.file.full_path = $proc_path

    $smb.metadata.event_timestamp.seconds <= $nfs.metadata.event_timestamp.seconds

  match:
    $hostname, $proc_path over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1135")
    $primary_entity = array_distinct($hostname)
    $probing_process = array_distinct($proc_path)
    $smb_targets = array_distinct($smb.target.ip)
    $nfs_targets = array_distinct($nfs.target.ip)
    $probing_user = array_distinct($smb.principal.user.userid)
    $smb_connection_count = count($smb.metadata.id)

  condition:
    $smb and $nfs
}
