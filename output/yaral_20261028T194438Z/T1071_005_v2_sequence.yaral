/*
  MITRE Technique : T1071.005 - Publish/Subscribe Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:11:03.618431+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_005_Linux_Staged_Binary_Connects_PubSub_Broker {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A file is created in a world-writable staging directory (/tmp, /var/tmp, /dev/shm) and, within five minutes, that same file path is the process making an external connection to a well-known publish/subscribe broker port (MQTT, AMQP, STOMP, XMPP). This indicates a dropped implant using a pub/sub protocol for C2. The rule correlates file and network telemetry, so it does not duplicate command-line detections."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.005"
    mitre_technique_name = "Application Layer Protocol: Publish/Subscribe Protocols"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that produces both FILE_CREATION and NETWORK_CONNECTION events with the originating process path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers or IoT engineers running test MQTT/AMQP clients from /tmp, containerised build or CI jobs that unpack and run brokers or clients from temp directories, self-extracting software installers or agents that connect to a cloud message broker."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools (creator or connecting process) and security agents to %global_allowed_security_tools. Add legitimate broker destinations to %global_allowed_domains where the target hostname is populated, or exclude by CI/build host using %global_allowed_script_hosts. Adjust the port list if a client uses non-standard broker ports."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/./ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $path

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/./ nocase
    (
      $net.target.port = 1883 or
      $net.target.port = 8883 or
      $net.target.port = 5672 or
      $net.target.port = 5671 or
      $net.target.port = 61613 or
      $net.target.port = 61614 or
      $net.target.port = 5222 or
      $net.target.port = 5269
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    $net.principal.hostname = $hostname
    $net.principal.process.file.full_path = $path

    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1071.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $staged_binary = array_distinct($net.principal.process.file.full_path)
    $broker_ips = array_distinct($net.target.ip)
    $broker_ports = array_distinct($net.target.port)
    $connection_count = count($net.metadata.id)

  condition:
    $file and $net
}
