/*
  MITRE Technique : T1111 - Multi-Factor Authentication Interception
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:10:54.213105+00:00
  Reference       : https://attack.mitre.org/techniques/T1111
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1111_Unexpected_Parent_Spawns_Shell_MFA_Interception_Staging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a script interpreter or shell-capable LOLBin launched by a parent process that should never spawn one: an Office application, web server worker, database service, print spooler, or the federation/identity service host. Staging a keylogger, token-capture or authentication-proxy tooling (T1111) on a server or workstation involved in MFA often starts from such a foothold. The detection pivots on process lineage and does not rely on command-line content."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1111"
    mitre_technique_name = "Multi-Factor Authentication Interception"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with populated parent (principal.process.file.full_path) and child (target.process.file.full_path) image paths, from an EDR, Sysmon Event ID 1, or Windows Security Event 4688 with parent process logging."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "SQL Server Agent jobs or xp_cmdshell used by legitimate database maintenance, IIS-hosted applications that intentionally shell out (report generators, deployment hooks), Office macros or add-ins from line-of-business software that call cmd or cscript, print drivers and print-management software that spawn helpers from the spooler, and application installers launched from Office."
    tuning_guidance = "Add approved parent processes (for example a specific application server host) to %global_allowed_script_hosts. Add sanctioned IT automation and deployment binaries to %global_allowed_admin_tools. If xp_cmdshell is used legitimately, scope the exclusion through the parent path in %global_allowed_script_hosts. Raise severity for hosts that run MFA, federation, or authentication infrastructure."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat\d*|java|php-cgi|sqlservr|mysqld|spoolsv|Microsoft\.IdentityServer\.ServiceHost)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|wmic|msbuild|installutil)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1111")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
