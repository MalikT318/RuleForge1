/*
  MITRE Technique : T1046 - Network Service Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:28:30.477067+00:00
  Reference       : https://attack.mitre.org/techniques/T1046
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1046_K8s_ClusterWide_Service_Endpoint_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a non-system identity listing Services, Endpoints or EndpointSlices across the whole cluster through the control-plane API. Cluster-wide enumeration of these objects maps every reachable network service and its backing pod addresses. Attackers with a stolen token or service-account credential use it for network service discovery instead of running a scanner, and it leaves no process or command-line trace. This rule detects the control-plane audit record of the enumeration."
    mitre_tactic = "Discovery"
    mitre_technique = "T1046"
    mitre_technique_name = "Network Service Discovery"
    log_prerequisites = "Requires Kubernetes API server audit logs ingested and normalised to UDM. The audit policy must record at least Metadata level for services, endpoints and endpointslices, and the request URI must be mapped to target.url."
    platform = "IaaS"
    log_source = "container"
    false_positives = "Service mesh control planes, ingress controllers, DNS and service-discovery operators, monitoring and observability agents, GitOps and CI/CD tooling, cluster cost or inventory tools, and administrators running kubectl get services -A."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, cloud or workload-identity principals to %global_allowed_cloud_principals, and named administrators to %global_allowed_admin_users. Extend the system account regex if the distribution uses a different control-plane naming convention. Raise severity for anonymous or external identities."

  events:
    $k8s.metadata.event_type = "USER_RESOURCE_ACCESS"
    $k8s.metadata.product_event_type = /^(list|get|watch)$/ nocase
    $k8s.target.url = /^\/api(s\/discovery\.k8s\.io\/v1(beta1)?)?\/(v1\/)?(services|endpoints|endpointslices)(\?.*)?$/ nocase
    $k8s.principal.user.userid != ""
    not $k8s.principal.user.userid = /^system:(kube-|node|serviceaccount:kube-system|serviceaccount:[^:]+:(coredns|kube-proxy))/ nocase
    not $k8s.principal.user.userid in %global_allowed_service_accounts
    not $k8s.principal.user.userid in %global_allowed_admin_users
    not $k8s.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1046")
    $primary_entity = array_distinct($k8s.principal.user.userid)
    $source_ips = array_distinct($k8s.principal.ip)
    $requested_urls = array_distinct($k8s.target.url)
    $api_verbs = array_distinct($k8s.metadata.product_event_type)

  condition:
    $k8s
}
