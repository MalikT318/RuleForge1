/*
  MITRE Technique : T1609 - Container Administration Command
  Tactic(s)       : Execution
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:28:23.153054+00:00
  Reference       : https://attack.mitre.org/techniques/T1609
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1609_Container_Exec_Volume_Per_User {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single identity issued an unusually high number of exec requests against pods through the container orchestration API within ten minutes. One exec call is routine administration. Repeated exec calls from one identity indicate interactive hands-on-keyboard activity inside containers, scripted command execution, or abuse of a stolen credential or service-account token."
    mitre_tactic = "Execution"
    mitre_technique = "T1609"
    mitre_technique_name = "Container Administration Command"
    log_prerequisites = "Kubernetes API server audit logging enabled at Metadata level or higher, so requests to the pod exec subresource are recorded, and ingested into Chronicle with the requested URI mapped to target.url and the caller mapped to principal.user.userid."
    platform = "Containers"
    log_source = "container"
    false_positives = "Engineers debugging workloads during an incident, CI/CD or GitOps pipelines running in-pod smoke tests, operators and controllers that exec into pods for health or backup tasks, and platform teams performing maintenance windows."
    tuning_guidance = "Add automation and controller identities to %global_allowed_service_accounts and approved platform engineers to %global_allowed_admin_users. Raise or lower the #k8s threshold per client baseline. Review the exec_targets outcome to see which pods were touched, and prioritise production namespaces."

  events:
    $k8s.metadata.event_type = "USER_RESOURCE_ACCESS"
    $k8s.target.url = /\/pods\/[^\/]+\/exec/ nocase
    $k8s.principal.user.userid = $user
    not $k8s.principal.user.userid in %global_allowed_service_accounts
    not $k8s.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1609")
    $primary_entity = array_distinct($user)
    $event_count = count($k8s.metadata.id)
    $exec_targets = array_distinct($k8s.target.url)
    $source_ips = array_distinct($k8s.principal.ip)

  condition:
    #k8s >= 5
}
