/*
  MITRE Technique : T1564.012 - File/Path Exclusions
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:32:48.745668+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_012_Executable_Drops_In_Default_AV_Exclusion_Paths {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several executable or script files are written to well-known default antivirus exclusion locations on one host within ten minutes. These include the Windows Update datastore, Defender scan and quarantine working folders, the Security database folder, and the NTDS and SYSVOL role folders. Each write is benign on its own, but repeated drops of executable content into these paths suggest an adversary hiding payloads in locations that scanners skip."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.012"
    mitre_technique_name = "Hide Artifacts: File/Path Exclusions"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent) with the target file path and initiating process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows Update and servicing stack activity, domain controller promotion or SYSVOL logon-script deployment by administrators, AD and DFSR replication of scripts into SYSVOL, security product self-update routines writing to their own working folders, and software deployment tools staging scripts."
    tuning_guidance = "Add approved deployment and patching binaries to %global_allowed_admin_tools and security agent processes to %global_allowed_security_tools. Add approved GPO or logon-script publishers to %global_allowed_admin_users. Raise the #file threshold for domain controllers where SYSVOL script changes are routine. Extend the process-name exclusion regex for client-specific servicing agents."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\windows\\softwaredistribution\\datastore\\|\\programdata\\microsoft\\windows defender\\(scans|quarantine)\\|\\windows\\security\\database\\|\\windows\\ntds\\|\\windows\\sysvol\\/ nocase
    $file.target.file.full_path = /\.(exe|dll|sys|scr|ps1|bat|cmd|vbs|js|hta|msi)$/ nocase
    not $file.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|NisSrv|TiWorker|TrustedInstaller)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_admin_users
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1564.012")
    $primary_entity = array_distinct($host)
    $file_count = count($file.metadata.id)
    $dropped_paths = array_distinct($file.target.file.full_path)
    $dropping_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
