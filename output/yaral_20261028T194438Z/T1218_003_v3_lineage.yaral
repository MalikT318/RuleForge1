/*
  MITRE Technique : T1218.003 - CMSTP
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:45:32.908548+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_003_CMSTP_Anomalous_Process_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects anomalous process lineage around CMSTP.exe. Branch 1: cmstp.exe spawns a shell, script interpreter or proxy-execution binary, which is the usual result of a malicious INF abusing CMSTP (including the auto-elevated COM UAC bypass). Branch 2: cmstp.exe is launched by an unexpected parent such as an Office application, script host, web server, database service or print spooler. Detection relies only on parent/child image paths, not command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.003"
    mitre_technique_name = "System Binary Proxy Execution: CMSTP"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with populated parent (principal) and child (target) process image paths, from an EDR, Sysmon Event ID 1 or Security Event 4688 with parent process logging."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "VPN or Connection Manager profile deployment by IT (SCCM/Intune packages, logon scripts, VPN client installers) that launch cmstp.exe from script hosts; custom Connection Manager profile actions that start helper executables; software packaging and testing on build hosts."
    tuning_guidance = "Add approved deployment, VPN-packaging and RMM binaries to %global_allowed_admin_tools. Add parent processes and hosts that legitimately run scripted CMSTP installs to %global_allowed_script_hosts. If the Connection Manager profile in use launches a known helper process, narrow the child regex for that environment rather than disabling the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $proc.principal.process.file.full_path = /\\cmstp\.exe$/ nocase and
        $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|regsvr32|rundll32|bitsadmin|certutil|wmic)\.exe$/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\\cmstp\.exe$/ nocase and
        $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|onenote|wscript|cscript|mshta|w3wp|httpd|nginx|sqlservr|spoolsv)\.exe$/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1218.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
