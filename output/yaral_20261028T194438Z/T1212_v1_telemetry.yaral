/*
  MITRE Technique : T1212 - Exploitation for Credential Access
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:19:54.102543+00:00
  Reference       : https://attack.mitre.org/techniques/T1212
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1212_AD_Machine_Account_Password_Change_By_Anonymous {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects a directory-level state change: a computer (machine) account password is changed or reset by an anonymous or unauthenticated principal. This is the RESULT of authentication-protocol exploitation (for example a Netlogon secure-channel flaw) that lets an attacker take over a domain controller or server account without credentials. The rule watches the identity audit layer, not process command lines, so it fires whatever tool or exploit payload was used."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1212"
    mitre_technique_name = "Exploitation for Credential Access"
    log_prerequisites = "Requires Active Directory directory-service audit events (account management auditing enabled on domain controllers, such as Windows Security events 4742 and 4724) ingested and normalized to UDM USER_CHANGE_PASSWORD with principal.user.userid and target.user.userid populated."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Domain join or rejoin operations in some legacy workflows, misparsed events where the actor field is blank or a placeholder, and directory migration or cloning tools running unauthenticated during domain controller promotion."
    tuning_guidance = "Add legitimate automation or migration accounts to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. If the parser populates the actor with a different placeholder for unauthenticated callers, extend the principal regex accordingly. Validate in a lab that the client parser maps the Security event subject account to principal.user.userid."

  events:
    $auth.metadata.event_type = "USER_CHANGE_PASSWORD"
    $auth.target.user.userid = /\$$/
    $auth.principal.user.userid = /^(anonymous logon|-)$/ nocase
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1212")
    $primary_entity = array_distinct($auth.target.user.userid)
    $source_ips = array_distinct($auth.principal.ip)
    $target_hosts = array_distinct($auth.target.hostname)

  condition:
    $auth
}
