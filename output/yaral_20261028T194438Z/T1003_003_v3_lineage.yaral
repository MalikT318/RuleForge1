/*
  MITRE Technique : T1003.003 - NTDS
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:41:18.993287+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_003_NTDS_Unexpected_Parent_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects an application that should never drive credential-store tooling (Office, web server, database service, print spooler, Java application server) launching a shell, script interpreter or native shadow-copy/ESE utility with NTDS.dit or volume-shadow-copy extraction arguments. Pivots on the anomalous parent-child lineage rather than on the command line alone, covering web-shell, macro and SQL xp_cmdshell driven Active Directory database theft."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.003"
    mitre_technique_name = "OS Credential Dumping: NTDS"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with parent process path and full command line (EDR, Sysmon Event ID 1 or Windows Security Event 4688 with command-line auditing). Most valuable when ingested from domain controllers and servers hosting web or database roles."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup or DR agents launched from a database or Java-based management service that snapshot volumes; application-server based admin consoles that run vssadmin or diskshadow; legitimate SQL Server maintenance jobs using xp_cmdshell for VSS-based backups; patching or imaging frameworks hosted in Java services."
    tuning_guidance = "Add approved parent binaries (backup agents, deployment services) to %global_allowed_admin_tools, trusted automation parents to %global_allowed_script_hosts, and approved service accounts to %global_allowed_service_accounts. Extend or trim the parent process list in the regex to match client application stacks."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Unexpected parent: Office, web/app server, DB engine, print spooler
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|w3wp|httpd|nginx|php-cgi|tomcat[0-9]*|java|sqlservr|spoolsv)\.exe$/ nocase

    // Child: shell, interpreter, or native utility able to copy or extract the AD database
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|ntdsutil|vssadmin|diskshadow|esentutl|wmic)\.exe$/ nocase

    // NTDS / shadow copy extraction context in arguments
    $proc.target.process.command_line = /(ntds|activate\s+instance|\bifm\b|create\s+(full|shadow)|shadow\s*copy|\bshadows?\b|diskshadow|vssadmin|\\config\\(sam|system|security)\b|esentutl)/ nocase

    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1003.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
