/*
  MITRE Technique : T1132.001 - Standard Encoding
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:45:36.356373+00:00
  Reference       : https://attack.mitre.org/techniques/T1132/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1132_001_Linux_Encoded_Staging_File_Then_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects an encoded-data file (Base64, Base32, hex or uuencode extension) created in a world-writable staging directory (/tmp, /var/tmp, /dev/shm), followed within 10 minutes by an external network connection from a transfer-capable or scripting process on the same host. This pattern is consistent with C2 data being encoded to a staging file and then sent out. It is based on file and network telemetry, not process command lines."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1132.001"
    mitre_technique_name = "Data Encoding: Standard Encoding"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that populates FILE_CREATION (with target.file.full_path and the writing process) and NETWORK_CONNECTION (with the originating process path and target.ip) events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers and admins who Base64-encode certificates, keys or config blobs in /tmp and then use curl or wget; CI/CD runners and build agents; configuration management tools; backup or package tooling that stages .enc files; Python or Perl automation that talks to external APIs."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools and %global_allowed_backup_processes (both are applied to the file writer and the network process). Scope noisy build hosts via %global_allowed_script_hosts or exclude them per client. Extend or narrow the extension and process lists to fit local conventions. If the file event reports the shell as the writer instead of the encoder, the writer exclusion can be tightened to specific interpreters."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+\.(b64|base64|b32|base32|hex|uu|enc)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    $file.principal.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(curl|wget|nc|ncat|netcat|socat|python[0-9.]*|perl|ruby|php)$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    $net.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1132.001")
    $primary_entity = array_distinct($hostname)
    $encoded_files = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $network_processes = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $connection_count = count($net.metadata.id)

  condition:
    $file and $net
}
