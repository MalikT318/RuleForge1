/*
  MITRE Technique : T1218.009 - Regsvcs/Regasm
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:53:46.015990+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_009_Regasm_Regsvcs_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a .NET assembly registration utility (Regasm or Regsvcs) making an outbound network connection to a non-internal address. These utilities register local COM assemblies and have no legitimate need to reach the internet, so an external connection indicates that code run through [ComRegisterFunction] or [ComUnregisterFunction] is beaconing or downloading a payload. This rule uses NETWORK_CONNECTION telemetry rather than process-creation command lines, so it complements command-line detections and still fires when command-line arguments are obfuscated. Regasm and Regsvcs are Windows-only .NET Framework utilities, so there is no Linux, macOS, or cloud equivalent. This variant is written for Windows."
    mitre_tactic = "Stealth (Defense Evasion)"
    mitre_technique = "T1218.009"
    mitre_technique_name = "System Binary Proxy Execution: Regsvcs/Regasm"
    log_prerequisites = "Requires Windows endpoint network telemetry that records the originating process path (EDR network events or Sysmon Event ID 3), normalised to UDM NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare. Possible sources are software installers or build and deployment pipelines that register .NET COM assemblies from a network share or perform CRL/OCSP lookups for signed assemblies, developer workstations running Regasm against remote resources, and RMM or deployment tooling."
    tuning_guidance = "Add approved deployment tooling or build-server identities to %global_allowed_admin_tools and %global_allowed_admin_users. If CRL/OCSP or certificate-validation traffic causes noise, exclude those destinations via %global_allowed_domains. Review any hit together with the parent process and any preceding file creation of a DLL in a user-writable location."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(regasm|regsvcs)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.009")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
