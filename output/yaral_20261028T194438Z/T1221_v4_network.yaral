/*
  MITRE Technique : T1221 - Template Injection
  Tactic(s)       : Stealth
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:14:27.012887+00:00
  Reference       : https://attack.mitre.org/techniques/T1221
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1221_Office_Outbound_SMB_Template_Injection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office application process opening an outbound SMB connection (TCP 445 or 139) to a non-internal address. Remote template injection and forced-authentication documents reference an external UNC or WebDAV-style template path. Office then reaches out over SMB, which can leak NTLM credentials or fetch a malicious template. Legitimate Office use rarely involves SMB to the internet."
    mitre_tactic = "Stealth"
    mitre_technique = "T1221"
    mitre_technique_name = "Template Injection"
    log_prerequisites = "Requires EDR or Sysmon-equivalent network connection telemetry (Sysmon Event ID 3 or equivalent) with the initiating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Hybrid or VPN-split-tunnel users opening documents from corporate file shares that resolve to non-RFC1918 or NATed addresses; Office documents on approved cloud SMB shares (for example Azure Files); mis-scoped internal address lists."
    tuning_guidance = "Confirm %rfc1918_internal covers the client's internal ranges. Add approved external file-share domains to %global_allowed_domains. Treat hits as high priority: check the opened document, block outbound 445 at the perimeter, and review for NTLM hash exposure."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|visio|mspub|msaccess)\.exe$/ nocase
    ($net.target.port = 445 or $net.target.port = 139)
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1221")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $office_process = array_distinct($net.principal.process.file.full_path)
    $affected_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
