/*
  MITRE Technique : T1001.002 - Steganography
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:08:39.231153+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_002_PowerShell_Image_Pixel_Decode_Execute {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a PowerShell process whose command line combines image-processing APIs (bitmap loading or pixel reads) with decode-and-execute primitives (Base64 decoding, Invoke-Expression, in-memory assembly load). This is the typical pattern for extracting a payload or C2 instructions hidden inside an image file (steganography). Note: this rule is written for Windows because the task's mandatory platform requirement is Windows, so the alternate-platform angle was not applied."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001.002"
    mitre_technique_name = "Data Obfuscation: Steganography"
    log_prerequisites = "Requires EDR process telemetry, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled. The command line must be populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Image-processing or thumbnail-generation admin scripts, report-generation scripts that build charts with System.Drawing, developer automation and build pipelines, and legitimate installers that embed Base64 resources alongside bitmap handling."
    tuning_guidance = "Add approved automation parent processes to %global_allowed_script_hosts, approved tooling to %global_allowed_admin_tools, and known automation accounts to %global_allowed_service_accounts. Review recurring hits per host and allowlist the parent process rather than loosening the regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|powershell_ise)\.exe$/ nocase
    $proc.target.process.command_line = /(System\.Drawing\.(Bitmap|Image)|Drawing\.Bitmap|LockBits|GetPixel|ImageConverter)/ nocase
    $proc.target.process.command_line = /(FromBase64String|Invoke-Expression|\biex\b|Assembly\]::Load|\[char\]\s*\$|-bxor)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1001.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
