/*
  MITRE Technique : T1218.004 - InstallUtil
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:47:48.908997+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_004_InstallUtil_Artifact_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of .NET installer artifact files (.InstallLog / .InstallState) created on a single host within 10 minutes. InstallUtil and the System.Configuration.Install framework write these files next to the assembly each time an installer class is executed, so repeated creation points to InstallUtil proxy execution of custom .NET assemblies. The rule matches the file-creation side effect rather than the process command line, so it still fires if the binary is renamed or copied, and it complements process-creation rules."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.004"
    mitre_technique_name = "System Binary Proxy Execution: InstallUtil"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent) mapped to UDM FILE_CREATION with target.file.full_path and principal.hostname populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate .NET software installers and MSI custom actions that call InstallUtil, software deployment and patching tools, developers testing installer classes on build or workstation hosts, and .NET service installation by IT staff."
    tuning_guidance = "Add deployment, packaging and RMM tooling to %global_allowed_admin_tools, and automation or build accounts to %global_allowed_service_accounts. Raise the #file threshold on developer or build hosts. Investigate the file paths in the outcome for user-writable locations such as Temp, Downloads or AppData."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(installlog|installstate)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1218.004")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $artifact_paths = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
