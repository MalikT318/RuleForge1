/*
  MITRE Technique : T1041 - Exfiltration Over C2 Channel
  Tactic(s)       : Exfiltration
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 1h
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:00:20.454715+00:00
  Reference       : https://attack.mitre.org/techniques/T1041
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1041_ESXi_High_Volume_External_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects an ESXi host making an unusually high number of outbound connections to external (non-RFC1918) destinations within one hour. Hypervisor hosts normally talk only to internal management, storage and time infrastructure, so sustained external egress is consistent with data staging and exfiltration over an established C2 channel. The individual connection is benign, but the volume is not."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1041"
    mitre_technique_name = "Exfiltration Over C2 Channel"
    log_prerequisites = "ESXi host network telemetry (firewall or vmkernel connection logging and syslog forwarding) normalised to UDM NETWORK_CONNECTION with principal.hostname, target.ip and network.direction populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Host patching or VIB downloads from vendor depots, NTP or DNS to external resolvers, call-home or telemetry services, cloud-backup or replication agents, monitoring agents that forward to external SaaS endpoints, and vendor-supported remote support sessions."
    tuning_guidance = "Add approved external destinations or update services to %global_allowed_domains. Add approved management or backup source addresses to %global_allowed_mgmt_sources. Add approved backup agents to %global_allowed_backup_processes. Raise or lower the #net threshold per client baseline. 25 connections per host per hour is conservative because ESXi hosts rarely initiate external connections."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.direction = "OUTBOUND"
    $net.principal.hostname = $host
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    $net.target.port != 53
    $net.target.port != 123

  match:
    $host over 1h

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1041")
    $primary_entity = array_distinct($host)
    $event_count = count($net.metadata.id)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 25
}
