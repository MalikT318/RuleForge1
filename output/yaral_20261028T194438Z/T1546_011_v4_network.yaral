/*
  MITRE Technique : T1546.011 - Application Shimming
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:15:18.660899+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_011_Shim_Installer_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Windows application compatibility shim installer (sdbinst.exe) opening a network connection to a non-internal address. The installer works on local shim databases (.sdb) and has no legitimate need to reach the internet. Outbound traffic from it suggests a shim database being fetched or the installer being abused as a download or proxy-execution binary for shim-based persistence or privilege escalation."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.011"
    mitre_technique_name = "Event Triggered Execution: Application Shimming"
    log_prerequisites = "Requires endpoint network telemetry that records the initiating process path, such as EDR network events or Sysmon Event ID 3, normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software packagers or deployment tools that install shims from a remote location, application compatibility testing by IT or developers, and rare certificate or revocation lookups triggered while the signed binary runs. Connections to known vendor infrastructure are the most likely benign source."
    tuning_guidance = "Add approved deployment or packaging administrator accounts to %global_allowed_admin_users. Add known-good vendor destinations to %global_allowed_domains. Pair this rule with registry-based detections on the AppCompatFlags InstalledSDB and Custom keys for full coverage."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\sdbinst\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.user.userid in %global_allowed_admin_users
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1546.011")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $acting_users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
