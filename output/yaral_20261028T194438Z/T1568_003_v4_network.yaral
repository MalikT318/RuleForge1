/*
  MITRE Technique : T1568.003 - DNS Calculation
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:08:13.755403+00:00
  Reference       : https://attack.mitre.org/techniques/T1568/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1568_003_Windows_Untrusted_Process_High_Port_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side detection of an outbound TCP connection to an external address on a high, non-standard destination port. The connection comes from a process running out of a user-writable location or from a script-host/proxy-execution binary. This is the typical result of DNS Calculation, where malware derives the C2 port (and sometimes the IP) from DNS answer octets so the port is not fixed and egress filtering is bypassed."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1568.003"
    mitre_technique_name = "Dynamic Resolution: DNS Calculation"
    log_prerequisites = "Requires endpoint network telemetry that attributes outbound TCP connections to the initiating process (EDR network events or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path and target.port populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Peer-to-peer or collaboration clients installed per-user (game launchers, torrent clients, VoIP/meeting apps, sync tools) using high ports; developer tools and test servers run from user profiles; line-of-business apps installed under ProgramData that use custom service ports; legitimate rundll32/wscript-hosted components connecting to vendor services."
    tuning_guidance = "Add approved per-user applications and deployment tooling to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, and known-good vendor destinations to %global_allowed_domains. Raise the port threshold (for example to 20000) in noisy estates. Review externally resolved destination hostnames and repeated connections to the same IP with varying ports for confirmation."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "TCP"
    $net.target.port >= 10000
    $net.principal.process.file.full_path = /(\\users\\[^\\]+\\appdata\\|\\programdata\\|\\users\\public\\|\\windows\\temp\\|\\(rundll32|regsvr32|mshta|wscript|cscript)\.exe$)/ nocase
    not $net.principal.process.file.full_path = /\\(chrome|msedge|firefox|brave|teams|ms-teams|onedrive|slack|zoom|discord|spotify|msmpeng|mssense)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1568.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
