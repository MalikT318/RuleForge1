/*
  MITRE Technique : T1484.001 - Group Policy Modification
  Tactic(s)       : Defense Impairment, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:32:47.603084+00:00
  Reference       : https://attack.mitre.org/techniques/T1484/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1484_001_Unexpected_Parent_Spawns_GPO_Activity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter that is spawned by an unexpected parent process (Office application, web server worker, print spooler or database service) and whose arguments reference Group Policy objects, SYSVOL policy storage or GPO management cmdlets. Legitimate GPO administration is not launched from these parents, so this lineage indicates exploitation or macro or web-shell driven GPO tampering."
    mitre_tactic = "Defense Impairment, Privilege Escalation"
    mitre_technique = "T1484.001"
    mitre_technique_name = "Domain or Tenant Policy Modification: Group Policy Modification"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and child command line populated (EDR, Sysmon Event ID 1 or Windows Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web-based or database-driven IT management portals that legitimately invoke PowerShell GPO cmdlets; Office-based automation used by admins to read GPO reports; custom print or ERP middleware calling gpupdate; authorised red team exercises."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts, approved management tooling to %global_allowed_admin_tools, and named administrator accounts to %global_allowed_admin_users. Scope the rule to domain controllers and admin workstations if noise persists on general endpoints."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|spoolsv|sqlservr|sqlagent)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(sysvol.{0,60}policies|\\policies\\\{[0-9a-f\-]{36}\}|new-gpo|set-gp[a-z]+|import-gpo|copy-gpo|restore-gpo|new-gplink|grouppolicy|gpupdate|gpttmpl\.inf|scheduledtasks\.xml|groups\.xml|registry\.pol|gpo)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1484.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
