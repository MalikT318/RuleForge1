/*
  MITRE Technique : T1491.002 - External Defacement
  Tactic(s)       : Impact
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:47:22.453116+00:00
  Reference       : https://attack.mitre.org/techniques/T1491/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_002_External_Web_Write_Method_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of successful HTTP content-write methods (PUT, MOVE, COPY, MKCOL, PROPPATCH, DELETE) from external sources against a single Windows-hosted web server within 10 minutes. Individual WebDAV-style writes are routine, but a high volume against one web server is consistent with web content replacement or defacement. Note: the Windows platform tag refers to the protected web server (for example IIS); the telemetry is firewall/proxy perimeter logs only."
    mitre_tactic = "Impact"
    mitre_technique = "T1491.002"
    mitre_technique_name = "Defacement: External Defacement"
    log_prerequisites = "Requires firewall, reverse proxy or WAF logs normalised to NETWORK_HTTP with network.http.method, target.hostname, principal.ip and network.http.response_code populated. TLS-inspected or terminated traffic is needed for method visibility."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate WebDAV or CMS publishing from external partners or remote developers, SharePoint/WebDAV file-sync clients, CI/CD deployment pipelines reaching the site from external addresses, API clients using PUT/DELETE for REST operations, and authorised penetration tests."
    tuning_guidance = "Add approved publishing, CI/CD and partner source addresses to %global_allowed_mgmt_sources, and authorised testing sources to %global_allowed_scanners. If REST APIs on the same host use PUT/DELETE heavily, raise the threshold per client or scope to web servers hosting static content. Review the target_urls outcome for default documents (index/default pages) to prioritise."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(PUT|MOVE|COPY|MKCOL|PROPPATCH|DELETE)$/ nocase
    $net.network.http.response_code >= 200
    $net.network.http.response_code < 300
    $net.target.hostname = $web_host
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  match:
    $web_host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1491.002")
    $primary_entity = array_distinct($web_host)
    $source_ips = array_distinct($net.principal.ip)
    $http_methods = array_distinct($net.network.http.method)
    $target_urls = array_distinct($net.target.url)

  condition:
    #net >= 10
}
