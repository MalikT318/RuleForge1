/*
  MITRE Technique : T1505.001 - SQL Stored Procedures
  Tactic(s)       : Persistence
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:27:14.607265+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_001_Linux_DB_Server_Bulk_Executable_Drops {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A database server process (MySQL/MariaDB, PostgreSQL, SQL Server on Linux) creates several shared libraries or script and binary files in its plugin directory or in world-writable staging directories within ten minutes on one host. One such file write is benign. A burst of them from the database engine itself matches UDF/stored-function abuse and SQL-driven file writes used to plant persistent code (e.g. SELECT ... INTO DUMPFILE, COPY ... TO PROGRAM staging, CREATE FUNCTION ... SONAME). Covers the file-creation side of the technique and does not rely on process command lines."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.001"
    mitre_technique_name = "Server Software Component: SQL Stored Procedures"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-write/watch rules (FILE_CREATION) that populate the writing process path (principal.process.file.full_path) and target.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "DBA-approved UDF or plugin deployments, database upgrades that unpack plugin libraries, logical backup/export jobs run by the database engine that write script or dump files to /tmp, extension installs (e.g. PostgreSQL extensions), data-load pipelines that stage files under /var/tmp."
    tuning_guidance = "Add approved backup and export tooling to %global_allowed_backup_processes and approved deployment or DBA tooling to %global_allowed_admin_tools. Add database hosts with sanctioned build or maintenance activity to %global_allowed_script_hosts. Raise the threshold on busy ETL hosts. Narrow the staging-directory or extension regex if the client stages data in /tmp by design."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(mysqld|mariadbd|postgres|sqlservr)$/ nocase
    $file.target.file.full_path = /(\/plugin\/[^\/]+\.so(\.[0-9]+)*$|^\/(tmp|var\/tmp|dev\/shm)\/[^\/]+\.(so|sh|py|pl|elf|bin)$)/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.hostname in %global_allowed_script_hosts

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1505.001")
    $primary_entity = array_distinct($host)
    $db_processes = array_distinct($file.principal.process.file.full_path)
    $dropped_files = array_distinct($file.target.file.full_path)
    $db_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
