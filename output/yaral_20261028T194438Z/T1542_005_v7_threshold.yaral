/*
  MITRE Technique : T1542.005 - TFTP Boot
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:51:25.645436+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_005_TFTP_External_Boot_Transfer_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated TFTP (port 69) connections from one network device or host to an external destination within ten minutes. TFTP to a non-internal server is rare and may indicate a device netbooting an unauthorized image or pulling a modified system image or config (T1542.005, often paired with T1601)."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.005"
    mitre_technique_name = "Pre-OS Boot: TFTP Boot"
    log_prerequisites = "Requires firewall or perimeter NETWORK_CONNECTION logs with principal.hostname, target.ip and target.port populated. The firewall must log permitted UDP/69 traffic, and the device's outbound traffic must traverse the firewall."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legacy device-provisioning workflows using a vendor or MSP-hosted TFTP server, remote-site config or image restores by network engineers, and PXE/zero-touch provisioning that uses an external TFTP service. Scanners probing UDP/69 can also trigger it."
    tuning_guidance = "Add approved management-source addresses to %global_allowed_mgmt_sources and approved scanners to %global_allowed_scanners. Raise the #net threshold if provisioning is noisy. If principal.hostname is not populated for a client's firewall, map the source host name in the parser."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    $net.principal.hostname = $host
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1542.005")
    $primary_entity = array_distinct($host)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    #net >= 3
}
