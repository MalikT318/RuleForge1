/*
  MITRE Technique : T1114.003 - Email Forwarding Rule
  Tactic(s)       : Collection
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:22:06.584635+00:00
  Reference       : https://attack.mitre.org/techniques/T1114/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_003_Exchange_Server_Side_Mail_Redirect_Cmdlet {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows process whose command line configures server-side mail redirection through Exchange management cmdlets: mailbox-level forwarding attributes, transport rules that redirect or BCC mail, or inbox rules with forward or redirect actions. This is the admin-plane variant for Windows hosts. It does not depend on a particular interpreter binary, so renamed or alternate hosts of the cmdlets are still covered."
    mitre_tactic = "Collection"
    mitre_technique = "T1114.003"
    mitre_technique_name = "Email Collection: Email Forwarding Rule"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command-line capture (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing). Most useful on admin workstations, jump hosts and Exchange servers."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Exchange administrators setting legitimate forwarding for departed staff, shared mailboxes or mail migrations; onboarding and offboarding automation; compliance teams creating journaling-style transport rules; helpdesk scripts."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users, and add approved provisioning or migration tooling to %global_allowed_admin_tools. Add known automation hosts to %global_allowed_script_hosts. Review the matched command line for external SMTP targets before suppressing."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $proc.target.process.command_line = /(set|new)-(mailbox|mailuser|remotemailbox)\b.*-(forwardingsmtpaddress|forwardingaddress)\b/ nocase or
      $proc.target.process.command_line = /(set|new)-transportrule\b.*-(redirectmessageto|blindcopyto|copyto)\b/ nocase or
      $proc.target.process.command_line = /(set|new)-inboxrule\b.*-(forwardto|forwardasattachmentto|redirectto)\b/ nocase
    )
    $proc.principal.hostname != ""
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1114.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
