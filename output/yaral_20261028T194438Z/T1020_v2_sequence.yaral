/*
  MITRE Technique : T1020 - Automated Exfiltration
  Tactic(s)       : Exfiltration
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:29:57.421777+00:00
  Reference       : https://attack.mitre.org/techniques/T1020
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1020_Linux_Repeated_Large_Outbound_Uploads_Same_Destination {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects automated exfiltration from a Linux server as seen at the network perimeter: one internal source sends two separate large outbound transfers to the same external destination within 10 minutes. A single bulk upload is common, but repeated bulk uploads to one external endpoint fit a scripted or scheduled staging-and-send loop (cron, systemd timer, or a looping shell or script). No endpoint process data is used, because perimeter logs do not carry it."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1020"
    mitre_technique_name = "Automated Exfiltration"
    log_prerequisites = "Firewall or proxy flow logs normalised to UDM NETWORK_FLOW with principal.ip, target.ip and network.sent_bytes populated. Egress from Linux server segments must pass through the logging perimeter."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Off-site backup and replication jobs, log shipping to external SaaS, software mirror syncs, CI/CD artifact publishing, cloud storage sync agents, and container image pushes to external registries."
    tuning_guidance = "Add known-good vendor and backup destinations to %global_allowed_domains. Scope the rule to Linux server subnets where the client's asset inventory allows. Raise or lower the sent_bytes threshold (50 MB per flow) to match client egress baselines. Widen the match window for slower exfiltration cadences."

  events:
    $upload1.metadata.event_type = "NETWORK_FLOW"
    $upload1.principal.ip = $src_ip
    $upload1.target.ip = $dst_ip
    $upload1.network.sent_bytes > 50000000
    not $upload1.target.ip in %rfc1918_internal
    not $upload1.target.hostname in %global_allowed_domains

    $upload2.metadata.event_type = "NETWORK_FLOW"
    $upload2.principal.ip = $src_ip
    $upload2.target.ip = $dst_ip
    $upload2.network.sent_bytes > 50000000
    not $upload2.target.ip in %rfc1918_internal
    not $upload2.target.hostname in %global_allowed_domains

    $upload1.metadata.event_timestamp.seconds < $upload2.metadata.event_timestamp.seconds

  match:
    $src_ip, $dst_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1020")
    $primary_entity = array_distinct($src_ip)
    $destination_ips = array_distinct($dst_ip)
    $destination_ports = array_distinct($upload2.target.port)
    $largest_upload_bytes = max($upload2.network.sent_bytes)
    $upload_count = count($upload1.metadata.id)

  condition:
    $upload1 and $upload2
}
