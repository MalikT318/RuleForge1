/*
  MITRE Technique : T1686.002 - Network Device Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:29:40.743245+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_002_External_Source_To_Network_Device_Mgmt_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a connection from a non-internal source address to a common network-device management-plane port (SSH, Telnet, NETCONF over SSH, or alternate HTTPS admin ports) as seen in firewall or perimeter logs. Exposed management interfaces are the usual entry point for adversaries who then disable the firewall or change ACLs, security zones or policy rules to permit blocked traffic. This is a network-side precursor signal that complements endpoint and command-line detections."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.002"
    mitre_technique_name = "Network Device Firewall"
    log_prerequisites = "Requires firewall, proxy, or perimeter connection logs normalised to UDM NETWORK_CONNECTION with populated principal.ip, target.ip and target.port. Logs must cover traffic destined to device management addresses, for example interface-local or management-zone traffic."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Remote administrators or the MSSP connecting from a non-allowlisted address (home, VPN egress, cloud jump host), authorised external vulnerability scans or pen tests, third-party network support vendors, and internet-wide scanners that probe exposed SSH or Telnet. Scanner hits on an exposed port are still worth review because the management plane should not be internet-reachable."
    tuning_guidance = "Add approved administrator, jump host and VPN egress addresses to %global_allowed_mgmt_sources. Add authorised scanner sources to %global_allowed_scanners. If a client uses a non-standard admin port, extend the port list for that tenant's rule copy. To reduce noise from internet scanners, pair the rule with a threshold or correlation variant, or restrict to destinations in the management zone."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 830 or
      $net.target.port = 4443 or
      $net.target.port = 8443 or
      $net.target.port = 10443
    )
    $net.principal.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1686.002")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
