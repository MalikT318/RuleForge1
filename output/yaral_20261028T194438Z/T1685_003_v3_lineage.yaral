/*
  MITRE Technique : T1685.003 - Modify or Spoof Tool UI
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:20:12.270443+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_003_Linux_Service_Parent_Spawns_Shell_Spoofing_Security_Status {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing or service daemon (web server, database, print, or cache service) spawning a shell or script interpreter that writes, copies, links, or edits a security-agent status, health, heartbeat, or definition-state artifact to a healthy value. This lineage is highly unusual and indicates web-shell or service-exploit-driven spoofing of security tool status after the tool has been tampered with."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.003"
    mitre_technique_name = "Modify or Spoof Tool UI"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry that populates parent process path, child process path, and command line on process launch events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web or database administration panels that run health-check scripts, application deployment hooks launched by a web server user, monitoring plugins spawned from database services, and CMS plugins that write their own application status files."
    tuning_guidance = "Add approved parent processes or hosts to %global_allowed_script_hosts and approved tooling to %global_allowed_admin_tools. Extend the parent regex with additional exposed daemons for a given client, and extend the child interpreter list if needed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|smbd)$/ nocase
    $proc.target.process.file.full_path = /\/(bash|dash|sh|zsh|ksh|ash|python[0-9.]*|perl|ruby|php[0-9.]*)$/ nocase
    $proc.target.process.command_line = /\b(echo|printf|tee|touch|ln|cp|mv|sed|truncate)\b/ nocase
    $proc.target.process.command_line = /(status|health|heartbeat|last_?(check|update|seen)|signature|definitions?)/ nocase
    $proc.target.process.command_line = /\b(running|active|healthy|protected|enabled|up.to.date|ok|connected|online)\b/ nocase
    $proc.target.process.command_line = /(\/var\/(run|lib|log)\/|\/run\/|\/opt\/|\/usr\/(local\/)?s?bin\/|\/etc\/|\/tmp\/|\/dev\/shm\/)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
