/*
  MITRE Technique : T1005 - Data from Local System
  Tactic(s)       : Collection
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:12:18.074601+00:00
  Reference       : https://attack.mitre.org/techniques/T1005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1005_Large_Outbound_Transfer_Staged_Local_Data {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side view of T1005 follow-on activity: a single connection from an internal host to an external destination sends a very large volume of data, which is consistent with bulk local data (files, databases, archives) being moved off the host after collection. This detects the result of collection rather than the collection commands, so it complements endpoint command-line detections. The signal is volumetric and is not specific to T1005 on its own."
    mitre_tactic = "Collection"
    mitre_technique = "T1005"
    mitre_technique_name = "Data from Local System"
    log_prerequisites = "Firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with network.sent_bytes, principal.ip and target.ip populated. Connection-close or session-summary logging must be enabled so byte counters are present."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Cloud backup and file sync uploads, software or video publishing, large legitimate SaaS uploads, offsite replication, VM or image uploads, and authorised penetration tests."
    tuning_guidance = "Add known-good destination domains to %global_allowed_domains. Raise or lower the sent_bytes threshold (default about 100 MB) to match the client baseline. Where the firewall logs resolved destination hostnames, populate %global_allowed_domains with backup and sync vendors. Consider restricting the rule to client workstation and server segments."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    $net.network.sent_bytes > 104857600
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1005")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
