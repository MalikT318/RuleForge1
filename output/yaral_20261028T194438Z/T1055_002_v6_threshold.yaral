/*
  MITRE Technique : T1055.002 - Portable Executable Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:48:35.263813+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_002_Burst_Cross_Process_Injection_Events {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of cross-process injection events on a single host within ten minutes. A single injection event can be benign (EDR, accessibility, overlay or anti-cheat software). Repeated injection by non-allowlisted processes into other processes is consistent with PE injection (VirtualAllocEx / WriteProcessMemory / CreateRemoteThread) used to hide execution inside legitimate processes or escalate privileges. This rule uses injection telemetry rather than process-creation or command-line matching."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.002"
    mitre_technique_name = "Process Injection: Portable Executable Injection"
    log_prerequisites = "Requires Windows endpoint telemetry that reports remote-thread creation or cross-process injection and normalises it to PROCESS_INJECTION (for example Sysmon Event ID 8 or EDR injection telemetry)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Endpoint security agents and DLP or monitoring agents hooking processes, application virtualization and compatibility shims, accessibility and input-method software, game overlays and anti-cheat, debuggers and developer tooling, and software deployment or RMM agents."
    tuning_guidance = "Add security agents to %global_allowed_security_tools, backup and imaging software to %global_allowed_backup_processes, and approved IT tooling to %global_allowed_admin_tools. Raise the #inj threshold on hosts running developer or debugging tools. Review the injector_processes and target_processes outcome values to identify noisy benign injectors."

  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.hostname = $host
    $inj.principal.process.file.full_path != ""
    $inj.target.process.file.full_path != ""
    $inj.principal.process.file.full_path != $inj.target.process.file.full_path
    not $inj.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|csrss)\.exe$/ nocase
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1055.002")
    $primary_entity = array_distinct($host)
    $injection_count = count($inj.metadata.id)
    $injector_processes = array_distinct($inj.principal.process.file.full_path)
    $target_processes = array_distinct($inj.target.process.file.full_path)
    $affected_users = array_distinct($inj.principal.user.userid)

  condition:
    #inj >= 5
}
