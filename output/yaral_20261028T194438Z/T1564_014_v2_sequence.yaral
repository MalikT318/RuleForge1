/*
  MITRE Technique : T1564.014 - Extended Attributes
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:35:07.569869+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_014_Linux_Xattr_Payload_Write_Then_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Linux host where a value is written into a user. extended attribute with setfattr and the user. attribute value is then read back raw with getfattr within 10 minutes. This write-then-retrieve pattern matches staging a payload in file metadata and loading it later. A single setfattr or getfattr run is common and low-risk; the sequence is the signal."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.014"
    mitre_technique_name = "Hide Artifacts: Extended Attributes"
    log_prerequisites = "Requires Linux EDR or auditd-derived process launch telemetry with full command line and parent process path populated in UDM."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup and restore tooling that saves and restores xattrs, SELinux or file-integrity tooling, configuration management and deployment agents, and admins testing or auditing xattr support on filesystems."
    tuning_guidance = "Add approved parent tooling to %global_allowed_admin_tools and backup agents to %global_allowed_backup_processes. Add automation accounts to %global_allowed_service_accounts. Raise severity or shorten the window on servers where xattr use is not expected."

  events:
    $set.metadata.event_type = "PROCESS_LAUNCH"
    $set.target.process.file.full_path = /\/setfattr$/ nocase
    $set.target.process.command_line = /(\s-n\s*|--name[=\s]+)['"]?user\./ nocase
    $set.target.process.command_line = /(\s-v\s*|--value[=\s]+)/ nocase
    not $set.principal.process.file.full_path in %global_allowed_admin_tools
    not $set.principal.process.file.full_path in %global_allowed_backup_processes
    not $set.principal.user.userid in %global_allowed_service_accounts
    $set.principal.hostname = $hostname

    $get.metadata.event_type = "PROCESS_LAUNCH"
    $get.target.process.file.full_path = /\/getfattr$/ nocase
    $get.target.process.command_line = /(--only-values|\s-n\s*['"]?user\.|--name[=\s]+['"]?user\.)/ nocase
    not $get.principal.process.file.full_path in %global_allowed_admin_tools
    not $get.principal.process.file.full_path in %global_allowed_backup_processes
    not $get.principal.user.userid in %global_allowed_service_accounts
    $get.principal.hostname = $hostname

    $set.metadata.event_timestamp.seconds <= $get.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1564.014")
    $primary_entity = array_distinct($hostname)
    $write_count = count($set.metadata.id)
    $read_count = count($get.metadata.id)
    $write_commands = array_distinct($set.target.process.command_line)
    $read_commands = array_distinct($get.target.process.command_line)
    $users = array_distinct($set.principal.user.userid)

  condition:
    $set and $get
}
