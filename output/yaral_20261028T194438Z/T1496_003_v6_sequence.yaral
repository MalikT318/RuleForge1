/*
  MITRE Technique : T1496.003 - SMS Pumping
  Tactic(s)       : Impact
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:56:43.035084+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_003_SMS_Settings_Change_Then_Message_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an identity that changes SMS or messaging spend, quota or origination settings and then, within 10 minutes, issues a burst of SMS send/publish API calls. This sequence is typical of SMS pumping (toll fraud) through abused or compromised messaging infrastructure."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.003"
    mitre_technique_name = "Resource Hijacking: SMS Pumping"
    log_prerequisites = "Requires cloud control plane audit logs that record messaging configuration changes (SETTING_MODIFICATION) and SMS send or publish API calls (USER_RESOURCE_ACCESS), with metadata.product_event_type and principal.user.userid populated."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate marketing or notification campaigns launched right after a quota increase; planned OTP or MFA rollouts; load or penetration tests of verification flows; onboarding of a new messaging service."
    tuning_guidance = "Add approved campaign and notification identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Add change-management administrators to %global_allowed_admin_users. Add authorised test sources to %global_allowed_scanners. Raise or lower the #send threshold in the condition to match the tenant's normal SMS volume."

  events:
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.metadata.product_event_type = /sms.*(spend|limit|quota|attribute|sandbox|origination|throttl|budget)|(spend|limit|quota|sandbox|origination|budget).*sms/ nocase
    $cfg.principal.user.userid = $user
    not $cfg.principal.user.userid in %global_allowed_admin_users
    not $cfg.principal.user.userid in %global_allowed_service_accounts

    $send.metadata.event_type = "USER_RESOURCE_ACCESS"
    $send.metadata.product_event_type = /(publish|send|dispatch).*(sms|text.?message|otp|verification)|(sms|otp).*(publish|send|dispatch)/ nocase
    $send.principal.user.userid = $user
    not $send.principal.user.userid in %global_allowed_cloud_principals
    not $send.principal.user.userid in %global_allowed_service_accounts

    $cfg.metadata.event_timestamp.seconds <= $send.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1496.003")
    $primary_entity = array_distinct($user)
    $send_count = count($send.metadata.id)
    $config_actions = array_distinct($cfg.metadata.product_event_type)
    $send_actions = array_distinct($send.metadata.product_event_type)
    $source_ips = array_distinct($send.principal.ip)
    $target_resources = array_distinct($send.target.resource.name)

  condition:
    $cfg and #send >= 10
}
