/*
  MITRE Technique : T1485 - Data Destruction
  Tactic(s)       : Impact
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:35:28.312386+00:00
  Reference       : https://attack.mitre.org/techniques/T1485
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1485_ESXi_Datastore_VM_Artifact_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects deletion of virtual machine disk or configuration artifacts (.vmdk, -flat.vmdk, .vmx) under /vmfs/volumes on an ESXi host by an account or process that is not an approved administrator, service account or backup tool. This catches destructive impact at the file-artifact layer, regardless of whether the shell command line was logged or obfuscated."
    mitre_tactic = "Impact"
    mitre_technique = "T1485"
    mitre_technique_name = "Data Destruction"
    log_prerequisites = "ESXi hostd/shell logs parsed into UDM FILE_DELETION events with target.file.full_path populated for datastore paths."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Planned VM decommissioning or deletion through the management plane, storage vMotion cleanup of source disks, template and clone lifecycle automation, backup or replication tools removing temporary disks."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users, automation and management service accounts to %global_allowed_service_accounts, and backup or replication processes to %global_allowed_backup_processes. Suppress during approved decommissioning windows."

  events:
    $file.metadata.event_type = "FILE_DELETION"
    $file.target.file.full_path = /^\/vmfs\/volumes\/.+\/[^\/]+\.(vmdk|vmx)$/ nocase
    not $file.target.file.full_path = /-(delta|sesparse|ctk)\.vmdk$/ nocase
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1485")
    $primary_entity = array_distinct(strings.coalesce($file.principal.hostname, $file.target.hostname))
    $deleted_paths = array_distinct($file.target.file.full_path)
    $acting_users = array_distinct($file.principal.user.userid)

  condition:
    $file
}
