/*
  MITRE Technique : T1557.004 - Evil Twin
  Tactic(s)       : Credential Access, Collection
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:36:15.397671+00:00
  Reference       : https://attack.mitre.org/techniques/T1557/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1557_004_EvilTwin_Cleartext_Portal_Credential_Post {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client sending an unencrypted HTTP POST to an external destination on a login, captive-portal or credential-style URL path. Clients tricked onto a rogue (evil twin) Wi-Fi access point are typically funnelled to a spoofed captive portal that harvests credentials over cleartext HTTP. The firewall or proxy sees this as a credential-style POST to an external host that is not a known-good domain."
    mitre_tactic = "Credential Access, Collection"
    mitre_technique = "T1557.004"
    mitre_technique_name = "Adversary-in-the-Middle: Evil Twin"
    log_prerequisites = "Firewall or web proxy logs normalised to NETWORK_HTTP with network.http.method, target.url, target.port, target.ip and target.hostname populated. Cleartext HTTP must be visible, so the proxy or firewall needs HTTP inspection on port 80."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate guest or hotel captive portals used by travelling staff, legacy internal or partner applications that post logins over HTTP to external hosts, IoT or appliance check-in services, and unmanaged BYOD devices on guest VLANs."
    tuning_guidance = "Add known-good vendor and partner domains to %global_allowed_domains. Keep %rfc1918_internal current so internal traffic is excluded. Raise severity for user VLANs that should never use cleartext HTTP. Narrow the URL keyword regex if a client's legacy applications generate noise."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.port = 80
    $net.target.url = /(login|logon|signin|sign-in|captive|portal|hotspot|wifi|splash|authenticate|password|credential)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1557.004")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $request_urls = array_distinct($net.target.url)

  condition:
    $net
}
