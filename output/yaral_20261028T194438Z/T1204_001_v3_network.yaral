/*
  MITRE Technique : T1204.001 - Malicious Link
  Tactic(s)       : Execution
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:59:12.123089+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_001_Network_Payload_Download_Via_Link {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client issuing an HTTP GET to an external destination for a URL whose path ends in a file type commonly delivered by phishing links (executables, installers, disk images, shortcuts, script and package files). This is the network-side footprint of a user clicking a malicious link that leads to code execution. It complements endpoint command-line rules by relying only on perimeter HTTP telemetry."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.001"
    mitre_technique_name = "User Execution: Malicious Link"
    log_prerequisites = "Requires proxy or firewall logs with URL inspection (TLS inspection for HTTPS) that populate network.http.method and target.url."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate software or driver downloads from vendor sites not yet in the allowlist, IT staff downloading installers or ISO images, update mechanisms using plain URLs, developers fetching packages or scripts."
    tuning_guidance = "Add known-good vendor, CDN and update domains to %global_allowed_domains. Add named administrators to %global_allowed_admin_users. Keep %rfc1918_internal populated with the client's internal address space. Narrow or widen the extension list per client; for noisy estates remove exe and msi."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.target.url = /^https?:\/\/[^\/]+\/[^?#]*\.(exe|msi|msix|appx|scr|hta|vbs|vbe|jse|wsf|iso|img|lnk|jar|ps1|bat|cmd)([?#].*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1204.001")
    $primary_entity = array_distinct($net.principal.ip)
    $source_hostnames = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $downloaded_urls = array_distinct($net.target.url)

  condition:
    $net
}
