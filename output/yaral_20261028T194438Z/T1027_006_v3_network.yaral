/*
  MITRE Technique : T1027.006 - HTML Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:47:12.883340+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_006_HTML_Smuggling_Large_HTML_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an unusually large HTML document (an .htm/.html-style URL served as text/html) downloaded over HTTP from an external site by a Windows browser. HTML smuggling embeds the payload inside the page as a JavaScript Blob or Data URL, so the HTML body is much larger than a normal landing page. The payload is assembled on the endpoint and never crosses the proxy as a file, so this rule uses the size and type of the HTML response as a proxy-side indicator."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.006"
    mitre_technique_name = "Obfuscated Files or Information: HTML Smuggling"
    log_prerequisites = "Requires proxy or firewall HTTP logs normalised to NETWORK_HTTP with target.url, target.file.mime_type, network.http.user_agent, network.http.response_code and network.received_bytes populated. TLS inspection is needed for HTTPS traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Large single-page web applications, saved or exported HTML reports, HTML email archives, online documentation bundles with inlined assets, and webmail or SaaS portals serving large static HTML pages."
    tuning_guidance = "Add known-good vendor and CDN domains to %global_allowed_domains. Raise or lower the network.received_bytes threshold (currently 1500000) to fit the client's normal web traffic. Pair with the endpoint detection for browser-spawned file drops to raise confidence."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.network.http.response_code = 200
    $net.target.url = /\.(html?|xhtml|shtml|mhtml?)(\?.*)?$/ nocase
    $net.target.file.mime_type = /text\/html/ nocase
    $net.network.http.user_agent = /Windows NT/ nocase
    $net.network.received_bytes > 1500000
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1027.006")
    $primary_entity = array_distinct($net.principal.hostname)
    $requested_urls = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)
    $max_response_bytes = max($net.network.received_bytes)

  condition:
    $net
}
