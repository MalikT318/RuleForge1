/*
  MITRE Technique : T1129 - Shared Modules
  Tactic(s)       : Execution
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:42:58.109200+00:00
  Reference       : https://attack.mitre.org/techniques/T1129
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1129_Outbound_SMB_Then_WebDAV_Fallback_UNC_Module_Load {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the network footprint of a Windows host trying to load a shared module (DLL) from a remote UNC path on an external server. The host first attempts outbound SMB (TCP/445) to an external address, then falls back to WebDAV over HTTP to the same external address within 10 minutes. The WebDAV request comes from the Windows WebDAV mini-redirector, which is what the Windows module loader and file APIs use for UNC-over-HTTP paths. Legitimate use of this pattern towards the internet is rare."
    mitre_tactic = "Execution"
    mitre_technique = "T1129"
    mitre_technique_name = "Shared Modules"
    log_prerequisites = "Requires perimeter firewall logs with NETWORK_CONNECTION events carrying source IP, destination IP and destination port, plus web proxy or firewall-inspected NETWORK_HTTP events with the HTTP user agent populated. HTTPS inspection or an explicit WebDAV-over-HTTP path is needed to see the user agent."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Users with a legitimately mapped cloud WebDAV or SMB-over-internet share, sanctioned vendor file exchange via WebDAV, SharePoint or OneDrive WebDAV mapped drives, and software deployment tools that pull content from external WebDAV repositories."
    tuning_guidance = "Add approved WebDAV and file-share destinations to %global_allowed_domains. Add authorised testing sources to %global_allowed_scanners. If the WebDAV event does not populate target.hostname, tune by source address using %global_allowed_mgmt_sources or by network segment at the firewall."

  events:
    $smb.metadata.event_type = "NETWORK_CONNECTION"
    $smb.target.port = 445
    not $smb.target.ip in %rfc1918_internal
    not $smb.principal.ip in %global_allowed_scanners
    $smb.principal.ip = $src_ip
    $smb.target.ip = $dest_ip

    $dav.metadata.event_type = "NETWORK_HTTP"
    $dav.network.http.user_agent = /^Microsoft-WebDAV-MiniRedir/ nocase
    not $dav.target.ip in %rfc1918_internal
    not $dav.target.hostname in %global_allowed_domains
    $dav.principal.ip = $src_ip
    $dav.target.ip = $dest_ip

    $smb.metadata.event_timestamp.seconds <= $dav.metadata.event_timestamp.seconds

  match:
    $src_ip, $dest_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1129")
    $primary_entity = array_distinct($src_ip)
    $destination_ips = array_distinct($dest_ip)
    $webdav_hosts = array_distinct($dav.target.hostname)
    $webdav_urls = array_distinct($dav.target.url)
    $smb_event_count = count($smb.metadata.id)

  condition:
    $smb and $dav
}
