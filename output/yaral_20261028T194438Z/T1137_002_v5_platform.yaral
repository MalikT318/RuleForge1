/*
  MITRE Technique : T1137.002 - Office Test
  Tactic(s)       : Persistence
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:16:22.789140+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_002_Office_Test_Perf_Registry_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a write to the Office Test 'Special\\Perf' registry key (HKCU or HKLM). This key is not created by default and lets a user-specified DLL load every time an Office application starts, so it is a known persistence mechanism. The rule matches the registry mechanism itself, not a particular DLL or tool."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.002"
    mitre_technique_name = "Office Application Startup: Office Test"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events) normalised to REGISTRY_MODIFICATION with target.registry.registry_key populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office add-in developers and QA teams using the Office test feature for debugging or performance testing; software packaging or deployment tools that touch Office keys; rare legacy Office customisation scripts run by administrators."
    tuning_guidance = "Add approved deployment or packaging binaries to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, and named developer or admin accounts to %global_allowed_admin_users. Because the key is absent by default, any hit outside a developer workstation group should be treated as suspicious. Consider scoping exclusions to developer hosts via reference lists rather than disabling the rule."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\software\\microsoft\\office test\\special\\perf/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1137.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_name)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $acting_users = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
