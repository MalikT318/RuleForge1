/*
  MITRE Technique : T1687 - Exploitation for Defense Impairment
  Tactic(s)       : Defense Impairment
  Rule variant    : 7 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:35:32.903074+00:00
  Reference       : https://attack.mitre.org/techniques/T1687
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1687_Security_Control_Group_Membership_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a directory group modification that touches a group governing security-control administration or protection (Protected Users, Group Policy Creator Owners, Event Log Readers, security operator/admin groups) when the acting account is not an approved administrator or service account. This is a result-based proxy for T1687: after exploiting a vulnerability to gain privilege, adversaries commonly alter these groups to weaken or gain control of defensive mechanisms. Identity telemetry cannot see the exploit itself."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1687"
    mitre_technique_name = "Exploitation for Defense Impairment"
    log_prerequisites = "Requires identity provider or directory audit logs normalised to GROUP_MODIFICATION, with target.group.group_display_name and principal.user.userid populated."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Legitimate identity governance workflows, helpdesk or onboarding automation, SOC and IT staff granting log-reader or policy rights, and scheduled access reviews performed by accounts not yet on the admin allowlists."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and automation or provisioning accounts to %global_allowed_service_accounts. Adjust the group-name regex to match each client's security tooling group naming. The Windows platform and identity log source were prioritised over the alternate-platform angle."

  events:
    $grp.metadata.event_type = "GROUP_MODIFICATION"
    $grp.target.group.group_display_name = /(protected users|group policy creator owners|event log readers|security (operators|admins|administrators)|(edr|defender|antivirus|endpoint security|siem).*(admin|operator|manager))/ nocase
    $grp.principal.user.userid != ""
    not $grp.principal.user.userid in %global_allowed_admin_users
    not $grp.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1687")
    $primary_entity = array_distinct($grp.principal.user.userid)
    $modified_groups = array_distinct($grp.target.group.group_display_name)
    $affected_users = array_distinct($grp.target.user.userid)

  condition:
    $grp
}
