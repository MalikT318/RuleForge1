/*
  MITRE Technique : T1071.004 - DNS
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:09:24.850805+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_004_DNS_Tunnel_Query_Then_Direct_External_DNS_Channel {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Windows client behind the network perimeter sending DNS TXT queries with unusually long, encoded-looking labels to an external resolver, then opening a direct TCP/53 session to the same external server within 5 minutes. This pattern is typical of DNS tunneling or DNS beaconing, where commands and data are carried in DNS records and the client bypasses the internal resolver. Detection is based on perimeter DNS and connection telemetry only, with no endpoint process fields."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.004"
    mitre_technique_name = "Application Layer Protocol: DNS"
    log_prerequisites = "Requires firewall, proxy or DNS-inspection logs that normalise to NETWORK_DNS (with question name and type, and source and destination IP) and NETWORK_CONNECTION (with TCP protocol and destination port). The perimeter must see client-to-external DNS traffic, so internal-resolver-only logging will not populate the events."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Security products and email gateways that use long encoded DNS labels for reputation or DNSBL lookups, CDN and cloud services with long hashed hostnames, DKIM/SPF TXT lookups, and legitimate DNS-over-TCP fallback for large responses. Misconfigured clients pointed at a public resolver may also trigger it."
    tuning_guidance = "Add known-good domains (vendors, reputation services, CDNs) to %global_allowed_domains. Add authorised DNS testing or scanning sources to %global_allowed_scanners. Tighten or loosen the label length quantifier ({40,}) per client baseline. Where public resolvers are sanctioned, consider alerting only on the TXT-query leg."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.type = 16
    $dns.network.dns.questions.name = /^[a-z0-9_+=\-]{40,}\./ nocase
    not $dns.target.ip in %rfc1918_internal
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.ip in %global_allowed_scanners
    $dns.principal.ip = $src_ip
    $dns.target.ip = $dns_server

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "TCP"
    $net.target.port = 53
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    $net.principal.ip = $src_ip
    $net.target.ip = $dns_server

    $dns.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $src_ip, $dns_server over 5m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1071.004")
    $primary_entity = array_distinct($dns.principal.ip)
    $external_dns_server = array_distinct($dns.target.ip)
    $suspicious_query_names = array_distinct($dns.network.dns.questions.name)
    $txt_query_count = count($dns.metadata.id)
    $tcp53_session_count = count($net.metadata.id)

  condition:
    $dns and $net
}
