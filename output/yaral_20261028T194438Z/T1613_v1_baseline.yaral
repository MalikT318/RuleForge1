/*
  MITRE Technique : T1613 - Container and Resource Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:34:47.211121+00:00
  Reference       : https://attack.mitre.org/techniques/T1613
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1613_Container_Resource_Discovery_Commands {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects container and Kubernetes resource discovery from inside a running container. Matches either a container or orchestrator CLI run with a listing, inspection or cluster-status verb (for example 'get', 'describe', 'ps', 'images', 'inspect', 'cluster-info'), or a curl/wget request to the orchestrator API for pods, nodes, namespaces, deployments or services. Application containers rarely enumerate the cluster, so this is a strong indicator of post-compromise reconnaissance."
    mitre_tactic = "Discovery"
    mitre_technique = "T1613"
    mitre_technique_name = "Container and Resource Discovery"
    log_prerequisites = "Requires container runtime or node-level process telemetry that records in-container process launches with full command lines (for example a runtime security sensor or auditd from the container host), mapped to UDM PROCESS_LAUNCH."
    platform = "Containers"
    log_source = "container"
    false_positives = "Debugging by SREs and developers using kubectl exec or docker exec sessions, CI/CD runner pods, GitOps and operator or controller pods that legitimately query the API, init containers and health-check scripts that call the API server, and cluster-management tooling."
    tuning_guidance = "Add approved admin and CI tooling binaries to %global_allowed_admin_tools and automation or controller identities to %global_allowed_service_accounts. If a workload class legitimately queries the API, scope exclusions by parent process path rather than disabling the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /\b(kubectl|crictl|nerdctl|podman|docker)\s+(\S+\s+){0,4}?(get|describe|ps|images|inspect|api-resources|cluster-info|top)\b|\b(curl|wget)\b.*\/apis?\/(v1\/)?(namespaces|pods|nodes|deployments|services)\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1613")
    $primary_entity = array_distinct($proc.principal.hostname)
    $discovery_commands = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
