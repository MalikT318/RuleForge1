/*
  MITRE Technique : T1653 - Power Settings
  Tactic(s)       : Persistence
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:57:31.788389+00:00
  Reference       : https://attack.mitre.org/techniques/T1653
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1653_Linux_Sleep_Target_Masked_Or_Shutdown_Binary_Tampered {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects Linux commands that stop a host from sleeping, suspending, hibernating or shutting down. This covers systemctl masking or disabling of the sleep, suspend, hibernate and hybrid-sleep targets, and deleting, moving or permission-stripping of the shutdown, reboot, halt and poweroff binaries. Both are used to keep an implant running on an otherwise dormant host."
    mitre_tactic = "Persistence"
    mitre_technique = "T1653"
    mitre_technique_name = "Power Settings"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to PROCESS_LAUNCH with populated command_line, target process path and parent process path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Server and kiosk hardening scripts that mask sleep targets (CIS or golden-image builds), configuration-management runs (Ansible, Puppet, Chef, Salt), cloud-init or image-build pipelines, administrators keeping a workstation awake during long jobs, and container or appliance image builders removing shutdown binaries."
    tuning_guidance = "Add approved config-management and image-build parent binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Suppress hardening-baseline hosts at the SOAR layer by asset group, not by hardcoding hostnames. If the shutdown-binary branch is noisy in container-build environments, require interactive or non-root-parent context in the response playbook."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $proc.target.process.file.full_path = /\/systemctl$/ nocase
        $proc.target.process.command_line = /\b(mask|disable)\b/ nocase
        $proc.target.process.command_line = /\b(sleep|suspend|hibernate|hybrid-sleep|suspend-then-hibernate)\.target\b/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\/(rm|mv|chmod|chattr|truncate|shred|unlink)$/ nocase
        $proc.target.process.command_line = /\/(usr\/)?s?bin\/(shutdown|reboot|halt|poweroff)(\s|$)/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1653")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
