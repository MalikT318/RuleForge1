/*
  MITRE Technique : T1218.009 - Regsvcs/Regasm
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:53:21.797921+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_009_Regsvcs_Regasm_Anomalous_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects Regsvcs.exe or Regasm.exe launched by a parent process that should never start .NET COM registration utilities: Office applications, web server processes, database services, the print spooler, WMI provider host, browsers, or script and proxy-execution hosts. The rule keys on process lineage rather than command-line content, so it complements command-line detections and still fires when arguments are obfuscated or the assembly path changes."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.009"
    mitre_technique_name = "System Binary Proxy Execution: Regsvcs/Regasm"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry (EDR, Sysmon Event ID 1, or Security Event 4688 with parent process populated) normalised to UDM PROCESS_LAUNCH with principal.process.file.full_path (parent) and target.process.file.full_path (child)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developer workstations where an IDE or build host launches regasm during COM interop registration; software installers or deployment agents launched via script hosts that register .NET assemblies; web or application servers hosting legitimate deployment tasks that call regasm; IIS or SQL Server administrative maintenance scripts."
    tuning_guidance = "Add approved deployment or packaging parent binaries to %global_allowed_admin_tools, and approved script-hosting parents to %global_allowed_script_hosts. Adjust the parent regex to add or remove parent families based on client software. Review hostnames with recurring hits (build servers) and consider suppressing them via the allow lists."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(regsvcs|regasm)\.exe$/ nocase
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|onenote|visio|w3wp|httpd|nginx|tomcat\d*|php-cgi|sqlservr|spoolsv|wmiprvse|mshta|wscript|cscript|rundll32|regsvr32|msedge|chrome|firefox|iexplore)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.009")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
