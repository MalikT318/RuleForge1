/*
  MITRE Technique : T1497 - Virtualization/Sandbox Evasion
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:00:11.722979+00:00
  Reference       : https://attack.mitre.org/techniques/T1497
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_Linux_VM_Artifact_Check_Via_Command_Line {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux process whose command line pairs a hardware or virtualization query (DMI/SMBIOS data in /sys/class/dmi/id, /proc/cpuinfo, dmidecode, lscpu, lspci, systemd-detect-virt) with a hypervisor or VM vendor string. This is the classic sandbox and VM awareness check used by malware and implants to decide whether to detonate or stay dormant. It matches the combination of query and artifact keyword, not a specific tool or payload, so renaming a binary does not evade it."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1497"
    mitre_technique_name = "Virtualization/Sandbox Evasion"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records with full command-line arguments (including shell -c strings) normalised to UDM PROCESS_LAUNCH."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management and inventory agents (asset discovery, CMDB collectors), cloud-init and provisioning scripts, hardware and compliance scanners, hypervisor guest-tool installers, administrators and engineers troubleshooting or confirming VM type, and virtualization-aware installers or licensing checks."
    tuning_guidance = "Add inventory, configuration-management and deployment binaries to %global_allowed_admin_tools. Add EDR and compliance agents to %global_allowed_security_tools. Add approved provisioning or orchestration parents to %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts. In environments that are fully virtualized, consider raising severity only when the process runs from /tmp, /dev/shm or /var/tmp, or is spawned by a web server or interactive-less parent."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|grep|egrep|fgrep|cat|awk|sed|head|dmidecode|lscpu|lspci|systemd-detect-virt|python[0-9.]*|perl|ruby)$/ nocase
    $proc.target.process.command_line = /(dmidecode|\/sys\/class\/dmi\/id\/|\/sys\/devices\/virtual\/dmi|\/proc\/cpuinfo|\/proc\/scsi\/scsi|\/proc\/modules|lscpu|lspci|lsmod|systemd-detect-virt|virt-what)/ nocase
    $proc.target.process.command_line = /(vmware|virtualbox|vbox|qemu|kvm|xen|hyper-v|parallels|bochs|innotek|hypervisor|bhyve|sandbox)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1497")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
