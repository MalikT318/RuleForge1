/*
  MITRE Technique : T1564.008 - Email Hiding Rules
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:26:05.736288+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_008_External_Login_Then_Inbox_Rule_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A successful sign-in from a non-internal source address is followed within 10 minutes by creation or modification of a mailbox inbox rule by the same user. This is a common account-takeover pattern in which the adversary hides security alerts and replies by moving, deleting or marking messages as read."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.008"
    mitre_technique_name = "Hide Artifacts: Email Hiding Rules"
    log_prerequisites = "Requires Microsoft 365 or Google Workspace unified audit logs ingested with sign-in events (USER_LOGIN) and mailbox rule audit events (SETTING_MODIFICATION with metadata.product_event_type populated, e.g. New-InboxRule, Set-InboxRule, UpdateInboxRules)."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Users who legitimately create inbox rules (e.g. newsletter or folder filing) right after signing in from home, mobile or VPN networks; helpdesk or admin staff configuring mailbox rules on behalf of users; migration and mailbox-provisioning automation; shared mailbox delegates."
    tuning_guidance = "Add automation and migration accounts to %global_allowed_service_accounts and administrators to %global_allowed_admin_users. If rule parameters are normalised in your tenant, add a regex on the rule-parameter field (delete, move-to-folder, mark-as-read) to the rule event to narrow further. Consider extending %rfc1918_internal handling or egress-IP exclusions through client-specific allow lists if corporate VPN egress addresses cause noise."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.principal.user.userid = $user
    not $login.principal.ip in %rfc1918_internal
    not $login.principal.user.userid in %global_allowed_service_accounts

    $rule.metadata.event_type = "SETTING_MODIFICATION"
    $rule.metadata.product_event_type = /^(New-InboxRule|Set-InboxRule|UpdateInboxRules)$/ nocase
    $rule.principal.user.userid = $user
    not $rule.principal.user.userid in %global_allowed_service_accounts
    not $rule.principal.user.userid in %global_allowed_admin_users

    $login.metadata.event_timestamp.seconds <= $rule.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1564.008")
    $primary_entity = array_distinct($rule.principal.user.userid)
    $login_source_ips = array_distinct($login.principal.ip)
    $rule_operations = array_distinct($rule.metadata.product_event_type)
    $rule_event_count = count($rule.metadata.id)

  condition:
    $login and $rule
}
