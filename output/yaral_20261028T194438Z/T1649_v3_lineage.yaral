/*
  MITRE Technique : T1649 - Steal or Forge Authentication Certificates
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:51:26.329086+00:00
  Reference       : https://attack.mitre.org/techniques/T1649
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1649_Linux_Service_Parent_Shell_Cert_Key_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server or database service process spawning a shell or script interpreter whose command line touches certificate or private key stores (TLS key directories, PKI trust stores, ACME/Let's Encrypt material, PKCS#12/PEM/JKS key files) or exports keys with openssl. Server daemons rarely spawn interpreters to read key material outside of exploitation or webshell activity, so this lineage anomaly indicates possible theft of authentication certificates and private keys."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1649"
    mitre_technique_name = "Steal or Forge Authentication Certificates"
    log_prerequisites = "Requires Linux EDR or auditd (execve) process launch telemetry with populated parent process path, child process path and command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Certificate renewal hooks (certbot/acme deploy hooks) invoked by web servers, application servers that reload keystores via shell wrappers, Java application startup scripts that reference .jks or .p12 files, database SSL setup scripts, and configuration management run through a service parent."
    tuning_guidance = "Add approved parent processes or wrapper binaries to %global_allowed_script_hosts and %global_allowed_admin_tools. If a Java or Node parent is noisy, add the specific application launcher to the allowlist rather than removing it from the parent regex. Review certificate renewal hooks and add their parent binary to the allowlist."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|php-fpm[0-9.]*|tomcat[0-9.]*|java|node|mysqld|mariadbd|postgres|mongod|redis-server|cupsd)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ash|ksh|python[0-9.]*|perl|ruby|php[0-9.]*)$/ nocase
    $proc.target.process.command_line = /(\/etc\/ssl\/private|\/etc\/pki\/|\/etc\/letsencrypt\/(live|archive)|\/var\/lib\/(pki|ipa|certmgr)|\/etc\/ipa\/|\.(pfx|p12|pem|jks|keystore)(\s|$|"|')|openssl\s+(pkcs12|rsa|pkey|x509)|keytool\s+.*-(importkeystore|exportcert))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1649")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
