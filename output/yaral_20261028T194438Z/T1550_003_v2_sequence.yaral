/*
  MITRE Technique : T1550.003 - Pass the Ticket
  Tactic(s)       : Lateral Movement
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:40:26.152410+00:00
  Reference       : https://attack.mitre.org/techniques/T1550/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1550_003_Kerberos_Ticket_File_Then_Remote_Kerberos_Logon {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A Kerberos ticket export file (.kirbi or .ccache) is written on one host, then the same account completes a network Kerberos logon on a different host within 10 minutes. This sequence is consistent with Pass-the-Ticket lateral movement using a dumped or forged ticket. It correlates file and authentication telemetry and does not depend on process command lines."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1550.003"
    mitre_technique_name = "Use Alternate Authentication Material: Pass the Ticket"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating principal.user.userid, and Windows Security 4624 logons normalised to USER_LOGIN with target.user.userid, extensions.auth.mechanism and extensions.auth.auth_details."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or security staff exporting tickets for Kerberos troubleshooting, authorised red team or purple team exercises, Kerberos-aware tooling and backup agents that cache tickets as files, and users who legitimately log on to another host shortly after exporting a ticket."
    tuning_guidance = "Add approved service and automation accounts to %global_allowed_service_accounts, administrator accounts that troubleshoot Kerberos to %global_allowed_admin_users, and approved tooling to %global_allowed_admin_tools. If extensions.auth.auth_details is not populated in your tenant, confirm the field mapping before deploying, or remove that line and rely on the network logon mechanism. Extend the file extension regex if your EDR reports other ticket export formats."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(kirbi|ccache)$/ nocase
    $file.principal.user.userid = $user
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    $login.metadata.event_type = "USER_LOGIN"
    $login.extensions.auth.mechanism = "NETWORK"
    $login.extensions.auth.auth_details = /kerberos/ nocase
    $login.target.user.userid = $user
    not $login.target.user.userid = /\$$/
    not $login.target.user.userid in %global_allowed_service_accounts
    not $login.target.user.userid in %global_allowed_admin_users
    $login.target.hostname != $file.principal.hostname

    $file.metadata.event_timestamp.seconds <= $login.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1550.003")
    $primary_entity = array_distinct($user)
    $ticket_export_hosts = array_distinct($file.principal.hostname)
    $ticket_files = array_distinct($file.target.file.full_path)
    $logon_target_hosts = array_distinct($login.target.hostname)
    $logon_source_ips = array_distinct($login.principal.ip)
    $first_seen = min($file.metadata.event_timestamp.seconds)
    $last_seen = max($login.metadata.event_timestamp.seconds)

  condition:
    $file and $login
}
