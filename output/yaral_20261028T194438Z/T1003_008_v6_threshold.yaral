/*
  MITRE Technique : T1003.008 - /etc/passwd and /etc/shadow
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:51:40.344274+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_008_Shadow_File_Mass_Read_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated file-read activity against /etc/shadow or /etc/gshadow on a single Linux host within 10 minutes, by processes that are not standard authentication components. A single read can be benign, but a burst of reads by an unexpected process indicates credential dumping for offline cracking (T1003.008). This rule is based on file-access telemetry, not command-line matching, so it also catches custom binaries, scripts and renamed utilities."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.008"
    mitre_technique_name = "OS Credential Dumping: /etc/passwd and /etc/shadow"
    log_prerequisites = "Requires Linux EDR file-read telemetry or auditd watch rules (-w /etc/shadow -p r) normalised to UDM FILE_READ events with principal.process.file.full_path and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management and compliance agents, file integrity monitoring, identity or directory sync agents (sssd/realmd enrolment), user-management scripts run by admins, backup jobs, vulnerability or audit scanners that inspect shadow file permissions or contents."
    tuning_guidance = "Add approved agents to %global_allowed_admin_tools, %global_allowed_security_tools or %global_allowed_backup_processes. Add automation accounts to %global_allowed_service_accounts. Extend the executable-name exclusion regex for site-specific PAM helpers. Raise the #file threshold in noisy environments, or lower it where auditd watch rules are scoped narrowly."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /^\/etc\/(shadow|gshadow)-?$/
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /^\/(usr\/)?(s?bin|lib(exec)?|lib\/systemd)\/(unix_chkpwd|sshd|login|su|sudo|passwd|chage|chpasswd|useradd|usermod|userdel|groupadd|groupmod|vipw|pwck|grpck|pwconv|pwunconv|systemd-logind|polkitd|cron|crond|atd|dbus-daemon|gdm|lightdm|sddm)$/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1003.008")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $files_read = array_distinct($file.target.file.full_path)
    $reading_processes = array_distinct($file.principal.process.file.full_path)
    $reading_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 5
}
