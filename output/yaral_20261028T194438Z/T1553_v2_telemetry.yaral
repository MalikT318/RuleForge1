/*
  MITRE Technique : T1553 - Subvert Trust Controls
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:58:40.913647+00:00
  Reference       : https://attack.mitre.org/techniques/T1553
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_Linux_Root_CA_Trust_Store_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a certificate file in a Linux system trust-anchor directory (the Debian, RHEL, SUSE and Arch CA stores) by a process that is not a package manager or CA-management utility. Adding a rogue root CA subverts TLS and code-signing trust (T1553.004 Install Root Certificate). The rule works on the resulting file artifact, so it still fires if command-line logging is evaded or the tooling is renamed."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553"
    mitre_technique_name = "Subvert Trust Controls"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules (-w on the trust anchor directories) that populate target.file.full_path and principal.process.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management (Ansible, Puppet, Chef, Salt) distributing corporate or internal CA certificates; container image builds and provisioning scripts adding a proxy or internal CA; administrators installing an enterprise CA manually; package installs that ship CA bundles."
    tuning_guidance = "Add approved config-management and deployment binaries to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Extend the package-manager executable-name exclusion if the client uses other package tooling. If a client mass-deploys internal CAs, consider enriching on the certificate file name via an allowlist."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(usr\/local\/share\/ca-certificates|usr\/share\/ca-certificates|etc\/pki\/ca-trust\/source\/anchors|etc\/pki\/trust\/anchors|etc\/ca-certificates\/trust-source\/anchors)\/.+\.(crt|pem|cer|der)$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|yum|dnf|zypper|pacman|update-ca-certificates|update-ca-trust|trust|p11-kit)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1553")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_cert_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
