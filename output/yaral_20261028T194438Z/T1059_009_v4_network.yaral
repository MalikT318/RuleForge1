/*
  MITRE Technique : T1059.009 - Cloud API
  Tactic(s)       : Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Office Suite
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:19:42.084264+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_009_Office_Suite_Scripted_Cloud_API_Write_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects state-changing (POST/PUT/PATCH/DELETE) calls to tenant directory, identity and administration API paths made by a command-line, scripting or SDK HTTP client from an external source address. This is the network-side signature of an adversary using a stolen token or session to drive the tenant through the cloud API (PowerShell modules, CLIs, Python or Go SDKs) instead of the interactive admin portal."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.009"
    mitre_technique_name = "Command and Scripting Interpreter: Cloud API"
    log_prerequisites = "Requires NETWORK_HTTP events populated with network.http.user_agent, network.http.method, target.url, principal.ip and principal.user.userid. Typical sources are a secure web gateway, CASB, API gateway or proxy that inspects traffic to the productivity-suite management APIs and is mapped to the identity log source."
    platform = "Office Suite"
    log_source = "identity"
    false_positives = "Legitimate administrators running automation from home or remote networks. Approved provisioning, HR-sync and licensing scripts. Backup, migration and SaaS-management vendors calling directory APIs. Security tooling that remediates users or groups through the API. Developers testing SDK integrations."
    tuning_guidance = "Add sanctioned automation identities to %global_allowed_service_accounts, named admins to %global_allowed_admin_users, and approved app or service principals to %global_allowed_cloud_principals. Widen or narrow the user-agent and API path regexes to match the client populations and tenants. Confirm the proxy or CASB populates principal.ip with the true client address, and exclude egress gateways if they appear there."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT|PATCH|DELETE)$/ nocase
    $net.network.http.user_agent = /(powershell|python-requests|python-urllib|aiohttp|httpx|go-http-client|okhttp|curl\/|azure-cli|azsdk|msgraph-sdk|graphpowershell|aws-sdk|boto3|google-api-python-client|gcloud|apache-httpclient|java\/)/ nocase
    $net.target.url = /\/(admin\/directory\/v1|v1\.0|beta)\/(users|groups|directoryroles|rolemanagement|roles|roleassignments|applications|serviceprincipals|oauth2permissiongrants|approleassignments|domains|devices|policies|tokens)(\/|\?|$)/ nocase
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.user.userid in %global_allowed_admin_users
    not $net.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1059.009")
    $primary_entity = array_distinct($net.principal.user.userid)
    $source_ips = array_distinct($net.principal.ip)
    $user_agents = array_distinct($net.network.http.user_agent)
    $http_methods = array_distinct($net.network.http.method)
    $target_urls = array_distinct($net.target.url)

  condition:
    $net
}
