/*
  MITRE Technique : T1213.005 - Messaging Applications
  Tactic(s)       : Collection
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:29:09.187313+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_005_Identity_Login_Then_Bulk_Messaging_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a user sign-in from an external source address followed within ten minutes by a burst of resource-access events against chat, channel, message or conversation objects by the same user. This pattern is consistent with an adversary using a freshly authenticated or hijacked session to mine messaging content for credentials, internal links or incident-response discussions."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.005"
    mitre_technique_name = "Data from Information Repositories: Messaging Applications"
    log_prerequisites = "Requires identity provider sign-in logs (USER_LOGIN with principal.ip populated) and SaaS messaging audit logs (USER_RESOURCE_ACCESS with target.resource.name populated) normalised to UDM with a consistent principal.user.userid across both sources."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Remote or travelling staff catching up on chat history after sign-in, eDiscovery and compliance export operators, helpdesk or SOC staff reviewing conversations, and chat-archiving or migration integrations running under user context."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts and compliance or eDiscovery administrators to %global_allowed_admin_users. Raise or lower the #access threshold in the condition to match the tenant's normal chat-access volume. Narrow the resource-name regex if the tenant's audit log uses different naming for messaging objects."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid = $user
    not $auth.principal.ip in %rfc1918_internal
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users

    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.principal.user.userid = $user
    $access.target.resource.name = /(chat|channel|message|conversation|thread|direct_?message)/ nocase
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_admin_users

    $auth.metadata.event_timestamp.seconds <= $access.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1213.005")
    $primary_entity = array_distinct($user)
    $access_count = count($access.metadata.id)
    $source_ips = array_distinct($auth.principal.ip)
    $accessed_resources = array_distinct($access.target.resource.name)

  condition:
    $auth and #access >= 10
}
