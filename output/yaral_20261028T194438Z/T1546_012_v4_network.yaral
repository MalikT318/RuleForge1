/*
  MITRE Technique : T1546.012 - Image File Execution Options Injection
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:17:16.844166+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_012_IFEO_Hijack_Target_Or_Debugger_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Network-side indicator of Image File Execution Options (IFEO) abuse. Detects a Windows accessibility or logon-screen binary (sethc, utilman, osk, narrator, magnify, displayswitch, atbroker) or a native Windows debugger (ntsd, cdb, kd, windbg) opening an outbound connection to a non-internal address. Accessibility binaries are the classic IFEO Debugger hijack targets, and a hijacked entry launches an attacker payload under that binary's name. These binaries have no legitimate reason to talk to external hosts. Debuggers acting as the IFEO Debugger value can likewise be used as a relay or launcher for a C2 implant. This is a post-exploitation network signal that complements registry- and command-line-based IFEO detections."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.012"
    mitre_technique_name = "Event Triggered Execution: Image File Execution Options Injection"
    log_prerequisites = "Endpoint network telemetry that populates the initiating process path (EDR or Sysmon Event ID 3) and normalises to NETWORK_CONNECTION. Reference lists %rfc1918_internal, %global_allowed_domains, %global_allowed_security_tools and %global_allowed_admin_tools must exist in the tenant."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "WinDbg, cdb or kd fetching symbols from a public symbol server, or performing remote kernel/user-mode debugging by developers and support engineers. Crash-dump analysis tooling on analyst workstations. Remote-support tools that launch the on-screen keyboard or Narrator and show it making network calls (uncommon). Security agents that inspect these binaries."
    tuning_guidance = "Add symbol and vendor domains to %global_allowed_domains (if target.hostname is populated). Add debugger or developer tooling parent paths to %global_allowed_admin_tools and security agents to %global_allowed_security_tools. On developer or engineering hosts, consider removing the debugger names from the regex and keeping only the accessibility binaries. Pair with endpoint registry rules for HKLM\\...\\Image File Execution Options\\<exe>\\Debugger and with SilentProcessExit key modification for confirmation."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(sethc|utilman|osk|narrator|magnify|displayswitch|atbroker|ntsd|cdb|kd|windbg|windbgx)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546.012")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $affected_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
