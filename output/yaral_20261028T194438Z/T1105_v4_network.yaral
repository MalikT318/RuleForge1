/*
  MITRE Technique : T1105 - Ingress Tool Transfer
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:13:19.767973+00:00
  Reference       : https://attack.mitre.org/techniques/T1105
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1105_Network_Executable_Download_NonBrowser_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host using HTTP GET to retrieve an executable, script, installer or archive from an external destination with a non-browser (or absent) user agent. This is the network-side signature of ingress tool transfer by command-line downloaders and scripting runtimes, and it is independent of endpoint process telemetry."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1105"
    mitre_technique_name = "Ingress Tool Transfer"
    log_prerequisites = "Requires firewall or web proxy logs normalised to NETWORK_HTTP with network.http.method, target.url and target.ip populated. network.http.user_agent should be populated, otherwise requests with no user agent are treated as non-browser."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Package managers and OS or application updaters fetching installers from vendor mirrors, software deployment tooling, developer or CI hosts pulling build artefacts, and monitoring agents downloading scripts."
    tuning_guidance = "Add vendor update and package-mirror domains to %global_allowed_domains (matched against target.hostname). Narrow or extend the extension list for the client's baseline. If response codes are reliably populated, add network.http.response_code >= 200 and < 300 to alert only on successful transfers. Enrich the source host against server or build-farm asset groups to lower severity."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.target.url = /\.(exe|dll|msi|scr|ps1|bat|vbs|hta|jar|elf|sh|bin|iso|7z|zip|rar|tar|gz)(\?.*)?$/ nocase
    not $net.network.http.user_agent = /^(Mozilla|Opera)\// nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1105")
    $primary_entity = array_distinct($net.principal.ip)
    $download_urls = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
