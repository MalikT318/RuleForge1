/*
  MITRE Technique : T1037.003 - Network Logon Script
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:21:11.528846+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_003_Logon_Script_Written_To_NETLOGON_SYSVOL {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of an executable script or binary in the NETLOGON share, the SYSVOL scripts folder, or a GPO logon/startup script folder. Adversaries with write access to these locations can plant a network logon script that runs on every host or user the script is assigned to, giving persistence and possible privilege escalation."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.003"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Network Logon Script"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon Event ID 11) from domain controllers and, ideally, from admin workstations that write to the share over SMB. Target file path must be populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Domain administrators or GPO management consoles publishing legitimate logon scripts; software deployment and RMM tools that push scripts to NETLOGON; identity management automation; SYSVOL replication (DFSR) staging on domain controllers."
    tuning_guidance = "Add approved script-publishing tools to %global_allowed_admin_tools, named admins to %global_allowed_admin_users, and automation accounts to %global_allowed_service_accounts. Review DFSR/replication processes in the baseline for each client and add them to the allowlist if they alert."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(netlogon|sysvol\\[^\\]+\\scripts|sysvol\\[^\\]+\\policies\\\{[0-9a-f-]+\}\\(user|machine)\\scripts(\\(logon|logoff|startup|shutdown))?)\\([^\\]+\\)*[^\\]+\.(bat|cmd|ps1|vbs|vbe|js|jse|wsf|wsh|hta|exe|scr|com)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1037.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $script_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
