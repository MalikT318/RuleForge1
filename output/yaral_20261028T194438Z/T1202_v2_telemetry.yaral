/*
  MITRE Technique : T1202 - Indirect Command Execution
  Tactic(s)       : Stealth
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:53:30.410589+00:00
  Reference       : https://attack.mitre.org/techniques/T1202
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1202_SSH_Config_Written_By_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a script interpreter or LOLBin creating or overwriting an OpenSSH client configuration file (per-user .ssh\\config or ProgramData\\ssh\\ssh_config). Adversaries plant ProxyCommand or LocalCommand directives in these files so that ssh.exe later runs arbitrary commands indirectly, bypassing cmd/PowerShell restrictions. Detection is at the file-artifact layer, so it does not depend on command-line logging."
    mitre_tactic = "Stealth"
    mitre_technique = "T1202"
    mitre_technique_name = "Indirect Command Execution"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with the writing process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin or provisioning scripts that deploy approved SSH client configuration, developer workstation bootstrap scripts, configuration management tools, and software installers that bundle OpenSSH."
    tuning_guidance = "Add deployment and configuration tooling to %global_allowed_admin_tools and approved build or provisioning hosts to %global_allowed_script_hosts. FILE_CREATION and FILE_MODIFICATION are separate event types and cannot be combined in one rule. If the EDR reports overwrites as FILE_MODIFICATION, clone this rule with that event type. Review the written file content, looking for ProxyCommand or LocalCommand, before closing the alert."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(\\Users\\[^\\]+\\\.ssh\\config|\\ProgramData\\ssh\\ssh_config)$/ nocase
    $file.principal.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|wmic|msiexec|forfiles|pcalua|scriptrunner)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1202")
    $primary_entity = array_distinct($file.principal.hostname)
    $written_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
