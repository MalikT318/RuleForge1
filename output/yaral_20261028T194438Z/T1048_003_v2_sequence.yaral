/*
  MITRE Technique : T1048.003 - Exfiltration Over Unencrypted Non-C2 Protocol
  Tactic(s)       : Exfiltration
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:37:36.716725+00:00
  Reference       : https://attack.mitre.org/techniques/T1048/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1048_003_ESXi_Login_Then_Firewall_Opened_For_Cleartext_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A management or SSH login to an ESXi host from a non-approved source is followed within ten minutes by a firewall configuration change that enables an outbound unencrypted client rule set (FTP, HTTP, TFTP, SMTP or Telnet) on the same host. This staging pattern precedes exfiltration of VM or datastore data over cleartext protocols. The rule detects the host configuration change, not a command line."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1048.003"
    mitre_technique_name = "Exfiltration Over Alternative Protocol: Exfiltration Over Unencrypted Non-C2 Protocol"
    log_prerequisites = "ESXi hostd and shell/auth logs forwarded and parsed into UDM. Login events must populate USER_LOGIN with principal.ip and target.user.userid. Firewall rule set changes logged by hostd must populate SETTING_MODIFICATION with a description. Hostname must be consistent across both event types."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators temporarily enabling the HTTP or FTP client to pull patches, VIB bundles or ISOs. Backup, deployment or monitoring tooling that toggles client rule sets. Lifecycle or upgrade workflows run from a jump host that is not yet allowlisted."
    tuning_guidance = "Add jump hosts and management subnets' source addresses to %global_allowed_mgmt_sources. Add named administrators to %global_allowed_admin_users. Add automation accounts to %global_allowed_service_accounts. If the parser places the rule set text in a different field, adjust the metadata.description regex. If the ESXi hostname is carried in target.hostname rather than principal.hostname, change the join fields."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.metadata.description = /(ssh|shell|accepted\s+(password|publickey|keyboard-interactive)|session\s+opened|logged\s+in)/ nocase
    not $login.principal.ip in %global_allowed_mgmt_sources
    not $login.target.user.userid in %global_allowed_admin_users
    not $login.target.user.userid in %global_allowed_service_accounts
    $login.principal.hostname = $hostname

    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.description = /firewall/ nocase
    $setting.metadata.description = /operation\s+'?enable'?/ nocase
    $setting.metadata.description = /rule\s?set\s+'?(ftpClient|httpClient|tftpClient|tftp|smtpClient|smtp|telnetClient|telnet)\b/ nocase
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    $setting.principal.hostname = $hostname

    $login.metadata.event_timestamp.seconds <= $setting.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1048.003")
    $primary_entity = array_distinct($hostname)
    $login_source_ips = array_distinct($login.principal.ip)
    $login_users = array_distinct($login.target.user.userid)
    $firewall_change_details = array_distinct($setting.metadata.description)
    $login_count = count($login.metadata.id)
    $setting_count = count($setting.metadata.id)

  condition:
    $login and $setting
}
