/*
  MITRE Technique : T1090 - Proxy
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:24:54.732192+00:00
  Reference       : https://attack.mitre.org/techniques/T1090
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1090_ESXi_SSH_Login_Then_Proxy_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a successful SSH login to an ESXi host followed within 10 minutes by a host configuration change that enables traffic relaying: SSH TCP forwarding or tunnelling, or a firewall ruleset being enabled or opened. Adversaries use this to turn the hypervisor into a connection proxy or pivot (T1090)."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1090"
    mitre_technique_name = "Proxy"
    log_prerequisites = "ESXi hostd, shell and auth syslog forwarded to Chronicle and parsed into USER_LOGIN and SETTING_MODIFICATION events, with metadata.description populated from the original message."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators legitimately enabling firewall rulesets (NTP, SNMP, syslog, vSAN, backup agents) after an SSH session; patching and host build automation; approved SSH tunnelling for troubleshooting."
    tuning_guidance = "Add named admin accounts to %global_allowed_admin_users and automation or deployment accounts to %global_allowed_service_accounts. If the principal.hostname values differ between login and settings events in your parser, align the join field. Narrow the setting regex to the rulesets you expect to see in change windows."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.metadata.description = /accepted\s+\S+\s+for\s+/ nocase
    not $login.target.user.userid in %global_allowed_admin_users
    $login.principal.hostname = $hostname

    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.description = /(allowtcpforwarding|permittunnel|gatewayports|firewall.{0,40}(ruleset|rule).{0,60}(enabl|allow|true))/ nocase
    not $setting.principal.user.userid in %global_allowed_service_accounts
    $setting.principal.hostname = $hostname

    $login.metadata.event_timestamp.seconds <= $setting.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1090")
    $primary_entity = array_distinct($hostname)
    $login_users = array_distinct($login.target.user.userid)
    $login_source_ips = array_distinct($login.principal.ip)
    $setting_changes = array_distinct($setting.metadata.description)
    $setting_count = count($setting.metadata.id)

  condition:
    $login and $setting
}
