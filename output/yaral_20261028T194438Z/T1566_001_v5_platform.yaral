/*
  MITRE Technique : T1566.001 - Spearphishing Attachment
  Tactic(s)       : Initial Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:47:54.420820+00:00
  Reference       : https://attack.mitre.org/techniques/T1566/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1566_001_Linux_Client_Attachment_Payload_Download_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux desktop client (browser or mail client identified by an X11 Linux user agent) retrieving an executable, script, archive or macro-document payload from an external URL whose path looks like a mail or webmail attachment download. This is the network-observable result of a user opening a spearphishing attachment on a Linux workstation. It complements process-creation rules by working from proxy or firewall HTTP telemetry."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1566.001"
    mitre_technique_name = "Phishing: Spearphishing Attachment"
    log_prerequisites = "Requires proxy or firewall HTTP inspection logs normalised to NETWORK_HTTP, with network.http.user_agent and target.url populated. TLS inspection is needed for visibility into HTTPS URL paths."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Linux developers and admins downloading legitimate packages, ISOs, installers or archives from vendor portals that use 'download' or 'attachment' URL paths; internal document-sharing portals; CI or build workstations running a browser user agent."
    tuning_guidance = "Add known-good vendor, repository and file-sharing domains to %global_allowed_domains. Exclude vulnerability scanners and test hosts by adding their hostnames to %global_allowed_scanners. If the user-agent filter is noisy in developer subnets, scope the rule at the proxy policy level or raise severity only for non-engineering segments."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /\(X11;[^)]*Linux/ nocase
    not $net.network.http.user_agent = /android/ nocase
    $net.target.url = /(attach(ment)?s?|mailfile|msgfile|download)[^?#]*\.(iso|img|zip|rar|7z|jar|appimage|sh|run|deb|rpm|py|pl|desktop|scr|lnk|js|hta|docm|xlsm|pptm)([?#]|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1566.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
