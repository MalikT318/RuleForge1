/*
  MITRE Technique : T1538 - Cloud Service Dashboard
  Tactic(s)       : Discovery
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:36:57.820819+00:00
  Reference       : https://attack.mitre.org/techniques/T1538
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1538_M365_Admin_Dashboard_Access_By_NonAdmin {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a successful interactive sign-in to a cloud administration or security dashboard (management portal, admin center, security/compliance console) by an account that is not a named administrator or approved service account. Adversaries with stolen credentials use these GUIs to enumerate tenant resources, services and security findings without making API calls."
    mitre_tactic = "Discovery"
    mitre_technique = "T1538"
    mitre_technique_name = "Cloud Service Dashboard"
    log_prerequisites = "Requires unified audit logs with identity sign-in events ingested and normalised to UDM USER_LOGIN with target.application populated (application or portal display name)."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Newly promoted or delegated admins not yet in the allowlist, helpdesk staff using admin centers, security analysts using compliance and security portals, consultants and MSP technicians with delegated access, break-glass account tests."
    tuning_guidance = "Add named administrators to %global_allowed_admin_users, automation identities to %global_allowed_service_accounts, and corporate egress or privileged-access-workstation addresses to %global_allowed_mgmt_sources. Narrow or extend the application-name regex if client application display names differ."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.application = /(portal|admin|management|compliance|security|purview|defender)/ nocase
    $auth.principal.user.userid != ""
    not $auth.principal.user.userid in %global_allowed_admin_users
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1538")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $dashboard_apps = array_distinct($auth.target.application)
    $source_ips = array_distinct($auth.principal.ip)

  condition:
    $auth
}
