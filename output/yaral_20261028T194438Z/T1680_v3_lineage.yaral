/*
  MITRE Technique : T1680 - Local Storage Discovery
  Tactic(s)       : Discovery
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:28:34.691796+00:00
  Reference       : https://attack.mitre.org/techniques/T1680
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1680_Linux_Storage_Discovery_From_Service_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux web server, application server, database or print service process directly launching a shell or disk utility that enumerates local storage (lsblk, fdisk -l, parted, blkid, lshw, findmnt, df, /proc/partitions, /proc/mounts). Service processes rarely enumerate disks. This behaviour typically indicates a web shell, injected code or a compromised service preparing for ransomware or direct volume access."
    mitre_tactic = "Discovery"
    mitre_technique = "T1680"
    mitre_technique_name = "Local Storage Discovery"
    log_prerequisites = "Linux EDR or auditd execve telemetry normalised to UDM PROCESS_LAUNCH with parent process path, child process path and command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Application health-check or monitoring scripts launched by Java or Node services that call df; database maintenance or backup jobs spawned by the database service that check free space; installers or auto-update routines run under a service parent; CUPS filters inspecting disks."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts. Add EDR or monitoring agents to %global_allowed_security_tools. If java or node parents are noisy, add the specific wrapper binaries to the allowlists rather than removing the lineage logic."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9.]*|php-cgi|tomcat[0-9]*|java|node|mysqld|mariadbd|postgres|mongod|redis-server|cupsd)$/ nocase
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|lsblk|fdisk|parted|lshw|blkid|findmnt|df)$/ nocase
    $proc.target.process.command_line = /(\b(lsblk|fdisk\s+-l|parted|lshw|blkid|findmnt)\b|\bdf(\s+-[a-z]+|\s*$)|\/proc\/(partitions|mounts|diskstats)|\/sys\/block)/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1680")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_command = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
