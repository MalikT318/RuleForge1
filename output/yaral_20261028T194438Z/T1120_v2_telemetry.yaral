/*
  MITRE Technique : T1120 - Peripheral Device Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:27:01.545166+00:00
  Reference       : https://attack.mitre.org/techniques/T1120
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1120_Linux_Peripheral_Device_Enumeration_File_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects a process reading kernel and sysfs peripheral inventory files (USB, input, PCI, video, sound and printer device descriptors). This detection is based on the file access that results from peripheral enumeration rather than the command line, so it still fires when the command line is hidden, the tool is renamed, or a script or custom binary reads the files directly. Well-known system daemons that legitimately read these files are excluded by executable name."
    mitre_tactic = "Discovery"
    mitre_technique = "T1120"
    mitre_technique_name = "Peripheral Device Discovery"
    log_prerequisites = "Requires Linux endpoint file-access telemetry normalised to FILE_READ, such as EDR file-open events or auditd watch rules (-w /proc/bus/input/devices -p r, -w /sys/bus/usb/devices -p r). Without a watch rule or EDR file-read collection the kernel pseudo-files will not generate events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Desktop and hardware daemons not in the exclusion regex (udev helpers, power managers, KVM/QEMU and USB-passthrough tooling, container runtimes), hardware inventory and CMDB agents, configuration management facts collection (Ansible, Puppet, Salt), admin troubleshooting with lsusb/lspci, and monitoring agents that collect hardware metrics."
    tuning_guidance = "Add approved inventory, monitoring and configuration-management binaries to %global_allowed_admin_tools. Add EDR/AV agents to %global_allowed_security_tools. Extend the daemon-name exclusion regex for client-specific desktop or hardware services. On server fleets with no USB use, consider raising severity. Keep auditd watches limited to the listed paths to control volume."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /^\/(proc\/bus\/(input\/devices|usb\/devices|pci\/)|sys\/bus\/usb\/devices\/.+\/(product|manufacturer|serial|idVendor|idProduct)|sys\/class\/(input|video4linux|sound|printer|usbmisc)\/|dev\/bus\/usb\/)/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path = /\/(systemd-udevd|udevd|systemd-logind|upowerd|Xorg|Xwayland|libinput[a-z-]*|gsd-[a-z-]+|cupsd|cups-browsed|bluetoothd|pipewire|pulseaudio|wireplumber|NetworkManager|ModemManager|fwupd|udisksd|dbus-daemon|dbus-broker|gnome-shell|colord|polkitd|gvfs[a-z-]*|thermald|irqbalance)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1120")
    $primary_entity = array_distinct($file.principal.hostname)
    $reader_process = array_distinct($file.principal.process.file.full_path)
    $accessed_paths = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
