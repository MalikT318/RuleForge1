/*
  MITRE Technique : T1547.008 - LSASS Driver
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:33:36.407889+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_008_LSA_Package_Registry_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of the LSA registry values that control which DLLs are loaded into lsass.exe (Authentication Packages, Notification Packages, Security Packages). Adversaries add or replace entries to get persistent code execution inside the LSA process. The rule fires on the registry state change, so it does not depend on command-line logging."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.008"
    mitre_technique_name = "Boot or Logon Autostart Execution: LSASS Driver"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events 12/13/14) with registry key and value name populated in UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate installation of password-filter or credential-provider products (e.g. password complexity filters, smart-card or MFA agents, third-party SSO agents), Windows servicing (TrustedInstaller/TiWorker), domain and security baseline tooling such as GPO or DSC enforcement."
    tuning_guidance = "Add approved deployment or installer binaries to %global_allowed_admin_tools, EDR/security agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Review the registry_value_data outcome to confirm that the added package is a signed, expected product DLL."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      (
        $reg.target.registry.registry_key = /\\Control\\Lsa(\\OSConfig)?$/ nocase and
        $reg.target.registry.registry_value_name = /^(Authentication Packages|Notification Packages|Security Packages)$/ nocase
      ) or
      $reg.target.registry.registry_key = /\\Control\\Lsa(\\OSConfig)?\\(Authentication Packages|Notification Packages|Security Packages)$/ nocase
    )
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.008")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $registry_value_data = array_distinct($reg.target.registry.registry_value_data)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
