/*
  MITRE Technique : T1036.006 - Space after Filename
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:06:56.098519+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_006_Linux_Trailing_Space_Filename_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a file on Linux whose name ends with an extension followed by one or more trailing space characters (for example 'name.txt ') inside user-writable staging locations such as /tmp, /var/tmp, /dev/shm, /root and /home. A trailing space defeats extension-based file-type handling and is used to disguise executables as benign documents. This is a file-creation detection, not a command-line match, so it is additive to process-creation coverage."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.006"
    mitre_technique_name = "Masquerading: Space after Filename"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-creation records (PATH/CREATE) normalised to UDM FILE_CREATION with target.file.full_path populated and trailing whitespace preserved by the parser."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Files saved by users or desktop applications with accidental trailing spaces; archive extraction of files created on other operating systems; file-sync clients and browsers writing downloads with unusual names; developer or build scripts producing odd filenames."
    tuning_guidance = "Add approved tooling or parent binaries to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. If the SIEM parser trims trailing whitespace from paths, validate that the field retains the space before deployment. Extend or narrow the staging-directory regex per client if needed."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|root|home\/[^\/]+)\/.*\/?[^\/]*\.[A-Za-z0-9]{1,8}[ ]+$/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1036.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
