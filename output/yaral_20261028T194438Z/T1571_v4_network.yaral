/*
  MITRE Technique : T1571 - Non-Standard Port
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:17:36.010189+00:00
  Reference       : https://attack.mitre.org/techniques/T1571
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1571_ESXi_Outbound_NonStandard_Port_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an ESXi host initiating an outbound connection to an external (non-internal) address on a port outside the small set of ports a hypervisor normally uses for external services (DNS, NTP, HTTP/HTTPS, syslog, vCenter heartbeat). A hypervisor reaching the internet on an arbitrary port is a strong indicator of C2, tunnelling, or data staging over a non-standard protocol and port pairing."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1571"
    mitre_technique_name = "Non-Standard Port"
    log_prerequisites = "Requires ESXi network connection telemetry (for example firewall rule-set logging, vmkernel/dvfilter connection logs, or an agent/NetFlow feed from the host) normalised to UDM NETWORK_CONNECTION with principal.hostname, target.ip and target.port populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Outbound connections to vendor licensing, update or telemetry services on custom ports; third-party backup or replication appliances using proprietary ports; external syslog, SNMP trap or monitoring collectors on non-default ports; NFS/iSCSI targets reached via routable non-RFC1918 addresses; admins using SSH or other tools to reach external hosts for troubleshooting."
    tuning_guidance = "Add approved update, vendor and backup destination domains to %global_allowed_domains. Add approved on-host agent or tooling binaries to %global_allowed_admin_tools. Extend the port exclusion list with ports that are standard in the client environment (for example a custom syslog or replication port). Ensure %rfc1918_internal covers the client's internal and storage address space so internal traffic is excluded."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname != ""
    $net.target.ip != ""
    $net.target.port > 0
    $net.target.port != 53
    $net.target.port != 80
    $net.target.port != 123
    $net.target.port != 443
    $net.target.port != 514
    $net.target.port != 902
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1571")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_processes = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
