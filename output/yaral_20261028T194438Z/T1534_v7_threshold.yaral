/*
  MITRE Technique : T1534 - Internal Spearphishing
  Tactic(s)       : Lateral Movement
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:33:34.578427+00:00
  Reference       : https://attack.mitre.org/techniques/T1534
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1534_Internal_Spearphishing_Mass_Internal_Email_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single user account sends an unusually high volume of email messages within ten minutes. This may indicate a compromised internal account being used to spread phishing lures to colleagues. Each message is benign on its own; the burst from one sender is the signal."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1534"
    mitre_technique_name = "Internal Spearphishing"
    log_prerequisites = "Requires unified audit or message trace telemetry normalised to UDM EMAIL_TRANSACTION events with principal.user.userid populated for the sender."
    platform = "SaaS"
    log_source = "m365"
    false_positives = "Marketing or HR bulk communications sent from a personal mailbox, shared or notification mailboxes, helpdesk and ticketing auto-responders, calendar or meeting invitation bursts, newsletter and distribution list owners, and automation or mail-merge accounts."
    tuning_guidance = "Add automation, notification and bulk-mailer accounts to %global_allowed_service_accounts. Add named communications or admin users to %global_allowed_admin_users. Raise or lower the #email threshold (default 25 in 10m) to suit the client's normal mail volume. Severity and risk score scale automatically above 100 messages."

  events:
    $email.metadata.event_type = "EMAIL_TRANSACTION"
    $email.principal.user.userid = $user
    $email.principal.user.userid != ""
    not $email.principal.user.userid in %global_allowed_service_accounts
    not $email.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $email_count = count($email.metadata.id)
    $risk_score = if($email_count >= 100, 85, 60)
    $mitre_technique_id = array_distinct("T1534")
    $primary_entity = array_distinct($user)
    $recipients = array_distinct($email.network.email.to)
    $subjects = array_distinct($email.network.email.subject)
    $source_ips = array_distinct($email.principal.ip)

  condition:
    #email >= 25
}
