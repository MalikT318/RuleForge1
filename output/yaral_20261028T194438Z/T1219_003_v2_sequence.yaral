/*
  MITRE Technique : T1219.003 - Remote Access Hardware
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:10:11.446490+00:00
  Reference       : https://attack.mitre.org/techniques/T1219/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1219_003_Linux_HID_Udev_Rule_Then_Console_Autologin {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a USB/HID-related udev rule being written on a Linux host, followed within 10 minutes on the same host by creation of a systemd getty/serial-getty override drop-in. This pairing is consistent with preparing a host for IP-KVM or remote access hardware: the input device is registered and a local console session is made available without credentials. It is file-based and does not depend on process command lines."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1219.003"
    mitre_technique_name = "Remote Access Software: Remote Access Hardware"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry with populated principal.hostname, target.file.full_path and principal.process.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management (Ansible, Puppet, Chef, Salt) rolling out udev and getty settings; kiosk, thin-client or lab builds that use console autologin; hardware enablement during provisioning; legitimate lab or datacenter IP-KVM deployments; OS installers and image builders."
    tuning_guidance = "Add configuration management and provisioning tooling to %global_allowed_admin_tools. Package managers are already excluded by process name. Narrow the udev filename keywords if a client's standard images ship matching rules. Consider scoping to server asset groups where console autologin is never expected."

  events:
    $udev.metadata.event_type = "FILE_CREATION"
    $udev.target.file.full_path = /\/udev\/rules\.d\/[^\/]*(hid|usb|gadget|uinput|input|kvm)[^\/]*\.rules$/ nocase
    not $udev.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|yum|dnf|zypper|snapd|packagekitd|pacman|unattended-upgrade)$/ nocase
    not $udev.principal.process.file.full_path in %global_allowed_admin_tools
    $udev.principal.hostname = $host

    $getty.metadata.event_type = "FILE_CREATION"
    $getty.target.file.full_path = /\/systemd\/system\/(serial-)?getty@[^\/]*\.service\.d\/[^\/]+\.conf$/ nocase
    not $getty.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|yum|dnf|zypper|snapd|packagekitd|pacman|unattended-upgrade)$/ nocase
    not $getty.principal.process.file.full_path in %global_allowed_admin_tools
    $getty.principal.hostname = $host

    $udev.metadata.event_timestamp.seconds <= $getty.metadata.event_timestamp.seconds

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1219.003")
    $primary_entity = array_distinct($host)
    $udev_rule_paths = array_distinct($udev.target.file.full_path)
    $getty_override_paths = array_distinct($getty.target.file.full_path)
    $writer_processes = array_distinct($getty.principal.process.file.full_path)
    $event_count = count($getty.metadata.id)

  condition:
    $udev and $getty
}
