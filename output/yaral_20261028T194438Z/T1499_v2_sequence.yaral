/*
  MITRE Technique : T1499 - Endpoint Denial of Service
  Tactic(s)       : Impact
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:14:48.622129+00:00
  Reference       : https://attack.mitre.org/techniques/T1499
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1499_Inbound_Connection_Flood_Then_Service_Errors {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a high-volume burst of external connections to common Windows-hosted service ports (HTTP/HTTPS, SMB, RDP) on a single destination, followed by server-side 5xx errors from the same destination within ten minutes. This indicates a resource-exhaustion style endpoint DoS that is degrading the service, not just a noisy scan."
    mitre_tactic = "Impact"
    mitre_technique = "T1499"
    mitre_technique_name = "Endpoint Denial of Service"
    log_prerequisites = "Requires firewall or perimeter connection logs (NETWORK_CONNECTION) and proxy, WAF or reverse-proxy HTTP logs (NETWORK_HTTP) with response codes, both normalised to UDM with target.ip populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Flash-crowd traffic from marketing campaigns or product launches, uptime and synthetic monitoring, unlisted vulnerability scanners and load-testing tools, CDN or NAT egress addresses that aggregate many users, and legitimate backend application bugs that return 5xx errors during busy periods."
    tuning_guidance = "Add authorised scanners and load-test sources to %global_allowed_scanners. Add trusted management sources to %global_allowed_mgmt_sources. Raise or lower the #conn threshold in the condition to match each client's normal peak traffic, and adjust the destination port list to the services the client exposes."

  events:
    $conn.metadata.event_type = "NETWORK_CONNECTION"
    (
      $conn.target.port = 80 or
      $conn.target.port = 443 or
      $conn.target.port = 445 or
      $conn.target.port = 3389
    )
    not $conn.principal.ip in %rfc1918_internal
    not $conn.principal.ip in %global_allowed_scanners
    not $conn.principal.ip in %global_allowed_mgmt_sources
    $conn.target.ip = $dst

    $err.metadata.event_type = "NETWORK_HTTP"
    $err.network.http.response_code >= 500
    not $err.principal.ip in %rfc1918_internal
    not $err.principal.ip in %global_allowed_scanners
    $err.target.ip = $dst

    $conn.metadata.event_timestamp.seconds <= $err.metadata.event_timestamp.seconds

  match:
    $dst over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1499")
    $primary_entity = array_distinct($dst)
    $source_ips = array_distinct($conn.principal.ip)
    $targeted_ports = array_distinct($conn.target.port)
    $connection_count = count($conn.metadata.id)
    $error_count = count($err.metadata.id)
    $max_http_status = max($err.network.http.response_code)

  condition:
    $conn and $err and #conn >= 100 and #err >= 3
}
