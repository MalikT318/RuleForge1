/*
  MITRE Technique : T1574.006 - Dynamic Linker Hijacking
  Tactic(s)       : Stealth, Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:32:15.781439+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_006_Staged_Shared_Object_Then_LD_Preload_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "A shared object (.so) is written to a world-writable staging directory (/tmp, /var/tmp, /dev/shm) and /etc/ld.so.preload is then modified on the same host within 10 minutes. This sequence indicates system-wide dynamic linker hijacking, where an attacker stages a malicious library and registers it so that every dynamically linked process loads it."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.006"
    mitre_technique_name = "Hijack Execution Flow: Dynamic Linker Hijacking"
    log_prerequisites = "Requires Linux EDR or auditd file telemetry (FILE_CREATION and FILE_MODIFICATION) with principal.hostname and target.file.full_path populated. File-integrity or audit watches on /etc/ld.so.preload and the staging directories improve coverage."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software installers or developer build tooling that compile a library in /tmp and register it in /etc/ld.so.preload; performance, profiling or debugging tools that use preload shims; configuration management agents that manage ld.so.preload; legitimate security or runtime-protection agents that register a preload library."
    tuning_guidance = "Add approved deployment, configuration management and patching tool binaries to %global_allowed_admin_tools. Add EDR or runtime-protection agent binaries that legitimately manage ld.so.preload to %global_allowed_security_tools. If the sensor reports first-time creation of /etc/ld.so.preload as FILE_CREATION rather than FILE_MODIFICATION, deploy a sibling variant with the second event as FILE_CREATION. Extend the staging directory regex if the environment uses other world-writable paths."

  events:
    $drop.metadata.event_type = "FILE_CREATION"
    $drop.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+\.so(\.[0-9]+)*$/ nocase
    not $drop.principal.process.file.full_path in %global_allowed_admin_tools
    $drop.principal.hostname = $hostname

    $preload.metadata.event_type = "FILE_MODIFICATION"
    $preload.target.file.full_path = /^\/etc\/ld\.so\.preload$/ nocase
    not $preload.principal.process.file.full_path in %global_allowed_admin_tools
    not $preload.principal.process.file.full_path in %global_allowed_security_tools
    $preload.principal.hostname = $hostname

    $drop.metadata.event_timestamp.seconds <= $preload.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1574.006")
    $primary_entity = array_distinct($hostname)
    $staged_libraries = array_distinct($drop.target.file.full_path)
    $dropper_processes = array_distinct($drop.principal.process.file.full_path)
    $preload_modifiers = array_distinct($preload.principal.process.file.full_path)
    $acting_users = array_distinct($preload.principal.user.userid)
    $event_count = count($preload.metadata.id)

  condition:
    $drop and $preload
}
