/*
  MITRE Technique : T1563 - Remote Service Session Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:06:11.921229+00:00
  Reference       : https://attack.mitre.org/techniques/T1563
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_Linux_Internal_Remote_Session_Protocol_Lateral {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects internal-to-internal connections to interactive remote-session services (SSH on 22, telnet on 23) seen at the network perimeter or internal firewall, from sources not approved for management access. Session hijacking (for example SSH agent or ControlMaster socket abuse) does not itself appear in firewall telemetry. This rule therefore detects the network-observable lateral movement it depends on: a non-management host opening a remote session channel to another internal Linux host. Treat a hit as a lead to correlate with endpoint telemetry."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1563"
    mitre_technique_name = "Remote Service Session Hijacking"
    log_prerequisites = "Requires firewall or network perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Firewalls must see east-west traffic (internal segmentation or datacenter firewalls)."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Administrators SSHing between servers, jump hosts and bastions not yet in the allowlist, configuration management and orchestration (Ansible-style SSH push), backup and monitoring systems using SSH, SFTP/rsync-over-SSH jobs, vulnerability scanners."
    tuning_guidance = "Add bastion, jump host, automation and monitoring source addresses to %global_allowed_mgmt_sources. Add authorised scanner sources to %global_allowed_scanners. Add named automation hosts or service identities to %global_allowed_service_accounts. The internal-target check uses only the standard private ranges. If the firewall sees only north-south traffic, deploy on an internal segmentation firewall instead."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 22 or $net.target.port = 23)
    (
      net.ip_in_range_cidr($net.target.ip, "10.0.0.0/8") or
      net.ip_in_range_cidr($net.target.ip, "172.16.0.0/12") or
      net.ip_in_range_cidr($net.target.ip, "192.168.0.0/16")
    )
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1563")
    $primary_entity = array_distinct($net.principal.ip)
    $target_hosts = array_distinct($net.target.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
