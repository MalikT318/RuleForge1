/*
  MITRE Technique : T1136 - Create Account
  Tactic(s)       : Persistence
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:07:01.306921+00:00
  Reference       : https://attack.mitre.org/techniques/T1136
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_IaaS_Rapid_Account_Creation_By_Single_Principal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single cloud identity created three or more user accounts within ten minutes. Creating one account is routine, but several created in quick succession by one principal suggests an adversary or compromised credential establishing secondary persistent access in the cloud tenant."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136"
    mitre_technique_name = "Create Account"
    log_prerequisites = "Cloud control-plane audit logs (identity and account management API activity) ingested and normalised to UDM USER_CREATION events with principal.user.userid populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Automated onboarding or joiner workflows, identity federation or SCIM provisioning, infrastructure-as-code pipelines creating service identities, bulk user imports by administrators, and tenant migration projects."
    tuning_guidance = "Add provisioning automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named onboarding administrators to %global_allowed_admin_users. Raise the #acct threshold for tenants with high joiner volumes. Risk score rises automatically when 10 or more distinct accounts are created."

  events:
    $acct.metadata.event_type = "USER_CREATION"
    $acct.principal.user.userid = $actor
    $acct.principal.user.userid != ""
    $acct.target.user.userid != ""
    not $acct.principal.user.userid in %global_allowed_service_accounts
    not $acct.principal.user.userid in %global_allowed_cloud_principals
    not $acct.principal.user.userid in %global_allowed_admin_users

  match:
    $actor over 10m

  outcome:
    $account_count = count_distinct($acct.target.user.userid)
    $risk_score = if($account_count >= 10, 90, 65)
    $mitre_technique_id = array_distinct("T1136")
    $primary_entity = array_distinct($acct.principal.user.userid)
    $created_accounts = array_distinct($acct.target.user.userid)
    $source_ips = array_distinct($acct.principal.ip)

  condition:
    #acct >= 3
}
