/*
  MITRE Technique : T1003 - OS Credential Dumping
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:35:41.176128+00:00
  Reference       : https://attack.mitre.org/techniques/T1003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_Linux_Credential_File_Read_Then_Staging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A non-standard process reads a Linux credential store (shadow, gshadow, opasswd, Kerberos keytab, SSSD secrets) and, within ten minutes, a file with a credential-themed name is created in a world-writable staging directory (/tmp, /var/tmp, /dev/shm) on the same host. This sequence indicates credential harvesting followed by staging for exfiltration or offline cracking. It is based on file telemetry rather than process command lines."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003"
    mitre_technique_name = "OS Credential Dumping"
    log_prerequisites = "Requires Linux EDR or auditd file telemetry that includes file read events (for example auditd watches on /etc/shadow) and file creation events, with the acting process path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup agents reading /etc/shadow, configuration management or compliance scanners (CIS audits), password-policy auditing tools, admins copying account files during migrations, and identity agents such as SSSD or realmd."
    tuning_guidance = "Add legitimate readers to %global_allowed_backup_processes, %global_allowed_security_tools, or %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Extend the process-name exclusion regex for local PAM or authentication daemons that read credential files in your environment."

  events:
    $read.metadata.event_type = "FILE_READ"
    $read.target.file.full_path = /^\/(etc\/(shadow|gshadow|security\/opasswd|krb5\.keytab)|var\/lib\/sss\/secrets\/secrets\.ldb)$/ nocase
    not $read.principal.process.file.full_path = /\/(passwd|chpasswd|chage|useradd|usermod|userdel|groupadd|vipw|pwck|grpck|unix_chkpwd|sshd|login|su|sudo|sudoedit|polkitd|cron|crond|systemd|systemd-logind|nscd|sssd|sssd_pam|dovecot)$/ nocase
    not $read.principal.process.file.full_path in %global_allowed_backup_processes
    not $read.principal.process.file.full_path in %global_allowed_security_tools
    not $read.principal.process.file.full_path in %global_allowed_admin_tools
    not $read.principal.user.userid in %global_allowed_service_accounts
    $read.principal.hostname = $hostname

    $stage.metadata.event_type = "FILE_CREATION"
    $stage.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.*(shadow|passwd|hash|cred|dump|secret|keytab)/ nocase
    not $stage.principal.process.file.full_path in %global_allowed_backup_processes
    not $stage.principal.process.file.full_path in %global_allowed_security_tools
    not $stage.principal.process.file.full_path in %global_allowed_admin_tools
    not $stage.principal.user.userid in %global_allowed_service_accounts
    $stage.principal.hostname = $hostname

    $read.metadata.event_timestamp.seconds <= $stage.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1003")
    $primary_entity = array_distinct($read.principal.hostname)
    $credential_files_read = array_distinct($read.target.file.full_path)
    $reading_processes = array_distinct($read.principal.process.file.full_path)
    $staged_files = array_distinct($stage.target.file.full_path)
    $acting_users = array_distinct($read.principal.user.userid)
    $read_count = count($read.metadata.id)
    $stage_count = count($stage.metadata.id)

  condition:
    $read and $stage
}
