/*
  MITRE Technique : T1213.005 - Messaging Applications
  Tactic(s)       : Collection
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:28:53.249528+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_005_Collab_Chat_Tenant_Setting_Broadened {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a tenant-level configuration change to the team chat and messaging service covering external or federated access, guest access, app permission or sideloading policy, or messaging policy. An adversary with a compromised administrator account can use these changes to expose chat content, such as credentials, source code snippets, internal links and incident response discussions, to external users or third-party apps. This rule detects the resulting setting state change rather than any command line."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.005"
    mitre_technique_name = "Data from Information Repositories: Messaging Applications"
    log_prerequisites = "Requires unified audit log ingestion for the collaboration suite, with admin and configuration operations normalised to SETTING_MODIFICATION and the operation name populated in metadata.product_event_type."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Planned tenant configuration changes by collaboration administrators, onboarding of partner organisations (federation or guest access), approved app deployments, and automated policy-management workflows."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation identities to %global_allowed_service_accounts. If the client's operation names differ, adjust the product_event_type regex. Correlate with a preceding anomalous sign-in for the same user to raise confidence."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(teams?|chat|messaging).*(config|setting|polic)|(federation|externalaccess|guestaccess|sideload)/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1213.005")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $operation_names = array_distinct($setting.metadata.product_event_type)
    $changed_resource = array_distinct($setting.target.resource.name)
    $source_ips = array_distinct($setting.principal.ip)

  condition:
    $setting
}
