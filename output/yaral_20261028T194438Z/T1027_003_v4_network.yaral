/*
  MITRE Technique : T1027.003 - Steganography
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:42:10.180866+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_003_Script_Host_Fetches_Image_Over_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a scripting interpreter or living-off-the-land binary (or a script-engine user agent) retrieving an image file (png, jpg, bmp, gif) from an external host over HTTP. Interpreters rarely need images, and this is the network-side pattern of steganographic payload staging, where code is hidden in image pixels and decoded in memory (for example Invoke-PSImage-style loaders)."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.003"
    mitre_technique_name = "Obfuscated Files or Information: Steganography"
    log_prerequisites = "Requires endpoint network telemetry that populates the originating process (EDR/Sysmon network events) or HTTP telemetry with URL and user agent, such as a proxy or EDR HTTP inspection, normalised to UDM NETWORK_HTTP."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin scripts downloading logos or icons for deployment packages, software installers run through PowerShell that fetch branding images, and wallpaper or lock-screen management scripts. Legitimate update checks from rundll32 or msiexec fetching image resources are also possible."
    tuning_guidance = "Add known-good CDN and vendor domains to %global_allowed_domains. Add approved automation and deployment parent or host processes to %global_allowed_script_hosts. Add approved IT tooling to %global_allowed_admin_tools. Populate %rfc1918_internal with the internal address space. Raise severity if the same host also shows encoded PowerShell execution."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\.(png|jpe?g|bmp|gif)(\?.*)?$/ nocase
    (
      $net.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|msiexec)\.exe$/ nocase or
      $net.network.http.user_agent = /(WindowsPowerShell|PowerShell|Microsoft BITS|CertUtil|WinHttp-Autoproxy|Windows Script Host)/ nocase
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_script_hosts
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1027.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $requested_urls = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)
    $source_processes = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
