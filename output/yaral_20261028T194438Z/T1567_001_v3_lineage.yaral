/*
  MITRE Technique : T1567.001 - Exfiltration to Code Repository
  Tactic(s)       : Exfiltration
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:55:52.176263+00:00
  Reference       : https://attack.mitre.org/techniques/T1567/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_001_ESXi_Mgmt_Daemon_Spawns_Transfer_Tool {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi management or web-facing daemon (hostd, vpxa, rhttpproxy, sfcbd, openwsman and similar) spawning a shell, script interpreter or transfer utility whose command line references an outbound HTTP(S) URL or upload or form-post flags. Management daemons do not normally launch interactive or transfer tooling, so this lineage points to exploitation of a management service or a hijacked session being used to push host data to an external code-hosting or repository API. The rule pivots on the parent-child relationship and does not match any repository domain."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567.001"
    mitre_technique_name = "Exfiltration Over Web Service: Exfiltration to Code Repository"
    log_prerequisites = "ESXi shell and hostd logs forwarded to Chronicle and parsed so that process launches carry parent and child process paths. Lineage fields must be populated by the parser."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Vendor or backup plug-ins invoked through hostd that use curl or python for legitimate HTTP calls; approved host-profile or remediation scripts launched by the management agent; lifecycle or patching tooling that downloads bundles over HTTPS; support-bundle upload workflows run by an administrator."
    tuning_guidance = "Add approved parent daemons or hosts to %global_allowed_script_hosts. Add sanctioned patching or backup utilities to %global_allowed_admin_tools or %global_allowed_backup_processes. Add automation accounts to %global_allowed_service_accounts. Review the parent path regex for daemons specific to your build."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(hostd|hostd-worker|vpxa|rhttpproxy|sfcbd|sfcb-[a-z]+|openwsmand|vmware-fdm|vsanmgmtd|vvold|lighttpd|nginx|envoy)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|ash|bash|dash|python[0-9.]*|perl|curl|wget|nc)$/ nocase
    $proc.target.process.command_line = /(https?:\/\/|--upload-file|--data-binary|--data-raw|\s-T\s|\s-F\s)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1567.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
