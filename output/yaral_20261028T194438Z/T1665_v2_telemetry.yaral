/*
  MITRE Technique : T1665 - Hide Infrastructure
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:04:41.206623+00:00
  Reference       : https://attack.mitre.org/techniques/T1665
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1665_ESXi_Proxy_Tunnel_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a configuration change on an ESXi host that creates or alters proxy, reverse-proxy, tunnel, port-forward or outbound firewall ruleset settings. Adversaries use these to turn a hypervisor into a relay that hides the true C2 infrastructure. Detection is based on the resulting setting state change, not on command-line text, so it still fires if shell command logging is evaded."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1665"
    mitre_technique_name = "Hide Infrastructure"
    log_prerequisites = "ESXi hostd and shell configuration-change logs ingested and parsed into UDM SETTING_MODIFICATION events with target.resource.name populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Planned changes by virtualization admins (enabling a proxy for patch or update downloads, enabling firewall rulesets for NTP, syslog or backup agents), configuration management or host profile remediation, and vendor support sessions."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Review the setting name in $changed_setting to refine the regex if a client legitimately uses a proxy for updates."

  events:
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.target.resource.name = /(http.?proxy|reverse.?proxy|socks|tunnel|port.?forward|port.?proxy|proxy\.(host|port|url|server)|firewall.*(ruleset|allowedall|outbound))/ nocase
    not $cfg.principal.user.userid in %global_allowed_admin_users
    not $cfg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1665")
    $primary_entity = array_distinct(strings.coalesce($cfg.principal.hostname, $cfg.target.hostname))
    $changed_setting = array_distinct($cfg.target.resource.name)
    $acting_user = array_distinct($cfg.principal.user.userid)

  condition:
    $cfg
}
