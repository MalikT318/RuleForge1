/*
  MITRE Technique : T1542.002 - Component Firmware
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:44:36.571631+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_002_Unexpected_Parent_Spawns_Firmware_Tooling {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office application, web server, print spooler, or database service spawning a shell or script interpreter whose command line contains firmware flashing or update operations (firmware download/commit/activate, microcode download, flash). Legitimate component firmware updates are run by vendor updaters or admin tooling, not by these parents. This lineage suggests exploitation or a malicious document or web shell attempting to tamper with component firmware (disk, NIC, controller) for persistence."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.002"
    mitre_technique_name = "Pre-OS Boot: Component Firmware"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Database or web-hosted management consoles that legitimately shell out to run vendor firmware or hardware inventory scripts (storage or RAID management plug-ins, OEM update portals), Office macros in IT-built hardware inventory workbooks, and print-spooler-hosted vendor driver or firmware utilities for printers."
    tuning_guidance = "Add approved parent binaries (vendor updaters, patching and deployment agents) to %global_allowed_admin_tools. Add sanctioned script-launching parents or hosts to %global_allowed_script_hosts. Add named firmware administrators to %global_allowed_admin_users. If a database or web application is known to run firmware tooling legitimately, allowlist that specific parent path rather than loosening the command-line regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|w3wp|httpd|nginx|tomcat\d*|php-cgi|spoolsv|sqlservr|mysqld|postgres|oracle)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|wmic)\.exe$/ nocase
    $proc.target.process.command_line = /(firmware|\bfw[-_ ]?(download|commit|update|activate|image)\b|flashfw|downloadmicrocode|\bflash(er)?\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1542.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
