/*
  MITRE Technique : T1552.004 - Private Keys
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:51:45.367350+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_004_NetDevice_Outbound_KeyExport_Transfer_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single network device or management-plane source makes repeated outbound file-transfer connections (TFTP, FTP, FTPS, SSH/SCP/SFTP) to external destinations within ten minutes. This is the network-observable result of exporting private keys or PKI material (for example a CLI crypto export to a remote server) and sending it off the device. One transfer is benign; repeated transfers to external hosts in a short window are not."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.004"
    mitre_technique_name = "Unsecured Credentials: Private Keys"
    log_prerequisites = "Firewall or perimeter connection logs that record the device or management source address, destination address and destination port (UDM NETWORK_CONNECTION). The network device's own management-plane traffic must traverse or be logged by the perimeter."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Scheduled configuration or certificate backups to an off-site server, firmware or image transfers to a vendor or cloud repository, managed-service tooling pulling configs, and monitoring or automation hosts that use SCP or SFTP externally."
    tuning_guidance = "Add approved backup, config-management and automation source addresses to %global_allowed_mgmt_sources. Raise the #net threshold in noisy environments. If only the device IP is logged, confirm principal.ip identifies the device and not a NAT gateway. This rule cannot see the key content, so correlate hits with management-plane syslog for export commands."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 69 or $net.target.port = 21 or $net.target.port = 990 or $net.target.port = 22)
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    $net.principal.ip = $src_ip

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1552.004")
    $primary_entity = array_distinct($src_ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 3
}
