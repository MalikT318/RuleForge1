/*
  MITRE Technique : T1030 - Data Transfer Size Limits
  Tactic(s)       : Exfiltration
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:52:08.274862+00:00
  Reference       : https://attack.mitre.org/techniques/T1030
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1030_Linux_Throttled_Upload_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an outbound network connection to an external destination initiated by a Linux command-line transfer client (curl or wget) whose command line combines an explicit bandwidth or rate limit with an upload or POST option. Rate-limited uploads are a network-side indicator of data transfer size limits, where an adversary throttles exfiltration to stay under volumetric alert thresholds."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1030"
    mitre_technique_name = "Data Transfer Size Limits"
    log_prerequisites = "Requires Linux EDR or auditd network telemetry that normalises to NETWORK_CONNECTION and populates principal.process.command_line and principal.process.file.full_path. Reference lists %rfc1918_internal, %global_allowed_admin_tools and %global_allowed_domains must exist in the tenant."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup or log-shipping scripts that throttle uploads to avoid saturating WAN links, CI/CD artifact publishers, administrators uploading large files over constrained links, and software vendors' telemetry or support-bundle uploaders."
    tuning_guidance = "Add approved backup, deployment and artifact-upload tooling to %global_allowed_admin_tools. Add known-good vendor or storage endpoints to %global_allowed_domains. If the EDR does not populate principal.process.command_line on network events, pair this rule with a PROCESS_LAUNCH variant. Review $command_lines in the outcome to separate legitimate throttled jobs from ad hoc operator activity."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(curl|wget)$/ nocase
    $net.principal.process.command_line = /--limit-rate|--max-rate/ nocase
    $net.principal.process.command_line = /(--upload-file|--data-binary|--post-file|--post-data|--form|\s-T\s|\s-F\s|\s-d\s*@)/
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1030")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $user = array_distinct($net.principal.user.userid)
    $command_lines = array_distinct($net.principal.process.command_line)

  condition:
    $net
}
