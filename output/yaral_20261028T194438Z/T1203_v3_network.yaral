/*
  MITRE Technique : T1203 - Exploitation for Client Execution
  Tactic(s)       : Execution
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:55:48.738961+00:00
  Reference       : https://attack.mitre.org/techniques/T1203
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1203_Office_Client_Retrieves_Executable_Content_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office or document-client HTTP user agent requesting executable or script-type content (PE, HTA, script, installer, shortcut) from an external destination. This network pattern is characteristic of a document or client-application exploit retrieving a second-stage payload, because Office clients do not normally download executable content directly. Detection is based on user-agent class and requested content type, so it does not depend on specific hosts, tools or payload strings."
    mitre_tactic = "Execution"
    mitre_technique = "T1203"
    mitre_technique_name = "Exploitation for Client Execution"
    log_prerequisites = "Requires forward-proxy or TLS-inspecting perimeter firewall logs that populate network.http.user_agent and target.url (normalised to NETWORK_HTTP). Plain-TCP firewall logs without HTTP visibility will not trigger this rule."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Office add-ins or macros that legitimately download installers or scripts from vendor sites, IT-managed Office deployment or update tooling, line-of-business document workflows that link to .exe/.msi/.jar assets, and security sandboxes that detonate documents."
    tuning_guidance = "Add known-good vendor and CDN domains to %global_allowed_domains (matched against target.hostname). Internal destinations are excluded through %rfc1918_internal. If the proxy does not populate principal.hostname, map the client identity during parsing so $primary_entity is populated. Narrow or extend the user-agent and extension regexes per client environment."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /(microsoft office|ms-office|msoffice|\b(winword|excel|powerpnt|outlook|onenote|visio)\b|microsoft (word|excel|powerpoint|outlook))/ nocase
    $net.target.url = /\.(exe|dll|scr|hta|sct|msi|jar|vbs|vbe|jse?|wsf|ps1|bat|cmd|lnk|cpl)(\?.*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1203")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
