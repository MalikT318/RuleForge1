/*
  MITRE Technique : T1546.010 - AppInit DLLs
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:12:52.371564+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_010_AppInit_DLLs_Registry_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry modification to the AppInit_DLLs value, or to the LoadAppInit_DLLs / RequireSignedAppInit_DLLs controls, under the Windows NT CurrentVersion Windows key (including the Wow6432Node view). Writing these values causes user32.dll to load an arbitrary DLL into nearly every GUI process, giving persistence and privilege escalation. Detection is on the resulting registry state change, not on the command line, so it fires whether the change is made by reg.exe, PowerShell, WMI, a custom binary or direct API calls."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.010"
    mitre_technique_name = "Event Triggered Execution: AppInit DLLs"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR registry-write events or Sysmon Event ID 13) normalised to UDM REGISTRY_MODIFICATION with target.registry.registry_key and target.registry.registry_value_name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy third-party software (older accessibility, screen-reader, overlay, graphics-utility or DRM products) that legitimately registers an AppInit DLL; software installers and uninstallers that reset the value to empty; endpoint security agents that manage these values; administrators applying hardening that sets LoadAppInit_DLLs to 0 or RequireSignedAppInit_DLLs to 1."
    tuning_guidance = "Add approved installers or management binaries to %global_allowed_admin_tools and security agents to %global_allowed_security_tools (matched on the writing process path). Hardening changes that disable AppInit loading or enable signature enforcement are benign and can be filtered in the SOAR playbook by inspecting registry_value_data. The rule can be narrowed to AppInit_DLLs only if LoadAppInit_DLLs noise is high. Modern Windows with Secure Boot disables AppInit loading, but the write is still a strong tampering indicator."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Microsoft\\Windows NT\\CurrentVersion\\Windows$/ nocase
    $reg.target.registry.registry_value_name = /^(AppInit_DLLs|LoadAppInit_DLLs|RequireSignedAppInit_DLLs)$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1546.010")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
