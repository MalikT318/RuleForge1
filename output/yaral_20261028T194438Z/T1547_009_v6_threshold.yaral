/*
  MITRE Technique : T1547.009 - Shortcut Modification
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:36:29.072100+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_009_Startup_Folder_Shortcut_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several shortcut (.lnk/.url) files are created in Windows Startup folders on a single host within ten minutes. One shortcut is routine; a burst suggests scripted persistence placement or a payload dropping multiple autostart shortcuts."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.009"
    mitre_technique_name = "Boot or Logon Autostart Execution: Shortcut Modification"
    log_prerequisites = "Requires EDR file telemetry or Sysmon Event ID 11 (FileCreate) normalised to UDM FILE_CREATION with target.file.full_path and principal.process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters adding Startup shortcuts, golden-image or profile provisioning, user profile first-logon setup, RMM or software deployment agents, and roaming-profile or folder-redirection sync."
    tuning_guidance = "Add approved deployment and installer tooling to %global_allowed_admin_tools, and EDR/AV agents to %global_allowed_security_tools. Raise the #file threshold on hosts used for imaging or profile provisioning. The rule counts creations in both per-user and All Users Startup folders."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\[^\\]+\.(lnk|url)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $event_count = count($file.metadata.id)
    $risk_score = max(if($event_count >= 10, 85, if($event_count >= 5, 70, 55)))
    $mitre_technique_id = array_distinct("T1547.009")
    $primary_entity = array_distinct($host)
    $shortcut_paths = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $affected_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
