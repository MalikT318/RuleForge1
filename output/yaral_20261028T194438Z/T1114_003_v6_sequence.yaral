/*
  MITRE Technique : T1114.003 - Email Forwarding Rule
  Tactic(s)       : Collection
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:22:25.016018+00:00
  Reference       : https://attack.mitre.org/techniques/T1114/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_003_Linux_Mail_Forward_Config_Then_Rebuild {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Linux mail forwarding or alias configuration file (/etc/aliases, Postfix virtual/canonical/BCC maps, ~/.forward, .procmailrc, Sieve scripts) being modified, followed within ten minutes on the same host by a mail map rebuild utility (newaliases, postalias, postmap). The sequence indicates a forwarding rule was created and activated to collect a victim's mail."
    mitre_tactic = "Collection"
    mitre_technique = "T1114.003"
    mitre_technique_name = "Email Collection: Email Forwarding Rule"
    log_prerequisites = "Requires Linux EDR or auditd file-modification telemetry (file watches on /etc/aliases, /etc/postfix and home directories) and process launch telemetry with full executable paths and command lines."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Mail administrators editing aliases or virtual maps, configuration management (Ansible, Puppet, Chef) pushing mail configuration, package installs or upgrades of MTAs, users legitimately setting a vacation or forward file."
    tuning_guidance = "Add approved configuration management and admin tooling to %global_allowed_admin_tools, and automation or mail service accounts to %global_allowed_service_accounts. Add named mail administrators to %global_allowed_admin_users. Package-manager exclusions are by executable name in the rule body."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /(^\/etc\/aliases$|^\/etc\/mail\/aliases$|^\/etc\/postfix\/(virtual|canonical|recipient_bcc|sender_bcc|recipient_canonical)[^\/]*$|\/\.forward$|\/\.procmailrc$|\/\.dovecot\.sieve$|\/sieve\/[^\/]+\.sieve$)/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|yum|dnf|unattended-upgrade)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(newaliases|postalias|postmap)$/ nocase
    not $proc.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|yum|dnf|unattended-upgrade)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1114.003")
    $primary_entity = array_distinct($hostname)
    $modified_files = array_distinct($file.target.file.full_path)
    $modifying_processes = array_distinct($file.principal.process.file.full_path)
    $modifying_users = array_distinct($file.principal.user.userid)
    $rebuild_commands = array_distinct($proc.target.process.command_line)
    $file_event_count = count($file.metadata.id)

  condition:
    $file and $proc
}
