/*
  MITRE Technique : T1553.006 - Code Signing Policy Modification
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:09:41.096755+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_006_Code_Integrity_Registry_Policy_Tamper {
  // Note: the "alternate platform" angle conflicts with the mandatory Windows target.
  // The Windows requirement takes precedence, so this variant pivots on the registry
  // mechanism (CI, HVCI and WinTrust policy keys) instead of bcdedit or boot options.
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modification of Windows code-integrity and signature-verification policy settings: Hypervisor-Enforced Code Integrity (HVCI), the vulnerable driver blocklist, and the WinTrust Authenticode verification state. Tampering with these settings lets unsigned or vulnerable drivers and code run."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.006"
    mitre_technique_name = "Subvert Trust Controls: Code Signing Policy Modification"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event IDs 12/13/14 or equivalent) covering HKLM\\SYSTEM\\CurrentControlSet\\Control\\CI, DeviceGuard and WinTrust keys."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or GPO and MDM baselines toggling HVCI or the driver blocklist, OS servicing and feature updates, driver or developer test workstations, security agent installers adjusting Device Guard settings."
    tuning_guidance = "Add approved deployment and baseline tooling to %global_allowed_admin_tools and security agents to %global_allowed_security_tools. Add change-management accounts to %global_allowed_admin_users. Consider scoping out developer or driver-test hosts by excluding them via %global_allowed_script_hosts."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      (
        $reg.target.registry.registry_key = /\\Control\\DeviceGuard\\Scenarios\\HypervisorEnforcedCodeIntegrity/ nocase and
        $reg.target.registry.registry_value_name = /^Enabled$/ nocase
      ) or
      (
        $reg.target.registry.registry_key = /\\Control\\CI\\Config/ nocase and
        $reg.target.registry.registry_value_name = /^VulnerableDriverBlocklistEnable$/ nocase
      ) or
      (
        $reg.target.registry.registry_key = /\\WinTrust\\Trust Providers\\Software Publishing/ nocase and
        $reg.target.registry.registry_value_name = /^State$/ nocase
      )
    )
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|MsMpEng|MsSense|SenseIR)\.exe$/ nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1553.006")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $modified_value = array_distinct($reg.target.registry.registry_value_name)
    $actor_process = array_distinct($reg.principal.process.file.full_path)
    $actor_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
