/*
  MITRE Technique : T1548 - Abuse Elevation Control Mechanism
  Tactic(s)       : Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:27:01.630044+00:00
  Reference       : https://attack.mitre.org/techniques/T1548
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_Linux_Service_Parent_Spawns_Elevation_Binary {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server, or database service process directly launching a privilege elevation binary (sudo, su, pkexec, doas). Server daemons do not normally invoke these binaries. This lineage usually means a web shell, injected code, or a compromised service account is trying to abuse elevation control mechanisms such as sudoers misconfigurations or SUID helpers. Detection uses process lineage only (parent and child image paths), not command-line content."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548"
    mitre_technique_name = "Abuse Elevation Control Mechanism"
    log_prerequisites = "Linux endpoint process-creation telemetry (EDR or auditd execve records) with parent and child process image paths populated in UDM."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legacy admin panels or deployment hooks that run sudo from a web or application service. Database maintenance jobs or backup wrappers launched by a database daemon that call sudo or su. Configuration-management agents that run under a service parent."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools. Add known service accounts that legitimately use sudo to %global_allowed_service_accounts. Extend the parent regex with customer-specific daemon names if needed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|php-fpm[0-9.]*|lighttpd|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|tomcat[0-9]*|node)$/ nocase
    $proc.target.process.file.full_path = /\/(sudo|su|pkexec|doas)$/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1548")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
