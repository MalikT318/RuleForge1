/*
  MITRE Technique : T1030 - Data Transfer Size Limits
  Tactic(s)       : Exfiltration
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:52:45.066859+00:00
  Reference       : https://attack.mitre.org/techniques/T1030
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1030_Fixed_Size_Chunked_Egress_Same_Destination {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a single internal source sending repeated outbound transfers of identical byte size to the same external destination within 10 minutes. This is consistent with data exfiltration in fixed-size chunks to stay under transfer-size alert thresholds. Uses only network-observable fields."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1030"
    mitre_technique_name = "Data Transfer Size Limits"
    log_prerequisites = "Firewall, proxy or perimeter flow logs normalised to UDM NETWORK_FLOW with principal.ip, target.ip and network.sent_bytes populated. Egress traffic must be logged with per-session byte counts."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Heartbeat or telemetry beacons with fixed payload size, backup or sync agents uploading fixed-size blocks, NTP or monitoring agents, and software update or cloud storage clients using fixed chunk uploads."
    tuning_guidance = "Add known-good external destinations to %global_allowed_domains, and approved internal sources (scanners, management hosts) to %global_allowed_scanners or %global_allowed_mgmt_sources. Adjust the sent_bytes band (1KB-5MB) and the #a/#b repeat counts to match client egress baselines. Raise the minimum for noisy environments."

  events:
    $a.metadata.event_type = "NETWORK_FLOW"
    $a.network.sent_bytes >= 1024
    $a.network.sent_bytes <= 5242880
    $a.principal.ip = $src
    $a.target.ip = $dst
    $a.network.sent_bytes = $bytes
    not $a.target.ip in %rfc1918_internal
    not $a.target.hostname in %global_allowed_domains
    not $a.principal.ip in %global_allowed_scanners
    not $a.principal.ip in %global_allowed_mgmt_sources

    $b.metadata.event_type = "NETWORK_FLOW"
    $b.network.sent_bytes >= 1024
    $b.network.sent_bytes <= 5242880
    $b.principal.ip = $src
    $b.target.ip = $dst
    $b.network.sent_bytes = $bytes
    not $b.target.ip in %rfc1918_internal
    not $b.target.hostname in %global_allowed_domains
    not $b.principal.ip in %global_allowed_scanners
    not $b.principal.ip in %global_allowed_mgmt_sources

    $a.metadata.id != $b.metadata.id
    $a.metadata.event_timestamp.seconds <= $b.metadata.event_timestamp.seconds

  match:
    $src, $dst, $bytes over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1030")
    $primary_entity = array_distinct($src)
    $destination_ips = array_distinct($dst)
    $chunk_size_bytes = max($a.network.sent_bytes)
    $chunk_count = count($a.metadata.id)
    $destination_ports = array_distinct($a.target.port)
    $first_seen = min($a.metadata.event_timestamp.seconds)
    $last_seen = max($b.metadata.event_timestamp.seconds)

  condition:
    #a >= 3 and #b >= 3
}
