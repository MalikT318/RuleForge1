/*
  MITRE Technique : T1127.001 - MSBuild
  Tactic(s)       : Stealth, Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:37:12.310922+00:00
  Reference       : https://attack.mitre.org/techniques/T1127/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1127_001_MSBuild_ProjectDrop_Then_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A non-build process writes an MSBuild project file (.proj, .csproj, .vbproj, .targets, .tasks, .props) to a user-writable location, then MSBuild.exe makes an outbound connection to an external address on the same host within 10 minutes. This pattern fits inline-task abuse, where MSBuild compiles and runs attacker code and then performs C2 or payload retrieval. The rule uses file-creation and network telemetry, not process command lines."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1127.001"
    mitre_technique_name = "Trusted Developer Utilities Proxy Execution: MSBuild"
    log_prerequisites = "Requires endpoint FILE_CREATION telemetry with file path and writing process, plus NETWORK_CONNECTION telemetry with the initiating process path and destination IP (EDR or Sysmon Event IDs 11 and 3)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developer workstations and build servers where IDEs, NuGet or package restore, or CI agents drop project files and MSBuild restores packages from external feeds. Software installers that stage .targets or .props files in Temp. RMM or deployment tooling that builds code on endpoints."
    tuning_guidance = "Add approved build, deployment or RMM tooling to %global_allowed_admin_tools, and approved build or developer hosts to %global_allowed_script_hosts. Add known package-feed domains to %global_allowed_domains if the destination domain is populated in your telemetry. Consider scoping the rule out of developer or build-server host groups in the client deployment."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(temp|appdata|programdata|users\\public|downloads|perflogs)\\.*\.(proj|csproj|vbproj|targets|tasks|props)$/ nocase
    not $file.principal.process.file.full_path = /\\(msbuild|devenv|vbcscompiler|dotnet|msiexec|nuget|vshub|servicehub\.[a-z]+)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.hostname in %global_allowed_script_hosts
    $file.principal.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\msbuild\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    $net.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1127.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $project_files = array_distinct($file.target.file.full_path)
    $dropper_processes = array_distinct($file.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $file and $net
}
