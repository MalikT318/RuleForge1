/*
  MITRE Technique : T1547.003 - Time Providers
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:27:44.785018+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_003_TimeProvider_DllName_Registry_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a write to the DllName value under a W32Time TimeProviders subkey that points to anything other than the stock Windows time provider DLLs. This is the registry-level mechanism for time provider persistence. T1547.003 is Windows-only, so no Linux, macOS, or cloud variant exists. This rule gives registry-based coverage that is independent of process command lines."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.003"
    mitre_technique_name = "Boot or Logon Autostart Execution: Time Providers"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR registry value-set events or Sysmon registry events) normalised to REGISTRY_MODIFICATION. Registry value data is used only to exclude the stock DLLs. If it is not populated, the rule alerts on every DllName write and the stock-DLL exclusion has no effect."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Virtualisation guest tools or third-party NTP/time-sync products (hardware clock or GPS time sources) that register their own time provider DLL; IT staff deliberately configuring a custom time provider; OS servicing that rewrites the default provider values."
    tuning_guidance = "Add approved installers or deployment tooling to %global_allowed_admin_tools and approved security agents to %global_allowed_security_tools. Extend the stock-DLL exclusion with the vetted DLL names of legitimate third-party time providers used by the client. If the EDR emits new-key registry creations separately from value sets, deploy a sibling rule on REGISTRY_CREATION."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\services\\w32time\\timeproviders\\[^\\]+$/ nocase
    $reg.target.registry.registry_value_name = /^dllname$/ nocase
    not $reg.target.registry.registry_value_data = /^(%systemroot%|[a-z]:\\windows)\\system32\\(w32time|vmictimeprovider)\.dll$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.003")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $dll_value = array_distinct($reg.target.registry.registry_value_data)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
