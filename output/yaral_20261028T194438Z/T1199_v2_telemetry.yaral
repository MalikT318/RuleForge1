/*
  MITRE Technique : T1199 - Trusted Relationship
  Tactic(s)       : Initial Access
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:48:09.546802+00:00
  Reference       : https://attack.mitre.org/techniques/T1199
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1199_OfficeSuite_Delegated_Partner_Admin_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a tenant configuration change that creates or modifies a delegated-administration or partner relationship in an Office Suite tenant. Adversaries who compromise a partner, reseller or service-provider account can add or accept delegated admin relationships to gain administrative control of the victim tenant. This rule works at the configuration-change layer (SETTING_MODIFICATION), not the command-line layer."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1199"
    mitre_technique_name = "Trusted Relationship"
    log_prerequisites = "Requires unified audit log ingestion with admin and directory configuration events normalised to SETTING_MODIFICATION, with metadata.product_event_type populated with the audit operation name."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate onboarding or offboarding of a managed service provider or reseller, planned changes to delegated admin permissions by tenant administrators, licensing or support partner changes, and automation that provisions partner relationships."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and provisioning automation to %global_allowed_service_accounts or %global_allowed_cloud_principals. Review the operation name regex against the operation names present in the client's audit feed. Correlate hits with change tickets for partner onboarding."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(add|set|update|create|accept)[a-z ]*(partner|delegation entry|delegated admin|delegated administration|admin relationship)/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1199")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $operation = array_distinct($setting.metadata.product_event_type)
    $source_ips = array_distinct($setting.principal.ip)
    $target_resource = array_distinct($setting.target.resource.name)

  condition:
    $setting
}
