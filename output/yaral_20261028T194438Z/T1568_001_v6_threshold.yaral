/*
  MITRE Technique : T1568.001 - Fast Flux DNS
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:05:10.634160+00:00
  Reference       : https://attack.mitre.org/techniques/T1568/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1568_001_FastFlux_DNS_Many_Distinct_Answers {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single Windows host repeatedly resolves the same domain within 10 minutes and receives many distinct IP addresses in the answers. Each lookup is benign on its own. A rapidly rotating answer set for one name is characteristic of single-flux DNS used to hide command and control infrastructure."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1568.001"
    mitre_technique_name = "Dynamic Resolution: Fast Flux DNS"
    log_prerequisites = "Requires Windows endpoint DNS query telemetry that includes the resolved answers (for example Sysmon Event ID 22 or EDR DNS events) normalised to UDM NETWORK_DNS with network.dns.questions.name and network.dns.answers.data populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "CDNs and global load balancers (Akamai, Cloudflare, Azure Front Door, AWS), large SaaS vendors using DNS-based load balancing, browsers and update agents resolving geo-distributed services, and peer-to-peer or content-sync software."
    tuning_guidance = "Add known-good CDN and vendor domains to %global_allowed_domains. Add noisy resolver processes (for example update agents) to %global_allowed_security_tools or %global_allowed_admin_tools. Raise the distinct-answer threshold (default 5) or the query count (default 10) in noisy environments. Review the matched domain for low domain age or algorithmically generated names."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.principal.hostname = $host
    $dns.network.dns.questions.name = $domain
    $dns.network.dns.answers.data != ""
    not $dns.network.dns.questions.name = /(?i)\.(arpa|local|lan|internal|corp|home)$/
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.process.file.full_path in %global_allowed_security_tools
    not $dns.principal.process.file.full_path in %global_allowed_admin_tools

  match:
    $host, $domain over 10m

  outcome:
    $risk_score = max(70)
    $distinct_ips = count_distinct($dns.network.dns.answers.data)
    $query_count = count($dns.metadata.id)
    $resolved_ips = array_distinct($dns.network.dns.answers.data)
    $querying_processes = array_distinct($dns.principal.process.file.full_path)
    $queried_domain = array_distinct($domain)
    $mitre_technique_id = array_distinct("T1568.001")
    $primary_entity = array_distinct($host)

  condition:
    #dns >= 10 and $distinct_ips >= 5
}
