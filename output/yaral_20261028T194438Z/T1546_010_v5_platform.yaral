/*
  MITRE Technique : T1546.010 - AppInit DLLs
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:14:03.184604+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_010_AppInit_Load_Controls_Tampered {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modification of the AppInit DLL control values (LoadAppInit_DLLs, RequireSignedAppInit_DLLs) under the Windows NT CurrentVersion Windows key, including the Wow6432Node view. Enabling AppInit loading or disabling the signature requirement is a prerequisite for AppInit DLL persistence and privilege escalation. This rule is registry-based and complements command-line process rules. AppInit_DLLs is a Windows-only mechanism, so no Linux, macOS or cloud equivalent exists and the rule targets Windows."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.010"
    mitre_technique_name = "Event Triggered Execution: AppInit DLLs"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR registry events or Sysmon Event ID 12/13) normalised to UDM REGISTRY_MODIFICATION with target.registry.registry_key and registry_value_name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy accessibility, screen-reader, or application-compatibility software that still relies on AppInit; security or endpoint hardening agents that set RequireSignedAppInit_DLLs; GPO or configuration-management baselines applying these values."
    tuning_guidance = "Add the approved modifying process path to %global_allowed_admin_tools or %global_allowed_security_tools, and approved administrator accounts to %global_allowed_admin_users. Pair with a separate rule on the AppInit_DLLs value itself if the client's EDR populates registry value data."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Microsoft\\Windows NT\\CurrentVersion\\Windows$/ nocase
    $reg.target.registry.registry_value_name = /^(LoadAppInit_DLLs|RequireSignedAppInit_DLLs)$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546.010")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_value = array_distinct($reg.target.registry.registry_value_name)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $modifying_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
