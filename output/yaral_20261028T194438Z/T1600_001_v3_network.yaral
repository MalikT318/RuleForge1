/*
  MITRE Technique : T1600.001 - Reduce Key Space
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:06:41.975089+00:00
  Reference       : https://attack.mitre.org/techniques/T1600/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_001_Weak_Cipher_Negotiated_External_Session {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an externally routed session whose negotiated TLS parameters are cryptographically weak (NULL, export-grade, anonymous, RC2/RC4, DES/3DES ciphers or SSLv2/SSLv3/TLS 1.0 protocol versions). This is the network-observable result of an adversary reducing cipher strength or key space on a compromised network device or its peers. The rule does not depend on a tool, hash or destination, only on the weakness of the negotiated parameters."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1600.001"
    mitre_technique_name = "Weaken Encryption: Reduce Key Space"
    log_prerequisites = "Firewall, proxy or perimeter logs that record the negotiated TLS version and cipher suite (for example with TLS inspection or session logging enabled), normalised to UDM network.tls.version and network.tls.cipher. Without these fields the rule will not fire."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legacy applications, embedded systems and appliances that only support old TLS versions or ciphers; third-party partner endpoints with outdated crypto configuration; authorised vulnerability scanners and crypto compliance testing; old IoT or OT equipment communicating outbound."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners and known-good legacy vendor destinations to %global_allowed_domains. Extend %rfc1918_internal if internal ranges are missing. Tighten or relax the cipher and version regex to match the client's crypto policy. Correlate hits with SETTING_MODIFICATION events on the same device for confirmation."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.network.tls.cipher = /(^|[_\-])(NULL|EXP|EXPORT|ANON|ADH|AECDH|RC2|RC4|DES|3DES)([_\-]|$)/ nocase or
      $net.network.tls.version = /(SSL\s?v?[23]|SSLv?[23](\.0)?|TLS\s?v?1\.0|TLSv?1(\.0)?$)/ nocase
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1600.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $negotiated_ciphers = array_distinct($net.network.tls.cipher)
    $tls_versions = array_distinct($net.network.tls.version)

  condition:
    $net
}
