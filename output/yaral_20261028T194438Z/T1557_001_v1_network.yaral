/*
  MITRE Technique : T1557.001 - Name Resolution Poisoning and SMB Relay
  Tactic(s)       : Credential Access, Collection
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:30:25.673946+00:00
  Reference       : https://attack.mitre.org/techniques/T1557/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1557_001_LLMNR_NBTNS_mDNS_Name_Resolution_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects LLMNR (UDP 5355), NBT-NS (UDP 137) or mDNS (UDP 5353) traffic sent to a non-internal, non-multicast destination as seen at the network perimeter. These link-local name resolution protocols should never be unicast to or routed towards external addresses. Such traffic points to name resolution poisoning or relay infrastructure, a forwarded or tunnelled responder, or a host that has been redirected to an adversary-controlled system. This covers the network side of T1557.001 and does not depend on endpoint process or command-line telemetry."
    mitre_tactic = "Credential Access, Collection"
    mitre_technique = "T1557.001"
    mitre_technique_name = "Adversary-in-the-Middle: LLMNR/NBT-NS Poisoning and SMB Relay"
    log_prerequisites = "Requires firewall or perimeter logs normalised to NETWORK_CONNECTION with principal.ip, target.ip and target.port populated, covering egress and inter-zone traffic. The reference list %rfc1918_internal must be populated for each client."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Misconfigured routers or VPN concentrators forwarding multicast or broadcast name resolution to remote sites; mDNS or NetBIOS traffic from guest or BYOD segments with non-RFC1918 addressing; legacy WAN-extended NetBIOS or WINS designs; internal address space missing from %rfc1918_internal (for example CGNAT or public-addressed internal ranges); authorised red-team or scanner activity."
    tuning_guidance = "Confirm %rfc1918_internal covers all of the client's internal and routable private space. Add approved scanner and security testing source addresses to %global_allowed_scanners and approved network management sources to %global_allowed_mgmt_sources. Multicast ranges (IPv4 224.0.0.0/4, IPv6 ff00::/8) are excluded because they are protocol constants, not tenant values. If a WAN-extended NetBIOS design is legitimate, exclude its source hosts using %global_allowed_mgmt_sources."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 5355 or
      $net.target.port = 137 or
      $net.target.port = 5353
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not net.ip_in_range_cidr($net.target.ip, "224.0.0.0/4")
    not net.ip_in_range_cidr($net.target.ip, "ff00::/8")
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1557.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
