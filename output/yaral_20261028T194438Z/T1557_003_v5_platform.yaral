/*
  MITRE Technique : T1557.003 - DHCP Spoofing
  Tactic(s)       : Credential Access, Collection
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:34:45.294772+00:00
  Reference       : https://attack.mitre.org/techniques/T1557/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1557_003_Rogue_DHCP_Server_Offer_Linux {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects DHCP server-to-client traffic (UDP source port 67 to destination port 68) from a source that is not an approved DHCP server. A rogue DHCP server, commonly a Linux host running a DHCP daemon or a purpose-built spoofing script, can hand out attacker-controlled gateway and DNS settings to place itself in an adversary-in-the-middle position. Detection is based purely on perimeter or network telemetry, so it works regardless of the process name or tool used on the rogue host."
    mitre_tactic = "Credential Access, Collection"
    mitre_technique = "T1557.003"
    mitre_technique_name = "Adversary-in-the-Middle: DHCP Spoofing"
    log_prerequisites = "Requires firewall, inter-VLAN, or network sensor logs that record internal UDP 67/68 flows with source and destination ports, normalised to UDM NETWORK_CONNECTION. Many perimeter firewalls do not see same-subnet DHCP, so use a segment-facing firewall, a relay-facing interface, or a mirrored sensor."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate DHCP servers or relay agents not yet in the allowlist, newly deployed or failover DHCP servers, network appliances (routers, wireless controllers, hypervisor or lab networks) that provide DHCP, and home or branch devices with built-in DHCP."
    tuning_guidance = "Populate %global_allowed_mgmt_sources with the IP addresses of each client's authorised DHCP servers and relay agents (this is the closest fixed-vocabulary list for permitted network infrastructure sources). Onboard each tenant's DHCP servers before enabling alerting. Where the firewall logs only inter-VLAN traffic, confirm DHCP relays are in the list."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "UDP"
    $net.principal.port = 67
    $net.target.port = 68
    $net.principal.ip != ""
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1557.003")
    $primary_entity = array_distinct($net.principal.ip)
    $rogue_server_hostname = array_distinct($net.principal.hostname)
    $client_ips = array_distinct($net.target.ip)

  condition:
    $net
}
