/*
  MITRE Technique : T1602.001 - SNMP (MIB Dump)
  Tactic(s)       : Collection
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:17:53.750650+00:00
  Reference       : https://attack.mitre.org/techniques/T1602/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_001_SNMP_MIB_Access_From_Unapproved_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects SNMP (port 161) connections to a managed device from a source that is not an approved management station or authorised scanner. Unapproved SNMP polling is the network-observable signal of MIB enumeration, used to collect device configuration, routing, interface and system data for network mapping."
    mitre_tactic = "Collection"
    mitre_technique = "T1602.001"
    mitre_technique_name = "Data from Configuration Repository: SNMP (MIB Dump)"
    log_prerequisites = "Requires firewall, perimeter or flow logs that record connection source, destination and destination port, with UDP/161 traffic permitted to be logged. Internal-segment firewalls or flow exporters give coverage of lateral SNMP polling."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Network monitoring systems (NMS), CMDB discovery and inventory tools, and vulnerability scanners that have not been added to the allowlists; newly deployed monitoring collectors; MSP or NOC monitoring probes."
    tuning_guidance = "Populate %global_allowed_mgmt_sources with the addresses of approved NMS and polling collectors, and %global_allowed_scanners with authorised scanners. If internal-to-internal noise is high, add monitoring subnets to the lists. To restrict the rule to internet-originated SNMP only, add: not $net.principal.ip in %rfc1918_internal."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 161
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1602.001")
    $primary_entity = array_distinct($net.principal.ip)
    $target_devices = array_distinct($net.target.ip)
    $target_hostnames = array_distinct($net.target.hostname)

  condition:
    $net
}
