/*
  MITRE Technique : T1547.006 - Kernel Modules and Extensions
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:33:05.741213+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_006_Linux_Kernel_Module_Autoload_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a Linux kernel module autoload configuration (modules-load.d or modprobe.d) or of a kernel module (.ko) file under /lib/modules by a process that is not a package manager or approved admin tool. These are the file-level mechanisms that make a loadable kernel module (LKM) rootkit persist across reboots. This file-creation rule complements command-line detections of insmod/modprobe."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.006"
    mitre_technique_name = "Boot or Logon Autostart Execution: Kernel Modules and Extensions"
    log_prerequisites = "Linux endpoint telemetry that records file creation events with the creating process (EDR file events, or auditd watches on /etc/modules-load.d, /etc/modprobe.d and /lib/modules normalised to UDM FILE_CREATION)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers installing kernel or driver packages, DKMS rebuilds after a kernel update, configuration management (Ansible, Puppet, Chef, Salt) deploying module configs, cloud-init or image-build tooling, administrators legitimately configuring hardware drivers (GPU, VPN, storage, hypervisor guest modules)."
    tuning_guidance = "Add approved deployment, configuration management and driver tooling binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Package manager and DKMS names are excluded by executable name. Expect noise on kernel update days and during golden-image builds."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(etc|usr\/lib|lib|run)\/(modules-load|modprobe)\.d\/[^\/]+\.conf$|^\/(usr\/)?lib\/modules\/[^\/]+\/.+\.ko(\.(xz|gz|zst))?$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|dnf|yum|zypper|pacman|dkms|cloud-init|kmod|depmod|update-initramfs|dracut|systemd-tmpfiles)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1547.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
