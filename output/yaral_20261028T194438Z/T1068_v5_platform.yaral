/*
  MITRE Technique : T1068 - Exploitation for Privilege Escalation
  Tactic(s)       : Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:54:41.635804+00:00
  Reference       : https://attack.mitre.org/techniques/T1068
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1068_Linux_Container_Escape_Host_Kernel_Interface_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects a write to a host-level kernel escape interface (cgroup release_agent, core_pattern, kernel modprobe path, uevent_helper, binfmt_misc register) as seen by container runtime or host auditd telemetry. These writes are the RESULT of successful privilege-escalation and container-escape exploitation (e.g. cgroup release_agent abuse, core_pattern host-execution tricks, privileged or host-mounted container breakout), after which attacker-controlled code runs as root on the underlying host. Detection is on the OS mechanism, not on any exploit payload or tool name."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1068"
    mitre_technique_name = "Exploitation for Privilege Escalation"
    log_prerequisites = "Requires Linux file-modification telemetry with process attribution from a container-aware EDR or auditd watch rules on /proc/sys/kernel, /sys/kernel and /sys/fs/cgroup, ingested into UDM as FILE_MODIFICATION."
    platform = "Linux"
    log_source = "container"
    false_positives = "Host bootstrap and node-provisioning agents setting core_pattern or modprobe path, crash-reporting or coredump handler installers, kernel-tuning tools run by administrators, container runtimes configuring cgroups with notify_on_release, and binfmt registration by emulation setup jobs (cross-architecture build nodes)."
    tuning_guidance = "Add approved node-provisioning, tuning and container-runtime binaries to %global_allowed_admin_tools, runtime and EDR agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Review build nodes that register binfmt handlers and exclude them via the admin tools list."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/(proc\/sys\/kernel\/(core_pattern|modprobe|hotplug)|sys\/kernel\/uevent_helper|proc\/sys\/fs\/binfmt_misc\/register|sys\/fs\/cgroup\/.*\/release_agent)$/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1068")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
