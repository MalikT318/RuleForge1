/*
  MITRE Technique : T1609 - Container Administration Command
  Tactic(s)       : Execution
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:26:57.196170+00:00
  Reference       : https://attack.mitre.org/techniques/T1609
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1609_Container_API_Pod_Exec_Attach_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a control-plane API request to the exec, attach or ephemeral-container subresource of a pod. This is the audit-log artifact of 'kubectl exec' or 'kubectl attach' and of direct API or kubelet calls that run commands inside a running container. It is detected at the API audit layer rather than from process command lines, so it still fires when in-container command logging is absent or evaded."
    mitre_tactic = "Execution"
    mitre_technique = "T1609"
    mitre_technique_name = "Container Administration Command"
    log_prerequisites = "Kubernetes API server audit logging must be enabled at Metadata level or higher, covering the pods/exec, pods/attach and pods/ephemeralcontainers subresources, and ingested into UDM as USER_RESOURCE_ACCESS with target.url populated and principal.user.userid mapped."
    platform = "Containers"
    log_source = "container"
    false_positives = "Developers and SREs debugging workloads, break-glass incident response, CI/CD or GitOps jobs running smoke tests via exec, operators and health-check tooling that exec into pods, and approved remote support tooling."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, named cluster administrators to %global_allowed_admin_users, and bastion or jump-host source addresses to %global_allowed_mgmt_sources. If exec is routine in non-production clusters, scope the rule to production clusters at deployment time, or raise severity for access to sensitive namespaces."

  events:
    $audit.metadata.event_type = "USER_RESOURCE_ACCESS"
    $audit.target.url = /\/pods\/[^\/\?]+\/(exec|attach|ephemeralcontainers)(\?|\/|$)/ nocase
    $audit.principal.user.userid != ""
    not $audit.principal.user.userid in %global_allowed_admin_users
    not $audit.principal.user.userid in %global_allowed_service_accounts
    not $audit.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1609")
    $primary_entity = array_distinct($audit.principal.user.userid)
    $source_ips = array_distinct($audit.principal.ip)
    $target_urls = array_distinct($audit.target.url)

  condition:
    $audit
}
