/*
  MITRE Technique : T1090.004 - Domain Fronting
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:32:10.544467+00:00
  Reference       : https://attack.mitre.org/techniques/T1090/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1090_004_Linux_Staged_Binary_SNI_Host_Mismatch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A file is created in a world-writable staging directory (/tmp, /var/tmp, /dev/shm) and, within 10 minutes, the same file path runs as a process making an outbound HTTPS request where the TLS SNI differs from, or is blank against, the HTTP destination host. This is the signature of domain fronting and domainless fronting from a freshly dropped implant."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1090.004"
    mitre_technique_name = "Proxy: Domain Fronting"
    log_prerequisites = "Requires Linux endpoint telemetry with FILE_CREATION events and NETWORK_HTTP events carrying process attribution, destination host, and TLS SNI (network.tls.client.server_name), for example from an EDR sensor or a TLS-inspecting proxy that is attributed to the process."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developer or CI builds that run freshly compiled binaries from /tmp against CDN-hosted APIs; package or installer scripts that download and run tools from /tmp; CDN or multi-tenant services whose Host header legitimately differs from SNI; sensors that do not populate SNI, which makes every HTTPS request look like a blank-SNI mismatch."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools, known-good destination hostnames to %global_allowed_domains, and trusted interpreter hosts to %global_allowed_script_hosts. If the sensor does not populate network.tls.client.server_name, disable this rule for that client rather than tuning it."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+/ nocase
    $file.target.file.full_path = $path
    $file.principal.hostname = $hostname
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts

    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.port = 443
    $net.principal.process.file.full_path = $path
    $net.principal.hostname = $hostname
    $net.target.hostname != ""
    $net.network.tls.client.server_name != $net.target.hostname
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1090.004")
    $primary_entity = array_distinct($hostname)
    $staged_binary = array_distinct($path)
    $http_host = array_distinct($net.target.hostname)
    $tls_sni = array_distinct($net.network.tls.client.server_name)
    $destination_ips = array_distinct($net.target.ip)
    $net_event_count = count($net.metadata.id)

  condition:
    $file and $net
}
