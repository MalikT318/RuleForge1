/*
  MITRE Technique : T1055.003 - Thread Execution Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:49:45.236647+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_003_Non_Networking_Process_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound connection to an external address from a Windows process that does not normally use the network (simple GUI utilities and core session or system processes). Thread execution hijacking places code in a live process of this kind, and the injected payload then beacons or downloads from it. This is network-side coverage that does not depend on process-creation or command-line telemetry."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.003"
    mitre_technique_name = "Process Injection: Thread Execution Hijacking"
    log_prerequisites = "Requires endpoint network telemetry that attributes each connection to the initiating process image path (EDR network events or Sysmon Event ID 3 normalised to NETWORK_CONNECTION), with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Notepad or Paint opening online help or sign-in prompts, update or telemetry callbacks from a built-in utility, security or monitoring agents injecting into system processes (for example lsass or conhost), proxy or VPN clients that make connections appear to come from another process, and application-compatibility shims."
    tuning_guidance = "Add EDR, AV and monitoring agent binaries to %global_allowed_security_tools. Add known vendor or update destinations to %global_allowed_domains. If the sensor reports proxy-routed traffic, expand %rfc1918_internal to cover the proxy addresses. To reduce noise further, remove the lower-fidelity GUI utilities from the process regex, or require repeat connections by converting the rule to a Threshold rule."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(notepad|calc|mspaint|write|wordpad|charmap|conhost|csrss|smss|wininit|winlogon|lsass|fontdrvhost)\.exe$/ nocase
    $net.principal.hostname != ""
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $affected_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
