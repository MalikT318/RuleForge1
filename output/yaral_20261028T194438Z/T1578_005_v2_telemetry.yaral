/*
  MITRE Technique : T1578.005 - Modify Cloud Compute Configurations
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:56:12.733104+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_005_Cloud_Compute_Quota_Or_Region_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a configuration change (SETTING_MODIFICATION) to cloud compute quotas, service limits or regional enablement. Adversaries raise quotas or enable unused regions to run hijacked compute (for example cryptomining) without exhausting the victim's normal limits. The rule alerts on the control-plane state change itself, not on any command line or client tool."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578.005"
    mitre_technique_name = "Modify Cloud Compute Configurations"
    log_prerequisites = "Cloud control-plane audit logs (management/admin activity events) ingested and normalised to UDM, with metadata.product_event_type and principal.user.userid populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate capacity planning and quota increase requests by cloud or platform engineering teams, planned expansion into new regions, infrastructure-as-code pipelines and landing-zone automation, and cloud provider support or account-management workflows."
    tuning_guidance = "Add approved capacity-management and IaC automation identities to %global_allowed_service_accounts, and named cloud administrators who own quota requests to %global_allowed_admin_users. Add federated automation or workload identities to %global_allowed_cloud_principals. If your environment has noisy read-style API names, narrow the product_event_type regex to write operations only."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /(RequestServiceQuotaIncrease|PutServiceQuota|ServiceQuotaIncrease|QuotaPreference|quotas\/write|quotaOverrides|EnableRegion|regionOptIn|OptInRegion|compute\.regionQuotas|compute\.projects\.setCommonInstanceMetadata)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1578.005")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_actions = array_distinct($cloud.metadata.product_event_type)
    $target_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
