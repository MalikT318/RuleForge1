/*
  MITRE Technique : T1547 - Boot or Logon Autostart Execution
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:22:50.487096+00:00
  Reference       : https://attack.mitre.org/techniques/T1547
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_Linux_Autostart_Location_Write_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of file creations in Linux boot and logon autostart locations on a single host within 10 minutes. Locations covered are systemd unit directories, init.d and rc.d, rc.local, cron directories and spools, profile.d, XDG autostart, systemd user units and ld.so.preload. One such write is routine. Several in a short window, from a process that is not a package manager or approved admin tool, indicates persistence staging."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547"
    mitre_technique_name = "Boot or Logon Autostart Execution"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules on autostart paths, normalised to FILE_CREATION with principal process and target file path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package installs and upgrades not caught by the package manager exclusion, configuration management runs (Ansible, Puppet, Chef, Salt), golden image builds and first-boot provisioning, container image builds, and administrators deploying several unit or cron files by hand."
    tuning_guidance = "Add configuration management, deployment and provisioning binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Raise the #file threshold on build or imaging hosts. Make sure auditd watches exist for the listed paths, otherwise coverage is silently reduced."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(etc\/(systemd\/system|init\.d|rc[0-6S]\.d|profile\.d|cron\.(d|daily|hourly|weekly|monthly)|xdg\/autostart)\/|(usr\/)?lib\/systemd\/system\/|var\/spool\/cron(\/crontabs)?\/|home\/[^\/]+\/\.config\/(autostart|systemd\/user)\/|root\/\.config\/(autostart|systemd\/user)\/|etc\/(rc\.local|ld\.so\.preload|crontab)$)/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|yum|dnf|zypper|snapd|pacman|apk|packagekitd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1547")
    $primary_entity = array_distinct($host)
    $autostart_paths = array_distinct($file.target.file.full_path)
    $writing_processes = array_distinct($file.principal.process.file.full_path)
    $writing_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 4
}
