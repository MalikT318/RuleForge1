/*
  MITRE Technique : T1001 - Data Obfuscation
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:03:59.353637+00:00
  Reference       : https://attack.mitre.org/techniques/T1001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_Network_Long_Encoded_HTTP_Parameter_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP requests to external destinations carrying an unusually long base64-style encoded query parameter. This is a network-side indicator of C2 data hidden inside otherwise normal web traffic (junk or encoded data in protocol fields, or an impersonated legitimate protocol). The rule uses only proxy or firewall HTTP telemetry and does not depend on process attribution."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001"
    mitre_technique_name = "Data Obfuscation"
    log_prerequisites = "Requires firewall, proxy or perimeter logs that normalise to UDM NETWORK_HTTP with target.url populated (for example a TLS-inspecting proxy or a next-generation firewall with URL logging)."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Web analytics and advertising beacons, SSO and OAuth redirects with long state or token parameters, cloud storage pre-signed URLs, software update and telemetry services, and web applications passing serialised state in query strings."
    tuning_guidance = "Add known-good destination domains (CDNs, SaaS, update services) to %global_allowed_domains. If a specific application is noisy, raise the {120,} length threshold or add its destination to the allowlist. Internal destinations are excluded via %rfc1918_internal."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(GET|POST|PUT)$/ nocase
    $http.target.url = /[?&;][A-Za-z0-9_\-]{1,32}=[A-Za-z0-9+\/_%\-]{120,}={0,2}/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1001")
    $primary_entity = array_distinct($http.principal.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $http_methods = array_distinct($http.network.http.method)

  condition:
    $http
}
