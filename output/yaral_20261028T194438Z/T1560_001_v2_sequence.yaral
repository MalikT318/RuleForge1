/*
  MITRE Technique : T1560.001 - Archive via Utility
  Tactic(s)       : Collection
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:57:34.631518+00:00
  Reference       : https://attack.mitre.org/techniques/T1560/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1560_001_Archive_Staged_Then_External_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an archive or cabinet file written to a common staging location on a Windows host, followed within ten minutes by an outbound connection to an external destination from a transfer-capable built-in binary on the same host. This pattern indicates collected data was compressed and then sent out. It relies on file-creation and network telemetry rather than archiver command lines, so it still fires when the archiving utility is renamed or is a third-party tool."
    mitre_tactic = "Collection"
    mitre_technique = "T1560.001"
    mitre_technique_name = "Archive Collected Data: Archive via Utility"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11) and network connection telemetry (Sysmon Event ID 3) with process attribution, normalised to UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and imaging jobs, software packaging and deployment, log collection scripts that zip and upload diagnostics to vendor support portals, administrators sending crash dumps or CAB files to vendors, user-initiated cloud uploads through PowerShell or curl."
    tuning_guidance = "Add approved archiving or backup processes to %global_allowed_backup_processes, approved IT tooling to %global_allowed_admin_tools and %global_allowed_remote_mgmt, and known-good vendor upload destinations to %global_allowed_domains. If the rule is too noisy, narrow the staging directory regex or the transfer binary list for the client environment."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\public|programdata|windows\\temp|perflogs|\$recycle\.bin|users\\[^\\]+\\appdata\\local\\temp|users\\[^\\]+\\appdata\\roaming)\\(.*\\)?[^\\]+\.(zip|7z|rar|cab|tar|gz|tgz|bz2|xz)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(curl|powershell|pwsh|bitsadmin|certutil|ftp|sftp|scp|ssh|cmd)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    $net.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1560.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $archive_paths = array_distinct($file.target.file.full_path)
    $archive_count = count($file.metadata.id)
    $creator_processes = array_distinct($file.principal.process.file.full_path)
    $transfer_processes = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $users = array_distinct($file.principal.user.userid)

  condition:
    $file and $net
}
