/*
  MITRE Technique : T1070.006 - Timestomp
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:07:46.627096+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_006_Linux_Staged_File_Then_Timestamp_Tamper {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a file created in a world-writable Linux staging directory (/tmp, /var/tmp, /dev/shm) that is then modified within 10 minutes by a timestamp-manipulation utility such as touch or debugfs. The creating process must be a different process from the modifier. This points to timestomping used to make a freshly dropped file blend in with older files."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.006"
    mitre_technique_name = "Indicator Removal: Timestomp"
    log_prerequisites = "Requires Linux EDR or auditd file telemetry that normalises file creation and file attribute or timestamp changes into FILE_CREATION and FILE_MODIFICATION events with the acting process populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Build and packaging jobs that touch freshly created temp files to normalise mtimes for reproducible builds, make/cmake dependency handling, installer or package-manager scripts, backup and sync tools restoring timestamps, and admins preparing test files."
    tuning_guidance = "Add approved build, deployment and patching tooling to %global_allowed_admin_tools. Add backup and restore agents to %global_allowed_backup_processes. Add CI/automation accounts to %global_allowed_service_accounts. If the telemetry does not report timestamp-only changes as FILE_MODIFICATION, the rule will not fire; verify that coverage before deploying."

  events:
    $create.metadata.event_type = "FILE_CREATION"
    $create.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    not $create.principal.process.file.full_path = /\/(touch|debugfs)$/ nocase
    not $create.principal.process.file.full_path in %global_allowed_admin_tools
    not $create.principal.process.file.full_path in %global_allowed_backup_processes
    $create.principal.hostname = $host
    $create.target.file.full_path = $path

    $mod.metadata.event_type = "FILE_MODIFICATION"
    $mod.principal.process.file.full_path = /\/(touch|debugfs)$/ nocase
    $mod.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    not $mod.principal.process.file.full_path in %global_allowed_admin_tools
    not $mod.principal.process.file.full_path in %global_allowed_backup_processes
    not $mod.principal.user.userid in %global_allowed_service_accounts
    $mod.principal.hostname = $host
    $mod.target.file.full_path = $path

    $create.metadata.event_timestamp.seconds <= $mod.metadata.event_timestamp.seconds

  match:
    $host, $path over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1070.006")
    $primary_entity = array_distinct($mod.principal.hostname)
    $tampered_files = array_distinct($mod.target.file.full_path)
    $creating_processes = array_distinct($create.principal.process.file.full_path)
    $timestamp_tools = array_distinct($mod.principal.process.file.full_path)
    $acting_users = array_distinct($mod.principal.user.userid)
    $modification_count = count($mod.metadata.id)

  condition:
    $create and $mod
}
