/*
  MITRE Technique : T1070.006 - Timestomp
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:07:28.687212+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_006_Timestomp_Creation_Time_Changed_Staging_Files {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a file creation-time change (Sysmon-style 'file creation time changed' state-change telemetry) on an executable or script file in a user-writable staging location, performed by a process that is not a known installer, sync client, or security tool. This catches $STANDARD_INFORMATION timestomping by its resulting file artifact, regardless of how the command was run."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.006"
    mitre_technique_name = "Indicator Removal: Timestomp"
    log_prerequisites = "Requires Windows endpoint telemetry that reports file creation-time changes (for example Sysmon Event ID 2 or an EDR equivalent) normalised to FILE_MODIFICATION. Without this telemetry the rule will not fire."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters that preserve original build timestamps, archive extraction tools, cloud sync clients, build and CI tooling that stamps artifacts, backup or restore agents, and admins or scripts that copy files with preserved attributes."
    tuning_guidance = "Add approved deployment and patching binaries to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, and backup/restore software to %global_allowed_backup_processes. Developer or build hosts may need the target path regex narrowed or additional parent executables excluded. If a client's telemetry does not populate metadata.product_event_type, the description match covers it."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    (
      $file.metadata.product_event_type = "2" or
      $file.metadata.description = /creation\s+time/ nocase
    )
    $file.target.file.full_path = /\.(exe|dll|sys|scr|com|ps1|psm1|bat|cmd|vbs|vbe|js|jse|hta|wsf|lnk)$/ nocase
    $file.target.file.full_path = /(\\users\\[^\\]+\\(appdata|downloads|desktop|documents)\\|\\programdata\\|\\windows\\temp\\|\\temp\\|\\users\\public\\|\\perflogs\\|\\\$recycle\.bin\\)/ nocase
    not $file.principal.process.file.full_path = /\\(OneDrive|Dropbox|GoogleDriveFS|msiexec|TrustedInstaller|TiWorker|MsMpEng|MsSense|SenseIR|wuauclt|svchost)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1070.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
