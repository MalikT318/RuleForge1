/*
  MITRE Technique : T1114.003 - Email Forwarding Rule
  Tactic(s)       : Collection
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:21:07.491980+00:00
  Reference       : https://attack.mitre.org/techniques/T1114/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_003_Mailbox_Forwarding_Rule_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of a mailbox inbox rule or mailbox-level setting that forwards, redirects or auto-forwards messages to another recipient. Adversaries use these rules to silently collect email and to keep access to a mailbox after credentials are reset."
    mitre_tactic = "Collection"
    mitre_technique = "T1114.003"
    mitre_technique_name = "Email Collection: Email Forwarding Rule"
    log_prerequisites = "Requires mailbox/Exchange admin audit logging (for example New-InboxRule, Set-InboxRule, Set-Mailbox, UpdateInboxRules) ingested and normalised to UDM. The operation name must be in metadata.product_event_type. The rule parameters (ForwardTo, RedirectTo, ForwardingSmtpAddress and similar) must be populated in security_result.description. Confirm the parser maps these fields for each client, and adjust the field if it does not."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Users forwarding mail to a personal or secondary address under an approved policy, delegated assistants who receive forwarded mail, administrators configuring shared mailboxes or migrations, mail-flow or ticketing automation that creates forwarding rules, and offboarding workflows that forward a departed user's mail to a manager."
    tuning_guidance = "Add approved automation and migration accounts to %global_allowed_service_accounts and named mailbox administrators to %global_allowed_admin_users. If the client's parser stores rule parameters in a different field, point the forwarding-parameter condition at that field. To raise fidelity for a client, add a condition for external recipient domains. Use %global_allowed_domains where the recipient domain is available as a separate field."

  events:
    $m.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"
    $m.metadata.product_event_type = /^(New-InboxRule|Set-InboxRule|UpdateInboxRules|Set-Mailbox|Enable-InboxRule)$/ nocase
    $m.security_result.description = /(ForwardTo|ForwardAsAttachmentTo|RedirectTo|ForwardingSmtpAddress|ForwardingAddress|DeliverToMailboxAndForward)/ nocase
    not $m.principal.user.userid in %global_allowed_service_accounts
    not $m.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1114.003")
    $primary_entity = array_distinct($m.principal.user.userid)
    $affected_mailbox = array_distinct($m.target.user.userid)
    $operation = array_distinct($m.metadata.product_event_type)
    $source_ip = array_distinct($m.principal.ip)

  condition:
    $m
}
