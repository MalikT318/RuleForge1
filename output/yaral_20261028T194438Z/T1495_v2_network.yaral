/*
  MITRE Technique : T1495 - Firmware Corruption
  Tactic(s)       : Impact
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:47:58.310478+00:00
  Reference       : https://attack.mitre.org/techniques/T1495
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1495_Firmware_Image_Pull_From_External_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a firmware or system image file (for example .bin, .img, .swi, .pkg, .trx, .rom) being fetched over HTTP from an external destination, where the URL path also carries firmware-related wording. Network devices and the hosts that manage them normally pull firmware from internal repositories or known vendor update domains. An unvetted external source is consistent with staging of a tampered or malicious image intended to corrupt device firmware (T1495). This is observed from the network perimeter, independent of endpoint coverage."
    mitre_tactic = "Impact"
    mitre_technique = "T1495"
    mitre_technique_name = "Firmware Corruption"
    log_prerequisites = "Requires firewall or web proxy logs normalised to UDM NETWORK_HTTP with target.url populated. TLS-inspected or cleartext HTTP traffic is needed for URL visibility."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate vendor firmware or patch downloads from domains not yet on the allowlist, administrators downloading upgrade images for planned maintenance, automated device lifecycle or zero-touch provisioning tools, and software mirrors serving .bin or .img files with firmware-like names."
    tuning_guidance = "Add approved vendor update and CDN domains to %global_allowed_domains. Add approved management or jump-host source addresses to %global_allowed_mgmt_sources. Ensure %rfc1918_internal is populated so internal repositories are excluded. Raise severity for clients where network devices have no direct internet egress by policy."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\.(bin|img|swi|pkg|trx|rom|dfu|fw)(\?.*)?$/ nocase
    $net.target.url = /(firmware|rommon|bios|flash|upgrade|sysimg|sysimage|fw[-_.]?[0-9]|boot[-_]?image)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1495")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
