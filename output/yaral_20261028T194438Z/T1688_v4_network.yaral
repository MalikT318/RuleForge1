/*
  MITRE Technique : T1688 - Safe Mode Boot
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:35:59.093153+00:00
  Reference       : https://attack.mitre.org/techniques/T1688
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1688_SafeBoot_Staging_Process_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process whose own command line manipulates Safe Mode boot settings (BCD safeboot options or the SafeBoot Minimal/Network registry keys) while it makes an outbound connection to a non-internal address. This pairs payload retrieval or C2 activity with Safe Mode staging, as seen in ransomware pre-encryption preparation. The rule observes the network side and does not depend on a process-creation event."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1688"
    mitre_technique_name = "Safe Mode Boot"
    log_prerequisites = "Requires Windows endpoint network telemetry (EDR or Sysmon Event ID 3) that populates principal.process.command_line on NETWORK_CONNECTION events. Without that field the rule will not fire."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin or deployment scripts that set safeboot for troubleshooting or driver servicing and also reach external update or management endpoints. Imaging and patching tools. Security agents that reference SafeBoot registry keys in their own command line."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools, %global_allowed_remote_mgmt, %global_allowed_script_hosts or %global_allowed_security_tools. Add known-good vendor destinations to %global_allowed_domains where target.hostname is populated."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.command_line = /(bcdedit(\.exe)?["']?\s.*\bsafeboot\b|\\Control\\SafeBoot\\(Minimal|Network)|\bsafeboot\s+(minimal|network))/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_script_hosts
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR)\.exe$/ nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1688")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $initiating_command_line = array_distinct($net.principal.process.command_line)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
