/*
  MITRE Technique : T1132.001 - Standard Encoding
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:45:18.960186+00:00
  Reference       : https://attack.mitre.org/techniques/T1132/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1132_001_Base64_Encoded_Payload_In_HTTP_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP requests to external destinations where a URL query parameter carries a very long Base64-style encoded value (100+ characters). This pattern is characteristic of C2 beaconing or data staging that hides content inside standard protocol encoding. The rule uses proxy/firewall HTTP telemetry only and does not depend on endpoint process or command-line data."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1132.001"
    mitre_technique_name = "Data Encoding: Standard Encoding"
    log_prerequisites = "Requires a proxy or perimeter firewall with URL logging (SSL inspection recommended) normalised to UDM NETWORK_HTTP with network.http and target.url populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Web analytics and advertising beacons, SSO/OAuth redirects carrying long state or token parameters, SaaS applications passing encoded session context, software update or telemetry services, and cloud storage pre-signed URLs."
    tuning_guidance = "Add known-good vendor and SaaS domains to %global_allowed_domains. Raise or lower the {100,} length threshold per client noise level. If hostname is not populated by the client's firewall, map principal.ip into the primary entity."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /[?&][^=&#]{1,40}=[A-Za-z0-9+\/_\-]{100,}(%3[dD]|=){0,3}(&|#|$)/
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1132.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $matched_urls = array_distinct($net.target.url)

  condition:
    $net
}
