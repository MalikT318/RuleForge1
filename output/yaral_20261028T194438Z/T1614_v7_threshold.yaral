/*
  MITRE Technique : T1614 - System Location Discovery
  Tactic(s)       : Discovery
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:38:30.395021+00:00
  Reference       : https://attack.mitre.org/techniques/T1614
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1614_Repeated_Geolocation_Lookup_Web_Requests {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal host makes repeated outbound HTTP requests to external URLs whose path or query contains geolocation-lookup terms (geoip, geolocation, ip lookup, country code, timezone) within ten minutes. This suggests automated IP-based system location discovery, which malware often uses to decide whether to proceed. One lookup is benign; repeated lookups from one host are not."
    mitre_tactic = "Discovery"
    mitre_technique = "T1614"
    mitre_technique_name = "System Location Discovery"
    log_prerequisites = "Requires web proxy or firewall logs with URL visibility (NETWORK_HTTP), either from TLS inspection or from explicit proxy logging, with principal.hostname and target.url populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Web applications and browsers that call geolocation or timezone APIs, SaaS tools that perform IP geolocation for sign-in or licensing, ad and analytics beacons, software updaters that check region, and developers testing geolocation services."
    tuning_guidance = "Add known-good vendor and CDN domains to %global_allowed_domains (matched against target.hostname). Raise the threshold from 5 for noisy environments. Add scanner or test sources to %global_allowed_scanners if needed."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(geo-?ip|geo-?locat|ip-?lookup|ip-?locat|country-?code|time-?zone)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    $http.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(55)
    $event_count = count($http.metadata.id)
    $mitre_technique_id = array_distinct("T1614")
    $primary_entity = array_distinct($host)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)

  condition:
    #http >= 5
}
