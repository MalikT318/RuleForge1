/*
  MITRE Technique : T1609 - Container Administration Command
  Tactic(s)       : Execution
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:26:43.520662+00:00
  Reference       : https://attack.mitre.org/techniques/T1609
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1609_Container_Exec_Via_API_Server {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an exec or attach request to a pod's exec/attach subresource on the Kubernetes API server (the mechanism behind kubectl exec). This is interactive or scripted command execution inside a running container through the container administration plane. Accounts in the admin and service-account allowlists are excluded."
    mitre_tactic = "Execution"
    mitre_technique = "T1609"
    mitre_technique_name = "Container Administration Command"
    log_prerequisites = "Kubernetes API server audit logging enabled at Metadata level or higher for the pods/exec and pods/attach subresources, ingested into Chronicle and normalised to USER_RESOURCE_ACCESS with target.url holding the request URI."
    platform = "Containers"
    log_source = "container"
    false_positives = "Engineers debugging workloads, SRE break-glass troubleshooting, CI/CD or GitOps jobs running smoke tests via exec, operators and controllers that exec into pods for health checks or database maintenance, and approved support tooling."
    tuning_guidance = "Add named human administrators to %global_allowed_admin_users and automation or controller identities to %global_allowed_service_accounts. Review exec activity in production namespaces first. If target.url is not populated by the tenant's audit parser, map the request URI field accordingly before deployment."

  events:
    $k8s.metadata.event_type = "USER_RESOURCE_ACCESS"
    $k8s.target.url = /\/pods\/[^\/\?]+\/(exec|attach)(\?|$)/ nocase
    $k8s.principal.user.userid != ""
    not $k8s.principal.user.userid in %global_allowed_admin_users
    not $k8s.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1609")
    $primary_entity = array_distinct($k8s.principal.user.userid)
    $request_uri = array_distinct($k8s.target.url)
    $source_ips = array_distinct($k8s.principal.ip)

  condition:
    $k8s
}
