/*
  MITRE Technique : T1053.005 - Scheduled Task
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:15:41.534299+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_005_Task_File_Written_Outside_Scheduler_Service {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a scheduled task definition file created under the Windows Tasks directory by a process other than the Task Scheduler service host (svchost). Legitimate task creation via schtasks, the GUI, COM/.NET wrappers or WMI is written to disk by the Schedule service. A different process writing task XML directly is a stealth technique that bypasses the Task Scheduler API and the command-line telemetry that process-creation rules depend on."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.005"
    mitre_technique_name = "Scheduled Task/Job: Scheduled Task"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with the writing process populated, covering the System32\\Tasks directory. File-write monitoring on this path must not be filtered out by the sensor."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows servicing and in-place upgrades (TrustedInstaller, TiWorker), system image or profile restore tools, backup/restore agents, software deployment or imaging tooling that stages task files, and EDR/AV self-healing."
    tuning_guidance = "Add approved deployment, imaging and patching binaries to %global_allowed_admin_tools. Add EDR/AV agents that touch the Tasks directory to %global_allowed_security_tools. If a client's sensor attributes Schedule-service writes to a different host process, extend the executable-name exclusion after validating it."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\windows\\(system32|syswow64)\\tasks(_migrated)?\\[^\\]+/ nocase
    $file.principal.hostname != ""
    $file.principal.process.file.full_path != ""
    not $file.principal.process.file.full_path = /\\(svchost|taskeng|taskhostw|TrustedInstaller|TiWorker)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1053.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $task_file_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
