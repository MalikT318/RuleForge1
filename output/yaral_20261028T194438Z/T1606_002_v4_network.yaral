/*
  MITRE Technique : T1606.002 - SAML Tokens
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:25:38.376466+00:00
  Reference       : https://attack.mitre.org/techniques/T1606/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1606_002_Scripted_Client_Posting_SAML_Assertion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an HTTP POST to a SAML assertion-consumer or federation sign-on endpoint from a non-internal source using a scripted or library HTTP client (not a browser). Forged SAML tokens are typically generated offline and replayed by scripts directly at the service provider, bypassing the interactive browser redirect flow."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1606.002"
    mitre_technique_name = "Forge Web Credentials: SAML Tokens"
    log_prerequisites = "Requires normalised HTTP telemetry (NETWORK_HTTP) populating network.http.method, network.http.user_agent, target.url and principal.ip, from a proxy, WAF, load balancer or identity-provider front end that sees SAML endpoint traffic."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Synthetic monitoring and uptime probes against SSO endpoints, SAML integration test automation, SSO provisioning or onboarding scripts run from external CI/CD runners, and vendor-managed federation health checks."
    tuning_guidance = "Add authorised scanner and monitoring source addresses to %global_allowed_scanners. Add approved automation or integration source addresses to %global_allowed_mgmt_sources and extend the exclusions if needed. Narrow the url regex if the tenant uses custom SAML endpoint paths."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.url = /\/(saml2?|sso|wsfed|federation|acs)(\/|\?|$)|samlresponse/ nocase
    $net.network.http.user_agent = /(python-requests|python-urllib|aiohttp|curl\/|wget|go-http-client|java\/|okhttp|libwww-perl|powershell|axios|node-fetch|httpclient|ruby|php\/)/ nocase
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1606.002")
    $primary_entity = array_distinct($net.principal.ip)
    $target_hosts = array_distinct($net.target.hostname)
    $target_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
