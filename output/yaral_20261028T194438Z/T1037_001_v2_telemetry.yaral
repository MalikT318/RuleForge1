/*
  MITRE Technique : T1037.001 - Logon Script (Windows)
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:19:40.448522+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_001_UserInitMprLogonScript_Registry_Set {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of the UserInitMprLogonScript value under a user's Environment registry key. Windows runs the script it points to at every logon for that user, so adversaries use it for persistence. The rule detects the registry state change rather than the command line, so it still fires when the attacker hides or obfuscates the tool that wrote the value."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.001"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Logon Script (Windows)"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events 12/13/14, or equivalent) normalised to UDM REGISTRY_MODIFICATION with target.registry.registry_key and registry_value_name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Enterprise logon-script deployment tools, RMM or endpoint management agents that configure per-user logon scripts, and administrators setting a legacy logon script during user-profile provisioning or migration."
    tuning_guidance = "Add approved deployment or management binaries to %global_allowed_admin_tools and approved administrator accounts to %global_allowed_admin_users. If a client legitimately uses logon scripts via this value, add the service account that sets it to %global_allowed_service_accounts."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Environment$/ nocase
    $reg.target.registry.registry_value_name = /^UserInitMprLogonScript$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_admin_users
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1037.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $acting_user = array_distinct($reg.principal.user.userid)
    $acting_process = array_distinct($reg.principal.process.file.full_path)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $script_value = array_distinct($reg.target.registry.registry_value_data)

  condition:
    $reg
}
