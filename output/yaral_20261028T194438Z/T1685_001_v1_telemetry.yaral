/*
  MITRE Technique : T1685.001 - Disable or Modify Windows Event Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:15:56.791465+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_001_EventLog_Registry_Disable {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry state changes that disable Windows event logging: the EventLog service Start value set to Disabled (4), or an event log channel's Enabled value under WINEVT\\Channels set to 0. This detects the resulting configuration change rather than the command line that caused it, so it still fires when the actor uses direct API calls, renamed tools, or scripts that evade command-line logging."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.001"
    mitre_technique_name = "Disable or Modify Windows Event Log"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon registry events) that populates the registry key, value name, and value data for HKLM\\SYSTEM and HKLM\\SOFTWARE hives."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or GPO/RMM deployments intentionally disabling verbose operational channels (for example diagnostic or analytic channels) to reduce noise; software installers that toggle their own event channels; image build and sysprep processes; servicing stack updates."
    tuning_guidance = "Add approved deployment and RMM binaries to %global_allowed_admin_tools, security agents to %global_allowed_security_tools, and named change-management administrators to %global_allowed_admin_users. If a specific noisy channel is disabled by policy, exclude it with an additional 'not' regex on target.registry.registry_key. Do not exclude the Security, System, or EventLog service keys."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      (
        $reg.target.registry.registry_key = /\\services\\eventlog$/ nocase and
        $reg.target.registry.registry_value_name = /^start$/ nocase and
        $reg.target.registry.registry_value_data = /^(4|0x0*4|dword \(0x0*4\))$/ nocase
      )
      or
      (
        $reg.target.registry.registry_key = /\\winevt\\channels\\[^\\]+$/ nocase and
        $reg.target.registry.registry_value_name = /^enabled$/ nocase and
        $reg.target.registry.registry_value_data = /^(0|0x0+|dword \(0x0+\))$/ nocase
      )
    )
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker)\.exe$/ nocase
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1685.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $modified_value = array_distinct($reg.target.registry.registry_value_name)
    $actor_process = array_distinct($reg.principal.process.file.full_path)
    $actor_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
