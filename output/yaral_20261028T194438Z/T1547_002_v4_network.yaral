/*
  MITRE Technique : T1547.002 - Authentication Package
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:25:45.123439+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_002_LSASS_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Local Security Authority process (lsass.exe) initiating a network connection to a non-internal address. LSASS normally talks only to internal domain controllers and infrastructure. A malicious authentication package DLL loaded into LSASS at boot (T1547.002) runs inside this process, so any C2 beaconing or exfiltration it performs shows up as external traffic from lsass.exe."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.002"
    mitre_technique_name = "Boot or Logon Autostart Execution: Authentication Package"
    log_prerequisites = "Requires endpoint network telemetry that records the originating process (EDR network events or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Hybrid-identity features that legitimately make LSASS contact cloud endpoints (Entra ID / Azure AD Kerberos, Windows Hello for Business cloud trust, certificate revocation or OCSP lookups). Domain controllers reaching external time or trust partners. Loopback traffic if the internal list does not include it."
    tuning_guidance = "Add known-good cloud identity and vendor domains to %global_allowed_domains. If the rfc1918_internal list lacks loopback or link-local ranges, add them there rather than editing this rule. Add endpoint agents that hook LSASS network activity to %global_allowed_security_tools. Review the loaded modules and the Authentication Packages value under HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa on any host that alerts."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\lsass\.exe$/ nocase
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $connection_count = count($net.metadata.id)

  condition:
    $net
}
