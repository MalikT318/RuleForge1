/*
  MITRE Technique : T1104 - Multi-Stage Channels
  Tactic(s)       : Command and Control
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:00:48.086784+00:00
  Reference       : https://attack.mitre.org/techniques/T1104
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1104_Windows_Rapid_Staged_Payload_Retrieval {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a single Windows host launching several native download-capable utilities or interpreters with URL-based retrieval command lines within ten minutes. Each launch is benign on its own. Repeated retrieval in a short window is consistent with a first-stage loader pulling a second-stage implant, or with fallback staging infrastructure being tried."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1104"
    mitre_technique_name = "Multi-Stage Channels"
    log_prerequisites = "Requires EDR process telemetry, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled, normalised to UDM PROCESS_LAUNCH."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and bootstrappers, package managers (choco, winget wrappers), RMM and patching agents, developer build scripts, and admin automation that downloads multiple artifacts."
    tuning_guidance = "Add approved deployment and RMM parent processes to %global_allowed_admin_tools, trusted script-hosting parents to %global_allowed_script_hosts, and automation accounts to %global_allowed_service_accounts. Raise the #proc threshold in noisy environments, or lower it for high-value server groups."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd|mshta|wscript|cscript|certutil|bitsadmin|curl)\.exe$/ nocase
    $proc.target.process.command_line = /https?:\/\// nocase
    $proc.target.process.command_line = /(downloadstring|downloadfile|downloaddata|invoke-webrequest|invoke-restmethod|start-bitstransfer|net\.webclient|\biwr\b|\birm\b|urlcache|\/transfer|curl|wget)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(re.regex($proc.target.process.command_line, /(?i)(-enc|-encodedcommand|-w(indowstyle)?\s+hidden|-nop|bypass|frombase64string)/), 80, 55))
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1104")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
