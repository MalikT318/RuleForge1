/*
  MITRE Technique : T1547.004 - Winlogon Helper DLL
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:29:45.897577+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_004_Winlogon_Helper_Registry_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Multiple registry modifications to Winlogon helper keys (Shell, Userinit, Notify, AppSetup, Taskman, VmApplet, GinaDLL) on a single host within ten minutes. A single change can be benign servicing, but a burst of these modifications indicates persistence tampering that makes Winlogon load attacker-controlled DLLs or executables at logon."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.004"
    mitre_technique_name = "Boot or Logon Autostart Execution: Winlogon Helper DLL"
    log_prerequisites = "Requires Windows endpoint registry-modification telemetry (EDR or Sysmon registry events) that populates target.registry.registry_key and the registry value name."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows servicing and feature updates, software deployment or RMM agents that adjust the Winlogon shell or Userinit, kiosk and custom-shell provisioning, and security products that harden Winlogon settings."
    tuning_guidance = "Add approved deployment and RMM binaries to %global_allowed_admin_tools and endpoint security agents to %global_allowed_security_tools. Raise the #reg threshold on kiosk or VDI fleets that are reprovisioned often. Severity and risk score are higher when Shell or Userinit is touched."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      $reg.target.registry.registry_key = /\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon\\Notify(\\|$)/ nocase or
      (
        $reg.target.registry.registry_key = /\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon$/ nocase and
        $reg.target.registry.registry_value_name = /^(Shell|Userinit|AppSetup|Taskman|VmApplet|GinaDLL|System)$/ nocase
      )
    )
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($reg.target.registry.registry_value_name = /^(Shell|Userinit)$/ nocase, 90, 70))
    $mitre_technique_id = array_distinct("T1547.004")
    $primary_entity = array_distinct($host)
    $event_count = count($reg.metadata.id)
    $modified_keys = array_distinct($reg.target.registry.registry_key)
    $modified_values = array_distinct($reg.target.registry.registry_value_name)
    $modifying_processes = array_distinct($reg.principal.process.file.full_path)
    $modifying_users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 3
}
