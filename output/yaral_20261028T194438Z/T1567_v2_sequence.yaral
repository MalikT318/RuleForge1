/*
  MITRE Technique : T1567 - Exfiltration Over Web Service
  Tactic(s)       : Exfiltration
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:54:01.630707+00:00
  Reference       : https://attack.mitre.org/techniques/T1567
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_Linux_CLI_Client_Web_Service_Upload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Linux-style command-line HTTP client (curl, wget, Python or Go HTTP libraries) contacting an external web service that is not allow-listed, then uploading a large body to the same service from the same source within 10 minutes. This pattern is typical of data exfiltration to a legitimate hosting, storage or paste-style service. Detection uses proxy/firewall HTTP telemetry only (user agent, method, bytes sent, destination host) and does not depend on endpoint process or command-line data."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567"
    mitre_technique_name = "Exfiltration Over Web Service"
    log_prerequisites = "Requires forward or transparent proxy, or a firewall with TLS inspection or HTTP logging, that populates network.http.method, network.http.user_agent, target.hostname and network.sent_bytes. Without TLS inspection or SNI/host logging the user agent will be empty and the rule will not fire."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Backup or log-shipping scripts that push to external SaaS or object storage, CI/CD runners uploading build artifacts, package or software publishing jobs, monitoring agents using Go or Python HTTP clients, admins manually uploading support bundles to vendors."
    tuning_guidance = "Add sanctioned external SaaS and storage domains to %global_allowed_domains. Raise or lower the sent_bytes threshold per client baseline. If a client has many legitimate scripted uploads from known servers, scope them out with a source-based exclusion, or extend the user-agent regex only for clients that need it."

  events:
    $probe.metadata.event_type = "NETWORK_HTTP"
    $probe.network.http.user_agent = /^(curl|wget|libcurl|python-requests|python-urllib|go-http-client|aria2)/ nocase
    $probe.network.http.method = /^(GET|HEAD|POST|PUT)$/ nocase
    not $probe.target.ip in %rfc1918_internal
    not $probe.target.hostname in %global_allowed_domains
    $probe.principal.ip = $src_ip
    $probe.target.hostname = $dest_host

    $upload.metadata.event_type = "NETWORK_HTTP"
    $upload.network.http.user_agent = /^(curl|wget|libcurl|python-requests|python-urllib|go-http-client|aria2)/ nocase
    $upload.network.http.method = /^(POST|PUT)$/ nocase
    $upload.network.sent_bytes > 5242880
    not $upload.target.ip in %rfc1918_internal
    not $upload.target.hostname in %global_allowed_domains
    $upload.principal.ip = $src_ip
    $upload.target.hostname = $dest_host

    $probe.metadata.event_timestamp.seconds <= $upload.metadata.event_timestamp.seconds

  match:
    $src_ip, $dest_host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1567")
    $primary_entity = array_distinct($src_ip)
    $destination_host = array_distinct($dest_host)
    $destination_ips = array_distinct($upload.target.ip)
    $max_bytes_sent = max($upload.network.sent_bytes)
    $user_agents = array_distinct($upload.network.http.user_agent)
    $upload_event_count = count($upload.metadata.id)

  condition:
    $probe and $upload
}
