/*
  MITRE Technique : T1136.001 - Local Account
  Tactic(s)       : Persistence
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:07:53.560996+00:00
  Reference       : https://attack.mitre.org/techniques/T1136/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_001_External_Source_To_Windows_Remote_Account_Mgmt_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a perimeter-observed connection from an external source address to an internal host on the Windows remote account-management ports: SMB/SAMR named pipes (445), RPC endpoint mapper (135) and WinRM (5985/5986). Remote local-account creation (for example 'net user /add' run remotely or SAMR calls over SMB) must pass through these ports, so external reachability to them is a network-side precursor to T1136.001. A firewall cannot see account creation itself, so treat a hit as a high-priority exposure and lead indicator. Pivot to endpoint account-creation telemetry (Security events 4720/4722/4732) on the target host."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136.001"
    mitre_technique_name = "Create Account: Local Account"
    log_prerequisites = "Requires firewall or perimeter NETWORK_CONNECTION logs with populated principal.ip, target.ip and target.port, ideally covering inbound traffic through the edge."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and penetration tests, VPN or remote-access concentrators that NAT remote users, vendor or MSP support over approved tunnels, hybrid-cloud management connections, and internet-exposed SMB or WinRM that was already misconfigured."
    tuning_guidance = "Add authorised scanner sources to %global_allowed_scanners and approved management or VPN source addresses to %global_allowed_mgmt_sources. Verify that %rfc1918_internal covers every internal range used by the client. If a client has legitimate inbound WinRM through the edge, remove 5985/5986 from the port list for that tenant. Correlate hits with endpoint USER_CREATION events on the destination host."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 445 or
      $net.target.port = 135 or
      $net.target.port = 5985 or
      $net.target.port = 5986
    )
    $net.principal.ip != ""
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1136.001")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
