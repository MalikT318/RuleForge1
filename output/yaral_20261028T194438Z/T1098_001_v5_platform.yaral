/*
  MITRE Technique : T1098.001 - Additional Cloud Credentials
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:41:41.658136+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_001_IdP_Credential_Added_To_App_Or_ServicePrincipal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects directory audit events in which a secret, certificate, or key credential is added to or updated on an application registration or service principal in the cloud identity provider. Adversaries add their own credentials to existing applications to keep persistent, password-less access that survives a user password reset or session revocation. The rule is based on identity audit telemetry rather than endpoint process data."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.001"
    mitre_technique_name = "Account Manipulation: Additional Cloud Credentials"
    log_prerequisites = "Requires cloud identity provider directory audit logs (application and service principal management activity) ingested and normalised to UDM, with metadata.product_event_type and principal.user.userid populated."
    platform = "Identity Provider"
    log_source = "m365"
    false_positives = "Planned secret or certificate rotation by application owners, DevOps and CI/CD pipelines that rotate application credentials, onboarding of new SaaS integrations or enterprise applications, and administrators performing approved maintenance."
    tuning_guidance = "Add automation and pipeline identities to %global_allowed_service_accounts, approved administrators to %global_allowed_admin_users, and approved cloud service principals to %global_allowed_cloud_principals. If rotation is frequent, raise severity only for credentials added to applications holding privileged directory roles, or pair this rule with a sign-in anomaly rule for the same actor."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"
    $cloud.metadata.product_event_type = /(add service principal credentials|add service principal key|update application\s*[-–]?\s*certificates and secrets management|add password credential|add key credential|certificates and secrets|update service principal credentials)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1098.001")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $operation = array_distinct($cloud.metadata.product_event_type)
    $target_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
