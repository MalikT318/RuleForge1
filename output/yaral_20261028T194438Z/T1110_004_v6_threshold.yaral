/*
  MITRE Technique : T1110.004 - Credential Stuffing
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:09:58.480714+00:00
  Reference       : https://attack.mitre.org/techniques/T1110/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1110_004_Container_API_Auth_Failure_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single source address generates a high volume of HTTP 401 unauthenticated responses against the container orchestration control-plane API within ten minutes. Each failed authentication is benign alone, but many in a short window indicate credential stuffing with breached username, password or token pairs against the cluster API server."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1110.004"
    mitre_technique_name = "Brute Force: Credential Stuffing"
    log_prerequisites = "Requires container orchestration (Kubernetes) API server audit logs normalized to UDM USER_RESOURCE_ACCESS with principal.ip, principal.user.userid and network.http.response_code populated. The audit policy must record authentication failures (401 responses)."
    platform = "Linux"
    log_source = "container"
    false_positives = "Misconfigured CI/CD runners or controllers with expired tokens or certificates, monitoring and health-check probes using stale credentials, load balancer probes hitting authenticated endpoints, developers with expired kubeconfig credentials retrying in a loop, authorized penetration tests."
    tuning_guidance = "Add known automation accounts to %global_allowed_service_accounts, and approved scanner, CI or management source addresses to %global_allowed_mgmt_sources. Raise the #auth threshold in noisy clusters, or lower it for high-security clusters exposing the API publicly. Review the distinct_users outcome: many different usernames from one source strongly indicates stuffing, while a single username suggests a broken client."

  events:
    $auth.metadata.event_type = "USER_RESOURCE_ACCESS"
    $auth.network.http.response_code = 401
    $auth.principal.ip = $src_ip
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.ip in %global_allowed_mgmt_sources

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($auth.metadata.id)
    $distinct_users = array_distinct($auth.principal.user.userid)
    $target_hosts = array_distinct($auth.target.hostname)
    $mitre_technique_id = array_distinct("T1110.004")
    $primary_entity = array_distinct($src_ip)

  condition:
    #auth >= 20
}
