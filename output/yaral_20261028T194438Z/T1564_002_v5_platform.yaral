/*
  MITRE Technique : T1564.002 - Hidden Users
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:16:16.733662+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_002_Winlogon_SpecialAccounts_UserList_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry write under the Winlogon SpecialAccounts UserList key, which hides a local account from the Windows logon screen. This is registry-based coverage that is independent of process command-line rules, so it also catches the change when it is made through APIs, scripts, or renamed tools. Written for Windows because the technique's registry mechanism is Windows-specific and the tenant log source requirement is Windows endpoint telemetry."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.002"
    mitre_technique_name = "Hide Artifacts: Hidden Users"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry value set events) normalised to REGISTRY_MODIFICATION with target.registry.registry_key populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Enterprise kiosk or shared-workstation provisioning, golden-image build scripts, IT tooling that hides service or admin accounts from the logon screen, and Group Policy or MDM configuration baselines."
    tuning_guidance = "Add approved provisioning or configuration binaries to %global_allowed_admin_tools. Add known automation accounts to %global_allowed_service_accounts. Add named administrators to %global_allowed_admin_users. Review $hidden_account_names to confirm which account was hidden; the value name is the account name."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Windows NT\\CurrentVersion\\Winlogon\\SpecialAccounts\\UserList/ nocase
    $reg.principal.hostname != ""
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1564.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $hidden_account_names = array_distinct($reg.target.registry.registry_value_name)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
