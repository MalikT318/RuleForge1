/*
  MITRE Technique : T1021.003 - Distributed Component Object Model
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:37:59.313250+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_003_DCOM_Permission_Registry_Tampering {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry changes that enable DCOM or loosen its remote launch, activation and access permissions. This covers the machine-wide OLE settings (MachineLaunchRestriction, MachineAccessRestriction, EnableDCOM, EnableRemoteConnect and the default permission values) and per-application AppID permission values (LaunchPermission, AccessPermission, RunAs, AuthenticationLevel). Attackers who want to use DCOM for lateral movement often make these changes first, because by default only Administrators can remotely activate COM objects. The rule works on the registry state change, so it still fires when command-line logging is evaded."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.003"
    mitre_technique_name = "Remote Services: Distributed Component Object Model"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events 12/13, normalised to UDM REGISTRY_MODIFICATION) with registry key path, value name and the modifying process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Enterprise software installers (Office, SQL Server, middleware, ERP and monitoring agents) that register DCOM applications; admins hardening DCOM after security advisories; GPO or configuration-management pushes of DCOM security settings; RMM tooling."
    tuning_guidance = "Add approved deployment and configuration tooling to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. If a client regularly installs DCOM-dependent software, add the installer parent process to %global_allowed_admin_tools. Tighten by restricting to the Ole key values if AppID noise is high."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      (
        $reg.target.registry.registry_key = /\\Software\\Microsoft\\Ole$/ nocase and
        $reg.target.registry.registry_value_name = /^(MachineLaunchRestriction|MachineAccessRestriction|DefaultLaunchPermission|DefaultAccessPermission|EnableDCOM|EnableRemoteConnect)$/ nocase
      ) or
      (
        $reg.target.registry.registry_key = /\\AppID\\(\{[0-9a-f\-]+\}|[^\\]+\.exe)$/ nocase and
        $reg.target.registry.registry_value_name = /^(LaunchPermission|AccessPermission|RunAs|AuthenticationLevel)$/ nocase
      )
    )
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1021.003")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_keys = array_distinct($reg.target.registry.registry_key)
    $modified_values = array_distinct($reg.target.registry.registry_value_name)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $modifying_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
