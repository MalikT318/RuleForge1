/*
  MITRE Technique : T1046 - Network Service Discovery
  Tactic(s)       : Discovery
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:29:25.909674+00:00
  Reference       : https://attack.mitre.org/techniques/T1046
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1046_Outbound_Windows_Service_Probe_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a perimeter-observed connection from an internal source to an external destination on a Windows management or file-sharing service port (RPC, NetBIOS, SMB, RDP, WinRM, Telnet). Those services are not normally reached across the perimeter, so such a connection indicates probing or service discovery of external or exposed hosts, or a compromised host reaching for them. Because this is a single-event indicator, pair it with a volume-based threshold rule on the same log source for confirmed scanning."
    mitre_tactic = "Discovery"
    mitre_technique = "T1046"
    mitre_technique_name = "Network Service Discovery"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Egress traffic must be logged, including permitted and denied connections."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scans, penetration tests, VPN or site-to-site links that carry SMB or RDP, administrators using RDP to a cloud-hosted jump host, hybrid-cloud file shares, and misconfigured clients with stale mapped drives."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners and approved management source addresses to %global_allowed_mgmt_sources. Add approved service-account hosts to %global_allowed_service_accounts if your log source populates user identity. Trim the port list if the client legitimately uses RDP or SMB to cloud services. Populate %rfc1918_internal with the client's internal address space."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 135 or
      $net.target.port = 139 or
      $net.target.port = 445 or
      $net.target.port = 3389 or
      $net.target.port = 5985 or
      $net.target.port = 5986 or
      $net.target.port = 23
    )
    $net.principal.ip in %rfc1918_internal
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1046")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
