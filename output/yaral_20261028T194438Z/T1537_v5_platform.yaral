/*
  MITRE Technique : T1537 - Transfer Data to Cloud Account
  Tactic(s)       : Exfiltration
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:36:08.272387+00:00
  Reference       : https://attack.mitre.org/techniques/T1537
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1537_IaaS_Snapshot_Image_Sharing_Permission_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a control-plane permission or sharing change on a disk snapshot, machine image, or backup resource. Granting another account access to these resources is a common way to move whole-volume data to an adversary-controlled cloud account in the same provider without any external network transfer. Matches the combination of a backup-type resource and a sharing, attribute, IAM, or access-grant operation."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1537"
    mitre_technique_name = "Transfer Data to Cloud Account"
    log_prerequisites = "Cloud provider control-plane audit logging must be enabled and ingested with management and write events, including compute and storage snapshot, image, and backup operations. metadata.product_event_type must be populated by the parser."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate cross-account or cross-project snapshot and image sharing for DR, golden-image distribution, AMI/image pipelines, central backup accounts, migration projects, and managed-service or MSSP onboarding. Automation roles run by IaC or backup orchestration tooling."
    tuning_guidance = "Add known automation and pipeline identities to %global_allowed_cloud_principals and approved administrators to %global_allowed_admin_users. If a client has a central backup or image-distribution account, allowlist the identity that performs the sharing. Triage by checking whether the account being granted access belongs to the organization."

  events:
    $cloud.metadata.event_type = "RESOURCE_PERMISSIONS_CHANGE"
    $cloud.metadata.product_event_type = /(snapshot|image|backup|restorepoint|recoverypoint).*(attribute|iam|policy|permission|share|grantaccess|getaccess|sas|access)|(share|grant|modify|setiam|put).*(snapshot|image|backup|restorepoint|recoverypoint)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1537")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_operations = array_distinct($cloud.metadata.product_event_type)
    $target_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
