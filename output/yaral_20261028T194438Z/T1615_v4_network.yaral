/*
  MITRE Technique : T1615 - Group Policy Discovery
  Tactic(s)       : Discovery
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:41:41.579773+00:00
  Reference       : https://attack.mitre.org/techniques/T1615
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1615_Perimeter_AD_Policy_Protocols_To_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal source opening a connection to a non-internal destination on the SMB (445), LDAP (389/636) or Global Catalog (3268/3269) ports. These are the protocols used to read SYSVOL and query Group Policy objects in Active Directory. They should never cross the perimeter. A perimeter device cannot see SYSVOL paths or the initiating process, so this rule covers only the network side of Group Policy and AD discovery: a compromised host, a pivot, or an exposed or rogue domain service. Pair it with endpoint rules for the same technique."
    mitre_tactic = "Discovery"
    mitre_technique = "T1615"
    mitre_technique_name = "Group Policy Discovery"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with populated principal.ip, target.ip and target.port. Egress traffic must be logged with the pre-NAT internal source address."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Hybrid or cloud-hosted domain controllers reached over a routed path (Azure AD DS, AWS Managed AD), site-to-site links whose peer address is not in the internal list, cloud file shares reached over SMB, vendor or partner directory federation over LDAPS, and authorised vulnerability or AD health scanners."
    tuning_guidance = "Confirm %rfc1918_internal covers all internal and VPN ranges. Add approved scanner sources to %global_allowed_scanners and approved management or jump host source addresses to %global_allowed_mgmt_sources. If the client has cloud-hosted domain controllers, add their addresses to the internal list or restrict those paths to approved sources. If perimeter logs only record post-NAT source addresses, remove the principal.ip internal-source condition and rely on the allowlists."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 445 or
      $net.target.port = 389 or
      $net.target.port = 636 or
      $net.target.port = 3268 or
      $net.target.port = 3269
    )
    $net.principal.ip in %rfc1918_internal
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1615")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
