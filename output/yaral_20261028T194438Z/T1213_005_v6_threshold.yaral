/*
  MITRE Technique : T1213.005 - Messaging Applications
  Tactic(s)       : Collection
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:29:56.525757+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_005_Messaging_App_High_Volume_Access_Per_User {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single user generates an unusually high volume of authentication or access events against chat and messaging applications within ten minutes. Individual sign-ins are benign. A burst of them suggests scripted or token-driven mining of messaging content (credentials, internal links, incident-response discussions) with a compromised account."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.005"
    mitre_technique_name = "Data from Information Repositories: Messaging Applications"
    log_prerequisites = "Identity provider sign-in / application access audit logs normalised to UDM USER_LOGIN with principal.user.userid and target.application populated."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Users with many devices or clients refreshing sessions at once (desktop, mobile, web). Shared kiosk or VDI accounts. Chat-integrated bots and automation using user identities. Mass re-authentication after a conditional-access or session-policy change. Productivity or archiving integrations."
    tuning_guidance = "Add automation and integration accounts to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Raise the #auth threshold (default 20) for tenants with heavy desktop-client session churn. Extend the target.application regex with the messaging application display names used in the tenant. Pair with an alert on new source IPs for the same user to prioritise triage."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.application = /(chat|messag|collaborat|channel)/ nocase
    $auth.principal.user.userid = $user
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $event_count = count($auth.metadata.id)
    $risk_score = if($event_count >= 60, 85, 60)
    $mitre_technique_id = array_distinct("T1213.005")
    $primary_entity = array_distinct($user)
    $source_ips = array_distinct($auth.principal.ip)
    $target_apps = array_distinct($auth.target.application)

  condition:
    #auth >= 20
}
