/*
  MITRE Technique : T1056.003 - Web Portal Capture
  Tactic(s)       : Collection, Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:49:02.807880+00:00
  Reference       : https://attack.mitre.org/techniques/T1056/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1056_003_Portal_Login_POST_Then_Server_Outbound {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the network pattern of a trojanised externally facing login portal (VPN, ADFS, OWA, RD Web style). An external client POSTs credentials to a login-style URL on a server. Within 10 minutes the same server opens an outbound connection to an external destination that is not an allow-listed domain. This is consistent with a modified login page forwarding captured credentials to attacker infrastructure."
    mitre_tactic = "Collection, Credential Access"
    mitre_technique = "T1056.003"
    mitre_technique_name = "Input Capture: Web Portal Capture"
    log_prerequisites = "Requires perimeter firewall or reverse-proxy logs that record HTTP method and URL (TLS inspection or termination at the proxy) for inbound traffic, and outbound connection logs for server-originated traffic, both normalised to UDM with populated principal.ip and target.ip."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Portal servers legitimately calling external services after a login, such as cloud MFA providers, SSO or identity federation endpoints, OCSP/CRL checks, telemetry and update services, and SIEM or log forwarders. Reverse-proxy deployments where the proxy IP is the target.ip of all POSTs and also makes backend calls."
    tuning_guidance = "Add known-good external destinations (MFA, SSO, update, OCSP/CRL domains) to %global_allowed_domains. Add approved management or monitoring destinations to %global_allowed_mgmt_sources. If a reverse proxy produces noise, scope the rule to portal server addresses in a per-client copy. Tighten the URL regex to the client's portal paths if needed."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST"
    $http.target.url = /(login|logon|signin|sign-in|auth|authenticate|owa|adfs|webvpn|remote|portal)/ nocase
    not $http.principal.ip in %rfc1918_internal
    $http.target.ip = $server_ip

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $server_ip
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.target.ip in %global_allowed_mgmt_sources
    (
      $net.target.port = 80 or
      $net.target.port = 443 or
      $net.target.port = 8080 or
      $net.target.port = 8443
    )

    $http.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $server_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1056.003")
    $primary_entity = array_distinct($server_ip)
    $login_post_count = count($http.metadata.id)
    $client_ips = array_distinct($http.principal.ip)
    $portal_urls = array_distinct($http.target.url)
    $outbound_destination_ips = array_distinct($net.target.ip)
    $outbound_destination_hosts = array_distinct($net.target.hostname)

  condition:
    $http and $net
}
