/*
  MITRE Technique : T1059.009 - Cloud API
  Tactic(s)       : Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:19:56.421669+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_009_SaaS_Programmatic_Client_Identity_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an identity provider sign-in where the client user agent is a command-line, scripting-language or SDK HTTP client rather than a browser or native app. Adversaries holding stolen credentials or tokens commonly authenticate this way to drive cloud and SaaS control-plane APIs from scripts, CLIs and cloud shells. This is a control-plane detection with no endpoint process fields, so it complements command-line rules."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.009"
    mitre_technique_name = "Command and Scripting Interpreter: Cloud API"
    log_prerequisites = "Identity provider sign-in logs ingested and normalised to UDM USER_LOGIN with network.http.user_agent populated. Non-interactive and service-principal sign-ins must be included in the export."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "DevOps and automation pipelines, administrators using cloud CLIs or PowerShell modules, sanctioned integrations and sync connectors, security scanners and monitoring probes, developers testing SDKs."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, named administrators to %global_allowed_admin_users, and approved management or CI egress addresses to %global_allowed_mgmt_sources. If a client environment legitimately uses a particular SDK heavily, narrow the user agent regex. To reduce noise further, require security_result.action = ALLOW where the tenant populates it consistently."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.network.http.user_agent = /(powershell|azure-?cli|aws-?cli|gcloud|google-cloud-sdk|boto3|botocore|python-requests|python-urllib|aiohttp|curl\/|wget\/|go-http-client|okhttp|axios|node-fetch|apache-httpclient|java\/|msgraph|graph-?sdk|cloudshell)/ nocase
    $auth.principal.user.userid != ""
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users
    not $auth.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1059.009")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $source_ips = array_distinct($auth.principal.ip)
    $user_agents = array_distinct($auth.network.http.user_agent)
    $target_apps = array_distinct($auth.target.application)

  condition:
    $auth
}
