/*
  MITRE Technique : T1574 - Hijack Execution Flow
  Tactic(s)       : Stealth, Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:27:32.871528+00:00
  Reference       : https://attack.mitre.org/techniques/T1574
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_006_Linux_Dynamic_Linker_Config_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of dynamic linker configuration files on Linux (/etc/ld.so.preload, /etc/ld.so.conf and /etc/ld.so.conf.d/*.conf) by a process other than a trusted package manager or approved admin tooling. Writing to these files forces or redirects shared-library loading system-wide (library injection or search-order hijack), a common userland rootkit and persistence technique. The rule keys on the file-write result, not on the command line, so it covers shell redirection, scripts, editors and custom binaries."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574"
    mitre_technique_name = "Hijack Execution Flow"
    log_prerequisites = "Linux endpoint file-write telemetry from EDR or auditd (watch rules on /etc/ld.so.preload, /etc/ld.so.conf and /etc/ld.so.conf.d/) normalised to UDM FILE_MODIFICATION with target.file.full_path and principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers installing or removing libraries that drop ld.so.conf.d snippets, configuration management agents (Ansible, Puppet, Chef, Salt), vendor installers for databases, GPU drivers, or language runtimes that register library directories, and administrators manually adding a library path."
    tuning_guidance = "Add approved configuration-management and deployment binaries to %global_allowed_admin_tools and EDR or AV agents that legitimately preload libraries to %global_allowed_security_tools. Writes to /etc/ld.so.preload are rare on healthy hosts and score higher than ld.so.conf.d changes. If the telemetry reports first-time file writes as FILE_CREATION, deploy a copy of this rule with that event type, because a single rule targets one event type only."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/(ld\.so\.preload|ld\.so\.conf|ld\.so\.conf\.d\/[^\/]+\.conf)$/
    not $file.principal.process.file.full_path = /^\/(usr\/)?(s?bin)\/(dpkg|rpm|apt|apt-get|yum|dnf|zypper|ldconfig|unattended-upgrade)$/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(if($file.target.file.full_path = "/etc/ld.so.preload", 90, 65))
    $mitre_technique_id = array_distinct("T1574")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
