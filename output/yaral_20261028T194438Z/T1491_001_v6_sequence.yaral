/*
  MITRE Technique : T1491.001 - Internal Defacement
  Tactic(s)       : Impact
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:45:22.056287+00:00
  Reference       : https://attack.mitre.org/techniques/T1491/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_001_Linux_Banner_And_Content_Defacement_Sequence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Linux host where a login banner file (/etc/motd, /etc/issue, /etc/issue.net, update-motd.d scripts, SSH banner) and an internal web page or desktop wallpaper asset are both modified by non-administrative processes within ten minutes. This combination indicates internal defacement intended to intimidate or mislead users."
    mitre_tactic = "Impact"
    mitre_technique = "T1491.001"
    mitre_technique_name = "Defacement: Internal Defacement"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules (write/attribute change) on /etc/motd, /etc/issue*, /etc/update-motd.d, web document roots, and wallpaper directories, normalised to FILE_MODIFICATION with principal.hostname populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management (Ansible, Puppet, Chef, Salt) pushing a new banner and web content in the same run; OS package upgrades; web developers deploying a site release while an admin updates the MOTD; corporate branding or desktop image rollouts."
    tuning_guidance = "Add approved deployment and configuration-management binaries to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and named administrators to %global_allowed_admin_users. Extend the path regexes if the client uses non-standard web roots."

  events:
    $banner.metadata.event_type = "FILE_MODIFICATION"
    $banner.target.file.full_path = /^\/etc\/(motd|issue|issue\.net)$|^\/etc\/update-motd\.d\/|^\/etc\/ssh\/[^\/]*banner[^\/]*$/ nocase
    not $banner.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|yum|dnf|zypper|unattended-upgrade|pacman|snapd|ansible[^\/]*|puppet|chef-client|salt-minion|cloud-init|systemd-tmpfiles)$/ nocase
    not $banner.principal.process.file.full_path in %global_allowed_admin_tools
    not $banner.principal.user.userid in %global_allowed_service_accounts
    not $banner.principal.user.userid in %global_allowed_admin_users
    $banner.principal.hostname = $hostname

    $content.metadata.event_type = "FILE_MODIFICATION"
    $content.target.file.full_path = /^\/(var\/www|srv\/www|usr\/share\/nginx|usr\/share\/httpd)\/.*index\.(html?|php|jsp)$|^\/usr\/share\/(backgrounds|wallpapers)\/[^\/]+/ nocase
    not $content.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|yum|dnf|zypper|unattended-upgrade|pacman|snapd|ansible[^\/]*|puppet|chef-client|salt-minion|cloud-init|systemd-tmpfiles)$/ nocase
    not $content.principal.process.file.full_path in %global_allowed_admin_tools
    not $content.principal.user.userid in %global_allowed_service_accounts
    not $content.principal.user.userid in %global_allowed_admin_users
    $content.principal.hostname = $hostname

    $banner.metadata.event_timestamp.seconds <= $content.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1491.001")
    $primary_entity = array_distinct($banner.principal.hostname)
    $banner_files = array_distinct($banner.target.file.full_path)
    $content_files = array_distinct($content.target.file.full_path)
    $banner_users = array_distinct($banner.principal.user.userid)
    $content_users = array_distinct($content.principal.user.userid)
    $banner_processes = array_distinct($banner.principal.process.file.full_path)
    $content_processes = array_distinct($content.principal.process.file.full_path)

  condition:
    $banner and $content
}
