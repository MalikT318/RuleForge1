/*
  MITRE Technique : T1216.001 - PubPrn
  Tactic(s)       : Stealth
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:35:03.257180+00:00
  Reference       : https://attack.mitre.org/techniques/T1216/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

// NOTE: PubPrn.vbs is a Windows-only component. The requested alternate-platform angle cannot be met, so this rule stays on Windows and pivots on renamed or copied script detection instead.
rule MSSP_T1216_001_PubPrn_Remote_Script_Moniker_WSH {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows Script Host binary (cscript/wscript) running a VBScript whose arguments contain a remote 'script:' moniker (http, https, ftp or UNC). This is the PubPrn proxy-execution pattern for loading a remote scriptlet. It matches on the argument combination rather than the pubprn.vbs filename, so renamed or copied script files are still caught."
    mitre_tactic = "Stealth"
    mitre_technique = "T1216.001"
    mitre_technique_name = "System Script Proxy Execution: PubPrn"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 with full command-line capture."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy admin or logon VBScripts that deliberately use a script: moniker to fetch scriptlets from an internal web server or file share; RMM or deployment tooling that launches WSH with remote script arguments; developers testing Windows Script Components."
    tuning_guidance = "Add approved parent processes and hosts to %global_allowed_script_hosts. Add approved deployment or RMM tooling to %global_allowed_admin_tools. Extend the exclusions with approved internal scriptlet sources if legitimate use is found."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(cscript|wscript)\.exe$/ nocase
    $proc.target.process.command_line = /\.vbs/ nocase
    $proc.target.process.command_line = /script:\s*["']?(https?:|ftp:|\\\\)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1216.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
