/*
  MITRE Technique : T1518.002 - Backup Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:22:57.937015+00:00
  Reference       : https://attack.mitre.org/techniques/T1518/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_002_Scripted_HTTP_To_Backup_Vendor_Infrastructure {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP(S) requests to external backup-vendor infrastructure made with a scripting or command-line HTTP client user-agent (PowerShell, curl, wget, Python, Go, Java). Browsers and the vendors' own agents use their own user-agents, so a scripted client querying backup-vendor hosts suggests an adversary or ransomware tooling enumerating backup products, licences, or cloud repositories before Inhibit System Recovery or Data Destruction. Observed on the network side, independent of endpoint coverage."
    mitre_tactic = "Discovery"
    mitre_technique = "T1518.002"
    mitre_technique_name = "Software Discovery: Backup Software Discovery"
    log_prerequisites = "Requires NETWORK_HTTP telemetry with target.url or target.hostname and network.http.user_agent populated (secure web proxy, TLS-inspecting firewall, or EDR HTTP telemetry). Internal address space is excluded via %rfc1918_internal."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup administrators scripting vendor REST APIs or cloud portals; PowerShell-based backup health or licence-check scripts; RMM or monitoring tools polling backup vendor cloud consoles; packaging and deployment scripts fetching backup agent updates."
    tuning_guidance = "Add approved backup agents and scripts to %global_allowed_backup_processes and RMM or monitoring binaries to %global_allowed_admin_tools. Add sanctioned vendor domains to %global_allowed_domains. If the proxy does not expose the originating process, tune per host or user-agent instead. Raise severity when the source host is a server that has no backup role."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.user_agent = /(WindowsPowerShell|PowerShell|curl\/|Wget|python-requests|python-urllib|Go-http-client|Java\/|WinHttp-Autoproxy|libwww-perl)/ nocase
    (
      $http.target.url = /(veeam|acronis|commvault|veritas|netbackup|backupexec|rubrik|cohesity|druva|datto|carbonite|paragon-software|storagecraft|arcserve|unitrends)/ nocase or
      $http.target.hostname = /(veeam|acronis|commvault|veritas|netbackup|backupexec|rubrik|cohesity|druva|datto|carbonite|paragon-software|storagecraft|arcserve|unitrends)/ nocase
    )
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.process.file.full_path in %global_allowed_backup_processes
    not $http.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1518.002")
    $primary_entity = array_distinct($http.principal.hostname)
    $target_hosts = array_distinct($http.target.hostname)
    $target_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)
    $source_users = array_distinct($http.principal.user.userid)

  condition:
    $http
}
