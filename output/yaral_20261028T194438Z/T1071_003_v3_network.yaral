/*
  MITRE Technique : T1071.003 - Mail Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:07:54.563168+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_003_External_Mail_Protocol_Egress_Firewall {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host making an outbound connection to an external destination on a mail-protocol port (SMTP, SMTPS, submission, POP3/S, IMAP/S). Workstations and servers that are not mail relays rarely speak these protocols directly to the internet, so this can indicate mail-protocol command and control or data exfiltration. Observed purely from perimeter telemetry, so it complements endpoint command-line detections."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.003"
    mitre_technique_name = "Application Layer Protocol: Mail Protocols"
    log_prerequisites = "Requires firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with target.ip and target.port populated and egress traffic from Windows hosts visible. The firewall must log allowed outbound connections, not only denies."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate mail servers and relays, multifunction printers and scanners sending scan-to-email, line-of-business applications sending notifications through external SMTP providers, users with desktop mail clients (Outlook/Thunderbird) using POP3/IMAP to external mail providers, and monitoring or ticketing systems that send alert emails."
    tuning_guidance = "Add sanctioned external mail relay and provider hostnames to %global_allowed_domains. Where the firewall log does not carry a destination hostname, scope exclusions at the firewall policy level or add the known mail gateway to the exclusion logic. Review the top source IPs in the first week and decide whether desktop clients are permitted to use external IMAP/POP3. Raise severity for server subnets that should never send mail directly."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 25 or
      $net.target.port = 465 or
      $net.target.port = 587 or
      $net.target.port = 2525 or
      $net.target.port = 110 or
      $net.target.port = 995 or
      $net.target.port = 143 or
      $net.target.port = 993
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1071.003")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $destination_hostnames = array_distinct($net.target.hostname)

  condition:
    $net
}
