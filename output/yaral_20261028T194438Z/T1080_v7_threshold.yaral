/*
  MITRE Technique : T1080 - Taint Shared Content
  Tactic(s)       : Lateral Movement
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:22:49.051942+00:00
  Reference       : https://attack.mitre.org/techniques/T1080
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1080_SaaS_Shared_Content_Executable_Bulk_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single user modified or overwrote several executable, script, macro-enabled or shortcut files in shared SaaS storage within ten minutes. Individual file updates are benign. Bulk modification of runnable content in shared locations is consistent with tainting shared content for lateral movement."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1080"
    mitre_technique_name = "Taint Shared Content"
    log_prerequisites = "Requires SaaS or cloud audit logs that record content updates to shared files and normalise them to USER_RESOURCE_UPDATE_CONTENT, with principal.user.userid and target.file.full_path populated."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Developers or release engineers syncing scripts or build artifacts to shared drives, software packaging and deployment pipelines, Office macro template maintenance, backup or sync clients re-uploading files, and bulk migrations by administrators."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, approved administrators to %global_allowed_admin_users, and sanctioned integrations to %global_allowed_cloud_principals. Raise the #file threshold for tenants with heavy script or artifact sharing. Narrow the extension regex if a client legitimately stores a given file type in shared storage."

  events:
    $file.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"
    $file.target.file.full_path = /\.(exe|dll|msi|scr|bat|cmd|ps1|vbs|vbe|js|jse|hta|lnk|jar|sh|docm|xlsm|pptm)$/ nocase
    $file.principal.user.userid != ""
    $file.principal.user.userid = $user
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_cloud_principals

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($file.metadata.id)
    $modified_files = array_distinct($file.target.file.full_path)
    $source_ips = array_distinct($file.principal.ip)
    $mitre_technique_id = array_distinct("T1080")
    $primary_entity = array_distinct($user)

  condition:
    #file >= 8
}
