/*
  MITRE Technique : T1684 - Social Engineering
  Tactic(s)       : Stealth
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:30:17.879897+00:00
  Reference       : https://attack.mitre.org/techniques/T1684
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1684_Third_Party_Password_Reset_Helpdesk_Pretext {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a password change or reset on an account performed by a different identity than the account owner, and not by an approved administrator or service account. Help-desk impersonation and pretexting calls typically end in this action, so a reset by an unapproved actor is a strong social-engineering outcome signal. Written for identity provider and SaaS control-plane audit logs."
    mitre_tactic = "Stealth"
    mitre_technique = "T1684"
    mitre_technique_name = "Social Engineering"
    log_prerequisites = "Requires identity provider directory audit logs that populate both the acting user (principal.user.userid) and the affected user (target.user.userid) on password change or reset events."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Help-desk staff or delegated administrators not yet in the approved admin list, automated onboarding and offboarding workflows, identity governance tooling, and bulk password rotations after a security incident."
    tuning_guidance = "Add named help-desk and identity administrators to %global_allowed_admin_users. Add provisioning and automation identities to %global_allowed_service_accounts. Route alerts for privileged target accounts to higher priority in SOAR."

  events:
    $auth.metadata.event_type = "USER_CHANGE_PASSWORD"
    $auth.principal.user.userid != ""
    $auth.target.user.userid != ""
    $auth.principal.user.userid != $auth.target.user.userid
    not $auth.principal.user.userid in %global_allowed_admin_users
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1684")
    $primary_entity = array_distinct($auth.target.user.userid)
    $acting_user = array_distinct($auth.principal.user.userid)
    $source_ips = array_distinct($auth.principal.ip)

  condition:
    $auth
}
