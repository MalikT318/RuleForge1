/*
  MITRE Technique : T1612 - Build Image on Host
  Tactic(s)       : Stealth
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:33:26.802346+00:00
  Reference       : https://attack.mitre.org/techniques/T1612
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1612_Container_Image_Build_From_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a container image build (build CLI subcommand, or a raw build call to the container runtime socket) launched directly by a web server, application server or database service. These parents never legitimately build images, so this lineage points to a compromised service building a custom image on the host to avoid pulling a malicious image from a registry. Only the direct parent is visible in UDM, so a build launched through an intermediate shell will not match."
    mitre_tactic = "Stealth"
    mitre_technique = "T1612"
    mitre_technique_name = "Build Image on Host"
    log_prerequisites = "Requires Linux host or in-container process launch telemetry (EDR, auditd execve or runtime sensor) populating principal.process.file.full_path, target.process.file.full_path and target.process.command_line."
    platform = "Containers"
    log_source = "container"
    false_positives = "Self-hosted build or CI web front-ends that invoke the build CLI directly, developer portals or PaaS control panels that build images on demand, and database or application containers with an embedded build hook."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts. Add build or automation accounts to %global_allowed_service_accounts. If a CI web service is a legitimate parent, allowlist it by executable path rather than by install directory."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|php-fpm[0-9.]*|php|tomcat[0-9]*|catalina|gunicorn|uwsgi|node|ruby|mysqld|mariadbd|postgres|redis-server|mongod)$/ nocase
    (
      (
        $proc.target.process.file.full_path = /\/(docker|podman|buildah|nerdctl|buildctl)$/ nocase and
        $proc.target.process.command_line = /(^|\s)(image\s+build|buildx\s+build|builder\s+build|build|bud)(\s|$)/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\/(curl|wget)$/ nocase and
        $proc.target.process.command_line = /docker\.sock|containerd\.sock|podman\.sock/ nocase and
        $proc.target.process.command_line = /\/build(\?|\s|"|'|$)/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1612")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
