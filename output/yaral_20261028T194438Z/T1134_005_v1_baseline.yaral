/*
  MITRE Technique : T1134.005 - SID-History Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:01:29.029735+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_005_SIDHistory_Attribute_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects a process launched with a command line that writes to the Active Directory sIDHistory attribute, using directory-modification cmdlets or utilities (Set-ADUser/Set-ADObject -Add/-Replace, DSInternals-style SID-history cmdlets, DsAddSidHistory, ldifde, ldapmodify). Injecting privileged SIDs into SID-History grants an account the access of another user or group, such as Enterprise Admins. The rule keys on the combination of the attribute name and a write operation, so read-only queries are not matched."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.005"
    mitre_technique_name = "Access Token Manipulation: SID-History Injection"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command-line capture (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing). Enable Security Event 4765/4766 on domain controllers as a corroborating source."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Authorised Active Directory domain migrations (ADMT or equivalent tooling) that legitimately populate SID-History; identity-management automation; administrators performing planned cross-domain account consolidation."
    tuning_guidance = "Add approved migration or identity tooling to %global_allowed_admin_tools (matched on the parent process path). Add named migration administrators to %global_allowed_admin_users. Suppress during documented migration windows at the client level rather than widening the regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /sid[-_]?history/ nocase
    $proc.target.process.command_line = /(set-ad(user|object|computer)|add-addbsidhistory|dsaddsidhistory|ldifde|ldapmodify|-(add|replace)\s*@\{)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(88)
    $mitre_technique_id = array_distinct("T1134.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
