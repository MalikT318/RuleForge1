/*
  MITRE Technique : T1543.002 - Systemd Service
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:54:00.785566+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_002_Systemd_Unit_Written_Then_Payload_From_Writable_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A systemd .service unit file is created by a non-package-manager process, and within 10 minutes systemd launches a binary from a world-writable or temporary directory (/tmp, /var/tmp, /dev/shm, /run/user) on the same host. This sequence indicates a newly installed service whose ExecStart payload runs from attacker-writable staging space, a common systemd persistence pattern."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.002"
    mitre_technique_name = "Create or Modify System Process: Systemd Service"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry (watches on /etc/systemd, /usr/lib/systemd, /lib/systemd and user unit directories) and process-launch telemetry that includes the parent process path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management or deployment tooling (Ansible, Puppet, Chef, Salt) writing units and starting services from temporary directories; software installers that unpack and run helpers from /tmp; developers testing custom services; container or CI build hosts."
    tuning_guidance = "Add approved deployment and configuration management binaries to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Add package or installer wrappers specific to the client to the writer-name exclusion. If a client legitimately runs services from /run/user, remove that directory from the payload path regex."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\/systemd\/(system|user)\/[^\/]+\.service$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|yum|dnf|zypper|pacman|snapd|packagekitd|unattended-upgrade|cloud-init)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/systemd$/ nocase
    $proc.target.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/user)\// nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1543.002")
    $primary_entity = array_distinct($hostname)
    $unit_files = array_distinct($file.target.file.full_path)
    $unit_writers = array_distinct($file.principal.process.file.full_path)
    $payload_paths = array_distinct($proc.target.process.file.full_path)
    $payload_command_lines = array_distinct($proc.target.process.command_line)
    $first_unit_write = min($file.metadata.event_timestamp.seconds)
    $last_payload_launch = max($proc.metadata.event_timestamp.seconds)

  condition:
    $file and $proc
}
