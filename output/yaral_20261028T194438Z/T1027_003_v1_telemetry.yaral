/*
  MITRE Technique : T1027.003 - Steganography
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:41:20.099847+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_003_Linux_Media_Carrier_Written_To_Staging_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of an image or audio file (a potential steganographic carrier) in a world-writable Linux staging directory (/tmp, /var/tmp, /dev/shm) by a shell, scripting interpreter or command-line downloader. Legitimate applications write media through their own binaries. A script or downloader dropping a media file into a staging path is consistent with fetching a carrier that hides a payload, or with writing a carrier that hides data for exfiltration. Detection is based on the file artifact, not the command line."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.003"
    mitre_technique_name = "Obfuscated Files or Information: Steganography"
    log_prerequisites = "Linux EDR file-creation telemetry or auditd file-write rules on /tmp, /var/tmp and /dev/shm, normalised to UDM FILE_CREATION with principal.process.file.full_path and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web scraping or reporting scripts that save images to /tmp, CI/build jobs, documentation or chart generators (matplotlib, wkhtmltoimage wrappers), package post-install scripts, and admin scripts that download logos or screenshots."
    tuning_guidance = "Add approved parent interpreters or hosts to %global_allowed_script_hosts, deployment and automation binaries to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Raise severity when the file is later read by an interpreter or sent to an external address (follow-up correlation). Extend the extension list or directory list per client if needed."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.*\.(png|jpe?g|bmp|gif|webp|tiff?|wav|mp3|flac|ogg|mp4|avi)$/ nocase
    $file.principal.process.file.full_path = /\/(sh|bash|dash|zsh|ksh|python[0-9.]*|perl|ruby|php[0-9.]*|node|lua|curl|wget)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1027.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $carrier_files = array_distinct($file.target.file.full_path)
    $creator_processes = array_distinct($file.principal.process.file.full_path)
    $acting_users = array_distinct($file.principal.user.userid)

  condition:
    $file
}
