/*
  MITRE Technique : T1556.009 - Conditional Access Policies
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:27:54.535020+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_009_IdP_Conditional_Access_Policy_Tampering {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an identity provider audit event in which a conditional access or sign-on policy or policy rule is updated, deactivated, disabled, or deleted by an account that is not an approved administrator or automation identity. Weakening these controls (removing MFA requirements, trusted-location or device-compliance conditions) lets a compromised account sign in without additional verification and persist."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.009"
    mitre_technique_name = "Modify Authentication Process: Conditional Access Policies"
    log_prerequisites = "Requires identity provider directory/admin audit logs ingested and normalised to UDM, with policy-change events populating metadata.product_event_type and principal.user.userid."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Planned policy changes by identity or security engineering teams, break-glass exclusion maintenance, infrastructure-as-code or policy-management automation, and tenant onboarding or migration projects."
    tuning_guidance = "Add approved identity administrators to %global_allowed_admin_users and policy-management automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Correlate with change tickets. If a source normalises policy changes to a different event type, deploy a sibling rule for that type rather than widening this one."

  events:
    $iam.metadata.event_type = "SETTING_MODIFICATION"
    $iam.metadata.product_event_type = /(update|delete|disable|deactivate|remove).*conditional access polic|policy\.(lifecycle|rule)\.(update|deactivate|delete)/ nocase
    $iam.principal.user.userid != ""
    not $iam.principal.user.userid in %global_allowed_admin_users
    not $iam.principal.user.userid in %global_allowed_service_accounts
    not $iam.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1556.009")
    $primary_entity = array_distinct($iam.principal.user.userid)
    $policy_action = array_distinct($iam.metadata.product_event_type)
    $policy_name = array_distinct($iam.target.resource.name)
    $source_ips = array_distinct($iam.principal.ip)

  condition:
    $iam
}
