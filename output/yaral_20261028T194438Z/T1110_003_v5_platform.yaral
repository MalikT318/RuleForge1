/*
  MITRE Technique : T1110.003 - Password Spraying
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:07:46.563640+00:00
  Reference       : https://attack.mitre.org/techniques/T1110/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1110_003_ESXi_Mgmt_Plane_Repeated_Auth_Attempts_Firewall {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a high volume of connections from one source to a single host on ESXi management ports (SSH 22, HTTPS/hostd 443, authd/NFC 902) within ten minutes. This is the perimeter-observable footprint of automated password spraying against ESXi local accounts. A firewall cannot see usernames, so the rule counts repeated session setups. It is written as a Threshold rule because one connection event cannot show spraying."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1110.003"
    mitre_technique_name = "Brute Force: Password Spraying"
    log_prerequisites = "Requires firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Firewall must log east-west traffic to hypervisor management VLANs, not only internet-facing traffic."
    platform = "ESXi"
    log_source = "firewall"
    false_positives = "vCenter and monitoring systems polling hosts, backup and replication proxies using port 443/902, automation and orchestration tools, vulnerability scanners, admin jump hosts with scripted session churn."
    tuning_guidance = "Add approved jump hosts, vCenter, backup and monitoring source addresses to %global_allowed_mgmt_sources. Add authorised scanners to %global_allowed_scanners. Raise or lower the #net threshold per client based on baseline polling volume. Correlate alerts with ESXi hostd and shell authentication failures where that telemetry is available."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 22 or $net.target.port = 443 or $net.target.port = 902)
    $net.principal.ip = $src_ip
    $net.target.ip = $dst_ip
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src_ip, $dst_ip over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1110.003")
    $primary_entity = array_distinct($dst_ip)
    $source_ips = array_distinct($src_ip)
    $targeted_ports = array_distinct($net.target.port)
    $connection_count = count($net.metadata.id)

  condition:
    #net >= 50
}
