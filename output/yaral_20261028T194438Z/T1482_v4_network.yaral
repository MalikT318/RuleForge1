/*
  MITRE Technique : T1482 - Domain Trust Discovery
  Tactic(s)       : Discovery
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:29:40.843861+00:00
  Reference       : https://attack.mitre.org/techniques/T1482
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1482_Domain_Trust_Discovery_DC_Locator_DNS {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a user-space, non-infrastructure process issuing Active Directory DC-locator SRV DNS lookups (_ldap/_gc/_kerberos/_pdc under _msdcs). This is the network-side footprint of domain and trust enumeration (DsGetDcName, DsEnumerateDomainTrusts, nltest-style and .NET/PowerShell trust discovery). Domain controllers and the OS locator are normally resolved by lsass/svchost/netlogon, so direct lookups from other processes are uncommon. The rule does not exclude internal address space, because the resolvers and domain controllers involved are internal by nature. It relies on the process exclusion lists instead."
    mitre_tactic = "Discovery"
    mitre_technique = "T1482"
    mitre_technique_name = "Domain Trust Discovery"
    log_prerequisites = "Requires Windows endpoint DNS telemetry that attributes each query to the originating process (Sysmon Event ID 22 or an EDR DNS event), normalised to NETWORK_DNS with principal.process.file.full_path and network.dns.questions.name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "AD health and diagnostic tooling run by administrators, RMM and inventory agents performing domain lookups, identity and PAM agents, VPN or NAC clients doing DC discovery, domain-join and migration utilities, and security or vulnerability scanning software."
    tuning_guidance = "Add approved admin, RMM and AD-diagnostic binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. If the regex for OS processes is too narrow for a client, extend the system-process alternation. Consider scoping by host role (e.g. exclude servers that legitimately run AD tooling) using the client's own asset context."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /^_(ldap|gc|kerberos|kpasswd)\._(tcp|udp)\.([^.]+\._sites\.)?(dc|gc|pdc|domains)\._msdcs\./ nocase
    $dns.principal.process.file.full_path != ""
    not $dns.principal.process.file.full_path = /\\(lsass|svchost|dns|ntds|dfsr|dfssvc|msmpeng|healthservice|w32tm|wininit|services|taskhostw|system)\.exe$/ nocase
    not $dns.principal.process.file.full_path in %global_allowed_admin_tools
    not $dns.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1482")
    $primary_entity = array_distinct($dns.principal.hostname)
    $querying_process = array_distinct($dns.principal.process.file.full_path)
    $querying_user = array_distinct($dns.principal.user.userid)
    $queried_names = array_distinct($dns.network.dns.questions.name)

  condition:
    $dns
}
