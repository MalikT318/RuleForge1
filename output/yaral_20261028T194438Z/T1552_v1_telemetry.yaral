/*
  MITRE Technique : T1552 - Unsecured Credentials
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:43:33.897336+00:00
  Reference       : https://attack.mitre.org/techniques/T1552
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_Linux_Container_Credential_Artifact_Staged_In_Temp_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a file in a world-writable staging directory (/tmp, /var/tmp, /dev/shm) whose name matches a well-known credential artifact: SSH private key, kubeconfig, mounted service-account token, cloud CLI credentials, container registry auth, .netrc, .pgpass or .git-credentials. This is the file-system result of an adversary copying unsecured credentials out of a container or node for staging or exfiltration. It fires on the resulting file artifact, so it still fires when command-line logging is evaded or the copy is made through a script, API or library."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552"
    mitre_technique_name = "Unsecured Credentials"
    log_prerequisites = "Requires container runtime or node-level file telemetry (EDR sensor, auditd or eBPF file events) that is normalised to UDM FILE_CREATION with target.file.full_path and principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "container"
    false_positives = "Backup and snapshot agents staging copies in /tmp, CI/CD runners and build containers that materialise kubeconfig or registry auth files for a job, configuration-management or secrets-injection agents, and admins troubleshooting inside a container."
    tuning_guidance = "Add legitimate writers to %global_allowed_backup_processes, %global_allowed_admin_tools or %global_allowed_script_hosts, and CI or automation identities to %global_allowed_service_accounts. If a build fleet is noisy, add its hostnames via a client-specific exclusion or tighten the staging directory regex."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    $file.target.file.full_path = /(\/(id_(rsa|dsa|ecdsa|ed25519)|kubeconfig|\.git-credentials|\.netrc|\.pgpass|\.s3cfg|credentials|credentials\.json|token)|\.kube\/config|\.aws\/credentials|\.docker\/config\.json|serviceaccount\/token)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1552")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
