/*
  MITRE Technique : T1098.006 - Additional Container Cluster Roles
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:49:55.194151+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_006_K8s_Burst_RoleBinding_Creation_By_Principal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single Kubernetes principal created several RoleBinding or ClusterRoleBinding objects within ten minutes. Creating one binding is routine, but a burst from one identity suggests an adversary granting extra roles to controlled accounts for persistence or privilege escalation. This rule uses control-plane audit events, not in-container command lines."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.006"
    mitre_technique_name = "Account Manipulation: Additional Container Cluster Roles"
    log_prerequisites = "Requires Kubernetes API server audit logging at Metadata level or higher, ingested and normalised to UDM RESOURCE_CREATION with principal.user.userid and target.resource.name populated for rbac.authorization.k8s.io objects."
    platform = "Containers"
    log_source = "container"
    false_positives = "GitOps controllers and CI/CD pipelines that apply RBAC manifests, Helm or operator installs that create many bindings at once, cluster bootstrap and onboarding automation, namespace provisioning tooling, and administrators doing planned RBAC rollouts."
    tuning_guidance = "Add deployment pipeline and GitOps identities to %global_allowed_service_accounts, and named cluster administrators to %global_allowed_admin_users. The threshold (#res >= 3) is deliberately conservative. Raise it for tenants with heavy automation. Review $target_bindings and $source_ips in the outcome when triaging."

  events:
    $res.metadata.event_type = "RESOURCE_CREATION"
    (
      $res.target.resource.name = /rbac\.authorization\.k8s\.io.*\b(cluster)?rolebindings\b/ nocase or
      $res.target.resource.name = /\b(cluster)?rolebindings\b/ nocase or
      $res.metadata.product_event_type = /rbac.*\b(cluster)?rolebindings\b.*create/ nocase
    )
    $res.principal.user.userid != ""
    $res.principal.user.userid = $user
    not $res.principal.user.userid in %global_allowed_service_accounts
    not $res.principal.user.userid in %global_allowed_admin_users
    not $res.principal.user.userid = /^system:(kube-controller-manager|kube-scheduler|apiserver)$/ nocase

  match:
    $user over 10m

  outcome:
    $risk_score = max(if($res.target.resource.name = /clusterrolebindings/ nocase, 85, 65))
    $event_count = count($res.metadata.id)
    $mitre_technique_id = array_distinct("T1098.006")
    $primary_entity = array_distinct($user)
    $target_bindings = array_distinct($res.target.resource.name)
    $source_ips = array_distinct($res.principal.ip)

  condition:
    #res >= 3
}
