/*
  MITRE Technique : T1132.002 - Non-Standard Encoding
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:48:45.183804+00:00
  Reference       : https://attack.mitre.org/techniques/T1132/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1132_002_Encoded_Blob_HTTP_Volume_Firewall {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source sends many HTTP requests to external destinations within 10 minutes, each carrying a long, unbroken run of base64-like or custom-alphabet characters in the URL. One such request is common on the web. Repeated requests of this kind from one host suggest C2 traffic hidden in a non-standard or modified encoding (T1132.002). Detection relies only on perimeter-observable HTTP metadata: URL content, destination, and volume per source. The rule is meant for traffic from Windows client environments. A perimeter log has no OS or process context, so scope it to Windows client address space where the client's log pipeline allows."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1132.002"
    mitre_technique_name = "Data Encoding: Non-Standard Encoding"
    log_prerequisites = "Requires firewall or proxy logs with HTTP URL visibility (explicit proxy or TLS inspection) normalised to UDM NETWORK_HTTP with principal.ip, target.url and target.hostname populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "SaaS and CDN tokens, OAuth and JWT-bearing URLs, telemetry and update beacons, signed or pre-signed storage URLs, analytics and ad-tech tracking calls, and software licensing checks that embed long encoded identifiers."
    tuning_guidance = "Add known-good destination domains to %global_allowed_domains and vulnerability scanners to %global_allowed_scanners. Raise the #http threshold (default 10) or the run length in the regex (default 100 characters) on noisy tenants. Raise severity only when the same source also shows rare destinations or fixed-interval beaconing."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.principal.ip = $src_ip
    $http.target.url = /[A-Za-z0-9+\/_\-]{100,}={0,2}/
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  match:
    $src_ip over 10m

  outcome:
    $risk_score = if(count($http.metadata.id) >= 30, 85, 60)
    $mitre_technique_id = array_distinct("T1132.002")
    $primary_entity = array_distinct($src_ip)
    $event_count = count($http.metadata.id)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)

  condition:
    #http >= 10
}
