/*
  MITRE Technique : T1027.005 - Indicator Removal from Tools
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:45:44.086484+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_005_LOLBin_Fetches_Executable_Content_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a built-in Windows download-capable binary or script host making an HTTP request to an external destination for executable or script content (PE, DLL, script, or installer extensions). After a tool is detected or quarantined, adversaries commonly strip the detected indicators and re-stage the modified build from remote infrastructure. This rule observes that re-delivery on the network side, independent of the process command line. It is a behavioural proxy for the technique, not proof of retooling."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.005"
    mitre_technique_name = "Obfuscated Files or Information: Indicator Removal from Tools"
    log_prerequisites = "Requires NETWORK_HTTP events (proxy, EDR network telemetry, or Sysmon-equivalent) that populate target.url and principal.process.file.full_path. Without the initiating process path populated, the rule will not match."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software deployment and patching scripts that pull installers or modules with PowerShell or BITS, package managers (curl-based installers), vendor update stubs fetching DLL or MSI content, and admins downloading tooling from external vendor sites."
    tuning_guidance = "Add approved vendor and update domains to %global_allowed_domains. Add sanctioned deployment tooling to %global_allowed_admin_tools. Add known script-hosting parents to %global_allowed_script_hosts. Tighten or widen the extension list per client baseline. Raise severity for servers or hosts with no history of downloader activity."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.principal.process.file.full_path = /\\(certutil|bitsadmin|powershell|pwsh|mshta|curl|wscript|cscript|regsvr32|rundll32)\.exe$/ nocase
    $net.target.url = /\.(exe|dll|scr|bin|dat|msi|ps1|hta|vbs|jse?)([?#].*)?$/ nocase
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1027.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $user = array_distinct($net.principal.user.userid)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $requested_url = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
