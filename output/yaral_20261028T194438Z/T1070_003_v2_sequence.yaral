/*
  MITRE Technique : T1070.003 - Clear Command History
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:03:29.185909+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_003_NetDevice_Mgmt_Session_Then_History_Clear {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a management-plane session (SSH or Telnet) to a network device from a source outside the approved management sources, followed within 10 minutes by a configuration or audit event on the same device showing the CLI history or logging buffer being cleared. This sequence indicates an operator hiding commands after gaining device access."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.003"
    mitre_technique_name = "Indicator Removal: Clear Command History"
    log_prerequisites = "Requires perimeter or firewall connection logs showing management-port sessions to the device, plus the same device's management-plane command audit or configuration-change syslog normalised to SETTING_MODIFICATION with the command text in security_result.description. Hostname must be populated consistently in both feeds (target.hostname on connections, principal.hostname on audit events)."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised network engineers doing log rotation or maintenance from a jump host not yet in the approved list, scheduled housekeeping scripts that clear logging buffers, device commissioning or decommissioning, and lab or staging devices reset between tests."
    tuning_guidance = "Populate %global_allowed_mgmt_sources with approved jump hosts and management subnets, %global_allowed_admin_users with named network administrators, and %global_allowed_service_accounts with automation accounts. If target.hostname is not populated on connection logs for a client, normalise the device hostname in the parser before enabling the rule. Adjust the command regex to the client's device CLI dialect."

  events:
    $mgmt.metadata.event_type = "NETWORK_CONNECTION"
    ($mgmt.target.port = 22 or $mgmt.target.port = 23)
    not $mgmt.principal.ip in %global_allowed_mgmt_sources
    $mgmt.target.hostname = $device

    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.security_result.description = /\b(clear\s+(logging|history|log|archive)|erase\s+(log|logging|history)|history\s+clear|terminal\s+history\s+size\s+0|no\s+logging\s+(buffered|console|monitor))\b/ nocase
    not $cfg.principal.user.userid in %global_allowed_admin_users
    not $cfg.principal.user.userid in %global_allowed_service_accounts
    $cfg.principal.hostname = $device

    $mgmt.metadata.event_timestamp.seconds <= $cfg.metadata.event_timestamp.seconds

  match:
    $device over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1070.003")
    $primary_entity = array_distinct($device)
    $source_ips = array_distinct($mgmt.principal.ip)
    $management_ports = array_distinct($mgmt.target.port)
    $acting_users = array_distinct($cfg.principal.user.userid)
    $clear_commands = array_distinct($cfg.security_result.description)
    $session_count = count($mgmt.metadata.id)

  condition:
    $mgmt and $cfg
}
