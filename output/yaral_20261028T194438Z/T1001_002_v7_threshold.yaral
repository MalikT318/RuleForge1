/*
  MITRE Technique : T1001.002 - Steganography
  Tactic(s)       : Command and Control
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:09:15.754146+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_002_ESXi_Repeated_External_Image_Fetch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single host makes repeated outbound HTTP requests for image files (jpg, png, gif, bmp, webp, tiff) to external destinations within ten minutes. ESXi management interfaces have no business browsing for images. Repeated image retrieval from a hypervisor is consistent with polling a steganographic carrier for hidden C2 instructions or payloads. A single request is benign. The volume and repetition from one host is the signal."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001.002"
    mitre_technique_name = "Data Obfuscation: Steganography"
    log_prerequisites = "Requires firewall or web proxy logs normalised to UDM NETWORK_HTTP with target.url populated and the source host resolvable in principal.hostname (via DHCP/DNS/asset enrichment). Egress from ESXi management VMkernel interfaces must traverse the logging perimeter device."
    platform = "ESXi"
    log_source = "firewall"
    false_positives = "Hypervisor management or monitoring appliances fetching icons or branding images, vendor update or health-check portals served via image URLs, jump hosts or admin workstations whose management address is mislabelled as the ESXi host, and proxy-mediated browsing by administrators from an ESXi shell or console."
    tuning_guidance = "Add known-good vendor and update domains to %global_allowed_domains. Scope the rule to hypervisor management addresses through asset enrichment or a client-specific wrapper so it does not fire on general user hosts. Raise the #net threshold (default 5) in noisy environments. If a legitimate management appliance is identified, exclude its egress path at the proxy log level."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\.(jpe?g|png|gif|bmp|webp|tiff?)(\?.*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    $net.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1001.002")
    $primary_entity = array_distinct($host)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)

  condition:
    #net >= 5
}
