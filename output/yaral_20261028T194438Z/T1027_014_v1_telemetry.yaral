/*
  MITRE Technique : T1027.014 - Polymorphic Code
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:00:10.600337+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_014_Linux_TempExec_Writes_Random_Named_File {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a process that is itself running from a world-writable staging directory (/tmp, /var/tmp, /dev/shm) creating a new extensionless, random-looking filename in a staging directory. This is the file artifact left by self-mutating (polymorphic) malware that drops a fresh variant of itself on each run. It does not rely on command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.014"
    mitre_technique_name = "Obfuscated Files or Information: Polymorphic Code"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry that populates principal.process.file.full_path and target.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software installers or self-extracting archives run from /tmp, build and CI jobs that compile in temp directories, language runtime or package-manager caches using random temp names, and in-house tools that create randomised scratch files."
    tuning_guidance = "Add legitimate installers and build tooling to %global_allowed_admin_tools, approved security agents to %global_allowed_security_tools, and CI or automation accounts to %global_allowed_service_accounts. Adjust the name-length quantifier ({8,32}) if mktemp-style names in your estate cause noise."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/\.?[a-z0-9]{8,32}$/ nocase
    $file.target.file.full_path = /[a-z][0-9]|[0-9][a-z]/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1027.014")
    $primary_entity = array_distinct($file.principal.hostname)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $dropped_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
