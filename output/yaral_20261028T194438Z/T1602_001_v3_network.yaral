/*
  MITRE Technique : T1602.001 - SNMP (MIB Dump)
  Tactic(s)       : Collection
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:18:20.333312+00:00
  Reference       : https://attack.mitre.org/techniques/T1602/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_001_External_SNMP_Query_To_Managed_Device {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an SNMP (UDP/161) connection from a non-internal source address to a managed device, as observed at the network perimeter. SNMP should only be reachable from approved management stations. External SNMP polling is characteristic of MIB dumping to collect routing tables, interface details, device configuration and network topology."
    mitre_tactic = "Collection"
    mitre_technique = "T1602.001"
    mitre_technique_name = "Data from Configuration Repository: SNMP (MIB Dump)"
    log_prerequisites = "Requires firewall or perimeter connection logs that record allowed and denied traffic with source IP and destination port, normalised to UDM NETWORK_CONNECTION."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Third-party or MSP monitoring platforms polling devices across the perimeter, authorised vulnerability scanners and penetration tests, cloud-hosted network monitoring services, and misconfigured NMS appliances using public addresses."
    tuning_guidance = "Add approved monitoring and NMS source addresses to %global_allowed_mgmt_sources and authorised scan sources to %global_allowed_scanners. Confirm %rfc1918_internal covers the client's internal address space. If the firewall also logs denied traffic, a high volume of hits from one source may indicate internet scanning, so consider a lower severity or a separate threshold rule."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 161
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1602.001")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
