/*
  MITRE Technique : T1036 - Masquerading
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:55:55.905625+00:00
  Reference       : https://attack.mitre.org/techniques/T1036
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_Container_Pod_Masquerading_System_Component_Name {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a pod whose name imitates a core Kubernetes or CNI/CSI system component (kube-proxy, coredns, etcd, calico-node and similar) by an identity that is not a cluster system component or an approved automation or admin account. Attackers name malicious workloads after control-plane or node-agent pods so they blend into kubectl and dashboard listings and escape review."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036"
    mitre_technique_name = "Masquerading"
    log_prerequisites = "Requires Kubernetes API audit logs (create verb on pods) ingested and normalized to UDM RESOURCE_CREATION with target.resource.resource_type and target.resource.name populated, and principal.user.userid carrying the authenticated Kubernetes username."
    platform = "Containers"
    log_source = "container"
    false_positives = "Platform engineers or GitOps and Helm pipelines installing or upgrading CNI, CSI, DNS or metrics add-ons under a human or CI identity; managed-cluster add-on controllers using non-system usernames; cluster bootstrap or disaster-recovery tooling re-creating system pods; static or mirror pods for etcd and kube-apiserver created by an unconventional node identity."
    tuning_guidance = "Add GitOps, CI/CD and add-on installer identities to %global_allowed_service_accounts, and platform administrators to %global_allowed_admin_users. Add managed-service identities to %global_allowed_cloud_principals. Extend or trim the component-name regex to match the add-ons deployed in each client cluster. If namespace is populated in the client's UDM mapping, add a condition for namespace not equal to the system namespace to raise fidelity."

  events:
    $k8s.metadata.event_type = "RESOURCE_CREATION"
    $k8s.target.resource.resource_type = "POD"
    $k8s.target.resource.name = /^(kube-(proxy|apiserver|controller-manager|scheduler|dns)|coredns|etcd|kubelet|calico-node|calico-kube-controllers|cilium|flannel|aws-node|azure-ip-masq-agent|metrics-server|node-local-dns|csi-[a-z0-9-]+|ebs-csi|efs-csi)(-|$)/ nocase
    $k8s.principal.user.userid != ""
    not $k8s.principal.user.userid = /^system:(serviceaccount:kube-system:|node:|kube-controller-manager|kube-scheduler|apiserver)/ nocase
    not $k8s.principal.user.userid in %global_allowed_service_accounts
    not $k8s.principal.user.userid in %global_allowed_admin_users
    not $k8s.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1036")
    $primary_entity = array_distinct($k8s.principal.user.userid)
    $pod_names = array_distinct($k8s.target.resource.name)
    $source_ips = array_distinct($k8s.principal.ip)

  condition:
    $k8s
}
