/*
  MITRE Technique : T1197 - BITS Jobs
  Tactic(s)       : Stealth, Persistence, Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:46:25.049580+00:00
  Reference       : https://attack.mitre.org/techniques/T1197
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1197_BITS_Service_Drops_Executable_Then_Executed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "The BITS service host (svchost) writes an executable file into a user-writable location, and that same file is launched as a process on the same host within 10 minutes. This is the download-then-execute result of a BITS job abuse. It does not rely on bitsadmin or PowerShell command lines, so it covers COM API and cmdlet-based jobs."
    mitre_tactic = "Stealth, Persistence, Execution"
    mitre_technique = "T1197"
    mitre_technique_name = "BITS Jobs"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry that records the writing process (svchost command line) and process-launch telemetry with the full image path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate updaters that use BITS to stage installers in ProgramData or Temp and then run them (software update agents, Windows Update components, application self-updaters, RMM or deployment tools)."
    tuning_guidance = "Add approved updater or deployment parent processes to %global_allowed_admin_tools. If the svchost command-line match returns no events in your environment, relax the principal.process.command_line filter to match svchost alone and rely on the path and extension filters."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\svchost\.exe$/ nocase
    $file.principal.process.command_line = /(-s\s+BITS|netsvcs)/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\|programdata\\|windows\\temp\\|temp\\).*\.(exe|scr|com)$/ nocase
    $file.target.file.full_path = $path
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\.(exe|scr|com)$/ nocase
    $proc.target.process.file.full_path = $path
    $proc.principal.hostname = $hostname
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1197")
    $primary_entity = array_distinct($hostname)
    $dropped_file = array_distinct($path)
    $launch_parent = array_distinct($proc.principal.process.file.full_path)
    $launch_command_line = array_distinct($proc.target.process.command_line)
    $launch_user = array_distinct($proc.principal.user.userid)
    $event_count = count($proc.metadata.id)

  condition:
    $file and $proc
}
