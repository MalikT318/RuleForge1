/*
  MITRE Technique : T1546.005 - Trap
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:07:01.987521+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_005_Linux_Shell_Startup_File_Modified_Trap_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects modification of shell startup and logout files (user rc, profile, bash_logout, and /etc/profile.d scripts) by a non-editor process. These files run automatically on shell start or exit, so they are common places to plant a 'trap' handler (for example trap 'cmd' EXIT, or SIGINT/SIGTERM) for persistence or privilege escalation. This rule works at the file-artifact layer and does not depend on command-line logging. File telemetry does not expose file content, so the rule flags the persistence location being changed, not the trap string itself."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.005"
    mitre_technique_name = "Event Triggered Execution: Trap"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-write watches (-w on /etc/profile, /etc/profile.d, /etc/bash.bashrc, and home-directory rc files) normalised to UDM FILE_MODIFICATION with principal.process and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management (Ansible, Puppet, Chef, Salt), cloud-init and provisioning scripts, package installs that drop /etc/profile.d scripts, user-provisioning tools such as useradd/adduser copying skeleton files, developer tooling installers (nvm, pyenv, conda, sdkman) appending to .bashrc, and admins editing profiles via scripts."
    tuning_guidance = "Add configuration-management and deployment binaries to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. If installer noise is high in developer fleets, scope by host group, or add the installer parent process to %global_allowed_admin_tools. If the EDR reports newly created profile.d files as FILE_CREATION, deploy a cloned rule for that event type."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /(^|\/)\.(bashrc|bash_profile|bash_login|bash_logout|profile|zshrc|zprofile|zlogin|zlogout|zshenv)$|^\/etc\/(profile|bash\.bashrc|bashrc|zsh\/zshrc|zsh\/zshenv|zsh\/zlogout)$|^\/etc\/profile\.d\/[^\/]+\.sh$/ nocase
    not $file.principal.process.file.full_path = /\/(vim|vi|nvim|nano|emacs|gedit|pico|ed|dpkg|rpm|apt|apt-get|yum|dnf|zypper|useradd|adduser|usermod|cloud-init|systemd-tmpfiles)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1546.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
