/*
  MITRE Technique : T1600.002 - Disable Crypto Hardware
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:08:59.037116+00:00
  Reference       : https://attack.mitre.org/techniques/T1600/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_002_External_Mgmt_Plane_Access_To_Device {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a connection from a non-internal source to an internal device on a management-plane port (SSH, Telnet, NETCONF, SNMP). Disabling dedicated crypto hardware (T1600.002) needs privileged management access to the device, typically via a system image or configuration change. This rule cannot see the hardware change itself, so it flags the network-side precondition: management access from outside trusted address space and approved management sources."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1600.002"
    mitre_technique_name = "Network Device CLI: Disable Crypto Hardware"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to NETWORK_CONNECTION with populated principal.ip, target.ip and target.port. The firewall must log traffic permitted to internal management interfaces."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Remote administration by network engineers over VPN or from a NAT egress address not yet on the allowlist, managed-service or vendor support sessions, external monitoring or SNMP pollers, and authorised penetration tests or scans."
    tuning_guidance = "Add approved administration jump hosts, VPN egress ranges and monitoring sources to %global_allowed_mgmt_sources. Expect a small number of per-tenant additions at onboarding. If the firewall logs VPN-assigned client addresses, confirm they fall inside %rfc1918_internal. Review any hit alongside configuration-change events on the target device."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 161 or
      $net.target.port = 830
    )
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1600.002")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $mgmt_ports = array_distinct($net.target.port)

  condition:
    $net
}
