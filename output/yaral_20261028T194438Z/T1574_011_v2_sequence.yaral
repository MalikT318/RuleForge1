/*
  MITRE Technique : T1574.011 - Services Registry Permissions Weakness
  Tactic(s)       : Stealth, Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:41:32.628871+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_011_Service_Registry_Modify_Then_Services_Launch_From_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a service's ImagePath, ServiceDll or FailureCommand registry value being modified on a host, followed within 10 minutes by services.exe launching a child binary from a user-writable location (Users, ProgramData, Temp, Public, PerfLogs) on the same host. This is the result of a service registry hijack and is independent of sc.exe or reg.exe command lines."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.011"
    mitre_technique_name = "Hijack Execution Flow: Services Registry Permissions Weakness"
    log_prerequisites = "Requires EDR or Sysmon registry-value-set telemetry (Sysmon Event ID 13 equivalent) for HKLM\\SYSTEM\\CurrentControlSet\\Services, plus process-creation telemetry with parent process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Third-party software installers or updaters that register services running from ProgramData or user-profile paths (for example per-user agents, collaboration clients, developer tools); RMM and deployment agents that rewrite ImagePath during upgrades; software packaged to run services from C:\\ProgramData."
    tuning_guidance = "Add approved installer, deployment and patching binaries to %global_allowed_admin_tools, which is applied to both the registry-writing process and the launched service binary. Add EDR and AV service binaries to %global_allowed_security_tools. If a client runs legitimate services from ProgramData, add those executable paths to %global_allowed_admin_tools rather than widening the path regex."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\CurrentControlSet\\Services\\[^\\]+/ nocase
    (
      $reg.target.registry.registry_value_name = /^(ImagePath|ServiceDll|FailureCommand)$/ nocase or
      $reg.target.registry.registry_key = /\\(ImagePath|ServiceDll|FailureCommand)$/ nocase
    )
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|msiexec|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    $reg.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\services\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(users\\[^\\]+|programdata|windows\\temp|temp|appdata|users\\public|perflogs)\\.*\.(exe|dll|bat|cmd|scr)$/ nocase
    not $proc.target.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|NisSrv)\.exe$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_security_tools
    $proc.principal.hostname = $hostname

    $reg.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1574.011")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_registry_keys = array_distinct($reg.target.registry.registry_key)
    $modified_value_names = array_distinct($reg.target.registry.registry_value_name)
    $registry_writer_processes = array_distinct($reg.principal.process.file.full_path)
    $launched_service_binaries = array_distinct($proc.target.process.file.full_path)
    $registry_event_count = count($reg.metadata.id)

  condition:
    $reg and $proc
}
