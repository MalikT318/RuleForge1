/*
  MITRE Technique : T1566.001 - Spearphishing Attachment
  Tactic(s)       : Initial Access
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:47:17.687660+00:00
  Reference       : https://attack.mitre.org/techniques/T1566/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1566_001_Linux_Network_Scripted_Fetch_Of_Attachment_Type_File {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux host fetching an attachment-style file (script, ELF/binary, archive, disk image, macro document, shortcut) from an external destination over HTTP using a non-browser command-line client user agent. This is the network-side footprint of a payload retrieved after a spearphishing attachment (for example a dropper that stages a second-stage file). It is based on proxy or firewall HTTP telemetry only and does not depend on endpoint process or command-line data."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1566.001"
    mitre_technique_name = "Phishing: Spearphishing Attachment"
    log_prerequisites = "Requires proxy or firewall HTTP logging (URL inspection or explicit proxy) normalised to UDM NETWORK_HTTP with target.url, network.http.user_agent and network.http.method populated. Encrypted traffic needs TLS inspection for URL visibility."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "DevOps and CI/CD automation pulling release archives or install scripts, configuration management agents, developers using curl or wget for legitimate downloads, vendor installers, and internal mirrors that resolve to public IPs."
    tuning_guidance = "Add known-good vendor, mirror and repository domains to %global_allowed_domains. Add build servers, jump hosts and automation hosts to %global_allowed_script_hosts. Narrow or extend the file extension and user agent regexes to match client conventions. Raise severity for user workstations versus servers using asset context."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.network.http.user_agent = /(?i)^(curl|wget|python-requests|python-urllib|libwww-perl|go-http-client)/
    $http.target.url = /(?i)\.(sh|bin|elf|run|appimage|jar|pl|py|zip|rar|7z|iso|docm|xlsm|hta|lnk|scr)(\?.*)?$/
    $http.principal.hostname != ""
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1566.001")
    $primary_entity = array_distinct($http.principal.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
