/*
  MITRE Technique : T1087.004 - Cloud Account
  Tactic(s)       : Discovery
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:57:40.573651+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_004_Cloud_Login_Then_Account_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects an identity authenticating and then, within ten minutes, making repeated cloud IAM enumeration API calls (list users, roles, groups, service accounts, IAM policies). This pattern is typical of an adversary or compromised credential mapping cloud accounts after gaining access. It is based on audit-log API activity, not process command lines."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.004"
    mitre_technique_name = "Account Discovery: Cloud Account"
    log_prerequisites = "Requires cloud control-plane audit logs (for example IAM/directory read-API auditing, which is often not enabled by default) and identity sign-in logs, both normalized to UDM with principal.user.userid populated and the API operation name in metadata.product_event_type."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Identity governance and access-review tools, CSPM and inventory scanners, IaC pipelines (plan/refresh calls), IT admins performing user audits or onboarding, and SSO/provisioning connectors that sync directory objects."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, cloud service principals to %global_allowed_cloud_principals, and named admins to %global_allowed_admin_users. Add trusted sign-in sources to %global_allowed_mgmt_sources. Raise the #list threshold in condition for noisy tenants, or lower it for high-security environments. Widen or narrow the operation-name regex to match the audit schema your tenant produces."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.principal.user.userid = $user
    not $login.principal.ip in %global_allowed_mgmt_sources
    not $login.principal.user.userid in %global_allowed_service_accounts
    not $login.principal.user.userid in %global_allowed_cloud_principals
    not $login.principal.user.userid in %global_allowed_admin_users

    $list.metadata.event_type = "USER_RESOURCE_ACCESS"
    $list.metadata.product_event_type = /(ListUsers|ListRoles|ListGroups|ListGroupsForUser|ListServiceAccounts|ListRoleAssignments|ListEntitiesForPolicy|GetAccountAuthorizationDetails|GetIamPolicy)/ nocase
    $list.principal.user.userid = $user
    not $list.principal.user.userid in %global_allowed_service_accounts
    not $list.principal.user.userid in %global_allowed_cloud_principals
    not $list.principal.user.userid in %global_allowed_admin_users

    $login.metadata.event_timestamp.seconds <= $list.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1087.004")
    $primary_entity = array_distinct($user)
    $enumeration_calls = array_distinct($list.metadata.product_event_type)
    $enumeration_count = count($list.metadata.id)
    $login_source_ips = array_distinct($login.principal.ip)

  condition:
    $login and #list >= 3
}
