/*
  MITRE Technique : T1547.005 - Security Support Provider
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:31:05.195896+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_005_LSASS_Outbound_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the LSASS process (lsass.exe), which hosts loaded Security Support Provider DLLs, initiating a network connection to a non-internal address. Legitimate LSASS traffic (Kerberos, LDAP, NetLogon, SMB/RPC to domain controllers) stays on internal address space. A malicious or rogue SSP (for example one that logs plaintext credentials and ships them out) loaded into LSASS will make the connection in-process. This is network-side coverage that complements endpoint registry and process rules."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.005"
    mitre_technique_name = "Boot or Logon Autostart Execution: Security Support Provider"
    log_prerequisites = "Requires endpoint network telemetry that attributes the connection to the initiating process (EDR or Sysmon Event ID 3 equivalent) and populates principal.process.file.full_path and target.ip."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Hybrid or Azure AD-joined hosts where LSASS contacts cloud identity endpoints; certificate revocation (CRL/OCSP) or AIA lookups from LSASS; domain controllers or servers with public DNS or NTP dependencies; external Kerberos or LDAP trusts over non-RFC1918 space; security agents that hook LSASS and attribute their own traffic to it."
    tuning_guidance = "Add known-good cloud identity and PKI domains to %global_allowed_domains. If the tenant uses public IP space internally, extend %rfc1918_internal. Review destination IPs and ports in the outcome. Prioritise hosts that also show registry changes to Lsa\\Security Packages or OSConfig\\Security Packages."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\lsass\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not re.regex($net.target.ip, `^(127\.|169\.254\.|::1$|(?i)fe80:)`)
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1547.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $destination_hosts = array_distinct($net.target.hostname)

  condition:
    $net
}
