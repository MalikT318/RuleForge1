/*
  MITRE Technique : T1619 - Cloud Storage Object Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:43:27.738871+00:00
  Reference       : https://attack.mitre.org/techniques/T1619
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1619_Cloud_Storage_Object_Enumeration_External_Principal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a storage object-listing API call (list objects, list object versions, list blobs) made by an identity that is not an approved service account, admin, or cloud principal, from a non-internal source address. Object enumeration is typically the first step before bulk retrieval of data from cloud storage."
    mitre_tactic = "Discovery"
    mitre_technique = "T1619"
    mitre_technique_name = "Cloud Storage Object Discovery"
    log_prerequisites = "Cloud control-plane audit logs with data-plane or storage object-level logging enabled (object-level data events), ingested and normalised to UDM USER_RESOURCE_ACCESS with metadata.product_event_type populated with the API operation name."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Developers and data engineers browsing buckets or containers from home or office networks, backup and sync tooling, data-lake and analytics jobs running under unlisted identities, third-party SaaS integrations with delegated storage access, and cloud-console browsing by administrators not yet in the allowlist."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, trusted service principals to %global_allowed_cloud_principals, and named administrators to %global_allowed_admin_users. If a client's logs record internal NAT egress ranges, extend the source-address exclusion. For noisy environments, pair this rule with a threshold or correlation rule on list-then-read volume per identity."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /^(ListObjects|ListObjectsV2|ListObjectVersions|ListBlobs|ListBlobsFlat|storage\.objects\.list)$/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.ip in %rfc1918_internal
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1619")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $source_ips = array_distinct($cloud.principal.ip)
    $storage_resources = array_distinct($cloud.target.resource.name)
    $api_operations = array_distinct($cloud.metadata.product_event_type)

  condition:
    $cloud
}
