/*
  MITRE Technique : T1005 - Data from Local System
  Tactic(s)       : Collection
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:12:01.981928+00:00
  Reference       : https://attack.mitre.org/techniques/T1005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1005_ESXi_Mgmt_SSH_Then_Large_External_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an SSH session to an ESXi host from a source outside the approved management sources, followed within 10 minutes by a large outbound transfer from the same host to an external destination. This pattern is consistent with an adversary collecting VM files or datastore content from the local system and staging it for exfiltration. Detection is network-observable only."
    mitre_tactic = "Collection"
    mitre_technique = "T1005"
    mitre_technique_name = "Data from Local System"
    log_prerequisites = "Requires perimeter firewall or proxy flow logs that cover ESXi management VLAN traffic, normalised to NETWORK_CONNECTION and NETWORK_FLOW with principal.ip, target.ip, target.port, target.hostname and network.sent_bytes populated. ESXi host names should contain 'esx' or 'vmhost'; adjust the regex if the naming convention differs."
    platform = "ESXi"
    log_source = "firewall"
    false_positives = "Administrators using SSH for break-glass maintenance who then upload support bundles (vm-support) to a vendor; approved offsite backup or replication jobs; VM export or OVF upload to an external cloud; patch or ISO sync from a vendor repository, if the connection direction is mis-normalised."
    tuning_guidance = "Add approved jump hosts and admin subnets to %global_allowed_mgmt_sources. Add vendor support, backup and replication destinations to %global_allowed_domains. Adjust the 100 MB sent_bytes threshold to the environment's baseline. Extend the target.hostname regex to match local ESXi naming conventions."

  events:
    $in.metadata.event_type = "NETWORK_CONNECTION"
    $in.target.port = 22
    $in.target.hostname = /(esx|vmhost)/ nocase
    not $in.principal.ip in %global_allowed_mgmt_sources
    $in.target.ip = $esxi_ip

    $out.metadata.event_type = "NETWORK_FLOW"
    $out.network.sent_bytes > 104857600
    not $out.target.ip in %rfc1918_internal
    not $out.target.hostname in %global_allowed_domains
    $out.principal.ip = $esxi_ip

    $in.metadata.event_timestamp.seconds <= $out.metadata.event_timestamp.seconds

  match:
    $esxi_ip over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1005")
    $primary_entity = array_distinct($esxi_ip)
    $ssh_source_ips = array_distinct($in.principal.ip)
    $external_destinations = array_distinct($out.target.ip)
    $total_bytes_sent = sum($out.network.sent_bytes)
    $flow_count = count($out.metadata.id)

  condition:
    $in and $out
}
