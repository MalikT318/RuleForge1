/*
  MITRE Technique : T1569 - System Services
  Tactic(s)       : Execution
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:09:01.962066+00:00
  Reference       : https://attack.mitre.org/techniques/T1569
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_Linux_Systemd_Run_Transient_Service_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects systemd-run creating a transient service or scope that executes a shell one-liner, a download or network utility, an encoded payload, or a binary staged in a world-writable directory (/tmp, /var/tmp, /dev/shm). Adversaries abuse systemd transient units to run commands through the service manager, which detaches them from the login session and gives them a service-manager parent."
    mitre_tactic = "Execution"
    mitre_technique = "T1569"
    mitre_technique_name = "System Services"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records (SYSCALL/EXECVE) normalised to UDM PROCESS_LAUNCH with populated target.process.file.full_path and target.process.command_line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators running ad-hoc maintenance with systemd-run; configuration management or orchestration agents launching transient units; CI/CD runners and container tooling that wrap jobs in transient scopes; developers testing resource-limited jobs from /tmp."
    tuning_guidance = "Add approved automation parent binaries to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and named administrators to %global_allowed_admin_users. Hosts with heavy CI or orchestration use may need an additional exclusion on %global_allowed_script_hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/systemd-run$/ nocase
    $proc.target.process.command_line = /(\/(tmp|dev\/shm|var\/tmp)\/|\b(ba|da|z|k|c)?sh\s+-c\b|\b(curl|wget|nc|ncat|socat)\b|base64\s+(-d|--decode)|\/dev\/tcp\/|\b(python[0-9.]*|perl|ruby)\s+-(c|e)\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1569")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
