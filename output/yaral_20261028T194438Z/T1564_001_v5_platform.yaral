/*
  MITRE Technique : T1564.001 - Hidden Files and Directories
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:14:41.184806+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_001_Linux_Hidden_File_In_Staging_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a dot-prefixed (hidden) file or directory inside world-writable staging locations (/tmp, /var/tmp, /dev/shm) on Linux. Adversaries hide payloads, staged data and implants this way so they do not appear in default ls output. This rule uses file-creation telemetry rather than process command lines, so it also catches hidden files dropped by compiled binaries, scripts and in-memory loaders that never invoke a visible 'touch' or 'mkdir' command."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.001"
    mitre_technique_name = "Hide Artifacts: Hidden Files and Directories"
    log_prerequisites = "Requires Linux EDR file-creation telemetry or auditd file-creation records (PATH/CREATE syscall auditing on /tmp, /var/tmp and /dev/shm) normalised to UDM FILE_CREATION with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "X11/ICE/font session sockets and directories, editor swap and backup files (vim, nano), browser and desktop-app temp directories, database client sockets, package managers and configuration management agents (Ansible, Puppet, Chef) that create hidden temp files, and developer build tooling."
    tuning_guidance = "Add approved writer binaries to %global_allowed_admin_tools, %global_allowed_backup_processes or %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Extend the benign-name regex for environment-specific application temp files. Raise severity or pair with execution telemetry when the writer is an interpreter or network-facing service."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/([^\/]+\/)*\.[^\/]+$/ nocase
    not $file.target.file.full_path = /\/\.(X11-unix|ICE-unix|font-unix|XIM-unix|Test-unix|s\.PGSQL|org\.chromium|com\.google|mozilla|dbus|esd-auth|X[0-9]+-lock)/ nocase
    not $file.target.file.full_path = /\.(swp|swx|swo|swn)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1564.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $hidden_paths = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
