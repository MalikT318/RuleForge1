/*
  MITRE Technique : T1078 - Valid Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:28:36.542734+00:00
  Reference       : https://attack.mitre.org/techniques/T1078
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_Account_RDP_Logon_Fanout_1h {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single account performs a high volume of remote interactive (RDP-style) logons within one hour. Each logon is routine, but a high count for one account suggests a valid account used by an adversary for lateral movement or hands-on access. Failed logons (BLOCK) are excluded where the action field is populated."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078"
    mitre_technique_name = "Valid Accounts"
    log_prerequisites = "Requires Windows Security logon events (4624) or equivalent identity and directory sign-in telemetry normalised to USER_LOGIN, with the logon mechanism and target user populated."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Helpdesk and IT admins on jump hosts, RDS/VDI session brokers reconnecting users, monitoring or RMM accounts, users with unstable RDP sessions that reconnect repeatedly."
    tuning_guidance = "Add approved service accounts to %global_allowed_service_accounts, named administrators to %global_allowed_admin_users, and jump or bastion hosts to %global_allowed_remote_mgmt. Raise the #auth threshold for environments with large RDS farms."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.extensions.auth.mechanism = "REMOTE_INTERACTIVE"
    $auth.target.user.userid = $user
    $auth.target.user.userid != ""
    $auth.target.hostname != ""
    not $auth.target.user.userid = /\$$/
    not $auth.target.user.userid = /^(anonymous logon|system|local service|network service|dwm-\d+|umfd-\d+)$/ nocase
    not $auth.security_result.action = "BLOCK"
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.principal.hostname in %global_allowed_remote_mgmt

  match:
    $user over 1h

  outcome:
    $risk_score = max(60)
    $event_count = count($auth.metadata.id)
    $mitre_technique_id = array_distinct("T1078")
    $primary_entity = array_distinct($user)
    $source_hosts = array_distinct($auth.principal.hostname)
    $target_hosts = array_distinct($auth.target.hostname)

  condition:
    #auth >= 10
}
