/*
  MITRE Technique : T1087.003 - Email Account
  Tactic(s)       : Discovery
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:56:47.916337+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_003_Mailbox_Platform_Address_List_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an administrative or audited operation that enumerates the global address list, address lists or offline address book in a hosted mailbox platform. Adversaries with an authenticated session use these operations to harvest email addresses and accounts. This is cloud control-plane coverage and is additive to endpoint command-line detections."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.003"
    mitre_technique_name = "Account Discovery: Email Account"
    log_prerequisites = "Unified audit logs for the mailbox platform must be ingested with admin or cmdlet auditing enabled, so that the operation name is populated in metadata.product_event_type. Read-only cmdlet auditing may need to be enabled explicitly in the tenant."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Messaging administrators performing address book maintenance, migration or hybrid-sync tooling, directory synchronisation service accounts, eDiscovery or compliance tooling, and mail-client sync services that legitimately fetch address lists."
    tuning_guidance = "Add expected service identities to %global_allowed_service_accounts, named messaging administrators to %global_allowed_admin_users, and approved automation principals to %global_allowed_cloud_principals. Source IPs for trusted management hosts can be excluded using %global_allowed_mgmt_sources."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /^(Get-GlobalAddressList|Get-AddressList|Get-OfflineAddressBook)$/ nocase
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1087.003")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $operations = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
