/*
  MITRE Technique : T1052.001 - Exfiltration over USB
  Tactic(s)       : Exfiltration
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:43:25.763694+00:00
  Reference       : https://attack.mitre.org/techniques/T1052/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1052_001_Linux_Bulk_Copy_To_Removable_Media {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux copy, sync or archive utility moving data from user, system or application directories (home, root, etc, srv, opt, tmp, var/lib|www|backups|log|mail) onto a removable-media mount point under /media or /run/media, which is where desktop automounters place USB storage. Matches the behaviour of staging data onto a USB device, not any specific tool or device."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1052.001"
    mitre_technique_name = "Exfiltration Over Physical Medium: Exfiltration over USB"
    log_prerequisites = "Linux EDR or auditd EXECVE/SYSCALL process telemetry that populates the full command line for PROCESS_LAUNCH events. USB storage must be auto-mounted under /media or /run/media (default on most desktop distributions)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators or users making legitimate backups or file transfers to approved USB drives; field-engineer data collection; backup agents writing to removable media; air-gapped transfer workflows that are sanctioned; software deployment from USB media."
    tuning_guidance = "Add approved backup and imaging binaries to %global_allowed_backup_processes, approved admin accounts to %global_allowed_admin_users, and sanctioned service accounts to %global_allowed_service_accounts. Servers that should never have removable media mounted can be given a higher severity. Sites that mount USB drives under /mnt can extend the destination regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(cp|mv|rsync|tar|zip|7z|7za|7zr|cpio)$/ nocase
    (
      // Copy/move/sync style: data source appears before the removable-media destination
      $proc.target.process.command_line = /(\/(home|root|etc|srv|opt|tmp)\/|\/var\/(lib|www|backups|log|mail)\/).*\s\/(run\/)?media\/\S+/ nocase
      or
      // Archivers: output file on removable media is usually given before the source paths
      (
        $proc.target.process.file.full_path = /\/(tar|zip|7z|7za|7zr|cpio)$/ nocase
        and $proc.target.process.command_line = /\s\/(run\/)?media\/\S+.*(\/(home|root|etc|srv|opt|tmp)\/|\/var\/(lib|www|backups|log|mail)\/)/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1052.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
