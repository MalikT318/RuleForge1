/*
  MITRE Technique : T1176.001 - Browser Extensions
  Tactic(s)       : Persistence
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:27:58.869927+00:00
  Reference       : https://attack.mitre.org/techniques/T1176/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_001_Linux_Browser_Prefs_Tamper_Then_Extension_Load {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A non-browser process modifies a Chromium-family browser Preferences or Secure Preferences file, then a browser is launched with a command-line extension loading flag on the same Linux host within 10 minutes. This pattern indicates silent installation of a malicious browser extension for persistence."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176.001"
    mitre_technique_name = "Software Extensions: Browser Extensions"
    log_prerequisites = "Requires Linux EDR or auditd file telemetry (FILE_MODIFICATION with writing process attribution) and process telemetry with full command lines (PROCESS_LAUNCH), normalised to UDM."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Enterprise configuration management (Ansible, Puppet, Chef) or managed-browser provisioning scripts that edit profile preferences and launch the browser; web extension developers using the load-unpacked flag during testing; browser automation and test frameworks (Selenium, Puppeteer, Playwright) that pre-seed profiles and load extensions; kiosk or VDI image build scripts."
    tuning_guidance = "Add approved configuration management and deployment binaries to %global_allowed_admin_tools. Add automation or CI service accounts to %global_allowed_service_accounts. Add approved script-launching parents to %global_allowed_script_hosts. Review developer workstations separately; consider scoping the rule to non-developer asset groups through client-specific rule exclusions."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\/(\.config\/(google-chrome|chromium|microsoft-edge|BraveSoftware\/Brave-Browser)|snap\/chromium\/common\/chromium)\/[^\/]+\/(Secure )?Preferences$/ nocase
    not $file.principal.process.file.full_path = /\/(chrome|chromium|chromium-browser|google-chrome|google-chrome-stable|brave|brave-browser|msedge|microsoft-edge|opera|vivaldi)(-stable)?$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(chrome|chromium|chromium-browser|google-chrome|google-chrome-stable|brave|brave-browser|msedge|microsoft-edge|opera|vivaldi)(-stable)?$/ nocase
    $proc.target.process.command_line = /--(load-extension|disable-extensions-except)[= ]/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1176.001")
    $primary_entity = array_distinct($hostname)
    $modified_prefs_files = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $browser_command_lines = array_distinct($proc.target.process.command_line)
    $affected_users = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
