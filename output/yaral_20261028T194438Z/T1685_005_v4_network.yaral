/*
  MITRE Technique : T1685.005 - Clear Windows Event Logs
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:24:05.701019+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_005_Remote_EventLog_Clear_Network_Activity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the network footprint of remote Windows Event Log clearing: a log-management utility or an event-log clearing cmdlet opening an RPC, SMB or WinRM connection to another system. Local log clearing generates no network traffic, so any network connection from these processes indicates remote administration of event logs, which is rare outside of adversary log tampering."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.005"
    mitre_technique_name = "Clear Windows Event Logs"
    log_prerequisites = "Requires EDR or Sysmon network connection telemetry (Sysmon Event ID 3 or equivalent) with the initiating process path and command line populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or scripts collecting or rotating event logs on remote servers, SIEM or log-forwarding maintenance scripts, RMM and patching tools that manage remote event logs."
    tuning_guidance = "Add approved administration tooling to %global_allowed_admin_tools (matched on the parent process path) and named administrators to %global_allowed_admin_users. Internal address space is deliberately NOT excluded: remote log clearing during lateral movement targets internal hosts, so excluding %rfc1918_internal would remove nearly all true positives. To narrow scope in noisy estates, add target ranges for management subnets after review."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.principal.process.file.full_path = /\\wevtutil\.exe$/ nocase
      or $net.principal.process.command_line = /(clear-eventlog|remove-eventlog|wevtutil.*\b(cl|clear-log)\b)/ nocase
    )
    (
      $net.target.port = 135
      or $net.target.port = 445
      or $net.target.port = 5985
      or $net.target.port = 5986
    )
    not $net.principal.process.parent_process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
