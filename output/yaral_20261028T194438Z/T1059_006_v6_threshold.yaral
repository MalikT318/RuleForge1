/*
  MITRE Technique : T1059.006 - Python
  Tactic(s)       : Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:15:39.305142+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_006_Python_Script_Drop_Volume_UserWritable {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Five or more Python script or bytecode files (.py, .pyw, .pyc, .pyz) are created in user-writable staging locations (Temp, ProgramData, Public, Downloads) on one host within ten minutes. A single file drop is benign. A burst of Python artefacts outside normal development paths suggests a Python-based payload or toolkit being unpacked or staged, including PyInstaller-style bundles extracting to Temp. This detects the file-staging stage rather than the interpreter command line."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.006"
    mitre_technique_name = "Command and Scripting Interpreter: Python"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent) populating target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developer workstations, data-science tooling, pip/conda environment builds, PyInstaller or cx_Freeze applications unpacking to Temp on launch, IT automation that deploys Python scripts, software installers that bundle a Python runtime."
    tuning_guidance = "Add approved deployment and developer tooling to %global_allowed_admin_tools and approved script-hosting parents to %global_allowed_script_hosts. Raise the #file threshold on developer-heavy hosts. Scope the rule to non-developer asset groups through SOAR or rule exclusions."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(py|pyw|pyc|pyz)$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\appdata\\local\\temp|windows\\temp|programdata|users\\public|users\\[^\\]+\\downloads)\\/ nocase
    not $file.target.file.full_path = /\\(site-packages|__pycache__|pip|conda|pkgs)\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1059.006")
    $primary_entity = array_distinct($host)
    $file_count = count($file.metadata.id)
    $dropped_paths = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 5
}
