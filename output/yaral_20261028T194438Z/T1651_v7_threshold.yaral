/*
  MITRE Technique : T1651 - Cloud Administration Command
  Tactic(s)       : Execution
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:54:15.570097+00:00
  Reference       : https://attack.mitre.org/techniques/T1651
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1651_Cloud_Run_Command_Burst_By_Principal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single cloud identity invokes remote command-execution management APIs (run command, send command, automation runbook job start) at least 5 times within 10 minutes. One invocation is routine administration. A burst from one principal suggests an adversary with administrative access running commands across many virtual machines through the VM agent."
    mitre_tactic = "Execution"
    mitre_technique = "T1651"
    mitre_technique_name = "Cloud Administration Command"
    log_prerequisites = "Cloud control-plane audit logging (management/activity events) must be enabled and ingested into UDM with metadata.product_event_type and principal.user.userid populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Patch and configuration-management automation, scheduled runbooks, fleet-wide health checks or inventory collection, administrators doing incident response or bulk remediation, and managed-service-provider delegated administrators."
    tuning_guidance = "Add known automation identities to %global_allowed_service_accounts, approved administrators to %global_allowed_admin_users, and approved service principals to %global_allowed_cloud_principals. Raise the #cloud threshold for tenants with heavy fleet automation. Extend the API-name regex if the tenant's log normalisation uses different product_event_type values."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /(SendCommand|StartAutomationExecution|StartSession|runCommand|virtualMachines\/runCommands|invokeRunCommand|automationAccounts\/jobs\/write|CreateAutomationJob)/ nocase
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($cloud.metadata.id)
    $mitre_technique_id = array_distinct("T1651")
    $primary_entity = array_distinct($user)
    $api_calls = array_distinct($cloud.metadata.product_event_type)
    $target_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    #cloud >= 5
}
