/*
  MITRE Technique : T1036.004 - Masquerade Task or Service
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:03:53.539226+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_004_Linux_Masquerading_Systemd_Unit_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several systemd unit files (.service/.timer) whose names imitate core Linux system services are created on a single host within 10 minutes by a process that is not a package manager or approved admin tool. Each unit creation is routine; a burst of look-alike system units outside package management indicates persistence or a service masquerading as a legitimate component."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.004"
    mitre_technique_name = "Masquerading: Masquerade Task or Service"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry (with principal process path) covering systemd unit directories such as /etc/systemd and /usr/lib/systemd."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management (Ansible, Puppet, Chef, Salt) deploying units; software installers and self-updaters not using the system package manager; container or image build pipelines; administrators creating drop-in or custom service units."
    tuning_guidance = "Add configuration-management and deployment binaries to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and build hosts to %global_allowed_script_hosts. Raise the #file threshold on hosts that frequently provision services."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(etc\/systemd\/(system|user)|usr\/lib\/systemd\/(system|user)|lib\/systemd\/(system|user)|home\/[^\/]+\/\.config\/systemd\/user)\/[^\/]*\.(service|timer)$/ nocase
    $file.target.file.full_path = /\/[^\/]*(systemd|dbus|udev|network|netmgr|syslog|rsyslog|cron|crond|auditd|polkit|kworker|avahi|bluetooth|cups|snapd|gdm|sshd|update|resolved|logind)[^\/]*\.(service|timer)$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|yum|dnf|zypper|pacman|snapd|packagekitd|unattended-upgrade)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($file.target.file.full_path = /^\/home\//, 75, 65))
    $mitre_technique_id = array_distinct("T1036.004")
    $primary_entity = array_distinct($host)
    $unit_count = count($file.metadata.id)
    $unit_paths = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $creating_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
