/*
  MITRE Technique : T1648 - Serverless Execution
  Tactic(s)       : Execution
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:49:35.299550+00:00
  Reference       : https://attack.mitre.org/techniques/T1648
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1648_Serverless_Function_Code_Or_Config_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a configuration-plane change to an existing serverless function (code update, configuration update, execution role or environment change) made by a principal that is not an approved deployment identity. Attackers who modify an existing function can run arbitrary code, or pick up a more privileged execution identity, without creating a new resource. The rule watches the resulting configuration state change in the control-plane audit log rather than any process or command line."
    mitre_tactic = "Execution"
    mitre_technique = "T1648"
    mitre_technique_name = "Serverless Execution"
    log_prerequisites = "Cloud control-plane audit logging for management and write API calls must be enabled and ingested into Chronicle, and the parser must populate metadata.product_event_type and principal.user.userid. Function update APIs must be mapped to SETTING_MODIFICATION; if a parser maps them to another event type, adjust the event type filter."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "CI/CD pipelines and infrastructure-as-code deployments that publish new function code; developers iterating in non-production accounts; platform teams rotating environment variables or execution roles; cloud-native deployment services acting through delegated identities."
    tuning_guidance = "Add deployment pipeline identities to %global_allowed_service_accounts, approved automation principals to %global_allowed_cloud_principals, and named release engineers to %global_allowed_admin_users. Raise severity for production accounts and for out-of-hours changes by combining with timestamp.get_hour() in a derived rule."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /(UpdateFunctionCode|UpdateFunctionConfiguration|CloudFunctionsService\.(Update|Patch)Function|functions\.(update|patch)|sites\/(config|functions)\/write)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1648")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_calls = array_distinct($cloud.metadata.product_event_type)
    $function_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
