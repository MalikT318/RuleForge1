/*
  MITRE Technique : T1553.002 - Code Signing
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:01:04.143764+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_002_Signing_Tool_From_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects code-signing and certificate-manipulation utilities (signing, certificate creation, certificate store and PFX handling binaries) launched by a parent that should never invoke them, such as an Office application, web server worker, database service or print spooler. Legitimate signing is performed by build pipelines and administrators from shells or CI agents. Signing or trusting material spawned from a document, web or database process indicates exploitation or post-exploitation staging of code-signing material. Detection is based on process lineage, not command-line content."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.002"
    mitre_technique_name = "Subvert Trust Controls: Code Signing"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry (EDR, Sysmon Event ID 1 or Security Event 4688 with parent process populated) normalised to UDM PROCESS_LAUNCH with principal.process.file.full_path (parent) and target.process.file.full_path (child)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web-based or database-driven software build and signing portals, Office macros or add-ins used by IT to enrol or import certificates, certificate enrolment agents running under a web server worker (for example internal PKI web enrolment), and print or deployment software that installs signing certificates during driver deployment."
    tuning_guidance = "Add approved parent binaries (build agents, PKI enrolment tooling) to %global_allowed_admin_tools. Add named administrator accounts that legitimately perform signing to %global_allowed_admin_users, and automation accounts to %global_allowed_service_accounts. Add hosts or parents legitimately running scripted signing to %global_allowed_script_hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|onenote|visio|w3wp|httpd|nginx|tomcat\d*|php-cgi|sqlservr|mysqld|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(signtool|makecert|pvk2pfx|certmgr|certutil|mpsigstub)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1553.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
