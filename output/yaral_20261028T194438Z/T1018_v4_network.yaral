/*
  MITRE Technique : T1018 - Remote System Discovery
  Tactic(s)       : Discovery
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:28:41.777743+00:00
  Reference       : https://attack.mitre.org/techniques/T1018
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1018_Linux_Network_Zone_Transfer_Or_Service_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS-based host enumeration observed at the network perimeter: zone transfer requests (AXFR/IXFR), which return every host record in a zone, and DNS-SD service-enumeration meta-queries, which list hosts offering services on the local network. Typical sources are a compromised Linux server running dig, host or nmap NSE scripts. Internal address space is deliberately NOT excluded on the destination, because the resolvers being enumerated are usually internal. Expected zone-transfer peers and sanctioned scanners are excluded through reference lists instead."
    mitre_tactic = "Discovery"
    mitre_technique = "T1018"
    mitre_technique_name = "Remote System Discovery"
    log_prerequisites = "Requires firewall, DNS-aware proxy or network sensor logs normalised to UDM NETWORK_DNS with network.dns.questions populated (name and type). Source-host attribution to a Linux asset depends on the client's asset or DHCP enrichment; a firewall log carries no process context."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Secondary DNS servers legitimately pulling zone transfers from primaries; DNS or network-engineering staff validating zones; authorised vulnerability scanners and asset-discovery tools; Linux desktops running Avahi/mDNS service browsing in office or lab networks."
    tuning_guidance = "Add secondary DNS servers and approved management hosts to %global_allowed_mgmt_sources. Add authorised scanner source addresses to %global_allowed_scanners. If mDNS service browsing is noisy in a client environment, remove the DNS-SD branch for that tenant; the zone-transfer branch has very low legitimate volume outside DNS infrastructure."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    (
      $dns.network.dns.questions.type = 252 or
      $dns.network.dns.questions.type = 251 or
      $dns.network.dns.questions.name = /^_services\._dns-sd\._udp\./ nocase
    )
    not $dns.principal.ip in %global_allowed_mgmt_sources
    not $dns.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1018")
    $primary_entity = array_distinct($dns.principal.hostname)
    $source_ips = array_distinct($dns.principal.ip)
    $dns_servers = array_distinct($dns.target.ip)
    $queried_names = array_distinct($dns.network.dns.questions.name)

  condition:
    $dns
}
