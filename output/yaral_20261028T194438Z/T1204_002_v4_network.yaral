/*
  MITRE Technique : T1204.002 - Malicious File
  Tactic(s)       : Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:01:21.635992+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_002_UserWritable_Executable_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Network-side detection of a user-opened malicious file. An executable-type file (.exe, .scr, .pif, .cpl, .com) running from a user-writable landing location (Downloads, Desktop, Temp, Outlook attachment cache) makes an outbound connection to a non-internal address. This is typical of a payload executed after the user opens a phishing attachment or downloaded file, which then beacons or fetches a second stage. It does not depend on process-creation command lines."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.002"
    mitre_technique_name = "User Execution: Malicious File"
    log_prerequisites = "Requires Windows endpoint network telemetry that attributes each connection to its originating process (EDR or Sysmon Event ID 3), normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Portable applications run from Downloads or Desktop (for example sysinternals tools, portable browsers, chat clients), freshly downloaded installers or updaters that contact vendor servers, self-extracting archives that fetch content, and developer or sandbox test binaries."
    tuning_guidance = "Add approved portable tooling and installers to %global_allowed_admin_tools, security agents to %global_allowed_security_tools, and known-good vendor or update domains to %global_allowed_domains. If internal address space is wider than %rfc1918_internal, extend that list. For noisy environments, add approved remote support tooling to %global_allowed_remote_mgmt and review by host."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\users\\[^\\]+\\(downloads|desktop|appdata\\local\\temp|appdata\\local\\microsoft\\windows\\inetcache\\content\.outlook)\\.*\.(exe|scr|pif|cpl|com)$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1204.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $user = array_distinct($net.principal.user.userid)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
