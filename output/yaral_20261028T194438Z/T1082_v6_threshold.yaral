/*
  MITRE Technique : T1082 - System Information Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:49:56.097465+00:00
  Reference       : https://attack.mitre.org/techniques/T1082
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1082_IaaS_Bulk_Instance_Metadata_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single cloud identity issued a high volume of read-only compute inventory and metadata API calls (describe/list/get on instances, images, disks, machine types) within 10 minutes. Each call is benign alone, but bulk enumeration of instance and OS image details is a common cloud discovery step after credential compromise, used to choose follow-on targets."
    mitre_tactic = "Discovery"
    mitre_technique = "T1082"
    mitre_technique_name = "System Information Discovery"
    log_prerequisites = "Requires cloud control-plane audit logs with read/management API events ingested and parsed to UDM USER_RESOURCE_ACCESS, with principal.user.userid and metadata.product_event_type populated. Data-plane or read-only management events may need to be enabled in the audit configuration."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Inventory and CMDB sync tools, cloud security posture management scanners, cost and asset management platforms, infrastructure-as-code plan/refresh runs, autoscaling and orchestration controllers, and administrators browsing consoles or running audits."
    tuning_guidance = "Add automation and inventory identities to %global_allowed_service_accounts, approved service principals to %global_allowed_cloud_principals, and named administrators to %global_allowed_admin_users. Raise the #cloud threshold (default 15) for noisy tenants, or lower it for high-sensitivity accounts. Extend the API-name regex with provider-specific read calls as required."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /(Describe(Instances|InstanceStatus|InstanceTypes|InstanceAttribute|Images|Volumes|Snapshots)|GetInstanceInformation|ListInstances|virtualMachines\/(read|instanceView\/read)|compute\.(instances|images|disks|machineTypes)\.(list|get|aggregatedList))/ nocase
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1082")
    $primary_entity = array_distinct($user)
    $event_count = count($cloud.metadata.id)
    $distinct_api_calls = count_distinct($cloud.metadata.product_event_type)
    $api_calls = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    #cloud >= 15
}
