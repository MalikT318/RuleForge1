/*
  MITRE Technique : T1072 - Software Deployment Tools
  Tactic(s)       : Execution, Lateral Movement
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:14:20.872575+00:00
  Reference       : https://attack.mitre.org/techniques/T1072
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1072_SaaS_Deployment_Config_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change on a centralized software deployment or endpoint management control plane that creates or alters remote command, script, package, automation or assignment objects. Attackers with administrative access to these services can use such changes to run code on many managed endpoints or instances, which is lateral movement and execution through a trusted channel. The rule detects the resulting configuration state change in the cloud audit log, not any endpoint command line."
    mitre_tactic = "Execution, Lateral Movement"
    mitre_technique = "T1072"
    mitre_technique_name = "Software Deployment Tools"
    log_prerequisites = "Cloud control plane audit logs (management and admin activity) ingested and normalised to UDM SETTING_MODIFICATION with metadata.product_event_type, principal.user.userid and target.resource.name populated."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate CI/CD pipelines and release automation, patch management and compliance baselines, IT administrators publishing approved scripts or packages, infrastructure-as-code runs, and scheduled maintenance windows."
    tuning_guidance = "Add expected pipeline and automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Add named change administrators to %global_allowed_admin_users. Narrow the product_event_type or resource name regex if a client's deployment tooling uses unusually broad naming. Consider raising severity for changes made outside business hours."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /(create|update|put|modify|register|start|send|attach|assign).*(association|command|script|deployment|automation|package|document|assignment|runbook|remediation|job)/ nocase
    $cloud.target.resource.name = /(deploy|script|command|package|automation|remediat|patch|runbook|payload|install|execute|run[-_ ]?doc)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1072")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $source_ips = array_distinct($cloud.principal.ip)
    $api_actions = array_distinct($cloud.metadata.product_event_type)
    $changed_resources = array_distinct($cloud.target.resource.name)

  condition:
    $cloud
}
