/*
  MITRE Technique : T1558.003 - Kerberoasting
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:44:59.619840+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_003_Kerberoasting_TGS_Request_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a single user account generating a high volume of Kerberos service ticket (TGS) requests, Windows Security event 4769, within ten minutes. Each request is benign on its own. Many requests from one account, for many service accounts, is the Kerberoasting pattern of harvesting tickets for offline cracking."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.003"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Kerberoasting"
    log_prerequisites = "Requires Windows Security event 4769 (Kerberos Service Ticket Operations) forwarded from domain controllers and normalised to USER_RESOURCE_ACCESS with metadata.product_event_type = 4769. Advanced Audit Policy 'Audit Kerberos Service Ticket Operations' must be enabled for success events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Vulnerability and asset scanners, service-discovery or inventory tooling, IT admins or RMM tools enumerating services, applications that legitimately authenticate to many SPNs (SharePoint or SQL front ends, middleware), and shared jump hosts used by many users."
    tuning_guidance = "Add expected service or automation accounts to %global_allowed_service_accounts, admin accounts to %global_allowed_admin_users, and scanner source hosts to %global_allowed_scanners. Raise the #auth threshold in condition for environments with high TGS volume. Lower it for small environments."

  events:
    $auth.metadata.event_type = "USER_RESOURCE_ACCESS"
    $auth.metadata.product_event_type = "4769"
    $auth.principal.user.userid = $user
    not $auth.principal.user.userid = /\$$/
    not $auth.target.resource.name = /(^krbtgt$|\$$)/ nocase
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users
    not $auth.principal.hostname in %global_allowed_scanners

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1558.003")
    $primary_entity = array_distinct($user)
    $event_count = count($auth.metadata.id)
    $requested_services = array_distinct($auth.target.resource.name)
    $source_hosts = array_distinct($auth.principal.hostname)
    $source_ips = array_distinct($auth.principal.ip)

  condition:
    #auth >= 10
}
