/*
  MITRE Technique : T1684.001 - Impersonation
  Tactic(s)       : Stealth
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:32:09.417496+00:00
  Reference       : https://attack.mitre.org/techniques/T1684/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1684_001_Email_ReplyTo_Domain_Mismatch_Urgent_Lure {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an email whose Reply-To domain differs from its From domain and whose subject uses urgency or payment-request language. This is a common business email compromise pattern, in which an adversary impersonates a trusted sender or executive and diverts replies to an attacker-controlled mailbox."
    mitre_tactic = "Stealth"
    mitre_technique = "T1684.001"
    mitre_technique_name = "Impersonation"
    log_prerequisites = "Requires Office Suite unified audit or mail-flow logs normalized to UDM EMAIL_TRANSACTION, with network.email.from, network.email.reply_to and network.email.subject populated."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate third-party senders such as bulk mailers, ticketing, invoicing and payroll platforms, CRM and marketing tools that send from one domain and route replies to another. Shared support mailboxes and vendors using delegated sending. Newsletters with urgent-sounding subjects."
    tuning_guidance = "Add known-good sender domains to %global_allowed_domains. Narrow or extend the subject keyword list per client. Add approved automation or mail-sending mailboxes to %global_allowed_service_accounts. If reply_to is not populated in a tenant's mail logs, confirm normalization before deploying."

  events:
    $mail.metadata.event_type = "EMAIL_TRANSACTION"
    $mail.network.email.from = /@/
    $mail.network.email.reply_to = /@/
    $mail.network.email.subject = /\b(urgent|urgently|immediate(ly)?|asap|payment|invoice|wire transfer|bank (details|account)|change of (bank|account)|gift ?cards?|overdue|confidential request|quick (task|favor)|request)\b/ nocase

    $from_domain = re.capture(strings.to_lower($mail.network.email.from), "@([^@>\\s]+)>?$")
    $reply_domain = re.capture(strings.to_lower($mail.network.email.reply_to), "@([^@>\\s]+)>?$")
    $from_domain != $reply_domain

    not $from_domain in %global_allowed_domains
    not $reply_domain in %global_allowed_domains
    not $mail.network.email.from in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1684.001")
    $primary_entity = array_distinct($mail.network.email.from)
    $reply_to_address = array_distinct($mail.network.email.reply_to)
    $email_subject = array_distinct($mail.network.email.subject)
    $sender_domain = array_distinct($from_domain)
    $reply_to_domain = array_distinct($reply_domain)

  condition:
    $mail
}
