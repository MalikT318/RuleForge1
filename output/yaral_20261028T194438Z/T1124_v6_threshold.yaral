/*
  MITRE Technique : T1124 - System Time Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:32:33.679172+00:00
  Reference       : https://attack.mitre.org/techniques/T1124
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1124_Linux_Excessive_External_NTP_Queries {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source makes an unusually high volume of UDP/123 (NTP) connections to external destinations within ten minutes. A normal NTP client polls a handful of servers at long intervals. Bursts of external time queries can indicate system time or time zone discovery, uptime or sandbox-evasion checks, or tooling probing many time servers. This is network-side coverage only and does not depend on process or command-line telemetry. The source is expected to be a Linux or Unix-like host, but a perimeter log cannot confirm the OS."
    mitre_tactic = "Discovery"
    mitre_technique = "T1124"
    mitre_technique_name = "System Time Discovery"
    log_prerequisites = "Requires firewall, proxy or perimeter flow logs normalised to UDM NETWORK_CONNECTION with source IP, destination IP, destination port and IP protocol populated. The perimeter must log outbound UDP/123 traffic."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Misconfigured or newly built hosts with aggressive NTP or chrony polling, time-sync troubleshooting by administrators, NTP monitoring probes, container or VM fleets syncing at the same time after a restart or image deploy, NAT gateways that aggregate many internal clients behind one source IP."
    tuning_guidance = "Add known-good external time providers to %global_allowed_domains where the destination hostname is populated. Add NAT gateways, monitoring probes and authorised scanners to %global_allowed_scanners. Raise the #net threshold in high-NAT environments. Consider lowering it for server segments that should only use internal NTP."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 123
    $net.network.ip_protocol = "UDP" nocase
    $net.principal.ip = $src_ip
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  match:
    $src_ip over 10m

  outcome:
    $event_count = count($net.metadata.id)
    $risk_score = max(if($event_count >= 60, 75, 45))
    $mitre_technique_id = array_distinct("T1124")
    $primary_entity = array_distinct($src_ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)

  condition:
    #net >= 15
}
