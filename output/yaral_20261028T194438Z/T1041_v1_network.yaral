/*
  MITRE Technique : T1041 - Exfiltration Over C2 Channel
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:58:53.354043+00:00
  Reference       : https://attack.mitre.org/techniques/T1041
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1041_Firewall_Large_Asymmetric_Outbound_Upload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a single outbound firewall-logged session over common C2-capable web ports (80/443/8080/8443) to an external destination that carries a very large upload with almost no returned data. This asymmetric profile is characteristic of bulk data exfiltration over an existing C2 channel that reuses the same protocol and port as normal C2 traffic."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1041"
    mitre_technique_name = "Exfiltration Over C2 Channel"
    log_prerequisites = "Firewall, proxy or perimeter logs normalised to UDM NETWORK_CONNECTION with network.sent_bytes and network.received_bytes populated, and target.ip populated. The %rfc1918_internal reference list must be populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Cloud backup and file sync uploads (to unlisted vendors), large email or file-share attachments, software or crash-dump uploads to vendors, video conferencing and screen-sharing uploads, developer pushes to code repositories, and legitimate off-site replication."
    tuning_guidance = "Add known-good external destinations (backup, sync and SaaS vendors) to %global_allowed_domains. Raise or lower the sent_bytes threshold (default 50 MB) per client baseline. Adjust the port list if the client's perimeter normalises C2-capable traffic on other ports. Consider a per-client lower threshold for high-sensitivity segments."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.sent_bytes >= 52428800
    $net.network.received_bytes < 1048576
    (
      $net.target.port = 80 or
      $net.target.port = 443 or
      $net.target.port = 8080 or
      $net.target.port = 8443
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1041")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
