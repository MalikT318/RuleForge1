/*
  MITRE Technique : T1068 - Exploitation for Privilege Escalation
  Tactic(s)       : Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:54:56.977380+00:00
  Reference       : https://attack.mitre.org/techniques/T1068
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1068_Container_Excessive_Pod_Exec_Attach_By_Identity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single identity issued a burst of exec/attach requests against running pods through the Kubernetes API within 10 minutes. One exec is routine. Many in a short window suggest hands-on-keyboard probing of workloads to find a vulnerable container or runtime, or an attempt to escape to the host and escalate privileges. This detects the API-level access pattern, not in-container command lines."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1068"
    mitre_technique_name = "Exploitation for Privilege Escalation"
    log_prerequisites = "Kubernetes API server audit logging at Metadata level or higher, with request URI mapped to target.url and the requesting identity mapped to principal.user.userid. Ingested into Chronicle as USER_RESOURCE_ACCESS events."
    platform = "Containers"
    log_source = "container"
    false_positives = "Engineers debugging incidents, CI/CD or GitOps jobs running exec for smoke tests, break-glass operations, operators and controllers that exec into pods for health checks, and training or lab clusters."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts and named SRE or platform admins to %global_allowed_admin_users. Raise the #access threshold for clusters with heavy interactive debugging, and lower it for production clusters where exec should be rare."

  events:
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.target.url = /\/pods\/[^\/\?]+\/(exec|attach)/ nocase
    $access.principal.user.userid = $user
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($access.metadata.id)
    $mitre_technique_id = array_distinct("T1068")
    $primary_entity = array_distinct($user)
    $target_urls = array_distinct($access.target.url)
    $source_ips = array_distinct($access.principal.ip)

  condition:
    #access >= 8
}
