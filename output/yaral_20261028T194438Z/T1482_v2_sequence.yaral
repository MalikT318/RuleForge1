/*
  MITRE Technique : T1482 - Domain Trust Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:28:52.681739+00:00
  Reference       : https://attack.mitre.org/techniques/T1482
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1482_Interpreter_LDAP_Then_GlobalCatalog_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A scripting interpreter or proxy-execution binary connects to LDAP (389/636) and then to Global Catalog (3268/3269) on the same host within ten minutes. This pattern is typical of in-memory or API-based domain and forest trust enumeration (for example .NET DirectoryServices, Get-ADTrust, DsEnumerateDomainTrusts). It does not depend on command-line content, so it complements process-creation rules."
    mitre_tactic = "Discovery"
    mitre_technique = "T1482"
    mitre_technique_name = "Domain Trust Discovery"
    log_prerequisites = "Requires endpoint network-connection telemetry with the initiating process path populated (EDR network events or Sysmon Event ID 3)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin PowerShell scripts for AD reporting or health checks, IT inventory and identity-governance scripts, logon scripts that query AD, and Exchange or hybrid-identity management consoles."
    tuning_guidance = "Add approved admin or AD tooling to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and admin jump hosts or script servers to %global_allowed_script_hosts. Raise severity for non-server hosts or non-admin users."

  events:
    $ldap.metadata.event_type = "NETWORK_CONNECTION"
    $ldap.principal.process.file.full_path = /\\(powershell|pwsh|cscript|wscript|mshta|rundll32|regsvr32|installutil|msbuild)\.exe$/ nocase
    ($ldap.target.port = 389 or $ldap.target.port = 636)
    $ldap.principal.hostname = $hostname
    not $ldap.principal.process.file.full_path in %global_allowed_admin_tools
    not $ldap.principal.hostname in %global_allowed_script_hosts
    not $ldap.principal.user.userid in %global_allowed_service_accounts

    $gc.metadata.event_type = "NETWORK_CONNECTION"
    $gc.principal.process.file.full_path = /\\(powershell|pwsh|cscript|wscript|mshta|rundll32|regsvr32|installutil|msbuild)\.exe$/ nocase
    ($gc.target.port = 3268 or $gc.target.port = 3269)
    $gc.principal.hostname = $hostname
    not $gc.principal.process.file.full_path in %global_allowed_admin_tools
    not $gc.principal.hostname in %global_allowed_script_hosts
    not $gc.principal.user.userid in %global_allowed_service_accounts

    $ldap.metadata.event_timestamp.seconds <= $gc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1482")
    $primary_entity = array_distinct($hostname)
    $ldap_targets = array_distinct($ldap.target.ip)
    $gc_targets = array_distinct($gc.target.ip)
    $initiating_processes = array_distinct($ldap.principal.process.file.full_path)
    $users = array_distinct($ldap.principal.user.userid)

  condition:
    $ldap and $gc
}
