/*
  MITRE Technique : T1027.011 - Fileless Storage
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:56:10.492889+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_011_Registry_Fileless_Payload_Storage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a script interpreter or proxy-execution binary writing a long base64 blob or executable script content into a registry value under a Software hive. This is the registry-as-fileless-storage pattern, where a payload is staged in the registry and later reloaded into memory. The rule uses REGISTRY_MODIFICATION telemetry rather than process command lines, so it complements existing PROCESS_LAUNCH detections."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.011"
    mitre_technique_name = "Obfuscated Files or Information: Fileless Storage"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event IDs 12/13/14 equivalent) with registry value data populated in UDM target.registry.registry_value_data."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin or deployment scripts that store encoded configuration or certificates in the registry, software installers that use script hosts, and RMM or inventory agents that save Base64 state under their own Software key."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools and approved script-host parents to %global_allowed_script_hosts. If a vendor's Software key is noisy, add a path exclusion for it. Adjust the base64 length threshold in the regex ({300,}) per environment."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|reg)\.exe$/ nocase
    $reg.target.registry.registry_key = /\\Software\\/ nocase
    $reg.target.registry.registry_value_data = /([A-Za-z0-9+\/=]{300,}|frombase64string|invoke-expression|\biex\b|\[reflection\.assembly\]|powershell)/ nocase
    not $reg.target.registry.registry_key = /\\Software\\(Policies|Classes)\\/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_script_hosts
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1027.011")
    $primary_entity = array_distinct($reg.principal.hostname)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
