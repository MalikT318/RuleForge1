/*
  MITRE Technique : T1505.006 - vSphere Installation Bundles
  Tactic(s)       : Persistence
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:35:19.767555+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_006_ESXi_External_VIB_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi host retrieving a vSphere Installation Bundle (.vib) over HTTP(S) from an external destination. Adversaries stage malicious VIBs on external infrastructure and pull them to the hypervisor to install boot-persistent payloads. This is a network-side detection that complements endpoint command-line coverage."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.006"
    mitre_technique_name = "Server Software Component: vSphere Installation Bundles"
    log_prerequisites = "Requires HTTP/proxy, firewall, or network sensor telemetry that records the URL for outbound requests from ESXi management interfaces, normalised to UDM NETWORK_HTTP with principal.hostname identifying the ESXi host. Requires the ESXi host to be mapped to the vmware_esxi log source or asset context."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators patching hosts directly from an external vendor depot or mirror, lifecycle or patch-management tooling pulling bundles, driver or agent VIBs for hardware vendors (storage, NIC, backup agents), and approved security or monitoring agent installs."
    tuning_guidance = "Add approved vendor depot and mirror domains to %global_allowed_domains. Add known ESXi patching or management hosts to %global_allowed_admin_tools if they are the requesting principal. Keep %rfc1918_internal populated for each tenant so internal depots are excluded. Consider scheduling-based suppression during approved maintenance windows."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\.vib($|\?|#)/ nocase
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1505.006")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
