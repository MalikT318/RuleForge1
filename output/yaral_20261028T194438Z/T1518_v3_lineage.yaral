/*
  MITRE Technique : T1518 - Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:36:43.600319+00:00
  Reference       : https://attack.mitre.org/techniques/T1518
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_Linux_Service_Parent_Spawns_Software_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server or database service process spawning a shell or package manager that runs a software inventory query (dpkg, rpm, apt, yum, dnf, snap, pip, apk, pacman). These daemons do not normally enumerate installed software, so this lineage suggests a web shell, injected code or a compromised service account profiling the host."
    mitre_tactic = "Discovery"
    mitre_technique = "T1518"
    mitre_technique_name = "Software Discovery"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records that populate the parent process path, the child process path and the child command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Application health checks or monitoring plugins run from a service context, CMS or control-panel plugins that list packages (for example hosting panels), database maintenance jobs that call shell wrappers, configuration management agents launched under a service parent, and developer or CI workloads on Java or Node application hosts."
    tuning_guidance = "Add approved parent binaries to %global_allowed_script_hosts and approved inventory or deployment tooling to %global_allowed_admin_tools. Extend the parent regex with in-house service daemons if needed. Review hosts that fire repeatedly, since a web shell often runs many discovery commands."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|php-cgi|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|tomcat[0-9]*)$/ nocase
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|ash|dpkg|dpkg-query|rpm|apt|apt-get|yum|dnf|snap|pip|pip3|apk|pacman)$/ nocase
    $proc.target.process.command_line = /\b(dpkg(-query)?\s+(-l|--list|-W|--show)|rpm\s+(-qa|-q\s+--all)|apt(-get)?\s+list\s+--installed|apt\s+list|yum\s+(list\s+installed|list\s+all)|dnf\s+(list\s+--?installed|list\s+installed)|snap\s+list|pip3?\s+(list|freeze)|apk\s+(info|list)|pacman\s+-Q)\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1518")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
