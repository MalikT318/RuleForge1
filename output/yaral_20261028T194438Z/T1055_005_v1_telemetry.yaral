/*
  MITRE Technique : T1055.005 - Thread Local Storage
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:52:17.462894+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_005_Untrusted_Process_Handle_To_Trusted_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process running from a user-writable location opening a handle to a trusted Windows host process (svchost, explorer, dllhost, etc.). TLS callback injection first needs a handle to the victim process so it can allocate and write memory and redirect a PE's TLS callback pointer. This rule detects the handle request rather than the command line, so it still fires when command-line logging is evaded."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.005"
    mitre_technique_name = "Process Injection: Thread Local Storage"
    log_prerequisites = "Requires endpoint telemetry that records process handle access (EDR process-access events or Sysmon Event ID 10) normalised to PROCESS_OPEN with populated principal and target process paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters run from Temp or AppData, game launchers and overlays, accessibility or screen-reader tools, user-installed utilities that legitimately inspect shell processes, developer debuggers and profilers, and unlisted EDR or AV agents."
    tuning_guidance = "Add approved EDR/AV agents to %global_allowed_security_tools, backup or imaging software to %global_allowed_backup_processes, and IT tooling to %global_allowed_admin_tools. If noise remains, extend the exclusion list by executable name for approved updaters. If the telemetry carries a granted-access mask, restrict the rule to write/operate rights (VM_WRITE, VM_OPERATION, CREATE_THREAD) to reduce volume."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.process.file.full_path = /(\\users\\[^\\]+\\(appdata|downloads|desktop|documents)\\|\\windows\\temp\\|\\users\\public\\|\\programdata\\[^\\]+\\[^\\]+\.exe$|\\\$recycle\.bin\\)/ nocase
    $open.target.process.file.full_path = /\\(svchost|explorer|notepad|rundll32|dllhost|regsvr32|msiexec|taskhostw|spoolsv|searchindexer|werfault|wuauclt|runtimebroker|sihost)\.exe$/ nocase
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    not $open.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|SenseCncProxy)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1055.005")
    $primary_entity = array_distinct($open.principal.hostname)
    $source_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $source_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
