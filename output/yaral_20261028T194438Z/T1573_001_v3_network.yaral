/*
  MITRE Technique : T1573.001 - Symmetric Cryptography
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:23:14.515926+00:00
  Reference       : https://attack.mitre.org/techniques/T1573/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1573_001_Linux_Unclassified_Encrypted_Egress_Firewall {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an established outbound TCP session from an internal host to an external address on a non-well-known port that the perimeter firewall could not classify as any known application protocol, with payload flowing in both directions. Custom symmetric encryption (AES, RC4, XOR-with-key and similar) wrapped around a bespoke C2 protocol is typically labelled unknown or unclassified by perimeter application identification. This rule covers the network side and is intended for egress from Linux servers and workloads; the firewall has no process context, so triage must pivot to endpoint telemetry."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1573.001"
    mitre_technique_name = "Encrypted Channel: Symmetric Cryptography"
    log_prerequisites = "Requires perimeter firewall or proxy logs normalised to UDM NETWORK_CONNECTION with network.application_protocol, network.direction, target.port, and sent/received byte counts populated. Application identification or DPI must be enabled on the firewall for the unknown-protocol label to be meaningful."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Proprietary or legacy business applications using custom TCP protocols, peer-to-peer and gaming clients, VoIP or video signalling, database replication or message-queue traffic to external partners, vendor telemetry agents, and firewalls with application identification disabled that label all traffic as unknown."
    tuning_guidance = "Add known-good vendor and partner destinations to %global_allowed_domains. If the firewall does not populate target.hostname, scope the rule to Linux server egress segments in the SIEM or increase the port floor. Raise the byte thresholds or promote to a Threshold rule (repeated beaconing to the same destination) in noisy environments. Confirm that the firewall's application identification is enabled before deployment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.direction = "OUTBOUND"
    $net.network.ip_protocol = "TCP"
    $net.network.application_protocol = "UNKNOWN_APPLICATION_PROTOCOL"
    $net.target.port >= 1024
    $net.network.sent_bytes > 0
    $net.network.received_bytes > 0
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1573.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $total_sent_bytes = sum($net.network.sent_bytes)

  condition:
    $net
}
