/*
  MITRE Technique : T1021.003 - Distributed Component Object Model
  Tactic(s)       : Lateral Movement
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:38:41.355505+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_003_DCOM_Embedding_Parent_Spawns_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a COM server application (MMC or an Office application) that was launched with the -Embedding activation switch and then spawned a command shell or script interpreter. This is the process lineage left behind when DCOM methods such as MMC20.Application ExecuteShellCommand or Excel/Outlook/Visio DCOM objects are invoked remotely for lateral movement. The rule matches the parent-child relationship and the COM activation marker on the parent, not the child command line."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.003"
    mitre_technique_name = "Remote Services: Distributed Component Object Model"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing) that populates the parent process path and parent command line."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate COM automation (scheduled reporting scripts or line-of-business add-ins driving Excel/Outlook that shell out to cmd or PowerShell), Office macros or VSTO add-ins run by automation accounts, administrators using remote MMC snap-ins that launch helper shells, and RMM or deployment tooling that automates Office."
    tuning_guidance = "Add approved automation parents to %global_allowed_admin_tools or %global_allowed_script_hosts, and add known automation accounts to %global_allowed_service_accounts. If the EDR does not populate the parent command line, the -Embedding condition will never match and the rule must be adapted for that client. Review the matched hosts for inbound network logons (Event 4624 type 3) and RPC activity on TCP 135 just before the alert."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(mmc|excel|winword|powerpnt|outlook|visio|msaccess|mspub)\.exe$/ nocase
    $proc.principal.process.command_line = /[-\/]embedding/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1021.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
