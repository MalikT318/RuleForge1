/*
  MITRE Technique : T1606.001 - Web Cookies
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:24:27.520448+00:00
  Reference       : https://attack.mitre.org/techniques/T1606/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1606_001_Linux_Secret_Read_Then_Cookie_Forge {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a user reading web application signing secrets (session or JWT keys, .env files, framework secrets) with a file-viewing utility, then within 10 minutes launching an interpreter or HTTP client that builds or signs a session cookie or sends a Cookie header. This sequence indicates cookie forgery rather than theft of a legitimate session."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1606.001"
    mitre_technique_name = "Forge Web Credentials: Web Cookies"
    log_prerequisites = "Requires Linux EDR or auditd EXECVE process telemetry with full command lines, normalised to UDM PROCESS_LAUNCH with principal.hostname populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers or SREs debugging session handling and testing authenticated endpoints with curl on the same host; CI/CD or deployment scripts that read .env files and then run smoke tests with cookies; application test suites that sign sessions; configuration management agents."
    tuning_guidance = "Add approved admin tooling parents to %global_allowed_admin_tools (secret-read side) and approved automation hosts or parent processes to %global_allowed_script_hosts (forge side). Add deployment and test accounts to %global_allowed_service_accounts. Run in a developer-heavy environment for 7 days in alert-only mode and review hits before raising severity."

  events:
    $secret_read.metadata.event_type = "PROCESS_LAUNCH"
    $secret_read.target.process.file.full_path = /\/(cat|grep|egrep|fgrep|sed|awk|head|tail|less|more|strings|xxd)$/ nocase
    $secret_read.target.process.command_line = /(\.env\b|settings\.py|local_settings|secrets?\.ya?ml|master\.key|credentials\.yml\.enc|secret[_-]?key|jwt[_-]?(secret|key)|session[_-]?(secret|key)|cookie[_-]?(secret|key)|machine[_-]?key|signing[_-]?key)/ nocase
    not $secret_read.principal.process.file.full_path in %global_allowed_admin_tools
    $secret_read.principal.hostname = $hostname

    $forge.metadata.event_type = "PROCESS_LAUNCH"
    $forge.target.process.file.full_path = /\/(python[0-9.]*|node|nodejs|ruby|perl|php|curl|wget)$/ nocase
    $forge.target.process.command_line = /(--cookie\b|\s-b\s+\S|-H\s+["']?cookie:|itsdangerous|URLSafeTimedSerializer|SecureCookieSessionInterface|jwt\.encode|jsonwebtoken|MessageVerifier|ActionDispatch::Cookies|Set-Cookie)/ nocase
    not $forge.principal.process.file.full_path in %global_allowed_script_hosts
    not $forge.principal.user.userid in %global_allowed_service_accounts
    $forge.principal.hostname = $hostname

    $secret_read.metadata.event_timestamp.seconds <= $forge.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1606.001")
    $primary_entity = array_distinct($hostname)
    $acting_users = array_distinct($forge.principal.user.userid)
    $secret_read_commands = array_distinct($secret_read.target.process.command_line)
    $forge_commands = array_distinct($forge.target.process.command_line)
    $forge_event_count = count($forge.metadata.id)

  condition:
    $secret_read and $forge
}
