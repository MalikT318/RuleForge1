/*
  MITRE Technique : T1003.002 - Security Account Manager
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:39:23.019846+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_002_Unexpected_Parent_Spawns_SAM_Hive_Dump {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects an unexpected parent process (Office application, web server worker, print spooler, database service or document reader) spawning a shell, script interpreter or reg.exe whose command line saves, exports or copies the SAM, SECURITY or SYSTEM registry hives. These parents have no legitimate reason to dump local credential hives, so this lineage indicates exploitation or macro and web shell post-exploitation credential theft."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.002"
    mitre_technique_name = "OS Credential Dumping: Security Account Manager"
    log_prerequisites = "Requires Windows endpoint process telemetry with parent process path and full command line (EDR, Sysmon Event ID 1 or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup or imaging agents launched from a database service that export hives for system-state backups; vulnerability or compliance scanners run by a service host; administrators testing from a web-based management console; legitimate recovery tooling invoked by an application server."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes, approved admin tooling to %global_allowed_admin_tools, EDR and security agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Extend the parent process regex with client-specific application server executables if needed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|onenote|visio|mspub|acrord32|acrobat|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|spoolsv|sqlservr|mysqld|postgres)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(reg|cmd|powershell|pwsh|wscript|cscript|esentutl)\.exe$/ nocase
    $proc.target.process.command_line = /\b(save|export|copy)\b/ nocase
    $proc.target.process.command_line = /((hklm|hkey_local_machine)\\(sam|security|system)\b|\\config\\(sam|security|system)\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1003.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
