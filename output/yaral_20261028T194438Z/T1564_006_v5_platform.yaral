/*
  MITRE Technique : T1564.006 - Run Virtual Instance
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:23:29.104780+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_006_VM_Disk_Or_Sandbox_Config_Dropped_UserWritable {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of virtual machine disk images or Windows Sandbox configuration files (.wsb, .vhd/.vhdx, .vdi, .vmdk, .qcow2, .ova/.ovf) in user-writable or staging locations. Adversaries drop these artifacts to run a hidden virtual instance, so security tools cannot see activity inside the guest. This is file-creation based and independent of process command-line detections: it fires regardless of which hypervisor binary is later launched or how it is renamed."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.006"
    mitre_technique_name = "Hide Artifacts: Run Virtual Instance"
    log_prerequisites = "Requires EDR or Sysmon-equivalent file creation telemetry (Sysmon Event ID 11 or equivalent) with the creating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developers, QA and lab users who legitimately build or download VMs; Windows Sandbox users saving .wsb files; browsers saving OVA/VHDX downloads; backup, imaging and P2V conversion tools; Hyper-V host management services; Packer/Vagrant style build pipelines."
    tuning_guidance = "Add approved virtualization and imaging tooling to %global_allowed_admin_tools and %global_allowed_backup_processes. Add approved build service accounts to %global_allowed_service_accounts. Add known developer or lab hosts to %global_allowed_script_hosts. If browser downloads are noisy, exclude browser executables by name in the creating-process regex, or raise severity only when the creating process is a script interpreter or Office application."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(wsb|vhdx?|vdi|vmdk|qcow2?|ova|ovf)$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents|music|videos|pictures)|users\\public|programdata|windows\\temp|temp|perflogs|\$recycle\.bin)\\/ nocase
    not $file.principal.process.file.full_path = /\\(vmms|vmwp|vmcompute|vmconnect|virtmgmt|MsMpEng|MsSense|SenseIR|TrustedInstaller|msiexec)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1564.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_files = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
