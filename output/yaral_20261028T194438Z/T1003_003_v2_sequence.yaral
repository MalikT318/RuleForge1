/*
  MITRE Technique : T1003.003 - NTDS
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:40:57.266119+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_003_NTDS_Copy_With_Registry_Hive_Staging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects a copy of the Active Directory database (ntds.dit) being written outside the live NTDS directory, followed within 10 minutes on the same host by creation of a copied SYSTEM or SECURITY registry hive file. Together these provide what is needed to extract domain credential hashes offline. This is file-creation based and does not depend on command-line matching, so it also covers shadow copy extraction, IFM media creation and direct-copy tooling."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.003"
    mitre_technique_name = "OS Credential Dumping: NTDS"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 equivalent) with full target file paths from domain controllers and servers."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Domain controller backup or imaging jobs that stage ntds.dit and hives to a temporary location, AD IFM media creation by administrators for new DC promotion, disaster recovery tests, and AD health or migration tooling."
    tuning_guidance = "Add approved backup and imaging process paths to %global_allowed_backup_processes and approved AD maintenance tooling to %global_allowed_admin_tools. If the hive is usually copied before the database in your environment, widen the ordering. Limit deployment to domain controllers and Tier-0 servers to reduce noise."

  events:
    $ntds.metadata.event_type = "FILE_CREATION"
    $ntds.target.file.full_path = /\\ntds\.dit$/ nocase
    not $ntds.target.file.full_path = /\\windows\\ntds\\ntds\.dit$/ nocase
    not $ntds.principal.process.file.full_path = /\\(vssvc|wbengine|MsMpEng|TiWorker)\.exe$/ nocase
    not $ntds.principal.process.file.full_path in %global_allowed_backup_processes
    not $ntds.principal.process.file.full_path in %global_allowed_admin_tools
    $ntds.principal.hostname = $hostname

    $hive.metadata.event_type = "FILE_CREATION"
    $hive.target.file.full_path = /\\(system|security)(\.(hiv|hive|bak|save|sav|dmp))?$/ nocase
    not $hive.target.file.full_path = /\\windows\\system32\\config\\/ nocase
    not $hive.target.file.full_path = /\\windows\\(servicing|winsxs)\\/ nocase
    not $hive.principal.process.file.full_path = /\\(vssvc|wbengine|MsMpEng|TiWorker)\.exe$/ nocase
    not $hive.principal.process.file.full_path in %global_allowed_backup_processes
    not $hive.principal.process.file.full_path in %global_allowed_admin_tools
    $hive.principal.hostname = $hostname

    $ntds.metadata.event_timestamp.seconds <= $hive.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1003.003")
    $primary_entity = array_distinct($ntds.principal.hostname)
    $ntds_paths = array_distinct($ntds.target.file.full_path)
    $hive_paths = array_distinct($hive.target.file.full_path)
    $ntds_processes = array_distinct($ntds.principal.process.file.full_path)
    $hive_processes = array_distinct($hive.principal.process.file.full_path)
    $users = array_distinct($ntds.principal.user.userid)
    $event_count = count($ntds.metadata.id)

  condition:
    $ntds and $hive
}
