/*
  MITRE Technique : T1213 - Data from Information Repositories
  Tactic(s)       : Collection
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:21:58.197442+00:00
  Reference       : https://attack.mitre.org/techniques/T1213
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_Repository_Service_Spawns_Shell_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter spawned by a process that hosts an information repository or serves data (web/application server worker, database engine, web server). Collaboration portals such as SharePoint and wikis run under w3wp.exe, and database services hold the data adversaries mine. These processes do not normally launch interactive shells or script hosts. A child shell indicates web shell activity, SQL command execution, or an exploited repository service being used to mine or stage data."
    mitre_tactic = "Collection"
    mitre_technique = "T1213"
    mitre_technique_name = "Data from Information Repositories"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with populated parent process path (EDR or Sysmon Event ID 1, or Security Event 4688 with parent process name)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "SQL Server Agent jobs or xp_cmdshell used by approved maintenance, IIS-hosted applications that legitimately shell out (reporting, PDF generation, deployment hooks), backup or patch tooling launched from the database or web service, and SharePoint farm administration scripts."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts. For recurring legitimate cases, add the parent path to the allowlist rather than widening the child filter. Consider excluding known application-pool maintenance hosts through %global_allowed_script_hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(w3wp|sqlservr|mysqld|postgres|httpd|nginx|php-cgi|tomcat[0-9]*)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|powershell_ise|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1213")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
