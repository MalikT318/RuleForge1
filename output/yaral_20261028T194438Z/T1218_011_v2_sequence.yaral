/*
  MITRE Technique : T1218.011 - Rundll32
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:56:10.019832+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_011_Rundll32_Dropped_DLL_Then_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A DLL, CPL or OCX file is written to a user-writable staging location and, within 10 minutes on the same host, rundll32.exe makes an outbound connection to an external address. This sequence is typical of rundll32 proxy execution of a dropped payload that then beacons or downloads further stages. It covers file-drop and network behaviour, not process command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.011"
    mitre_technique_name = "System Binary Proxy Execution: Rundll32"
    log_prerequisites = "Requires endpoint telemetry that records file creation events (with the writing process) and network connection events attributed to the initiating process, such as an EDR agent or Sysmon (Event IDs 11 and 3)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers or updaters that unpack DLLs to AppData, ProgramData or Temp and then use rundll32 for legitimate cloud-sync or licensing calls. Control Panel applets (.cpl) from vendors. Developer machines building and testing DLLs. Remote-support and RMM agents that stage helper libraries."
    tuning_guidance = "Add approved installer, deployment and RMM binaries to %global_allowed_admin_tools. Add EDR and AV agents that write DLLs to staging paths to %global_allowed_security_tools. Narrow or extend the staging-path regex per client. Consider raising severity when the DLL writer is an Office application, browser or script interpreter."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop)|programdata|windows\\temp|users\\public)\\.*\.(dll|cpl|ocx)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|TrustedInstaller|msiexec)\.exe$/ nocase
    $file.principal.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\rundll32\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    $net.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.011")
    $primary_entity = array_distinct($hostname)
    $dropped_files = array_distinct($file.target.file.full_path)
    $dropping_processes = array_distinct($file.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $affected_users = array_distinct($net.principal.user.userid)
    $connection_count = count($net.metadata.id)

  condition:
    $file and $net
}
