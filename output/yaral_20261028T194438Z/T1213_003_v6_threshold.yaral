/*
  MITRE Technique : T1213.003 - Code Repositories
  Tactic(s)       : Collection
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:27:13.594325+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_003_Code_Repo_Bulk_Access_Per_User {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single user performs a high volume of code repository clone, fetch, download, archive or export operations within ten minutes. Each action is benign alone, but bulk repository collection can indicate source code or embedded-credential harvesting through a compromised account or token."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.003"
    mitre_technique_name = "Data from Information Repositories: Code Repositories"
    log_prerequisites = "Requires SaaS or cloud audit logs for the code hosting service, normalised to USER_RESOURCE_ACCESS with the action name populated in metadata.product_event_type and the repository in target.resource.name."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "CI/CD runners and build bots using user-owned tokens, developers onboarding or re-cloning many repositories, migration or mirroring projects, code-search and SAST indexers, backup jobs, and security researchers or audit teams."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts and %global_allowed_cloud_principals. Raise or lower the #access threshold (default 25) per client baseline. Review the $distinct_repos and $event_count outcome values to separate repeated pulls of one repository from wide enumeration across many."

  events:
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.metadata.product_event_type = /((repo|git|source|code).*(clone|fetch|pull|download|archive|export))|((clone|fetch|pull|download|archive|export).*(repo|git|source|code))/ nocase
    $access.target.resource.name != ""
    $access.principal.user.userid = $user
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_cloud_principals

  match:
    $user over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1213.003")
    $primary_entity = array_distinct($user)
    $event_count = count($access.metadata.id)
    $distinct_repos = array_distinct($access.target.resource.name)
    $actions = array_distinct($access.metadata.product_event_type)
    $source_ips = array_distinct($access.principal.ip)

  condition:
    #access >= 25
}
