/*
  MITRE Technique : T1021.002 - SMB/Windows Admin Shares
  Tactic(s)       : Lateral Movement
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:37:19.258316+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_002_Remote_SMB_Executable_Drop_Admin_Share {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an executable or script file written into the Windows directory tree by the kernel System process (PID 4), the footprint of a remote SMB write to ADMIN$ or C$. This is file-creation telemetry on the receiving host, not command-line matching. Note: the 'alternate platform' angle conflicts with the mandatory Windows platform requirement, so this rule stays on Windows and provides additive coverage through FILE_CREATION telemetry instead of PROCESS_LAUNCH."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.002"
    mitre_technique_name = "Remote Services: SMB/Windows Admin Shares"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11) that records the writing process PID. SMB server writes appear as the System process (PID 4)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software deployment and patching tools that push installers over admin shares, remote administrators copying maintenance scripts, imaging and migration tooling."
    tuning_guidance = "Add approved deployment or patch file paths to %global_allowed_admin_tools and approved administrator accounts to %global_allowed_admin_users. Where telemetry records the System process without a PID, change the principal.process.pid condition to match the System process path."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.pid = "4"
    $file.target.file.full_path = /^[a-z]:\\windows\\(system32\\|syswow64\\|temp\\|tasks\\)?[^\\]+\.(exe|dll|bat|cmd|ps1|vbs|msi|scr)$/ nocase
    not $file.target.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1021.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_files = array_distinct($file.target.file.full_path)

  condition:
    $file
}
