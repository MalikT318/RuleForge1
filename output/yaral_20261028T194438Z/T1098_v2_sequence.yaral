/*
  MITRE Technique : T1098 - Account Manipulation
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:39:34.761687+00:00
  Reference       : https://attack.mitre.org/techniques/T1098
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_NetDevice_Mgmt_Login_Then_Account_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A user authenticates to a network device management plane from a source outside the approved management sources, then changes account permissions or privilege levels on the same device within ten minutes. This sequence is consistent with an adversary using a compromised credential to grant or elevate access for persistence (account manipulation on routers, switches, firewalls and similar devices)."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098"
    mitre_technique_name = "Account Manipulation"
    log_prerequisites = "Requires network device AAA / management-plane authentication logs (SSH, console, HTTPS, TACACS+/RADIUS accounting) normalised to USER_LOGIN, and account or privilege-level change audit logs normalised to USER_CHANGE_PERMISSIONS, with principal.user.userid, principal.ip and target.hostname populated."
    platform = "Network Devices"
    log_source = "identity"
    false_positives = "Planned network engineering changes from a jump host or VPN pool that is not yet in the approved management sources, onboarding or offboarding of network administrators, break-glass administrator activity, and automation or orchestration platforms that log in and adjust local accounts in the same session."
    tuning_guidance = "Add jump hosts, bastions and management subnets to %global_allowed_mgmt_sources. Add network admin accounts to %global_allowed_admin_users and automation or orchestration accounts to %global_allowed_service_accounts. If target.hostname is not populated for a log source, normalise it in the parser before enabling the rule."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid != ""
    $auth.target.hostname != ""
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.principal.user.userid in %global_allowed_service_accounts
    $auth.principal.user.userid = $user
    $auth.target.hostname = $device

    $chg.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $chg.target.user.userid != ""
    not $chg.principal.user.userid in %global_allowed_admin_users
    not $chg.principal.user.userid in %global_allowed_service_accounts
    $chg.principal.user.userid = $user
    $chg.target.hostname = $device

    $auth.metadata.event_timestamp.seconds <= $chg.metadata.event_timestamp.seconds

  match:
    $user, $device over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1098")
    $primary_entity = array_distinct($device)
    $acting_user = array_distinct($user)
    $login_source_ips = array_distinct($auth.principal.ip)
    $modified_accounts = array_distinct($chg.target.user.userid)
    $change_count = count($chg.metadata.id)

  condition:
    $auth and $chg
}
