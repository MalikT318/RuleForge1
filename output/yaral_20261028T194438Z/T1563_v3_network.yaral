/*
  MITRE Technique : T1563 - Remote Service Session Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:06:42.987150+00:00
  Reference       : https://attack.mitre.org/techniques/T1563
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_Linux_Outbound_Remote_Session_Protocol_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects perimeter-observed SSH (22) or Telnet (23) connections from an internal source to a non-internal destination, where the source is not an approved management host. Interactive remote-session protocols leaving the network from an unapproved source can indicate a hijacked session, a forwarded SSH agent, or a hijacked session used as a pivot out of the environment. This is a network-side view of T1563 on Linux and complements endpoint coverage."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1563"
    mitre_technique_name = "Remote Service Session Hijacking"
    log_prerequisites = "Requires firewall, proxy or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. The log does not carry process fields. The Linux hosts are identified only by source IP."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Administrators or developers using SSH to reach external servers, Git over SSH to hosted repositories, SFTP and rsync transfers to partners, automation or CI runners connecting to cloud instances, and legacy Telnet to external network devices."
    tuning_guidance = "Add approved bastion, jump-host and automation source IPs to %global_allowed_mgmt_sources. Ensure %rfc1918_internal is populated for the tenant. For noisy environments, scope the rule to server-segment sources or raise the risk score only when the destination is rare. Consider a companion threshold rule on volume if needed."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port >= 22
    $net.target.port <= 23
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1563")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
