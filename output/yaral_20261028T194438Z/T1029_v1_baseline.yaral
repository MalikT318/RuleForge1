/*
  MITRE Technique : T1029 - Scheduled Transfer
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:49:08.322595+00:00
  Reference       : https://attack.mitre.org/techniques/T1029
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1029_Off_Hours_Large_Outbound_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a large outbound data transfer to an external destination during the overnight window. Adversaries schedule exfiltration for quiet hours to blend into normal traffic. Detection relies only on network-observable signals (direction, volume, time of day) and does not depend on destination, tool, or protocol."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1029"
    mitre_technique_name = "Scheduled Transfer"
    log_prerequisites = "Firewall or perimeter flow logs normalised to UDM NETWORK_FLOW with network.sent_bytes populated. Events must be logged with the session close or summary byte counts."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Scheduled offsite or cloud backups, overnight software or patch distribution, cloud file sync, log shipping and telemetry uploads, replication jobs, and legitimate batch jobs in other time zones."
    tuning_guidance = "The off-hours window is evaluated in UTC (hours 00:00-04:59). Shift the hour bounds to match each client's local overnight period. Raise or lower the sent_bytes threshold to fit the client's baseline. Add known-good external destinations to %global_allowed_domains. Where flow logs carry no target hostname, exclude by source with a client-specific variant."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    $net.network.sent_bytes > 52428800
    timestamp.get_hour($net.metadata.event_timestamp.seconds, "UTC") >= 0
    timestamp.get_hour($net.metadata.event_timestamp.seconds, "UTC") < 5
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1029")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
