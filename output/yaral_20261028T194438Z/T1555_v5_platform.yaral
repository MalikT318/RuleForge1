/*
  MITRE Technique : T1555 - Credentials from Password Stores
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:53:11.338034+00:00
  Reference       : https://attack.mitre.org/techniques/T1555
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_Cloud_Secret_Store_Read_By_Unapproved_Principal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects retrieval of secret values or instance administrator passwords from a cloud secrets vault or credential store by an identity that is not an approved service account, cloud principal, or named administrator. Covers the control-plane equivalent of searching password stores: secret value reads, batch secret reads, secret version access, and Windows instance password retrieval."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555"
    mitre_technique_name = "Credentials from Password Stores"
    log_prerequisites = "Cloud audit logging must be enabled and ingested, including data-plane or data-access events for the secrets manager or key vault service. Management-event-only logging will miss secret reads on some providers."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Application deployment pipelines and CI/CD roles that fetch secrets at deploy time, serverless functions or workloads reading their own secrets via role identities, break-glass access by engineers, infrastructure-as-code tooling, and secret rotation automation."
    tuning_guidance = "Add automation and workload identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Add named administrators to %global_allowed_admin_users. If a client's secret reads are very noisy, raise severity only for production vaults by adding a target.resource.name regex filter per tenant."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /(GetSecretValue|BatchGetSecretValue|AccessSecretVersion|SecretGet|GetSecret|GetPasswordData)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1555")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_calls = array_distinct($cloud.metadata.product_event_type)
    $secret_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
