/*
  MITRE Technique : T1657 - Financial Theft
  Tactic(s)       : Impact
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:01:48.401163+00:00
  Reference       : https://attack.mitre.org/techniques/T1657
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1657_Linux_Ransom_Note_Mass_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a single Linux host creating several files named like ransom or extortion notes (for example 'how to decrypt', 'restore your files') within ten minutes. One such file is rarely meaningful, but ransomware drops the same note into many directories. Extortion by ransomware is a primary financial theft scenario."
    mitre_tactic = "Impact"
    mitre_technique = "T1657"
    mitre_technique_name = "Financial Theft"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-creation records normalised to UDM FILE_CREATION with principal.hostname and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup or file-recovery utilities writing restore instructions, data recovery tooling run by administrators, documentation or training material about decryption and recovery being unpacked, and security awareness or ransomware simulation exercises."
    tuning_guidance = "Add approved backup and restore processes to %global_allowed_backup_processes and admin tooling to %global_allowed_admin_tools. Raise the #file threshold on hosts that routinely unpack documentation archives. Review the affected_paths outcome to confirm that notes are spread across many directories."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\/[^\/]*(how[_ -]?to[_ -]?(decrypt|recover|restore|unlock)|(decrypt|recover|restore)[_ -]?(my|your|all)?[_ -]?(files|data)|ransom|readme[_ -]?(to|for)[_ -]?(decrypt|restore|recover)|files[_ -]?(are[_ -]?)?(encrypted|locked))[^\/]*\.(txt|html|hta|md|rtf)$/ nocase
    not $file.target.file.full_path = /^\/(usr\/(share|lib|src)|opt\/[^\/]+\/doc|var\/lib\/(dpkg|rpm)|proc|sys)\// nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(85)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1657")
    $primary_entity = array_distinct($host)
    $affected_paths = array_distinct($file.target.file.full_path)
    $writing_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 5
}
