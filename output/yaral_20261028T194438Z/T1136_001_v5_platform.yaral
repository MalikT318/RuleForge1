/*
  MITRE Technique : T1136.001 - Local Account
  Tactic(s)       : Persistence
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:08:26.296261+00:00
  Reference       : https://attack.mitre.org/techniques/T1136/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_001_Containers_K8s_ServiceAccount_Create_Via_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP POST to the Kubernetes API server that creates a ServiceAccount (/api/v1/namespaces/<ns>/serviceaccounts), observed at a proxy or perimeter device with TLS inspection. A new in-cluster identity is a common persistence mechanism (local account creation) after cluster access is obtained. This is network-observable coverage and does not depend on process or command-line telemetry."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136.001"
    mitre_technique_name = "Create Account: Local Account"
    log_prerequisites = "Requires firewall or proxy logs normalised to NETWORK_HTTP with network.http.method and target.url populated. This needs TLS inspection or decryption on the path to the Kubernetes API server (commonly TCP 443 or 6443)."
    platform = "Containers"
    log_source = "firewall"
    false_positives = "CI/CD pipelines and GitOps controllers that provision ServiceAccounts, Helm or operator installs, cluster-bootstrap automation, and platform engineers onboarding new namespaces or workloads."
    tuning_guidance = "Add deployment pipeline and automation identities to %global_allowed_service_accounts. Add jump hosts, CI runners and admin workstations to %global_allowed_mgmt_sources. Add named platform administrators to %global_allowed_admin_users if the proxy logs user identity. If the proxy also logs HTTP response codes, consider requiring a 2xx response to reduce noise from rejected requests."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /\/api\/v1\/namespaces\/[^\/\?]+\/serviceaccounts\/?(\?.*)?$/ nocase
    not $http.principal.user.userid in %global_allowed_service_accounts
    not $http.principal.user.userid in %global_allowed_admin_users
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1136.001")
    $primary_entity = array_distinct($http.principal.ip)
    $api_server = array_distinct($http.target.hostname)
    $request_urls = array_distinct($http.target.url)
    $request_users = array_distinct($http.principal.user.userid)

  condition:
    $http
}
