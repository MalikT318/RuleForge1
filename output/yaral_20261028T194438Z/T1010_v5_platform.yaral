/*
  MITRE Technique : T1010 - Application Window Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:18:50.821486+00:00
  Reference       : https://attack.mitre.org/techniques/T1010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

// NOTE: The requested "alternate platform" angle conflicts with the mandatory Windows platform and the windows_endpoint log source. This rule keeps Windows and gets additive coverage through PROCESS_MODULE_LOAD instead of PROCESS_LAUNCH command-line matching.
rule MSSP_T1010_Script_Host_Loads_UI_Automation_Module {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a scripting host (PowerShell, WSH, mshta, rundll32) loading the .NET UI Automation client assemblies. These assemblies let a script enumerate and inspect open application windows without any distinctive command line. Detection is based on module-load telemetry, not process-creation command lines, so it complements existing command-line rules."
    mitre_tactic = "Discovery"
    mitre_technique = "T1010"
    mitre_technique_name = "Application Window Discovery"
    log_prerequisites = "Requires EDR or Sysmon-equivalent image/module load telemetry (Sysmon Event ID 7 or equivalent) normalised to PROCESS_MODULE_LOAD. Module-load logging must include .NET assemblies from the GAC and native image paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Accessibility and UI test automation run from PowerShell (e.g. UI automation test frameworks), RPA tooling, helpdesk scripts that drive GUI applications, and software deployment scripts that interact with installer dialogs."
    tuning_guidance = "Add approved automation or test hosts to %global_allowed_script_hosts and approved RMM or deployment tooling to %global_allowed_admin_tools. If the module-load source does not populate target.process.file.full_path, map the loaded module path accordingly in the parser. Raise severity for servers where GUI automation is not expected."

  events:
    $mod.metadata.event_type = "PROCESS_MODULE_LOAD"
    $mod.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32)\.exe$/ nocase
    $mod.target.process.file.full_path = /\\UIAutomation(Client|ClientsideProviders|Types)\.dll$/ nocase
    not $mod.principal.process.file.full_path in %global_allowed_script_hosts
    not $mod.principal.process.file.full_path in %global_allowed_admin_tools
    not $mod.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR)\.exe$/ nocase

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1010")
    $primary_entity = array_distinct($mod.principal.hostname)
    $loading_process = array_distinct($mod.principal.process.file.full_path)
    $loaded_module = array_distinct($mod.target.process.file.full_path)
    $user = array_distinct($mod.principal.user.userid)

  condition:
    $mod
}
