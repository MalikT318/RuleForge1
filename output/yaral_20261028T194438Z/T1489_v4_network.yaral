/*
  MITRE Technique : T1489 - Service Stop
  Tactic(s)       : Impact
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:39:18.151473+00:00
  Reference       : https://attack.mitre.org/techniques/T1489
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1489_Linux_Remote_Container_Orchestrator_Stop_API {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux host issuing HTTP calls to an external container or orchestration management API that stop or kill containers, or delete Kubernetes workloads (deployments, statefulsets, daemonsets). This is the network-side signature of service stop (T1489) against containerised services, and it complements endpoint command-line rules because it still fires when the stop is done through an API client, script or custom binary rather than systemctl, service or docker CLI."
    mitre_tactic = "Impact"
    mitre_technique = "T1489"
    mitre_technique_name = "Service Stop"
    log_prerequisites = "Requires Linux endpoint network telemetry or a proxy/sensor that normalises plaintext HTTP to NETWORK_HTTP with network.http.method and target.url populated. TLS-encrypted API traffic is only visible where the sensor or an inspecting proxy can see the URL."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Remote CI/CD or deployment pipelines, autoscalers and orchestration controllers, authorised admins managing hosted container platforms, chaos-engineering and resilience testing, and cloud-hosted clusters managed from inside the environment."
    tuning_guidance = "Add approved deployment and orchestration client binaries to %global_allowed_admin_tools. Add automation identities to %global_allowed_service_accounts. Add approved management-plane source addresses to %global_allowed_mgmt_sources. Add approved external management endpoints to %global_allowed_domains if the URL host is populated in your telemetry."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    (
      (
        $http.network.http.method = "POST" and
        $http.target.url = /\/containers\/[a-z0-9_.-]+\/(stop|kill)(\?|$)/ nocase
      )
      or
      (
        $http.network.http.method = "DELETE" and
        $http.target.url = /\/apis\/apps\/v1\/namespaces\/[^\/]+\/(deployments|statefulsets|daemonsets)\/[^\/?]+/ nocase
      )
    )
    not $http.target.ip in %rfc1918_internal
    not $http.principal.process.file.full_path in %global_allowed_admin_tools
    not $http.principal.user.userid in %global_allowed_service_accounts
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1489")
    $primary_entity = array_distinct($http.principal.hostname)
    $target_urls = array_distinct($http.target.url)
    $destination_ips = array_distinct($http.target.ip)
    $initiating_process = array_distinct($http.principal.process.file.full_path)
    $initiating_user = array_distinct($http.principal.user.userid)

  condition:
    $http
}
