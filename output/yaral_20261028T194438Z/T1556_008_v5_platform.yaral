/*
  MITRE Technique : T1556.008 - Network Provider DLL
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:26:27.856525+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_008_Network_Provider_Registry_Registration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry writes that register a network provider DLL (a service's NetworkProvider\\ProviderPath value) or add a provider to the NetworkProvider\\Order\\ProviderOrder list. A rogue provider DLL receives cleartext credentials from mpnotify.exe through NPLogonNotify() at every logon. This is registry-based coverage that complements process command-line detections. Network Provider DLL abuse exists only on Windows, so the rule is written for Windows."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.008"
    mitre_technique_name = "Modify Authentication Process: Network Provider DLL"
    log_prerequisites = "Requires Windows registry-modification telemetry (EDR or Sysmon registry value-set events) covering HKLM\\SYSTEM\\CurrentControlSet\\Services and HKLM\\SYSTEM\\CurrentControlSet\\Control\\NetworkProvider."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate installs of VPN clients, virtual-machine guest tools, third-party file-system or network-redirector software, and SSO or credential-provider products that register a network provider. Approved software deployment tooling writing these values."
    tuning_guidance = "Add approved deployment and installer processes to %global_allowed_admin_tools. Add endpoint agents to %global_allowed_security_tools. Check the provider DLL path in the outcome against the vendor's expected install location, and extend the Microsoft default provider DLL exclusion only if it is too noisy for a client."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      (
        $reg.target.registry.registry_key = /\\services\\[^\\]+\\networkprovider$/ nocase and
        $reg.target.registry.registry_value_name = /^providerpath$/ nocase
      ) or
      (
        $reg.target.registry.registry_key = /\\control\\networkprovider\\order$/ nocase and
        $reg.target.registry.registry_value_name = /^providerorder$/ nocase
      )
    )
    not $reg.target.registry.registry_key = /\\services\\(lanmanworkstation|rdpnp|webclient)\\networkprovider$/ nocase
    not $reg.target.registry.registry_value_data = /^(%systemroot%|[a-z]:\\windows)\\system32\\(ntlanman|drprov|davclnt|rdpnp)\.dll$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1556.008")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $registry_value_data = array_distinct($reg.target.registry.registry_value_data)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
