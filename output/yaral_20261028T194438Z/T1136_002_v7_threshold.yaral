/*
  MITRE Technique : T1136.002 - Domain Account
  Tactic(s)       : Persistence
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:10:37.122417+00:00
  Reference       : https://attack.mitre.org/techniques/T1136/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_002_Linux_Bulk_Domain_Account_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects multiple directory (domain) account creation commands being run on a single Linux host within 10 minutes. Examples are Samba AD, FreeIPA, adcli and net ads user-creation subcommands. A single creation is routine administration. Several in a short window suggest an adversary creating persistent domain accounts or scripting bulk account creation."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136.002"
    mitre_technique_name = "Create Account: Domain Account"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records, normalised to UDM PROCESS_LAUNCH with target.process.command_line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Identity-management administrators onboarding staff in bulk, HR-driven provisioning scripts, configuration management or automation runs, directory migration projects, lab or test domain builds."
    tuning_guidance = "Add approved provisioning tooling and parent processes to %global_allowed_admin_tools. Add named identity administrators to %global_allowed_admin_users. Raise the #proc threshold on hosts that run frequent legitimate provisioning, such as domain controllers or IdM servers, or reduce it to 2 for high-security environments."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(samba-tool\s+user\s+(create|add)\b|ipa\s+(user-add|stageuser-add)\b|adcli\s+create-user\b|net\s+ads\s+user\s+add\b)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1136.002")
    $primary_entity = array_distinct($host)
    $acting_users = array_distinct($proc.principal.user.userid)
    $commands_observed = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
