/*
  MITRE Technique : T1525 - Implant Internal Image
  Tactic(s)       : Persistence
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:25:01.102387+00:00
  Reference       : https://attack.mitre.org/techniques/T1525
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1525_Container_Registry_Image_Push_By_Unapproved_Principal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an image push or layer upload to a container registry by an identity that is not an approved CI/CD, automation or administrator principal. An adversary with registry write access can backdoor an image that provisioning tooling pulls by tag (for example 'latest'), which gives them persistence in the environment. The rule matches the registry write API action, not any specific image or repository name."
    mitre_tactic = "Persistence"
    mitre_technique = "T1525"
    mitre_technique_name = "Implant Internal Image"
    log_prerequisites = "Requires cloud control-plane audit logs with registry API activity normalised to UDM RESOURCE_CREATION. Registry data-plane or data-access audit logging must be enabled, because image pushes are often not logged by default. metadata.product_event_type must carry the native API action name."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "CI/CD pipelines and build service identities not yet in the allowlists, developers pushing test images to non-production registries, image promotion or replication jobs, base-image refresh automation, and registry migration projects."
    tuning_guidance = "Add CI/CD and build identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named release engineers to %global_allowed_admin_users. For stricter coverage, scope the rule per client to production registries by adding a target.resource.name regex in that client's tenant copy. Lower severity if the client has high push volume from many developers."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /(PutImage|CompleteLayerUpload|BatchCompleteLayerUpload|InitiateLayerUpload|REGISTRIES\/PUSH\/WRITE|UploadArtifact|docker\.images\.push)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1525")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_actions = array_distinct($cloud.metadata.product_event_type)
    $target_registry_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
