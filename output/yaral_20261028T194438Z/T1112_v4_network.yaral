/*
  MITRE Technique : T1112 - Modify Registry
  Tactic(s)       : Defense Impairment, Persistence
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:13:04.026057+00:00
  Reference       : https://attack.mitre.org/techniques/T1112
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1112_Registry_Tool_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a built-in Windows registry utility (reg, regedit, regini) opening a network connection to a non-internal address. These tools operate on the local or remote registry over internal RPC/SMB and have no legitimate reason to talk to external hosts. External connections indicate registry import or export from an attacker-hosted share (WebDAV/SMB), proxied execution, or a renamed or injected process masquerading as a registry tool. This is network-side coverage that complements process command-line rules for registry modification."
    mitre_tactic = "Defense Impairment, Persistence"
    mitre_technique = "T1112"
    mitre_technique_name = "Modify Registry"
    log_prerequisites = "Requires endpoint network telemetry that attributes each NETWORK_CONNECTION to the initiating process (EDR or Sysmon Event ID 3). The principal process path must be populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admins importing .reg files from approved external or cloud file shares, RMM or deployment tooling that wraps reg.exe and reaches out to vendor infrastructure, and EDR network-isolation or proxy products that attribute traffic to the wrong process."
    tuning_guidance = "Add approved parent processes (RMM, deployment tools) to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Make sure %rfc1918_internal covers all internal space in the client environment. Raise severity if the connection is followed by registry run-key or security-setting changes on the same host."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(reg|regedit|regini)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.parent_process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1112")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $process_command_line = array_distinct($net.principal.process.command_line)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
