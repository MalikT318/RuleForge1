/*
  MITRE Technique : T1071.002 - File Transfer Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:05:58.996360+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_002_Perimeter_FTP_Control_Then_Large_Outbound_Flow {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An internal host opens an outbound file-transfer control channel (FTP, FTPS or TFTP port) to an external address and, within five minutes, sends a large volume of data to the same external address on a non-privileged port. This pattern matches file-transfer protocol abuse for command and control or exfiltration, such as an FTP data channel or an FTPS/TFTP session carrying data."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.002"
    mitre_technique_name = "Application Layer Protocol: File Transfer Protocols"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs and flow records with source IP, destination IP, destination port and sent-bytes populated in UDM."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate partner or vendor FTP/SFTP-over-FTPS file exchanges, automated B2B batch transfers, firmware or configuration backups pushed to external TFTP/FTP servers, and software update mirrors that use FTP."
    tuning_guidance = "Add approved source addresses (such as managed file transfer gateways) to %global_allowed_mgmt_sources and known-good vendor destinations to %global_allowed_domains. Adjust the sent_bytes threshold (default about 5 MB) per client baseline. Add authorised transfer hosts to %global_allowed_scanners if they generate matching traffic."

  events:
    $ftp_ctl.metadata.event_type = "NETWORK_CONNECTION"
    ($ftp_ctl.target.port = 21 or $ftp_ctl.target.port = 69 or $ftp_ctl.target.port = 990)
    $ftp_ctl.principal.ip = $src
    $ftp_ctl.target.ip = $dst
    not $ftp_ctl.target.ip in %rfc1918_internal
    not $ftp_ctl.principal.ip in %global_allowed_mgmt_sources
    not $ftp_ctl.target.hostname in %global_allowed_domains

    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.target.port > 1023
    $flow.network.sent_bytes > 5000000
    $flow.principal.ip = $src
    $flow.target.ip = $dst
    not $flow.target.ip in %rfc1918_internal
    not $flow.principal.ip in %global_allowed_mgmt_sources

    $ftp_ctl.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $src, $dst over 5m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1071.002")
    $primary_entity = array_distinct($src)
    $destination_ips = array_distinct($dst)
    $control_ports = array_distinct($ftp_ctl.target.port)
    $data_ports = array_distinct($flow.target.port)
    $max_sent_bytes = max($flow.network.sent_bytes)

  condition:
    $ftp_ctl and $flow
}
