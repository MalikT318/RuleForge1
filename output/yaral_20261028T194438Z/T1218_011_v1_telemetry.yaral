/*
  MITRE Technique : T1218.011 - Rundll32
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:55:53.010874+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_011_Rundll32_Drops_Executable_Content_User_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects rundll32.exe writing executable or script content (DLL, EXE, SCR, CPL, SCT, HTA, script files) into user-writable staging locations. Rundll32 is a loader and rarely creates such files in normal operation. This behaviour indicates a proxied-execution payload dropping a second stage, or a staged DLL being written for later rundll32 execution. The rule detects the resulting file artifact, so it still fires when command-line logging is evaded or obfuscated."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.011"
    mitre_technique_name = "System Binary Proxy Execution: Rundll32"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry with the writing process populated (EDR file events or Sysmon Event ID 11) normalised to UDM FILE_CREATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Installers and updaters that call rundll32 to run setup DLL entry points (for example, some printer driver and legacy MSI custom actions), cloud-sync or collaboration clients unpacking components under AppData, and IT packaging scripts that use rundll32 during deployment."
    tuning_guidance = "Add service and automation accounts to %global_allowed_service_accounts, named administrators to %global_allowed_admin_users, and hosts used for software packaging or deployment to %global_allowed_script_hosts. If a specific vendor updater is noisy, request a narrow exclusion on the dropped file path rather than widening the process condition."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\rundll32\.exe$/ nocase
    $file.target.file.full_path = /\.(dll|exe|scr|cpl|sct|hta|js|jse|vbs|vbe|ps1|bat|cmd)$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop)|programdata|users\\public|windows\\temp|temp)\\/ nocase
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1218.011")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_files = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
