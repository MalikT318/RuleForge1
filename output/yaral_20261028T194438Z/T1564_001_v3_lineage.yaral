/*
  MITRE Technique : T1564.001 - Hidden Files and Directories
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:14:04.953264+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_001_Linux_Service_Parent_Spawns_Hidden_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, database, print or similar network-facing service process spawning either a hidden (dot-prefixed) executable or a shell/interpreter that runs a hidden file from a world-writable staging directory. Pivots on the anomalous parent-child lineage rather than on the hiding action itself. Typical of webshell or service-exploit post-exploitation staging payloads in dot-files."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.001"
    mitre_technique_name = "Hide Artifacts: Hidden Files and Directories"
    log_prerequisites = "Requires Linux EDR or auditd (execve) process telemetry populating principal.process.file.full_path (parent) and target.process.file.full_path (child)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Database maintenance hooks (e.g. archive or backup commands launched by the database service), PHP applications calling helper scripts, CUPS filters, application installers or updaters run through a service parent, and monitoring agents spawned by a web or application server."
    tuning_guidance = "Add legitimate parent service binaries or hosts to %global_allowed_script_hosts. Add approved helper binaries or scripts to %global_allowed_admin_tools. Extend the parent regex with additional exposed services for the environment (for example application servers) where parent-spawns-shell is not expected."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9.]*|php-cgi|tomcat[0-9]*|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|squid|named)$/ nocase
    (
      $proc.target.process.file.full_path = /\/\.[^\/]+$/ nocase or
      (
        $proc.target.process.file.full_path = /\/(ba|da|a|z|k|c|tc|fi)?sh$|\/(python[0-9.]*|perl|ruby|php[0-9.]*)$/ nocase and
        $proc.target.process.command_line = /(\/tmp|\/dev\/shm|\/var\/tmp|\/var\/www|\/run\/user)\/([^\s\/]+\/)*\.[A-Za-z0-9_][^\s\/]*/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1564.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
