/*
  MITRE Technique : T1542.003 - Bootkit
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:47:22.257241+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_003_Linux_Bootloader_ESP_Modified_By_Untrusted_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of bootloader components on Linux (EFI System Partition binaries and configs under /boot/efi/EFI, and GRUB boot images and modules under /boot/grub or /boot/grub2) by a process that is not a trusted package manager, bootloader installer, firmware updater, or allowlisted admin or security tool. Bootkits persist by patching these files so adversary code runs before the OS loads."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.003"
    mitre_technique_name = "Pre-OS Boot: Bootkit"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules (-w /boot -p wa) normalized to UDM FILE_MODIFICATION with principal.process.file.full_path and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Kernel and bootloader package upgrades (shim, grub, systemd-boot), grub-install or update-grub runs, fwupd UEFI capsule and dbx updates, distro upgrade tooling, config management pushing grub settings, and admins hand-editing GRUB configuration."
    tuning_guidance = "Add approved deployment or patching binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. The built-in exclusion covers only package managers and bootloader tools running from standard system directories. Extend the path regex if the fleet has non-standard ESP mount points. Deploy a companion FILE_CREATION variant to cover newly dropped .efi files."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/boot\/(efi\/EFI\/.+|grub2?\/(i386-pc|x86_64-efi|arm64-efi)\/.+|grub2?\/(core|boot)\.img)$/ nocase
    not $file.principal.process.file.full_path = /^\/usr\/(s?bin|libexec|lib\/fwupd|lib\/systemd)\/(dpkg|apt|apt-get|rpm|dnf|yum|zypper|packagekitd|grub-install|grub2-install|update-grub|grub-mkconfig|grub2-mkconfig|shim-install|bootctl|fwupd|fwupdmgr|fwupdtool|kernel-install|dracut|update-initramfs|mkinitrd|ostree|rpm-ostree)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1542.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_files = array_distinct($file.target.file.full_path)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $modifying_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
