/*
  MITRE Technique : T1133 - External Remote Services
  Tactic(s)       : Persistence, Initial Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:49:41.314657+00:00
  Reference       : https://attack.mitre.org/techniques/T1133
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1133_Linux_Container_ExposedService_Spawns_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an internet-facing service process (web server, application runtime, database, cache) spawning a shell or script interpreter on a Linux host or inside a container. This lineage is a strong result of an exposed service being abused for initial access or persistence (T1133), for example an unauthenticated management web UI, a web shell, or an exposed service API reaching code execution. The rule matches on process lineage only, not command-line content, so it complements command-line detections."
    mitre_tactic = "Persistence, Initial Access"
    mitre_technique = "T1133"
    mitre_technique_name = "External Remote Services"
    log_prerequisites = "Requires container runtime or node-level process telemetry (EDR, auditd execve, or runtime security sensor) that populates parent (principal.process) and child (target.process) executable paths for processes in containers and on hosts."
    platform = "Linux"
    log_source = "container"
    false_positives = "Application health-check or entrypoint scripts that run via a shell from the service; database maintenance hooks (e.g. archive or backup commands launched by the database server); CGI or PHP applications that legitimately shell out; Java or Node build and deployment tooling inside CI containers; admin troubleshooting via interactive exec in a service container."
    tuning_guidance = "Add approved parent executable paths to %global_allowed_script_hosts, add approved deployment or management binaries to %global_allowed_admin_tools, and add approved service accounts to %global_allowed_service_accounts. If java or node parents are noisy in build or CI clusters, scope them out via the allowlists rather than removing them from the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|caddy|traefik|haproxy|envoy|gunicorn|uwsgi|php-fpm[0-9.]*|tomcat[0-9.]*|java|node|mysqld|mariadbd|postgres|redis-server|mongod|memcached)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|ash|zsh|ksh|csh|tcsh|python[0-9.]*|perl|ruby)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1133")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
