/*
  MITRE Technique : T1056.004 - Credential API Hooking
  Tactic(s)       : Collection, Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:50:38.631046+00:00
  Reference       : https://attack.mitre.org/techniques/T1056/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1056_004_AppInit_AppCert_DLL_Registry_Hook_Config {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of the registry values that make Windows load an arbitrary DLL into other processes: AppInit_DLLs, LoadAppInit_DLLs and AppCertDLLs. Attackers use these to inject a hooking DLL into processes that handle credentials and intercept credential-bearing API calls (T1056.004). Detection is on the registry state change, so it does not depend on command-line logging."
    mitre_tactic = "Collection, Credential Access"
    mitre_technique = "T1056.004"
    mitre_technique_name = "Input Capture: Credential API Hooking"
    log_prerequisites = "Requires registry modification telemetry from an EDR or Sysmon (registry value set events) that populates target.registry.registry_key, target.registry.registry_value_name and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy enterprise software that still uses AppInit_DLLs (some accessibility, screen-reader, display or VDI agents, older application-compatibility shims). Endpoint security or DLP agents that register injection DLLs. Software deployment and imaging tools that write these values. Clearing or disabling the values is excluded by the value-data filter."
    tuning_guidance = "Add the writing process executable path of approved security agents to %global_allowed_security_tools. Add approved deployment or configuration tools to %global_allowed_admin_tools. If a client legitimately uses AppInit_DLLs, allowlist the writing process rather than the registry key. Keep AppCertDLLs coverage enabled, as legitimate use is extremely rare."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      (
        $reg.target.registry.registry_key = /\\Microsoft\\Windows NT\\CurrentVersion\\Windows$/ nocase and
        $reg.target.registry.registry_value_name = /^(AppInit_DLLs|LoadAppInit_DLLs)$/ nocase
      ) or
      $reg.target.registry.registry_key = /\\Control\\Session Manager\\AppCertDLLs/ nocase
    )
    not $reg.target.registry.registry_value_data = "0"
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1056.004")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
