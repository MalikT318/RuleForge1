/*
  MITRE Technique : T1048 - Exfiltration Over Alternative Protocol
  Tactic(s)       : Exfiltration
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:32:58.356522+00:00
  Reference       : https://attack.mitre.org/techniques/T1048
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1048_ESXi_Outbound_Firewall_Ruleset_Enabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi host firewall configuration change that enables an outbound client ruleset (FTP, SSH/SCP, HTTP, NFS or SMTP). Hypervisor management networks normally block these egress protocols, so enabling one is a common step before exfiltrating VM data, configs or datastore content over an alternative protocol. This is a host configuration (SETTING_MODIFICATION) detection, not a process command-line detection."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1048"
    mitre_technique_name = "Exfiltration Over Alternative Protocol"
    log_prerequisites = "ESXi hostd/vobd firewall configuration change messages ('Firewall configuration has changed. Operation enable for rule set ...') forwarded via syslog and parsed to UDM SETTING_MODIFICATION with the message text in metadata.description."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators temporarily enabling ftpClient/httpClient/nfsClient for patching, offline bundle download, backup or datastore migration; automation tooling (host profiles, configuration management) applying firewall baselines; host rebuilds or reconfiguration after maintenance."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Add change-control or jump-host source addresses to %global_allowed_mgmt_sources. Adjust the ruleset name list if the environment legitimately uses a subset (e.g. nfsClient for datastore mounts)."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.description = /firewall\s+configuration\s+has\s+changed/ nocase
    $setting.metadata.description = /operation\s+'?enable'?\s+for\s+rule\s*set\s+'?(ftpClient|sshClient|httpClient|nfsClient|smtpClient)/ nocase
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1048")
    $primary_entity = array_distinct($setting.principal.hostname)
    $acting_user = array_distinct($setting.principal.user.userid)
    $source_ips = array_distinct($setting.principal.ip)
    $change_detail = array_distinct($setting.metadata.description)

  condition:
    $setting
}
