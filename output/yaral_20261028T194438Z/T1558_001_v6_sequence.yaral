/*
  MITRE Technique : T1558.001 - Golden Ticket
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:40:50.017682+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_001_Krbtgt_Secret_Access_Then_Ticket_Forge {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects a process command line that touches KRBTGT secrets (replication, NTDS or hash extraction) followed within ten minutes by a command line that forges or injects a Kerberos ticket (pass-the-ticket together with a domain SID and a KRBTGT or key argument) on the same host. This sequence indicates golden ticket creation."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.001"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Golden Ticket"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command lines (EDR, Sysmon Event 1 or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Authorised KRBTGT password rotation scripts, AD health-check and replication audit tooling, red team or purple team exercises, identity security assessments that query the KRBTGT account."
    tuning_guidance = "Add approved AD maintenance and audit tooling to %global_allowed_admin_tools. Add authorised red team or scanner sources to %global_allowed_scanners and named AD administrators to %global_allowed_admin_users. The join is per host, so a dump on a domain controller followed by forging on a separate workstation will not correlate. Pair this rule with a user-based variant if that pattern matters."

  events:
    $dump.metadata.event_type = "PROCESS_LAUNCH"
    $dump.target.process.command_line = /\bkrbtgt\b/ nocase
    $dump.target.process.command_line = /(ntds|ifm|drsuapi|dcsync|replicat|ReplAccount|unicodePwd|nthash|ntlm|aes256|rc4)/ nocase
    not $dump.principal.process.file.full_path in %global_allowed_admin_tools
    not $dump.principal.process.file.full_path in %global_allowed_security_tools
    not $dump.principal.user.userid in %global_allowed_admin_users
    $dump.principal.hostname = $hostname

    $forge.metadata.event_type = "PROCESS_LAUNCH"
    $forge.target.process.command_line = /(\/ptt\b|\bptt\b|\/ticket:|-ptt\b)/ nocase
    $forge.target.process.command_line = /(\/sid:|-domain-sid|-sid\s|\/domain:)/ nocase
    $forge.target.process.command_line = /(krbtgt|\/rc4:|\/aes256:|\/aes128:|-nthash|-aesKey)/ nocase
    not $forge.principal.process.file.full_path in %global_allowed_admin_tools
    not $forge.principal.process.file.full_path in %global_allowed_security_tools
    not $forge.principal.user.userid in %global_allowed_admin_users
    $forge.principal.hostname = $hostname

    $dump.metadata.event_timestamp.seconds <= $forge.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1558.001")
    $primary_entity = array_distinct($dump.principal.hostname)
    $users = array_distinct($forge.principal.user.userid)
    $dump_commands = array_distinct($dump.target.process.command_line)
    $forge_commands = array_distinct($forge.target.process.command_line)
    $first_seen = min($dump.metadata.event_timestamp.seconds)
    $last_seen = max($forge.metadata.event_timestamp.seconds)

  condition:
    $dump and $forge
}
