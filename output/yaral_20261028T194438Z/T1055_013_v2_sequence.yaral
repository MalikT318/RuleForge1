/*
  MITRE Technique : T1055.013 - Process Doppelgänging
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:01:11.199862+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_013_Dropped_Executable_Then_Process_Injection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A process writes an executable image (exe/dll/sys/scr) to a user-writable staging location and, within five minutes on the same host, the same process performs process injection into a system binary. This file-write-then-inject chain matches the Process Doppelgänging pattern (transacted file write, section creation, process created from a section) without relying on command lines. It complements existing process-creation rules."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.013"
    mitre_technique_name = "Process Injection: Process Doppelgänging"
    log_prerequisites = "Requires endpoint telemetry that reports file creation and process injection or process tampering events, normalised to FILE_CREATION and PROCESS_INJECTION (EDR or Sysmon equivalent)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters that drop binaries in temp or ProgramData and then inject; application compatibility shims; game anti-cheat and DRM; developer debuggers and profilers; unlisted EDR or backup agents."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools, backup agents to %global_allowed_backup_processes, and deployment or patching tools to %global_allowed_admin_tools. If installers are noisy, extend the exclusions with the installer parent process path. To raise fidelity, require that the injection target is a process launched within the same window."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(exe|dll|sys|scr)$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\appdata\\|programdata\\|windows\\temp\\|temp\\|users\\public\\)/ nocase
    $file.principal.hostname = $hostname
    $file.principal.process.file.full_path = $actor_path
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.target.process.file.full_path = /\\windows\\(system32|syswow64)\\[^\\]+\.exe$/ nocase
    $inj.principal.hostname = $hostname
    $inj.principal.process.file.full_path = $actor_path
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes

    $file.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname, $actor_path over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.013")
    $primary_entity = array_distinct($file.principal.hostname)
    $actor_process = array_distinct($file.principal.process.file.full_path)
    $dropped_files = array_distinct($file.target.file.full_path)
    $injected_targets = array_distinct($inj.target.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)
    $file_event_count = count($file.metadata.id)

  condition:
    $file and $inj
}
