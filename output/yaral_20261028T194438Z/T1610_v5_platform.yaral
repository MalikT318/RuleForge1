/*
  MITRE Technique : T1610 - Deploy Container
  Tactic(s)       : Execution
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:29:55.286534+00:00
  Reference       : https://attack.mitre.org/techniques/T1610
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1610_Container_Runtime_Privileged_Or_Host_Mounted_Deploy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a container runtime CLI on a Linux node or build host being used to create or run a container with host-escape settings. These include privileged mode, host PID/network/IPC namespaces, dangerous capabilities, disabled seccomp/AppArmor confinement, or bind mounts of the host root, runtime socket, or kubelet/system directories. The rule matches the combination of a create/run verb and an escape-enabling flag, so it does not depend on image names or attacker tooling."
    mitre_tactic = "Execution"
    mitre_technique = "T1610"
    mitre_technique_name = "Deploy Container"
    log_prerequisites = "Requires Linux endpoint or EDR process-launch telemetry (auditd execve, EDR sensor) from container hosts, Kubernetes worker nodes and CI/build runners, with full command lines populated."
    platform = "Containers"
    log_source = "container"
    false_positives = "Legitimate privileged system workloads started manually (CNI/CSI node agents, monitoring or log-collection agents), CI/CD build runners using Docker-in-Docker or a mounted docker socket, platform engineers debugging nodes, and local developer testing on shared hosts."
    tuning_guidance = "Add approved deployment, CI and orchestration binaries to %global_allowed_admin_tools (matched on the parent process path). Add CI/automation accounts to %global_allowed_service_accounts, and named platform engineers to %global_allowed_admin_users. Add approved build hosts to %global_allowed_script_hosts. Narrow the flag regex if Docker-in-Docker socket mounts are routine in an environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(docker|podman|nerdctl|ctr|crictl)$/ nocase
    $proc.target.process.command_line = /\b(run|create|runp)\b/ nocase
    $proc.target.process.command_line = /(--privileged|--(pid|ipc|userns|uts)[= ]+host|--(net|network)[= ]+host|--cap-add[= ]+(sys_admin|sys_ptrace|sys_module|dac_read_search|all)|--security-opt[= ]+(seccomp|apparmor)[=:]unconfined|(-v|--volume)[= ]+\/:|(-v|--volume)[= ]+\/(var\/run\/docker\.sock|run\/containerd|proc|sys|etc|root|var\/lib\/kubelet)|--device[= ]+\/dev\/(sd[a-z]|nvme|mem|kmem)|(source|src)=\/(,|\s|$))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1610")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $runtime_binary = array_distinct($proc.target.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
