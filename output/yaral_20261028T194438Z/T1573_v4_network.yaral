/*
  MITRE Technique : T1573 - Encrypted Channel
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:21:40.825734+00:00
  Reference       : https://attack.mitre.org/techniques/T1573
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1573_ESXi_Outbound_Encrypted_Channel_Untrusted_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi host opening an outbound connection to an external address on a common encrypted-transport port (TLS or SSH) from a process running out of a writable location (/tmp, /var/tmp, /scratch, /dev/shm, /vmfs/volumes), or from an SSH or TLS client binary. Hypervisors seldom initiate encrypted sessions to the internet from ad-hoc binaries, so this pattern is characteristic of encrypted C2, reverse SSH tunnels, or exfiltration channels."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1573"
    mitre_technique_name = "Encrypted Channel"
    log_prerequisites = "ESXi host network connection telemetry with the originating process path populated (for example an endpoint or network sensor on the hypervisor, or firewall/connection logs enriched with process context). Host logs must be ingested with the vmware_esxi log source."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators running ssh or openssl client checks from the ESXi shell, vendor or third-party agents and plug-ins installed on a datastore that call home over TLS, scripted patching or offline-bundle downloads, backup or monitoring appliances running binaries from /vmfs/volumes, proxy-based update checks."
    tuning_guidance = "Add approved binaries to %global_allowed_admin_tools, %global_allowed_security_tools, or %global_allowed_backup_processes. Add known-good vendor and update endpoints to %global_allowed_domains. Extend %rfc1918_internal if the tenant uses non-RFC1918 internal space. Adjust the port list if the client uses other encrypted service ports."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname != ""
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    (
      $net.target.port = 443 or
      $net.target.port = 8443 or
      $net.target.port = 4443 or
      $net.target.port = 993 or
      $net.target.port = 995 or
      $net.target.port = 990 or
      $net.target.port = 22 or
      $net.target.port = 2222 or
      $net.target.port = 9001
    )
    (
      $net.principal.process.file.full_path = /^\/(tmp|var\/tmp|scratch|dev\/shm|vmfs\/volumes)\// nocase or
      $net.principal.process.file.full_path = /\/(ssh|dropbear|openssl)$/ nocase
    )
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1573")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_process = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
