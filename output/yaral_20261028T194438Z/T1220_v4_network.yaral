/*
  MITRE Technique : T1220 - XSL Script Processing
  Tactic(s)       : Stealth
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:12:28.660104+00:00
  Reference       : https://attack.mitre.org/techniques/T1220
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1220_XSL_Remote_Stylesheet_Network_Fetch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound external network connection from a process whose command line references a remote XSL stylesheet. This covers the WMIC /format:<URL> and msxsl-style 'XML + remote XSL' patterns, where embedded script is fetched over HTTP(S) and executed. The logic matches the combination of a format or stylesheet argument and a URL in the command line, not a binary name, so a renamed binary still matches."
    mitre_tactic = "Stealth"
    mitre_technique = "T1220"
    mitre_technique_name = "XSL Script Processing"
    log_prerequisites = "Requires endpoint network telemetry that records the initiating process command line on network connections (EDR or Sysmon Event ID 3 enriched with process command line)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or inventory scripts that use WMIC /format with a hosted stylesheet, software packaging or documentation tooling that transforms XML with a remote XSL, and developer build tools fetching stylesheets from internal web servers that resolve to public addresses."
    tuning_guidance = "Add approved tooling executables to %global_allowed_admin_tools, add known-good stylesheet hosting domains to %global_allowed_domains, and add approved scripting parents to %global_allowed_script_hosts. Internal destinations are already excluded via %rfc1918_internal."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.command_line = /((\/|-)format\s*[:=]\s*["']?https?:\/\/|\bmsxsl\b.*https?:\/\/|https?:\/\/[^\s"']+\.xslt?\b)/ nocase
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_script_hosts
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1220")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $initiating_command_line = array_distinct($net.principal.process.command_line)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
