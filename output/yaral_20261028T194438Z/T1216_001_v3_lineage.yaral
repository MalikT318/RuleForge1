/*
  MITRE Technique : T1216.001 - PubPrn
  Tactic(s)       : Stealth
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:34:32.938519+00:00
  Reference       : https://attack.mitre.org/techniques/T1216/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1216_001_PubPrn_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a script host (cscript/wscript) running PubPrn.vbs with a script: moniker when it is spawned by an unexpected parent such as an Office application, web server, database service or print spooler. This lineage is a strong indicator of proxy execution of a remote scriptlet through the signed PubPrn script."
    mitre_tactic = "Stealth"
    mitre_technique = "T1216.001"
    mitre_technique_name = "System Script Proxy Execution: PubPrn"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare legitimate printer-publishing automation launched from a web-based admin portal or a database job; print-management or deployment software that wraps PubPrn.vbs; administrators testing printer publication from an Office-hosted macro or tool."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts and approved deployment or print-management tooling to %global_allowed_admin_tools. Extend the parent regex with environment-specific application-server or database service executables. Because Windows 10+ restricts PubPrn to LDAP://, any script: moniker from these parents is anomalous and should rarely need suppression."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(cscript|wscript)\.exe$/ nocase
    $proc.target.process.command_line = /pubprn(\.vbs)?/ nocase
    $proc.target.process.command_line = /script:\S+/ nocase
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat\d*|java|php-cgi|sqlservr|mysqld|postgres|oracle|spoolsv)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1216.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
