/*
  MITRE Technique : T1098.002 - Additional Email Delegate Permissions
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:43:33.793385+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_002_Mass_Mailbox_Permission_Grants {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single account granted or modified mailbox, mailbox-folder or recipient permissions three or more times within 10 minutes. One delegation change is routine administration. Repeated changes by one actor suggest an adversary or compromised admin granting persistent delegate access across mailboxes, for example Full Access, SendAs, or Default/Anonymous folder rights, as seen in BEC and persistent-access campaigns."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.002"
    mitre_technique_name = "Account Manipulation: Additional Email Delegate Permissions"
    log_prerequisites = "Requires Exchange admin and mailbox audit logging in the unified audit log, with the operation name populated in metadata.product_event_type and the acting user in principal.user.userid. The permission-change operation must be normalised to USER_CHANGE_PERMISSIONS; adjust the event type if a client's parser maps it differently."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Mailbox migrations and onboarding or offboarding automation, helpdesk staff delegating shared or executive-assistant mailboxes in bulk, shared-mailbox provisioning scripts, and identity governance tooling."
    tuning_guidance = "Add migration and provisioning service accounts to %global_allowed_service_accounts. Add helpdesk and named administrators to %global_allowed_admin_users. Add approved automation principals to %global_allowed_cloud_principals. Raise the threshold from 3 for clients with heavy delegation activity. Severity can be raised when the target mailbox count is high or the actor is not an expected administrator."

  events:
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.metadata.product_event_type = /^(add|set)-?(mailbox|mailboxfolder|recipient)permission$/ nocase
    $perm.principal.user.userid = $actor
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_cloud_principals

  match:
    $actor over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1098.002")
    $primary_entity = array_distinct($actor)
    $event_count = count($perm.metadata.id)
    $operations = array_distinct($perm.metadata.product_event_type)
    $target_mailboxes = array_distinct($perm.target.user.userid)
    $source_ips = array_distinct($perm.principal.ip)

  condition:
    #perm >= 3
}
