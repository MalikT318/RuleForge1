/*
  MITRE Technique : T1686.001 - Cloud Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:29:07.794397+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_001_Cloud_Firewall_Rule_Tampering {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects control-plane API calls that create, modify or delete cloud network firewall constructs (security groups, network ACLs, VPC firewall rules, network security group rules) when made by an identity that is not an approved automation or administrator account. Adversaries use these changes to open ingress to cloud workloads or remove network restrictions that limit malicious activity."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.001"
    mitre_technique_name = "Disable or Modify Tools: Cloud Firewall"
    log_prerequisites = "Cloud control-plane audit logging enabled for management/write events and ingested into UDM with metadata.product_event_type populated with the API operation name."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Infrastructure-as-code pipelines and deployment roles not yet in the allowlists, network engineers making approved change-window edits, autoscaling or managed-service roles that create security groups, and break-glass administrative changes."
    tuning_guidance = "Add CI/CD and IaC automation identities to %global_allowed_service_accounts, named network administrators to %global_allowed_admin_users, and permitted service principals to %global_allowed_cloud_principals. If the tenant maps firewall changes to RESOURCE_PERMISSIONS_CHANGE or RESOURCE_CREATION instead of SETTING_MODIFICATION, clone this rule with that single event type. Consider raising severity for operations performed by first-seen identities."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /(AuthorizeSecurityGroup(Ingress|Egress)|RevokeSecurityGroup(Ingress|Egress)|ModifySecurityGroupRules|CreateSecurityGroup|DeleteSecurityGroup|CreateNetworkAcl(Entry)?|ReplaceNetworkAclEntry|DeleteNetworkAcl(Entry)?|compute\.firewalls\.(insert|patch|update|delete)|networkSecurityGroups\/(write|delete)|securityRules\/(write|delete)|firewallPolicies\/(write|delete)|firewallRules\/(write|delete))/ nocase
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1686.001")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_operations = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)
    $affected_resources = array_distinct($cloud.target.resource.name)

  condition:
    $cloud
}
