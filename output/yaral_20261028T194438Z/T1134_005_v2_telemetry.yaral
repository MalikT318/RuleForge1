/*
  MITRE Technique : T1134.005 - SID-History Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:01:47.834523+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_005_NTDS_Database_Modified_By_NonLSASS_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects modification of the Active Directory database (ntds.dit) by any process other than LSASS. Offline SID-History injection (editing the AD database directly and then restoring it) leaves this file-level artifact regardless of how the tool was launched or what its command line looked like. Legitimate writes to the AD database are performed by the directory service inside lsass.exe, so a different writing process is a strong indicator of offline tampering."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.005"
    mitre_technique_name = "Access Token Manipulation: SID-History Injection"
    log_prerequisites = "Requires EDR or Sysmon file-modification telemetry (Sysmon Event ID 11/23-style or EDR file write events) from domain controllers, including the NTDS data directory."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and restore agents, AD database maintenance (offline defragmentation or integrity checks), domain controller promotion or demotion, AD snapshot mounting, authorised disaster-recovery exercises, and EDR/AV agents that touch the file."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes, maintenance and DC build tooling to %global_allowed_admin_tools, and EDR/AV agents to %global_allowed_security_tools. Scope deployment to domain controller assets if the telemetry source also covers member servers."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\\ntds\.dit$/ nocase
    not $file.principal.process.file.full_path = /\\lsass\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1134.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
