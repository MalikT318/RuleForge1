/*
  MITRE Technique : T1685.006 - Clear Linux or Mac System Logs
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:26:09.066414+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_006_Linux_Bulk_System_Log_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects multiple deletions of core Linux system, authentication, login-record, audit, journal or web server log files under /var/log on a single host within 10 minutes, by processes other than log management daemons. One deletion can be routine housekeeping, but several in a short window indicates log wiping to hide intrusion evidence."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.006"
    mitre_technique_name = "Clear Linux or Mac System Logs"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd (unlink/unlinkat syscalls or watches on /var/log) normalised to FILE_DELETION with populated target.file.full_path and principal.hostname."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Custom log rotation or cleanup scripts, disk-space emergency cleanup by administrators, package or container image build steps that purge logs, and log shippers or agents that remove processed files."
    tuning_guidance = "Add approved cleanup or maintenance binaries to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Raise the #file threshold for hosts with aggressive custom rotation. Extend the log-management process exclusion regex only for daemons verified in your environment."

  events:
    $file.metadata.event_type = "FILE_DELETION"
    $file.target.file.full_path = /^\/var\/log\/(messages|secure|auth\.log|syslog|kern\.log|cron|maillog|wtmp|btmp|lastlog|utmp|audit\/|journal\/|httpd\/|apache2\/|nginx\/)/ nocase
    not $file.principal.process.file.full_path = /\/(logrotate|rsyslogd|syslog-ng|systemd-journald|journalctl|savelog|anacron|dpkg|rpm|apt|yum|dnf)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685.006")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $deleted_files = array_distinct($file.target.file.full_path)
    $acting_users = array_distinct($file.principal.user.userid)
    $acting_processes = array_distinct($file.principal.process.file.full_path)

  condition:
    #file >= 4
}
