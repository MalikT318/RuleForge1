/*
  MITRE Technique : T1095 - Non-Application Layer Protocol
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:38:37.527117+00:00
  Reference       : https://attack.mitre.org/techniques/T1095
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1095_ICMP_Payload_Then_UDP_Same_External_Dest {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An internal host sends ICMP traffic with an unusually large payload to an external address and then opens a UDP flow on a non-standard port to the same external address within 10 minutes. This pattern is consistent with a non-application layer protocol channel, where ICMP is used for beaconing or tunnelling and UDP for the follow-on C2 or data transfer."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1095"
    mitre_technique_name = "Non-Application Layer Protocol"
    log_prerequisites = "Requires perimeter firewall or proxy flow logs that populate network.ip_protocol, network.sent_bytes, principal.ip, target.ip and target.port, with ICMP and UDP flows logged (not only TCP)."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Network monitoring and uptime probes that send large ICMP payloads (path-MTU discovery, latency testing), VoIP/WebRTC/STUN and gaming traffic that follows an ICMP reachability check, VPN clients and QUIC-like UDP applications on custom ports, and authorised scanners."
    tuning_guidance = "Add monitoring, scanner and approved test source addresses to %global_allowed_scanners. Raise or lower the ICMP sent_bytes threshold to suit the client's baseline, and extend the UDP port exclusions for approved UDP services such as VoIP or VPN. Internal destinations are already excluded via %rfc1918_internal."

  events:
    $icmp.metadata.event_type = "NETWORK_FLOW"
    $icmp.network.ip_protocol = "ICMP"
    $icmp.network.sent_bytes > 256
    not $icmp.target.ip in %rfc1918_internal
    not $icmp.principal.ip in %global_allowed_scanners
    $icmp.principal.ip = $src
    $icmp.target.ip = $dst

    $udp.metadata.event_type = "NETWORK_FLOW"
    $udp.network.ip_protocol = "UDP"
    $udp.target.port != 53
    $udp.target.port != 123
    $udp.target.port != 443
    $udp.target.port != 500
    $udp.target.port != 4500
    not $udp.target.ip in %rfc1918_internal
    not $udp.principal.ip in %global_allowed_scanners
    $udp.principal.ip = $src
    $udp.target.ip = $dst

    $icmp.metadata.event_timestamp.seconds <= $udp.metadata.event_timestamp.seconds

  match:
    $src, $dst over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1095")
    $primary_entity = array_distinct($src)
    $external_destination = array_distinct($dst)
    $max_icmp_sent_bytes = max($icmp.network.sent_bytes)
    $udp_ports = array_distinct($udp.target.port)
    $icmp_flow_count = count($icmp.metadata.id)
    $udp_flow_count = count($udp.metadata.id)

  condition:
    $icmp and $udp
}
