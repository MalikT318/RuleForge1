/*
  MITRE Technique : T1021.005 - VNC
  Tactic(s)       : Lateral Movement
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:42:48.536172+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_005_VNC_Connection_Volume_Single_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single source address makes a high volume of connections to VNC/RFB ports (5900-5909) within ten minutes. Individual VNC connections are routine, but many connections from one source indicate VNC brute forcing, sweeping for VNC servers, or repeated remote-control sessions used for lateral movement with valid accounts."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.005"
    mitre_technique_name = "Remote Services: VNC"
    log_prerequisites = "Requires firewall, proxy, or perimeter logs normalised to UDM NETWORK_CONNECTION or NETWORK_FLOW with principal.ip, target.ip and target.port populated. The firewall must have visibility of east-west traffic, otherwise only perimeter-crossing VNC is seen."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "IT helpdesk and support staff using VNC for approved remote assistance, vulnerability scanners probing common ports, monitoring systems checking VNC availability, and lab or kiosk environments that use VNC heavily."
    tuning_guidance = "Add approved scanner source addresses to %global_allowed_scanners and approved management or jump host addresses to %global_allowed_mgmt_sources. The threshold of 10 connections is conservative. Raise it for environments with heavy sanctioned VNC use, or lower it for high-security segments. Review the distinct_destinations outcome: many distinct targets suggest a sweep, while one target with many connections suggests brute forcing."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port >= 5900
    $net.target.port <= 5909
    $net.principal.ip = $src
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1021.005")
    $primary_entity = array_distinct($src)
    $connection_count = count($net.metadata.id)
    $distinct_destinations = count_distinct($net.target.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 10
}
