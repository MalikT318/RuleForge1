/*
  MITRE Technique : T1657 - Financial Theft
  Tactic(s)       : Impact
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:00:51.441573+00:00
  Reference       : https://attack.mitre.org/techniques/T1657
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1657_Linux_AppServer_Spawns_Shell_Crypto_Theft {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application runtime or database service spawning a shell or script interpreter whose command line references cryptocurrency wallet or key material, or a mining pool protocol. Such lineage suggests a compromised internet-facing service being used for financial theft (wallet theft or resource hijacking for profit)."
    mitre_tactic = "Impact"
    mitre_technique = "T1657"
    mitre_technique_name = "Financial Theft"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry normalised to UDM PROCESS_LAUNCH with parent process path and full command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate blockchain or crypto-payment applications whose web or application service shells out to wallet tooling; node operators running wallet maintenance scripts through an application runtime; developer or test servers; Java or Node based deployment hooks that touch keystore files (for example TLS Java keystores)."
    tuning_guidance = "Add approved parent binaries to %global_allowed_script_hosts or %global_allowed_admin_tools. Add known automation accounts to %global_allowed_service_accounts. If Java TLS keystore maintenance is common, narrow the keystore pattern in the command-line regex for that client."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|php-fpm[0-9.]*|lighttpd|caddy|mysqld|mariadbd|postgres|node|java|gunicorn|uwsgi|tomcat[0-9]*)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|ash|zsh|python[0-9.]*|perl|ruby|php[0-9.]*)$/ nocase
    $proc.target.process.command_line = /(wallet\.dat|\.bitcoin|\.ethereum|\.electrum|\/keystore\/|UTC--[0-9]{4}-|stratum\+(tcp|ssl|tls)|--donate-level|mining[_-]?pool)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1657")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
