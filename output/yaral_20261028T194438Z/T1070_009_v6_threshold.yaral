/*
  MITRE Technique : T1070.009 - Clear Persistence
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:13:35.309575+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_009_ESXi_Persistence_Artifact_Deletion_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of file deletions on a single ESXi host within 10 minutes that target common persistence locations: boot-time startup scripts, root SSH authorized keys, cron entries, init scripts, and installed package or bootbank content. Each deletion alone can be routine maintenance. Several in a short window suggest an adversary removing persistence artifacts to cover their tracks."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.009"
    mitre_technique_name = "Indicator Removal: Clear Persistence"
    log_prerequisites = "Requires ESXi shell, hostd or file-integrity telemetry normalised to UDM FILE_DELETION with principal.hostname and target.file.full_path populated. Syslog forwarding from each ESXi host to Chronicle must be enabled."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Planned host decommissioning or rebuild, patch and upgrade workflows that replace startup scripts or packages, lifecycle manager remediation, admins rotating SSH authorized keys, configuration management tooling resetting startup scripts."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users, lifecycle and patching tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Raise the #file threshold in the condition for noisy estates, or lower it to 2 for high-security clusters. Suppress during change windows."

  events:
    $file.metadata.event_type = "FILE_DELETION"
    $file.target.file.full_path = /^\/(etc\/rc\.local\.d\/|etc\/ssh\/keys-[^\/]+\/authorized_keys|etc\/cron\/crontabs\/|etc\/init\.d\/|etc\/vmware\/firewall\/|store\/packages\/|bootbank\/|altbootbank\/|var\/spool\/cron\/)/ nocase
    $file.principal.hostname = $host
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1070.009")
    $primary_entity = array_distinct($host)
    $deletion_count = count($file.metadata.id)
    $deleted_paths = array_distinct($file.target.file.full_path)
    $acting_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 4
}
