/*
  MITRE Technique : T1048 - Exfiltration Over Alternative Protocol
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:32:03.324408+00:00
  Reference       : https://attack.mitre.org/techniques/T1048
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1048_OfficeSuite_Mailbox_External_Forwarding_Config {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change in the Office Suite audit trail that sets up automatic mail forwarding or redirection (mailbox forwarding address, inbox rule forward/redirect action, or transport rule redirect). Adversaries use these settings to move mail data out of the tenant over an alternate channel without any endpoint process activity. This rule detects the persistent configuration state change, not a command line."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1048"
    mitre_technique_name = "Exfiltration Over Alternative Protocol"
    log_prerequisites = "Requires unified audit logs for the collaboration and email suite, with mailbox and mail-flow administrative operations (mailbox setting changes, inbox rule and transport rule create/update) ingested and normalised to SETTING_MODIFICATION with the operation name in metadata.product_event_type and operation parameters in security_result.description or target.resource.name."
    platform = "Office Suite"
    log_source = "cloud_audit"
    false_positives = "Users forwarding mail to a personal or secondary address (policy permitting), administrators configuring shared-mailbox forwarding, employee offboarding or leave-of-absence redirects, mail-flow rules for compliance archiving or journaling, and migration projects."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and automation or migration identities to %global_allowed_service_accounts. Where operation parameters are not populated in security_result.description in your tenant, confirm the parameter field mapping with the parser before deploying. Consider raising severity if the actor is also flagged for a risky sign-in."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /^(Set-Mailbox|New-InboxRule|Set-InboxRule|UpdateInboxRules|New-TransportRule|Set-TransportRule)$/ nocase
    (
      $cloud.security_result.description = /(ForwardingSmtpAddress|ForwardingAddress|ForwardTo|ForwardAsAttachmentTo|RedirectTo|BlindCopyTo|DeliverToMailboxAndForward)/ nocase or
      $cloud.target.resource.name = /(ForwardingSmtpAddress|ForwardingAddress|ForwardTo|ForwardAsAttachmentTo|RedirectTo|BlindCopyTo|DeliverToMailboxAndForward)/ nocase
    )
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1048")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $operation = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
