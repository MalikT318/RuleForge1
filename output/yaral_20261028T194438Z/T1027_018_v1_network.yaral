/*
  MITRE Technique : T1027.018 - Invisible Unicode
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:07:03.757884+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/018
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_018_Invisible_Unicode_In_Outbound_URL {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP requests to external destinations where the URL carries a run of four or more consecutive invisible or non-printing Unicode characters (zero-width, bidi controls, word joiners, BOM, variation selectors, tag characters), in percent-encoded or raw form. This pattern is typical of invisible-Unicode encoded payloads or staged content fetched by scripts and loaders running on Linux hosts behind a proxy or firewall. Network-side coverage that complements endpoint command-line detections."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.018"
    mitre_technique_name = "Obfuscated Files or Information: Invisible Unicode"
    log_prerequisites = "Requires proxy or firewall HTTP logs with the full request URL populated in target.url (URL inspection or proxy logging enabled) and destination IP in target.ip."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Web applications and analytics tools that embed zero-width characters or BOMs in query strings (tracking or watermarking), internationalised sites using variation selectors (emoji) in URLs, and URL-encoded text copied from rich-text editors or chat applications. Security testing or awareness-training platforms."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains. Add authorised testing sources to %global_allowed_scanners. Raise the repetition count in the regex from 4 to a higher value if emoji-heavy URLs cause noise, or lower it to 3 for higher sensitivity."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(?i)(?:%E2%80%8[B-F]|%E2%80%A[A-E]|%E2%81%A[0-4]|%E2%81%A[6-9]|%EF%BB%BF|%EF%B8%8[0-9A-F]|%F3%A0%8[01]%[89AB][0-9A-F]|[\x{200B}-\x{200F}\x{202A}-\x{202E}\x{2060}-\x{2064}\x{FEFF}\x{FE00}-\x{FE0F}]){4,}/
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.018")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)

  condition:
    $http
}
