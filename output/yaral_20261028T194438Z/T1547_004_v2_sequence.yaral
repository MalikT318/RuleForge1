/*
  MITRE Technique : T1547.004 - Winlogon Helper DLL
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:28:37.637180+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_004_Winlogon_Helper_Dropped_Binary_Then_Registry_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A DLL or executable is written to a user-writable or staging location, then a Winlogon helper value (Shell, Userinit, Notify DllName, Taskman, VmApplet, AppSetup, GinaDLL) is modified to a non-default value on the same host within 10 minutes. This is the drop-then-register pattern used for Winlogon Helper DLL persistence. The rule uses file and registry telemetry only, so it does not duplicate command-line rules."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.004"
    mitre_technique_name = "Boot or Logon Autostart Execution: Winlogon Helper DLL"
    log_prerequisites = "Requires endpoint file-creation and registry-modification telemetry (EDR or Sysmon Event IDs 11 and 13) with registry key paths and value names populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers or updaters that write a binary to ProgramData or Temp and then legitimately change the Winlogon Shell or Userinit value. Third-party credential providers, kiosk or shell-replacement products, and VDI or profile-management agents. Admin scripts and GPO-driven configuration."
    tuning_guidance = "Add approved deployment, RMM and installer binaries to %global_allowed_admin_tools. Add EDR and AV agents that write files to staging paths to %global_allowed_security_tools. Kiosk or shell-replacement environments may need a customer-specific exclusion for the expected Shell value."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\[^\\]+\\appdata\\.+|users\\public|programdata|windows\\temp|temp|perflogs|windows\\tasks)\\([^\\]+\\)*[^\\]+\.(dll|exe)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon(\\|$)/ nocase
    $reg.target.registry.registry_value_name = /^(Shell|Userinit|Taskman|VmApplet|AppSetup|DllName|GinaDLL)$/ nocase
    not $reg.target.registry.registry_value_data = /^((c:\\windows\\)(system32\\)?)?(userinit|explorer)\.exe,?$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1547.004")
    $primary_entity = array_distinct($hostname)
    $dropped_files = array_distinct($file.target.file.full_path)
    $dropping_processes = array_distinct($file.principal.process.file.full_path)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_name)
    $registry_data = array_distinct($reg.target.registry.registry_value_data)
    $modifying_processes = array_distinct($reg.principal.process.file.full_path)
    $users = array_distinct($reg.principal.user.userid)

  condition:
    $file and $reg
}
