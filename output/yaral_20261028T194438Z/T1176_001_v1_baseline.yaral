/*
  MITRE Technique : T1176.001 - Browser Extensions
  Tactic(s)       : Persistence
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:26:29.387005+00:00
  Reference       : https://attack.mitre.org/techniques/T1176/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_001_Browser_Extension_Package_Download_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP request observed at the network perimeter for a browser extension package (.crx or .xpi) from an external host outside the known-good domain list. Side-loaded or off-store extension packages are a common way to install a persistent malicious browser extension. Browser stores normally deliver extensions through allowlisted vendor update services, so a direct package download from any other host is anomalous."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176.001"
    mitre_technique_name = "Software Extensions: Browser Extensions"
    log_prerequisites = "Requires proxy or firewall logs with full URL visibility, either TLS inspection or URL-aware filtering, normalised to UDM NETWORK_HTTP with target.url populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Enterprise-managed extension deployment from internal or private vendor hosting, developers testing unpacked or self-hosted extensions, legitimate vendor extension updates from domains not yet in the allowlist, and security or password-manager vendors distributing packages from their own CDN."
    tuning_guidance = "Add legitimate extension distribution domains (browser vendor stores and update services, approved enterprise extension hosts) to %global_allowed_domains. Hostnames are matched exactly, so list the exact hosts or tune the list accordingly. Add approved scanners or test sources to %global_allowed_scanners. Hunt for hosts that fetch packages repeatedly, or that fetch from newly seen domains."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.target.url = /\.(crx|xpi)([?#]|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1176.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
