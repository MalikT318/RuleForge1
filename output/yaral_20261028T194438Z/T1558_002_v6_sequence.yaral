/*
  MITRE Technique : T1558.002 - Silver Ticket
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:42:51.958178+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_002_Kerberos_Network_Logon_Then_Privileged_Group_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Kerberos network logon followed within 10 minutes by the same account modifying a privileged group. This pattern is consistent with a forged service ticket (silver ticket) carrying a fabricated privileged PAC, which is then used to make directory changes without a prior legitimate TGT or KDC interaction."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.002"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Silver Ticket"
    log_prerequisites = "Requires Windows domain controller and member server Security event logs (4624 network logons, 4728/4732/4756 group membership changes) or equivalent identity provider audit logs ingested and normalised to UDM USER_LOGIN and GROUP_MODIFICATION."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Administrators who legitimately authenticate with Kerberos and then manage privileged groups, identity governance or JIT access automation, helpdesk onboarding workflows, and migration tooling."
    tuning_guidance = "Add named admin accounts to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Adjust the privileged group name regex to match client naming conventions. If auth_details is not populated for a client, validate the field mapping before deployment."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.extensions.auth.mechanism = "NETWORK"
    $login.extensions.auth.auth_details = /kerberos/ nocase
    $login.target.user.userid = $user
    not $login.target.user.userid = /\$$/
    not $login.target.user.userid in %global_allowed_admin_users
    not $login.target.user.userid in %global_allowed_service_accounts

    $grp.metadata.event_type = "GROUP_MODIFICATION"
    $grp.target.group.group_display_name = /(admins|administrators|operators|remote desktop users|backup operators|account operators|server operators)/ nocase
    $grp.principal.user.userid = $user
    not $grp.principal.user.userid in %global_allowed_admin_users
    not $grp.principal.user.userid in %global_allowed_service_accounts

    $login.metadata.event_timestamp.seconds <= $grp.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1558.002")
    $primary_entity = array_distinct($user)
    $login_source_ips = array_distinct($login.principal.ip)
    $login_target_hosts = array_distinct($login.target.hostname)
    $modified_groups = array_distinct($grp.target.group.group_display_name)
    $login_count = count($login.metadata.id)

  condition:
    $login and $grp
}
