/*
  MITRE Technique : T1534 - Internal Spearphishing
  Tactic(s)       : Lateral Movement
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:32:59.911792+00:00
  Reference       : https://attack.mitre.org/techniques/T1534
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1534_Linux_CLI_Mail_Client_Phish_Delivery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a native Linux command-line mail utility (mail, mailx, mutt, s-nail, msmtp, sendmail) launched either with an attachment taken from a world-writable staging path (/tmp, /var/tmp, /dev/shm) or with a message body carrying a link plus credential-lure keywords. This is the Linux-side mechanism for sending internal spearphishing from a compromised account or host, using the trusted internal mail relay."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1534"
    mitre_technique_name = "Internal Spearphishing"
    log_prerequisites = "Linux EDR or auditd EXECVE telemetry normalised to UDM PROCESS_LAUNCH with full command line capture. Mail utilities must be installed on the monitored host for this to be observable."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Cron or monitoring scripts mailing reports or logs staged in /tmp, backup and log-rotation jobs sending attachments, admins manually sending diagnostics, application notification scripts that include password-reset or account links."
    tuning_guidance = "Add automation and monitoring accounts to %global_allowed_service_accounts, add legitimate scheduler or wrapper parents to %global_allowed_script_hosts, and add approved reporting tools to %global_allowed_admin_tools. Review repeated hits per host to identify scripted senders before suppressing."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(mail|mailx|mutt|s-nail|nail|msmtp|sendmail)$/ nocase
    (
      $proc.target.process.command_line = /\s(-a|-A|--attach(ment)?)[\s=]*\S*\/(tmp|var\/tmp|dev\/shm)\// nocase or
      (
        $proc.target.process.command_line = /https?:\/\/\S+/ nocase and
        $proc.target.process.command_line = /(login|signin|sign-in|verify|password|passwd|reset|sso|mfa|invoice|unlock)/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1534")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $mail_binary = array_distinct($proc.target.process.file.full_path)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
