/*
  MITRE Technique : T1574.008 - Path Interception by Search Order Hijacking
  Tactic(s)       : Stealth, Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:36:34.314285+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_008_Sysbinary_Name_Nonsystem_Path_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process named after a built-in Windows console or discovery utility (cmd, net, whoami, ipconfig, etc.) that runs from outside the protected Windows system directories and makes a connection to an external address. Legitimate copies of these utilities live in System32/SysWOW64/WinSxS and rarely initiate external traffic. A planted look-alike binary picked up through search order hijacking, which then beacons or downloads a payload, matches this pattern. This is the network-side view of the technique and is independent of command-line matching."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.008"
    mitre_technique_name = "Hijack Execution Flow: Path Interception by Search Order Hijacking"
    log_prerequisites = "Requires endpoint network telemetry that populates the initiating process path (EDR or Sysmon Event ID 3 equivalent) normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path and target.ip."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Portable or side-by-side copies of cmd.exe or similar utilities bundled with developer toolchains, Git/MSYS/Cygwin environments, application installers that stage utilities in their own directory, and RMM or deployment agents. Unusual WinSxS or servicing paths on non-standard system drive layouts can also trigger it."
    tuning_guidance = "Add approved admin and deployment tooling to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Extend the system-directory exclusion regex if the client uses a non-standard OS path. Add trusted external destinations by extending exclusions with %global_allowed_domains if the telemetry carries a target hostname."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(cmd|net|net1|whoami|ipconfig|systeminfo|tasklist|nltest|hostname|wmic|find|findstr|attrib|taskkill|sc|schtasks|reg)\.exe$/ nocase
    not $net.principal.process.file.full_path = /^[a-z]:\\windows\\(system32|syswow64|sysnative|winsxs)\\/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1574.008")
    $primary_entity = array_distinct($net.principal.hostname)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $affected_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
