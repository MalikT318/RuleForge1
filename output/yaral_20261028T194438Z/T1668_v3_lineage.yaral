/*
  MITRE Technique : T1668 - Exclusive Control
  Tactic(s)       : Persistence
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:10:44.288726+00:00
  Reference       : https://attack.mitre.org/techniques/T1668
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1668_Linux_Service_Parent_Spawns_Shell_Exclusive_Control {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server or database service process spawning a shell whose command line performs 'close the door' actions typical of exclusive control: stopping or disabling services, killing other processes, blocking inbound traffic with firewall rules, making files immutable, removing cron jobs, locking accounts, or deleting SSH authorized_keys. These parents rarely launch shells for administrative hardening, so this lineage suggests post-exploitation activity."
    mitre_tactic = "Persistence"
    mitre_technique = "T1668"
    mitre_technique_name = "Exclusive Control"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry that populates the parent process path, child process path and full command line for PROCESS_LAUNCH events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Application deployment or maintenance hooks run by a web or database service, CMS or control-panel plugins that restart services, database failover scripts (for example a Postgres promote or restart wrapper), Tomcat/Java applications that legitimately shell out to manage services, and custom admin panels that call systemctl through a shell."
    tuning_guidance = "Add approved parent processes or hosts to %global_allowed_script_hosts and named administrators to %global_allowed_admin_users. Narrow or extend the parent service regex to match the web and database stack in each client environment. Remove the java alternative where Java application servers commonly shell out for management tasks."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9.]*|php-cgi|uwsgi|gunicorn|java|mysqld|mariadbd|postgres|redis-server|mongod)$/ nocase
    $proc.target.process.file.full_path = /\/(ba|da|a|z|k|c|tc)?sh$/ nocase
    $proc.target.process.command_line = /(systemctl[[:space:]]+(stop|disable|mask)|service[[:space:]]+[^[:space:]]+[[:space:]]+stop|pkill|killall|kill[[:space:]]+-9|iptables[[:space:]].*(INPUT|-A|-I).*(DROP|REJECT)|ufw[[:space:]]+(deny|enable)|chattr[[:space:]]+\+i|crontab[[:space:]]+-r|passwd[[:space:]]+-l|usermod[[:space:]]+-L|(rm|mv|truncate)[[:space:]].*authorized_keys)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1668")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
