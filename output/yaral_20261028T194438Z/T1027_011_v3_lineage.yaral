/*
  MITRE Technique : T1027.011 - Fileless Storage
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:55:37.324791+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_011_Unexpected_Parent_Spawns_Registry_WMI_Script_Child {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office application, web server worker, print spooler, or database service spawning a script interpreter or a registry/WMI utility. Registry and the WMI repository are common fileless storage locations (T1027.011) for payloads and staged data. This rule pivots on the anomalous parent-child lineage and does not inspect command-line content, so it complements command-line detections."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.011"
    mitre_technique_name = "Obfuscated Files or Information: Fileless Storage"
    log_prerequisites = "Requires endpoint process-launch telemetry with populated parent and child process image paths (EDR, Sysmon Event ID 1, or Windows Security Event 4688 with parent process logging)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros or add-ins from line-of-business applications that call cmd or PowerShell; web applications that legitimately shell out (IIS-hosted admin or deployment portals); database jobs using xp_cmdshell for approved maintenance; print drivers or print management software launching helper scripts; software installers launched from Outlook or Office."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts, and approved IT or deployment tooling to %global_allowed_admin_tools. Add EDR or AV agent parents to %global_allowed_security_tools. If a specific child binary is noisy for one tenant, tune the child regex for that tenant rather than widening the parent exclusions."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat[0-9]*|spoolsv|sqlservr|mysqld|postgres|oracle)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta|reg|wmic|mofcomp)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1027.011")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
