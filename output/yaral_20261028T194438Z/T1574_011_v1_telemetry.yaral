/*
  MITRE Technique : T1574.011 - Services Registry Permissions Weakness
  Tactic(s)       : Stealth, Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:41:10.639583+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_011_Service_Registry_ImagePath_Redirect {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a write to a service's ImagePath, ServiceDll or FailureCommand registry value under HKLM\\SYSTEM\\<ControlSet>\\Services where the new value points outside standard system and program directories. This is the registry state change produced when an adversary hijacks a service through weak key permissions, whatever tool made the change (reg.exe, PowerShell, API calls, custom malware). It does not depend on command-line logging."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.011"
    mitre_technique_name = "Hijack Execution Flow: Services Registry Permissions Weakness"
    log_prerequisites = "Requires endpoint registry telemetry with registry key, value name and value data populated (EDR registry events or Sysmon Event ID 13). Service key auditing must not be filtered out at the sensor."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Third-party installers or updaters that register services under ProgramData, AppData, or non-standard drive paths. Software deployment and RMM agents that reconfigure service binaries. Developers installing test services. Driver installers writing ImagePath to non-system locations."
    tuning_guidance = "Add approved deployment, patching and RMM binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Writes made through the service control manager appear with services.exe as the writer, so the rule relies on the value-data location filter to stay quiet for them. If a client has legitimate services in non-standard install paths, extend the standard-path regex in the rule copy for that client."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SYSTEM\\(CurrentControlSet|ControlSet\d+)\\Services\\[^\\]+(\\Parameters)?$/ nocase
    $reg.target.registry.registry_value_name = /^(ImagePath|ServiceDll|FailureCommand)$/ nocase
    $reg.target.registry.registry_value_data = /.+/
    not $reg.target.registry.registry_value_data = /^"?(%(systemroot|windir|programfiles|programfiles\(x86\)|programw6432)%|\\systemroot\\|\\\?\?\\[a-z]:\\windows\\|[a-z]:\\windows\\|[a-z]:\\program files( \(x86\))?\\)/ nocase
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|msiexec|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1574.011")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $modified_value_name = array_distinct($reg.target.registry.registry_value_name)
    $new_value_data = array_distinct($reg.target.registry.registry_value_data)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
