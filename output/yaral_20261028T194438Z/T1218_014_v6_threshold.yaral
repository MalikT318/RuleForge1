/*
  MITRE Technique : T1218.014 - MMC
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:01:46.003722+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_014_MSC_Files_Dropped_Writable_Paths_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several .msc (Microsoft Management Console) files are created in user-writable or temporary locations on a single host within ten minutes. One such file is benign, but a burst suggests staging of malicious consoles for later proxy execution through mmc.exe. Severity is scaled in outcome by volume."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.014"
    mitre_technique_name = "System Binary Proxy Execution: MMC"
    log_prerequisites = "Requires EDR or Sysmon file creation telemetry (Sysmon Event ID 11 or equivalent) with populated target file path and principal process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators saving custom MMC consoles, RSAT or admin-tool installers extracting consoles to temp folders, software deployment agents, backup or profile-restore tools recreating user files, and IT automation that builds management consoles."
    tuning_guidance = "Add approved deployment and admin tooling to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. Raise the #file threshold in noisy admin-heavy environments. Correlate hits with later mmc.exe launches of the same file paths during triage."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.msc$/ nocase
    $file.target.file.full_path = /(\\users\\[^\\]+\\(appdata|downloads|desktop|documents)\\|\\users\\public\\|\\programdata\\|\\windows\\temp\\|\\temp\\|\\\$recycle\.bin\\)/ nocase
    not $file.principal.process.file.full_path = /\\(msiexec|TrustedInstaller|MsMpEng|MsSense|SenseIR|TiWorker)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(count($file.metadata.id) >= 10, 80, 55))
    $file_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1218.014")
    $primary_entity = array_distinct($host)
    $msc_paths = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
