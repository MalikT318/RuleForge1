/*
  MITRE Technique : T1195.001 - Compromise Software Dependencies and Development Tools
  Tactic(s)       : Initial Access
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:41:17.148287+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_001_Package_Manager_Fetch_Then_Unusual_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A host fetches software packages through a package-manager client (identified by HTTP user-agent) from a source outside the known-good domain list, then opens an outbound connection to an external address on a high, non-web port within 10 minutes. This pattern is consistent with a trojanised or typosquatted dependency running install-time code that calls back to attacker infrastructure."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.001"
    mitre_technique_name = "Supply Chain Compromise: Compromise Software Dependencies and Development Tools"
    log_prerequisites = "Firewall or proxy logs with HTTP user-agent visibility (TLS inspection or explicit proxy) for package-manager traffic, plus connection logs for the same source IP. Source IPs must be consistent between the two event types."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Developer workstations and build agents using private or internal package mirrors not yet in the allowlist, legitimate package post-install scripts that download binaries, developer tools using non-standard ports, and remote debugging or tunnelling by developers."
    tuning_guidance = "Add private package feeds and approved mirror domains to %global_allowed_domains. Add approved management or build-infrastructure destinations to %global_allowed_mgmt_sources. Add vulnerability scanner sources to %global_allowed_scanners. If the environment relies on non-standard web ports, extend the port exclusions. Consider raising severity for server subnets that should never run package managers."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.user_agent = /^(npm|yarn|pnpm|pip|twine|nuget|nuget command line|dotnet)[\/ ]/ nocase
    not $http.target.hostname in %global_allowed_domains
    not $http.target.ip in %rfc1918_internal
    $http.principal.ip = $src_ip

    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains
    $net.target.port > 1024
    $net.target.port != 8080
    $net.target.port != 8443
    $net.principal.ip = $src_ip

    $http.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1195.001")
    $primary_entity = array_distinct($src_ip)
    $package_sources = array_distinct($http.target.hostname)
    $user_agents = array_distinct($http.network.http.user_agent)
    $egress_ips = array_distinct($net.target.ip)
    $egress_ports = array_distinct($net.target.port)
    $egress_count = count($net.metadata.id)

  condition:
    $http and $net
}
