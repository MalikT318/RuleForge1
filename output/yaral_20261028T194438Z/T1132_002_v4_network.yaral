/*
  MITRE Technique : T1132.002 - Non-Standard Encoding
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:48:16.608610+00:00
  Reference       : https://attack.mitre.org/techniques/T1132/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1132_002_Linux_Scripted_Client_Encoded_HTTP_Payload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP requests from a Linux host made by a command-line or scripting HTTP client (curl, wget, Python, Go, Perl, Java style user agents) where the URL carries a long unbroken base64-style blob in the path or query string. This is the network-side signature of C2 data wrapped in a non-standard or modified Base64 encoding. It complements endpoint command-line detections by observing the traffic itself."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1132.002"
    mitre_technique_name = "Data Encoding: Non-Standard Encoding"
    log_prerequisites = "Requires NETWORK_HTTP telemetry with target.url and network.http.user_agent populated, from a Linux endpoint sensor, forward proxy, or network sensor that sees Linux host traffic."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers and update agents using signed or tokenised URLs, CI/CD and build tooling fetching artefacts with long signed query strings (pre-signed object-storage URLs), monitoring and telemetry agents posting encoded metrics, SaaS API clients passing JWT or opaque tokens in the URL, and developer scripts calling APIs."
    tuning_guidance = "Add known-good external domains (artefact repositories, object storage, vendor APIs) to %global_allowed_domains. Add approved automation hosts to %global_allowed_script_hosts and service accounts to %global_allowed_service_accounts. Raise the blob length quantifier from 120 to 200 or more on noisy estates."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.user_agent = /^(curl|wget|python|go-http-client|libwww-perl|java|okhttp|lwp)/ nocase
    $http.target.url = /[\/?&=][A-Za-z0-9+\/_\-]{120,}={0,2}([&#]|$)/
    $http.target.ip != ""
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_script_hosts
    not $http.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1132.002")
    $primary_entity = array_distinct($http.principal.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $user_agents = array_distinct($http.network.http.user_agent)
    $source_users = array_distinct($http.principal.user.userid)

  condition:
    $http
}
