/*
  MITRE Technique : T1561.001 - Disk Content Wipe
  Tactic(s)       : Impact
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:05:13.536512+00:00
  Reference       : https://attack.mitre.org/techniques/T1561/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1561_001_Wiper_Propagation_SMB_Fanout {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a single internal source opening a high volume of SMB/NetBIOS session connections to internal destinations within 10 minutes. This is the network-observable worm-like propagation stage used by disk-wiping malware (T1561.001) to spread before overwriting disk content. A firewall cannot see the disk wipe itself, so this rule detects the propagation precondition rather than the wipe."
    mitre_tactic = "Impact"
    mitre_technique = "T1561.001"
    mitre_technique_name = "Disk Wipe: Disk Content Wipe"
    log_prerequisites = "Requires firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Internal east-west traffic must be logged by the firewall."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Backup servers, file migration jobs, software distribution and patching servers, domain controllers, vulnerability scanners, and endpoint management consoles legitimately fan out over SMB."
    tuning_guidance = "Add scanner and authorised testing sources to %global_allowed_scanners and approved management or backup servers to %global_allowed_mgmt_sources. Raise the #net threshold in high-traffic segments. Lower it for isolated server VLANs where SMB fan-out is unusual."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 445 or $net.target.port = 139)
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    $net.principal.ip = $src_ip

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1561.001")
    $primary_entity = array_distinct($src_ip)
    $connection_count = count($net.metadata.id)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 50
}
