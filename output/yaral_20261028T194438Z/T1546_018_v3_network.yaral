/*
  MITRE Technique : T1546.018 - Python Startup Hooks
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:25:54.290752+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/018
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_018_Python_Client_Fetching_Startup_Hook_Payload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Python HTTP client library (identified by its default user agent) making an outbound request to an external destination for a payload that matches Python startup-hook or follow-on staging content: .pth files, sitecustomize/usercustomize modules, Python or shell scripts, or shared objects. This is the network-side signal of an implant that plants a .pth, sitecustomize.py or usercustomize.py hook and retrieves its next stage every time the interpreter starts. It complements endpoint command-line and file-write detections and does not rely on process fields."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1546.018"
    mitre_technique_name = "Event Triggered Execution: Python Startup Hooks"
    log_prerequisites = "Requires proxy, secure web gateway or firewall logs with L7 inspection that populate network.http.user_agent and target.url. A Linux host source must be attributable via principal.hostname."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate automation, configuration management, monitoring or deployment scripts written in Python that download scripts or shared objects from external vendors or repositories; developer workstations and CI runners; internal tooling bootstrapping over HTTP."
    tuning_guidance = "Add approved external vendor and repository domains to %global_allowed_domains. Add build servers, automation hosts and developer jump hosts to %global_allowed_script_hosts. Raise severity when the destination is a bare IP address or the URL targets sitecustomize/usercustomize/.pth content. Internal address space is excluded via %rfc1918_internal."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /^(python-requests|python-urllib|python-httpx|aiohttp|urllib3|python)\b/ nocase
    $net.target.url = /(sitecustomize|usercustomize)\.py|\.pth|\.(py|sh|so|elf)(\?.*)?$/ nocase
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1546.018")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
