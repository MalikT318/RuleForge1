/*
  MITRE Technique : T1556.001 - Domain Controller Authentication
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:14:14.994060+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_001_LSA_Protection_Tampering_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modification of LSA protection settings (RunAsPPL, RunAsPPLBoot, LsaCfgFlags) by a process that is not an approved admin or security tool. Skeleton Key-style patching of LSASS on a domain controller requires LSA protection and Credential Guard to be off, so this catches the state change that enables the attack and does not depend on command-line logging."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.001"
    mitre_technique_name = "Modify Authentication Process: Domain Controller Authentication"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events 12/13) that populates target.registry.registry_key and registry_value_name. registry_value_data is used only to exclude known-hardening values, so rule still works if it is not populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or GPO/MDM/configuration management deliberately changing LSA protection or Credential Guard settings during hardening, rollback or troubleshooting; OS upgrades and servicing; security agents that manage LSA settings; imaging and build processes."
    tuning_guidance = "Add approved configuration management and hardening tooling to %global_allowed_admin_tools, security agents to %global_allowed_security_tools, and change-window administrator accounts to %global_allowed_admin_users. Prioritise domain controllers using asset context in the SOAR playbook, because any unapproved change on a DC is high fidelity."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control\\Lsa(\\|$)/ nocase
    $reg.target.registry.registry_value_name = /^(RunAsPPL|RunAsPPLBoot|LsaCfgFlags)$/ nocase
    not $reg.target.registry.registry_value_data = /^(1|2|0x0*[12]|DWORD \(0x0*[12]\))$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1556.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_value = array_distinct($reg.target.registry.registry_value_name)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
