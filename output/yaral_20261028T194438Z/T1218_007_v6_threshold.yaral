/*
  MITRE Technique : T1218.007 - Msiexec
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:50:51.772414+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_007_Msiexec_Repeated_External_Connections {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects msiexec.exe making repeated outbound connections to external addresses from a single host within 10 minutes. A single connection can be a legitimate installer download. Repeated external connections suggest remote MSI or DLL retrieval and proxy execution, or staged payload download."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.007"
    mitre_technique_name = "System Binary Proxy Execution: Msiexec"
    log_prerequisites = "Requires Windows endpoint network telemetry that records the originating process (EDR or Sysmon Event ID 3), normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software deployment and patching tools that fetch MSI packages, vendor installers and updaters that download several components, and admins installing software from remote shares or web servers."
    tuning_guidance = "Add deployment and patching parent processes to %global_allowed_admin_tools. Add vendor update domains to %global_allowed_domains. Add deployment accounts to %global_allowed_service_accounts. Raise the #net threshold on hosts that install software frequently. The risk score rises when connection volume reaches 10 or more."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\msiexec\.exe$/ nocase
    $net.principal.hostname = $host
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.parent_process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $event_count = count($net.metadata.id)
    $risk_score = max(if($event_count >= 10, 85, 60))
    $mitre_technique_id = array_distinct("T1218.007")
    $primary_entity = array_distinct($host)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $users = array_distinct($net.principal.user.userid)

  condition:
    #net >= 3
}
