/*
  MITRE Technique : T1556.004 - Network Device Authentication
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:19:38.758941+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_004_External_Mgmt_Plane_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external (non-internal) source connecting to a management-plane port (Telnet, SSH, NETCONF-over-SSH) on an internal address, as seen by a perimeter firewall. A router or switch whose image has been patched with a hardcoded backdoor password (the Synful Knock pattern) is reached over exactly this path, so this is the network-side footprint of an adversary using the implanted password. The rule does not rely on the device's own authentication logs, which the implant bypasses."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.004"
    mitre_technique_name = "Modify Authentication Process: Network Device Authentication"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated, and logging of permitted inbound traffic."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised vendor or MSP remote support over SSH, administrators connecting from home or travel without VPN, external vulnerability scanners or penetration tests, cloud-hosted jump hosts or management platforms outside the allowlists, and legitimately published SSH services on internal servers."
    tuning_guidance = "Add approved external management or jump-host source addresses to %global_allowed_mgmt_sources. Add authorised external scanners to %global_allowed_scanners. If SSH is intentionally published for non-device servers, scope the rule per client to the network-device address ranges or remove port 22 for that client. Any external Telnet (23) hit should be treated as high-fidelity."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 22 or $net.target.port = 23 or $net.target.port = 830)
    not $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1556.004")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
