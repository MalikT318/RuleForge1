/*
  MITRE Technique : T1027.006 - HTML Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:46:36.260297+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_006_Large_External_HTML_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a successful proxy-observed HTTP GET of an HTML-family document (.html, .htm, .xhtml, .svg, .hta) from an external host with an unusually large response body. HTML smuggling embeds the payload as a Base64 Blob or Data URL inside the page, so the carrier file is far larger than a normal static page. The payload never crosses the network as a separate download, so the oversized carrier document is the network-visible artefact."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.006"
    mitre_technique_name = "Obfuscated Files or Information: HTML Smuggling"
    log_prerequisites = "Requires forward-proxy or secure web gateway logs normalised to NETWORK_HTTP with target.url, network.http.method, network.http.response_code and network.received_bytes populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Large self-contained HTML reports exported to cloud storage, single-file web apps, saved web pages, documentation bundles, SaaS-generated HTML exports, and vendor portals serving large static HTML."
    tuning_guidance = "Add known-good external hostnames to %global_allowed_domains. Raise or lower the network.received_bytes threshold (default 500000) to match client web traffic baselines. Add sanctioned scanner or crawler source addresses to %global_allowed_scanners if they generate hits."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET"
    $net.network.http.response_code = 200
    $net.target.url = /\.(html?|xhtml|svg|hta)(\?|#|$)/ nocase
    $net.network.received_bytes > 500000
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1027.006")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_host = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $requested_url = array_distinct($net.target.url)
    $max_response_bytes = max($net.network.received_bytes)

  condition:
    $net
}
