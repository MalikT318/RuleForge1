/*
  MITRE Technique : T1687 - Exploitation for Defense Impairment
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:34:03.433871+00:00
  Reference       : https://attack.mitre.org/techniques/T1687
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1687_SaaS_Identity_Security_Control_Disabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the result of defense impairment in an identity provider or SaaS tenant: a security control (MFA, conditional access, sign-on or authentication policy, risk or threat protection, network zone) is disabled, deactivated, deleted or bypassed by a principal that is not an approved administrator or automation account. Exploitation itself is rarely visible in SaaS audit logs, so the rule alerts on the effect on the defensive control. This catches both exploited privilege-escalation or authorization-bypass flaws and abuse of stolen admin sessions."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1687"
    mitre_technique_name = "Exploitation for Defense Impairment"
    log_prerequisites = "Identity provider directory or admin audit logs ingested and normalised to UDM SETTING_MODIFICATION events, with target.resource.name (policy or setting name), metadata.description (action text) and principal.user.userid populated."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Planned policy rewrites or migrations by identity administrators, temporary MFA or conditional access exclusions during break-glass or incident response, tenant onboarding or consolidation, and IaC or automation pipelines that recreate policies by deactivating and re-adding them."
    tuning_guidance = "Add named administrators to %global_allowed_admin_users, and automation or IaC accounts to %global_allowed_service_accounts. Add approved cloud or identity service principals to %global_allowed_cloud_principals. If the identity provider writes the action into a different field, adjust the metadata.description regex. Correlate with a preceding anomalous sign-in for the same principal when triaging."

  events:
    $set.metadata.event_type = "SETTING_MODIFICATION"
    $set.target.resource.name = /(mfa|multi.?factor|conditional.?access|sign.?on.?polic|authentication.?polic|security.?default|threat.?(insight|protection)|risk.?polic|network.?zone|password.?polic|session.?polic)/ nocase
    $set.metadata.description = /(disabl|deactivat|delet|remov|bypass|turn(ed)?.?off|exclud|exempt)/ nocase
    not $set.principal.user.userid in %global_allowed_admin_users
    not $set.principal.user.userid in %global_allowed_service_accounts
    not $set.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1687")
    $primary_entity = array_distinct($set.principal.user.userid)
    $source_ips = array_distinct($set.principal.ip)
    $modified_controls = array_distinct($set.target.resource.name)

  condition:
    $set
}
