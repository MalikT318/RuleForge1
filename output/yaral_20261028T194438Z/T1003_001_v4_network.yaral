/*
  MITRE Technique : T1003.001 - LSASS Memory
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:38:02.539555+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_001_LSASS_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the LSASS process (lsass.exe) initiating a network connection to a non-internal address. Legitimate LSASS traffic (Kerberos, LDAP, NetLogon, SMB, RPC) goes to domain controllers and internal servers. An outbound connection to external address space suggests code injected into LSASS, a malicious security support provider or password filter DLL, or a process masquerading as lsass.exe that is sending out harvested credential material."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.001"
    mitre_technique_name = "OS Credential Dumping: LSASS Memory"
    log_prerequisites = "Requires Windows endpoint network telemetry that records the initiating process path for each connection (for example Sysmon Event ID 3 or equivalent EDR network events), normalised to UDM NETWORK_CONNECTION. The %rfc1918_internal list must be populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Hybrid-identity or cloud Kerberos and KDC proxy scenarios (Entra ID joined or hybrid joined hosts, Kerberos over HTTPS), CRL/OCSP or certificate validation traffic from LSASS in some configurations, loopback or link-local addresses not covered by the internal list, and DCs in remote sites reached over public addressing."
    tuning_guidance = "Confirm %rfc1918_internal covers all private, loopback and link-local ranges used by the client. Add known-good external endpoints (cloud identity or KDC proxy names) to %global_allowed_domains. Add approved external destinations such as VPN-reachable domain controllers to %global_allowed_mgmt_sources. Review the destination_ips and destination_ports outcome fields during triage."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\lsass\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1003.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $lsass_path = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
