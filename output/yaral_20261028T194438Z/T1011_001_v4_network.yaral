/*
  MITRE Technique : T1011.001 - Exfiltration Over Bluetooth
  Tactic(s)       : Exfiltration
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:22:25.851353+00:00
  Reference       : https://attack.mitre.org/techniques/T1011/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1011_001_Bluetooth_Stack_Process_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux Bluetooth stack or OBEX process (bluetoothd, obexd, obexftp, blueman and similar) opening a network connection to an external, non-internal address. Bluetooth traffic does not cross the IP network, so this is a proxy for the network-visible side of T1011.001. These daemons normally talk only to local radios and peers. An outbound IP connection to an external destination suggests data being relayed between a Bluetooth channel and an internet-facing channel, or a Bluetooth PAN/tether bridge in use. It does not observe the Bluetooth transfer itself. Pair it with endpoint rules covering OBEX file transfers and rfcomm/bnep interface creation."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1011.001"
    mitre_technique_name = "Exfiltration Over Other Network Medium: Exfiltration Over Bluetooth"
    log_prerequisites = "Linux endpoint telemetry (EDR or auditd with socket/connect auditing) that populates NETWORK_CONNECTION events with the originating process path (principal.process.file.full_path) and the destination IP (target.ip)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Desktop Bluetooth managers (blueman, bluedevil) checking for updates or fetching device metadata; Bluetooth PAN tethering where the host legitimately routes internet traffic via a paired phone; vendor Bluetooth management agents on kiosks or IoT gateways; process-attribution errors in the EDR that tag proxied traffic to the Bluetooth daemon."
    tuning_guidance = "Add known-good external destination domains to %global_allowed_domains and approved management or tethering tooling to %global_allowed_admin_tools. Populate %global_allowed_remote_mgmt for sanctioned remote-support agents that may share process lineage. For fleets that use Bluetooth tethering by policy, scope the rule to server and non-workstation host groups via a SOAR suppression."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(bluetoothd|obexd|obex-data-server|obexftp|obexfs|bluetooth-sendto|blueman-[a-z-]+|bluedevil[a-z-]*|bt-obex|rfcomm|pand)$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1011.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $bluetooth_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
