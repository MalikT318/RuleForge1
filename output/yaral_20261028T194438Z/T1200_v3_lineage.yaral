/*
  MITRE Technique : T1200 - Hardware Additions
  Tactic(s)       : Initial Access
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:50:00.022017+00:00
  Reference       : https://attack.mitre.org/techniques/T1200
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1200_Linux_Udev_Device_Parent_Spawns_Shell_Payload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a device-management daemon (udev or udisks) spawning a shell or script interpreter whose command line shows payload staging or network-fetch behaviour. A malicious hardware addition, such as a rogue USB device or a planted udev rule, can trigger this lineage. Legitimate hotplug handlers rarely fetch remote content, use raw TCP/UDP sockets, or execute from world-writable staging directories."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1200"
    mitre_technique_name = "Hardware Additions"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry that populates both parent and child process paths and the child command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Custom udev RUN+= rules that call helper scripts for device provisioning, kiosk or lab imaging stations, storage auto-mount helpers that stage files under /tmp, and hardware-enablement scripts that download firmware."
    tuning_guidance = "Add approved provisioning hosts or parent processes to %global_allowed_script_hosts and sanctioned helper interpreters to %global_allowed_admin_tools. Extend the parent regex with other device-event daemons used in the environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(systemd-udevd|udevd|udisksd)$/ nocase
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ash|ksh|python[0-9.]*|perl|ruby)$/ nocase
    $proc.target.process.command_line = /(\/dev\/(tcp|udp)\/|\b(curl|wget|nc|ncat|socat)\b|base64\s+(-d|--decode)|\bchmod\s+[+0-7a-z]*x|\/(tmp|var\/tmp|dev\/shm)\/)/ nocase
    not $proc.principal.hostname in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1200")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
