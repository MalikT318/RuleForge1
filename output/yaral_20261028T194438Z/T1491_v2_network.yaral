/*
  MITRE Technique : T1491 - Defacement
  Tactic(s)       : Impact
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:42:17.878326+00:00
  Reference       : https://attack.mitre.org/techniques/T1491
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_Web_Content_Overwrite_Via_External_HTTP_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external (non-internal) source successfully using an HTTP content-write method (PUT, MOVE, COPY) against a web server's default or landing document, such as index, default or iisstart. Writing to these pages is the network-observable step of web defacement on Windows-hosted web servers (IIS and similar). The rule keys on the write method plus a landing-page target and a success response, not on any attacker tool or payload."
    mitre_tactic = "Impact"
    mitre_technique = "T1491"
    mitre_technique_name = "Defacement"
    log_prerequisites = "Requires firewall, reverse-proxy or WAF logs that populate network.http.method, target.url, network.http.response_code and principal.ip, with decrypted HTTP visibility for inbound traffic to web servers."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Authorised content publishers or CMS and WebDAV deployments pushing site updates from external IPs, CI/CD pipelines deploying static sites, vendor-managed web hosting, and authorised penetration tests."
    tuning_guidance = "Add approved publisher and deployment source addresses to %global_allowed_mgmt_sources and authorised testers to %global_allowed_scanners. If a client legitimately uses WebDAV or PUT-based publishing, scope the rule per tenant by adding the publishing source to %global_allowed_mgmt_sources. Extend the landing-page regex only for client-specific default document names."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(PUT|MOVE|COPY)$/ nocase
    $net.target.url = /\/(index|default|iisstart|home|main|welcome)\.(html?|aspx?|php|jsp)(\?.*)?$/ nocase
    $net.network.http.response_code >= 200
    $net.network.http.response_code < 300
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1491")
    $primary_entity = array_distinct($net.target.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $written_urls = array_distinct($net.target.url)
    $http_methods = array_distinct($net.network.http.method)

  condition:
    $net
}
