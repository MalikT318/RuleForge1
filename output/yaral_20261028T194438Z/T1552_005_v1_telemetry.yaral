/*
  MITRE Technique : T1552.005 - Cloud Instance Metadata API
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:52:02.057183+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_005_IMDS_Config_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a control-plane configuration change to an instance's metadata service options (for example ModifyInstanceMetadataOptions). Adversaries with API access commonly re-enable the legacy unauthenticated metadata protocol, raise the response hop limit so containers or SSRF paths can reach it, or re-enable the endpoint. Any of these makes instance-role credentials easier to harvest. This rule covers the configuration state change at the cloud audit layer, not process or command-line activity on the instance."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.005"
    mitre_technique_name = "Unsecured Credentials: Cloud Instance Metadata API"
    log_prerequisites = "Cloud provider control-plane audit logs (management events) ingested and normalised to UDM SETTING_MODIFICATION, with metadata.product_event_type populated with the API operation name."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Infrastructure-as-code pipelines and landing-zone automation applying or re-applying metadata options; security hardening projects that move instances to the authenticated protocol (a hardening change also matches because request parameters are not evaluated); cloud administrators troubleshooting legacy applications that depend on the older metadata protocol; autoscaling or image-baking workflows."
    tuning_guidance = "Add IaC and automation identities to %global_allowed_cloud_principals and named administrators to %global_allowed_admin_users. If the tenant's UDM parser exposes request parameters, add a condition on the specific option values (tokens optional, hop limit above 1, endpoint enabled) to remove hardening changes. Consider raising severity for production or internet-facing instance groups."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /(ModifyInstanceMetadataOptions|ModifyInstanceMetadataDefaults)/ nocase
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1552.005")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $source_ips = array_distinct($cloud.principal.ip)
    $api_operation = array_distinct($cloud.metadata.product_event_type)
    $target_resource = array_distinct($cloud.target.resource.name)

  condition:
    $cloud
}
