/*
  MITRE Technique : T1069.003 - Cloud Groups
  Tactic(s)       : Discovery
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:01:36.983658+00:00
  Reference       : https://attack.mitre.org/techniques/T1069/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1069_003_Cloud_Group_Role_Enumeration_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single identity issues a high volume of group, role, policy and membership listing API calls within ten minutes. Each call is benign on its own. A burst of them is typical of an adversary with newly obtained cloud credentials mapping permission groups and role assignments."
    mitre_tactic = "Discovery"
    mitre_technique = "T1069.003"
    mitre_technique_name = "Permission Groups Discovery: Cloud Groups"
    log_prerequisites = "Cloud control-plane audit logs (management/read API activity) ingested and normalised to UDM USER_RESOURCE_ACCESS, with the API operation name in metadata.product_event_type. Read-only list and get API calls must be enabled in the audit configuration, because many platforms do not log them by default."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "IAM governance and access-review tooling, identity sync and provisioning connectors, CSPM and compliance scanners running under user or service identities, admins performing access audits or migrations, infrastructure-as-code pipelines that refresh state."
    tuning_guidance = "Add automation and connector identities to %global_allowed_service_accounts, approved IAM administrators to %global_allowed_admin_users, and approved cloud service principals to %global_allowed_cloud_principals. Raise the #access threshold for tenants with heavy governance automation. Lower it for low-activity tenants. Extend the operation-name regex if the log source uses different list/get verbs."

  events:
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.metadata.product_event_type = /(List|Get|Describe|Search)[A-Za-z]*(Group|Role|Polic|Member|Assignment|Permission|Acl|Entitlement)/ nocase
    $access.principal.user.userid = $user
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_admin_users
    not $access.principal.user.userid in %global_allowed_cloud_principals

  match:
    $user over 10m

  outcome:
    $risk_score = max(55)
    $event_count = count($access.metadata.id)
    $distinct_operations = count_distinct($access.metadata.product_event_type)
    $operations_seen = array_distinct($access.metadata.product_event_type)
    $source_ips = array_distinct($access.principal.ip)
    $mitre_technique_id = array_distinct("T1069.003")
    $primary_entity = array_distinct($user)

  condition:
    #access >= 15
}
