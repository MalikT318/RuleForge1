/*
  MITRE Technique : T1558.003 - Kerberoasting
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:43:45.256560+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_003_NonLsass_Kerberos_Traffic_Then_Ticket_File {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a process other than the Windows Kerberos provider (lsass) or an approved tool connecting to the Kerberos port (88) and, within ten minutes on the same host, a Kerberos ticket export file (.kirbi or .ccache) being written to disk. Together these indicate TGS ticket requests made by a user-space process and then extracted for offline cracking (Kerberoasting). This is endpoint network and file telemetry, so it adds coverage beyond process command-line rules."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.003"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Kerberoasting"
    log_prerequisites = "Requires EDR or Sysmon network connection telemetry (Sysmon EID 3 equivalent) with process attribution, and file creation telemetry (Sysmon EID 11 equivalent), normalised to UDM NETWORK_CONNECTION and FILE_CREATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Java or other cross-platform applications and MIT Kerberos for Windows that speak Kerberos directly; identity and PAM tooling; Kerberos troubleshooting by administrators who export tickets; security assessment tooling during authorised tests."
    tuning_guidance = "Add approved Kerberos-aware tooling to %global_allowed_admin_tools, authorised testing hosts or tools to %global_allowed_scanners, and EDR or security agents to %global_allowed_security_tools. If the tenant has many direct-Kerberos applications, add their executable paths to %global_allowed_admin_tools."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 88
    $net.principal.process.file.full_path != ""
    not $net.principal.process.file.full_path = /\\(lsass|System)\.exe$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    $net.principal.hostname = $hostname

    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(kirbi|ccache)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $net.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1558.003")
    $primary_entity = array_distinct($hostname)
    $kerberos_clients = array_distinct($net.principal.process.file.full_path)
    $domain_controllers = array_distinct($net.target.ip)
    $ticket_files = array_distinct($file.target.file.full_path)
    $affected_users = array_distinct($file.principal.user.userid)
    $kerberos_connection_count = count($net.metadata.id)

  condition:
    $net and $file
}
