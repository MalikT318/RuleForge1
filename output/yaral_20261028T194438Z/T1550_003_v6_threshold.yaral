/*
  MITRE Technique : T1550.003 - Pass the Ticket
  Tactic(s)       : Lateral Movement
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:41:35.441134+00:00
  Reference       : https://attack.mitre.org/techniques/T1550/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1550_003_Kerberos_Network_Logon_Fanout_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single non-machine account performs a high volume of Kerberos network logons within ten minutes. Each logon is normal. A burst of them from one account is consistent with a stolen or forged Kerberos ticket (pass-the-ticket) being replayed to move laterally across hosts and services."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1550.003"
    mitre_technique_name = "Use Alternate Authentication Material: Pass the Ticket"
    log_prerequisites = "Requires Windows Security event log 4624 (logon type 3, Kerberos package) normalised to USER_LOGIN with extensions.auth.mechanism and extensions.auth.auth_details populated, collected from domain controllers and member servers."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "File, print and application servers authenticating many users or one proxy account. Monitoring and inventory accounts. Backup or patching service accounts. Admins running scripts across many servers. Mapped-drive or DFS reconnect storms after network outages."
    tuning_guidance = "Add service and automation accounts to %global_allowed_service_accounts. Add named administrators to %global_allowed_admin_users. Add scanner or jump-host sources to %global_allowed_scanners. Raise or lower the #auth threshold per client baseline. Review $distinct_target_hosts in the outcome: a high value points to lateral movement, while a low value with a high event count suggests a chatty service."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.extensions.auth.mechanism = "NETWORK"
    $auth.extensions.auth.auth_details = /kerberos/ nocase
    $auth.target.user.userid != ""
    $auth.target.hostname != ""
    not $auth.target.user.userid = /\$$/
    not $auth.target.user.userid = /^(anonymous logon|-)$/ nocase
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.principal.hostname in %global_allowed_scanners
    $auth.target.user.userid = $user

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1550.003")
    $primary_entity = array_distinct($user)
    $logon_count = count($auth.metadata.id)
    $distinct_target_hosts = count_distinct($auth.target.hostname)
    $target_hosts = array_distinct($auth.target.hostname)
    $source_hosts = array_distinct($auth.principal.hostname)

  condition:
    #auth >= 15
}
