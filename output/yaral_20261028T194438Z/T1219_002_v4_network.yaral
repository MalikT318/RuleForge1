/*
  MITRE Technique : T1219.002 - Remote Desktop Software
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:08:42.916800+00:00
  Reference       : https://attack.mitre.org/techniques/T1219/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1219_002_Outbound_Remote_Desktop_Protocol_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects outbound connections from internal hosts to external addresses on ports commonly used by remote desktop and remote support software (RDP, VNC, and the default ports of commercial remote support tools). Perimeter logs show the network side of an interactive remote-control channel, so this works even when the endpoint binary has been renamed or portable-packaged."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1219.002"
    mitre_technique_name = "Remote Access Software: Remote Desktop Software"
    log_prerequisites = "Firewall or perimeter logs normalised to UDM NETWORK_CONNECTION, with principal.ip, target.ip and target.port populated. The %rfc1918_internal list must be maintained for the tenant."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Approved IT support or MSP remote access, helpdesk tooling, vendor-managed systems, admins reaching cloud-hosted Windows servers over RDP, and cloud-hosted VDI services."
    tuning_guidance = "Add approved source addresses to %global_allowed_mgmt_sources, approved destination domains to %global_allowed_domains, and approved support hosts to %global_allowed_remote_mgmt. Narrow the port list if a client legitimately uses one of these ports for outbound traffic."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.ip != ""
    (
      $net.target.port = 3389 or
      $net.target.port = 5900 or
      $net.target.port = 5901 or
      $net.target.port = 5902 or
      $net.target.port = 5931 or
      $net.target.port = 5938 or
      $net.target.port = 6568 or
      $net.target.port = 7070
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.hostname in %global_allowed_remote_mgmt
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1219.002")
    $primary_entity = array_distinct($net.principal.ip)
    $source_hostnames = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
