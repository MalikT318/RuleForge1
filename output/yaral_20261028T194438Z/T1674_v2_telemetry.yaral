/*
  MITRE Technique : T1674 - Input Injection
  Tactic(s)       : Execution
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:17:56.459658+00:00
  Reference       : https://attack.mitre.org/techniques/T1674
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1674_Linux_Virtual_Input_Device_Config_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of udev, modules-load or modprobe configuration files that enable or grant access to the kernel virtual input interfaces (uinput/uhid). These interfaces let a process or emulated HID inject synthetic keystrokes and mouse events, which is how input injection is done on Linux without any command-line trace. The rule pivots on the persistent file artifact rather than process command lines."
    mitre_tactic = "Execution"
    mitre_technique = "T1674"
    mitre_technique_name = "Input Injection"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules (-w /etc/udev/rules.d -p wa, -w /etc/modules-load.d -p wa, -w /etc/modprobe.d -p wa) that populate FILE_CREATION events with target.file.full_path and principal.process.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Remote desktop and virtual KVM software, game controller and input-remapping packages, accessibility tools, on-screen keyboards, VM guest additions, Steam and gaming-input packages, and configuration management that deploys input-device udev rules."
    tuning_guidance = "Add approved deployment or package tooling to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. On servers with no GUI, treat any hit as high priority and consider raising severity. On developer or desktop fleets, expect more hits from legitimate input-remapping packages. This rule only matches files whose names reference uinput or uhid; for broader coverage, add auditd watches on /dev/uinput opens, which require a PROCESS_OPEN or file-read source."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(etc|usr\/lib|lib|run)\/(udev\/rules\.d|modules-load\.d|modprobe\.d)\/[^\/]*(uinput|uhid)[^\/]*$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|yum|dnf|zypper|pacman|snapd|packagekitd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1674")
    $primary_entity = array_distinct($file.principal.hostname)
    $config_file_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
