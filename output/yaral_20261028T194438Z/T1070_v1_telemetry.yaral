/*
  MITRE Technique : T1070 - Indicator Removal
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:01:52.735844+00:00
  Reference       : https://attack.mitre.org/techniques/T1070
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_M365_Audit_Logging_Tampering {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects administrative configuration changes that disable, bypass or weaken tenant audit logging (unified audit log configuration, mailbox audit bypass, mailbox audit settings). Adversaries use these changes to selectively remove evidence of their activity. This rule works at the configuration-change layer, not the command line."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070"
    mitre_technique_name = "Indicator Removal"
    log_prerequisites = "Requires Microsoft 365 / Google Workspace unified audit logs with admin and exchange-admin operations ingested and normalised to SETTING_MODIFICATION, with the operation name in metadata.product_event_type."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Planned compliance or audit-policy changes by tenant administrators, migration projects that temporarily bypass mailbox auditing for service accounts, backup or archiving connectors requiring audit bypass, onboarding of new tenants."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and automation or migration identities to %global_allowed_service_accounts. Add approved cloud service principals to %global_allowed_cloud_principals. Raise severity to Critical if the change occurs outside change windows or follows a risky sign-in for the same user."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /^(Set-AdminAuditLogConfig|Set-MailboxAuditBypassAssociation|Set-AuditConfig|Set-OrganizationConfig|Set-Mailbox|Disable-AuditLog\w*|Remove-AuditLog\w*)$/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1070")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $operations = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)
    $affected_resources = array_distinct($cloud.target.resource.name)

  condition:
    $cloud
}
