/*
  MITRE Technique : T1213.006 - Databases
  Tactic(s)       : Collection
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:31:42.853838+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_006_Excessive_External_Database_Port_Connections {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source opens many connections to well-known database service ports on external destinations within ten minutes. Each connection is benign on its own. High volume suggests database mining, bulk data collection or exposed-database access, such as from a compromised Windows workstation or server. Detection uses only network-observable fields (destination port, destination address scope, connection volume) and no endpoint process data."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.006"
    mitre_technique_name = "Data from Information Repositories: Databases"
    log_prerequisites = "Firewall, proxy or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. The firewall must see egress traffic from the Windows hosts of interest."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Applications or ETL jobs that legitimately use externally hosted databases (cloud-managed SQL or NoSQL services), developer workstations testing against cloud databases, vulnerability scanners probing database ports, and monitoring or health-check systems."
    tuning_guidance = "Add approved scanner sources to %global_allowed_scanners and approved management or data-integration sources to %global_allowed_mgmt_sources. Raise the #net threshold in noisy environments with many cloud-hosted databases. Internal destinations are excluded by %rfc1918_internal, so pair this rule with an internal-facing rule if east-west database access needs coverage."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 1433 or
      $net.target.port = 1521 or
      $net.target.port = 3306 or
      $net.target.port = 5432 or
      $net.target.port = 27017 or
      $net.target.port = 6379 or
      $net.target.port = 9042
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    $net.principal.ip = $src_ip

  match:
    $src_ip over 10m

  outcome:
    $risk_score = if(count($net.metadata.id) >= 50, 80, 55)
    $mitre_technique_id = array_distinct("T1213.006")
    $primary_entity = array_distinct($src_ip)
    $event_count = count($net.metadata.id)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 10
}
