/*
  MITRE Technique : T1055.005 - Thread Local Storage
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:52:47.460762+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_005_Unexpected_Parent_Spawns_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a script interpreter or shell launched by a parent process that should never spawn one: an Office application, web server worker, print spooler, or database service. This is a lineage-based indicator of in-memory injection (including TLS callback injection, T1055.005) into a long-running host process that then executes follow-on commands. It does not observe the TLS callback manipulation itself; it flags the anomalous parent-child relationship that results from successful injection or exploitation. It does not match on command-line content."
    mitre_tactic = "Defense Evasion (Stealth), Privilege Escalation"
    mitre_technique = "T1055.005"
    mitre_technique_name = "Process Injection: Thread Local Storage"
    log_prerequisites = "Requires Windows EDR or Sysmon process-creation telemetry (or Security Event 4688 with parent process name) that populates both the parent (principal.process) and child (target.process) image paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "SQL Server Agent jobs or xp_cmdshell used by legitimate administration; IIS-hosted applications that shell out for report generation or file conversion; print drivers or vendor print-management software launching cmd from the spooler; Office macros or add-ins used by approved business workflows; developer machines running local web servers."
    tuning_guidance = "Add approved parent binaries to %global_allowed_script_hosts and approved management tooling to %global_allowed_admin_tools. Where a database or web application legitimately launches shells, add the parent executable path to %global_allowed_script_hosts for that client only. Narrow or extend the parent regex per client as needed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|onenote|visio|w3wp|httpd|nginx|tomcat\d*|php-cgi|spoolsv|sqlservr|mysqld|postgres|oracle)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|powershell_ise|wscript|cscript|mshta)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
