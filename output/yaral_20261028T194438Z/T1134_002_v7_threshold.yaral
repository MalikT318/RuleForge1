/*
  MITRE Technique : T1134.002 - Create Process with Token
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:56:22.530302+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_002_Runas_Alternate_Credential_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated use of the built-in runas utility with alternate-credential switches (/user, /netonly, /savecred) on a single host within ten minutes. A single runas call is routine administration. A burst suggests an adversary spawning processes under another user's token or credentials to escalate privileges or move laterally."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.002"
    mitre_technique_name = "Access Token Manipulation: Create Process with Token"
    log_prerequisites = "Requires Windows endpoint process telemetry (EDR or Sysmon Event ID 1) or Windows Security Event 4688 with command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Helpdesk and system administrators launching several elevated consoles under a different account, IT deployment or patching scripts using runas, and developers testing applications under different user contexts."
    tuning_guidance = "Add approved parent tooling to %global_allowed_admin_tools, add named administrators to %global_allowed_admin_users, and add automation accounts to %global_allowed_service_accounts. Raise the #proc threshold for hosts such as jump boxes or admin workstations where runas is used heavily."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\runas\.exe$/ nocase
    $proc.target.process.command_line = /\/(user|netonly|savecred)\b/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1134.002")
    $primary_entity = array_distinct($host)
    $invoking_users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
