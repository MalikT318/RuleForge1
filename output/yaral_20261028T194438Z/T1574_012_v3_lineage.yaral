/*
  MITRE Technique : T1574.012 - COR_PROFILER
  Tactic(s)       : Stealth, Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:43:40.142466+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_012_COR_PROFILER_Unexpected_Parent_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, script interpreter or environment-modifying utility that references .NET profiler environment variables (COR_ENABLE_PROFILING, COR_PROFILER, COR_PROFILER_PATH, CORECLR_*) and was spawned by an unexpected parent: an Office application, web server, print spooler, database service or similar. Normal developer and APM use of these variables does not originate from these parents, so the lineage anomaly is the primary signal and the profiler marker confirms intent to hijack CLR loading for persistence or privilege escalation."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.012"
    mitre_technique_name = "Hijack Execution Flow: COR_PROFILER"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with parent process path, child process path and full command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing and parent fields populated)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web applications or database jobs that legitimately launch .NET diagnostic or profiling tooling (APM agent installers, application performance tuning run from IIS or SQL Agent), Office add-in installers configuring .NET profiling for developers, and software deployment run through a web-hosted management console."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts and approved tooling to %global_allowed_admin_tools. If a client runs an APM product that injects via COR_PROFILER from a service parent, add that parent executable to %global_allowed_script_hosts. Extend the parent regex with client-specific line-of-business server processes if required."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|onenote|msaccess|mspub|visio|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|spoolsv|sqlservr|sqlagent|mysqld|postgres|oracle)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|reg|setx|wmic|regsvr32|rundll32)\.exe$/ nocase
    $proc.target.process.command_line = /(COR_ENABLE_PROFILING|COR_PROFILER|COR_PROFILER_PATH|CORECLR_ENABLE_PROFILING|CORECLR_PROFILER)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1574.012")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
