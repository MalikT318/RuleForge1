/*
  MITRE Technique : T1134.005 - SID-History Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:03:05.592198+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_005_SIDHistory_Modification_Then_Remote_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects a command that adds or replaces the SIDHistory attribute of an AD object (PowerShell AD cmdlets, LDIF import, LDAP modify, offline NTDS editing), followed within 10 minutes by a remote-access command on the same host. The remote command is a share or admin-share connection, WinRM/PS remoting or a remote service, task or WMI action. This sequence matches SID-History injection used to impersonate privileged identities and then move laterally."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.005"
    mitre_technique_name = "Access Token Manipulation: SID-History Injection"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command lines (EDR, Sysmon Event 1 or Security Event 4688 with command-line auditing) from domain controllers and admin workstations."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate AD domain migrations (ADMT, cross-domain account moves) that populate SIDHistory, followed by admin remote sessions from the same jump host; identity-management automation; AD consultants running audits."
    tuning_guidance = "Add migration and management tooling to %global_allowed_admin_tools, migration administrators to %global_allowed_admin_users, and approved remote-management tooling to %global_allowed_remote_mgmt. During planned domain migrations, scope the exclusions to the migration hosts."

  events:
    $sid.metadata.event_type = "PROCESS_LAUNCH"
    $sid.target.process.command_line = /sidhistory/ nocase
    $sid.target.process.command_line = /(set-aduser|set-adobject|add-addbsidhistory|ldifde|ldapmodify|dsaddsidhistory|-add\s+@\{|-replace\s+@\{|\bchangetype:\s*modify|\bsid::patch|\bmisc::addsid)/ nocase
    not $sid.principal.process.file.full_path in %global_allowed_admin_tools
    not $sid.principal.user.userid in %global_allowed_admin_users
    $sid.principal.hostname = $hostname

    $remote.metadata.event_type = "PROCESS_LAUNCH"
    $remote.target.process.file.full_path = /\\(net|net1|powershell|pwsh|winrs|wmic|sc|schtasks|cmd)\.exe$/ nocase
    $remote.target.process.command_line = /(\\\\[^\\\s]+\\(admin|c|ipc)\$|enter-pssession|new-pssession|invoke-command|winrs\s+.*-r:|\bsc(\.exe)?\s+\\\\|schtasks.*\/s\s|wmic.*\/node:)/ nocase
    not $remote.principal.process.file.full_path in %global_allowed_remote_mgmt
    $remote.principal.hostname = $hostname

    $sid.metadata.event_timestamp.seconds <= $remote.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1134.005")
    $primary_entity = array_distinct($sid.principal.hostname)
    $sid_history_commands = array_distinct($sid.target.process.command_line)
    $remote_commands = array_distinct($remote.target.process.command_line)
    $acting_users = array_distinct($sid.principal.user.userid)
    $remote_event_count = count($remote.metadata.id)

  condition:
    $sid and $remote
}
