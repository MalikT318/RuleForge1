/*
  MITRE Technique : T1001.003 - Protocol or Service Impersonation
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:09:31.605938+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_003_Cleartext_HTTP_On_TLS_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Network security appliance (IDS/IPS) identifies plaintext HTTP application-layer traffic from an internal Windows host to an external destination on a TLS service port (443/8443). Implants that impersonate TLS or web-service traffic to blend in with HTTPS often produce this mismatch: the port suggests encrypted web traffic, but the payload is not TLS."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001.003"
    mitre_technique_name = "Data Obfuscation: Protocol or Service Impersonation"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs normalized to UDM NETWORK_CONNECTION with network.application_protocol populated by the appliance's application identification (not inferred from the port). Source hosts should be mapped to Windows endpoints through asset or IP context."
    platform = "Windows"
    log_source = "ips"
    false_positives = "Legacy applications or embedded agents that send plain HTTP to port 443; misconfigured proxies or load balancers; TLS-inspecting devices that log the decrypted application protocol on port 443; appliance application-ID misclassification of unusual TLS extensions or handshakes."
    tuning_guidance = "First confirm that the appliance's application_protocol reflects actual traffic content and not the port. Add known-good destination domains to %global_allowed_domains. Add scanners or testing sources to %global_allowed_scanners. If TLS inspection is deployed, exclude the inspection egress addresses by adding them to %global_allowed_scanners or by tuning the source. Add 8443 or other ports to the port condition only if the environment supports them."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.application_protocol = "HTTP"
    ($net.target.port = 443 or $net.target.port = 8443)
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1001.003")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
