/*
  MITRE Technique : T1001 - Data Obfuscation
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:04:15.074408+00:00
  Reference       : https://attack.mitre.org/techniques/T1001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_Linux_Service_Parent_Spawns_Decode_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing service process (web server, application server, database or cache daemon) spawning a shell or script interpreter whose command line decodes obfuscated content (base64 decode, hex reversal, openssl decode, or escaped bytes piped into a shell). This lineage anomaly is typical of web shells and implants that receive encoded C2 commands and hide their content from inspection."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001"
    mitre_technique_name = "Data Obfuscation"
    log_prerequisites = "Linux EDR or auditd execve telemetry normalised to UDM PROCESS_LAUNCH with populated parent process path, child process path and full command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web applications or CMS plugins that legitimately shell out to decode base64 (for example mail or upload handlers), database maintenance or backup scripts launched by the database daemon, application deployment hooks run from a web server parent, and health-check scripts started by service wrappers."
    tuning_guidance = "Add approved parent binaries or wrapper scripts to %global_allowed_script_hosts and approved tooling to %global_allowed_admin_tools. If a specific application legitimately decodes data via shell, allowlist its parent path rather than loosening the command-line regex. Extend the parent regex with client-specific service daemons if needed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|php-cgi|tomcat[0-9]*|mysqld|mariadbd|postgres|redis-server|mongod)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ksh|ash|python[0-9.]*|perl|ruby|php)$/ nocase
    $proc.target.process.command_line = /(base64\s+(-d|-D|--decode)|xxd\s+-r|openssl\s+(enc|base64)[^|;]*-d|(\\x[0-9a-f]{2}){4,}.*\|\s*(ba|da)?sh\b|\|\s*base64\s+(-d|--decode))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
