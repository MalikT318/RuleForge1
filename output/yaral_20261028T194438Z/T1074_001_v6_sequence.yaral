/*
  MITRE Technique : T1074.001 - Local Data Staging
  Tactic(s)       : Collection
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:19:19.356228+00:00
  Reference       : https://attack.mitre.org/techniques/T1074/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_001_Linux_Copy_To_Staging_Then_Archive {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects local data staging on Linux: a copy or sync command moves sensitive-looking content (home directories, SSH material, credential files, web roots, application data) into a world-writable staging directory (/tmp, /var/tmp, /dev/shm). An archive utility then writes a compressed archive into one of those directories on the same host within ten minutes."
    mitre_tactic = "Collection"
    mitre_technique = "T1074.001"
    mitre_technique_name = "Data Staged: Local Data Staging"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry populating command lines for PROCESS_LAUNCH, plus file creation telemetry (FILE_CREATION) with the creating process path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup and migration scripts that stage data in /tmp before archiving, admins collecting support bundles or logs, software installers and package build jobs, database dump jobs, and configuration management or deployment tooling."
    tuning_guidance = "Add approved backup tooling to %global_allowed_backup_processes and approved admin or deployment tools to %global_allowed_admin_tools. Add approved automation users to %global_allowed_admin_users. Narrow the source-path regex or the staging directories to suit client environments. Raise severity where sensitive-path hits include /etc/shadow or .ssh."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(cp|rsync|scp|install)$/ nocase
    $proc.target.process.command_line = /(\/home\/|\/root\/|\/etc\/(passwd|shadow|ssh)|\/var\/(www|lib\/(mysql|postgresql))|\.ssh|\.gnupg|\.aws|\.kube)/ nocase
    $proc.target.process.command_line = /(\/dev\/shm\/|\/var\/tmp\/|\/tmp\/)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.user.userid in %global_allowed_admin_users
    $proc.principal.hostname = $host

    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.*\.(tar|tgz|tar\.gz|tar\.bz2|tar\.xz|zip|7z|rar|gz|bz2|xz)$/ nocase
    $file.principal.process.file.full_path = /\/(tar|zip|7z|7za|7zr|gzip|bzip2|xz|rar)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $host

    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1074.001")
    $primary_entity = array_distinct($host)
    $copy_commands = array_distinct($proc.target.process.command_line)
    $staged_archives = array_distinct($file.target.file.full_path)
    $acting_users = array_distinct($proc.principal.user.userid)
    $event_count = count($file.metadata.id)

  condition:
    $proc and $file
}
