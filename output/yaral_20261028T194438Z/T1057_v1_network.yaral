/*
  MITRE Technique : T1057 - Process Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:52:27.569473+00:00
  Reference       : https://attack.mitre.org/techniques/T1057
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1057_Linux_External_Container_Process_Listing_API {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external (non-internal) source calling container or orchestrator management API endpoints that return the list of running processes or pods on a Linux host, such as the container runtime 'top' endpoint and the node agent 'runningpods' endpoint. This is network-side process discovery against an exposed management plane and complements endpoint command-line detections for ps or /proc enumeration."
    mitre_tactic = "Discovery"
    mitre_technique = "T1057"
    mitre_technique_name = "Process Discovery"
    log_prerequisites = "Requires firewall, proxy or WAF logs normalised to NETWORK_HTTP with target.url populated (cleartext or TLS-inspected traffic). Without URL visibility this rule will not fire."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Internet-hosted monitoring or CI/CD SaaS that legitimately queries container runtime or node agent APIs, authorised external penetration tests, NAT or proxy egress addresses that make internal clients appear external."
    tuning_guidance = "Add approved external scanners and testing sources to %global_allowed_scanners, approved external management or monitoring addresses to %global_allowed_mgmt_sources, and known-good service identities to %global_allowed_service_accounts. Confirm that the %rfc1918_internal list covers all internal ranges and NAT egress for the client."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\/(containers\/[^\/]+\/top|runningpods)\/?(\?|$)/ nocase
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1057")
    $primary_entity = array_distinct($net.target.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $target_urls = array_distinct($net.target.url)

  condition:
    $net
}
