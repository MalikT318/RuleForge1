/*
  MITRE Technique : T1055 - Process Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:45:13.678782+00:00
  Reference       : https://attack.mitre.org/techniques/T1055
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_Windows_Repeated_Process_Injection_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of cross-process injection events (remote thread creation, memory write or mapping into another process) on a single Windows host within 10 minutes. A single injection event is common in benign software, but repeated injections from non-allowlisted source processes suggest an injection-capable implant, a loader segmenting its modules across several victim processes, or post-exploitation tooling migrating between processes."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055"
    mitre_technique_name = "Process Injection"
    log_prerequisites = "Requires Windows endpoint telemetry (EDR or Sysmon-equivalent) that is normalised to PROCESS_INJECTION events, such as remote thread creation and cross-process memory write/map events. PROCESS_LAUNCH telemetry alone is not sufficient."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Endpoint security and EDR agents, application compatibility shims, accessibility and input-method software, screen readers, game overlays, DRM or anti-cheat software, backup and imaging agents, debuggers and profilers used by developers, and RMM tooling that hooks other processes."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools, backup agents to %global_allowed_backup_processes, and IT tooling to %global_allowed_admin_tools. If one noisy host is a developer workstation running debuggers, raise the #inj threshold for that client or add the debugger executable to %global_allowed_admin_tools. Risk can be raised in outcome when many distinct target processes are injected."

  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.hostname = $host
    $inj.principal.process.file.full_path != ""
    $inj.target.process.file.full_path != ""
    $inj.principal.process.file.full_path != $inj.target.process.file.full_path
    not $inj.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|SenseCncProxy)\.exe$/ nocase
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1055")
    $primary_entity = array_distinct($host)
    $event_count = count($inj.metadata.id)
    $source_processes = array_distinct($inj.principal.process.file.full_path)
    $target_processes = array_distinct($inj.target.process.file.full_path)
    $source_users = array_distinct($inj.principal.user.userid)

  condition:
    #inj >= 5
}
