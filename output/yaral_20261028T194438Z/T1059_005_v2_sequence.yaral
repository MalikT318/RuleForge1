/*
  MITRE Technique : T1059.005 - Visual Basic
  Tactic(s)       : Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:12:52.976874+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_005_Linux_VB_Source_Dropped_Then_Executed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A Visual Basic source or script file (.vbs, .vbe, .vb, .bas) is written to a world-writable staging directory (/tmp, /var/tmp, /dev/shm) and, within five minutes on the same host, a VB-capable runtime or compiler (Wine script host, Mono, .NET SDK, VB compiler) is launched against a VB file. On Linux, VB is rare and this drop-then-run sequence is a strong sign of cross-platform malware or a staged VBScript payload."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.005"
    mitre_technique_name = "Command and Scripting Interpreter: Visual Basic"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that produces both FILE_CREATION and PROCESS_LAUNCH events with populated target.file.full_path, target.process.file.full_path and command_line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers building VB.NET projects with the .NET SDK or Mono in temporary build directories, CI/CD runners, and legitimate Wine-based Windows application compatibility workflows."
    tuning_guidance = "Add approved build agents and package managers to %global_allowed_script_hosts (file writer) or %global_allowed_admin_tools (launching process). Add build and automation accounts to %global_allowed_service_accounts. If the developer population is large, scope by host group in the SOAR playbook."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.*\.(vbs|vbe|vb|bas)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(wine|wine64|wine-preloader|mono|dotnet|vbnc|vbc|cscript|wscript)$/ nocase
    $proc.target.process.command_line = /\.(vbs|vbe|vb|bas)(\s|"|'|$)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1059.005")
    $primary_entity = array_distinct($hostname)
    $dropped_files = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $runtime_processes = array_distinct($proc.target.process.file.full_path)
    $executed_commands = array_distinct($proc.target.process.command_line)
    $executing_users = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
