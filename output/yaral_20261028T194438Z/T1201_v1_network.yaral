/*
  MITRE Technique : T1201 - Password Policy Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:51:39.260891+00:00
  Reference       : https://attack.mitre.org/techniques/T1201
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1201_Cloud_Password_Policy_Query_Via_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects scripted or non-browser HTTP clients on Windows hosts querying identity-provider directory API paths that expose tenant password and lockout policy (domain password validity, password rule directory settings, authentication method policies) through an external web gateway. This is the network-side view of password policy discovery against cloud directories, complementing endpoint command-line detections."
    mitre_tactic = "Discovery"
    mitre_technique = "T1201"
    mitre_technique_name = "Password Policy Discovery"
    log_prerequisites = "Requires proxy or secure web gateway logs with TLS inspection so the full request URL and user agent are normalised to NETWORK_HTTP (target.url, network.http.user_agent). Without TLS inspection the URL path is not visible and this rule will not fire."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Identity and IT administrators scripting tenant audits, identity governance and posture-management tools, directory sync agents, MDM or compliance connectors, and approved penetration tests or security assessments."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users, automation identities to %global_allowed_service_accounts, and approved scanner or assessment sources to %global_allowed_scanners. If TLS inspection does not populate network.http.user_agent for a client, remove the user agent condition and rely on the URL path and exclusions."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\/(v1\.0|beta)\/(domains|settings|policies\/(authenticationMethodsPolicy|identitySecurityDefaultsEnforcementPolicy|authorizationPolicy))/ nocase
    $net.network.http.user_agent = /(WindowsPowerShell|PowerShell|python-requests|python-urllib|curl|wget|Go-http-client|okhttp|Java\/|libwww|aiohttp)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.user.userid in %global_allowed_admin_users
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1201")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_user = array_distinct($net.principal.user.userid)
    $requested_urls = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
