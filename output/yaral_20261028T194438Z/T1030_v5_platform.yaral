/*
  MITRE Technique : T1030 - Data Transfer Size Limits
  Tactic(s)       : Exfiltration
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:52:23.925524+00:00
  Reference       : https://attack.mitre.org/techniques/T1030
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1030_ESXi_Host_Chunked_Outbound_Upload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi host making a one-way, chunk-sized outbound transfer (roughly 500 KB to 10 MB sent, almost nothing received) to an external destination, as seen at the network perimeter. ESXi management hosts rarely initiate bulk uploads to the internet. Repeated fixed-size flows like this match staged exfiltration in size-limited chunks (T1030). Each hit is one chunk, so correlate repeated alerts for the same primary entity."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1030"
    mitre_technique_name = "Data Transfer Size Limits"
    log_prerequisites = "Firewall or proxy flow logs that populate network.sent_bytes and network.received_bytes. The ESXi host must be identifiable by principal.hostname, which assumes a hostname convention containing 'esx'. Alternatively, populate the host's source IP via asset enrichment."
    platform = "ESXi"
    log_source = "firewall"
    false_positives = "Authorised offsite backup or replication (VM replication appliances, backup proxies), ESXi host log or support-bundle upload to a vendor, patch or depot synchronisation, vCenter-initiated telemetry, and hosts whose names contain 'esx' but run unrelated workloads."
    tuning_guidance = "Add approved vendor, backup and update destinations to %global_allowed_domains. Adjust the sent_bytes band to the environment's baseline. If hostnames do not follow an 'esx' convention, change the principal.hostname regex to the client's ESXi naming convention. Alert on repeats per host in downstream SOAR logic to catch the chunking pattern."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    $net.principal.hostname = /esx/ nocase
    not $net.target.ip in %rfc1918_internal
    $net.network.sent_bytes >= 524288
    $net.network.sent_bytes <= 10485760
    $net.network.received_bytes < 4096
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1030")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
