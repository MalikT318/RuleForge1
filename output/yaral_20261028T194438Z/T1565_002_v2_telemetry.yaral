/*
  MITRE Technique : T1565.002 - Transmitted Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:41:06.695844+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_002_Root_Cert_Store_Registry_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry write that adds or changes a certificate in the Windows trusted Root certificate store (machine, user, or policy hive). Planting a rogue root CA is the prerequisite for TLS interception, which lets an adversary read and alter data in transit without certificate warnings. The rule pivots on the registry state change rather than command lines, so it still fires if the cert is installed through an API, a script, or a renamed tool."
    mitre_tactic = "Impact"
    mitre_technique = "T1565.002"
    mitre_technique_name = "Data Manipulation: Transmitted Data Manipulation"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon registry events, ID 12/13/14) normalised to UDM REGISTRY_MODIFICATION, with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy or MDM certificate deployment, enterprise PKI auto-enrolment, corporate TLS-inspection proxy or DLP agent installation, VPN and endpoint security client installers, developer tools that trust local dev CAs, Windows servicing processes."
    tuning_guidance = "Add approved deployment and PKI tooling to %global_allowed_admin_tools, EDR and security agents to %global_allowed_security_tools, and automation identities to %global_allowed_service_accounts. If Group Policy certificate delivery (svchost.exe hosting gpsvc) is noisy, add the process path to %global_allowed_admin_tools per client rather than editing the rule. Review the first week of hits to baseline the legitimate corporate root CA rollout."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SystemCertificates\\Root\\Certificates\\[0-9a-f]{40}/ nocase
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|MsMpEng|MsSense|SenseIR|WaaSMedic|TiWorker)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1565.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
