/*
  MITRE Technique : T1027.010 - Command Obfuscation
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:53:36.424606+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_010_Dropped_Script_Then_Obfuscated_Interpreter_Launch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A script file is written to a user-writable location and, within five minutes on the same host, a Windows script interpreter executes a script file with command-line obfuscation (caret insertion, environment-variable substring reassembly, backtick escaping, or long encoded payloads). The file-drop-then-obfuscated-execution chain is typical of phishing and drive-by payload staging."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.010"
    mitre_technique_name = "Obfuscated Files or Information: Command Obfuscation"
    log_prerequisites = "Requires Windows endpoint telemetry with both file-creation and process-launch events (EDR or Sysmon Event IDs 11 and 1)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate installers or software packaging tools that write temporary batch scripts and use caret escaping; admin automation that passes base64-encoded PowerShell payloads; login scripts distributed through temp folders; developer build tooling."
    tuning_guidance = "Add approved deployment and packaging tools to %global_allowed_admin_tools (file creator) and approved parent processes or hosts to %global_allowed_script_hosts. Raise the encoded-payload length threshold in the command-line regex if noisy. Extend the drop-location regex if clients stage scripts in other writable paths."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(appdata|temp|programdata|users\\public)\\([^\\]+\\)*[^\\]+\.(bat|cmd|vbs|vbe|js|jse|hta|ps1|wsf)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /\.(bat|cmd|vbs|vbe|js|jse|hta|ps1|wsf)\b/ nocase
    $proc.target.process.command_line = /(\w\^){4,}|(%[a-z0-9_]{1,20}:~-?[0-9]+(,-?[0-9]+)?%.*){2,}|(\w`){3,}|-(e|en|enc|enco|encod|encode|encoded|encodedcommand)\s+[a-z0-9+\/=]{40,}/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1027.010")
    $primary_entity = array_distinct($hostname)
    $dropped_scripts = array_distinct($file.target.file.full_path)
    $dropper_processes = array_distinct($file.principal.process.file.full_path)
    $obfuscated_command_lines = array_distinct($proc.target.process.command_line)
    $launch_count = count($proc.metadata.id)

  condition:
    $file and $proc
}
