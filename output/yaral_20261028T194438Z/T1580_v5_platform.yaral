/*
  MITRE Technique : T1580 - Cloud Infrastructure Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:58:29.691915+00:00
  Reference       : https://attack.mitre.org/techniques/T1580
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1580_Cloud_Infra_Discovery_API_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects control-plane API calls that enumerate compute, snapshot, volume, database, or storage resources (describe/list/head-bucket/public-access-block style operations) issued through programmatic clients (CLI, SDK, scripts) by an identity that is not an approved admin, service, scanner, or management source. Targets IaaS cloud audit telemetry only, with no endpoint fields."
    mitre_tactic = "Discovery"
    mitre_technique = "T1580"
    mitre_technique_name = "Cloud Infrastructure Discovery"
    log_prerequisites = "Cloud control-plane audit logs ingested and normalised to UDM with read/data-plane management events enabled (read-only API activity is often off by default). Requires metadata.product_event_type, principal.user.userid, and ideally network.http.user_agent."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Infrastructure-as-code pipelines and drift-detection jobs, cloud posture and asset-inventory tools, FinOps and cost-reporting scripts, monitoring agents, new administrators or developers exploring an account, and break-glass troubleshooting."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, named administrators to %global_allowed_admin_users, posture and inventory scanner sources to %global_allowed_scanners, and bastion or CI egress addresses to %global_allowed_mgmt_sources. If user-agent data is sparsely populated for a tenant, remove the user-agent condition and rely on the allowlists. Consider raising severity for identities that have never made these calls before."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /^(Describe(Instances|InstanceStatus|Snapshots|Volumes|Images|Vpcs|SecurityGroups|DBInstances|DBSnapshots)|ListBuckets|HeadBucket|GetPublicAccessBlock|ListFunctions|ListClusters)$|compute\.(instances|disks|snapshots|images)\.(list|aggregatedList)|storage\.buckets\.list|sql\.instances\.list|MICROSOFT\.COMPUTE\/(VIRTUALMACHINES|SNAPSHOTS|DISKS)\/READ|MICROSOFT\.STORAGE\/STORAGEACCOUNTS\/(READ|LISTKEYS\/ACTION)|MICROSOFT\.SQL\/SERVERS\/READ/ nocase
    $cloud.network.http.user_agent = /(cli|boto|sdk|python|powershell|curl|go-http|terraform|java)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.ip in %global_allowed_scanners
    not $cloud.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1580")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $source_ips = array_distinct($cloud.principal.ip)
    $api_calls = array_distinct($cloud.metadata.product_event_type)
    $user_agents = array_distinct($cloud.network.http.user_agent)

  condition:
    $cloud
}
