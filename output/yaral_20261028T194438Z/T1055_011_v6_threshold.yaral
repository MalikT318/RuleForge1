/*
  MITRE Technique : T1055.011 - Extra Window Memory Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:58:43.893618+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_011_EWM_Injection_Repeated_Shell_Process_Injection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated cross-process injection events from non-allowlisted processes into shell and GUI host processes (explorer, sihost, shell experience hosts) on a single host within 10 minutes. Extra Window Memory (EWM) injection works by writing code into shared sections of a GUI process, using SetWindowLong to place a pointer in the window's extra memory, and then triggering execution via a window message. Shell windows such as the taskbar are the classic target. One event can be benign, but repeated injection into the shell from the same host is anomalous."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.011"
    mitre_technique_name = "Process Injection: Extra Window Memory Injection"
    log_prerequisites = "Requires endpoint telemetry that emits cross-process injection events (remote thread creation, memory write, APC or window-message based injection) with populated principal and target process paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Accessibility and screen-reader software, input method editors, shell extensions and desktop customisation tools, application-whitelisting or DLP agents hooking explorer, remote support tools, and EDR/AV agents that are not yet in the allowlists."
    tuning_guidance = "Add security agents to %global_allowed_security_tools, approved IT and RMM tooling to %global_allowed_admin_tools, and remote support tooling to %global_allowed_remote_mgmt. Raise the #inj threshold on hosts running accessibility or desktop hooking software. Extend the target process regex if other GUI processes are commonly targeted in your environment."

  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.hostname = $host
    $inj.target.process.file.full_path = /\\(explorer|sihost|ShellExperienceHost|StartMenuExperienceHost)\.exe$/ nocase
    $inj.principal.process.file.full_path != ""
    $inj.principal.process.file.full_path != $inj.target.process.file.full_path
    not $inj.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|csrss|winlogon|wininit|dwm)\.exe$/ nocase
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.process.file.full_path in %global_allowed_remote_mgmt

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($inj.metadata.id)
    $injecting_processes = array_distinct($inj.principal.process.file.full_path)
    $target_processes = array_distinct($inj.target.process.file.full_path)
    $injecting_users = array_distinct($inj.principal.user.userid)
    $mitre_technique_id = array_distinct("T1055.011")
    $primary_entity = array_distinct($host)

  condition:
    #inj >= 3
}
