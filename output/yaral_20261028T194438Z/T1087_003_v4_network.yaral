/*
  MITRE Technique : T1087.003 - Email Account
  Tactic(s)       : Discovery
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:56:33.371658+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_003_Scripted_Client_Mailbox_Directory_Enumeration_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects HTTP requests from a scripting or programmatic client to mailbox directory endpoints (Exchange Web Services, OWA people-search actions, Offline Address Book downloads). These requests are how address lists (GAL) are harvested over the network from an authenticated session. Internal destinations are excluded through a reference list, so the rule targets externally reachable or cloud-hosted mail endpoints."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.003"
    mitre_technique_name = "Account Discovery: Email Account"
    log_prerequisites = "Requires web proxy, secure web gateway, or TLS-inspecting network telemetry normalised to NETWORK_HTTP with target.url and network.http.user_agent populated. Identity-provider sign-in logs are used for context and tuning, since the attributed principal.user.userid typically comes from proxy authentication or identity correlation."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Approved migration, backup, or archiving tools using EWS; helpdesk or admin scripts that query the directory; line-of-business apps with service accounts that resolve recipients; monitoring probes against mail endpoints."
    tuning_guidance = "Add expected automation accounts to %global_allowed_service_accounts. Add sanctioned scanners or testing sources to %global_allowed_scanners. Add known-good vendor destination hostnames to %global_allowed_domains. If on-premises Exchange is the primary mail platform and sits in internal address space, this rule will not see it because of the %rfc1918_internal exclusion. In that case, deploy a variant scoped with %global_allowed_mgmt_sources instead."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\/ews\/exchange\.asmx|\/owa\/service\.svc\?action=(findpeople|getpeoplefilters|findpersona|getpersona)|\/oab\/[^\/]+\/[^\/]*\.(lzx|xml)/ nocase
    $net.network.http.user_agent = /(powershell|python|curl|wget|go-http-client|okhttp|libwww|java\/|httpclient|axios|node-fetch)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1087.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $user = array_distinct($net.principal.user.userid)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
