/*
  MITRE Technique : T1564 - Hide Artifacts
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:11:56.312757+00:00
  Reference       : https://attack.mitre.org/techniques/T1564
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_002_Hidden_User_SpecialAccounts_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry write under the Winlogon SpecialAccounts\\UserList key. Setting a value here hides a local account from the logon screen and user selection UI. Attackers use it to conceal backdoor accounts. The rule fires on the resulting registry state change, so it still detects the activity if command-line logging is evaded or the tool is renamed."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.002"
    mitre_technique_name = "Hide Artifacts: Hidden Users"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon registry value-set events) normalised to UDM REGISTRY_MODIFICATION with target.registry.registry_key populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Kiosk or shared-workstation build scripts, VDI/golden image provisioning, enterprise software that creates hidden service or support accounts (some remote support and deployment agents), and administrators deliberately hiding break-glass accounts."
    tuning_guidance = "Add approved provisioning and deployment binaries to %global_allowed_admin_tools and trusted admin accounts to %global_allowed_admin_users. Clone this rule for REGISTRY_CREATION if the EDR reports first-time value creation as a separate event type. Review $hidden_account_name against known service accounts before closing."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\winlogon\\specialaccounts\\userlist/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1564.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $hidden_account_name = array_distinct($reg.target.registry.registry_value_name)
    $acting_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
