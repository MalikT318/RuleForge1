/*
  MITRE Technique : T1011.001 - Exfiltration Over Bluetooth
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:21:34.674961+00:00
  Reference       : https://attack.mitre.org/techniques/T1011/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1011_001_Bluetooth_File_Transfer_Initiated {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects launch of the native Windows Bluetooth File Transfer wizard, or a PowerShell session that invokes Bluetooth device and transfer APIs. Both are direct mechanisms for moving data off a host over a Bluetooth channel instead of the monitored network path."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1011.001"
    mitre_technique_name = "Exfiltration Over Other Network Medium: Exfiltration Over Bluetooth"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 / Windows Event 4688 with command-line auditing enabled. PowerShell command lines must be captured."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Users legitimately sending files to phones, headsets or peripherals; IT staff pairing or testing Bluetooth devices; helpdesk troubleshooting; developers using Bluetooth SDKs from PowerShell; kiosk or lab machines with approved Bluetooth workflows."
    tuning_guidance = "Add approved admin tooling or parent processes to %global_allowed_admin_tools and trusted accounts to %global_allowed_admin_users. On hosts where Bluetooth transfer is not permitted by policy, raise severity to High. Review the file-staging activity on the same host around the alert time to confirm data exfiltration."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $proc.target.process.file.full_path = /\\fsquirt\.exe$/ nocase or
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase and
        $proc.target.process.command_line = /(Windows\.Devices\.Bluetooth|Windows\.Devices\.Enumeration.{0,200}bluetooth|BluetoothDevice|BluetoothLEDevice|RfcommDeviceService|ObexFileTransfer|Windows\.Networking\.Proximity)/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1011.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $launched_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
