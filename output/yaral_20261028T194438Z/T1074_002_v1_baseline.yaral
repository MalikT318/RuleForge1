/*
  MITRE Technique : T1074.002 - Remote Data Staging
  Tactic(s)       : Collection
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:19:50.970530+00:00
  Reference       : https://attack.mitre.org/techniques/T1074/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_002_Large_Internal_SMB_WinRM_Transfer_Staging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a single large internal-to-internal flow over Windows file-sharing or remote management ports (SMB 445, WinRM 5985/5986). A host pushing a large volume of data to another internal host over these protocols is consistent with collected data being copied to a central staging system before exfiltration. The rule is network-observable only and cannot see which process or files were involved."
    mitre_tactic = "Collection"
    mitre_technique = "T1074.002"
    mitre_technique_name = "Data Staged: Remote Data Staging"
    log_prerequisites = "Requires firewall or perimeter/internal segmentation flow logs with session byte counts (network.sent_bytes) for east-west traffic, normalised to NETWORK_FLOW. Flow records should be emitted at session end or at regular intervals so that byte counts are populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Backup and imaging jobs, file server migrations and replication (DFS-R), software distribution and patch deployment, vulnerability scanners, user profile or home-drive synchronisation, and IT admins copying large images or ISOs between servers."
    tuning_guidance = "Add known backup, replication and deployment servers to %global_allowed_mgmt_sources and approved scanners to %global_allowed_scanners. Adjust the byte threshold (500 MB) to suit client baseline traffic volumes. Consider raising severity for destinations that are not file servers."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    ($net.target.port = 445 or $net.target.port = 5985 or $net.target.port = 5986)
    $net.network.sent_bytes > 524288000
    $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1074.002")
    $primary_entity = array_distinct($net.principal.ip)
    $staging_destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
