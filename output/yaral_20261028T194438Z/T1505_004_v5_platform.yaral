/*
  MITRE Technique : T1505.004 - IIS Components
  Tactic(s)       : Persistence
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:32:18.415679+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_004_IIS_Component_DLL_Written_To_Inetsrv {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a DLL being created inside an IIS inetsrv directory by a process that is not a trusted installer or approved admin tool. Native IIS modules and ISAPI extensions or filters are DLLs loaded by the IIS worker process, so a dropped DLL here is a common persistence step. This rule is file-creation based and complements process command-line rules. ATT&CK lists this technique for Windows only, so no Linux, macOS or cloud variant exists and the rule is written for Windows."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.004"
    mitre_technique_name = "Server Software Component: IIS Components"
    log_prerequisites = "Requires EDR or Sysmon-equivalent file creation telemetry (e.g. Sysmon Event ID 11) populating target.file.full_path and the writing process path on IIS servers."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IIS role or feature installation, Windows Update servicing, legitimate third-party IIS module installers (URL Rewrite, ARR, WAF or APM agents), authorised deployment pipelines."
    tuning_guidance = "Add approved installer or deployment binaries to %global_allowed_admin_tools. Add known IIS patching or deployment hosts to %global_allowed_script_hosts. Review the installer exclusion regex against client software baselines."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\inetsrv\\.*\.dll$/ nocase
    not $file.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|msiexec|wuauclt|usoclient|musnotification|MoUsoCoreWorker|TrustedInstaller)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1505.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_dll = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
