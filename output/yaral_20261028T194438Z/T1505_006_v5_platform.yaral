/*
  MITRE Technique : T1505.006 - vSphere Installation Bundles
  Tactic(s)       : Persistence
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:35:38.718525+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_006_ESXi_VIB_Acceptance_Level_Downgrade {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a host configuration change event on an ESXi hypervisor in which the VIB acceptance level is lowered to CommunitySupported or PartnerSupported, or in which an unsigned or forced VIB installation is recorded. Lowering the acceptance level is a prerequisite for installing an unsigned, persistent malicious vSphere Installation Bundle. This rule uses host configuration (SETTING_MODIFICATION) telemetry rather than process command-line matching, so it complements existing process-creation coverage and still fires when the change is made through the management API or a renamed client."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.006"
    mitre_technique_name = "Server Software Component: vSphere Installation Bundles"
    log_prerequisites = "ESXi hostd and esxupdate/configuration-change logs forwarded to Chronicle and parsed to SETTING_MODIFICATION with a populated metadata.description and principal.hostname. The log forwarding agent (syslog) must be configured on each ESXi host."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Planned installation of third-party driver, NIC, storage or backup agent VIBs by the virtualisation team; lab or test hosts deliberately set to CommunitySupported; lifecycle or patch-baseline tooling that temporarily changes the acceptance level during host remediation."
    tuning_guidance = "Add approved admin accounts to %global_allowed_admin_users and automation or lifecycle accounts to %global_allowed_service_accounts. Correlate hits with change-management tickets. Consider alerting at higher severity for production clusters where the acceptance level is expected to remain at PartnerSupported or higher."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    (
      $setting.metadata.description = /acceptance[\s_-]*(level|mode).{0,80}(community|partner)/ nocase or
      $setting.metadata.description = /(community|partner)[\s_-]*supported.{0,60}acceptance/ nocase or
      $setting.metadata.description = /vib.{0,80}(no-?sig(nature)?-?check|--force|force(d)?\s+install|community)/ nocase
    )
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1505.006")
    $primary_entity = array_distinct(strings.coalesce($setting.principal.hostname, $setting.target.hostname))
    $acting_user = array_distinct($setting.principal.user.userid)
    $source_ips = array_distinct($setting.principal.ip)
    $change_detail = array_distinct($setting.metadata.description)

  condition:
    $setting
}
