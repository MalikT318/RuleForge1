/*
  MITRE Technique : T1021.003 - Distributed Component Object Model
  Tactic(s)       : Lateral Movement
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:39:04.073184+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_003_DCOM_RPC_Endpoint_Mapper_From_Script_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a script host or LOLBin (PowerShell, WSH, mshta, rundll32, cmd, wmic and similar) opening a connection to TCP/135 (the RPC endpoint mapper) on another internal host. DCOM lateral movement starts with an RPC endpoint-mapper lookup before activating a remote COM object (for example MMC20.Application, ShellWindows or Excel.Application). Service processes such as svchost, lsass and mmc normally generate this traffic, so a scripting interpreter doing so is a strong indicator. This is a network-side detection and does not depend on command-line content."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.003"
    mitre_technique_name = "Remote Services: Distributed Component Object Model"
    log_prerequisites = "Requires endpoint network telemetry (EDR or Sysmon Event ID 3) that records the initiating process path for outbound connections."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin PowerShell scripts that use WMI/DCOM against remote hosts, RMM and patching tooling, inventory and monitoring scripts, vulnerability scanners and software deployment agents."
    tuning_guidance = "Internal address space is deliberately INCLUDED via %rfc1918_internal, because DCOM lateral movement is internal-to-internal; an exclusion would defeat the rule. Tune with: add approved tooling binaries to %global_allowed_admin_tools, jump hosts and scanner source IPs to %global_allowed_mgmt_sources, and named admin accounts to %global_allowed_admin_users. Widen the interpreter list only after baselining."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 135
    $net.target.ip in %rfc1918_internal
    $net.principal.ip != $net.target.ip
    $net.principal.process.file.full_path = /\\(powershell|pwsh|powershell_ise|cscript|wscript|mshta|rundll32|regsvr32|cmd|wmic|msiexec|installutil|regasm|regsvcs)\.exe$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1021.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $source_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
