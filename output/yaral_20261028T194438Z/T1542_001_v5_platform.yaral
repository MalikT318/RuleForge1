/*
  MITRE Technique : T1542.001 - System Firmware
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:43:14.635038+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_001_NetDevice_External_TFTP_Firmware_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a TFTP session (port 69) crossing the network perimeter to a non-internal destination from a source that is not an approved management address. Network devices commonly load firmware and boot images over TFTP, so an unapproved device or host pulling or pushing an image to an external TFTP server is a network-observable sign of firmware or system image tampering. TFTP is unauthenticated and unencrypted and should never cross the perimeter in normal operations."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.001"
    mitre_technique_name = "Pre-OS Boot: System Firmware"
    log_prerequisites = "Firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Network device management interfaces must egress through the logging perimeter."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised firmware upgrades fetched from a vendor-hosted or cloud-hosted TFTP server, zero-touch provisioning of new devices at remote sites, and lab or staging devices that use TFTP for config and image backup. Approved scanners may also probe UDP 69."
    tuning_guidance = "Add approved network management and jump host source addresses to %global_allowed_mgmt_sources. Add known vendor update domains to %global_allowed_domains. Add authorised vulnerability scanners to %global_allowed_scanners. Where TFTP is never expected across the perimeter, keep this rule at High severity and route it to the network engineering on-call."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1542.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
