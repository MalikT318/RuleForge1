/*
  MITRE Technique : T1218.009 - Regsvcs/Regasm
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:53:29.404395+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_009_Regsvcs_Regasm_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects regsvcs.exe or regasm.exe, which are local .NET COM registration utilities, initiating a network connection to a non-internal address. These binaries have no legitimate need to reach external hosts, so outbound traffic strongly suggests proxy execution of attacker code that is performing command and control or payload retrieval."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.009"
    mitre_technique_name = "System Binary Proxy Execution: Regsvcs/Regasm"
    log_prerequisites = "Requires endpoint network telemetry (for example Sysmon Event ID 3 or EDR network events) that populates principal.process.file.full_path and target.ip."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare. Developer or build workstations registering .NET assemblies that trigger remote lookups (for example certificate revocation checks on signed assemblies), software installers that call regasm during setup and fetch resources, and authorised red team exercises."
    tuning_guidance = "Add approved software deployment or installer parent tooling to %global_allowed_admin_tools, security agents to %global_allowed_security_tools, and authorised testing sources to %global_allowed_scanners. Consider a hostname exclusion for developer build servers if CRL traffic is noisy."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(regsvcs|regasm)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1218.009")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
