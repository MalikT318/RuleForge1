/*
  MITRE Technique : T1201 - Password Policy Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:52:04.386544+00:00
  Reference       : https://attack.mitre.org/techniques/T1201
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1201_Linux_Password_Policy_Read_Then_Credential_Store_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a non-standard process reading Linux password policy configuration (login.defs, PAM password modules, pwquality/faillock settings) and then reading the local credential stores (/etc/shadow, /etc/gshadow, /etc/security/opasswd) on the same host within 10 minutes. This file-access sequence, seen through auditd or EDR file-read telemetry, indicates the adversary is learning the password policy and then preparing offline cracking or guessing attacks. It is independent of process command-line matching."
    mitre_tactic = "Discovery"
    mitre_technique = "T1201"
    mitre_technique_name = "Password Policy Discovery"
    log_prerequisites = "Requires Linux auditd file watches (-w on /etc/login.defs, /etc/pam.d/, /etc/security/, /etc/shadow with -p r) or EDR file-read telemetry normalised to UDM FILE_READ with principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management agents (Ansible, Puppet, Chef, Salt), compliance and hardening scanners (CIS benchmark, OpenSCAP, Lynis), backup agents, identity agents (SSSD, realmd) and admins auditing password settings by hand."
    tuning_guidance = "Add approved config-management, compliance and scanning binaries to %global_allowed_admin_tools or %global_allowed_security_tools, service accounts to %global_allowed_service_accounts, and backup tooling to %global_allowed_backup_processes. Extend the process-name exclusion regexes with any local PAM or identity helpers that read these files legitimately."

  events:
    $policy.metadata.event_type = "FILE_READ"
    $policy.target.file.full_path = /^\/etc\/(login\.defs|pam\.d\/(common-password|system-auth|password-auth|passwd)|security\/(pwquality\.conf|pwhistory\.conf|faillock\.conf)|pam_pwquality\.conf)$/
    not $policy.principal.process.file.full_path = /\/(sshd|login|su|sudo|passwd|chpasswd|chage|useradd|usermod|userdel|groupadd|unix_chkpwd|systemd|systemd-logind|cron|crond|polkitd|gdm|lightdm|sssd|dpkg|apt|apt-get|rpm|yum|dnf)$/
    not $policy.principal.process.file.full_path in %global_allowed_admin_tools
    not $policy.principal.process.file.full_path in %global_allowed_security_tools
    not $policy.principal.process.file.full_path in %global_allowed_backup_processes
    not $policy.principal.user.userid in %global_allowed_service_accounts
    $policy.principal.hostname = $hostname

    $cred.metadata.event_type = "FILE_READ"
    $cred.target.file.full_path = /^\/etc\/(shadow|gshadow|security\/opasswd)$/
    not $cred.principal.process.file.full_path = /\/(sshd|login|su|sudo|passwd|chpasswd|chage|useradd|usermod|userdel|groupadd|unix_chkpwd|systemd|systemd-logind|cron|crond|polkitd|gdm|lightdm|sssd|dpkg|apt|apt-get|rpm|yum|dnf|vipw|pwck|grpck)$/
    not $cred.principal.process.file.full_path in %global_allowed_admin_tools
    not $cred.principal.process.file.full_path in %global_allowed_security_tools
    not $cred.principal.process.file.full_path in %global_allowed_backup_processes
    not $cred.principal.user.userid in %global_allowed_service_accounts
    $cred.principal.hostname = $hostname

    $policy.metadata.event_timestamp.seconds <= $cred.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1201")
    $primary_entity = array_distinct($hostname)
    $policy_files_read = array_distinct($policy.target.file.full_path)
    $policy_processes = array_distinct($policy.principal.process.file.full_path)
    $credential_files_read = array_distinct($cred.target.file.full_path)
    $credential_processes = array_distinct($cred.principal.process.file.full_path)
    $users = array_distinct($cred.principal.user.userid)
    $policy_read_count = count($policy.metadata.id)

  condition:
    $policy and $cred
}
