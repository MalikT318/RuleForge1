/*
  MITRE Technique : T1566.002 - Spearphishing Link
  Tactic(s)       : Initial Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:49:21.729350+00:00
  Reference       : https://attack.mitre.org/techniques/T1566/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1566_002_Identity_Scripted_Client_Signin_After_Phish {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a user sign-in at the identity provider whose HTTP user-agent is a scripting or HTTP-library client rather than a browser or native sign-in client. After a spearphishing link, adversary-in-the-middle phishing kits and credential-replay tooling commonly replay harvested credentials or session material with such clients. This is identity-plane coverage for Windows-user accounts and does not depend on endpoint process telemetry."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1566.002"
    mitre_technique_name = "Phishing: Spearphishing Link"
    log_prerequisites = "Requires identity provider sign-in logs normalised to UDM USER_LOGIN with network.http.user_agent populated."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Approved automation or monitoring that signs in with scripted HTTP clients, developer or admin scripts using the identity API, synthetic-transaction probes, and legacy line-of-business integrations."
    tuning_guidance = "Add automation and integration accounts to %global_allowed_service_accounts and named admin accounts to %global_allowed_admin_users. Extend or narrow the user-agent regex to match client-specific scripted-access patterns. Consider raising severity if the sign-in follows a recent email-security alert for the same user."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.network.http.user_agent = /(python-requests|python-urllib|aiohttp|httpx|axios|node-fetch|go-http-client|okhttp|libwww-perl|java\/[0-9]|curl\/|wget\/)/ nocase
    $auth.target.user.userid != ""
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1566.002")
    $primary_entity = array_distinct($auth.target.user.userid)
    $source_ips = array_distinct($auth.principal.ip)
    $user_agents = array_distinct($auth.network.http.user_agent)

  condition:
    $auth
}
