/*
  MITRE Technique : T1601.002 - Downgrade System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:15:19.037508+00:00
  Reference       : https://attack.mitre.org/techniques/T1601/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_002_Network_Device_Image_Fetch_Via_TFTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects TFTP (port 69) connections crossing the network perimeter to a non-internal destination that is not an approved management or image-repository source. Network devices commonly fetch OS or firmware images over TFTP. When the server is external and unapproved, this is a network-observable precursor to a system image downgrade or replacement. Firewall logs cannot show the image version, so this rule detects the staging of the image, not the version change itself."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1601.002"
    mitre_technique_name = "Modify System Image: Downgrade System Image"
    log_prerequisites = "Firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Egress TFTP traffic from the management network must traverse a logging enforcement point."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Network engineers performing sanctioned firmware upgrades from a vendor-hosted or cloud-hosted TFTP server, managed service providers staging device images, zero-touch provisioning of new branch devices, and legacy PXE or provisioning workflows that cross the perimeter."
    tuning_guidance = "Add approved external image repositories and provisioning servers to %global_allowed_mgmt_sources. Exclude vulnerability and testing sources via %global_allowed_scanners. Correlate hits with device configuration-change tickets. A hit outside a change window should be escalated to the network team to verify the device boot image and version."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1601.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
