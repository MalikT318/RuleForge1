/*
  MITRE Technique : T1008 - Fallback Channels
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:16:06.576223+00:00
  Reference       : https://attack.mitre.org/techniques/T1008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1008_Linux_Outbound_Alternate_Port_Channel {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound TCP connections from internal hosts to external addresses on ports commonly used for alternate or fallback C2 channels. These include DNS-over-TCP to non-internal resolvers, SOCKS proxy and Tor relay/directory ports. Implants fall back to such channels when the primary channel is blocked. Observed from the network perimeter, so it works regardless of the endpoint agent."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1008"
    mitre_technique_name = "Fallback Channels"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with direction, protocol, source IP and destination IP/port populated. Perimeter logs carry no process context."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Servers configured to use external DNS resolvers over TCP (large responses, DNSSEC, zone transfers), approved Tor or SOCKS proxy use by researchers, developer or CI hosts using SOCKS tunnels, and vulnerability scanners probing these ports."
    tuning_guidance = "Add approved scanners to %global_allowed_scanners, approved management or egress source addresses to %global_allowed_mgmt_sources, and approved remote tooling hosts to %global_allowed_remote_mgmt. Add known-good destination domains to %global_allowed_domains. Scope the rule to Linux server subnets or asset groups per client in the Chronicle rule scope. Review the port set against each client's baseline."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.direction = "OUTBOUND"
    $net.network.ip_protocol = "TCP"
    (
      $net.target.port = 53 or
      $net.target.port = 1080 or
      $net.target.port = 9001 or
      $net.target.port = 9030 or
      $net.target.port = 9050
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_remote_mgmt
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1008")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
