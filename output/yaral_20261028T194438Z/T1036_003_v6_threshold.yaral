/*
  MITRE Technique : T1036.003 - Rename Legitimate Utilities
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:01:49.853454+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_003_Burst_Executable_Copies_To_Writable_Paths {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several executable files are written into user-writable or staging directories by a shell or file-copy utility on one host within ten minutes. This is the file-creation side of renaming or copying legitimate system utilities (for example, a copied rundll32 or PsExec-style binary under a new name) so that path- or name-based detections miss them. A single copy is benign; a burst is not."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.003"
    mitre_technique_name = "Masquerading: Rename Legitimate Utilities"
    log_prerequisites = "Requires EDR or Sysmon-equivalent file-creation telemetry (Sysmon Event ID 11 or equivalent) with the creating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters unpacking executables to ProgramData or temp folders, developer build output, RMM or deployment scripts staging binaries, portable-application extraction by administrators, and user profile migrations."
    tuning_guidance = "Add approved deployment and RMM tooling to %global_allowed_admin_tools, and hosts or parents permitted to run scripts (build servers, packaging hosts) to %global_allowed_script_hosts. Raise the #file threshold for developer-heavy estates, or narrow the directory regex to the staging locations seen in the client environment."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(cmd|powershell|pwsh|xcopy|robocopy)\.exe$/ nocase
    $file.target.file.full_path = /\.exe$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents|music|pictures|videos)|users\\public|programdata|windows\\temp|perflogs|temp)\\/ nocase
    not $file.target.file.full_path = /\\(windowsapps|microsoft\\edge|microsoft\\teams|google\\chrome)\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.hostname in %global_allowed_script_hosts
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1036.003")
    $primary_entity = array_distinct($host)
    $created_files = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
