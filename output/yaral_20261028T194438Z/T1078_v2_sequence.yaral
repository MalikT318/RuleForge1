/*
  MITRE Technique : T1078 - Valid Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:27:19.186455+00:00
  Reference       : https://attack.mitre.org/techniques/T1078
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_IaaS_Login_Then_Privilege_Grant {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A successful sign-in from an external address is followed within one hour by a privilege or role change performed by the same identity. The role target must look privileged (admin, owner, contributor and similar). This pattern is typical of a compromised valid account being used to escalate privileges or establish persistence in a cloud environment."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078"
    mitre_technique_name = "Valid Accounts"
    log_prerequisites = "Requires identity provider or cloud IAM sign-in logs normalised to USER_LOGIN, and directory or IAM audit logs normalised to USER_CHANGE_PERMISSIONS, with principal.user.userid populated on both."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Administrators legitimately signing in remotely (VPN, home, travel) and then granting roles; onboarding and offboarding workflows; just-in-time privileged access elevation; break-glass procedures."
    tuning_guidance = "Add named administrators to %global_allowed_admin_users, automation identities to %global_allowed_service_accounts, and approved cloud service principals to %global_allowed_cloud_principals. Add corporate egress addresses to %rfc1918_internal if the tenant treats them as internal. Narrow or widen the privileged-role regex on target.resource.name to match the tenant's role naming."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid != ""
    not $auth.principal.ip in %rfc1918_internal
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users
    $auth.principal.user.userid = $user

    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.target.resource.name = /(admin|owner|contributor|privileged|root|poweruser|security)/ nocase
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_cloud_principals
    $perm.principal.user.userid = $user

    $auth.metadata.event_timestamp.seconds <= $perm.metadata.event_timestamp.seconds

  match:
    $user over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1078")
    $primary_entity = array_distinct($user)
    $source_ips = array_distinct($auth.principal.ip)
    $privileged_targets = array_distinct($perm.target.resource.name)
    $login_count = count($auth.metadata.id)
    $permission_change_count = count($perm.metadata.id)

  condition:
    $auth and $perm
}
