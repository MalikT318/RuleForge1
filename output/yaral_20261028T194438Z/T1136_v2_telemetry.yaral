/*
  MITRE Technique : T1136 - Create Account
  Tactic(s)       : Persistence
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:05:51.438310+00:00
  Reference       : https://attack.mitre.org/techniques/T1136
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_001_Direct_SAM_Registry_Account_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a local account key under the SAM hive (SAM\\Domains\\Account\\Users\\Names) by a process other than the Local Security Authority or service host. Legitimate account creation through net.exe, PowerShell or the Windows UI is written by lsass.exe through the SAM service. A different process writing this key indicates direct SAM manipulation, a technique used to create hidden or backdoor local accounts that evade command-line and Security 4720 auditing. This detects the registry state change rather than the command line."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136.001"
    mitre_technique_name = "Create Account: Local Account"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon registry events, event IDs 12/13) with the HKLM\\SAM\\SAM hive included in monitoring scope. Many EDR products and default Sysmon configurations do not cover this hive, so confirm coverage before relying on the rule."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Offline or in-place identity migration tools, imaging and sysprep workflows, third-party local account management or password-vault agents that write to the SAM directly, and security tooling that restores the SAM hive."
    tuning_guidance = "Add approved account-management or migration tooling to %global_allowed_admin_tools and endpoint security agents to %global_allowed_security_tools. Confirm that lsass.exe is the only expected writer in your EDR telemetry. If a client's sensor reports lsass as the actor for all SAM writes, this rule fires only on out-of-band changes by design."

  events:
    $reg.metadata.event_type = "REGISTRY_CREATION"
    $reg.target.registry.registry_key = /\\SAM\\SAM\\Domains\\Account\\Users\\Names\\[^\\]+/ nocase
    not $reg.principal.process.file.full_path = /\\(lsass|services|smss|wininit)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1136.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $writer_user = array_distinct($reg.principal.user.userid)
    $sam_key = array_distinct($reg.target.registry.registry_key)

  condition:
    $reg
}
