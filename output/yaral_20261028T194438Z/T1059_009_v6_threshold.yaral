/*
  MITRE Technique : T1059.009 - Cloud API
  Tactic(s)       : Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Command and Scripting Interpreter
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:20:11.345185+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_009_Cloud_API_Burst_IAM_Permission_Changes {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single cloud identity performs a burst of IAM permission changes through the control-plane API within 10 minutes. Each change is benign alone. A burst of grants, role attachments or policy edits from one principal is consistent with scripted API abuse through a CLI, SDK or cloud shell to escalate privileges or establish access."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.009"
    mitre_technique_name = "Command and Scripting Interpreter: Cloud API"
    log_prerequisites = "Requires cloud control-plane audit logs (IAM and directory change events) ingested and normalised to UDM USER_CHANGE_PERMISSIONS with principal.user.userid populated."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Infrastructure-as-code pipelines applying IAM changes, onboarding or offboarding automation, identity governance tooling, bulk role migrations, and administrators performing planned access reviews."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named administrators to %global_allowed_admin_users. The threshold is conservative at 5 events in 10m; raise it for tenants with heavy provisioning automation."

  events:
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.principal.user.userid != ""
    $perm.principal.user.userid = $user
    not $perm.principal.user.userid in %global_allowed_cloud_principals
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($perm.metadata.id)
    $mitre_technique_id = array_distinct("T1059.009")
    $primary_entity = array_distinct($user)
    $source_ips = array_distinct($perm.principal.ip)
    $affected_targets = array_distinct($perm.target.user.userid)
    $user_agents = array_distinct($perm.network.http.user_agent)

  condition:
    #perm >= 5
}
