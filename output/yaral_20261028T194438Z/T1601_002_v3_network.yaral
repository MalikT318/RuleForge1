/*
  MITRE Technique : T1601.002 - Downgrade System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:14:44.910395+00:00
  Reference       : https://attack.mitre.org/techniques/T1601/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_002_Perimeter_TFTP_FTP_Image_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a perimeter-observed TFTP (UDP/69) or FTP control (TCP/21) connection from an internal source to an external destination. Network devices typically fetch replacement operating system images over these protocols when an adversary stages an older image to downgrade the device. Both are rarely legitimate across the internet boundary, and the cleartext transfer offers no integrity protection."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1601.002"
    mitre_technique_name = "Modify System Image: Downgrade System Image"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated, covering the egress path of network device management interfaces."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legacy file-transfer workflows to external vendors, approved firmware or configuration pulls from vendor-hosted TFTP/FTP servers during planned maintenance, backup jobs for device configurations, and vulnerability scanners probing port 21 or 69."
    tuning_guidance = "Add approved management or update source addresses to %global_allowed_mgmt_sources, authorised scanners to %global_allowed_scanners, and known-good vendor destinations to %global_allowed_domains. Correlate hits against change windows and device inventory, and prioritise sources that are network device management addresses."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 69 or $net.target.port = 21)
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1601.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
