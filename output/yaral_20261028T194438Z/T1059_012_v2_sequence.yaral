/*
  MITRE Technique : T1059.012 - Hypervisor CLI
  Tactic(s)       : Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:24:03.425798+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_012_ESXi_Shell_Login_Then_Host_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an interactive SSH or shell login to an ESXi host from a source outside the approved management addresses, followed within five minutes by a host configuration change on the same host. The changes covered are syslog forwarding, firewall rulesets, lockdown mode, shell/SSH service policy and timeouts. This is the typical pattern of an adversary using the hypervisor CLI to weaken logging and access controls. It is additive to command-line rules because it correlates authentication with a setting-change event rather than matching process arguments."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.012"
    mitre_technique_name = "Command and Scripting Interpreter: Hypervisor CLI"
    log_prerequisites = "ESXi hostd, shell and auth logs forwarded via syslog and parsed to UDM, with USER_LOGIN and SETTING_MODIFICATION events populated. The login source IP and the ESXi hostname must be present."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators performing planned maintenance over SSH, such as enabling syslog forwarding, adjusting firewall rulesets or changing shell timeouts. Host profile or automation remediation, patching and build pipelines, and monitoring or configuration-management agents that log in and change settings."
    tuning_guidance = "Add jump hosts, bastions and admin workstation IPs to %global_allowed_mgmt_sources. Add automation identities to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. If the parser puts the ESXi hostname in target.hostname for login events, adjust the login-side join field accordingly. Narrow the target.resource.name regex per client if routine change windows are noisy."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.target.application = /(ssh|shell)/ nocase
    not $login.principal.ip in %global_allowed_mgmt_sources
    not $login.target.user.userid in %global_allowed_service_accounts
    not $login.target.user.userid in %global_allowed_admin_users
    $login.principal.hostname = $host

    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.target.resource.name = /(syslog|loghost|firewall|ruleset|lockdown|shelltimeout|esxishell|dcuitimeout|sshd|tsm|execinstalledonly)/ nocase
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_admin_users
    $setting.principal.hostname = $host

    $login.metadata.event_timestamp.seconds <= $setting.metadata.event_timestamp.seconds

  match:
    $host over 5m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1059.012")
    $primary_entity = array_distinct($host)
    $login_users = array_distinct($login.target.user.userid)
    $login_source_ips = array_distinct($login.principal.ip)
    $changed_settings = array_distinct($setting.target.resource.name)
    $setting_count = count($setting.metadata.id)

  condition:
    $login and $setting
}
