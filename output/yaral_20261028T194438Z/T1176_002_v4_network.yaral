/*
  MITRE Technique : T1176.002 - IDE Extensions
  Tactic(s)       : Persistence
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:29:30.335539+00:00
  Reference       : https://attack.mitre.org/techniques/T1176/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_002_IDE_Extension_Package_Download_Untrusted_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP request for an IDE extension package (.vsix or marketplace package-download path) sent to an external host that is not in the known-good domain list. This is the network-side signature of an extension being side-loaded or pulled from an untrusted source, which an adversary can use to persist inside the IDE. Detection depends on the request and destination, not on the initiating process."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176.002"
    mitre_technique_name = "Software Extensions: IDE Extensions"
    log_prerequisites = "Requires proxy or firewall logs with URL visibility (TLS inspection or explicit proxy) that populate target.url and target.hostname as NETWORK_HTTP events."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Developers installing extensions from private or internal artifact mirrors, third-party extension registries or vendor download sites not yet in the allowlist, and CI/build agents fetching packaged extensions."
    tuning_guidance = "Add legitimate marketplace, mirror and vendor distribution domains to %global_allowed_domains. Internal destinations are excluded via %rfc1918_internal. If volume is high, scope the rule to developer subnets at the SIEM or tenant level."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /(\.vsix([?#]|$)|\/vspackage([\/?]|$)|\/_apis\/public\/gallery\/publishers\/[^\/]+\/vsextensions)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1176.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
