/*
  MITRE Technique : T1056.004 - Credential API Hooking
  Tactic(s)       : Collection, Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:52:09.323283+00:00
  Reference       : https://attack.mitre.org/techniques/T1056/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1056_004_Linux_Shared_Object_Drop_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Several shared-object (.so) files are created within ten minutes on one Linux host, either in world-writable locations (/tmp, /var/tmp, /dev/shm) or in PAM security module directories. Adversaries stage hook libraries in these places for LD_PRELOAD interposition of libc/libpam credential functions, or for malicious PAM modules. One file creation is routine, but repeated drops in these locations are a strong sign of credential API hooking. This rule is file-creation based and complements process command-line detections."
    mitre_tactic = "Collection, Credential Access"
    mitre_technique = "T1056.004"
    mitre_technique_name = "Input Capture: Credential API Hooking"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry that populates target.file.full_path and principal.process.file.full_path, normalised to UDM FILE_CREATION."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers or configuration management installing PAM modules or libraries, software installers and self-extracting applications that unpack .so files to /tmp, build and CI hosts compiling shared libraries, language runtimes (JVM, Python, Node native addons) extracting native libraries to temp directories."
    tuning_guidance = "Add approved deployment and build tooling to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Add automation account identifiers to %global_allowed_service_accounts. Raise the threshold (#file >= 3) on build or CI hosts, or move them to a separate rule scope. Package managers are excluded by executable name in the rule."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/(tmp|var\/tmp|dev\/shm)\/.*|\/(usr\/)?lib[^\/]*\/(.*\/)?security\/[^\/]*)\.so(\.[0-9]+)*$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|yum|dnf|zypper|pacman|snapd|unattended-upgrade)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(re.regex($file.target.file.full_path, /(?i)\/security\/[^\/]*\.so/), 85, 65))
    $event_count = count($file.metadata.id)
    $dropped_paths = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)
    $mitre_technique_id = array_distinct("T1056.004")
    $primary_entity = array_distinct($host)

  condition:
    #file >= 3
}
