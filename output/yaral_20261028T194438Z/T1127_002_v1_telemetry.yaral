/*
  MITRE Technique : T1127.002 - ClickOnce
  Tactic(s)       : Stealth, Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:38:28.284951+00:00
  Reference       : https://attack.mitre.org/techniques/T1127/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1127_002_ClickOnce_Payload_Written_To_AppCache {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects the ClickOnce deployment service (dfsvc.exe) writing an executable or library (.exe/.dll) into the per-user ClickOnce application cache (AppData\\Local\\Apps\\2.0). This is the file artifact left when a ClickOnce application is installed, whether it was launched from a web page, an .appref-ms or .application file, or via dfshim. It does not depend on command-line logging, so it still fires when the launch method is obfuscated or the command line is hidden."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1127.002"
    mitre_technique_name = "Trusted Developer Utilities Proxy Execution: ClickOnce"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon Event ID 11) that populates the writing process path and target file path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate ClickOnce line-of-business applications (internal tools, vendor-delivered .NET apps, Visual Studio or Office add-ins deployed via ClickOnce) and their automatic updates. Expect a high volume in environments that distribute internal software this way."
    tuning_guidance = "Add accounts of known ClickOnce deployment or test users to %global_allowed_admin_users. Add approved deployment tooling to %global_allowed_admin_tools. Where a fleet relies on ClickOnce, correlate with the originating download source or raise the severity only for non-managed hosts."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\dfsvc\.exe$/ nocase
    $file.target.file.full_path = /\\AppData\\Local\\Apps\\2\.0\\.+\.(exe|dll)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1127.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_files = array_distinct($file.target.file.full_path)
    $affected_users = array_distinct($file.principal.user.userid)

  condition:
    $file
}
