/*
  MITRE Technique : T1078.002 - Domain Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:32:08.106220+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_002_Domain_Account_High_Volume_Logons {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single domain account produces an unusually high number of successful logon events within one hour. Each logon is benign on its own, but the volume suggests credential reuse, automated lateral movement or a stolen domain credential being used across many systems."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.002"
    mitre_technique_name = "Valid Accounts: Domain Accounts"
    log_prerequisites = "Requires Windows Security logon events (4624) or equivalent EDR authentication telemetry normalised to USER_LOGIN with target.user.userid populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Helpdesk and IT admins working across many servers, file or print servers with heavy network logon traffic, monitoring and inventory accounts, batch jobs, shared jump hosts, and terminal servers with many sessions."
    tuning_guidance = "Add service and automation accounts to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Raise the #auth threshold on high-traffic servers or lower it for high-security tenants. Review the distinct_target_hosts outcome to separate fan-out across many hosts from repeated logons to one host."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.user.userid = $user
    $auth.target.user.userid != ""
    $auth.target.hostname != ""
    not $auth.target.user.userid = /\$$/
    not $auth.target.user.userid = /^(system|local service|network service|anonymous logon|dwm-\d+|umfd-\d+)$/ nocase
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users

  match:
    $user over 1h

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1078.002")
    $primary_entity = array_distinct($user)
    $logon_count = count($auth.metadata.id)
    $distinct_target_hosts = array_distinct($auth.target.hostname)
    $source_hosts = array_distinct($auth.principal.hostname)

  condition:
    #auth >= 30
}
