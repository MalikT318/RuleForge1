/*
  MITRE Technique : T1110.003 - Password Spraying
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:07:23.451681+00:00
  Reference       : https://attack.mitre.org/techniques/T1110/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1110_003_Inbound_Mgmt_Port_Short_Auth_Session {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an inbound connection from an external source to a common management or authentication service port (SSH, Telnet, FTP, SMB, RDP, VNC, database listeners) that carries only a small number of bytes in each direction. That profile matches a single failed or aborted login attempt, the per-attempt footprint of password spraying seen from the network perimeter. Legitimate administrative sessions normally transfer far more data. Each alert is one attempt, so analysts should pivot on the source address to confirm a spray pattern across many destinations."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1110.003"
    mitre_technique_name = "Brute Force: Password Spraying"
    log_prerequisites = "Firewall or perimeter logs normalised to NETWORK_CONNECTION with network.direction, principal.ip, target.ip, target.port, and ideally network.sent_bytes and network.received_bytes populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Internet-facing management services probed by benign monitoring or uptime checks, partner or vendor remote-support sessions that are briefly interrupted, external vulnerability scanners not yet allow-listed, port-open health checks from load balancers or cloud monitors, and noisy internet background scanning of exposed services."
    tuning_guidance = "Add authorised scanner sources to %global_allowed_scanners and trusted external management sources to %global_allowed_mgmt_sources. Populate %rfc1918_internal for the tenant's address space. Adjust the byte thresholds to the firewall's byte-count semantics; where byte counters are not populated the value is 0 and the filter passes, so the rule becomes a plain external-to-management-port detection. Pair this with a host-level threshold rule on the same source, or route alerts to a SOAR step that counts distinct destinations per source, to cut noise from one-off probes."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.direction = "INBOUND"
    (
      $net.target.port = 22 or
      $net.target.port = 21 or
      $net.target.port = 23 or
      $net.target.port = 445 or
      $net.target.port = 3389 or
      $net.target.port = 5900 or
      $net.target.port = 1433 or
      $net.target.port = 1521 or
      $net.target.port = 3306
    )
    $net.network.sent_bytes < 5000
    $net.network.received_bytes < 5000
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1110.003")
    $primary_entity = array_distinct($net.principal.ip)
    $targeted_hosts = array_distinct($net.target.ip)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    $net
}
