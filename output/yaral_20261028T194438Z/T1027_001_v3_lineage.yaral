/*
  MITRE Technique : T1027.001 - Binary Padding
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:38:22.315999+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_001_Linux_Service_Parent_Spawns_Padding_Utility {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server or database service process spawning a file-padding utility (dd, truncate, fallocate, head, yes) with padding semantics such as appending zero or random data, extending a file by a relative size, or writing in non-truncating mode. These services have no legitimate reason to enlarge binaries, so this lineage anomaly indicates a compromised service (web shell, SQL injection to command execution) padding a payload to change its on-disk size and checksum and evade hash-based or size-limited scanning."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.001"
    mitre_technique_name = "Obfuscated Files or Information: Binary Padding"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records normalised to UDM PROCESS_LAUNCH with populated parent (principal.process) and child (target.process) paths and the child command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Application health or maintenance scripts launched by a service that use dd or truncate for log rotation or cache pre-allocation, database engines pre-allocating or truncating data files via helper scripts (for example PostgreSQL archive_command or MySQL backup hooks), Java-based build or CI agents that shell out to dd or fallocate."
    tuning_guidance = "Add legitimate parent binaries (for example a backup wrapper launched by a database service) to %global_allowed_script_hosts and approved maintenance tooling to %global_allowed_admin_tools. If the java or node parent generates noise on build or CI hosts, add those parents to %global_allowed_script_hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9.]*|php-cgi|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server)$/ nocase
    $proc.target.process.file.full_path = /\/(dd|truncate|fallocate|head|yes)$/ nocase
    $proc.target.process.command_line = /(\/dev\/(zero|urandom|random)|conv=[a-z,]*notrunc|oflag=[a-z,]*append|(-s|--size)[= ]*\+[0-9]+|\byes\b.*>>)/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1027.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
