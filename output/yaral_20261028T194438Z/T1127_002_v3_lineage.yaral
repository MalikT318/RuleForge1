/*
  MITRE Technique : T1127.002 - ClickOnce
  Tactic(s)       : Stealth, Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:38:58.533563+00:00
  Reference       : https://attack.mitre.org/techniques/T1127/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1127_002_ClickOnce_Dfsvc_Spawns_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the ClickOnce deployment host (dfsvc.exe) spawning a shell, script interpreter or proxy-execution LOLBin. Dfsvc normally launches only the deployed .NET application. When it spawns an interpreter or LOLBin, a ClickOnce package is likely proxying malicious execution through a trusted Windows component. The rule is lineage-based and does not depend on command-line content."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1127.002"
    mitre_technique_name = "Trusted Developer Utilities Proxy Execution: ClickOnce"
    log_prerequisites = "Requires Windows EDR process telemetry or Sysmon Event ID 1 / Security Event 4688 with parent process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate line-of-business ClickOnce applications that shell out to cmd.exe or PowerShell during install, update or startup; internal developer tools published through ClickOnce; IT-deployed ClickOnce utilities that run helper scripts."
    tuning_guidance = "Add hosts that legitimately run such ClickOnce apps (for example developer or IT workstations) to %global_allowed_script_hosts. Add named administrator accounts to %global_allowed_admin_users. Add approved deployment tooling to %global_allowed_admin_tools. Review the child command line in the outcome fields before excluding anything."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\dfsvc\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|powershell_ise|pwsh|wscript|cscript|mshta|rundll32|regsvr32|msbuild|installutil|regasm|regsvcs|certutil|bitsadmin|wmic|forfiles|pcalua)\.exe$/ nocase
    not $proc.principal.hostname in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1127.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
