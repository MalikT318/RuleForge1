/*
  MITRE Technique : T1039 - Data from Network Shared Drive
  Tactic(s)       : Collection
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:25:08.166241+00:00
  Reference       : https://attack.mitre.org/techniques/T1039
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1039_Linux_Service_Parent_Spawns_Shell_Network_Share_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server, database or print service process spawning a shell or script interpreter whose command line uses a collection utility against a network share (SMB/CIFS/NFS mount points, UNC-style paths, or share-mounting commands). Service daemons do not normally browse or copy from network shares via a shell, so this lineage suggests a web shell or exploited service staging data from a file server."
    mitre_tactic = "Collection"
    mitre_technique = "T1039"
    mitre_technique_name = "Data from Network Shared Drive"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records (SYSCALL/EXECVE) normalised to PROCESS_LAUNCH with parent and child process paths and the full command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web or CMS applications that legitimately read from NFS/CIFS-backed upload or media directories through a shell wrapper, database maintenance or backup jobs launched from the database service that write to a mounted share, and print or CUPS filters that spool to network storage."
    tuning_guidance = "Add legitimate parent processes or hosts to %global_allowed_script_hosts, backup tooling to %global_allowed_backup_processes, and application service accounts to %global_allowed_service_accounts. If the environment uses non-standard mount roots, extend the share path regex. Consider raising severity for internet-facing web servers."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|tomcat[0-9]*|catalina|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|smbd|node)$/ nocase
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|csh|tcsh|python[0-9.]*|perl|ruby|php[0-9.]*)$/ nocase
    $proc.target.process.command_line = /\b(smbclient|mount\.cifs|mount|find|ls|cp|rsync|tar|zip|cat|scp|dd|7z|mv)\b/ nocase
    $proc.target.process.command_line = /(\/(mnt|media|net|srv\/samba|srv\/nfs|run\/media)\/|gvfs\/smb-share|smbclient|mount\.cifs|-t\s+(cifs|nfs[34]?|smb3?)|(^|[\s'"])\/\/[a-z0-9._-]+\/[^\s'"]+)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.hostname in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1039")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
