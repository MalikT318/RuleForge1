/*
  MITRE Technique : T1078.001 - Default Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:29:47.735305+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_001_Default_Account_External_Remote_Service_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "A built-in default account (Administrator, Guest, DefaultAccount, WDAGUtilityAccount) is attributed to a network connection to an external address on a remote-access or remote-management port (RDP, SSH, SMB, WinRM, VNC). Legitimate use of these accounts for external remote access is rare, so this indicates likely default-account abuse for initial access or lateral movement."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.001"
    mitre_technique_name = "Valid Accounts: Default Accounts"
    log_prerequisites = "Requires NETWORK_CONNECTION events with principal.user.userid populated, such as network telemetry or firewall logs enriched with user identity from the directory/identity source. Events without user attribution will not match."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Break-glass administrator use during incidents, small environments that still use the built-in Administrator account for vendor remote support, and lab or test hosts."
    tuning_guidance = "Add approved break-glass or renamed administrator accounts to %global_allowed_admin_users and automation identities to %global_allowed_service_accounts. Extend the port list for client-specific remote-access services. If the built-in Administrator account is legitimately used externally, scope the exclusion to that account instead of disabling the rule."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.user.userid = /^([^\\]+\\)?(administrator|guest|defaultaccount|wdagutilityaccount)$/ nocase
    (
      $net.target.port = 3389 or
      $net.target.port = 22 or
      $net.target.port = 445 or
      $net.target.port = 5985 or
      $net.target.port = 5986 or
      $net.target.port = 5900
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.user.userid in %global_allowed_admin_users
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1078.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $default_account = array_distinct($net.principal.user.userid)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
