/*
  MITRE Technique : T1213.003 - Code Repositories
  Tactic(s)       : Collection
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:26:37.941496+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_003_External_Git_Clone_Or_Archive_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects HTTP requests to a hosted code repository service that use the git smart-HTTP transport (upload-pack / info/refs) or a repository archive download, coming from a non-internal source address. This pattern is typical of bulk source code collection with a stolen token or session from attacker infrastructure. It does not depend on any specific repository host, tool name, or client binary."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.003"
    mitre_technique_name = "Data from Information Repositories: Code Repositories"
    log_prerequisites = "Requires repository or SaaS audit/access logs normalized to NETWORK_HTTP with target.url, principal.ip, and principal.user.userid populated. Git transport requests (clone, fetch, archive download) must be logged, not just admin events."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Remote developers cloning from home or travel networks, CI/CD runners and build services hosted outside the corporate range, contractors, third-party code scanning or backup integrations, and software package mirrors."
    tuning_guidance = "Add CI/CD and automation identities to %global_allowed_service_accounts. Add named administrators to %global_allowed_admin_users. Add known remote-work egress addresses to %global_allowed_mgmt_sources. Ensure %rfc1918_internal covers all internal and VPN address space. Consider raising severity for privileged users or repositories flagged as sensitive."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(\/info\/refs\?service=git-(upload|receive)-pack|\/git-upload-pack|\/archive\/.+\.(zip|tar\.gz|tgz)|\/zipball\/|\/tarball\/)/ nocase
    $http.principal.ip != ""
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_mgmt_sources
    not $http.principal.user.userid in %global_allowed_service_accounts
    not $http.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1213.003")
    $primary_entity = array_distinct($http.principal.user.userid)
    $source_ips = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
