/*
  MITRE Technique : T1222.001 - Windows Permissions
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:18:15.728337+00:00
  Reference       : https://attack.mitre.org/techniques/T1222/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_001_Protected_System_Binary_Overwritten_Post_ACL_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of protected, TrustedInstaller-owned logon-screen and accessibility binaries in System32/SysWOW64 by a process that is not a Windows servicing component. These files cannot be written without first taking ownership or rewriting the DACL (takeown, icacls, cacls, Set-Acl, or API calls). The rule therefore catches the file artifact that results from a permission change, whether or not command-line logging is present."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1222.001"
    mitre_technique_name = "File and Directory Permissions Modification: Windows File and Directory Permissions Modification"
    log_prerequisites = "Requires Windows endpoint file-write telemetry from an EDR or Sysmon (file modification events that include the writing process path). System32 and SysWOW64 must not be excluded from file monitoring."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Cumulative updates and feature upgrades delivered by non-standard servicing processes, OS repair or in-place upgrade tooling, imaging and deployment tasks (SCCM/Intune/MDT), and security or accessibility software that legitimately replaces these binaries."
    tuning_guidance = "Add approved patching and deployment binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Exclude known-good update service accounts via %global_allowed_service_accounts. If a client uses a custom servicing stack, add its executable name to the servicing regex exclusion. To broaden coverage, extend the filename group with additional protected binaries after baselining. Pair with a FILE_CREATION variant if the environment records replacements as a creation event."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\\windows\\(system32|syswow64)\\(sethc|utilman|osk|magnify|narrator|displayswitch|atbroker)\.exe$/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|MoUsoCoreWorker|wuauclt|musNotification|SetupHost|setupprep)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1222.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_files = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $acting_users = array_distinct($file.principal.user.userid)

  condition:
    $file
}
