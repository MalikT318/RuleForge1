/*
  MITRE Technique : T1055.009 - Proc Memory
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:55:47.523424+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_009_Proc_Mem_File_Write_Injection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a write to a process memory pseudo-file (/proc/<pid>/mem, /proc/self/mem or /proc/<pid>/task/<tid>/mem). Proc memory injection overwrites a live process's stack or code through this file, typically with dd or a custom loader, to run code in another process's address space. This rule works from the resulting file-modification artifact, not the command line, so it still fires when the writing tool is renamed, compiled from scratch or run with obfuscated arguments."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.009"
    mitre_technique_name = "Process Injection: Proc Memory"
    log_prerequisites = "Linux EDR file telemetry or auditd with a watch or syscall rule on writes to /proc/*/mem, normalised to UDM FILE_MODIFICATION with principal.process.file.full_path and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Debuggers and tracers (gdb, lldb, strace-style tooling) that write to /proc/<pid>/mem; crash-dump and live-patching utilities; EDR/AV agents and memory forensics tools; language runtimes, JIT engines or sandboxes that write to their own /proc/self/mem; backup or checkpoint/restore tooling (for example CRIU)."
    tuning_guidance = "Add legitimate writer binaries to %global_allowed_security_tools (security and forensic agents) or %global_allowed_admin_tools (approved debugging and support tooling). Add checkpoint and backup agents to %global_allowed_backup_processes. If /proc/self/mem writes by runtimes are noisy in a given environment, tune the self-path branch of the regex for that client after reviewing the writing processes."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/proc\/(self|thread-self|[0-9]+)\/(task\/[0-9]+\/)?mem$/ nocase
    not $file.principal.process.file.full_path = /\/(gdb|gdbserver|lldb|lldb-server)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.009")
    $primary_entity = array_distinct($file.principal.hostname)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_command_line = array_distinct($file.principal.process.command_line)
    $target_mem_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
