/*
  MITRE Technique : T1195.003 - Compromise Hardware Supply Chain
  Tactic(s)       : Initial Access
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:45:48.165278+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_003_Linux_Firmware_Modification_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of firmware, BIOS/UEFI, BMC or NVMe firmware modification commands on a single Linux host within 10 minutes. Each command is routine on its own. Repeated write, flash, install or boot-entry changes in a short window can indicate hardware or firmware tampering, or a backdoored device being provisioned from a compromised supply chain."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.003"
    mitre_technique_name = "Supply Chain Compromise: Compromise Hardware Supply Chain"
    log_prerequisites = "Linux EDR or auditd execve telemetry normalised to UDM PROCESS_LAUNCH with populated target.process.file.full_path and target.process.command_line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Planned firmware or BIOS updates by system administrators, fleet patching through LVFS, hardware provisioning and imaging pipelines, BMC configuration by data-centre staff, bootloader or Secure Boot maintenance after kernel updates, and storage vendor firmware updates."
    tuning_guidance = "Add approved patching, provisioning and deployment tooling to %global_allowed_admin_tools (matched on the parent process). Add named firmware administrators to %global_allowed_admin_users. Raise the threshold on hosts that are provisioned in bulk. Scope the rule away from build and imaging hosts if they generate noise."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(flashrom|flashcp|fwupdtool|fwupdmgr|efibootmgr|ipmitool|mokutil|nvme)$/ nocase
    $proc.target.process.command_line = /(\s-w\b|--write|\bwrite\b|\binstall\b|\bflash\b|fw-download|fw-commit|\s-c\b|--create|--import|--enroll|\braw\b|\bmc\s+reset)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1195.003")
    $primary_entity = array_distinct($host)
    $firmware_tools = array_distinct($proc.target.process.file.full_path)
    $executing_users = array_distinct($proc.principal.user.userid)
    $sample_commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
