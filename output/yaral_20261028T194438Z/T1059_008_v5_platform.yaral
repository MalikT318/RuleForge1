/*
  MITRE Technique : T1059.008 - Network Device CLI
  Tactic(s)       : Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:18:29.273590+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_008_Cleartext_Telnet_Mgmt_CLI_From_Unapproved_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a cleartext Telnet session (TCP/23) observed at the network perimeter from a source that is not an approved management source or authorised scanner. Telnet is a native remote CLI transport on network devices (routers, switches, firewalls). Unapproved Telnet access to a device CLI allows an adversary to run commands, change device configuration, alter traffic flows, or disable logging. This is network-observable and does not rely on endpoint process telemetry."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.008"
    mitre_technique_name = "Command and Scripting Interpreter: Network Device CLI"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Telnet traffic must cross a logged enforcement point."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legacy devices or out-of-band console servers that are still managed over Telnet by network engineers, lab or test networks, OT/ICS equipment with Telnet-only management, authorised vulnerability or compliance scanners that probe port 23, and monitoring systems that perform Telnet port checks."
    tuning_guidance = "Add jump hosts, NMS servers and network engineer bastions to %global_allowed_mgmt_sources. Add authorised scanning sources to %global_allowed_scanners. Where legacy Telnet is unavoidable, add the approved source addresses to the management list. Plan to remediate by moving those devices to SSH."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 23
    $net.target.ip != ""
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1059.008")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
