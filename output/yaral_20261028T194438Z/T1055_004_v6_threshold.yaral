/*
  MITRE Technique : T1055.004 - Asynchronous Procedure Call
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:52:01.137318+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_004_Burst_Process_Injection_Per_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of cross-process injection events (the telemetry produced by APC queueing, Early Bird and similar techniques) originating from non-allowlisted processes on a single host within 10 minutes. One injection event can be benign, but repeated injection into other processes is characteristic of APC-based injection. This rule uses process-injection telemetry, not command lines."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.004"
    mitre_technique_name = "Process Injection: Asynchronous Procedure Call"
    log_prerequisites = "Requires Windows EDR or Sysmon-equivalent telemetry that is normalised to PROCESS_INJECTION events, such as remote thread creation or APC queueing. Process injection or remote-thread visibility must be enabled in the sensor policy."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Endpoint security agents and DLP or monitoring tools that hook processes, application-compatibility shims, accessibility and input-method software, game overlays, some legitimate software updaters, and debuggers or developer tooling."
    tuning_guidance = "Add the injecting process path to %global_allowed_security_tools, %global_allowed_backup_processes or %global_allowed_admin_tools. Raise the #inj threshold on hosts with noisy agents. Source-process exclusions are by executable name, not install path."

  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.hostname = $host
    $inj.principal.process.file.full_path != ""
    $inj.target.process.file.full_path != ""
    $inj.principal.process.file.full_path != $inj.target.process.file.full_path
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|csrss|wininit|services)\.exe$/ nocase

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($inj.target.process.file.full_path = /\\(explorer|svchost|lsass|winlogon|spoolsv)\.exe$/ nocase, 85, 65))
    $event_count = count($inj.metadata.id)
    $mitre_technique_id = array_distinct("T1055.004")
    $primary_entity = array_distinct($host)
    $source_processes = array_distinct($inj.principal.process.file.full_path)
    $target_processes = array_distinct($inj.target.process.file.full_path)
    $affected_users = array_distinct($inj.principal.user.userid)

  condition:
    #inj >= 5
}
