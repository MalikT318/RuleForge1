/*
  MITRE Technique : T1557 - Adversary-in-the-Middle
  Tactic(s)       : Credential Access, Collection
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:29:26.228543+00:00
  Reference       : https://attack.mitre.org/techniques/T1557
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1557_Outbound_DNS_To_External_Resolver {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a client sending DNS (port 53) or DNS-over-TLS (port 853) traffic directly to an external, non-RFC1918 resolver. This is a network-side indicator of DNS hijacking, such as a client DNS setting changed by a DNS-changer trojan or rogue DHCP, which lets an adversary-controlled resolver sit in the path for Adversary-in-the-Middle. Clients normally resolve through internal resolvers, so direct external resolver use is anomalous."
    mitre_tactic = "Credential Access, Collection"
    mitre_technique = "T1557"
    mitre_technique_name = "Adversary-in-the-Middle"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with populated principal.ip, target.ip and target.port. Egress logging must include permitted traffic to port 53/853 from internal clients."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Internal DNS servers or forwarders resolving upstream, roaming laptops using public or ISP resolvers, guest and BYOD networks, branch routers with direct internet DNS, DoT-enabled browsers or OS resolvers, vendor appliances with hardcoded resolvers."
    tuning_guidance = "Add the addresses of sanctioned internal DNS servers and forwarders to %global_allowed_mgmt_sources. Scope the rule to client network segments in the firewall log pipeline. Route egress DNS through approved resolvers and alert only on deviations. Raise severity when the same source also changes resolver across many days."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 53 or $net.target.port = 853)
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1557")
    $primary_entity = array_distinct($net.principal.ip)
    $resolver_ips = array_distinct($net.target.ip)
    $resolver_ports = array_distinct($net.target.port)

  condition:
    $net
}
