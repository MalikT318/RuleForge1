/*
  MITRE Technique : T1553.002 - Code Signing
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:00:26.018714+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_002_Code_Signing_Key_Material_File_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a private-key or certificate-bundle file (.pfx, .p12, .pvk) on a Windows endpoint by a process that is not an approved admin, backup or security tool. Staging exported or stolen code signing material on disk is a precursor to signing malware with a valid signature. This is a file-artifact detection that does not depend on command-line logging, so it still fires if the export is done through the CryptoAPI, a renamed tool or a script."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.002"
    mitre_technique_name = "Subvert Trust Controls: Code Signing"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or PKI teams exporting certificates for legitimate deployment; developers and build engineers exporting signing certificates; software installers or MDM agents dropping PFX files; backup or migration tooling; users saving a certificate downloaded from an internal portal."
    tuning_guidance = "Add approved PKI, deployment and build tooling to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, backup software to %global_allowed_backup_processes, and certificate automation accounts to %global_allowed_service_accounts. Build servers that legitimately handle signing keys can be excluded by their service account."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(pfx|p12|pvk)$/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path = /\\(chrome|msedge|firefox|iexplore)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1553.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
