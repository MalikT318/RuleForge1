/*
  MITRE Technique : T1132.001 - Standard Encoding
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:46:36.807881+00:00
  Reference       : https://attack.mitre.org/techniques/T1132/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1132_001_Linux_Encoded_Payload_Staged_In_Temp_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a file with an encoding-scheme extension (Base64, Base32, hex, uuencode, Base85) in a world-writable staging directory (/tmp, /var/tmp, /dev/shm) on Linux. Adversaries stage Base64- or hex-encoded C2 data or payloads in these locations before decoding and executing them, or before sending them over a C2 channel. This is file-creation telemetry rather than command-line matching, so it adds coverage beyond process-creation rules."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1132.001"
    mitre_technique_name = "Data Encoding: Standard Encoding"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-creation events (e.g. watches on /tmp, /var/tmp, /dev/shm) normalised to UDM FILE_CREATION with target.file.full_path and principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers and admins saving Base64 or hex output while debugging; certificate and key handling scripts; configuration management and deployment agents; package build processes; backup or support-bundle collection tools that write encoded temp files."
    tuning_guidance = "Add approved writer binaries to %global_allowed_admin_tools, approved automation hosts or parent interpreters to %global_allowed_script_hosts, and expected service accounts to %global_allowed_service_accounts. If a client's tooling uses a specific extension heavily, remove it from the extension group in the regex for that client."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.*\.(b64|base64|b32|base32|b85|base85|hex|uu|uue)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1132.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $staged_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
