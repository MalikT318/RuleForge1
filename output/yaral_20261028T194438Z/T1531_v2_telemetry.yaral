/*
  MITRE Technique : T1531 - Account Access Removal
  Tactic(s)       : Impact
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:30:40.154972+00:00
  Reference       : https://attack.mitre.org/techniques/T1531
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1531_ESXi_Local_Account_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a host configuration change in which an ESXi local account is removed, disabled, updated or has its password changed. This is the state change produced by account access removal (for example via esxcli, the host client or the API), whatever command line was used. Ransomware operators use it to lock administrators out of hypervisors before encrypting datastores."
    mitre_tactic = "Impact"
    mitre_technique = "T1531"
    mitre_technique_name = "Account Access Removal"
    log_prerequisites = "ESXi hostd audit and event messages (account removed/updated, password changed) forwarded to Chronicle and parsed to SETTING_MODIFICATION with the event text in metadata.description."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Planned password rotation by privileged access management tooling, joiner/mover/leaver account clean-up by administrators, host build or re-image automation, lockdown mode and compliance remediation scripts."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and automation or rotation accounts to %global_allowed_service_accounts. Accounts that are routinely rotated can be matched on the target user and added to %global_allowed_service_accounts. If a client's parser puts the event text in a different field, adjust the metadata.description match for that client."

  events:
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.metadata.description = /\b(account|local user)\b.{0,80}\b(removed|deleted|disabled|updated|modified|password\s+(was\s+)?(changed|reset))\b/ nocase
    $cfg.principal.hostname != ""
    not $cfg.principal.user.userid in %global_allowed_admin_users
    not $cfg.principal.user.userid in %global_allowed_service_accounts
    not $cfg.target.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1531")
    $primary_entity = array_distinct($cfg.principal.hostname)
    $acting_user = array_distinct($cfg.principal.user.userid)
    $affected_account = array_distinct($cfg.target.user.userid)
    $change_detail = array_distinct($cfg.metadata.description)

  condition:
    $cfg
}
