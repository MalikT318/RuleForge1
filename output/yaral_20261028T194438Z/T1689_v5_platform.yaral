/*
  MITRE Technique : T1689 - Downgrade Attack
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:37:59.695473+00:00
  Reference       : https://attack.mitre.org/techniques/T1689
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1689_Schannel_Legacy_Protocol_Enabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Windows SCHANNEL registry configuration being changed to enable a deprecated TLS/SSL protocol (SSL 2.0, SSL 3.0, TLS 1.0, TLS 1.1) for client or server use. Adversaries downgrade protocol support to force weaker cryptography and enable adversary-in-the-middle or network sniffing. This is the registry-based variant and complements the PowerShell version-2 downgrade detection."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1689"
    mitre_technique_name = "Downgrade Attack"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events) with registry key, value name and value data populated in UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy application compatibility fixes, vendor installers for older line-of-business software, IT staff re-enabling TLS 1.0/1.1 for a legacy integration, and configuration management or GPO baselines that intentionally enable legacy protocols."
    tuning_guidance = "Add approved configuration tooling to %global_allowed_admin_tools and named administrators to %global_allowed_admin_users. If your EDR reports new values as REGISTRY_CREATION, deploy a copy of this rule for that event type. If value data is not populated for a client, remove the registry_value_data condition and review the alerts manually."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SecurityProviders\\SCHANNEL\\Protocols\\(SSL 2\.0|SSL 3\.0|TLS 1\.0|TLS 1\.1)\\(Client|Server)$/ nocase
    $reg.target.registry.registry_value_name = "Enabled" nocase
    $reg.target.registry.registry_value_data = /(0x0*|\b)1\)?$/
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1689")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $modifying_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
