/*
  MITRE Technique : T1087.001 - Local Account
  Tactic(s)       : Discovery
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:52:19.192667+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_001_Linux_Passwd_Then_Group_File_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects local account and group enumeration through file-access telemetry. A single user on one host reads /etc/passwd and then /etc/group or /etc/gshadow within ten minutes, using a file-reading utility or scripting interpreter. This is based on file-read events, not process command lines."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.001"
    mitre_technique_name = "Account Discovery: Local Account"
    log_prerequisites = "Requires Linux endpoint file-read telemetry (EDR file access events or auditd watches on /etc/passwd, /etc/group and /etc/gshadow) normalised to UDM FILE_READ with principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management agents (Ansible, Puppet, Chef, Salt) and inventory or compliance scripts. User-audit tooling, administrators troubleshooting permissions, and backup or provisioning scripts that parse account databases."
    tuning_guidance = "Add approved automation and inventory binaries to %global_allowed_admin_tools. Add service accounts that routinely audit accounts to %global_allowed_service_accounts. Add EDR and compliance agents to %global_allowed_security_tools. Ensure auditd watches are limited to the three account files to control volume."

  events:
    $pw.metadata.event_type = "FILE_READ"
    $pw.target.file.full_path = /^\/etc\/passwd$/ nocase
    $pw.principal.process.file.full_path = /\/(cat|head|tail|less|more|grep|egrep|awk|gawk|sed|cut|sort|getent|python[0-9.]*|perl|ruby|php)$/ nocase
    not $pw.principal.process.file.full_path in %global_allowed_admin_tools
    not $pw.principal.process.file.full_path in %global_allowed_security_tools
    not $pw.principal.user.userid in %global_allowed_service_accounts
    $pw.principal.hostname = $hostname
    $pw.principal.user.userid = $user

    $grp.metadata.event_type = "FILE_READ"
    $grp.target.file.full_path = /^\/etc\/(group|gshadow)$/ nocase
    $grp.principal.process.file.full_path = /\/(cat|head|tail|less|more|grep|egrep|awk|gawk|sed|cut|sort|getent|python[0-9.]*|perl|ruby|php)$/ nocase
    not $grp.principal.process.file.full_path in %global_allowed_admin_tools
    not $grp.principal.process.file.full_path in %global_allowed_security_tools
    not $grp.principal.user.userid in %global_allowed_service_accounts
    $grp.principal.hostname = $hostname
    $grp.principal.user.userid = $user

    $pw.metadata.event_timestamp.seconds <= $grp.metadata.event_timestamp.seconds

  match:
    $hostname, $user over 10m

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1087.001")
    $primary_entity = array_distinct($hostname)
    $accounts_involved = array_distinct($user)
    $passwd_readers = array_distinct($pw.principal.process.file.full_path)
    $group_readers = array_distinct($grp.principal.process.file.full_path)
    $group_files_read = array_distinct($grp.target.file.full_path)
    $first_read_time = min($pw.metadata.event_timestamp.seconds)
    $last_read_time = max($grp.metadata.event_timestamp.seconds)

  condition:
    $pw and $grp
}
