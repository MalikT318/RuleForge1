/*
  MITRE Technique : T1011.001 - Exfiltration Over Bluetooth
  Tactic(s)       : Exfiltration
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:21:52.192178+00:00
  Reference       : https://attack.mitre.org/techniques/T1011/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1011_001_Linux_Bluetooth_Device_Pairing_State_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a BlueZ per-device pairing record (/var/lib/bluetooth/<adapter>/<device>/info) on a Linux host. This state artifact is written when a new remote Bluetooth device is paired or bonded. An adversary with physical proximity can use such a pairing as an out-of-band exfiltration channel that bypasses network monitoring. The rule works at the file-state layer, so it still fires if command-line logging is evaded or the pairing is made through a GUI or D-Bus."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1011.001"
    mitre_technique_name = "Exfiltration Over Other Network Medium: Exfiltration Over Bluetooth"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules (-w /var/lib/bluetooth -p wa) normalised to UDM FILE_CREATION events with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Laptop and desktop users pairing headsets, keyboards, mice or phones; kiosk or IoT gateways that legitimately pair peripherals; configuration-management or provisioning runs that restore Bluetooth state; BlueZ re-creating records after a package upgrade or adapter replacement."
    tuning_guidance = "Add configuration-management or provisioning binaries to %global_allowed_admin_tools. On servers and headless systems with no Bluetooth requirement, raise severity to High. On user workstations where pairing is routine, consider keeping the rule as a low-priority hunting signal. Correlate the host with later large file reads or archive creation before escalating."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/var\/lib\/bluetooth\/([0-9a-f]{2}:){5}[0-9a-f]{2}\/([0-9a-f]{2}:){5}[0-9a-f]{2}\/info/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1011.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $pairing_file_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
