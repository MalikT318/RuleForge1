/*
  MITRE Technique : T1558.004 - AS-REP Roasting
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:46:12.283038+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_004_NonLsass_Kerberos_ASREQ_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows host where a process other than the Local Security Authority (lsass.exe) opens an outbound connection to TCP/UDP port 88 (Kerberos). Native Windows Kerberos AS-REQ/TGS-REQ traffic is issued by lsass.exe. A user-mode process speaking Kerberos directly to a domain controller is characteristic of AS-REP roasting tooling that sends AS-REQ messages without pre-authentication data to enumerate accounts with preauth disabled and harvest crackable AS-REP material. Destination addresses are deliberately NOT filtered with %rfc1918_internal, because roasting traffic is sent to the internal domain controller, so excluding internal targets would blind the rule."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.004"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: AS-REP Roasting"
    log_prerequisites = "Requires endpoint network telemetry (EDR or Sysmon Event ID 3 equivalent) that populates the principal process path and destination port for NETWORK_CONNECTION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Java, Python or other cross-platform applications with their own Kerberos or GSSAPI stack; Linux-style tooling on Windows such as WSL or Cygwin ssh/curl using Kerberos; vulnerability scanners and authorized red-team or penetration testing; identity management and RMM agents; security product agents that probe domain controllers; non-lsass system components in some EDR sensor normalisations."
    tuning_guidance = "Add legitimate Kerberos-speaking binaries to %global_allowed_admin_tools or %global_allowed_security_tools (by executable path), and add authorised testing sources to %global_allowed_scanners. Add service hosts to %global_allowed_remote_mgmt where needed. If the same host produces many hits, tighten with a threshold variant or raise the risk_score only for hosts that are not domain controllers."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 88
    $net.principal.hostname != ""
    $net.target.ip != ""
    $net.principal.process.file.full_path = /\.exe$/ nocase
    not $net.principal.process.file.full_path = /\\lsass\.exe$/ nocase
    not $net.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|NisSrv)\.exe$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1558.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $kdc_ips = array_distinct($net.target.ip)
    $source_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
