/*
  MITRE Technique : T1547.001 - Registry Run Keys / Startup Folder
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:23:28.430915+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_001_Dropped_Executable_Then_RunKey_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an executable or script file being created in a user-writable staging location (AppData, ProgramData, Public, Temp) followed within ten minutes by a write to a Run, RunOnce or RunOnceEx registry key on the same host. This drop-then-persist sequence is typical of malware installing a startup foothold. It is based on file and registry telemetry, not process command lines."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.001"
    mitre_technique_name = "Boot or Logon Autostart Execution: Registry Run Keys / Startup Folder"
    log_prerequisites = "Requires Windows endpoint telemetry that reports both file creation and registry value modification events, e.g. EDR or Sysmon Event IDs 11 and 13, normalised to UDM FILE_CREATION and REGISTRY_MODIFICATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-user software installers and self-updaters (browsers, collaboration clients, cloud storage sync clients) that unpack binaries into AppData and register a Run key for auto-start. Software deployment and RMM agents. Legitimate line-of-business applications that configure start-up on first run."
    tuning_guidance = "Add approved deployment, patching and RMM binaries to %global_allowed_admin_tools. Add EDR and AV agents to %global_allowed_security_tools. If a specific updater is noisy, add its executable to %global_allowed_admin_tools rather than excluding by install path. Increase the match window or add a join on the writing process if a customer needs a stricter or looser correlation."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(exe|dll|scr|bat|cmd|vbs|vbe|js|jse|hta|ps1)$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\appdata\\|programdata\\|users\\public\\|windows\\temp\\)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Microsoft\\Windows\\CurrentVersion\\(Run|RunOnce|RunOnceEx)(\\|$)/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1547.001")
    $primary_entity = array_distinct($hostname)
    $dropped_files = array_distinct($file.target.file.full_path)
    $dropper_processes = array_distinct($file.principal.process.file.full_path)
    $run_keys = array_distinct($reg.target.registry.registry_key)
    $run_key_writers = array_distinct($reg.principal.process.file.full_path)
    $affected_users = array_distinct($reg.principal.user.userid)

  condition:
    $file and $reg
}
