/*
  MITRE Technique : T1566.003 - Spearphishing via Service
  Tactic(s)       : Initial Access
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:50:39.013789+00:00
  Reference       : https://attack.mitre.org/techniques/T1566/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1566_003_Linux_CLI_Downloader_Payload_Fetch_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux host fetching an executable, script or archive payload from an external, non-allowlisted site using a command-line HTTP client user-agent. This is the network-side result of a user following a spearphishing link or message received through a third-party service (webmail, social media, messaging) and handing the payload to a shell. It does not rely on process or command-line telemetry."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1566.003"
    mitre_technique_name = "Phishing: Spearphishing via Service"
    log_prerequisites = "Requires proxy or perimeter HTTP logs that populate the URL, user-agent, and destination hostname/IP, normalised to NETWORK_HTTP."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Developers and build/CI hosts pulling installers or release archives, admins fetching vendor scripts or packages from non-allowlisted mirrors, container image build pipelines, configuration management bootstrapping."
    tuning_guidance = "Add vendor, mirror and repository domains to %global_allowed_domains. Add build, CI and automation hosts to %global_allowed_script_hosts. Narrow or extend the extension and user-agent regexes per client baseline."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.network.http.user_agent = /^(curl|wget|python-requests|python-urllib|go-http-client|libwww-perl)/ nocase
    $net.target.url = /\.(sh|bash|elf|bin|run|appimage|deb|rpm|jar|py|pl|so|zip|tar|gz|tgz|7z|rar|iso)(\?.*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1566.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $requested_urls = array_distinct($net.target.url)
    $destination_hosts = array_distinct($net.target.hostname)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
