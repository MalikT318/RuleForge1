/*
  MITRE Technique : T1674 - Input Injection
  Tactic(s)       : Execution
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:19:28.358360+00:00
  Reference       : https://attack.mitre.org/techniques/T1674
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1674_Scripted_Keystroke_Injection_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated launches of script interpreters whose command lines invoke synthetic keyboard input APIs (SendKeys, SendWait, SendInput, keybd_event) on a single host within 10 minutes. A single use is often benign automation. Repeated use suggests scripted keystroke injection into a user session or GUI, such as keyboard-driven console launching or pasting and executing scripts on behalf of the user."
    mitre_tactic = "Execution"
    mitre_technique = "T1674"
    mitre_technique_name = "Input Injection"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 / Windows Event 4688 with command-line auditing enabled, normalised to UDM PROCESS_LAUNCH with target.process.command_line populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "GUI test automation and UI testing frameworks, accessibility and macro tools, legacy admin or login scripts that use SendKeys to drive applications, helpdesk and RMM scripts that automate dialogs, kiosk or training software."
    tuning_guidance = "Add approved automation parent processes or hosts to %global_allowed_script_hosts, and approved IT automation or deployment tooling to %global_allowed_admin_tools. Raise the condition threshold (#proc >= 3) on QA or test-lab hosts. Scale the risk score in the SOAR playbook using $event_count."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|cmd)\.exe$/ nocase
    $proc.target.process.command_line = /(sendkeys|sendwait|sendinput|keybd_event)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.hostname in %global_allowed_script_hosts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1674")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $sample_command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
