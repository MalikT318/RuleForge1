/*
  MITRE Technique : T1555.004 - Windows Credential Manager
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:58:44.621266+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_004_Credential_Vault_File_Read_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects multiple reads of Windows Credential Manager vault and credential store files (.vcrd, .vpol and DPAPI credential blobs) on a single host within ten minutes by processes that are not approved security, backup or core OS components. Individual reads are benign; volume across the vault stores indicates credential harvesting."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.004"
    mitre_technique_name = "Credentials from Password Stores: Windows Credential Manager"
    log_prerequisites = "Requires EDR or Sysmon-equivalent file-access telemetry normalised to FILE_READ for user and ProgramData vault and credential directories. Not available from process-creation logs alone."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and imaging agents, profile migration tools, EDR or AV scanners that touch vault files, user-state migration during device refresh, and legitimate credential management software."
    tuning_guidance = "Add backup agents to %global_allowed_backup_processes and EDR or AV binaries to %global_allowed_security_tools. Add approved IT and migration tooling to %global_allowed_admin_tools. Raise the #file threshold in noisy estates, or lower it to 2 for high-sensitivity hosts. Extend the executable-name exclusion for OS components that legitimately read the vault in your environment."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /\\Microsoft\\(Vault\\.*\.(vcrd|vpol)|Credentials\\[0-9A-F]{32})$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\\(lsass|vaultsvc|svchost|services|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($file.target.file.full_path = /\.vpol$/ nocase, 85, 70))
    $mitre_technique_id = array_distinct("T1555.004")
    $primary_entity = array_distinct($host)
    $read_count = count($file.metadata.id)
    $accessed_files = array_distinct($file.target.file.full_path)
    $reading_processes = array_distinct($file.principal.process.file.full_path)
    $affected_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
