/*
  MITRE Technique : T1137.002 - Office Test
  Tactic(s)       : Persistence
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:16:04.604896+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_002_Office_Test_Key_Set_By_Anomalous_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, script interpreter or registry utility that references the Office Test persistence key (Software\\Microsoft\\Office test\\Special\\Perf) and was spawned by an unexpected parent: an Office application, browser, web server, print spooler, database service, WMI provider host or script host. The Office Test key is not created by default, so writing it from these lineages is a strong sign of DLL persistence."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.002"
    mitre_technique_name = "Office Application Startup: Office Test"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with full parent and child image paths and command lines (EDR, Sysmon Event ID 1 or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office or add-in developers and testers who legitimately configure the Office Test key from a script host. Packaging or deployment tooling that launches reg.exe or PowerShell from a script host. Software installers that configure Office performance test settings."
    tuning_guidance = "Add approved deployment or packaging parent binaries to %global_allowed_admin_tools. Add approved automation hosts or interpreters to %global_allowed_script_hosts. Narrow or widen the parent regex per client environment. Pair with a registry-modification rule for the same key for full coverage."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|onenote|mspub|visio|chrome|msedge|firefox|iexplore|w3wp|httpd|nginx|php-cgi|tomcat[0-9]*|java|spoolsv|sqlservr|mysqld|wmiprvse|mshta|wscript|cscript)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(reg|regedit|powershell|pwsh|cmd|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /office\s+test\\+special\\+perf/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1137.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
