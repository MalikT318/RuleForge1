/*
  MITRE Technique : T1601 - Modify System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:12:06.019432+00:00
  Reference       : https://attack.mitre.org/techniques/T1601
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_Repeated_Image_Transfer_Protocols_To_Device {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Repeated TFTP or FTP connections from non-approved sources to a single destination within ten minutes. These cleartext file-transfer protocols are commonly used to push or pull network device operating system images and configuration files. Repeated attempts against one device may indicate an attempt to modify the system image."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1601"
    mitre_technique_name = "Modify System Image"
    log_prerequisites = "Requires firewall or network perimeter connection logs that populate principal.ip, target.ip and target.port. The firewall must have visibility of management-plane traffic between the source and the network device."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised firmware upgrades and configuration backups by network engineers, network automation and configuration management servers, PXE or provisioning services using TFTP, and legacy file-transfer jobs."
    tuning_guidance = "Add approved management, automation and backup source addresses to %global_allowed_mgmt_sources, and vulnerability scanner addresses to %global_allowed_scanners. Raise the #net threshold in environments with frequent TFTP-based provisioning. Alert severity scales in outcome, with TFTP scored higher than FTP."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 69 or $net.target.port = 21)
    $net.target.ip = $device
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  match:
    $device over 10m

  outcome:
    $risk_score = max(if($net.target.port = 69, 70, 55))
    $mitre_technique_id = array_distinct("T1601")
    $primary_entity = array_distinct($device)
    $event_count = count($net.metadata.id)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    #net >= 3
}
