/*
  MITRE Technique : T1211 - Exploitation for Stealth
  Tactic(s)       : Stealth
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:19:18.098270+00:00
  Reference       : https://attack.mitre.org/techniques/T1211
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1211_SaaS_Audit_Tampering_Then_Resource_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a cloud or SaaS audit, logging, or diagnostic configuration being modified by an identity, followed within ten minutes by the same identity creating a new resource. This pattern is consistent with exploiting a control-plane flaw or misconfiguration to suppress telemetry and then deploy infrastructure or access that is hidden from monitoring."
    mitre_tactic = "Stealth"
    mitre_technique = "T1211"
    mitre_technique_name = "Exploitation for Stealth"
    log_prerequisites = "Requires cloud control-plane audit logs ingested and normalised to UDM, with metadata.product_event_type, principal.user.userid and target.resource.name populated. Audit-configuration changes must be logged as SETTING_MODIFICATION and resource provisioning as RESOURCE_CREATION."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Planned logging migrations, log-destination or retention changes by platform teams, infrastructure-as-code pipelines that update audit settings and provision resources in the same run, and cloud landing-zone automation during onboarding of new accounts or subscriptions."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named platform administrators to %global_allowed_admin_users. Narrow the product_event_type regexes to the event names your tenant emits if noise persists. Raise severity when the resource-creation event is an identity, key or compute resource."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(stop|disable|delete|update|put|suspend|remove).*(logging|trail|sink|diagnostic|auditconfig|flowlog|audit)/ nocase
    $setting.principal.user.userid != ""
    $setting.principal.user.userid = $user
    not $setting.principal.user.userid in %global_allowed_cloud_principals
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_admin_users

    $create.metadata.event_type = "RESOURCE_CREATION"
    $create.metadata.product_event_type = /(create|run|insert|launch|register|deploy).*(instance|function|key|token|user|role|credential|cluster|app)/ nocase
    $create.principal.user.userid != ""
    $create.principal.user.userid = $user
    not $create.principal.user.userid in %global_allowed_cloud_principals
    not $create.principal.user.userid in %global_allowed_service_accounts
    not $create.principal.user.userid in %global_allowed_admin_users

    $setting.metadata.event_timestamp.seconds <= $create.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1211")
    $primary_entity = array_distinct($user)
    $tamper_actions = array_distinct($setting.metadata.product_event_type)
    $tampered_resources = array_distinct($setting.target.resource.name)
    $created_actions = array_distinct($create.metadata.product_event_type)
    $created_resources = array_distinct($create.target.resource.name)
    $source_ips = array_distinct($setting.principal.ip)
    $tamper_event_count = count($setting.metadata.id)

  condition:
    $setting and $create
}
