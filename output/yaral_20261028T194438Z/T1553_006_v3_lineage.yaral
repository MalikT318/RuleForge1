/*
  MITRE Technique : T1553.006 - Code Signing Policy Modification
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:08:55.969124+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_006_Anomalous_Parent_Spawns_Code_Signing_Policy_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects a Windows boot configuration tool, or a shell or script interpreter running a boot configuration command, that disables driver signature enforcement (test signing, integrity checks off). The process is launched by a parent that should never do this, such as an Office application, web server worker, print spooler or database service. This points to exploitation or macro-driven staging that prepares the host to load unsigned or self-signed drivers."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.006"
    mitre_technique_name = "Subvert Trust Controls: Code Signing Policy Modification"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare. Possible sources are driver developers or QA test labs where a build or test service on a database or web host toggles test signing, software installers that launch from an Office add-in or web-hosted deployment agent, and lab or automation hosts that routinely configure boot options."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts, approved deployment or provisioning tools to %global_allowed_admin_tools, and EDR/AV agents to %global_allowed_security_tools. Exclude driver-development hosts by reviewing the primary_entity values and tuning at client level, not by adding hostnames to this rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|onenote|visio|acrord32|w3wp|httpd|nginx|tomcat\d*|php-cgi|spoolsv|sqlservr|mysqld|postgres)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(bcdedit|cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /bcdedit.*(testsigning|nointegritychecks|disable_integrity_checks)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1553.006")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
