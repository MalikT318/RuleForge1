/*
  MITRE Technique : T1496 - Resource Hijacking
  Tactic(s)       : Impact
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:51:07.779599+00:00
  Reference       : https://attack.mitre.org/techniques/T1496
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_Linux_Container_Staging_Then_Mining_Activity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects resource hijacking (cryptomining) in a Linux container or container host. A payload is downloaded or made executable in a world-writable staging directory (/tmp, /var/tmp, /dev/shm), then within 10 minutes a process is launched with mining-pool protocol URIs or miner-specific parameters on the same host."
    mitre_tactic = "Impact"
    mitre_technique = "T1496"
    mitre_technique_name = "Resource Hijacking"
    log_prerequisites = "Requires container runtime or node-level process telemetry (PROCESS_LAUNCH with full command line) normalised to UDM, with principal.hostname populated consistently for both events."
    platform = "Linux"
    log_source = "container"
    false_positives = "Authorised blockchain or crypto research workloads, CI jobs that download and chmod tools in /tmp, developer test containers, approved software installers, security testing frameworks that simulate miner command lines."
    tuning_guidance = "Add approved deployment and tooling parent processes to %global_allowed_admin_tools, approved script-running hosts to %global_allowed_script_hosts, and EDR or runtime security agents to %global_allowed_security_tools. If legitimate crypto workloads exist, scope them by adding their parent process paths to %global_allowed_admin_tools."

  events:
    // Stage 1: payload download or chmod +x in a world-writable staging directory
    $dl.metadata.event_type = "PROCESS_LAUNCH"
    $dl.target.process.command_line = /(\b(curl|wget)\b.*\/(tmp|var\/tmp|dev\/shm)\/|\bchmod\b.*\+x.*\/(tmp|var\/tmp|dev\/shm)\/)/ nocase
    not $dl.principal.process.file.full_path in %global_allowed_admin_tools
    not $dl.principal.process.file.full_path in %global_allowed_script_hosts
    $dl.principal.hostname = $hostname

    // Stage 2: process launched with mining-pool protocol URI or miner-specific parameters
    $miner.metadata.event_type = "PROCESS_LAUNCH"
    $miner.target.process.command_line = /(stratum[0-9]*(\+(tcp|ssl|tls|udp))?:\/\/|--donate-level|--coin[= ]|--cpu-priority)/ nocase
    not $miner.principal.process.file.full_path in %global_allowed_security_tools
    not $miner.principal.process.file.full_path in %global_allowed_admin_tools
    $miner.principal.hostname = $hostname

    $dl.metadata.event_timestamp.seconds <= $miner.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1496")
    $primary_entity = array_distinct($hostname)
    $staging_commands = array_distinct($dl.target.process.command_line)
    $miner_commands = array_distinct($miner.target.process.command_line)
    $miner_users = array_distinct($miner.principal.user.userid)
    $miner_launch_count = count($miner.metadata.id)

  condition:
    $dl and $miner
}
