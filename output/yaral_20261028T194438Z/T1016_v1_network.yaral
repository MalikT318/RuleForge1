/*
  MITRE Technique : T1016 - System Network Configuration Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:43:19.531836+00:00
  Reference       : https://attack.mitre.org/techniques/T1016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_Scripted_Client_External_IP_Echo_Lookup {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host using a scripting or command-line HTTP client (PowerShell, WinHTTP, curl, Python and similar) to request an external 'what is my IP' style endpoint. Adversaries use these lookups to learn the egress address and network configuration of a compromised Windows host. This is network-side coverage that complements endpoint command-line detections for local discovery utilities. Matching is on the generic URL path shape and the non-browser user agent, not on named services."
    mitre_tactic = "Discovery"
    mitre_technique = "T1016"
    mitre_technique_name = "System Network Configuration Discovery"
    log_prerequisites = "Requires proxy or firewall HTTP logging with URL path and user-agent populated (TLS inspection or explicit proxy for HTTPS). Source IP must be normalised to principal.ip."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "IT automation or monitoring scripts that check the public IP (dynamic DNS updaters, VPN or SD-WAN health checks), software installers that detect geography or egress IP, and developers testing connectivity with curl or PowerShell."
    tuning_guidance = "Add approved vendor or monitoring destinations to %global_allowed_domains. Keep %rfc1918_internal current for the tenant's address space. If a known script host generates noise, narrow the user-agent regex or add a source-IP exception through the client's standard suppression process."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET"
    $net.target.url = /\/(my-?ip|what-?is-?my-?ip|check-?ip|get-?ip|ip-?address|ip|ip\.json|ip\.txt)\/?(\?.*)?$/ nocase
    $net.network.http.user_agent = /(powershell|winhttp|curl|wget|python|go-http-client|java\/|cscript|wscript)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1016")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
