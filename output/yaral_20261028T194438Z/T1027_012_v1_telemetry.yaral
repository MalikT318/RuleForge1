/*
  MITRE Technique : T1027.012 - LNK Icon Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:56:45.508431+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_012_LNK_Icon_Smuggling_Explorer_INetCache_Payload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the file artifact left by LNK icon smuggling. When Explorer renders a shortcut whose IconEnvironmentDataBlock points at a remote URL or UNC/WebDAV path, Windows fetches the resource into the user's INetCache. This rule alerts when explorer.exe writes an executable, script, installer, or shortcut-type file into INetCache, which is not normal Explorer behaviour. It covers the downloaded payload rather than the LNK command line, so it still fires if process command-line logging is evaded."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.012"
    mitre_technique_name = "Obfuscated Files or Information: LNK Icon Smuggling"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with the creating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy browser or Office in-place document handlers that route through Explorer; WebDAV-hosted line-of-business shortcuts that fetch .exe or .dll icon resources; software installers launched from web shares; shell extensions that cache remote icon libraries."
    tuning_guidance = "Add EDR or security agents that touch INetCache to %global_allowed_security_tools. Add named administrators who legitimately open WebDAV or remote shortcuts to %global_allowed_admin_users. Narrow or widen the extension list in the target path regex to match client software. Review the parent LNK file and its source (email, ISO, or archive) for any hit."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\explorer\.exe$/ nocase
    $file.target.file.full_path = /\\users\\[^\\]+\\appdata\\local\\(microsoft\\windows\\inetcache|microsoft\\windows\\temporary internet files)\\.*\.(exe|dll|scr|msi|hta|js|jse|vbs|vbe|ps1|bat|cmd|jar|cpl|lnk|iso|img)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.012")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_files = array_distinct($file.target.file.full_path)
    $affected_users = array_distinct($file.principal.user.userid)

  condition:
    $file
}
