/*
  MITRE Technique : T1213.001 - Confluence
  Tactic(s)       : Collection
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:23:08.562330+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_001_Wiki_Space_Access_Setting_Broadened {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a configuration change on a collaborative wiki or knowledge-base SaaS application that widens access to content. Examples are enabling anonymous or public access, granting space or global permissions, and enabling space export. An adversary with a foothold can use these changes to mine or bulk-collect documentation (network diagrams, credentials, source snippets). The rule works at the configuration-change layer, not the process or command-line layer."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.001"
    mitre_technique_name = "Data from Information Repositories: Confluence"
    log_prerequisites = "Requires SaaS or cloud audit logs for the wiki or knowledge-base application, ingested and normalised to SETTING_MODIFICATION. metadata.product_event_type must carry the audit action name, and target.application or target.url must identify the wiki application."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate space administrators onboarding new teams or projects, intentionally public documentation spaces, IAM or identity-governance automation syncing group permissions, and scheduled migrations or backup configurations that enable export."
    tuning_guidance = "Add named wiki administrators to %global_allowed_admin_users and provisioning or SCIM automation accounts to %global_allowed_service_accounts. The target.application and target.url scoping assumes the wiki application is identified by a 'wiki' token in those fields. Adjust the scoping regex per client to match how the audit log is normalised. Narrow or extend the product_event_type regex to match each client's audit action naming."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    (
      $setting.target.application = /wiki/ nocase or
      $setting.target.url = /\/wiki\// nocase
    )
    $setting.metadata.product_event_type = /(anonymous|public|guest).*(access|permission|link)|(space|global|site).*permission.*(add|grant|chang|updat|set)|(space|site).*export|export.*(enabled|allowed|space)/ nocase
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1213.001")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $changed_action = array_distinct($setting.metadata.product_event_type)
    $changed_resource = array_distinct($setting.target.resource.name)
    $source_ips = array_distinct($setting.principal.ip)

  condition:
    $setting
}
