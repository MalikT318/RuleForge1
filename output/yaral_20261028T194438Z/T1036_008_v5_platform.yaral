/*
  MITRE Technique : T1036.008 - Masquerade File Type
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:10:06.085205+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_008_Non_Executable_Extension_Loaded_As_Module {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process loading a module (DLL image) whose file extension is that of a benign document, image, or text type. Executable code stored under a non-executable extension is a core file-type masquerading technique. This is image-load based and does not depend on process command lines."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.008"
    mitre_technique_name = "Masquerading: Masquerade File Type"
    log_prerequisites = "Requires endpoint module/image-load telemetry (for example Sysmon Event ID 7 or an EDR equivalent) normalised to PROCESS_MODULE_LOAD with target.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers or packers that stage DLLs under renamed extensions, legacy applications loading plugins with .dat or .log names, developer and build tooling, and AV or EDR products that load content files for scanning."
    tuning_guidance = "Add approved loading processes to %global_allowed_security_tools or %global_allowed_admin_tools. Trim the extension list (for example remove dat or ico) if a client application legitimately loads such files as modules. Review the loading process, its parent, and the file's origin (download or temp path) when triaging."

  events:
    $mod.metadata.event_type = "PROCESS_MODULE_LOAD"
    $mod.target.file.full_path = /\.(jpe?g|png|gif|bmp|ico|svg|webp|tiff?|txt|log|csv|pdf|docx?|xlsx?|pptx?|mp3|mp4|dat)$/ nocase
    $mod.principal.hostname != ""
    not $mod.principal.process.file.full_path in %global_allowed_security_tools
    not $mod.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1036.008")
    $primary_entity = array_distinct($mod.principal.hostname)
    $loading_process = array_distinct($mod.principal.process.file.full_path)
    $loaded_module = array_distinct($mod.target.file.full_path)
    $user = array_distinct($mod.principal.user.userid)

  condition:
    $mod
}
