/*
  MITRE Technique : T1498.002 - Reflection Amplification
  Tactic(s)       : Impact
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:12:23.417444+00:00
  Reference       : https://attack.mitre.org/techniques/T1498/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_002_Cloud_Firewall_Opened_To_Amplification_UDP_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a cloud network access-control change (security group, network ACL, NSG or VPC firewall rule) that exposes a UDP service commonly abused for reflection amplification (DNS, NTP, SNMP, CLDAP, SSDP, chargen, memcached) to any source address. Exposing these ports to the internet turns a cloud workload into an open reflector that can be used against third-party victims. The rule fires on the resulting configuration state change, not on any command line."
    mitre_tactic = "Impact"
    mitre_technique = "T1498.002"
    mitre_technique_name = "Network Denial of Service: Reflection Amplification"
    log_prerequisites = "Cloud control-plane audit logs ingested and normalised to UDM SETTING_MODIFICATION for network ACL and firewall changes. The parser must populate metadata.product_event_type, target.port, and the requested rule source range in security_result.description. Verify field population per tenant before enabling."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate public DNS, NTP or VoIP/SNMP-gateway services deployed by platform teams; infrastructure-as-code pipelines rolling out approved public resolvers; lab or sandbox accounts; network engineers temporarily opening ports for troubleshooting."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and IaC or automation identities to %global_allowed_cloud_principals. Adjust the port list to the services the client legitimately exposes. If a client runs public DNS or NTP, scope the exclusions to the owning principals rather than removing the port."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /(AuthorizeSecurityGroupIngress|ModifySecurityGroupRules|CreateNetworkAclEntry|ReplaceNetworkAclEntry|firewalls\.(insert|patch|update)|securityRules\/write|networkSecurityGroups\/write)/ nocase
    (
      $cloud.target.port = 19 or
      $cloud.target.port = 53 or
      $cloud.target.port = 123 or
      $cloud.target.port = 161 or
      $cloud.target.port = 389 or
      $cloud.target.port = 1900 or
      $cloud.target.port = 11211
    )
    $cloud.security_result.description = /(0\.0\.0\.0\/0|::\/0)/
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1498.002")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $exposed_ports = array_distinct($cloud.target.port)
    $changed_resource = array_distinct($cloud.target.resource.name)
    $api_action = array_distinct($cloud.metadata.product_event_type)

  condition:
    $cloud
}
