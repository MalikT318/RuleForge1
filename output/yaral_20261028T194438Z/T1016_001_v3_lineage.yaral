/*
  MITRE Technique : T1016.001 - Internet Connection Discovery
  Tactic(s)       : Discovery
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:45:30.902742+00:00
  Reference       : https://attack.mitre.org/techniques/T1016/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_001_Unexpected_Parent_Spawns_Connectivity_Check {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an Office application, web server, database service, or print spooler process spawning a shell, script host, or network utility that performs an Internet connectivity check (ping, tracert, pathping, nslookup, web request cmdlets, curl). These parents rarely launch connectivity tests in normal operation. The lineage points to post-exploitation discovery, such as a web shell, malicious macro, or database command execution, checking that the host can reach C2."
    mitre_tactic = "Discovery"
    mitre_technique = "T1016.001"
    mitre_technique_name = "System Network Configuration Discovery: Internet Connection Discovery"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with parent process path and child command line populated (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web applications with a legitimate network health-check feature that shells out to ping or curl; database jobs (SQL Agent, xp_cmdshell maintenance scripts) testing connectivity to linked servers or replication partners; Office add-ins or VBA macros that check connectivity before syncing; monitoring or diagnostic plugins hosted in IIS or Tomcat."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts or %global_allowed_admin_tools. Add EDR and AV parents to %global_allowed_security_tools. To narrow the rule on noisy hosts, remove parent families (for example the database services) from the parent regex in a client-specific copy. Raise severity where the parent is w3wp.exe or an Office application."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Unexpected parent: Office, web server, database, or print spooler
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|spoolsv|sqlservr|mysqld|postgres|oracle)\.exe$/ nocase

    // Child: shell, script host, or network diagnostic utility
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|ping|tracert|pathping|nslookup|curl|bitsadmin)\.exe$/ nocase

    // Child is performing connectivity discovery
    $proc.target.process.command_line = /\b(ping|tracert|pathping|nslookup|test-netconnection|test-connection|invoke-webrequest|invoke-restmethod|iwr|curl|wget|bitsadmin|net\.webclient|downloadstring)\b/ nocase

    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1016.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
