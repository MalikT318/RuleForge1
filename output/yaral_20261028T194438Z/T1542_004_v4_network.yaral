/*
  MITRE Technique : T1542.004 - ROMMONkit
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:48:56.206952+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_004_ROMMON_Outbound_TFTP_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects TFTP (port 69) connections crossing the network perimeter to a non-internal destination. Adversaries stage unauthorized ROMMON images on a remote TFTP server and pull them onto a network device before a reload overwrites the boot firmware. TFTP is unauthenticated and unencrypted, and legitimate use almost always stays inside the management network, so any external TFTP session is a strong indicator of a firmware or boot image transfer."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.004"
    mitre_technique_name = "Pre-OS Boot: ROMMONkit"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Egress traffic from the network device management plane must traverse the logging firewall."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Vendor-supported firmware or configuration transfers to an external TFTP server, remote branch devices pulling images from a central site through the perimeter, lab or staging networks, and legacy PXE or provisioning workflows routed through the firewall."
    tuning_guidance = "Add approved management or provisioning source addresses to %global_allowed_mgmt_sources. Keep %rfc1918_internal populated with the customer's internal address space. For branch-to-hub transfers, add the source device addresses to %global_allowed_mgmt_sources after change-control validation. Correlate hits with device reload or boot-variable change events from the device syslog."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    $net.principal.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1542.004")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
