/*
  MITRE Technique : T1688 - Safe Mode Boot
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:35:40.526194+00:00
  Reference       : https://attack.mitre.org/techniques/T1688
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1688_SafeMode_Boot_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, script interpreter or boot/registry utility configuring safe mode boot (BCD safeboot option or SafeBoot registry key) when it was spawned by an unexpected parent: an Office application, web server, print spooler, database service or similar. Legitimate safe mode configuration comes from an administrator shell or management tooling, not from these parents, so the lineage anomaly is the pivot. Removal of the safeboot option (deletevalue) is excluded."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1688"
    mitre_technique_name = "Safe Mode Boot"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and child command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web-based or database-hosted administration and patching tools that legitimately shell out to bcdedit or reg; Office macros in IT-built diagnostic workbooks; vendor recovery or imaging software launched from a service host; security testing and red team exercises."
    tuning_guidance = "Add approved parent processes to %global_allowed_admin_tools, security or EDR agents to %global_allowed_security_tools, and approved script-hosting parents to %global_allowed_script_hosts. Extend the parent regex with environment-specific service hosts if needed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|spoolsv|sqlservr|mysqld|postgres)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(bcdedit|reg|cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /safeboot/ nocase
    not $proc.target.process.command_line = /deletevalue/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1688")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
