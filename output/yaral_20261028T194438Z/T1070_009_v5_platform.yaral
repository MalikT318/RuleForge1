/*
  MITRE Technique : T1070.009 - Clear Persistence
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:13:19.525497+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_009_Linux_Persistence_Artifact_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects deletion of Linux persistence artifacts (cron entries, systemd unit files, init scripts, rc.local, autostart entries, ld.so.preload, authorized_keys) by a process other than a package manager or approved admin tooling. This is file-deletion telemetry, so it catches cleanup done through any binary or API and does not depend on shell command lines."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.009"
    mitre_technique_name = "Indicator Removal: Clear Persistence"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-delete/unlink watches (-w on /etc/cron*, /var/spool/cron, /etc/systemd/system, /etc/init.d, and similar paths) normalised to FILE_DELETION."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package manager installs, upgrades and removals (not excluded when the parent is an unlisted wrapper); configuration management agents rewriting cron or unit files; administrators decommissioning services or running crontab -r; container image build or cleanup processes; user cleanup during account offboarding."
    tuning_guidance = "Add configuration management and deployment binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Add approved scripting parents to %global_allowed_script_hosts. If crontab -r by admins is noisy, allowlist the admin accounts in %global_allowed_admin_users."

  events:
    $file.metadata.event_type = "FILE_DELETION"
    $file.target.file.full_path = /^\/(etc\/(cron\.(d|daily|hourly|weekly|monthly)\/|crontab$|anacrontab$|systemd\/system\/|init\.d\/|rc\.local$|rc[0-6S]\.d\/|ld\.so\.preload$|xdg\/autostart\/)|var\/spool\/cron\/|usr\/lib\/systemd\/system\/|lib\/systemd\/system\/|run\/systemd\/system\/|(home\/[^\/]+|root)\/(\.config\/(autostart|systemd\/user)\/|\.ssh\/authorized_keys$))/ nocase
    not $file.target.file.full_path = /(\.swp|\.swx|~|\/tmp\.[A-Za-z0-9]+)$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|yum|dnf|zypper|snapd|packagekitd|unattended-upgrade|pacman|apk)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1070.009")
    $primary_entity = array_distinct($file.principal.hostname)
    $deleted_paths = array_distinct($file.target.file.full_path)
    $deleting_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
