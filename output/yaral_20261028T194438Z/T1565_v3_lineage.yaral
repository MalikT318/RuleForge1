/*
  MITRE Technique : T1565 - Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:37:13.140618+00:00
  Reference       : https://attack.mitre.org/techniques/T1565
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_Linux_Service_Parent_Spawns_Shell_Data_Manipulation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server or database service process spawning a shell or script interpreter whose command line performs in-place data modification or destruction (sed -i, truncate, shred, dd of=, tee, or output redirection into system, log, data or web content directories). Service processes do not normally launch interpreters to alter files, so this lineage suggests webshell, injection or database-abuse activity manipulating data integrity."
    mitre_tactic = "Impact"
    mitre_technique = "T1565"
    mitre_technique_name = "Data Manipulation"
    log_prerequisites = "Requires Linux EDR or auditd (execve) process telemetry normalised to UDM PROCESS_LAUNCH with populated parent process path, child process path and command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "CMS or application update/deploy hooks run by the web server user, PHP or CGI maintenance scripts rewriting config or cache files, database backup, rotation or maintenance scripts launched from the database service, log rotation helpers triggered by the service, and admin troubleshooting via application consoles."
    tuning_guidance = "Add approved parent binaries or hosts that legitimately run scripts to %global_allowed_script_hosts. Add deployment and configuration tooling to %global_allowed_admin_tools. Extend the parent regex to cover site-specific application servers (e.g. java-based services) if the environment baseline allows it. Narrow the command line regex to critical data directories for noisy hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|php-cgi|tomcat[0-9]*|mysqld|mariadbd|postgres|mongod|redis-server)$/ nocase
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|csh|tcsh|python[0-9.]*|perl|ruby|php[0-9.]*)$/ nocase
    $proc.target.process.command_line = /(\bsed\s+(-[a-z]*i|--in-place)|\btruncate\s|\bshred\s|\bdd\s.*\bof=|\btee\s+(-a\s+)?\/|>>?\s*\/(etc|var\/(log|lib|www|spool)|opt|srv|home|usr\/(local|share))\/)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.hostname in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1565")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
