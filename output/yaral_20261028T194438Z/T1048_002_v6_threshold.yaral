/*
  MITRE Technique : T1048.002 - Exfiltration Over Asymmetric Encrypted Non-C2 Protocol
  Tactic(s)       : Exfiltration
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:37:01.034691+00:00
  Reference       : https://attack.mitre.org/techniques/T1048/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1048_002_Encrypted_Egress_Volume_Single_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source sends multiple large outbound flows (at least 1 MB each) to external destinations over common encrypted ports (HTTPS, SSH/SFTP/SCP, FTPS, alternate HTTPS) within ten minutes. Each flow alone is benign, but repeated bulk uploads over TLS/SSH are consistent with exfiltration over an asymmetrically encrypted protocol."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1048.002"
    mitre_technique_name = "Exfiltration Over Alternative Protocol: Exfiltration Over Asymmetric Encrypted Non-C2 Protocol"
    log_prerequisites = "Requires perimeter firewall or proxy flow logs normalised to UDM NETWORK_FLOW with principal.ip, target.ip, target.port and network.sent_bytes populated. Outbound (egress) traffic from Windows endpoints and servers must traverse the logging device."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Cloud backup and sync clients (OneDrive, SharePoint, other SaaS sync), software and telemetry uploads, video conferencing, offsite backup jobs, developers pushing to remote repositories over SSH or HTTPS, large file uploads by legitimate users."
    tuning_guidance = "Add known-good external destinations to %global_allowed_domains. Add approved scanner or management source addresses to %global_allowed_scanners. Raise the #net threshold or the sent_bytes floor for high-volume egress hosts such as backup servers or proxies. The flow count threshold is conservative by design. Review $total_bytes_sent and $dest_ips in the outcome to triage."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    $net.principal.ip = $src
    (
      $net.target.port = 443 or
      $net.target.port = 22 or
      $net.target.port = 990 or
      $net.target.port = 8443 or
      $net.target.port = 2222
    )
    $net.network.sent_bytes >= 1000000
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1048.002")
    $primary_entity = array_distinct($src)
    $flow_count = count($net.metadata.id)
    $total_bytes_sent = sum($net.network.sent_bytes)
    $dest_ips = array_distinct($net.target.ip)
    $dest_ports = array_distinct($net.target.port)

  condition:
    #net >= 5
}
