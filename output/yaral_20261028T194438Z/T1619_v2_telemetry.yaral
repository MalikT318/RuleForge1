/*
  MITRE Technique : T1619 - Cloud Storage Object Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:42:45.644712+00:00
  Reference       : https://attack.mitre.org/techniques/T1619
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1619_Storage_Inventory_Config_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a configuration change that enables bulk object-inventory or storage-insights reporting on a cloud storage container. An adversary can use this to obtain a full object listing delivered as a report, without issuing object-listing API calls that are commonly not logged (data events are off by default). The rule pivots on the control-plane configuration state change, not on the listing calls themselves."
    mitre_tactic = "Discovery"
    mitre_technique = "T1619"
    mitre_technique_name = "Cloud Storage Object Discovery"
    log_prerequisites = "Cloud control-plane audit logs (management events) normalised to UDM SETTING_MODIFICATION, with metadata.product_event_type and principal.user.userid populated. Data-plane object-level logging is NOT required."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Storage or FinOps teams enabling inventory reports for cost analysis, compliance or lifecycle tooling; backup and DR products creating inventory manifests; infrastructure-as-code pipelines that apply inventory configuration during deployment."
    tuning_guidance = "Add IaC and pipeline identities to %global_allowed_service_accounts, approved storage administrators to %global_allowed_admin_users, and approved automation roles to %global_allowed_cloud_principals. Some parsers map initial inventory creation to SETTING_CREATION; clone this rule with that event type if needed. Raise severity when the destination of the report is in a different account or project."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /(PutBucketInventoryConfiguration|inventoryPolicies\/write|storageinsights\.reportConfigs\.(create|update)|PutStorageLensConfiguration)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1619")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_action = array_distinct($cloud.metadata.product_event_type)
    $target_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
