/*
  MITRE Technique : T1123 - Audio Capture
  Tactic(s)       : Collection
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:28:50.264207+00:00
  Reference       : https://attack.mitre.org/techniques/T1123
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1123_Linux_Audio_Capture_Utility_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects execution of a Linux audio-capture mechanism: a native recorder (ALSA, PulseAudio or PipeWire) started in a capture mode rather than a device listing, or a transcoder or sox-style tool reading from an audio input device (alsa, pulse, oss, jack, pipewire). Matching on the capture behaviour (recorder invocation or input-device flags) rather than a payload means it still fires if a malicious script renames its output file or changes its staging location."
    mitre_tactic = "Collection"
    mitre_technique = "T1123"
    mitre_technique_name = "Audio Capture"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to UDM PROCESS_LAUNCH, with target.process.command_line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Users recording audio or running voice and video calls from a desktop session, podcast or media production workstations, accessibility and speech-recognition tools, audio hardware diagnostics, helpdesk and remote support tooling, kiosk or conferencing-room appliances."
    tuning_guidance = "Add approved recording or support tooling to %global_allowed_remote_mgmt and %global_allowed_admin_tools (matched on parent process path). On media-production or conferencing endpoints, scope the exclusion by parent process. Consider raising severity for headless servers, where audio capture is almost never legitimate."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $proc.target.process.file.full_path = /\/(arecord|aplay-record|parecord|parec|pw-record|pw-cat)$/ nocase and
        not $proc.target.process.command_line = /(\s-(l|L)\b|--list|--help|--version)/ nocase
      ) or
      (
        $proc.target.process.file.full_path = /\/(ffmpeg|avconv)$/ nocase and
        $proc.target.process.command_line = /\s-f\s+(alsa|pulse|oss|jack|pipewire)\b/ nocase
      ) or
      (
        $proc.target.process.file.full_path = /\/(sox|rec)$/ nocase and
        $proc.target.process.command_line = /(\s-d\b|\s-t\s*(alsa|pulseaudio|oss)\b|--default-device)/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1123")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $capture_binary = array_distinct($proc.target.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
