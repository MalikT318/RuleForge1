/*
  MITRE Technique : T1531 - Account Access Removal
  Tactic(s)       : Impact
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:31:21.829100+00:00
  Reference       : https://attack.mitre.org/techniques/T1531
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1531_M365_Password_Reset_By_Other_Account {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a password change or reset on a cloud tenant user account that was performed by a different account than the account owner. Adversaries who compromise a privileged identity can reset user credentials to lock legitimate users out (T1531, Impact) and slow incident response. Self-service password changes are excluded because actor and target match."
    mitre_tactic = "Impact"
    mitre_technique = "T1531"
    mitre_technique_name = "Account Access Removal"
    log_prerequisites = "Microsoft 365 or Google Workspace unified audit logs ingested and normalised to UDM USER_CHANGE_PASSWORD, with principal.user.userid populated for the actor and target.user.userid for the affected account."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Help desk staff resetting forgotten passwords, onboarding and offboarding automation, identity governance tools, bulk password rotation after an approved incident, and delegated admins in managed service arrangements."
    tuning_guidance = "Add help desk and administrator identities to %global_allowed_admin_users. Add identity automation accounts to %global_allowed_service_accounts. Raise severity or add a Threshold variant if many distinct targets are reset by one actor in a short window."

  events:
    $auth.metadata.event_type = "USER_CHANGE_PASSWORD"
    $auth.principal.user.userid != ""
    $auth.target.user.userid != ""
    $auth.principal.user.userid != $auth.target.user.userid
    not $auth.principal.user.userid in %global_allowed_admin_users
    not $auth.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1531")
    $primary_entity = array_distinct($auth.target.user.userid)
    $actor = array_distinct($auth.principal.user.userid)
    $source_ips = array_distinct($auth.principal.ip)

  condition:
    $auth
}
