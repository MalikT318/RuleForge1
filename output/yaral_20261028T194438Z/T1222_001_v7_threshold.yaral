/*
  MITRE Technique : T1222.001 - Windows Permissions
  Tactic(s)       : Defense Impairment
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:19:36.073006+00:00
  Reference       : https://attack.mitre.org/techniques/T1222/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_001_Bulk_File_Permission_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of built-in Windows ACL and ownership modification commands (icacls, cacls, xcacls, takeown) with permission-changing flags on a single host within 10 minutes. A single permission change is routine, but repeated grants, owner changes or resets across many objects suggest an adversary taking control of protected files to evade access controls."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1222.001"
    mitre_technique_name = "File and Directory Permissions Modification: Windows File and Directory Permissions Modification"
    log_prerequisites = "Requires EDR process telemetry, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled, normalised to UDM PROCESS_LAUNCH."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters resetting permissions on install directories, IT deployment and imaging scripts, profile migration or file server migration jobs, RMM tooling, and administrators remediating permission problems in bulk."
    tuning_guidance = "Add approved deployment and RMM parent process paths to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Raise the #proc threshold for noisy environments such as file servers or VDI build hosts. Review the command_lines and users outcome fields to separate admin activity from attacker behaviour."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(icacls|cacls|xcacls|takeown)\.exe$/ nocase
    $proc.target.process.command_line = /(\/grant|\/deny|\/setowner|\/reset|\/inheritance|\/remove|\/f\s)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1222.001")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 5
}
