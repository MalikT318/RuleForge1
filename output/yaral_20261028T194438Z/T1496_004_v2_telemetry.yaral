/*
  MITRE Technique : T1496.004 - Cloud Service Hijacking
  Tactic(s)       : Impact
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:57:32.693401+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_004_Cloud_Service_Enablement_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change in the cloud control plane that enables or expands a resource-intensive messaging or AI/ML service. Examples are granting generative-model access, verifying a new sending identity, enabling sending, raising sending quotas, requesting production sending access, and leaving the SMS sandbox. Adversaries with compromised cloud credentials make these changes before abusing the service for spam, phishing or LLM hijacking. The rule works on the resulting setting change, not on the API client or command line used."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.004"
    mitre_technique_name = "Resource Hijacking: Cloud Service Hijacking"
    log_prerequisites = "Cloud control-plane audit logs (management/admin activity events) ingested and normalised to UDM SETTING_MODIFICATION, with the API/operation name populated in metadata.product_event_type and the caller in principal.user.userid."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate onboarding of a new email sending domain or SMS/notification capability; approved enablement of AI model access by platform or data-science teams; infrastructure-as-code pipelines and provisioning automation; quota increase requests by application owners."
    tuning_guidance = "Add known provisioning pipelines and automation identities to %global_allowed_service_accounts, approved platform or cloud administrators to %global_allowed_admin_users, and approved service principals to %global_allowed_cloud_principals. If your tenant produces very frequent identity verification events, narrow the regex on metadata.product_event_type to the operations relevant to the services in use. Review alerts for first-time callers or callers outside normal business hours."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(model.?access|foundation.?model|email.?identity|verify.?email|verify.?domain|sending.?(enabled|quota|limit|authorization)|production.?access|sms.?sandbox|use.?case.?for.?model)/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1496.004")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $operations = array_distinct($setting.metadata.product_event_type)
    $target_resources = array_distinct($setting.target.resource.name)
    $source_ips = array_distinct($setting.principal.ip)

  condition:
    $setting
}
