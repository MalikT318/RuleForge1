/*
  MITRE Technique : T1574.001 - DLL
  Tactic(s)       : Stealth, Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:28:31.288255+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_001_DLL_Dropped_Then_Loaded_From_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A DLL is written to a user-writable directory (AppData, ProgramData, Users\\Public, Windows\\Temp) by one process, and within 10 minutes a different process running from a user-writable path loads that same DLL. This pattern is typical of DLL side-loading, where a legitimate executable is staged alongside a planted DLL. The rule uses file-creation and module-load telemetry rather than command-line matching."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.001"
    mitre_technique_name = "Hijack Execution Flow: DLL"
    log_prerequisites = "Requires EDR or Sysmon-equivalent telemetry with FILE_CREATION (Sysmon EID 11) and PROCESS_MODULE_LOAD (Sysmon EID 7) events populated with full file paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-user application installers and auto-updaters (collaboration clients, browsers, cloud storage sync clients), software deployment tools staging DLLs in ProgramData, developer build output in AppData, and portable applications run from user profiles."
    tuning_guidance = "Add approved deployment and installer processes to %global_allowed_admin_tools, and EDR/AV agents to %global_allowed_security_tools. Review recurring benign loader executables and allowlist them through the reference lists. If noise is high, add a filter on the dropper process path or restrict to hosts outside your software-packaging groups."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\[^\\]+\\appdata\\|programdata\\|users\\public\\|windows\\temp\\).*\.dll$/ nocase
    $file.target.file.full_path = $dllpath
    $file.principal.hostname = $hostname
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

    $mod.metadata.event_type = "PROCESS_MODULE_LOAD"
    $mod.target.file.full_path = $dllpath
    $mod.principal.hostname = $hostname
    $mod.principal.process.file.full_path = /\\(users\\[^\\]+\\appdata\\|programdata\\|users\\public\\|windows\\temp\\).*\.exe$/ nocase
    not $mod.principal.process.file.full_path in %global_allowed_security_tools
    not $mod.principal.process.file.full_path in %global_allowed_admin_tools
    $mod.principal.process.file.full_path != $file.principal.process.file.full_path

    $file.metadata.event_timestamp.seconds <= $mod.metadata.event_timestamp.seconds

  match:
    $hostname, $dllpath over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1574.001")
    $primary_entity = array_distinct($hostname)
    $dropped_dll = array_distinct($dllpath)
    $dropper_process = array_distinct($file.principal.process.file.full_path)
    $loader_process = array_distinct($mod.principal.process.file.full_path)
    $dropper_user = array_distinct($file.principal.user.userid)

  condition:
    $file and $mod
}
