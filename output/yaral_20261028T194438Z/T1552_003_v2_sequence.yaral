/*
  MITRE Technique : T1552.003 - Shell History
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:48:48.684364+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_003_Linux_Shell_History_Read_Then_External_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A non-shell process reads a user's shell history file (bash, zsh, sh, ash or fish), and within 10 minutes the same user on the same host makes an external connection from a transfer-capable utility. This pattern suggests harvesting credentials typed on the command line followed by exfiltration or staging to remote infrastructure. It adds file-access and network sequence coverage beyond command-line matching on process creation."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.003"
    mitre_technique_name = "Unsecured Credentials: Shell History"
    log_prerequisites = "Requires Linux EDR or auditd file-read telemetry (watches on history files, normalised to FILE_READ) and network connection telemetry with process attribution, both populating principal.hostname and principal.user.userid."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup agents or configuration-management tools that read home directories and then contact external endpoints; administrators who review their own history and use curl or scp shortly afterwards; EDR or DLP agents scanning home directories; software that reads history files for shell-integration features."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes and EDR or DLP agents to %global_allowed_security_tools. Add approved transfer or automation tooling to %global_allowed_admin_tools and approved service accounts to %global_allowed_service_accounts. Extend the history file regex if the environment uses other shells."

  events:
    $read.metadata.event_type = "FILE_READ"
    $read.target.file.full_path = /\/(\.bash_history|\.zsh_history|\.sh_history|\.ash_history|fish_history)$/ nocase
    not $read.principal.process.file.full_path = /\/(bash|zsh|sh|dash|ash|fish|ksh|login|sshd|su|sudo)$/ nocase
    not $read.principal.process.file.full_path in %global_allowed_backup_processes
    not $read.principal.process.file.full_path in %global_allowed_security_tools
    not $read.principal.user.userid in %global_allowed_service_accounts
    $read.principal.hostname = $hostname
    $read.principal.user.userid = $user

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(curl|wget|nc|ncat|netcat|socat|scp|sftp|ftp|openssl|python[0-9.]*|perl|ruby)$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    $net.principal.hostname = $hostname
    $net.principal.user.userid = $user

    $read.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1552.003")
    $primary_entity = array_distinct($hostname)
    $affected_user = array_distinct($user)
    $history_files = array_distinct($read.target.file.full_path)
    $reader_processes = array_distinct($read.principal.process.file.full_path)
    $transfer_processes = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $connection_count = count($net.metadata.id)

  condition:
    $read and $net
}
