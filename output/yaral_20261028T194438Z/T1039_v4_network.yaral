/*
  MITRE Technique : T1039 - Data from Network Shared Drive
  Tactic(s)       : Collection
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:25:34.658260+00:00
  Reference       : https://attack.mitre.org/techniques/T1039
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1039_SMB_Share_Access_From_Interpreter_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an SMB (TCP/445) connection to an internal file server initiated by a command interpreter, script host or file-copy utility. This is the network-side footprint of an adversary browsing or collecting data from network shares with cmd, PowerShell, WSH or robocopy-style tooling. The rule deliberately uses %rfc1918_internal as an inclusion list (target must be internal), because shared drives are internal assets. SMB to external addresses is a different behaviour and is not covered here."
    mitre_tactic = "Collection"
    mitre_technique = "T1039"
    mitre_technique_name = "Data from Network Shared Drive"
    log_prerequisites = "Requires Windows endpoint network telemetry that attributes outbound connections to the initiating process (EDR or Sysmon Event ID 3 normalised to NETWORK_CONNECTION). If the telemetry only attributes SMB to the System process, this rule will not fire."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Logon scripts and GPO startup scripts mapping drives, admins using PowerShell or robocopy against file servers, IT automation and software deployment scripts, user-run batch files that copy from team shares, backup or migration jobs."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools, %global_allowed_backup_processes or %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Add approved management or file-server source addresses to %global_allowed_mgmt_sources. Raise severity for servers and high-value workstations. Pair with the endpoint-side variants of T1039 for corroboration."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 445
    $net.principal.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|wmic|robocopy|xcopy|forfiles)\.exe$/ nocase
    $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.principal.process.file.full_path in %global_allowed_script_hosts
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.user.userid in %global_allowed_admin_users
    not $net.target.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1039")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_user = array_distinct($net.principal.user.userid)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $share_server_ips = array_distinct($net.target.ip)

  condition:
    $net
}
