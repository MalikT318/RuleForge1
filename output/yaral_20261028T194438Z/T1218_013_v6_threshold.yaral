/*
  MITRE Technique : T1218.013 - Mavinject
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:00:12.867882+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_013_Mavinject_Repeated_Injection_Activity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated process-injection events originating from the Microsoft Application Virtualization Injector (mavinject) on a single host within ten minutes. A single injection can occur in App-V workflows, but repeated injections into one or more processes indicate DLL injection or import descriptor injection abuse. This rule uses process-injection telemetry rather than process-creation command lines, so it complements command-line rules."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.013"
    mitre_technique_name = "System Binary Proxy Execution: Mavinject"
    log_prerequisites = "Requires endpoint telemetry that reports cross-process injection or remote-thread events (EDR or Sysmon-equivalent) normalised to PROCESS_INJECTION, with the injecting process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Microsoft App-V client operations, application virtualization deployment or sequencing by IT, and authorised red-team or security testing."
    tuning_guidance = "Add App-V administrator and service accounts to %global_allowed_admin_users or %global_allowed_service_accounts. Add approved security or EDR target processes to %global_allowed_security_tools. Raise the #inj threshold on hosts that run App-V heavily. Lower it to 2 for high-value servers."

  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.process.file.full_path = /\\mavinject(32)?\.exe$/ nocase
    $inj.principal.hostname = $host
    not $inj.principal.user.userid in %global_allowed_admin_users
    not $inj.principal.user.userid in %global_allowed_service_accounts
    not $inj.target.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.013")
    $primary_entity = array_distinct($host)
    $injection_count = count($inj.metadata.id)
    $injected_processes = array_distinct($inj.target.process.file.full_path)
    $injected_pids = array_distinct($inj.target.process.pid)
    $injecting_users = array_distinct($inj.principal.user.userid)

  condition:
    #inj >= 3
}
