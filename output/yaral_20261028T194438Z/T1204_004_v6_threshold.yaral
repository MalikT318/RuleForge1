/*
  MITRE Technique : T1204.004 - Malicious Copy and Paste
  Tactic(s)       : Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:05:34.905031+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_004_ClickFix_Scripted_Client_Outbound_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of outbound web requests from a single Windows host made with the user-agent of a command-line or scripting HTTP client (PowerShell, curl, wget, certutil, BITS) to external, non-allowlisted destinations within ten minutes. After a ClickFix-style paste-and-run lure, the pasted command typically pulls a payload or stager from attacker infrastructure. Each request alone is benign; the volume from scripted clients to external hosts is the signal. This is a network-side detection and complements process command-line rules."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.004"
    mitre_technique_name = "User Execution: Malicious Copy and Paste"
    log_prerequisites = "Requires proxy or firewall logs with HTTP inspection that populate the client user-agent (network.http.user_agent), destination hostname or IP, and the source hostname. TLS inspection is needed to see user-agents on HTTPS traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Admin or IT automation scripts that download content, software package managers and update scripts using PowerShell or curl, developer workstations, RMM and patching jobs, and monitoring scripts calling external APIs."
    tuning_guidance = "Add known-good vendor, CDN and update domains to %global_allowed_domains. Add approved scanner or automation hosts to %global_allowed_scanners. Raise the #http threshold on developer or build-server segments. If the firewall does not populate principal.hostname, map the source IP to a hostname during ingestion."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.user_agent = /(WindowsPowerShell|PowerShell|^curl\/|^Wget\/|CertUtil|Microsoft BITS)/ nocase
    $http.target.hostname != ""
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_scanners
    $http.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($http.metadata.id)
    $mitre_technique_id = array_distinct("T1204.004")
    $primary_entity = array_distinct($host)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    #http >= 5
}
