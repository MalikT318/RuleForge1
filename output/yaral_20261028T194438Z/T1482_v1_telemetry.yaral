/*
  MITRE Technique : T1482 - Domain Trust Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:28:33.263439+00:00
  Reference       : https://attack.mitre.org/techniques/T1482
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1482_Trust_Enumeration_Output_File_Staged {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a trust-enumeration output file (a data file whose name carries a 'trust' or 'trusts' token) in a user-writable or staging location, written by a shell or scripting interpreter. This catches the file artifact left by domain trust discovery (redirected native utility output, script or .NET/LDAP collector results) even when command-line logging is evaded or obfuscated."
    mitre_tactic = "Discovery"
    mitre_technique = "T1482"
    mitre_technique_name = "Domain Trust Discovery"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Domain migration or consolidation projects, AD health-check and audit scripts run by administrators, IT documentation exports, security assessment and purple-team exercises, and backup or reporting scripts that write 'trust' named report files."
    tuning_guidance = "Add approved admin tooling and audit scripts to %global_allowed_admin_tools, approved script hosts to %global_allowed_script_hosts, and named administrators to %global_allowed_admin_users. Add authorised assessment accounts to %global_allowed_service_accounts. To widen coverage, add more data extensions to the filename regex; to cut noise, narrow the staging path regex."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $file.target.file.full_path = /\\([^\\]*[_. -])?trusts?([_. -][^\\]*)?\.(txt|csv|json|xml|log|out|dat|zip)$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|programdata|windows\\temp|users\\public|temp)\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1482")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
