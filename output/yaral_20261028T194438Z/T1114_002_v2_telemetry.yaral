/*
  MITRE Technique : T1114.002 - Remote Email Collection
  Tactic(s)       : Collection
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:19:45.041361+00:00
  Reference       : https://attack.mitre.org/techniques/T1114/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_002_Mailbox_Access_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change in the identity/directory audit trail that grants or enables remote access to mailbox content. Examples are full-access or folder delegation, mailbox forwarding or redirect settings, inbox rules that forward or redirect, and application consent to mail-read scopes. This works at the configuration-state layer rather than the command-line layer, so it still fires if endpoint command-line logging is evaded."
    mitre_tactic = "Collection"
    mitre_technique = "T1114.002"
    mitre_technique_name = "Email Collection: Remote Email Collection"
    log_prerequisites = "Requires identity provider / directory audit logs and mailbox audit logs (admin and delegate operations) ingested and normalised to UDM SETTING_MODIFICATION, with the operation name populated in metadata.product_event_type."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Helpdesk granting shared mailbox or delegate access, onboarding/offboarding forwarding to a manager, migration tooling, approved third-party mail apps consented by admins, executive assistants delegation."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users, and migration or provisioning identities to %global_allowed_service_accounts and %global_allowed_cloud_principals. If the tenant maps these operations to a different event type, create a sibling rule for that type rather than widening this one."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(add-mailboxpermission|add-mailboxfolderpermission|add-recipientpermission|set-mailbox$|new-inboxrule|set-inboxrule|update-inboxrule|new-transportrule|set-transportrule|consent to application|add app role assignment|add delegated permission grant)/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1114.002")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $operations = array_distinct($setting.metadata.product_event_type)
    $affected_mailboxes = array_distinct($setting.target.user.userid)
    $source_ips = array_distinct($setting.principal.ip)

  condition:
    $setting
}
