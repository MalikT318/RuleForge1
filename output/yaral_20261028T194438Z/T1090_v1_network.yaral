/*
  MITRE Technique : T1090 - Proxy
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:24:34.920928+00:00
  Reference       : https://attack.mitre.org/techniques/T1090
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1090_Outbound_Proxy_Service_Port_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a perimeter-observed connection from an internal host to an external destination on a port typically used by proxy or anonymising relay services (SOCKS, Squid-style HTTP proxy, Privoxy, Tor client/SOCKS). Adversaries use external proxies or relays to hide command and control infrastructure. This rule works from the network side and does not depend on endpoint process telemetry."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1090"
    mitre_technique_name = "Proxy"
    log_prerequisites = "Firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Corporate or sanctioned cloud web-proxy and secure web gateway services listening on common proxy ports, developers or researchers using SOCKS or Tor intentionally, privacy-focused users, vendor update services that use port 3128 or 1080, and security testing tools."
    tuning_guidance = "Add known-good external proxy or gateway domains to %global_allowed_domains. Add approved scanner or testing sources to the exclusion list in your tenant by extending the reference list used here. If the environment legitimately uses an external proxy on one of these ports, remove that port from the rule for that client rather than excluding the source host. Review the destination_ports and destination_ips outcome values for triage."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 1080 or
      $net.target.port = 1081 or
      $net.target.port = 3128 or
      $net.target.port = 8118 or
      $net.target.port = 9050 or
      $net.target.port = 9150
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1090")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
