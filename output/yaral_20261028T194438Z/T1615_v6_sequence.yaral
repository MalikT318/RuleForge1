/*
  MITRE Technique : T1615 - Group Policy Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:42:06.805355+00:00
  Reference       : https://attack.mitre.org/techniques/T1615
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1615_GPO_Discovery_LDAP_Then_SYSVOL_SMB {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects one internal source making repeated directory (LDAP/Global Catalog) connections to a domain controller and then repeated SMB connections to the same server within 10 minutes. This is the network footprint of Group Policy discovery: enumerating GPO and gPLink objects over LDAP, then reading policy files from the SYSVOL share over SMB. Typical tooling is gpresult /h, Get-DomainGPO and similar enumeration frameworks."
    mitre_tactic = "Discovery"
    mitre_technique = "T1615"
    mitre_technique_name = "Group Policy Discovery"
    log_prerequisites = "Requires firewall connection logs normalised to NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. The firewall must see east-west traffic between client/server segments and domain controllers (internal segmentation or datacenter firewall). A pure internet-edge perimeter will not see this behaviour."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Normal domain-joined client startup, logon and gpupdate cycles; domain-join and provisioning workflows; AD health, audit and inventory tooling; vulnerability scanners; helpdesk staff running gpresult; identity-management sync servers."
    tuning_guidance = "Add approved scanner and management source addresses to %global_allowed_scanners and %global_allowed_mgmt_sources. Raise the #ldap and #smb thresholds in the condition if client subnets with heavy logon churn (VDI, terminal servers) are noisy. Scope the rule to server, admin or DMZ segments rather than user workstation VLANs where possible."

  events:
    $ldap.metadata.event_type = "NETWORK_CONNECTION"
    ($ldap.target.port = 389 or $ldap.target.port = 636 or $ldap.target.port = 3268 or $ldap.target.port = 3269)
    $ldap.principal.ip = $src_ip
    $ldap.target.ip = $dc_ip
    not $ldap.principal.ip in %global_allowed_scanners
    not $ldap.principal.ip in %global_allowed_mgmt_sources

    $smb.metadata.event_type = "NETWORK_CONNECTION"
    $smb.target.port = 445
    $smb.principal.ip = $src_ip
    $smb.target.ip = $dc_ip
    not $smb.principal.ip in %global_allowed_scanners
    not $smb.principal.ip in %global_allowed_mgmt_sources

    $ldap.metadata.event_timestamp.seconds <= $smb.metadata.event_timestamp.seconds

  match:
    $src_ip, $dc_ip over 10m

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1615")
    $primary_entity = array_distinct($src_ip)
    $directory_server = array_distinct($dc_ip)
    $ldap_ports = array_distinct($ldap.target.port)
    $ldap_connection_count = count($ldap.metadata.id)
    $smb_connection_count = count($smb.metadata.id)
    $first_seen = min($ldap.metadata.event_timestamp.seconds)
    $last_seen = max($smb.metadata.event_timestamp.seconds)

  condition:
    $ldap and $smb and #ldap >= 3 and #smb >= 3
}
