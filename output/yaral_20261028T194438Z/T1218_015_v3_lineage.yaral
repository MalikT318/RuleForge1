/*
  MITRE Technique : T1218.015 - Electron Applications
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:02:41.854096+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_015_Electron_App_Spawns_Shell_Or_LOLBin {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a script interpreter or living-off-the-land binary launched as a direct child of an Electron-hosted application (collaboration and messaging clients) or a Chromium-based browser. These apps rarely spawn shells in normal use. A shell child suggests Electron abuse, such as a malicious --gpu-launcher argument, planted JavaScript with Node.js child_process access, or a tampered application package. The rule keys on process lineage, not command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.015"
    mitre_technique_name = "System Binary Proxy Execution: Electron Applications"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with parent process path populated (EDR or Sysmon Event ID 1, or Security Event 4688 with parent process name)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developer tools hosted in Electron that legitimately open terminals (code editors, API clients, Git GUIs); browser native-messaging hosts or enterprise extensions implemented as batch or PowerShell scripts; collaboration-app plugins or deployment scripts that launch helper scripts; IT support sessions in which an admin launches a shell from an Electron-based remote tool."
    tuning_guidance = "Add approved parent application paths to %global_allowed_script_hosts and sanctioned IT tooling to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. If developer workstations are noisy, add the code-editor parent path to %global_allowed_script_hosts. Extend or narrow the parent regex to match the Electron applications deployed at the client."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(ms-teams|teams|slack|signal|discord|whatsapp|notion|chrome|msedge)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1218.015")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
