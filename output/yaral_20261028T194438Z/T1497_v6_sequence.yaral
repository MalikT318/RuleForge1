/*
  MITRE Technique : T1497 - Virtualization/Sandbox Evasion
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:00:32.945874+00:00
  Reference       : https://attack.mitre.org/techniques/T1497
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_VM_Artifact_Query_Then_Sleep_Delay {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a command-line query for virtualization artifacts (registry, WMI or CIM lookups for hypervisor, BIOS or VM tool indicators) followed on the same host within 10 minutes by a sleep or delay command (long ping, timeout or Start-Sleep). This pairing is typical of malware that fingerprints a VM or sandbox and then stalls to outlast automated analysis."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1497"
    mitre_technique_name = "Virtualization/Sandbox Evasion"
    log_prerequisites = "Requires Windows EDR or Sysmon process-creation telemetry with full command lines (Sysmon Event ID 1 or Windows Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Hardware or VM inventory scripts, RMM and asset-management agents, VDI image build and golden-image scripts, administrators checking VM tools state, installer scripts that query for a hypervisor and then wait on a delay."
    tuning_guidance = "Add approved inventory and RMM binaries to %global_allowed_admin_tools, EDR and AV agents to %global_allowed_security_tools, and trusted script parent processes to %global_allowed_script_hosts. Exclude VDI build hosts at the client level. Raise the sleep duration threshold in the delay regex if noisy."

  events:
    $recon.metadata.event_type = "PROCESS_LAUNCH"
    $recon.target.process.file.full_path = /\\(reg|wmic|powershell|pwsh|cmd)\.exe$/ nocase
    $recon.target.process.command_line = /(reg(\.exe)?\s+query|wmic|get-wmiobject|get-ciminstance|gwmi|win32_(computersystem|bios|baseboard|diskdrive))/ nocase
    $recon.target.process.command_line = /(vmware|vbox|virtualbox|qemu|vmtoolsd|vmware tools|hyper-v|xen|parallels|systembiosversion|vboxservice|vmmouse|vmhgfs)/ nocase
    not $recon.principal.process.file.full_path in %global_allowed_admin_tools
    not $recon.principal.process.file.full_path in %global_allowed_security_tools
    $recon.principal.hostname = $hostname

    $delay.metadata.event_type = "PROCESS_LAUNCH"
    $delay.target.process.file.full_path = /\\(ping|timeout|powershell|pwsh)\.exe$/ nocase
    $delay.target.process.command_line = /(ping(\.exe)?\s+(-n|\/n)\s+\d{2,}|timeout(\.exe)?\s+\/t\s+\d{2,}|start-sleep\s+(-s(econds)?\s+)?\d{2,})/ nocase
    not $delay.principal.process.file.full_path in %global_allowed_script_hosts
    not $delay.principal.process.file.full_path in %global_allowed_admin_tools
    $delay.principal.hostname = $hostname

    $recon.metadata.event_timestamp.seconds <= $delay.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1497")
    $primary_entity = array_distinct($hostname)
    $recon_commands = array_distinct($recon.target.process.command_line)
    $delay_commands = array_distinct($delay.target.process.command_line)
    $users = array_distinct($recon.principal.user.userid)
    $recon_event_count = count($recon.metadata.id)

  condition:
    $recon and $delay
}
