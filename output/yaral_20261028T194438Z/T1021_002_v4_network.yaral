/*
  MITRE Technique : T1021.002 - SMB/Windows Admin Shares
  Tactic(s)       : Lateral Movement
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:37:02.369561+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_002_SMB_Connection_From_NonSystem_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an SMB (TCP/445) connection initiated by a user-mode process. On Windows, native SMB client activity such as net use, file copy to admin shares, and remote service or task creation is carried by the kernel (System) process. A user-mode process opening its own socket to 445 usually means a custom or third-party SMB client, such as a scripted or compiled lateral-movement tool, an SMB scanner, or a relayed or injected process. The rule is network-side and does not depend on command-line content."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.002"
    mitre_technique_name = "Remote Services: SMB/Windows Admin Shares"
    log_prerequisites = "Requires endpoint network-connection telemetry that records the initiating process (EDR or Sysmon Event ID 3 equivalent) normalised to NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and imaging agents that speak SMB directly, vulnerability scanners and asset-inventory tools, RMM and software-deployment agents, third-party file-sync clients, and EDR agents that probe shares. Browsers or Office applications opening UNC paths in some configurations may also fire."
    tuning_guidance = "Add approved SMB-speaking binaries to %global_allowed_admin_tools, %global_allowed_backup_processes, %global_allowed_remote_mgmt or %global_allowed_security_tools. Add scanner hosts to %global_allowed_scanners and approved destination file servers or management sources to %global_allowed_mgmt_sources. This rule intentionally does not exclude internal address space, because lateral movement over SMB is internal-to-internal. If a client wants to cut noise from known file servers, put them in %global_allowed_mgmt_sources."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 445
    $net.principal.process.file.full_path != ""
    not $net.principal.process.file.full_path = /(^System$|\\ntoskrnl\.exe$)/ nocase
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.hostname in %global_allowed_scanners
    not $net.target.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1021.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
