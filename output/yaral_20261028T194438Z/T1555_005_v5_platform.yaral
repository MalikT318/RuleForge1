/*
  MITRE Technique : T1555.005 - Password Managers
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:00:12.866986+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_005_Linux_Password_Vault_Staged_To_Temp_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a password manager vault database or credential export (KeePass-family, Password Safe, 1Password, or Bitwarden/LastPass/Dashlane exports) inside a world-writable Linux staging directory (/tmp, /var/tmp, /dev/shm). Legitimate vaults live in user home or application data directories, so a copy in a temp location suggests staging for exfiltration or offline cracking. Uses file-creation telemetry rather than process command lines, so it complements command-line rules."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.005"
    mitre_technique_name = "Credentials from Password Stores: Password Managers"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-creation events normalised to UDM FILE_CREATION with target.file.full_path and principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Users exporting or converting a vault via a temp directory, backup or sync agents staging files in /tmp, helpdesk migrations between password managers, and password manager applications writing temporary copies during save or sync."
    tuning_guidance = "Add approved backup and imaging process paths to %global_allowed_backup_processes, EDR and security agents to %global_allowed_security_tools, and IT tooling to %global_allowed_admin_tools. Add named administrators to %global_allowed_admin_users if they routinely migrate vaults. Raise severity if the creating process is a shell, scripting interpreter, or network utility."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    (
      $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/(.*\/)?[^\/]+\.(kdbx?|psafe3|opvault|agilekeychain|1pif|1pux)$/ nocase or
      $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/(.*\/)?[^\/]*(bitwarden|lastpass|dashlane|1password|keepass)[^\/]*\.(json|csv|xml)$/ nocase
    )
    $file.principal.hostname = $hostname
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1555.005")
    $primary_entity = array_distinct($hostname)
    $staged_files = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    $file
}
