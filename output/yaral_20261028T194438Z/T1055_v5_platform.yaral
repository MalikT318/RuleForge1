/*
  MITRE Technique : T1055 - Process Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:44:57.659051+00:00
  Reference       : https://attack.mitre.org/techniques/T1055
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_Linux_Proc_Mem_Write_Injection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process writing to another process's memory through the procfs interface (/proc/<pid>/mem or /proc/<pid>/task/<tid>/mem). This is the Linux 'Proc Memory' injection technique. It needs no ptrace-based injector binary and does not depend on command-line content. The regex requires a numeric PID, so writes through /proc/self/mem are not matched."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055"
    mitre_technique_name = "Process Injection"
    log_prerequisites = "Requires Linux EDR file telemetry, or auditd watch rules on writes to /proc/*/mem, normalised to UDM FILE_MODIFICATION events with principal.process and target.file.full_path populated. Default auditd configurations do not capture these writes."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Debuggers (gdb, lldb) attaching to and patching live processes, live-patching and instrumentation or profiling agents, crash-dump and forensic tooling, some language runtime debug and hot-reload features, and EDR or security agents inspecting memory."
    tuning_guidance = "Add approved debuggers, profilers and instrumentation binaries to %global_allowed_admin_tools. Add EDR or security agent binaries to %global_allowed_security_tools. Add approved automation accounts to %global_allowed_service_accounts. On developer or build hosts, consider scoping to production server groups, or raise the allowlist to cover debuggers."

  events:
    $proc_mem.metadata.event_type = "FILE_MODIFICATION"
    $proc_mem.target.file.full_path = /^\/proc\/[0-9]+(\/task\/[0-9]+)?\/mem$/ nocase
    $proc_mem.principal.process.file.full_path != ""
    not $proc_mem.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc_mem.principal.process.file.full_path in %global_allowed_security_tools
    not $proc_mem.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055")
    $primary_entity = array_distinct($proc_mem.principal.hostname)
    $writer_process = array_distinct($proc_mem.principal.process.file.full_path)
    $writer_user = array_distinct($proc_mem.principal.user.userid)
    $victim_mem_path = array_distinct($proc_mem.target.file.full_path)

  condition:
    $proc_mem
}
