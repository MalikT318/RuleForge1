/*
  MITRE Technique : T1048.002 - Exfiltration Over Asymmetric Encrypted Non-C2 Protocol
  Tactic(s)       : Exfiltration
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:36:44.345125+00:00
  Reference       : https://attack.mitre.org/techniques/T1048/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1048_002_ESXi_Firewall_Outbound_Ruleset_Enabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a host firewall configuration change on an ESXi host that enables an outbound encrypted-transfer ruleset (sshClient, i.e. outbound SSH/SCP/SFTP) or sets the firewall to allow all connections. ESXi blocks outbound SSH by default, so opening it is a common precursor to exfiltrating datastore or VM data over an asymmetrically encrypted protocol. This is a host configuration (SETTING_MODIFICATION) detection and does not rely on process command lines."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1048.002"
    mitre_technique_name = "Exfiltration Over Alternative Protocol: Exfiltration Over Asymmetric Encrypted Non-C2 Protocol"
    log_prerequisites = "ESXi hostd logs forwarded and parsed to UDM, including firewall ruleset change messages (for example 'Firewall configuration has changed. Operation enable for rule set sshClient succeeded'), normalised as SETTING_MODIFICATION."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators temporarily enabling outbound SSH for host-to-host migration, support or log collection; configuration management or host profile remediation re-applying firewall rulesets; backup or replication jobs that need outbound SSH/SFTP; initial host build and provisioning."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and automation or lifecycle accounts to %global_allowed_service_accounts. If a client legitimately runs host-to-host SCP, review the change window and keep the ruleset enabled only for the duration of the activity. Correlate with SSH login events on the same host for triage."

  events:
    $set.metadata.event_type = "SETTING_MODIFICATION"
    (
      $set.metadata.description = /firewall.{0,80}(rule\s?set|ruleset).{0,80}(sshClient|allowedAll)/ nocase or
      $set.metadata.description = /firewall.{0,80}(enable|allowed\s?all).{0,80}(sshClient|allowedAll|all\s+ips)/ nocase or
      $set.security_result.summary = /firewall.{0,80}(rule\s?set|ruleset).{0,80}(sshClient|allowedAll)/ nocase
    )
    $set.metadata.description != /(disable|disabled|removed|closed)\s+for\s+rule\s?set/ nocase
    not $set.principal.user.userid in %global_allowed_admin_users
    not $set.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1048.002")
    $primary_entity = array_distinct(strings.coalesce($set.principal.hostname, $set.target.hostname))
    $acting_user = array_distinct($set.principal.user.userid)

  condition:
    $set
}
