/*
  MITRE Technique : T1027.001 - Binary Padding
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:38:54.067894+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_001_Linux_Staged_Binary_Padded_By_Native_Utility {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a file-modification event in a world-writable Linux staging directory (/tmp, /var/tmp, /dev/shm) against an extensionless or binary-style file, where the writing process is a native padding utility (dd, truncate, fallocate). Appending junk bytes or extending an executable with these utilities is the standard way to pad a Linux payload so its hash changes and it exceeds scanner size limits. The rule keys on the file-modification event and the staging location, not on command-line content, so it complements existing process command-line rules."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.001"
    mitre_technique_name = "Obfuscated Files or Information: Binary Padding"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd (PATH/SYSCALL records) normalised to UDM FILE_MODIFICATION with principal.process.file.full_path and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers and admins creating test or benchmark files with dd/truncate/fallocate in /tmp; installers and build jobs that preallocate extensionless scratch files; swap or disk-image creation scripts; CI runners; backup or imaging jobs."
    tuning_guidance = "Add approved tooling binaries to %global_allowed_admin_tools and automation or build accounts to %global_allowed_service_accounts. Extend the path regex if the client uses other staging locations. Raise severity for servers where /tmp should never hold executables."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/(.*\/)?([^\/.]+|[^\/]+\.(elf|bin|so|out))$/ nocase
    $file.principal.process.file.full_path = /(^|\/)(dd|truncate|fallocate)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1027.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $padding_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
