/*
  MITRE Technique : T1036.005 - Match Legitimate Resource Name or Location
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:04:32.684233+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_005_Container_SystemMimic_Resource_Then_Exec {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A non-allowlisted identity creates a Kubernetes resource named like a core cluster component (kube-proxy, coredns, etcd, CNI or node agents), then execs or attaches into a workload with a similar name within 10 minutes. This pattern is typical of backdoor workloads that masquerade as system components, as seen in Kubernetes backdoor campaigns."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.005"
    mitre_technique_name = "Masquerading: Match Legitimate Resource Name or Location"
    log_prerequisites = "Requires Kubernetes audit logs (or equivalent container control-plane logs) ingested with create and exec/attach API calls normalised to RESOURCE_CREATION and USER_RESOURCE_ACCESS, with principal.user.userid, target.resource.name and target.url populated."
    platform = "Containers"
    log_source = "container"
    false_positives = "Cluster bootstrap or upgrade tooling (kubeadm, managed-cluster add-on installers), GitOps controllers deploying CNI, DNS or metrics add-ons under a human or unlisted service identity, platform engineers debugging system add-ons with kubectl exec."
    tuning_guidance = "Add CI/CD, GitOps and cluster-lifecycle identities to %global_allowed_service_accounts. Add platform engineers to %global_allowed_admin_users. Add managed cloud control-plane identities to %global_allowed_cloud_principals. Extend the component-name regex to match add-ons used in your environment."

  events:
    $create.metadata.event_type = "RESOURCE_CREATION"
    $create.target.resource.name = /^(kube-(proxy|apiserver|controller-manager|scheduler|dns|system|state-metrics)|coredns|etcd|kubelet|calico-node|cilium|aws-node|azure-ip-masq-agent|metrics-server|node-exporter|csi-node|istiod)([-.][a-z0-9]+)*$/ nocase
    $create.principal.user.userid != ""
    not $create.principal.user.userid in %global_allowed_service_accounts
    not $create.principal.user.userid in %global_allowed_admin_users
    not $create.principal.user.userid in %global_allowed_cloud_principals
    $create.principal.user.userid = $user

    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.target.url = /\/(exec|attach)(\?|$)/ nocase
    $access.target.resource.name = /^(kube-(proxy|apiserver|controller-manager|scheduler|dns|system|state-metrics)|coredns|etcd|kubelet|calico-node|cilium|aws-node|azure-ip-masq-agent|metrics-server|node-exporter|csi-node|istiod)([-.][a-z0-9]+)*$/ nocase
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_admin_users
    not $access.principal.user.userid in %global_allowed_cloud_principals
    $access.principal.user.userid = $user

    $create.metadata.event_timestamp.seconds <= $access.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1036.005")
    $primary_entity = array_distinct($user)
    $created_resources = array_distinct($create.target.resource.name)
    $accessed_resources = array_distinct($access.target.resource.name)
    $access_urls = array_distinct($access.target.url)
    $create_count = count($create.metadata.id)

  condition:
    $create and $access
}
