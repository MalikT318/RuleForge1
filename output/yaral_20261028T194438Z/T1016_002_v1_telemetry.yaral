/*
  MITRE Technique : T1016.002 - Wi-Fi Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:46:39.092580+00:00
  Reference       : https://attack.mitre.org/techniques/T1016/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_002_WiFi_Profile_Export_File_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of an exported Windows WLAN profile XML file, the file artifact left when saved Wi-Fi profiles (SSIDs and, with key=clear, plaintext keys) are exported. Matches either the default export naming convention (Wi-Fi-<SSID>.xml or Wireless Network Connection-<SSID>.xml) or an XML file written by the Windows network shell binary. Works at the file-artifact layer, so it does not depend on command-line logging."
    mitre_tactic = "Discovery, Credential Access"
    mitre_technique = "T1016.002"
    mitre_technique_name = "System Network Configuration Discovery: Wi-Fi Discovery"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with the target file path and the writing process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or helpdesk staff exporting WLAN profiles for migration or device provisioning, RMM or deployment tooling that backs up wireless profiles, and network troubleshooting scripts. Other netsh exports that write .xml files can also match the netsh branch."
    tuning_guidance = "Add approved provisioning or RMM binaries to %global_allowed_admin_tools and named administrators to %global_allowed_admin_users. If the netsh branch is noisy, rely on the default-naming branch only. Consider raising severity for hosts that are not IT-managed."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    (
      $file.target.file.full_path = /\\(Wi-Fi|Wireless Network Connection|WLAN)-[^\\]+\.xml$/ nocase or
      (
        $file.principal.process.file.full_path = /\\netsh\.exe$/ nocase and
        $file.target.file.full_path = /\.xml$/ nocase
      )
    )
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1016.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $user = array_distinct($file.principal.user.userid)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $exported_file = array_distinct($file.target.file.full_path)

  condition:
    $file
}
