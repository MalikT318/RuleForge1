/*
  MITRE Technique : T1564.002 - Hidden Users
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:15:17.776579+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_002_Winlogon_SpecialAccounts_Hidden_User_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry write under the Winlogon SpecialAccounts\\UserList key. Setting a per-account value here (typically DWORD 0) hides that account from the Windows logon screen and user selection UI. Adversaries use it to conceal local accounts they create for persistence. The rule keys on the resulting registry state change, not on the command that produced it, so it still fires when command-line logging is evaded or the change is made through reg.exe, PowerShell, WMI, a custom binary or direct API calls."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.002"
    mitre_technique_name = "Hide Artifacts: Hidden Users"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events, equivalent to Sysmon Event ID 12/13) with the registry key path and value name populated in UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Enterprise kiosk, shared-workstation or VDI image builds that hide service or break-glass accounts. Golden-image provisioning scripts. Endpoint management or hardening tooling that hides local admin or service accounts. Remote access and support software that creates and hides a helper account. Some security hardening baselines (GPO or DSC) that write this key."
    tuning_guidance = "Add approved provisioning, hardening and management binaries to %global_allowed_admin_tools. Add approved administrator accounts to %global_allowed_admin_users. Add service and automation accounts that legitimately manage this key to %global_allowed_service_accounts. Review the hidden_account outcome value (the account name being hidden) against known built-in and managed accounts. To reduce noise further on UDM mappings that populate registry_value_data, add a condition requiring the value data to be 0."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Winlogon\\SpecialAccounts\\UserList/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_admin_users
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1564.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $hidden_account = array_distinct($reg.target.registry.registry_value_name)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
