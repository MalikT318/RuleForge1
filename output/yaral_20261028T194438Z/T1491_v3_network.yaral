/*
  MITRE Technique : T1491 - Defacement
  Tactic(s)       : Impact
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:42:32.026159+00:00
  Reference       : https://attack.mitre.org/techniques/T1491
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_Linux_Web_Homepage_Overwrite_External_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external source using a write-capable HTTP method (PUT, or WebDAV MOVE/COPY) against a web site's default or home page (index, default, home, main, welcome) and receiving a 2xx success response. This is the network-visible result of web defacement. It is observed at the proxy or perimeter and needs no endpoint process data."
    mitre_tactic = "Impact"
    mitre_technique = "T1491"
    mitre_technique_name = "Defacement"
    log_prerequisites = "Requires firewall, reverse-proxy, WAF or web-gateway logs normalised to UDM NETWORK_HTTP with method, URL, response code and source IP populated. The proxy must see traffic to the Linux web servers, with TLS inspected or terminated at the proxy."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Web publishing or CMS deployments over WebDAV/PUT from external CI/CD or hosting providers, remote web developers pushing content through a perimeter, authorised penetration tests, vulnerability scanners that probe PUT."
    tuning_guidance = "Add approved external deployment, CI/CD and developer egress addresses to %global_allowed_mgmt_sources. Add authorised scanner sources to %global_allowed_scanners. Widen the filename regex for site-specific landing pages. If no PUT/WebDAV is expected on the web tier, severity can be raised to Critical."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(PUT|MOVE|COPY)$/ nocase
    $http.target.url = /\/(index|default|home|main|welcome)\.(html?|php|jsp)(\?.*)?$/ nocase
    $http.network.http.response_code >= 200
    $http.network.http.response_code < 300
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_mgmt_sources
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1491")
    $primary_entity = array_distinct($http.target.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $modified_urls = array_distinct($http.target.url)
    $http_methods = array_distinct($http.network.http.method)

  condition:
    $http
}
