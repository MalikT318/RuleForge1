/*
  MITRE Technique : T1087 - Account Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:51:37.942680+00:00
  Reference       : https://attack.mitre.org/techniques/T1087
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_M365_Bulk_Directory_Enumeration_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single user account performs a high volume of directory, mailbox, recipient or group-membership read and listing operations in the Microsoft 365 / Google Workspace audit log within 10 minutes. Each lookup is benign on its own. Bulk enumeration indicates account and email address discovery that may precede phishing, password spraying or account takeover."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087"
    mitre_technique_name = "Account Discovery"
    log_prerequisites = "Microsoft 365 unified audit log (Exchange admin audit and directory activity) or Google Workspace admin and directory audit logs, ingested and normalised to UDM with metadata.product_event_type populated. Read/list operations must be enabled for auditing (for example Exchange admin audit logging)."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Directory synchronisation and identity governance tools, HR or onboarding automation, eDiscovery and compliance exports, migration projects, helpdesk staff bulk-checking accounts, and admin PowerShell or Graph scripts that report on users or groups."
    tuning_guidance = "Add automation and sync accounts to %global_allowed_service_accounts and approved administrators to %global_allowed_admin_users. Raise the #acc threshold in tenants with heavy admin scripting, or lower it for tenants with few administrators. Extend or narrow the operation-name regex to match the audit operation names present in the client's logs."

  events:
    $acc.metadata.event_type = "USER_RESOURCE_ACCESS"
    $acc.metadata.product_event_type = /^(get|list|search|enumerate|find)[-_ ]?(mailbox|user|msoluser|azureaduser|mguser|recipient|contact|group|groupmember|distributiongroupmember|unifiedgroup|unifiedgrouplinks|addresslist|globaladdresslist|directoryrole|directoryrolemember|serviceprincipal)/ nocase
    $acc.principal.user.userid = $user
    not $acc.principal.user.userid in %global_allowed_service_accounts
    not $acc.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($acc.metadata.id)
    $distinct_operations = array_distinct($acc.metadata.product_event_type)
    $source_ips = array_distinct($acc.principal.ip)
    $mitre_technique_id = array_distinct("T1087")
    $primary_entity = array_distinct($user)

  condition:
    #acc >= 25
}
