/*
  MITRE Technique : T1129 - Shared Modules
  Tactic(s)       : Execution
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:43:12.674396+00:00
  Reference       : https://attack.mitre.org/techniques/T1129
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1129_Linux_Repeated_Shared_Object_Download_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single host fetched several Linux shared object (.so) files from external destinations using a command-line HTTP client within ten minutes. This is network-observable staging of loadable modules, which an adversary can later execute through dlopen or LD_PRELOAD. One download is benign, but repeated downloads of shared libraries by scripted clients are not typical of normal package management."
    mitre_tactic = "Execution"
    mitre_technique = "T1129"
    mitre_technique_name = "Shared Modules"
    log_prerequisites = "Requires proxy or perimeter HTTP logs normalised to UDM NETWORK_HTTP with target.url and network.http.user_agent populated. Visibility is limited to unencrypted traffic or TLS-inspected traffic."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Developers or build pipelines fetching prebuilt libraries, vendor installers and agent bootstrap scripts that pull .so files, container image builds, and configuration management tools downloading runtime dependencies."
    tuning_guidance = "Add trusted vendor and artifact-repository domains to %global_allowed_domains. Add known scanner or build-host sources to %global_allowed_scanners. Raise the threshold (#net >= 3) for build-heavy environments, or narrow the user-agent regex."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\.so(\.[0-9]+)*([?#].*)?$/ nocase
    $net.network.http.user_agent = /(curl|wget|python-requests|python-urllib|libwww-perl|go-http-client)/ nocase
    $net.principal.hostname = $host
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1129")
    $primary_entity = array_distinct($host)
    $requested_urls = array_distinct($net.target.url)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    #net >= 3
}
