/*
  MITRE Technique : T1651 - Cloud Administration Command
  Tactic(s)       : Execution
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:53:41.240472+00:00
  Reference       : https://attack.mitre.org/techniques/T1651
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1651_Cloud_VM_Agent_Remote_Command_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a cloud control-plane API call that remotely executes commands, scripts or interactive sessions inside virtual machines through the in-guest management agent (run-command, send-command, session-start or automation/runbook execution). Adversaries with administrative or delegated access abuse these services to run code on VMs without network-level access. Matches on API operation names in the audit log, not on specific payloads, so it still fires when the script content or target changes."
    mitre_tactic = "Execution"
    mitre_technique = "T1651"
    mitre_technique_name = "Cloud Administration Command"
    log_prerequisites = "Cloud provider control-plane audit logging must be enabled and ingested into UDM, with management and data-plane API events for compute and VM-management services, and with metadata.product_event_type and principal.user.userid populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate patching and configuration-management automation, IT operations staff running diagnostics or remediation scripts, infrastructure-as-code pipelines and CI/CD service roles, break-glass troubleshooting sessions, and managed-service-provider delegated administrators."
    tuning_guidance = "Add automation and pipeline identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named operations staff to %global_allowed_admin_users. Raise severity or add a time-of-day condition for production-only accounts. Consider a companion threshold rule if the volume of interactive-session events is high in your environment."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /(sendcommand|startautomationexecution|startsession|runcommand|runcommands|invokerunbook)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1651")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_operations = array_distinct($cloud.metadata.product_event_type)
    $target_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
