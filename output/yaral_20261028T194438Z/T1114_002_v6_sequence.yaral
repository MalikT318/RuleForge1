/*
  MITRE Technique : T1114.002 - Remote Email Collection
  Tactic(s)       : Collection
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:20:30.611027+00:00
  Reference       : https://attack.mitre.org/techniques/T1114/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_002_Mailbox_Permission_Grant_Then_External_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An account is granted mailbox-related permissions (full access, impersonation, delegated mail read or write), then signs in from an external address within 10 minutes. This pattern suggests an adversary preparing and then using remote access to collect email."
    mitre_tactic = "Collection"
    mitre_technique = "T1114.002"
    mitre_technique_name = "Email Collection: Remote Email Collection"
    log_prerequisites = "Requires identity provider directory audit events (permission and role changes) and sign-in events normalised to UDM USER_CHANGE_PERMISSIONS and USER_LOGIN. Permission-change events must populate target.user.userid and metadata.description. Sign-in events must populate principal.user.userid and principal.ip."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Help desk or messaging admins granting delegate or shared-mailbox access to a user who then works remotely. New-hire or migration projects. Executive assistants given delegate access who sign in from home or mobile networks. Approved e-discovery or compliance accounts."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users. Add migration, e-discovery and automation accounts to %global_allowed_service_accounts. Adjust the metadata.description regex to match the wording of the client's identity provider. Reduce noise on remote-heavy tenants by shortening the window or requiring a new source IP."

  events:
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.metadata.description = /(mailbox|impersonat|full.?access|send.?as|mail\.read|mail\.readwrite|mail\.send|application.?access|delegat)/ nocase
    $perm.target.user.userid = $user
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.target.user.userid in %global_allowed_service_accounts

    $login.metadata.event_type = "USER_LOGIN"
    $login.principal.user.userid = $user
    not $login.principal.ip in %rfc1918_internal
    not $login.principal.user.userid in %global_allowed_service_accounts

    $perm.metadata.event_timestamp.seconds <= $login.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1114.002")
    $primary_entity = array_distinct($user)
    $granting_admins = array_distinct($perm.principal.user.userid)
    $login_source_ips = array_distinct($login.principal.ip)
    $login_count = count($login.metadata.id)

  condition:
    $perm and $login
}
