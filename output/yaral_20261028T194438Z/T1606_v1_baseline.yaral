/*
  MITRE Technique : T1606 - Forge Web Credentials
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:21:21.322653+00:00
  Reference       : https://attack.mitre.org/techniques/T1606
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1606_Forged_Preauth_Token_Web_Login_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external client presenting a pre-authentication key token (a 40-character hex HMAC in a preauth URL parameter) to a web mail or collaboration login endpoint. Adversaries who obtain the domain pre-auth key (for example via the Zimbra zmprov gdpak command) can forge tokens for any user and bypass password and MFA checks. This rule observes the forged-credential result on the wire. It does not depend on endpoint process telemetry, tool names or specific IPs."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1606"
    mitre_technique_name = "Forge Web Credentials"
    log_prerequisites = "Requires perimeter, reverse-proxy or TLS-inspecting firewall logs normalised to NETWORK_HTTP with target.url populated (query string retained) and principal.ip populated. Protected web servers are typically Linux-hosted."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate single sign-on portals or intranet integrations that use pre-auth URLs from external partner or SaaS egress addresses; authorised penetration tests; monitoring probes that test pre-auth login."
    tuning_guidance = "Add approved integration source addresses to %global_allowed_mgmt_sources, authorised testers to %global_allowed_scanners, and known-good SSO portal domains to %global_allowed_domains. Because pre-auth is often used only by a small set of partners, review the baseline for 2-4 weeks before enabling automated response. If the proxy strips query strings, this rule will not fire and cannot be used."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/service\/preauth\?.*\bpreauth=[0-9a-f]{40}\b/ nocase
    $http.principal.ip != ""
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_mgmt_sources
    not $http.principal.ip in %global_allowed_scanners
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1606")
    $primary_entity = array_distinct($http.target.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
