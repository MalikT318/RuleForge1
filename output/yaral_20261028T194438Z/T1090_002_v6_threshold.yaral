/*
  MITRE Technique : T1090.002 - External Proxy
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:29:47.610377+00:00
  Reference       : https://attack.mitre.org/techniques/T1090/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1090_002_ESXi_Repeated_Network_Exposure_Changes {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several firewall, network or proxy-related configuration changes on a single ESXi host within ten minutes. Each change alone is routine, but a burst can mean the host is being turned into a traffic relay or port redirector toward an external proxy or C2 server, for example by opening outbound firewall rulesets, adding VMkernel interfaces, or changing network stack settings."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1090.002"
    mitre_technique_name = "Proxy: External Proxy"
    log_prerequisites = "ESXi hostd and shell logs forwarded and parsed into UDM as SETTING_MODIFICATION events with a populated description and principal.hostname."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Planned host build or re-configuration, patching and upgrade workflows, host profile remediation, network team changes to vSwitch, portgroup or firewall rulesets, and automation that configures new hosts."
    tuning_guidance = "Add named administrators to %global_allowed_admin_users and approved management or automation source addresses to %global_allowed_mgmt_sources. Raise the #setting threshold for environments with frequent host builds. Schedule maintenance windows with the SOC to suppress alerts during planned changes."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.description = /(firewall|ruleset|vmknic|vmkernel|portgroup|vswitch|tcpip|netstack|proxy|port.?forward|redirect)/ nocase
    $setting.principal.hostname = $host
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.ip in %global_allowed_mgmt_sources

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1090.002")
    $primary_entity = array_distinct($host)
    $event_count = count($setting.metadata.id)
    $acting_users = array_distinct($setting.principal.user.userid)
    $source_ips = array_distinct($setting.principal.ip)

  condition:
    #setting >= 4
}
