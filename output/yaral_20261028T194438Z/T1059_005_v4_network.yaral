/*
  MITRE Technique : T1059.005 - Visual Basic
  Tactic(s)       : Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:13:24.154700+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_005_Linux_DotNet_Runtime_Staged_Assembly_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side detection of a .NET/Mono runtime (the only way compiled Visual Basic .NET payloads execute on Linux) making an outbound connection to a non-internal address while the runtime was launched against an assembly or script staged in a world-writable location (/tmp, /var/tmp, /dev/shm). Native VBScript/VBA do not exist on Linux, so this covers the VB.NET / cross-platform .NET Core execution path. The network event cannot prove the assembly was written in VB, so triage should confirm the language and origin of the assembly."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.005"
    mitre_technique_name = "Command and Scripting Interpreter: Visual Basic"
    log_prerequisites = "Requires Linux endpoint telemetry (EDR or auditd with network socket auditing) that populates NETWORK_CONNECTION events with principal.process.file.full_path and principal.process.command_line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers or CI jobs running .NET/Mono test builds from /tmp that call external package feeds or APIs; build agents extracting and running assemblies in temp directories; legitimate .NET applications that unpack to /tmp at startup; vendor installers using Mono or dotnet."
    tuning_guidance = "Add approved runtime wrappers or build tooling to %global_allowed_admin_tools. Add approved external destination domains to %global_allowed_domains. Add expected hosts or parent tooling used for scripting to %global_allowed_script_hosts. Ensure %rfc1918_internal is populated so internal traffic is excluded. For build servers, scope exclusions by host rather than disabling the rule."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(mono|mono-sgen|mono-sgen64|dotnet)$/ nocase
    $net.principal.process.command_line = /(^|\s)(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/)/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1059.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $runtime_path = array_distinct($net.principal.process.file.full_path)
    $runtime_command_line = array_distinct($net.principal.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
