/*
  MITRE Technique : T1480.001 - Environmental Keying
  Tactic(s)       : Stealth
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:24:56.797760+00:00
  Reference       : https://attack.mitre.org/techniques/T1480/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1480_001_Linux_Decrypted_Payload_Staged_In_Temp {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a decryption utility writing a file into a world-writable or memory-backed staging location (/dev/shm, /tmp, /var/tmp) as a hidden file or with an executable or script-like extension. Environmentally keyed payloads derive a key from host-specific values, then decrypt and drop the payload at runtime. Detection pivots on the resulting file artifact rather than the command line."
    mitre_tactic = "Stealth"
    mitre_technique = "T1480.001"
    mitre_technique_name = "Execution Guardrails: Environmental Keying"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-write events (execve and openat/creat watches on /tmp, /var/tmp, /dev/shm) that populate the principal process path and target file path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators or deployment scripts decrypting configuration or secrets into temp directories, backup and restore jobs, package or installer scripts using gpg for signature handling, CI/CD runners decrypting build artifacts."
    tuning_guidance = "Add approved tooling and automation parent binaries to %global_allowed_admin_tools, backup software to %global_allowed_backup_processes, and service accounts that decrypt into temp paths to %global_allowed_service_accounts. Remove the /dev/shm branch of the regex if the environment legitimately uses shared memory for decrypted secrets."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(openssl|gpg|gpg2|gpg-agent|age|ccrypt|ccdecrypt|mcrypt)$/ nocase
    $file.target.file.full_path = /^\/dev\/shm\/[^\/]+|^\/(var\/)?tmp\/(\.[^\/]+|[^\/]+\.(so|elf|bin|sh|py|pl))$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1480.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_files = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
