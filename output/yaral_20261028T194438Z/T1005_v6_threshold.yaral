/*
  MITRE Technique : T1005 - Data from Local System
  Tactic(s)       : Collection
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:13:02.097092+00:00
  Reference       : https://attack.mitre.org/techniques/T1005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1005_ESXi_Bulk_VM_File_Reads_By_User {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single account reads an unusually high number of virtual machine files (disks, configuration, snapshots, memory, NVRAM) from datastore volumes on one ESXi host within ten minutes. A single read is routine, but bulk reads indicate local data collection or staging before exfiltration."
    mitre_tactic = "Collection"
    mitre_technique = "T1005"
    mitre_technique_name = "Data from Local System"
    log_prerequisites = "Requires ESXi host logs (hostd, shell, file access auditing) forwarded and parsed into UDM FILE_READ events with target.file.full_path, principal.user.userid and principal.hostname populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Backup and replication agents, VM cloning or migration by administrators, datastore browser downloads during planned maintenance, vulnerability or compliance scanners inspecting VM files."
    tuning_guidance = "Add backup software to %global_allowed_backup_processes and automation accounts to %global_allowed_service_accounts. Raise the #file threshold for hosts running frequent VM migrations, or lower it for hosts that should be quiet."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /^\/vmfs\/volumes\/.+\.(vmdk|vmx|vmsn|vmss|vmem|nvram|vswp)$/ nocase
    $file.principal.hostname = $host
    $file.principal.user.userid = $user
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  match:
    $host, $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1005")
    $primary_entity = array_distinct($host)
    $actor = array_distinct($user)
    $file_read_count = count($file.metadata.id)
    $files_read = array_distinct($file.target.file.full_path)

  condition:
    #file >= 10
}
