/*
  MITRE Technique : T1652 - Device Driver Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:54:51.249971+00:00
  Reference       : https://attack.mitre.org/techniques/T1652
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1652_Linux_Kernel_Module_Inventory_File_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects reads of the kernel's loaded-module and kernel-symbol tables (/proc/modules, /proc/kallsyms) by shells, scripting interpreters, common text utilities, or binaries running from world-writable directories. These reads are the file-level result of device driver enumeration (lsmod, cat /proc/modules, scripted reconnaissance) and are visible even when command-line logging is evaded or the lsmod/modinfo binaries are not used."
    mitre_tactic = "Discovery"
    mitre_technique = "T1652"
    mitre_technique_name = "Device Driver Discovery"
    log_prerequisites = "Requires Linux EDR file-read telemetry or auditd with watch rules on /proc/modules and /proc/kallsyms, normalised to UDM FILE_READ with principal.process.file.full_path and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "System administrators checking loaded modules, configuration management and inventory agents, monitoring and observability collectors, support-bundle scripts (sosreport), package post-install scripts, container and hypervisor tooling, and kernel hardening or compliance audit scripts."
    tuning_guidance = "Add approved inventory, monitoring and RMM binaries to %global_allowed_admin_tools, EDR and audit agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Extend the system-daemon exclusion regex for client-specific collectors. For noisy hosts, consider raising severity only when the reader runs from /tmp, /var/tmp or /dev/shm."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /^\/proc\/(modules|kallsyms)$/
    $file.principal.process.file.full_path = /(^\/(tmp|var\/tmp|dev\/shm)\/|\/(bash|sh|dash|zsh|ksh|python[0-9.]*|perl|ruby|php|cat|lsmod|awk|grep|sed|less|more|head|tail|strings)$)/
    not $file.principal.process.file.full_path = /\/(systemd-udevd|udevd|kmod|modprobe|depmod|dracut|auditd|sosreport|node_exporter|telegraf|snapd|multipathd)$/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1652")
    $primary_entity = array_distinct($file.principal.hostname)
    $reader_process = array_distinct($file.principal.process.file.full_path)
    $read_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
