/*
  MITRE Technique : T1134.005 - SID-History Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:03:22.093163+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_005_SIDHistory_Modification_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated process launches on a single host whose command lines write to or modify the Active Directory SIDHistory attribute (Set-ADUser/Set-ADObject, -Add/-Replace hashtable, LDIF or LDAP modify operations) within 10 minutes. A single SIDHistory command can be benign migration work, but repeated modification activity from one host indicates SID-History injection for privilege escalation."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.005"
    mitre_technique_name = "Access Token Manipulation: SID-History Injection"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command lines (EDR, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled). Domain controller and admin workstation coverage is strongly recommended."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Authorised Active Directory domain migrations (ADMT or similar tooling), identity governance and IAM automation, AD health or audit scripts that handle SIDHistory, and administrators running cleanup of stale SIDHistory values."
    tuning_guidance = "Add migration tooling and approved admin parents to %global_allowed_admin_tools, migration or automation accounts to %global_allowed_admin_users, and trusted jump or management hosts to %global_allowed_script_hosts. Raise the #proc threshold in environments with frequent migration activity. Lower it to 1 on non-migration tenants."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /sid-?history/ nocase
    $proc.target.process.command_line = /(set-ad(user|object)|ldifde|ldapmodify|dsmod|-add\s+@\{|-replace\s+@\{|changetype\s*:\s*modify|add-ad\w*sid)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1134.005")
    $primary_entity = array_distinct($host)
    $event_count = count($proc.metadata.id)
    $users = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
