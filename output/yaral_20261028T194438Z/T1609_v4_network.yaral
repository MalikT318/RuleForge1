/*
  MITRE Technique : T1609 - Container Administration Command
  Tactic(s)       : Execution
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:27:34.078608+00:00
  Reference       : https://attack.mitre.org/techniques/T1609
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1609_External_Container_Exec_API_Call {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects HTTP requests to container administration endpoints (Kubernetes API server pod exec/attach, kubelet exec/run/attach, Docker daemon container exec) originating from outside internal address space. Remote exec/attach calls from non-internal, non-approved sources indicate abuse of a container administration service to run commands inside a container."
    mitre_tactic = "Execution"
    mitre_technique = "T1609"
    mitre_technique_name = "Container Administration Command"
    log_prerequisites = "Requires HTTP-level visibility of container control-plane traffic that populates network.http and target.url, such as API server or ingress/load balancer logs, kubelet or Docker daemon proxy logs, or a network sensor with TLS inspection."
    platform = "Containers"
    log_source = "container"
    false_positives = "Authorised remote administrators or CI/CD runners reaching the API server through a public endpoint or NAT egress address, cloud provider shell or console features, and managed support or break-glass access. Non-container web applications that expose /exec/, /run/ or /attach/ paths with three path segments may also match the kubelet-style pattern."
    tuning_guidance = "Add approved bastion, VPN and CI/CD egress addresses to %global_allowed_mgmt_sources. Add named cluster administrators to %global_allowed_admin_users and automation identities to %global_allowed_service_accounts. Confirm that %rfc1918_internal is populated with the client's internal address space. If the kubelet-style pattern is noisy, restrict it to hosts that run container workloads."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /(\/api\/v1\/namespaces\/[^\/]+\/pods\/[^\/]+\/(exec|attach)|\/(exec|run|attach)\/[^\/?]+\/[^\/?]+\/[^\/?]+|\/containers\/[^\/]+\/exec|\/exec\/[a-f0-9]+\/start)/ nocase
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.user.userid in %global_allowed_admin_users
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1609")
    $primary_entity = array_distinct(strings.coalesce($net.target.hostname, $net.principal.hostname))
    $source_ips = array_distinct($net.principal.ip)
    $requested_urls = array_distinct($net.target.url)
    $source_users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
