/*
  MITRE Technique : T1136.002 - Domain Account
  Tactic(s)       : Persistence
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:09:41.168737+00:00
  Reference       : https://attack.mitre.org/techniques/T1136/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_002_Linux_Domain_Account_Created_From_Anomalous_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a domain (directory) account creation command, such as samba-tool, ipa user-add, adcli create-user, net ads user add or ldapadd, launched by a web server, application server, database, or print spooler process, or by a shell or interpreter that one of them spawned. These services have no legitimate reason to create directory accounts, so this lineage suggests a compromised service being used to establish persistence through a rogue domain account."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136.002"
    mitre_technique_name = "Create Account: Domain Account"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to UDM PROCESS_LAUNCH with parent process path, child process path and full command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Identity-management web portals or self-service provisioning apps that run as a web or Java process and call ipa, samba-tool or ldapadd; HR-driven account provisioning scripts launched from a Tomcat or Node service; directory administrators testing from an application server."
    tuning_guidance = "Add approved provisioning wrappers or parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts. Add provisioning service accounts to %global_allowed_service_accounts. If the client runs a legitimate identity portal on Java or Node, exclude that parent through the reference lists rather than removing the parent from the regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(httpd|apache2|nginx|lighttpd|php-fpm[0-9.]*|php[0-9.]*|tomcat[0-9]*|java|node|mysqld|mariadbd|postgres|mongod|redis-server|cupsd)$/ nocase
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|python[0-9.]*|perl|samba-tool|ipa|adcli|net|ldapadd)$/ nocase
    $proc.target.process.command_line = /(samba-tool\s+user\s+(create|add)|ipa\s+user-add|adcli\s+create-user|net\s+ads\s+user\s+add|\bldapadd\b)/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1136.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
