/*
  MITRE Technique : T1036.011 - Overwrite Process Arguments
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:15:37.442427+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_011_Proc_Mem_Comm_Write_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated writes to /proc/<pid>/mem or /proc/<pid>/comm (including /proc/self) from non-debugger processes on a single host within 10 minutes. A process overwriting its own argv memory or comm name to masquerade as a benign process produces this file-write pattern. One write is rare and often benign, but a burst indicates in-memory argument or name spoofing as used by BPFDoor and XorDdos-style Linux implants."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.011"
    mitre_technique_name = "Masquerading: Overwrite Process Arguments"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry that covers procfs paths (/proc/<pid>/mem, /proc/<pid>/comm), normalised to FILE_MODIFICATION with principal.process and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Debuggers and tracers (gdb, strace, ltrace), crash handlers and core dump tooling, JIT runtimes and language runtimes that set thread names via /proc/self/comm (JVM, Node.js, Chromium-based apps), container runtimes, and EDR or memory forensics agents."
    tuning_guidance = "Add approved debugging, diagnostic and runtime tooling to %global_allowed_admin_tools and endpoint agents to %global_allowed_security_tools. If a runtime that sets thread names via /proc/self/comm causes noise, exclude its parent binary through %global_allowed_script_hosts or raise the threshold. Scale the threshold per environment."

  events:
    $proc.metadata.event_type = "FILE_MODIFICATION"
    $proc.target.file.full_path = /^\/proc\/(self|thread-self|[0-9]+)(\/task\/[0-9]+)?\/(mem|comm)$/ nocase
    not $proc.principal.process.file.full_path = /\/(gdb|gdbserver|lldb|strace|ltrace|perf)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    $proc.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1036.011")
    $primary_entity = array_distinct($host)
    $writer_processes = array_distinct($proc.principal.process.file.full_path)
    $target_proc_files = array_distinct($proc.target.file.full_path)
    $users = array_distinct($proc.principal.user.userid)

  condition:
    #proc >= 3
}
