/*
  MITRE Technique : T1216.001 - PubPrn
  Tactic(s)       : Stealth
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:34:19.701228+00:00
  Reference       : https://attack.mitre.org/techniques/T1216/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1216_001_PubPrn_Script_Copy_Outside_Trusted_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a copy of the signed PubPrn.vbs printer-publishing script outside its legitimate Windows locations (Printing_Admin_Scripts, WinSxS, servicing). Adversaries stage copies in writable paths to proxy execution through a Microsoft-signed script, or to modify it so the signature or application-control checks no longer apply. This detects the file artifact left behind rather than command-line arguments, so it still fires when command-line logging is evaded."
    mitre_tactic = "Stealth"
    mitre_technique = "T1216.001"
    mitre_technique_name = "System Script Proxy Execution: PubPrn"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry that populates target.file.full_path and principal.process.file.full_path (EDR file events or Sysmon Event ID 11)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows servicing and cumulative updates that restage system scripts, OS image or profile deployment tooling, backup restores, administrators copying printing admin scripts for legitimate AD printer publishing, and security products that quarantine or copy the script for scanning."
    tuning_guidance = "Add approved deployment, imaging and patching processes to %global_allowed_admin_tools, and EDR or AV agents that copy or quarantine files to %global_allowed_security_tools. If a client has a custom golden-image build path, extend the directory exclusion regex in the rule. Detection depends on the filename, so a renamed copy is not caught. Pair this rule with process-lineage coverage for that case."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\pubprn\.vbs$/ nocase
    not $file.target.file.full_path = /\\windows\\(system32\\printing_admin_scripts|syswow64\\printing_admin_scripts|winsxs|servicing)\\/ nocase
    not $file.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1216.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
