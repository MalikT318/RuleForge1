/*
  MITRE Technique : T1546.004 - Unix Shell Configuration Modification
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:06:18.031910+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_004_Shell_Interpreter_Outbound_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Unix shell interpreter (bash, sh, dash, zsh, ksh) that itself opens an outbound connection to an external address. Shells do not normally make network connections. When they do, it often means a command planted in a shell startup file (/etc/profile, /etc/profile.d/*, ~/.bashrc, ~/.bash_profile) is running, for example a /dev/tcp reverse shell or a built-in callback that fires each time a shell starts. This is a network-side indicator of the persistence mechanism, independent of process command-line rules. It does not prove the startup file was modified, so correlate with file-modification telemetry from the endpoint."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.004"
    mitre_technique_name = "Event Triggered Execution: Unix Shell Configuration Modification"
    log_prerequisites = "Requires Linux endpoint network telemetry (EDR or auditd socket/connect events) that populates principal.process.file.full_path on NETWORK_CONNECTION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Admin scripts or deployment tooling that use bash /dev/tcp for health checks; configuration management and bootstrap scripts run through a shell; EDR network sensors that attribute a child's connection to its parent shell; interactive admin sessions using shell built-ins to test connectivity."
    tuning_guidance = "Add approved automation and jump hosts to %global_allowed_script_hosts. Add service accounts that legitimately run shell-based network checks to %global_allowed_service_accounts. Add approved management or monitoring destinations to %global_allowed_mgmt_sources. Add known-good external destinations to %global_allowed_domains when the target hostname is populated."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|ash)$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $shell_users = array_distinct($net.principal.user.userid)
    $shell_command_lines = array_distinct($net.principal.process.command_line)

  condition:
    $net
}
