/*
  MITRE Technique : T1564.013 - Bind Mounts
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:34:12.363225+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_013_Proc_Bind_Mount_Systemd_Unit {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a systemd mount unit whose name encodes a /proc/<pid> mount point (proc-<pid>.mount). systemd derives unit names from the mount path, so this unit mounts something over a process's /proc directory. That is the persistent or transient form of the bind-mount trick used to hide a malicious process from ps and top. The rule uses file-creation telemetry instead of command-line matching, so it also catches systemd-mount, transient units, and hand-written units."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.013"
    mitre_technique_name = "Hide Artifacts: Bind Mounts"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry covering /etc/systemd, /run/systemd and /usr/lib/systemd with the creating process path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators or container tooling that deliberately mount over /proc/<pid> paths (rare), hardening or sandboxing tools that create proc-* mount units, and configuration management pushing custom mount units."
    tuning_guidance = "Add approved configuration-management and deployment binaries to %global_allowed_admin_tools and EDR or hardening agents to %global_allowed_security_tools. Verify that the unit's What= and Where= point at /proc/<pid> and that the PID belongs to a running process of interest. Scope the path regex to your distribution's unit directories if needed."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(etc\/systemd\/system|run\/systemd\/(system|transient)|usr\/lib\/systemd\/system|lib\/systemd\/system)\/proc-[0-9]+(-[^\/]+)?\.mount$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1564.013")
    $primary_entity = array_distinct($file.principal.hostname)
    $mount_unit_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
