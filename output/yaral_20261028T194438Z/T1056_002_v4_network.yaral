/*
  MITRE Technique : T1056.002 - GUI Input Capture
  Tactic(s)       : Collection, Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:47:50.044120+00:00
  Reference       : https://attack.mitre.org/techniques/T1056/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1056_002_Linux_Dialog_Helper_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux GUI dialog or prompt helper (zenity, kdialog, yad, Xdialog, gxmessage, pinentry) opening a network connection to an external address. These binaries only draw prompts and have no legitimate reason to talk to the internet. External egress from one suggests a fake credential prompt is sending captured input off-host, or that the helper has been replaced, wrapped or injected into. This is the network-side counterpart to command-line detections of password-prompt dialogs."
    mitre_tactic = "Collection, Credential Access"
    mitre_technique = "T1056.002"
    mitre_technique_name = "Input Capture: GUI Input Capture"
    log_prerequisites = "Requires Linux endpoint telemetry (EDR or auditd with connect syscall auditing) that populates NETWORK_CONNECTION with the originating process path (principal.process.file.full_path) and the destination IP."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Dialog helpers wrapped by vendor installers or in-house tooling that proxy traffic; remote-desktop or X-forwarding setups where the dialog binary is bound to a remote display over a routable address; EDR network attribution errors that assign a child's connection to the dialog process; custom gxmessage or yad frontends compiled with web components."
    tuning_guidance = "Add approved wrapper or deployment binaries to %global_allowed_admin_tools and EDR or agent binaries to %global_allowed_security_tools. Confirm %rfc1918_internal covers the customer's internal address space. If a client uses routable addresses for X11 forwarding, exclude those sources in a customer-level copy of the rule. Investigate the parent shell script and any recent writes to /tmp, /dev/shm or ~/.local for the prompt script."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(zenity|kdialog|yad|xdialog|gxmessage|pinentry[a-z0-9_-]*)$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not re.regex($net.target.ip, `^(127\.|::1$|fe80:)`)
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1056.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $user = array_distinct($net.principal.user.userid)
    $dialog_process = array_distinct($net.principal.process.file.full_path)
    $dialog_command_line = array_distinct($net.principal.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
