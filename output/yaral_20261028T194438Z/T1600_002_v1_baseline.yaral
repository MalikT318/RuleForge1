/*
  MITRE Technique : T1600.002 - Disable Crypto Hardware
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:08:24.837728+00:00
  Reference       : https://attack.mitre.org/techniques/T1600/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_002_Crypto_Hardware_Acceleration_Disabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a management-plane configuration change on a network device that disables dedicated hardware cryptographic acceleration or offload (for example, removing the crypto engine or turning off IPsec/SSL hardware offload). Forcing encryption into software weakens performance and integrity guarantees and is a precursor to cipher-weakening attacks."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1600.002"
    mitre_technique_name = "Weaken Encryption: Disable Crypto Hardware"
    log_prerequisites = "Requires device configuration-change or command-audit syslog from firewalls, routers or VPN gateways, forwarded to Chronicle and parsed into SETTING_MODIFICATION events with the change text in metadata.description or security_result.description. Config-change logging (for example command accounting) must be enabled on the device."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Planned troubleshooting by network engineers (temporarily disabling offload to isolate a fault), hardware replacement or RMA procedures, firmware or OS upgrades that re-apply configuration, and automated config-management pushes from approved orchestration hosts."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users, automation accounts to %global_allowed_service_accounts, and trusted jump-host or orchestration addresses to %global_allowed_mgmt_sources. Correlate with a change ticket before closing. If a client's devices log config text in a different field, extend the field checks accordingly."

  events:
    $set.metadata.event_type = "SETTING_MODIFICATION"
    (
      $set.metadata.description = /\bno\s+crypto\s+engine\b|\bcrypto\s+engine\s+\S+.*\b(disable|disabled|software)\b|\b(crypto|ipsec|ssl|aes|encrypt\w*)[ _-]?(accel\w*|offload|hw|hardware|engine)\b.{0,30}\b(disable|disabled|off|none|0)\b|\b(disable|no)\s+(crypto|ipsec|ssl|aes)[ _-]?(accel\w*|offload|hw|hardware)\b|\bnpu[ _-]?offload\b.{0,20}\b(disable|disabled)\b|\b(inbound|outbound)[ _-]?offload\b.{0,20}\b(disable|disabled)\b/ nocase
      or
      $set.security_result.description = /\bno\s+crypto\s+engine\b|\bcrypto\s+engine\s+\S+.*\b(disable|disabled|software)\b|\b(crypto|ipsec|ssl|aes|encrypt\w*)[ _-]?(accel\w*|offload|hw|hardware|engine)\b.{0,30}\b(disable|disabled|off|none|0)\b|\b(disable|no)\s+(crypto|ipsec|ssl|aes)[ _-]?(accel\w*|offload|hw|hardware)\b|\bnpu[ _-]?offload\b.{0,20}\b(disable|disabled)\b|\b(inbound|outbound)[ _-]?offload\b.{0,20}\b(disable|disabled)\b/ nocase
    )
    not $set.principal.user.userid in %global_allowed_admin_users
    not $set.principal.user.userid in %global_allowed_service_accounts
    not $set.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1600.002")
    $primary_entity = array_distinct($set.principal.hostname)
    $acting_user = array_distinct($set.principal.user.userid)
    $source_ips = array_distinct($set.principal.ip)
    $change_text = array_distinct($set.metadata.description)

  condition:
    $set
}
