/*
  MITRE Technique : T1020.001 - Traffic Duplication
  Tactic(s)       : Exfiltration
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:32:15.974268+00:00
  Reference       : https://attack.mitre.org/techniques/T1020/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1020_001_Cloud_Traffic_Mirror_Session_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a network traffic mirroring session, packet mirroring policy, or virtual network tap through the cloud control plane. Attackers with sufficient cloud permissions can duplicate traffic from workload network interfaces to a destination they control, which gives them passive, continuous exfiltration of network data without touching any endpoint. This rule detects the API-level creation of the mirroring configuration, so it is independent of the host operating system, any process or command line, and the destination infrastructure."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1020.001"
    mitre_technique_name = "Automated Exfiltration: Traffic Duplication"
    log_prerequisites = "Cloud control-plane audit logging for management and network API calls must be enabled, ingested, and parsed into UDM as RESOURCE_CREATION with metadata.product_event_type populated. Requires multi-region and organization-level trail coverage."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Network and security engineering teams deploying approved traffic analysis or IDS/NDR sensors, infrastructure-as-code pipelines that provision mirroring for monitoring tools, vendor-managed network visibility platforms, and troubleshooting sessions during incident response or performance investigations."
    tuning_guidance = "Add the approved pipeline or automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named network administrators to %global_allowed_admin_users. Review the mirror destination in the alert before suppressing. Mirroring to a target in a different account, project, or subscription should always be investigated."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /(CreateTrafficMirrorSession|packetMirrorings\.(insert|patch)|virtualNetworkTaps\/write|tapConfigurations\/write)/ nocase
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1020.001")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_action = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)
    $mirror_resource = array_distinct($cloud.target.resource.name)

  condition:
    $cloud
}
