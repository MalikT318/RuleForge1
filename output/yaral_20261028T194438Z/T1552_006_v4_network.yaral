/*
  MITRE Technique : T1552.006 - Group Policy Preferences
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:54:28.079343+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_006_GPP_SYSVOL_SMB_From_Script_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a scripting interpreter or command shell opening an SMB (TCP/445) connection to another host. GPP password harvesters (Get-GPPPassword-style scripts, Python gpprefdecrypt-style tooling, and post-exploitation modules) connect to the SYSVOL share on a domain controller over SMB to enumerate and read Groups.xml, Services.xml and similar files. Normal SMB traffic comes from the System process or Explorer, so SMB initiated by an interpreter is a useful network-side signal. This rule does not exclude internal address space, because SYSVOL is served by internal domain controllers. Noise is controlled by process, host and user allowlists instead."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.006"
    mitre_technique_name = "Unsecured Credentials: Group Policy Preferences"
    log_prerequisites = "Requires endpoint network telemetry that records the initiating process for outbound connections (EDR network events or Sysmon Event ID 3) normalised to NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators mapping or browsing file shares from PowerShell or cmd (net use, New-PSDrive, Copy-Item to UNC paths), logon and startup scripts, software deployment and RMM scripts that copy from file servers, backup or inventory scripts, and Python-based admin tooling."
    tuning_guidance = "Add approved admin tooling binaries to %global_allowed_admin_tools, jump hosts and automation servers to %global_allowed_script_hosts, and named administrators to %global_allowed_admin_users. Add vulnerability scanners to %global_allowed_scanners. If the tenant has a small, stable set of domain controllers, consider alerting only when the target host is a DC, using an enrichment-based filter. Raise severity when the source host is a standard workstation or server and the user is not an administrator."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 445
    $net.principal.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta|python[0-9\.]*|pythonw[0-9\.]*|perl|ruby)\.exe$/ nocase
    $net.principal.hostname != ""
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_scanners
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1552.006")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_user = array_distinct($net.principal.user.userid)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $smb_target_ips = array_distinct($net.target.ip)
    $smb_target_hosts = array_distinct($net.target.hostname)

  condition:
    $net
}
