/*
  MITRE Technique : T1055.013 - Process Doppelgänging
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:00:51.851200+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_013_TxF_Metadata_Artifact_By_NonSystem_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a user-mode process creating file artifacts inside the NTFS Transactional (TxF) metadata area ($Extend\\$RmMetadata\\$Txf / $TxfLog). Process Doppelganging relies on a transacted file write that is rolled back after a section is created from it. The TxF resource-manager structures are normally touched only by the kernel (System) or by backup and security tooling. This rule works at the file-artifact layer, not the command-line layer, so it still fires if the command line is hidden or obfuscated. Visibility depends on the endpoint sensor reporting file events for NTFS metadata paths, so treat it as a supplementary, lower-volume signal."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.013"
    mitre_technique_name = "Process Injection: Process Doppelgänging"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) that includes NTFS metadata paths and the writing process image path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and imaging agents, volume shadow copy and snapshot tooling, disk or file system repair utilities, EDR and AV agents that enumerate NTFS metadata, and legacy applications that use the deprecated TxF API (some installers, older database and file-sync products)."
    tuning_guidance = "Add legitimate backup agent images to %global_allowed_backup_processes, EDR/AV agent images to %global_allowed_security_tools, and approved IT utilities to %global_allowed_admin_tools. If a specific line-of-business application legitimately uses TxF, add its image path to %global_allowed_admin_tools after confirming the behaviour with the client. Pair hits with process-tampering or image-mismatch alerts on the same host to raise confidence."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\\$Extend\\\$RmMetadata\\\$Txf/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path = /(^|\\)(System|ntoskrnl\.exe|smss\.exe)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1055.013")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $txf_artifact_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
