/*
  MITRE Technique : T1195.002 - Compromise Software Supply Chain
  Tactic(s)       : Initial Access
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:42:39.106685+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_002_Linux_PkgMgr_NonStandard_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux package manager or language package tool (apt, dpkg, yum, dnf, zypper, pip, npm, gem, cargo) opening a network connection to an external address on a port other than 80 or 443. Legitimate repositories are almost always served over HTTP or HTTPS. A package or update client reaching an unknown external host on an unusual port can indicate a hijacked update channel, a rogue repository mirror, or a dependency-confusion or typosquat payload server, any of which can deliver trojanised software."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.002"
    mitre_technique_name = "Supply Chain Compromise: Compromise Software Supply Chain"
    log_prerequisites = "Requires Linux EDR or auditd network telemetry that populates the connecting process path (principal.process.file.full_path), target.ip and target.port, normalised to UDM NETWORK_CONNECTION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Internal or partner package mirrors reachable on external IPs with custom ports (for example Artifactory, Nexus, Pulp or Satellite exposed on 8081/8443), apt-key or GPG keyserver lookups on port 11371, rsync-based mirror syncs on 873, and developer or build hosts pulling from self-hosted registries."
    tuning_guidance = "Add approved mirror and repository domains to %global_allowed_domains. Add patch and deployment tooling to %global_allowed_admin_tools. Confirm that %rfc1918_internal covers client internal ranges. If a client legitimately uses a custom port for an external mirror, allowlist its hostname instead of widening the port filter."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(apt|apt-get|dpkg|yum|dnf|zypper|pip|pip3|npm|gem|cargo)$/ nocase
    $net.target.port != 80
    $net.target.port != 443
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1195.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $package_tool = array_distinct($net.principal.process.file.full_path)
    $process_command_line = array_distinct($net.principal.process.command_line)

  condition:
    $net
}
