/*
  MITRE Technique : T1083 - File and Directory Discovery
  Tactic(s)       : Discovery
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:23:56.770842+00:00
  Reference       : https://attack.mitre.org/techniques/T1083
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1083_ESXi_External_Datastore_Browse_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP request from a non-internal source to the ESXi host datastore file browser (/folder endpoint). This endpoint lists and downloads datastore directory contents, so it is a network-side way to enumerate VM folders, disk files and configuration files without running any shell commands on the host. The rule complements endpoint command-line detections by observing the management-plane HTTP traffic instead."
    mitre_tactic = "Discovery"
    mitre_technique = "T1083"
    mitre_technique_name = "File and Directory Discovery"
    log_prerequisites = "Requires ESXi HTTP reverse-proxy or management-plane request logging (URL and source IP) forwarded to Chronicle and parsed to NETWORK_HTTP."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators or backup and migration tooling browsing or copying datastore files from a routed or NATed address that is not in the internal list; remote-site management jump hosts; vulnerability scanners crawling the web interface; automation that downloads VMX or log files via the file browser."
    tuning_guidance = "Add approved management jump hosts and VPN egress addresses to %global_allowed_mgmt_sources. Add named administrators to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Add authorised scanners to %global_allowed_scanners. Ensure %rfc1918_internal covers the client's internal address space."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/folder(\/|\?|$)/ nocase
    $http.network.http.method = /^(GET|HEAD|PROPFIND)$/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_mgmt_sources
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.user.userid in %global_allowed_admin_users
    not $http.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1083")
    $primary_entity = array_distinct($http.target.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $source_users = array_distinct($http.principal.user.userid)

  condition:
    $http
}
