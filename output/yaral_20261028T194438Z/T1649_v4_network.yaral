/*
  MITRE Technique : T1649 - Steal or Forge Authentication Certificates
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:51:45.783314+00:00
  Reference       : https://attack.mitre.org/techniques/T1649
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1649_IdP_External_Cert_Enrollment_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects HTTP requests from non-internal source addresses to certificate enrollment services (AD CS web enrollment, certificate request/retrieval pages, and NDES/SCEP endpoints) hosted on identity infrastructure. These services are normally reachable only from internal networks. External access suggests an adversary is requesting, forging, or relaying authentication certificates that can then be used as credentials for domain or directory accounts."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1649"
    mitre_technique_name = "Steal or Forge Authentication Certificates"
    log_prerequisites = "Requires HTTP-level telemetry (web server, reverse proxy, WAF or load balancer logs) for hosts providing certificate enrollment or identity services, normalised to UDM NETWORK_HTTP with principal.ip and target.url populated."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Intentionally internet-published NDES/SCEP endpoints for MDM or mobile device enrollment, remote workers connecting via a VPN or reverse proxy whose egress address appears as a non-internal source, authorised external penetration tests or vulnerability scans, and CDN or proxy addresses fronting the enrollment service."
    tuning_guidance = "Add approved proxy, VPN egress and MDM service addresses to %global_allowed_mgmt_sources. Add authorised scanning sources to %global_allowed_scanners. If NDES/SCEP is intentionally published, scope it by adding the fronting proxy address to %global_allowed_mgmt_sources. If the load balancer masks client addresses, map the real client address into principal.ip during parsing."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(certsrv|certenroll|mscep|mscep_admin|certsrv\/certfnsh\.asp|certsrv\/certrqxt\.asp|certsrv\/certnew\.cer|certsrv\/certnew\.p7b)(\/|$|\?)/ nocase
    $http.principal.ip != ""
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_mgmt_sources
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1649")
    $primary_entity = array_distinct($http.principal.ip)
    $target_host = array_distinct($http.target.hostname)
    $requested_urls = array_distinct($http.target.url)
    $http_methods = array_distinct($http.network.http.method)

  condition:
    $http
}
