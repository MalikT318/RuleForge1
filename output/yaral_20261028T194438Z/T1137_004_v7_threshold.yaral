/*
  MITRE Technique : T1137.004 - Outlook Home Page
  Tactic(s)       : Persistence
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:19:59.168640+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_004_Outlook_HomePage_Registry_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects multiple Outlook folder home page registry modifications on a single host within 10 minutes: writes under the Outlook WebView key, or changes to the Outlook Security values that allow roaming or non-default-store folder home pages and scripts. A single write can be benign; a burst of them matches an adversary configuring Outlook Home Page persistence."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.004"
    mitre_technique_name = "Office Application Startup: Outlook Home Page"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events) normalised to UDM REGISTRY_MODIFICATION with target.registry.registry_key and registry_value_name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy or Intune/MDM applying Outlook policy settings, Office installers or upgrades, IT deployment scripts configuring Outlook profiles, and Outlook itself writing WebView settings when users customise folder views."
    tuning_guidance = "Add approved deployment or policy tooling to %global_allowed_admin_tools. Add known configuration-management hosts and parent processes to %global_allowed_script_hosts. Raise the #reg threshold on tenants with heavy Outlook policy churn. Review $risk_score: 90 means a roaming-homepage or store-script security value was changed."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      $reg.target.registry.registry_key = /\\Office\\[0-9.]+\\Outlook\\WebView\\/ nocase or
      (
        $reg.target.registry.registry_key = /\\Office\\[0-9.]+\\Outlook\\Security$/ nocase and
        $reg.target.registry.registry_value_name = /^(EnableRoamingFolderHomepages|NonDefaultStoreScript)$/ nocase
      )
    )
    not $reg.principal.process.file.full_path = /\\(OfficeClickToRun|OfficeC2RClient|setup|msiexec|TrustedInstaller)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_script_hosts
    $reg.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(re.regex($reg.target.registry.registry_value_name, `(?i)^(EnableRoamingFolderHomepages|NonDefaultStoreScript)$`), 90, 70))
    $mitre_technique_id = array_distinct("T1137.004")
    $primary_entity = array_distinct($host)
    $event_count = count($reg.metadata.id)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_name)
    $writing_processes = array_distinct($reg.principal.process.file.full_path)
    $users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 3
}
