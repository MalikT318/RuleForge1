/*
  MITRE Technique : T1684.002 - Email Spoofing
  Tactic(s)       : Stealth
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:33:16.676200+00:00
  Reference       : https://attack.mitre.org/techniques/T1684/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1684_002_M365_AntiSpoofing_Control_Weakened {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects configuration changes that weaken or bypass a tenant's email anti-spoofing protections: anti-phishing or spoof-intelligence policy changes or removal, tenant allow entries for spoofed senders, connection-filter allow-list changes, and DKIM signing configuration changes. Adversaries or compromised admins make these changes so that spoofed sender identities reach victim inboxes. This rule works at the configuration-state layer (SETTING_MODIFICATION) rather than at the message or command layer."
    mitre_tactic = "Stealth"
    mitre_technique = "T1684.002"
    mitre_technique_name = "Email Spoofing"
    log_prerequisites = "Requires unified audit logs covering admin and mail-flow configuration operations, ingested and normalised to UDM SETTING_MODIFICATION with the operation name in metadata.product_event_type and the acting admin in principal.user.userid."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate mail administrators tuning anti-phishing thresholds; onboarding of third-party bulk senders or security gateways that require connection-filter allow-listing; planned DKIM key rotation; approved tenant allow entries for known marketing or partner senders; change-managed policy migrations."
    tuning_guidance = "Add named mail administrators to %global_allowed_admin_users and automation or provisioning identities to %global_allowed_service_accounts. Correlate hits with change tickets. To reduce noise, remove the DkimSigningConfig operation from the regex if key rotation is frequent in a client environment."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /^((Set|Remove)-(AntiPhishPolicy|PhishFilterPolicy|DkimSigningConfig|HostedConnectionFilterPolicy)|(Disable|Remove)-AntiPhishRule|(New|Set)-TenantAllowBlockListSpoofItems)$/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1684.002")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $operation = array_distinct($setting.metadata.product_event_type)
    $source_ip = array_distinct($setting.principal.ip)

  condition:
    $setting
}
