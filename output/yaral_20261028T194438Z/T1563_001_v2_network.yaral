/*
  MITRE Technique : T1563.001 - SSH Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:08:23.489759+00:00
  Reference       : https://attack.mitre.org/techniques/T1563/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_001_Outbound_SSH_To_External_Destination {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host initiating an SSH (TCP/22) connection to a non-internal destination as seen by perimeter devices. A hijacked SSH agent socket or session lets an adversary reuse a victim's trusted keys to reach systems outside the local network, such as cloud-hosted servers or third-party bastions. Servers rarely make direct outbound SSH connections to external addresses, so the perimeter log is a useful network-side signal that complements endpoint coverage."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1563.001"
    mitre_technique_name = "Remote Service Session Hijacking: SSH Hijacking"
    log_prerequisites = "Requires firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. The %rfc1918_internal reference list must be populated for the tenant."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Developers or admins using SSH or git-over-SSH to external code hosts, approved vendor or managed-service SSH access, automated deployment or backup jobs pushing to external SFTP/SSH endpoints, and Linux build servers pulling from external repositories over SSH."
    tuning_guidance = "Add approved sources (jump hosts, build servers, deployment hosts) to %global_allowed_mgmt_sources. Keep %rfc1918_internal current for each tenant. If developer workstations are noisy, scope the rule to server subnets at the SIEM level, or raise severity only for sources that have no baseline of outbound SSH."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 22
    $net.network.ip_protocol = "TCP"
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1563.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $source_hostnames = array_distinct($net.principal.hostname)

  condition:
    $net
}
