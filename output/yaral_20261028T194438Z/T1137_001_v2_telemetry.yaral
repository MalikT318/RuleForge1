/*
  MITRE Technique : T1137.001 - Office Template Macros
  Tactic(s)       : Persistence
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:14:28.300330+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_001_Office_Template_Macro_Artifact_Dropped {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of an Office base-template or startup-folder artifact (Normal.dotm, NormalEmail.dotm, Word STARTUP add-ins, Excel XLSTART workbooks such as PERSONAL.XLSB) by a process other than the Office applications themselves. Attackers plant macro-enabled templates in these locations so that their code runs each time Word or Excel starts. This detects the resulting file artifact rather than the command line, so it still fires when the dropper process or its command-line logging is evaded."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.001"
    mitre_technique_name = "Office Application Startup: Office Template Macros"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) that populates target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Profile migration or roaming-profile sync tools, backup/restore agents, IT deployment of corporate Normal.dotm templates or approved Excel add-ins, OneDrive or file-redirection agents, and user-initiated copying of PERSONAL.XLSB between machines."
    tuning_guidance = "Add approved deployment, RMM and profile-management binaries to %global_allowed_admin_tools. Add backup and restore agents to %global_allowed_backup_processes. Add EDR/AV agents to %global_allowed_security_tools. A companion rule on FILE_MODIFICATION can cover in-place edits of an existing Normal.dotm by non-Office processes."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\appdata\\roaming\\microsoft\\(templates\\normal(email)?\.dotm?|excel\\xlstart\\[^\\]+\.(xlsb|xlsm|xlam|xls)|word\\startup\\[^\\]+\.(dotm|dot|docm|wll))$/ nocase
    not $file.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msoadfsb|officeclicktorun|officec2rclient)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1137.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $user = array_distinct($file.principal.user.userid)
    $dropped_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
