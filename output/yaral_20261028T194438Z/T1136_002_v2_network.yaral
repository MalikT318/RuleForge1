/*
  MITRE Technique : T1136.002 - Domain Account
  Tactic(s)       : Persistence
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:09:23.344527+00:00
  Reference       : https://attack.mitre.org/techniques/T1136/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_002_External_Source_To_Directory_Account_Mgmt_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a connection from a non-internal source to directory-service ports used to create or manage domain accounts (LDAP, LDAPS, Global Catalog, Kerberos password set/change on 464). Perimeter logs cannot see the account-creation command itself. This rule therefore catches the network precondition for remote domain account creation: an external host reaching Active Directory services. Pair it with endpoint rules for 'net user /add /domain' and Event ID 4720 for full coverage."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136.002"
    mitre_technique_name = "Create Account: Domain Account"
    log_prerequisites = "Firewall or perimeter NETWORK_CONNECTION logs with populated principal.ip, target.ip and target.port. Traffic must be logged at an interface where the real external source address is visible (no source NAT)."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Internet scanners and exposure-management services probing LDAP ports, partner or cloud directory synchronisation that is intentionally exposed, VPN or remote-access address pools that are not covered by the internal address list, and authorised penetration tests."
    tuning_guidance = "Add authorised scanner and pen-test sources to %global_allowed_scanners. Add approved remote management or directory-sync source addresses to %global_allowed_mgmt_sources. Add client VPN pool addresses to %rfc1918_internal if they are not already present. Domain controllers should never be reachable from the internet, so treat any remaining hit as high priority."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 389 or
      $net.target.port = 464 or
      $net.target.port = 636 or
      $net.target.port = 3268 or
      $net.target.port = 3269
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1136.002")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
