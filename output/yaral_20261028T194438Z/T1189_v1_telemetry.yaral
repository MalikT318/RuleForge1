/*
  MITRE Technique : T1189 - Drive-by Compromise
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:34:26.904956+00:00
  Reference       : https://attack.mitre.org/techniques/T1189
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1189_Linux_Browser_Drops_Executable_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web browser process writing an executable or auto-start artifact (shell script, ELF/binary, shared object, AppImage, or autostart .desktop entry) into a world-writable staging directory (/tmp, /var/tmp, /dev/shm) or a user autostart location. This file-level state change is a common result of browser exploitation or a drive-by download, and is independent of command-line logging."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1189"
    mitre_technique_name = "Drive-by Compromise"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry with the creating (principal) process path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Users deliberately saving scripts or AppImages through the browser, browser-based installers or extensions that write helper scripts, web-based IDEs or developer tooling, and browser-managed native messaging host installers that create .desktop files."
    tuning_guidance = "Add developer workstation or kiosk hostnames that legitimately handle scripts to %global_allowed_script_hosts. Add approved EDR/AV agents to %global_allowed_security_tools. Add automation accounts to %global_allowed_service_accounts. Extend or narrow the extension list in the target path regex to suit the client environment."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(firefox|firefox-bin|firefox-esr|chrome|google-chrome|chromium|chromium-browser|brave|brave-browser|opera|vivaldi|msedge|microsoft-edge|epiphany|midori|librewolf|waterfox)$/ nocase
    (
      $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.*\.(sh|bash|elf|bin|run|so|py|pl|appimage|desktop)$/ nocase or
      $file.target.file.full_path = /^(\/home\/[^\/]+|\/root)\/\.config\/autostart\/[^\/]+\.desktop$/ nocase
    )
    not $file.principal.hostname in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1189")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file = array_distinct($file.target.file.full_path)
    $browser_process = array_distinct($file.principal.process.file.full_path)
    $affected_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
