/*
  MITRE Technique : T1550.003 - Pass the Ticket
  Tactic(s)       : Lateral Movement
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:40:44.149801+00:00
  Reference       : https://attack.mitre.org/techniques/T1550/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1550_003_Pass_The_Ticket_Anomalous_Parent_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects Kerberos ticket handling (ticket import/export, klist, TGT/TGS requests, Kerberos ticket files) by a shell, script interpreter or klist process that was spawned by a parent that should never launch one: an Office application, web server worker, print spooler or database service. This lineage indicates an exploited or macro-driven foothold staging pass-the-ticket for lateral movement."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1550.003"
    mitre_technique_name = "Use Alternate Authentication Material: Pass the Ticket"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web applications or SQL Server jobs that legitimately shell out to run klist for Kerberos diagnostics, IIS-hosted admin portals that invoke PowerShell for Kerberos or AD operations, Office macros or add-ins from IT that inspect the ticket cache, and authorised red team exercises."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts and approved admin tooling to %global_allowed_admin_tools. Add automation or application-pool service accounts that legitimately run Kerberos diagnostics to %global_allowed_service_accounts. Narrow or extend the parent process regex to match the client's software estate."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|visio|onenote|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|spoolsv|sqlservr|mysqld)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|klist)\.exe$/ nocase
    $proc.target.process.command_line = /(\bklist\b|\.kirbi|\.ccache|\bptt\b|\basktgt\b|\basktgs\b|\bs4u\b|\bcreatenetonly\b|kerberos|\bticket)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1550.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
