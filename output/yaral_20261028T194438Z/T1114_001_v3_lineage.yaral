/*
  MITRE Technique : T1114.001 - Local Email Collection
  Tactic(s)       : Collection
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:18:07.297891+00:00
  Reference       : https://attack.mitre.org/techniques/T1114/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_001_Anomalous_Parent_Spawns_Shell_Accessing_Mailbox_Files {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office application, web server worker, database service or print spooler spawning a shell or script interpreter whose command line references Outlook data files (.pst/.ost) or the local Outlook data store. These parents do not normally launch interpreters that touch local mailbox files, so this lineage suggests macro, web shell or exploited-service driven local email collection."
    mitre_tactic = "Collection"
    mitre_technique = "T1114.001"
    mitre_technique_name = "Email Collection: Local Email Collection"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros or add-ins in legitimate mailbox archiving or migration workflows, eDiscovery or compliance export scripts launched from Office, line-of-business web apps or database jobs that legitimately process PST files (mail import/export portals, SQL Agent jobs), and backup or migration tooling invoked through a script host."
    tuning_guidance = "Add approved parent or child binaries to %global_allowed_script_hosts, %global_allowed_admin_tools and %global_allowed_backup_processes. Add the specific parent process of any legitimate mail-migration or archiving workflow to %global_allowed_script_hosts. Extend the parent regex (for example with the mail client itself) only if it is not already generating legitimate shell activity in the environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|msaccess|mspub|visio|w3wp|httpd|nginx|php-cgi|tomcat\d*|sqlservr|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(\.(pst|ost)\b|\\microsoft\\outlook\\|\\outlook files\\)/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1114.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
