/*
  MITRE Technique : T1021.006 - Windows Remote Management
  Tactic(s)       : Lateral Movement
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:43:35.729186+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_006_WinRM_Perimeter_Crossing_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network connection to the WinRM service ports (5985 HTTP / 5986 HTTPS) that crosses the network perimeter, where either the source or the destination is outside internal address space. WinRM should normally stay on internal management networks. Perimeter-crossing WinRM indicates inbound remote command execution with valid accounts, outbound WinRM to an attacker-controlled or third-party host, or lateral movement through a pivot. This is a network-side detection and does not rely on endpoint process telemetry."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.006"
    mitre_technique_name = "Remote Services: Windows Remote Management"
    log_prerequisites = "Firewall, proxy, or perimeter network logs normalised to UDM NETWORK_CONNECTION events with principal.ip, target.ip and target.port populated. The firewall must see traffic crossing the perimeter. East-west WinRM that never crosses the firewall is covered by the endpoint-based rules."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Approved MSP or vendor remote administration over WinRM through a VPN or NAT, cloud-hosted Windows servers managed from a corporate network, hybrid-cloud automation (configuration management, patching orchestration), authorised penetration tests and vulnerability scans, and DMZ jump hosts that legitimately administer internal servers."
    tuning_guidance = "Add approved management source addresses to %global_allowed_mgmt_sources and authorised scanner addresses to %global_allowed_scanners. Populate %rfc1918_internal with the internal address space of each client. For clients with legitimate cloud or hybrid WinRM administration, restrict by approved source addresses in %global_allowed_mgmt_sources rather than disabling the rule. Consider raising severity when the source is external and the destination is an internal host."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 5985 or $net.target.port = 5986)
    (not $net.principal.ip in %rfc1918_internal or not $net.target.ip in %rfc1918_internal)
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1021.006")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
