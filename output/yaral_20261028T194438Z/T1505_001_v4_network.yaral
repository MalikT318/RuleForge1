/*
  MITRE Technique : T1505.001 - SQL Stored Procedures
  Tactic(s)       : Persistence
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:26:36.852818+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_001_Linux_DB_Server_External_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux database server daemon (SQL Server, MySQL/MariaDB, PostgreSQL, Oracle), or a process spawned by one, opening an outbound connection to a non-internal address. Database engines rarely initiate internet connections. When they do, it often indicates a malicious stored procedure, UDF or extension (e.g. xp_cmdshell on SQL Server for Linux, MySQL UDF, PostgreSQL COPY PROGRAM) performing reverse-shell, download or exfiltration activity. This is a network-side detection and is independent of process command-line rules."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.001"
    mitre_technique_name = "Server Software Component: SQL Stored Procedures"
    log_prerequisites = "Requires Linux EDR or auditd (connect syscall) network telemetry, normalised to NETWORK_CONNECTION, with the initiating process path and, for the child-process branch, the parent process path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Linked servers or replication/availability-group partners on public or non-RFC1918 addresses, database-initiated calls to cloud storage for backups, license or telemetry check-ins, external monitoring or exporter agents spawned by the DB service, managed cloud DB services using public endpoints."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools and backup agents spawned by the DB to %global_allowed_backup_processes. Extend the port exclusions if the customer uses non-default replication ports. Review the destination_ips and destination_ports outcome fields before suppressing."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    (
      (
        $net.principal.process.file.full_path = /\/(sqlservr|mysqld|mariadbd|postgres|oracle)$/ nocase
        $net.target.port != 1433
        $net.target.port != 3306
        $net.target.port != 5432
        $net.target.port != 5022
        $net.target.port != 1521
      )
      or
      $net.principal.process.parent_process.file.full_path = /\/(sqlservr|mysqld|mariadbd|postgres|oracle)$/ nocase
    )

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1505.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $parent_process = array_distinct($net.principal.process.parent_process.file.full_path)

  condition:
    $net
}
