/*
  MITRE Technique : T1036.008 - Masquerade File Type
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:09:13.343469+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_008_Linux_Masqueraded_File_Created_Then_Executed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A file with a benign-looking extension (image, text, document, media) is created in a world-writable or user-writable Linux location and the same path is then launched as a process on the same host within 10 minutes. Legitimate non-executable file types are never executed directly, so this indicates a payload disguised by its file extension."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.008"
    mitre_technique_name = "Masquerading: Masquerade File Type"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that normalises file creation (FILE_CREATION) and process execution (PROCESS_LAUNCH) with full file paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software installers or build systems that unpack helper binaries with a generic .dat or .log extension into /tmp and run them, CI runners, self-extracting archives, and admin troubleshooting scripts."
    tuning_guidance = "Add approved deployment, packaging, or automation binaries to %global_allowed_admin_tools. Add trusted interpreters or build hosts to %global_allowed_script_hosts. Remove .dat from the extension list if it is noisy in your environment."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|home\/[^\/]+|var\/www)\/.*\.(jpe?g|png|gif|bmp|ico|svg|webp|txt|pdf|log|css|mp3|mp4|dat)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $path

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|home\/[^\/]+|var\/www)\/.*\.(jpe?g|png|gif|bmp|ico|svg|webp|txt|pdf|log|css|mp3|mp4|dat)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname
    $proc.target.process.file.full_path = $path

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1036.008")
    $primary_entity = array_distinct($hostname)
    $masqueraded_path = array_distinct($path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $launching_parent = array_distinct($proc.principal.process.file.full_path)
    $executing_user = array_distinct($proc.principal.user.userid)
    $exec_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $file and $proc
}
