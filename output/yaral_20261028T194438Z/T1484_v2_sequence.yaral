/*
  MITRE Technique : T1484 - Domain or Tenant Policy Modification
  Tactic(s)       : Defense Impairment, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:30:45.193167+00:00
  Reference       : https://attack.mitre.org/techniques/T1484
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1484_Privileged_Group_Change_Then_Directory_Policy_ACL_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "The same actor adds a member to a privileged or policy-management directory group and then, within ten minutes, changes permissions on a domain policy object (Group Policy container, policy store, or domain trust object). This sequence is consistent with an adversary granting themselves rights and then tampering with domain-wide policy or trust configuration."
    mitre_tactic = "Defense Impairment, Privilege Escalation"
    mitre_technique = "T1484"
    mitre_technique_name = "Domain or Tenant Policy Modification"
    log_prerequisites = "Requires normalized directory audit events from Active Directory domain controllers: Windows Security events for group membership changes (4728/4732/4756) and directory object permission changes (5136/4670) mapped to GROUP_MODIFICATION and USER_CHANGE_PERMISSIONS, with principal.user.userid populated."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Planned delegation of GPO administration, domain administrator onboarding or offboarding, identity governance or privileged access management tooling, and AD migration or consolidation projects."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation or PAM accounts to %global_allowed_service_accounts. Narrow the group name regex or the policy object regex to match the client's delegation model."

  events:
    $grp.metadata.event_type = "GROUP_MODIFICATION"
    $grp.target.group.group_display_name = /(domain admins|enterprise admins|schema admins|administrators|group policy creator owners|account operators|server operators|backup operators|dnsadmins)/ nocase
    $grp.principal.user.userid = $actor
    not $grp.principal.user.userid in %global_allowed_admin_users
    not $grp.principal.user.userid in %global_allowed_service_accounts

    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.target.resource.name = /(groupPolicyContainer|cn=policies,cn=system|trustedDomain|cn=domainupdates|cn=sysvol)/ nocase
    $perm.principal.user.userid = $actor
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_service_accounts

    $grp.metadata.event_timestamp.seconds <= $perm.metadata.event_timestamp.seconds

  match:
    $actor over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1484")
    $primary_entity = array_distinct($actor)
    $modified_groups = array_distinct($grp.target.group.group_display_name)
    $policy_objects = array_distinct($perm.target.resource.name)
    $source_hosts = array_distinct($perm.principal.hostname)
    $event_count = count($perm.metadata.id)

  condition:
    $grp and $perm
}
