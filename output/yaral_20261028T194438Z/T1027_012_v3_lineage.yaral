/*
  MITRE Technique : T1027.012 - LNK Icon Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:57:22.646726+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_012_LNK_Smuggling_Unexpected_Parent_Spawns_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a script interpreter or download-capable LOLBin launched by a document, mail, PDF, archive or browser process. Phishing chains that use LNK icon smuggling (T1027.012) commonly reach this state after the user opens a shortcut delivered by one of these applications. The rule pivots on the anomalous parent-child lineage and does not match command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.012"
    mitre_technique_name = "Obfuscated Files or Information: LNK Icon Smuggling"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry (EDR or Sysmon Event ID 1) that populates both the parent process path and the child process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros or add-ins that legitimately call cmd or PowerShell (finance and ERP integrations); archive tools running post-extract scripts; PDF or browser helper integrations; software packaging and deployment workflows; developers or admins testing automation from Office."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts, approved deployment or RMM tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Per-client Office-based automation is the most common source of noise, so allowlist those parents by executable name."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|onenote|msaccess|mspub|visio|acrord32|acrobat|foxitreader|winrar|7zfm|7zg|winzip(32|64)?|chrome|msedge|firefox|brave|opera)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|mshta|wscript|cscript|rundll32|regsvr32|msiexec|bitsadmin|certutil|curl)\.exe$/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.012")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
