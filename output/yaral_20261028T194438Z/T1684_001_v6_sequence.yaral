/*
  MITRE Technique : T1684.001 - Impersonation
  Tactic(s)       : Stealth
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:32:30.189495+00:00
  Reference       : https://attack.mitre.org/techniques/T1684/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1684_001_Mailbox_Rule_Then_Urgent_Financial_Email {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a user account creating or modifying a mailbox inbox rule and then, within 10 minutes, sending email whose subject uses payment or urgency language typical of business email compromise. This pattern is consistent with an adversary who has taken over a mailbox, hidden victim replies with an inbox rule, and is impersonating the mailbox owner to push recipients into acting."
    mitre_tactic = "Stealth"
    mitre_technique = "T1684.001"
    mitre_technique_name = "Impersonation"
    log_prerequisites = "Requires Microsoft 365 unified audit logs covering Exchange admin and mailbox audit events (inbox rule changes) and email send events, normalised to UDM with principal.user.userid populated consistently on both event types (the same identity format, e.g. UPN)."
    platform = "SaaS"
    log_source = "m365"
    false_positives = "Legitimate users who create Outlook rules for organisation and then send an invoice or payment-related email; finance and accounts-payable staff; helpdesk or admins configuring rules on behalf of users; automated billing mailboxes and shared mailboxes."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and billing or automation mailboxes to %global_allowed_service_accounts. Extend or narrow the subject keyword regex to suit the client's business language. If the client's UDM mapping places the sender identity in a different field, align the join field on both events. Consider raising severity for executive or finance-role mailboxes via downstream enrichment."

  events:
    $inbox.metadata.event_type = "SETTING_MODIFICATION"
    $inbox.metadata.product_event_type = /^(New-InboxRule|Set-InboxRule|UpdateInboxRules)$/ nocase
    $inbox.principal.user.userid = $user
    not $inbox.principal.user.userid in %global_allowed_admin_users
    not $inbox.principal.user.userid in %global_allowed_service_accounts

    $mail.metadata.event_type = "EMAIL_TRANSACTION"
    $mail.network.email.subject = /\b(urgent|payment|invoice|wire|transfer|remittance|bank details|overdue|request)\b/ nocase
    $mail.principal.user.userid = $user
    not $mail.principal.user.userid in %global_allowed_service_accounts

    $inbox.metadata.event_timestamp.seconds <= $mail.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1684.001")
    $primary_entity = array_distinct($user)
    $rule_actions = array_distinct($inbox.metadata.product_event_type)
    $email_subjects = array_distinct($mail.network.email.subject)
    $email_count = count($mail.metadata.id)

  condition:
    $inbox and $mail
}
