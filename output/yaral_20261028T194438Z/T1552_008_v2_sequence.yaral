/*
  MITRE Technique : T1552.008 - Chat Messages
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:57:20.242775+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_008_Chat_Message_Harvest_Then_Export {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A user retrieves or lists chat messages through Teams/Graph audited operations and, within 10 minutes, exports content through a compliance/eDiscovery search export. This pattern fits an adversary or compromised account harvesting credentials, API keys or tokens shared in chat and staging them for removal."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.008"
    mitre_technique_name = "Unsecured Credentials: Chat Messages"
    log_prerequisites = "Microsoft 365 unified audit log ingestion with Teams and Security/Compliance workloads, normalised to UDM USER_RESOURCE_ACCESS with metadata.product_event_type populated."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legal, HR or compliance staff running authorised eDiscovery cases; records-management exports; approved archiving or backup integrations that read chats; Teams client sync activity for users who also run exports."
    tuning_guidance = "Add authorised compliance officers to %global_allowed_admin_users, archiving/eDiscovery automation accounts to %global_allowed_service_accounts, and approved integration principals to %global_allowed_cloud_principals. If the tenant uses different operation names, adjust the metadata.product_event_type regexes in both event blocks."

  events:
    $chat.metadata.event_type = "USER_RESOURCE_ACCESS"
    $chat.metadata.product_event_type = /^(ChatRetrieved|MessagesListed|MessageHostedContentsListed|MessageHostedContentRead)$/ nocase
    $chat.principal.user.userid = $user
    not $chat.principal.user.userid in %global_allowed_service_accounts
    not $chat.principal.user.userid in %global_allowed_admin_users
    not $chat.principal.user.userid in %global_allowed_cloud_principals

    $exp.metadata.event_type = "USER_RESOURCE_ACCESS"
    $exp.metadata.product_event_type = /^(SearchExported|SearchResultsExported|SearchReportExported)$/ nocase
    $exp.principal.user.userid = $user
    not $exp.principal.user.userid in %global_allowed_service_accounts
    not $exp.principal.user.userid in %global_allowed_admin_users
    not $exp.principal.user.userid in %global_allowed_cloud_principals

    $chat.metadata.event_timestamp.seconds <= $exp.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(78)
    $mitre_technique_id = array_distinct("T1552.008")
    $primary_entity = array_distinct($user)
    $chat_operations = array_distinct($chat.metadata.product_event_type)
    $export_operations = array_distinct($exp.metadata.product_event_type)
    $chat_read_count = count($chat.metadata.id)
    $source_ips = array_distinct($chat.principal.ip)

  condition:
    $chat and $exp
}
