/*
  MITRE Technique : T1016.001 - Internet Connection Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:46:07.453396+00:00
  Reference       : https://attack.mitre.org/techniques/T1016/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_001_ESXi_Outbound_Internet_Connectivity_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an ESXi hypervisor host initiating outbound ICMP or plain-HTTP (TCP/80) traffic to an external address. Management hosts rarely talk to the internet this way, so it is a typical connectivity check (ping, wget or curl to a well-known endpoint) an adversary runs from a compromised host before attempting C2. The rule works from network telemetry rather than process command lines, so it complements existing command-line detections."
    mitre_tactic = "Discovery"
    mitre_technique = "T1016.001"
    mitre_technique_name = "System Network Configuration Discovery: Internet Connection Discovery"
    log_prerequisites = "Requires ESXi host network connection telemetry (firewall or flow logging forwarded from the hypervisor, normalised to NETWORK_CONNECTION with principal.hostname set to the ESXi host)."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Patch or VIB depot access over HTTP, hardware vendor health or phone-home checks, monitoring appliances pinging external gateways for uptime, admins troubleshooting uplink or DNS problems, and proxy or NTP reachability tests."
    tuning_guidance = "Add known-good update and vendor domains to %global_allowed_domains. Add approved monitoring or admin binaries to %global_allowed_admin_tools. Add approved scanner hosts to %global_allowed_scanners. Raise severity for hosts that should have no internet egress at all."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.network.ip_protocol = "ICMP" or
      $net.target.port = 80
    )
    $net.principal.hostname != ""
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not net.ip_in_range_cidr($net.target.ip, "127.0.0.0/8")
    not net.ip_in_range_cidr($net.target.ip, "169.254.0.0/16")
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1016.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
