/*
  MITRE Technique : T1601 - Modify System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:10:29.529847+00:00
  Reference       : https://attack.mitre.org/techniques/T1601
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_Network_Device_Image_Transfer_TFTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects TFTP (UDP/69) traffic crossing the network perimeter outside approved management sources. TFTP is the classic unauthenticated, plaintext protocol used to push or pull monolithic network device OS images, and an adversary modifying a device image (T1601) commonly relies on it. TFTP is rarely needed in normal production flows, so any session from or to a non-approved source is high-signal."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1601"
    mitre_technique_name = "Modify System Image"
    log_prerequisites = "Firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION, with principal.ip, target.ip, target.port and network.ip_protocol populated. Populate %global_allowed_mgmt_sources with approved image-staging and management hosts."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised firmware upgrades and configuration backups from a staging TFTP server, PXE or network boot infrastructure, VoIP phone provisioning, lab or test networks, and legacy device-management tooling."
    tuning_guidance = "Add approved image-staging servers and management jump hosts to %global_allowed_mgmt_sources. Add authorised vulnerability or inventory scanners to %global_allowed_scanners. If the client uses TFTP for phone or PXE provisioning, scope those sources into %global_allowed_mgmt_sources rather than disabling the rule."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    $net.network.ip_protocol = "UDP"
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1601")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
