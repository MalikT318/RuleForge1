/*
  MITRE Technique : T1601.001 - Patch System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:13:21.192573+00:00
  Reference       : https://attack.mitre.org/techniques/T1601/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_001_TFTP_Transfer_From_Unapproved_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects TFTP (UDP/69) sessions observed at the network perimeter from a source that is not an approved management source. TFTP is a standard channel for pushing or pulling network device OS images, so this can indicate an attacker staging a patched system image. The firewall cannot inspect the transferred file, so this is a transfer-channel indicator only and should be correlated with device configuration-change logs."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1601.001"
    mitre_technique_name = "Modify System Image: Patch System Image"
    log_prerequisites = "Requires firewall or perimeter connection and flow logs that populate principal.ip and target.port, with TFTP traffic permitted or logged (including denied attempts) on the inspected path."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Network engineers upgrading device firmware from a workstation that is not yet an approved management source; PXE and network boot services; zero-touch provisioning of new switches or routers; lab and staging networks; backup of device configurations via TFTP by network management systems."
    tuning_guidance = "Add legitimate firmware-staging servers, network management systems and engineer jump hosts to %global_allowed_mgmt_sources. Scanners that probe UDP/69 belong in %global_allowed_scanners. If a client legitimately uses TFTP for provisioning, scope an exception by source address rather than disabling the rule."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1601.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)

  condition:
    $net
}
