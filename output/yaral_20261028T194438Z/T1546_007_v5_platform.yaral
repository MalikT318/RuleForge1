/*
  MITRE Technique : T1546.007 - Netsh Helper DLL
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:09:39.424929+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_007_Netsh_Helper_DLL_Registry_Registration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry writes under the Netsh helper registration key (HKLM\\SOFTWARE\\Microsoft\\NetSh, including the Wow6432Node view), which registers a helper DLL that netsh.exe loads on every run. Netsh helper DLLs are a Windows-only mechanism, so a Linux, macOS or cloud variant does not exist. This rule gives additive Windows coverage from registry telemetry rather than process command lines, so it also catches registration through reg.exe, PowerShell, WMI, custom binaries or direct API calls."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.007"
    mitre_technique_name = "Event Triggered Execution: Netsh Helper DLL"
    log_prerequisites = "Requires EDR registry telemetry or Sysmon registry events (Event IDs 12/13/14) mapped to UDM REGISTRY_MODIFICATION, with the target registry key populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate VPN clients, network or firewall management software, and Windows feature installs or servicing that register their own netsh helpers; RMM or deployment tooling during software installs."
    tuning_guidance = "Add approved installer or deployment binaries to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. Review registry_value_data in the outcome: legitimate helpers are normally signed DLLs in System32 or a vendor Program Files directory, while unusual paths such as user profile, temp or ProgramData locations warrant escalation."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SOFTWARE\\(Wow6432Node\\)?Microsoft\\NetSh(\\|$)/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1546.007")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $registry_value_data = array_distinct($reg.target.registry.registry_value_data)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
