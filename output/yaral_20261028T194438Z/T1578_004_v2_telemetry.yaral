/*
  MITRE Technique : T1578.004 - Revert Cloud Instance
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:54:39.747867+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_004_Cloud_Instance_Revert_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a control-plane configuration change that reverts a cloud compute instance to an earlier state: replacing a root volume from a snapshot or image, restoring a snapshot, or reimaging an instance to reset ephemeral OS storage. Adversaries use these actions to erase evidence of their activity on the instance. Detection works at the configuration-change layer (SETTING_MODIFICATION), so it does not depend on command-line or guest-OS telemetry."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578.004"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Revert Cloud Instance"
    log_prerequisites = "Cloud provider control-plane audit logs (management or admin activity events) ingested and normalised to UDM, with metadata.product_event_type and principal.user.userid populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Approved disaster-recovery tests and restores, golden-image or autoscaling refresh automation, CI/CD pipelines that reimage build or test instances, scheduled VM reimaging for patching or compliance, admins recovering from a failed change or corruption."
    tuning_guidance = "Add automation and pipeline identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named DR or platform admins to %global_allowed_admin_users. Extend the product_event_type regex if the tenant normalises extra restore or reimage API names. Raise severity or add a correlation with prior suspicious activity on the same instance for production workloads."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /(ReplaceRootVolume|RestoreSnapshot|RevertToSnapshot|RevertSnapshot|RestoreDisk|SwapOsDisk|virtualMachines\/reimage|instances\.revert)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1578.004")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_actions = array_distinct($cloud.metadata.product_event_type)
    $target_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
