/*
  MITRE Technique : T1071.001 - Web Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:05:27.946271+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_001_Linux_Volatile_Path_Process_Web_Beaconing {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a single Linux host where processes executing from world-writable or volatile directories (/tmp, /var/tmp, /dev/shm, /run/user) make a high volume of outbound web-port connections (80/443/8080/8443) to external addresses within 10 minutes. A single connection is benign; repeated check-ins from a binary in a staging directory resemble C2 beaconing over web protocols."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.001"
    mitre_technique_name = "Application Layer Protocol: Web Protocols"
    log_prerequisites = "Requires Linux endpoint telemetry (EDR or auditd with network connect auditing) that populates NETWORK_CONNECTION events with principal process path, target IP and target port."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Self-extracting installers or package builds run from /tmp that download dependencies, CI/CD build agents and containers using temp directories, developer scripts or compiled test binaries calling APIs, and software updaters staging in /var/tmp."
    tuning_guidance = "Add approved tooling and build/deployment binaries to %global_allowed_admin_tools, EDR/security agents to %global_allowed_security_tools. Raise the #net threshold on build servers or lower it for high-value servers. Per-host exclusions for CI runners can be handled through the allowlisted process paths."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/user\/[0-9]+)\// nocase
    ($net.target.port = 80 or $net.target.port = 443 or $net.target.port = 8080 or $net.target.port = 8443)
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    $net.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1071.001")
    $primary_entity = array_distinct($host)
    $event_count = count($net.metadata.id)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_processes = array_distinct($net.principal.process.file.full_path)
    $source_users = array_distinct($net.principal.user.userid)

  condition:
    #net >= 15
}
