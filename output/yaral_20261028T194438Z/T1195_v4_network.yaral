/*
  MITRE Technique : T1195 - Supply Chain Compromise
  Tactic(s)       : Initial Access
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:38:18.123398+00:00
  Reference       : https://attack.mitre.org/techniques/T1195
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_Linux_Package_Manager_External_Unapproved_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux package manager or language dependency tool (pip, npm, yarn, gem, cargo, go, composer, apt, dnf, yum and similar) opening a network connection to an external host that is not in the approved domain list. This is the network footprint of dependencies or updates being pulled from a rogue, typosquatted or compromised registry or mirror, as in dependency confusion and software distribution compromise."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195"
    mitre_technique_name = "Supply Chain Compromise"
    log_prerequisites = "Requires Linux EDR or auditd network connection telemetry that records the initiating process path and the destination hostname or IP, normalised to UDM NETWORK_CONNECTION."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Builds that use private or internal registries and mirrors hosted externally, vendor repositories (for example a third-party apt or yum repo), new but legitimate CDN hostnames for public registries, developer workstations installing packages from personal forks or Git hosts."
    tuning_guidance = "Populate %global_allowed_domains with approved registry and mirror domains (PyPI, npm, RubyGems, crates, Go proxy, distro mirrors, internal artifact repositories). Add approved build or CI tooling to %global_allowed_admin_tools. Exact matching on target.hostname means CDN subdomains may need to be listed individually. Consider raising severity for production servers that should never install packages ad hoc."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(pip[0-9.]*|npm|yarn|pnpm|gem|cargo|go|composer|apt|apt-get|aptitude|dnf|yum|zypper|conda|mvn|gradle)$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1195")
    $primary_entity = array_distinct($net.principal.hostname)
    $package_tool = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
