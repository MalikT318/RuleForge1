/*
  MITRE Technique : T1668 - Exclusive Control
  Tactic(s)       : Persistence
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:10:09.454976+00:00
  Reference       : https://attack.mitre.org/techniques/T1668
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1668_Linux_Immutable_Flag_On_Access_Control_Files {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects chattr setting the immutable (+i) or append-only (+a) attribute on files that control access or persistence on Linux (SSH authorized_keys, cron, sudoers, passwd/shadow, sshd_config, ld.so.preload, rc.local, systemd units). Adversaries use this to lock out other actors and administrators by preventing their keys, accounts, or scheduled jobs from being changed or removed, which is the 'closing the door' behaviour of Exclusive Control."
    mitre_tactic = "Persistence"
    mitre_technique = "T1668"
    mitre_technique_name = "Exclusive Control"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records that populate the full command line and the target process path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Hardening scripts and CIS/STIG baselines that set immutable flags on sshd_config, passwd or shadow; configuration management agents; admins locking authorized_keys on bastion hosts; FIM or compliance tooling."
    tuning_guidance = "Add approved hardening and config-management binaries to %global_allowed_admin_tools and named administrators to %global_allowed_admin_users. If a client hardens files routinely, narrow the path regex per client or allowlist the parent process."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/chattr$/ nocase
    // chattr flag set adding immutable (i) or append-only (a); flag letters are case-sensitive
    $proc.target.process.command_line = /\s\+[a-zA-Z]*[ia]/
    // sensitive access-control and persistence locations
    $proc.target.process.command_line = /(authorized_keys|\/\.ssh|\/etc\/(crontab|cron\.|passwd|shadow|group|gshadow|sudoers|ld\.so\.preload|rc\.local|ssh\/sshd_config|hosts\.(allow|deny)|systemd\/system)|\/var\/spool\/cron)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1668")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
