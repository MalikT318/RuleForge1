/*
  MITRE Technique : T1039 - Data from Network Shared Drive
  Tactic(s)       : Collection
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:24:27.398764+00:00
  Reference       : https://attack.mitre.org/techniques/T1039
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1039_Linux_Bulk_Collection_From_Network_Share_Mount {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a native search, copy or archive utility launched against a mounted network share path (NFS/CIFS/SMB mount points, gvfs, automounts) with recursive, pattern-search, archive or sensitive-keyword arguments. This is the typical way an adversary on a Linux host hunts for and stages files of interest from network shared drives before exfiltration."
    mitre_tactic = "Collection"
    mitre_technique = "T1039"
    mitre_technique_name = "Data from Network Shared Drive"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to UDM PROCESS_LAUNCH with full command-line capture."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup and imaging jobs, administrators migrating or auditing data on NFS/CIFS mounts, developers or data engineers running recursive greps or archives on mounted storage, configuration management and deployment scripts, and scheduled log or report collection from shared storage."
    tuning_guidance = "Add approved backup software to %global_allowed_backup_processes, approved IT and deployment tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Customers whose network shares mount outside /mnt, /media, /net, /run/media or gvfs can extend the path regex. Consider raising severity for interactive users on servers that never touch shares."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(find|grep|egrep|fgrep|rg|ag|locate|cp|rsync|tar|zip|7z|7za|7zr)$/ nocase
    $proc.target.process.command_line = /(\/mnt\/|\/media\/|\/run\/media\/|\/run\/user\/[0-9]+\/gvfs\/|\/net\/|\/srv\/(nfs|smb|samba))/ nocase
    $proc.target.process.command_line = /(\s-[a-z]*[ra][a-z]*\s|\s-(i?name|exec|regex)\s|--recursive|--include|\s-?[czx]+f\s|\*\.(docx?|xlsx?|pptx?|pdf|pst|kdbx|pem|key|sql|bak|csv|conf|db)\b|passw|secret|credential)/ nocase
    not $proc.target.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1039")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $tool = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
