/*
  MITRE Technique : T1546.001 - Change Default File Association
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:00:33.043587+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_001_Dropped_Binary_Then_File_Association_Handler_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A process drops an executable or script into a user-writable location and, within ten minutes, the same process on the same host modifies a file-association handler command key (shell\\open\\command and similar). This pattern indicates persistence through a hijacked file-type handler that points at attacker-dropped content. The rule uses file and registry telemetry, so it does not duplicate command-line rules for assoc or ftype."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.001"
    mitre_technique_name = "Event Triggered Execution: Change Default File Association"
    log_prerequisites = "Requires endpoint FILE_CREATION and REGISTRY_MODIFICATION telemetry with initiating-process paths populated (EDR or Sysmon Event IDs 11 and 13). Registry monitoring must cover HKCR and HKLM/HKU Software\\Classes."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters that register their own file handlers (for example PDF readers, archivers, media players, Office add-ins), per-user application installers writing under AppData, and RMM or deployment agents."
    tuning_guidance = "Add approved installer, deployment or patching process paths to %global_allowed_admin_tools and EDR or AV agent paths to %global_allowed_security_tools. Review recurring benign installers by initiating process and handler key before allowlisting. If the noise is high, add an exclusion for specific handler names in the registry key."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(exe|dll|scr|bat|cmd|ps1|vbs|vbe|js|jse|wsf|hta)$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|users\\public|programdata|windows\\temp|temp)\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname
    $file.principal.process.file.full_path = $proc_path

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(^HKEY_CLASSES_ROOT\\|^HKCR\\|\\software\\classes\\).+\\shell\\(open|edit|print|printto|runas)\\command$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $hostname
    $reg.principal.process.file.full_path = $proc_path

    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname, $proc_path over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1546.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $acting_process = array_distinct($proc_path)
    $acting_user = array_distinct($reg.principal.user.userid)
    $dropped_files = array_distinct($file.target.file.full_path)
    $modified_handler_keys = array_distinct($reg.target.registry.registry_key)
    $dropped_file_count = count_distinct($file.target.file.full_path)

  condition:
    $file and $reg
}
