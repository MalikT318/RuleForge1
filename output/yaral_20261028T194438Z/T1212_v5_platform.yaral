/*
  MITRE Technique : T1212 - Exploitation for Credential Access
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:20:53.789606+00:00
  Reference       : https://attack.mitre.org/techniques/T1212
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1212_Linux_Network_Service_Modifies_Credential_Store {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing service daemon (web server, application runtime, database, directory or file service) modifying a local Linux credential store such as /etc/shadow, /etc/passwd, /etc/sudoers, or a Kerberos keytab. These daemons never legitimately write to these files, so a modification indicates the daemon was exploited and is being used to harvest, plant or tamper with credentials. The rule detects the result of exploitation rather than a specific vulnerability or payload."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1212"
    mitre_technique_name = "Exploitation for Credential Access"
    log_prerequisites = "Requires Linux EDR or auditd file-integrity telemetry (watch rules on /etc/shadow, /etc/passwd, /etc/sudoers, /etc/krb5.keytab) normalised to FILE_MODIFICATION with the writing process path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Self-service password or account management web applications running as a service and intentionally calling account utilities; directory or file services (slapd, smbd, winbindd) joined to a domain that legitimately update keytabs or local account stores; configuration management agents that run inside a Java or Node runtime; container images that bake credentials at build time."
    tuning_guidance = "Add approved management binaries to %global_allowed_admin_tools and endpoint agents to %global_allowed_security_tools. Extend the service process regex for customer-specific daemons. For hosts that run domain-join or identity services, scope exclusions by process path rather than by host."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/(shadow-?|gshadow-?|passwd-?|sudoers(\.d\/.+)?|krb5\.keytab|security\/opasswd)$/ nocase
    $file.principal.process.file.full_path = /\/(apache2|httpd|nginx|php-fpm[0-9.]*|php[0-9.]*|java|tomcat[0-9]*|node|mysqld|mariadbd|postgres|redis-server|mongod|smbd|winbindd|slapd|named|dovecot|exim4?|cupsd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1212")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $service_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
