/*
  MITRE Technique : T1547.013 - XDG Autostart Entries
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:39:54.360023+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_013_XDG_Autostart_Desktop_File_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a .desktop file in a system-wide (/etc/xdg/autostart) or per-user (~/.config/autostart) XDG Autostart directory by a process that is not a package manager, desktop session/settings component, or approved admin tool. The detection pivots on the resulting file artifact rather than command-line content, so it still fires when the entry is written by a script, an editor, a renamed binary, or an obfuscated command."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.013"
    mitre_technique_name = "Boot or Logon Autostart Execution: XDG Autostart Entries"
    log_prerequisites = "Requires Linux endpoint file-creation telemetry (EDR file events or auditd watches on /etc/xdg/autostart and user .config/autostart directories) normalised to UDM FILE_CREATION with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package installs or upgrades not captured by the package-manager exclusion, desktop settings tools adding startup applications, user-installed desktop applications (chat, sync, VPN clients) enabling 'start at login', configuration management or provisioning scripts, and golden-image or kiosk build processes."
    tuning_guidance = "Add approved provisioning, configuration-management and deployment binaries to %global_allowed_admin_tools. Add approved scripting parents or build hosts to %global_allowed_script_hosts. Extend the inline desktop-environment or package-manager process regex if a client uses additional distro tooling. Prioritise hits where the creating process is a shell, interpreter, or runs from /tmp, /dev/shm or /var/tmp."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(^|\/)(etc\/xdg|\.config)\/autostart\/[^\/]+\.desktop$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|dnf|yum|zypper|snapd|packagekitd|flatpak|pacman|gnome-shell|gnome-session|gnome-control-center|gnome-tweaks|xfce4-session|xfce4-settings-manager|kded5|kded6|plasmashell|systemsettings)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1547.013")
    $primary_entity = array_distinct($file.principal.hostname)
    $autostart_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
