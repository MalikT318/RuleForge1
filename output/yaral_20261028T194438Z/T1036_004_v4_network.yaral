/*
  MITRE Technique : T1036.004 - Masquerade Task or Service
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:03:11.085665+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_004_Linux_Masqueraded_Daemon_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound external network connection from a process whose binary name imitates a core Linux system daemon (systemd-*, rsyslogd, dbus-*, crond, sshd, udevd, kworker, auditd and similar) but which runs from a path outside the standard system binary directories. This is the network-side footprint of a masqueraded service or task, for example a backdoor persisted as a systemd unit or cron job under a legitimate-sounding daemon name. It is intended to complement process-creation and command-line detections."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.004"
    mitre_technique_name = "Masquerade Task or Service"
    log_prerequisites = "Requires Linux EDR or auditd network telemetry (connect syscalls) that populates principal.process.file.full_path and target.ip on NETWORK_CONNECTION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Vendor or third-party agents installed under /opt or a custom prefix that ship daemons with system-like names; locally compiled builds of sshd, chronyd or ntpd outside /usr; containerised workloads whose process paths are reported relative to the container filesystem; software under development or test on engineering hosts."
    tuning_guidance = "Add approved binary paths to %global_allowed_admin_tools. Add EDR or monitoring agents to %global_allowed_security_tools. Add automation accounts to %global_allowed_service_accounts. Extend the system-directory exclusion regex if the estate uses non-standard prefixes. Use %rfc1918_internal to keep internal traffic excluded. If container noise appears, exclude container-runtime hosts via %global_allowed_script_hosts or scope the rule to non-container assets."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(systemd[^\/]*|rsyslogd|syslogd|dbus[^\/]*|crond?|atd|sshd|udevd|kworker[^\/]*|auditd|journald|polkitd|avahi-daemon|irqbalance|chronyd|ntpd|snapd|cupsd|agetty|networkd|NetworkManager|accounts-daemon)$/ nocase
    not $net.principal.process.file.full_path = /^\/(usr|bin|sbin|lib|lib32|lib64|snap)\// nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1036.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $masquerading_process_path = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $process_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
