/*
  MITRE Technique : T1606.002 - SAML Tokens
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:26:15.489081+00:00
  Reference       : https://attack.mitre.org/techniques/T1606/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1606_002_IdP_Admin_Role_Grant_Then_Federated_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An account is granted a privileged directory role and then signs in through federated SSO within ten minutes. This sequence is consistent with Golden SAML tradecraft, where an adversary with administrative control of the identity provider escalates an identity and then authenticates with a forged SAML assertion."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1606.002"
    mitre_technique_name = "Forge Web Credentials: SAML Tokens"
    log_prerequisites = "Requires identity provider directory audit logs normalised to USER_CHANGE_PERMISSIONS, with the role-assignment description populated in metadata.description. Also requires sign-in logs normalised to USER_LOGIN with extensions.auth.type set to SSO."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Planned administrator onboarding followed by a first federated sign-in, just-in-time privileged access activations (PIM-style elevation) used immediately, break-glass account tests, and helpdesk staff promoted during incident response."
    tuning_guidance = "Add approved administrator actors to %global_allowed_admin_users and automation or JIT-elevation accounts to %global_allowed_service_accounts. Adjust the role-name regex to match the privileged role names your directory emits. For high-volume tenants, extend the sign-in filter with additional federated-authentication indicators."

  events:
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.metadata.description = /(add|assign|grant|elevat|activat).*(global admin|privileged|super admin|company admin|tenant admin|administrator)/ nocase
    $perm.target.user.userid = $user
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.target.user.userid in %global_allowed_service_accounts

    $auth.metadata.event_type = "USER_LOGIN"
    $auth.extensions.auth.type = "SSO"
    $auth.target.user.userid = $user
    not $auth.target.user.userid in %global_allowed_service_accounts

    $perm.metadata.event_timestamp.seconds <= $auth.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1606.002")
    $primary_entity = array_distinct($user)
    $granting_actor = array_distinct($perm.principal.user.userid)
    $login_source_ips = array_distinct($auth.principal.ip)
    $login_count = count($auth.metadata.id)

  condition:
    $perm and $auth
}
