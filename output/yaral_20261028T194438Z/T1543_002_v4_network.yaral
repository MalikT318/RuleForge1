/*
  MITRE Technique : T1543.002 - Systemd Service
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:54:36.351305+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_002_Systemd_Service_Payload_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound connection to an external address by a process that systemd (PID 1) started and whose binary runs from a world-writable or hidden location such as /tmp, /var/tmp, /dev/shm, /run/user or a hidden directory under /home. This is the network footprint of a malicious systemd service unit, where ExecStart launches a dropped payload that beacons out or fetches tooling. Legitimate services normally run from /usr, /opt or /lib, so this complements endpoint rules that match unit-file creation or command lines."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.002"
    mitre_technique_name = "Create or Modify System Process: Systemd Service"
    log_prerequisites = "Requires Linux EDR or auditd network telemetry normalised to NETWORK_CONNECTION with principal process path and parent process path populated. Parent process visibility is required to tie the connection to systemd."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Self-updating agents or developer tools installed under a hidden home directory and run as a systemd user service, containers or CI runners that execute from /tmp or /run/user, and temporary RMM or deployment agents run from staging directories."
    tuning_guidance = "Add approved agent binaries to %global_allowed_admin_tools, security agents to %global_allowed_security_tools, and known-good remote tooling to %global_allowed_remote_mgmt. Exclude expected destinations via %global_allowed_mgmt_sources. Internal destinations are already excluded by %rfc1918_internal. If the parent process path is not populated for a client, this rule will not fire for that client."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.parent_process.file.full_path = /\/(systemd|init)$/ nocase
    $net.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/user|home\/[^\/]+\/\.[^\/]+)\// nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip = /^(127\.|::1$|fe80:)/ nocase
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1543.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
