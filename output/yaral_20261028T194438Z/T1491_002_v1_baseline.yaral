/*
  MITRE Technique : T1491.002 - External Defacement
  Tactic(s)       : Impact
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:45:54.571565+00:00
  Reference       : https://attack.mitre.org/techniques/T1491/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_002_External_Web_Content_Write_Via_HTTP_Method {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external source successfully using a content-modifying HTTP method (PUT, MOVE, COPY, PROPPATCH) against a web content resource (html, aspx, php, jsp, js, css) on an internet-facing web server. This is the network-visible result of web content being overwritten or replaced, which is the mechanism behind external defacement."
    mitre_tactic = "Impact"
    mitre_technique = "T1491.002"
    mitre_technique_name = "Defacement: External Defacement"
    log_prerequisites = "Requires firewall, reverse proxy, or WAF logs that decode HTTP (method, URL, response code) and are normalised to NETWORK_HTTP. TLS inspection or termination in front of the web servers is required to see the method and URL."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Authorised content publishing from external CMS or CI/CD pipelines, WebDAV-based editing by remote staff or contractors, vendor-managed web hosting, and authorised penetration tests."
    tuning_guidance = "Add approved publishing and management source addresses to %global_allowed_mgmt_sources. Add authorised testing sources to %global_allowed_scanners. Add named content publishers to %global_allowed_admin_users if the proxy records user identity. If WebDAV is used legitimately, scope with the target host or URL path."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(PUT|MOVE|COPY|PROPPATCH)$/ nocase
    $net.target.url = /\.(html?|aspx?|php|jsp|js|css)(\?.*)?$/ nocase
    $net.network.http.response_code >= 200
    $net.network.http.response_code < 300
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1491.002")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_urls = array_distinct($net.target.url)
    $http_methods = array_distinct($net.network.http.method)

  condition:
    $net
}
