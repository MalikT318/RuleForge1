/*
  MITRE Technique : T1620 - Reflective Code Loading
  Tactic(s)       : Stealth
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:45:37.204258+00:00
  Reference       : https://attack.mitre.org/techniques/T1620
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1620_PowerShell_Reflective_Assembly_Load_Then_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a PowerShell process launched with a command line that reflectively loads a .NET assembly from in-memory bytes (Reflection.Assembly Load combined with base64 decoding or a web download), followed within 10 minutes by an outbound connection to a non-internal address from PowerShell on the same host. This pattern indicates fileless payload staging and execution in memory."
    mitre_tactic = "Stealth"
    mitre_technique = "T1620"
    mitre_technique_name = "Reflective Code Loading"
    log_prerequisites = "Requires EDR or Sysmon process launch telemetry with full command lines (Sysmon Event 1 or Windows Event 4688 with command-line auditing) and network connection telemetry (Sysmon Event 3 or EDR equivalent) that populates the initiating process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate administration or deployment scripts that load .NET assemblies from base64 or downloaded content, such as software packaging, DSC and configuration management bootstrap scripts, RMM tooling, and developer or red-team testing."
    tuning_guidance = "Add approved parent processes and script hosts to %global_allowed_script_hosts and approved deployment or RMM binaries to %global_allowed_admin_tools. Add known-good external domains or destinations to %global_allowed_domains if network exclusions are needed. Correlate on principal.process.pid if the EDR populates it consistently for tighter matching."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
    $proc.target.process.command_line = /reflection\.assembly\]?\s*::\s*(load|loadfile|unsafeloadfrom)/ nocase
    $proc.target.process.command_line = /(frombase64string|downloaddata|downloadstring|webclient|invoke-webrequest|iwr\s)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    $net.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1620")
    $primary_entity = array_distinct($hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $proc and $net
}
