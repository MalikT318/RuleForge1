/*
  MITRE Technique : T1189 - Drive-by Compromise
  Tactic(s)       : Initial Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:35:20.850129+00:00
  Reference       : https://attack.mitre.org/techniques/T1189
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1189_IdP_Scripted_Client_Login_Session_Replay {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an identity provider sign-in from an external source whose user agent is a scripted HTTP client or headless browser rather than an interactive browser. After a drive-by compromise, adversaries replay stolen session tokens or harvested credentials from automation tooling. This is identity-plane coverage of the post-exploitation result, not endpoint process activity."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1189"
    mitre_technique_name = "Drive-by Compromise"
    log_prerequisites = "Requires identity provider sign-in logs normalised to USER_LOGIN with network.http.user_agent and principal.ip populated."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Sanctioned automation and integrations that authenticate interactively as users, monitoring and synthetic-login probes, developer scripts using user credentials, authorised penetration tests, and help-desk or SSO health checks."
    tuning_guidance = "Add automation and integration accounts to %global_allowed_service_accounts, named admin or developer accounts to %global_allowed_admin_users, and approved testing sources to %global_allowed_scanners. Narrow or extend the user-agent regex to match client mix. Consider raising severity for privileged users."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.network.http.user_agent = /(headlesschrome|phantomjs|puppeteer|playwright|selenium|python-requests|python-urllib|aiohttp|go-http-client|node-fetch|axios|okhttp|libwww-perl|curl\/|wget\/|java\/)/ nocase
    $auth.target.user.userid != ""
    not $auth.principal.ip in %rfc1918_internal
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1189")
    $primary_entity = array_distinct($auth.target.user.userid)
    $source_ips = array_distinct($auth.principal.ip)
    $user_agents = array_distinct($auth.network.http.user_agent)

  condition:
    $auth
}
