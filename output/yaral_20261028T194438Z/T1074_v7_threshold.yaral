/*
  MITRE Technique : T1074 - Data Staged
  Tactic(s)       : Collection
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:17:38.455620+00:00
  Reference       : https://attack.mitre.org/techniques/T1074
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_IaaS_Mass_Snapshot_Image_Staging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single cloud identity creates or copies many disk snapshots or machine images within ten minutes. Adversaries use this to stage copies of victim data in a central location, or in an account they control, before exfiltration. Each API call is routine, but the volume from one principal is not."
    mitre_tactic = "Collection"
    mitre_technique = "T1074"
    mitre_technique_name = "Data Staged"
    log_prerequisites = "Cloud control-plane audit logs (management-plane write events) normalised to UDM RESOURCE_CREATION with principal.user.userid and metadata.product_event_type populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Backup and disaster-recovery automation, golden-image build pipelines, infrastructure-as-code deployments, migration projects, and administrators running bulk snapshot housekeeping."
    tuning_guidance = "Add automation and pipeline identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named admins to %global_allowed_admin_users. Raise the #cloud threshold for tenants with heavy snapshot automation. Lower it for tenants with no snapshot activity."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /(snapshot|createimage|copyimage|images\/write|images\.insert)/ nocase
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1074")
    $primary_entity = array_distinct($user)
    $event_count = count($cloud.metadata.id)
    $api_calls = array_distinct($cloud.metadata.product_event_type)
    $staged_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    #cloud >= 5
}
