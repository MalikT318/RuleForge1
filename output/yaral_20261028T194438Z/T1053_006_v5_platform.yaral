/*
  MITRE Technique : T1053.006 - Systemd Timers
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:18:38.287554+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_006_Linux_Systemd_Timer_Unit_File_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a systemd .timer unit file in a system, user or runtime unit directory by a process other than a package manager or approved admin tooling. Attackers use timer units, paired with a .service unit, as a cron alternative for persistence and scheduled execution. This rule is file-creation based, so it is additive to command-line rules for systemctl or systemd-run and also catches timers dropped by scripts, editors, or direct file writes."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.006"
    mitre_technique_name = "Scheduled Task/Job: Systemd Timers"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules (for example -w /etc/systemd/system -p wa) normalised to UDM FILE_CREATION, with principal.process populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package installs or upgrades not using a recognised package manager binary, configuration management agents (Ansible, Puppet, Chef, Salt), image-build and container-build pipelines, administrators manually creating legitimate timers, and applications that register their own user-level timers on first run."
    tuning_guidance = "Add configuration management and deployment binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Review hosts with frequent legitimate timer creation, such as build servers, and consider scoping them out at the client level."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/etc\/systemd\/(system|user)|\/usr\/lib\/systemd\/(system|user)|\/lib\/systemd\/(system|user)|\/home\/[^\/]+\/\.config\/systemd\/user|\/root\/\.config\/systemd\/user|\/run\/systemd\/(system|transient))\/(.*\/)?[^\/]+\.timer$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|yum|dnf|zypper|pacman|snapd|packagekitd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1053.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $timer_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $creating_command_line = array_distinct($file.principal.process.command_line)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
