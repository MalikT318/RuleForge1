/*
  MITRE Technique : T1036.003 - Rename Legitimate Utilities
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:00:34.363917+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_003_System_Utility_Copied_Then_Executed_From_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a shell or copy utility creating an executable in a user-writable directory from a command line that references a Windows system directory (copy or move of a built-in utility under a new name), followed within 10 minutes by that same file being executed on the same host. The join on the exact file path catches renamed or relocated legitimate utilities regardless of the new filename."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.003"
    mitre_technique_name = "Masquerading: Rename Legitimate Utilities"
    log_prerequisites = "Requires Windows endpoint telemetry that records FILE_CREATION with the creating process command line, and PROCESS_LAUNCH with the full image path (EDR or Sysmon Event IDs 11 and 1)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or installers that stage a copy of a system binary in a temp or ProgramData folder, software packaging and deployment scripts, developers testing LOLBin behaviour, and application compatibility workarounds that copy system tools locally."
    tuning_guidance = "Add approved deployment and staging tools to %global_allowed_admin_tools, and add approved automation hosts or parent processes to %global_allowed_script_hosts. Add service accounts that legitimately stage binaries to %global_allowed_service_accounts. If volume is high, narrow the writable-directory regex for the environment."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|programdata|users\\public|windows\\temp|temp)\\.*\.exe$/ nocase
    $file.principal.process.file.full_path = /\\(cmd|powershell|pwsh|xcopy|robocopy)\.exe$/ nocase
    $file.principal.process.command_line = /\b(copy|xcopy|robocopy|move|copy-item|move-item|cp|mv)\b/ nocase
    $file.principal.process.command_line = /\\(system32|syswow64|winsxs|windows\\microsoft\.net)\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $host
    $file.target.file.full_path = $path

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $host
    $proc.target.process.file.full_path = $path

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $host, $path over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1036.003")
    $primary_entity = array_distinct($host)
    $renamed_binary_path = array_distinct($path)
    $copy_command_lines = array_distinct($file.principal.process.command_line)
    $executed_command_lines = array_distinct($proc.target.process.command_line)
    $launch_users = array_distinct($proc.principal.user.userid)
    $launch_count = count($proc.metadata.id)

  condition:
    $file and $proc
}
