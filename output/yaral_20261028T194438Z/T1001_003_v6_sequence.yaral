/*
  MITRE Technique : T1001.003 - Protocol or Service Impersonation
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:11:09.436175+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_003_ESXi_Fake_TLS_Port443_Protocol_Mismatch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An ESXi host makes an outbound connection that impersonates TLS on port 443. The perimeter first sees plaintext HTTP on the TLS port, then sees an unclassified, non-TLS protocol to the same external IP within 10 minutes. ESXi hosts rarely initiate internet traffic, so this pattern points to C2 disguised as HTTPS."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001.003"
    mitre_technique_name = "Data Obfuscation: Protocol or Service Impersonation"
    log_prerequisites = "Firewall or proxy logs with application-layer protocol identification (application_protocol populated) and a source hostname resolvable to the ESXi host, either from DHCP/DNS/asset enrichment or a hostname naming convention containing esx, vmhost or vmware."
    platform = "ESXi"
    log_source = "firewall"
    false_positives = "Legitimate ESXi outbound traffic such as vCenter or VMware update and licensing checks, or proxy and TLS-inspection devices that mislabel application protocols. Also vendor health-check or telemetry agents on hypervisors, and misclassification of QUIC or other non-TLS traffic on 443."
    tuning_guidance = "Add approved management or jump-host source IPs to %global_allowed_mgmt_sources and VMware or vendor update domains to %global_allowed_domains. If the environment does not name hosts esx/vmhost/vmware, adjust the principal.hostname regex or switch to an asset-based filter. If the firewall does not label unrecognised traffic as UNKNOWN_APPLICATION_PROTOCOL, tune event 2 to the value the firewall emits."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.principal.hostname = /(esx|vmhost|vmware)/ nocase
    $http.principal.hostname = $hostname
    $http.target.port = 443
    $http.network.application_protocol = "HTTP"
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_mgmt_sources
    $http.target.ip = $dest_ip

    $conn.metadata.event_type = "NETWORK_CONNECTION"
    $conn.principal.hostname = /(esx|vmhost|vmware)/ nocase
    $conn.principal.hostname = $hostname
    $conn.target.port = 443
    $conn.network.application_protocol = "UNKNOWN_APPLICATION_PROTOCOL"
    not $conn.target.ip in %rfc1918_internal
    not $conn.target.hostname in %global_allowed_domains
    not $conn.principal.ip in %global_allowed_mgmt_sources
    $conn.target.ip = $dest_ip

    $http.metadata.event_timestamp.seconds <= $conn.metadata.event_timestamp.seconds

  match:
    $hostname, $dest_ip over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1001.003")
    $primary_entity = array_distinct($hostname)
    $destination_ips = array_distinct($dest_ip)
    $http_event_count = count($http.metadata.id)
    $conn_event_count = count($conn.metadata.id)
    $first_seen = min($http.metadata.event_timestamp.seconds)
    $last_seen = max($conn.metadata.event_timestamp.seconds)

  condition:
    $http and $conn
}
