/*
  MITRE Technique : T1554 - Compromise Host Software Binary
  Tactic(s)       : Persistence
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:11:20.188756+00:00
  Reference       : https://attack.mitre.org/techniques/T1554
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1554_ESXi_Daemon_Spawns_Shell_Modifying_System_Binaries {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi management daemon or service process (hostd, vpxa, rhttpproxy, sfcbd, openwsmand, slpd, snmpd and similar) spawning a shell or script interpreter whose command line writes, copies, moves, links or downloads into system binary or library directories. Management daemons never legitimately launch shells to alter files under /bin, /sbin, /lib or /usr/lib/vmware. This lineage anomaly points to exploitation of a management service followed by replacement or trojanising of a host binary, as in hypervisor backdoor persistence campaigns."
    mitre_tactic = "Persistence"
    mitre_technique = "T1554"
    mitre_technique_name = "Compromise Host Software Binary"
    log_prerequisites = "ESXi shell and process execution auditing forwarded to Chronicle and parsed into UDM PROCESS_LAUNCH events with principal.process.file.full_path (parent), target.process.file.full_path (child) and target.process.command_line populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Host patching or upgrade workflows (esxcli software, vSphere Lifecycle Manager) that run helper scripts from a management service; vendor VIB installs and driver updates; third-party agent installers triggered through the management plane; approved admin automation that shells out from a service process."
    tuning_guidance = "Add approved patching, lifecycle and automation parent binaries to %global_allowed_admin_tools. Add known automation accounts to %global_allowed_service_accounts. Extend the parent daemon regex with site-specific agent daemons if they legitimately spawn shells, and review hosts in a maintenance window before enabling alerting."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(hostd|vmware-hostd|vpxa|rhttpproxy|sfcbd|sfcb-[a-z_]+|openwsmand|slpd|snmpd|vmware-fdm|fdm|vobd|vmsyslogd|vmware-vmx|nfcd|envoy|lwsmd|lsassd)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|ash|bash|busybox|python[0-9.]*|perl)$/ nocase
    $proc.target.process.command_line = /(\b(cp|mv|dd|tee|sed|ln|install|chmod|chattr|wget|curl|scp|rsync)\b.*\/(bin|sbin|lib|lib64|usr\/bin|usr\/sbin|usr\/lib\/vmware|usr\/libexec)\/|>>?\s*\/(bin|sbin|lib|lib64|usr\/bin|usr\/sbin|usr\/lib\/vmware|usr\/libexec)\/)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1554")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
