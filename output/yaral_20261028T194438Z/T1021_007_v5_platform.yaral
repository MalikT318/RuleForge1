/*
  MITRE Technique : T1021.007 - Cloud Services
  Tactic(s)       : Lateral Movement
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:45:23.593416+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_007_Cloud_Console_Programmatic_Login_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a user sign-in to the cloud tenant from an external (non-RFC1918) source using a scripted or command-line client, identified by its user agent (shell modules, cloud CLIs, SDKs, HTTP libraries) rather than a browser. Adversaries with valid or federated credentials use these clients to run management actions as the compromised user. The rule matches the client class rather than a specific tool or payload."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.007"
    mitre_technique_name = "Remote Services: Cloud Services"
    log_prerequisites = "Unified audit and sign-in logs ingested into UDM as USER_LOGIN, with network.http.user_agent and principal.ip populated. No endpoint telemetry is required."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Administrators and engineers running legitimate automation or CLI sessions from home or a VPN egress that is not in the internal address list. Monitoring and backup connectors that sign in with HTTP libraries. Developers testing against the tenant. Approved SaaS integrations that use SDK user agents."
    tuning_guidance = "Add automation and integration identities to %global_allowed_service_accounts. Add named administrators who legitimately use CLI sessions to %global_allowed_admin_users. Add approved service principals to %global_allowed_cloud_principals. Add corporate egress addresses to %rfc1918_internal if the tenant keeps them there. Because the rule does not filter on login outcome, review whether the login succeeded in the alert. A burst of failures from one source suggests password spraying, and a success suggests account takeover."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.network.http.user_agent = /(powershell|azsdk|azure-cli|gcloud|python-requests|python-urllib|aiohttp|go-http-client|okhttp|libcurl|curl\/|wget\/|axios|node-fetch|java\/|apache-httpclient)/ nocase
    not $auth.principal.ip in %rfc1918_internal
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1021.007")
    $primary_entity = array_distinct($auth.target.user.userid)
    $source_ips = array_distinct($auth.principal.ip)
    $user_agents = array_distinct($auth.network.http.user_agent)

  condition:
    $auth
}
