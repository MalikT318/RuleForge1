/*
  MITRE Technique : T1132.001 - Standard Encoding
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:46:58.719904+00:00
  Reference       : https://attack.mitre.org/techniques/T1132/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1132_001_ESXi_Repeated_Encoding_Utility_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of standard-encoding utility executions (base64, base32, xxd, uuencode) on a single ESXi host within 10 minutes. A single invocation is routine, but repeated encoding of data in a short window suggests a script or implant encoding C2 traffic or staged data. Matching is on the executed binary name, not on command-line content."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1132.001"
    mitre_technique_name = "Data Encoding: Standard Encoding"
    log_prerequisites = "ESXi shell and process execution logging forwarded and parsed into UDM PROCESS_LAUNCH events with target.process.file.full_path populated. This typically comes from shell.log or auditd-style forwarding of ESXi shell activity."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators encoding or decoding certificates, kickstart or host profile payloads, or support-bundle content in a troubleshooting session. Vendor or automation scripts that base64-encode configuration blobs. Backup or monitoring agents running scripted encoding loops."
    tuning_guidance = "Add approved automation parent binaries to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Trusted script hosts can be added to %global_allowed_script_hosts. Raise the #proc threshold if noisy hosts remain."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(base64|base32|xxd|uuencode|b64encode)$/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1132.001")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $encoders = array_distinct($proc.target.process.file.full_path)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)

  condition:
    #proc >= 8
}
