/*
  MITRE Technique : T1547.005 - Security Support Provider
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:30:08.757932+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_005_SSP_DLL_Drop_Then_LSA_Security_Packages_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "A new DLL is written to System32 and, within ten minutes on the same host, the LSA 'Security Packages' registry value (Lsa or Lsa\\OSConfig) is modified. This sequence indicates registration of a malicious Security Support Provider that will be loaded into LSASS to harvest credentials. It is a file and registry correlation, not a command-line detection."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.005"
    mitre_technique_name = "Boot or Logon Autostart Execution: Security Support Provider"
    log_prerequisites = "Requires endpoint file-creation and registry-modification telemetry (EDR or Sysmon Event IDs 11 and 13) with the initiating process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate installers that register an authentication package, such as smart card middleware, third-party SSO or credential providers, and password filter or authentication products. Also OS servicing and feature updates, and approved IT deployment tooling."
    tuning_guidance = "Add approved deployment and installer binaries to %global_allowed_admin_tools and authentication or security agents to %global_allowed_security_tools. Review the file path and registry writer in the outcome before closing. Legitimate changes are rare and should be tracked against change tickets."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\windows\\system32\\[^\\]+\.dll$/ nocase
    not $file.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|MsMpEng|MpCmdRun)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control\\Lsa(\\OSConfig)?$/ nocase
    $reg.target.registry.registry_value_name = /^Security Packages$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1547.005")
    $primary_entity = array_distinct($reg.principal.hostname)
    $dropped_dlls = array_distinct($file.target.file.full_path)
    $dropper_processes = array_distinct($file.principal.process.file.full_path)
    $registry_writers = array_distinct($reg.principal.process.file.full_path)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $acting_users = array_distinct($reg.principal.user.userid)

  condition:
    $file and $reg
}
