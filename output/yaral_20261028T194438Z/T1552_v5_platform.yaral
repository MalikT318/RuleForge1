/*
  MITRE Technique : T1552 - Unsecured Credentials
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:44:22.810691+00:00
  Reference       : https://attack.mitre.org/techniques/T1552
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_Cloud_Secret_Store_Read_By_Scripted_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a read of stored credential material (secret values, decrypted parameters, key vault secrets) from a cloud secrets store by a scripted or CLI/SDK client. This pattern is typical of an adversary with stolen cloud credentials harvesting unsecured credentials from the control plane. Console and managed-service access is not matched. Windows and endpoint coverage is out of scope."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552"
    mitre_technique_name = "Unsecured Credentials"
    log_prerequisites = "Cloud control-plane and data-event audit logs ingested and normalised to UDM as USER_RESOURCE_ACCESS. Secrets-store read events must be enabled (e.g. secret value retrieval data events, key vault secret reads, secret version access). metadata.product_event_type and network.http.user_agent must be populated."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Deployment pipelines and infrastructure-as-code runners, application bootstrap scripts, operators running CLI tools for troubleshooting, rotation and migration jobs, and break-glass access by administrators."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, platform or workload principals to %global_allowed_cloud_principals, and named administrators to %global_allowed_admin_users. Add authorised assessment identities to %global_allowed_scanners. If the tenant's CI/CD uses a recognisable user-agent family, narrow the user-agent regex. Raise severity for principals with no prior secret-read history."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /^(GetSecretValue|BatchGetSecretValue|GetParameters?|GetParametersByPath|GetSecret|SecretGet|SecretVersionAccess|AccessSecretVersion|GetSecretVersion)/ nocase
    $cloud.target.resource.name != ""
    $cloud.network.http.user_agent = /(aws-cli|boto|botocore|aws-sdk|azure[- ]?cli|azure-sdk|az\/|gcloud|google-cloud-sdk|terraform|python-requests|curl|wget|go-http-client|powershell)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1552")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $secret_names = array_distinct($cloud.target.resource.name)
    $api_calls = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)
    $user_agents = array_distinct($cloud.network.http.user_agent)

  condition:
    $cloud
}
