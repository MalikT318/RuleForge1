/*
  MITRE Technique : T1548.003 - Sudo and Sudo Caching
  Tactic(s)       : Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:32:55.139932+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_003_Sudo_Spawned_Interpreter_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Network-side detection of privilege escalation through sudo. A shell or scripting interpreter whose parent process is sudo, running as root, opens an outbound connection to a non-internal address. This pattern is typical of sudo-elevated reverse shells, payload staging and C2 callbacks after sudo abuse or sudo credential caching. It is complementary to command-line rules because it keys on the observed network behaviour of the elevated process lineage, not on sudo arguments. Coverage depends on the EDR or auditd source populating the parent process on network events."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.003"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Sudo and Sudo Caching"
    log_prerequisites = "Requires Linux endpoint network telemetry (EDR or auditd socket/connect records) that populates principal.process.parent_process.file.full_path, principal.user.userid and target.ip on NETWORK_CONNECTION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators running sudo-wrapped package managers or scripts that call external repositories, configuration management runs (Ansible, Puppet, Chef) invoked via sudo, sudo-run monitoring or inventory scripts that call SaaS APIs, and backup or deployment scripts that pull from external endpoints."
    tuning_guidance = "Add approved automation interpreters or wrappers to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and build, patching or jump hosts to %global_allowed_script_hosts. Add package mirrors and vendor update endpoints to %global_allowed_domains. If the sensor does not populate parent process on network events, the rule will not fire."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.parent_process.file.full_path = /\/sudo$/ nocase
    $net.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|python[0-9.]*|perl|ruby|php|lua|node)$/ nocase
    $net.principal.user.userid = "root"
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1548.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $elevated_process = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
