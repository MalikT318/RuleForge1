/*
  MITRE Technique : T1505 - Server Software Component
  Tactic(s)       : Persistence
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:24:46.249076+00:00
  Reference       : https://attack.mitre.org/techniques/T1505
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_Network_External_POST_To_Script_In_Upload_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external source sending an HTTP POST that gets a successful response from a server-side script (aspx, ashx, jsp, php, cfm, cgi) located in an upload, media, temp, cache or static-content directory. These directories should hold data, not executable code. Interactive POST traffic to a script there is characteristic of a web shell or malicious server component used for persistence. Observed from the network perimeter, so it complements endpoint process and command-line coverage."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505"
    mitre_technique_name = "Server Software Component"
    log_prerequisites = "Requires perimeter telemetry that records the HTTP method, full request URL and response code (reverse proxy, WAF, or TLS-inspecting firewall) normalised to UDM NETWORK_HTTP. Plain flow logs without URL visibility cannot trigger this rule."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "CMS or e-commerce plugins that legitimately handle form or file posts through scripts in upload or media paths, image-processing endpoints, legacy applications that keep handler scripts in static directories, and authorised penetration tests or vulnerability scans."
    tuning_guidance = "Add authorised scanner and pentest source IPs to %global_allowed_scanners. Add trusted partner or management source addresses to %global_allowed_mgmt_sources. Add known-good hosted application names to %global_allowed_domains. If a specific application legitimately posts to a script in these paths, narrow the directory regex rather than disabling the rule."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.network.http.response_code >= 200
    $http.network.http.response_code < 300
    $http.target.url = /\/(uploads?|images?|img|assets|static|media|files|tmp|temp|cache|userfiles|attachments)\/([^?#]*\/)?[^\/?#]+\.(aspx?|ashx|asmx|jspx?|php[0-9]?|phtml|cfm|cgi)([?#]|$)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1505")
    $primary_entity = array_distinct($http.target.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
