/*
  MITRE Technique : T1005 - Data from Local System
  Tactic(s)       : Collection
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:12:34.586042+00:00
  Reference       : https://attack.mitre.org/techniques/T1005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1005_Linux_Large_CLI_Upload_To_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a large HTTP POST or PUT upload to an external destination from a client using a command-line or scripting HTTP user agent (curl, wget, Python, Perl, Go). This is the network-side result of local data collection being sent off-host, as seen at a firewall or proxy. It adds coverage that does not depend on endpoint process or command-line telemetry."
    mitre_tactic = "Collection"
    mitre_technique = "T1005"
    mitre_technique_name = "Data from Local System"
    log_prerequisites = "Requires firewall or proxy logs with HTTP inspection (method, user agent, bytes sent) normalised to NETWORK_HTTP. TLS interception, or an explicit proxy that sees the request metadata, is needed for HTTPS traffic."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Backup and log-shipping scripts that use curl or wget; CI/CD artifact uploads; software publishing jobs; legitimate API integrations that send bulk data from Linux servers; vendor telemetry uploads (crash dumps, support bundles)."
    tuning_guidance = "Add known-good destination domains to %global_allowed_domains. Add automation accounts that legitimately upload data to %global_allowed_service_accounts. Raise or lower the sent_bytes threshold (currently 10 MB) to suit the client's baseline upload volume. Confirm %rfc1918_internal covers the client's internal address space."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT)$/ nocase
    $net.network.http.user_agent = /(curl|wget|python-requests|python-urllib|aiohttp|libwww-perl|go-http-client|okhttp)/ nocase
    $net.network.sent_bytes > 10485760
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1005")
    $primary_entity = array_distinct($net.principal.ip)
    $source_hostname = array_distinct($net.principal.hostname)
    $destination_host = array_distinct($net.target.hostname)
    $destination_ip = array_distinct($net.target.ip)
    $bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
