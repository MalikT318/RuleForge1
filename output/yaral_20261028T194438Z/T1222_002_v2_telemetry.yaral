/*
  MITRE Technique : T1222.002 - Linux and Mac Permissions
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:20:26.916890+00:00
  Reference       : https://attack.mitre.org/techniques/T1222/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_002_Linux_Sensitive_File_Permission_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a permission, ownership, ACL or attribute change (chmod, chown, chgrp, setfacl, chattr) applied to security-sensitive Linux files. These include credential stores, sudoers, SSH keys and config, PAM, cron, systemd units, ld.so.preload and shell startup files. The rule works from the resulting file-modification artifact (auditd/EDR attribute-change events) and does not depend on command-line logging."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1222.002"
    mitre_technique_name = "File and Directory Permissions Modification: Linux and Mac File and Directory Permissions Modification"
    log_prerequisites = "Requires Linux EDR or auditd file telemetry (e.g. watches on chmod/fchmodat/chown/setxattr syscalls) normalised to FILE_MODIFICATION with the acting process populated in principal.process.file.full_path and the affected file in target.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management (Ansible, Puppet, Chef, Salt) enforcing file modes; package manager post-install scripts; user-provisioning scripts that set ~/.ssh and authorized_keys permissions; legitimate admins hardening sudoers, SSH or cron files during change windows; backup/restore tooling resetting ownership."
    tuning_guidance = "Add approved configuration management and deployment binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Narrow or widen the sensitive-path regex per customer baseline."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.principal.process.file.full_path = /\/(chmod|chown|chgrp|setfacl|chattr)$/ nocase
    $file.target.file.full_path = /^\/etc\/(shadow|gshadow|passwd|group|sudoers|sudoers\.d\/.+|ld\.so\.preload|ld\.so\.conf\.d\/.+|crontab|cron\.(d|hourly|daily|weekly|monthly)\/.+|pam\.d\/.+|ssh\/sshd_config|ssh\/ssh_config|profile|profile\.d\/.+|bash\.bashrc|systemd\/system\/.+\.(service|timer))$|^\/(root|home\/[^\/]+)\/\.(ssh\/(authorized_keys2?|config|id_[a-z0-9]+)|bashrc|bash_profile|profile|zshrc)$|^\/var\/spool\/cron(\/crontabs)?\/.+/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1222.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $actor_user = array_distinct($file.principal.user.userid)
    $actor_process = array_distinct($file.principal.process.file.full_path)
    $modified_paths = array_distinct($file.target.file.full_path)

  condition:
    $file
}
