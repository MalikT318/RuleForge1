/*
  MITRE Technique : T1078.003 - Local Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : ESXi
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:33:22.616987+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_003_ESXi_Local_Account_Login_Untrusted_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an interactive or remote login to an ESXi host with a local account (SSH, DCUI, host client) from a source that is not an approved management address, by an account that is not an approved administrator or service account. Local ESXi accounts bypass central identity controls, so a login from an unexpected source indicates possible credential reuse or abuse."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.003"
    mitre_technique_name = "Valid Accounts: Local Accounts"
    log_prerequisites = "ESXi host authentication events (hostd, shell and SSH daemon logs) must be ingested and normalised to UDM USER_LOGIN with principal.ip, target.user.userid and target.hostname populated. The sign-in stream must be tagged with the identity log source. A plain IdP-only deployment cannot see local ESXi logins and will not fire this rule. Populate %global_allowed_mgmt_sources with jump hosts and management subnets for each client."
    platform = "ESXi"
    log_source = "identity"
    false_positives = "Administrators connecting from a new jump host or VPN pool not yet in the allowlist, backup and monitoring products that authenticate with local accounts, break-glass access during an outage, vendor support sessions."
    tuning_guidance = "Add approved management source addresses to %global_allowed_mgmt_sources, named administrators to %global_allowed_admin_users, and automation or backup accounts to %global_allowed_service_accounts. If the application field is unpopulated in a client's parser, adjust the target.application filter to match the field that identifies ESXi authentication. Failed logins are filtered where the summary text is populated."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.application = /esxi|hostd|vpxa|dcui|sshd|shell/ nocase
    $auth.target.user.userid != ""
    $auth.principal.ip != ""
    not $auth.security_result.summary = /fail|denied|invalid|reject|incorrect/ nocase
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.target.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1078.003")
    $primary_entity = array_distinct($auth.target.hostname)
    $login_user = array_distinct($auth.target.user.userid)
    $source_ips = array_distinct($auth.principal.ip)

  condition:
    $auth
}
