/*
  MITRE Technique : T1213 - Data from Information Repositories
  Tactic(s)       : Collection
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:22:49.939508+00:00
  Reference       : https://attack.mitre.org/techniques/T1213
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_SaaS_Bulk_Repository_Access_By_User {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single user generates an unusually high volume of resource access events (downloads, exports, views, reads) against SaaS information repositories within ten minutes. Each access is benign on its own, but bulk access suggests an adversary or compromised account mining document stores, wikis or ticketing systems for credentials, architecture details or sensitive data."
    mitre_tactic = "Collection"
    mitre_technique = "T1213"
    mitre_technique_name = "Data from Information Repositories"
    log_prerequisites = "Requires SaaS application audit logs normalised to UDM USER_RESOURCE_ACCESS with principal.user.userid populated. metadata.product_event_type and target.resource.name should be populated where available."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Employees running legitimate bulk downloads or exports, content migrations, eDiscovery or legal-hold collection, backup and sync clients, search indexers and integrations running under user accounts, and new-starter onboarding."
    tuning_guidance = "Add automation and integration identities to %global_allowed_service_accounts, %global_allowed_cloud_principals or %global_allowed_admin_users. The threshold of 100 events per 10 minutes is conservative; raise it for high-activity tenants or lower it for sensitive repositories. Adjust the product_event_type regex to the verbs used by the client's SaaS audit schema."

  events:
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.metadata.product_event_type = /(?i)(download|export|sync|preview|view|read|fileaccess|get)/
    $access.target.resource.name != ""
    $access.principal.user.userid != ""
    $access.principal.user.userid = $user
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_cloud_principals
    not $access.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($access.metadata.id)
    $mitre_technique_id = array_distinct("T1213")
    $primary_entity = array_distinct($user)
    $accessed_resources = array_distinct($access.target.resource.name)
    $source_ips = array_distinct($access.principal.ip)

  condition:
    #access >= 100
}
