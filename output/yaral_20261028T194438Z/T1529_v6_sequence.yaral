/*
  MITRE Technique : T1529 - System Shutdown/Reboot
  Tactic(s)       : Impact
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:29:57.362188+00:00
  Reference       : https://attack.mitre.org/techniques/T1529
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1529_NetDev_Mgmt_Session_Then_Boot_TFTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a management-plane session (SSH or Telnet) to a network device from a source outside the approved management sources, followed within 10 minutes by that same device originating a TFTP connection. Devices commonly fetch images or configuration over TFTP while reloading, so this pattern can indicate an unauthorised reload or reboot (T1529). A firewall cannot see CLI commands such as 'reload' directly, so the rule infers the reboot from the post-session device behaviour. Treat it as a lead for analyst review, not proof of a reboot."
    mitre_tactic = "Impact"
    mitre_technique = "T1529"
    mitre_technique_name = "System Shutdown/Reboot"
    log_prerequisites = "Firewall or perimeter logs that record both sessions to device management interfaces and device-originated traffic, with principal.ip and target.ip populated for the network device. The device's own management address must be visible as target.ip in the first event and principal.ip in the second."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Planned maintenance windows where engineers log in from jump hosts not yet in the allow list; scheduled firmware or configuration backups and restores over TFTP; zero-touch provisioning of new devices; vulnerability scanners probing SSH or Telnet."
    tuning_guidance = "Add approved jump hosts, bastions and management subnets to %global_allowed_mgmt_sources. Add authorised scanners to %global_allowed_scanners. If TFTP is not used for provisioning in the environment, consider raising severity. If SSH and Telnet management uses non-standard ports, extend the port list accordingly."

  events:
    $mgmt.metadata.event_type = "NETWORK_CONNECTION"
    ($mgmt.target.port = 22 or $mgmt.target.port = 23)
    not $mgmt.principal.ip in %global_allowed_mgmt_sources
    not $mgmt.principal.ip in %global_allowed_scanners
    $mgmt.target.ip = $device

    $boot.metadata.event_type = "NETWORK_CONNECTION"
    $boot.target.port = 69
    $boot.principal.ip = $device

    $mgmt.metadata.event_timestamp.seconds <= $boot.metadata.event_timestamp.seconds

  match:
    $device over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1529")
    $primary_entity = array_distinct($device)
    $mgmt_source_ips = array_distinct($mgmt.principal.ip)
    $mgmt_ports = array_distinct($mgmt.target.port)
    $tftp_server_ips = array_distinct($boot.target.ip)
    $mgmt_event_count = count($mgmt.metadata.id)

  condition:
    $mgmt and $boot
}
