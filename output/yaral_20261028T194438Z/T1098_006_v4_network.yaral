/*
  MITRE Technique : T1098.006 - Additional Container Cluster Roles
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:49:22.950159+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_006_K8s_RBAC_Binding_Write_From_External_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a write request (create, replace or patch) to the Kubernetes RBAC RoleBinding or ClusterRoleBinding API endpoints, seen as HTTP traffic from a source outside internal address space. Adversaries use these calls to bind powerful roles to accounts they control and keep persistent access to the cluster. Because the rule keys on the API resource path and HTTP verb, it still fires if the attacker changes tooling, account names, role names or infrastructure."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.006"
    mitre_technique_name = "Account Manipulation: Additional Container Cluster Roles"
    log_prerequisites = "Requires network or API-gateway HTTP telemetry that records the request method and URL path for traffic to the Kubernetes API server (for example a load balancer, ingress or proxy in front of the control plane, or audit events normalised to NETWORK_HTTP). Fields used: network.http.method, target.url, principal.ip."
    platform = "Containers"
    log_source = "container"
    false_positives = "External CI/CD or GitOps controllers that apply RBAC manifests from outside the cluster network, cloud-managed cluster administration performed from corporate egress or VPN addresses, infrastructure-as-code pipelines (Terraform, Helm), and managed-Kubernetes control planes reaching the API through NAT."
    tuning_guidance = "Add approved CI/CD and automation identities to %global_allowed_service_accounts, named cluster administrators to %global_allowed_admin_users, and corporate VPN or bastion egress addresses to %global_allowed_mgmt_sources. Make sure %rfc1918_internal covers the internal ranges used by your clients. If the telemetry only records the proxy IP, narrow the exclusions by user instead."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT|PATCH)$/ nocase
    $net.target.url = /\/apis\/rbac\.authorization\.k8s\.io\/v1\/(namespaces\/[^\/]+\/)?(clusterrolebindings|rolebindings)/ nocase
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1098.006")
    $primary_entity = array_distinct($net.principal.ip)
    $source_users = array_distinct($net.principal.user.userid)
    $request_urls = array_distinct($net.target.url)
    $http_methods = array_distinct($net.network.http.method)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
