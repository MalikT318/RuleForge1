/*
  MITRE Technique : T1053.005 - Scheduled Task
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:16:19.801595+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_005_Anomalous_Parent_Spawns_Schtasks {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects schtasks.exe creating or modifying a task when launched by a parent process that should never manage scheduled tasks: an Office application, web server worker, print spooler, database service, or script host. This lineage anomaly suggests macro, web shell, or exploited-service abuse to establish persistence or execute as SYSTEM. Detection pivots on the parent-child relationship, not on a specific task payload."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.005"
    mitre_technique_name = "Scheduled Task/Job: Scheduled Task"
    log_prerequisites = "Requires Windows endpoint process telemetry with populated parent process path (EDR, Sysmon Event ID 1, or Security Event 4688 with parent process name)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office add-ins or VSTO installers that register update tasks, legitimate web applications or CMS installers that schedule maintenance jobs from the web server worker, database maintenance or setup routines that create tasks, and software deployment run from script hosts."
    tuning_guidance = "Add approved parent binaries (deployment and patching tooling) to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. If a specific web application or database legitimately creates tasks, allowlist its parent executable in %global_allowed_admin_tools rather than loosening the parent regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\schtasks\.exe$/ nocase
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|php-cgi|tomcat\d*|spoolsv|sqlservr|mysqld|postgres|oracle|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /\/(create|change)\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1053.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
