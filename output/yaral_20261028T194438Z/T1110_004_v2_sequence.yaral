/*
  MITRE Technique : T1110.004 - Credential Stuffing
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:08:44.889711+00:00
  Reference       : https://attack.mitre.org/techniques/T1110/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1110_004_Container_API_Credential_Stuffing_Success {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A single source address generates a burst of failed logins against the container orchestration control plane or container registry, then completes a successful login within 10 minutes. This pattern is consistent with credential stuffing using breached username and password pairs that ended in a valid account compromise."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1110.004"
    mitre_technique_name = "Brute Force: Credential Stuffing"
    log_prerequisites = "Requires cloud control plane audit logs (Kubernetes API server audit, managed Kubernetes or container registry authentication events) normalised to USER_LOGIN with principal.ip, target.user.userid and security_result.action populated."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Misconfigured CI/CD runners or GitOps controllers with stale credentials that later succeed; shared NAT or egress gateways where many legitimate users sign in from one address; expired kubeconfig tokens retried by developer tooling; authorised penetration tests."
    tuning_guidance = "Add approved scanner and pen-test sources to %global_allowed_scanners, trusted bastion or VPN egress addresses to %global_allowed_mgmt_sources, and automation identities to %global_allowed_service_accounts. Raise or lower the failure count in the condition (#fail >= 10) to match the client's baseline. For clients behind a shared NAT, raise it further."

  events:
    $fail.metadata.event_type = "USER_LOGIN"
    $fail.security_result.action = "BLOCK"
    $fail.principal.ip = $src_ip
    $fail.target.user.userid != ""
    not $fail.principal.ip in %global_allowed_scanners
    not $fail.principal.ip in %global_allowed_mgmt_sources
    not $fail.target.user.userid in %global_allowed_service_accounts

    $success.metadata.event_type = "USER_LOGIN"
    $success.security_result.action = "ALLOW"
    $success.principal.ip = $src_ip
    $success.target.user.userid != ""
    not $success.principal.ip in %global_allowed_scanners
    not $success.principal.ip in %global_allowed_mgmt_sources
    not $success.target.user.userid in %global_allowed_service_accounts

    $fail.metadata.event_timestamp.seconds <= $success.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1110.004")
    $primary_entity = array_distinct($src_ip)
    $failed_attempts = count($fail.metadata.id)
    $distinct_users_targeted = count_distinct($fail.target.user.userid)
    $compromised_users = array_distinct($success.target.user.userid)
    $first_failure = min($fail.metadata.event_timestamp.seconds)
    $first_success = min($success.metadata.event_timestamp.seconds)

  condition:
    #fail >= 10 and $success
}
