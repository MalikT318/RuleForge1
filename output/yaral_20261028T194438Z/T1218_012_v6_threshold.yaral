/*
  MITRE Technique : T1218.012 - Verclsid
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:58:42.683236+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_012_Verclsid_Repeated_External_Connections {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Verclsid.exe (the shell extension CLSID verification host) makes repeated outbound connections to external addresses from a single host within 10 minutes. The binary normally has no reason to use the network. Repeated external connections suggest it is proxying remote COM scriptlet or payload retrieval."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.012"
    mitre_technique_name = "System Binary Proxy Execution: Verclsid"
    log_prerequisites = "Requires EDR or Sysmon-equivalent network connection telemetry (Sysmon Event ID 3 or equivalent) with the initiating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare. Possible sources are shell extension verification that touches network shares or WebDAV paths resolving to public addresses, proxy or VPN clients that present internal traffic with public destination addresses, and security tooling that launches verclsid.exe during sandbox detonation or testing."
    tuning_guidance = "Add service or automation accounts that legitimately trigger shell extension verification to %global_allowed_service_accounts. Raise the #net threshold if a client has WebDAV-heavy workflows. Scanners or sandbox hosts can be excluded by user ID. Lower the threshold to 1 for high-security environments."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\verclsid\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.user.userid in %global_allowed_service_accounts
    $net.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(75)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1218.012")
    $primary_entity = array_distinct($host)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $users = array_distinct($net.principal.user.userid)

  condition:
    #net >= 3
}
