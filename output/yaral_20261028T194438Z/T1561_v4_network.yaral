/*
  MITRE Technique : T1561 - Disk Wipe
  Tactic(s)       : Impact
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:03:08.241268+00:00
  Reference       : https://attack.mitre.org/techniques/T1561
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1561_Linux_Wiper_Payload_Staging_Bare_IP_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side precursor to a Linux disk-wipe operation. A Linux host using a command-line HTTP client (curl, wget, python, perl) fetches a script or binary payload from a bare external IP address rather than a named domain. Disk wipers have no network signature of their own, so this detects the staging step through firewall or proxy telemetry. It does not observe the wipe itself and should be paired with endpoint detections for raw block-device writes. Internal destinations are excluded with a reference list."
    mitre_tactic = "Impact"
    mitre_technique = "T1561"
    mitre_technique_name = "Disk Wipe"
    log_prerequisites = "Requires firewall or proxy logs normalised to UDM NETWORK_HTTP with target.url, network.http.user_agent, target.ip and principal.hostname populated (TLS inspection or explicit proxy needed for URL visibility)."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Administrators or provisioning tools (kickstart, cloud-init, config management) downloading installers from IP-addressed internal-facing mirrors that resolve externally; vulnerability scanners; developers testing against IP-addressed lab servers; CDN-hosted software that uses IP URLs."
    tuning_guidance = "Add known-good external hostnames to %global_allowed_domains and scanner or provisioning hosts to %global_allowed_scanners. If the proxy does not log the user agent, the rule will not fire. Confirm target.url is populated for the client's log source before deployment. Raise severity when the same host also shows endpoint raw-disk write activity."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /(curl|wget|python|libwww-perl)/ nocase
    $net.target.url = /^https?:\/\/[0-9]{1,3}(\.[0-9]{1,3}){3}(:[0-9]+)?\/.*\.(sh|elf|bin|py|pl)(\?.*)?$/ nocase
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1561")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
