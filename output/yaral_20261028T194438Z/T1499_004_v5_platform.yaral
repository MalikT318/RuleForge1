/*
  MITRE Technique : T1499.004 - Application or System Exploitation
  Tactic(s)       : Impact
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:23:16.816529+00:00
  Reference       : https://attack.mitre.org/techniques/T1499/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1499_004_Cloud_Forced_Instance_Crash_Or_Reset {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects control-plane API calls that deliberately crash or hard-reset a virtual machine instance: a diagnostic interrupt (NMI, which triggers a kernel panic or crash dump), a forced hardware-style reset, or a redeploy action. Outside approved operators and break-glass troubleshooting, these calls are a way to force an availability loss on a workload without touching the guest OS, so no endpoint telemetry is needed. Repeated calls can keep a workload in a persistent crash and restart loop."
    mitre_tactic = "Impact"
    mitre_technique = "T1499.004"
    mitre_technique_name = "Endpoint Denial of Service: Application or System Exploitation"
    log_prerequisites = "Cloud control-plane audit logs ingested and normalised to UDM USER_RESOURCE_ACCESS with metadata.product_event_type populated with the API operation name, and principal.user.userid populated. Data-plane and guest OS logs are not required."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Engineers capturing a crash dump for kernel debugging, automated remediation or chaos-engineering tooling that hard-resets unresponsive instances, break-glass recovery of hung VMs, and platform teams redeploying VMs to move hosts during maintenance."
    tuning_guidance = "Add approved automation and remediation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named SRE or platform administrators to %global_allowed_admin_users. If hard resets or redeploys are routine in a tenant, narrow the operation regex to the diagnostic-interrupt operation only. Raise severity when the same principal targets several instances."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /(SendDiagnosticInterrupt|compute\.instances\.reset|virtualMachines\/redeploy\/action)/ nocase
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1499.004")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_operation = array_distinct($cloud.metadata.product_event_type)
    $target_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
