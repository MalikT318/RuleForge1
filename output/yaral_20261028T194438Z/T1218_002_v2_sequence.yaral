/*
  MITRE Technique : T1218.002 - Control Panel
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:43:37.942974+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_002_CPL_Registry_Registration_Then_Control_Launch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a write to the Control Panel CPL registration registry key (Control Panel\\Cpls) followed within ten minutes by control.exe launching on the same host. Registering a CPL payload and then triggering Control Panel is a known proxy-execution and persistence pattern. The rule keys on the registry registration artefact, not on command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.002"
    mitre_technique_name = "System Binary Proxy Execution: Control Panel"
    log_prerequisites = "Requires EDR or Sysmon registry modification telemetry (Sysmon Event ID 12/13) and process creation telemetry for the same hosts."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate third-party software installers or hardware drivers (printer, GPU or audio utilities) that register a Control Panel applet and then open Control Panel. Software deployment tooling, and admins configuring Control Panel items."
    tuning_guidance = "Add approved installers and deployment agents to %global_allowed_admin_tools. Review the registry key and writing process in the outcome. Where one hardware vendor repeatedly triggers the rule, exclude the writing process by executable name. Consider also excluding trusted security agents via %global_allowed_security_tools."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control Panel\\Cpls/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|msiexec)\.exe$/ nocase
    $reg.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\control\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $reg.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1218.002")
    $primary_entity = array_distinct($hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_name)
    $registry_writers = array_distinct($reg.principal.process.file.full_path)
    $control_parents = array_distinct($proc.principal.process.file.full_path)
    $affected_users = array_distinct($proc.principal.user.userid)

  condition:
    $reg and $proc
}
