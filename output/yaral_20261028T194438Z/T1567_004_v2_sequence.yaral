/*
  MITRE Technique : T1567.004 - Exfiltration Over Webhook
  Tactic(s)       : Exfiltration
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:01:10.126354+00:00
  Reference       : https://attack.mitre.org/techniques/T1567/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_004_Webhook_Post_Followed_By_Large_Upload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Windows-network client sending an HTTP POST to an external URL with a webhook-style path (numeric ID plus long token, Slack-style T/B/token, or webhook UUID), followed within 10 minutes by a large outbound HTTPS upload from the same source IP. This suggests staged data posted to an adversary-controlled webhook endpoint. The rule uses only network-observable fields and does not depend on process or command-line data."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567.004"
    mitre_technique_name = "Exfiltration Over Web Service: Exfiltration Over Webhook"
    log_prerequisites = "Requires firewall or proxy logs normalised to NETWORK_HTTP (with full URL and HTTP method, which needs TLS inspection for HTTPS) and NETWORK_FLOW or NETWORK_CONNECTION (with sent bytes)."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate CI/CD, ticketing, chat-ops and monitoring integrations posting to SaaS webhooks, followed by routine large uploads (cloud backup, OneDrive/SharePoint sync, software publishing) from the same host or NAT address. Shared NAT or proxy egress IPs can correlate unrelated activity."
    tuning_guidance = "Add sanctioned webhook destination domains to %global_allowed_domains. Raise or lower the sent_bytes threshold per client baseline. If clients egress through a shared NAT or proxy, map the join to a per-user or per-host identifier where available. Add known automation and scanner source IPs to %global_allowed_scanners."

  events:
    $hook.metadata.event_type = "NETWORK_HTTP"
    $hook.network.http.method = "POST"
    $hook.target.url = /\/(api\/)?webhooks?\/[0-9]{6,}\/[A-Za-z0-9_\-]{20,}|\/services\/T[A-Z0-9]{6,}\/B[A-Z0-9]{6,}\/[A-Za-z0-9]{16,}|\/webhooks?\/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-/ nocase
    not $hook.target.ip in %rfc1918_internal
    not $hook.target.hostname in %global_allowed_domains
    not $hook.principal.ip in %global_allowed_scanners
    $hook.principal.ip = $src_ip

    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.target.port = 443
    $flow.network.sent_bytes >= 1000000
    not $flow.target.ip in %rfc1918_internal
    not $flow.principal.ip in %global_allowed_scanners
    $flow.principal.ip = $src_ip

    $hook.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1567.004")
    $primary_entity = array_distinct($src_ip)
    $webhook_urls = array_distinct($hook.target.url)
    $webhook_hosts = array_distinct($hook.target.hostname)
    $upload_destinations = array_distinct($flow.target.ip)
    $max_sent_bytes = max($flow.network.sent_bytes)

  condition:
    $hook and $flow
}
