/*
  MITRE Technique : T1547.013 - XDG Autostart Entries
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:40:30.769624+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_013_XDG_Autostart_Written_By_Service_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter spawned by a web server, application server, database, or print service process whose command line creates or modifies an XDG autostart .desktop entry. Service daemons have no legitimate reason to write desktop login persistence, so this lineage points to web shell, injection, or service-exploitation activity establishing persistence."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.013"
    mitre_technique_name = "Boot or Logon Autostart Execution: XDG Autostart Entries"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry populating parent process path, child process path, and command line for process launches."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management or provisioning hooks run from a service-owned parent (for example a web-based admin panel deploying desktop settings), kiosk or VDI image build pipelines, and CUPS or application installers that register desktop launchers."
    tuning_guidance = "Add legitimate parent process paths to %global_allowed_script_hosts and trusted administrator accounts to %global_allowed_admin_users. Extend the parent process regex with customer-specific application server binaries if needed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|php-cgi|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|cups-browsed)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ksh|csh|tcsh|python[0-9.]*|perl|ruby|php[0-9.]*)$/ nocase
    $proc.target.process.command_line = /(\/etc\/xdg|\.config)\/autostart\b/ nocase
    $proc.target.process.command_line = /\.desktop\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1547.013")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
