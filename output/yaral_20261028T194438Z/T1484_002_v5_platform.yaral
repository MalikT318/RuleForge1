/*
  MITRE Technique : T1484.002 - Trust Modification
  Tactic(s)       : Defense Impairment, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:34:59.002200+00:00
  Reference       : https://attack.mitre.org/techniques/T1484/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1484_002_Identity_Federation_Trust_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a directory or identity-provider audit event in which federation, domain authentication, external identity provider, or cross-tenant trust settings are created or changed. Attackers use this to add a signing certificate or issuer they control, convert a managed domain to a federated one, or add a rogue identity provider, so they can forge tokens or sign in as any user. Covers the cloud identity control plane and does not overlap with process or command-line detections."
    mitre_tactic = "Defense Impairment, Privilege Escalation"
    mitre_technique = "T1484.002"
    mitre_technique_name = "Domain or Tenant Policy Modification: Trust Modification"
    log_prerequisites = "Identity provider directory/admin audit logs ingested and normalized to UDM, with the audit activity name populated in metadata.product_event_type and the acting admin in principal.user.userid."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Planned federation onboarding or migration, merger and acquisition tenant consolidation, certificate rollover on an existing federation, approved SSO application or partner-tenant setup by identity engineering, and managed-service admin activity during change windows."
    tuning_guidance = "Add approved identity administrators to %global_allowed_admin_users and automation or sync accounts to %global_allowed_service_accounts. Correlate hits with change tickets. Some identity logs normalize trust creation as SETTING_CREATION; if the tenant does, clone this rule with that event type rather than adding an OR. Extend the product_event_type regex to match local audit activity naming."

  events:
    $idp.metadata.event_type = "SETTING_MODIFICATION"
    $idp.metadata.product_event_type = /((set|update|modify|add|create|change|configure).*(federation|domain authentication|identity provider|cross.?tenant|trusted?\s*(domain|realm|relationship|issuer)))|(idp\.lifecycle\.(create|update|activate))|(federat.*(setting|config|trust))/ nocase
    $idp.principal.user.userid != ""
    not $idp.principal.user.userid in %global_allowed_admin_users
    not $idp.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1484.002")
    $primary_entity = array_distinct($idp.principal.user.userid)
    $audit_activity = array_distinct($idp.metadata.product_event_type)
    $changed_object = array_distinct($idp.target.resource.name)
    $source_ips = array_distinct($idp.principal.ip)

  condition:
    $idp
}
