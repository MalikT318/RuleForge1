/*
  MITRE Technique : T1092 - Communication Through Removable Media
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:35:25.207757+00:00
  Reference       : https://attack.mitre.org/techniques/T1092
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1092_Interpreter_Executes_Content_From_NonSystem_Drive {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows command interpreter (cmd, PowerShell) that reads a file from a non-system drive letter (D: to Z:, typical of removable media) and passes the content straight to an execution primitive such as Invoke-Expression, a pipe into another shell, or a for /f loop. This is the command-relay pattern used when an implant takes instructions from files carried on removable media between an internet-connected host and an air-gapped host."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1092"
    mitre_technique_name = "Communication Through Removable Media"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with full command lines (EDR, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators running scripts from mapped network drives, secondary data volumes or install media. Software deployment and imaging tasks that read answer or config files from a non-C: drive. Developers using Get-Content with Invoke-Expression on secondary volumes."
    tuning_guidance = "Add approved deployment and RMM binaries to %global_allowed_admin_tools. Add trusted parent processes or hosts that legitimately run scripts to %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts. If a client uses non-C: system or data volumes or mapped drives for scripts, restrict the drive-letter range in the regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd)\.exe$/ nocase
    $proc.target.process.command_line = /(get-content|\bgc\b|\btype\b|readalltext|readalllines|for\s+\/f)/ nocase
    $proc.target.process.command_line = /\b[d-z]:\\/ nocase
    $proc.target.process.command_line = /(invoke-expression|\biex\b|\|\s*(cmd|powershell|pwsh)\b|for\s+\/f.*\bdo\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1092")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
