/*
  MITRE Technique : T1137.003 - Outlook Forms
  Tactic(s)       : Persistence
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:18:20.443324+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_003_Outlook_Forms_Artifact_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several Outlook form artifacts (.oft templates or files written to the Outlook FORMS cache directory) are created on a single host within 10 minutes. Individual writes are routine, but a burst of form files, especially written by a process other than Outlook, can indicate a malicious custom form being staged or loaded for persistence or code execution."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.003"
    mitre_technique_name = "Office Application Startup: Outlook Forms"
    log_prerequisites = "Requires Windows endpoint telemetry that reports file creation events with full target path and the creating process (EDR or Sysmon Event ID 11)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Outlook profile first-run or migration populating the forms cache, enterprise custom-form deployments (HR, helpdesk or ticketing templates), users saving or sharing .oft templates, backup or profile-sync tools restoring user data."
    tuning_guidance = "Add approved deployment or migration tooling to %global_allowed_admin_tools, and add EDR or AV agents to %global_allowed_security_tools. Raise the #file threshold if Outlook-initiated cache writes are noisy. Writes by non-Outlook processes score higher (80 vs 55) in $risk_score."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(\\Microsoft\\FORMS\\|\.oft$)/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($file.principal.process.file.full_path = /\\outlook\.exe$/ nocase, 55, 80))
    $mitre_technique_id = array_distinct("T1137.003")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $form_files = array_distinct($file.target.file.full_path)
    $creator_processes = array_distinct($file.principal.process.file.full_path)
    $affected_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
