/*
  MITRE Technique : T1678 - Delay Execution
  Tactic(s)       : Stealth
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:24:26.468572+00:00
  Reference       : https://attack.mitre.org/techniques/T1678
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1678_Unexpected_Parent_Delay_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter launched by an unexpected parent (Office application, web server, print spooler, or database service) whose command line contains a delay-execution construct such as ping -n with a high count, timeout /t, choice /t, waitfor, or Start-Sleep. Delays like these are used to evade sandbox time limits or sequence payload stages. The unusual parent-to-child lineage is the primary signal."
    mitre_tactic = "Stealth"
    mitre_technique = "T1678"
    mitre_technique_name = "Delay Execution"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and child command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros or add-ins that pause between steps, web applications that shell out to sleep or ping for health checks, database jobs (SQL Agent, xp_cmdshell maintenance scripts) that use timeout or waitfor, and legitimate print-driver or spooler helper scripts."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts and approved tooling to %global_allowed_admin_tools. Raise the ping count threshold (\\d{2,}) if internal scripts use short delays. Extend the parent regex with client-specific web or database service executables if needed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|mshta|w3wp|httpd|nginx|tomcat\d*|php-cgi|spoolsv|sqlservr|mysqld|postgres|oracle)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript)\.exe$/ nocase
    $proc.target.process.command_line = /(ping(\.exe)?\s+.*[-\/]n\s+\d{2,}|timeout(\.exe)?\s+.*[-\/]t\s+\d+|choice(\.exe)?\s+.*[-\/]t\s+\d+|waitfor(\.exe)?\s|start-sleep|thread\]::sleep|sleep\s+-?s(econds)?\s+\d+)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1678")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
