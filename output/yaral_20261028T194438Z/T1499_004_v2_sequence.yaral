/*
  MITRE Technique : T1499.004 - Application or System Exploitation
  Tactic(s)       : Impact
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:22:20.278808+00:00
  Reference       : https://attack.mitre.org/techniques/T1499/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1499_004_Repeated_Restart_Then_Resource_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a cloud resource that is restarted, rebooted, reset or stopped repeatedly (a crash-loop or forced-restart pattern consistent with exploitation of a vulnerable service) and is then deleted or terminated within the same window. The sequence indicates a possible availability impact on the resource. It is correlated on the shared target resource name."
    mitre_tactic = "Impact"
    mitre_technique = "T1499.004"
    mitre_technique_name = "Endpoint Denial of Service: Application or System Exploitation"
    log_prerequisites = "Cloud control-plane audit logs with metadata.product_event_type and target.resource.name populated, ingested into UDM as SETTING_MODIFICATION (restart/stop operations) and RESOURCE_DELETION (delete/terminate operations). Restart and stop operations must be normalised to SETTING_MODIFICATION in the parser; if the client's parser maps them to a different event type, adjust the first event accordingly."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Autoscaling or deployment pipelines that cycle instances, blue/green deployments, patch-window reboots followed by decommissioning, ephemeral test or CI environments torn down after restarts, administrators troubleshooting and then removing a faulty resource."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts and %global_allowed_cloud_principals, and approved administrators to %global_allowed_admin_users. Raise the restart threshold in the condition (#restart >= 2) for noisy tenants. Narrow the product_event_type regexes to the provider operations used in the client's environment."

  events:
    $restart.metadata.event_type = "SETTING_MODIFICATION"
    $restart.metadata.product_event_type = /(reboot|restart|reset|stop|deallocate|poweroff)/ nocase
    $restart.target.resource.name != ""
    $restart.target.resource.name = $resource
    not $restart.principal.user.userid in %global_allowed_service_accounts
    not $restart.principal.user.userid in %global_allowed_cloud_principals
    not $restart.principal.user.userid in %global_allowed_admin_users

    $delete.metadata.event_type = "RESOURCE_DELETION"
    $delete.metadata.product_event_type = /(delete|terminate|destroy|remove)/ nocase
    $delete.target.resource.name = $resource
    not $delete.principal.user.userid in %global_allowed_service_accounts
    not $delete.principal.user.userid in %global_allowed_cloud_principals
    not $delete.principal.user.userid in %global_allowed_admin_users

    $restart.metadata.event_timestamp.seconds <= $delete.metadata.event_timestamp.seconds

  match:
    $resource over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1499.004")
    $primary_entity = array_distinct($resource)
    $restart_count = count($restart.metadata.id)
    $restart_actors = array_distinct($restart.principal.user.userid)
    $delete_actors = array_distinct($delete.principal.user.userid)
    $restart_operations = array_distinct($restart.metadata.product_event_type)
    $delete_operations = array_distinct($delete.metadata.product_event_type)
    $source_ips = array_distinct($delete.principal.ip)

  condition:
    #restart >= 2 and $delete
}
