/*
  MITRE Technique : T1197 - BITS Jobs
  Tactic(s)       : Stealth, Persistence, Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:46:05.145329+00:00
  Reference       : https://attack.mitre.org/techniques/T1197
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1197_BITS_Download_Temp_File_UserWritable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects the file artifact of a BITS download landing in a user-writable location. The BITS service (svchost.exe) creates a transient BITxxxx.tmp file in the job's destination directory before renaming it to the final name. Legitimate BITS consumers such as Windows Update and vendor updaters normally write to system or product-owned directories, so this artifact in a user profile, Public or Windows Temp directory indicates a user- or attacker-created BITS job. The rule works at file-artifact level and does not depend on command-line logging, so it also catches jobs created through PowerShell cmdlets, COM APIs or renamed bitsadmin binaries."
    mitre_tactic = "Stealth, Persistence, Execution"
    mitre_technique = "T1197"
    mitre_technique_name = "BITS Jobs"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry with populated principal process path and target file path (EDR file-write events or Sysmon Event ID 11)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-user application updaters and messengers that use BITS to download into the user profile (for example browser, collaboration or cloud-storage clients), software deployment tools that stage content via BITS into Public or Temp directories, and administrators testing BITS transfers."
    tuning_guidance = "Add expected service or deployment accounts to %global_allowed_service_accounts and approved deployment tooling to %global_allowed_admin_tools. If a specific per-user updater is noisy at a client, tighten the path regex for that client's baseline. Consider raising severity when the final destination file has an executable or script extension."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\svchost\.exe$/ nocase
    $file.target.file.full_path = /\\BIT[0-9A-F]{1,8}\.tmp$/ nocase
    $file.target.file.full_path = /\\(Users\\[^\\]+\\(Downloads|Desktop|Documents|AppData\\Local\\Temp|AppData\\Roaming|AppData\\Local\\Microsoft\\Windows\\INetCache)|Users\\Public|Windows\\Temp)\\/ nocase
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1197")
    $primary_entity = array_distinct($file.principal.hostname)
    $bits_temp_files = array_distinct($file.target.file.full_path)
    $affected_users = array_distinct($file.principal.user.userid)

  condition:
    $file
}
