/*
  MITRE Technique : T1558.003 - Kerberoasting
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:44:42.970979+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_003_Kerberos_Traffic_From_NonLSASS_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows endpoint process other than the Local Security Authority (lsass) opening a network connection to a Kerberos KDC on port 88. Normal Windows clients request TGTs and service tickets through SSPI, so the traffic leaves the host from lsass. A different process talking Kerberos directly suggests a tool crafting its own TGS-REQ for SPNs (Kerberoasting) to harvest RC4-encrypted tickets for offline cracking. This detection uses network telemetry and does not depend on command-line strings, so it complements process-creation rules. The task asked for an alternate platform, but the mandatory platform requirement is Windows, so this adds Windows coverage through a different telemetry type."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.003"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Kerberoasting"
    log_prerequisites = "Requires Windows endpoint network telemetry (EDR or Sysmon Event ID 3) that populates the initiating process path and destination port for outbound connections."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Java applications with a built-in Kerberos client, MIT Kerberos for Windows and kinit, Cygwin or WSL-based tooling, some database or middleware clients that use their own GSSAPI library, identity sync and directory connectors, and authorised red team or penetration testing activity."
    tuning_guidance = "Add approved Kerberos-speaking binaries to %global_allowed_admin_tools, EDR and security agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. If a client runs many Java or middleware servers, allowlist those runtimes by executable name rather than by install path. To raise fidelity, route matches from user workstations to a higher-priority queue than matches from application servers."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 88
    $net.principal.process.file.full_path != ""
    not $net.principal.process.file.full_path = /\\lsass\.exe$/ nocase
    not $net.principal.process.file.full_path = /\\(System|Registry)$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1558.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $source_user = array_distinct($net.principal.user.userid)
    $kdc_ips = array_distinct($net.target.ip)

  condition:
    $net
}
