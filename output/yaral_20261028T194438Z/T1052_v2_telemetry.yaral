/*
  MITRE Technique : T1052 - Exfiltration Over Physical Medium
  Tactic(s)       : Exfiltration
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:40:58.715129+00:00
  Reference       : https://attack.mitre.org/techniques/T1052
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1052_Archive_Staged_To_Removable_Media_Mount {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of an archive or encrypted container file under a removable-media mount point (/media or /run/media) on a Linux host. This is the file artifact left when data is packaged and written to a USB or external drive, and it does not depend on command-line logging."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1052"
    mitre_technique_name = "Exfiltration Over Physical Medium"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-write events normalized to UDM FILE_CREATION with target.file.full_path populated. Desktop environments must auto-mount removable devices under /media/<user> or /run/media/<user>."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Users making legitimate personal or approved backups to USB drives, IT imaging and migration work, backup agents writing to attached drives, and developers copying release tarballs to portable media."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes, IT tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. For servers where manual mounts under /mnt are the norm, clone the rule and extend the path regex. Raise severity on hosts that are air-gapped or hold sensitive data."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(run\/)?media\/[^\/]+\/.+\.(zip|tar|tgz|tbz2|txz|gz|bz2|xz|7z|rar|gpg|pgp|enc|aes|luks|img|iso|dd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1052")
    $primary_entity = array_distinct($file.principal.hostname)
    $user = array_distinct($file.principal.user.userid)
    $written_files = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
