/*
  MITRE Technique : T1027.001 - Binary Padding
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:38:03.160957+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_001_Dropped_Executable_Modified_By_Script_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "An executable or DLL is written to a user-writable staging directory and, within five minutes, the same file is modified in place by a shell or script interpreter. This pattern is consistent with binary padding, where junk data is appended to a dropped payload to change its on-disk size and checksum and evade hash-based or size-limited scanning. Detection is based on file-event sequencing, not command-line matching."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.001"
    mitre_technique_name = "Obfuscated Files or Information: Binary Padding"
    log_prerequisites = "Requires endpoint file telemetry (FILE_CREATION and FILE_MODIFICATION) with populated principal process path and target file path. Sysmon Event ID 11 or equivalent EDR file-write events must be enabled for user-writable directories."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers or updaters that stage and patch binaries via batch or PowerShell scripts; build and packaging scripts on developer workstations; self-updating portable applications; code-signing or installer-authoring workflows run through cmd or PowerShell."
    tuning_guidance = "Add approved deployment and patching tooling to %global_allowed_admin_tools, approved script-running parents to %global_allowed_script_hosts, and automation accounts to %global_allowed_service_accounts. For developer-heavy tenants, scope the rule to non-engineering hosts or raise severity only when the file size grows noticeably between the two events (see $created_size and $modified_size in the outcome)."

  events:
    $create.metadata.event_type = "FILE_CREATION"
    $create.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|programdata|users\\public|windows\\temp)\\.*\.(exe|dll|scr|sys)$/ nocase
    not $create.principal.process.file.full_path in %global_allowed_admin_tools
    $create.principal.hostname = $hostname
    $create.target.file.full_path = $path

    $mod.metadata.event_type = "FILE_MODIFICATION"
    $mod.principal.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $mod.target.file.full_path = /\.(exe|dll|scr|sys)$/ nocase
    not $mod.principal.process.file.full_path in %global_allowed_script_hosts
    not $mod.principal.process.file.full_path in %global_allowed_admin_tools
    not $mod.principal.user.userid in %global_allowed_service_accounts
    $mod.principal.hostname = $hostname
    $mod.target.file.full_path = $path

    $create.metadata.event_timestamp.seconds <= $mod.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 5m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1027.001")
    $primary_entity = array_distinct($hostname)
    $padded_file = array_distinct($path)
    $creating_process = array_distinct($create.principal.process.file.full_path)
    $modifying_process = array_distinct($mod.principal.process.file.full_path)
    $modifying_user = array_distinct($mod.principal.user.userid)
    $created_size = min($create.target.file.size)
    $modified_size = max($mod.target.file.size)

  condition:
    $create and $mod
}
