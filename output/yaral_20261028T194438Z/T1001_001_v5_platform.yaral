/*
  MITRE Technique : T1001.001 - Junk Data
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:06:43.470105+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_001_ESXi_Random_Data_Piped_To_Network_Tool {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi shell command line that combines a kernel random-data device (/dev/urandom or /dev/random) with a network transfer utility or the bash /dev/tcp pseudo-device. This pattern is used to generate and send junk or padding data over a command and control channel so that the traffic is harder to decode or fingerprint. Legitimate administrators rarely stream random bytes to a network socket from a hypervisor shell."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001.001"
    mitre_technique_name = "Data Obfuscation: Junk Data"
    log_prerequisites = "ESXi shell command auditing (shell.log / hostd) forwarded to Chronicle and parsed into PROCESS_LAUNCH events with target.process.command_line populated. SSH or ESXi Shell must be enabled for commands to be logged."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators running network throughput or latency tests with random data (dd from /dev/urandom piped to nc), approved vulnerability scanners or security testing from the host shell, backup or migration scripts that benchmark transfers, and key or token generation scripts that post random material to an internal service."
    tuning_guidance = "Add approved admin users to %global_allowed_admin_users, approved automation accounts to %global_allowed_service_accounts, and approved tooling or parent processes to %global_allowed_admin_tools. Add authorised testing hosts to %global_allowed_scanners. Review matching hosts for an enabled SSH or ESXi Shell session that was not expected."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /\/dev\/u?random/ nocase
    $proc.target.process.command_line = /(\b(nc|ncat|netcat|curl|wget|openssl|telnet|socat)\b|\/dev\/tcp\/|\/dev\/udp\/)/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1001.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
