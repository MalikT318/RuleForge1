/*
  MITRE Technique : T1550.002 - Pass the Hash
  Tactic(s)       : Lateral Movement
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:38:48.257791+00:00
  Reference       : https://attack.mitre.org/techniques/T1550/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1550_002_PtH_Remote_Exec_Lineage_Anomaly {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a command shell or script interpreter spawned non-interactively by the Windows Service Control Manager (services.exe) or the WMI provider host (WmiPrvSE.exe). This lineage is the signature of remote execution after Pass-the-Hash authentication (PsExec-, SMBExec- and WMIExec-style lateral movement). The rule pivots on the unexpected parent-child relationship, not on the credential-theft tooling or specific command content."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1550.002"
    mitre_technique_name = "Use Alternate Authentication Material: Pass the Hash"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path populated (EDR, Sysmon Event ID 1, or Security Event 4688 with process creation auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Monitoring and inventory platforms that run scripts through WMI, software deployment (SCCM/Intune-style agents) using WMI or service-based execution, legitimate admin remote management tools that install a service to launch a shell, and vendor services that wrap batch or PowerShell launchers."
    tuning_guidance = "Add approved automation and monitoring accounts to %global_allowed_service_accounts, approved deployment or management binaries to %global_allowed_admin_tools, and hosts that legitimately run remote scripting to %global_allowed_script_hosts. Review results by target host and the remote logon user to identify the account whose hash was abused."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(services|wmiprvse)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(^|\s)[\/-](c|q|k|command|enc|encodedcommand|e|ec|file|f)(\s|$)/ nocase
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.hostname in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1550.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
