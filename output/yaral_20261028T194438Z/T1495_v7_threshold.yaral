/*
  MITRE Technique : T1495 - Firmware Corruption
  Tactic(s)       : Impact
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:49:29.260430+00:00
  Reference       : https://attack.mitre.org/techniques/T1495
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1495_Linux_Mass_TFTP_Firmware_Push_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single source host opens a high volume of TFTP (UDP/69) connections within ten minutes. TFTP is the usual transport for pushing firmware or boot images to network devices. A burst across many sessions or destinations indicates bulk firmware replacement or corruption (T1495) rather than a one-off backup or restore. Firewall logs carry no process or OS context, so the source is assumed to be a Linux management or jump host based on the deployment's asset inventory."
    mitre_tactic = "Impact"
    mitre_technique = "T1495"
    mitre_technique_name = "Firmware Corruption"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. The firewall must see traffic between management zones and device networks."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Approved network engineering or provisioning hosts doing staged firmware upgrades, PXE/network boot and zero-touch provisioning servers, config backup jobs using TFTP, and lab environments."
    tuning_guidance = "Add approved provisioning, orchestration and network-engineering source addresses to %global_allowed_mgmt_sources and authorised scanners to %global_allowed_scanners. Raise the #net threshold in noisy environments with frequent legitimate upgrades. Review $distinct_destinations for fan-out across many devices."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    $net.principal.ip = $src_ip
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1495")
    $primary_entity = array_distinct($src_ip)
    $event_count = count($net.metadata.id)
    $distinct_destinations = array_distinct($net.target.ip)

  condition:
    #net >= 10
}
