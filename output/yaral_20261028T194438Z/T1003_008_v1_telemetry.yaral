/*
  MITRE Technique : T1003.008 - /etc/passwd and /etc/shadow
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:50:07.679733+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_008_Shadow_Passwd_Copy_Staged_File_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a file in a world-writable staging directory (/tmp, /var/tmp, /dev/shm) whose name references shadow, passwd or unshadow. This is the file artifact left behind when an adversary copies /etc/shadow or /etc/passwd, or writes combined unshadow output, to prepare for offline password cracking. Detection is based on the resulting file state change, so it holds even when command-line logging is evaded or the tool is renamed."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.008"
    mitre_technique_name = "OS Credential Dumping: /etc/passwd and /etc/shadow"
    log_prerequisites = "Requires Linux endpoint file-creation telemetry (EDR file events or auditd PATH/CREATE records) normalised to UDM FILE_CREATION with target.file.full_path and principal process populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup and imaging tools that stage copies of account files; configuration management or migration scripts that snapshot /etc/passwd before changes; administrators making a temporary backup before editing accounts; package or installer scripts for PAM or shadow-utils; application temp files whose names contain 'shadow' (UI themes, CSS, browser caches)."
    tuning_guidance = "Add approved backup and imaging binaries to %global_allowed_backup_processes, approved configuration and deployment tooling to %global_allowed_admin_tools, and break-glass admin accounts to %global_allowed_admin_users. Extend the benign-extension exclusion if application temp files with 'shadow' in the name cause noise in a given estate."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/(.*\/)?[^\/]*(shadow|passwd|unshadow)[^\/]*$/ nocase
    not $file.target.file.full_path = /\.(png|jpe?g|gif|svg|css|scss|so|lock|pyc|log)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1003.008")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
