/*
  MITRE Technique : T1578.004 - Revert Cloud Instance
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:54:22.158362+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_004_Cloud_Instance_Volume_Snapshot_Restore {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects control-plane API calls that revert a cloud compute instance or its storage to an earlier state: replacing an instance root volume from a snapshot or image, restoring a snapshot or image from the recycle bin or an archive tier, or writing a VM restore point. Adversaries use these operations to roll back a host and erase evidence of their activity."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578.004"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Revert Cloud Instance"
    log_prerequisites = "Cloud control-plane audit logs ingested and normalised to UDM, with metadata.product_event_type carrying the provider API operation name and principal.user.userid populated. Management-event logging must be enabled."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Disaster-recovery and rollback exercises, approved patch-failure rollbacks, golden-image or AMI rebuild pipelines, backup and DR orchestration service accounts, and engineers restoring deleted snapshots from the recycle bin."
    tuning_guidance = "Add automation and DR identities to %global_allowed_service_accounts, %global_allowed_cloud_principals or %global_allowed_admin_users. Some parsers map restore operations to USER_RESOURCE_CREATION or USER_RESOURCE_ACCESS; if telemetry shows this, clone the rule with that event type rather than OR-ing event types. Correlate hits with change tickets and with prior suspicious activity on the same instance."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /(CreateReplaceRootVolumeTask|RestoreSnapshotFromRecycleBin|RestoreSnapshotTier|RestoreImageFromRecycleBin|restorepointcollections\/restorepoints\/write)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1578.004")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_operation = array_distinct($cloud.metadata.product_event_type)
    $target_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
