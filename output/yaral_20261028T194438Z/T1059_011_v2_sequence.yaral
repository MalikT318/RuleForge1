/*
  MITRE Technique : T1059.011 - Lua
  Tactic(s)       : Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:22:25.183587+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_011_Lua_Script_Download_Then_Outbound_NonStd_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a Linux host retrieving a Lua script (.lua URL or Lua HTTP client user agent) from an external web server and, within five minutes, opening an outbound connection to an external address on a high non-standard port. This is the network-observable pattern of Lua payload staging followed by interpreter-driven C2 or tooling callbacks. It is a perimeter-based complement to process command-line detections."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.011"
    mitre_technique_name = "Command and Scripting Interpreter: Lua"
    log_prerequisites = "Requires firewall or proxy logs normalised to UDM with NETWORK_HTTP (URL and user agent visible, e.g. via TLS inspection or an explicit proxy) and NETWORK_CONNECTION events with principal.ip populated."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate Lua-based software (OpenResty/nginx, game servers, Neovim or Redis plugin managers, NodeMCU or embedded tooling) fetching .lua files from public repositories, followed by unrelated high-port traffic such as P2P, VoIP, or custom application ports. Vulnerability scanners and package or config management pulling Lua modules."
    tuning_guidance = "Add known-good download sources to %global_allowed_domains, scanner source addresses to %global_allowed_scanners, and approved infrastructure source addresses to %global_allowed_mgmt_sources. Raise the port threshold or add further port exclusions where internal applications use high ports."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    (
      $http.target.url = /\.lua(\?.*)?$/ nocase or
      $http.network.http.user_agent = /(luasocket|lua-resty|lua-http|^lua[\/ ])/ nocase
    )
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources
    $http.principal.ip = $src_ip

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port >= 1024
    $net.target.port != 8080
    $net.target.port != 8443
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    $net.principal.ip = $src_ip

    $http.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $src_ip over 5m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1059.011")
    $primary_entity = array_distinct($src_ip)
    $lua_urls = array_distinct($http.target.url)
    $download_hosts = array_distinct($http.target.hostname)
    $callback_ips = array_distinct($net.target.ip)
    $callback_ports = array_distinct($net.target.port)
    $callback_count = count($net.metadata.id)

  condition:
    $http and $net
}
