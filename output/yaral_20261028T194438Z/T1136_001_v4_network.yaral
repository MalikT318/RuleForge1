/*
  MITRE Technique : T1136.001 - Local Account
  Tactic(s)       : Persistence
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:08:09.155833+00:00
  Reference       : https://attack.mitre.org/techniques/T1136/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_001_Linux_Account_Utility_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux local account management utility (useradd, adduser, newusers, chpasswd, usermod) initiating an outbound connection to a non-internal address. These utilities operate on local files such as /etc/passwd and /etc/shadow and have no legitimate reason to talk to external hosts. External traffic from them suggests a hijacked or proxied process, a trojanised binary, or a remotely driven account-creation tool. This rule is network-side coverage and complements endpoint command-line rules."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136.001"
    mitre_technique_name = "Create Account: Local Account"
    log_prerequisites = "Requires Linux endpoint telemetry that attributes NETWORK_CONNECTION events to the originating process (principal.process.file.full_path), such as EDR network events or auditd connect() records."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Hosts with PAM/NSS modules or identity-sync tooling (LDAP, SSSD, FreeIPA) that run inside account utilities and contact a public identity provider; configuration-management or provisioning wrappers that execute useradd and make external calls in the same process context; misattributed process names in some EDR agents."
    tuning_guidance = "Add approved provisioning or identity-sync binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Ensure %rfc1918_internal covers the client's internal address space. For clients with an external identity provider, add the destination domains to %global_allowed_domains and extend the rule to exclude them if the telemetry carries a target hostname."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(useradd|adduser|newusers|chpasswd|usermod)$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1136.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
