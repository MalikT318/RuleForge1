/*
  MITRE Technique : T1567.002 - Exfiltration to Cloud Storage
  Tactic(s)       : Exfiltration
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:57:44.054467+00:00
  Reference       : https://attack.mitre.org/techniques/T1567/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_002_Large_Outbound_Upload_To_Cloud_Storage_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a single large outbound HTTP PUT/POST upload from an internal client to an external host whose name suggests a storage, file-sharing or object-hosting service. Observed from the network side (proxy/firewall), independent of the endpoint process. Hostname keywords are generic service-type terms, not specific providers, so the rule survives provider changes."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567.002"
    mitre_technique_name = "Exfiltration Over Web Service: Exfiltration to Cloud Storage"
    log_prerequisites = "Requires proxy or firewall logs with HTTP inspection (TLS inspection or SNI-based logging) populating network.http.method, network.sent_bytes and target.hostname, normalised to NETWORK_HTTP."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate large uploads to sanctioned file-sharing or backup services, software publishers pushing build artifacts, users sharing large media files, cloud-sync clients performing initial seeding."
    tuning_guidance = "Add sanctioned storage and file-sharing domains to %global_allowed_domains. Add automation or sync service accounts to %global_allowed_service_accounts. Tune the byte threshold (default 50 MB) per client baseline. Extend or narrow the hostname keyword regex to suit the proxy's hostname population."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(PUT|POST)$/ nocase
    $http.network.sent_bytes > 52428800
    $http.target.hostname = /(storage|drive|bucket|blob|upload|fileshare|filesharing|files|share|objects|cloud)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1567.002")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $max_bytes_sent = max($http.network.sent_bytes)

  condition:
    $http
}
