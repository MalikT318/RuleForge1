/*
  MITRE Technique : T1557.001 - Name Resolution Poisoning and SMB Relay
  Tactic(s)       : Credential Access, Collection
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:31:11.506947+00:00
  Reference       : https://attack.mitre.org/techniques/T1557/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1557_001_Perimeter_SMB_NameRes_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Network-side detection of the result of LLMNR/NBT-NS/mDNS poisoning and SMB relay. A Windows client that has been poisoned sends SMB (445), NetBIOS session (139) or name-resolution traffic (137, 5355, 5353) to a non-internal, non-multicast destination. Legitimate Windows name resolution is link-local and SMB is internal, so these flows crossing the perimeter indicate a victim talking to an attacker-controlled system, or a poisoner or relay host outside the expected trust boundary."
    mitre_tactic = "Credential Access, Collection"
    mitre_technique = "T1557.001"
    mitre_technique_name = "Adversary-in-the-Middle: LLMNR/NBT-NS Poisoning and SMB Relay"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with target.ip and target.port populated, and egress traffic on ports 445/139/137/5355/5353 logged (not dropped silently before logging). Populate %rfc1918_internal with the client's internal address space."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Sanctioned cloud file shares reached over SMB (for example, cloud storage SMB endpoints), site-to-site or VPN-routed SMB where the remote site uses non-RFC1918 space, authorised penetration tests and vulnerability scanners, split-tunnel VPN clients reaching corporate file servers over public addressing, misrouted or misconfigured NetBIOS traffic."
    tuning_guidance = "Add approved cloud file-share domains to %global_allowed_domains, scanner and pen-test sources to %global_allowed_scanners, and make sure %rfc1918_internal covers all client internal space, including any non-RFC1918 space used by remote sites. If port 445 egress is blocked at the perimeter and logged as denied, consider raising severity because attempts still show a poisoned host."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 445 or
      $net.target.port = 139 or
      $net.target.port = 137 or
      $net.target.port = 5355 or
      $net.target.port = 5353
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not net.ip_in_range_cidr($net.target.ip, "224.0.0.0/4")
    not net.ip_in_range_cidr($net.target.ip, "255.255.255.255/32")
    not net.ip_in_range_cidr($net.target.ip, "169.254.0.0/16")
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1557.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
