/*
  MITRE Technique : T1124 - System Time Discovery
  Tactic(s)       : Discovery
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:31:43.721414+00:00
  Reference       : https://attack.mitre.org/techniques/T1124
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1124_Outbound_NTP_To_External_Time_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an internal host sending NTP (UDP/123) time queries directly to an external address, bypassing the internal time hierarchy. Adversaries and malware query external time sources to gather system time, check time zone, or detect sandboxes. This is network-side coverage that complements endpoint command-line detections."
    mitre_tactic = "Discovery"
    mitre_technique = "T1124"
    mitre_technique_name = "System Time Discovery"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip, target.port and network.ip_protocol populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Hosts, appliances, IoT or printers with default public NTP pool settings; cloud-hosted workloads syncing to provider time services; network devices syncing upstream; guest or BYOD networks; misconfigured time sync on newly built systems."
    tuning_guidance = "Add the addresses of approved internal NTP servers and network devices that legitimately sync upstream to %global_allowed_mgmt_sources. Add authorised scanners to %global_allowed_scanners. Review the highest-volume sources first and fix their NTP configuration; remaining unique sources outside the baseline are the signal."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 123
    $net.network.ip_protocol = "UDP"
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1124")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
