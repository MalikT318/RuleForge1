/*
  MITRE Technique : T1003.007 - Proc Filesystem
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:48:28.644543+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_007_Proc_Mem_Read_By_Foreign_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a file-read event on /proc/<pid>/mem where the reading process is not the owner of that PID. Reading another process's virtual memory through the proc filesystem is the core mechanism of Linux credential harvesting from memory. The rule works at the file-access layer, so it still fires if the tool is renamed or the command line is hidden or obfuscated."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.007"
    mitre_technique_name = "OS Credential Dumping: Proc Filesystem"
    log_prerequisites = "Requires Linux EDR file-access telemetry or auditd file-watch rules (for example -w on /proc or syscall auditing of openat/read on /proc/*/mem) normalised to FILE_READ with principal.process.pid populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Debuggers and tracers (gdb, strace, ltrace) run by developers or SREs, crash and core-dump collectors, EDR and security agents, backup or snapshot tools, JVM and language-runtime profilers, and container runtime tooling."
    tuning_guidance = "Add approved debugging, monitoring and agent binaries to %global_allowed_admin_tools, %global_allowed_security_tools or %global_allowed_backup_processes. Add trusted service accounts to %global_allowed_service_accounts. Consider excluding known developer or build hosts via %global_allowed_script_hosts. If principal.process.pid is not populated by the log source, the self-access check is ineffective and self-reads of /proc/<own pid>/mem may need to be allowlisted."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /^\/proc\/[0-9]+\/mem$/
    re.capture($file.target.file.full_path, "^/proc/([0-9]+)/mem$") != $file.principal.process.pid
    $file.principal.process.file.full_path != ""
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1003.007")
    $primary_entity = array_distinct($file.principal.hostname)
    $reading_process = array_distinct($file.principal.process.file.full_path)
    $reading_user = array_distinct($file.principal.user.userid)
    $accessed_path = array_distinct($file.target.file.full_path)

  condition:
    $file
}
