/*
  MITRE Technique : T1667 - Email Bombing
  Tactic(s)       : Impact
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:08:51.346676+00:00
  Reference       : https://attack.mitre.org/techniques/T1667
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1667_Linux_Service_Parent_Spawns_Bulk_Mail_Loop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application runtime or database service process spawning a shell or script interpreter whose command line combines a looping or bulk-iteration construct with a mail-sending utility or SMTP library. Such a parent-child lineage is atypical for legitimate mail and strongly suggests a compromised service being used to flood mailboxes (email bombing) or to relay mass mail."
    mitre_tactic = "Impact"
    mitre_technique = "T1667"
    mitre_technique_name = "Email Bombing"
    log_prerequisites = "Requires Linux EDR or auditd EXECVE telemetry normalised to UDM PROCESS_LAUNCH with populated parent process path, child process path and full command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web applications or cron-style wrappers legitimately sending batched notification or newsletter mail via a shell loop; monitoring or alerting scripts launched by an application server; database maintenance jobs that mail reports; developers testing mail functionality on non-production hosts."
    tuning_guidance = "Add approved parent runtimes or wrapper paths to %global_allowed_script_hosts and approved application accounts to %global_allowed_service_accounts. Extend the parent regex with local application servers if needed. For known bulk-mail applications, exclude by parent process path rather than command-line content."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|php-cgi|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ash|ksh|python[0-9.]*|perl|php[0-9.]*|ruby)$/ nocase
    $proc.target.process.command_line = /(\bfor\s+\w+\s+in\s|\bwhile\s+(true|:|read)|\bseq\s+[0-9]+|\{[0-9]+\.\.[0-9]+\}|\bxargs\b|range\s*\()/ nocase
    $proc.target.process.command_line = /(\bsendmail\b|\bmailx?\b|\bmutt\b|\bmsmtp\b|\bssmtp\b|smtplib|Net::SMTP|\bmail\s*\()/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1667")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
