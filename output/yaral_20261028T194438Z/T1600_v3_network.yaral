/*
  MITRE Technique : T1600 - Weaken Encryption
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:04:27.251494+00:00
  Reference       : https://attack.mitre.org/techniques/T1600
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_Cleartext_Mgmt_Protocol_Across_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects firewall-observed connections to cleartext management or file-transfer ports (telnet, TFTP, rexec/rlogin) that cross the network perimeter, in either direction. Network devices that have had their encryption weakened or disabled (for example by key-space reduction, disabled crypto hardware, or a modified system image) fall back to these protocols, which expose credentials and configuration to interception. The rule also covers adversary use of the same ports for device access or configuration transfer."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1600"
    mitre_technique_name = "Weaken Encryption"
    log_prerequisites = "Firewall, proxy or perimeter connection logs normalised to NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs must record traffic crossing the perimeter."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legacy network equipment or OT/ICS devices that only support telnet or TFTP; vendor remote support sessions; automated firmware or configuration pushes over TFTP; authorised penetration tests and vulnerability scans; outbound telnet to legitimate public services such as MUD or BBS hosts."
    tuning_guidance = "Add approved management jump hosts and device-management addresses to %global_allowed_mgmt_sources. Add authorised scanner addresses to %global_allowed_scanners. For persistent legacy-device use, scope the exclusion to the specific source or destination using the same lists. Raise severity where the destination is a known network device."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 23 or $net.target.port = 69 or $net.target.port = 512 or $net.target.port = 513)
    (not $net.target.ip in %rfc1918_internal or not $net.principal.ip in %rfc1918_internal)
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1600")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
