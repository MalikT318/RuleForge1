/*
  MITRE Technique : T1567.003 - Exfiltration to Text Storage Sites
  Tactic(s)       : Exfiltration
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:59:35.541044+00:00
  Reference       : https://attack.mitre.org/techniques/T1567/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_003_Linux_CLI_Upload_To_External_Web_Service {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP POST or PUT upload with a meaningful request body, sent from a command-line HTTP client user agent (curl, wget, python, Go, perl) to an external destination. This is the network-side signature of scripted data exfiltration to text storage or paste sites. It uses proxy or firewall HTTP telemetry only and does not rely on any endpoint process field or on a hardcoded paste-site domain."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567.003"
    mitre_technique_name = "Exfiltration Over Web Service: Exfiltration to Text Storage Sites"
    log_prerequisites = "Requires a forward proxy, SSL-inspecting firewall, or secure web gateway that populates network.http.method, network.http.user_agent and network.sent_bytes, with target.hostname and target.ip for the destination. Without TLS inspection, the HTTP method and user agent are not visible."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Linux servers that legitimately push data with scripted HTTP clients: monitoring and metrics shippers, CI/CD runners and build agents, package or artifact uploads, webhook and chat notifications, configuration management, and cloud CLI or SDK uploads. Developers testing APIs with curl."
    tuning_guidance = "Add known-good destination domains (SaaS APIs, artifact stores, monitoring back-ends) to %global_allowed_domains. Raise the sent_bytes threshold on noisy estates, or lower it on locked-down server segments. Extend the user-agent regex for additional scripting clients seen in your environment. Consider scoping the rule to server subnets through client-specific tuning."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT)$/ nocase
    $net.network.http.user_agent = /^(curl|libcurl|wget|python-requests|python-urllib|aiohttp|go-http-client|libwww-perl|lwp-)/ nocase
    $net.network.sent_bytes >= 4096
    $net.target.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1567.003")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_host = array_distinct($net.target.hostname)
    $destination_ip = array_distinct($net.target.ip)
    $user_agent = array_distinct($net.network.http.user_agent)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
