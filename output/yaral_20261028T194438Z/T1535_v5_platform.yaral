/*
  MITRE Technique : T1535 - Unused/Unsupported Cloud Regions
  Tactic(s)       : Stealth
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:34:36.334260+00:00
  Reference       : https://attack.mitre.org/techniques/T1535
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1535_Cloud_Compute_Created_In_Opt_In_Region {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of compute instances in rarely enabled, opt-in cloud regions through the control plane API. Adversaries deploy resources in regions customers do not use or monitor, to evade detection or run hijacked compute such as cryptomining. Opt-in regions are disabled by default, so instance creation there by a non-approved identity is a strong indicator."
    mitre_tactic = "Stealth"
    mitre_technique = "T1535"
    mitre_technique_name = "Unused/Unsupported Cloud Regions"
    log_prerequisites = "Cloud provider audit logs (management or activity events) ingested and normalised to UDM RESOURCE_CREATION, with metadata.product_event_type and target.location.name populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Organisations that have legitimately expanded into an opt-in region for data residency or latency. Infrastructure-as-code pipelines and disaster-recovery automation under approved identities. Newly onboarded regional teams."
    tuning_guidance = "Add approved automation and pipeline identities to %global_allowed_service_accounts, %global_allowed_cloud_principals or %global_allowed_admin_users. Confirm that the region name is in target.location.name for your parser. Extend or trim the region regex per client for regions that are in sanctioned use, and consider a per-client copy of the rule once the approved region footprint is known."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /(RunInstances|CreateInstance|instances\.insert|compute\.instances\.create|virtualMachines\.write|CreateVirtualMachine)/ nocase
    $cloud.target.location.name = /^(af-south-1|ap-east-1|ap-south-2|ap-southeast-3|ap-southeast-4|ap-southeast-5|ap-southeast-7|ca-west-1|eu-central-2|eu-south-1|eu-south-2|il-central-1|me-central-1|me-south-1|mx-central-1)$/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1535")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $region = array_distinct($cloud.target.location.name)
    $api_call = array_distinct($cloud.metadata.product_event_type)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
