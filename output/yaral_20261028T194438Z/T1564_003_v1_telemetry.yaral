/*
  MITRE Technique : T1564.003 - Hidden Window
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:16:54.582703+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_003_Linux_Autostart_Desktop_Entry_Dropped_By_Script {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of an XDG autostart .desktop launcher (per-user ~/.config/autostart or system /etc/xdg/autostart) by a shell, scripting interpreter or downloader rather than by a desktop session or package manager. On Linux, .desktop entries control whether an application shows a window, icon or menu entry (Hidden, NoDisplay, Terminal=false, X-GNOME-Autostart keys), so a script-written autostart entry is a file-artifact indicator of persistence that is concealed from the user. Detection works on the resulting file-creation state change and not on command lines, so it holds up when command-line logging is evaded. File content is not visible in FILE_CREATION telemetry, so analysts should inspect the dropped file for Hidden=true, NoDisplay=true or Terminal=false."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.003"
    mitre_technique_name = "Hide Artifacts: Hidden Window"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules on /etc/xdg/autostart and user .config/autostart directories, normalised to UDM FILE_CREATION with principal process and target file path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package post-install scripts (run via sh) registering autostart launchers, configuration management or provisioning scripts (Ansible, Puppet, cloud-init) that deploy desktop entries, user dotfile bootstrap scripts, and developers scripting desktop setup."
    tuning_guidance = "Add approved provisioning or deployment tooling to %global_allowed_admin_tools, trusted parent/host scripting processes to %global_allowed_script_hosts, and automation accounts to %global_allowed_service_accounts. Servers without a desktop environment should rarely produce this event, so consider raising severity on headless hosts."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/home\/[^\/]+|\/root)\/\.config\/autostart\/[^\/]+\.desktop$|^\/etc\/xdg\/autostart\/[^\/]+\.desktop$/ nocase
    $file.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|fish|python[0-9.]*|perl|ruby|php|node|curl|wget|busybox)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1564.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
