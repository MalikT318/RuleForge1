/*
  MITRE Technique : T1110.002 - Password Cracking
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:05:54.508999+00:00
  Reference       : https://attack.mitre.org/techniques/T1110/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1110_002_Outbound_TFTP_Config_Hash_Exfil {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a connection from internal address space to an external TFTP service (UDP/TCP 69). Offline password cracking is not observable on the wire. The network-side precursor is the removal of device configuration files that contain hashed credentials (T1602 feeding T1110.002). TFTP has no authentication or encryption and is almost never legitimate across the perimeter, so an outbound TFTP session to a non-internal destination is a strong signal that configuration or hash material is leaving for cracking elsewhere. This rule gives precursor coverage only and does not detect the cracking itself."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1110.002"
    mitre_technique_name = "Brute Force: Password Cracking"
    log_prerequisites = "Perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Egress TFTP must be logged (permit and deny both help)."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Vendor-managed network device backup or firmware upload to an external TFTP server, managed service provider config backup jobs, lab or staging gear PXE or firmware loads over the internet, misrouted traffic to a private range that is not covered by the internal list."
    tuning_guidance = "Add approved backup or management source addresses to %global_allowed_mgmt_sources. Make sure %rfc1918_internal covers all internal and carrier-grade NAT ranges used by the client. If the client legitimately uses an external TFTP provider, scope an exclusion by the source device rather than widening the port."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1110.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
