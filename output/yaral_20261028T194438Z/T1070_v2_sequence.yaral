/*
  MITRE Technique : T1070 - Indicator Removal
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:02:09.462733+00:00
  Reference       : https://attack.mitre.org/techniques/T1070
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_Container_Exec_Then_Resource_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A user opens an interactive exec or attach session into a running pod and, within 10 minutes, the same identity deletes Kubernetes events or pods. This pattern is consistent with an adversary removing control-plane evidence (cluster events, the pod itself) after working inside a container."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070"
    mitre_technique_name = "Indicator Removal"
    log_prerequisites = "Kubernetes API server audit logs at Metadata level or higher, covering pods/exec, pods/attach and delete verbs, ingested and normalised to UDM with metadata.product_event_type populated."
    platform = "Containers"
    log_source = "container"
    false_positives = "Engineers debugging a pod then deleting it to force a restart, CI/CD or GitOps jobs running exec and cleanup under a human identity, chaos-engineering tests, routine namespace cleanup after troubleshooting."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, approved platform or SRE administrators to %global_allowed_admin_users, and approved cloud or identity principals to %global_allowed_cloud_principals. If pod deletion is too noisy, narrow the deletion regex to events only."

  events:
    $exec.metadata.event_type = "USER_RESOURCE_ACCESS"
    $exec.metadata.product_event_type = /pods\.(exec|attach)\.(create|get)$/ nocase
    $exec.principal.user.userid = $user
    not $exec.principal.user.userid in %global_allowed_service_accounts
    not $exec.principal.user.userid in %global_allowed_admin_users
    not $exec.principal.user.userid in %global_allowed_cloud_principals

    $del.metadata.event_type = "RESOURCE_DELETION"
    $del.metadata.product_event_type = /\.(events|pods)\.(delete|deletecollection)$/ nocase
    $del.principal.user.userid = $user
    not $del.principal.user.userid in %global_allowed_service_accounts
    not $del.principal.user.userid in %global_allowed_admin_users
    not $del.principal.user.userid in %global_allowed_cloud_principals

    $exec.metadata.event_timestamp.seconds <= $del.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1070")
    $primary_entity = array_distinct($user)
    $exec_targets = array_distinct($exec.target.resource.name)
    $deleted_resources = array_distinct($del.target.resource.name)
    $deletion_count = count($del.metadata.id)

  condition:
    $exec and $del
}
