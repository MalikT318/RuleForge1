/*
  MITRE Technique : T1211 - Exploitation for Stealth
  Tactic(s)       : Stealth
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:19:02.333494+00:00
  Reference       : https://attack.mitre.org/techniques/T1211
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1211_Linux_Logging_Daemon_Spawns_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux logging or audit daemon (rsyslog, syslog-ng, journald, auditd and similar) launching a shell, scripting interpreter or network transfer utility. Logging daemons do not normally spawn interactive or scripting children, so this is a likely result of exploiting the logging pipeline to run code from a trusted, rarely scrutinised process and evade audit trails."
    mitre_tactic = "Stealth"
    mitre_technique = "T1211"
    mitre_technique_name = "Exploitation for Stealth"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records normalised to UDM PROCESS_LAUNCH, with parent process path populated in principal.process.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "rsyslog omprog output modules or syslog-ng program() destinations that run approved helper scripts; auditd disk_full_action, space_left_action or admin_space_left_action scripts; custom log-forwarding wrappers started from a shell by the daemon."
    tuning_guidance = "Add approved parent daemon paths that legitimately run helper scripts to %global_allowed_script_hosts. Add approved helper binaries to %global_allowed_admin_tools. Review omprog and audit action configuration on noisy hosts before allowlisting."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(rsyslogd|syslogd|syslog-ng|systemd-journald|journald|auditd|audispd|audisp-remote)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ksh|csh|tcsh|ash|python[0-9.]*|perl|ruby|php|nc|ncat|netcat|socat|curl|wget|telnet)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1211")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
