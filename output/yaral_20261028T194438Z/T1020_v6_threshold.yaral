/*
  MITRE Technique : T1020 - Automated Exfiltration
  Tactic(s)       : Exfiltration
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:31:00.916219+00:00
  Reference       : https://attack.mitre.org/techniques/T1020
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1020_Firewall_Repeated_Large_Outbound_Flows {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source sends several large outbound flows to external destinations within ten minutes. Each flow is unremarkable alone, but repeated bulk uploads in a short window are consistent with scripted or automated data exfiltration over the network perimeter."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1020"
    mitre_technique_name = "Automated Exfiltration"
    log_prerequisites = "Requires firewall or perimeter flow/connection logs normalised to UDM NETWORK_FLOW with principal.ip, target.ip and network.sent_bytes populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Cloud backup and replication jobs, software or OS update distribution, large file sync to approved SaaS, video conferencing or streaming uploads, CI/CD artifact publishing, authorised penetration tests."
    tuning_guidance = "Add approved external destination domains to %global_allowed_domains and approved management or backup source addresses to %global_allowed_mgmt_sources. Raise the byte threshold in network.sent_bytes or the flow count in the condition for high-volume environments. Review $total_bytes_sent and $distinct_destinations in the outcome during triage."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    $net.network.sent_bytes > 1000000
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains
    $net.principal.ip = $src

  match:
    $src over 10m

  outcome:
    $risk_score = max(if($net.network.sent_bytes > 10000000, 85, 60))
    $mitre_technique_id = array_distinct("T1020")
    $primary_entity = array_distinct($src)
    $flow_count = count($net.metadata.id)
    $total_bytes_sent = sum($net.network.sent_bytes)
    $distinct_destinations = count_distinct($net.target.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 5
}
