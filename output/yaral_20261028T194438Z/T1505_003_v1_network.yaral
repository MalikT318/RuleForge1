/*
  MITRE Technique : T1505.003 - Web Shell
  Tactic(s)       : Persistence
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:29:26.103444+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_003_External_POST_To_Script_In_Static_Content_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external client sending an HTTP POST to a server-side script file (aspx, ashx, asmx, asp, cer, asa, php) located under a directory normally reserved for static content (uploads, images, css, js, assets, media, temp). The server answers successfully. Legitimate applications rarely execute scripts from these paths, but web shells dropped through upload flaws are commonly placed there and driven with POST requests. This is network-side coverage that does not rely on endpoint process telemetry."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.003"
    mitre_technique_name = "Server Software Component: Web Shell"
    log_prerequisites = "Requires perimeter proxy, reverse proxy or web-aware firewall logs that populate network.http.method, target.url and network.http.response_code (HTTP inspection or TLS decryption must be enabled for inbound traffic to Windows web servers)."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Web applications that legitimately post to handlers stored under upload or media directories (file upload widgets, CMS media handlers, image processing endpoints), authorised penetration tests and vulnerability scanners, and CDN or monitoring probes."
    tuning_guidance = "Add authorised scanner and pen-test source addresses to %global_allowed_scanners. Source IPs in %global_allowed_mgmt_sources are also excluded. If a client application legitimately uses script handlers in one of the listed directories, narrow the directory regex for that tenant or exclude the destination host. Raise severity when the same source also hits the same URL repeatedly."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.network.http.response_code = 200
    $net.target.url = /\/(upload|uploads|image|images|img|css|js|static|assets|media|files|temp|tmp|content|fonts|downloads)\/[^?#\s]*\.(aspx|ashx|asmx|asp|cer|asa|php)([?#].*)?$/ nocase
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1505.003")
    $primary_entity = array_distinct($net.target.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
