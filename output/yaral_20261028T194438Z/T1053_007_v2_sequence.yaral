/*
  MITRE Technique : T1053.007 - Container Orchestration Job
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:19:28.854724+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_007_K8s_Secret_Or_Exec_Access_Then_CronJob_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A single Kubernetes identity reads secrets, requests a service-account token, or execs/attaches into a pod, then creates a CronJob within one hour. This pattern suggests credential or foothold acquisition followed by scheduled-container persistence or execution, which is a common cluster persistence technique."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.007"
    mitre_technique_name = "Scheduled Task/Job: Container Orchestration Job"
    log_prerequisites = "Kubernetes API server audit logs at Metadata level or higher, ingested and parsed to UDM. The request URI must be populated in target.url and the acting identity in principal.user.userid. Audit policy must record secrets, pods/exec and cronjobs requests."
    platform = "Containers"
    log_source = "container"
    false_positives = "GitOps controllers and CI/CD deployers that read secrets and then apply CronJob manifests; platform engineers debugging a pod (exec) and then deploying a legitimate scheduled maintenance or backup CronJob; operators and Helm releases that install CronJobs after reading secrets."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts and named platform administrators to %global_allowed_admin_users. Because the join is per identity, tune by identity rather than by namespace. If audit logs are noisy, restrict the first event to pods/exec or serviceaccounts/token only."

  events:
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.target.url = /\/(pods\/[^\/\?]+\/(exec|attach)|secrets|serviceaccounts\/[^\/\?]+\/token)(\/|\?|$)/ nocase
    $access.principal.user.userid = $user
    not $access.principal.user.userid = /^system:(kube-|node|apiserver|serviceaccount:kube-system)/ nocase
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_admin_users

    $create.metadata.event_type = "RESOURCE_CREATION"
    $create.target.url = /\/apis\/batch\/[^\/]+\/(namespaces\/[^\/]+\/)?cronjobs(\/|\?|$)/ nocase
    $create.principal.user.userid = $user
    not $create.principal.user.userid in %global_allowed_service_accounts
    not $create.principal.user.userid in %global_allowed_admin_users

    $access.metadata.event_timestamp.seconds <= $create.metadata.event_timestamp.seconds

  match:
    $user over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1053.007")
    $primary_entity = array_distinct($create.principal.user.userid)
    $access_urls = array_distinct($access.target.url)
    $cronjob_urls = array_distinct($create.target.url)
    $source_ips = array_distinct($create.principal.ip)
    $access_event_count = count($access.metadata.id)

  condition:
    $access and $create
}
