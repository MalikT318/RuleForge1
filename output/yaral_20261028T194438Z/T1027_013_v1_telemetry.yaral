/*
  MITRE Technique : T1027.013 - Encrypted/Encoded File
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:58:33.490280+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_013_Encoded_Encrypted_Payload_File_Dropped_By_Script_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a file with an encoded or encrypted payload extension (base64, enc, crypt, aes, xor, rc4, pgp) in a user-writable staging location, written by a script interpreter, Office application or encoding-capable LOLBin. This catches the resulting file artifact of T1027.013 regardless of how the command line was obfuscated or hidden."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.013"
    mitre_technique_name = "Obfuscated Files or Information: Encrypted/Encoded File"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry with the writing process populated (EDR file events or Sysmon Event ID 11) normalised to UDM FILE_CREATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developers and admins encoding certificates or keys with certutil or PowerShell, PowerShell-based backup or export scripts writing .enc/.gpg files, encrypted-mail or PGP tooling, software packaging pipelines, and automation that stages encrypted configuration files in temp or ProgramData."
    tuning_guidance = "Add approved script-hosting or automation executables to %global_allowed_script_hosts, deployment and RMM tooling to %global_allowed_admin_tools, and backup software to %global_allowed_backup_processes. Narrow the extension list or staging-directory regex per client if a business application legitimately writes these files."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(b64|base64|b64enc|enc|encrypted|crypt|aes|xor|rc4|pgp|gpg)$/ nocase
    $file.target.file.full_path = /(\\users\\[^\\]+\\(appdata|downloads|desktop|documents)\\|\\users\\public\\|\\programdata\\|\\windows\\temp\\|\\temp\\)/ nocase
    $file.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|certutil|cmd|rundll32|regsvr32|winword|excel|powerpnt|outlook)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.013")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
