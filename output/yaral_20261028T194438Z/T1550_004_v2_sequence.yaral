/*
  MITRE Technique : T1550.004 - Web Session Cookie
  Tactic(s)       : Lateral Movement
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:42:08.496566+00:00
  Reference       : https://attack.mitre.org/techniques/T1550/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1550_004_Session_Reuse_Divergent_Source_Agent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects one identity authenticating twice within 10 minutes from a different source IP and a different client user agent. This pattern suggests a stolen web session cookie replayed from attacker infrastructure, with the second session inheriting authentication (including MFA) from the first. Analysts should confirm whether the second event was a fresh interactive authentication or a token or session reuse."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1550.004"
    mitre_technique_name = "Use Alternate Authentication Material: Web Session Cookie"
    log_prerequisites = "Identity provider sign-in logs normalised to UDM USER_LOGIN with principal.user.userid, principal.ip and network.http.user_agent populated."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Users roaming between Wi-Fi and mobile networks, VPN or split-tunnel reconnects, users signed in on a laptop and phone at once, corporate proxy or egress IP rotation, and browser or client updates that change the user agent."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Add known egress or management addresses to %global_allowed_mgmt_sources. Raise severity if the second login also touches privileged resources, or narrow the window for mobile-heavy tenants."

  events:
    $login_a.metadata.event_type = "USER_LOGIN"
    $login_a.principal.user.userid != ""
    $login_a.principal.user.userid = $user
    $login_a.network.http.user_agent != ""
    not $login_a.principal.user.userid in %global_allowed_service_accounts
    not $login_a.principal.user.userid in %global_allowed_admin_users

    $login_b.metadata.event_type = "USER_LOGIN"
    $login_b.principal.user.userid = $user
    $login_b.network.http.user_agent != ""
    not $login_b.principal.ip in %global_allowed_mgmt_sources

    $login_a.principal.ip != $login_b.principal.ip
    $login_a.network.http.user_agent != $login_b.network.http.user_agent
    $login_a.metadata.event_timestamp.seconds < $login_b.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1550.004")
    $primary_entity = array_distinct($user)
    $first_source_ips = array_distinct($login_a.principal.ip)
    $second_source_ips = array_distinct($login_b.principal.ip)
    $first_user_agents = array_distinct($login_a.network.http.user_agent)
    $second_user_agents = array_distinct($login_b.network.http.user_agent)
    $login_count = count($login_b.metadata.id)

  condition:
    $login_a and $login_b
}
