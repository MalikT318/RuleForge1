/*
  MITRE Technique : T1137 - Office Application Startup
  Tactic(s)       : Persistence
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:13:35.046864+00:00
  Reference       : https://attack.mitre.org/techniques/T1137
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_Login_Then_Mailbox_Rule_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a user sign-in followed within 10 minutes by creation or modification of a mailbox inbox rule for the same account. Attackers use inbox rules (Outlook rules abuse) to persist in a mailbox, hide or redirect mail, and trigger actions after account compromise (T1137.005)."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137"
    mitre_technique_name = "Office Application Startup"
    log_prerequisites = "Requires Microsoft 365 unified audit log ingestion with Azure AD sign-in and Exchange mailbox audit (admin and mailbox rule operations) normalised to UDM. No endpoint process telemetry is needed."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Users creating legitimate mail-organisation rules right after signing in (the most common source), helpdesk staff or migration tooling configuring rules for users, executive assistants managing delegated mailboxes, and automation accounts that deploy standard rules."
    tuning_guidance = "Add automation and migration accounts to %global_allowed_service_accounts. Add helpdesk and messaging administrators to %global_allowed_admin_users. If volume is high, extend the rule with a condition on external sign-in source or rule parameters (forward, redirect, delete, move to RSS or Archive folders). Confirm the product_event_type values match how the tenant's M365 parser populates Exchange operations."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.metadata.product_event_type = /^(UserLoggedIn|MailboxLogin)$/ nocase
    $login.target.user.userid = $user
    not $login.target.user.userid in %global_allowed_service_accounts
    not $login.target.user.userid in %global_allowed_admin_users

    $rule.metadata.event_type = "SETTING_MODIFICATION"
    $rule.metadata.product_event_type = /^(New-InboxRule|Set-InboxRule|UpdateInboxRules)$/ nocase
    $rule.principal.user.userid = $user
    not $rule.principal.user.userid in %global_allowed_service_accounts
    not $rule.principal.user.userid in %global_allowed_admin_users

    $login.metadata.event_timestamp.seconds <= $rule.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1137")
    $primary_entity = array_distinct($user)
    $login_source_ips = array_distinct($login.principal.ip)
    $rule_operations = array_distinct($rule.metadata.product_event_type)
    $rule_source_ips = array_distinct($rule.principal.ip)
    $rule_event_count = count($rule.metadata.id)

  condition:
    $login and $rule
}
