/*
  MITRE Technique : T1218 - System Binary Proxy Execution
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:40:58.588569+00:00
  Reference       : https://attack.mitre.org/techniques/T1218
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_Linux_Trusted_Utility_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an outbound connection to a non-internal address where the connecting process is a core system utility that has no legitimate reason to open network sockets (split, xargs, find, stdbuf, flock, taskset, ionice, nice, setsid, nohup, timeout, env, dd, tee, install), or where the connection's parent process is split. This is the network-side footprint of adversaries proxying execution through trusted Linux binaries (for example split --filter or xargs spawning a reverse shell or downloader) to bypass process-name and signature-based controls. It complements process-creation detections by observing the resulting egress traffic."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218"
    mitre_technique_name = "System Binary Proxy Execution"
    log_prerequisites = "Requires Linux endpoint network telemetry (EDR socket/connect events or auditd connect syscall records) normalized to NETWORK_CONNECTION with principal.process.file.full_path and target.ip populated. Parent process path (principal.process.parent_process.file.full_path) improves coverage but is optional."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrator one-liners that wrap network tools in nohup, setsid, timeout or xargs; configuration management and deployment agents; backup or monitoring scripts using flock or nice to wrap curl or rsync; EDR products attributing a child's socket to the wrapper binary; container entrypoints using env or setsid."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools (matched on the connecting process path) and approved script-running parents to %global_allowed_script_hosts. Trim the wrapper binary list (nohup, timeout, env, nice) if the environment has heavy legitimate script usage. Loopback traffic is not covered by %rfc1918_internal; if the EDR reports loopback connections, add loopback strings to that list for the tenant."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.principal.process.file.full_path = /\/(split|xargs|find|stdbuf|flock|taskset|ionice|nice|setsid|nohup|timeout|env|dd|tee|install)$/ nocase or
      $net.principal.process.parent_process.file.full_path = /\/split$/ nocase
    )
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.parent_process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1218")
    $primary_entity = array_distinct($net.principal.hostname)
    $connecting_process = array_distinct($net.principal.process.file.full_path)
    $parent_process = array_distinct($net.principal.process.parent_process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
