/*
  MITRE Technique : T1040 - Network Sniffing
  Tactic(s)       : Credential Access, Discovery
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:28:12.484373+00:00
  Reference       : https://attack.mitre.org/techniques/T1040
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1040_Cloud_Traffic_Mirror_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single cloud identity created several traffic-mirroring or packet-capture resources (mirror targets, filters, sessions, virtual network taps, packet captures) within 10 minutes. Each creation is normal on its own, but a burst from one principal matches how an adversary sets up cloud network sniffing to copy workload traffic to a collector."
    mitre_tactic = "Credential Access, Discovery"
    mitre_technique = "T1040"
    mitre_technique_name = "Network Sniffing"
    log_prerequisites = "Cloud control-plane audit logging must be enabled and normalised to UDM RESOURCE_CREATION with metadata.product_event_type and principal.user.userid populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Network or security engineering teams building approved traffic inspection (IDS/NDR sensor deployment), infrastructure-as-code pipelines provisioning mirroring, and troubleshooting of network issues with packet captures."
    tuning_guidance = "Add IaC pipeline and NDR deployment identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Raise the condition threshold for tenants that deploy mirroring frequently. Review the destination target resource names in the outcome to confirm the collector is an approved sensor."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /(CreateTrafficMirror(Session|Target|Filter|FilterRule)|packetMirrorings\.(insert|patch)|virtualNetworkTaps\/write|networkWatchers\/packetCaptures\/write)/ nocase
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  match:
    $user over 10m

  outcome:
    $event_count = count($cloud.metadata.id)
    $risk_score = max(if($event_count >= 6, 85, 65))
    $mitre_technique_id = array_distinct("T1040")
    $primary_entity = array_distinct($user)
    $api_calls = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)
    $target_resources = array_distinct($cloud.target.resource.name)

  condition:
    #cloud >= 3
}
