/*
  MITRE Technique : T1566.003 - Spearphishing via Service
  Tactic(s)       : Initial Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:51:38.474299+00:00
  Reference       : https://attack.mitre.org/techniques/T1566/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1566_003_Burst_Risky_File_Downloads_External_Services {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single Windows host downloads several executable, script, shortcut, disk-image, macro-document or archive files over HTTP from external, non-allowlisted destinations within ten minutes. Each download is individually common. A burst of risky payload types from third-party services fits delivery of attachments or links received through webmail, social media or messaging platforms (spearphishing via service), and is visible at the perimeter without endpoint process data."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1566.003"
    mitre_technique_name = "Phishing: Spearphishing via Service"
    log_prerequisites = "Proxy or firewall logs with URL visibility (TLS inspection or explicit proxy) normalised to UDM NETWORK_HTTP, with principal.hostname and target.url populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Software installers and updaters fetched from vendor or CDN sites not yet allowlisted, developers or admins pulling tooling and archives, package and build systems, and users legitimately downloading shared documents or zip files from cloud file-sharing services."
    tuning_guidance = "Add known-good vendor, CDN and update domains to %global_allowed_domains. Raise the #http threshold for build servers or developer workstations. Narrow or extend the file extension list to fit the client's proxy URL logging."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.principal.hostname = $host
    $http.network.http.method = "GET" nocase
    $http.target.url = /\.(exe|scr|msi|iso|img|vhd|lnk|js|jse|vbs|vbe|hta|wsf|ps1|bat|cmd|dll|jar|docm|xlsm|zip|rar|7z)(\?[^\/]*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($http.metadata.id)
    $mitre_technique_id = array_distinct("T1566.003")
    $primary_entity = array_distinct($host)
    $source_users = array_distinct($http.principal.user.userid)
    $download_hosts = array_distinct($http.target.hostname)
    $download_urls = array_distinct($http.target.url)
    $destination_ips = array_distinct($http.target.ip)

  condition:
    #http >= 4
}
