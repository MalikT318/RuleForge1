/*
  MITRE Technique : T1547.010 - Port Monitors
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:37:05.584358+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_010_Port_Monitor_DLL_Drop_Then_Driver_Registration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A DLL is written to System32 or SysWOW64 and, within ten minutes on the same host, a Driver value is set under HKLM\\SYSTEM\\CurrentControlSet\\Control\\Print\\Monitors. This is the typical AddMonitor-style port monitor persistence, where spoolsv.exe loads the DLL as SYSTEM at boot."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.010"
    mitre_technique_name = "Boot or Logon Autostart Execution: Port Monitors"
    log_prerequisites = "Requires EDR or Sysmon file creation telemetry (FILE_CREATION) and registry modification telemetry (REGISTRY_MODIFICATION) with the process context populated. Registry auditing must cover the Print\\Monitors key."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Printer driver and print management software installs (vendor print suites, universal print drivers, virtual PDF printers), software deployment tooling that installs new port monitors, OS servicing that updates print components."
    tuning_guidance = "Add approved print and deployment tooling executables to %global_allowed_admin_tools. Add EDR or AV agents that write to System32 to %global_allowed_security_tools. If the DLL is staged outside System32 or SysWOW64, extend the file path regex. A Driver value created as a new key may be logged as REGISTRY_CREATION in some pipelines. Clone the registry event block with that type if needed."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\windows\\(system32|syswow64)\\[^\\]+\.dll$/ nocase
    not $file.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|MsMpEng|MsSense|SenseIR|wuauclt|usoclient)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control\\Print\\Monitors\\/ nocase
    $reg.target.registry.registry_value_name = "Driver" nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    $reg.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1547.010")
    $primary_entity = array_distinct($hostname)
    $dropped_dlls = array_distinct($file.target.file.full_path)
    $dropping_processes = array_distinct($file.principal.process.file.full_path)
    $monitor_keys = array_distinct($reg.target.registry.registry_key)
    $registry_writers = array_distinct($reg.principal.process.file.full_path)

  condition:
    $file and $reg
}
