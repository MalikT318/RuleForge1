/*
  MITRE Technique : T1573.002 - Asymmetric Cryptography
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:25:46.177533+00:00
  Reference       : https://attack.mitre.org/techniques/T1573/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1573_002_TLS_NoSNI_NonStandard_Port_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an IDS/IPS-observed TLS session from an internal host to an external destination on a non-standard port with no SNI. Malware that wraps C2 in public-key (TLS/RSA) encryption often connects directly to an IP-addressed server on an unusual port. This is network-side coverage for Windows hosts, complementing process command-line rules. Because it keys on TLS metadata rather than host telemetry, it works when no EDR is present."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1573.002"
    mitre_technique_name = "Encrypted Channel: Asymmetric Cryptography"
    log_prerequisites = "IDS/IPS or network security appliance logs that populate TLS metadata (network.tls.version, network.tls.client.server_name) and destination port on connection events. Appliances that do not parse the TLS handshake will not trigger this rule."
    platform = "Windows"
    log_source = "ips"
    false_positives = "Custom line-of-business apps using TLS on non-standard ports, VoIP/video conferencing, mail or LDAPS services on alternate ports, VPN and remote-access clients, IoT or update agents connecting by IP, and TLS clients that legitimately omit SNI."
    tuning_guidance = "Add authorised scanner source IPs to %global_allowed_scanners and known-good destination hostnames to %global_allowed_domains. If the sensor does not populate target.hostname, tune with the standard-port list in the rule instead. Extend the standard-port exclusions for environment-specific TLS services. Raise severity for hosts that also match other C2 rules."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.tls.version != ""
    $net.network.tls.client.server_name = ""
    $net.target.port > 1024
    $net.target.port != 8443
    $net.target.port != 8080
    $net.target.port != 9443
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1573.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
