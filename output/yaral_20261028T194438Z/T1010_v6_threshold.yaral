/*
  MITRE Technique : T1010 - Application Window Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:19:10.419223+00:00
  Reference       : https://attack.mitre.org/techniques/T1010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1010_Linux_Window_Enumeration_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A high volume of X11/desktop window-enumeration utility launches on a single Linux host within ten minutes. One invocation is routine, but repeated polling by non-interactive or scripted parents suggests an implant or script mapping open application windows to find sensitive applications or security tooling."
    mitre_tactic = "Discovery"
    mitre_technique = "T1010"
    mitre_technique_name = "Application Window Discovery"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve events normalised to UDM PROCESS_LAUNCH, with target.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Desktop automation and GUI test frameworks, status bars and panels that poll window properties, accessibility tools, kiosk or VDI session scripts, and remote-support agents on desktop Linux."
    tuning_guidance = "Add approved automation parents to %global_allowed_script_hosts and approved tooling to %global_allowed_admin_tools. Add known automation accounts to %global_allowed_service_accounts. Raise the #proc threshold on developer workstations with heavy GUI automation. Servers without a desktop environment should rarely see these utilities, so the threshold can be lowered there."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(wmctrl|xwininfo|xdotool|xprop|xlsclients|xdpyinfo)$/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path = /\/(i3bar|i3status|polybar|waybar|gnome-shell|xfce4-panel|plasmashell|picom|sxhkd)$/ nocase

  match:
    $host over 10m

  outcome:
    $risk_score = max(45)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1010")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $tools_used = array_distinct($proc.target.process.file.full_path)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)

  condition:
    #proc >= 10
}
