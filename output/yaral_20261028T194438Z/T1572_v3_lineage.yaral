/*
  MITRE Technique : T1572 - Protocol Tunneling
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:19:35.345375+00:00
  Reference       : https://attack.mitre.org/techniques/T1572
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1572_ESXi_Tunnel_Binary_From_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi host management daemon or service process (host agent, vCenter agent, CIM broker, WS-Management, reverse proxy, web server, or script interpreter) directly spawning a network tunneling or relay binary such as ssh or nc. Interactive administrators reach these binaries through a login shell, not from a management daemon. A daemon parent indicates a compromised service or an injected or web-shell-driven process setting up SSH port forwarding or a raw relay. The rule pivots on process lineage, not command-line content, so it complements existing command-line tunneling detections."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1572"
    mitre_technique_name = "Protocol Tunneling"
    log_prerequisites = "ESXi shell and process execution telemetry forwarded to Chronicle, including parent and child process paths (for example shell.log or auditd-style process events parsed into PROCESS_LAUNCH)."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Vendor or backup agents that run as a daemon and legitimately call ssh or nc for health checks; custom monitoring scripts invoked by python-based services; support-driven troubleshooting using a script host; automation frameworks that spawn ssh from a service account."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts, approved agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. If a specific daemon parent is noisy in one tenant, confirm its behavior and add it to the appropriate list rather than loosening the child regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(hostd|hostd-worker|vpxa|fdm|sfcbd|sfcb-[a-z_]+|openwsman|wsman|rhttpproxy|lighttpd|python[0-9.]*|snmpd|slpd|vmsyslogd)$/ nocase
    $proc.target.process.file.full_path = /\/(ssh|nc|netcat|ncat|socat|dbclient)$/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1572")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
