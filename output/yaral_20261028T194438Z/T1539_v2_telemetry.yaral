/*
  MITRE Technique : T1539 - Steal Web Session Cookie
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:38:53.724814+00:00
  Reference       : https://attack.mitre.org/techniques/T1539
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1539_SaaS_Session_Lifetime_Policy_Weakened {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change to identity-provider session or token policy (session lifetime, sign-in frequency, persistent browser session, remember-device). This is the state change that extends how long a stolen session cookie stays usable, so it flags cookie-theft enablement or persistence rather than the theft itself. Detection is at the configuration layer, not process or command-line level. It is a precursor and persistence indicator and should be triaged alongside token-replay detections."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1539"
    mitre_technique_name = "Steal Web Session Cookie"
    log_prerequisites = "Identity provider directory/admin audit logs normalised to UDM SETTING_MODIFICATION, with the policy or setting name populated in target.resource.name or metadata.description."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Planned security-policy reviews, helpdesk or IAM teams changing session timeouts for usability, onboarding of new applications, tenant migrations, and IaC or automation pipelines that reconcile policy."
    tuning_guidance = "Add named IAM administrators to %global_allowed_admin_users and automation or pipeline identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Narrow the regex if a client's audit log uses distinct policy naming. Raise severity when the change is made outside change windows or by an account that has just had an anomalous sign-in."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    (
      $setting.target.resource.name = /(session|token|cookie).{0,30}(lifetime|timeout|duration|expir|frequency|validity)|sign.?in.?frequency|persistent.{0,15}(browser|session)|remember.{0,15}(me|device|mfa)|keep.?me.?signed.?in/ nocase or
      $setting.metadata.description = /(session|token|cookie).{0,30}(lifetime|timeout|duration|expir|frequency|validity)|sign.?in.?frequency|persistent.{0,15}(browser|session)|remember.{0,15}(me|device|mfa)|keep.?me.?signed.?in/ nocase
    )
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1539")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $changed_setting = array_distinct($setting.target.resource.name)
    $source_ip = array_distinct($setting.principal.ip)

  condition:
    $setting
}
