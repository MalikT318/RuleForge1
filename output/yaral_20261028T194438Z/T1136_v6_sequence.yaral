/*
  MITRE Technique : T1136 - Create Account
  Tactic(s)       : Persistence
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:06:44.850280+00:00
  Reference       : https://attack.mitre.org/techniques/T1136
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_SaaS_Account_Created_Then_Privileges_Granted {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A single actor creates a new user account and then, within ten minutes, performs a permission, role or policy change. This sequence is typical of an adversary creating a secondary account and giving it access to maintain persistence in a SaaS or cloud tenant."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136"
    mitre_technique_name = "Create Account"
    log_prerequisites = "Requires SaaS or cloud control-plane audit logs that normalise account creation to USER_CREATION and permission or role changes to RESOURCE_PERMISSIONS_CHANGE, with principal.user.userid populated on both. Also requires metadata.product_event_type to be populated."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Identity lifecycle automation and HR-driven onboarding workflows; helpdesk or IT admins provisioning new employees and assigning initial roles; SCIM or directory-sync connectors; break-glass account provisioning during approved change windows."
    tuning_guidance = "Add onboarding automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Add named IAM or helpdesk administrators to %global_allowed_admin_users. Narrow the product_event_type regex on the permission event if a client logs very noisy role updates. Add a join on the new account identifier if the client's log source populates target.user.userid consistently on both events."

  events:
    $create.metadata.event_type = "USER_CREATION"
    $create.principal.user.userid != ""
    $create.principal.user.userid = $actor
    not $create.principal.user.userid in %global_allowed_admin_users
    not $create.principal.user.userid in %global_allowed_service_accounts
    not $create.principal.user.userid in %global_allowed_cloud_principals

    $perm.metadata.event_type = "RESOURCE_PERMISSIONS_CHANGE"
    $perm.principal.user.userid != ""
    $perm.principal.user.userid = $actor
    $perm.metadata.product_event_type = /(attach|add|grant|assign|put|set|update|create).*(role|policy|permission|member|admin|iam)/ nocase
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_cloud_principals

    $create.metadata.event_timestamp.seconds <= $perm.metadata.event_timestamp.seconds

  match:
    $actor over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1136")
    $primary_entity = array_distinct($actor)
    $created_accounts = array_distinct($create.target.user.userid)
    $creation_actions = array_distinct($create.metadata.product_event_type)
    $permission_actions = array_distinct($perm.metadata.product_event_type)
    $permission_targets = array_distinct($perm.target.resource.name)
    $source_ips = array_distinct($create.principal.ip)
    $first_seen = min($create.metadata.event_timestamp.seconds)
    $last_seen = max($perm.metadata.event_timestamp.seconds)

  condition:
    $create and $perm
}
