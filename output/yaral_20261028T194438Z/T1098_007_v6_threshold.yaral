/*
  MITRE Technique : T1098.007 - Additional Local or Domain Groups
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:51:45.157193+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_007_Bulk_Privileged_Group_Membership_Additions {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects one account adding members to several privileged local or domain groups (administrators, remote desktop, backup operators, domain admins, VPN groups and similar) within ten minutes. A single group change is routine administration. A burst from one actor is characteristic of persistence or privilege escalation through group membership. Detection is based on normalised group-modification events (Windows Security group membership change events) rather than process command lines, so it also covers changes made through GUI tools, PowerShell cmdlets, LDAP and API calls."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.007"
    mitre_technique_name = "Account Manipulation: Additional Local or Domain Groups"
    log_prerequisites = "Requires Windows Security log group-membership change auditing (Audit Security Group Management and Audit User Account Management) on endpoints and domain controllers, normalised to GROUP_MODIFICATION with principal.user.userid (actor) and target.group.group_display_name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Identity governance and provisioning tools, joiner/mover/leaver automation, helpdesk onboarding of new staff, bulk role changes during migrations, server build and imaging jobs, RMM or deployment tooling that adds a service account to local groups."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and provisioning or automation accounts to %global_allowed_service_accounts. The default threshold is 3 changes in 10 minutes; raise it for tenants with heavy onboarding automation. Extend the group name regex with client-specific privileged or VPN group naming conventions."

  events:
    $grp.metadata.event_type = "GROUP_MODIFICATION"
    $grp.target.group.group_display_name = /(admin|remote desktop|remote management|backup operators|account operators|server operators|print operators|dnsadmins|schema|enterprise|group policy creator|vpn)/ nocase
    $grp.principal.user.userid = $actor
    not $grp.principal.user.userid in %global_allowed_admin_users
    not $grp.principal.user.userid in %global_allowed_service_accounts

  match:
    $actor over 10m

  outcome:
    $risk_score = max(if($grp.target.group.group_display_name = /(administrators|domain admins|enterprise admins|schema admins)/ nocase, 90, 65))
    $mitre_technique_id = array_distinct("T1098.007")
    $primary_entity = array_distinct($grp.principal.user.userid)
    $change_count = count($grp.metadata.id)
    $groups_modified = array_distinct($grp.target.group.group_display_name)
    $members_added = array_distinct($grp.target.user.userid)
    $source_hosts = array_distinct($grp.principal.hostname)

  condition:
    #grp >= 3
}
