/*
  MITRE Technique : T1546.010 - AppInit DLLs
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:13:48.308794+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_010_AppInit_Offline_GUI_Process_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external network connection initiated by a built-in Windows GUI or console-host process that normally makes no outbound connections (for example notepad, calc, mspaint, conhost, ctfmon). A malicious AppInit_DLLs entry is loaded by user32.dll into nearly every GUI process, so an implant can beacon from any of them, including processes that are normally offline. This is a network-side proxy for AppInit DLL implant activity and not proof of the registry change itself. Pair it with endpoint registry detections for the AppInit_DLLs value."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.010"
    mitre_technique_name = "Event Triggered Execution: AppInit DLLs"
    log_prerequisites = "Requires endpoint network telemetry with initiating process path populated (EDR network events or Sysmon Event ID 3) normalised to NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Modern Windows builds of Notepad or Calculator with cloud, update, or AI features; Store app update and telemetry traffic from inbox utilities; proxy-aware software that hooks GUI processes (legitimate AppInit users such as accessibility, screen-reader, or DLP and monitoring agents); remote support tools that inject into user processes."
    tuning_guidance = "Add approved agents to %global_allowed_security_tools, %global_allowed_admin_tools, or %global_allowed_remote_mgmt (matched on the initiating process path). Add known-good vendor destinations to %global_allowed_domains. Edit the process-name regex to match the offline-by-design baseline of each environment. Raise severity when the same host also shows a registry change to the AppInit_DLLs or LoadAppInit_DLLs value."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(notepad|calc|mspaint|wordpad|charmap|winver|osk|magnify|narrator|conhost|ctfmon)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1546.010")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $affected_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
