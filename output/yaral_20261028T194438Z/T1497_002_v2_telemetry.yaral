/*
  MITRE Technique : T1497.002 - User Activity Based Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:03:58.556635+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_002_Win_User_Activity_Artifact_Tampering {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects registry writes to user-activity artifact keys (RecentDocs, RunMRU, TypedPaths, TypedURLs, WordWheelQuery, Open/Save MRU) by a script interpreter, LOLBin or a binary in a user-writable location instead of the shell or a normal application. Malware that checks for signs of real user activity to evade sandboxes can seed or alter these keys to appear to be a lived-in host. It can also modify them to defeat another sandbox-aware implant. The rule detects the resulting registry state change rather than the command line."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1497.002"
    mitre_technique_name = "Virtualization/Sandbox Evasion: User Activity Based Checks"
    log_prerequisites = "Requires Windows endpoint telemetry that records registry value writes with the initiating process (EDR or Sysmon Event ID 12/13 equivalent). Registry auditing of the HKCU Explorer MRU keys must not be filtered out at the collector."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Logon scripts or profile-management tools (roaming profile, user-state migration, VDI profile tools) that write MRU keys. Privacy and cleanup utilities that clear history. Admin scripts pre-populating user profiles. Installers that add recent-document entries from a temp path."
    tuning_guidance = "Add approved profile and migration tooling to %global_allowed_admin_tools and endpoint security agents to %global_allowed_security_tools. If a client uses a logon-script host that legitimately writes these keys, add its parent or process path to %global_allowed_admin_tools. Tighten or widen the registry key regex to suit the environment."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\(RecentDocs|RunMRU|TypedPaths|WordWheelQuery|ComDlg32\\(OpenSavePidlMRU|LastVisitedPidlMRU))|\\Software\\Microsoft\\Internet Explorer\\TypedURLs/ nocase
    (
      $reg.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|cmd|reg|regedit)\.exe$/ nocase or
      $reg.principal.process.file.full_path = /\\users\\[^\\]+\\(appdata|downloads|desktop|music|pictures)\\/ nocase or
      $reg.principal.process.file.full_path = /\\(programdata|windows\\temp|temp)\\/ nocase
    )
    not $reg.principal.process.file.full_path = /\\(explorer|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1497.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $user = array_distinct($reg.principal.user.userid)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value = array_distinct($reg.target.registry.registry_value_name)

  condition:
    $reg
}
