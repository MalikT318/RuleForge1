/*
  MITRE Technique : T1546.007 - Netsh Helper DLL
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:09:52.743683+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_007_Netsh_Helper_DLL_Registry_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects multiple registry writes under the Netsh helper DLL registration key (HKLM\\SOFTWARE\\Microsoft\\NetSh) on a single host within ten minutes. Registering a helper DLL makes netsh.exe load arbitrary code every time it runs, giving persistence and possible privilege escalation. This rule is additive to process-creation rules because it relies on registry telemetry and does not depend on netsh.exe command lines."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.007"
    mitre_technique_name = "Event Triggered Execution: Netsh Helper DLL"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events) normalised to UDM REGISTRY_MODIFICATION, with target.registry.registry_key populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers or VPN/network-management agents that register their own netsh helper (for example during install, upgrade or repair), IT deployment tooling, and administrators legitimately extending netsh. Installers often write several values in one session."
    tuning_guidance = "Add approved installers and deployment binaries to %global_allowed_admin_tools, approved EDR/AV agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Raise the condition threshold if a client's VPN or network software repeatedly re-registers helpers. After baselining, consider lowering the threshold to 1 for high-value hosts."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Microsoft\\NetSh(\\|$)/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($reg.metadata.id)
    $mitre_technique_id = array_distinct("T1546.007")
    $primary_entity = array_distinct($host)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $value_names = array_distinct($reg.target.registry.registry_value_name)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 2
}
