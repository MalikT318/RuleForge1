/*
  MITRE Technique : T1564.010 - Process Argument Spoofing
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:28:11.461249+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_010_Unexpected_Parent_Spawns_Shell_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, script interpreter or proxy-execution binary launched by a parent process that should never spawn one (Office applications, web server workers, database services, print spooler). Argument spoofing (PEB command-line overwrite) is typically used by injected or hollowed processes to hide malicious arguments from command-line logging. Because the logged command line cannot be trusted in that case, this rule pivots on process lineage, which the spoofing technique does not alter."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.010"
    mitre_technique_name = "Hide Artifacts: Process Argument Spoofing"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with populated parent and child image paths (EDR, Sysmon Event ID 1, or Security Event 4688 with parent process)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros or add-ins used by legitimate line-of-business workflows that call cmd or PowerShell; web applications that deliberately shell out (for example report generators or IIS-hosted admin panels); SQL Server agent jobs or xp_cmdshell used by DBAs; print drivers or print management software spawning helper scripts; RMM and patching tools that launch via these parents."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts or %global_allowed_admin_tools. Add known automation accounts to %global_allowed_service_accounts. If a specific web or database workload legitimately spawns a shell, scope an exclusion to that parent path through the allowed lists rather than editing the regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|php-cgi|tomcat\d*|sqlservr|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|regsvr32|rundll32|wmic|bitsadmin|certutil)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1564.010")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $logged_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
