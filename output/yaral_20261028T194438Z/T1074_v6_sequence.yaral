/*
  MITRE Technique : T1074 - Data Staged
  Tactic(s)       : Collection
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:17:24.943468+00:00
  Reference       : https://attack.mitre.org/techniques/T1074
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_Linux_Bulk_Copy_To_Staging_Then_Archive {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a recursive copy of data from sensitive or user-data directories into a world-writable staging location (/tmp, /var/tmp, /dev/shm), followed within 10 minutes on the same host by an archive or compression utility run against that staging location. This is the stage-then-package pattern that precedes exfiltration."
    mitre_tactic = "Collection"
    mitre_technique = "T1074"
    mitre_technique_name = "Data Staged"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to PROCESS_LAUNCH with populated command lines."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup or migration scripts that stage files in /tmp before archiving, software installers or packaging jobs, configuration management runs, developers building releases, and administrators collecting diagnostic bundles (sosreport-style)."
    tuning_guidance = "Add approved backup tooling to %global_allowed_backup_processes, deployment and RMM tooling to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and approved parent shells or hosts to %global_allowed_script_hosts. Extend the source-directory regex for client-specific data locations such as /var/lib/mysql or application data roots."

  events:
    $copy.metadata.event_type = "PROCESS_LAUNCH"
    $copy.target.process.file.full_path = /\/(cp|rsync|mv)$/ nocase
    $copy.target.process.command_line = /(\s-[a-zA-Z]*[raR][a-zA-Z]*\s|\s--(recursive|archive)\b)/ nocase
    $copy.target.process.command_line = /(\/home|\/root|\/etc|\/var\/www|\/var\/lib|\/var\/backups|\/srv|\/opt|\/mnt)\S*\s+.*(\/tmp|\/var\/tmp|\/dev\/shm)(\/|\s|$)/ nocase
    not $copy.principal.process.file.full_path in %global_allowed_backup_processes
    not $copy.principal.process.file.full_path in %global_allowed_admin_tools
    not $copy.principal.process.file.full_path in %global_allowed_script_hosts
    not $copy.principal.user.userid in %global_allowed_service_accounts
    $copy.principal.hostname = $hostname

    $arch.metadata.event_type = "PROCESS_LAUNCH"
    $arch.target.process.file.full_path = /\/(tar|zip|7z|7za|7zr|rar|gzip|bzip2|xz|zstd)$/ nocase
    $arch.target.process.command_line = /(\/tmp|\/var\/tmp|\/dev\/shm)\// nocase
    not $arch.principal.process.file.full_path in %global_allowed_backup_processes
    not $arch.principal.process.file.full_path in %global_allowed_admin_tools
    not $arch.principal.user.userid in %global_allowed_service_accounts
    $arch.principal.hostname = $hostname

    $copy.metadata.event_timestamp.seconds <= $arch.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1074")
    $primary_entity = array_distinct($hostname)
    $users = array_distinct($copy.principal.user.userid)
    $copy_commands = array_distinct($copy.target.process.command_line)
    $archive_commands = array_distinct($arch.target.process.command_line)
    $copy_event_count = count($copy.metadata.id)
    $archive_event_count = count($arch.metadata.id)

  condition:
    $copy and $arch
}
