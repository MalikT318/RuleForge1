/*
  MITRE Technique : T1498 - Network Denial of Service
  Tactic(s)       : Impact
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:09:41.130503+00:00
  Reference       : https://attack.mitre.org/techniques/T1498
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_Outbound_Connection_Flood_Single_Destination {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single internal source (typically a compromised Windows host) opens a very large number of connections to one external destination within ten minutes. This is consistent with the host being used as a participant in a network denial-of-service flood. Each connection is benign on its own; the volume to a single target is the signal."
    mitre_tactic = "Impact"
    mitre_technique = "T1498"
    mitre_technique_name = "Network Denial of Service"
    log_prerequisites = "Requires firewall, proxy or perimeter NETWORK_CONNECTION logs with populated principal.ip and target.ip. The source address must be the pre-NAT internal client address. Windows endpoints must sit behind the logging perimeter."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Backup or replication jobs to cloud storage, software update distribution, CDN or SaaS sync clients, load or synthetic-monitoring tools, authorised stress tests, NAT gateways or proxies that aggregate many clients behind one source address."
    tuning_guidance = "Add authorised scanners and load-test sources to %global_allowed_scanners, and known-good vendor or CDN destinations to %global_allowed_domains. Raise or lower the #net threshold per client based on baseline connection rates. For proxy or NAT egress addresses, exclude the aggregated source address or raise the threshold substantially."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src
    $net.target.ip = $dst
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  match:
    $src, $dst over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1498")
    $primary_entity = array_distinct($src)
    $destination_ips = array_distinct($dst)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 1000
}
