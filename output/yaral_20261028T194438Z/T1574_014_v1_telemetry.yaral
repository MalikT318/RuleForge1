/*
  MITRE Technique : T1574.014 - AppDomainManager
  Tactic(s)       : Stealth, Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:46:37.604058+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_014_AppDomainManager_Env_Registry_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry write that defines the .NET AppDomainManager environment variables (APPDOMAIN_MANAGER_ASM / APPDOMAIN_MANAGER_TYPE) in a persistent user or system environment. Once set, every .NET process started afterwards loads the attacker-named assembly as its AppDomainManager. This is a registry state-change detection and does not depend on command-line logging."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.014"
    mitre_technique_name = "Hijack Execution Flow: AppDomainManager"
    log_prerequisites = "Requires endpoint registry telemetry (EDR registry-write events or Sysmon Event ID 13) normalised to REGISTRY_MODIFICATION with registry key and/or value name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developers or build engineers who debug custom .NET hosting or AppDomainManager implementations, .NET profiling or instrumentation tools that set these variables, and software deployment tooling that configures a managed runtime host."
    tuning_guidance = "Add approved deployment or developer tooling to %global_allowed_admin_tools, and approved administrator accounts to %global_allowed_admin_users. In developer-heavy tenants, scope by host group downstream. Any hit on a non-developer endpoint should be treated as high confidence."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      $reg.target.registry.registry_value_name = /^APPDOMAIN_?MANAGER_(ASM|TYPE)$/ nocase or
      $reg.target.registry.registry_key = /\\Environment\\APPDOMAIN_?MANAGER_(ASM|TYPE)$/ nocase
    )
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1574.014")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_value_names = array_distinct($reg.target.registry.registry_value_name)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
