/*
  MITRE Technique : T1059.004 - Unix Shell
  Tactic(s)       : Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:12:17.960762+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_004_External_Shell_Port_Connection_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single external source makes many connections to interactive shell management ports (SSH/Telnet) within ten minutes. Network devices and embedded Linux/BusyBox systems expose a Unix shell on these ports, so repeated external connections indicate probing or an attempt to obtain remote shell execution. Telnet attempts score higher. This is network-observable coverage that does not rely on process or command-line telemetry."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.004"
    mitre_technique_name = "Command and Scripting Interpreter: Unix Shell"
    log_prerequisites = "Firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs must record permitted and denied inbound connections to management-plane services."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and penetration tests, external MSP or vendor support access over SSH, monitoring or configuration-backup systems connecting from public addresses, and NAT gateways that aggregate many legitimate admins behind one public IP."
    tuning_guidance = "Add approved management and vendor source addresses to %global_allowed_mgmt_sources and scanner addresses to %global_allowed_scanners. Raise the #net threshold in noisy environments. Consider also blocking inbound Telnet at the perimeter, which makes any Telnet hit significant."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 22 or $net.target.port = 23)
    $net.principal.ip = $src
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src over 10m

  outcome:
    $risk_score = max(if($net.target.port = 23, 85, 65))
    $mitre_technique_id = array_distinct("T1059.004")
    $primary_entity = array_distinct($src)
    $connection_count = count($net.metadata.id)
    $targeted_devices = array_distinct($net.target.ip)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    #net >= 10
}
