/*
  MITRE Technique : T1059.010 - AutoHotKey & AutoIT
  Tactic(s)       : Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:21:36.741155+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_010_AutoIT_AHK_Script_Dropped_By_Delivery_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of an AutoHotkey (.ahk) or AutoIt (.au3/.a3x) script file in a user-writable location by a process commonly involved in payload delivery (browser, mail client, Office, archiver, script host, download utility). This is file-creation coverage that complements command-line detection of the interpreter. The technique is Windows-only, so the rule targets Windows rather than another platform."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.010"
    mitre_technique_name = "Command and Scripting Interpreter: AutoHotKey & AutoIT"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent) populating principal.process.file.full_path and target.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Power users, developers and IT staff who download or extract legitimate AutoHotkey or AutoIt automation scripts; software packages that bundle .au3 or .ahk helper scripts; internal automation distributed via archives or script hosts."
    tuning_guidance = "Add approved deployment or automation tooling to %global_allowed_admin_tools, approved script-authoring hosts to %global_allowed_script_hosts, and named automation administrators to %global_allowed_admin_users. Add EDR or AV agents to %global_allowed_security_tools if they write quarantine copies of scripts."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(ahk|au3|a3x)$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|windows\\temp|programdata|users\\public)\\/ nocase
    $file.principal.process.file.full_path = /\\(chrome|msedge|firefox|brave|opera|outlook|thunderbird|winword|excel|powerpnt|7zfm|7zg|winrar|explorer|powershell|pwsh|cmd|wscript|cscript|mshta|curl|bitsadmin)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1059.010")
    $primary_entity = array_distinct($file.principal.hostname)
    $script_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
