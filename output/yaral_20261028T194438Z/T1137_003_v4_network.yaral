/*
  MITRE Technique : T1137.003 - Outlook Forms
  Tactic(s)       : Persistence
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:17:45.047604+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_003_Outlook_Spawned_Interpreter_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external network connection made by a script interpreter or living-off-the-land binary whose parent process is Outlook. A malicious Outlook form (for example one planted with a mailbox-rules/forms tool) runs its VBScript inside Outlook, which then spawns a helper process that reaches out to the internet for a payload or C2. This rule observes the network side of that behaviour and is independent of process-creation command-line rules."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.003"
    mitre_technique_name = "Office Application Startup: Outlook Forms"
    log_prerequisites = "Requires endpoint network telemetry (EDR or Sysmon Event ID 3) that populates the initiating process and its parent process path on NETWORK_CONNECTION events. Without parent process data the rule will not fire."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Outlook add-ins or COM integrations (CRM, ticketing, e-signature, archiving) that launch helper processes and contact vendor cloud services; RMM or deployment scripts triggered from Outlook; admin macros that call web APIs."
    tuning_guidance = "Add approved helper binaries to %global_allowed_admin_tools and sanctioned vendor domains to %global_allowed_domains. Ensure %rfc1918_internal is populated for the client. Add known add-in hosts to %global_allowed_script_hosts if needed. For clients with heavy Outlook add-in use, narrow the interpreter list to wscript, cscript, mshta and powershell."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.parent_process.file.full_path = /\\outlook\.exe$/ nocase
    $net.principal.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.parent_process.file.full_path in %global_allowed_script_hosts
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1137.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $user = array_distinct($net.principal.user.userid)
    $child_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
