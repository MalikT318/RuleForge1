/*
  MITRE Technique : T1518 - Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:36:26.262247+00:00
  Reference       : https://attack.mitre.org/techniques/T1518
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_Software_Inventory_Output_File_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a scripting or command interpreter writing a software or security-product inventory output file (installed software, programs, AV products, inventory) into a user-writable staging location. This is the file artifact left by software discovery, so it fires even when command-line logging is evaded or obfuscated."
    mitre_tactic = "Discovery"
    mitre_technique = "T1518"
    mitre_technique_name = "Software Discovery"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating principal.process.file.full_path and target.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT asset-inventory and license-audit scripts, RMM and patching agents exporting software lists, helpdesk staff running diagnostics, software deployment tooling writing install logs."
    tuning_guidance = "Add approved inventory and RMM binaries to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, authorised admin accounts to %global_allowed_admin_users, and approved scripting hosts to %global_allowed_script_hosts. Narrow the staging directory or file-name keywords if a client uses a standard inventory export name."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|wmic|reg|mshta|powershell_ise)\.exe$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\appdata\\local\\temp|users\\public|programdata|windows\\temp|perflogs)\\([^\\]+\\)*[^\\]*(installed[_\-\s]?(software|programs|apps)|software[_\-\s]?(list|inventory)|program[_\-\s]?list|app[_\-\s]?list|inventory|av[_\-\s]?(list|products)|antivirus|security[_\-\s]?products)[^\\]*\.(txt|csv|log|json|xml|html?|dat)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1518")
    $primary_entity = array_distinct($file.principal.hostname)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $output_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
