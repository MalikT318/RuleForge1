/*
  MITRE Technique : T1542.005 - TFTP Boot
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:50:13.341532+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_005_External_TFTP_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a UDP connection to TFTP (port 69) with an external, non-allowlisted destination, as seen at the network perimeter. Legitimate netbooting and image or config transfers use TFTP from a central server inside the management network. A TFTP session leaving the environment suggests a device was reconfigured to netboot from an attacker-controlled server, or is staging or exfiltrating images and configs."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.005"
    mitre_technique_name = "Pre-OS Boot: TFTP Boot"
    log_prerequisites = "Firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with destination IP, destination port and protocol populated. TFTP traffic must be permitted or logged at the egress boundary."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Vendor-hosted or managed-service TFTP/PXE servers; branch devices pulling approved images or configs from a central provider; lab and staging networks; misconfigured devices using a public TFTP server for backups."
    tuning_guidance = "Add approved external TFTP server addresses to %global_allowed_mgmt_sources. Confirm %rfc1918_internal covers the client's private address space. If the client permits no external TFTP, raise severity to Critical. Triage by checking the source device for recent boot-system or config changes."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    $net.network.ip_protocol = "UDP"
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1542.005")
    $primary_entity = array_distinct($net.principal.ip)
    $source_hostname = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
