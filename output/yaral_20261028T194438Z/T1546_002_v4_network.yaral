/*
  MITRE Technique : T1546.002 - Screensaver
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:02:50.112147+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_002_Screensaver_Binary_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process whose executable has a .scr (screensaver) extension making an outbound connection to a non-internal address. Legitimate screensavers are local display programs and almost never initiate external network traffic. Outbound traffic from a .scr image indicates a malicious PE registered as the screensaver (SCRNSAVE.EXE persistence) beaconing, staging payloads or exfiltrating data after user inactivity."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.002"
    mitre_technique_name = "Event Triggered Execution: Screensaver"
    log_prerequisites = "Requires Windows endpoint network telemetry that records the originating process image path (EDR network events or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Third-party or corporate-branded screensavers that fetch content (weather, news, photo feeds, digital signage); software licensing or telemetry check-ins from commercial screensaver products; kiosk or signage hosts that deliberately run a networked .scr; vendor-supplied .scr files used as installers or launchers."
    tuning_guidance = "Add approved networked screensaver or signage binaries to %global_allowed_admin_tools, and known-good content or vendor domains to %global_allowed_domains. If kiosk or signage hosts generate noise, scope them out through your SOAR playbook or a client-specific copy of the rule rather than hardcoding hostnames here."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\.scr$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1546.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $screensaver_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
