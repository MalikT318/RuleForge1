/*
  MITRE Technique : T1543.003 - Windows Service
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:56:11.526415+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_003_Service_Spawned_Binary_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound connection to an external address by a process that was launched by the Service Control Manager (services.exe) and runs from a user-writable or staging directory. Legitimate Windows services run from System32 or Program Files. A service binary in a writable path that beacons out indicates a malicious or attacker-modified service used for persistence or C2. This is the network-side view of T1543.003 and complements endpoint process and command-line rules."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.003"
    mitre_technique_name = "Create or Modify System Process: Windows Service"
    log_prerequisites = "Requires endpoint network telemetry (EDR or Sysmon Event ID 3) with principal process path and parent process path populated on NETWORK_CONNECTION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Third-party software services installed to ProgramData or AppData (updaters, collaboration or sync agents, some VPN and RMM agents, per-user installers registered as services), and developer or test services running from temp directories."
    tuning_guidance = "Add approved service binaries to %global_allowed_admin_tools, %global_allowed_remote_mgmt or %global_allowed_security_tools. Add trusted destination domains to %global_allowed_domains if the target hostname is populated. If the parent process path is not populated by the EDR, this rule will not fire for that client."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.parent_process.file.full_path = /\\services\.exe$/ nocase
    $net.principal.process.file.full_path = /\\(temp|users\\public|programdata|perflogs|\$recycle\.bin|users\\[^\\]+\\appdata|windows\\debug|windows\\tasks)\\/ nocase
    $net.principal.process.file.full_path = /\.exe$/ nocase
    not $net.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|NisSrv)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1543.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $service_binary = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
