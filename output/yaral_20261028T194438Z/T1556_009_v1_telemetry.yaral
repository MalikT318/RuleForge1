/*
  MITRE Technique : T1556.009 - Conditional Access Policies
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:27:00.746005+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_009_IdP_Conditional_Access_Policy_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change (update, deactivation or deletion) to an identity provider conditional access or sign-on policy by an account that is not an approved administrator or automation identity. Adversaries weaken these policies to remove MFA requirements, add trusted locations or exclude accounts, which gives persistent access to compromised identities. The rule works at the directory audit configuration-change layer, not on process or command-line telemetry."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.009"
    mitre_technique_name = "Modify Authentication Process: Conditional Access Policies"
    log_prerequisites = "Requires identity provider directory/admin audit logs normalised to UDM SETTING_MODIFICATION with metadata.product_event_type and principal.user.userid populated."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Planned policy changes by identity or security engineering teams, change-window rollouts of new MFA or location rules, infrastructure-as-code pipelines applying policy, onboarding of new trusted network locations, and emergency break-glass adjustments during an incident."
    tuning_guidance = "Add approved identity administrators to %global_allowed_admin_users and policy-automation or IaC identities to %global_allowed_service_accounts. Review the product_event_type values seen at each client and tighten or extend the regex. If non-access policies such as password policies generate noise, extend the regex with a target.resource.name filter for that tenant."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(conditional.?access|sign.?on.?polic|access.?polic|policy\.rule\.(update|deactivate|delete)|policy\.lifecycle\.(update|deactivate|delete))/ nocase
    not $setting.metadata.product_event_type = /(create|add)/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1556.009")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $event_names = array_distinct($setting.metadata.product_event_type)
    $changed_resource = array_distinct($setting.target.resource.name)
    $source_ips = array_distinct($setting.principal.ip)

  condition:
    $setting
}
