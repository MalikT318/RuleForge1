/*
  MITRE Technique : T1098.001 - Additional Cloud Credentials
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:40:59.514518+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_001_Cloud_Credential_Resource_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the control-plane state change that results from adding new credentials to a cloud identity or compute environment: creation of programmatic access keys, SSH key pairs, imported public keys, service account keys, or service principal secrets and certificates. Adversaries add these credentials to keep access after the original compromised session or password is revoked. The rule works on the resulting audit-log resource creation, so it fires regardless of the client tool used (console, CLI, SDK, or PowerShell module) and does not depend on command-line logging."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.001"
    mitre_technique_name = "Account Manipulation: Additional Cloud Credentials"
    log_prerequisites = "Cloud control-plane audit logging enabled for management/IAM write events and ingested into Chronicle with metadata.product_event_type populated by the parser. Identity-provider audit events for service principal credential changes must be normalised to RESOURCE_CREATION."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate onboarding of developers or automation, scheduled access key rotation, CI/CD pipelines or infrastructure-as-code creating service account keys, administrators provisioning SSH key pairs for new instances, and break-glass account preparation."
    tuning_guidance = "Add automation and key-rotation identities to %global_allowed_service_accounts, approved IAM administrators to %global_allowed_admin_users, and approved identity or pipeline principals to %global_allowed_cloud_principals. If the parser maps credential changes to a different event type (for example SETTING_MODIFICATION), deploy a sibling rule with that event type. Raise severity when the principal is a root or owner-level identity or when the source IP is not in a known management range."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /(CreateAccessKey|CreateKeyPair|ImportKeyPair|CreateServiceAccountKey|UploadServiceAccountKey|CreateLoginProfile|Add service principal credentials|Add service principal|Update application . Certificates and secrets management|AddPasswordCredential|AddKeyCredential)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1098.001")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_calls = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)
    $target_resources = array_distinct($cloud.target.resource.name)

  condition:
    $cloud
}
