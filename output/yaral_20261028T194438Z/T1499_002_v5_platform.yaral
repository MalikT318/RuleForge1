/*
  MITRE Technique : T1499.002 - Service Exhaustion Flood
  Tactic(s)       : Impact
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:19:38.416931+00:00
  Reference       : https://attack.mitre.org/techniques/T1499/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1499_002_Inbound_HTTP_Request_Flood_Single_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects an HTTP request flood: one external source sends a very high volume of HTTP requests to a single internal web service within one minute. Fires on perimeter proxy or firewall HTTP telemetry rather than endpoint process creation, so it is additive to command-line rules. A flood is a volume behaviour that one event cannot show, so this is a Threshold rule with a single event variable, not a strict Single-Event rule. The detection is network-observable and independent of the victim server's OS; platform is set to Windows per the requested target (Windows-hosted web services)."
    mitre_tactic = "Impact"
    mitre_technique = "T1499.002"
    mitre_technique_name = "Endpoint Denial of Service: Service Exhaustion Flood"
    log_prerequisites = "Requires firewall, reverse-proxy or WAF logs that populate NETWORK_HTTP with principal.ip, target.ip and network.http.method. Logging must cover inbound traffic to internal web services."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Load tests and vulnerability scanners not yet allow-listed, uptime or health-check monitors polling aggressively, CDN or upstream proxy egress nodes that aggregate many users behind one IP, API integrations or partner batch jobs, web crawlers, and NAT gateways that make many users appear as one source."
    tuning_guidance = "Add authorised scanners and monitoring sources to %global_allowed_scanners. Adjust the request threshold (#http >= 500 per 1m) to the baseline of each client's busiest services; lower it for small sites and raise it for high-traffic APIs. If a CDN or upstream proxy fronts the service, log the true client address, or the CDN egress IPs will need allow-listing."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(GET|POST|HEAD|PUT|OPTIONS)$/ nocase
    not $http.principal.ip in %rfc1918_internal
    $http.target.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    $http.principal.ip = $src_ip
    $http.target.ip = $dst_ip

  match:
    $src_ip, $dst_ip over 1m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1499.002")
    $primary_entity = array_distinct($http.principal.ip)
    $request_count = count($http.metadata.id)
    $targeted_hosts = array_distinct($http.target.hostname)
    $targeted_ports = array_distinct($http.target.port)

  condition:
    #http >= 500
}
