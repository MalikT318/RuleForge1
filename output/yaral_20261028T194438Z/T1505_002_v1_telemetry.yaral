/*
  MITRE Technique : T1505.002 - Transport Agent
  Tactic(s)       : Persistence
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:27:33.105800+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_002_Linux_MTA_Config_Hook_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of Linux mail transfer agent (MTA) configuration files that control mail-pipeline hooks (Postfix master.cf/main.cf, header and body check maps, transport maps, Sendmail .cf/.mc, Exim configuration, and /etc/aliases). Attackers can add content filters, milters, pipe aliases or transport rules to run their own code on in-transit mail. This is the Linux analogue of registering a malicious Exchange transport agent. Detection is at the file-state layer and does not depend on command-line logging."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.002"
    mitre_technique_name = "Server Software Component: Transport Agent"
    log_prerequisites = "Linux EDR file telemetry or auditd file-watch rules (-w /etc/postfix -p wa, -w /etc/mail -p wa, -w /etc/exim4 -p wa, -w /etc/aliases -p wa) normalised to UDM FILE_MODIFICATION with principal.process populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate mail administrators editing Postfix, Sendmail or Exim configuration; configuration management runs (Ansible, Puppet, Chef, Salt) pushing mail settings; package upgrades rewriting default configs; mail-security gateway or antispam installers adding content filters or milters; first-time mail relay setup on new servers."
    tuning_guidance = "Add configuration management and deployment binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Add named mail administrators to the allowlist via %global_allowed_service_accounts. Enrich with change-ticket data for planned mail changes. Treat modifications made by shells, scripting interpreters, or from /tmp or /dev/shm parent processes as high priority."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/(postfix\/(master\.cf|main\.cf|header_checks|body_checks|transport|[^\/]*filter[^\/]*)|mail\/(sendmail|submit)\.(cf|mc)|exim4?\/(exim4?\.conf[^\/]*|conf\.d\/.+)|aliases)$/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|yum|dnf|rpm|zypper|unattended-upgrade)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1505.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $actor_process = array_distinct($file.principal.process.file.full_path)
    $actor_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
