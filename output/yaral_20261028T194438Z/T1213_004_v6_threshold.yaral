/*
  MITRE Technique : T1213.004 - Customer Relationship Management Software
  Tactic(s)       : Collection
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:28:37.813873+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_004_CRM_Excessive_Application_Access_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single user generates an abnormal volume of successful sign-in or token-grant events to a customer relationship management application within ten minutes. Individual CRM sign-ins are benign, but repeated session or token issuance at this rate suggests scripted or tool-driven access, such as stolen session tokens or an automated client mining customer records."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.004"
    mitre_technique_name = "Data from Information Repositories: Customer Relationship Management Software"
    log_prerequisites = "Requires identity provider sign-in or application-assignment audit logs normalised to USER_LOGIN with target.application populated with the application display name. The rule only matches applications whose display name contains 'CRM' or 'customer relationship'. Clients with differently named CRM applications should extend the regex."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Users with unstable sessions or frequent re-authentication, browser extensions or desktop sync clients refreshing tokens, sales or support staff on shared kiosks, integration or automation accounts not yet in the service account list, and load or health testing from authorised scanners."
    tuning_guidance = "Add integration and automation accounts to %global_allowed_service_accounts. Add named administrators to %global_allowed_admin_users. Add approved cloud principals to %global_allowed_cloud_principals. Raise the #auth threshold for tenants with chatty token refresh behaviour. Extend the application name regex to cover client-specific CRM display names."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.application = /(crm|customer[ _-]?relationship)/ nocase
    $auth.principal.user.userid = $user
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users
    not $auth.principal.user.userid in %global_allowed_cloud_principals

  match:
    $user over 10m

  outcome:
    $event_count = count($auth.metadata.id)
    $risk_score = max(if($event_count >= 40, 85, if($event_count >= 20, 70, 50)))
    $mitre_technique_id = array_distinct("T1213.004")
    $primary_entity = array_distinct($user)
    $applications = array_distinct($auth.target.application)
    $source_ips = array_distinct($auth.principal.ip)

  condition:
    #auth >= 10
}
