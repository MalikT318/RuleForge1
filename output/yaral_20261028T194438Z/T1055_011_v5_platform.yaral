/*
  MITRE Technique : T1055.011 - Extra Window Memory Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:58:28.197840+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_011_EWM_Injection_Into_Shell_GUI_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a cross-process injection event (remote memory write or thread/APC execution) from a non-system, non-security process into a long-lived GUI shell process such as explorer.exe. Extra Window Memory (EWM) injection typically targets these processes because they own windows and window classes. This rule uses process injection telemetry rather than command lines, so it is additive to process-creation detections. EWM injection is Windows-specific, so this rule covers the Windows injection event only."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.011"
    mitre_technique_name = "Process Injection: Extra Window Memory Injection"
    log_prerequisites = "Requires endpoint telemetry that emits cross-process memory write, remote thread or APC events normalised to PROCESS_INJECTION, with principal and target process paths populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Accessibility and screen-reader software, input method editors, UI automation and screen-sharing tools, application compatibility shims, third-party shell extensions, DLP and EDR agents not yet in the allowlists, and software deployment tools."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools, UI automation and IT tooling to %global_allowed_admin_tools, and imaging software to %global_allowed_backup_processes. If the shell-process regex is too noisy, narrow it to explorer.exe only. Review how the EDR populates the principal process path before deployment."

  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.target.process.file.full_path = /\\(explorer|sihost|ctfmon|taskhostw|ShellExperienceHost|StartMenuExperienceHost)\.exe$/ nocase
    $inj.principal.process.file.full_path != ""
    not $inj.principal.process.file.full_path = /\\(explorer|csrss|winlogon|wininit|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1055.011")
    $primary_entity = array_distinct($inj.principal.hostname)
    $injecting_process = array_distinct($inj.principal.process.file.full_path)
    $injected_process = array_distinct($inj.target.process.file.full_path)
    $acting_user = array_distinct($inj.principal.user.userid)

  condition:
    $inj
}
