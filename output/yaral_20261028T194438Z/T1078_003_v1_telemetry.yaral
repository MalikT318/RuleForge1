/*
  MITRE Technique : T1078.003 - Local Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:32:23.427677+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_003_Local_Account_Added_To_Privileged_Local_Group {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a membership change that adds an account to a privileged built-in local group (Administrators, Remote Desktop Users, Remote Management Users, Backup Operators) on a Windows host. The rule works from the resulting directory and group-state change rather than command lines, so it still fires if process logging is evaded. Attackers who obtain or create local accounts commonly add them to these groups to keep persistent, elevated or remote access."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.003"
    mitre_technique_name = "Valid Accounts: Local Accounts"
    log_prerequisites = "Requires normalised group-membership audit events (for example Windows Security 4732 collected from member servers and workstations) mapped to GROUP_MODIFICATION with target.group.group_display_name, target.hostname and principal.user.userid populated."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Help-desk or IT staff granting local admin or RDP rights, imaging and provisioning workflows, endpoint management and privileged access tooling, and automated onboarding that adds a break-glass or support account to local Administrators."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and automation or provisioning accounts to %global_allowed_service_accounts. If a client uses its own naming for these groups, adjust the group name regex. Raise severity for servers and domain controllers if asset context is available."

  events:
    $grp.metadata.event_type = "GROUP_MODIFICATION"
    $grp.target.group.group_display_name = /^(administrators|remote desktop users|remote management users|backup operators)$/ nocase
    $grp.target.hostname != ""
    $grp.principal.user.userid != ""
    not $grp.principal.user.userid = /\$$/
    not $grp.principal.user.userid in %global_allowed_admin_users
    not $grp.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1078.003")
    $primary_entity = array_distinct(strings.coalesce($grp.target.hostname, $grp.principal.hostname))
    $actor = array_distinct($grp.principal.user.userid)
    $added_member = array_distinct($grp.target.user.userid)
    $group_name = array_distinct($grp.target.group.group_display_name)

  condition:
    $grp
}
