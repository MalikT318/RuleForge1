/*
  MITRE Technique : T1007 - System Service Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:13:56.765952+00:00
  Reference       : https://attack.mitre.org/techniques/T1007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1007_Windows_Service_Enumeration_Utilities {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects built-in Windows utilities launched with the arguments that enumerate registered services: sc query/queryex without a specific service name (or with type/state filters), tasklist /svc, net start with no arguments, and wmic service list/get. The match is on the combination of binary and enumeration flags, so renamed attacker tooling that wraps these utilities is still caught."
    mitre_tactic = "Discovery"
    mitre_technique = "T1007"
    mitre_technique_name = "System Service Discovery"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with full command lines (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT inventory and RMM health checks, software installers and patching scripts that check service state, helpdesk staff troubleshooting, vulnerability and compliance scanners, and EDR or AV agents that inventory services."
    tuning_guidance = "Add approved parent tooling to %global_allowed_admin_tools, security agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. If a deployment script is noisy, add its parent to %global_allowed_script_hosts. Consider raising severity when the parent is an Office application, script interpreter, or a process in a user-writable path."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $proc.target.process.file.full_path = /\\sc\.exe$/ nocase and
        $proc.target.process.command_line = /\bquery(ex)?("|\s)*($|\s(type|state|group|bufsize|ri)\s*=)/ nocase
      ) or
      (
        $proc.target.process.file.full_path = /\\tasklist\.exe$/ nocase and
        $proc.target.process.command_line = /\s[\/-]svc\b/ nocase
      ) or
      (
        $proc.target.process.file.full_path = /\\net1?\.exe$/ nocase and
        $proc.target.process.command_line = /\bstart"?\s*$/ nocase
      ) or
      (
        $proc.target.process.file.full_path = /\\wmic\.exe$/ nocase and
        $proc.target.process.command_line = /\bservice\s+(list|get)\b/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1007")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
