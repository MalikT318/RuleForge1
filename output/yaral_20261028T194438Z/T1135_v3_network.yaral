/*
  MITRE Technique : T1135 - Network Share Discovery
  Tactic(s)       : Discovery
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:04:13.898786+00:00
  Reference       : https://attack.mitre.org/techniques/T1135
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1135_Outbound_SMB_To_External_Network_Share_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host opening an SMB (TCP 445) or NetBIOS session service (TCP 139) connection to a non-internal destination, as seen at the network perimeter. Legitimate SMB is normally confined to internal address space. Outbound SMB to external addresses indicates share enumeration or access against remote systems, misconfigured or compromised hosts, or credential-harvesting attempts."
    mitre_tactic = "Discovery"
    mitre_technique = "T1135"
    mitre_technique_name = "Network Share Discovery"
    log_prerequisites = "Requires firewall, proxy or perimeter flow logs normalised to NETWORK_CONNECTION with populated principal.ip, target.ip and target.port. Only traffic that crosses the perimeter is visible, so internal-to-internal share discovery is out of scope for this rule."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Approved cloud file services reachable over SMB (for example Azure Files over port 445), site-to-site or VPN-tunnelled branch file shares with public addressing, authorised vulnerability scanners and penetration tests, and hosts in segments whose internal ranges are missing from the internal address list."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners. Make sure %rfc1918_internal covers the client's private address space. Add approved management sources to %global_allowed_mgmt_sources. Raise severity for client servers that have no business reason to initiate outbound SMB."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 445 or $net.target.port = 139)
    $net.principal.ip in %rfc1918_internal
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1135")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
