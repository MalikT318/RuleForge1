/*
  MITRE Technique : T1087.002 - Domain Account
  Tactic(s)       : Discovery
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:55:35.284389+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_002_Linux_Excessive_LDAP_Queries_From_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a single Linux host opening many LDAP/LDAPS/Global Catalog connections within ten minutes from a process that is not a known directory-integration daemon. Each connection is benign on its own, but repeated directory binds from an interactive tool or script indicate domain user and group enumeration. This is network-based and complements process command-line detections."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.002"
    mitre_technique_name = "Account Discovery: Domain Account"
    log_prerequisites = "Requires Linux endpoint network telemetry (EDR or auditd socket/connect events) normalised to NETWORK_CONNECTION with principal.process.file.full_path and target.port populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Identity-integration daemons not covered by the default process exclusion (custom sssd/nslcd builds, realm join tooling), configuration management and inventory agents querying AD, application servers doing LDAP authentication, admin troubleshooting of AD joins, vulnerability scanners."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools, %global_allowed_security_tools or %global_allowed_scanners, and automation accounts to %global_allowed_service_accounts. Raise the #net threshold on hosts that proxy LDAP authentication, such as bastions, web servers and file servers. Extend the process-name exclusion regex for any local directory-integration daemons."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 389 or
      $net.target.port = 636 or
      $net.target.port = 3268 or
      $net.target.port = 3269
    )
    $net.principal.hostname = $host
    not $net.principal.process.file.full_path = /\/(sssd|sssd_be|sssd_nss|sssd_pam|nslcd|nscd|winbindd|slapd|smbd|oddjobd|realmd|adcli)$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.hostname in %global_allowed_scanners

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($net.target.port = 3268 or $net.target.port = 3269, 70, 55))
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1087.002")
    $primary_entity = array_distinct($host)
    $source_users = array_distinct($net.principal.user.userid)
    $source_processes = array_distinct($net.principal.process.file.full_path)
    $directory_servers = array_distinct($net.target.ip)
    $ldap_ports = array_distinct($net.target.port)

  condition:
    #net >= 10
}
