/*
  MITRE Technique : T1055.015 - ListPlanting
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:04:22.752844+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_015_ListPlanting_ProcessOpen_ListView_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process running from a user-writable location that requests a handle to a process commonly hosting a SysListView32 list-view control (for example the shell, registry editor, task manager or management console). ListPlanting needs a handle with memory-write and thread-level access to the victim before it copies code in and triggers it through a list-view sort callback. This rule detects the handle request at the PROCESS_OPEN layer, not the command line."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.015"
    mitre_technique_name = "Process Injection: ListPlanting"
    log_prerequisites = "Requires endpoint telemetry that records process-handle requests (Sysmon Event ID 10 equivalent or EDR cross-process open events) normalised to PROCESS_OPEN with principal and target process paths populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-user installed software (collaboration clients, browsers, updaters) that legitimately interacts with the shell. Accessibility and screen-reader tools. Unapproved UI automation or test frameworks. Developer debuggers run from user profile paths. Third-party security agents installed under the user profile or ProgramData that are missing from the allowlists."
    tuning_guidance = "Add EDR/AV agents to %global_allowed_security_tools, approved IT tooling to %global_allowed_admin_tools, and imaging/backup agents to %global_allowed_backup_processes. Extend or narrow the target process regex to match the client's environment. If the telemetry source exposes a granted-access field, add a filter for memory-write and thread-access rights to raise fidelity."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\(explorer|regedit|taskmgr|mmc|control|dllhost)\.exe$/ nocase
    $open.principal.process.file.full_path = /\\(users|programdata|temp|perflogs|appdata)\\.*\.exe$/ nocase
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    not $open.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|csrss|lsass|services|svchost|wininit|winlogon)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1055.015")
    $primary_entity = array_distinct($open.principal.hostname)
    $source_process = array_distinct($open.principal.process.file.full_path)
    $victim_process = array_distinct($open.target.process.file.full_path)
    $acting_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
