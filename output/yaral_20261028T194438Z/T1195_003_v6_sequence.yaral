/*
  MITRE Technique : T1195.003 - Compromise Hardware Supply Chain
  Tactic(s)       : Initial Access
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:45:31.158089+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_003_New_USB_HID_Device_Then_Hidden_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a new USB or HID device enumeration key created on a host, followed within 10 minutes by an interactive-shell-parented script interpreter running a hidden-window, encoded or download-style command. This is the behavioural signature of a tampered or implanted peripheral (rogue HID or keystroke-injection device) delivering a payload. Software cannot inspect hardware provenance directly, so the rule detects the result of the implant acting on the host."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.003"
    mitre_technique_name = "Supply Chain Compromise: Compromise Hardware Supply Chain"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry covering HKLM\\SYSTEM\\CurrentControlSet\\Enum (registry key creation events) and process launch telemetry with command lines (EDR or Windows Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate new peripherals (keyboards, docks, security tokens) plugged in shortly before a user or helpdesk runs a hidden or encoded PowerShell command; IT provisioning and imaging of new workstations; kiosk or lab machines with frequent USB device changes; admins launching scripts from the Run dialog."
    tuning_guidance = "Add approved deployment and provisioning tooling to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Add approved script-launching parents to %global_allowed_script_hosts. Exclude provisioning or imaging hosts at the client level. Narrow or widen the command-line regex if the client uses legitimate hidden-window scripts."

  events:
    $reg.metadata.event_type = "REGISTRY_CREATION"
    $reg.target.registry.registry_key = /\\CurrentControlSet\\Enum\\(USB|HID)\\/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    $reg.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\explorer\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(-|\/)(w|win|window|windowstyle)\s+hidden|(-|\/)(e|ec|enc|encodedcommand)\s+[a-z0-9+\/=]{20,}|downloadstring|downloadfile|invoke-webrequest|invoke-expression|\biex\b|urlcache|https?:\/\//
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    $reg.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1195.003")
    $primary_entity = array_distinct($hostname)
    $device_keys = array_distinct($reg.target.registry.registry_key)
    $shell_commands = array_distinct($proc.target.process.command_line)
    $affected_users = array_distinct($proc.principal.user.userid)

  condition:
    $reg and $proc
}
