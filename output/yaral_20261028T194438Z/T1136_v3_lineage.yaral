/*
  MITRE Technique : T1136 - Create Account
  Tactic(s)       : Persistence
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:06:08.165308+00:00
  Reference       : https://attack.mitre.org/techniques/T1136
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_Linux_Account_Creation_From_Service_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects local account creation or modification (useradd, adduser, usermod, chpasswd, newusers, or a shell invoking them or editing passwd/shadow) launched directly by a web server, application server, database, or print service process. These parents should never manage local accounts, so the lineage suggests post-exploitation such as a webshell or RCE creating a backdoor account."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136"
    mitre_technique_name = "Create Account"
    log_prerequisites = "Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to UDM PROCESS_LAUNCH with populated parent (principal.process) and child (target.process) paths and command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Self-service hosting control panels (e.g. web panels that provision system users), CI/CD or application servers (Jenkins, Tomcat-based tools) that provision service accounts, database packages whose install scripts create a service user, and container build or configuration-management tasks started from a Java or Node process."
    tuning_guidance = "Add approved provisioning parents (control panels, deployment agents) to %global_allowed_admin_tools. Add named administrators who legitimately run these commands to %global_allowed_admin_users. If a parent in the regex is noisy in an environment (for example java in CI servers), scope it with an allowlist entry rather than editing the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|php-cgi|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|cupsd)$/ nocase
    (
      $proc.target.process.file.full_path = /\/(useradd|adduser|usermod|chpasswd|newusers)$/ nocase
      or
      (
        $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ash|ksh)$/ nocase
        and $proc.target.process.command_line = /(useradd|adduser|chpasswd|newusers|\/etc\/(passwd|shadow))/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1136")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
