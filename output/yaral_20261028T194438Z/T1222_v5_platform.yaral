/*
  MITRE Technique : T1222 - File and Directory Permissions Modification
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:16:55.758351+00:00
  Reference       : https://attack.mitre.org/techniques/T1222
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_ESXi_Sensitive_Path_Permission_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects chmod, chown or chgrp on an ESXi host that grants execute or symbolic write/execute permissions, or changes ownership, on paths attackers abuse: temporary directories, datastore volumes, boot-persistence scripts, SSH and host configuration, and boot banks. This pattern is typical of staging an encryptor or backdoor, or tampering with protected host files, before execution."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1222"
    mitre_technique_name = "File and Directory Permissions Modification"
    log_prerequisites = "ESXi shell command auditing (shell.log or syslog forwarding of executed commands) normalized to PROCESS_LAUNCH with target.process.command_line populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators deploying VIBs, patches or custom startup scripts; backup or monitoring agents installing helper binaries in /tmp or datastores; automated host configuration and provisioning tooling; support staff changing ownership during troubleshooting."
    tuning_guidance = "Add approved parent processes or tooling to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Narrow or extend the path regex to match local operations (for example, datastore folders used by deployment tooling)."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /(^|\/)(chmod|chown|chgrp)$/ nocase
    $proc.target.process.command_line = /\s(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/vmfs\/volumes\/|\/etc\/rc\.local\.d\/|\/etc\/init\.d\/|\/etc\/vmware\/|\/etc\/ssh\/|\/bootbank|\/altbootbank|\/etc\/shadow|\/etc\/profile|\/etc\/passwd)/ nocase
    (
      $proc.target.process.command_line = /\s([ugoa]*\+[rwxst]*[xws][rwxst]*|[0-7]?([1357][0-7]{2}|[0-7][1357][0-7]|[0-7]{2}[1357]))\s/ nocase or
      $proc.target.process.file.full_path = /(^|\/)(chown|chgrp)$/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1222")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
