/*
  MITRE Technique : T1548.002 - Bypass User Account Control
  Tactic(s)       : Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:31:53.162043+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_002_UAC_Bypass_Registry_Hijack_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of registry modifications on one host within 10 minutes that either hijack auto-elevating shell handler keys under the per-user Classes hive (the registry staging step of fodhelper/eventvwr-style UAC bypasses) or weaken UAC policy values. A single write can be benign; several in a short window on one host indicate UAC bypass staging or UAC tampering."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.002"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Bypass User Account Control"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event IDs 12/13/14 or equivalent) normalised to REGISTRY_MODIFICATION with target.registry.registry_key populated. Registry value name populated where available."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters registering protocol or file handlers under HKCU\\Software\\Classes, endpoint hardening or GPO tooling changing UAC policy values, RMM and deployment agents, and administrators legitimately reconfiguring UAC."
    tuning_guidance = "Add approved deployment, hardening and RMM binaries to %global_allowed_admin_tools, EDR or AV agents to %global_allowed_security_tools, and automation identities to %global_allowed_service_accounts. Raise the #proc threshold if a client's installers are noisy. Lower it to 2 for high-assurance environments."

  events:
    $proc.metadata.event_type = "REGISTRY_MODIFICATION"
    $proc.principal.hostname = $host
    (
      $proc.target.registry.registry_key = /\\Software\\Classes\\(ms-settings|mscfile|exefile|folder|ms-windows-store|AppX[a-z0-9]+)\\shell\\open\\command/ nocase
      or
      (
        $proc.target.registry.registry_key = /\\Microsoft\\Windows\\CurrentVersion\\Policies\\System$/ nocase
        and $proc.target.registry.registry_value_name = /^(EnableLUA|ConsentPromptBehaviorAdmin|ConsentPromptBehaviorUser|PromptOnSecureDesktop|LocalAccountTokenFilterPolicy|FilterAdministratorToken|EnableInstallerDetection)$/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(75)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1548.002")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $registry_keys = array_distinct($proc.target.registry.registry_key)
    $registry_values = array_distinct($proc.target.registry.registry_value_name)
    $writing_processes = array_distinct($proc.principal.process.file.full_path)

  condition:
    #proc >= 3
}
