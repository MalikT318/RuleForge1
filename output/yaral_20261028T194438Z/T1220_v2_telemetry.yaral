/*
  MITRE Technique : T1220 - XSL Script Processing
  Tactic(s)       : Stealth
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:11:52.037655+00:00
  Reference       : https://attack.mitre.org/techniques/T1220
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1220_XSL_Stylesheet_Dropped_User_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of an XSL/XSLT stylesheet file in a user-writable or staging location (user profile, ProgramData, Windows Temp, Public). Attackers drop stylesheets containing embedded script before running them through a transformation utility or WMI-based XSL processing. This rule works at the file-artifact layer, so it still fires if command-line logging is evaded or the processing binary is renamed."
    mitre_tactic = "Stealth"
    mitre_technique = "T1220"
    mitre_technique_name = "XSL Script Processing"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) that populates target.file.full_path and the principal process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Browsers or email clients saving legitimate XSL/XSLT files; web and XML developers working with stylesheets; software installers or reporting tools that unpack XSL templates into ProgramData or Temp; Office or document-conversion utilities that generate temporary stylesheets; RMM and deployment agents."
    tuning_guidance = "Add approved developer, deployment, or reporting tool binaries to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. Review the dropping process in $dropping_process: Office, browsers, archivers, and script hosts writing stylesheets are the higher-fidelity cases. Because attackers can use arbitrary extensions, pair this rule with a PROCESS_LAUNCH-based variant for full coverage."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.xslt?$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|users\\public|programdata|windows\\temp|temp)\\/ nocase
    not $file.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|TiWorker|TrustedInstaller|msiexec)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1220")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file = array_distinct($file.target.file.full_path)
    $dropping_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
