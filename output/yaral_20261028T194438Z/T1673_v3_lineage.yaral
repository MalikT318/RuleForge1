/*
  MITRE Technique : T1673 - Virtual Machine Discovery
  Tactic(s)       : Discovery
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:16:18.401923+00:00
  Reference       : https://attack.mitre.org/techniques/T1673
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1673_Linux_Unexpected_Parent_VM_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects virtualization enumeration commands (hypervisor or VM management CLIs listing guests) launched directly by, or through a shell spawned from, a web server, application server, database, or print service. Legitimate VM inventory does not originate from these parents, so this lineage anomaly suggests a web shell, injected service, or compromised application discovering VMs on the host before follow-on actions such as service stop or encryption."
    mitre_tactic = "Discovery"
    mitre_technique = "T1673"
    mitre_technique_name = "Virtual Machine Discovery"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records normalised to UDM PROCESS_LAUNCH with populated parent process path, child process path, and command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Self-hosted virtualization management portals or web UIs that call virsh or similar CLIs from a web or application server; cloud or hosting control panels run by a web service account; monitoring plugins run from a database or Java-based agent that list VMs; backup or orchestration jobs spawned by an application server."
    tuning_guidance = "Add approved management or orchestration parent binaries to %global_allowed_admin_tools, approved script-hosting parents to %global_allowed_script_hosts, and named administrator accounts to %global_allowed_admin_users. If the java parent is noisy where hypervisor management software runs on the host, exclude that host's approved parent via the lists above."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|php-cgi|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|cupsd)$/ nocase
    (
      $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ksh|csh|tcsh)$/ nocase or
      $proc.target.process.file.full_path = /\/(virsh|vboxmanage|vim-cmd|esxcli|qm|prlctl|vmrun)$/ nocase
    )
    $proc.target.process.command_line = /(\bvirsh\s+(-\S+\s+\S+\s+)*(list|dominfo|domstate)\b|\bvboxmanage\s+list\s+(runningvms|vms)\b|\bvim-cmd\s+vmsvc\/getallvms\b|\besxcli\s+vm\s+process\s+list\b|\bqm\s+list\b|\bprlctl\s+list\b|\bvmrun\s+(-\S+\s+)*list\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1673")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
