/*
  MITRE Technique : T1529 - System Shutdown/Reboot
  Tactic(s)       : Impact
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:30:10.527950+00:00
  Reference       : https://attack.mitre.org/techniques/T1529
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1529_ESXi_Burst_VM_Power_Off_Or_Host_Shutdown {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of VM power-off, VM process kill, or host shutdown/reboot commands run from the ESXi shell on a single host within 10 minutes. One such command is routine administration. Many in a short window match mass VM termination and host shutdown seen before ransomware encryption or destructive impact."
    mitre_tactic = "Impact"
    mitre_technique = "T1529"
    mitre_technique_name = "System Shutdown/Reboot"
    log_prerequisites = "ESXi shell command auditing forwarded to Chronicle and parsed to PROCESS_LAUNCH with target.process.command_line and principal.hostname populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Planned maintenance windows with scripted VM shutdown before patching or host reboot, automated DR or failover tests, VM decommissioning scripts, and orchestration tooling that powers off many guests."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and approved automation parents to %global_allowed_admin_tools. Raise the #proc threshold for hosts with frequent scripted maintenance, or suppress during change windows. Severity scales through $risk_score in outcome."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(esxcli\s+vm\s+process\s+kill|vim-cmd\s+vmsvc\/power\.(off|shutdown|reset)|esxcli\s+system\s+shutdown|(^|\/|\s)(poweroff|halt|reboot)(\s|$))/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(count($proc.metadata.id) >= 15, 90, 65))
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1529")
    $primary_entity = array_distinct($host)
    $acting_users = array_distinct($proc.principal.user.userid)
    $sample_commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 5
}
