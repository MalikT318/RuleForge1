/*
  MITRE Technique : T1014 - Rootkit
  Tactic(s)       : Stealth
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:26:31.185915+00:00
  Reference       : https://attack.mitre.org/techniques/T1014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1014_Kernel_Driver_Service_ImagePath_UserWritable {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows service ImagePath registry value set to a kernel driver (.sys) located in a user-writable directory such as Temp, AppData, ProgramData or Public. Rootkits commonly register an unsigned or bring-your-own-vulnerable driver as a service to load kernel-mode code and hide processes, files and connections. Legitimate drivers load from the system drivers directory or from signed vendor install locations. Note: the requested alternate-platform angle conflicts with the mandatory Windows platform and windows_endpoint log source, so this rule pivots on the registry service-driver mechanism for Windows instead."
    mitre_tactic = "Stealth"
    mitre_technique = "T1014"
    mitre_technique_name = "Rootkit"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events) with registry key, value name and value data populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers that stage a driver from a temp directory before copying it, hardware vendor driver updaters, developer or driver-testing workstations, anti-cheat and virtualization software that loads drivers from ProgramData, and EDR or security agent installers."
    tuning_guidance = "Add approved installer or updater binaries to %global_allowed_admin_tools and security agents to %global_allowed_security_tools. Add deployment service accounts to %global_allowed_service_accounts. Exclude driver-development hosts through a scoped exception."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\CurrentControlSet\\Services\\[^\\]+/ nocase
    (
      $reg.target.registry.registry_value_name = "ImagePath" nocase or
      $reg.target.registry.registry_key = /\\ImagePath$/ nocase
    )
    $reg.target.registry.registry_value_data = /\.sys\b/ nocase
    $reg.target.registry.registry_value_data = /\\(temp|appdata|programdata|users\\public|perflogs|windows\\temp|windows\\debug)\\/ nocase
    not $reg.target.registry.registry_value_data = /\\system32\\drivers\\[^\\]+\.sys/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1014")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $driver_path = array_distinct($reg.target.registry.registry_value_data)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
