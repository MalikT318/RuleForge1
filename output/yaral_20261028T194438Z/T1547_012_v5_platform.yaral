/*
  MITRE Technique : T1547.012 - Print Processors
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:39:22.420284+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_012_PrintProcessor_DLL_Dropped {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a DLL written into the print spooler's print-processor directory (spool\\prtprocs\\<architecture>) by a process other than trusted servicing components. Malicious print processor DLLs must be staged in this directory before AddPrintProcessor or a registry-based registration can load them into spoolsv.exe as SYSTEM. This is file-system telemetry, so it complements process command-line detections and still fires when the DLL is dropped by an API call or a renamed tool."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.012"
    mitre_technique_name = "Boot or Logon Autostart Execution: Print Processors"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate printer driver or print-management software installs, Windows servicing and patching (TrustedInstaller, TiWorker), RMM or software deployment pushing print solutions, OS upgrades."
    tuning_guidance = "Add approved deployment and print-management tooling to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Add approved deployment accounts to %global_allowed_service_accounts. Review the writing process path and signer for any remaining hits."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\spool\\prtprocs\\[^\\]+\\.+\.dll$/ nocase
    not $file.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.012")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_dll = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
