/*
  MITRE Technique : T1176 - Software Extensions
  Tactic(s)       : Persistence
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:25:11.994338+00:00
  Reference       : https://attack.mitre.org/techniques/T1176
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_Extension_Package_Download_Unapproved_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP request through the network perimeter for a browser or IDE extension package (.crx, .vsix, .xpi) from an external host that is not on the known-good domain list. Malicious extensions are often side-loaded from attacker-controlled hosting rather than the official marketplace. This is a network-side view and uses no endpoint process fields."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176"
    mitre_technique_name = "Software Extensions"
    log_prerequisites = "Requires proxy or firewall logs with URL-level visibility (NETWORK_HTTP) that populate target.url and target.hostname. TLS inspection is needed to see URLs for HTTPS traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Developers and users installing extensions from vendor-hosted or self-hosted download sites, internal tooling teams distributing packages through external CDNs, and enterprise extension deployment from a cloud storage host not yet allowlisted."
    tuning_guidance = "Add legitimate marketplace, vendor, and CDN domains to %global_allowed_domains. Extend %rfc1918_internal if internal mirrors resolve to non-standard ranges. Consider raising severity for server and high-value asset segments, or for hosts that are not developer workstations."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\.(crx|vsix|xpi)(\?.*|#.*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1176")
    $primary_entity = array_distinct($http.principal.hostname)
    $requested_urls = array_distinct($http.target.url)
    $destination_hosts = array_distinct($http.target.hostname)

  condition:
    $http
}
