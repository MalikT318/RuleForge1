/*
  MITRE Technique : T1555.002 - Securityd Memory
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:54:50.429574+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_002_Linux_Keyring_Daemon_Process_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process opening a handle to the memory space of a credential-holding daemon (desktop keyring, wallet or password-manager process) on Linux. This is the Linux equivalent of scanning securityd memory for keychain master keys. Process-access telemetry is used instead of command-line matching, so it still fires when the access comes from a renamed binary, a custom tool or a debugger-style API call."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.002"
    mitre_technique_name = "Credentials from Password Stores: Securityd Memory"
    log_prerequisites = "Requires Linux EDR or auditd (ptrace/process_vm_readv/openat on /proc/<pid>/mem) normalised to PROCESS_OPEN events with principal and target process paths populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Debuggers or profilers run by developers on workstations, crash-dump collectors, EDR and backup agents not yet in the allowlists, and session managers that legitimately interact with the keyring daemon during login."
    tuning_guidance = "Add endpoint security agents to %global_allowed_security_tools, backup agents to %global_allowed_backup_processes, and approved diagnostic tooling to %global_allowed_admin_tools. Add approved automation accounts to %global_allowed_service_accounts. Extend the target regex with other in-house credential-broker daemons if needed."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\/(gnome-keyring-daemon|kwalletd[0-9]*|ksecretd|keepassxc|ssh-agent)$/ nocase
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555.002")
    $primary_entity = array_distinct($open.principal.hostname)
    $accessing_process = array_distinct($open.principal.process.file.full_path)
    $accessed_process = array_distinct($open.target.process.file.full_path)
    $accessing_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
