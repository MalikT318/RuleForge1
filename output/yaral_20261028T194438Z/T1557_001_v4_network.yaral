/*
  MITRE Technique : T1557.001 - Name Resolution Poisoning and SMB Relay
  Tactic(s)       : Credential Access, Collection
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:31:29.177293+00:00
  Reference       : https://attack.mitre.org/techniques/T1557/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1557_001_Name_Resolution_And_SMB_Egress_To_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects internal hosts sending LLMNR, NBT-NS, mDNS, NetBIOS session or SMB traffic to non-internal destinations. These protocols are link-local or LAN-scoped and should not cross the perimeter. Egress of this traffic indicates a victim lured by name-resolution poisoning toward an attacker-controlled or relayed system, or an authentication-coercion attempt that leaks NTLM material."
    mitre_tactic = "Credential Access, Collection"
    mitre_technique = "T1557.001"
    mitre_technique_name = "Adversary-in-the-Middle: LLMNR/NBT-NS Poisoning and SMB Relay"
    log_prerequisites = "Firewall or perimeter logs recording permitted and denied connections with source IP, destination IP and destination port. Visibility of egress from client VLANs or internal segmentation firewalls improves coverage. The perimeter will not see purely intra-segment poisoning."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Misconfigured split-tunnel VPN clients, legacy cloud file shares or hybrid SMB-over-internet (for example SMB over QUIC or Azure Files on 445), vulnerability scanners, authorised penetration tests, and mDNS leakage from guest or BYOD networks."
    tuning_guidance = "Add approved scanner and security-testing source addresses to %global_allowed_scanners. Add approved management or file-gateway source addresses to %global_allowed_mgmt_sources. Populate %rfc1918_internal with the customer's internal space. If SMB to a known cloud storage endpoint is expected, scope it by source host in %global_allowed_mgmt_sources rather than removing port 445."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 137 or
      $net.target.port = 139 or
      $net.target.port = 445 or
      $net.target.port = 5353 or
      $net.target.port = 5355
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1557.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
