/*
  MITRE Technique : T1557.004 - Evil Twin
  Tactic(s)       : Credential Access, Collection
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:35:23.457287+00:00
  Reference       : https://attack.mitre.org/techniques/T1557/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1557_004_EvilTwin_Captive_Portal_Cleartext_Credential_POST {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a cleartext HTTP POST on port 80 to an external destination whose URL combines captive-portal wording (portal, hotspot, splash, wifi) with credential-submission wording (login, auth, password). This is the network-side footprint of an evil twin access point serving a fake captive portal to harvest credentials from clients on the monitored network. It does not depend on SSID, tool name, or destination infrastructure."
    mitre_tactic = "Credential Access, Collection"
    mitre_technique = "T1557.004"
    mitre_technique_name = "Adversary-in-the-Middle: Evil Twin"
    log_prerequisites = "Requires firewall or proxy logs that populate NETWORK_HTTP with network.http.method, target.url, target.port and target.ip. Needs HTTP visibility (proxy, or firewall with URL logging) for traffic from Wi-Fi, guest, or bridged client segments."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate hotel, airport, or guest-Wi-Fi captive portals that use HTTP, third-party guest-Wi-Fi or BYOD onboarding services, legacy internal applications with portal-style login URLs published externally, and security awareness phishing simulations."
    tuning_guidance = "Add known-good portal and vendor domains to %global_allowed_domains. Scope the rule to client or Wi-Fi egress segments where evil twin exposure exists. Review hits for the same client IP across multiple portal-style destinations, and correlate with wireless controller rogue-AP alerts."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST"
    $net.target.port = 80
    $net.target.url = /(captive|hotspot|splash|wifi|wlan|portal)/ nocase
    $net.target.url = /(login|logon|signin|auth|password|credential|verify)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1557.004")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_urls = array_distinct($net.target.url)

  condition:
    $net
}
