/*
  MITRE Technique : T1220 - XSL Script Processing
  Tactic(s)       : Stealth
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:11:39.053485+00:00
  Reference       : https://attack.mitre.org/techniques/T1220
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1220_WMIC_XSL_Format_Script_Processing {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects wmic.exe launched with a /format: switch pointing to an XSL stylesheet, a local or UNC path, or a remote URL instead of a built-in format keyword (list, table, csv, htable). This is the OS mechanism behind the 'Squiblytwo' XSL script processing technique, where JScript or VBScript embedded in the stylesheet runs under a trusted, signed binary and bypasses application control."
    mitre_tactic = "Stealth"
    mitre_technique = "T1220"
    mitre_technique_name = "XSL Script Processing"
    log_prerequisites = "Requires EDR or Sysmon-equivalent process creation telemetry with full command line (Sysmon Event ID 1 or Windows Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or inventory scripts that format WMI output with a custom local XSL stylesheet, legacy reporting scripts, and RMM or asset-inventory tooling that calls wmic with a stylesheet path."
    tuning_guidance = "Add approved inventory or RMM parent processes to %global_allowed_admin_tools and approved script-hosting parents to %global_allowed_script_hosts. If a client legitimately uses custom XSL with wmic, scope an exclusion to the parent process and host rather than loosening the regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\wmic\.exe$/ nocase
    $proc.target.process.command_line = /[\/\-]format\s*:\s*["']?[^\s"']*(\.xsl\b|https?:\/\/|\\\\|[a-z]:\\|\.\.?\\|\/\/)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1220")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
