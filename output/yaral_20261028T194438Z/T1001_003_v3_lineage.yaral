/*
  MITRE Technique : T1001.003 - Protocol or Service Impersonation
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:10:07.791206+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_003_ESXi_Management_Daemon_Spawns_Shell_Network_Tool {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi management or proxy daemon (hostd, vpxa, rhttpproxy, envoy, openwsmand, sfcbd) spawning a shell, script interpreter or network utility whose command line shows socket, TLS or tunnelling behaviour. These daemons terminate legitimate HTTPS and management-protocol traffic, so a shell child with network-relay arguments is consistent with C2 that impersonates trusted management or TLS traffic, such as a reverse shell or tunnel hidden behind a management service."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001.003"
    mitre_technique_name = "Data Obfuscation: Protocol or Service Impersonation"
    log_prerequisites = "ESXi shell and process execution logging forwarded to Chronicle and parsed into UDM PROCESS_LAUNCH events with parent and child process paths and command lines populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Vendor or backup agent integrations that call helper shell scripts from hostd or vpxa, host-profile remediation, scripted health checks launched by management daemons, and approved support tooling."
    tuning_guidance = "Add approved parent daemons or helper launchers to %global_allowed_script_hosts, approved automation accounts to %global_allowed_service_accounts, and approved management tooling to %global_allowed_admin_tools. Review the child command line in the alert to confirm whether it is a legitimate helper."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(hostd|vmware-hostd|vpxa|rhttpproxy|envoy|openwsmand|sfcbd|sfcb-[a-z]+)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|ash|bash|busybox|python[0-9.]*|perl|nc|ncat|netcat|socat|openssl|curl|wget)$/ nocase
    $proc.target.process.command_line = /(\/dev\/tcp\/|\bs_client\b|\bsocat\b|\b(nc|ncat|netcat)\b|mkfifo|socket\.socket|\bcurl\b|\bwget\b|\bexec\s+[0-9]+<>)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1001.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
