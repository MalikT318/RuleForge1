/*
  MITRE Technique : T1213.004 - Customer Relationship Management Software
  Tactic(s)       : Collection
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:27:35.528589+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_004_CRM_App_Permission_Grant_Identity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an identity-layer permission, role, consent or access grant to a CRM-type business application by an account that is not an approved administrator or service principal. This is a directory state change rather than a command line. It is the access-enablement step that precedes bulk mining of customer records in CRM software."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.004"
    mitre_technique_name = "Data from Information Repositories: Customer Relationship Management Software"
    log_prerequisites = "Identity provider directory/audit logs normalised to UDM USER_CHANGE_PERMISSIONS with target.application or target.resource.name and metadata.description populated. The CRM application must be registered in the identity provider (SSO/OAuth)."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Legitimate onboarding of sales or support staff, helpdesk-driven role assignments, HR-driven joiner/mover automation, sanctioned integration consent by application owners, and group-based provisioning waves."
    tuning_guidance = "Add approved IAM administrators to %global_allowed_admin_users and provisioning or automation identities to %global_allowed_cloud_principals or %global_allowed_service_accounts. Adjust the application-name regex to the customer's CRM naming (for example custom app display names). If grants are noisy, raise severity only when the grant also contains broad-scope keywords."

  events:
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    (
      $perm.target.application = /(\bcrm\b|customer.?relationship|customer.?(data|engagement|service|support)|\bsales\b|\bleads?\b|\bcontacts?\b|help.?desk|ticketing)/ nocase or
      $perm.target.resource.name = /(\bcrm\b|customer.?relationship|customer.?(data|engagement|service|support)|\bsales\b|\bleads?\b|\bcontacts?\b|help.?desk|ticketing)/ nocase
    )
    $perm.metadata.description = /(consent|grant|oauth|delegat|assign|role|scope|permission|access)/ nocase
    $perm.principal.user.userid != ""
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_cloud_principals
    not $perm.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1213.004")
    $primary_entity = array_distinct($perm.principal.user.userid)
    $target_users = array_distinct($perm.target.user.userid)
    $target_applications = array_distinct($perm.target.application)
    $target_resources = array_distinct($perm.target.resource.name)

  condition:
    $perm
}
