/*
  MITRE Technique : T1543.002 - Systemd Service
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:54:20.188493+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_002_Systemd_Persistence_From_Anomalous_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server, database, or print service process spawning systemctl, systemd-run, or a shell or interpreter that references systemd unit directories or systemctl. Service daemons do not normally manage systemd units, so this lineage suggests exploitation or a webshell installing a persistent service."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.002"
    mitre_technique_name = "Create or Modify System Process: Systemd Service"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry normalized to PROCESS_LAUNCH, with populated parent (principal.process) and child (target.process) executable paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package post-install scripts or database and web server packages that run via the service binary and call systemctl, application self-update or reload routines, config-management hooks run by the daemon, and admins using a shell spawned from a web or database service (e.g. a management plugin)."
    tuning_guidance = "Add approved parent binaries to %global_allowed_script_hosts or %global_allowed_admin_tools. Extend the parent regex with client-specific daemons (e.g. application runtimes) once baselined. Raise severity when the host is internet-facing."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|php-fpm[0-9.]*|php[0-9.]*|tomcat[0-9]*|lighttpd|caddy|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|cupsd)$/ nocase
    (
      $proc.target.process.file.full_path = /\/(systemctl|systemd-run)$/ nocase or
      (
        $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ksh|python[0-9.]*|perl|ruby|php[0-9.]*)$/ nocase and
        $proc.target.process.command_line = /(\/(etc|usr\/lib|lib|run)\/systemd\/(system|user)|\.config\/systemd\/user|systemctl\s+(enable|start|daemon-reload|link|reenable)|systemd-run)/ nocase
      )
    )
    not $proc.target.process.command_line = /\b(status|is-active|is-enabled|is-failed|show|list-units|list-unit-files)\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1543.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
