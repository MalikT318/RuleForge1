/*
  MITRE Technique : T1497.002 - User Activity Based Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:05:20.213486+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_002_Linux_User_Activity_Check_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of user-activity and sandbox-awareness checks on a single Linux host within ten minutes. The checks include idle-time and input-device probes, logged-in session enumeration, and inspection of shell history, browser profiles, and common user folders. A single check is benign, but repeated checks in a short window suggest malware testing whether a real user is present before it activates."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1497.002"
    mitre_technique_name = "Virtualization/Sandbox Evasion: User Activity Based Checks"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records normalised to PROCESS_LAUNCH, with command_line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators running who, w, or last during troubleshooting. Login-banner and MOTD scripts. Desktop idle-lock and screensaver helpers. Backup or file-indexing jobs that enumerate home folders. Inventory and compliance agents. User-auditing scripts."
    tuning_guidance = "Add approved inventory, monitoring, and RMM binaries to %global_allowed_admin_tools. Add trusted wrapper scripts and parents to %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts. Raise the #proc threshold on noisy jump hosts or shared terminal servers."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(\bxprintidle\b|getmouselocation|\bloginctl\s+(list-sessions|show-session)|(^|\/)(who|w|last|lastlog|users)(\s+-\S+)*\s*$|\/dev\/input\/|\b(ls|find|du|tree)\s.*\/(Desktop|Documents|Downloads)\b|\.bash_history|\.zsh_history|\.mozilla\/firefox|\.config\/(google-chrome|chromium)|recently-used\.xbel)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1497.002")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $observed_commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 5
}
