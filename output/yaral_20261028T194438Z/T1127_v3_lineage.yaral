/*
  MITRE Technique : T1127 - Trusted Developer Utilities Proxy Execution
  Tactic(s)       : Stealth, Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:35:45.247889+00:00
  Reference       : https://attack.mitre.org/techniques/T1127
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1127_Unexpected_Parent_Spawns_Developer_Utility {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a trusted developer or debugging utility (MSBuild, csc, vbc, jsc, rcsi, csi, dnx, cdb, ntsd, windbg, tracker, aspnet_compiler) launched by a parent process that should never act as a build or debug host. Such parents include Office applications, web server worker processes, database services, the print spooler, and script hosts. This lineage anomaly indicates proxy execution of attacker code through a signed developer binary and is independent of command-line content."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1127"
    mitre_technique_name = "Trusted Developer Utilities Proxy Execution"
    log_prerequisites = "Requires Windows process creation telemetry with populated parent and child image paths (EDR, Sysmon Event ID 1, or Security Event 4688 with parent process name)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "ASP.NET dynamic compilation (w3wp.exe spawning csc.exe or vbc.exe), SQL Server CLR or build-integration jobs, Office add-in or VSTO developer workflows on developer workstations, CI agents or deployment tools launched from approved parents, and authorised red-team or purple-team exercises."
    tuning_guidance = "Add approved parent binaries (build agents, deployment tooling) to %global_allowed_admin_tools. Add known automation accounts to %global_allowed_service_accounts. Add authorised testing hosts' tooling to %global_allowed_scanners if required. If ASP.NET compilation noise persists on web servers, review the Temporary ASP.NET Files exclusion and scope it per client."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|php-cgi|tomcat[0-9]*|sqlservr|spoolsv|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(msbuild|csc|vbc|jsc|rcsi|csi|dnx|cdb|ntsd|windbg|tracker|aspnet_compiler)\.exe$/ nocase
    not $proc.target.process.command_line = /temporary asp\.net files/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1127")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
