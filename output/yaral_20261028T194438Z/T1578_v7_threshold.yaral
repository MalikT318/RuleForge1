/*
  MITRE Technique : T1578 - Modify Cloud Compute Infrastructure
  Tactic(s)       : Defense Impairment
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:49:37.830987+00:00
  Reference       : https://attack.mitre.org/techniques/T1578
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_Bulk_Compute_Resource_Deletion_By_Identity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single cloud identity deleted, terminated or deregistered ten or more compute components (instances, virtual machines, snapshots, images, volumes or disks) within ten minutes. Bulk removal of compute infrastructure can indicate an adversary destroying evidence, evading defenses or tearing down forensic artifacts. A single deletion is routine; the volume from one identity is not."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578"
    mitre_technique_name = "Modify Cloud Compute Infrastructure"
    log_prerequisites = "Cloud control-plane audit logs with management/write events enabled and normalised to UDM RESOURCE_DELETION, with metadata.product_event_type and principal.user.userid populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Autoscaling and instance-lifecycle automation, CI/CD pipelines tearing down ephemeral environments, backup retention jobs pruning old snapshots, cost-optimisation or cleanup scripts, planned decommissioning by administrators."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, approved cloud service principals to %global_allowed_cloud_principals, and named cloud administrators to %global_allowed_admin_users. Raise or lower the #cloud threshold per client based on normal churn. Narrow the product_event_type regex if a client's environment is highly ephemeral."

  events:
    $cloud.metadata.event_type = "RESOURCE_DELETION"
    $cloud.metadata.product_event_type = /(delete|terminate|deregister).*(snapshot|instance|image|volume|virtualmachine|disk)|(snapshots|instances|images|volumes|virtualmachines|disks)\/delete/ nocase
    $cloud.principal.user.userid != ""
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($cloud.metadata.id)
    $mitre_technique_id = array_distinct("T1578")
    $primary_entity = array_distinct($user)
    $deleted_resources = array_distinct($cloud.target.resource.name)
    $api_actions = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    #cloud >= 10
}
