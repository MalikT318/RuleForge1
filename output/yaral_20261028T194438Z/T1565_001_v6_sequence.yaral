/*
  MITRE Technique : T1565.001 - Stored Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:40:14.813278+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_001_Linux_InPlace_Data_Edit_Then_File_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Linux utility (sed, perl, awk, dd, truncate, sqlite3) launched with in-place edit, overwrite, truncate or SQL modify arguments against a data file or database directory, followed within 10 minutes by a file modification of a data file performed by a text or data utility on the same host. This sequence indicates stored data manipulation outside the owning application."
    mitre_tactic = "Impact"
    mitre_technique = "T1565.001"
    mitre_technique_name = "Data Manipulation: Stored Data Manipulation"
    log_prerequisites = "Requires Linux EDR or auditd with execve (process launch) and file-write telemetry normalised to UDM, with command line and file path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "DBAs running sed/sqlite3 maintenance, configuration management and deployment scripts rewriting JSON/CSV data files, log or data rotation jobs using truncate, ETL and data-cleanup scripts, backup and restore jobs."
    tuning_guidance = "Add approved admin tooling to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and backup or imaging processes to %global_allowed_backup_processes. Extend the data file extension list per client if proprietary data formats are in use."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(sed|perl|awk|gawk|dd|truncate|sqlite3)$/ nocase
    $proc.target.process.command_line = /(\s-[a-zA-Z]*i\b|--in-place|\bof=|\btruncate\b|\s-s\s*0\b|\b(update|delete|drop)\b)/ nocase
    $proc.target.process.command_line = /(\.(db|sqlite3?|csv|sql|ibd|myd|frm|json|xlsx?|ldb)\b|\/var\/lib\/(mysql|postgresql|mongodb))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $host

    $mod.metadata.event_type = "FILE_MODIFICATION"
    $mod.principal.process.file.full_path = /\/(sed|perl|awk|gawk|dd|truncate|sqlite3|tee|python3?)$/ nocase
    $mod.target.file.full_path = /^\/(var\/lib\/(mysql|postgresql|mongodb)|srv|opt|home|var\/www|data|mnt)\/.*\.(db|sqlite3?|csv|sql|ibd|myd|frm|json|xlsx?|ldb)$/ nocase
    not $mod.principal.process.file.full_path in %global_allowed_backup_processes
    not $mod.principal.process.file.full_path in %global_allowed_admin_tools
    $mod.principal.hostname = $host

    $proc.metadata.event_timestamp.seconds <= $mod.metadata.event_timestamp.seconds

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1565.001")
    $primary_entity = array_distinct($host)
    $commands = array_distinct($proc.target.process.command_line)
    $modified_files = array_distinct($mod.target.file.full_path)
    $modified_file_count = count($mod.metadata.id)

  condition:
    $proc and $mod
}
