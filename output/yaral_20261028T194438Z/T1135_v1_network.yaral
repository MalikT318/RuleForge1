/*
  MITRE Technique : T1135 - Network Share Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:03:36.076092+00:00
  Reference       : https://attack.mitre.org/techniques/T1135
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1135_Outbound_SMB_To_External_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a network connection to SMB (TCP 445) or NetBIOS session service (TCP 139) on a non-internal destination, as seen at the network perimeter. Windows share enumeration and access runs over SMB, and SMB crossing the perimeter is rarely legitimate. It can indicate share discovery against externally reachable hosts, SMB-based collection, or exposure through a misconfigured egress policy. This is network-side coverage that does not depend on endpoint command-line telemetry."
    mitre_tactic = "Discovery"
    mitre_technique = "T1135"
    mitre_technique_name = "Network Share Discovery"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with populated principal.hostname, target.ip and target.port. The perimeter must log allowed and denied egress traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Cloud file-share services reached over SMB (for example managed cloud file storage), site-to-site or VPN-hairpinned traffic that appears as non-RFC1918 space, authorised vulnerability scanners and penetration tests, and hosts with legitimate SMB over WAN or SD-WAN to a partner."
    tuning_guidance = "Add known cloud file-share and partner domains to %global_allowed_domains, and authorised scanner sources to %global_allowed_scanners. Confirm %rfc1918_internal covers all internal and VPN address space for the client. If egress SMB is blocked by policy, consider raising severity when the connection is allowed."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 445 or $net.target.port = 139)
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1135")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
