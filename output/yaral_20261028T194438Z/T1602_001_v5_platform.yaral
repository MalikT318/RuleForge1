/*
  MITRE Technique : T1602.001 - SNMP (MIB Dump)
  Tactic(s)       : Collection
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:18:45.930817+00:00
  Reference       : https://attack.mitre.org/techniques/T1602/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_001_SNMP_Query_From_Unapproved_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects SNMP queries (UDP/TCP port 161) observed at the network perimeter or internal firewall from a source that is not an approved management station or authorised scanner. Unapproved SNMP polling of network devices can indicate MIB dumping to collect configuration, routing, and interface data for network mapping."
    mitre_tactic = "Collection"
    mitre_technique = "T1602.001"
    mitre_technique_name = "Data from Configuration Repository: SNMP (MIB Dump)"
    log_prerequisites = "Firewall or network perimeter connection/flow logs that populate principal.ip, target.ip and target.port, with traffic to SNMP-managed devices passing through the logging firewall. Populate %global_allowed_mgmt_sources with NMS/monitoring server addresses."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Network monitoring systems and NMS pollers not yet in the allow list, new monitoring deployments, authorised vulnerability or discovery scans, and IT staff running SNMP walks during troubleshooting."
    tuning_guidance = "Add approved NMS and monitoring server addresses to %global_allowed_mgmt_sources and approved scanner sources to %global_allowed_scanners. Review the first week of alerts per client to baseline legitimate pollers. Raise severity for sources outside internal address space or when the target is an externally exposed device."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 161
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1602.001")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_devices = array_distinct($net.target.ip)

  condition:
    $net
}
