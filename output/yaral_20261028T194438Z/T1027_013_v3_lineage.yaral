/*
  MITRE Technique : T1027.013 - Encrypted/Encoded File
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:59:07.456302+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_013_Anomalous_Parent_Spawns_Decoder {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office application, web server worker, print spooler, or database service spawning a script interpreter or a built-in decode/unpack utility. Encoded or encrypted payloads (T1027.013) are typically revealed at execution time by exactly this kind of unexpected parent-child lineage. The rule pivots on process lineage only, not on command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.013"
    mitre_technique_name = "Obfuscated Files or Information: Encrypted/Encoded File"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with parent process path populated (EDR, Sysmon Event ID 1, or Security Event 4688 with parent process logging)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros or add-ins from line-of-business apps that call cmd or PowerShell; SQL Server xp_cmdshell jobs run by DBAs; IIS or Apache applications that legitimately shell out for report generation or file conversion; print drivers and print monitors that launch helper scripts via spoolsv."
    tuning_guidance = "Add approved parent binaries to %global_allowed_script_hosts, approved tooling to %global_allowed_admin_tools, and service accounts that legitimately run these chains to %global_allowed_service_accounts. Review recurring hits per host or parent and exclude by parent executable name rather than path."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|php-cgi|spoolsv|sqlservr|mysqld)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|certutil|rundll32|regsvr32|expand|extrac32)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.013")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
