/*
  MITRE Technique : T1497.003 - Time Based Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:06:14.690661+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_003_Unexpected_Parent_Spawns_Time_Check_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office application, web server, database service or print spooler spawning a shell or script interpreter whose command line performs time-based sandbox or VM checks (sleep or delay loops, tick-count or uptime queries, boot-time enumeration, system clock sampling). Document macros and web shells commonly run these checks before detonating a payload, so the rule pivots on the unexpected parent-child lineage rather than the time check alone."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1497.003"
    mitre_technique_name = "Virtualization/Sandbox Evasion: Time Based Checks"
    log_prerequisites = "Windows endpoint process-launch telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Office macros or add-ins that call PowerShell or cmd with a delay (for example Start-Sleep or timeout) for retries. Web applications or IIS-hosted apps that shell out to run scheduled or maintenance scripts with sleep or uptime checks. Database maintenance jobs launched from the SQL service that query boot time. Print-driver or spooler helper scripts. Approved IT automation launched from these parents."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts or %global_allowed_admin_tools. Where a known application legitimately shells out with delays, allowlist its parent executable path rather than the command line. Extend or narrow the parent regex to match the server roles present at the client."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat\d*|php-cgi|sqlservr|mysqld|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|powershell_ise|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(start-sleep|\bsleep(\.exe)?\s+-?\w*\s*\d+|\btimeout(\.exe)?\s+(\/t\s+)?-?\d+|\bping(\.exe)?\s+.*-n\s+\d{2,}|tickcount|lastbootuptime|get-uptime|\bnet\s+stat(istics)?\s+(workstation|server)|\bw32tm\b|\[datetime\]::(utc)?now|get-date|systemtime|win32_(perfformatteddata_perfos_system|operatingsystem))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1497.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
