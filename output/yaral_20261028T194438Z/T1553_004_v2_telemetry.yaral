/*
  MITRE Technique : T1553.004 - Install Root Certificate
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:04:36.227642+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_004_Linux_Root_CA_Trust_Store_File_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a certificate file (.crt/.pem/.cer/.der) inside a Linux system CA trust store or trust anchor directory by a process that is not a package manager or approved admin tool. Writing to these directories is how a root CA is installed system-wide. Because the rule pivots on the resulting file artifact rather than the command line, it still fires when the attacker uses cp, a script, a custom binary, or a renamed utility."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.004"
    mitre_technique_name = "Subvert Trust Controls: Install Root Certificate"
    log_prerequisites = "Linux EDR file-creation telemetry or auditd watch rules (-w) on the CA trust store directories, normalised to UDM FILE_CREATION with principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management (Ansible, Puppet, Chef, Salt) deploying corporate or internal CA certificates; image and container build pipelines that add a proxy CA; OS package installs and upgrades of ca-certificates; admins manually adding an enterprise CA; TLS-inspection proxy agent onboarding."
    tuning_guidance = "Add approved config-management and deployment binaries to %global_allowed_admin_tools by full process path. Add EDR or agent processes that legitimately touch the trust store to %global_allowed_security_tools. To also cover in-place replacement of existing certificates, clone the rule with metadata.event_type = FILE_MODIFICATION. Where a standard corporate CA rollout is expected, tune per client by narrowing the directory regex or adding the rollout tooling to the allowlist."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(usr\/local\/share\/ca-certificates|usr\/share\/ca-certificates|etc\/ca-certificates|etc\/pki\/ca-trust\/source|etc\/pki\/tls\/certs|etc\/ssl\/certs)\/.+\.(crt|pem|cer|der)$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|yum|dnf|zypper|packagekitd|update-ca-certificates|update-ca-trust|p11-kit|trust)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1553.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $cert_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
