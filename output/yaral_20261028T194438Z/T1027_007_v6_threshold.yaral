/*
  MITRE Technique : T1027.007 - Dynamic API Resolution
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:49:59.473142+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_007_Userland_Process_Bulk_Capability_Module_Loads {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A process running from a user-writable location loads many networking, crypto, credential and debugging DLLs on one host within ten minutes. Each load is benign on its own. Unsigned or packed malware that resolves its APIs at runtime (LoadLibrary/GetProcAddress, API hashing) loads these capability modules in bulk instead of declaring them in its import table."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.007"
    mitre_technique_name = "Obfuscated Files or Information: Dynamic API Resolution"
    log_prerequisites = "Requires EDR or Sysmon-equivalent image/module load telemetry (Sysmon Event ID 7) normalised to PROCESS_MODULE_LOAD, with principal.process.file.full_path and target.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-user installed applications (collaboration clients, browsers, developer tools, updaters), portable admin utilities, software installers and self-extracting packages staged in Temp, and in-house applications run from user profiles."
    tuning_guidance = "Add approved per-user applications to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. Raise the #modload threshold on hosts with heavy developer or portable-tool use. Extend the executable-name exclusion for client-specific per-user software."

  events:
    $modload.metadata.event_type = "PROCESS_MODULE_LOAD"
    $modload.principal.hostname = $host
    $modload.principal.process.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|music|pictures|videos)|windows\\temp|programdata|users\\public|\$recycle\.bin)\\/ nocase
    $modload.target.file.full_path = /\\(ws2_32|wininet|winhttp|urlmon|dnsapi|wldap32|netapi32|mpr|crypt32|bcrypt|vaultcli|samcli|wtsapi32|dbghelp|dbgcore|taskschd|wevtapi)\.dll$/ nocase
    not $modload.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|chrome|msedge|firefox|teams|ms-teams|onedrive|slack|zoom|code|squirrel|update)\.exe$/ nocase
    not $modload.principal.process.file.full_path in %global_allowed_admin_tools
    not $modload.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1027.007")
    $primary_entity = array_distinct($host)
    $module_load_count = count($modload.metadata.id)
    $distinct_module_count = count_distinct($modload.target.file.full_path)
    $loading_processes = array_distinct($modload.principal.process.file.full_path)
    $loaded_modules = array_distinct($modload.target.file.full_path)
    $affected_users = array_distinct($modload.principal.user.userid)

  condition:
    #modload >= 8
}
