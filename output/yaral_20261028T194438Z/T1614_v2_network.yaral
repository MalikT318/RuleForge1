/*
  MITRE Technique : T1614 - System Location Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:37:16.282938+00:00
  Reference       : https://attack.mitre.org/techniques/T1614
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1614_Linux_Scripted_Client_Geolocation_Lookup_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a scripted command-line HTTP client (curl, wget, python, Go, Perl) requesting an external URL whose path or query looks like a public-IP or geolocation lookup. Malware and operator scripts use these lookups for victim geolocation and to decide whether to proceed. The rule is network-side only: it uses the proxy or firewall HTTP log (user agent and URL) and does not rely on endpoint process fields."
    mitre_tactic = "Discovery"
    mitre_technique = "T1614"
    mitre_technique_name = "System Location Discovery"
    log_prerequisites = "Requires firewall or web proxy logs normalised to UDM NETWORK_HTTP with network.http.user_agent and target.url populated. TLS inspection is needed to see the URL and user agent on HTTPS traffic."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Admin and monitoring scripts that check the server's public IP (dynamic DNS updaters, VPN or failover health checks), configuration management and provisioning tools (Ansible, cloud-init, Terraform provisioners), and CI/CD build jobs with geo-aware logic."
    tuning_guidance = "Add approved vendor or update domains to %global_allowed_domains. Add known automation or jump hosts to %global_allowed_script_hosts. Review the matching hostname and URL in the outcome fields. If a dynamic DNS updater is noisy, allowlist its destination domain rather than weakening the user-agent or URL patterns."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.user_agent = /^(curl|wget|python-requests|python-urllib|go-http-client|libwww-perl)/ nocase
    $http.target.url = /(geo-?ip|geolocat|geolookup|ip-?lookup|ip-?locat|myip|whatismyip|checkip|external-?ip|public-?ip|country-?code)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1614")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
