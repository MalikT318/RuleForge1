/*
  MITRE Technique : T1213.006 - Databases
  Tactic(s)       : Collection
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:31:21.732981+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_006_Cloud_Database_Snapshot_Sharing_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a permission or sharing change on a managed database snapshot or backup in the cloud control plane. Adversaries with cloud access can share or expose a database snapshot or backup, then restore it in an environment they control and mine its contents without ever querying the live database. This rule covers collection from cloud-hosted databases through audit-log API activity rather than endpoint command lines."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.006"
    mitre_technique_name = "Data from Information Repositories: Databases"
    log_prerequisites = "Cloud control-plane audit logging (management/admin activity events) must be enabled and ingested, with permission-change API calls normalised to RESOURCE_PERMISSIONS_CHANGE and the API operation name populated in metadata.product_event_type."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Planned cross-account or cross-project disaster-recovery replication, backup-copy automation, database migration projects, and DBAs sharing snapshots with a sanctioned test or analytics account."
    tuning_guidance = "Add approved automation identities to %global_allowed_cloud_principals or %global_allowed_service_accounts, and named DBAs to %global_allowed_admin_users. For client-specific DR pipelines, add the pipeline's service identity to the same lists. Raise severity to Critical if the sharing target is a public or external principal."

  events:
    $cloud.metadata.event_type = "RESOURCE_PERMISSIONS_CHANGE"
    $cloud.metadata.product_event_type = /(ModifyDB(Cluster)?SnapshotAttribute|(db|database|sql).*(snapshot|backup).*(share|permission|attribute|setiampolicy))/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1213.006")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $source_ips = array_distinct($cloud.principal.ip)
    $operations = array_distinct($cloud.metadata.product_event_type)
    $target_resources = array_distinct($cloud.target.resource.name)

  condition:
    $cloud
}
