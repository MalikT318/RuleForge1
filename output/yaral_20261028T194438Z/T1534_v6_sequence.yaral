/*
  MITRE Technique : T1534 - Internal Spearphishing
  Tactic(s)       : Lateral Movement
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:33:19.619402+00:00
  Reference       : https://attack.mitre.org/techniques/T1534
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1534_External_Login_Then_Internal_Email_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a user sign-in from a non-internal source address followed within 10 minutes by a burst of outbound email transactions from the same account. This pattern is consistent with a compromised account being used for internal spearphishing, where the attacker sends lures from a trusted mailbox to other users in the organisation."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1534"
    mitre_technique_name = "Internal Spearphishing"
    log_prerequisites = "Requires unified audit logs with sign-in events (USER_LOGIN) and mail send events (EMAIL_TRANSACTION), with principal.user.userid populated consistently on both."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate remote or travelling users sending several emails after sign-in, shared or team mailboxes, marketing and newsletter senders, helpdesk or HR staff sending mass notifications, automation accounts that send alerts or reports."
    tuning_guidance = "Add automation and notification mailboxes to %global_allowed_service_accounts, and bulk-sender administrators to %global_allowed_admin_users. Raise or lower the #email threshold per client mail volume. Keep this rule's severity at High only for clients with enforced MFA, where unexpected external sign-ins are rare."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.principal.user.userid != ""
    not $login.principal.ip in %rfc1918_internal
    not $login.principal.user.userid in %global_allowed_service_accounts
    not $login.principal.user.userid in %global_allowed_admin_users
    $login.principal.user.userid = $user

    $email.metadata.event_type = "EMAIL_TRANSACTION"
    $email.principal.user.userid != ""
    $email.network.email.from != ""
    not $email.principal.user.userid in %global_allowed_service_accounts
    not $email.principal.user.userid in %global_allowed_admin_users
    $email.principal.user.userid = $user

    $login.metadata.event_timestamp.seconds <= $email.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1534")
    $primary_entity = array_distinct($user)
    $login_source_ips = array_distinct($login.principal.ip)
    $email_count = count($email.metadata.id)
    $email_subjects = array_distinct($email.network.email.subject)

  condition:
    $login and #email >= 5
}
