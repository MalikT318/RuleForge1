/*
  MITRE Technique : T1027.003 - Steganography
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:42:41.517462+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_003_Script_Host_Bulk_Image_File_Writes {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single host has several image files (png, jpg, bmp, gif) written to user-writable locations by script interpreters or proxy-execution binaries within ten minutes. Script hosts rarely create image files in bulk. Repeated writes of this kind suggest payloads being carved from or embedded into images (for example PowerShell steganography tooling), or steganographic staging of data for exfiltration. This is file-creation volume logic and does not depend on command-line matching."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.003"
    mitre_technique_name = "Obfuscated Files or Information: Steganography"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent) with the creating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Report-generation or charting scripts, PowerShell-based screenshot or documentation tools, IT asset or inventory scripts exporting images, and web-scraping or automation scripts run by developers or admins. Packaging and deployment scripts that unpack icon or image resources are another source."
    tuning_guidance = "Add approved script-host parent processes or hosts to %global_allowed_script_hosts and approved admin or automation tooling to %global_allowed_admin_tools. Raise the #file threshold in condition for noisy developer or automation hosts. Lower it to 3 for high-value servers."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32)\.exe$/ nocase
    $file.target.file.full_path = /\.(png|jpg|jpeg|bmp|gif)$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|programdata|windows\\temp|users\\public)\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.003")
    $primary_entity = array_distinct($host)
    $image_write_count = count($file.metadata.id)
    $image_paths = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $affected_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 5
}
