/*
  MITRE Technique : T1102.002 - Bidirectional Communication
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:55:59.485476+00:00
  Reference       : https://attack.mitre.org/techniques/T1102/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1102_002_ESXi_Host_Bidirectional_WebService_C2 {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An ESXi host pulls content from an external web service with an HTTP GET and then posts data back to the same external service with an HTTP POST within 10 minutes. ESXi hosts have no business browsing or writing to external web services, so this two-way pattern is consistent with C2 over a legitimate web service. It is detected from perimeter or proxy telemetry only, with no endpoint process data."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1102.002"
    mitre_technique_name = "Web Service: Bidirectional Communication"
    log_prerequisites = "Requires firewall or proxy logs with HTTP-level visibility (method and destination host), normalized to UDM NETWORK_HTTP. The ESXi management VMkernel traffic must traverse the logging perimeter and the source hostname must resolve to the ESXi host."
    platform = "ESXi"
    log_source = "firewall"
    false_positives = "ESXi hosts that reach vendor update or patch repositories, or that call home to licensing or telemetry endpoints, and are not yet in the allowed domain list. Also possible: backup or monitoring appliances that proxy through the host, and hostnames that match the ESXi naming pattern but belong to other systems."
    tuning_guidance = "Add approved external domains (vendor update, depot, telemetry) to %global_allowed_domains. The ESXi host identification regex on principal.hostname (esx|vmhost) is a naming-convention heuristic. Adjust it to the client's ESXi naming standard during onboarding. Raise the severity or add a minimum request count if proxied management traffic is noisy."

  events:
    $get.metadata.event_type = "NETWORK_HTTP"
    $get.network.http.method = "GET"
    $get.principal.hostname = /(esx|vmhost)/ nocase
    not $get.target.ip in %rfc1918_internal
    not $get.target.hostname in %global_allowed_domains
    $get.principal.hostname = $hostname
    $get.target.hostname = $domain

    $post.metadata.event_type = "NETWORK_HTTP"
    $post.network.http.method = "POST"
    $post.principal.hostname = /(esx|vmhost)/ nocase
    not $post.target.ip in %rfc1918_internal
    not $post.target.hostname in %global_allowed_domains
    $post.principal.hostname = $hostname
    $post.target.hostname = $domain

    $get.metadata.event_timestamp.seconds <= $post.metadata.event_timestamp.seconds

  match:
    $hostname, $domain over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1102.002")
    $primary_entity = array_distinct($hostname)
    $c2_domain = array_distinct($domain)
    $destination_ips = array_distinct($post.target.ip)
    $get_count = count($get.metadata.id)
    $post_count = count($post.metadata.id)
    $max_bytes_sent = max($post.network.sent_bytes)

  condition:
    $get and $post
}
