/*
  MITRE Technique : T1071.004 - DNS
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:09:05.061082+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_004_ESXi_Host_DNS_Resolver_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a configuration change to the DNS resolver settings of an ESXi host (DNS server list, search domain, host or domain name, or resolver config). Repointing a hypervisor at an unapproved resolver is a state change that enables DNS-based command and control or tunneling from the host. This rule works at the configuration-change layer, so it fires regardless of whether the change was made via the shell, the host client, an API call or a script, and does not depend on command-line logging."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.004"
    mitre_technique_name = "Application Layer Protocol: DNS"
    log_prerequisites = "ESXi hostd and shell logs forwarded to Chronicle and normalized to SETTING_MODIFICATION events, with the acting user and host populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Initial host build or provisioning, planned DNS infrastructure migrations, network re-IP projects, host profile or desired-state remediation, and automation by approved admin or service accounts."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and provisioning or automation accounts to %global_allowed_service_accounts. Correlate any hit with outbound DNS volume from the host's management VMkernel interface and with recent SSH or shell enablement on the same host. Changes outside a change window deserve higher priority."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    (
      $setting.target.resource.name = /(dns[\s_.\-]?(server|servers|config|configuration|search|domain|suffix|address)|resolv\.conf|DnsServer|DnsSearch|DnsHost|DnsDomain)/ nocase or
      $setting.metadata.description = /(dns[\s_.\-]?(server|servers|config|configuration|search|domain|suffix|address)|resolv\.conf|network\s+ip\s+dns)/ nocase
    )
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1071.004")
    $primary_entity = array_distinct(strings.coalesce($setting.principal.hostname, $setting.target.hostname))
    $acting_user = array_distinct($setting.principal.user.userid)
    $changed_setting = array_distinct($setting.target.resource.name)

  condition:
    $setting
}
