/*
  MITRE Technique : T1574.008 - Path Interception by Search Order Hijacking
  Tactic(s)       : Stealth, Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:36:17.726991+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_008_Search_Order_Hijack_SystemBinary_Name_From_NonSystem_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process whose image carries the name of a core Windows utility (cmd, net, whoami, reg and similar) but runs from outside the Windows system directories, launched by a parent that is also outside the Windows directory. This lineage is characteristic of search order hijacking: a program that invokes a utility by bare name is tricked into launching a planted look-alike binary from its own directory. Detection pivots on the parent-child image path relationship and not on command-line content."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.008"
    mitre_technique_name = "Hijack Execution Flow: Path Interception by Search Order Hijacking"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry that populates both the parent (principal.process.file.full_path) and child (target.process.file.full_path) image paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Portable or self-contained applications that ship their own copies of utilities such as cmd.exe or reg.exe; developer toolchains (Cygwin, MSYS, Git for Windows, Python or Node bundles); software installers and updaters extracting to temp folders; sandbox or application-virtualization products; Windows image-servicing or setup media run from non-standard drives."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Trim or extend the utility-name list to match client software. If a client runs Windows from a non-standard drive or directory, adjust the Windows directory exclusion. For high-volume developer endpoints, scope by host or add developer toolchain parents to %global_allowed_script_hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Child carries the name of a commonly-invoked built-in Windows utility
    $proc.target.process.file.full_path = /\\(cmd|net|net1|whoami|ipconfig|systeminfo|tasklist|nltest|reg|schtasks|sc|wmic|certutil|mshta|rundll32|regsvr32|netsh|arp|nslookup|hostname|quser|taskkill|attrib|find|findstr|ping|cscript|wscript|msiexec|bitsadmin)\.exe$/ nocase

    // ...but it is NOT running from a genuine Windows system location
    not $proc.target.process.file.full_path = /^[a-z]:\\windows\\(system32|syswow64|sysnative|winsxs)\\/ nocase

    // Parent is a real image located outside the Windows directory (lineage anomaly)
    $proc.principal.process.file.full_path = /\\[^\\]+\.exe$/ nocase
    not $proc.principal.process.file.full_path = /^[a-z]:\\windows\\/ nocase

    // Exclusions
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1574.008")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_image = array_distinct($proc.principal.process.file.full_path)
    $child_image = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
