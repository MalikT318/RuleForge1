/*
  MITRE Technique : T1669 - Wi-Fi Networks
  Tactic(s)       : Initial Access
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:12:21.840742+00:00
  Reference       : https://attack.mitre.org/techniques/T1669
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1669_IPS_Wireless_Segment_Outbound_Verdict {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side detection of a client on a wireless segment (rogue or evil-twin AP, guest or open WLAN, wireless intrusion verdict) generating an IPS/network security appliance verdict on a connection to an external destination. This indicates a device that joined the Wi-Fi network may be using it as an initial-access foothold for outbound C2, scanning or exfiltration."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1669"
    mitre_technique_name = "Wi-Fi Networks"
    log_prerequisites = "IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION. The appliance must write the signature or rule name, or the verdict description, into security_result.rule_name or security_result.description, and wireless-zone or WIPS context must appear in that text. Source and destination IPs must be populated."
    platform = "Network Devices"
    log_source = "ips"
    false_positives = "Authorised wireless penetration tests, wireless site surveys and scanners, guest Wi-Fi users triggering generic web or P2P signatures, BYOD devices with adware, and neighbouring-AP detections that are not on the corporate network."
    tuning_guidance = "Add authorised testing sources to %global_allowed_scanners and approved wireless controllers or management addresses to %global_allowed_mgmt_sources. Extend %rfc1918_internal if internal ranges are missing. If the appliance uses different wireless zone or signature terminology, adjust the regex on security_result."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.security_result.rule_name = /(wi-?fi|wlan|wireless|rogue[ _-]?ap|evil[ _-]?twin|deauth|guest[ _-]?(ssid|wlan|network))/ nocase or
      $net.security_result.description = /(wi-?fi|wlan|wireless|rogue[ _-]?ap|evil[ _-]?twin|deauth|guest[ _-]?(ssid|wlan|network))/ nocase
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1669")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
