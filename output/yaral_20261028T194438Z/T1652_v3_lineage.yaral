/*
  MITRE Technique : T1652 - Device Driver Discovery
  Tactic(s)       : Discovery
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:55:10.017396+00:00
  Reference       : https://attack.mitre.org/techniques/T1652
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1652_Unexpected_Parent_Driver_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects device driver enumeration (driverquery, pnputil driver listing, sc query for drivers, fltmc, WMI Win32_SystemDriver, Get-WindowsDriver) launched by an unexpected parent process such as an Office application, web server worker, print spooler or database service. Legitimate administration rarely runs driver discovery from these parents, so this lineage often indicates exploitation or macro or web shell activity profiling the host for security tooling or exploitable drivers."
    mitre_tactic = "Discovery"
    mitre_technique = "T1652"
    mitre_technique_name = "Device Driver Discovery"
    log_prerequisites = "Requires Windows process creation telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Vendor management or diagnostic plugins hosted in a web server or database service that inventory drivers; Office add-ins or support tools that collect system diagnostics; print management software that runs driver queries from the spooler; IT inventory scripts launched from an unusual parent."
    tuning_guidance = "Add approved parent process paths to %global_allowed_admin_tools or %global_allowed_script_hosts. Add EDR or AV agents to %global_allowed_security_tools. Add automation accounts to %global_allowed_service_accounts. Extend or trim the parent regex to match the client's web, database and Office estate."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|onenote|msaccess|mspub|visio|acrord32|acrobat|w3wp|httpd|nginx|php-cgi|tomcat\d*|sqlservr|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|wmic|sc|driverquery|pnputil|fltmc)\.exe$/ nocase
    $proc.target.process.command_line = /(\bdriverquery(\.exe)?\b|\bpnputil(\.exe)?\b.*(\/enum-drivers|\/e\b|-e\b|\/enum-devices)|\bsc(\.exe)?\s+(\\\\\S+\s+)?(query|queryex)\b.*type=\s*(driver|kernel|filesys)|\bfltmc(\.exe)?\b|win32_systemdriver|win32_pnpsigneddriver|wmic.*sysdriver|enumdevicedrivers|get-windowsdriver|get-wmiobject.*systemdriver|get-ciminstance.*systemdriver)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1652")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
