/*
  MITRE Technique : T1003.002 - Security Account Manager
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:39:41.696646+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_002_SAM_Hive_Reg_Exfil_External_SMB {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the reg utility, or any process whose command line is saving or exporting the SAM, SYSTEM or SECURITY hives, opening an SMB connection (445/139) to a non-internal address. This is the network footprint of 'reg save HKLM\\sam \\\\remote\\share\\sam' writing credential hives straight to an attacker-controlled share, and it complements process-command-line detections by observing the outbound traffic."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.002"
    mitre_technique_name = "OS Credential Dumping: Security Account Manager"
    log_prerequisites = "Requires Windows endpoint network-connection telemetry (EDR or Sysmon Event ID 3) with populated principal process path, and ideally command line, on NETWORK_CONNECTION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators using reg.exe against a remote registry or file share reached through a public or NAT-translated address, approved backup or imaging tools that export registry hives to cloud-hosted SMB storage, and DR or migration tooling."
    tuning_guidance = "Add approved administrative tooling to %global_allowed_admin_tools and backup software to %global_allowed_backup_processes. If a client uses SMB over public address space (for example Azure Files), add the process to the allowlist and use %global_allowed_remote_mgmt for approved tooling. Review the risk score for hosts where internal NAT is not captured in %rfc1918_internal."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 445 or
      $net.target.port = 139
    )
    (
      $net.principal.process.file.full_path = /\\reg\.exe$/ nocase or
      $net.principal.process.command_line = /\b(save|export)\b\s+"?hk(lm|ey_local_machine)\\(sam|security|system)\b/ nocase
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1003.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_user = array_distinct($net.principal.user.userid)
    $process_command_line = array_distinct($net.principal.process.command_line)

  condition:
    $net
}
