/*
  MITRE Technique : T1553.006 - Code Signing Policy Modification
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:08:17.737386+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_006_BCDEdit_Code_Signing_Disabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects bcdedit.exe being used to weaken Windows code signing enforcement, by enabling test signing, disabling integrity checks, or setting the DISABLE_INTEGRITY_CHECKS load option. These changes let unsigned or self-signed drivers and code load, and are commonly used before installing rootkits or vulnerable or malicious drivers."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.006"
    mitre_technique_name = "Subvert Trust Controls: Code Signing Policy Modification"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 / Windows Event 4688 with command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Driver developers and QA engineers enabling test signing on lab or build machines, hardware or kernel driver test automation, OS imaging and deployment task sequences, and approved IT troubleshooting of boot configuration."
    tuning_guidance = "Add approved deployment, imaging and driver-testing parent processes to %global_allowed_admin_tools. Add named administrators or build accounts to %global_allowed_admin_users. Add automation accounts to %global_allowed_service_accounts. Consider scoping the rule to non-developer asset groups if development workstations are noisy."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\bcdedit\.exe$/ nocase
    $proc.target.process.command_line = /\bset\b.*(\b(testsigning|nointegritychecks)\b\s+(on|yes|1|true)\b|\bloadoptions\b\s+.*disable_integrity_checks)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1553.006")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
