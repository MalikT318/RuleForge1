/*
  MITRE Technique : T1564.012 - File/Path Exclusions
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:32:29.497765+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_012_Linux_Scanner_Exclusion_Config_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects modification of Linux malware-scanner, file-integrity and audit configuration files (where scan exclusions, whitelists and audit 'never' rules are defined) by a process that is not an approved package manager or admin tool. Adversaries add exclusions here so that dropped payloads are not scanned or audited. This is file-based and complements process command-line coverage."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.012"
    mitre_technique_name = "Hide Artifacts: File/Path Exclusions"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file watches (-w on /etc/clamav, /etc/aide, /etc/audit, /etc/rkhunter.conf) normalised to FILE_MODIFICATION with principal process populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management (Ansible, Puppet, Chef, Salt) pushing scanner config, package upgrades rewriting config files, administrators manually tuning scanner exclusions or audit rules, and AIDE or rkhunter baseline maintenance scripts."
    tuning_guidance = "Add configuration management agents and approved admin tooling to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and named administrators to %global_allowed_admin_users. Extend the path regex if the client uses additional scanners, e.g. an EDR agent's local policy directory."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/(clamav\/|clamd\.d\/|clamd\.conf$|freshclam\.conf$|rkhunter\.conf(\.local)?$|aide\/|aide\.conf$|audit\/(rules\.d\/|audit\.rules$|auditd\.conf$))/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|yum|dnf|unattended-upgrade|packagekitd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1564.012")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_config = array_distinct($file.target.file.full_path)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
