/*
  MITRE Technique : T1070.003 - Clear Command History
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:03:48.716289+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_003_ESXi_Mgmt_Daemon_Spawns_Shell_Clearing_History {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi management or agent daemon (host agent, vCenter agent, reverse proxy, CIM/WS-Man broker, SNMP, SLP) spawning a shell or script interpreter whose arguments target shell history or the ESXi shell audit log. These daemons do not normally launch interactive shells or touch history files, so this lineage suggests exploitation of a management service, followed by anti-forensic cleanup of command history. The detection pivots on the anomalous parent-child relationship, with the history-target arguments as a secondary qualifier."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.003"
    mitre_technique_name = "Indicator Removal: Clear Command History"
    log_prerequisites = "ESXi process execution telemetry with parent and child process paths and command line populated, forwarded to Chronicle (shell audit logging enabled, or an agent or forwarder that records process lineage)."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Vendor or backup agents that run housekeeping shell wrappers from a management daemon, host remediation or patching scripts launched through the management agent, support-bundle collection scripts that reference shell.log, and administrator automation invoked via the management plane."
    tuning_guidance = "Add approved parent binaries to %global_allowed_script_hosts or %global_allowed_admin_tools. If the environment uses vendor agents that legitimately spawn shells from a daemon, allowlist that parent path. Extend the parent daemon regex with site-specific management daemons if needed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(hostd|hostd-worker|vpxa|rhttpproxy|openwsmand|sfcbd|sfcb-[a-z0-9_-]+|snmpd|slpd|fdm|vmware-fdm|lwsmd)$/ nocase
    $proc.target.process.file.full_path = /(^|\/)(sh|ash|bash|dash|python[0-9.]*|perl)$/ nocase
    $proc.target.process.command_line = /(shell\.log|\.ash_history|\.bash_history|\.sh_history|histfile|history\s+-[cw]|\/var\/log\/shell)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1070.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
