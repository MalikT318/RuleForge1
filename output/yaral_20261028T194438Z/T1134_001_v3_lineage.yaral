/*
  MITRE Technique : T1134.001 - Token Impersonation/Theft
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:53:27.501226+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_001_Token_Theft_Anomalous_Parent_Spawns_Privileged_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter running in a SYSTEM or service security context that was spawned by a parent process that should never launch one: an Office application, web server worker, print spooler or database service. A low-privileged service process that duplicates and impersonates a SYSTEM token (the potato-style and PrintSpoofer-style pattern) typically spawns an elevated shell from exactly this lineage."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.001"
    mitre_technique_name = "Access Token Manipulation: Token Impersonation/Theft"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and the launching user populated (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web applications or database jobs that legitimately shell out (SQL Server xp_cmdshell maintenance jobs, IIS-hosted admin or deployment tools, report-generation scripts), print drivers or print-management software launching helper scripts from the spooler, and Office automation or deployment agents running as a service account."
    tuning_guidance = "Add approved parent binaries or hosts to %global_allowed_script_hosts and approved automation accounts to %global_allowed_service_accounts. Add approved deployment or RMM tools to %global_allowed_admin_tools. Extend or trim the parent process list per customer stack, for example adding application servers that never spawn shells."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|spoolsv|sqlservr|mysqld|oracle)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|powershell_ise|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.principal.user.userid = /(^|\\)(system|local service|network service)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1134.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $launching_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
