/*
  MITRE Technique : T1564.014 - Extended Attributes
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:36:24.420914+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_014_Linux_Bulk_Xattr_Payload_Writes {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects bursts of extended-attribute writes into the user. or trusted. namespace on a single Linux host within 10 minutes. A single setfattr call is routine, but repeated value writes by one host suggest payload staging in hidden file metadata. The rule matches the OS-native setfattr binary combined with a namespaced attribute name and an explicit value, and counts the volume."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.014"
    mitre_technique_name = "Hide Artifacts: Extended Attributes"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records normalised to UDM PROCESS_LAUNCH with target.process.file.full_path and command_line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup and restore tools that replicate xattrs, SELinux or IMA labelling scripts, container image builds and package post-install scripts, file synchronisation and migration jobs, configuration management runs, and admins tagging files in bulk."
    tuning_guidance = "Add approved config-management, deployment and backup parent processes to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Raise the #proc threshold on hosts that run file-labelling jobs. Review hits where the attribute value is long or encoded."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/setfattr$/ nocase
    $proc.target.process.command_line = /\s-n\s*\S?(user|trusted)\./ nocase
    $proc.target.process.command_line = /(\s-v\s*|\s--value[=\s])/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($proc.target.process.command_line = /\s-n\s*\S?trusted\./ nocase, 80, 60))
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1564.014")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)

  condition:
    #proc >= 5
}
