/*
  MITRE Technique : T1055.004 - Asynchronous Procedure Call
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:51:46.760211+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_004_APC_Injection_UserWritable_Source_Into_Host_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects EDR-reported cross-process injection (the telemetry that covers APC queuing and Early Bird style injection) where the injecting process runs from a user-writable location and the victim is a commonly abused Windows host process. APC injection exists only on Windows, so a Linux, macOS or cloud pivot is not possible. This rule instead adds additive coverage through PROCESS_INJECTION telemetry rather than PROCESS_LAUNCH command-line matching."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.004"
    mitre_technique_name = "Process Injection: Asynchronous Procedure Call"
    log_prerequisites = "Requires EDR or Sysmon-equivalent telemetry that reports cross-process injection and is normalised to UDM PROCESS_INJECTION, with populated principal and target process paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers or updaters run from Temp or AppData, game anti-cheat and overlay tools, accessibility and screen-reader software, in-house developer debugging tools, and unlisted security or backup agents."
    tuning_guidance = "Add approved EDR/AV agents to %global_allowed_security_tools, deployment and patching tooling to %global_allowed_admin_tools, and imaging software to %global_allowed_backup_processes. Extend the victim-process regex if the environment has additional commonly abused host processes."

  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.process.file.full_path = /\\(appdata|temp|downloads|programdata|users\\public)\\/ nocase
    $inj.target.process.file.full_path = /\\(svchost|explorer|notepad|rundll32|dllhost|werfault|runtimebroker|spoolsv|winlogon|taskhostw|searchindexer)\.exe$/ nocase
    $inj.principal.process.file.full_path != $inj.target.process.file.full_path
    $inj.principal.hostname != ""
    not $inj.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.004")
    $primary_entity = array_distinct($inj.principal.hostname)
    $injector_process = array_distinct($inj.principal.process.file.full_path)
    $victim_process = array_distinct($inj.target.process.file.full_path)
    $acting_user = array_distinct($inj.principal.user.userid)

  condition:
    $inj
}
