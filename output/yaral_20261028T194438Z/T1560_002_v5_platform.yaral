/*
  MITRE Technique : T1560.002 - Archive via Library
  Tactic(s)       : Collection
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:00:01.765348+00:00
  Reference       : https://attack.mitre.org/techniques/T1560/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1560_002_Script_Runtime_Writes_Archive_In_Staging_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a scripting runtime (Python, PowerShell, Node, Ruby, Perl, PHP) creating a compressed archive file in a common staging location. This catches archiving through in-process libraries (zipfile, zlib, System.IO.Compression and similar) rather than a spawned archiver utility. It is file-creation based and complements command-line process-launch rules. The write-up of the technique is in the MITRE T1560.002 entry."
    mitre_tactic = "Collection"
    mitre_technique = "T1560.002"
    mitre_technique_name = "Archive Collected Data: Archive via Library"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) that populates the writing process path and the target file path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developer and data-science workstations using Python or Node build and packaging tooling; PowerShell Compress-Archive in admin or log-collection scripts; software installers that unpack bundled archives into temp folders; backup and reporting scripts."
    tuning_guidance = "Add approved script-running hosts and parent tools to %global_allowed_script_hosts, backup tooling to %global_allowed_backup_processes, IT tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. On developer-heavy tenants, narrow the staging-path regex or scope the rule to non-developer asset groups."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(python[0-9.]*|pythonw[0-9.]*|powershell|pwsh|node|ruby|perl|php)\.exe$/ nocase
    $file.target.file.full_path = /\.(zip|7z|rar|tar|gz|tgz|bz2|xz)$/ nocase
    $file.target.file.full_path = /(\\users\\[^\\]+\\appdata\\local\\temp\\|\\users\\public\\|\\programdata\\|\\windows\\temp\\|\\\$recycle\.bin\\|\\perflogs\\)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1560.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $archive_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
