/*
  MITRE Technique : T1557.001 - Name Resolution Poisoning and SMB Relay
  Tactic(s)       : Credential Access, Collection
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:30:47.171366+00:00
  Reference       : https://attack.mitre.org/techniques/T1557/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1557_001_NameResolution_Poison_Then_SMB_To_Responder {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A host sends traffic sourced from the LLMNR (UDP 5355), NBT-NS (UDP 137) or mDNS (UDP 5353) service ports to a client, and that same client then opens an SMB connection (445/139) back to the host that answered. This pattern is consistent with a poisoner (Responder-style) answering a name query and capturing or relaying the NTLM authentication that follows."
    mitre_tactic = "Credential Access, Collection"
    mitre_technique = "T1557.001"
    mitre_technique_name = "Adversary-in-the-Middle: LLMNR/NBT-NS Poisoning and SMB Relay"
    log_prerequisites = "Requires firewall or network perimeter telemetry that sees intra-site and inter-VLAN flows (internal segmentation firewalls, east-west sensors, or flow logs) with source and destination IP and port populated. Perimeter-only logging will not see same-segment multicast name resolution traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate Windows hosts, printers, NAS devices and media or IoT devices that answer mDNS or NBT-NS queries and are then accessed over SMB (file servers, print servers, domain controllers running NetBIOS name service); authorised network discovery or vulnerability scanners; internal penetration tests."
    tuning_guidance = "Add authorised scanners and testing sources to %global_allowed_scanners and approved infrastructure addresses (file servers, WINS or NetBIOS servers, domain controllers) to %global_allowed_mgmt_sources. If mDNS noise is high from printers or NAS devices in a client, remove port 5353 from the first event or allowlist those device addresses. Widen or narrow the 10m window per client."

  events:
    $poison.metadata.event_type = "NETWORK_CONNECTION"
    (
      $poison.principal.port = 5355 or
      $poison.principal.port = 137 or
      $poison.principal.port = 5353
    )
    $poison.principal.ip != $poison.target.ip
    not $poison.principal.ip in %global_allowed_scanners
    not $poison.principal.ip in %global_allowed_mgmt_sources
    $poison.principal.ip = $responder_ip
    $poison.target.ip = $victim_ip

    $smb.metadata.event_type = "NETWORK_CONNECTION"
    (
      $smb.target.port = 445 or
      $smb.target.port = 139
    )
    not $smb.target.ip in %global_allowed_mgmt_sources
    $smb.target.ip = $responder_ip
    $smb.principal.ip = $victim_ip

    $poison.metadata.event_timestamp.seconds <= $smb.metadata.event_timestamp.seconds

  match:
    $responder_ip, $victim_ip over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1557.001")
    $primary_entity = array_distinct($poison.principal.ip)
    $victim_hosts = array_distinct($smb.principal.ip)
    $poison_source_ports = array_distinct($poison.principal.port)
    $smb_target_ports = array_distinct($smb.target.port)
    $first_poison_seen = min($poison.metadata.event_timestamp.seconds)
    $smb_connection_count = count($smb.metadata.id)

  condition:
    $poison and $smb
}
