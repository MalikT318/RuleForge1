/*
  MITRE Technique : T1074 - Data Staged
  Tactic(s)       : Collection
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:17:04.713740+00:00
  Reference       : https://attack.mitre.org/techniques/T1074
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_Script_Interpreter_Writes_Archive_To_Staging_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a script interpreter or command shell creating a compressed archive (zip, rar, 7z, cab, tar, gz) inside a common world-writable staging location such as the Recycle Bin, PerfLogs, Users\\Public, Windows\\Temp or ProgramData. Adversaries commonly stage collected data this way before exfiltration. The rule keys on the behaviour (interpreter writing an archive to a staging directory) and does not depend on any tool name."
    mitre_tactic = "Collection"
    mitre_technique = "T1074"
    mitre_technique_name = "Data Staged"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry from an EDR or Sysmon (Event ID 11) with the initiating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin or backup scripts that compress logs into ProgramData or Temp, software installers or updaters that run via PowerShell and unpack or create cabinet files, helpdesk diagnostic collection scripts, and log-rotation jobs."
    tuning_guidance = "Add approved scripting hosts or parent processes to %global_allowed_script_hosts, sanctioned backup or collection tooling to %global_allowed_backup_processes and %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Remove ProgramData from the path regex if it is too noisy in a given environment."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta)\.exe$/ nocase
    $file.target.file.full_path = /\\(\$recycle\.bin|perflogs|programdata|users\\public|windows\\temp)\\.*\.(zip|rar|7z|cab|tar|gz|tgz|bz2)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1074")
    $primary_entity = array_distinct($file.principal.hostname)
    $user = array_distinct($file.principal.user.userid)
    $staged_file = array_distinct($file.target.file.full_path)
    $initiating_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
