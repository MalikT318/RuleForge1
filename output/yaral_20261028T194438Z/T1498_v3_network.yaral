/*
  MITRE Technique : T1498 - Network Denial of Service
  Tactic(s)       : Impact
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:08:24.155951+00:00
  Reference       : https://attack.mitre.org/techniques/T1498
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_Inbound_Volumetric_Flow_To_Windows_Service {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a single firewall flow record from an external source carrying an extreme byte volume toward ports commonly exposed by Windows hosts (HTTP/S, DNS, SMB, RDP, WinRM). This pattern is characteristic of a volumetric network denial-of-service attempt that exhausts bandwidth or service capacity."
    mitre_tactic = "Impact"
    mitre_technique = "T1498"
    mitre_technique_name = "Network Denial of Service"
    log_prerequisites = "Requires firewall or perimeter flow logs normalised to NETWORK_FLOW with principal.ip, target.ip, target.port and network.sent_bytes populated. Flow records must be exported at session end or at periodic intervals so that bytes are accumulated per record."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Large legitimate inbound transfers such as backup replication from cloud providers, OS and software update distribution, partner or CDN bulk data pushes, load tests and penetration tests, and long-lived RDP or SMB sessions from VPN concentrators with external-facing addresses."
    tuning_guidance = "Raise or lower the sent_bytes threshold (default 500000000 bytes per flow record) to match the flow export interval and the customer's baseline. Add authorised external sources to %global_allowed_scanners or %global_allowed_mgmt_sources. Adjust the destination port set to the services the customer actually exposes."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    (
      $net.target.port = 53 or
      $net.target.port = 80 or
      $net.target.port = 443 or
      $net.target.port = 445 or
      $net.target.port = 3389 or
      $net.target.port = 5985 or
      $net.target.port = 5986
    )
    $net.network.sent_bytes > 500000000

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1498")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
