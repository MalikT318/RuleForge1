/*
  MITRE Technique : T1114.003 - Email Forwarding Rule
  Tactic(s)       : Collection
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:21:22.965259+00:00
  Reference       : https://attack.mitre.org/techniques/T1114/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_003_Outlook_Rules_Wizard_File_Dropped {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of an Outlook Rules Wizard (.rwz) file by a process other than Outlook itself. A .rwz file is the portable artifact used to import mailbox rules, including forward and redirect rules. A script, archive tool, browser or remote-access process writing one to disk is consistent with an adversary staging a forwarding rule for import into a compromised mailbox. The rule works at the file-artifact layer, so it does not depend on command-line logging."
    mitre_tactic = "Collection"
    mitre_technique = "T1114.003"
    mitre_technique_name = "Email Collection: Email Forwarding Rule"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) normalised to UDM FILE_CREATION with principal.process.file.full_path and target.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or help desk staff deploying standard mailbox rules through scripts or RMM tooling, users saving rule backups through a file manager or sync client, migration tools moving mailbox rules, and browsers downloading .rwz files shared internally."
    tuning_guidance = "Add approved deployment or migration binaries to %global_allowed_admin_tools. Add help desk or migration accounts to %global_allowed_admin_users. Add service accounts that legitimately stage rule files to %global_allowed_service_accounts. Raise severity if the file is created in a temp or download directory by a script host or browser."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.rwz$/ nocase
    not $file.principal.process.file.full_path = /\\outlook\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1114.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $user = array_distinct($file.principal.user.userid)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $rule_file_path = array_distinct($file.target.file.full_path)

  condition:
    $file
}
