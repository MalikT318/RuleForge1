/*
  MITRE Technique : T1053.005 - Scheduled Task
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:16:40.342061+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_005_Scheduler_Spawned_Process_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound connection to a non-internal address made by a script interpreter, LOLBin or binary in a user-writable path whose parent is the Windows Task Scheduler engine (the Schedule service host, taskeng or taskhostw). This is the network footprint of a scheduled task used for persistence or recurring C2 beaconing, and it complements process-creation rules by observing task execution from the network side."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.005"
    mitre_technique_name = "Scheduled Task/Job: Scheduled Task"
    log_prerequisites = "Requires endpoint network telemetry (EDR or Sysmon Event ID 3) that populates the initiating process and its parent process path or command line."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate scheduled tasks that run PowerShell or cmd to reach external update, licensing or telemetry services; software updaters that run from ProgramData via a scheduled task; RMM and patching tasks; backup agents calling cloud endpoints."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools or %global_allowed_security_tools, known-good destinations to %global_allowed_domains, and hosts that legitimately run scheduled scripts to %global_allowed_script_hosts. If the parent process is not populated for a client's EDR, validate coverage before deploying."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname != ""

    // Parent is the Task Scheduler engine
    (
      $net.principal.process.parent_process.file.full_path = /\\(taskeng|taskhostw)\.exe$/ nocase or
      $net.principal.process.parent_process.command_line = /-s\s+schedule\b/ nocase
    )

    // Child is an interpreter/LOLBin, or runs from a user-writable location
    (
      $net.principal.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|msiexec|installutil|regasm|regsvcs|msbuild)\.exe$/ nocase or
      $net.principal.process.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop)|programdata|windows\\temp|users\\public)\\.*\.(exe|dll|scr)$/ nocase
    )

    // External destinations only
    not $net.target.ip in %rfc1918_internal
    $net.target.ip != ""

    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1053.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $initiating_command_line = array_distinct($net.principal.process.command_line)
    $scheduler_parent = array_distinct($net.principal.process.parent_process.file.full_path)

  condition:
    $net
}
