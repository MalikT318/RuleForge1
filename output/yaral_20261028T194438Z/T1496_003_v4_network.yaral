/*
  MITRE Technique : T1496.003 - SMS Pumping
  Tactic(s)       : Impact
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:56:09.951424+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_003_External_OTP_SMS_Endpoint_Request {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP POST from an external source address to a web path that triggers an SMS one-time-passcode or phone-verification message. Unauthenticated verification endpoints are the usual entry point for SMS pumping fraud. Because this is a single-event rule, each hit is one SMS-triggering request. Triage by counting hits per source address in the SIEM, or promote to a Threshold rule once a per-tenant baseline exists."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.003"
    mitre_technique_name = "Resource Hijacking: SMS Pumping"
    log_prerequisites = "Requires web application, API gateway, WAF or CDN HTTP request logs normalised to NETWORK_HTTP, with principal.ip, target.url and network.http.method populated."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate users signing up or logging in with SMS verification; customer-facing password-reset flows; mobile app onboarding spikes after a marketing campaign; QA and load-testing traffic; authorised vulnerability scanners."
    tuning_guidance = "Add approved test and scan source addresses to %global_allowed_scanners and trusted vendor or partner destinations to %global_allowed_domains. Review the URL regex against each tenant's verification endpoint naming. Once a baseline exists, convert to a Threshold rule grouped by source IP (for example #net >= 10 over 10m) to cut volume."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.url = /\/(otp|sms|send[-_]?(code|otp|sms|verification)|verify[-_]?(phone|mobile|number)|phone[-_]?verif[a-z]*|request[-_]?(code|otp)|mfa\/(sms|enroll)|resend[-_]?(code|otp))/ nocase
    $net.network.http.response_code < 400
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1496.003")
    $primary_entity = array_distinct($net.principal.ip)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)
    $target_hosts = array_distinct($net.target.hostname)

  condition:
    $net
}
