/*
  MITRE Technique : T1547.001 - Registry Run Keys / Startup Folder
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:24:08.632996+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_001_RunKey_Persistence_Network_Beacon_From_Logon_Launched_Binary {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side view of Run key / RunOnce persistence. A binary running from a user-writable location (AppData, ProgramData, Public, Temp) was started by a logon-time launcher (userinit, runonce or explorer) and is making an outbound connection to a non-internal address. This is the typical first callback of a program persisted through a Run key. It complements registry and command-line detections by catching persistence that was set up in ways they miss."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.001"
    mitre_technique_name = "Boot or Logon Autostart Execution: Registry Run Keys / Startup Folder"
    log_prerequisites = "Requires endpoint network telemetry (EDR or Sysmon Event ID 3) that populates principal.process.file.full_path and principal.process.parent_process.file.full_path on NETWORK_CONNECTION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-user installed applications that auto-start at logon and call home (collaboration clients, cloud sync agents, browsers, updaters, VPN clients), line-of-business apps installed under AppData or ProgramData, and RMM agents installed per user."
    tuning_guidance = "Add approved auto-start application executables to %global_allowed_admin_tools or %global_allowed_remote_mgmt, and EDR or AV agents to %global_allowed_security_tools. Add automation accounts to %global_allowed_service_accounts. Extend the executable-name exclusion regex with applications common in the client estate. To reduce volume further, raise severity only when the destination is rare across the estate."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.parent_process.file.full_path = /\\(userinit|runonce|explorer)\.exe$/ nocase
    (
      $net.principal.process.file.full_path = /\\users\\[^\\]+\\appdata\\(roaming|local)\\/ nocase or
      $net.principal.process.file.full_path = /\\programdata\\/ nocase or
      $net.principal.process.file.full_path = /\\users\\public\\/ nocase or
      $net.principal.process.file.full_path = /\\windows\\temp\\/ nocase or
      $net.principal.process.file.full_path = /\\users\\[^\\]+\\(downloads|desktop)\\/ nocase
    )
    not $net.principal.process.file.full_path = /\\(chrome|msedge|firefox|brave|teams|ms-teams|onedrive|slack|zoom|code|discord|spotify|dropbox|msteams|outlook|squirrel|update)\.exe$/ nocase
    not $net.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1547.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $parent_path = array_distinct($net.principal.process.parent_process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
