/*
  MITRE Technique : T1566.001 - Spearphishing Attachment
  Tactic(s)       : Initial Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:47:35.113305+00:00
  Reference       : https://attack.mitre.org/techniques/T1566/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1566_001_Office_WebDAV_Client_Fetches_Payload_From_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office or WebDAV client user agent retrieving an executable, script, disk image, shortcut, archive or macro-enabled document from an external destination, as seen in proxy or perimeter HTTP logs. This is the network-side footprint of a malicious email attachment or linked document pulling its second-stage payload or opening a remote file share. It uses no endpoint process fields."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1566.001"
    mitre_technique_name = "Phishing: Spearphishing Attachment"
    log_prerequisites = "Requires proxy or firewall HTTP logs normalised to UDM NETWORK_HTTP with network.http.user_agent and target.url populated. TLS inspection is needed for HTTPS visibility into URLs and user agents."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Office add-ins or templates downloaded from external vendor sites, users opening documents hosted on external collaboration or WebDAV services, software updaters that present an Office-style user agent, and legitimate external SharePoint or WebDAV shares."
    tuning_guidance = "Add known-good external hosts to %global_allowed_domains. Add approved scanners or proxy test sources to %global_allowed_scanners. Narrow or widen the extension list in target.url to suit client file-handling policy. If the proxy does not populate target.hostname, tune on target.url instead."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.user_agent = /(microsoft office|ms-office|Microsoft-WebDAV-MiniRedir|MSOffice|Word\/|Excel\/|PowerPoint\/|Outlook\/)/ nocase
    $http.target.url = /\.(exe|dll|scr|msi|cpl|js|jse|vbs|vbe|wsf|hta|ps1|bat|cmd|lnk|iso|img|vhd|zip|rar|7z|docm|xlsm|pptm|xlam|dotm)([?#].*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1566.001")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
