/*
  MITRE Technique : T1090 - Proxy
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:25:13.997720+00:00
  Reference       : https://attack.mitre.org/techniques/T1090
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1090_Anomalous_Parent_Spawns_Proxy_Tunnel_Utility {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a built-in port-forwarding or tunnelling utility (netsh portproxy, or OpenSSH with dynamic, local or remote forwarding flags) launched by an unexpected parent process such as an Office application, web server, database service or print spooler. These parents should never configure traffic relays, so this lineage points to exploitation or a malicious document establishing a connection proxy."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1090"
    mitre_technique_name = "Proxy"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and child command line populated (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web or database application installers and management plugins that configure port forwarding; IT automation launched via a web-based admin console; developer or support workflows that tunnel from a web-hosted application; Office add-ins used by network administrators (rare)."
    tuning_guidance = "Add legitimate parent process paths to %global_allowed_admin_tools, add trusted hosts or parent processes (for example management consoles or jump hosts) to %global_allowed_script_hosts. If a web server legitimately runs netsh on specific servers, exclude those hosts via %global_allowed_script_hosts rather than editing the parent regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|onenote|msaccess|w3wp|httpd|nginx|php-cgi|tomcat\d*|sqlservr|mysqld|spoolsv)\.exe$/ nocase
    (
      (
        $proc.target.process.file.full_path = /\\netsh\.exe$/ nocase and
        $proc.target.process.command_line = /portproxy\s+add/ nocase
      ) or
      (
        $proc.target.process.file.full_path = /\\ssh\.exe$/ nocase and
        $proc.target.process.command_line = /\s-[DRL]\s*\S/
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1090")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
