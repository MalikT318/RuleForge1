/*
  MITRE Technique : T1600.002 - Disable Crypto Hardware
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:09:15.966338+00:00
  Reference       : https://attack.mitre.org/techniques/T1600/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_002_External_Mgmt_Plane_Access_Network_Device {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects connections from non-internal source addresses to network device management-plane services (SSH, Telnet, TFTP, SNMP, NETCONF-over-SSH). Disabling dedicated crypto hardware (T1600.002) requires privileged management access to the device, usually followed by a configuration change or system image modification (T1601). A firewall or perimeter log does not show the setting change itself, so this rule flags the precondition: management access from sources outside internal address space and outside approved management sources. Treat it as a lead and correlate with device syslog."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1600.002"
    mitre_technique_name = "Weaken Encryption: Disable Crypto Hardware"
    log_prerequisites = "Requires firewall, proxy or perimeter NETWORK_CONNECTION logs with populated principal.ip, target.ip and target.port. Logs must cover traffic destined to network device management interfaces."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Remote administrators or managed-service staff connecting from home or a VPN pool not yet allowlisted; third-party vendor support sessions; external monitoring or SNMP polling platforms; authorised penetration tests and vulnerability scans; internet-wide scanner noise if denied or dropped connections are logged as NETWORK_CONNECTION."
    tuning_guidance = "Add approved administrator, VPN egress, jump host and NMS source addresses to %global_allowed_mgmt_sources. Add authorised scanning sources to %global_allowed_scanners. If dropped connections are logged as NETWORK_CONNECTION, scope the rule to accepted flows through log source configuration. Where possible, restrict to network device management addresses via asset context. Review the port list per customer, for example remove 161 where external SNMP polling is normal."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 69 or
      $net.target.port = 161 or
      $net.target.port = 830
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1600.002")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
