/*
  MITRE Technique : T1567.002 - Exfiltration to Cloud Storage
  Tactic(s)       : Exfiltration
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:58:00.434263+00:00
  Reference       : https://attack.mitre.org/techniques/T1567/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_002_Linux_Large_Upload_To_External_NonBrowser {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a large HTTP PUT or POST upload from an internal host to an external destination, sent by a non-browser client and to a domain outside the known-good list. Servers rarely make bulk uploads to unknown external services with scripted clients, so this pattern fits exfiltration to cloud storage. It works from network-side telemetry and does not depend on endpoint process or command-line data."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567.002"
    mitre_technique_name = "Exfiltration Over Web Service: Exfiltration to Cloud Storage"
    log_prerequisites = "Requires forward proxy, TLS-inspecting firewall, or secure web gateway logs normalised to NETWORK_HTTP with network.http.method, network.sent_bytes and target.hostname populated. Without TLS inspection the method and user agent are not visible and the rule will not fire."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Backup or replication jobs to offsite object storage, CI/CD artifact publishing, log shippers and telemetry agents, package or container registry pushes, approved data-transfer or migration projects, vendor support uploads such as core dumps."
    tuning_guidance = "Add approved cloud storage and vendor domains to %global_allowed_domains. Add proxy-authenticated service accounts to %global_allowed_service_accounts. Raise or lower the 50 MB sent_bytes threshold per client baseline. Scope the rule to Linux server address groups at the client level, because firewall logs do not identify the operating system."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(PUT|POST)$/ nocase
    $net.network.sent_bytes > 52428800
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.network.http.user_agent = /mozilla/ nocase

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1567.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $max_bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
