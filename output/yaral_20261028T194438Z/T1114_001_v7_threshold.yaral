/*
  MITRE Technique : T1114.001 - Local Email Collection
  Tactic(s)       : Collection
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:19:09.381700+00:00
  Reference       : https://attack.mitre.org/techniques/T1114/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_001_Mass_Outlook_Data_File_Creation_By_NonOutlook {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Multiple Outlook data files (.pst, .ost, .nst) are created on one host within ten minutes by a process other than Outlook. A single file creation is routine, but repeated creation by a non-mail process suggests mailbox copying or staging for local email collection."
    mitre_tactic = "Collection"
    mitre_technique = "T1114.001"
    mitre_technique_name = "Email Collection: Local Email Collection"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with the creating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Mailbox migration or archiving tools, backup and imaging software, eDiscovery and PST export utilities, IT staff moving profiles, and Outlook profile rebuilds run by helper processes."
    tuning_guidance = "Add approved backup and imaging executables to %global_allowed_backup_processes and approved migration or IT tooling to %global_allowed_admin_tools. Raise the #file threshold for hosts that run mailbox migrations. Severity scales in outcome when the file count reaches 10 or more."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(pst|ost|nst)$/ nocase
    not $file.principal.process.file.full_path = /\\(outlook|olk|scanpst|searchindexer)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $file_count = count($file.metadata.id)
    $risk_score = max(if($file_count >= 10, 85, 60))
    $mitre_technique_id = array_distinct("T1114.001")
    $primary_entity = array_distinct($host)
    $created_files = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $affected_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
