/*
  MITRE Technique : T1190 - Exploit Public-Facing Application
  Tactic(s)       : Initial Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:36:46.144258+00:00
  Reference       : https://attack.mitre.org/techniques/T1190
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1190_Container_K8s_Anonymous_Sensitive_API_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects an unauthenticated or anonymous identity reaching a sensitive Kubernetes API endpoint (pod exec/attach/portforward, secrets, pod or workload creation, RBAC bindings) from a non-internal source address. This is the typical result of exploiting an exposed or misconfigured Kubernetes API server or kubelet, and it gives initial access to the cluster and its containers. The rule looks at control-plane audit events, not process command lines."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1190"
    mitre_technique_name = "Exploit Public-Facing Application"
    log_prerequisites = "Kubernetes API server audit logging enabled at Metadata level or higher and ingested into Chronicle, normalised to USER_RESOURCE_ACCESS with principal.user.userid, principal.ip and target.url (request URI) populated. Managed-cluster control-plane audit logs must be enabled."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Misconfigured load balancers or proxies that forward requests without credentials; external monitoring or uptime tools probing the API; intentionally enabled anonymous access for specific public endpoints; authentication webhook outages that cause requests to be recorded as unauthenticated; penetration tests."
    tuning_guidance = "Add authorised scanner or test sources to %global_allowed_mgmt_sources. Add approved named administrators to %global_allowed_admin_users. Add legitimate automation identities to %global_allowed_service_accounts. If the cluster API is intentionally reached through an internal NAT or proxy address, confirm that address is covered by the internal-address exclusion or the allowed management sources."

  events:
    $k8s.metadata.event_type = "USER_RESOURCE_ACCESS"
    $k8s.principal.user.userid = /^system:(anonymous|unauthenticated)$/ nocase
    $k8s.target.url = /\/(pods\/[^\/?]+\/(exec|attach|portforward)|secrets|configmaps|serviceaccounts\/[^\/?]+\/token|clusterrolebindings|rolebindings|pods|deployments|daemonsets|cronjobs|jobs)(\/|\?|$)/ nocase
    not $k8s.principal.ip in %rfc1918_internal
    not $k8s.principal.ip in %global_allowed_mgmt_sources
    not $k8s.principal.user.userid in %global_allowed_admin_users
    not $k8s.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1190")
    $primary_entity = array_distinct($k8s.principal.ip)
    $source_user = array_distinct($k8s.principal.user.userid)
    $requested_url = array_distinct($k8s.target.url)
    $target_host = array_distinct($k8s.target.hostname)

  condition:
    $k8s
}
