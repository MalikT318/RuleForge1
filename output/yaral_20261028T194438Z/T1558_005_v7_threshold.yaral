/*
  MITRE Technique : T1558.005 - Ccache Files
  Tactic(s)       : Credential Access
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:49:12.969481+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_005_Ccache_File_Bulk_Access_Linux {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated launches of copy, read, archive or transfer utilities that reference Kerberos credential cache files (krb5cc_*, krb5.ccache) on a single Linux host within 10 minutes. One access is routine; repeated handling suggests ticket theft for Pass-the-Ticket use."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.005"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Ccache Files"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry normalised to UDM PROCESS_LAUNCH with populated command lines."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Kerberos-integrated backup or configuration management agents, admins troubleshooting ticket caches, SSSD/Kerberos health-check scripts, and automation that copies credential caches between jobs. Scripted Kerberos-authenticated workloads (Python, curl with GSSAPI) may also trigger."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools and automation identities to %global_allowed_service_accounts. Raise the #proc threshold on hosts that run Kerberos-heavy batch jobs. Interactive kinit, klist and kdestroy are not matched."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(cp|mv|cat|scp|sftp|rsync|base64|tar|zip|xxd|dd|strings|nc|ncat|socat|curl|wget|openssl|python[0-9.]*|perl|ruby)$/ nocase
    $proc.target.process.command_line = /(krb5cc_|krb5\.ccache|\/krb5cc)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(re.regex($proc.target.process.file.full_path, /(?i)\/(nc|ncat|socat|curl|wget|scp|sftp|rsync)$/), 85, 65))
    $mitre_technique_id = array_distinct("T1558.005")
    $primary_entity = array_distinct($host)
    $event_count = count($proc.metadata.id)
    $users = array_distinct($proc.principal.user.userid)
    $tools = array_distinct($proc.target.process.file.full_path)
    $sample_command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
