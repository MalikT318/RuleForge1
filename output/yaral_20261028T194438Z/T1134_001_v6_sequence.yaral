/*
  MITRE Technique : T1134.001 - Token Impersonation/Theft
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:54:18.211492+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_001_Token_Theft_Handle_Open_Then_SYSTEM_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A process opens a handle to a SYSTEM-level process (winlogon, lsass, services, wininit, spoolsv) and, within 10 minutes on the same host, that same process launches a command interpreter running as SYSTEM even though the launcher is not SYSTEM. This pattern is typical of token duplication and impersonation (DuplicateTokenEx, ImpersonateLoggedOnUser, CreateProcessWithTokenW) used for privilege escalation."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.001"
    mitre_technique_name = "Access Token Manipulation: Token Impersonation/Theft"
    log_prerequisites = "Requires EDR or Sysmon process-access telemetry (Sysmon Event ID 10 or equivalent, normalised to PROCESS_OPEN) and process-launch telemetry with the target user populated (PROCESS_LAUNCH). The principal process PID must be populated on both event types."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Endpoint security agents and EDR sensors not yet in the allowlist, backup and imaging agents, RMM and remote support tools that start SYSTEM shells, software deployment agents, and administrators using sanctioned SYSTEM-context tooling."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools, RMM and deployment binaries to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. If PID reuse causes noise, shorten the window. If principal.user.userid is not populated in your EDR, review how that exclusion behaves."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\(winlogon|lsass|services|wininit|spoolsv)\.exe$/ nocase
    not $open.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|csrss|wininit|services|lsass)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    $open.principal.hostname = $hostname
    $open.principal.process.pid = $pid

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32)\.exe$/ nocase
    $proc.target.user.userid = /^(nt authority\\)?system$/ nocase
    not $proc.principal.user.userid = /^(nt authority\\)?(system|local service|network service)$/ nocase
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname
    $proc.principal.process.pid = $pid

    $open.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $pid over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1134.001")
    $primary_entity = array_distinct($hostname)
    $opened_targets = array_distinct($open.target.process.file.full_path)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $launched_process = array_distinct($proc.target.process.file.full_path)
    $launched_command_lines = array_distinct($proc.target.process.command_line)
    $launcher_user = array_distinct($proc.principal.user.userid)

  condition:
    $open and $proc
}
