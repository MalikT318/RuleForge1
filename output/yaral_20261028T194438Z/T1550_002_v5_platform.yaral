/*
  MITRE Technique : T1550.002 - Pass the Hash
  Tactic(s)       : Lateral Movement
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:39:37.223490+00:00
  Reference       : https://attack.mitre.org/techniques/T1550/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1550_002_NTLM_Network_Logon_Pass_The_Hash {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows network logon (logon type 3) authenticated with NTLM from a different host by a non-machine, non-anonymous account. NTLM network logons are the authentication-level signature of Pass-the-Hash, where a stolen NT hash is replayed without the cleartext password. This rule works on authentication events (Security 4624), so it adds coverage beyond process-creation or command-line rules and still fires if the attacker renames their tooling. The variant is written for Windows because the platform requirement for this request is Windows."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1550.002"
    mitre_technique_name = "Use Alternate Authentication Material: Pass the Hash"
    log_prerequisites = "Windows Security event log 4624 (Audit Logon: Success) from servers and workstations, forwarded and normalised to UDM USER_LOGIN with extensions.auth.mechanism and auth_details populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy applications and devices that only support NTLM, access by IP address instead of hostname (which forces NTLM over Kerberos), file-share and print access from non-domain-joined hosts, vulnerability scanners, RMM and backup agents using NTLM, service accounts on older software."
    tuning_guidance = "Add known NTLM-dependent service accounts to %global_allowed_service_accounts, administrator accounts to %global_allowed_admin_users, scanner hosts to %global_allowed_scanners, and approved management source addresses to %global_allowed_mgmt_sources. Where NTLM is already restricted in the environment, raise severity. Consider forwarding only this rule's hits for admin or privileged accounts first to cut volume."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.extensions.auth.mechanism = "NETWORK"
    $auth.extensions.auth.auth_details = /NTLM/ nocase
    $auth.target.user.userid != ""
    $auth.principal.hostname != $auth.target.hostname
    not $auth.target.user.userid = /\$$/
    not $auth.target.user.userid = /^(anonymous logon|nt authority\\anonymous logon)$/ nocase
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.principal.hostname in %global_allowed_scanners
    not $auth.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1550.002")
    $primary_entity = array_distinct($auth.target.hostname)
    $source_hosts = array_distinct($auth.principal.hostname)
    $source_ips = array_distinct($auth.principal.ip)
    $logon_accounts = array_distinct($auth.target.user.userid)

  condition:
    $auth
}
