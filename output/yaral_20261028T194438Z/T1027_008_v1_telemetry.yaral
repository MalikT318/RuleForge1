/*
  MITRE Technique : T1027.008 - Stripped Payloads
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:50:16.254225+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_008_Linux_Strip_Utility_Modifies_Binary_In_Staging_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a symbol-stripping utility (strip, objcopy, sstrip, eu-strip, llvm-strip) modifying a file in a world-writable or volatile staging directory such as /tmp, /var/tmp or /dev/shm. This is the file-artifact result of stripping symbols from a payload on the host. It is detected from the file-write event and does not depend on command-line logging, so it complements existing process-creation rules."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.008"
    mitre_technique_name = "Obfuscated Files or Information: Stripped Payloads"
    log_prerequisites = "Linux EDR or auditd file telemetry normalised to UDM FILE_MODIFICATION with principal.process.file.full_path and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers or CI jobs that build and strip binaries under /tmp or /dev/shm, package build systems (rpmbuild, dpkg-buildpackage, Docker or container builds), and build or test hosts compiling software in scratch directories."
    tuning_guidance = "Add CI and build service accounts to %global_allowed_service_accounts, and approved build or packaging tooling to %global_allowed_admin_tools. Extend the build-artifact extension exclusion or the staging directory regex to suit local conventions. Consider suppressing known build hosts via %global_allowed_script_hosts."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.principal.process.file.full_path = /\/(strip|objcopy|sstrip|eu-strip|llvm-strip|llvm-objcopy|[a-z0-9_]+-linux-gnu-strip)$/ nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/user\/[0-9]+|var\/run|run\/shm)\// nocase
    not $file.target.file.full_path = /\.(o|a|lo|la|dbg|debug|sym|map|log|tmp)$/ nocase
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.008")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_files = array_distinct($file.target.file.full_path)
    $stripping_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
