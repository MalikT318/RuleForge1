/*
  MITRE Technique : T1600.001 - Reduce Key Space
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:06:09.203730+00:00
  Reference       : https://attack.mitre.org/techniques/T1600/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_001_Network_Device_Weak_Crypto_Config {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change on a firewall or network perimeter device that reduces cryptographic key space: generating RSA/DSA keys with a sub-1024-bit modulus, or selecting NULL, DES, 3DES, RC4 or export-grade encryption for SSH, SSL/TLS or IPsec/IKE. Matches the command pattern, not a vendor-specific payload."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1600.001"
    mitre_technique_name = "Weaken Encryption: Reduce Key Space"
    log_prerequisites = "Requires firewall or network device management-plane audit logs (configuration or command accounting, forwarded by syslog) that Chronicle normalises to SETTING_MODIFICATION with the configuration command text in security_result.description. Command accounting or configuration logging must be enabled on the device."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legacy interoperability changes for old VPN peers or appliances that only support DES/3DES; lab or staging devices; authorised crypto-hardening work that briefly applies a weak setting; automated config-push tools replaying archived configs."
    tuning_guidance = "Add approved network administrators to %global_allowed_admin_users and automation or config-push accounts to %global_allowed_service_accounts. If a customer has a documented legacy VPN exception, scope it by account or change window rather than loosening the regex. If the customer's parser puts the command text in another UDM field, adjust the field reference."

  events:
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    (
      $cfg.security_result.description = /crypto\s+key\s+generate\s+(rsa|dsa)\b.*\b(modulus|size|bits)\s+[1-9]\d{0,2}\b/ nocase or
      $cfg.security_result.description = /\b(encryption|encr|cipher|ciphers|esp)\s+([\w-]+\s+)*?(null|des|3des|rc4|esp-null|esp-des|esp-3des|export)\b/ nocase
    )
    not $cfg.principal.user.userid in %global_allowed_admin_users
    not $cfg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1600.001")
    $primary_entity = array_distinct(strings.coalesce($cfg.target.hostname, $cfg.principal.hostname))
    $acting_user = array_distinct($cfg.principal.user.userid)
    $config_command = array_distinct($cfg.security_result.description)

  condition:
    $cfg
}
