/*
  MITRE Technique : T1115 - Clipboard Data
  Tactic(s)       : Collection
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:22:58.441945+00:00
  Reference       : https://attack.mitre.org/techniques/T1115
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1115_PowerShell_Clipboard_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a PowerShell host launched with a command line that reads the Windows clipboard (Get-Clipboard, its gcb alias, or the .NET Windows.Forms.Clipboard getter methods). Reading the clipboard from a command line is the most direct way for an adversary to collect copied data such as passwords, tokens and sensitive text. It is rarely needed in normal administration."
    mitre_tactic = "Collection"
    mitre_technique = "T1115"
    mitre_technique_name = "Clipboard Data"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with full command-line capture (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled). Clipboard reads inside script files or encoded commands are only visible if the decoded command line or script-block content is logged."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or helpdesk staff using Get-Clipboard interactively, user productivity or automation scripts that read pasted input, developer tooling and IDE terminals, and RMM or deployment scripts that handle clipboard content."
    tuning_guidance = "Add approved parent tools or script launchers to %global_allowed_admin_tools or %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts. If a legitimate script triggers the rule repeatedly, scope the exclusion to its parent process rather than loosening the command-line regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|powershell_ise)\.exe$/ nocase
    $proc.target.process.command_line = /(get-clipboard|(^|[\s;|(&])gcb([\s;|)]|$)|windows\.forms\.clipboard\]?\s*::\s*(gettext|getdataobject|getimage|getfiledroplist|getaudiostream))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1115")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
