/*
  MITRE Technique : T1505 - Server Software Component
  Tactic(s)       : Persistence
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:23:51.815076+00:00
  Reference       : https://attack.mitre.org/techniques/T1505
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_ESXi_Web_Component_File_Written {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of script or web-executable files inside the ESXi host web service tree (hostd docroot, host client UI, vSAN perfsvc), or a new file in the reverse-proxy configuration directory. This is the file-level result of an adversary installing a web shell or malicious server component for persistence, whether it was dropped by hand, via a VIB, or by a script. It does not depend on command-line logging."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505"
    mitre_technique_name = "Server Software Component"
    log_prerequisites = "ESXi file-integrity or file-audit telemetry normalised to UDM FILE_CREATION with target.file.full_path populated, for example from a host agent or syslog forwarding of file-change auditing. Basic hostd, vmkernel or shell syslog alone may not report file creation."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Legitimate patching or upgrades (VIB or offline bundle installs, esxcli software profile update), vendor driver or plugin installs, vSphere Lifecycle Manager remediation, host client or vSAN health component updates, and administrator-approved certificate or proxy configuration changes."
    tuning_guidance = "Add approved installer and patching process paths to %global_allowed_admin_tools. Add change-window administrator or service accounts to %global_allowed_admin_users or %global_allowed_service_accounts. If file telemetry lacks a principal process, rely on user-based exclusions. During scheduled patch windows, suppress alerts per host through the SOAR playbook rather than widening the path regex."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    (
      (
        $file.target.file.full_path = /^\/usr\/lib\/vmware\/(hostd\/docroot|ui|vsan\/perfsvc)\// nocase and
        $file.target.file.full_path = /\.(py|pyc|sh|pl|cgi|php|jsp|jspx|asp|aspx|html|htm|js)$/ nocase
      ) or
      $file.target.file.full_path = /^\/etc\/vmware\/rhttpproxy\/[^\/]+$/ nocase
    )
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1505")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)
    $acting_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
