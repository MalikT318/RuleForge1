/*
  MITRE Technique : T1137.004 - Outlook Home Page
  Tactic(s)       : Persistence
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:18:55.776394+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_004_Outlook_Spawns_Script_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Outlook process spawning a shell, script interpreter, or script-capable LOLBin. A malicious Outlook Home Page is rendered by Outlook's embedded HTML engine and can execute script that launches child processes from outlook.exe. Outlook rarely launches these binaries in normal use, so this lineage is a strong persistence and execution indicator."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.004"
    mitre_technique_name = "Office Application Startup: Outlook Home Page"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with parent process path (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing) normalised to UDM PROCESS_LAUNCH."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Outlook add-ins (CRM, ticketing, archiving, e-signature, or DLP plugins) that shell out to cmd or PowerShell; helpdesk or admin scripts launched from Outlook macros; software deployment or repair actions triggered from within Outlook; users opening script attachments that are handed off to wscript or mshta."
    tuning_guidance = "Add legitimate child binaries to %global_allowed_admin_tools and approved parent processes to %global_allowed_script_hosts. Add service or automation accounts to %global_allowed_service_accounts. Review the add-in that spawned the process, and if it is legitimate, allowlist it per client rather than loosening the child-process regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\outlook\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|wmic|bitsadmin|certutil|msbuild|installutil|regasm|regsvcs)\.exe$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1137.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
