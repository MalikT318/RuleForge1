/*
  MITRE Technique : T1029 - Scheduled Transfer
  Tactic(s)       : Exfiltration
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:50:13.143381+00:00
  Reference       : https://attack.mitre.org/techniques/T1029
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1029_Offhours_Large_External_Transfer_Firewall {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a large outbound transfer to an external destination during off-hours (00:00-05:59 UTC) as seen by the network perimeter. Scheduled exfiltration (T1029) is often timed for quiet periods to blend with normal activity. The rule uses only perimeter-observable data (direction, volume, timing, destination) and no endpoint process fields."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1029"
    mitre_technique_name = "Scheduled Transfer"
    log_prerequisites = "Firewall or proxy flow/connection logs normalised to UDM NETWORK_FLOW with network.sent_bytes populated and an accurate event timestamp."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Scheduled offsite or cloud backups, OS and software update distribution, cloud file sync (OneDrive, SharePoint), log shipping to SIEM or SaaS, overnight batch or ETL jobs, and clients in time zones where 00:00-05:59 UTC is business hours."
    tuning_guidance = "Add known-good external destinations (backup vendors, update CDNs, SaaS sync endpoints) to %global_allowed_domains. Adjust the sent_bytes threshold (50 MB) to the client's baseline. Shift the off-hours window to the client's local night, or pass a time zone to timestamp.get_hour(). Pair with an ingestion-time enrichment if destination hostnames are not populated."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    $net.network.sent_bytes > 52428800
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    timestamp.get_hour($net.metadata.event_timestamp.seconds, "UTC") >= 0
    timestamp.get_hour($net.metadata.event_timestamp.seconds, "UTC") <= 5

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1029")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
