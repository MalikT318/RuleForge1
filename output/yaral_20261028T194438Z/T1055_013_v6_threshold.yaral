/*
  MITRE Technique : T1055.013 - Process Doppelgänging
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:02:23.487901+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_013_Process_Doppelganging_Repeated_Cross_Process_Injection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated cross-process injection or process-tampering events on a single host within ten minutes. Process Doppelgänging (TxF abuse) maps a transacted file section into a new process image, so telemetry shows a process whose image does not match its backing file. A single event is often benign, but several from non-allowlisted sources on one host indicate injection tradecraft. This complements PROCESS_LAUNCH command-line rules by using injection and tampering telemetry."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.013"
    mitre_technique_name = "Process Injection: Process Doppelganging"
    log_prerequisites = "Requires Windows endpoint telemetry that normalises process injection or process tampering into PROCESS_INJECTION events, e.g. EDR memory and process-tampering sensors, or Sysmon process-tampering and remote-thread events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "EDR/AV agents and DLP or application-control products that hook processes; backup and imaging software; software protection, anti-cheat and DRM; accessibility and UI automation tools; developer debuggers and profilers; application-compatibility shims; RMM and deployment agents."
    tuning_guidance = "Add expected injector binaries to %global_allowed_security_tools, %global_allowed_backup_processes or %global_allowed_admin_tools. Raise the #inj threshold for developer workstations or hosts running debuggers. If the threshold is still noisy, add the host's expected injector to the allowlists rather than raising the threshold tenant-wide."

  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.hostname = $host
    $inj.principal.process.file.full_path != ""
    $inj.target.process.file.full_path = /\.exe$/ nocase
    $inj.principal.process.file.full_path != $inj.target.process.file.full_path
    not $inj.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|SenseCnC|NisSrv)\.exe$/ nocase
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($inj.metadata.id)
    $mitre_technique_id = array_distinct("T1055.013")
    $primary_entity = array_distinct($host)
    $injector_processes = array_distinct($inj.principal.process.file.full_path)
    $target_processes = array_distinct($inj.target.process.file.full_path)
    $affected_users = array_distinct($inj.principal.user.userid)

  condition:
    #inj >= 3
}
