/*
  MITRE Technique : T1016 - System Network Configuration Discovery
  Tactic(s)       : Discovery
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:44:04.519758+00:00
  Reference       : https://attack.mitre.org/techniques/T1016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_ESXi_External_IP_Lookup_Over_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an ESXi host making an outbound HTTP request with a scripted or CLI client (wget, curl, python, busybox) to an external destination. The request path has the shape of a public IP-echo lookup (/ip, /myip, /ifconfig, /whatismyip, /getip, /json, /raw). This is network-side evidence of an adversary working out the host's external address and egress path after a shell session. It complements process command-line detections for esxcli network enumeration."
    mitre_tactic = "Discovery"
    mitre_technique = "T1016"
    mitre_technique_name = "System Network Configuration Discovery"
    log_prerequisites = "Requires outbound HTTP telemetry attributable to the ESXi management IP or hostname, such as proxy, firewall or secure web gateway logs. Both the URL and the user agent must be populated. The host itself must be onboarded under the hypervisor log source."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators running manual connectivity or egress tests from the ESXi shell. Approved patching and update scripts that use wget or curl. Monitoring or inventory scripts that record the host's public address. Lab and staging hosts."
    tuning_guidance = "Add known-good external hosts to %global_allowed_domains. Add approved scripted callers to %global_allowed_admin_tools. Add known automation identities to %global_allowed_service_accounts. Hosts in documented maintenance windows can be suppressed in the SIEM. If your proxy logs lack user-agent data, remove the user-agent condition and rely on the path and destination exclusions."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /^(curl|wget|python|busybox|libwww)/ nocase
    $net.target.url = /^https?:\/\/[^\/]+\/(ip|myip|ifconfig|whatismyip|getip|json|raw)\/?(\?.*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1016")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
