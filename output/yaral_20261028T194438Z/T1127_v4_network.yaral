/*
  MITRE Technique : T1127 - Trusted Developer Utilities Proxy Execution
  Tactic(s)       : Stealth, Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:35:59.453850+00:00
  Reference       : https://attack.mitre.org/techniques/T1127
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1127_Dev_Utility_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a trusted developer or debugging utility (MSBuild, C#/VB/JScript compilers, Roslyn scripting host, command-line debuggers, DNX) initiating an outbound connection to a non-internal address. These utilities normally compile or debug local code and rarely talk to the internet. An external connection suggests they are proxying execution of a remotely staged payload or acting as a C2 channel. This is network-side coverage that complements existing process-creation and command-line detections."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1127"
    mitre_technique_name = "Trusted Developer Utilities Proxy Execution"
    log_prerequisites = "Requires endpoint network telemetry with process attribution (EDR network events or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developer workstations and build servers where MSBuild restores NuGet packages or fetches SDKs; CI/CD build agents; Visual Studio and debugger symbol-server downloads (cdb/windbg/ntsd); software installers invoking MSBuild or csc."
    tuning_guidance = "Add build agents and approved developer tooling parent binaries to %global_allowed_admin_tools. Add package and symbol repositories (NuGet, Microsoft symbol servers) to %global_allowed_domains. Consider scoping the rule to non-developer assets, or lowering severity on developer and build hosts, per client."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(msbuild|csc|vbc|jsc|rcsi|csi|dnx|cdb|ntsd|windbg|kd)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1127")
    $primary_entity = array_distinct($net.principal.hostname)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $process_command_line = array_distinct($net.principal.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
