/*
  MITRE Technique : T1055.004 - Asynchronous Procedure Call
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:51:29.627450+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_004_APC_Injection_Silent_Process_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external network connection initiated by a built-in Windows utility that has no legitimate reason to communicate with the internet (notepad, calc, mspaint, wordpad, charmap, winver, on-screen keyboard, snipping tool). Early Bird and other APC injection variants commonly create such a benign process in a suspended state, queue shellcode to its main thread, and let the hollowed host beacon to command-and-control. The rule observes the network-side result of the injection rather than the injection API calls or process command lines."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.004"
    mitre_technique_name = "Process Injection: Asynchronous Procedure Call"
    log_prerequisites = "Requires endpoint network telemetry that records the initiating process path (EDR or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated. The %rfc1918_internal reference list must be populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Modern Store-packaged versions of Notepad, Calculator (currency conversion) and Paint (cloud AI features) may contact Microsoft services for updates, telemetry or licensing. Help links or Open With flows in WordPad may reach the internet. Security agents and sandbox or detonation hosts that launch these utilities. Proxy-forwarded traffic may show unusual target IPs."
    tuning_guidance = "Add known-good Microsoft destination domains to %global_allowed_domains if domain telemetry is joined, and add approved agents to %global_allowed_security_tools. Extend or trim the utility list in the regex for the client environment. Add sandbox or malware-analysis hosts to %global_allowed_scanners. Consider raising severity for servers where these utilities are rarely run interactively."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(notepad|calc|calculatorapp|mspaint|wordpad|write|charmap|winver|osk|snippingtool|magnify|narrator)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1055.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $source_user = array_distinct($net.principal.user.userid)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
