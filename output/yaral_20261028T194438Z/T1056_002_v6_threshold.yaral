/*
  MITRE Technique : T1056.002 - GUI Input Capture
  Tactic(s)       : Collection, Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:48:21.858319+00:00
  Reference       : https://attack.mitre.org/techniques/T1056/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1056_002_Linux_Repeated_Credential_Dialog_Prompts {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated launches of GUI or TUI dialog utilities on one Linux host within ten minutes, with options that render masked password entry fields. A single prompt is usually benign, but repeated masked-input prompts suggest a malicious script spoofing an authentication dialog until the user enters credentials."
    mitre_tactic = "Collection, Credential Access"
    mitre_technique = "T1056.002"
    mitre_technique_name = "Input Capture: GUI Input Capture"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records with full command-line arguments, normalised to UDM PROCESS_LAUNCH."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate desktop helper scripts that prompt for a password (sudo askpass wrappers, VPN or disk-unlock helpers, installer scripts), admin provisioning scripts using dialog or whiptail, and users repeatedly mistyping a password into a legitimate prompt."
    tuning_guidance = "Add approved askpass and provisioning parent binaries to %global_allowed_admin_tools, approved wrapper hosts or parents to %global_allowed_script_hosts, and automation accounts to %global_allowed_service_accounts. Raise the #proc threshold in noisy environments such as developer workstations."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(zenity|kdialog|yad|whiptail|dialog|Xdialog)$/ nocase
    $proc.target.process.command_line = /(--password|--newpassword|--passwordbox|--hide-text|--insecure|:H(\s|$|:))/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1056.002")
    $primary_entity = array_distinct($host)
    $affected_users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)

  condition:
    #proc >= 3
}
