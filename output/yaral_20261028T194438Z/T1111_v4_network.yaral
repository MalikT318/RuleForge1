/*
  MITRE Technique : T1111 - Multi-Factor Authentication Interception
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:11:13.894605+00:00
  Reference       : https://attack.mitre.org/techniques/T1111
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1111_Linux_Auth_Process_External_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux authentication-handling process (sshd, login, su, sudo, unix_chkpwd, display-manager greeter) opening an outbound network connection to an external address. These processes handle passwords, PINs and one-time codes but do not normally initiate external connections. Egress from them is characteristic of a trojanized PAM module, a hooked login binary or a credential/OTP interceptor sending captured MFA material to an attacker."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1111"
    mitre_technique_name = "Multi-Factor Authentication Interception"
    log_prerequisites = "Requires Linux endpoint network telemetry (EDR or auditd connect syscall auditing) that populates principal.process.file.full_path and target.ip on NETWORK_CONNECTION events. Populate %rfc1918_internal with loopback and internal ranges if not already present."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "PAM-based MFA modules that call an external cloud MFA or RADIUS service from sshd or login; sshd TCP port forwarding (-L/-D) to external hosts; remote LDAP/Kerberos-backed PAM stacks reaching external identity providers; sudo plugins that phone home for audit logging."
    tuning_guidance = "Add approved MFA/identity endpoints to %global_allowed_domains and approved PAM/MFA agents to %global_allowed_security_tools. Add automation identities to %global_allowed_service_accounts. Ensure %rfc1918_internal includes loopback so sshd local forwarding does not alert. If the client uses a cloud MFA PAM module, expect baseline sshd egress and rely on the domain allowlist."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(sshd|sshd-session|login|su|sudo|unix_chkpwd|gdm-password|lightdm|sddm)$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1111")
    $primary_entity = array_distinct($net.principal.hostname)
    $auth_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
