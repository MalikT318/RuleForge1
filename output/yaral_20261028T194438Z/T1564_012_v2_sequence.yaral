/*
  MITRE Technique : T1564.012 - File/Path Exclusions
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:31:30.222041+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_012_AV_Exclusion_Added_Then_Executable_Dropped {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Microsoft Defender exclusion (path, extension or process) being written to the registry on a host, followed within 10 minutes by creation of an executable or script file in a user-writable staging location on the same host. This sequence indicates an adversary hiding file-based payloads in a scan-excluded location."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.012"
    mitre_technique_name = "File/Path Exclusions"
    log_prerequisites = "Requires EDR or Sysmon registry value-set telemetry (REGISTRY_MODIFICATION) and file creation telemetry (FILE_CREATION) from the same Windows endpoint."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Endpoint management or GPO-driven exclusion deployment followed by software installs or updates; developers or build servers whose tooling is excluded for performance and who then compile binaries into user profile or ProgramData folders; IT admins adding exclusions for line-of-business applications."
    tuning_guidance = "Add RMM, deployment and configuration-management binaries to %global_allowed_admin_tools, security agents to %global_allowed_security_tools, and named admins to %global_allowed_admin_users. Tighten the file-creation location regex if build servers are noisy."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Windows Defender\\Exclusions\\(Paths|Extensions|Processes|TemporaryPaths)/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users
    $reg.principal.hostname = $hostname

    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop)|programdata|windows\\temp|perflogs)\\.+\.(exe|dll|scr|ps1|bat|vbs|hta|js)$/ nocase
    not $file.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $reg.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1564.012")
    $primary_entity = array_distinct($hostname)
    $exclusion_keys = array_distinct($reg.target.registry.registry_key)
    $exclusion_values = array_distinct($reg.target.registry.registry_value_name)
    $registry_writers = array_distinct($reg.principal.process.file.full_path)
    $dropped_files = array_distinct($file.target.file.full_path)
    $dropping_processes = array_distinct($file.principal.process.file.full_path)
    $dropped_file_count = count($file.metadata.id)

  condition:
    $reg and $file
}
