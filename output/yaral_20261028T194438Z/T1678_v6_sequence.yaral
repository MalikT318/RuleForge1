/*
  MITRE Technique : T1678 - Delay Execution
  Tactic(s)       : Stealth
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:25:26.742433+00:00
  Reference       : https://attack.mitre.org/techniques/T1678
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1678_Linux_Shell_Sleep_Then_Temp_Dir_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A shell runs a long sleep (60 seconds or more) and then, on the same host and as the same user, launches a binary from a world-writable staging directory (/tmp, /var/tmp, /dev/shm) within 10 minutes. This pattern is typical of delayed payload execution used to outlast sandbox analysis or separate the drop from the execution."
    mitre_tactic = "Stealth"
    mitre_technique = "T1678"
    mitre_technique_name = "Delay Execution"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry normalised to PROCESS_LAUNCH with populated command line, parent process path, hostname and user fields."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Installers and package post-install scripts that sleep and then run helpers from /tmp; CI/CD build agents and test harnesses; configuration management runs (Ansible, Puppet, Chef) that stage temporary scripts; admin troubleshooting scripts; health-check or retry wrappers."
    tuning_guidance = "Add approved parent shells, hosts or automation to %global_allowed_script_hosts. Add approved deployment and configuration-management binaries to %global_allowed_admin_tools. Exclude build and CI hosts by adding them to %global_allowed_script_hosts. Raise the sleep threshold in the regex or shorten the match window to reduce noise."

  events:
    $sleep.metadata.event_type = "PROCESS_LAUNCH"
    $sleep.target.process.file.full_path = /\/sleep$/ nocase
    $sleep.target.process.command_line = /\bsleep\s+(([6-9][0-9]|[0-9]{3,})s?|[0-9]+(\.[0-9]+)?[mhd])\b/ nocase
    $sleep.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh)$/ nocase
    not $sleep.principal.process.file.full_path in %global_allowed_script_hosts
    $sleep.principal.hostname = $hostname
    $sleep.principal.user.userid = $user

    $exec.metadata.event_type = "PROCESS_LAUNCH"
    $exec.target.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    $exec.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh)$/ nocase
    not $exec.principal.process.file.full_path in %global_allowed_script_hosts
    not $exec.target.process.file.full_path in %global_allowed_admin_tools
    $exec.principal.hostname = $hostname
    $exec.principal.user.userid = $user

    $sleep.metadata.event_timestamp.seconds <= $exec.metadata.event_timestamp.seconds

  match:
    $hostname, $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1678")
    $primary_entity = array_distinct($sleep.principal.hostname)
    $affected_user = array_distinct($sleep.principal.user.userid)
    $sleep_commands = array_distinct($sleep.target.process.command_line)
    $executed_paths = array_distinct($exec.target.process.file.full_path)
    $exec_command_lines = array_distinct($exec.target.process.command_line)
    $exec_count = count($exec.metadata.id)

  condition:
    $sleep and $exec
}
