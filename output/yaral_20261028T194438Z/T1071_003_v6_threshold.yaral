/*
  MITRE Technique : T1071.003 - Mail Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:08:49.879759+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_003_Excessive_External_Mail_Protocol_Connections {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source makes a high volume of connections to external destinations on SMTP, POP3 or IMAP ports (plain and TLS) within ten minutes. One mail connection is benign. Sustained repeated connections from one source can indicate mail protocols being used as a C2 channel or for data exfiltration, a pattern more typical of beaconing than of a normal mail client."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.003"
    mitre_technique_name = "Application Layer Protocol: Mail Protocols"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs that populate principal.ip, target.ip and target.port for outbound sessions, normalised to NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Mail servers and SMTP relays sending outbound mail, multifunction printers and scanners that send scan-to-email, applications and monitoring tools that send alert emails, users with desktop mail clients using IMAP/POP3/SMTP against external providers, and bulk mailers or marketing platforms."
    tuning_guidance = "Add known-good external mail providers and relays to %global_allowed_domains (matched on target.hostname, so it only works where the log populates the destination hostname). Raise the #net threshold in the condition for environments with chatty mail relays. Where the source is a known mail gateway, scope it out with a client-specific exclusion on principal.ip. Alerts scale in risk_score once the connection count reaches 50."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 25 or
      $net.target.port = 465 or
      $net.target.port = 587 or
      $net.target.port = 110 or
      $net.target.port = 995 or
      $net.target.port = 143 or
      $net.target.port = 993
    )
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    $net.principal.ip = $src_ip

  match:
    $src_ip over 10m

  outcome:
    $event_count = count($net.metadata.id)
    $risk_score = max(if($event_count >= 50, 80, 55))
    $mitre_technique_id = array_distinct("T1071.003")
    $primary_entity = array_distinct($src_ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 15
}
