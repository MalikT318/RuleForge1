/*
  MITRE Technique : T1036 - Masquerading
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:56:16.156222+00:00
  Reference       : https://attack.mitre.org/techniques/T1036
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_ESXi_SystemBinaryName_From_NonSystem_Path_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Several processes on one ESXi host within ten minutes executed from writable or datastore locations (temp, scratch, shared memory, home, datastore volumes) while using the filename of a core ESXi daemon or utility. This is a masquerading pattern: a binary is named like a trusted system component but runs from outside the system binary directories. The match uses the executable path and name, not command-line content. One occurrence can be benign; repeated occurrences on a single host are not."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036"
    mitre_technique_name = "Masquerading"
    log_prerequisites = "ESXi shell and hostd process execution logs normalised to UDM PROCESS_LAUNCH with target.process.file.full_path populated, forwarded to Chronicle."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators testing or staging copies of ESXi utilities from a datastore, vendor or driver installers that unpack helper binaries under /tmp or /scratch, patching and lifecycle tooling during upgrades, and backup or monitoring agents that bundle busybox or similarly named helpers."
    tuning_guidance = "Add approved patching and lifecycle tooling to %global_allowed_admin_tools, and named administrators to %global_allowed_admin_users. Raise the threshold on hosts that run frequent upgrade jobs. Narrow the directory list if a client legitimately runs binaries from datastore volumes."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /^\/(tmp|var\/tmp|scratch|dev\/shm|var\/run|root|home|vmfs\/volumes)\/(.*\/)?(hostd|vpxa|fdm|vmkfstools|esxcli|esxcfg-[a-z0-9_-]+|vim-cmd|busybox|sshd|dropbear|crond|syslogd|init|vmtoolsd|vmware-[a-z0-9_-]+|vmkeventd|vobd|rhttpproxy|openwsmand)$/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1036")
    $primary_entity = array_distinct($host)
    $masquerading_paths = array_distinct($proc.target.process.file.full_path)
    $launching_users = array_distinct($proc.principal.user.userid)

  condition:
    #proc >= 3
}
