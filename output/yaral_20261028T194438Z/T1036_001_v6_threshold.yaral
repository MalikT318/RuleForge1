/*
  MITRE Technique : T1036.001 - Invalid Code Signature
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:58:24.989194+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_001_Mass_SystemBinary_Named_Files_Outside_SystemDirs {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several files named after core Windows binaries are written outside the protected OS directories on one host within ten minutes. Writing a single such file is rare but explainable. Several in a short window suggest staging of unsigned lookalike binaries whose names and metadata are copied from signed Microsoft programs, as MetaTwin-style tooling does. Those files fail signature validation but look legitimate to users and tools."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.001"
    mitre_technique_name = "Masquerading: Invalid Code Signature"
    log_prerequisites = "Requires EDR file telemetry or Sysmon Event ID 11 normalised to UDM FILE_CREATION, with full file paths populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "OS servicing and feature-update staging, software installers or packagers that stage copies of system binaries, backup restores, malware analysis or forensic sandboxes, and developers building test images."
    tuning_guidance = "Add approved writer processes (deployment, imaging and patching tools) to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Add service accounts that run image-build jobs to %global_allowed_service_accounts. Raise the #file threshold on build or sandbox hosts, or lower it to 2 for high-value servers."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(svchost|lsass|csrss|services|winlogon|smss|wininit|taskhostw?|spoolsv|conhost|dllhost|rundll32|searchindexer|explorer|werfault|audiodg|dwm|fontdrvhost|sihost|ctfmon|msiexec)\.exe$/ nocase
    not $file.target.file.full_path = /^[a-z]:\\windows\\(system32|syswow64|winsxs|servicing|softwaredistribution|immersivecontrolpanel|systemapps)\\/ nocase
    not $file.target.file.full_path = /^[a-z]:\\windows\\explorer\.exe$/ nocase
    not $file.target.file.full_path = /^[a-z]:\\\$windows\.~(bt|ws)\\/ nocase
    not $file.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|MoUsoCoreWorker|MsMpEng|MsSense|SenseIR|wuauclt|SetupHost)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $file_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1036.001")
    $primary_entity = array_distinct($host)
    $created_paths = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
