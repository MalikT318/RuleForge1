/*
  MITRE Technique : T1546.007 - Netsh Helper DLL
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:08:37.585641+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_007_Netsh_Helper_DLL_Registry_Registration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a write to the Netsh helper DLL registry key (HKLM\\SOFTWARE\\Microsoft\\NetSh), including the WOW6432Node view. A new value here registers a DLL that netsh.exe loads on every execution, giving persistence and possible privilege escalation. The rule works on the registry state change, so it fires whether the value was set with netsh.exe, reg.exe, PowerShell, WMI or a custom binary."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.007"
    mitre_technique_name = "Event Triggered Execution: Netsh Helper DLL"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon registry events, equivalent to Sysmon Event IDs 12/13/14) normalised to UDM REGISTRY_MODIFICATION with target.registry.registry_key populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Third-party VPN clients, network or firewall management agents and network-stack drivers that register their own netsh helper during install or upgrade; OS servicing (TrustedInstaller/TiWorker) when Windows features are added; authorised admin scripts that register netsh helpers."
    tuning_guidance = "Add the approved installer or deployment binary to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. Add automation accounts to %global_allowed_service_accounts. Review the registry value data for non-system paths or unsigned DLLs outside System32. Legitimate built-in helpers use bare file names such as ifmon.dll."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\software\\(wow6432node\\)?microsoft\\netsh(\\|$)/ nocase
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1546.007")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $registry_value_data = array_distinct($reg.target.registry.registry_value_data)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
