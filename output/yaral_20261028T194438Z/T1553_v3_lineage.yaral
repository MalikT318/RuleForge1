/*
  MITRE Technique : T1553 - Subvert Trust Controls
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:58:57.584219+00:00
  Reference       : https://attack.mitre.org/techniques/T1553
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_Trust_Control_Subversion_From_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office application, web server worker, print spooler or database service spawning a shell, script interpreter or certificate utility whose command line subverts trust controls. Examples are installing a root or trusted-publisher certificate, removing Mark-of-the-Web (Zone.Identifier / Unblock-File), or weakening attachment zone-information or WinVerifyTrust policy. Pivots on the anomalous parent-child lineage rather than the action alone."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553"
    mitre_technique_name = "Subvert Trust Controls"
    log_prerequisites = "Requires Windows process launch telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web applications or SQL jobs that legitimately import certificates during deployment, Office macros or add-ins in managed workflows that unblock downloaded files, print-management or document-management software scripting certificate or zone handling, and software installers launched by an Office or web service context."
    tuning_guidance = "Add approved deployment and certificate-management parents to %global_allowed_admin_tools or %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts. Extend or narrow the parent and command-line regexes per client application stack."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|sqlservr|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|certutil|reg)\.exe$/ nocase
    $proc.target.process.command_line = /(certutil.*-addstore.*(root|authroot|trustedpublisher|disallowed|ca)\b|unblock-file|zone\.identifier|savezoneinformation|cert:\\(localmachine|currentuser)\\(root|trustedpublisher|authroot)|import-certificate|import-pfxcertificate|set-authenticodesignature|reg(\.exe)?\s+add.*\\(policies\\(attachments|associations)|wintrust\\trust providers\\software publishing))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1553")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
