/*
  MITRE Technique : T1498.002 - Reflection Amplification
  Tactic(s)       : Impact
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:13:31.589383+00:00
  Reference       : https://attack.mitre.org/techniques/T1498/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_002_Cloud_Firewall_Opened_To_Amplification_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a cloud control-plane change that creates or modifies a network ingress, firewall or security rule for a UDP service commonly abused for reflection amplification (DNS, chargen, NTP, SNMP, CLDAP, SSDP, memcached). Exposing these services makes cloud-hosted instances usable as reflectors in DDoS attacks against third parties."
    mitre_tactic = "Impact"
    mitre_technique = "T1498.002"
    mitre_technique_name = "Network Denial of Service: Reflection Amplification"
    log_prerequisites = "Cloud provider audit logs (control-plane/admin activity) ingested and normalised to UDM with metadata.product_event_type and target.port populated for network rule changes."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate deployment of public DNS, NTP or VoIP/SNMP services; infrastructure-as-code pipelines; network engineers editing rules for internal resolvers; load balancer or managed service provisioning."
    tuning_guidance = "Add IaC pipeline and automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named network administrators to %global_allowed_admin_users. Remove ports from the list that are legitimately exposed in a given client environment (e.g. 53 or 123 for public resolvers or time servers). Consider raising severity when the rule source is open to the internet."

  events:
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.metadata.product_event_type = /(ingress|firewall|securityrule|securitygroup|networkacl)/ nocase
    $cfg.metadata.product_event_type = /(authorize|insert|create|patch|update|write|replace|modify|add)/ nocase
    (
      $cfg.target.port = 53 or
      $cfg.target.port = 19 or
      $cfg.target.port = 123 or
      $cfg.target.port = 161 or
      $cfg.target.port = 389 or
      $cfg.target.port = 1900 or
      $cfg.target.port = 11211
    )
    not $cfg.principal.user.userid in %global_allowed_service_accounts
    not $cfg.principal.user.userid in %global_allowed_cloud_principals
    not $cfg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1498.002")
    $primary_entity = array_distinct($cfg.principal.user.userid)
    $exposed_ports = array_distinct($cfg.target.port)
    $api_actions = array_distinct($cfg.metadata.product_event_type)
    $source_ips = array_distinct($cfg.principal.ip)

  condition:
    $cfg
}
