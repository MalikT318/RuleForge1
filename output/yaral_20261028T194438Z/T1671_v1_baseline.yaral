/*
  MITRE Technique : T1671 - Cloud Application Integration
  Tactic(s)       : Persistence
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:14:22.305043+00:00
  Reference       : https://attack.mitre.org/techniques/T1671
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1671_OAuth_App_Consent_Grant {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an OAuth application consent or delegated permission grant in the tenant (user or admin consent, OAuth2 permission grant, app role assignment, or service principal creation). Adversaries use these grants to persist through an application integration that survives password resets, MFA and account disablement. Grants made by accounts not on the administrator or automation allowlists should be reviewed."
    mitre_tactic = "Persistence"
    mitre_technique = "T1671"
    mitre_technique_name = "Cloud Application Integration"
    log_prerequisites = "Requires Microsoft 365 unified audit log ingestion that includes Azure Active Directory / Entra ID audit events, normalised so the audit operation name is populated in metadata.product_event_type."
    platform = "SaaS"
    log_source = "m365"
    false_positives = "Legitimate IT-led onboarding of approved SaaS integrations, admin consent workflows, users consenting to sanctioned productivity add-ins, automated app provisioning by deployment pipelines, and first-party or vendor application updates that re-request consent."
    tuning_guidance = "Add named administrators who onboard integrations to %global_allowed_admin_users. Add automation and provisioning identities to %global_allowed_service_accounts and approved app-registration service principals to %global_allowed_cloud_principals. Review the target application name in the outcome against the client's approved application inventory. If the client's parser maps consent events to a different UDM event type, adjust metadata.event_type accordingly."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"
    $cloud.metadata.product_event_type = /(?i)(consent to application|add oauth2permissiongrant|add delegated permission grant|add app role assignment (grant )?to service principal|add service principal$|add app role assignment grant to user)/
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1671")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $consent_operation = array_distinct($cloud.metadata.product_event_type)
    $target_application = array_distinct($cloud.target.application)
    $target_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
