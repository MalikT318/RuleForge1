/*
  MITRE Technique : T1014 - Rootkit
  Tactic(s)       : Stealth
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:25:35.879914+00:00
  Reference       : https://attack.mitre.org/techniques/T1014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1014_Linux_LD_SO_Preload_File_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of /etc/ld.so.preload, the file the dynamic linker reads to load shared libraries into every dynamically linked process. Userland rootkits write to it to hook libc calls and hide processes, files and network connections. The rule detects the resulting file state change rather than the command used, so it still fires when command-line logging is evaded or tooling is renamed."
    mitre_tactic = "Stealth"
    mitre_technique = "T1014"
    mitre_technique_name = "Rootkit"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules (for example auditctl -w /etc/ld.so.preload -p wa) normalised to UDM FILE_MODIFICATION events with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate use of /etc/ld.so.preload is rare. Possible sources include system hardening or memory-allocator tooling (for example an allocator or profiler preloaded system-wide), APM or security agents that inject a preload library, and configuration management runs that deploy such libraries."
    tuning_guidance = "Add approved configuration management, deployment or hardening binaries to %global_allowed_admin_tools. Add endpoint security agents that legitimately preload libraries to %global_allowed_security_tools. Add automation accounts to %global_allowed_service_accounts. Where the sensor reports file creation instead of modification, clone the rule with metadata.event_type = FILE_CREATION."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/ld\.so\.preload$/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1014")
    $primary_entity = array_distinct($file.principal.hostname)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $modifying_user = array_distinct($file.principal.user.userid)
    $modified_file = array_distinct($file.target.file.full_path)

  condition:
    $file
}
