/*
  MITRE Technique : T1498.002 - Reflection Amplification
  Tactic(s)       : Impact
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:12:46.096337+00:00
  Reference       : https://attack.mitre.org/techniques/T1498/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_002_Inbound_UDP_Amplification_Response_Firewall {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a single large inbound UDP flow from an external address whose source port is a well-known amplification service (memcached, CLDAP, SSDP, chargen, QOTD, SNMP, portmap, WS-Discovery, NTP, DNS). Replies from third-party reflectors that were never solicited by the internal victim are the network-side signature of a reflection amplification DoS. Byte thresholds are higher for DNS and NTP because those services are commonly used legitimately."
    mitre_tactic = "Impact"
    mitre_technique = "T1498.002"
    mitre_technique_name = "Network Denial of Service: Reflection Amplification"
    log_prerequisites = "Requires firewall or perimeter flow logs normalised to UDM NETWORK_CONNECTION with ip_protocol, principal.ip, principal.port (the reflector's source port), target.ip and network.sent_bytes (bytes from principal to target) populated. Inbound traffic must be logged, including allowed and dropped flows."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate large DNS responses or NTP replies from upstream resolvers and time servers to internal clients, SSDP or WS-Discovery on flat or guest networks, SNMP polling by external monitoring providers, and vulnerability scanners or red-team exercises."
    tuning_guidance = "Add authorised external scanner and monitoring source addresses to %global_allowed_scanners and trusted upstream resolvers or time sources to %global_allowed_mgmt_sources. Raise or lower the byte thresholds to match each client's baseline for DNS and NTP. If the sensor reports bytes in the opposite direction, swap network.sent_bytes for network.received_bytes."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "UDP"
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    (
      (
        (
          $net.principal.port = 11211 or
          $net.principal.port = 389 or
          $net.principal.port = 1900 or
          $net.principal.port = 19 or
          $net.principal.port = 17 or
          $net.principal.port = 161 or
          $net.principal.port = 111 or
          $net.principal.port = 3702
        ) and $net.network.sent_bytes >= 5000
      ) or
      (
        $net.principal.port = 123 and $net.network.sent_bytes >= 10000
      ) or
      (
        $net.principal.port = 53 and $net.network.sent_bytes >= 20000
      )
    )

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1498.002")
    $primary_entity = array_distinct($net.target.ip)
    $reflector_ips = array_distinct($net.principal.ip)
    $reflector_source_ports = array_distinct($net.principal.port)
    $max_flow_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
