/*
  MITRE Technique : T1505.001 - SQL Stored Procedures
  Tactic(s)       : Persistence
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:26:55.065728+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_001_SQL_Server_Drops_Executable_Content {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the SQL Server engine process writing an executable or script file (DLL, EXE, script) into a user-writable or web-accessible location. This is a file-system artefact of xp_cmdshell, OLE automation, CLR assembly export or startup stored procedure abuse. It uses FILE_CREATION telemetry only, so it complements command-line rules on PROCESS_LAUNCH."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.001"
    mitre_technique_name = "Server Software Component: SQL Stored Procedures"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with the writing process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "SQL Server features that legitimately export assemblies or scripts, such as ETL/SSIS packages, SQL Agent maintenance jobs, vendor application installers that use the SQL service to stage files, and DBA-driven deployment of CLR libraries."
    tuning_guidance = "Add hosts that legitimately stage executables or scripts through SQL Server (ETL or deployment servers) to %global_allowed_script_hosts. Narrow the target path regex if a specific application writes to ProgramData or inetpub as part of normal operation."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\sqlservr\.exe$/ nocase
    $file.target.file.full_path = /\.(dll|exe|scr|ps1|psm1|bat|cmd|vbs|vbe|js|jse|hta|aspx|asp|ashx)$/ nocase
    $file.target.file.full_path = /\\(windows\\temp|programdata|users\\[^\\]+\\appdata|users\\public|inetpub|perflogs|temp)\\/ nocase
    not $file.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1505.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_files = array_distinct($file.target.file.full_path)
    $sql_process = array_distinct($file.principal.process.file.full_path)
    $sql_service_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
