/*
  MITRE Technique : T1021.003 - Distributed Component Object Model
  Tactic(s)       : Lateral Movement
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:38:22.489440+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_003_Network_Logon_Then_DCOM_Activated_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a network logon (type 3) to a host followed within 10 minutes by a DCOM-activated COM server process (mmc.exe or an Office application launched with -Embedding) spawning a shell or script interpreter. This pairing is the host-side footprint of remote DCOM lateral movement (MMC20.Application, Office application COM objects). Remote authentication and COM-server child execution are correlated instead of matching only on a command line."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.003"
    mitre_technique_name = "Remote Services: Distributed Component Object Model"
    log_prerequisites = "Requires Windows Security 4624 (logon type 3, normalised to USER_LOGIN with auth mechanism NETWORK) and EDR/Sysmon process-creation telemetry that populates the parent process path and parent command line, both from the same endpoint."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators using MMC snap-ins that launch helper shells while remotely connected; Office automation or add-ins launched by service accounts; software deployment or RMM tooling driving Office or MMC remotely; users working over a remote session who also receive network logons."
    tuning_guidance = "Add approved automation accounts to %global_allowed_service_accounts, approved administration jump hosts to %global_allowed_mgmt_sources, and approved management binaries to %global_allowed_admin_tools. If the EDR does not populate the parent command line, remove the -Embedding condition and rely on the logon join. Widen or narrow the child-process regex per client."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.extensions.auth.mechanism = "NETWORK"
    $auth.target.hostname = $hostname
    not $auth.target.user.userid = /\$$/
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.principal.ip in %global_allowed_mgmt_sources

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(mmc|excel|winword|powerpnt|outlook|visio)\.exe$/ nocase
    $proc.principal.process.command_line = /-Embedding/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $auth.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1021.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $logon_users = array_distinct($auth.target.user.userid)
    $source_ips = array_distinct($auth.principal.ip)
    $dcom_parent_processes = array_distinct($proc.principal.process.file.full_path)
    $spawned_processes = array_distinct($proc.target.process.file.full_path)
    $spawned_command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $auth and $proc
}
