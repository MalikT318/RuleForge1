/*
  MITRE Technique : T1055.015 - ListPlanting
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:05:48.276543+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_015_ListPlanting_Repeated_Handle_Opens_To_ListView_Hosts {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a single host where non-allowlisted processes repeatedly open handles to processes that host list-view (SysListView32) controls, such as the shell, task manager, registry editor and MMC, within 10 minutes. A single handle open is benign, but repeated opens to these windowed processes are consistent with ListPlanting preparation (locating the list-view window, allocating and writing memory, then triggering the sort callback). This is an aggregation of process-access telemetry and does not depend on command-line matching."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.015"
    mitre_technique_name = "Process Injection: ListPlanting"
    log_prerequisites = "Requires EDR or Sysmon-equivalent process-access telemetry (for example Sysmon Event ID 10) normalised to PROCESS_OPEN with principal and target process paths populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Accessibility and screen-reader software, UI automation and test frameworks, remote support and RMM agents, application-compatibility shims, third-party shell extensions or desktop customisation tools, password managers, and unlisted EDR/AV agents opening handles to explorer.exe."
    tuning_guidance = "Add approved EDR/AV agents to %global_allowed_security_tools, RMM and support tooling to %global_allowed_admin_tools or %global_allowed_remote_mgmt, imaging software to %global_allowed_backup_processes, and automation accounts to %global_allowed_service_accounts. Raise the #open threshold on hosts with heavy UI automation. Severity and risk_score increase when the shell is the target."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\(explorer|taskmgr|regedit|mmc|msinfo32|perfmon|control)\.exe$/ nocase
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    $open.principal.hostname = $host
    not $open.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|csrss|wininit|services|lsass|svchost)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($open.target.process.file.full_path = /\\explorer\.exe$/ nocase, 75, 55))
    $event_count = count($open.metadata.id)
    $mitre_technique_id = array_distinct("T1055.015")
    $primary_entity = array_distinct($host)
    $source_processes = array_distinct($open.principal.process.file.full_path)
    $target_processes = array_distinct($open.target.process.file.full_path)

  condition:
    #open >= 5
}
