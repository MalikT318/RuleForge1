/*
  MITRE Technique : T1003.008 - /etc/passwd and /etc/shadow
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:51:22.931589+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_008_Linux_Shadow_File_Read_By_Unexpected_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a file-read event against /etc/shadow, /etc/gshadow or /etc/security/opasswd (including common backup copies) by a process that is not a recognised authentication, account-management or allow-listed component. This is file-access telemetry, not command-line matching, so it still fires when the adversary uses a script, a renamed binary, a language runtime (python, perl) or a custom reader instead of cat or unshadow."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.008"
    mitre_technique_name = "OS Credential Dumping: /etc/passwd and /etc/shadow"
    log_prerequisites = "Linux file-access telemetry that emits FILE_READ events: auditd with a watch rule on /etc/shadow, /etc/gshadow and /etc/security/opasswd (for example: -w /etc/shadow -p r -k shadow_read), or EDR file-read monitoring. Without a watch rule on these paths, no events are produced."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "PAM and authentication helpers not covered by the built-in executable-name exclusion (custom auth daemons, LDAP/SSSD/Kerberos helpers); configuration management and compliance tooling that audits shadow permissions or contents; backup agents; vulnerability and CIS benchmark scanners; identity-sync agents; administrators running a legitimate account audit."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools, %global_allowed_security_tools, %global_allowed_backup_processes and %global_allowed_scanners (matched on principal process path). Add automation accounts to %global_allowed_service_accounts. Extend the executable-name regex with site-specific authentication daemons. Confirm the audit watch rule is deployed on clients, because the rule depends on it."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /^\/etc\/(shadow|gshadow|security\/opasswd)(-|\.bak|\.old|~)?$/ nocase
    $file.principal.process.file.full_path = /.+/
    not $file.principal.process.file.full_path = /\/(sshd|login|su|sudo|passwd|chage|chpasswd|chfn|chsh|newgrp|gpasswd|unix_chkpwd|useradd|usermod|userdel|groupadd|groupmod|groupdel|vipw|vigr|pwck|grpck|pwconv|pwunconv|systemd|systemd-logind|polkitd|crond|cron|atd|gdm|lightdm|sssd|saslauthd|cockpit-session)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_scanners
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1003.008")
    $primary_entity = array_distinct($file.principal.hostname)
    $reading_process = array_distinct($file.principal.process.file.full_path)
    $reading_user = array_distinct($file.principal.user.userid)
    $accessed_file = array_distinct($file.target.file.full_path)

  condition:
    $file
}
