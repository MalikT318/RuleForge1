/*
  MITRE Technique : T1003.005 - Cached Domain Credentials
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:46:09.361590+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_005_Registry_Hive_Dump_File_Writes_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects the built-in registry utility writing several non-.reg files to disk on a single host within ten minutes. Offline hive export (SAM, SYSTEM and SECURITY) is the standard way to get cached domain credentials (MS-Cache v2 under HKLM\\SECURITY\\Cache) for offline extraction. One file write is benign, but a burst of hive-style output files from this utility is not. This rule uses FILE_CREATION telemetry, so it is not a duplicate of command-line matching rules."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.005"
    mitre_technique_name = "OS Credential Dumping: Cached Domain Credentials"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating principal.process.file.full_path, target.file.full_path and principal.hostname."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or backup scripts saving registry hives before maintenance, golden-image and system-state preparation, configuration management exporting registry branches, and forensic or IR collection."
    tuning_guidance = "Add approved admin tooling to %global_allowed_admin_tools and automation or service accounts to %global_allowed_service_accounts. Raise the threshold if hive saves are routine on build or imaging hosts. The threshold of 3 matches a SAM, SYSTEM and SECURITY triple. Risk is raised automatically when the written file name references SECURITY or SAM."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\reg\.exe$/ nocase
    not $file.target.file.full_path = /\.reg$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($file.target.file.full_path = /(?i)(security|sam)/, 90, 70))
    $mitre_technique_id = array_distinct("T1003.005")
    $primary_entity = array_distinct($host)
    $file_count = count($file.metadata.id)
    $files_written = array_distinct($file.target.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
