/*
  MITRE Technique : T1560.002 - Archive via Library
  Tactic(s)       : Collection
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:59:28.974642+00:00
  Reference       : https://attack.mitre.org/techniques/T1560/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1560_002_Unexpected_Parent_Spawns_Archive_Library_Script {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office application, web server, database service or print spooler spawning a shell or script interpreter whose command line references an archive or compression library (.NET System.IO.Compression, Python zipfile/tarfile/shutil/py7zr/rarfile/zlib). Archiving data through a library from an unexpected parent is a strong sign of staged collection after exploitation or macro execution."
    mitre_tactic = "Collection"
    mitre_technique = "T1560.002"
    mitre_technique_name = "Archive Collected Data: Archive via Library"
    log_prerequisites = "Requires Windows EDR or Sysmon process-creation telemetry (Event ID 1 or equivalent) with parent process path and child command line populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web applications or reporting jobs that legitimately build ZIP exports through PowerShell or Python, Office macros or add-ins that package documents, database maintenance jobs that compress backups via script, and print or document-management workflows."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts or %global_allowed_admin_tools. Add known automation accounts to %global_allowed_service_accounts. If a web or database parent legitimately builds archives, exclude it by executable name rather than install path."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat\d*|php-cgi|sqlservr|mysqld|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(powershell|pwsh|python\d*|pythonw|py|cmd|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(System\.IO\.Compression|ZipFile|ZipArchive|CreateFromDirectory|Compress-Archive|zipfile|tarfile|shutil\.make_archive|py7zr|rarfile|pyminizip|zlib|bz2|lzma|gzip)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1560.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
