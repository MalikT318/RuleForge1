/*
  MITRE Technique : T1550.004 - Web Session Cookie
  Tactic(s)       : Lateral Movement
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:42:54.285052+00:00
  Reference       : https://attack.mitre.org/techniques/T1550/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1550_004_Cloud_Login_Reusing_Prior_MFA_Token_External_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a successful cloud control-plane or portal sign-in from an external address where the sign-in record shows that MFA was satisfied by an existing session token or claim rather than a fresh challenge. This is the typical audit trail of a replayed (pass-the-cookie) session. It adds identity-plane coverage for T1550.004 on IaaS, where no endpoint process telemetry exists."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1550.004"
    mitre_technique_name = "Use Alternate Authentication Material: Web Session Cookie"
    log_prerequisites = "Requires identity provider sign-in logs ingested and normalised to UDM USER_LOGIN, with the authentication-requirement detail (for example 'MFA satisfied by claim in the token' or 'previously satisfied') mapped into security_result.summary or security_result.description, and with principal.ip populated."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Legitimate users on SSO sessions who roam between networks (home, mobile, hotel Wi-Fi), corporate VPN or proxy egress addresses not in the internal list, browsers restoring long-lived sessions, and zero-trust or secure web gateway egress."
    tuning_guidance = "Add known corporate egress and VPN addresses to %global_allowed_mgmt_sources. Add automation identities to %global_allowed_service_accounts and break-glass or named administrators to %global_allowed_admin_users. Tenants whose logs do not map token-claim MFA detail will not match, so confirm the field mapping before deploying. For higher fidelity, tighten the target.application pattern to the management portals and consoles in use."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    (
      $auth.security_result.summary = /(mfa|multi.?factor).{0,60}(claim|token|previously satisfied|satisfied by|existing session)/ nocase or
      $auth.security_result.description = /(mfa|multi.?factor).{0,60}(claim|token|previously satisfied|satisfied by|existing session)/ nocase
    )
    $auth.target.application = /(console|portal|management|admin|azure|cloud)/ nocase
    $auth.principal.ip != ""
    not $auth.principal.ip in %rfc1918_internal
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1550.004")
    $primary_entity = array_distinct($auth.target.user.userid)
    $source_ips = array_distinct($auth.principal.ip)
    $target_apps = array_distinct($auth.target.application)
    $user_agents = array_distinct($auth.network.http.user_agent)

  condition:
    $auth
}
