/*
  MITRE Technique : T1535 - Unused/Unsupported Cloud Regions
  Tactic(s)       : Stealth
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:33:53.445335+00:00
  Reference       : https://attack.mitre.org/techniques/T1535
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1535_Compute_Created_In_Uncommon_Cloud_Region {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of compute or container resources (virtual machines, functions, clusters) in cloud regions that are disabled by default or rarely used, by an identity not on the approved lists. Adversaries launch resources in regions customers do not monitor to evade detection or to run resource-hijacking workloads such as cryptocurrency mining."
    mitre_tactic = "Stealth"
    mitre_technique = "T1535"
    mitre_technique_name = "Unused/Unsupported Cloud Regions"
    log_prerequisites = "Requires cloud control-plane audit logs ingested and normalised to UDM as RESOURCE_CREATION. The region must be populated in target.location.name and the API operation name in metadata.product_event_type. Management-event logging must be enabled in all regions, not only the regions in use."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate expansion into a new region for latency or compliance, disaster-recovery tests, multi-region infrastructure-as-code pipelines, cloud-native security or cost-management tooling that provisions probes in every region, and customers whose workloads genuinely run in one of the listed regions."
    tuning_guidance = "Add approved IaC pipelines, automation roles and service accounts to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named administrators to %global_allowed_admin_users. For customers who legitimately operate in a listed region, remove that region from the regex or add the approved identities to the exclusion lists. Consider raising severity for regions the customer has never used."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /(RunInstances|CreateFunction|CreateCluster|CreateNodegroup|CreateVirtualMachine|virtualMachines\.write|instances\.insert|CreateService|CreateAutoScalingGroup|CreateFleet)/ nocase
    $cloud.target.location.name = /^(af-south-1|ap-east-1|ap-south-2|ap-southeast-[3-7]|eu-south-[12]|eu-central-2|me-south-1|me-central-1|il-central-1|ca-west-1|mx-central-1|africa-south1|me-west1|me-central[12]|southamerica-west1|australia-southeast2|southafricanorth|southafricawest|uaenorth|uaecentral|qatarcentral|israelcentral|brazilsoutheast|switzerlandwest|norwaywest|germanynorth|francesouth|koreasouth|jioindiacentral|jioindiawest)$/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1535")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $region = array_distinct($cloud.target.location.name)
    $api_call = array_distinct($cloud.metadata.product_event_type)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
