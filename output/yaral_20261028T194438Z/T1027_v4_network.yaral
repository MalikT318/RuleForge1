/*
  MITRE Technique : T1027 - Obfuscated Files or Information
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:36:54.395346+00:00
  Reference       : https://attack.mitre.org/techniques/T1027
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_Linux_IPS_Packed_Payload_Download_NonBrowser {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux host using a command-line or scripting HTTP client (non-browser user agent) to fetch a packed, encoded or encrypted payload container from an external destination. The URL is requested with a payload-container extension such as base64, enc, xz, 7z, bz2, zst, lzma, gpg, aes, pack or bin. This is the in-transit side of obfuscated or compressed payload staging, and is additive to endpoint command-line detections."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027"
    mitre_technique_name = "Obfuscated Files or Information"
    log_prerequisites = "IDS/IPS or inline network security appliance logs that populate NETWORK_HTTP with network.http.user_agent, target.url and principal.hostname. TLS inspection is needed to see URLs on HTTPS traffic."
    platform = "Linux"
    log_source = "ips"
    false_positives = "Package and software mirrors serving .xz, .bz2 or .zst archives; configuration management and patching agents; backup or deployment scripts; developers downloading release archives or firmware images with curl or wget; container and image build pipelines."
    tuning_guidance = "Add known vendor and mirror domains to %global_allowed_domains. Add patching, deployment and automation tooling hosts to %global_allowed_script_hosts and %global_allowed_admin_tools. Add authorised test sources to %global_allowed_scanners. Narrow or widen the extension list per client baseline."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.user_agent = /^(curl|wget)\/|python-requests|python-urllib|libwww-perl|go-http-client|aiohttp|okhttp/ nocase
    $http.target.url = /\.(b64|base64|enc|xz|7z|bz2|zst|lzma|gpg|aes|pack|packed|bin)(\?.*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_script_hosts
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027")
    $primary_entity = array_distinct($http.principal.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
