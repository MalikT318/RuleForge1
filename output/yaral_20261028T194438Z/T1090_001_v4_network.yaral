/*
  MITRE Technique : T1090.001 - Internal Proxy
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:27:29.183033+00:00
  Reference       : https://attack.mitre.org/techniques/T1090/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1090_001_Internal_Proxy_Port_Connection_By_Script_Or_UserPath_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows host where a script interpreter, LOLBin, or user-writable-path process opens a network connection to an internal address on a port commonly used for SOCKS or HTTP proxies and port relays (1080, 3128, 8080, 8888, 8118, 9050). This is the hop-to-hop behaviour of an internal proxy or port redirector used to chain C2 traffic between compromised systems. Internal address space is matched positively with %rfc1918_internal because the internal hop is the behaviour of interest. Browsers and allow-listed management, security, and script-host sources are excluded."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1090.001"
    mitre_technique_name = "Proxy: Internal Proxy"
    log_prerequisites = "Requires endpoint network telemetry (EDR or Sysmon Event ID 3 equivalent) populating principal.process.file.full_path, target.ip, and target.port on NETWORK_CONNECTION events. Reference list %rfc1918_internal must be populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developers and admins using PowerShell or scripts against internal web proxies or dev servers on 8080/8888; software running from ProgramData or user profile folders that talks to internal proxies (updaters, collaboration clients, VPN clients); internal automation or monitoring scripts calling internal web APIs on proxy-style ports; PowerShell-based management tooling."
    tuning_guidance = "Add approved management agents and RMM tools to %global_allowed_admin_tools or %global_allowed_remote_mgmt. Add EDR and AV agents to %global_allowed_security_tools. Add build servers, jump hosts, and automation hosts to %global_allowed_script_hosts. If the corporate forward proxy is on one of the listed ports, remove that port from the rule or allow-list the client processes. Adjust the port set to match client environments."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.ip in %rfc1918_internal
    (
      $net.target.port = 1080 or
      $net.target.port = 1081 or
      $net.target.port = 3128 or
      $net.target.port = 8080 or
      $net.target.port = 8118 or
      $net.target.port = 8888 or
      $net.target.port = 9050
    )
    (
      $net.principal.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32|msiexec|certutil|bitsadmin)\.exe$/ nocase or
      $net.principal.process.file.full_path = /\\users\\[^\\]+\\(appdata|downloads|desktop|documents)\\/ nocase or
      $net.principal.process.file.full_path = /\\(programdata|temp)\\/ nocase
    )
    not $net.principal.process.file.full_path = /\\(chrome|msedge|firefox|iexplore|brave|opera)\.exe$/ nocase
    not $net.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|NisSrv)\.exe$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1090.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $internal_destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_process_paths = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
