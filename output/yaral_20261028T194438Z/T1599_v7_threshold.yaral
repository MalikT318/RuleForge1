/*
  MITRE Technique : T1599 - Network Boundary Bridging
  Tactic(s)       : Defense Impairment
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:01:06.944818+00:00
  Reference       : https://attack.mitre.org/techniques/T1599
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1599_Untrusted_To_Internal_Mgmt_Port_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single non-internal source opens a burst of connections to management-plane ports (SSH, Telnet, SNMP, NETCONF, alternate HTTPS admin) on internal addresses within ten minutes. Individually these connections are benign. In volume, they indicate that a boundary device policy has been bypassed or reconfigured, or that a compromised perimeter device is being used to bridge the untrusted-to-trusted network boundary."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1599"
    mitre_technique_name = "Network Boundary Bridging"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION, with principal.ip, target.ip and target.port populated. Logs must record allowed traffic, not only denies."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and penetration tests, VPN or jump-host ranges not yet allowlisted, remote vendor support sessions, external monitoring probes, and internet background scanning where management ports are intentionally exposed."
    tuning_guidance = "Add authorised administration source addresses to %global_allowed_mgmt_sources and scanner sources to %global_allowed_scanners. Raise the #net threshold in high-noise environments. If management ports are intentionally internet-facing, scope the rule to the specific ports or reduce its severity."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 161 or
      $net.target.port = 830 or
      $net.target.port = 8443 or
      $net.target.port = 10000
    )
    $net.principal.ip = $src_ip
    not $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1599")
    $primary_entity = array_distinct($src_ip)
    $event_count = count($net.metadata.id)
    $targeted_ips = array_distinct($net.target.ip)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    #net >= 10
}
