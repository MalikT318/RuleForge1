/*
  MITRE Technique : T1567.004 - Exfiltration Over Webhook
  Tactic(s)       : Exfiltration
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:01:31.248852+00:00
  Reference       : https://attack.mitre.org/techniques/T1567/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_004_Linux_Network_Webhook_Post_Scripted_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects, from perimeter telemetry, an HTTP POST to an external destination whose URL path follows the webhook convention (a /webhook(s)/<id>/<token> path or a chat-platform style /services/T<id>/B<id>/<token> path), sent by a non-browser client. This is the network footprint of a Linux host pushing staged data to a webhook endpoint (T1567.004). It does not depend on process names, command lines or specific webhook provider domains."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567.004"
    mitre_technique_name = "Exfiltration Over Web Service: Exfiltration Over Webhook"
    log_prerequisites = "Requires proxy or TLS-inspecting firewall logs that populate NETWORK_HTTP with network.http.method, target.url and network.http.user_agent. Without TLS inspection, HTTPS URL paths are not visible and the rule will not fire."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "CI/CD runners, monitoring and alerting agents (for example Alertmanager or Grafana notifications), cron jobs or backup scripts that post status messages to approved chat or ticketing webhooks, and developer automation or ChatOps bots."
    tuning_guidance = "Add approved vendor or SaaS webhook domains to %global_allowed_domains. Add known automation, CI and monitoring hosts to %global_allowed_script_hosts. Raise the severity or risk score for server segments that should never post to external webhooks."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    (
      $net.target.url = /\/(api\/)?webhooks?\/[A-Za-z0-9_\-\/]{10,}/ nocase or
      $net.target.url = /\/services\/T[A-Z0-9]{8,}\/B[A-Z0-9]{8,}\/[A-Za-z0-9]{16,}/
    )
    not re.regex($net.network.http.user_agent, /^Mozilla\//)
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1567.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
