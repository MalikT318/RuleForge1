/*
  MITRE Technique : T1195 - Supply Chain Compromise
  Tactic(s)       : Initial Access
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:37:46.923442+00:00
  Reference       : https://attack.mitre.org/techniques/T1195
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_Package_Manager_Writes_Launchd_Plist {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a software-dependency or package-manager process (Node, Python, Ruby, Homebrew and similar) creating a launchd persistence plist. This is the file artifact left by a malicious install or post-install script in a compromised SaaS-hosted package registry or update channel. It detects the resulting file state change rather than the command line. Note: the requested platform label is SaaS, but the telemetry is the macOS endpoint file-creation events of developer and build hosts that consume SaaS-delivered packages."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195"
    mitre_technique_name = "Supply Chain Compromise"
    log_prerequisites = "Requires macOS endpoint file-creation telemetry (EDR or unified log) populating principal.process.file.full_path and target.file.full_path."
    platform = "SaaS"
    log_source = "macos_endpoint"
    false_positives = "Legitimate developer tooling or approved packages that install a helper daemon or login item (database servers, local proxies, VPN or dev-environment helpers); IT-managed provisioning scripts run through a package manager."
    tuning_guidance = "Add approved deployment and provisioning binaries to %global_allowed_admin_tools, approved script-host parents to %global_allowed_script_hosts, and EDR agents to %global_allowed_security_tools. Consider scoping to developer and build-server hosts first in noisy environments."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/Library\/(LaunchAgents|LaunchDaemons)|\/Users\/[^\/]+\/Library\/LaunchAgents)\/[^\/]+\.plist$/ nocase
    $file.principal.process.file.full_path = /\/(node|npm|npx|yarn|pnpm|pip|pip3|python|python3|ruby|gem|perl|brew|cargo|go)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1195")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_plist = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $affected_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
