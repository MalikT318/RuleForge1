/*
  MITRE Technique : T1669 - Wi-Fi Networks
  Tactic(s)       : Initial Access
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:14:06.515382+00:00
  Reference       : https://attack.mitre.org/techniques/T1669
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1669_Wireless_Foothold_Internal_Service_Sweep {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single source address makes a high volume of connections to internal hosts on remote-administration and file-sharing ports within ten minutes, as seen by network security sensors. A rogue Linux-based device (for example a dual-homed or implanted system) that has just joined the Wi-Fi network often does this to map reachable services. Each connection is benign on its own, but the volume from one source is not."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1669"
    mitre_technique_name = "Wi-Fi Networks"
    log_prerequisites = "Requires IDS/IPS or network security sensor logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated, covering the wireless or guest segments."
    platform = "Linux"
    log_source = "ips"
    false_positives = "Authorised vulnerability scanners, network inventory and monitoring systems, jump hosts, configuration management or automation servers, and admins running bulk SSH tasks."
    tuning_guidance = "Add scanners to %global_allowed_scanners and approved management sources to %global_allowed_mgmt_sources. Raise or lower the #net threshold per client based on baseline traffic. Where sensors only cover wireless or guest VLANs, the rule is most precise. Where they cover wired segments too, consider scoping to those sensors."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src
    $net.target.ip in %rfc1918_internal
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 445 or
      $net.target.port = 3389 or
      $net.target.port = 5900 or
      $net.target.port = 8080 or
      $net.target.port = 8443
    )
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1669")
    $primary_entity = array_distinct($src)
    $target_ips = array_distinct($net.target.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    #net >= 40
}
