/*
  MITRE Technique : T1539 - Steal Web Session Cookie
  Tactic(s)       : Credential Access
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:40:04.765126+00:00
  Reference       : https://attack.mitre.org/techniques/T1539
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1539_Identity_Session_Replay_Multi_Source_Logins {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single account produces a burst of sign-in events from external addresses within ten minutes. Individual sign-ins are benign, but the volume suggests a stolen session cookie or token being replayed from attacker infrastructure, for example through an adversary-in-the-middle proxy. The outcome lists the distinct source IPs so analysts can confirm whether several locations used the same account at once."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1539"
    mitre_technique_name = "Steal Web Session Cookie"
    log_prerequisites = "Requires identity provider (directory / sign-in) audit logs normalised to UDM USER_LOGIN with principal.user.userid and principal.ip populated."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Users behind rotating corporate VPN or proxy egress pools, mobile users roaming between carrier networks, shared kiosk or VDI accounts, SSO applications that generate many token-refresh sign-ins, and automation accounts not yet allowlisted."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Raise the #auth threshold for tenants with chatty SSO token refresh. Review the distinct source IP count in the outcome to separate roaming users from simultaneous multi-location use."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid = $user
    $auth.principal.user.userid != ""
    $auth.principal.ip != ""
    not $auth.principal.ip in %rfc1918_internal
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($auth.metadata.id)
    $distinct_source_ips = count_distinct($auth.principal.ip)
    $source_ips = array_distinct($auth.principal.ip)
    $mitre_technique_id = array_distinct("T1539")
    $primary_entity = array_distinct($user)

  condition:
    #auth >= 5
}
