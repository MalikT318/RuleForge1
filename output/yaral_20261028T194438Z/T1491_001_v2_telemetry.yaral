/*
  MITRE Technique : T1491.001 - Internal Defacement
  Tactic(s)       : Impact
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:44:10.871098+00:00
  Reference       : https://attack.mitre.org/techniques/T1491/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_001_Registry_Wallpaper_Or_Logon_Banner_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects registry state changes that deface a Windows system internally: the desktop wallpaper value being set (user Control Panel\\Desktop or the Policies\\System wallpaper policy) or the interactive-logon legal notice caption or text being changed. Detection is on the resulting registry modification rather than the command line that produced it, so it still fires if process command-line logging is evaded or the tooling is renamed."
    mitre_tactic = "Impact"
    mitre_technique = "T1491.001"
    mitre_technique_name = "Defacement: Internal Defacement"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon registry events) that populates target.registry.registry_key and target.registry.registry_value_name."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Users changing their own wallpaper through Settings or Personalization; Group Policy or MDM-enforced corporate wallpaper and legal notice banners; login-banner changes by compliance or hardening teams; VDI or golden-image provisioning; branding or theme tools."
    tuning_guidance = "Add approved deployment and configuration tooling to %global_allowed_admin_tools, named admins to %global_allowed_admin_users, and GPO/MDM automation accounts to %global_allowed_service_accounts. If user-initiated wallpaper changes are noisy, restrict the wallpaper branch to non-interactive writers or raise severity only when the writer is a script host or an unusual parent. Consider alerting on legal notice changes at a higher severity on servers."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      (
        $reg.target.registry.registry_key = /\\Control Panel\\Desktop$/ nocase and
        $reg.target.registry.registry_value_name = /^wallpaper$/ nocase and
        not $reg.principal.process.file.full_path = /\\(explorer|SystemSettings|SystemSettingsBroker)\.exe$/ nocase
      )
      or
      (
        $reg.target.registry.registry_key = /\\Microsoft\\Windows\\CurrentVersion\\Policies\\System$/ nocase and
        $reg.target.registry.registry_value_name = /^(wallpaper|legalnoticecaption|legalnoticetext)$/ nocase
      )
    )
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_admin_users
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1491.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_name)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $acting_users = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
