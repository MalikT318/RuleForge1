/*
  MITRE Technique : T1548.005 - Temporary Elevated Cloud Access
  Tactic(s)       : Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:34:03.238443+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_005_M365_Role_Elevation_Then_Tenant_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a user being granted or activating an elevated administrative role, delegation, or app permission, followed within 10 minutes by that same user modifying a sensitive tenant, mail-flow, mailbox-permission, identity or application setting. This sequence is consistent with abuse of temporary or just-in-time elevated cloud access."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.005"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Temporary Elevated Cloud Access"
    log_prerequisites = "Requires Microsoft 365 or Google Workspace unified audit logs ingested with role and permission change events and admin setting change events normalised to UDM. metadata.product_event_type must be populated."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate admins who activate a role through just-in-time access and then perform planned tenant or mail-flow changes; onboarding and migration projects; helpdesk staff granted delegated mailbox permissions who then adjust mailbox settings; managed service provider administrators."
    tuning_guidance = "Add named administrators to %global_allowed_admin_users and automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Narrow or extend the product_event_type regexes to match the client's audit operation names. Raise the severity when the elevated user is not an administrator."

  events:
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.metadata.product_event_type = /(add member to role|add eligible member|activate.*role|role assignment|add app role assignment|add delegated permission|consent to application|add service principal credentials|grant.*delegat|assign.*privilege)/ nocase
    $perm.target.user.userid = $user
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_cloud_principals
    not $perm.target.user.userid in %global_allowed_admin_users

    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(transportrule|mailboxpermission|organizationconfig|set-casmailbox|forwarding|conditional access|federat|domain authentication|authentication method|service principal|application|app registration|security default|dkim|anti-?phish|safe ?(links|attachments)|audit.*config|admin audit)/ nocase
    $setting.principal.user.userid = $user
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_cloud_principals

    $perm.metadata.event_timestamp.seconds <= $setting.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1548.005")
    $primary_entity = array_distinct($user)
    $elevation_actor = array_distinct($perm.principal.user.userid)
    $elevation_operations = array_distinct($perm.metadata.product_event_type)
    $setting_operations = array_distinct($setting.metadata.product_event_type)
    $source_ips = array_distinct($setting.principal.ip)
    $setting_change_count = count($setting.metadata.id)

  condition:
    $perm and $setting
}
