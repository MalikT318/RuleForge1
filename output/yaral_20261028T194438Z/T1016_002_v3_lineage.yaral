/*
  MITRE Technique : T1016.002 - Wi-Fi Discovery
  Tactic(s)       : Discovery
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:47:19.592635+00:00
  Reference       : https://attack.mitre.org/techniques/T1016/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_002_Unexpected_Parent_Spawns_WiFi_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects Wi-Fi profile or network enumeration (netsh wlan show/export) run by a shell, script host or netsh itself where the parent is an application that should never spawn one: an Office application, web server or application-server worker, print spooler, or database service. Pivots on process lineage rather than the discovery command alone, so it finds exploitation or macro-driven Wi-Fi credential harvesting."
    mitre_tactic = "Discovery"
    mitre_technique = "T1016.002"
    mitre_technique_name = "System Network Configuration Discovery: Wi-Fi Discovery"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office add-ins or macros from IT-authored workbooks that inventory wireless settings; web-based helpdesk or asset-inventory applications running netsh from a web server worker; database jobs (xp_cmdshell) used by in-house network tooling; RMM or deployment agents launched under one of the listed parents."
    tuning_guidance = "Add approved parent binaries or management tooling to %global_allowed_admin_tools, and EDR or AV agents to %global_allowed_security_tools. Add automation accounts to %global_allowed_service_accounts. Widen or narrow the parent regex for client-specific stacks, for example by adding other web or application-server runtimes."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat\d*|java|php-cgi|spoolsv|sqlservr|mysqld|postgres|oracle)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(netsh|cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /\bnetsh\b/ nocase
    $proc.target.process.command_line = /\bwlan\s+(show|export)\s+(profiles?|networks?|interfaces?|all)\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1016.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
