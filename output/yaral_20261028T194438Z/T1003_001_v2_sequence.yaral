/*
  MITRE Technique : T1003.001 - LSASS Memory
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:37:25.483429+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_001_LSASS_Handle_Open_Then_Dump_File_Written {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "A process opens a handle to lsass.exe and then the same process writes a memory-dump style file on the same host within 10 minutes. This sequence indicates credential dumping from LSASS memory regardless of tool name, command line or dump method."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.001"
    mitre_technique_name = "OS Credential Dumping: LSASS Memory"
    log_prerequisites = "Requires EDR or Sysmon process-access telemetry (Sysmon Event ID 10 equivalent) normalised to PROCESS_OPEN, plus file-creation telemetry (Sysmon Event ID 11 equivalent) normalised to FILE_CREATION, with the acting process path populated on both."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Crash-dump and error-reporting components writing dumps after an lsass fault, unlisted backup or imaging agents, EDR or AV agents not yet in the allowlist, and administrators or support engineers capturing diagnostic dumps."
    tuning_guidance = "Add approved EDR/AV agents to %global_allowed_security_tools and approved backup or imaging agents to %global_allowed_backup_processes. Add approved IT tooling to %global_allowed_admin_tools. If PROCESS_OPEN telemetry is very noisy, make sure the sensor is filtered to lsass.exe as the target."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\lsass\.exe$/ nocase
    $open.principal.process.file.full_path = /\.exe$/ nocase
    not $open.principal.process.file.full_path = /\\(lsass|MsMpEng|MsSense|SenseIR|csrss|wininit|services)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    $open.principal.hostname = $hostname
    $open.principal.process.file.full_path = $actor

    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(\.(dmp|mdmp|hdmp)$|lsass[^\\]*\.(bin|dat|tmp|txt|zip|7z)$)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname
    $file.principal.process.file.full_path = $actor

    $open.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname, $actor over 10m

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1003.001")
    $primary_entity = array_distinct($open.principal.hostname)
    $actor_process = array_distinct($actor)
    $dump_files = array_distinct($file.target.file.full_path)
    $acting_users = array_distinct($open.principal.user.userid)
    $open_event_count = count($open.metadata.id)

  condition:
    $open and $file
}
