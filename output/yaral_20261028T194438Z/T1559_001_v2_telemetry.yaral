/*
  MITRE Technique : T1559.001 - Component Object Model
  Tactic(s)       : Execution
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:51:58.907411+00:00
  Reference       : https://attack.mitre.org/techniques/T1559/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_001_COM_Hijack_User_Hive_Server_Registration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry value write to the InprocServer32 or LocalServer32 key of a CLSID in a per-user registry hive (HKCU or HKU). Adversaries register or redirect a COM class in the user hive to hijack COM object resolution. The user hive is consulted before HKLM, so the hijack runs attacker code whenever a legitimate application instantiates the CLSID. This works for persistence, local code execution and privilege escalation, and it needs no elevated rights. The rule detects the resulting registry state change, not the command line that produced it."
    mitre_tactic = "Execution"
    mitre_technique = "T1559.001"
    mitre_technique_name = "Inter-Process Communication: Component Object Model"
    log_prerequisites = "Requires Windows endpoint registry telemetry normalised to REGISTRY_MODIFICATION (EDR registry events or Sysmon Event ID 12/13) with target.registry.registry_key and the writing process populated. HKCU and HKU writes must be collected, because some EDR sensors filter registry events by default."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-user application installers and updaters (Microsoft 365 click-to-run, OneDrive, Teams, browsers, Adobe, Java) that register per-user COM servers. Shell extension and add-in installers. Developer tooling that registers COM components for debugging (regsvr32 in user context, Visual Studio). Software packaging and deployment agents."
    tuning_guidance = "Add approved installer or deployment binaries to %global_allowed_admin_tools. Add EDR/AV agents to %global_allowed_security_tools. Add service or automation accounts that legitimately register COM servers to %global_allowed_service_accounts. Review hits where the writing process runs from a user-writable path, or where the registered server path points to a user profile, temp or public directory."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /^(HKEY_CURRENT_USER|HKCU|HKEY_USERS|HKU)\\/ nocase
    $reg.target.registry.registry_key = /\\CLSID\\\{[0-9a-f\-]{36}\}\\(InprocServer32|LocalServer32)$/ nocase
    not $reg.principal.process.file.full_path = /\\(msiexec|MsMpEng|MsSense|SenseIR|TrustedInstaller|OneDriveSetup|OneDrive)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1559.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
