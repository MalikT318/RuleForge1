/*
  MITRE Technique : T1567.003 - Exfiltration to Text Storage Sites
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:58:54.758511+00:00
  Reference       : https://attack.mitre.org/techniques/T1567/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_003_ESXi_Outbound_Web_Egress_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an ESXi host configuration change that opens or widens outbound web egress from the hypervisor: enabling the outbound HTTP client firewall ruleset, disabling the host firewall or setting its default action to allow, or setting an HTTP proxy advanced option. ESXi blocks most outbound web traffic by default, so staging data for upload to text storage or paste sites normally needs one of these changes first. This is the state-change layer of T1567.003, not command-line matching. It is a precursor and proxy indicator, not proof of exfiltration."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567.003"
    mitre_technique_name = "Exfiltration Over Web Service: Exfiltration to Text Storage Sites"
    log_prerequisites = "ESXi hostd and shell logs forwarded to Chronicle and parsed so that firewall, ruleset and advanced-setting changes normalise to SETTING_MODIFICATION. Requires the setting name or change text in target.resource.name or metadata.description."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorised patching or image-profile updates that temporarily enable the outbound HTTP client ruleset, vendor or proxy-based update and telemetry configuration, initial host build and automation, and firewall changes made during approved maintenance windows."
    tuning_guidance = "Add named administrators to %global_allowed_admin_users and automation or lifecycle accounts to %global_allowed_service_accounts. Correlate hits with a later large outbound transfer from the same host. Raise severity if the change happens outside a change window or follows a new SSH login."

  events:
    $set.metadata.event_type = "SETTING_MODIFICATION"
    (
      $set.target.resource.name = /(httpclient|firewall|UserVars\.[a-z]*proxy|proxy)/ nocase or
      $set.metadata.description = /(httpclient|firewall|proxy)/ nocase
    )
    (
      $set.metadata.description = /(httpclient[^\n]*(enabl|allow|true)|(enabl|allow|true)[^\n]*httpclient|firewall[^\n]*(disabl|default[^\n]*allow|outgoing[^\n]*allow|enabled[^\n]*false)|proxy[^\n]*(set|configur|enabl|modif))/ nocase or
      $set.target.resource.name = /(httpclient|UserVars\.[a-z]*proxy)/ nocase
    )
    not $set.principal.user.userid in %global_allowed_admin_users
    not $set.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1567.003")
    $primary_entity = array_distinct(strings.coalesce($set.target.hostname, $set.principal.hostname))
    $acting_user = array_distinct($set.principal.user.userid)
    $setting_name = array_distinct($set.target.resource.name)

  condition:
    $set
}
