/*
  MITRE Technique : T1095 - Non-Application Layer Protocol
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:38:21.217327+00:00
  Reference       : https://attack.mitre.org/techniques/T1095
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1095_ESXi_Shell_Raw_Socket_Relay_Or_Listener {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a socket utility run from the ESXi shell with a combination of options that sets up a non-application-layer channel. This covers a UDP listener, a raw or IP-protocol socket address, or a socket bound to a shell or command. Adversaries use these to build C2 tunnels or relays directly on the hypervisor that bypass normal application-layer monitoring."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1095"
    mitre_technique_name = "Non-Application Layer Protocol"
    log_prerequisites = "ESXi shell command logging (shell.log / hostd) forwarded and parsed into UDM PROCESS_LAUNCH events with target.process.file.full_path and target.process.command_line populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators or VMware support troubleshooting connectivity with UDP or listener tests from the ESXi shell, network or storage diagnostics scripts, and approved remote management tooling that opens a temporary socket."
    tuning_guidance = "Add approved automation parent binaries to %global_allowed_admin_tools and named administrator accounts to %global_allowed_admin_users. If the shell logging source does not populate target.process.file.full_path, adjust the path condition to match the process name field in use."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /(^|\/)(nc|ncat|netcat|socat)$/ nocase
    $proc.target.process.command_line = /(\s-[a-z]*[ec]\s+\S*(sh|ash|bash)\b|\s-[a-z]*(ul|lu)[a-z]*\b|\b(exec|system|udp[46]?-(listen|connect|sendto|recvfrom)|ip[46]?-(sendto|recv|recvfrom)|raw):)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1095")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
