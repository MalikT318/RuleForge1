/*
  MITRE Technique : T1218.012 - Verclsid
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:58:16.171634+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_012_Verclsid_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects verclsid.exe (Extension CLSID Verification Host) initiating a network connection to a non-internal destination. In normal operation verclsid.exe verifies local shell extension CLSIDs and does not talk to external hosts. Outbound connections indicate proxy execution of a remote COM scriptlet or payload (for example verclsid.exe /S /C {CLSID} resolving a CLSID that points to a remote scriptlet). The rule keys on the network behaviour of the binary, not its command line, so it complements process-creation detections and still fires if the command-line arguments are obfuscated."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1218.012"
    mitre_technique_name = "System Binary Proxy Execution: Verclsid"
    log_prerequisites = "Requires endpoint network telemetry that records the initiating process path (EDR network events or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION. Reference list %rfc1918_internal must be populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare. Shell extension verification of a network-hosted resource (for example WebDAV or a UNC path that resolves to a public address), VPN or split-tunnel setups where internal file servers appear on public address space, and security or sandbox tooling that detonates verclsid.exe."
    tuning_guidance = "Add known-good vendor or CDN destination hostnames to %global_allowed_domains. If internal servers appear on non-RFC1918 space, add those address strings to %rfc1918_internal. Add sandbox or detonation hosts to %global_allowed_scanners if the hostname exclusion is extended."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\verclsid\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.012")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_user = array_distinct($net.principal.user.userid)
    $process_command_line = array_distinct($net.principal.process.command_line)

  condition:
    $net
}
