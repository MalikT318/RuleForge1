/*
  MITRE Technique : T1098.003 - Additional Cloud Roles
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:44:06.362001+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_003_New_Account_Granted_Privileged_Role {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a newly created directory account that is granted an administrative or privileged role within 10 minutes of creation. Adversaries use this pattern to establish persistent, privileged access to a tenant (account creation followed by role assignment)."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.003"
    mitre_technique_name = "Account Manipulation: Additional Cloud Roles"
    log_prerequisites = "Requires unified audit / directory audit logs normalised to UDM USER_CREATION and USER_CHANGE_PERMISSIONS, with target.user.attribute.roles.name or metadata.description populated with the role granted."
    platform = "Identity Provider"
    log_source = "m365"
    false_positives = "HR-driven or automated onboarding of new administrators, privileged identity management workflows that create and elevate accounts in one change window, break-glass account provisioning, IT staff creating new service or admin accounts during tenant setup or migration."
    tuning_guidance = "Add provisioning and onboarding automation identities to %global_allowed_service_accounts. Add named administrators who legitimately create and elevate accounts to %global_allowed_admin_users. Widen or narrow the role regex to match the client's privileged role naming. Extend the 10m window only if the client's provisioning workflow is slower."

  events:
    $create.metadata.event_type = "USER_CREATION"
    $create.target.user.userid = $user
    not $create.principal.user.userid in %global_allowed_service_accounts
    not $create.principal.user.userid in %global_allowed_admin_users

    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.target.user.userid = $user
    (
      $perm.target.user.attribute.roles.name = /(admin|owner|privileged|contributor)/ nocase or
      $perm.metadata.description = /(admin|owner|privileged|contributor)/ nocase
    )
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_admin_users

    $create.metadata.event_timestamp.seconds <= $perm.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1098.003")
    $primary_entity = array_distinct($user)
    $creating_actors = array_distinct($create.principal.user.userid)
    $assigning_actors = array_distinct($perm.principal.user.userid)
    $granted_roles = array_distinct($perm.target.user.attribute.roles.name)
    $source_ips = array_distinct($perm.principal.ip)

  condition:
    $create and $perm
}
