/*
  MITRE Technique : T1027.018 - Invisible Unicode
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:07:49.612894+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/018
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_018_Linux_Invisible_Unicode_Run_In_Outbound_URL {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an outbound HTTP request whose URL contains a run of four or more invisible Unicode characters, either percent-encoded or raw. The characters covered are zero-width space/joiners, bidi controls, word joiner and invisible operators, BOM, variation selectors and tag characters. Payloads hidden in invisible characters are often fetched or exfiltrated this way (for example by curl, wget or Python scripts on Linux hosts). A run of this length does not occur in normal URLs. This is a network-side detection that complements endpoint command-line rules."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.018"
    mitre_technique_name = "Obfuscated Files or Information: Invisible Unicode"
    log_prerequisites = "Requires forward or transparent proxy, or firewall with URL inspection, logs normalised to UDM NETWORK_HTTP with target.url populated. TLS inspection is needed to see URLs on HTTPS traffic."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Web applications that legitimately carry zero-width or bidi characters in URLs (some right-to-left language sites, URL shorteners, CMS or analytics tracking parameters, emoji with variation selectors in search or social links), and security scanners or fuzzers sending Unicode test strings."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains and authorised scanners to %global_allowed_scanners. If right-to-left language sites cause noise, raise the repetition threshold from {4,} to a higher value. Internal destinations are excluded through %rfc1918_internal."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /(%e2%80%(8[b-f]|a[a-e])|%e2%81%(a[0-4]|a[6-9])|%ef%bb%bf|%ef%b8%8[0-9a-f]|%f3%a0%8[0-7]%[89ab][0-9a-f]|[\x{200B}-\x{200F}\x{202A}-\x{202E}\x{2060}-\x{2064}\x{FEFF}\x{FE00}-\x{FE0F}\x{E0000}-\x{E01EF}]){4,}/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.018")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
