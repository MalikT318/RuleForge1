/*
  MITRE Technique : T1200 - Hardware Additions
  Tactic(s)       : Initial Access
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:51:15.108333+00:00
  Reference       : https://attack.mitre.org/techniques/T1200
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1200_Linux_USB_Network_HID_Driver_Load_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of kernel module loads on a single Linux host within 10 minutes for USB network adapter or USB HID drivers (RNDIS/CDC Ethernet, USB NIC chipsets, usbhid/hid_generic). Each load is benign alone, but several in a short window can indicate a rogue hardware addition such as a USB Ethernet implant, network tap, or keystroke-injection device. Detection is based on the OS driver-binding behaviour, not on device identifiers."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1200"
    mitre_technique_name = "Hardware Additions"
    log_prerequisites = "Linux EDR or auditd process execution telemetry (execve) with full command lines, normalised to UDM PROCESS_LAUNCH. Module loads triggered by udev must be visible as modprobe/insmod launches."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate users docking laptops or plugging in USB Ethernet adapters, keyboards or mice; kiosk or lab hosts with frequent device changes; boot-time driver initialisation; configuration management or provisioning scripts that load these modules; virtualisation hosts attaching USB devices to guests."
    tuning_guidance = "Add approved provisioning, deployment and configuration-management binaries to %global_allowed_admin_tools. Raise the #proc threshold for laptop or docking-station fleets. Lower it for servers and appliances, which should never see USB NIC or HID driver loads. Consider excluding the boot window if module loading at startup is noisy."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(modprobe|insmod|kmod)$/ nocase
    $proc.target.process.command_line = /(modprobe|insmod)\s+.*\b(rndis_host|cdc_ether|cdc_ncm|cdc_eem|usbnet|usbhid|hid_generic|r8152|ax88179_178a|smsc95xx)\b/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(55)
    $event_count = count($proc.metadata.id)
    $loaded_modules = array_distinct($proc.target.process.command_line)
    $mitre_technique_id = array_distinct("T1200")
    $primary_entity = array_distinct($host)

  condition:
    #proc >= 3
}
