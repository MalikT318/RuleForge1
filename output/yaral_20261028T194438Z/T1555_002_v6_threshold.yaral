/*
  MITRE Technique : T1555.002 - Securityd Memory
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:55:07.309584+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_002_Linux_Bulk_Proc_Memory_Reads {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of reads of /proc/<pid>/mem or /proc/<pid>/maps on a single Linux host within 10 minutes. A single read is common in debuggers and monitoring, but repeated reads across processes match memory scraping of credential-holding daemons (keyring, agent or authentication services). This is the Linux analogue of reading securityd memory. It needs root or ptrace capability and can recover plaintext secrets or keys."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.002"
    mitre_technique_name = "Credentials from Password Stores: Securityd Memory"
    log_prerequisites = "Requires Linux endpoint file-read telemetry (EDR file access events or auditd watches on /proc/*/mem and /proc/*/maps) normalised to UDM FILE_READ with principal.hostname, principal.process.file.full_path and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Debuggers (gdb, strace, lldb), profilers and performance tools, crash dump collectors, EDR and AV agents, backup or checkpoint tools (CRIU), container runtimes and JVM or language-runtime diagnostics."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools, backup and checkpoint tooling to %global_allowed_backup_processes, and admin diagnostic tooling to %global_allowed_admin_tools. Raise the #proc threshold on developer workstations or build hosts. Lower it on servers that never run debuggers."

  events:
    $proc.metadata.event_type = "FILE_READ"
    $proc.target.file.full_path = /^\/proc\/[0-9]+\/(mem|maps)$/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(75)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1555.002")
    $primary_entity = array_distinct($host)
    $reading_processes = array_distinct($proc.principal.process.file.full_path)
    $reading_users = array_distinct($proc.principal.user.userid)
    $memory_targets = array_distinct($proc.target.file.full_path)

  condition:
    #proc >= 10
}
