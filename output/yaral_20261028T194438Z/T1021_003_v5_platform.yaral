/*
  MITRE Technique : T1021.003 - Distributed Component Object Model
  Tactic(s)       : Lateral Movement
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:39:26.447280+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_003_DCOM_Permission_Registry_Tampering {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modification of DCOM launch/activation/access permission settings (machine-wide Ole restrictions, per-application AppID LaunchPermission/AccessPermission, EnableDCOM, RemoteServerName) by a process that is not an approved administrative or security tool. Adversaries with administrative rights loosen these ACLs or enable DCOM so a remote COM object can be activated for lateral movement. The detection is registry-based and independent of process command lines. The technique is Windows-only, so a non-Windows variant is not applicable and the rule targets Windows."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.003"
    mitre_technique_name = "Remote Services: Distributed Component Object Model"
    log_prerequisites = "Requires Windows endpoint telemetry with registry modification events (EDR or Sysmon event ID 13) covering HKLM\\SOFTWARE\\Microsoft\\Ole and HKLM\\SOFTWARE\\Classes\\AppID, with registry key and value name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy or MDM applying DCOM hardening baselines (for example the KB5004442 DCOM hardening), enterprise software installers registering DCOM servers or AppIDs, dcomcnfg changes by administrators, and RMM or configuration management tooling."
    tuning_guidance = "Add approved deployment and configuration tooling executables to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, and named change-window administrators to %global_allowed_admin_users. If a specific installer is noisy, exclude its executable name rather than its install path."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(Microsoft\\Ole|AppID\\[^\\]+)$/ nocase
    $reg.target.registry.registry_value_name = /^(MachineLaunchRestriction|MachineAccessRestriction|DefaultLaunchPermission|DefaultAccessPermission|LaunchPermission|AccessPermission|EnableDCOM|RemoteServerName)$/ nocase
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1021.003")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $modified_value = array_distinct($reg.target.registry.registry_value_name)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
