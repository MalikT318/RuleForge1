/*
  MITRE Technique : T1614.001 - System Language Discovery
  Tactic(s)       : Discovery
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:39:52.030325+00:00
  Reference       : https://attack.mitre.org/techniques/T1614/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1614_001_Script_Host_Geo_Language_Lookup_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows scripting host or LOLBin (PowerShell, WScript, CScript, MSHTA) making an outbound HTTP request to an external destination whose URL carries geolocation or country-lookup semantics. Malware uses these lookups to infer victim geography and system language before deciding whether to proceed. The detection matches the generic URL pattern, not a specific provider, so it survives a change of lookup service."
    mitre_tactic = "Discovery"
    mitre_technique = "T1614.001"
    mitre_technique_name = "System Location Discovery: System Language Discovery"
    log_prerequisites = "Requires NETWORK_HTTP telemetry with target.url populated and principal.process attribution (EDR network telemetry, Sysmon-enriched proxy logs, or a secure web gateway with endpoint process correlation). Pair with endpoint rules for registry and API-based language checks."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin or inventory scripts that look up site or geography for asset tagging, PowerShell modules that call location or locale APIs, RMM health checks, and legitimate web-enabled automation. Developer workstations running API tests."
    tuning_guidance = "Add approved automation hosts and parent processes to %global_allowed_script_hosts, approved tooling binaries to %global_allowed_admin_tools, and known-good external services to %global_allowed_domains. If the URL pattern is noisy, require an additional PROCESS_LAUNCH correlation on the same host."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $net.target.url = /(geo[-_]?(ip|loc|location|lookup)|country[-_]?(code|name)|ipgeo|iplookup|ip2country)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1614.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_user = array_distinct($net.principal.user.userid)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $requested_urls = array_distinct($net.target.url)
    $destination_hosts = array_distinct($net.target.hostname)

  condition:
    $net
}
