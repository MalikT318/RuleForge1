/*
  MITRE Technique : T1602.001 - SNMP (MIB Dump)
  Tactic(s)       : Collection
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:19:03.848157+00:00
  Reference       : https://attack.mitre.org/techniques/T1602/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_001_External_SNMP_Query_Then_Mgmt_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A non-internal source sends SNMP (port 161) traffic to a device and then connects to a management port (SSH, Telnet, HTTPS) on the same device within 10 minutes. This pattern suggests MIB collection used for device reconnaissance, followed by hands-on access to the same managed device."
    mitre_tactic = "Collection"
    mitre_technique = "T1602.001"
    mitre_technique_name = "Data from Configuration Repository: SNMP (MIB Dump)"
    log_prerequisites = "Perimeter or internal firewall connection logs that include source IP, destination IP and destination port, with SNMP (UDP 161) and management-port traffic permitted or logged. Both allowed and denied connections should be logged where possible."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Third-party network monitoring or MSP polling platforms that also open SSH or HTTPS sessions to the same devices, authorised vulnerability scans or penetration tests, and ISP or carrier-managed CPE devices that are polled from provider address space."
    tuning_guidance = "Add monitoring platform, polling and jump-host source addresses to %global_allowed_mgmt_sources. Add approved scanner sources to %global_allowed_scanners. Narrow the management port list or the 10m window if needed for a specific client."

  events:
    $snmp.metadata.event_type = "NETWORK_CONNECTION"
    $snmp.target.port = 161
    not $snmp.principal.ip in %rfc1918_internal
    not $snmp.principal.ip in %global_allowed_mgmt_sources
    not $snmp.principal.ip in %global_allowed_scanners
    $snmp.principal.ip = $src
    $snmp.target.ip = $dst

    $mgmt.metadata.event_type = "NETWORK_CONNECTION"
    (
      $mgmt.target.port = 22 or
      $mgmt.target.port = 23 or
      $mgmt.target.port = 443 or
      $mgmt.target.port = 8443
    )
    not $mgmt.principal.ip in %rfc1918_internal
    not $mgmt.principal.ip in %global_allowed_mgmt_sources
    not $mgmt.principal.ip in %global_allowed_scanners
    $mgmt.principal.ip = $src
    $mgmt.target.ip = $dst

    $snmp.metadata.event_timestamp.seconds <= $mgmt.metadata.event_timestamp.seconds

  match:
    $src, $dst over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1602.001")
    $primary_entity = array_distinct($dst)
    $source_ips = array_distinct($src)
    $snmp_event_count = count($snmp.metadata.id)
    $mgmt_ports = array_distinct($mgmt.target.port)

  condition:
    $snmp and $mgmt
}
