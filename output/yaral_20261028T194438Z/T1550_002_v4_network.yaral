/*
  MITRE Technique : T1550.002 - Pass the Hash
  Tactic(s)       : Lateral Movement
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:39:13.557556+00:00
  Reference       : https://attack.mitre.org/techniques/T1550/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1550_002_Admin_Protocol_Egress_NonSystem_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Network-side Pass-the-Hash observation. Detects a user-mode Windows process opening a connection to a remote-authentication service (SMB 445, RPC 135, WinRM 5985/5986) on a non-internal destination. On Windows, SMB and RPC authentication normally comes from the kernel (System) or service host processes. A non-standard user-mode process making these connections indicates a tool that authenticates with a stolen NTLM hash (overpass-the-hash or pass-the-hash tooling) from an endpoint to a host outside the internal address space. Internal-to-internal lateral movement is deliberately excluded via %rfc1918_internal, so that variant is covered by the endpoint process and logon rules. This rule covers hosts reached over VPN, cloud-hosted workloads, internet-exposed SMB/WinRM, and attacker infrastructure."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1550.002"
    mitre_technique_name = "Use Alternate Authentication Material: Pass the Hash"
    log_prerequisites = "Requires endpoint network telemetry (EDR or Sysmon Event ID 3 equivalent) with principal.process.file.full_path and target.port populated on NETWORK_CONNECTION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Approved remote management, RMM and patching agents; vulnerability scanners and authorised pen-test hosts; backup agents that write to external SMB shares; admins using PowerShell remoting or WinRM to cloud-hosted servers; Azure Files or SMB-over-internet storage mounts from non-system processes."
    tuning_guidance = "Add approved admin and RMM binaries to %global_allowed_admin_tools or %global_allowed_remote_mgmt. Add scanner source IPs to %global_allowed_scanners. Add known-good management destinations to %global_allowed_mgmt_sources. Extend the system-process executable-name exclusion if a client runs additional trusted service hosts. Make sure %rfc1918_internal covers the client's private and VPN address ranges, or traffic to those ranges will alert."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 445 or
      $net.target.port = 135 or
      $net.target.port = 5985 or
      $net.target.port = 5986
    )
    $net.principal.process.file.full_path = /\\[^\\]+\.exe$/ nocase
    not $net.principal.process.file.full_path = /\\(system|svchost|lsass|services|wmiprvse|MsMpEng|MsSense|SenseIR|explorer|System32\\ntoskrnl)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1550.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $source_user = array_distinct($net.principal.user.userid)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
