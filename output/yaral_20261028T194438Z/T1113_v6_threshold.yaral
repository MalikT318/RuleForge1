/*
  MITRE Technique : T1113 - Screen Capture
  Tactic(s)       : Collection
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:15:30.290662+00:00
  Reference       : https://attack.mitre.org/techniques/T1113
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1113_Linux_Bulk_Image_Files_Staged_Temp_Dirs {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of image files (png, jpg, bmp, xwd, ppm, gif) created in world-writable or volatile staging directories (/tmp, /var/tmp, /dev/shm, /run/user) on a single Linux host within 10 minutes. Each file is benign alone, but repeated creation is consistent with automated screen capture (X11/Wayland grabbers, RAT screenshot modules) staging output for collection. This uses file-creation volume rather than process command-line matching, so it still fires if the capture binary is renamed or built in-memory."
    mitre_tactic = "Collection"
    mitre_technique = "T1113"
    mitre_technique_name = "Screen Capture"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry that populates target.file.full_path and principal.process.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Desktop screenshot utilities used by users, screen-recording or remote-support sessions, GUI test automation (Selenium/headless browser screenshots), thumbnail or image-processing batch jobs, document conversion pipelines, CI runners, and monitoring/kiosk systems that write frames to /tmp."
    tuning_guidance = "Add approved screenshot, QA automation and image-processing binaries to %global_allowed_admin_tools, support tools to %global_allowed_remote_mgmt, and EDR agents to %global_allowed_security_tools. Raise the #file threshold on build/CI hosts or developer workstations. Review hosts with no interactive user sessions first, since servers rarely take screenshots."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/user\/[0-9]+)\/.*\.(png|jpe?g|bmp|xwd|ppm|gif)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $file_count = count($file.metadata.id)
    $risk_score = max(if($file_count >= 30, 85, 60))
    $mitre_technique_id = array_distinct("T1113")
    $primary_entity = array_distinct($host)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)
    $sample_files = array_distinct($file.target.file.full_path)

  condition:
    #file >= 10
}
