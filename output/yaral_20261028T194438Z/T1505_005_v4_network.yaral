/*
  MITRE Technique : T1505.005 - Terminal Services DLL
  Tactic(s)       : Persistence
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:33:40.389469+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_005_Inbound_RDP_From_External_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network connection to the Remote Desktop (TermService) port 3389 from a non-internal source address. Adversaries who tamper with or replace the Terminal Services ServiceDll (termsrv.dll) to keep or widen RDP access rely on that RDP listener being reachable. This rule covers the network side of the technique and complements endpoint process, registry and file detections. Direct internet-sourced RDP is rare in a well-run estate, so it is a strong indicator of exposed or backdoored remote access."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.005"
    mitre_technique_name = "Server Software Component: Terminal Services DLL"
    log_prerequisites = "Requires endpoint or network telemetry normalised to NETWORK_CONNECTION with target.port populated and the connection source in principal.ip. Hosts must report inbound connections, as Sysmon Event ID 3 or an EDR network sensor does, and the %rfc1918_internal list must be maintained for the tenant."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Intentionally internet-exposed RDP servers or jump hosts; VPN or NAT egress addresses seen as external; vendor or MSP remote support over RDP; RDP gateway or load balancer addresses; authorised penetration tests or scanners."
    tuning_guidance = "Add approved external RDP source addresses and gateways to %global_allowed_mgmt_sources. Confirm that %rfc1918_internal covers all tenant internal and VPN address space. For environments where RDP is legitimately published, scope the rule to non-approved servers or pair it with endpoint alerts for ServiceDll or termsrv.dll changes before raising priority."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 3389
    $net.principal.ip != ""
    $net.target.hostname != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1505.005")
    $primary_entity = array_distinct($net.target.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
