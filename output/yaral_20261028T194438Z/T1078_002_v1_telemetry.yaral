/*
  MITRE Technique : T1078.002 - Domain Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:30:43.915719+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_002_Linux_Kerberos_Credential_Artifact_Staged {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of Kerberos credential artifacts (keytab or ccache files, or krb5cc ticket caches in memory-backed or persistent temp locations) in world-writable staging directories by a process other than the normal Kerberos or SSSD stack. This is the file-level result of exporting, converting or copying domain account tickets or keys for reuse (pass-the-ticket or keytab theft), independent of the command line used."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.002"
    mitre_technique_name = "Valid Accounts: Domain Accounts"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file watches (for example on /tmp, /var/tmp and /dev/shm) normalised to UDM FILE_CREATION with principal.process and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators exporting keytabs for services with ktutil or adcli, configuration management (Ansible, Puppet, Chef) staging keytabs, domain-join tooling, and applications that deliberately write ticket caches to /var/tmp or /dev/shm."
    tuning_guidance = "Add approved keytab and domain-join tooling to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and approved admin identities to %global_allowed_admin_users. To flag only /dev/shm and /var/tmp, remove the tmp alternative from the path regex."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/(.*\/)?[^\/]+\.(ccache|keytab)$|^\/(var\/tmp|dev\/shm)\/(.*\/)?krb5cc[^\/]*$/ nocase
    not $file.principal.process.file.full_path = /\/(kinit|klist|kdestroy|sssd|sssd_be|krb5_child|ldap_child|sshd|login|su|sudo|gdm|gdm-session-worker|systemd|k5start|krenew)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1078.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)
    $acting_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
