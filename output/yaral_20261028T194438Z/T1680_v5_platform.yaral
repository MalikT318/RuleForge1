/*
  MITRE Technique : T1680 - Local Storage Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:28:54.284658+00:00
  Reference       : https://attack.mitre.org/techniques/T1680
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1680_ESXi_Local_Storage_Enumeration_CLI {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects storage and datastore enumeration from the ESXi shell, such as esxcli storage list sub-commands, esxcfg-scsidevs listing, vmkfstools volume queries, or searches for virtual disk (.vmdk) files under /vmfs/volumes. Ransomware operators and hands-on-keyboard intruders run these commands to map datastores and virtual disks before encryption or exfiltration. The rule matches the command-line combination rather than a single binary, so it still fires if the binary is invoked by a different path or wrapper."
    mitre_tactic = "Discovery"
    mitre_technique = "T1680"
    mitre_technique_name = "Local Storage Discovery"
    log_prerequisites = "ESXi shell and process execution logging forwarded to the SIEM and parsed into UDM PROCESS_LAUNCH events with target.process.command_line populated (for example syslog forwarding of shell.log with command auditing enabled)."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators troubleshooting storage or datastore capacity, backup and replication agents enumerating datastores, host monitoring and inventory scripts, patching or upgrade workflows, and vendor support sessions."
    tuning_guidance = "Add backup agents and monitoring binaries to %global_allowed_backup_processes and %global_allowed_admin_tools, and named administrators to %global_allowed_admin_users. Add automation accounts to %global_allowed_service_accounts. To reduce noise on busy hosts, raise severity only when this alert is correlated with SSH enablement or a first-time interactive login."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(esxcli\s+(\S+\s+)*storage\s+(core\s+(device|adapter|path)|filesystem|vmfs|nmp\s+device|san)\s+(\S+\s+)*list)|(esxcfg-scsidevs\s+-[lmcu])|(vmkfstools\s+(\S+\s+)*(-P|-D|--queryfs|--geometry))|(\b(find|ls)\s+.*\/vmfs\/volumes.*\.vmdk)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1680")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $observed_commands = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
