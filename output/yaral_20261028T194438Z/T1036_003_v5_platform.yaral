/*
  MITRE Technique : T1036.003 - Rename Legitimate Utilities
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:01:30.530646+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_003_Linux_System_Binary_Renamed_To_Writable_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a system utility under a standard binary directory (/bin, /sbin, /usr/bin, /usr/sbin, /usr/local/bin) being moved and renamed into a world-writable or user-controlled location (/tmp, /var/tmp, /dev/shm, /run/user, or a hidden path under /home or /root). Adversaries do this to evade detections keyed on the original utility name or path. This is a file-move detection that complements process-creation and command-line rules. It fires on the rename itself, before the renamed binary executes."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.003"
    mitre_technique_name = "Masquerading: Rename Legitimate Utilities"
    log_prerequisites = "Linux EDR or auditd file telemetry that produces FILE_MOVE events with both the source path (src.file.full_path) and destination path (target.file.full_path) populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers or image builders staging binaries in /tmp during install or upgrade; container build tooling; admins backing up or relocating binaries during troubleshooting; configuration management agents."
    tuning_guidance = "Add approved deployment and patching tools to %global_allowed_admin_tools. Extend the package-manager process regex if the environment uses other installers. If container build hosts are noisy, scope them out through %global_allowed_admin_tools. Note that copy-based renames (cp, install) generate FILE_CREATION rather than FILE_MOVE and are not covered by this rule."

  events:
    $file.metadata.event_type = "FILE_MOVE"
    $file.src.file.full_path = /^\/(usr\/(local\/)?)?s?bin\/[^\/]+$/ nocase
    $file.target.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/run\/user\/|\/home\/[^\/]+\/\.|\/root\/\.)/ nocase
    $src_name = re.capture($file.src.file.full_path, "([^/]+)$")
    $dst_name = re.capture($file.target.file.full_path, "([^/]+)$")
    $src_name != $dst_name
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|yum|dnf|zypper|snapd|pacman|apk|unattended-upgr[a-z]*)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1036.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $original_path = array_distinct($file.src.file.full_path)
    $renamed_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)
    $acting_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
