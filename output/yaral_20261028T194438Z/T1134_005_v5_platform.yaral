/*
  MITRE Technique : T1134.005 - SID-History Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:02:46.487595+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_005_SIDHistory_Attribute_Write_CommandLine {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process launch whose command line writes to the Active Directory SIDHistory attribute (Set-ADUser/Set-ADObject -Add or -Replace, SID-history cmdlets, or LDIF/LDAP modify utilities). SID-History injection is an Active Directory and Windows-only technique with no Linux, macOS or SaaS equivalent, so this variant targets Windows endpoints and covers the command-line attribute write path. Read-only queries of SIDHistory are not matched because a write verb is required."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.005"
    mitre_technique_name = "Access Token Manipulation: SID-History Injection"
    log_prerequisites = "Requires EDR process telemetry with full command lines, Sysmon Event ID 1, or Windows Event 4688 with command-line auditing enabled. Most useful on domain controllers and admin workstations."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Authorised AD domain or forest migrations (SID-History is used legitimately for inter-domain account migration), migration tooling run by named administrators, and identity-management automation that manages SIDHistory."
    tuning_guidance = "Add migration and identity-management tooling to %global_allowed_admin_tools. Add named migration administrators to %global_allowed_admin_users. Expect most noise during planned migration windows, so consider temporary exclusions scoped to those windows."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /sid-?history/ nocase
    $proc.target.process.command_line = /(set-ad(user|object|computer)|add-\w*sid-?history|ldifde|ldapmodify|-(add|replace)\s*@\{[^}]*sid-?history)/ nocase
    $proc.principal.hostname = $hostname
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1134.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
