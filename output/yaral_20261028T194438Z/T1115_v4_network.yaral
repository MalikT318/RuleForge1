/*
  MITRE Technique : T1115 - Clipboard Data
  Tactic(s)       : Collection
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:23:57.228306+00:00
  Reference       : https://attack.mitre.org/techniques/T1115
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1115_Linux_Clipboard_Utility_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux clipboard utility (xclip, xsel, wl-paste, wl-copy) making an outbound network connection to a non-internal address. These utilities only read or write the local X11 or Wayland selection buffer and have no legitimate reason to communicate with external hosts. A connection suggests clipboard contents are being piped to a remote endpoint, or that the binary is being abused or masqueraded for exfiltration."
    mitre_tactic = "Collection"
    mitre_technique = "T1115"
    mitre_technique_name = "Clipboard Data"
    log_prerequisites = "Requires Linux EDR or auditd-derived network telemetry that populates the initiating process path (principal.process.file.full_path) on NETWORK_CONNECTION events, plus target.ip."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Remote desktop or VNC/RDP-style sessions that proxy clipboard sync through a helper binary, user-installed clipboard managers or sync tools wrapping xclip/xsel, and wrapper scripts or packaging that exec the clipboard binary and then open a network socket under the same process image. Typically rare."
    tuning_guidance = "Add approved remote-support and clipboard-sync binaries to %global_allowed_remote_mgmt, and approved IT tooling to %global_allowed_admin_tools. Extend %rfc1918_internal if the tenant uses additional internal address space. If a tenant legitimately uses a clipboard-sync tool, scope the exclusion by process path rather than by host."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(xclip|xsel|wl-paste|wl-copy)$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1115")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
