/*
  MITRE Technique : T1110 - Brute Force
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:02:40.208073+00:00
  Reference       : https://attack.mitre.org/techniques/T1110
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1110_Account_Lockout_Policy_Weakened {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change to account lockout or bad-password throttling settings in the directory or identity provider. Adversaries weaken these controls (raise the lockout threshold, shorten the lockout duration or observation window, or disable smart lockout) before password guessing, spraying or credential stuffing so that brute force can run without locking accounts. This rule detects the resulting configuration state change, not a command line."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1110"
    mitre_technique_name = "Brute Force"
    log_prerequisites = "Requires identity provider or directory audit logs, including domain or tenant policy change events, normalized to UDM SETTING_MODIFICATION with the setting name in target.resource.name or metadata.description."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Planned password or lockout policy hardening by identity administrators, security baseline or compliance remediation (CIS/STIG alignment), tenant onboarding or migration projects, and automation that reapplies policy through approved service accounts."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and policy automation identities to %global_allowed_service_accounts. Correlate with the change ticket. Any change by an account outside those lists, or outside business hours, should be treated as suspicious. If the connector populates the setting name in a different field, extend the field match accordingly."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    (
      $setting.target.resource.name = /(account.?lockout|lockout.?(threshold|duration|policy|observation)|smart.?lockout|bad.?password|invalid.?(logon|sign.?in).?(count|threshold)|password.?(guess|spray).?protect)/ nocase or
      $setting.metadata.description = /(account.?lockout|lockout.?(threshold|duration|policy|observation)|smart.?lockout|bad.?password|invalid.?(logon|sign.?in).?(count|threshold)|password.?(guess|spray).?protect)/ nocase
    )
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1110")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $changed_setting = array_distinct($setting.target.resource.name)
    $source_ips = array_distinct($setting.principal.ip)

  condition:
    $setting
}
