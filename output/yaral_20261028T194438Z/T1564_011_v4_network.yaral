/*
  MITRE Technique : T1564.011 - Ignore Process Interrupts
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:30:15.592340+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_011_Linux_Nohup_Process_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an outbound connection to a non-internal address made by a Linux process that was started under nohup (hangup-immune execution), identified by nohup in the process command line or as the parent process. Malware and reverse shells use nohup to survive session logoff while keeping a C2 channel open. This is a network-side detection and does not depend on PROCESS_LAUNCH command-line rules."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.011"
    mitre_technique_name = "Hide Artifacts: Ignore Process Interrupts"
    log_prerequisites = "Requires Linux endpoint telemetry (EDR or auditd socket/connect events) that populates NETWORK_CONNECTION with principal process command line and parent process path. The reference list %rfc1918_internal must be populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators starting long-running downloads, rsync/scp transfers, or tunnels with nohup; backup and data-sync jobs launched via nohup; developer or CI jobs (package builds, model training, remote uploads) run detached from a terminal; configuration management or deployment agents that wrap commands in nohup."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and approved parent processes or hosts to %global_allowed_script_hosts. Keep %rfc1918_internal current with each client's internal address space. If a client runs many nohup jobs, raise the severity only when combined with endpoint rules for T1564.011 on the same host."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.principal.process.command_line = /(^|[\s;&|(])nohup(\s|$)/ nocase or
      $net.principal.process.parent_process.file.full_path = /\/nohup$/ nocase
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.parent_process.file.full_path in %global_allowed_script_hosts
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1564.011")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $process_command_lines = array_distinct($net.principal.process.command_line)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
