/*
  MITRE Technique : T1078.001 - Default Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:29:10.229890+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_001_NetDev_External_Mgmt_Access_Then_Device_Outbound {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an external (non-RFC1918) source reaching a network device on a management-plane port (Telnet, SSH, HTTP/HTTPS admin), followed within one hour by that same device initiating an outbound connection to an external host on a file-transfer or remote-shell port (FTP, SSH, Telnet, TFTP). This pattern is consistent with abuse of a default or factory account on an exposed device, followed by config exfiltration or pivoting. Firewall logs do not carry the authenticated account name, so the rule detects the network-observable consequences of default-credential access rather than the login itself."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.001"
    mitre_technique_name = "Valid Accounts: Default Accounts"
    log_prerequisites = "Requires perimeter firewall connection logs (allowed traffic) normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated, covering both inbound management traffic and device-originated outbound traffic."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Vendor or MSP remote support reaching devices over the internet, cloud-managed network devices contacting vendor portals, scheduled config backups to an external SFTP/FTP/TFTP server, and authorised penetration tests."
    tuning_guidance = "Add approved administration source addresses to %global_allowed_mgmt_sources and scanner addresses to %global_allowed_scanners. Add approved external backup or update destinations to %global_allowed_domains. If management access over the internet is never legitimate for a client, consider raising severity to Critical."

  events:
    $mgmt.metadata.event_type = "NETWORK_CONNECTION"
    (
      $mgmt.target.port = 22 or
      $mgmt.target.port = 23 or
      $mgmt.target.port = 80 or
      $mgmt.target.port = 443 or
      $mgmt.target.port = 8080 or
      $mgmt.target.port = 8443
    )
    not $mgmt.principal.ip in %rfc1918_internal
    not $mgmt.principal.ip in %global_allowed_mgmt_sources
    not $mgmt.principal.ip in %global_allowed_scanners
    $mgmt.target.ip = $device_ip

    $out.metadata.event_type = "NETWORK_CONNECTION"
    (
      $out.target.port = 21 or
      $out.target.port = 22 or
      $out.target.port = 23 or
      $out.target.port = 69
    )
    not $out.target.ip in %rfc1918_internal
    not $out.target.hostname in %global_allowed_domains
    $out.principal.ip = $device_ip

    $mgmt.metadata.event_timestamp.seconds <= $out.metadata.event_timestamp.seconds

  match:
    $device_ip over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1078.001")
    $primary_entity = array_distinct($device_ip)
    $external_sources = array_distinct($mgmt.principal.ip)
    $mgmt_ports = array_distinct($mgmt.target.port)
    $outbound_destinations = array_distinct($out.target.ip)
    $outbound_ports = array_distinct($out.target.port)
    $inbound_event_count = count($mgmt.metadata.id)

  condition:
    $mgmt and $out
}
