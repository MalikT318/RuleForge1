/*
  MITRE Technique : T1574.012 - COR_PROFILER
  Tactic(s)       : Stealth, Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:43:57.044980+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_012_COR_PROFILER_Elevated_MMC_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound connection to a non-internal address from a Microsoft Management Console or Event Viewer host process. These .NET-hosting, auto-elevating binaries are commonly hijacked through COR_PROFILER for UAC bypass and persistence, and they rarely make external connections. An external connection indicates that a profiler DLL loaded into the CLR may be beaconing, staging a payload or exfiltrating data. The rule is a network-side observation of the result of the hijack and does not depend on command-line or environment-variable visibility."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.012"
    mitre_technique_name = "Hijack Execution Flow: COR_PROFILER"
    log_prerequisites = "Requires Windows endpoint network telemetry that attributes each connection to its originating process (EDR network events or Sysmon Event ID 3) and populates principal.process.file.full_path, target.ip and principal.hostname."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "MMC snap-ins that contact external services (certificate or CRL retrieval, cloud-hosted management consoles, Microsoft online help or update checks), Event Viewer online-help lookups, and remote administration of externally addressed servers over VPN or NAT. Hosts running approved RMM tooling that drives MMC may also trigger."
    tuning_guidance = "Add approved management tooling to %global_allowed_admin_tools and endpoint security agents to %global_allowed_security_tools. Populate %rfc1918_internal with all client internal ranges. If online-help or CRL traffic is noisy, add the known-good destinations to %global_allowed_domains and extend the rule with a target.hostname exclusion. Review the destination IPs in the outcome and pivot to registry and module-load telemetry for COR_ENABLE_PROFILING / COR_PROFILER on the same host."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(mmc|eventvwr|perfmon)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1574.012")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
