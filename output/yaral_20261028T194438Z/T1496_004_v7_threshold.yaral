/*
  MITRE Technique : T1496.004 - Cloud Service Hijacking
  Tactic(s)       : Impact
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:58:34.154429+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_004_SaaS_Bulk_Messaging_Or_Inference_API_Abuse {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single identity makes a high volume of message-sending or model-inference API calls within ten minutes. This pattern matches cloud service hijacking, such as bulk email/SMS spam or LLMJacking of hosted AI models. Each call is benign on its own; the volume from one identity is the signal."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.004"
    mitre_technique_name = "Resource Hijacking: Cloud Service Hijacking"
    log_prerequisites = "Requires cloud control-plane or data-plane audit logs that record message-send and model-inference API calls (for example data-event logging enabled for messaging and AI services), normalised to USER_RESOURCE_ACCESS with metadata.product_event_type populated."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate bulk notification or marketing senders, application backends calling inference or messaging APIs through a user-attributed identity, load or batch-inference jobs, developer testing of AI features, and authorised email/SMS campaign launches."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts and approved cloud service principals to %global_allowed_cloud_principals. Raise or lower the #cloud threshold per client based on baseline volume. Narrow the product_event_type regex to the services each client actually uses."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /^(invoke|converse|generatecontent|streamgeneratecontent|predict|send(bulk)?(email|rawemail|templatedemail|sms|message|messages)|publish(batch)?$)/ nocase
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($cloud.metadata.id)
    $mitre_technique_id = array_distinct("T1496.004")
    $primary_entity = array_distinct($user)
    $api_calls = array_distinct($cloud.metadata.product_event_type)
    $target_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    #cloud >= 100
}
