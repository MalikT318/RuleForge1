/*
  MITRE Technique : T1505 - Server Software Component
  Tactic(s)       : Persistence
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:24:11.641223+00:00
  Reference       : https://attack.mitre.org/techniques/T1505
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_Inbound_Script_POST_Then_Server_Outbound_Callback {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a web-shell-like pattern in perimeter telemetry. An external client sends an HTTP POST to a server-side script resource (aspx, ashx, asmx, asp, jsp, php, cfm) on an internal server. Within 10 minutes the same server opens an outbound connection to an external address on a non-web port. This suggests a malicious server component being driven remotely and calling back or tunnelling."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505"
    mitre_technique_name = "Server Software Component"
    log_prerequisites = "Requires perimeter or proxy telemetry with URL and HTTP method visibility (TLS inspection or reverse proxy/WAF in front of the web server) normalised to NETWORK_HTTP, plus firewall connection logs normalised to NETWORK_CONNECTION. Internal server IPs must be consistent across both log types (no NAT between the sensor and the server)."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate web applications that POST to script endpoints and make outbound calls to partner APIs, payment gateways, SMTP relays or webhook receivers on non-standard ports. Also authorised vulnerability or penetration-test scanning, and CMS or plugin update routines."
    tuning_guidance = "Add scanner and pentest source IPs to %global_allowed_scanners. Add known application servers that legitimately call out on custom ports to the reference lists used by your onboarding process, or tighten the outbound port exclusions. If TLS inspection is unavailable, this rule will not fire for encrypted POST traffic."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST"
    $http.target.url = /\.(aspx|ashx|asmx|asp|jsp|php|cfm)(\?|$)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    $http.target.ip = $server

    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %rfc1918_internal
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 53
    $net.target.port != 123
    $net.principal.ip = $server

    $http.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $server over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1505")
    $primary_entity = array_distinct($server)
    $client_ips = array_distinct($http.principal.ip)
    $posted_urls = array_distinct($http.target.url)
    $callback_ips = array_distinct($net.target.ip)
    $callback_ports = array_distinct($net.target.port)
    $callback_count = count($net.metadata.id)

  condition:
    $http and $net
}
