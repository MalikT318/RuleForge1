/*
  MITRE Technique : T1649 - Steal or Forge Authentication Certificates
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:52:04.206382+00:00
  Reference       : https://attack.mitre.org/techniques/T1649
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1649_Certificate_Authentication_External_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a successful certificate-based authentication (PKINIT / certificate logon) against the Windows-based directory identity plane from a non-internal source address. Stolen or forged authentication certificates are commonly replayed from attacker infrastructure outside the corporate network to obtain a ticket or token as the impersonated identity. This rule uses identity-provider telemetry only, with no endpoint process fields."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1649"
    mitre_technique_name = "Steal or Forge Authentication Certificates"
    log_prerequisites = "Requires directory/identity sign-in telemetry (for example domain controller Kerberos authentication events or hybrid identity sign-in logs) normalised to USER_LOGIN, with the authentication method populated in extensions.auth.auth_details and a populated principal.ip."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Legitimate smart-card or certificate-based sign-in by remote staff over VPN or from the internet, passwordless certificate authentication for managed devices, and service or automation accounts that authenticate with certificates from cloud-hosted addresses."
    tuning_guidance = "Add expected certificate-authenticating service identities to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Confirm that the auth_details field carries the authentication method in each client's parser. If VPN egress addresses are not in %rfc1918_internal, the rule may fire for remote smart-card users and should be tuned per client."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.extensions.auth.auth_details = /certificate|pkinit|x509/ nocase
    $auth.principal.ip != ""
    not $auth.principal.ip in %rfc1918_internal
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1649")
    $primary_entity = array_distinct($auth.target.user.userid)
    $source_ips = array_distinct($auth.principal.ip)
    $target_hosts = array_distinct($auth.target.hostname)

  condition:
    $auth
}
