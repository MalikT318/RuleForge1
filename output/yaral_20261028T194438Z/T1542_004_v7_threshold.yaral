/*
  MITRE Technique : T1542.004 - ROMMONkit
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:49:46.429415+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_004_ROMMON_Repeated_TFTP_Transfers {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated TFTP (UDP/69) connections from a single source within ten minutes. TFTP is the usual transport for pushing a ROMMON or boot image to a network device. A single TFTP session is routine; several sessions from one source in a short window suggest firmware staging, so this rule flags volume rather than any individual event."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.004"
    mitre_technique_name = "Pre-OS Boot: ROMMONkit"
    log_prerequisites = "Firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip and target.port populated. The firewall must log TFTP (UDP/69) sessions, including internal segment traffic that crosses it."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Scheduled network device configuration or firmware backups and restores, network management or provisioning servers, zero-touch provisioning and PXE/network boot services, lab or staging networks, and authorised device upgrade maintenance windows."
    tuning_guidance = "Add approved management and provisioning server addresses to %global_allowed_mgmt_sources. Raise the threshold on sites with frequent legitimate TFTP backups. Correlate hits with device syslog for reload or boot-variable changes, and with change tickets."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    $net.principal.ip = $src
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1542.004")
    $primary_entity = array_distinct($src)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    #net >= 3
}
