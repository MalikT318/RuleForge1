/*
  MITRE Technique : T1546.002 - Screensaver
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:03:29.273058+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_002_Screensaver_Settings_Burst_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of modifications to screensaver configuration values (SCRNSAVE.EXE, ScreenSaveActive, ScreenSaveTimeout, ScreenSaverIsSecure) under a Control Panel\\Desktop registry key on a single host within 10 minutes. Setting several of these values together is how an adversary enables a malicious screensaver as an inactivity-triggered persistence mechanism. A single value change is common and benign, but a burst is not."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.002"
    mitre_technique_name = "Event Triggered Execution: Screensaver"
    log_prerequisites = "Requires EDR registry telemetry or Sysmon Event IDs 12/13 normalised to REGISTRY_MODIFICATION, with registry key, value name and the modifying process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Users changing screensaver settings through Personalization or Control Panel (which writes several values together), Group Policy or logon scripts that enforce screensaver timeout and lock, VDI or kiosk profile provisioning, and endpoint hardening or compliance tools."
    tuning_guidance = "Add approved configuration and deployment tooling to %global_allowed_admin_tools and EDR or compliance agents to %global_allowed_security_tools. Raise the #reg threshold in noisy environments with frequent GPO or profile provisioning. Review the $values_modified and $modifying_processes outcomes; SCRNSAVE.EXE being set by a non-standard process is the strongest indicator."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control Panel\\Desktop$/ nocase
    $reg.target.registry.registry_value_name = /^(SCRNSAVE\.EXE|ScreenSaveActive|ScreenSaverIsSecure|ScreenSaveTimeout)$/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1546.002")
    $primary_entity = array_distinct($host)
    $event_count = count($reg.metadata.id)
    $values_modified = array_distinct($reg.target.registry.registry_value_name)
    $modifying_processes = array_distinct($reg.principal.process.file.full_path)
    $affected_users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 3
}
