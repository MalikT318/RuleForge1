/*
  MITRE Technique : T1205.001 - Port Knocking
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:10:01.680804+00:00
  Reference       : https://attack.mitre.org/techniques/T1205/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_001_Linux_Port_Knock_Firewall_Rule {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a host firewall rule being added that implements port knocking on Linux. This is an iptables or ip6tables rule using the 'recent' match module with --set, --rcheck or --update, or an nftables rule that adds the source address to a dynamic timeout set. A knock sequence on closed ports then dynamically opens a hidden service port for the adversary's source address. This is the standard OS-level mechanism for stealthy persistence and C2 access."
    mitre_tactic = "Stealth, Persistence, Command and Control"
    mitre_technique = "T1205.001"
    mitre_technique_name = "Traffic Signaling: Port Knocking"
    log_prerequisites = "Requires Linux endpoint process telemetry with full command lines (EDR or auditd EXECVE records) normalised to UDM PROCESS_LAUNCH."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators or configuration management (Ansible, Puppet, Chef, Salt) deploying SSH brute-force rate limiting with the iptables 'recent' module; hardening scripts or CIS benchmark remediation; legitimate port-knocking setups on bastion or jump hosts; container or firewall-management frameworks that manage dynamic nftables sets."
    tuning_guidance = "Add approved configuration-management or firewall-management parent binaries to %global_allowed_admin_tools and approved administrator accounts to %global_allowed_admin_users. Rate-limiting rules that use '-m recent --update --seconds --hitcount' with a DROP target on port 22 are common benign cases, so review those first and exclude by approved parent process. Hosts that are intentional knock-protected bastions should be handled by exclusion at the client level."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(iptables|ip6tables|iptables-nft|iptables-legacy|ip6tables-nft|ip6tables-legacy|nft)$/ nocase
    $proc.target.process.command_line = /(-m\s+recent\b.*--(rcheck|update|set)\b|--(rcheck|update|set)\b.*-m\s+recent\b|\b(add|update)\s+@\S+\s+\{\s*ip6?\s+saddr\b.*timeout)/ nocase
    $proc.principal.hostname = $hostname
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1205.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $firewall_command = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
