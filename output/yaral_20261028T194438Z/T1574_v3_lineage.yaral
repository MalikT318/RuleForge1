/*
  MITRE Technique : T1574 - Hijack Execution Flow
  Tactic(s)       : Stealth, Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:26:57.903525+00:00
  Reference       : https://attack.mitre.org/techniques/T1574
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_Linux_Service_Daemon_Spawns_Shell_Or_Loader {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing service daemon (web server, application runtime, database, cache) spawning a shell, script interpreter, or the dynamic loader directly. Hijacked execution flow in these services, such as a poisoned library or module, a trojaned plugin, or an injected preload, commonly shows up as an unexpected child process. The rule keys on parent-child lineage rather than command-line content."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574"
    mitre_technique_name = "Hijack Execution Flow"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records normalised to UDM PROCESS_LAUNCH, with both parent (principal.process) and child (target.process) executable paths populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "CGI or PHP applications that legitimately shell out, database archive_command or maintenance hooks (postgres, mysqld), web-based admin panels, container health checks run through a shell, deployment hooks launched from the service, and monitoring agents run by the service user."
    tuning_guidance = "Add approved parent binaries to %global_allowed_script_hosts, approved tooling to %global_allowed_admin_tools, and service accounts that run known hook scripts to %global_allowed_service_accounts. Review the parent and child paths in the outcome to decide which application-specific lineage to allowlist per client."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9.]*|php-cgi|uwsgi|gunicorn|mysqld|mariadbd|postgres|mongod|redis-server|memcached)$/ nocase
    $proc.target.process.file.full_path = /(\/(ba|da|a|z|k|c|tc|fi)?sh|\/python[0-9.]*|\/perl|\/ruby|\/lua|\/ld-linux[^\/]*\.so(\.[0-9]+)*|\/ld\.so)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1574")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $service_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
