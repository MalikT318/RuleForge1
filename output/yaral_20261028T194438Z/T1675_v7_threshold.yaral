/*
  MITRE Technique : T1675 - ESXi Administration Command
  Tactic(s)       : Execution
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:21:44.994379+00:00
  Reference       : https://attack.mitre.org/techniques/T1675
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1675_ESXi_Burst_VM_Admin_Shell_Commands {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of VM-management commands (vim-cmd vmsvc operations and esxcli vm process operations) run from the shell of a single ESXi host within ten minutes. A single command is routine administration, but rapid repeated VM enumeration, power-state control, snapshot, unregister or process-kill activity is consistent with an adversary abusing ESXi administration services to operate on hosted VMs."
    mitre_tactic = "Execution"
    mitre_technique = "T1675"
    mitre_technique_name = "ESXi Administration Command"
    log_prerequisites = "ESXi shell command auditing (shell.log / hostd) forwarded and parsed into UDM PROCESS_LAUNCH events with principal.hostname, principal.user.userid and target.process.command_line populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Backup and snapshot orchestration run from the ESXi shell, patching and maintenance-mode scripts, monitoring agents polling VM state, administrators performing bulk VM maintenance or troubleshooting."
    tuning_guidance = "Add approved admin accounts to %global_allowed_admin_users, automation accounts to %global_allowed_service_accounts, and approved tooling parent processes to %global_allowed_admin_tools or %global_allowed_backup_processes. Raise the #proc threshold on hosts with heavy automation; lower it for hosts that are rarely administered by shell."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(vim-cmd\s+vmsvc\/(getallvms|power\.[a-z]+|get\.[a-z]+|snapshot\.[a-z]+|destroy|unregister|reload)|esxcli\s+(--formatter[= ]\S+\s+)?vm\s+process\s+(list|kill))/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(re.regex($proc.target.process.command_line, /(?i)(power\.off|destroy|unregister|process\s+kill|snapshot\.remove)/), 85, 55))
    $mitre_technique_id = array_distinct("T1675")
    $primary_entity = array_distinct($host)
    $event_count = count($proc.metadata.id)
    $users = array_distinct($proc.principal.user.userid)
    $commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 10
}
