/*
  MITRE Technique : T1496.002 - Bandwidth Hijacking
  Tactic(s)       : Impact
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:54:57.502059+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_002_Persistent_Container_Then_Outbound_Bandwidth_Abuse {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a detached container started with an automatic restart policy, followed within 10 minutes by repeated outbound connections to external addresses from a process running out of the container runtime storage on the same Linux host. This pattern is typical of proxyjacking and bandwidth-resale workloads deployed as unattended containers."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.002"
    mitre_technique_name = "Resource Hijacking: Bandwidth Hijacking"
    log_prerequisites = "Requires Linux host or container runtime process telemetry (EDR or auditd execve) with command lines, plus network connection telemetry that carries the originating process path."
    platform = "Linux"
    log_source = "container"
    false_positives = "Legitimate long-running containerised services such as web apps, CI runners, monitoring exporters, update agents, and self-hosted VPN or proxy services started with a restart policy. Developers testing images on shared build hosts."
    tuning_guidance = "Add approved deployment tooling to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and known-good external destinations to %global_allowed_domains. Raise the connection count in the condition (#net >= 5) on busy container hosts, or restrict the rule to hosts outside approved container platforms."

  events:
    $run.metadata.event_type = "PROCESS_LAUNCH"
    $run.target.process.file.full_path = /\/(docker|podman|nerdctl)$/ nocase
    $run.target.process.command_line = /\b(run|create)\b/ nocase
    $run.target.process.command_line = /(\s-[a-z]*d[a-z]*\s|--detach)/ nocase
    $run.target.process.command_line = /--restart[=\s]+(always|unless-stopped)/ nocase
    not $run.principal.process.file.full_path in %global_allowed_admin_tools
    not $run.principal.user.userid in %global_allowed_service_accounts
    $run.principal.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\/var\/lib\/(docker|containerd|containers)\// nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    $net.principal.hostname = $hostname

    $run.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1496.002")
    $primary_entity = array_distinct($run.principal.hostname)
    $container_command = array_distinct($run.target.process.command_line)
    $launching_user = array_distinct($run.principal.user.userid)
    $destination_ips = array_distinct($net.target.ip)
    $connection_count = count($net.metadata.id)

  condition:
    $run and #net >= 5
}
