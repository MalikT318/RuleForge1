/*
  MITRE Technique : T1556.008 - Network Provider DLL
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:25:51.386399+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_008_NetworkProvider_Mpnotify_Lineage_Anomaly {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects process-lineage anomalies around mpnotify.exe, the Windows component that passes logon credentials in cleartext to registered network provider DLLs. Fires when mpnotify.exe is launched by any parent other than winlogon.exe, or when mpnotify.exe itself spawns a shell, script interpreter or proxy-execution binary. Either indicates a malicious network provider DLL (NPLogonNotify credential harvester) or an attempt to impersonate the credential-notification process."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.008"
    mitre_technique_name = "Modify Authentication Process: Network Provider DLL"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with populated parent (principal.process) and child (target.process) image paths, from an EDR, Sysmon Event ID 1, or Security Event 4688 with parent process logging."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Security or EDR agents that spawn or inspect mpnotify.exe during testing; third-party credential providers or SSO and VPN pre-logon network providers whose notification components launch helper processes; administrators or software-verification tooling that run mpnotify.exe manually; lab or red-team exercises."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools and approved deployment or support tooling to %global_allowed_admin_tools. If a legitimate third-party network provider (VPN or SSO client) spawns helper processes from mpnotify.exe, allowlist that child by adding the vendor tooling to %global_allowed_admin_tools. Review the primary entity's HKLM\\SYSTEM\\CurrentControlSet\\Control\\NetworkProvider\\Order\\ProviderOrder value and the registered provider DLLs for unsigned or recently written files."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $proc.target.process.file.full_path = /\\mpnotify\.exe$/ nocase and
        not $proc.principal.process.file.full_path = /\\winlogon\.exe$/ nocase
      ) or
      (
        $proc.principal.process.file.full_path = /\\mpnotify\.exe$/ nocase and
        $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|wmic|bitsadmin|certutil|msiexec)\.exe$/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1556.008")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
