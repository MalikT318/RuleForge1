/*
  MITRE Technique : T1686 - Disable or Modify System Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:28:02.063121+00:00
  Reference       : https://attack.mitre.org/techniques/T1686
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_External_Mgmt_Port_Surge_After_Firewall_Weakening {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a surge of connections from external sources to remote-administration ports (SSH, Telnet, RDP, SMB, WinRM) on a single destination within 10 minutes. Perimeter logs do not show the firewall change itself, so this detects its result: a policy that was disabled, loosened or given a new permissive rule. Each connection alone is routine, but the volume to a single host suggests exposure that was not there before."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686"
    mitre_technique_name = "Disable or Modify System Firewall"
    log_prerequisites = "Requires perimeter or firewall connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Connections must be logged for permitted traffic."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scans or penetration tests, internet-wide background scanning and brute-force noise against intentionally exposed bastion or VPN hosts, vendor remote support sessions, and new service rollouts that legitimately publish a management port."
    tuning_guidance = "Add authorised scanner sources to %global_allowed_scanners and approved external admin or support source addresses to %global_allowed_mgmt_sources. Raise the #net threshold for hosts that are intentionally internet-facing, or lower it for high-security tenants. Review the matched destination against recent firewall change tickets."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 445 or
      $net.target.port = 3389 or
      $net.target.port = 5985 or
      $net.target.port = 5986
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    $net.target.ip = $dst_ip

  match:
    $dst_ip over 10m

  outcome:
    $risk_score = max(if($net.target.port = 3389 or $net.target.port = 23 or $net.target.port = 445, 85, 65))
    $mitre_technique_id = array_distinct("T1686")
    $primary_entity = array_distinct($net.target.ip)
    $connection_count = count($net.metadata.id)
    $source_ips = array_distinct($net.principal.ip)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    #net >= 25
}
