/*
  MITRE Technique : T1047 - Windows Management Instrumentation
  Tactic(s)       : Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:30:36.545063+00:00
  Reference       : https://attack.mitre.org/techniques/T1047
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1047_Remote_Logon_Then_WmiPrvSE_Spawns_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a network logon to a Windows host followed within 10 minutes by the WMI provider host (WmiPrvSE) spawning a shell, script host or LOLBin on that same host. This is the signature of remote WMI execution (for example Win32_Process Create over DCOM or WinRM), and it is detected here from the combination of authentication and process lineage, not from command-line matching."
    mitre_tactic = "Execution"
    mitre_technique = "T1047"
    mitre_technique_name = "Windows Management Instrumentation"
    log_prerequisites = "Requires Windows Security logon events (4624 with network logon type) normalised to USER_LOGIN, and EDR or Sysmon process telemetry with parent process populated (PROCESS_LAUNCH)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Configuration management and monitoring platforms that run commands over WMI, SCCM/Intune-style deployment agents, admins running remote WMI administration scripts, and inventory or patching tooling."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users, automation accounts to %global_allowed_service_accounts, and approved management or deployment child binaries to %global_allowed_admin_tools. If a specific management server generates noise, add its account to the service account list rather than loosening the child-process filter."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.extensions.auth.mechanism = "NETWORK"
    $auth.target.hostname = $hostname
    $auth.target.user.userid != ""
    not $auth.target.user.userid = /\$$/
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.target.user.userid in %global_allowed_service_accounts

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\wmiprvse\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|mshta|rundll32|regsvr32|wscript|cscript|certutil|bitsadmin|msiexec)\.exe$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $auth.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1047")
    $primary_entity = array_distinct($proc.principal.hostname)
    $logon_users = array_distinct($auth.target.user.userid)
    $logon_source_ips = array_distinct($auth.principal.ip)
    $spawned_processes = array_distinct($proc.target.process.file.full_path)
    $spawned_command_lines = array_distinct($proc.target.process.command_line)
    $logon_count = count($auth.metadata.id)

  condition:
    $auth and $proc
}
