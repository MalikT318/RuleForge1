/*
  MITRE Technique : T1059.007 - JavaScript
  Tactic(s)       : Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:16:58.826875+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_007_Script_File_Dropped_By_Delivery_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a JScript/JavaScript-hosted script file (.js, .jse, .wsf, .hta) in a user-writable staging location by a browser, mail client, Office application, or archive handler. This is the file-delivery stage that precedes Windows Script Host or mshta execution. It is file-creation based and deliberately does not match process command lines, so it complements existing PROCESS_LAUNCH rules."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.007"
    mitre_technique_name = "Command and Scripting Interpreter: JavaScript"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating principal.process.file.full_path and target.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Users saving legitimate .js or .hta files from the web or email, developers and web designers extracting archives containing JavaScript, installers that unpack temporary scripts, and IT staff downloading admin scripts."
    tuning_guidance = "Add approved deployment or packaging processes to %global_allowed_admin_tools and approved developer or build hosts and parent processes to %global_allowed_script_hosts. Remove 'hta' or 'js' from the extension regex if the environment is too noisy. Pair with a PROCESS_LAUNCH rule on wscript/cscript/mshta to confirm execution."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(js|jse|wsf|hta)$/ nocase
    $file.target.file.full_path = /\\users\\[^\\]+\\(downloads|desktop|appdata\\local\\temp|appdata\\local\\microsoft\\windows\\inetcache\\content\.outlook)\\/ nocase
    $file.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|chrome|msedge|firefox|brave|7zfm|7zg|winrar|explorer)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1059.007")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file = array_distinct($file.target.file.full_path)
    $dropper_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
