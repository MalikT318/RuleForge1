/*
  MITRE Technique : T1484.001 - Group Policy Modification
  Tactic(s)       : Defense Impairment, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:33:14.468280+00:00
  Reference       : https://attack.mitre.org/techniques/T1484/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1484_001_Script_Host_LDAP_To_Domain_Controller {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side indicator of possible GPO tampering. A scripting interpreter or LOLBin opens an LDAP/LDAPS/Global Catalog session to an internal directory server. GPO links and attributes such as gPLink and gPCFileSysPath are written over these ports, so scripted modification (for example the GroupPolicy PowerShell module or ADSI) produces this connection. The destination is deliberately required to be INTERNAL (%rfc1918_internal used as an inclusion list), because GPO changes are east-west traffic to a domain controller. External destinations are out of scope. This is deliberately a lower-fidelity hunting-grade signal that complements endpoint command-line rules, and it should be correlated with GPO change events (5136/5137/5141) and SYSVOL file writes."
    mitre_tactic = "Defense Impairment, Privilege Escalation"
    mitre_technique = "T1484.001"
    mitre_technique_name = "Domain or Tenant Policy Modification: Group Policy Modification"
    log_prerequisites = "Requires endpoint network telemetry that populates the owning process (EDR network events or Sysmon Event ID 3) with principal.process.file.full_path and target.port."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators running AD or GPO management scripts, logon scripts that query LDAP, IT inventory and identity-governance automation, RMM and patching agents using PowerShell for directory lookups, and developers testing AD-integrated scripts."
    tuning_guidance = "Add approved automation hosts to %global_allowed_script_hosts, approved tooling to %global_allowed_admin_tools, jump hosts and management stations to %global_allowed_mgmt_sources, and named GPO administrators to %global_allowed_admin_users. Add service accounts to %global_allowed_service_accounts. Consider raising severity for non-admin workstations (not in the allow lists) connecting to a domain controller."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta|wmic|rundll32|regsvr32|msbuild|installutil|csc)\.exe$/ nocase
    (
      $net.target.port = 389 or
      $net.target.port = 636 or
      $net.target.port = 3268 or
      $net.target.port = 3269
    )
    $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.principal.hostname in %global_allowed_mgmt_sources
    not $net.principal.user.userid in %global_allowed_admin_users
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1484.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $initiating_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
