/*
  MITRE Technique : T1553.003 - SIP and Trust Provider Hijacking
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:03:36.129127+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_003_SIP_Trust_Provider_DLL_Drop_Then_Registry_Hijack {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a DLL written to a user-writable or staging directory, followed within 10 minutes on the same host by a registry modification to a SIP (CryptSIPDll*) or trust provider (Providers\\Trust\\FinalPolicy, Certification) registration key. This pattern indicates an adversary registering a rogue signature-validation DLL so that unsigned or malicious code validates as trusted."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.003"
    mitre_technique_name = "Subvert Trust Controls: SIP and Trust Provider Hijacking"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (e.g. Sysmon Event 11) and registry modification telemetry (e.g. Sysmon Events 12/13/14), both normalised to UDM with principal.hostname populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Code-signing and packaging toolkits (Windows SDK, signing appliances, installer frameworks) that register custom SIPs; third-party software installers or updaters that register their own SIP or trust provider (e.g. document, PDF or Java signing components); EDR or application control agents that register trust providers; legitimate OS servicing."
    tuning_guidance = "Add approved installer, deployment and signing tool binaries to %global_allowed_admin_tools and endpoint security agents to %global_allowed_security_tools. If a client legitimately uses a custom SIP, scope an exclusion by the registering process rather than by install path. Consider raising severity to Critical where the registering process is a script interpreter or runs from a user-writable directory."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.dll$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\|programdata\\|windows\\temp\\|temp\\|perflogs\\|\$recycle\.bin\\|users\\public\\)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Cryptography\\(OID\\EncodingType 0\\CryptSIPDll(GetSignedDataMsg|PutSignedDataMsg|CreateIndirectData|VerifyIndirectData|RemoveSignedDataMsg|IsMyFileType2|GetCaps)|Providers\\Trust\\(FinalPolicy|Certification|Cleanup|DiagnosticPolicy|Initialization|Message|Signature))\\/ nocase
    $reg.target.registry.registry_value_name = /dll|funcname|function/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1553.003")
    $primary_entity = array_distinct($reg.principal.hostname)
    $dropped_dll_paths = array_distinct($file.target.file.full_path)
    $dropping_processes = array_distinct($file.principal.process.file.full_path)
    $modified_registry_keys = array_distinct($reg.target.registry.registry_key)
    $registering_processes = array_distinct($reg.principal.process.file.full_path)
    $registering_users = array_distinct($reg.principal.user.userid)

  condition:
    $file and $reg
}
