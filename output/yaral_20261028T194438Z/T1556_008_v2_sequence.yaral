/*
  MITRE Technique : T1556.008 - Network Provider DLL
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:25:32.952264+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_008_NetProvider_DLL_Drop_Then_Registration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A DLL is written to a system or world-writable staging location and, within 10 minutes on the same host, a Network Provider registration value (ProviderPath or ProviderOrder) is modified in the registry. This sequence indicates a rogue credential-manager DLL being installed so that mpnotify.exe passes cleartext logon credentials to it."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.008"
    mitre_technique_name = "Modify Authentication Process: Network Provider DLL"
    log_prerequisites = "Requires EDR or Sysmon-equivalent file creation telemetry (Sysmon EID 11) and registry value-set telemetry (Sysmon EID 12/13) normalised to UDM FILE_CREATION and REGISTRY_MODIFICATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate installs of VPN clients, remote access or SSO agents, and credential providers such as network client or storage software that register a network provider; OS servicing and feature updates; RMM or software deployment tooling pushing these agents."
    tuning_guidance = "Add approved deployment and installer binaries to %global_allowed_admin_tools and approved remote access tooling to %global_allowed_remote_mgmt. Review the registry values and DLL paths in the outcome to confirm the DLL is signed by a known vendor before adding any exclusion."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(windows\\(system32|syswow64|temp)|programdata|users\\public)\\[^\\]+\.dll$/ nocase
    not $file.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(services\\[^\\]+\\networkprovider|control\\networkprovider\\order)$/ nocase
    $reg.target.registry.registry_value_name = /^(providerpath|providerorder)$/ nocase
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    $reg.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1556.008")
    $primary_entity = array_distinct($reg.principal.hostname)
    $dropped_dll_paths = array_distinct($file.target.file.full_path)
    $dropping_processes = array_distinct($file.principal.process.file.full_path)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_data)
    $acting_users = array_distinct($reg.principal.user.userid)

  condition:
    $file and $reg
}
