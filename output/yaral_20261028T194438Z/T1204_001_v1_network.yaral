/*
  MITRE Technique : T1204.001 - Malicious Link
  Tactic(s)       : Execution
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:58:30.708744+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_001_Browser_Download_Of_Executable_Content_From_External_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows browser-style HTTP GET to an external host for a URL that ends in an executable, script, shortcut, installer or disk-image extension. This is the network-side footprint of a user clicking a malicious link that delivers content requiring execution. It is based on proxy or firewall HTTP telemetry only and does not rely on endpoint process data."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.001"
    mitre_technique_name = "User Execution: Malicious Link"
    log_prerequisites = "Requires proxy or firewall HTTP logging with full URL and user-agent populated (NETWORK_HTTP), e.g. TLS-inspecting perimeter devices. Without TLS inspection, URL paths for HTTPS traffic are not visible."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate software downloads by users or IT (installers, vendor patches, drivers) from sites not yet in the known-good domain list; developers pulling .jar or .ps1 files; software update mechanisms that use a browser-like user agent; internal download portals served from public addresses."
    tuning_guidance = "Add known-good vendor, CDN and update domains to %global_allowed_domains. Confirm %rfc1918_internal covers client internal ranges. If noise remains, narrow the extension list per client (for example remove jar or img) or require a successful response code. If the log source does not populate target.hostname, rely on URL-based tuning instead."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.network.http.user_agent = /(?i)mozilla.*windows nt/
    $net.target.url = /(?i)\.(exe|msi|msix|appx|scr|hta|js|jse|vbs|vbe|wsf|ps1|bat|cmd|lnk|iso|img|jar|dll)(\?.*)?$/
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1204.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
