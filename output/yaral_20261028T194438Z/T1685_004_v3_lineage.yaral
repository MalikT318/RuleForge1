/*
  MITRE Technique : T1685.004 - Disable or Modify Linux Audit System Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:21:57.793729+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_004_Audit_Tampering_From_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects a web server, application server, or database service process directly spawning a shell, service-control utility, auditctl, or file-manipulation utility whose arguments reference the Linux Audit system (auditd, auditctl, /etc/audit, audit.rules). Network-facing service processes have no legitimate reason to administer the audit subsystem, so this lineage indicates a webshell, injection, or exploited service attempting to blind host logging."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.004"
    mitre_technique_name = "Disable or Modify Linux Audit System Log"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry normalised to PROCESS_LAUNCH with populated parent (principal.process) and child (target.process) paths and the child command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Application installers or configuration-management hooks run from a database or web service context (e.g. a package post-install script triggered by a service-managed update), admin-built web consoles that deliberately manage auditd, containerised workloads where the service is PID 1 and runs setup scripts at start-up."
    tuning_guidance = "Add legitimate parent binaries to %global_allowed_admin_tools, trusted automation accounts to %global_allowed_service_accounts, and approved wrapper or orchestration parents to %global_allowed_script_hosts. Extend the parent regex with additional customer-specific service daemons if required."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(httpd|apache2|nginx|lighttpd|php-fpm[0-9.]*|php-cgi|tomcat[0-9]*|catalina|java|gunicorn|uwsgi|node|mysqld|mariadbd|postgres|mongod|redis-server)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ksh|csh|tcsh|busybox|python[0-9.]*|perl|auditctl|augenrules|systemctl|service|pkill|killall|kill|sed|tee|rm|mv|cp|truncate|chattr)$/ nocase
    $proc.target.process.command_line = /(auditd|auditctl|augenrules|audit\.rules|audit\.conf|auditd\.conf|\/etc\/audit|\/etc\/libaudit\.conf|audit\.rules\.d)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1685.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
