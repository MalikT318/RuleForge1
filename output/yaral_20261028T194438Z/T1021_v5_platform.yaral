/*
  MITRE Technique : T1021 - Remote Services
  Tactic(s)       : Lateral Movement
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:33:47.073891+00:00
  Reference       : https://attack.mitre.org/techniques/T1021
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_RDP_Enabled_Via_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Terminal Server fDenyTSConnections registry value being set to 0, which enables inbound Remote Desktop on a Windows host. Adversaries do this to prepare a host for RDP lateral movement with valid accounts (T1021.001). This rule uses registry telemetry rather than process command-line matching, so it also catches changes made through APIs, WMI, PowerShell cmdlets or injected code."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021"
    mitre_technique_name = "Remote Services"
    log_prerequisites = "Requires endpoint registry modification telemetry (EDR or Sysmon Event ID 13) that populates the registry key, value name and value data fields."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy applying an RDP-enable setting, golden image or build automation, RMM and remote support tooling enabling RDP, helpdesk staff enabling RDP by hand on a server, and VDI provisioning."
    tuning_guidance = "Add approved deployment and RMM binaries to %global_allowed_admin_tools and %global_allowed_remote_mgmt, and named administrators to %global_allowed_admin_users. If Group Policy enables RDP on managed servers, route those hosts or writer processes through the allowlists. If the EDR does not populate registry_value_data, remove that line and accept a higher alert volume."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control\\Terminal Server$/ nocase
    $reg.target.registry.registry_value_name = /^fDenyTSConnections$/ nocase
    $reg.target.registry.registry_value_data = /^(DWORD \(0x0+\)|0x0+|0)$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1021")
    $primary_entity = array_distinct($reg.principal.hostname)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
