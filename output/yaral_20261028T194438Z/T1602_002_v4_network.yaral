/*
  MITRE Technique : T1602.002 - Network Device Configuration Dump
  Tactic(s)       : Collection
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:20:14.982719+00:00
  Reference       : https://attack.mitre.org/techniques/T1602/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_002_External_Access_To_Network_Device_Config_Protocols {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a connection from an external (non-internal) source address to a network device on a management protocol commonly abused to dump device configuration: Cisco Smart Install (TCP 4786), SNMP (161) or TFTP (69). Observed from the network perimeter, so no endpoint process data is needed."
    mitre_tactic = "Collection"
    mitre_technique = "T1602.002"
    mitre_technique_name = "Data from Configuration Repository: Network Device Configuration Dump"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. The firewall must log permitted and denied inbound traffic to device management addresses."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "External network monitoring or SNMP polling platforms, managed-service NOC tooling, vulnerability scanners and authorised penetration tests, ISP or vendor remote support, and legitimate TFTP or Smart Install use during device provisioning from a remote site."
    tuning_guidance = "Add approved monitoring, NOC and provisioning source addresses to %global_allowed_mgmt_sources. Add authorised scanner sources to %global_allowed_mgmt_sources as well, since no scanner list holds addresses in this tenant. Make sure %rfc1918_internal contains all internal and VPN address space so site-to-site and remote-access traffic is not treated as external. Treat any hit with permitted traffic to a device as critical."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 4786 or
      $net.target.port = 161 or
      $net.target.port = 69
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1602.002")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
