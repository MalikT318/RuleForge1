/*
  MITRE Technique : T1569.003 - Systemctl
  Tactic(s)       : Execution
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:13:56.614595+00:00
  Reference       : https://attack.mitre.org/techniques/T1569/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_003_Linux_Systemctl_Unit_From_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects systemctl being used to link, enable, or start a service, timer, or socket unit that resides in a world-writable or user-writable location (/tmp, /var/tmp, /dev/shm, /home, /run/user). Legitimate units are installed under /etc/systemd, /usr/lib/systemd, or /lib/systemd. Units loaded from writable paths are a strong indicator that an adversary is using systemctl to execute arbitrary commands as a service."
    mitre_tactic = "Execution"
    mitre_technique = "T1569.003"
    mitre_technique_name = "System Services: Systemctl"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records (with full command-line arguments) normalised to UDM PROCESS_LAUNCH."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers or CI runners testing unit files from home or temp directories, configuration management agents staging units in /tmp before moving them, container build pipelines, and software installers that briefly start units from extracted archives."
    tuning_guidance = "Add approved deployment and configuration tooling to %global_allowed_admin_tools (matched against the parent process path). Add automation accounts to %global_allowed_service_accounts. Consider adding build servers to the exclusions if development workflows legitimately start units from home directories."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/systemctl$/ nocase
    $proc.target.process.command_line = /\b(link|enable|start|restart|reload-or-restart|try-restart|reenable)\b/ nocase
    $proc.target.process.command_line = /(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/home\/[^\/\s]+\/|\/run\/user\/)[^\s]*\.(service|timer|socket)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1569.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
