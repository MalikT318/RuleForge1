/*
  MITRE Technique : T1499.003 - Application Exhaustion Flood
  Tactic(s)       : Impact
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:21:40.063023+00:00
  Reference       : https://attack.mitre.org/techniques/T1499/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1499_003_Cloud_Compute_Resource_Creation_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single cloud identity issues an abnormal burst of compute-type resource creation API calls (instances, functions, clusters, containers, load balancers, scaling actions) within ten minutes. Each call is benign alone, but sustained volume from one principal can exhaust account quotas, API rate limits and capacity, denying availability to hosted applications."
    mitre_tactic = "Impact"
    mitre_technique = "T1499.003"
    mitre_technique_name = "Endpoint Denial of Service: Application Exhaustion Flood"
    log_prerequisites = "Cloud control-plane audit logs (management or admin activity) ingested and normalised to UDM with RESOURCE_CREATION events, principal.user.userid and metadata.product_event_type populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Infrastructure-as-code pipelines, autoscaling controllers, CI/CD deployment roles, disaster-recovery failover tests, container orchestration scale-outs, and legitimate bulk provisioning by administrators."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, approved service principals to %global_allowed_cloud_principals and named admins to %global_allowed_admin_users. Raise or lower the #cloud threshold per client based on baseline provisioning volume. Extend or narrow the product_event_type regex to match the client's provider API naming."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /(instance|virtualmachine|vm|function|cluster|container|loadbalancer|autoscal|scale|nodegroup|deployment)/ nocase
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1499.003")
    $primary_entity = array_distinct($user)
    $event_count = count($cloud.metadata.id)
    $api_calls = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)
    $created_resources = array_distinct($cloud.target.resource.name)

  condition:
    #cloud >= 25
}
