/*
  MITRE Technique : T1606.001 - Web Cookies
  Tactic(s)       : Credential Access
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:24:45.328633+00:00
  Reference       : https://attack.mitre.org/techniques/T1606/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1606_001_SaaS_Repeated_External_Session_Logins_Per_User {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects an unusually high volume of login events for a single SaaS user from external source addresses within ten minutes. A forged or replayed session cookie or token can produce repeated session establishment without normal interactive authentication. Severity and risk score scale with volume and source diversity."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1606.001"
    mitre_technique_name = "Forge Web Credentials: Web Cookies"
    log_prerequisites = "Requires Microsoft 365 or Google Workspace unified audit or sign-in logs normalised to UDM USER_LOGIN events with principal.user.userid and principal.ip populated."
    platform = "SaaS"
    log_source = "m365"
    false_positives = "Users behind rotating corporate proxies or VPN egress pools, mobile clients that re-authenticate frequently, email and calendar sync clients with short-lived tokens, unlisted service or automation accounts, and shared kiosk or VDI sessions."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, named administrators to %global_allowed_admin_users, and known corporate egress addresses to %global_allowed_mgmt_sources. Raise the #auth threshold in condition for tenants with chatty token-refresh clients."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid = $user
    $auth.principal.user.userid != ""
    $auth.principal.ip != ""
    not $auth.principal.ip in %rfc1918_internal
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $login_count = count($auth.metadata.id)
    $source_ips = array_distinct($auth.principal.ip)
    $risk_score = max(if($login_count >= 25, 85, 60))
    $mitre_technique_id = array_distinct("T1606.001")
    $primary_entity = array_distinct($user)

  condition:
    #auth >= 10
}
