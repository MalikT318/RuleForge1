/*
  MITRE Technique : T1685.001 - Disable or Modify Windows Event Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:17:29.025104+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_001_EventLog_Channel_Or_Service_Disabled_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry-level disabling of Windows Event Logging: a WINEVT channel's Enabled value set to 0, or the EventLog service Start value set to 4 (Disabled). This is independent of process command lines, so it also catches API, script, or direct-registry tampering that command-line rules miss. Note: the requested 'alternate platform' angle conflicts with the mandatory Windows platform requirement. The rule stays on Windows and gets its additive coverage by pivoting from process command line to registry telemetry."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.001"
    mitre_technique_name = "Disable or Modify Windows Event Log"
    log_prerequisites = "Requires endpoint registry modification telemetry (EDR or Sysmon registry events) covering HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels, HKLM\\SYSTEM\\CurrentControlSet\\Services\\WINEVT\\Channels and HKLM\\SYSTEM\\CurrentControlSet\\Services\\EventLog."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT or RMM tooling that toggles analytic/debug channels; software installers that register or disable their own event channels; GPO or baseline hardening scripts; performance troubleshooting by administrators."
    tuning_guidance = "Add approved tooling executables to %global_allowed_admin_tools and EDR/security agents to %global_allowed_security_tools. Add named administrators to %global_allowed_admin_users. If the Security, System or Sysmon channels are the main concern, restrict the channel regex to those names. Confirm the sensor reports registry_value_data in a DWORD format that the data regexes match."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      (
        (
          $reg.target.registry.registry_key = /\\WINEVT\\Channels\\[^\\]+\\Enabled$/ nocase or
          (
            $reg.target.registry.registry_key = /\\WINEVT\\Channels\\[^\\]+$/ nocase and
            $reg.target.registry.registry_value_name = "Enabled" nocase
          )
        ) and
        $reg.target.registry.registry_value_data = /^(dword \()?(0x0+|0)\)?$/ nocase
      ) or
      (
        (
          $reg.target.registry.registry_key = /\\Services\\EventLog\\Start$/ nocase or
          (
            $reg.target.registry.registry_key = /\\Services\\EventLog$/ nocase and
            $reg.target.registry.registry_value_name = "Start" nocase
          )
        ) and
        $reg.target.registry.registry_value_data = /^(dword \()?(0x0*4|4)\)?$/ nocase
      )
    )
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_keys = array_distinct($reg.target.registry.registry_key)
    $actor_process = array_distinct($reg.principal.process.file.full_path)
    $actor_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
