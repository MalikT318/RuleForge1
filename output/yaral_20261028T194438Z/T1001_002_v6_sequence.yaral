/*
  MITRE Technique : T1001.002 - Steganography
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:08:58.503191+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_002_Linux_Image_Download_Then_Embedded_Payload_Decode {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a likely steganographic C2 or payload delivery chain on Linux. A host first uses curl or wget to fetch a remote image into a world-writable directory (/tmp, /var/tmp, /dev/shm). Within 10 minutes a shell then reads an image file from one of those directories, extracts or decodes embedded data (base64 -d, xxd -r, openssl enc -d, tail -c, dd skip=) and pipes the result into an interpreter. The rule matches the behaviour of extracting and executing data hidden in an image, not a specific tool or payload."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001.002"
    mitre_technique_name = "Data Obfuscation: Steganography"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records normalised to PROCESS_LAUNCH, with full command line and process path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Build and deployment scripts that download image assets and post-process them with base64 or dd; developers testing image handling; configuration management and RMM tooling pulling icons or branding assets; backup or forensics scripts carving data from images."
    tuning_guidance = "Add approved download tooling or parent processes to %global_allowed_admin_tools and approved automation hosts or interpreters to %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts. If the rule is noisy, narrow the interpreter pipe regex or extend the time window per client."

  events:
    $dl.metadata.event_type = "PROCESS_LAUNCH"
    $dl.target.process.file.full_path = /\/(curl|wget)$/ nocase
    $dl.target.process.command_line = /https?:\/\/\S+\.(jpe?g|png|gif|bmp|webp|ico|tiff?)(\?\S*)?(\s|$)/ nocase
    $dl.target.process.command_line = /(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/)/ nocase
    not $dl.principal.process.file.full_path in %global_allowed_admin_tools
    not $dl.principal.user.userid in %global_allowed_service_accounts
    $dl.principal.hostname = $hostname

    $ext.metadata.event_type = "PROCESS_LAUNCH"
    $ext.target.process.file.full_path = /\/(ba|da|z|k)?sh$/ nocase
    $ext.target.process.command_line = /(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/)\S*\.(jpe?g|png|gif|bmp|webp|ico|tiff?)/ nocase
    $ext.target.process.command_line = /(base64\s+(-d|--decode)|xxd\s+-r|openssl\s+enc\s+-d|tail\s+-c|dd\s+.*skip=)/ nocase
    $ext.target.process.command_line = /\|\s*(\/\S+\/)?(ba|da|z|k)?sh\b|\|\s*(\/\S+\/)?(python[0-9.]*|perl|ruby)\b/ nocase
    not $ext.principal.process.file.full_path in %global_allowed_script_hosts
    not $ext.principal.user.userid in %global_allowed_service_accounts
    $ext.principal.hostname = $hostname

    $dl.metadata.event_timestamp.seconds <= $ext.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1001.002")
    $primary_entity = array_distinct($hostname)
    $download_commands = array_distinct($dl.target.process.command_line)
    $decode_commands = array_distinct($ext.target.process.command_line)
    $users = array_distinct($ext.principal.user.userid)
    $event_count = count($ext.metadata.id)

  condition:
    $dl and $ext
}
