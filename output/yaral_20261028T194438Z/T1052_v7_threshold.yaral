/*
  MITRE Technique : T1052 - Exfiltration Over Physical Medium
  Tactic(s)       : Exfiltration
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:42:10.414863+00:00
  Reference       : https://attack.mitre.org/techniques/T1052
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1052_Windows_Bulk_Copy_To_NonSystem_Drive_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of file copy or move commands (cmd, robocopy, xcopy, PowerShell) whose destination is a non-system drive letter (D: to Z:) on a single host within 10 minutes. Individually benign, but in volume this indicates staging or bulk transfer of data to removable media such as USB drives or external disks."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1052"
    mitre_technique_name = "Exfiltration Over Physical Medium"
    log_prerequisites = "Requires EDR process telemetry, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and imaging jobs, IT data migration scripts, users copying to secondary internal data partitions, mapped network drives, software deployment from secondary volumes, developers copying build artifacts to a secondary drive."
    tuning_guidance = "Add approved backup tooling to %global_allowed_backup_processes, deployment and migration tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Raise the #proc threshold on hosts with a secondary data drive. Consider correlating with removable-storage device insertion events where available."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /\b(robocopy|xcopy|copy|move|copy-item|move-item|cp|mv)\b.*[\s"'][d-z]:\\/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1052")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $sample_commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 10
}
