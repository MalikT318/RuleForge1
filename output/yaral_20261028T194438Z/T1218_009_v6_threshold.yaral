/*
  MITRE Technique : T1218.009 - Regsvcs/Regasm
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:54:00.695011+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_009_Regsvcs_Regasm_Repeated_External_Connections {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects regsvcs.exe or regasm.exe making repeated external network connections from a single host within 10 minutes. These .NET registration utilities do not normally initiate outbound traffic. Repeated connections suggest a proxied-execution payload (ComRegisterFunction / ComUnregisterFunction) is performing C2 beaconing, staging, or exfiltration. The rule uses network telemetry attributed to the process, not process-launch command lines."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.009"
    mitre_technique_name = "System Binary Proxy Execution: Regsvcs/Regasm"
    log_prerequisites = "Requires Windows endpoint telemetry (EDR or Sysmon Event ID 3) with network connection events that populate principal.process.file.full_path and target.ip."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Installers or deployment tooling that register .NET assemblies and fetch remote resources (for example a UNC or proxied path); developer build machines running regasm against assemblies that call out; software packaging pipelines; RMM tooling that wraps regasm."
    tuning_guidance = "Add approved deployment or packaging parent binaries to %global_allowed_admin_tools and approved EDR or security agents to %global_allowed_security_tools. Raise the #net threshold on developer or build hosts. Common outbound proxy addresses can be excluded after review."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(regsvcs|regasm)\.exe$/ nocase
    $net.principal.hostname = $host
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1218.009")
    $primary_entity = array_distinct($host)
    $connection_count = count($net.metadata.id)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $affected_users = array_distinct($net.principal.user.userid)

  condition:
    #net >= 3
}
