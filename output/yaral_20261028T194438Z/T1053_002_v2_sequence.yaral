/*
  MITRE Technique : T1053.002 - At
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:12:34.947823+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_002_At_Job_Created_Then_Interpreter_Spawned_By_Scheduler {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects creation of a legacy At-style scheduled task (task name of the form At<N>, as produced by at.exe or the Win32_ScheduledJob WMI class) followed within one hour, on the same host, by the Task Scheduler service host (svchost.exe) spawning a script interpreter or proxy-execution binary. This correlates task registration with task execution rather than matching the at.exe command line."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.002"
    mitre_technique_name = "Scheduled Task/Job: At"
    log_prerequisites = "Requires Windows Security event 4698 (scheduled task created, normalised to SCHEDULED_TASK_CREATION with the task name in target.resource.name) or equivalent EDR task telemetry, plus EDR/Sysmon process launch telemetry with parent process lineage."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy line-of-business applications and batch jobs that still register At-style jobs; software deployment or patching agents that schedule interpreter-based tasks; administrators using At jobs for maintenance windows. Other scheduled tasks on the same host that legitimately launch interpreters within the hour may add noise."
    tuning_guidance = "Add expected automation accounts to %global_allowed_service_accounts, and add hosts or parents that routinely run scheduled scripts (for example patching or batch servers) to %global_allowed_script_hosts. If noisy, shorten the match window or require the spawned interpreter command line to contain additional suspicious flags."

  events:
    $task.metadata.event_type = "SCHEDULED_TASK_CREATION"
    $task.target.resource.name = /^\\?At\d+$/ nocase
    not $task.principal.user.userid in %global_allowed_service_accounts
    $task.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\svchost\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32)\.exe$/ nocase
    not $proc.principal.hostname in %global_allowed_script_hosts
    $proc.principal.hostname = $hostname

    $task.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1053.002")
    $primary_entity = array_distinct($task.principal.hostname)
    $task_names = array_distinct($task.target.resource.name)
    $task_creator = array_distinct($task.principal.user.userid)
    $spawned_processes = array_distinct($proc.target.process.file.full_path)
    $spawned_command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $task and $proc
}
