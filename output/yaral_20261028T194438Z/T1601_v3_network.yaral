/*
  MITRE Technique : T1601 - Modify System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:11:00.932313+00:00
  Reference       : https://attack.mitre.org/techniques/T1601
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_External_TFTP_Image_Transfer_Firewall {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a TFTP connection (destination port 69) crossing the perimeter to a non-internal address. TFTP is a common transport for pushing or pulling network device operating system images and configurations. An internal network device fetching or sending an image over the internet suggests an attempt to replace or modify the device system image, and TFTP is unauthenticated and unencrypted. This is the network-side view of the technique and complements endpoint and management-plane coverage."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1601"
    mitre_technique_name = "Modify System Image"
    log_prerequisites = "Firewall, proxy or perimeter connection logs that are normalised to UDM NETWORK_CONNECTION with target.ip and target.port populated. The %rfc1918_internal reference list must be populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised remote firmware staging or vendor-hosted TFTP image repositories used during planned upgrades, remote branch provisioning or zero-touch deployment, lab or test devices that reach external TFTP servers, and legacy PXE or boot-server traffic that is routed through the perimeter."
    tuning_guidance = "Add approved upgrade or jump-host source addresses to %global_allowed_mgmt_sources. Add approved admin or automation identities to %global_allowed_service_accounts if user context is present. During change windows, scope the rule to network device address groups at the client level. Raise severity to Critical if the source is a known router, switch or firewall management address."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1601")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
