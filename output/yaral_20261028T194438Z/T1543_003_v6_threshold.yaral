/*
  MITRE Technique : T1543.003 - Windows Service
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:56:47.293910+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_003_Service_Registry_Config_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several Windows service configuration registry writes (ImagePath, ServiceDll, FailureCommand) occur on a single host within ten minutes. One service registration is normal. A burst of service executable or recovery command changes points to persistence or privilege escalation by service or driver installation, or to tampering with existing services. This detects the registry result of service creation or modification regardless of the tool (sc.exe, API, direct registry edit, or driver loader), so it is not dependent on command lines."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.003"
    mitre_technique_name = "Create or Modify System Process: Windows Service"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event IDs 12/13/14 or equivalent) normalised to REGISTRY_MODIFICATION with target.registry.registry_key and registry_value_name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and upgrades registering several services or drivers, RMM and patch-deployment agents, endpoint agent installs or upgrades, imaging and golden-image build hosts, and driver installs (printers, VPN, virtualisation)."
    tuning_guidance = "Add approved deployment, RMM and patching binaries to %global_allowed_admin_tools and EDR/AV agent binaries to %global_allowed_security_tools. Raise the #reg threshold on build and imaging hosts. Add known automation accounts to %global_allowed_service_accounts. Review the writing process and ImagePath values in the outcome before escalating."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(CurrentControlSet|ControlSet\d{3})\\Services\\[^\\]+/ nocase
    $reg.target.registry.registry_value_name = /^(ImagePath|ServiceDll|FailureCommand)$/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(count($reg.metadata.id) >= 10, 85, 60))
    $event_count = count($reg.metadata.id)
    $mitre_technique_id = array_distinct("T1543.003")
    $primary_entity = array_distinct($host)
    $service_keys = array_distinct($reg.target.registry.registry_key)
    $writing_processes = array_distinct($reg.principal.process.file.full_path)
    $users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 3
}
