/*
  MITRE Technique : T1612 - Build Image on Host
  Tactic(s)       : Stealth
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:33:05.972868+00:00
  Reference       : https://attack.mitre.org/techniques/T1612
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1612_Host_Image_Build_Context_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects the file artifact left on a container host when the runtime receives a build request. When an image is built through the build API, the daemon extracts the supplied build context, including the Dockerfile or Containerfile, into a temporary builder directory. Detecting this state change works even when command-line logging is evaded, for example when the build request is sent straight to the remote API. It can indicate an adversary building a custom image on the host to avoid pulling a known-malicious image from a registry."
    mitre_tactic = "Stealth"
    mitre_technique = "T1612"
    mitre_technique_name = "Build Image on Host"
    log_prerequisites = "Requires host file-integrity or EDR file telemetry on container hosts and build nodes, covering the container runtime data directory, normalised to FILE_CREATION events with target.file.full_path populated."
    platform = "Containers"
    log_source = "container"
    false_positives = "Legitimate CI/CD build nodes, developers building images on shared hosts, image-baking pipelines, and automation that uses the build API on a schedule."
    tuning_guidance = "Add CI/build service accounts to %global_allowed_service_accounts and dedicated build hosts to %global_allowed_script_hosts. Production runtime nodes that should never build images deserve a higher severity. Review the source of the build request in daemon or API audit logs."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\/docker\/tmp\/docker-builder[0-9]+\/(.+\/)?(dockerfile|containerfile)$/ nocase
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1612")
    $primary_entity = array_distinct($file.principal.hostname)
    $build_file_paths = array_distinct($file.target.file.full_path)
    $acting_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
