/*
  MITRE Technique : T1203 - Exploitation for Client Execution
  Tactic(s)       : Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:55:30.564826+00:00
  Reference       : https://attack.mitre.org/techniques/T1203
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1203_Linux_Client_App_Drops_Then_Executes_Temp_Binary {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A client-facing application (browser, mail client, office suite or document viewer) writes a file into a world-writable staging directory (/tmp, /var/tmp, /dev/shm), and that same file is then executed on the same host within 10 minutes. This is a typical post-exploitation pattern for client-side exploits: the compromised application drops a payload and runs it. The rule joins on the exact dropped file path rather than matching command lines."
    mitre_tactic = "Execution"
    mitre_technique = "T1203"
    mitre_technique_name = "Exploitation for Client Execution"
    log_prerequisites = "Linux EDR or auditd telemetry providing both FILE_CREATION events (with the writing process path) and PROCESS_LAUNCH events (with the executed file path), normalised to UDM with principal.hostname populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Users running installers or AppImages downloaded through a browser and staged in /tmp; browser or office updaters that unpack helper binaries to temp; Snap/Flatpak sandbox helpers; LibreOffice or Thunderbird extensions that run helper executables; developer workstations testing downloaded binaries."
    tuning_guidance = "Add approved software-deployment or patching parent processes to %global_allowed_admin_tools, and service or automation accounts to %global_allowed_service_accounts. If a particular client application is noisy, narrow the writer process regex. Extend the staging directory regex with additional client-writable paths if needed."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(firefox|firefox-bin|plugin-container|chrome|chromium|chromium-browser|brave|brave-browser|soffice\.bin|oosplash|evince|okular|zathura|atril|xreader|thunderbird|epiphany|acroread|foxitreader)$/ nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+/ nocase
    $file.target.file.full_path = $path
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = $path
    $proc.principal.hostname = $hostname
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1203")
    $primary_entity = array_distinct($hostname)
    $dropper_process = array_distinct($file.principal.process.file.full_path)
    $dropped_file = array_distinct($path)
    $executed_command_line = array_distinct($proc.target.process.command_line)
    $executing_user = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
