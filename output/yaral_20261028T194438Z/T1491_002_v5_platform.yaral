/*
  MITRE Technique : T1491.002 - External Defacement
  Tactic(s)       : Impact
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:46:46.263115+00:00
  Reference       : https://attack.mitre.org/techniques/T1491/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_002_Linux_Web_Homepage_Overwrite_Via_HTTP_Write_Method {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external client using an HTTP write method (PUT, MOVE or COPY) to successfully modify a website landing page (index, default, home or main) on a Linux-hosted web server. This is a network-observable sign of external defacement, such as a WebDAV or misconfigured upload endpoint being used to replace the homepage. The rule matches the method, target page and success response rather than any specific payload, tool or attacker infrastructure."
    mitre_tactic = "Impact"
    mitre_technique = "T1491.002"
    mitre_technique_name = "Defacement: External Defacement"
    log_prerequisites = "Requires firewall, reverse-proxy, WAF or web-gateway logs in front of Linux web servers that are normalised to UDM NETWORK_HTTP with network.http.method, network.http.response_code and target.url populated. Logs must be decrypted at the inspection point, because HTTPS flows without inspection do not expose the method or URL."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Content management or publishing workflows that use WebDAV or REST PUT to update landing pages; CI/CD or deployment tooling publishing through the proxy; authorised web administrators editing the site remotely; vulnerability scanners and penetration tests probing for writable web roots."
    tuning_guidance = "Add trusted publishing, CI/CD and administrator source addresses to %global_allowed_mgmt_sources. Add approved scanner sources to %global_allowed_scanners. Extend the landing-page filename regex for site-specific entry pages. If the CMS legitimately accepts PUT from the internet, restrict the rule further by target host or raise the severity only for unauthenticated sources."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(PUT|MOVE|COPY)$/ nocase
    $http.target.url = /\/(index|default|home|main)\.(html?|php|jsp|aspx?)(\?.*)?$/ nocase
    $http.network.http.response_code >= 200
    $http.network.http.response_code < 300
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_mgmt_sources
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1491.002")
    $primary_entity = array_distinct($http.target.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $defaced_urls = array_distinct($http.target.url)
    $http_methods = array_distinct($http.network.http.method)

  condition:
    $http
}
