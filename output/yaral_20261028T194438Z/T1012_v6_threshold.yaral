/*
  MITRE Technique : T1012 - Query Registry
  Tactic(s)       : Discovery
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:25:06.842935+00:00
  Reference       : https://attack.mitre.org/techniques/T1012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1012_Registry_Query_Burst_Per_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of registry query activity on a single host within ten minutes, using reg.exe query or PowerShell registry provider reads. A single query is routine, but many in a short window indicates automated registry discovery of system, software and security configuration. Windows telemetry exposes no registry-read event, so process launches that perform queries are aggregated by host, and the volume is the detection signal."
    mitre_tactic = "Discovery"
    mitre_technique = "T1012"
    mitre_technique_name = "Query Registry"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command-line capture (EDR, Sysmon Event ID 1 or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software inventory and asset management agents, RMM health checks, patching and compliance scanners, login or logon-script routines, admins troubleshooting configuration, and installers that probe registry state."
    tuning_guidance = "Add inventory, RMM and deployment tooling to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Raise the #proc threshold on hosts that run compliance tooling. Lower it to 5 for high-value servers."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $proc.target.process.file.full_path = /\\reg\.exe$/ nocase and
        $proc.target.process.command_line = /\bquery\b/ nocase
      ) or
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase and
        $proc.target.process.command_line = /(get-itemproperty|get-childitem|get-item|\bgp\b|\bgci\b)[^|;]{0,100}(hklm|hkcu|hkey_|registry::)/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    $proc.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(count($proc.metadata.id) >= 20, 75, 50))
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1012")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $sample_commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 8
}
