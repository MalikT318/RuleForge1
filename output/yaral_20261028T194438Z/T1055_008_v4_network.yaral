/*
  MITRE Technique : T1055.008 - Ptrace System Calls
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:54:57.529170+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_008_Ptrace_Injected_Daemon_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound connection to a non-internal address from a core Linux system daemon that has no normal reason to initiate external traffic (cron, atd, auditd, dbus-daemon, logind, udevd, getty, polkitd, irqbalance). These processes are common ptrace injection hosts, and an external connection from one is a network-side result of code injected via PTRACE_POKETEXT or PTRACE_SETREGS. This is complementary to command-line rules because it observes the post-injection behaviour rather than the injector invocation."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.008"
    mitre_technique_name = "Process Injection: Ptrace System Calls"
    log_prerequisites = "Requires Linux EDR or auditd network telemetry (connect syscalls) that populates principal.process.file.full_path, principal.hostname and target.ip on NETWORK_CONNECTION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Minimal-image or container hosts where a daemon is wrapped to reach an external service (for example, PAM or NSS modules performing remote lookups through logind or polkitd); cron or atd spawning in-process helpers that call out; custom builds of these daemons with remote reporting; monitoring agents that rename or replace these binaries."
    tuning_guidance = "Add approved binaries to %global_allowed_admin_tools or %global_allowed_security_tools. Add known-good destination domains to %global_allowed_domains where target.hostname is populated. Add extra internal ranges to %rfc1918_internal. If a client legitimately forwards from one of these daemons, remove that name from the process regex for that tenant."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(crond?|atd|auditd|dbus-daemon|systemd-logind|systemd-udevd|agetty|polkitd|irqbalance)$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1055.008")
    $primary_entity = array_distinct($net.principal.hostname)
    $injected_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
