/*
  MITRE Technique : T1069.003 - Cloud Groups
  Tactic(s)       : Discovery
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:01:20.337144+00:00
  Reference       : https://attack.mitre.org/techniques/T1069/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1069_003_Office_Suite_Cloud_Group_Role_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects a user or API client running directory group, distribution group, role group or admin role enumeration operations (list/get groups, group members, role assignments) recorded in the Office Suite unified audit log. Adversaries with a compromised account use these operations to learn which users hold privileged roles and which groups grant access. This is control-plane coverage and is independent of any endpoint process or command-line telemetry."
    mitre_tactic = "Discovery"
    mitre_technique = "T1069.003"
    mitre_technique_name = "Permission Groups Discovery: Cloud Groups"
    log_prerequisites = "Unified audit logging enabled and ingested with the product event type (operation name) mapped to metadata.product_event_type. Admin or directory read operations must be audited (for example Exchange admin audit including Get-* cmdlets, directory audit, or Workspace admin and group audit activity)."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Help-desk and IT administrators reviewing group membership, identity governance and access-review tooling, HR or onboarding automation syncing group data, licensing and compliance reporting scripts, migration projects, and security assessment tooling."
    tuning_guidance = "Add named administrators to %global_allowed_admin_users, automation and sync accounts to %global_allowed_service_accounts, and approved integration principals to %global_allowed_cloud_principals. If volume is high in a tenant, promote this to a threshold rule or raise severity only for role-related operations. Review hits where the actor is a non-administrator or the account has recently had a new sign-in location or MFA change."

  events:
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.metadata.product_event_type = /^(Get-(Msol|AzureAD|AzureADMS|Mg)?(Group|GroupMember|Role|RoleMember|DirectoryRole|DirectoryRoleMember)|Get-(DistributionGroup|DistributionGroupMember|DynamicDistributionGroup|UnifiedGroup|UnifiedGroupLinks|RoleGroup|RoleGroupMember|ManagementRole|ManagementRoleAssignment|ManagementRoleEntry)|list[_ ]?groups|list[_ ]?group[_ ]?members|list[_ ]?roles|list[_ ]?role[_ ]?assignments|view[_ ]?group[_ ]?members?)$/ nocase
    $access.principal.user.userid != ""
    not $access.principal.user.userid in %global_allowed_admin_users
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1069.003")
    $primary_entity = array_distinct($access.principal.user.userid)
    $operations = array_distinct($access.metadata.product_event_type)
    $source_ips = array_distinct($access.principal.ip)

  condition:
    $access
}
