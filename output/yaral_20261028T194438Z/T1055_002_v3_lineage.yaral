/*
  MITRE Technique : T1055.002 - Portable Executable Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:47:51.523064+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_002_Unexpected_Parent_Spawns_Injection_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process-lineage anomaly: an Office application, web server worker, print spooler or database service spawning a shell, script interpreter or a DLL/COM host binary commonly used as a PE injection or hollowing target. These parents have no legitimate reason to launch these children, so the lineage points to code executing inside the parent or a staged injection host. The rule uses lineage only and does not match command-line content."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.002"
    mitre_technique_name = "Process Injection: Portable Executable Injection"
    log_prerequisites = "Requires Windows EDR or Sysmon process-creation telemetry (Sysmon Event ID 1 or equivalent) that populates both parent and child process image paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros or add-ins in legitimate business workflows, web applications that shell out for maintenance tasks, database jobs using xp_cmdshell, print drivers or monitors that launch rundll32, and vulnerability scanners or admin tooling run through these parents."
    tuning_guidance = "Add approved parent binaries to %global_allowed_script_hosts or %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. If a specific web or database workload legitimately spawns a shell, exclude it per client by parent path and host rather than widening the child list."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|w3wp|httpd|nginx|tomcat[0-9]*|spoolsv|sqlservr|mysqld|postgres)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|dllhost|msbuild|installutil)\.exe$/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
