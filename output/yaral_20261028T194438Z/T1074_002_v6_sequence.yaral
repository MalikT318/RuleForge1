/*
  MITRE Technique : T1074.002 - Remote Data Staging
  Tactic(s)       : Collection
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:21:01.337461+00:00
  Reference       : https://attack.mitre.org/techniques/T1074/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_002_Linux_Remote_Staging_Then_Archive {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects files landing in a world-writable staging directory (/tmp, /var/tmp, /dev/shm) via a remote file-transfer process (sftp-server, scp, rsync, smbd), followed within 10 minutes by an archive or compression utility run against that staging directory on the same host. This pattern suggests data collected from other systems is being centralised and packaged before exfiltration."
    mitre_tactic = "Collection"
    mitre_technique = "T1074.002"
    mitre_technique_name = "Data Staged: Remote Data Staging"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that populates FILE_CREATION with the writing process path (principal.process.file.full_path) and PROCESS_LAUNCH with command lines."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup or replication jobs that land data in /tmp or /var/tmp and then compress it, admin file transfers followed by tar or gzip, software deployment pipelines that unpack uploaded bundles, log collection and rotation jobs."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes, deployment and sync tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. If a legitimate workflow stages data under /var/tmp, narrow the staging directory regex or exclude that workflow's parent process."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(sftp-server|scp|rsync|rsyncd|smbd)$/ nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(tar|zip|7z|7za|7zr|rar|gzip|bzip2|xz|zstd)$/ nocase
    $proc.target.process.command_line = /(^|\s|=)\/(tmp|var\/tmp|dev\/shm)\// nocase
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1074.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $staged_files = array_distinct($file.target.file.full_path)
    $transfer_processes = array_distinct($file.principal.process.file.full_path)
    $archive_commands = array_distinct($proc.target.process.command_line)
    $archive_users = array_distinct($proc.principal.user.userid)
    $staged_file_count = count($file.metadata.id)

  condition:
    $file and $proc
}
