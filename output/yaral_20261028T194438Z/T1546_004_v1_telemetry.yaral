/*
  MITRE Technique : T1546.004 - Unix Shell Configuration Modification
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:05:21.252177+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_004_Linux_Shell_Profile_File_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of Unix shell startup and logout scripts that execute automatically when a shell starts or exits. Covered files are system-wide (/etc/profile, /etc/profile.d/*, /etc/bash.bashrc, /etc/bashrc, /etc/zsh/*) and per-user (~/.bashrc, ~/.bash_profile, ~/.bash_login, ~/.profile, ~/.bash_logout, ~/.zshrc, ~/.zprofile, ~/.zshenv, ~/.zlogin). Attackers add commands to these files for persistence and privilege escalation. The rule works on the resulting file-modification artifact, so it still fires when the command line is obfuscated, split across steps, or not logged."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.004"
    mitre_technique_name = "Event Triggered Execution: Unix Shell Configuration Modification"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules (-w on /etc/profile, /etc/profile.d, /etc/bash.bashrc, /home and /root dotfiles) normalised to UDM FILE_MODIFICATION with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers updating /etc/profile.d scripts; configuration management and provisioning tools (Ansible, Puppet, Chef, cloud-init); administrators or developers editing their own dotfiles; environment managers (nvm, pyenv, conda, sdkman) appending init lines to .bashrc or .profile; user-creation and account-provisioning utilities."
    tuning_guidance = "Add configuration management, provisioning and package tooling binaries to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Named administrators who routinely edit dotfiles can be added to %global_allowed_admin_users. If developer-workstation noise is high, raise severity only for system-wide paths by splitting the regex into a separate rule copy."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    (
      $file.target.file.full_path = /^\/etc\/(profile|bashrc|bash\.bashrc|bash\.bash_logout|zshenv|zprofile|zshrc|zlogin|zlogout|zsh\/(zshenv|zprofile|zshrc|zlogin|zlogout))$/ nocase or
      $file.target.file.full_path = /^\/etc\/profile\.d\/[^\/]+$/ nocase or
      $file.target.file.full_path = /^\/(root|home\/[^\/]+)\/\.(bashrc|bash_profile|bash_login|profile|bash_logout|zshrc|zprofile|zshenv|zlogin|zlogout)$/ nocase
    )
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|yum|dnf|zypper|snapd|pacman|apk)$/ nocase

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
