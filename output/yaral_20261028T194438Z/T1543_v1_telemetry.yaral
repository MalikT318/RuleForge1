/*
  MITRE Technique : T1543 - Create or Modify System Process
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:51:51.590650+00:00
  Reference       : https://attack.mitre.org/techniques/T1543
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_Linux_Systemd_Init_Unit_File_Created_By_Unexpected_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a systemd unit, unit drop-in, SysV init script or rc.local file on a Linux host or container host by a process that is not a package manager, configuration-management tool or approved admin tool. This is the file-system artifact left when an adversary installs a persistent service or daemon, including from a container with a host-mounted /etc or /usr/lib. It is detected at the file-state layer, so it still fires if command-line logging is evaded or the process is renamed."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543"
    mitre_technique_name = "Create or Modify System Process"
    log_prerequisites = "Requires Linux runtime or EDR file telemetry (or auditd file-watch rules on the systemd and init paths) normalised to UDM FILE_CREATION with principal.hostname, principal.process.file.full_path and target.file.full_path populated. The container runtime sensor must report file events for the host and for containers with host mounts."
    platform = "Linux"
    log_source = "container"
    false_positives = "Package installs and upgrades run by unlisted package tooling, configuration-management agents (Ansible, Puppet, Chef, Salt) deploying units, cloud-init or image-build pipelines at first boot, and admins hand-writing unit files. Golden-image baking and node bootstrap in Kubernetes autoscaling groups are also common sources."
    tuning_guidance = "Add approved deployment, config-management and image-build binaries to %global_allowed_admin_tools. Add automation account IDs to %global_allowed_service_accounts. Where node bootstrap is noisy, add the bootstrap parent process or host to the same lists, or schedule suppression for build windows. Extend the process-name exclusion regex only with executable names, never install directories."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(etc\/(systemd\/(system|user)\/[^\/]+\.(service|timer|socket|path)|systemd\/system\/[^\/]+\.d\/[^\/]+\.conf|init\.d\/[^\/]+|rc\.local)|(usr\/)?lib\/systemd\/(system|user)\/[^\/]+\.(service|timer|socket|path)|run\/systemd\/(system|transient)\/[^\/]+\.(service|timer)|(home\/[^\/]+|root)\/\.config\/systemd\/user\/[^\/]+\.(service|timer))$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|yum|dnf|zypper|snapd|packagekitd|unattended-upgr|cloud-init|systemctl|systemd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1543")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
