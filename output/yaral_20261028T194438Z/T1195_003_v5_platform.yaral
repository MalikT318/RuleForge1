/*
  MITRE Technique : T1195.003 - Compromise Hardware Supply Chain
  Tactic(s)       : Initial Access
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:45:09.619485+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_003_Linux_Firmware_Flash_Utility_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux host launching a firmware-writing operation (SPI/MTD flash write, NVMe or ATA drive firmware download, BMC/HPM firmware upgrade, or a local firmware capsule install). Hardware and firmware supply chain tampering, or later reflashing of a compromised device, relies on these write mechanisms. The rule matches the combination of utility and write-mode arguments, not a payload or specific file."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.003"
    mitre_technique_name = "Supply Chain Compromise: Compromise Hardware Supply Chain"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to PROCESS_LAUNCH with full command lines populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Authorised firmware updates by sysadmins or hardware vendors, datacenter provisioning and RMA burn-in workflows, BMC/BIOS patch cycles run through config management, and build or lab hosts that flash embedded boards."
    tuning_guidance = "Add approved patching and provisioning tools to %global_allowed_admin_tools (matched on the parent process path). Add automation accounts to %global_allowed_service_accounts. Review hits outside approved maintenance windows, and on hosts that are not provisioning or lab systems, as high priority."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(flashrom\s.*(\s-w|\s--write)(\s|$)|flashcp\s.*\/dev\/mtd|mtd_debug\s+write|nvme\s+fw-download|hdparm\s.*--fwdownload|fwupd(mgr|tool)\s+(local-)?install|ipmitool\s.*hpm\s+upgrade)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1195.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $flash_command = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $executing_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
