/*
  MITRE Technique : T1620 - Reflective Code Loading
  Tactic(s)       : Stealth
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:45:07.021839+00:00
  Reference       : https://attack.mitre.org/techniques/T1620
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1620_Scripting_Host_Reflective_Load_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a PowerShell process whose command line contains a .NET reflective assembly load (Assembly.Load/LoadFrom) combined with a web or socket download primitive, and that makes an outbound connection to a non-internal address. This is the network footprint of staging a managed payload from a remote host and loading it directly into process memory."
    mitre_tactic = "Stealth"
    mitre_technique = "T1620"
    mitre_technique_name = "Reflective Code Loading"
    log_prerequisites = "Requires Windows endpoint network telemetry that populates the initiating process path and command line on NETWORK_CONNECTION events (EDR or Sysmon Event ID 3 equivalent). Populate %rfc1918_internal with the client's internal address space."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrative or deployment scripts that download and load .NET assemblies at runtime (module bootstrappers, package providers, RMM or patching scripts), developer workstations testing .NET code, and legitimate PowerShell modules that fetch helper assemblies from vendor CDNs."
    tuning_guidance = "Add approved tooling executable paths to %global_allowed_admin_tools, approved vendor or CDN domains to %global_allowed_domains, and approved script-hosting processes to %global_allowed_script_hosts. Ensure %rfc1918_internal reflects the client's internal ranges. If the telemetry does not populate the command line on network events, pair this rule with the endpoint-side variants."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
    $net.principal.process.command_line = /reflection\.assembly\W{1,6}(load|loadfrom|loadfile)/ nocase
    $net.principal.process.command_line = /(downloaddata|downloadstring|downloadfile|webclient|invoke-webrequest|invoke-restmethod|httpwebrequest|net\.sockets|frombase64string)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1620")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
