/*
  MITRE Technique : T1120 - Peripheral Device Discovery
  Tactic(s)       : Discovery
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:28:28.008940+00:00
  Reference       : https://attack.mitre.org/techniques/T1120
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1120_Rapid_Peripheral_Discovery_Commands {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Multiple distinct peripheral and removable-device discovery commands (PnP device enumeration, WMI/CIM peripheral class queries, disk and USB enumeration, printer enumeration) run on a single host within ten minutes. Each command is benign alone; the volume on one host suggests hands-on-keyboard or scripted peripheral discovery."
    mitre_tactic = "Discovery"
    mitre_technique = "T1120"
    mitre_technique_name = "Peripheral Device Discovery"
    log_prerequisites = "Requires Windows endpoint process telemetry (EDR or Sysmon Event ID 1 or Windows Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT inventory and asset-management agents, RMM health checks, driver and hardware troubleshooting by administrators, device-control or DLP agents, print-management software, imaging and provisioning scripts."
    tuning_guidance = "Add inventory, RMM and deployment tooling parent processes to %global_allowed_admin_tools, approved script hosts to %global_allowed_script_hosts, and approved security agents to %global_allowed_security_tools. Raise the #proc threshold on hosts with heavy inventory activity."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $proc.target.process.command_line = /\bget-pnpdevice\b/ nocase or
      $proc.target.process.command_line = /\bpnputil(\.exe)?\s+.*\/enum-devices/ nocase or
      $proc.target.process.command_line = /\bpnputil(\.exe)?\s+.*-e\b/ nocase or
      $proc.target.process.command_line = /\b(get-wmiobject|gwmi|get-ciminstance|gcim)\b.*\b(win32_pnpentity|win32_usbcontroller|win32_usbhub|win32_diskdrive|win32_logicaldisk|win32_printer|win32_cdromdrive|win32_keyboard|win32_pointingdevice|win32_videocontroller|win32_desktopmonitor|win32_sounddevice|cim_logicaldevice)\b/ nocase or
      $proc.target.process.command_line = /\bwmic(\.exe)?\b.*\b(path\s+win32_pnpentity|diskdrive|logicaldisk|cdrom|printer|path\s+win32_usb\w*|path\s+win32_keyboard|path\s+win32_pointingdevice|path\s+win32_videocontroller|path\s+win32_sounddevice)\b/ nocase or
      $proc.target.process.command_line = /\bfsutil(\.exe)?\s+fsinfo\s+drives\b/ nocase or
      $proc.target.process.command_line = /\bfsutil(\.exe)?\s+fsinfo\s+drivetype\b/ nocase or
      $proc.target.process.command_line = /\bget-(printer|disk|volume|physicaldisk)\b/ nocase or
      $proc.target.process.command_line = /\b(driverquery|devcon(\.exe)?\s+(find|hwids|listclass))\b/ nocase or
      $proc.target.process.command_line = /\bmountvol(\.exe)?\b/ nocase or
      $proc.target.process.command_line = /\bdiskpart\b.*\blist\s+(disk|volume)\b/ nocase or
      $proc.target.process.command_line = /\bcurrentcontrolset\\enum\\(usb|usbstor|hid)\b/ nocase
    )
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(
      if($proc.metadata.id != "" and #proc >= 10, 70, 45)
    )
    $event_count = count($proc.metadata.id)
    $commands_seen = array_distinct($proc.target.process.command_line)
    $users = array_distinct($proc.principal.user.userid)
    $mitre_technique_id = array_distinct("T1120")
    $primary_entity = array_distinct($host)

  condition:
    #proc >= 5
}
