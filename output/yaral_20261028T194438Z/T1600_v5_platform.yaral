/*
  MITRE Technique : T1600 - Weaken Encryption
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:05:03.802654+00:00
  Reference       : https://attack.mitre.org/techniques/T1600
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_Weak_Crypto_Negotiated_Network_Device {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects connections to internal network devices or services that negotiate deprecated protocol versions (SSLv2/SSLv3/TLS 1.0/TLS 1.1) or broken cipher suites (NULL, EXPORT, RC4, RC2, DES/3DES, anonymous, MD5). This is the network-observable result of weakened device encryption, such as a reduced key space, disabled crypto hardware or a tampered system image. It can also indicate a downgrade-capable man-in-the-middle."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1600"
    mitre_technique_name = "Weaken Encryption"
    log_prerequisites = "Firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with network.tls.version or network.tls.cipher populated. This normally requires TLS inspection or a TLS-aware proxy or firewall. Without those fields the rule will not fire."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legacy appliances, printers, OT/IoT devices and old management interfaces that only support TLS 1.0/1.1. Vulnerability scanners and compliance probes testing weak ciphers. Old client software, such as unpatched embedded systems or legacy line-of-business applications."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners. Add known legacy destinations (by hostname) to %global_allowed_domains. Change severity to High for management-plane destinations once the legacy baseline is documented. Consider adding target.port filters per client for known management ports."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.ip in %rfc1918_internal
    (
      $net.network.tls.version = /(?i)^(ssl\s*v?(2|3)(\.0)?|tls\s*v?1([._]?[01])?)$/ or
      $net.network.tls.cipher = /(?i)(NULL|EXPORT|RC4|RC2|DES|ANON|MD5)/
    )
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1600")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)
    $tls_versions = array_distinct($net.network.tls.version)
    $tls_ciphers = array_distinct($net.network.tls.cipher)

  condition:
    $net
}
