/*
  MITRE Technique : T1114 - Email Collection
  Tactic(s)       : Collection
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:17:18.760363+00:00
  Reference       : https://attack.mitre.org/techniques/T1114
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_Linux_Mass_Mail_Store_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of file-copy, archive, read or transfer utilities launched against local mail stores (mbox spool, Maildir, desktop mail client profiles, PST/OST/EML exports) on a single Linux host within ten minutes. One access is routine; repeated bulk access suggests email collection ahead of staging or exfiltration."
    mitre_tactic = "Collection"
    mitre_technique = "T1114"
    mitre_technique_name = "Email Collection"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records normalised to UDM PROCESS_LAUNCH with full command lines."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Mail server backup and migration jobs, mail indexing or archiving agents, administrators troubleshooting mailboxes, eDiscovery or compliance export scripts, antivirus mail scanners."
    tuning_guidance = "Add approved backup and archiving parents to %global_allowed_backup_processes, mail admin tooling to %global_allowed_admin_tools, and mail-handling service accounts to %global_allowed_service_accounts. Raise the #proc threshold on mail servers where bulk access is normal."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(cp|mv|tar|zip|7z|7za|rsync|scp|cat|strings|grep|sqlite3|base64|gzip|dd)$/ nocase
    $proc.target.process.command_line = /(\/var\/(spool\/)?mail\/|\/maildir\b|\/\.thunderbird\/|\/\.mozilla-thunderbird\/|\/\.local\/share\/evolution\/mail|\/\.config\/evolution\/|\.mbox\b|\.pst\b|\.ost\b|\.eml\b)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1114")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $utilities = array_distinct($proc.target.process.file.full_path)
    $sample_command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 5
}
