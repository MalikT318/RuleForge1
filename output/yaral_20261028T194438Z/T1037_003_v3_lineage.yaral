/*
  MITRE Technique : T1037.003 - Network Logon Script
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:21:46.500699+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_003_Unexpected_Parent_Spawns_LogonScript_Tampering {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an unexpected parent process (Office application, web server, database service, print spooler) spawning a shell, script interpreter or net utility whose command line sets a user logon script attribute (scriptPath) or touches the NETLOGON/SYSVOL script shares. This lineage anomaly indicates network logon script persistence being staged from an exploited or phished process rather than by an administrator."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.003"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Network Logon Script"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web or database based administration portals that legitimately manage AD user attributes, Office macros or add-ins in IT-run provisioning workflows, helpdesk or HR onboarding applications that set user scriptPath, and deployment tooling that copies files to NETLOGON/SYSVOL via a web or database service account."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts and named administrators to %global_allowed_admin_users. Add approved provisioning tooling to %global_allowed_admin_tools. Review the parent process and command line in the alert to confirm whether the scriptPath change was expected."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat\d*|php-cgi|sqlservr|mysqld|spoolsv|inetinfo)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|net|net1)\.exe$/ nocase
    $proc.target.process.command_line = /(scriptpath|\\(netlogon|sysvol)\\)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1037.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
