/*
  MITRE Technique : T1497.003 - Time Based Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:07:06.817904+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_003_Linux_Time_Check_Then_Sleep_Same_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A single parent process (typically a script or shell) queries the system clock or uptime (date epoch output, /proc/uptime, uptime, hwclock) and then launches a sleep of two seconds or more within ten minutes. This is the classic sample-time, sleep, re-sample pattern used to detect sandbox time acceleration."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1497.003"
    mitre_technique_name = "Virtualization/Sandbox Evasion: Time Based Checks"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry normalised to PROCESS_LAUNCH with populated target.process.command_line, principal.process.pid and principal.hostname."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Monitoring and health-check scripts, init and boot scripts, backup wrappers, CI/CD runners, retry-with-backoff shell scripts, and admins running ad-hoc timing commands."
    tuning_guidance = "Add approved scripting parents to %global_allowed_script_hosts and approved IT tooling to %global_allowed_admin_tools. Raise the sleep threshold in the regex or require a command-line pattern for noisy hosts. If principal.process.pid is not populated for a client, this rule will not fire."

  events:
    $time.metadata.event_type = "PROCESS_LAUNCH"
    $time.target.process.command_line = /(\/proc\/uptime|(^|\/)date\s+\S*%s|(^|\/)uptime(\s|$)|(^|\/)hwclock(\s|$))/ nocase
    $time.principal.hostname = $hostname
    $time.principal.process.pid = $ppid
    not $time.principal.process.file.full_path in %global_allowed_script_hosts
    not $time.principal.process.file.full_path in %global_allowed_admin_tools

    $sleep.metadata.event_type = "PROCESS_LAUNCH"
    $sleep.target.process.file.full_path = /\/sleep$/ nocase
    $sleep.target.process.command_line = /(^|\/)sleep\s+(\d{2,}|[2-9])/ nocase
    $sleep.principal.hostname = $hostname
    $sleep.principal.process.pid = $ppid
    not $sleep.principal.process.file.full_path in %global_allowed_script_hosts
    not $sleep.principal.process.file.full_path in %global_allowed_admin_tools

    $time.metadata.event_timestamp.seconds <= $sleep.metadata.event_timestamp.seconds

  match:
    $hostname, $ppid over 10m

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1497.003")
    $primary_entity = array_distinct($hostname)
    $time_commands = array_distinct($time.target.process.command_line)
    $sleep_commands = array_distinct($sleep.target.process.command_line)
    $parent_processes = array_distinct($time.principal.process.file.full_path)
    $users = array_distinct($time.principal.user.userid)

  condition:
    $time and $sleep
}
