/*
  MITRE Technique : T1600 - Weaken Encryption
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:04:10.491874+00:00
  Reference       : https://attack.mitre.org/techniques/T1600
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_Weak_TLS_Negotiated_External_Firewall {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects perimeter-observed connections to external destinations that negotiated a deprecated TLS/SSL protocol version or a cryptographically weak cipher (NULL, EXPORT, RC2/RC4, DES/3DES, anonymous key exchange, MD5). From the network side, a device whose key space was reduced, whose crypto hardware was disabled, or whose system image was modified to weaken encryption will negotiate downgraded parameters. The same pattern also surfaces downgrade attacks and legacy clients."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1600"
    mitre_technique_name = "Weaken Encryption"
    log_prerequisites = "Firewall, proxy or perimeter logs with TLS metadata (network.tls.version and network.tls.cipher) populated, typically from TLS inspection or a TLS-aware flow log. Normalised to UDM NETWORK_CONNECTION."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legacy applications, embedded or IoT devices and old appliances that only support TLS 1.0/1.1 or 3DES. Third-party servers with outdated TLS configurations. Authorised vulnerability or compliance scanners probing cipher support. Legacy B2B or partner integrations."
    tuning_guidance = "Add known legacy-dependent source addresses and scanners to %global_allowed_scanners. Add known-good external vendor domains to %global_allowed_domains. Keep %rfc1918_internal current so internal traffic is excluded. To reduce volume, remove the version clause and alert only on weak ciphers. To increase coverage, add further deprecated cipher tokens to the regex."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.network.tls.version = /^(SSL.*|TLS\s?v?1(\.[01])?)$/ nocase or
      $net.network.tls.cipher = /(NULL|EXPORT|RC2|RC4|DES|ANON|MD5)/ nocase
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1600")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $tls_versions = array_distinct($net.network.tls.version)
    $tls_ciphers = array_distinct($net.network.tls.cipher)

  condition:
    $net
}
