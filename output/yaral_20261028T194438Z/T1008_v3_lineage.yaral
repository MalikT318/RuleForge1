/*
  MITRE Technique : T1008 - Fallback Channels
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:16:22.199308+00:00
  Reference       : https://attack.mitre.org/techniques/T1008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1008_ESXi_Mgmt_Daemon_Spawns_Shell_Or_Net_Utility {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi management or agent daemon (host agent, vCenter agent, reverse proxy, CIM broker, WS-Man, SLP, SNMP) spawning a shell, scripting interpreter or network transfer utility. These daemons do not normally launch interactive shells or outbound network tools. When they do, it usually means the daemon has been exploited or abused to establish or switch to an alternate command-and-control channel (fallback channel) on the hypervisor."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1008"
    mitre_technique_name = "Fallback Channels"
    log_prerequisites = "ESXi shell and process execution telemetry (hostd, shell.log, auditd-style process launch events) forwarded to Chronicle and parsed into UDM PROCESS_LAUNCH with principal.process.file.full_path (parent) and target.process.file.full_path (child) populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Vendor or OEM health-check and monitoring VIBs that shell out from the CIM broker or SNMP agent; host agent invoking helper shell scripts during patching, upgrades or host profile remediation; backup or storage plugins that call curl or wget from an agent daemon; admins running diagnostic scripts through agent-hosted tooling."
    tuning_guidance = "Add legitimate parent daemon paths to %global_allowed_script_hosts and approved management tooling to %global_allowed_admin_tools. Add known automation accounts to %global_allowed_service_accounts. If a specific OEM VIB legitimately spawns shells, allowlist its parent path rather than loosening the child regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(hostd|vpxa|rhttpproxy|sfcbd|sfcb-[a-z_-]+|openwsmand|slpd|snmpd|fdm|vobd|vmware-hostd|vmware-vpxa)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|ash|bash|dash|python[0-9.]*|perl|nc|ncat|netcat|socat|wget|curl|ssh|telnet)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1008")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
