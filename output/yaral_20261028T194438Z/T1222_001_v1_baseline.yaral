/*
  MITRE Technique : T1222.001 - Windows Permissions
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:17:48.644506+00:00
  Reference       : https://attack.mitre.org/techniques/T1222/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_001_Broad_Principal_ACL_Grant_Via_Native_Utility {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a native Windows ACL utility (icacls, cacls, xcacls) granting Full, Modify or Generic-All rights to a broad principal such as Everyone, Users, Authenticated Users or their well-known SIDs. Adversaries use this to weaken DACLs and gain access to protected files and directories, or to let a payload be modified or executed by any account."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1222.001"
    mitre_technique_name = "File and Directory Permissions Modification: Windows File and Directory Permissions Modification"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command-line capture (EDR, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters that open permissions on application data folders, IT deployment scripts and logon scripts that grant Users modify rights on shared or application directories, build and CI agents preparing working directories, and administrators fixing permission problems on file shares."
    tuning_guidance = "Add approved deployment, RMM, and installer parent processes to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Add named administrators to %global_allowed_admin_users. If a client has a known installer that grants Users rights, exclude it by parent process name rather than install path. Consider raising severity when the command targets system directories or is run by a non-admin account."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(icacls|cacls|xcacls)\.exe$/ nocase
    $proc.target.process.command_line = /\/grant(:[rR])?\s+"?\*?(everyone|s-1-1-0|s-1-5-11|s-1-5-7|authenticated users|anonymous logon|(builtin\\)?users)"?:\s*(\([a-z,]+\))*\((f|m|fa|ga)\)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1222.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
