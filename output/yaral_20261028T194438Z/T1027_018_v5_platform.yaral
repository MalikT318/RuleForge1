/*
  MITRE Technique : T1027.018 - Invisible Unicode
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:08:37.308520+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/018
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_018_Invisible_Unicode_In_Linux_Client_HTTP_URL {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP requests from Linux-originated clients (command-line fetchers, scripting HTTP libraries, Linux browsers) where the requested URL contains two or more invisible or non-printing Unicode characters, either percent-encoded or literal. These include zero-width characters, bidi controls, word joiners, BOM, variation selectors, and tag characters. Adversaries use them to hide or reconstruct payload data, to disguise paths in phishing or staging links, and to evade static URL inspection. This is a network-observable control that adds to endpoint command-line coverage."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.018"
    mitre_technique_name = "Obfuscated Files or Information: Invisible Unicode"
    log_prerequisites = "Requires proxy or perimeter firewall logs with URL inspection (SSL inspection for HTTPS), normalised to UDM NETWORK_HTTP with target.url and network.http.user_agent populated."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Internationalised web applications and CMS sites that percent-encode joiners or variation selectors (emoji, Indic and Arabic scripts), tracking URLs containing a BOM, and legitimate API clients that submit non-Latin text in query strings."
    tuning_guidance = "Add known-good external destinations to %global_allowed_domains and authorised testing sources to %global_allowed_scanners. Raise the repetition count from 2 to 4 if internationalised sites cause noise. Extend the user-agent regex if client Linux user agents are not logged consistently."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.user_agent = /(curl|wget|python-requests|python-urllib|libwww-perl|Go-http-client|X11; Linux|Linux x86_64|Linux aarch64)/ nocase
    $http.target.url = /(?i)((%e2%80%8[b-f]|%e2%80%a[a-e]|%e2%81%a[0-4]|%e2%81%a[6-9]|%ef%bb%bf|%ef%b8%8[0-9a-f]|%e3%85%a4|%e1%a0%8e|%f3%a0%8[0-7]%[89a-f][0-9a-f]|[\x{200B}-\x{200F}\x{202A}-\x{202E}\x{2060}-\x{2064}\x{FEFF}\x{FE00}-\x{FE0F}\x{3164}\x{180E}]).*){2,}/
    not $http.target.hostname in %global_allowed_domains
    not $http.target.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.018")
    $primary_entity = array_distinct($http.principal.ip)
    $source_hostname = array_distinct($http.principal.hostname)
    $destination_host = array_distinct($http.target.hostname)
    $user_agent = array_distinct($http.network.http.user_agent)
    $request_url = array_distinct($http.target.url)

  condition:
    $http
}
