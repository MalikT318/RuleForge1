/*
  MITRE Technique : T1036.011 - Overwrite Process Arguments
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:14:59.016466+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_011_Linux_Masqueraded_Process_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound connection to a non-internal address from a Linux process whose command line presents as a kernel thread (bracketed name such as [kworker/0:1]) or as a local utility that never opens network sockets (cat, ls, ps, grep, sleep and similar). Implants that overwrite argv[0] to hide (BPFDoor- and XorDdos-style) keep their real network behaviour, so the spoofed name and the external connection together expose the masquerade from the network side."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.011"
    mitre_technique_name = "Masquerading: Overwrite Process Arguments"
    log_prerequisites = "Linux endpoint telemetry that produces NETWORK_CONNECTION events with principal.process.command_line populated from the live /proc/<PID>/cmdline value (not a cached launch-time value)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "BusyBox-based containers or appliances where argv[0] is an applet name; kernel-level network clients (NFS, iSCSI, Ceph) that some agents report with bracketed thread names; shell wrappers or monitoring plugins that exec utilities and proxy sockets; process-title rewriting by legitimate daemons that happen to use a utility-like title."
    tuning_guidance = "Add legitimate binaries that rewrite their own argv to %global_allowed_admin_tools or %global_allowed_script_hosts. Add EDR and monitoring agents to %global_allowed_security_tools. Add approved remote support tooling to %global_allowed_remote_mgmt. Add approved destinations to %global_allowed_domains or %global_allowed_mgmt_sources where relevant. If kernel-client noise appears, tune the bracketed-name branch per client."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.command_line = /^(\[[a-z0-9_\/:\-\.]+\]|(\S*\/)?(cat|ls|ps|grep|egrep|fgrep|head|tail|less|more|sleep|pwd|id|whoami|uname|df|du|echo|sort|uniq|wc)(\s|$))/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1036.011")
    $primary_entity = array_distinct($net.principal.hostname)
    $spoofed_command_line = array_distinct($net.principal.process.command_line)
    $real_executable = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
