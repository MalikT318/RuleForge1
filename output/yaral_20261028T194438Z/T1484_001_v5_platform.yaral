/*
  MITRE Technique : T1484.001 - Group Policy Modification
  Tactic(s)       : Defense Impairment, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:33:30.993715+00:00
  Reference       : https://attack.mitre.org/techniques/T1484/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1484_001_SYSVOL_GPO_Sensitive_File_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of high-impact Group Policy content inside SYSVOL (Preferences scheduled tasks, services, local groups, startup/logon scripts, and security template GptTmpl.inf). These are the files adversaries edit to push persistence or privilege escalation to every machine in scope of a GPO. The rule is file-write based and complements process command-line detections. The angle requested an alternate platform, but GPOs exist only on Windows/Active Directory, so the rule stays on Windows and pivots to file telemetry instead."
    mitre_tactic = "Defense Impairment, Privilege Escalation"
    mitre_technique = "T1484.001"
    mitre_technique_name = "Domain or Tenant Policy Modification: Group Policy Modification"
    log_prerequisites = "Requires EDR or Sysmon file-modification telemetry (Sysmon Event ID 11 or equivalent) from domain controllers, with file path and writing process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate GPO edits by domain administrators through GPMC or RSAT, approved GPO deployment or configuration-management tooling, backup and restore of SYSVOL, and DFSR or FRS replication writes between domain controllers."
    tuning_guidance = "Add approved admin accounts to %global_allowed_admin_users and GPO management or deployment tooling to %global_allowed_admin_tools. Add SYSVOL backup software to %global_allowed_backup_processes. If DFSR replication is noisy, add the replication process path to %global_allowed_admin_tools."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\\sysvol\\[^\\]+\\policies\\\{[0-9a-f\-]{36}\}\\(machine|user)\\(preferences\\(scheduledtasks|services|groups|files|datasources|registry)\\[^\\]+\.xml|scripts\\.+|microsoft\\windows nt\\secedit\\gpttmpl\.inf)$/ nocase
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1484.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_gpo_file = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
