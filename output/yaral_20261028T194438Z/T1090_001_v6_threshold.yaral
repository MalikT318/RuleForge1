/*
  MITRE Technique : T1090.001 - Internal Proxy
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:28:04.732535+00:00
  Reference       : https://attack.mitre.org/techniques/T1090/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1090_001_Internal_Proxy_Hub_Connection_Fanin {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal host receives a high volume of TCP connections from internal sources on an uncommon high port within 10 minutes. This fan-in pattern is consistent with a compromised system acting as an internal proxy or relay hub for C2 traffic. Any one connection is benign; the volume to one internal destination and port is not."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1090.001"
    mitre_technique_name = "Proxy: Internal Proxy"
    log_prerequisites = "Requires perimeter or internal segmentation firewall logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip, target.port and network.ip_protocol populated. The sensor must see east-west traffic, not only internet-bound traffic."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Internal application servers, databases, message brokers, caching tiers, internal web or API gateways on non-standard ports, load balancer backends, monitoring collectors, and log or telemetry aggregators receiving traffic from many clients."
    tuning_guidance = "Add scanner source IPs to %global_allowed_scanners and approved management source addresses to %global_allowed_mgmt_sources. Raise the #net threshold for busy environments. Extend the port exclusions to cover legitimate high-port internal services. Alerts are most meaningful when the destination is a user workstation rather than a server."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "TCP"
    $net.target.port > 1024
    $net.target.port != 3389
    $net.target.port != 5985
    $net.target.port != 5986
    $net.target.port != 8080
    $net.target.port != 8443
    $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    $net.target.ip = $dst

  match:
    $dst over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1090.001")
    $primary_entity = array_distinct($dst)
    $connection_count = count($net.metadata.id)
    $distinct_sources = count_distinct($net.principal.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    #net >= 50
}
