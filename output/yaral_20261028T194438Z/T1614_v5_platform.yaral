/*
  MITRE Technique : T1614 - System Location Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:37:56.376159+00:00
  Reference       : https://attack.mitre.org/techniques/T1614
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1614_Linux_Client_Geolocation_Lookup_Via_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux-style command-line HTTP client (curl, wget, scripting libraries) requesting an external URL whose host or path indicates an IP geolocation or public-IP lookup service. Malware and post-exploitation scripts use these lookups to infer the victim's location and decide whether to continue. Detection relies only on perimeter-observable HTTP fields (user agent and URL keywords), not endpoint process data."
    mitre_tactic = "Discovery"
    mitre_technique = "T1614"
    mitre_technique_name = "System Location Discovery"
    log_prerequisites = "Requires firewall or web proxy logs that populate network.http.user_agent and target.url (TLS inspection or an explicit proxy for HTTPS). Events must be normalised to NETWORK_HTTP."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate administration or monitoring scripts that look up public IP or region (cloud bootstrap, dynamic DNS updaters, CDN or GeoDNS health checks), developers testing geolocation APIs, and application back-ends that call geo-IP APIs by design."
    tuning_guidance = "Add known-good geolocation or vendor domains to %global_allowed_domains. Add automation or build hosts that legitimately run such scripts to %global_allowed_script_hosts. If proxy logs lack user agent for HTTPS, enable TLS inspection or the proxy log field first."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /^(curl|wget|python-requests|python-urllib|libwww-perl|go-http-client)/ nocase
    $net.target.url = /(geoip|geo-?locat|geo-?lookup|iplocat|ip2loc|ip-?geo|whereami|country_?code|myip|whatismyip)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1614")
    $primary_entity = array_distinct($net.principal.ip)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
