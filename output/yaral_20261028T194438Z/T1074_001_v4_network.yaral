/*
  MITRE Technique : T1074.001 - Local Data Staging
  Tactic(s)       : Collection
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:18:45.060388+00:00
  Reference       : https://attack.mitre.org/techniques/T1074/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_001_ESXi_Staged_Archive_Outbound_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi host shell utility opening an outbound connection to a non-internal address while its command line references a staged archive or disk/data file in a datastore or temp location. This is the network-side signature of data staged locally on the hypervisor and then moved off the host."
    mitre_tactic = "Collection"
    mitre_technique = "T1074.001"
    mitre_technique_name = "Data Staged: Local Data Staging"
    log_prerequisites = "Requires ESXi host shell/process-attributed network telemetry in which principal.process.file.full_path and principal.process.command_line are populated on NETWORK_CONNECTION events."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators uploading support bundles (vm-support) or logs to a vendor or support portal, backup or replication tooling copying datastore files off-host, approved scripted configuration backups."
    tuning_guidance = "Add approved backup and replication binaries to %global_allowed_backup_processes and approved admin tooling to %global_allowed_admin_tools. Keep %rfc1918_internal current for the tenant. Narrow the staging path or extension regex if the client routinely transfers such files externally."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(curl|wget|nc|ncat|netcat|scp|sftp|ssh|python|python3)$/ nocase
    $net.principal.process.command_line = /(\/vmfs\/volumes\/|\/tmp\/|\/var\/tmp\/|\/scratch\/|\/vmfs\/volumes\/[^\s]+\/).*\.(tar|tgz|gz|zip|7z|rar|bz2|vmdk|vmx|nvram|bak|db|dat)(\s|$|"|')/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1074.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $transfer_process = array_distinct($net.principal.process.file.full_path)
    $transfer_command = array_distinct($net.principal.process.command_line)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
