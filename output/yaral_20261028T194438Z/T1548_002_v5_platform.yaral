/*
  MITRE Technique : T1548.002 - Bypass User Account Control
  Tactic(s)       : Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:31:30.125577+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_002_UAC_Bypass_Registry_Handler_Hijack {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a write to a per-user COM/file-association shell handler 'shell\\open\\command' key under Software\\Classes (or the _Classes hive) for handlers used by auto-elevating Windows binaries. Registry-based UAC bypass, not a command-line detection. UAC bypass is Windows-only, so the alternate angle is registry telemetry rather than a non-Windows platform."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.002"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Bypass User Account Control"
    log_prerequisites = "Requires endpoint registry modification telemetry (EDR or Sysmon registry events) that includes HKCU/HKU Software\\Classes writes."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers or user-level default-app and file-association changes, EDR/AV self-protection, admin or RMM tooling that sets shell handlers, and some developer tools registering .msc or Settings handlers."
    tuning_guidance = "Add approved installers or RMM binaries to %global_allowed_admin_tools, security agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Restrict the handler list if a client legitimately customises one."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /^(HKU|HKEY_USERS|HKCU|HKEY_CURRENT_USER)\\.*(\\Software\\Classes|_Classes)\\(ms-settings|mscfile|exefile|Folder|launcher\.systemsettings)\\shell\\open\\command/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1548.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value = array_distinct($reg.target.registry.registry_value_name)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
