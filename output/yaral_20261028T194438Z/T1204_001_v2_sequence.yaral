/*
  MITRE Technique : T1204.001 - Malicious Link
  Tactic(s)       : Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:58:50.476625+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_001_Linux_Browser_Download_Then_Execute {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A browser process writes an executable-type file (AppImage, .run, .bin, .elf, or an extensionless binary) to a user download, desktop or /tmp location, and the same file path is then executed on the same host within 10 minutes. This indicates a user followed a malicious link and ran the downloaded payload. The rule joins on the exact file path and does not rely on command-line matching."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.001"
    mitre_technique_name = "User Execution: Malicious Link"
    log_prerequisites = "Requires Linux EDR or auditd telemetry with both FILE_CREATION events (including the writing process path) and PROCESS_LAUNCH events (including the executed binary path)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers and power users who download and run AppImages, vendor .run or .bin installers, or self-extracting tools. Browser-based software updaters that stage and execute binaries from /tmp. Sanctioned deployments done by IT staff from a browser."
    tuning_guidance = "Add approved installer launchers or parent processes to %global_allowed_admin_tools. Add IT and packaging accounts to %global_allowed_admin_users. Chromium-based browsers may write a .crdownload temporary name first and rename it later. If your EDR reports the final rename as FILE_CREATION, coverage is complete. If it does not, confirm that the final filename is logged. Widen or narrow the directory regex to match client conventions."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(firefox|firefox-bin|firefox-esr|chrome|google-chrome|chromium|chromium-browser|brave|brave-browser|opera|vivaldi|epiphany|microsoft-edge)$/ nocase
    $file.target.file.full_path = /^\/(home\/[^\/]+\/(Downloads|Desktop)|root\/Downloads|tmp)\// nocase
    $file.target.file.full_path = /(\.(appimage|run|bin|elf)|\/[^\/.]+)$/ nocase
    $file.target.file.full_path = $path
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /^\/(home\/[^\/]+\/(Downloads|Desktop)|root\/Downloads|tmp)\// nocase
    $proc.target.process.file.full_path = $path
    $proc.principal.hostname = $hostname
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1204.001")
    $primary_entity = array_distinct($hostname)
    $downloaded_file = array_distinct($path)
    $download_process = array_distinct($file.principal.process.file.full_path)
    $launching_parent = array_distinct($proc.principal.process.file.full_path)
    $executing_user = array_distinct($proc.principal.user.userid)
    $download_events = count($file.metadata.id)
    $execution_events = count($proc.metadata.id)

  condition:
    $file and $proc
}
