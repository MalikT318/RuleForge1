/*
  MITRE Technique : T1684 - Social Engineering
  Tactic(s)       : Stealth
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:30:33.656268+00:00
  Reference       : https://attack.mitre.org/techniques/T1684
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1684_Helpdesk_Reset_Then_External_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a possible help desk social engineering account takeover. A password reset is performed on a user account by a different, non-approved administrator, and within 10 minutes that account logs in from an external source address. This pattern is typical when an adversary persuades support staff to reset credentials and then signs in with them."
    mitre_tactic = "Stealth"
    mitre_technique = "T1684"
    mitre_technique_name = "Social Engineering"
    log_prerequisites = "Requires directory/identity audit logs that populate USER_CHANGE_PASSWORD (actor in principal.user.userid, affected account in target.user.userid) and sign-in logs that populate USER_LOGIN (account in target.user.userid, client address in principal.ip). Windows Active Directory events for password reset and logon, or the equivalent normalised identity provider logs, satisfy this."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Legitimate help desk password resets followed by the user signing in remotely (VPN, home or mobile networks), new-hire onboarding, travelling staff, and remote workers whose logins come from external addresses after a self-service-assisted reset."
    tuning_guidance = "Add help desk and IAM admin accounts to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Add VPN or proxy egress addresses to %global_allowed_mgmt_sources. Extend %rfc1918_internal handling if internal NAT ranges appear as external. Consider raising severity for privileged target accounts."

  events:
    $reset.metadata.event_type = "USER_CHANGE_PASSWORD"
    $reset.target.user.userid = $user
    $reset.principal.user.userid != $reset.target.user.userid
    not $reset.principal.user.userid in %global_allowed_admin_users
    not $reset.principal.user.userid in %global_allowed_service_accounts

    $login.metadata.event_type = "USER_LOGIN"
    $login.target.user.userid = $user
    not $login.principal.ip in %rfc1918_internal
    not $login.principal.ip in %global_allowed_mgmt_sources

    $reset.metadata.event_timestamp.seconds <= $login.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1684")
    $primary_entity = array_distinct($user)
    $reset_actors = array_distinct($reset.principal.user.userid)
    $login_source_ips = array_distinct($login.principal.ip)
    $login_count = count($login.metadata.id)

  condition:
    $reset and $login
}
