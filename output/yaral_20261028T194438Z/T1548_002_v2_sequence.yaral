/*
  MITRE Technique : T1548.002 - Bypass User Account Control
  Tactic(s)       : Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:30:37.922270+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_002_UAC_Bypass_Registry_Hijack_Then_AutoElevate_Child {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a per-user registry shell\\open\\command hijack of a class handler abused by auto-elevating Windows binaries, followed within 10 minutes by one of those auto-elevating binaries spawning a shell or script interpreter on the same host. This is the registry-hijack UAC bypass pattern. It correlates the registry write with the elevated child process instead of matching command lines."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.002"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Bypass User Account Control"
    log_prerequisites = "Requires EDR or Sysmon registry value-set telemetry (REGISTRY_MODIFICATION with populated target.registry.registry_key) and process launch telemetry with parent process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers or default-app managers that legitimately write per-user class handlers for the listed ProgIDs, followed by an administrator launching a console from an auto-elevating utility; RMM or deployment tooling; developers customising Event Viewer or Settings handlers."
    tuning_guidance = "Add approved installer, deployment and RMM binaries to %global_allowed_admin_tools (matched against the registry-writing process). Add automation accounts to %global_allowed_service_accounts (matched against the user of the spawned child). If the registry telemetry does not include the writing process path, the exclusion is simply inactive, so review the first-week alerts to confirm."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Software\\Classes\\(ms-settings|mscfile|exefile|folder|launcher\.systemsettings)\\shell\\open\\command/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    $reg.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(fodhelper|computerdefaults|eventvwr|sdclt|wsreset|slui|cmstp)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32)\.exe$/ nocase
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    $reg.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1548.002")
    $primary_entity = array_distinct($hostname)
    $hijacked_keys = array_distinct($reg.target.registry.registry_key)
    $registry_writers = array_distinct($reg.principal.process.file.full_path)
    $elevating_parents = array_distinct($proc.principal.process.file.full_path)
    $spawned_children = array_distinct($proc.target.process.file.full_path)
    $spawned_command_lines = array_distinct($proc.target.process.command_line)
    $affected_users = array_distinct($proc.principal.user.userid)

  condition:
    $reg and $proc
}
