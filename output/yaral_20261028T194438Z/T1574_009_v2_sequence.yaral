/*
  MITRE Technique : T1574.009 - Path Interception by Unquoted Path
  Tactic(s)       : Stealth, Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:37:46.328565+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_009_Unquoted_Path_Executable_Planted_Then_Run_By_SCM {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an executable written to a drive root or directly into Program Files (a truncated-path hijack location for unquoted service paths), then launched by the Service Control Manager from that same path within 10 minutes. This is the result of unquoted service path interception rather than a command-line pattern."
    mitre_tactic = "Persistence, Privilege Escalation, Execution"
    mitre_technique = "T1574.009"
    mitre_technique_name = "Hijack Execution Flow: Path Interception by Unquoted Path"
    log_prerequisites = "Requires EDR or Sysmon file creation telemetry (FILE_CREATION with populated target path) and process launch telemetry with parent process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy installers or updaters that drop an executable at the drive root or directly in Program Files and then start it as a service. Software deployment and patching tools. Vendor agents that self-update at these locations."
    tuning_guidance = "Add approved installer, deployment and patching binaries to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. Both lists are applied to the file-writing process and the launched binary. If a legacy application legitimately lives in a matching location, add its executable to %global_allowed_admin_tools."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^[a-z]:\\([^\\]+|program files( \(x86\))?\\[^\\]+)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname
    $path = strings.to_lower($file.target.file.full_path)

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\services\.exe$/ nocase
    $proc.target.process.file.full_path = /^[a-z]:\\([^\\]+|program files( \(x86\))?\\[^\\]+)\.exe$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_security_tools
    $proc.principal.hostname = $hostname
    $path = strings.to_lower($proc.target.process.file.full_path)

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1574.009")
    $primary_entity = array_distinct($file.principal.hostname)
    $planted_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)
    $launch_count = count($proc.metadata.id)

  condition:
    $file and $proc
}
