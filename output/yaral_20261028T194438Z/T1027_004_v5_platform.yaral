/*
  MITRE Technique : T1027.004 - Compile After Delivery
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:44:12.777786+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_004_Source_Code_Download_Via_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client downloading raw, uncompiled source code or build project files (C#, VB, IL assembly, C/C++, MSBuild project files) from an external host over HTTP(S). Adversaries deliver payloads as text-based source so that they bypass executable scanning, then compile them on the victim with a native or bundled compiler. This rule is network-observable coverage that complements endpoint process-creation detections: it fires on the delivery step instead of the compile step."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.004"
    mitre_technique_name = "Obfuscated Files or Information: Compile After Delivery"
    log_prerequisites = "Requires web proxy, secure web gateway, or firewall logs with URL-level visibility (NETWORK_HTTP events with target.url populated). HTTPS URLs are visible only when TLS inspection is enabled."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Developers and build engineers pulling source code or project files from external repositories, package feeds, or code-hosting sites; security researchers; training and lab systems; CI/CD agents fetching dependencies."
    tuning_guidance = "Add trusted code repositories, vendor SDK hosts, and package feeds to %global_allowed_domains. Where developer subnets are known, scope the rule per client by excluding them with an additional reference-list condition. Raise severity when the same client later runs a compiler, which is covered by existing endpoint rules."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.target.url = /\.(cs|vb|il|csproj|vbproj|cpp|c)(\?[^\/]*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1027.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $downloaded_urls = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
