/*
  MITRE Technique : T1195.002 - Compromise Software Supply Chain
  Tactic(s)       : Initial Access
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:43:18.011356+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_002_Linux_PkgMgr_Drops_And_Executes_Temp_Binary {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A package manager or language package installer writes a file into a world-writable staging directory (/tmp, /var/tmp, /dev/shm), and that same file is then executed on the same host within 10 minutes. This pattern is consistent with a trojanised package, a malicious install or maintainer script, or a tampered update mechanism dropping and running a second-stage payload."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.002"
    mitre_technique_name = "Supply Chain Compromise: Compromise Software Supply Chain"
    log_prerequisites = "Requires Linux EDR or auditd telemetry providing FILE_CREATION events with the writing process path, and PROCESS_LAUNCH events with the executed file path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate package install or post-install scripts that unpack and run helper binaries from /tmp (some vendor installers, language runtimes, DKMS or kernel module builds), CI/build agents installing dependencies with native build steps (npm or pip native extensions), and configuration management runs."
    tuning_guidance = "Add approved installer, build and deployment tooling to %global_allowed_admin_tools. rpm scriptlet temp files (rpm-tmp.*) are already excluded. If CI/build hosts are noisy, add the writing process path to %global_allowed_admin_tools. Consider raising severity for production servers."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|yum|dnf|zypper|apk|pip|pip3|npm|yarn|gem|snap|snapd)$/ nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+/ nocase
    not $file.target.file.full_path = /rpm-tmp\./ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $path

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+/ nocase
    not $proc.target.process.file.full_path = /rpm-tmp\./ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname
    $proc.target.process.file.full_path = $path

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1195.002")
    $primary_entity = array_distinct($hostname)
    $dropped_file = array_distinct($path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $executing_parent = array_distinct($proc.principal.process.file.full_path)
    $executed_command_line = array_distinct($proc.target.process.command_line)
    $executing_user = array_distinct($proc.principal.user.userid)
    $event_count = count($proc.metadata.id)

  condition:
    $file and $proc
}
