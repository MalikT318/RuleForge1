/*
  MITRE Technique : T1037.003 - Network Logon Script
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:23:01.070206+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_003_Netlogon_Script_Burst_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects several script or executable files being created in the NETLOGON share or in a SYSVOL scripts folder (logon script storage) by a single host within ten minutes. One file drop can be routine administration, but a burst of logon-script writes is consistent with an adversary staging network logon scripts for persistence or lateral execution across many systems."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.003"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Network Logon Script"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) from domain controllers or file servers hosting NETLOGON and SYSVOL, with the target file path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Domain administrators deploying or updating logon scripts, GPO management consoles and deployment tooling, DFS Replication between domain controllers, and migration or consolidation projects that copy many scripts at once."
    tuning_guidance = "Add approved deployment tooling to %global_allowed_admin_tools, named administrators to %global_allowed_admin_users, and automation accounts to %global_allowed_service_accounts. Raise the #file threshold if script publishing is frequent in the environment. Consider scoping to domain controllers if the client has a reliable asset naming convention."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(netlogon\\|sysvol\\.*\\scripts\\).*\.(bat|cmd|ps1|vbs|vbe|js|jse|wsf|hta|exe|dll)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\\(dfsrs|dfssvc|ntfrs|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($file.target.file.full_path = /\.(exe|dll|hta)$/ nocase, 90, 70))
    $mitre_technique_id = array_distinct("T1037.003")
    $primary_entity = array_distinct($host)
    $file_count = count($file.metadata.id)
    $written_paths = array_distinct($file.target.file.full_path)
    $writing_processes = array_distinct($file.principal.process.file.full_path)
    $writing_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
