/*
  MITRE Technique : T1599.001 - Network Address Translation Traversal
  Tactic(s)       : Defense Impairment
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:03:23.608338+00:00
  Reference       : https://attack.mitre.org/techniques/T1599/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1599_001_External_Source_Volume_To_Internal_Via_Border_NAT {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a single external source address making a high volume of connections to internal (RFC1918) destinations on remote-administration and lateral-movement ports through a border device within 10 minutes. Internal hosts are normally unreachable from untrusted networks, so sustained inbound flows to private addresses suggest a malicious or unauthorised NAT or port-forward change bridging network boundaries (T1599.001). The detection is based on the network-observable result of that change, not on the device configuration command."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1599.001"
    mitre_technique_name = "Network Boundary Bridging: Network Address Translation Traversal"
    log_prerequisites = "Requires firewall or perimeter connection and flow logs that record the translated (post-NAT) destination address, or the internal destination, for inbound sessions. The ingest parser must populate principal.ip, target.ip and target.port."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimately published services (published RDP gateways, SSH bastions, VPN concentrators with documented static NAT), authorised vulnerability scanners and penetration tests, partner or MSP remote-support source addresses, and load balancers or reverse proxies that log pre-NAT public sources against internal destinations."
    tuning_guidance = "Add authorised scanner sources to %global_allowed_scanners and approved management or partner source addresses to %global_allowed_mgmt_sources. Raise or lower the #net threshold per client based on baseline inbound volume. If the firewall logs only pre-NAT destination addresses, this rule will not fire. Adjust the port list to the client's published services."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src
    not $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 135 or
      $net.target.port = 139 or
      $net.target.port = 445 or
      $net.target.port = 3389 or
      $net.target.port = 5900 or
      $net.target.port = 5985 or
      $net.target.port = 5986
    )
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src over 10m

  outcome:
    $risk_score = max(if($net.target.port = 3389 or $net.target.port = 22 or $net.target.port = 445, 80, 65))
    $mitre_technique_id = array_distinct("T1599.001")
    $primary_entity = array_distinct($src)
    $event_count = count($net.metadata.id)
    $internal_destinations = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $observing_devices = array_distinct($net.principal.hostname)

  condition:
    #net >= 20
}
