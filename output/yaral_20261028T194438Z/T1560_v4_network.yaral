/*
  MITRE Technique : T1560 - Archive Collected Data
  Tactic(s)       : Collection
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:56:26.882731+00:00
  Reference       : https://attack.mitre.org/techniques/T1560
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1560_Linux_Archive_Upload_Over_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a scripted or command-line HTTP client on a Linux host uploading an archive or encrypted-container file (POST/PUT with an archive extension in the URL) to an external destination. This is the network-side result of data being compressed or encrypted before exfiltration, and it complements endpoint command-line detections."
    mitre_tactic = "Collection"
    mitre_technique = "T1560"
    mitre_technique_name = "Archive Collected Data"
    log_prerequisites = "Requires NETWORK_HTTP telemetry (egress proxy, network sensor or EDR HTTP events) with the method, URL and user agent populated and attributed to a Linux source host."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup and artifact-publishing scripts that upload tarballs to external storage, CI/CD jobs pushing release archives, log shipping scripts, and administrators uploading support bundles to vendor portals."
    tuning_guidance = "Add approved vendor and storage domains to %global_allowed_domains, backup agents to %global_allowed_backup_processes, and automation accounts to %global_allowed_service_accounts. If the user-agent filter is too narrow for a client's proxy, extend the client-name alternation in the regex. If it is too noisy, restrict to specific source host groups through a separate allowlist."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT)$/ nocase
    $net.target.url = /\.(tar|tgz|tar\.gz|tar\.bz2|tar\.xz|zip|7z|rar|gz|bz2|xz|zst|gpg|pgp|enc)(\?.*)?$/ nocase
    $net.network.http.user_agent = /^(curl|libcurl|wget|python-requests|python-urllib|go-http-client|aiohttp)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1560")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $uploaded_urls = array_distinct($net.target.url)
    $source_users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
