/*
  MITRE Technique : T1573.001 - Symmetric Cryptography
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:24:06.047992+00:00
  Reference       : https://attack.mitre.org/techniques/T1573/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1573_001_Repeated_NonStandard_Port_External_Sessions {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source makes many TCP connections to external destinations on non-standard high ports within 10 minutes. Custom symmetric-encrypted C2 (AES, RC4, etc.) often runs over raw TCP on arbitrary ports instead of a standard TLS service, and implants beacon repeatedly on a fixed interval. Each connection is benign on its own; the sustained volume is the signal. Detection is network-observable only and does not depend on process fields."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1573.001"
    mitre_technique_name = "Encrypted Channel: Symmetric Cryptography"
    log_prerequisites = "Firewall, proxy, or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip, target.port, and network.ip_protocol populated. Outbound traffic from Windows endpoints must be logged at the egress point."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "VoIP and video conferencing clients, online games, P2P or sync software, VPN clients on custom ports, mail or SFTP clients using alternate ports, legitimate SaaS agents on high ports, vulnerability scanners and monitoring probes."
    tuning_guidance = "Add known-good destinations to %global_allowed_domains, and scanner or monitoring sources to %global_allowed_scanners. Raise the #net threshold (default 40) for noisy egress segments. Extend the excluded port list with approved custom-port services for the client."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "TCP"
    $net.principal.ip = $src_ip
    not $net.target.ip in %rfc1918_internal
    $net.target.port >= 1024
    $net.target.port != 8080
    $net.target.port != 8443
    $net.target.port != 8000
    $net.target.port != 3389
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1573.001")
    $primary_entity = array_distinct($src_ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 40
}
