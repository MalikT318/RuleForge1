/*
  MITRE Technique : T1134 - Access Token Manipulation
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:52:20.630473+00:00
  Reference       : https://attack.mitre.org/techniques/T1134
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_Handle_To_SYSTEM_Process_Then_SYSTEM_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A non-SYSTEM process opens a handle to a protected SYSTEM-context process (winlogon, lsass, services, wininit, spoolsv) and, within 10 minutes, the same process launches a command shell running as SYSTEM. This is the usual result of token theft or token duplication (T1134.001 / T1134.002) used to escalate from administrator to SYSTEM."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134"
    mitre_technique_name = "Access Token Manipulation"
    log_prerequisites = "Requires EDR or Sysmon process-access telemetry (normalised to PROCESS_OPEN) and process-launch telemetry (PROCESS_LAUNCH) with principal.process.pid and target.user.userid populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Remote support and RMM agents that legitimately spawn SYSTEM shells, software deployment tooling, PsExec-style administrative tools, backup agents that open protected processes, and unlisted EDR or AV agents."
    tuning_guidance = "Add approved RMM, deployment and admin tool binaries to %global_allowed_admin_tools, EDR and AV agents to %global_allowed_security_tools, and backup agents to %global_allowed_backup_processes. If the EDR does not populate target.user.userid on PROCESS_LAUNCH, validate the field mapping before deploying."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\(winlogon|lsass|services|wininit|spoolsv)\.exe$/ nocase
    not $open.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|csrss|wininit|winlogon|services|lsass)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    $open.principal.hostname = $hostname
    $open.principal.process.pid = $pid

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh)\.exe$/ nocase
    $proc.target.user.userid = /^(nt authority\\)?system$/ nocase
    not $proc.principal.user.userid = /^(nt authority\\)?(system|local service|network service)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname
    $proc.principal.process.pid = $pid

    $open.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $pid over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1134")
    $primary_entity = array_distinct($proc.principal.hostname)
    $opener_process = array_distinct($open.principal.process.file.full_path)
    $opened_targets = array_distinct($open.target.process.file.full_path)
    $spawned_shell = array_distinct($proc.target.process.file.full_path)
    $shell_command_lines = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)
    $open_event_count = count($open.metadata.id)

  condition:
    $open and $proc
}
