/*
  MITRE Technique : T1040 - Network Sniffing
  Tactic(s)       : Credential Access, Discovery
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:26:41.971799+00:00
  Reference       : https://attack.mitre.org/techniques/T1040
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1040_Linux_Remote_Packet_Capture_Stream_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux host opening an outbound connection to an external destination on a port used to stream or serve captured packets (remote pcap daemon, TZSP sniffer streaming, pcap-over-IP). This is the network-side footprint of network sniffing, where traffic captured in promiscuous mode or from a mirror port is forwarded to or collected by a remote system. It complements process-creation rules because it does not depend on endpoint command lines."
    mitre_tactic = "Credential Access, Discovery"
    mitre_technique = "T1040"
    mitre_technique_name = "Network Sniffing"
    log_prerequisites = "Requires firewall or perimeter NETWORK_CONNECTION logs with populated principal.ip, target.ip and target.port. The %rfc1918_internal reference list must be populated so internal traffic is excluded."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Authorised network monitoring or IDS sensors that forward mirrored traffic to an external or cloud analysis service; managed security or NDR vendors that collect captures remotely; administrators running remote capture for troubleshooting; unrelated services that happen to use the default port 2002."
    tuning_guidance = "Add the source addresses of approved sensors and monitoring hosts to %global_allowed_mgmt_sources. Add or remove ports in the port list to match the capture protocols in use. If port 2002 is noisy, require corroborating endpoint telemetry for that port before alerting."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 2002 or
      $net.target.port = 37008 or
      $net.target.port = 57012
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1040")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
