/*
  MITRE Technique : T1033 - System Owner/User Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:53:42.141178+00:00
  Reference       : https://attack.mitre.org/techniques/T1033
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1033_NetDevice_Mgmt_Session_Then_Directory_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A single source opens a remote management session (SSH or Telnet) and then makes repeated directory-service connections (LDAP, LDAPS, Global Catalog) within ten minutes. This network-observable pattern fits user and account discovery: the actor identifies who is logged in or administers the device, then enumerates directory accounts to shape follow-on actions. It uses perimeter connection telemetry only and does not duplicate process or command-line detections."
    mitre_tactic = "Discovery"
    mitre_technique = "T1033"
    mitre_technique_name = "System Owner/User Discovery"
    log_prerequisites = "Firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs must cover both management-plane traffic and directory-service traffic from the same source."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Network administrators who log in to a device and then use directory-integrated tools; identity and access management or user-provisioning systems; vulnerability scanners and asset-inventory tools; jump hosts with directory-backed authentication; monitoring systems that poll devices and query LDAP."
    tuning_guidance = "Add approved administrative jump hosts and management stations to %global_allowed_mgmt_sources. Add authorised scanners and inventory tools to %global_allowed_scanners. Raise the #ldap threshold in the condition for noisy environments, or lengthen the window if directory queries lag management logins."

  events:
    $mgmt.metadata.event_type = "NETWORK_CONNECTION"
    ($mgmt.target.port = 22 or $mgmt.target.port = 23)
    $mgmt.principal.ip = $src
    not $mgmt.principal.ip in %global_allowed_mgmt_sources

    $ldap.metadata.event_type = "NETWORK_CONNECTION"
    ($ldap.target.port = 389 or $ldap.target.port = 636 or $ldap.target.port = 3268 or $ldap.target.port = 3269)
    $ldap.principal.ip = $src
    not $ldap.principal.ip in %global_allowed_scanners
    not $ldap.principal.ip in %global_allowed_mgmt_sources

    $mgmt.metadata.event_timestamp.seconds <= $ldap.metadata.event_timestamp.seconds

  match:
    $src over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1033")
    $primary_entity = array_distinct($mgmt.principal.ip)
    $mgmt_targets = array_distinct($mgmt.target.ip)
    $directory_targets = array_distinct($ldap.target.ip)
    $directory_connection_count = count($ldap.metadata.id)

  condition:
    $mgmt and $ldap and #ldap >= 3
}
