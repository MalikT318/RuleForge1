/*
  MITRE Technique : T1036.002 - Right-to-Left Override
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:58:37.549499+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_002_RTLO_Executable_File_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a file on disk whose name contains the Unicode right-to-left override character (U+202E) followed by an executable or script extension. This is the file artifact left by RTLO filename spoofing, such as a .scr file disguised as a document or image. The rule works on the file-creation state change rather than process command lines, so it still fires when the file is delivered by email, archive extraction, browser download or a script."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.002"
    mitre_technique_name = "Masquerading: Right-to-Left Override"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon file create events) with the full target file path populated and Unicode characters preserved in the path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate files with right-to-left language (Arabic, Hebrew) names that embed U+202E and end in a script or executable extension, which is rare. Security tooling that quarantines or unpacks samples containing RTLO names. Malware analysis or phishing-awareness sandboxes, and software installers that create bidirectional-formatted names."
    tuning_guidance = "Add endpoint security agents to %global_allowed_security_tools and imaging or backup software to %global_allowed_backup_processes. Hosts used for malware analysis should be excluded at the client level. To narrow further, remove extensions that are common in the client's environment from the regex. Always investigate the creating process and the download or email origin of the file."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\x{202E}[^\\]*\.(exe|scr|com|pif|bat|cmd|js|jse|vbs|vbe|wsf|wsh|hta|ps1|lnk|dll|msi|jar)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1036.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $file_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
