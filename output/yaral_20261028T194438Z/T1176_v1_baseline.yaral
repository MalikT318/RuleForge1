/*
  MITRE Technique : T1176 - Software Extensions
  Tactic(s)       : Persistence
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:24:27.439267+00:00
  Reference       : https://attack.mitre.org/techniques/T1176
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_Linux_Extension_Package_Download_Unapproved_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux client (browser, IDE or command-line downloader) fetching a software extension package (.crx, .vsix, .xpi) over HTTP(S) from an external host that is not a known-good extension distribution domain. Sideloading extensions from unapproved sources is a common way to deliver malicious browser or IDE extensions that persist inside a trusted host application."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176"
    mitre_technique_name = "Software Extensions"
    log_prerequisites = "Requires proxy or firewall logs with URL visibility (TLS inspection or explicit proxy) that normalise to NETWORK_HTTP with target.url, target.hostname and network.http.user_agent populated."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Developers sideloading internal or private extensions, enterprise extension distribution from self-hosted internal mirrors, vendor-hosted extension downloads from domains not yet allowlisted, and CI or build hosts fetching extension packages with curl or wget."
    tuning_guidance = "Add official marketplace, vendor and internal mirror domains to %global_allowed_domains. If NETWORK_HTTP events lack a user agent, remove the user-agent condition and scope by source network instead. Where TLS inspection is absent, URLs are unavailable and this rule will not fire."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\.(crx|vsix|xpi)(\?.*)?$/ nocase
    $net.network.http.user_agent = /(linux|x11|curl|wget)/ nocase
    not $net.target.hostname in %global_allowed_domains
    not $net.target.ip in %rfc1918_internal

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1176")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $extension_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
