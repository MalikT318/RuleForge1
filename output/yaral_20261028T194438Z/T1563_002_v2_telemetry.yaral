/*
  MITRE Technique : T1563.002 - RDP Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:10:19.427760+00:00
  Reference       : https://attack.mitre.org/techniques/T1563/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_002_RDP_Hijack_Service_ImagePath_Tscon {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows service ImagePath registry value that invokes the Terminal Services Console (tscon) with a session argument. This is the classic SYSTEM-level RDP session hijack: create a service whose binary path runs tscon to attach another user's session to the attacker's session. Detection is at the registry state-change layer, so it still fires if command-line logging is evaded or the service-creation utility is renamed."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1563.002"
    mitre_technique_name = "Remote Service Session Hijacking: RDP Hijacking"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon registry events) with target.registry.registry_value_data populated for HKLM\\SYSTEM\\*ControlSet*\\Services value writes."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare. Possible sources are administrator troubleshooting or lab scripts that wrap tscon in a service or helper, and session-management or VDI tooling that installs a service referencing tscon. Legitimate software does not normally register tscon as a service ImagePath."
    tuning_guidance = "Add approved session-management or VDI tooling binaries that write service keys to %global_allowed_admin_tools. If the SIEM maps new-service ImagePath writes to REGISTRY_CREATION rather than REGISTRY_MODIFICATION, deploy a sibling copy of this rule for that event type. Do not allowlist by service name, because attackers choose arbitrary names."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(CurrentControlSet|ControlSet\d{3})\\Services\\[^\\]+$/ nocase
    $reg.target.registry.registry_value_name = "ImagePath" nocase
    $reg.target.registry.registry_value_data = /\btscon(\.exe)?["']?\s+\S+/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(88)
    $mitre_technique_id = array_distinct("T1563.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $service_key = array_distinct($reg.target.registry.registry_key)
    $image_path = array_distinct($reg.target.registry.registry_value_data)
    $actor_process = array_distinct($reg.principal.process.file.full_path)
    $actor_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
