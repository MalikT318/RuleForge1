/*
  MITRE Technique : T1673 - Virtual Machine Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:16:01.616335+00:00
  Reference       : https://attack.mitre.org/techniques/T1673
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1673_VM_Process_Handle_Access_By_Unexpected_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a process requesting a handle to a hypervisor management or VM worker process (Hyper-V vmms/vmwp, VMware vmx, VirtualBox service/VM process) when the requester is not an approved management, backup, or security tool. Adversaries enumerating running VMs on a Windows host often query or open these processes directly. This rule works at the process-handle layer, so it is independent of command-line logging and still fires if the discovery tool is renamed."
    mitre_tactic = "Discovery"
    mitre_technique = "T1673"
    mitre_technique_name = "Virtual Machine Discovery"
    log_prerequisites = "Requires endpoint telemetry that records process handle or access requests (EDR process-access events or Sysmon Event ID 10) with populated principal and target process paths, on hosts running a hypervisor."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and snapshot agents, virtualization management consoles, performance and monitoring agents, EDR/AV scanners, and admin scripts that inventory VMs. Developer workstations running desktop hypervisors may also trigger it."
    tuning_guidance = "Add approved requesting binaries to %global_allowed_admin_tools, %global_allowed_backup_processes, or %global_allowed_security_tools. Add automation identities to %global_allowed_service_accounts. Extend the principal-process exclusion regex for client-specific hypervisor helper services. Consider limiting the rule to hosts that do not run a hypervisor."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\(vmwp|vmms|vmware-vmx|VirtualBoxVM|VBoxSVC)\.exe$/ nocase
    $open.principal.hostname != ""
    not $open.principal.process.file.full_path = /\\(csrss|services|svchost|wininit|vmms|vmwp|vmcompute|vmconnect|vmware[^\\]*|vmnat|VBox[^\\]*|VirtualBox[^\\]*)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1673")
    $primary_entity = array_distinct($open.principal.hostname)
    $requesting_process = array_distinct($open.principal.process.file.full_path)
    $target_vm_process = array_distinct($open.target.process.file.full_path)
    $requesting_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
