/*
  MITRE Technique : T1564.005 - Hidden File System
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:21:42.779720+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_005_Linux_Hidden_FS_Image_Staged {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a disk or filesystem image file (img, raw, qcow2, vhd, vmdk, luks, ext2/3/4, squashfs) in a world-writable staging directory (/tmp, /var/tmp, /dev/shm) or in a hidden dot-directory under a user home or /root. Adversaries drop portable partition images or encrypted containers on top of the standard filesystem and loop-mount them as a hidden file system to conceal tooling and data from users and file-based security tools."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.005"
    mitre_technique_name = "Hide Artifacts: Hidden File System"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-write/create rules (for example watches on /tmp, /var/tmp, /dev/shm and home directories) normalised to UDM FILE_CREATION with target.file.full_path and principal.process populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "VM and container image builders, CI/CD runners, backup and imaging jobs writing temporary images, package and ISO build tooling, developers creating loopback test filesystems, forensic or recovery work by administrators, installers that unpack squashfs or ext4 images to /tmp."
    tuning_guidance = "Add approved image-building or imaging binaries to %global_allowed_admin_tools or %global_allowed_backup_processes, and automation accounts to %global_allowed_service_accounts. Extend the benign-path exclusion regex for tenant-specific build directories. Consider raising severity when the creating process is a shell or interpreter, or when a loop mount follows on the same host."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    (
      $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/shm)\/(.*\/)?[^\/]+\.(img|raw|qcow2?|vhdx?|vmdk|luks|ext[234]|squashfs|dd)$/ nocase or
      $file.target.file.full_path = /^\/(home\/[^\/]+|root)\/\.[^\/]+\/(.*\/)?[^\/]+\.(img|raw|qcow2?|vhdx?|vmdk|luks|ext[234]|squashfs|dd)$/ nocase
    )
    not $file.target.file.full_path = /^\/(home\/[^\/]+|root)\/\.(cache|local|var|vagrant\.d|docker|minikube|lima|config)\// nocase
    not $file.target.file.full_path = /^\/var\/lib\/(libvirt|docker|snapd|containers|lxd|machines)\// nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1564.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $image_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
