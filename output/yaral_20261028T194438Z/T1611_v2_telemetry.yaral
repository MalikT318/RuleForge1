/*
  MITRE Technique : T1611 - Escape to Host
  Tactic(s)       : Privilege Escalation
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:31:02.872134+00:00
  Reference       : https://attack.mitre.org/techniques/T1611
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1611_Container_Escape_Host_Kernel_Interface_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects file modification of kernel and cgroup interfaces that are the final step of well-known container escapes (cgroup release_agent, core_pattern or modprobe usermode-helper hijack, sysrq trigger, binfmt_misc registration). Also detects modification of sensitive host files (cron, passwd/shadow, sudoers, ld.so.preload, SSH authorized_keys) through a host filesystem mount inside a container. The rule pivots on the resulting file state change, not the command line, so it is independent of how the attacker issued the write."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1611"
    mitre_technique_name = "Escape to Host"
    log_prerequisites = "Requires container runtime or node-level sensor telemetry that reports file modification events with principal.hostname, principal.process.file.full_path and target.file.full_path populated for Linux container workloads."
    platform = "Containers"
    log_source = "container"
    false_positives = "Container runtimes and orchestration agents configuring cgroups; node tuning or hardening DaemonSets writing core_pattern or sysctl values; security or forensics agents; backup agents that restore files through a host mount; admins debugging from a privileged debug pod."
    tuning_guidance = "Add approved node agents and runtime helpers to %global_allowed_security_tools or %global_allowed_admin_tools (matched on the writing process path). Add automation identities to %global_allowed_service_accounts. Add approved debugging or maintenance accounts to %global_allowed_admin_users. Review any hit where the writing process is a shell or an interpreter inside a container."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /(\/sys\/fs\/cgroup\/.*\/(release_agent|notify_on_release)$|\/proc\/sys\/kernel\/(core_pattern|modprobe|hotplug)$|\/proc\/sysrq-trigger$|\/proc\/sys\/fs\/binfmt_misc\/register$|^\/(host|hostfs|rootfs|mnt\/host|host-root)\/(etc\/(cron\.d\/|cron\.daily\/|cron\.hourly\/|crontab|passwd|shadow|sudoers|ld\.so\.preload)|var\/spool\/cron\/|root\/\.ssh\/authorized_keys))/ nocase
    not $file.principal.process.file.full_path = /\/(runc|containerd|containerd-shim[^\/]*|dockerd|crio|conmon|kubelet)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(88)
    $mitre_technique_id = array_distinct("T1611")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_paths = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $acting_users = array_distinct($file.principal.user.userid)

  condition:
    $file
}
