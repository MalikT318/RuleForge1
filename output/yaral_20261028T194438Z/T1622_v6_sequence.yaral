/*
  MITRE Technique : T1622 - Debugger Evasion
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:48:52.498942+00:00
  Reference       : https://attack.mitre.org/techniques/T1622
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1622_Debugger_Check_Then_Payload_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A script interpreter on a Windows host runs a command line that calls native debugger-detection APIs through inline interop code. Within 10 minutes, a script interpreter on the same host writes an executable or library to a user-writable staging location. This matches the pattern of malware checking for a debugger before dropping a secondary payload."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1622"
    mitre_technique_name = "Debugger Evasion"
    log_prerequisites = "Requires EDR or Sysmon process telemetry with full command lines (Sysmon EID 1 / Security EID 4688 with command-line auditing, or script-block content surfaced in command_line) and file creation telemetry (Sysmon EID 11 or EDR equivalent)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software developers and reverse engineers testing P/Invoke code in PowerShell, security research or malware analysis labs, installer or packaging scripts that call debugger-check APIs and then write binaries, and admin build or deployment scripts."
    tuning_guidance = "Add approved script-hosting parents to %global_allowed_script_hosts, deployment and packaging tooling to %global_allowed_admin_tools, and developer or analyst accounts to %global_allowed_admin_users. Widen or narrow the staging path regex per client environment. Lower the severity on developer-heavy hosts or analyst VDI."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|cscript|wscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(IsDebuggerPresent|CheckRemoteDebuggerPresent|NtQueryInformationProcess|ProcessDebugPort|ProcessDebugObjectHandle|ProcessDebugFlags|ThreadHideFromDebugger|NtSetInformationThread)/ nocase
    $proc.target.process.command_line = /(Add-Type|DllImport|GetProcAddress|GetDelegateForFunctionPointer|InteropServices|kernel32|ntdll)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users
    $proc.principal.hostname = $hostname

    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(powershell|pwsh|cscript|wscript|mshta)\.exe$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop)|programdata|windows\\temp|users\\public)\\.*\.(exe|dll|scr|sys)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1622")
    $primary_entity = array_distinct($hostname)
    $debug_check_commands = array_distinct($proc.target.process.command_line)
    $dropped_files = array_distinct($file.target.file.full_path)
    $users = array_distinct($proc.principal.user.userid)
    $dropped_file_count = count($file.metadata.id)

  condition:
    $proc and $file
}
