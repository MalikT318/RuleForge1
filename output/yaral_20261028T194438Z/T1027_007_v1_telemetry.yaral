/*
  MITRE Technique : T1027.007 - Dynamic API Resolution
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:48:31.938076+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_007_System_DLL_Copy_Outside_System_Directories {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a core Windows API library (ntdll, kernel32, kernelbase, win32u) on disk outside the Windows system and servicing directories. Malware that resolves APIs dynamically, by parsing the export table of its own copy of a system DLL, often stages a fresh copy to avoid hooked functions and API-monitoring sensors. This rule detects the staged file artifact, not the command line."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.007"
    mitre_technique_name = "Obfuscated Files or Information: Dynamic API Resolution"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with full target file path and writing process path populated in UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Debugger and symbol tooling that caches system DLLs (symbol servers, crash-dump analysis), OS servicing and in-place upgrade components, forensic and incident-response collection tools, software that bundles or repackages system DLLs, and backup or restore jobs that copy system files."
    tuning_guidance = "Add approved debugging, imaging and deployment binaries to %global_allowed_admin_tools, security agents that copy system files to %global_allowed_security_tools, and backup software to %global_allowed_backup_processes. Add further trusted OS servicing writer names to the writer-process regex. Limitation: an attacker who renames the staged DLL copy will not match the filename logic."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(ntdll|kernel32|kernelbase|win32u)\.dll$/ nocase
    $file.principal.hostname = $hostname

    // Exclude the legitimate OS locations and servicing stores
    not $file.target.file.full_path = /^[a-z]:\\(windows\\(system32|syswow64|winsxs|servicing|softwaredistribution|assembly)|\$winreagent|windows\.old)\\/ nocase

    // Exclude OS servicing and update writers by executable name, not install path
    not $file.principal.process.file.full_path = /\\(TiWorker|TrustedInstaller|MoUsoCoreWorker|wusa|DismHost|SetupHost|MsMpEng|MpCmdRun)\.exe$/ nocase

    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.007")
    $primary_entity = array_distinct($file.principal.hostname)
    $staged_file_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
