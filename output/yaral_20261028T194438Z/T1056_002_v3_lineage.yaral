/*
  MITRE Technique : T1056.002 - GUI Input Capture
  Tactic(s)       : Collection, Credential Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:47:31.325225+00:00
  Reference       : https://attack.mitre.org/techniques/T1056/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1056_002_Unexpected_Parent_Spawns_Credential_Prompt_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office application, print spooler, web server or database service spawning a script interpreter. PowerShell children must also carry credential-dialog indicators, such as Get-Credential, PromptForCredential, CredUI, InputBox or WinForms/WPF dialog classes. wscript, cscript and mshta children are flagged on lineage alone because their script content is not in the command line. These parents have no legitimate reason to display a credential prompt, so the lineage points to a spoofed credential dialog used to harvest user credentials."
    mitre_tactic = "Collection, Credential Access"
    mitre_technique = "T1056.002"
    mitre_technique_name = "Input Capture: GUI Input Capture"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and child command line populated (EDR, Sysmon Event ID 1 or Windows Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros or add-ins from line-of-business applications that legitimately launch scripts; web or database admin and maintenance scripts launched from w3wp, tomcat or sqlservr (for example SQL Agent jobs); print-management scripts launched by the spooler; legitimate installers that use mshta or wscript from Office."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts and approved tooling to %global_allowed_admin_tools. If a client has a specific line-of-business Office add-in that spawns scripts, allowlist its parent path in %global_allowed_script_hosts rather than loosening the regexes. Review recurring hosts before suppressing."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|spoolsv|w3wp|httpd|nginx|tomcat\d*|sqlservr|mysqld)\.exe$/ nocase
    (
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh|powershell_ise)\.exe$/ nocase and
        $proc.target.process.command_line = /(Get-Credential|PromptForCredential|CredUIPromptForCredentials|CredentialPicker|Microsoft\.VisualBasic\.Interaction|InputBox|System\.Windows\.Forms|PresentationFramework|ValidateCredentials|ShowDialog)/ nocase
      ) or
      $proc.target.process.file.full_path = /\\(wscript|cscript|mshta)\.exe$/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1056.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
