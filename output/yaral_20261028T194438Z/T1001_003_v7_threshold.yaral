/*
  MITRE Technique : T1001.003 - Protocol or Service Impersonation
  Tactic(s)       : Command and Control
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:11:26.907724+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_003_Burst_HTTP_Client_Header_Spoofing {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of built-in HTTP client invocations (PowerShell web cmdlets, curl, wget, .NET WebClient) that explicitly set or override User-Agent, Host, Referer or Origin headers, all on one host within ten minutes. A single header override is common admin and developer activity. Repeated header manipulation in a short window suggests scripted C2 beaconing that impersonates legitimate web or service traffic."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001.003"
    mitre_technique_name = "Data Obfuscation: Protocol or Service Impersonation"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command-line capture (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developers and QA testing web APIs, IT automation and monitoring scripts that set custom headers, software deployment and package scripts, health-check scripts that call internal services with a Host header, RMM tooling."
    tuning_guidance = "Add approved automation parent processes to %global_allowed_admin_tools or %global_allowed_script_hosts, and service accounts to %global_allowed_service_accounts. Raise the #proc threshold for noisy developer or build hosts. Review $sample_commands in the outcome to confirm the header values are impersonating a trusted service."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(invoke-webrequest|invoke-restmethod|\biwr\b|\birm\b|\bcurl(\.exe)?\b|\bwget\b|net\.webclient|webclient)/ nocase
    $proc.target.process.command_line = /(-useragent\b|--user-agent|\s-A\s+['\x22]|user-agent\s*:|-H\s+['\x22]?(host|referer|origin|user-agent)\s*:|headers\s*=?\s*@\{|headers\.add)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1001.003")
    $primary_entity = array_distinct($host)
    $event_count = count($proc.metadata.id)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $sample_commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 5
}
