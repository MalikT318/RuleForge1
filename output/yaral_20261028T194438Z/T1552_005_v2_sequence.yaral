/*
  MITRE Technique : T1552.005 - Cloud Instance Metadata API
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:52:25.493795+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_005_Instance_Role_Credentials_Used_From_New_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the result of instance metadata credential theft. Temporary credentials issued to a compute instance role (session identity ending in an instance ID) make API calls from the instance's normal source address, then within 10 minutes the same identity makes discovery, secret or credential-related API calls from a different, external source address. Instance role credentials are normally used only from the instance itself, so use from another external address suggests they were taken from the metadata service via local access or SSRF."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.005"
    mitre_technique_name = "Unsecured Credentials: Cloud Instance Metadata API"
    log_prerequisites = "Cloud control-plane audit logs with API-level activity (management events) ingested and normalised to UDM, with principal.user.userid and principal.ip populated. The instance role session name must be preserved in the user identifier."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Instances behind NAT pools or dual-homed with several egress addresses; instances that fail over between egress paths; administrators deliberately testing instance role permissions from a workstation or VPN; CI/CD or automation that reuses instance role sessions from a different network; VPC endpoint or proxy changes that alter the apparent source address."
    tuning_guidance = "Add approved automation or role identifiers to %global_allowed_cloud_principals. Add corporate VPN, bastion and egress addresses to %global_allowed_mgmt_sources. Extend or narrow the product_event_type regex in the second event to fit the client's API naming. If the client's session identifiers do not end in an instance ID, adjust the userid regex."

  events:
    // Event 1: instance role session activity from its usual source
    $first.metadata.event_type = "USER_RESOURCE_ACCESS"
    $first.principal.user.userid = /i-[0-9a-f]{8,17}$/ nocase
    not $first.principal.user.userid in %global_allowed_cloud_principals
    $first.principal.user.userid = $user

    // Event 2: same instance role session used from a different external source
    $second.metadata.event_type = "USER_RESOURCE_ACCESS"
    $second.principal.user.userid = /i-[0-9a-f]{8,17}$/ nocase
    $second.metadata.product_event_type = /^(GetCallerIdentity|ListBuckets|ListObjects|ListObjectsV2|GetObject|ListUsers|ListRoles|ListAccessKeys|ListSecrets|GetSecretValue|GetParameter|GetParameters|GetParametersByPath|DescribeInstances|DescribeSecurityGroups|GetAccessKeyLastUsed|ListAttachedRolePolicies|ListRolePolicies|GetRolePolicy|CreateAccessKey|AssumeRole)$/ nocase
    not $second.principal.ip in %rfc1918_internal
    not $second.principal.ip in %global_allowed_mgmt_sources
    not $second.principal.user.userid in %global_allowed_cloud_principals
    $second.principal.user.userid = $user

    // The source address differs between the two events
    $first.principal.ip != $second.principal.ip

    // Chronological order
    $first.metadata.event_timestamp.seconds <= $second.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1552.005")
    $primary_entity = array_distinct($user)
    $original_source_ips = array_distinct($first.principal.ip)
    $new_source_ips = array_distinct($second.principal.ip)
    $suspicious_actions = array_distinct($second.metadata.product_event_type)
    $event_count = count($second.metadata.id)

  condition:
    $first and $second
}
