/*
  MITRE Technique : T1543.002 - Systemd Service
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:55:08.109404+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_002_Systemd_Unit_Mass_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several systemd service unit files are created in system or user unit directories on a single Linux host within ten minutes. Creating one unit is routine, but a burst of new units from a non-package-manager process suggests persistence being staged (T1543.002), with multiple units used for redundancy or staged payloads."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.002"
    mitre_technique_name = "Create or Modify System Process: Systemd Service"
    log_prerequisites = "Requires Linux EDR or auditd file telemetry (watches on /etc/systemd, /usr/lib/systemd, /lib/systemd, /run/systemd and ~/.config/systemd) normalized to UDM FILE_CREATION with principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management agents (Ansible, Puppet, Chef, Salt) deploying several units, container or application installers run outside a package manager, golden-image build pipelines, administrators setting up multiple services manually."
    tuning_guidance = "Add configuration management and deployment binaries to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Raise the #file threshold on hosts that are frequently provisioned. Package managers are already excluded by executable name."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(etc|usr\/lib|lib|run)\/systemd\/(system|user)\/[^\/]+\.service$|\/\.config\/systemd\/user\/[^\/]+\.service$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|yum|dnf|zypper|snapd|packagekitd|unattended-upgrade|pacman)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1543.002")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $unit_files = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
