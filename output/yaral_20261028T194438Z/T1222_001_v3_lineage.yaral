/*
  MITRE Technique : T1222.001 - Windows Permissions
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:18:35.281468+00:00
  Reference       : https://attack.mitre.org/techniques/T1222/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_001_Unexpected_Parent_Spawns_Permission_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file or directory permission and attribute modification (icacls, cacls, xcacls, takeown, attrib, Set-Acl) launched from an unexpected parent process such as an Office application, web server worker, database service, print spooler or script host. Legitimate permission changes rarely originate from these parents, so this lineage indicates exploitation or macro or script-driven defense impairment."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1222.001"
    mitre_technique_name = "File and Directory Permissions Modification: Windows File and Directory Permissions Modification"
    log_prerequisites = "Requires endpoint process launch telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Application installers or updaters launched from Office or a database service, web applications that legitimately reset upload-directory ACLs (IIS app pools running deployment scripts), SQL Server maintenance jobs that set folder permissions for backups, print driver installation via the spooler, and administrator-authored VBScript or HTA logon scripts."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools, add expected automation accounts to %global_allowed_service_accounts, and add EDR or AV agents to %global_allowed_security_tools. If a web or database host legitimately runs permission changes, add its parent process path to %global_allowed_admin_tools instead of widening the rule. Adjust the parent regex to include or remove processes per client environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat\d*|php-cgi|sqlservr|spoolsv|mshta|wscript|cscript)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(icacls|cacls|xcacls|takeown|attrib|cmd|powershell|pwsh)\.exe$/ nocase
    $proc.target.process.command_line = /(\b(icacls|cacls|xcacls)\b.*(\/grant|\/deny|\/setowner|\/inheritance|\/reset|\/g\s|\/p\s)|\btakeown\b.*\/f\b|\battrib\b.*[+-][rsh]\b|set-acl|setaccesscontrol|setowner)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1222.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
