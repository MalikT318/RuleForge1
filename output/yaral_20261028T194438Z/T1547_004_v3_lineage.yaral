/*
  MITRE Technique : T1547.004 - Winlogon Helper DLL
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:28:56.539912+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_004_Winlogon_Unexpected_Child_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects winlogon.exe or userinit.exe spawning a child process outside the small set of expected logon components. Tampering with the Winlogon Shell, Userinit or Notify registry values makes the Winlogon process chain launch attacker-controlled executables or interpreters at logon. This rule detects the lineage result of the persistence, not the registry write or command line, so it covers registry changes made through APIs, offline hive edits and scripted tooling."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.004"
    mitre_technique_name = "Boot or Logon Autostart Execution: Winlogon Helper DLL"
    log_prerequisites = "Requires EDR or Sysmon process-creation telemetry (or Windows Event 4688 with parent process name populated) that populates the parent process path (principal.process.file.full_path) and the child process path (target.process.file.full_path)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "GPO or Active Directory logon scripts launched by userinit.exe (cmd.exe, wscript.exe, powershell.exe, batch files); kiosk or thin-client environments with a custom Winlogon Shell; third-party credential providers or GINA-style components such as VPN pre-logon and smart-card middleware; Windows feature components that winlogon.exe spawns on some builds."
    tuning_guidance = "Add custom shell or approved logon-script binaries to %global_allowed_admin_tools. Add endpoint security agents that launch at logon to %global_allowed_security_tools. Extend the child-name exclusion regex only for Windows components confirmed benign in the client environment. For kiosk fleets, scope or suppress by host in the SOAR playbook."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winlogon|userinit)\.exe$/ nocase
    $proc.target.process.file.full_path != ""
    not $proc.target.process.file.full_path = /\\(userinit|explorer|logonui|dwm|fontdrvhost|consent|werfault|wermgr|sihost|taskhostw|rdpclip)\.exe$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
