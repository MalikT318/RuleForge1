/*
  MITRE Technique : T1496.002 - Bandwidth Hijacking
  Tactic(s)       : Impact
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:53:42.931174+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_002_Bandwidth_Hijacking_Asymmetric_Upload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a single perimeter flow in which an internal Windows host sends a very large volume of data to an external address while receiving almost nothing back. This one-way upload pattern is typical of bandwidth hijacking: proxyware/proxyjacking relays, botnet DDoS traffic, torrent seeding, and outbound scanning or relay traffic."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.002"
    mitre_technique_name = "Resource Hijacking: Bandwidth Hijacking"
    log_prerequisites = "Requires firewall or perimeter NETWORK_FLOW telemetry with network.sent_bytes and network.received_bytes populated, and source/destination IPs normalised to UDM. No endpoint process fields are used."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Cloud backup and replication jobs, large file or media uploads to external SaaS, software publishers pushing builds, offsite log shipping, video conferencing or streaming from servers, authorised penetration tests and scanners."
    tuning_guidance = "Add known-good external destinations to %global_allowed_domains. Add authorised scanner or test sources to %global_allowed_scanners. Adjust the sent_bytes threshold (1 GB) and the received_bytes ceiling (10 MB) per client baseline. If flows are logged as periodic sessions rather than final totals, lower the threshold or move to a Threshold rule aggregating per source host."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    $net.principal.ip in %rfc1918_internal
    not $net.target.ip in %rfc1918_internal
    $net.network.sent_bytes > 1000000000
    $net.network.received_bytes < 10000000
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1496.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
