/*
  MITRE Technique : T1020 - Automated Exfiltration
  Tactic(s)       : Exfiltration
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:30:46.733203+00:00
  Reference       : https://attack.mitre.org/techniques/T1020
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1020_Linux_CLI_Client_Large_Outbound_Upload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a large outbound HTTP upload (POST/PUT) to an external destination from a client whose user-agent is a Linux-style command-line or scripting HTTP library. Automated exfiltration from Linux hosts (cron jobs, systemd timers, shell or Python scripts) typically uses these non-browser clients. Detection is perimeter-based and uses the user-agent as the only Linux indicator, because firewall and proxy logs carry no process or OS fields. It complements process-creation rules by catching the network result of the exfiltration."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1020"
    mitre_technique_name = "Automated Exfiltration"
    log_prerequisites = "Requires forward-proxy or perimeter HTTP logging with HTTP method, user-agent and sent-bytes populated. TLS inspection is needed to see the user-agent for HTTPS traffic."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Backup and artifact upload jobs, CI/CD runners pushing build artifacts, log shippers and telemetry agents, package or container registry pushes, sanctioned cloud storage sync scripts, and macOS hosts using the same CLI clients."
    tuning_guidance = "Add sanctioned destinations to %global_allowed_domains. Add service accounts that run upload jobs to %global_allowed_service_accounts. Raise or lower the sent_bytes threshold per client baseline. Add or remove user-agent patterns to match the client's environment."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT)$/ nocase
    $net.network.http.user_agent = /^(curl|wget|libcurl|python-(requests|urllib)|go-http-client|aria2|lwp-trivial|okhttp|apache-httpclient)/ nocase
    $net.network.sent_bytes >= 10485760
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1020")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $max_sent_bytes = max($net.network.sent_bytes)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
