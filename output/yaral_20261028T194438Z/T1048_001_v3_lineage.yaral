/*
  MITRE Technique : T1048.001 - Exfiltration Over Symmetric Encrypted Non-C2 Protocol
  Tactic(s)       : Exfiltration
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:34:16.374668+00:00
  Reference       : https://attack.mitre.org/techniques/T1048/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1048_001_ESXi_Mgmt_Daemon_Spawns_Transfer_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi management or agent daemon (host agent, vCenter agent, reverse HTTP proxy, CIM broker, WS-Man, SLP) directly spawning an outbound data-transfer client such as scp, sftp, ssh, nc, curl, wget or openssl. These daemons never legitimately launch file-transfer or encrypted-tunnel clients, so this lineage points to exploitation of a management service or a hijacked agent being used to stage encrypted exfiltration to a non-C2 destination."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1048.001"
    mitre_technique_name = "Exfiltration Over Alternative Protocol: Exfiltration Over Symmetric Encrypted Non-C2 Protocol"
    log_prerequisites = "ESXi shell/hostd process execution logs forwarded to Chronicle with parent and child process paths populated (principal.process.file.full_path and target.process.file.full_path)."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Third-party backup or monitoring agents installed as VIBs that shell out to curl, wget or scp. Vendor support scripts launched by the host agent. Custom automation that uses the host agent to fetch patches or bundles."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools and approved automation accounts to %global_allowed_service_accounts. Add backup agents to the exclusion list if they legitimately spawn transfer clients. Extend the parent daemon regex with local agent names if needed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(hostd|vpxa|rhttpproxy|sfcbd|sfcb-[a-z0-9_-]+|openwsmand|slpd|vobd|vmsyslogd|fdm)$/ nocase
    $proc.target.process.file.full_path = /\/(scp|sftp|ssh|nc|ncat|netcat|curl|wget|openssl)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1048.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
