/*
  MITRE Technique : T1221 - Template Injection
  Tactic(s)       : Stealth
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:13:38.103207+00:00
  Reference       : https://attack.mitre.org/techniques/T1221
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1221_Office_Launch_Remote_Template_Reference {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Microsoft Office application (Word, Excel, PowerPoint) launched with a command line that references a remote template or macro-enabled document over HTTP(S), WebDAV or a UNC share. This is the load path used by remote template injection, where the document pulls a payload from an external location when it is opened."
    mitre_tactic = "Stealth"
    mitre_technique = "T1221"
    mitre_technique_name = "Template Injection"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command-line capture (EDR, Sysmon Event ID 1 or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Users opening corporate templates or macro-enabled documents from SharePoint, WebDAV or file shares; document management and deployment tooling that launches Office with remote template paths; IT staff testing template deployment."
    tuning_guidance = "Add approved launcher or deployment parent processes to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. If internal SharePoint or file-share template use is common, narrow the remote-path branch of the regex, or deploy only the HTTP(S) and WebDAV branches for that tenant."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(winword|excel|powerpnt)\.exe$/ nocase
    $proc.target.process.command_line = /(https?:\/\/|@ssl\\|davwwwroot|\\\\[a-z0-9._-]+\\)/ nocase
    $proc.target.process.command_line = /\.(dotm|dotx|dot|docm|xltm|xltx|xlt|xlsm|potm|potx|pot|pptm)(\b|$|["'?])/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1221")
    $primary_entity = array_distinct($proc.principal.hostname)
    $office_process = array_distinct($proc.target.process.file.full_path)
    $office_command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
