/*
  MITRE Technique : T1558 - Steal or Forge Kerberos Tickets
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:38:00.418672+00:00
  Reference       : https://attack.mitre.org/techniques/T1558
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_Outbound_Kerberos_To_External_KDC {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows host opening a Kerberos (TCP/UDP 88) connection to a non-internal address. Domain KDCs sit on internal address space, so Kerberos traffic leaving the network suggests ticket requests (AS-REQ/TGS-REQ) sent to an external or attacker-proxied KDC, or tunnelled by offensive tooling such as Kerberoasting, AS-REP roasting or ticket forging utilities. This is a network-side view and works alongside endpoint coverage of klist and ticket-dumping activity."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558"
    mitre_technique_name = "Steal or Forge Kerberos Tickets"
    log_prerequisites = "Requires endpoint network telemetry that populates principal process, target IP and target port for outbound connections (EDR network events, Sysmon Event ID 3, or equivalent) normalised to NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Cross-forest or cross-realm trusts reached over routable address space that is not in the internal list, hybrid or partner realms reached over VPN or WAN with public addressing, multi-site networks that use non-RFC1918 internal ranges, vulnerability scanners and authorised penetration tests, and Kerberos-aware proxies or gateways."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools and approved remote management tooling to %global_allowed_remote_mgmt. If a client uses public or non-RFC1918 addressing internally, add those ranges to %rfc1918_internal. Add authorised scanner source processes to %global_allowed_admin_tools if they trigger the rule. Raise severity for non-lsass processes if desired."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 88
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1558")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $source_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
