/*
  MITRE Technique : T1014 - Rootkit
  Tactic(s)       : Stealth
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:26:46.592397+00:00
  Reference       : https://attack.mitre.org/techniques/T1014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1014_Linux_Staged_Kernel_Module_Then_Load {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A kernel module (.ko) is written to a world-writable staging location (/tmp, /var/tmp, /dev/shm, /run/user) and then loaded with insmod or modprobe on the same host within 10 minutes. This staged-module-then-load pattern is typical of loadable kernel module (LKM) rootkit installation. Legitimate modules are installed under /lib/modules by the package manager and are not loaded from temp directories."
    mitre_tactic = "Stealth"
    mitre_technique = "T1014"
    mitre_technique_name = "Rootkit"
    log_prerequisites = "Requires Linux EDR or auditd telemetry providing file creation events (with target path) and process launch events (with command line and parent process path), normalised to UDM."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Driver developers and kernel engineers building out-of-tree modules in temp directories, DKMS or vendor driver installers that unpack and load modules from /tmp (GPU, VPN, hypervisor guest tools), CI/build hosts and kernel test labs."
    tuning_guidance = "Add approved build, deployment and driver-installer parent processes to %global_allowed_admin_tools. Add approved build or kernel-development hosts' automation to the exclusions. Consider excluding known developer hosts via a host condition per tenant."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/user\/[0-9]+)\/.*\.ko(\.(xz|gz|zst))?$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(insmod|modprobe)$/ nocase
    $proc.target.process.command_line = /(^|\s)\/?(tmp|var\/tmp|dev\/shm|run\/user\/[0-9]+)\/\S*\.ko(\s|$)|\/(tmp|var\/tmp|dev\/shm|run\/user\/[0-9]+)\/\S*\.ko(\s|$)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1014")
    $primary_entity = array_distinct($hostname)
    $staged_module_paths = array_distinct($file.target.file.full_path)
    $load_commands = array_distinct($proc.target.process.command_line)
    $loading_users = array_distinct($proc.principal.user.userid)
    $load_count = count($proc.metadata.id)

  condition:
    $file and $proc
}
