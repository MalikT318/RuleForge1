/*
  MITRE Technique : T1098 - Account Manipulation
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:39:15.789128+00:00
  Reference       : https://attack.mitre.org/techniques/T1098
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_Container_Privileged_RBAC_Binding_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a permission change in which a subject is bound to a cluster-wide privileged role or group (cluster-admin, system:masters) in a Kubernetes/container orchestration control plane. This is detected at the configuration/permission state-change layer, not through command-line telemetry, so it fires whether the change was made via kubectl, a direct API call, or a CI/CD pipeline. Adversaries use it to persist or escalate through account manipulation."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098"
    mitre_technique_name = "Account Manipulation"
    log_prerequisites = "Requires Kubernetes control-plane audit logs, or identity/directory audit logs covering the cluster, ingested and normalised to UDM USER_CHANGE_PERMISSIONS, with the bound role or group in target.resource.name or target.group.group_display_name. Audit policy must record RoleBinding and ClusterRoleBinding create/update requests at Metadata level or higher."
    platform = "Containers"
    log_source = "identity"
    false_positives = "Cluster bootstrap and day-0 provisioning; platform engineering or GitOps controllers granting admin to break-glass groups; managed Kubernetes services that auto-bind admin roles to the cluster creator; planned administrator onboarding."
    tuning_guidance = "Add GitOps/CI service accounts to %global_allowed_service_accounts, named cluster administrators to %global_allowed_admin_users, and approved cloud or identity principals to %global_allowed_cloud_principals. Extend the privileged role regex with client-specific high-privilege custom roles, using a per-client copy of the rule."

  events:
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    (
      $perm.target.resource.name = /^(cluster-admin|system:masters)$/ nocase or
      $perm.target.group.group_display_name = /^(cluster-admin|system:masters)$/ nocase
    )
    $perm.principal.user.userid != ""
    not $perm.principal.user.userid = /^system:(kube-|apiserver|node|serviceaccount:kube-system)/ nocase
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1098")
    $primary_entity = array_distinct($perm.principal.user.userid)
    $target_subjects = array_distinct($perm.target.user.userid)
    $bound_roles = array_distinct(strings.coalesce($perm.target.resource.name, $perm.target.group.group_display_name))
    $source_ips = array_distinct($perm.principal.ip)

  condition:
    $perm
}
