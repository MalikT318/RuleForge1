/*
  MITRE Technique : T1036.009 - Break Process Trees
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:11:23.777664+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_009_Orphaned_Writable_Path_Process_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound connection to an external address from a process that has been re-parented to init (PID 1) and executes from a world-writable or memory-backed location such as /tmp, /var/tmp, /dev/shm or a memfd. This is the network footprint of a payload that double-forked or daemonized to break its process tree and then began C2 or staging traffic. It provides network-side coverage that does not depend on process-creation command-line logic."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.009"
    mitre_technique_name = "Masquerading: Break Process Trees"
    log_prerequisites = "Requires Linux EDR or auditd network telemetry (connect syscalls) that populates principal.process.parent_process.pid and principal.process.file.full_path on NETWORK_CONNECTION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Self-updating agents or portable tools staged in /tmp or /var/tmp and run as daemons by an installer; containerized workloads where the entrypoint runs as PID 1 from a temp path; package or build jobs that download dependencies from a temporary directory; admin-written daemons using double-fork that run from /tmp."
    tuning_guidance = "Add approved agent or deployment binaries to %global_allowed_admin_tools and approved security agents to %global_allowed_security_tools. Add known-good external destinations to %global_allowed_domains. Add approved script hosts to %global_allowed_script_hosts. Keep %rfc1918_internal populated for each client's internal address space. For container-heavy fleets, consider adding container host exclusions via %global_allowed_script_hosts."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.parent_process.pid = "1"
    $net.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/shm)\/|^\/proc\/self\/fd\/|memfd:/ nocase
    $net.target.ip != ""
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1036.009")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
