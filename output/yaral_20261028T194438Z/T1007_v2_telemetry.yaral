/*
  MITRE Technique : T1007 - System Service Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:14:15.183828+00:00
  Reference       : https://attack.mitre.org/techniques/T1007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1007_Linux_Service_Enumeration_Output_Staged {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects a shell or script interpreter creating a file in a world-writable staging directory (/tmp, /var/tmp, /dev/shm) whose name indicates service, daemon, systemd unit or cron enumeration output. Matching on the resulting file artifact instead of the command line still catches discovery when command-line logging is evaded, obfuscated or truncated."
    mitre_tactic = "Discovery"
    mitre_technique = "T1007"
    mitre_technique_name = "System Service Discovery"
    log_prerequisites = "Linux EDR or auditd file-creation telemetry that populates the creating process path (principal.process.file.full_path) and the created file path (target.file.full_path)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Admin or troubleshooting scripts that save systemctl, service or crontab listings to /tmp; configuration management and inventory or health-check scripts; backup or monitoring scripts that write temporary service-state files; developers testing init scripts."
    tuning_guidance = "Add approved inventory and automation binaries to %global_allowed_admin_tools, hosts where scripting is expected to %global_allowed_script_hosts, and automation accounts to %global_allowed_service_accounts. Treat hits on internet-facing servers or containers, or hits followed by archive or network-transfer activity, as higher priority. Extend the filename keywords per environment if needed."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/[^\/]*(services?|svc|systemctl|chkconfig|daemons?|unit[-_]?files?|crontab|cron[-_]?(list|jobs?)|initd)[^\/]*$/ nocase
    $file.principal.process.file.full_path = /\/(bash|dash|sh|zsh|ksh|csh|tcsh|python[0-9.]*|perl|ruby)$/ nocase
    not $file.target.file.full_path = /systemd-private-/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.hostname in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1007")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_files = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $acting_users = array_distinct($file.principal.user.userid)

  condition:
    $file
}
