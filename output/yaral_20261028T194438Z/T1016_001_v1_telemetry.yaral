/*
  MITRE Technique : T1016.001 - Internet Connection Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:44:50.313661+00:00
  Reference       : https://attack.mitre.org/techniques/T1016/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_001_Linux_Connectivity_Check_Artifact_In_Staging_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects creation of a file in a world-writable staging directory (/tmp, /var/tmp, /dev/shm) that is either written by a built-in network diagnostic utility (ping, traceroute, tracepath, mtr, speedtest) or named like a connectivity-check result. This catches the file artifact of Internet connection discovery regardless of how the command line was obfuscated or logged."
    mitre_tactic = "Discovery"
    mitre_technique = "T1016.001"
    mitre_technique_name = "System Network Configuration Discovery: Internet Connection Discovery"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-creation records (PATH/CWD/SYSCALL) normalised to UDM FILE_CREATION, with principal.process.file.full_path and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Network monitoring or uptime-check scripts writing results to /tmp, admin troubleshooting sessions, configuration management or provisioning scripts that test connectivity, package installers and cloud-init checking for network availability, speed test cron jobs."
    tuning_guidance = "Add approved monitoring and automation binaries to %global_allowed_admin_tools, authorised scanners to %global_allowed_scanners, and EDR/agent binaries to %global_allowed_security_tools. If a client runs recurring health-check scripts, add the script interpreter or parent process to %global_allowed_script_hosts. Raise severity if correlated with other discovery activity from the same host."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    (
      $file.principal.process.file.full_path = /\/(ping|ping6|fping|traceroute|traceroute6|tracepath|tracepath6|mtr|speedtest|speedtest-cli)$/ nocase or
      $file.target.file.full_path = /\/([^\/]*[_.-])?(ping|traceroute|tracepath|speedtest|connectivity|inet_?check|net_?check|online_?check)([_.-][^\/]*)?$/ nocase
    )
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_scanners
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1016.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_files = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    $file
}
