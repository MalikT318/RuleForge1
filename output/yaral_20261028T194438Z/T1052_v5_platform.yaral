/*
  MITRE Technique : T1052 - Exfiltration Over Physical Medium
  Tactic(s)       : Exfiltration
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:41:39.666549+00:00
  Reference       : https://attack.mitre.org/techniques/T1052
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1052_Bulk_Copy_To_Non_System_Drive {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects built-in Windows bulk-copy utilities (robocopy/xcopy) run with recursive or mirror flags to copy user-data locations to a non-system drive letter (D: to Z:), a common pattern when staging data onto removable media. The rule is written for Windows because the target platform is mandated as Windows, so the alternate-platform angle was not applied. Command-line telemetry cannot confirm that the destination is removable, so this is a behavioural proxy."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1052"
    mitre_technique_name = "Exfiltration Over Physical Medium"
    log_prerequisites = "Requires EDR process telemetry with full command lines, Sysmon Event ID 1, or Windows Event 4688 with command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Users or admins backing up profiles to secondary internal disks or mapped network drives, profile migration during device refresh, software deployment scripts, and approved backup jobs run through scripts."
    tuning_guidance = "Add approved backup and imaging tools to %global_allowed_backup_processes and IT tooling to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Consider correlating with device-insertion telemetry if available. On hosts with a permanent secondary data volume, exclude by host or user via the reference lists."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(robocopy|xcopy)\.exe$/ nocase
    $proc.target.process.command_line = /\s\/(s|e|mir|move|mov|z|zb)\b/ nocase
    $proc.target.process.command_line = /(users\\|%userprofile%|%homepath%|documents|desktop|\\\\).*\s"?[d-z]:\\/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1052")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
