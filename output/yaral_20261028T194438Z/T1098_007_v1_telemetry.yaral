/*
  MITRE Technique : T1098.007 - Additional Local or Domain Groups
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:50:10.060236+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_007_Linux_Group_Or_Sudoers_File_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of Linux group membership and privilege files (/etc/group, /etc/gshadow, /etc/sudoers, /etc/sudoers.d/*). This is the resulting file-state change when an account is added to additional local groups such as sudo, wheel, docker or adm. It fires regardless of how the change was made (usermod, gpasswd, direct editing, or a custom tool), so it still works when command-line logging is evaded."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.007"
    mitre_technique_name = "Account Manipulation: Additional Local or Domain Groups"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules (-w /etc/group -p wa, -w /etc/gshadow -p wa, -w /etc/sudoers -p wa, -w /etc/sudoers.d/ -p wa) normalised to UDM FILE_MODIFICATION with the acting process populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate administrators running usermod, gpasswd or visudo; configuration management (Ansible, Puppet, Chef, Salt) pushing group or sudoers changes; package installs creating system groups; cloud-init and provisioning on first boot; identity agents syncing local groups; user onboarding and offboarding."
    tuning_guidance = "Add approved config-management and provisioning binaries to %global_allowed_admin_tools. Add named administrators to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Extend the package-manager and provisioning process-name exclusion if a client uses other installers. Consider correlating with a change ticket window."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/(group|gshadow|sudoers)$|^\/etc\/sudoers\.d\/[^\/]+$/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path = /\/(dpkg|rpm|yum|dnf|zypper|apt|apt-get|snapd|cloud-init|systemd-sysusers)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1098.007")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $acting_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
