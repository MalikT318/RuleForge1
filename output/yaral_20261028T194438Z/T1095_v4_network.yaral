/*
  MITRE Technique : T1095 - Non-Application Layer Protocol
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:38:01.461464+00:00
  Reference       : https://attack.mitre.org/techniques/T1095
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1095_Firewall_Outbound_ICMP_Large_Payload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound ICMP traffic to an external destination where the bytes sent in a single connection exceed what normal echo diagnostics produce. Oversized ICMP payloads to the internet are a common sign of ICMP tunnelling or C2 over a non-application layer protocol."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1095"
    mitre_technique_name = "Non-Application Layer Protocol"
    log_prerequisites = "Requires firewall or perimeter logs that record ICMP sessions, with network.ip_protocol, target.ip and network.sent_bytes populated and normalised to NETWORK_CONNECTION."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Network monitoring and uptime probes that use large ICMP payloads, MTU and path-discovery testing by network engineers, vulnerability scanners, and SD-WAN or VPN appliances that probe links with oversized pings."
    tuning_guidance = "Add authorised probe and scanner source addresses to %global_allowed_scanners and approved management or monitoring sources to %global_allowed_mgmt_sources. Add known-good external destinations (vendor and ISP monitoring targets) to %global_allowed_domains if the destination is logged as a hostname. Raise or lower the network.sent_bytes threshold (default 256) to match the customer's baseline ping size."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "ICMP"
    $net.network.sent_bytes > 256
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1095")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
