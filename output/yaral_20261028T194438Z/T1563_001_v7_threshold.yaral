/*
  MITRE Technique : T1563.001 - SSH Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:09:42.910626+00:00
  Reference       : https://attack.mitre.org/techniques/T1563/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_001_Internal_SSH_Fanout_From_Single_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source opens an unusually high number of SSH (TCP/22) connections to internal destinations within ten minutes. Hijacked SSH agent sockets or sessions let an adversary reuse trusted key-based access to hop between hosts, which appears on the perimeter or internal firewall as rapid SSH fan-out from one host. Each connection is benign on its own; the volume is the signal. This is a network-level proxy for the technique and does not see the agent socket itself."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1563.001"
    mitre_technique_name = "Remote Service Session Hijacking: SSH Hijacking"
    log_prerequisites = "Firewall, proxy or network flow logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. The firewall must see east-west (internal-to-internal) traffic, for example via internal segmentation firewalls or flow logs."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Bastion or jump hosts, configuration management and orchestration servers (Ansible, Salt), backup or file-sync jobs over SSH/SCP/rsync, CI/CD runners deploying to many hosts, monitoring systems using SSH checks, and authorised vulnerability or compliance scanners."
    tuning_guidance = "Add jump hosts, automation controllers and monitoring sources to %global_allowed_mgmt_sources. Add authorised scanners to %global_allowed_scanners. Raise the #net threshold in noisy environments with heavy automation, or lower it for high-security segments. Confirm %rfc1918_internal matches the client's internal addressing."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 22
    $net.target.ip in %rfc1918_internal
    $net.principal.ip = $src
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1563.001")
    $primary_entity = array_distinct($src)
    $event_count = count($net.metadata.id)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    #net >= 10
}
