/*
  MITRE Technique : T1091 - Replication Through Removable Media
  Tactic(s)       : Lateral Movement, Initial Access
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:34:32.730670+00:00
  Reference       : https://attack.mitre.org/techniques/T1091
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1091_Autorun_Inf_Created_On_NonSystem_Drive {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of an autorun.inf file in the root of a non-system drive letter, the Windows AutoRun mechanism used to execute malware from removable media. The requested non-Windows pivot conflicts with the mandatory Windows platform and log-source requirement, so this rule targets Windows only."
    mitre_tactic = "Lateral Movement, Initial Access"
    mitre_technique = "T1091"
    mitre_technique_name = "Replication Through Removable Media"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with full file paths populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate installer or media-authoring software writing autorun.inf to optical or USB media, IT imaging and USB provisioning tools, backup software, and software distribution on removable drives. Mapped network drives or secondary fixed disks that use non-C drive letters may also match."
    tuning_guidance = "Add approved media-authoring, imaging and provisioning tools to %global_allowed_admin_tools and endpoint agents to %global_allowed_security_tools. Add provisioning accounts to %global_allowed_admin_users. If a client keeps data on a fixed D: drive, tune with hostname-scoped exclusions at deployment."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^[a-z]:\\autorun\.inf$/ nocase
    not $file.target.file.full_path = /^c:\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1091")
    $primary_entity = array_distinct($file.principal.hostname)
    $acting_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)
    $autorun_path = array_distinct($file.target.file.full_path)

  condition:
    $file
}
