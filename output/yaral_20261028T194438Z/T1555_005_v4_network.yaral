/*
  MITRE Technique : T1555.005 - Password Managers
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:59:56.175615+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_005_Script_Interpreter_Password_Vault_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "A scripting interpreter or script-capable LOLBin makes an outbound network connection to an external host whose name indicates a password vault or password manager service. Legitimate password manager clients and browsers perform this traffic. A scripting engine doing so suggests scripted vault API or CLI access, vault exfiltration, or credential harvesting from a password manager."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.005"
    mitre_technique_name = "Credentials from Password Stores: Password Managers"
    log_prerequisites = "Requires Windows endpoint network telemetry (EDR or Sysmon Event ID 3) that populates the initiating process path and the destination hostname (reverse-resolved or DNS-enriched) on NETWORK_CONNECTION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admins or DevOps pipelines scripting enterprise secret stores (for example Azure Key Vault or HashiCorp Vault) from PowerShell or Python; sanctioned password manager automation or provisioning scripts; IT onboarding scripts that call a corporate password manager API."
    tuning_guidance = "Add sanctioned vault and secret-store domains to %global_allowed_domains. Add approved automation tooling to %global_allowed_admin_tools and approved script runners to %global_allowed_script_hosts. Add service accounts that legitimately call vault APIs to %global_allowed_service_accounts. Where the destination hostname is rarely populated, enable DNS enrichment on endpoint network events."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|python[w]?|cmd)\.exe$/ nocase
    $net.target.hostname = /(vault|passw(or)?d[-_.]?(manager|safe|store)|pass[-_.]?manager)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1555.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
