/*
  MITRE Technique : T1564.012 - File/Path Exclusions
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:32:08.982588+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_012_Network_Egress_From_AV_Exclusion_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process executing from a well-known default antivirus/OS scan-exclusion data directory (for example Defender scan, quarantine and definition folders, SoftwareDistribution Datastore, Security database, System32 Config, GroupPolicy, spool PRINTERS) that makes an outbound connection to a non-internal address. These folders hold data only, so a binary running from them and talking to the internet suggests an implant hiding in a scan-exempt location (T1564.012) and beaconing or staging."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.012"
    mitre_technique_name = "Hide Artifacts: File/Path Exclusions"
    log_prerequisites = "Requires endpoint network telemetry (EDR or Sysmon Event ID 3 equivalent) that populates principal.process.file.full_path and target.ip for outbound connections."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Antivirus definition updater stubs that run from the definition-updates folder, security agents or EDR sensors with their own data directories, backup or imaging agents staging in these folders, and Windows servicing components that briefly execute from servicing data directories."
    tuning_guidance = "Add legitimate security agents to %global_allowed_security_tools and approved IT or deployment tooling to %global_allowed_admin_tools. Extend the process-name exclusion for any client-specific updater stub that runs from a scan-exclusion folder. Review the primary_process outcome to decide which paths to allow."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(Windows\\SoftwareDistribution\\Datastore|Windows\\Security\\database|Windows\\System32\\config|Windows\\System32\\GroupPolicy|Windows\\System32\\spool\\PRINTERS|Windows\\System32\\LogFiles\\Sum|Windows\\System32\\wdi\\LogFiles|ProgramData\\Microsoft\\Windows Defender\\(Scans|Quarantine|Definition Updates))\\/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path = /\\(MsMpEng|MpCmdRun|NisSrv|MsSense|SenseIR|mpam-[a-z0-9]+)\.exe$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1564.012")
    $primary_entity = array_distinct($net.principal.hostname)
    $primary_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
