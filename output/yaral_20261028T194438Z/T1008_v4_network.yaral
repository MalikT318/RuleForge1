/*
  MITRE Technique : T1008 - Fallback Channels
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:16:38.880317+00:00
  Reference       : https://attack.mitre.org/techniques/T1008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1008_Fallback_Channel_IP_Literal_NonStandard_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an outbound proxied or inspected HTTP request from an internal client to an external destination addressed by a raw IP literal on a non-standard port. Malware commonly falls back to hardcoded IP and port pairs when its primary domain-based C2 channel is blocked or sinkholed. The rule observes this from the network perimeter and does not rely on endpoint process fields. It approximates fallback behaviour from a single event and does not prove channel failover."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1008"
    mitre_technique_name = "Fallback Channels"
    log_prerequisites = "Firewall or web proxy logs normalised to UDM NETWORK_HTTP with target.url, target.ip and target.port populated. Requires HTTP-aware inspection (proxy or application-aware firewall), and the client source IP must be populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Software updaters or appliances that contact vendors by IP on high ports, web-based management consoles for external or cloud-hosted devices, developer and test traffic to cloud VMs by IP, CDN or telemetry agents with hardcoded endpoints, and authorised vulnerability scanning or pen-test traffic."
    tuning_guidance = "Add scanner source IPs to %global_allowed_scanners. Add known-good vendor domains to %global_allowed_domains, which is matched against target.hostname where the proxy resolves it. Add trusted management source addresses to %global_allowed_mgmt_sources. Raise severity or add a Threshold variant for repeated hits from one source."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /^(?i)(https?:\/\/)?\d{1,3}(\.\d{1,3}){3}(:\d{1,5})?(\/|$)/
    $net.target.port > 0
    $net.target.port != 80
    $net.target.port != 443
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1008")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
