/*
  MITRE Technique : T1665 - Hide Infrastructure
  Tactic(s)       : Command and Control
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:06:11.707223+00:00
  Reference       : https://attack.mitre.org/techniques/T1665
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1665_DNS_Long_Label_Query_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single Windows client issues a burst of DNS queries for unusually long, machine-generated-looking subdomain labels within ten minutes. Long random labels are a common way to mask the true destination of C2 infrastructure behind disposable or fronted domains. Any one such query is often benign, but the volume from one host is not."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1665"
    mitre_technique_name = "Hide Infrastructure"
    log_prerequisites = "Requires DNS query or resolver logs normalized to UDM NETWORK_DNS, with the querying client in principal.hostname and the queried name in network.dns.questions.name."
    platform = "Windows"
    log_source = "dns"
    false_positives = "CDN and cloud storage hostnames with long generated labels, software update and telemetry services, email security and URL-reputation lookups, DNS-based blocklist queries, anti-malware cloud lookups, and browser safe-browsing services."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains (matched against the full queried name, so add the exact noisy names that appear). Add vulnerability scanners and authorised test hosts to %global_allowed_scanners. Raise the #dns threshold or the label length (currently 35+ characters) for noisy tenants. Review the sample_queries outcome field to confirm algorithmic naming."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /[a-z0-9\-]{35,}\.[a-z0-9\-]+\.[a-z]{2,}$/ nocase
    $dns.principal.hostname = $host
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.hostname in %global_allowed_scanners

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1665")
    $primary_entity = array_distinct($host)
    $query_count = count($dns.metadata.id)
    $distinct_names = count_distinct($dns.network.dns.questions.name)
    $sample_queries = array_distinct($dns.network.dns.questions.name)

  condition:
    #dns >= 15
}
