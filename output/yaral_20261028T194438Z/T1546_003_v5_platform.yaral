/*
  MITRE Technique : T1546.003 - Windows Management Instrumentation Event Subscription
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:04:50.495031+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_003_WMI_MOF_File_Staged_In_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a Managed Object Format (.mof) file in the legacy WMI auto-recompile directory or in a user-writable staging location. MOF files are the compiled input for WMI event filter, consumer and binding persistence, and the file is typically dropped before mofcomp consumes it. This rule is file-telemetry based, so it adds coverage that command-line rules miss, including MOF compilation triggered by a service, API call or script host. The required angle asked for a non-Windows platform, but the platform requirement mandates Windows, so this rule targets Windows file-creation telemetry."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.003"
    mitre_technique_name = "Event Triggered Execution: Windows Management Instrumentation Event Subscription"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon FileCreate) populating target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers or vendor agents that stage MOF files in temp or ProgramData paths, hardware or monitoring agents registering WMI providers, and administrators authoring MOF files for legitimate WMI work."
    tuning_guidance = "Add approved deployment or RMM binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Add known service accounts that compile MOF files to %global_allowed_service_accounts. If installer noise is high, extend the process-name exclusion regex."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.mof$/ nocase
    (
      $file.target.file.full_path = /\\wbem\\mof\\/ nocase or
      $file.target.file.full_path = /\\users\\[^\\]+\\(appdata|downloads|desktop|documents)\\/ nocase or
      $file.target.file.full_path = /\\(temp|programdata|users\\public|windows\\temp)\\/ nocase
    )
    not $file.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|msiexec|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $mof_paths = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    $file
}
