/*
  MITRE Technique : T1203 - Exploitation for Client Execution
  Tactic(s)       : Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:56:05.197733+00:00
  Reference       : https://attack.mitre.org/techniques/T1203
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1203_Linux_ClientApp_Child_Outbound_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Network-side detection of post-exploitation behaviour: a shell, script interpreter or network utility whose parent is a client application (browser, office suite, PDF viewer, mail client) opens an outbound connection to a non-internal address. Client applications do not normally spawn network-capable interpreters. When they do, it usually indicates a successful exploit that has delivered a reverse shell or downloader."
    mitre_tactic = "Execution"
    mitre_technique = "T1203"
    mitre_technique_name = "Exploitation for Client Execution"
    log_prerequisites = "Requires Linux EDR or auditd network telemetry (connect syscalls) normalised to NETWORK_CONNECTION, with principal process and parent process paths populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Browser or mail client helper scripts that launch curl/wget or python (for example, desktop integration handlers, native messaging hosts), office suite macros or extensions that run approved scripts, developer workstations that launch tooling from a browser, and IT automation launched from a client application."
    tuning_guidance = "Add approved interpreter or helper binaries to %global_allowed_admin_tools, add approved parent processes or hosts to %global_allowed_script_hosts, and add known-good destination domains to %global_allowed_domains. Review the parent process path in the alert to decide whether to tune by parent or by child."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.parent_process.file.full_path = /\/(firefox|firefox-bin|chrome|chromium|chromium-browser|google-chrome|brave|soffice|soffice\.bin|libreoffice|evince|okular|atril|xreader|zathura|thunderbird)$/ nocase
    $net.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|python[0-9.]*|perl|ruby|php|nc|ncat|netcat|socat|curl|wget)$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.parent_process.file.full_path in %global_allowed_script_hosts
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1203")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $child_process = array_distinct($net.principal.process.file.full_path)
    $parent_process = array_distinct($net.principal.process.parent_process.file.full_path)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
