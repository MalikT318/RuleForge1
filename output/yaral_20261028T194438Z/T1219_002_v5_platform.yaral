/*
  MITRE Technique : T1219.002 - Remote Desktop Software
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:09:07.464429+00:00
  Reference       : https://attack.mitre.org/techniques/T1219/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1219_002_Linux_VNC_X11_Perimeter_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a perimeter TCP connection from an internal host to an external address on ports used by remote-desktop protocols native to Linux desktops and servers: VNC/RFB (5900-5909), reverse-VNC viewer listener (5500) and X11 display forwarding (6000-6009). Firewall logs cannot identify the host OS or initiating process, so the rule targets the protocols Linux uses for graphical remote control (x11vnc, TigerVNC, tightvnc, remote X11) as observed at the network perimeter. It complements existing process-creation detections by catching tools that were renamed, run from unusual paths or are not visible to endpoint agents."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1219.002"
    mitre_technique_name = "Remote Access Software: Remote Desktop Software"
    log_prerequisites = "Requires firewall, proxy or perimeter flow logs that record outbound TCP connections with source address, destination address and destination port, normalised to UDM NETWORK_CONNECTION. Egress traffic must be logged, including allowed connections."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Approved vendor support sessions over VNC, remote X11 use by engineering or lab staff, cloud-hosted VDI or remote lab environments reached over VNC, other applications that legitimately use ports 5500 or 6000-6009, and authorised penetration tests."
    tuning_guidance = "Add approved source addresses (jump hosts, support workstations) to %global_allowed_mgmt_sources and authorised testing sources to %global_allowed_scanners. If the tenant sees noise on a specific port such as 5500, remove that port range from the rule for that tenant. Consider raising severity where the source is a server subnet, since Linux servers rarely need outbound remote-desktop traffic."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "TCP"
    (
      ($net.target.port >= 5900 and $net.target.port <= 5909) or
      ($net.target.port >= 6000 and $net.target.port <= 6009) or
      $net.target.port = 5500
    )
    $net.principal.ip in %rfc1918_internal
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1219.002")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
