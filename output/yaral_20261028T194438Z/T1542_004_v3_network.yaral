/*
  MITRE Technique : T1542.004 - ROMMONkit
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:48:43.481987+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_004_ROMMON_External_TFTP_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects TFTP (UDP/69) connections crossing the network perimeter to a non-internal destination. ROMMON images are commonly upgraded or replaced over TFTP, and an unauthorised ROMMON image gives an adversary persistence below the operating system. Legitimate TFTP is almost always confined to internal management networks, so an external TFTP session from a network device or management segment is a strong indicator of image staging or exfiltration of device firmware."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.004"
    mitre_technique_name = "Pre-OS Boot: ROMMONkit"
    log_prerequisites = "Firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with target.ip and target.port populated. Logging must include permitted and denied sessions for UDP/69 on the egress and ingress perimeter."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Vendor-assisted firmware upgrades from an external TFTP server, remote branch sites staging images from a central cloud-hosted TFTP service, lab or test networks, PXE or zero-touch provisioning that uses a cloud-hosted TFTP server, and misconfigured backup jobs for device configurations."
    tuning_guidance = "Add approved management or jump-host source addresses to %global_allowed_mgmt_sources. Confirm that %rfc1918_internal covers all internal space for the client. For clients with sanctioned external provisioning, scope the exclusion to the specific source addresses of the devices involved rather than disabling the rule. Correlate hits with device syslog for reload, boot-variable or ROMMON upgrade events."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    $net.principal.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1542.004")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $source_hosts = array_distinct($net.principal.hostname)

  condition:
    $net
}
