/*
  MITRE Technique : T1556.002 - Password Filter DLL
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:16:35.425823+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_002_Unexpected_Parent_Spawns_LSA_Notification_Package_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects an unexpected parent process (Office application, web server, print spooler or database service) spawning a shell, script interpreter or registry utility whose command line references the LSA 'Notification Packages' value. That value controls which password filter DLLs the LSA loads, so changing it from this lineage strongly indicates a malicious password filter being registered to harvest plain-text credentials."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.002"
    mitre_technique_name = "Modify Authentication Process: Password Filter DLL"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry (EDR or Sysmon Event ID 1) with populated parent process path, child process path and command line. Run on domain controllers and servers where password filters are relevant."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate password-policy products (for example third-party password complexity or breached-password filters) installed by an IT deployment tool that is launched from an unusual parent; vendor installers spawned by a database service during a managed upgrade; authorized admin automation hosted in a web application."
    tuning_guidance = "Add approved deployment or installer parent binaries to %global_allowed_admin_tools and approved script-hosting parents to %global_allowed_script_hosts. Add EDR or AV agents to %global_allowed_security_tools if they spawn child processes that touch the LSA key. Extend or narrow the parent regex to match the server roles present in each client environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|spoolsv|w3wp|httpd|nginx|tomcat\d*|php-cgi|sqlservr|mysqld|postgres)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|reg|regedit|wmic|rundll32)\.exe$/ nocase
    $proc.target.process.command_line = /Notification\s*Packages/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1556.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
