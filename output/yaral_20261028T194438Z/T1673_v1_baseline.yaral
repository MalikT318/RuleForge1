/*
  MITRE Technique : T1673 - Virtual Machine Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:15:43.248090+00:00
  Reference       : https://attack.mitre.org/techniques/T1673
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1673_ESXi_VM_Discovery_CLI {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects enumeration of registered or running virtual machines on a hypervisor host through the built-in management CLIs (esxcli vm process list, vim-cmd vmsvc/getallvms). Ransomware operators and intruders typically run these commands first to pick targets for follow-on VM shutdown or encryption."
    mitre_tactic = "Discovery"
    mitre_technique = "T1673"
    mitre_technique_name = "Virtual Machine Discovery"
    log_prerequisites = "ESXi shell command auditing or process execution telemetry (shell.log / hostd) forwarded and parsed into UDM PROCESS_LAUNCH events with target.process.command_line populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Backup and replication agents that list VMs before snapshotting, monitoring and inventory scripts, patching and lifecycle tooling, and administrators troubleshooting from an SSH or DCUI shell."
    tuning_guidance = "Add approved backup, monitoring or automation parent processes to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Raise severity when the same host also shows SSH enablement or a first-time interactive login shortly before this activity."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(esxcli\b.*\bvm\s+process\s+list|vim-cmd\b.*\bvmsvc\/getallvms)/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1673")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
