/*
  MITRE Technique : T1195 - Supply Chain Compromise
  Tactic(s)       : Initial Access
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:39:00.682827+00:00
  Reference       : https://attack.mitre.org/techniques/T1195
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_Update_Package_Download_Then_Nonstandard_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A host downloads an update or installer style package (exe, msi, msp, dll, zip) over HTTP from an external site that is not a known-good domain. Within 10 minutes the same host opens a new outbound connection to a different external address on a non-standard high port. This pattern is consistent with a trojanised software update or distribution channel that delivers a payload, which then beacons to attacker infrastructure."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195"
    mitre_technique_name = "Supply Chain Compromise"
    log_prerequisites = "Requires firewall or proxy logs that populate NETWORK_HTTP (URL, method, target hostname) and NETWORK_CONNECTION (source IP, target IP, target port). Proxy-side URL visibility or TLS inspection is needed for the HTTP event."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate vendor updaters hosted on domains missing from the allowlist, software deployment or patching from external CDNs, and users installing approved software while other apps use high ports (VoIP, gaming, P2P, custom line-of-business apps)."
    tuning_guidance = "Add update, CDN and vendor domains to %global_allowed_domains. Review the high-port destination, and if it is an approved service, tighten the port condition. Add approved scanner or management source addresses to the exclusion lists as needed."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET"
    $http.target.url = /(update|upgrade|patch|setup|installer)[^\/]*\.(exe|msi|msp|dll|zip)(\?.*)?$/ nocase
    not $http.target.hostname in %global_allowed_domains
    $http.principal.ip = $src_ip

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port > 1024
    not $net.target.ip in %rfc1918_internal
    $net.target.ip != $http.target.ip
    $net.principal.ip = $src_ip

    $http.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1195")
    $primary_entity = array_distinct($src_ip)
    $download_urls = array_distinct($http.target.url)
    $download_hosts = array_distinct($http.target.hostname)
    $egress_ips = array_distinct($net.target.ip)
    $egress_ports = array_distinct($net.target.port)

  condition:
    $http and $net
}
