/*
  MITRE Technique : T1068 - Exploitation for Privilege Escalation
  Tactic(s)       : Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:54:03.208234+00:00
  Reference       : https://attack.mitre.org/techniques/T1068
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1068_Container_Service_Parent_Spawns_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing service or database daemon inside a container (web server, reverse proxy, PHP handler, database, cache) spawning a shell or script interpreter. Such daemons do not normally fork interactive shells. This lineage anomaly is a common result of exploiting the service or a kernel/runtime flaw to run attacker code, and is often a precursor to privilege escalation or container escape. The rule keys on parent-child process lineage and does not inspect command-line content."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1068"
    mitre_technique_name = "Exploitation for Privilege Escalation"
    log_prerequisites = "Requires in-container process telemetry (runtime security sensor or node-level EDR/auditd) that populates parent and child process paths for PROCESS_LAUNCH events."
    platform = "Containers"
    log_source = "container"
    false_positives = "Database maintenance hooks (PostgreSQL archive_command or restore_command, MySQL init scripts), entrypoint or wrapper scripts where the service binary is exec'd by a shell, legacy CGI or PHP applications that shell out, debug sessions in non-production containers, and approved admin tooling."
    tuning_guidance = "Add approved parent binaries to %global_allowed_script_hosts and approved shell wrappers to %global_allowed_admin_tools. Add known maintenance or build-pipeline hosts to %global_allowed_script_hosts. Narrow or extend the parent daemon list per client application stack."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|haproxy|php-fpm[0-9.]*|mysqld|mariadbd|postgres|mongod|redis-server|memcached)$/ nocase
    $proc.target.process.file.full_path = /\/(bash|dash|ash|sh|zsh|ksh|csh|tcsh|python[0-9.]*|perl)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.hostname in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1068")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
