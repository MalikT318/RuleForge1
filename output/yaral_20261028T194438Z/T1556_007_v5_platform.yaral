/*
  MITRE Technique : T1556.007 - Hybrid Identity
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:24:37.816934+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_007_Cloud_Federation_Trust_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of the federation or hybrid authentication configuration in a cloud identity control plane, such as updating a SAML identity provider or changing a domain's federation or authentication settings. Adversaries who backdoor hybrid identity do this to forge tokens or bypass authentication. Written for cloud audit telemetry, not endpoint process data."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.007"
    mitre_technique_name = "Modify Authentication Process: Hybrid Identity"
    log_prerequisites = "Requires cloud control-plane audit logs (IaaS audit trail and identity provider directory audit) ingested and normalised to UDM SETTING_MODIFICATION with metadata.product_event_type populated with the audit operation name."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Planned SAML signing-certificate rotation, scheduled federation metadata refresh, identity team onboarding or migrating a domain to or from federated authentication, and hybrid identity sync tooling maintained by approved administrators."
    tuning_guidance = "Add approved identity administrators to %global_allowed_admin_users and automation or sync principals to %global_allowed_cloud_principals. Correlate alerts with change tickets. If your pipeline maps provider creation operations to RESOURCE_CREATION, clone this rule with that event type and the same product_event_type pattern."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /(UpdateSAMLProvider|federation settings|set domain authentication|set federation|passthroughauthentication)/ nocase
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1556.007")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $operation = array_distinct($cloud.metadata.product_event_type)
    $target_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
