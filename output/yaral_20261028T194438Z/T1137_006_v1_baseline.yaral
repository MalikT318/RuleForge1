/*
  MITRE Technique : T1137.006 - Add-ins
  Tactic(s)       : Persistence
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:22:17.293155+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_006_Office_Addin_Registry_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry writes that register an Office add-in for automatic loading: COM/VSTO add-in keys under Office\\<app>\\Addins, or the Office Options OPEN value used to auto-load XLL/WLL add-ins. Any of these makes attacker code run each time the Office application starts."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.006"
    mitre_technique_name = "Office Application Startup: Add-ins"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events 12/13/14) populating target.registry.registry_key and target.registry.registry_value_name."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Office add-in installers (MSI or per-user installers for CRM, PDF, e-signature, Teams/Zoom meeting and DLP plugins), Office updates and repair, Office disabling a crashing add-in by rewriting LoadBehavior, and software deployment tooling pushing add-ins."
    tuning_guidance = "Add deployment and packaging tooling to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. In environments that heavily use msiexec-installed add-ins, review the principal process and key name first and allowlist the approved installer process. Raise severity when the writing process is a script host, an Office application, or runs from a user-writable path."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      $reg.target.registry.registry_key = /\\software\\(wow6432node\\)?microsoft\\office\\([0-9]+\.[0-9]+\\)?(word|excel|powerpoint|outlook|access|visio|project|publisher)\\addins\\[^\\]+/ nocase
      or
      (
        $reg.target.registry.registry_key = /\\software\\(wow6432node\\)?microsoft\\office\\[0-9]+\.[0-9]+\\(word|excel|powerpoint|access|publisher)\\options$/ nocase
        and $reg.target.registry.registry_value_name = /^open[0-9]*$/ nocase
      )
    )
    not $reg.principal.process.file.full_path = /\\(OfficeClickToRun|OfficeC2RClient|IntegratedOffice)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1137.006")
    $primary_entity = array_distinct($reg.principal.hostname)
    $user = array_distinct($reg.principal.user.userid)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $writer_command_line = array_distinct($reg.principal.process.command_line)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $registry_value_data = array_distinct($reg.target.registry.registry_value_data)

  condition:
    $reg
}
