/*
  MITRE Technique : T1098.006 - Additional Container Cluster Roles
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:48:47.530343+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_006_K8s_ServiceAccount_Created_Then_RBAC_Binding {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects one Kubernetes identity creating a ServiceAccount and then creating a RoleBinding or ClusterRoleBinding within 10 minutes. This is a common persistence and privilege-escalation pattern, where an adversary creates an account and immediately grants it cluster roles. The rule uses control-plane audit events rather than in-container command lines."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.006"
    mitre_technique_name = "Account Manipulation: Additional Container Cluster Roles"
    log_prerequisites = "Requires Kubernetes API server audit logs at Metadata level or higher, ingested and normalised to UDM RESOURCE_CREATION events. The request URI must be populated in target.url and the caller identity in principal.user.userid. Audit policy must record create verbs on serviceaccounts and on rbac.authorization.k8s.io bindings."
    platform = "Containers"
    log_source = "container"
    false_positives = "GitOps controllers and CI/CD pipelines that deploy applications with their own ServiceAccount and RBAC. Helm or operator installs that create a ServiceAccount and binding together. Cluster bootstrap and onboarding automation. Platform engineers provisioning new namespaces or tenants."
    tuning_guidance = "Add deployment pipeline, operator and GitOps identities to %global_allowed_service_accounts. Add named platform administrators to %global_allowed_admin_users. Raise severity or add a cluster-admin filter if the audit log includes the request object and it is populated."

  events:
    $sa.metadata.event_type = "RESOURCE_CREATION"
    $sa.target.url = /\/api\/v1\/namespaces\/[^\/]+\/serviceaccounts(\?|$)/ nocase
    $sa.principal.user.userid = $user
    not $sa.principal.user.userid in %global_allowed_service_accounts
    not $sa.principal.user.userid in %global_allowed_admin_users

    $bind.metadata.event_type = "RESOURCE_CREATION"
    $bind.target.url = /\/apis\/rbac\.authorization\.k8s\.io\/v1\/(namespaces\/[^\/]+\/)?(clusterrolebindings|rolebindings)(\?|$)/ nocase
    $bind.principal.user.userid = $user
    not $bind.principal.user.userid in %global_allowed_service_accounts
    not $bind.principal.user.userid in %global_allowed_admin_users

    $sa.metadata.event_timestamp.seconds <= $bind.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1098.006")
    $primary_entity = array_distinct($user)
    $sa_requests = array_distinct($sa.target.url)
    $binding_requests = array_distinct($bind.target.url)
    $source_ips = array_distinct($bind.principal.ip)
    $binding_count = count($bind.metadata.id)

  condition:
    $sa and $bind
}
