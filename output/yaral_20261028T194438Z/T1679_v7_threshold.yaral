/*
  MITRE Technique : T1679 - Selective Exclusion
  Tactic(s)       : Stealth
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:27:57.284303+00:00
  Reference       : https://attack.mitre.org/techniques/T1679
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1679_Selective_Exclusion_Repeated_Extension_Exclusion_Args {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated process launches on a single host whose command lines pass exclusion-style switches (exclude, skip, ignore, whitelist) naming at least two of the executable-content extensions dll, exe and lnk. Ransomware and destructive payloads use this pattern to skip system-critical files so the host stays usable for the ransom note. A single such command line can be benign, but repeated launches within 10 minutes on one host indicate payload staging or iteration."
    mitre_tactic = "Stealth"
    mitre_technique = "T1679"
    mitre_technique_name = "Selective Exclusion"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with full command-line capture (EDR, Sysmon Event ID 1 or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup, archive and file-sync tools or scripts that exclude binaries (compression utilities, deployment packaging, build pipelines), admin scripts copying data while skipping executables, and DLP or data-migration jobs."
    tuning_guidance = "Add approved admin, backup and packaging tools to %global_allowed_admin_tools and %global_allowed_backup_processes (matched on parent or child process path). Add trusted security agents to %global_allowed_security_tools. Raise the #proc threshold for hosts running build or packaging workloads; lower it to 2 for high-value servers."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /[\s\/-](exclude|excl|skip|ignore|except|whitelist|exts?)[a-z_-]*[\s=:]+[^|&]{0,120}\b(dll|exe|lnk)\b/ nocase
    $proc.target.process.command_line = /(dll[^|&]{0,120}\b(exe|lnk)\b|exe[^|&]{0,120}\b(dll|lnk)\b|lnk[^|&]{0,120}\b(dll|exe)\b)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1679")
    $primary_entity = array_distinct($host)
    $event_count = count($proc.metadata.id)
    $users = array_distinct($proc.principal.user.userid)
    $launched_processes = array_distinct($proc.target.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
