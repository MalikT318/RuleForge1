/*
  MITRE Technique : T1525 - Implant Internal Image
  Tactic(s)       : Persistence
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:24:30.787345+00:00
  Reference       : https://attack.mitre.org/techniques/T1525
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1525_Cloud_Image_Creation_By_Unapproved_Principal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation, registration, import, copy or push of a machine or container image in the cloud control plane by a principal that is not an approved image-build or administrative identity. The rule works from the resulting control-plane resource-creation record, not from commands on any host. Adversaries who implant a backdoored image in an internal registry gain persistence whenever provisioning tooling pulls the latest image."
    mitre_tactic = "Persistence"
    mitre_technique = "T1525"
    mitre_technique_name = "Implant Internal Image"
    log_prerequisites = "Cloud control-plane audit logging must be enabled and ingested with management and write events, including compute image APIs and container registry push APIs. The audit log must populate metadata.product_event_type and principal.user.userid."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Image-baking pipelines (CI/CD, golden-image builders), scheduled backup or snapshot-to-image automation, disaster-recovery image copies between regions, platform teams publishing base images, container build systems pushing new tags on every release."
    tuning_guidance = "Add CI/CD, image-builder and backup automation identities to %global_allowed_service_accounts. Add named platform administrators to %global_allowed_admin_users. Add approved federated or service principals to %global_allowed_cloud_principals. For noisy tenants, raise severity only when the target resource is in a production project or account, and review pushes from principals with no prior image activity."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /^(CreateImage|RegisterImage|CopyImage|ImportImage|PutImage|CompleteLayerUpload|CreateImageVersion|(compute\.)?images\.insert|Microsoft\.Compute\/(images|galleries\/images\/versions)\/write)$/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1525")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_calls = array_distinct($cloud.metadata.product_event_type)
    $image_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
