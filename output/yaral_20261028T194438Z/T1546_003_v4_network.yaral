/*
  MITRE Technique : T1546.003 - Windows Management Instrumentation Event Subscription
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:04:32.636752+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_003_WMI_Consumer_Host_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the WMI event consumer host (scrcons.exe) or the WMI provider host (WmiPrvSe.exe) opening a network connection to a non-internal address. Malicious permanent WMI event subscriptions (ActiveScript or CommandLine consumers) run inside these host processes, and they rarely initiate outbound external connections in normal operation. This covers the network side of the technique, independent of process command-line rules."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.003"
    mitre_technique_name = "Event Triggered Execution: Windows Management Instrumentation Event Subscription"
    log_prerequisites = "Requires Windows endpoint network telemetry that records the initiating process path (EDR network events or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Third-party monitoring or inventory agents that use WMI providers and call out to cloud services; WMI-based management consoles that reach external endpoints; some security and EDR agents that use WMI consumers; Azure Arc or hybrid management tooling."
    tuning_guidance = "Add approved management or security tooling process paths to %global_allowed_admin_tools or %global_allowed_security_tools. Confirm %rfc1918_internal covers the client's internal ranges. Loopback and link-local addresses must be present in that list, or they will need to be excluded separately. Investigate any scrcons.exe hit as high fidelity, because that process only runs for WMI script and command-line consumers. For hits from WmiPrvSe.exe, review the WMI-Activity operational log and the subscription objects in the repository (root\\subscription)."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(scrcons|wmiprvse)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(
      if($net.principal.process.file.full_path = /\\scrcons\.exe$/ nocase, 90, 75)
    )
    $mitre_technique_id = array_distinct("T1546.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $wmi_host_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
