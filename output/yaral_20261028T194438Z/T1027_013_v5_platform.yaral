/*
  MITRE Technique : T1027.013 - Encrypted/Encoded File
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:59:41.567770+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_013_Certutil_Decoded_Executable_Written {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the file-creation result of certutil decoding content: the certificate utility writing an executable or script-type file to disk. Certutil normally writes certificate artifacts (.cer, .crt, .p7b, .crl), so an executable or script output indicates Base64/hex-encoded content being decoded (T1140 following T1027.013). This rule keys on the FILE_CREATION event and not on process command lines, so it complements existing command-line rules. Note: the requested alternate-platform angle conflicts with the mandatory Windows platform and log_source, so this rule gives additive Windows coverage through file telemetry."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.013"
    mitre_technique_name = "Obfuscated Files or Information: Encrypted/Encoded File"
    log_prerequisites = "Requires Windows EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 equivalent) that populates the creating process path in principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare admin scripts using certutil to decode or export installers, PKI or certificate-enrolment tooling that exports signed binaries, and software packaging pipelines that Base64-wrap installers."
    tuning_guidance = "Add approved service or automation accounts to %global_allowed_service_accounts. Review the dropped_files and dropped_paths outcome values to confirm that the output is an unexpected executable or script. If a legitimate deployment workflow uses certutil to decode packages, scope the exclusion by account and not by path."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\certutil\.exe$/ nocase
    $file.target.file.full_path = /\.(exe|dll|scr|sys|msi|ps1|psm1|vbs|vbe|js|jse|wsf|hta|bat|cmd)$/ nocase
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1027.013")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_files = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
