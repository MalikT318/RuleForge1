/*
  MITRE Technique : T1499.003 - Application Exhaustion Flood
  Tactic(s)       : Impact
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:21:05.018924+00:00
  Reference       : https://attack.mitre.org/techniques/T1499/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1499_003_HTTP_Resource_Intensive_Request_Abuse {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP request from an external client that abuses a resource-intensive application feature: an extreme page-size or result-count parameter (five or more digits), or a search parameter consisting only of wildcard characters. Requests like these force the server to build very large result sets and are a common application-exhaustion DoS primitive. This is the network-side view, so it is independent of endpoint process telemetry."
    mitre_tactic = "Impact"
    mitre_technique = "T1499.003"
    mitre_technique_name = "Endpoint Denial of Service: Application Exhaustion Flood"
    log_prerequisites = "Requires firewall, proxy or web gateway logs normalised to NETWORK_HTTP with target.url and principal.ip populated. TLS inspection or reverse-proxy logging is needed for URLs to be visible on encrypted traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate bulk export or reporting APIs, search-engine crawlers, partner integrations that page with large limits, and authorised load or performance testing from external sources."
    tuning_guidance = "Add authorised testing and partner source addresses to %global_allowed_scanners. Adjust the digit threshold in the page-size regex (currently 5 or more digits) to suit applications with legitimately large page sizes. Correlate repeated hits from the same source in SOAR, or promote this to a Threshold rule if the firewall log volume allows."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url != ""
    (
      $net.target.url = /[?&](limit|page_?size|per_?page|rows|count|max|take|top|size|results)=[0-9]{5,}/ nocase or
      $net.target.url = /[?&](q|query|search|s|keyword|term)=((%2a|\*)+)(&|$)/ nocase
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1499.003")
    $primary_entity = array_distinct($net.target.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $target_urls = array_distinct($net.target.url)

  condition:
    $net
}
