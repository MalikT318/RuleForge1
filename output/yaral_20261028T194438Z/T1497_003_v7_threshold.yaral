/*
  MITRE Technique : T1497.003 - Time Based Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:07:25.477175+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_003_Repeated_Time_Check_Commands {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated time-based environment checks on a single Windows host within ten minutes: clock and uptime queries, tick-count lookups, and sleep or delay commands launched through built-in interpreters and utilities. One such command is benign, but a burst of them suggests malware or a loader measuring elapsed time to detect sandbox time acceleration or a virtualised analysis environment."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1497.003"
    mitre_technique_name = "Virtualization/Sandbox Evasion: Time Based Checks"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with full command lines (EDR, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Login or logon scripts that wait with timeout or ping delays, software installers and deployment wrappers that poll the clock, RMM and inventory agents that collect uptime and boot time, build or CI scripts that use Start-Sleep loops, and admins troubleshooting time sync with w32tm."
    tuning_guidance = "Add approved automation parents to %global_allowed_admin_tools or %global_allowed_script_hosts, and add service accounts that run scheduled maintenance scripts to %global_allowed_service_accounts. Raise the #proc threshold for noisy environments. Review the $commands outcome to refine the regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd|wmic|ping|timeout|w32tm|net|net1|systeminfo|cscript|wscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(get-date|start-sleep|\[environment\]::tickcount|gettickcount|getsystemtimeasfiletime|lastbootuptime|localdatetime|w32tm\s+\/(stripchart|query|tz)|ping(\.exe)?\s+(-n|\/n)\s+\d{2,}|timeout(\.exe)?\s+\/t\s+\d+|net\s+statistics\s+(workstation|server)|systeminfo.*boot|wscript\.sleep|sleep\s+-(s|m|seconds|milliseconds))/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1497.003")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 5
}
