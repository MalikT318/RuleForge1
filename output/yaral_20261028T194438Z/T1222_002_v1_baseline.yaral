/*
  MITRE Technique : T1222.002 - Linux and Mac Permissions
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:20:08.398482+00:00
  Reference       : https://attack.mitre.org/techniques/T1222/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_002_Linux_Dangerous_Permission_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects chmod/chown executions that apply a dangerous permission change: setuid/setgid on files in user-writable or staging locations, world-writable modes on authentication and privilege configuration files, or ownership changes to shadow, sudoers or ld.so.preload. These changes are used to enable privilege escalation, persistence and tampering with access controls."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1222.002"
    mitre_technique_name = "File and Directory Permissions Modification: Linux and Mac File and Directory Permissions Modification"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to PROCESS_LAUNCH with full command lines."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management and deployment tooling (Ansible, Puppet, Chef, package post-install scripts), administrators hardening or repairing permissions, developers testing setuid binaries in home directories, container build processes."
    tuning_guidance = "Add approved configuration management and deployment binaries to %global_allowed_admin_tools, named administrators to %global_allowed_admin_users, and automation accounts to %global_allowed_service_accounts. Extend or narrow the staging-directory and sensitive-file path alternations per client environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(chmod|chown)$/ nocase
    (
      $proc.target.process.command_line = /chmod\s+(-\S+\s+)*(0?[2467][0-7]{3}|[ugoa]*[+=][rwxXt]*s[rwxXt]*)\s+(\S+\s+)*\S*\/(tmp|dev\/shm|var\/tmp|home|root|run\/user)\// nocase or
      $proc.target.process.command_line = /chmod\s+(-\S+\s+)*([0-7]{2,3}[2367]|(a|[ug]*o[ug]*)?[+=][rwxXst]*w[rwxXst]*)\s+(\S+\s+)*\S*(\/etc\/(passwd|shadow|gshadow|sudoers|ld\.so\.preload|crontab|cron\.[a-z]+|pam\.d|ssh\/sshd_config)|\/\.ssh\/)/ nocase or
      $proc.target.process.command_line = /chown\s+(-\S+\s+)*\S+\s+(\S+\s+)*\S*\/etc\/(shadow|gshadow|sudoers|ld\.so\.preload)/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1222.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
