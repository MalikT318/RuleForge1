/*
  MITRE Technique : T1071.001 - Web Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:03:57.187297+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_001_Proxy_Scripted_Client_Post_To_External_IP_Literal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects HTTP POST requests to an external host addressed by raw IP literal (no DNS name) from a scripting or library HTTP client, as seen in firewall or proxy logs. This pattern is characteristic of web-protocol C2 beaconing from Windows hosts, where implants and scripts post data straight to infrastructure without a domain."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.001"
    mitre_technique_name = "Application Layer Protocol: Web Protocols"
    log_prerequisites = "Requires firewall or proxy logs normalised to NETWORK_HTTP with target.url, network.http.method and network.http.user_agent populated. TLS inspection is required to see these fields for HTTPS traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Internal tooling or vendor agents that post telemetry to a fixed public IP, developer or admin scripts calling APIs by IP, IoT or appliance check-ins, and monitoring or licensing agents."
    tuning_guidance = "Add known-good external destination hostnames to %global_allowed_domains. Add approved scanner sources to %global_allowed_scanners and approved management sources to %global_allowed_mgmt_sources. Confirm %rfc1918_internal covers the client's internal ranges. Extend the user-agent regex per client if needed."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.url = /^(https?:\/\/)?\d{1,3}(\.\d{1,3}){3}(:\d{1,5})?(\/|$)/ nocase
    $net.network.http.user_agent = /(WindowsPowerShell|PowerShell|WinHttpRequest|python-requests|python-urllib|curl\/|Go-http-client|Java\/|libwww-perl)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1071.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
