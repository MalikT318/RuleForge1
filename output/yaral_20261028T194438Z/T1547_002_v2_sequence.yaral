/*
  MITRE Technique : T1547.002 - Authentication Package
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:25:12.304206+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_002_Dropped_DLL_Then_LSA_Auth_Package_Registered {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A new DLL is written to System32 and, within ten minutes on the same host, the LSA 'Authentication Packages' registry value is modified. This sequence is consistent with an adversary staging a malicious authentication package DLL and registering it for load by LSASS at boot."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.002"
    mitre_technique_name = "Boot or Logon Autostart Execution: Authentication Package"
    log_prerequisites = "Requires Windows endpoint file-creation and registry-modification telemetry (EDR or Sysmon file and registry events) with the writing process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate installers of third-party credential providers or authentication products (smart card, MFA, SSO or password-filter agents), OS servicing and feature installs, and IT software deployment tooling."
    tuning_guidance = "Add approved installer and deployment binaries to %global_allowed_admin_tools and EDR or security agent binaries to %global_allowed_security_tools. Review the file_paths and registry_data outcome values to confirm the registered package matches the dropped DLL. Both events are pre-filtered, so tune by extending the writer-process exclusions rather than widening the match."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\windows\\system32\\[^\\]+\.dll$/ nocase
    not $file.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|MsMpEng|wuauclt|musnotification|usoclient)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control\\Lsa$/ nocase
    $reg.target.registry.registry_value_name = /^Authentication Packages$/ nocase
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|MsMpEng)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1547.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $file_paths = array_distinct($file.target.file.full_path)
    $dll_writer_processes = array_distinct($file.principal.process.file.full_path)
    $registry_writer_processes = array_distinct($reg.principal.process.file.full_path)
    $registry_data = array_distinct($reg.target.registry.registry_value_data)
    $acting_users = array_distinct($reg.principal.user.userid)

  condition:
    $file and $reg
}
