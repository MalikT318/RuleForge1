/*
  MITRE Technique : T1546.008 - Accessibility Features
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:11:09.699889+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_008_Accessibility_Binary_File_Replacement {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a file write to a Windows accessibility binary (sticky keys, Utility Manager, On-Screen Keyboard, Narrator, Magnifier and similar) in System32 or SysWOW64 by a process other than the Windows servicing stack. Replacing these binaries with a shell or backdoor gives pre-logon SYSTEM access from the logon screen. This is file-integrity coverage that does not depend on command-line or registry (IFEO) matching. The Windows-only platform requirement took precedence over the 'alternate platform' angle because T1546.008 has no Linux, macOS or cloud equivalent."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.008"
    mitre_technique_name = "Event Triggered Execution: Accessibility Features"
    log_prerequisites = "Requires EDR file telemetry or Sysmon Event ID 11 (FileCreate) normalised to UDM FILE_CREATION with principal process and target file path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows servicing (cumulative updates, feature upgrades, DISM or SFC repair), OS imaging and golden-image build tasks, and approved IT tooling that restores system binaries."
    tuning_guidance = "Add approved deployment or patching tools to %global_allowed_admin_tools, and EDR or AV agents that touch System32 binaries to %global_allowed_security_tools. If a client's servicing process appears as a repeated false positive, extend the writer-process exclusion regex. Clone the rule for FILE_MODIFICATION if the client's EDR reports overwrites with that event type."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\windows\\(system32|syswow64)\\(sethc|utilman|osk|narrator|magnify|displayswitch|atbroker)\.exe$/ nocase
    not $file.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|setuphost|wuauclt|musnotificationux)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(88)
    $mitre_technique_id = array_distinct("T1546.008")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_binary = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
