/*
  MITRE Technique : T1003 - OS Credential Dumping
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:36:55.855899+00:00
  Reference       : https://attack.mitre.org/techniques/T1003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_Linux_Bulk_Proc_Memory_Reads_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects one Linux host reading the memory or memory-map pseudo-files (/proc/<pid>/mem, /proc/<pid>/maps) of many processes within ten minutes. A single read is routine, but sweeping across processes is the pattern of credential scrapers that search process memory for clear-text passwords, hashes, or tokens (for example in sshd, sudo, gnome-keyring, or browser processes)."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003"
    mitre_technique_name = "OS Credential Dumping"
    log_prerequisites = "Requires Linux endpoint telemetry (EDR file-access events or auditd watches on /proc) that normalises to UDM FILE_READ with principal.process.file.full_path and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Debuggers and tracers (gdb, strace, ltrace) run by administrators, EDR and runtime-security agents, memory profilers, JVM and language-runtime diagnostics, checkpoint/restore tooling, backup agents, and process-monitoring tools such as htop or ps-style collectors reading /proc/<pid>/maps."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools, backup and checkpoint tooling to %global_allowed_backup_processes, and sanctioned diagnostic tooling to %global_allowed_admin_tools. The threshold of 15 reads in 10 minutes is conservative; raise it for hosts running many profilers or lower it on hardened servers. Scope auditd or EDR file-read collection to /proc/*/mem and /proc/*/maps to limit volume."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /^\/proc\/[0-9]+\/(mem|maps)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1003")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $reading_processes = array_distinct($file.principal.process.file.full_path)
    $reading_users = array_distinct($file.principal.user.userid)
    $sample_targets = array_distinct($file.target.file.full_path)

  condition:
    #file >= 15
}
