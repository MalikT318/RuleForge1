/*
  MITRE Technique : T1133 - External Remote Services
  Tactic(s)       : Persistence, Initial Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:50:33.341403+00:00
  Reference       : https://attack.mitre.org/techniques/T1133
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1133_K8s_External_Pod_Exec_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single identity issues a burst of exec, attach or port-forward requests against pods through the container orchestration API from a non-internal source address within ten minutes. Each request is benign on its own, but repeated interactive access from outside the network indicates abuse of an exposed control plane or stolen credentials (T1133 in containerized environments)."
    mitre_tactic = "Persistence, Initial Access"
    mitre_technique = "T1133"
    mitre_technique_name = "External Remote Services"
    log_prerequisites = "Kubernetes or container-orchestration API audit logs at request level (at least Metadata audit level) with the request URI and client source IP normalized to UDM USER_RESOURCE_ACCESS events."
    platform = "Linux"
    log_source = "container"
    false_positives = "Engineers debugging workloads through a corporate VPN or NAT egress address that is not in the internal range list, CI/CD runners performing repeated exec steps, managed-service jump hosts, and GitOps or operator tooling."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, named cluster administrators to %global_allowed_admin_users, and VPN, bastion or NAT egress addresses to %global_allowed_mgmt_sources. Raise the #access threshold for clusters with heavy interactive use. Confirm that the audit pipeline populates target.url with the API request path."

  events:
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.target.url = /\/pods\/[^\/]+\/(exec|attach|portforward)/ nocase
    $access.principal.user.userid = $user
    not $access.principal.ip in %rfc1918_internal
    not $access.principal.ip in %global_allowed_mgmt_sources
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($access.metadata.id)
    $mitre_technique_id = array_distinct("T1133")
    $primary_entity = array_distinct($user)
    $source_ips = array_distinct($access.principal.ip)
    $target_urls = array_distinct($access.target.url)

  condition:
    #access >= 5
}
