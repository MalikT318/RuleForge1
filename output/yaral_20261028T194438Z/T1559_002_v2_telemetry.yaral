/*
  MITRE Technique : T1559.002 - Dynamic Data Exchange
  Tactic(s)       : Execution
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:54:01.990147+00:00
  Reference       : https://attack.mitre.org/techniques/T1559/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_002_Office_DDE_Registry_Enablement {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of the Microsoft Office security registry values that control Dynamic Data Exchange (AllowDDE, DisableDDEServerLaunch, DisableDDEServerLookup). Adversaries re-enable DDE in Word and Excel so that poisoned documents can execute commands without VBA macros. The rule works on the registry state change, so it still fires when command-line logging is evaded or the writing tool is renamed."
    mitre_tactic = "Execution"
    mitre_technique = "T1559.002"
    mitre_technique_name = "Inter-Process Communication: Dynamic Data Exchange"
    log_prerequisites = "Requires Windows registry telemetry (EDR registry events, or Sysmon Event IDs 12/13/14) normalised to UDM REGISTRY_MODIFICATION with target.registry.registry_key and registry_value_name populated, covering HKCU and HKLM Office hives."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy or MDM baselines that deliberately set the DDE values (including hardening that sets them to the secure state), Office deployment and configuration tooling, legacy line-of-business workflows that depend on DDE (older finance or ERP Excel integrations), and administrators testing Office hardening."
    tuning_guidance = "Add approved configuration and deployment binaries to %global_allowed_admin_tools, endpoint security agents to %global_allowed_security_tools, and named administrators to %global_allowed_admin_users. Review the $value_data outcome to separate hardening writes (secure state) from re-enablement, and suppress by host where a legacy DDE workflow is documented."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Software\\(Policies\\)?Microsoft\\Office\\[0-9.]+\\(Word|Excel|Outlook|OneNote|PowerPoint)\\Security/ nocase
    $reg.target.registry.registry_value_name = /^(AllowDDE|DisableDDEServerLaunch|DisableDDEServerLookup)$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1559.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $value_name = array_distinct($reg.target.registry.registry_value_name)
    $value_data = array_distinct($reg.target.registry.registry_value_data)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
