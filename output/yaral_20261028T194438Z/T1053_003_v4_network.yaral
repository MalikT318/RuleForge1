/*
  MITRE Technique : T1053.003 - Cron
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:14:50.846610+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_003_ESXi_Cron_Spawned_Process_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound connection to an external address from a process whose parent is the cron daemon on an ESXi host. ESXi has no legitimate need for cron-spawned jobs to reach the internet. Malicious crontab entries (for example in /var/spool/cron/crontabs/root) typically fetch payloads, beacon, or exfiltrate data. This is network-side coverage that complements endpoint command-line detections for cron persistence."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.003"
    mitre_technique_name = "Scheduled Task/Job: Cron"
    log_prerequisites = "ESXi host telemetry (shell, hostd, vmkernel) or an agent/network sensor that produces NETWORK_CONNECTION events with principal.process.parent_process populated. Without parent-process attribution on network events this rule will not evaluate."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Admin-authored cron jobs for NTP or time sync, scheduled configuration backups to remote storage, vendor or monitoring agents that phone home from cron, and scheduled log-forwarding or update-check scripts."
    tuning_guidance = "Add approved tooling binaries to %global_allowed_admin_tools and approved destinations such as backup, syslog, or management servers to %global_allowed_mgmt_sources. Add backup agents to %global_allowed_backup_processes. Add known-good external destinations to %global_allowed_domains."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.parent_process.file.full_path = /(^|\/)crond$/ nocase
    $net.principal.hostname != ""
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1053.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $child_process = array_distinct($net.principal.process.file.full_path)
    $child_command_line = array_distinct($net.principal.process.command_line)

  condition:
    $net
}
