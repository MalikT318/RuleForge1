/*
  MITRE Technique : T1567.001 - Exfiltration to Code Repository
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:55:05.539463+00:00
  Reference       : https://attack.mitre.org/techniques/T1567/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_001_Code_Repo_API_Upload_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an outbound HTTP write (POST/PUT/PATCH) carrying a sizeable payload to an external URL whose path matches the content-upload APIs of code hosting services (repository contents/blobs/commits, project repository files, snippets, gists). The rule keys on API path structure and upload volume, not on named domains, so self-hosted and lesser-known repository platforms are also covered. It provides network-side coverage of exfiltration to a code repository, additive to endpoint command-line detections."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567.001"
    mitre_technique_name = "Exfiltration Over Web Service: Exfiltration to Code Repository"
    log_prerequisites = "Requires proxy or firewall logs normalised to NETWORK_HTTP with network.http.method, target.url and network.sent_bytes populated. URL path visibility needs TLS inspection (SSL decryption) on the perimeter device; without it the rule cannot see API paths."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Developers and CI/CD systems legitimately pushing commits, files or gists through the code hosting API; build agents on Windows servers; DevOps automation; IT staff publishing scripts or documentation to repositories."
    tuning_guidance = "Add sanctioned code hosting domains (including the organisation's own enterprise instances) to %global_allowed_domains. Add build and automation accounts to %global_allowed_service_accounts. Raise or lower the network.sent_bytes threshold (50000) per client baseline. Prioritise alerts from non-developer hosts and users."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(POST|PUT|PATCH)$/ nocase
    $http.target.url = /\/repos\/[^\/]+\/[^\/]+\/(contents|git\/(blobs|trees|commits))(\/|\?|$)|\/api\/v[0-9]+\/projects\/[^\/]+\/repository\/(files|commits)|\/api\/v[0-9]+\/snippets|\/gists(\/|\?|$)|\/2\.0\/repositories\/[^\/]+\/[^\/]+\/(src|commits)/ nocase
    $http.network.sent_bytes > 50000
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1567.001")
    $primary_entity = array_distinct($http.principal.hostname)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_urls = array_distinct($http.target.url)
    $max_sent_bytes = max($http.network.sent_bytes)
    $users = array_distinct($http.principal.user.userid)

  condition:
    $http
}
