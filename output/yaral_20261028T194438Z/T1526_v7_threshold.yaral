/*
  MITRE Technique : T1526 - Cloud Service Discovery
  Tactic(s)       : Discovery
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:27:12.449216+00:00
  Reference       : https://attack.mitre.org/techniques/T1526
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1526_IdP_Rapid_Multi_Application_Access_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single identity authenticates to an unusually high number of distinct cloud applications or services within ten minutes. Each sign-in is benign on its own, but rapid breadth across many service targets is consistent with an adversary using a compromised identity or token to enumerate which cloud services are reachable (Cloud Service Discovery)."
    mitre_tactic = "Discovery"
    mitre_technique = "T1526"
    mitre_technique_name = "Cloud Service Discovery"
    log_prerequisites = "Requires identity provider sign-in / SSO audit logs normalised to UDM USER_LOGIN with principal.user.userid and target.application populated."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Users starting their workday via an SSO portal or dashboard that launches many apps, helpdesk or IT staff testing application access, automated service integrations or synthetic monitoring, onboarding and application-rollout testing, and browser session restores that re-authenticate to many apps."
    tuning_guidance = "Add service and automation accounts to %global_allowed_service_accounts, named administrators to %global_allowed_admin_users, and approved cloud service principals to %global_allowed_cloud_principals. Raise the #auth threshold for tenants with large SSO app catalogs. Review the distinct_applications outcome to see breadth; many distinct applications with unfamiliar user context deserves higher priority."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid = $user
    $auth.target.application != ""
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users
    not $auth.principal.user.userid in %global_allowed_cloud_principals

  match:
    $user over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1526")
    $primary_entity = array_distinct($user)
    $event_count = count($auth.metadata.id)
    $distinct_applications = array_distinct($auth.target.application)
    $source_ips = array_distinct($auth.principal.ip)

  condition:
    #auth >= 10
}
