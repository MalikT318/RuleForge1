/*
  MITRE Technique : T1059.004 - Unix Shell
  Tactic(s)       : Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:12:02.700998+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_004_Linux_Shell_Script_Download_Via_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux-style command-line HTTP client (curl or wget user agent) fetching a shell script (.sh or .bash) from an external destination, as seen in proxy or perimeter logs. This is the network-observable first stage of 'download and pipe to shell' delivery for Unix shell execution. It needs no endpoint process telemetry and complements command-line detections."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.004"
    mitre_technique_name = "Command and Scripting Interpreter: Unix Shell"
    log_prerequisites = "Requires proxy or firewall logs with URL inspection (HTTP or HTTPS decryption) that populate network.http.user_agent and target.url. Plain connection-only firewall logs cannot support this rule."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate bootstrap and installer scripts (package repositories, configuration management, container or cloud-init provisioning), developer workstations installing tooling, and vendor agent installers fetched with curl or wget."
    tuning_guidance = "Add known-good vendor and repository domains to %global_allowed_domains. Review the source hosts: servers that should not fetch scripts directly are the highest-fidelity hits. Raise severity for hosts in production server segments. Internal destinations are already excluded through %rfc1918_internal."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.network.http.user_agent = /^(curl|wget)\// nocase
    $http.target.url = /\.(sh|bash)([?#].*)?$/ nocase
    $http.principal.hostname != ""
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1059.004")
    $primary_entity = array_distinct($http.principal.hostname)
    $script_urls = array_distinct($http.target.url)
    $destination_hosts = array_distinct($http.target.hostname)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
