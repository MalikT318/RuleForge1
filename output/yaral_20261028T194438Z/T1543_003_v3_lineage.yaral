/*
  MITRE Technique : T1543.003 - Windows Service
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:55:56.779144+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_003_Unexpected_Parent_Spawns_Service_Install {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows service being created or reconfigured by a shell, script interpreter or sc.exe whose parent is an Office application, web server worker, print spooler, database engine or document reader. These parents should never administer services, so this lineage indicates exploitation or a malicious document or web shell establishing persistence or privilege escalation."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.003"
    mitre_technique_name = "Create or Modify System Process: Windows Service"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Database or web application installers and updaters that register helper services; Office or Acrobat add-in installers running elevated; print driver installers launched from the spooler; vendor patching run from a web or database service context."
    tuning_guidance = "Add approved installer or deployment parent processes to %global_allowed_admin_tools, approved script-hosting parents to %global_allowed_script_hosts, and automation accounts to %global_allowed_service_accounts. Adjust the parent regex to remove application families not present in the client environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|acrord32|acrobat|spoolsv|w3wp|httpd|nginx|php-cgi|tomcat[0-9]*|sqlservr|mysqld|postgres|oracle)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(sc|cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(\b(create|config)\b.*\bbinpath\b|\bnew-service\b|\bset-service\b|\bsc(\.exe)?\s+(\\\\\S+\s+)?(create|config)\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1543.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
