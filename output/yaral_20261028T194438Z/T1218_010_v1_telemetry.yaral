/*
  MITRE Technique : T1218.010 - Regsvr32
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:54:21.464156+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_010_Regsvr32_COM_Server_Registration_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects regsvr32.exe writing a COM server registration (InprocServer32/LocalServer32 under CLSID) either into a per-user registry hive or pointing to a user-writable path. This registry state change is the artifact of a DLL being registered by regsvr32 for proxy execution or COM-based persistence, and it fires regardless of how the command line was obfuscated or hidden."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.010"
    mitre_technique_name = "System Binary Proxy Execution: Regsvr32"
    log_prerequisites = "Requires Windows endpoint registry telemetry that records the writing process (EDR registry events or Sysmon Event ID 12/13) normalised to UDM REGISTRY_MODIFICATION with principal.process.file.full_path and target.registry.registry_key populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-user software installers and updaters that register COM components with regsvr32 (some Office add-ins, shell extensions, developer tools such as Visual Studio or COM-based SDKs), self-registering DLLs from software deployed under AppData or ProgramData, and developers registering locally built COM servers."
    tuning_guidance = "Add deployment and packaging service accounts to %global_allowed_service_accounts and named administrators who legitimately register COM servers to %global_allowed_admin_users. Review recurring hits for known per-user installers and exclude by the writing account. If registry_value_data is not populated by the client's EDR, the rule still alerts on per-user hive registrations."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.principal.process.file.full_path = /\\regsvr32\.exe$/ nocase
    $reg.target.registry.registry_key = /\\Classes\\CLSID\\\{[0-9a-f\-]+\}\\(InprocServer32|LocalServer32)/ nocase
    (
      $reg.target.registry.registry_key = /^(HKEY_CURRENT_USER|HKEY_USERS|HKU|HKCU)\\/ nocase or
      $reg.target.registry.registry_value_data = /\\(appdata|programdata|temp|tmp|downloads|users\\public|perflogs|windows\\tasks|windows\\debug)\\/ nocase
    )
    not $reg.principal.user.userid in %global_allowed_service_accounts
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.010")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registered_server = array_distinct($reg.target.registry.registry_value_data)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
