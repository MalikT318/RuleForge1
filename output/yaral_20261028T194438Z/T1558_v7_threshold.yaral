/*
  MITRE Technique : T1558 - Steal or Forge Kerberos Tickets
  Tactic(s)       : Credential Access
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:38:57.903746+00:00
  Reference       : https://attack.mitre.org/techniques/T1558
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_Linux_Kerberos_Ticket_Store_Access_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of process launches on one Linux host whose command lines touch Kerberos credential stores: credential cache files (krb5cc_*, KCM/SSSD ccache), keytab files, or the SSSD secrets database. Reading, copying or encoding these files is a common step in stealing tickets for Pass-the-Ticket. A single access is routine, but repeated access in a short window is not."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558"
    mitre_technique_name = "Steal or Forge Kerberos Tickets"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records with full command lines normalised to UDM PROCESS_LAUNCH."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Kerberos-integrated services (sshd with GSSAPI, SSSD, NFS/Samba, Apache mod_auth_kerb) and cron jobs that renew tickets with kinit -k; sysadmins troubleshooting keytabs or ticket caches; configuration management and RMM agents that audit or deploy keytabs; domain-join tooling."
    tuning_guidance = "Add approved admin and config-management binaries to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and security agents to %global_allowed_security_tools. Raise the threshold (#proc >= 5) on hosts that run many Kerberized batch jobs. Findings from the same host with an interactive, non-service user are higher priority."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(\/tmp\/krb5cc_|\/var\/run\/user\/[0-9]+\/krb5cc|\/run\/user\/[0-9]+\/krb5cc|\/var\/lib\/sss\/db\/ccache_|\/var\/lib\/sss\/secrets\/|\/etc\/krb5\.keytab|\.keytab\b|\bkrb5cc_[0-9a-z]+|\bKRB5CCNAME=)/ nocase
    not $proc.principal.process.file.full_path = /\/(sssd|sssd_kcm|krb5kdc|kadmind|sshd)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($proc.target.process.command_line = /\b(cat|cp|scp|base64|xxd|strings|nc|ncat|curl|wget|tar|zip|dd)\b/ nocase, 85, 65))
    $mitre_technique_id = array_distinct("T1558")
    $primary_entity = array_distinct($host)
    $event_count = count($proc.metadata.id)
    $users = array_distinct($proc.principal.user.userid)
    $commands = array_distinct($proc.target.process.command_line)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)

  condition:
    #proc >= 5
}
