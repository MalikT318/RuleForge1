/*
  MITRE Technique : T1003.006 - DCSync
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:46:49.631508+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_006_DCSync_RPC_Epmap_Then_Dynamic_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects the network pattern of DCSync (DRSUAPI replication) as seen by an east-west firewall. One source opens an RPC endpoint-mapper connection (TCP/135) to a destination, then opens a connection to a dynamic RPC port (49152-65535) on the same destination within 10 minutes. This is how a non-DC host reaches the DRSUAPI interface on a domain controller. A firewall cannot see the RPC interface UUID or the initiating process, so this is a lower-fidelity, network-only signal. It is meant to surface unexpected workstation-to-DC replication-capable RPC sessions for triage alongside endpoint and Security log detections."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.006"
    mitre_technique_name = "OS Credential Dumping: DCSync"
    log_prerequisites = "Requires internal or east-west firewall logs that record allowed connections between internal segments, including client-to-domain-controller traffic, normalised to NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Perimeter-only logging will not see this traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Domain-joined hosts doing normal RPC to a DC (Group Policy, Netlogon, SAM-R, DFS-R), AD replication between domain controllers, Azure AD Connect / identity sync servers, vulnerability scanners, AD management and monitoring tooling, and RMM platforms."
    tuning_guidance = "Add domain controllers, identity sync servers, and approved admin jump hosts to %global_allowed_mgmt_sources. Add authorised scanners to %global_allowed_scanners. Where the firewall can scope destinations, restrict the rule to destinations in the domain controller segment, and if possible exclude DC-to-DC sources. Raise severity when the source is a workstation or server-tier host that is not a DC."

  events:
    $epm.metadata.event_type = "NETWORK_CONNECTION"
    $epm.target.port = 135
    $epm.principal.ip = $src_ip
    $epm.target.ip = $dst_ip
    not $epm.principal.ip in %global_allowed_mgmt_sources
    not $epm.principal.ip in %global_allowed_scanners

    $rpc.metadata.event_type = "NETWORK_CONNECTION"
    $rpc.target.port >= 49152
    $rpc.target.port <= 65535
    $rpc.principal.ip = $src_ip
    $rpc.target.ip = $dst_ip
    not $rpc.principal.ip in %global_allowed_mgmt_sources
    not $rpc.principal.ip in %global_allowed_scanners

    $epm.metadata.event_timestamp.seconds <= $rpc.metadata.event_timestamp.seconds

  match:
    $src_ip, $dst_ip over 10m

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1003.006")
    $primary_entity = array_distinct($src_ip)
    $destination_ips = array_distinct($dst_ip)
    $dynamic_ports = array_distinct($rpc.target.port)
    $rpc_connection_count = count($rpc.metadata.id)

  condition:
    $epm and $rpc
}
