/*
  MITRE Technique : T1546 - Event Triggered Execution
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:59:16.162244+00:00
  Reference       : https://attack.mitre.org/techniques/T1546
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_Trigger_Host_Binary_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound connection to a non-internal address from a Windows binary that only makes network calls when an event-triggered execution mechanism has fired. The WMI script event consumer host (scrcons.exe) runs ActiveScript WMI event subscriptions (T1546.003). The accessibility and logon-screen binaries (sethc, utilman, osk, narrator, magnify, displayswitch, atbroker) are abused through debugger or replacement persistence (T1546.008). None of these normally initiates external network traffic, so a connection is the observable result of the trigger executing a payload, not the way it was installed."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546"
    mitre_technique_name = "Event Triggered Execution"
    log_prerequisites = "Requires EDR or Sysmon network connection telemetry (Sysmon Event ID 3 or equivalent) with the initiating process path populated, normalised to UDM NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Accessibility tools that launch an online help or update component. Narrator or Magnify with cloud-backed features (for example Narrator online voices). Legacy WMI script consumers used by monitoring or inventory products that report to an external SaaS console. Remote support tools that start accessibility utilities as part of a session."
    tuning_guidance = "Add approved WMI-based monitoring agents or support tooling to %global_allowed_admin_tools or %global_allowed_remote_mgmt. Add approved vendor tooling to %global_allowed_security_tools. If a client uses online Narrator features, consider removing narrator from the regex for that tenant, or exclude known vendor destinations by domain with %global_allowed_domains on a NETWORK_DNS variant. Make sure the %rfc1918_internal list covers the client's internal address space."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(scrcons|sethc|utilman|osk|narrator|magnify|displayswitch|atbroker)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1546")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $source_user = array_distinct($net.principal.user.userid)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
