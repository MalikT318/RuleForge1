/*
  MITRE Technique : T1497.001 - System Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:01:31.072178+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_001_Linux_VM_Check_Artifact_In_Staging_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a file in a world-writable staging directory (/tmp, /var/tmp, /dev/shm) whose name references virtualization or sandbox artifacts such as dmi, hypervisor, vbox, vmware, qemu, kvm or sandbox. This is the file-system residue of a script or implant caching virtual machine environment check results (for example DMI/SMBIOS or CPU hypervisor flag output) before deciding whether to continue. The rule works at the file artifact layer, so it is independent of command-line logging."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1497.001"
    mitre_technique_name = "Virtualization/Sandbox Evasion: System Checks"
    log_prerequisites = "Linux endpoint telemetry (EDR or auditd with file watches on /tmp, /var/tmp and /dev/shm) that populates FILE_CREATION events with principal.process.file.full_path and target.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Hypervisor and guest tooling (libvirt, QEMU, open-vm-tools, VirtualBox guest additions) writing temporary files; cloud-init and provisioning scripts; configuration management and inventory/CMDB collectors; developers or QA engineers on virtualization hosts; package installs of virtualization software; sandbox and malware-analysis labs."
    tuning_guidance = "Add approved inventory, provisioning and virtualization management binaries to %global_allowed_admin_tools. Add approved build or automation parents to %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts. On virtualization hosts or malware analysis labs, consider scoping the rule out by host. Extend the process-name exclusion regex for client-specific guest agents."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/(.*[\/._-])?(dmi|dmidecode|hypervisor|virtualbox|vbox|vmware|vmw|qemu|kvm|sandbox|antivm|vmcheck|vmdetect|virt)([\/._-].*)?$/ nocase
    not $file.principal.process.file.full_path = /\/(libvirtd|virtqemud|virtlogd|qemu-[a-z0-9_-]+|vmtoolsd|vmware-[a-z0-9_-]+|VBoxService|VBoxClient|cloud-init|dpkg|apt|apt-get|rpm|dnf|yum|systemd|virt-manager|virsh)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1497.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
