/*
  MITRE Technique : T1574.001 - DLL
  Tactic(s)       : Stealth, Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:28:54.178564+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_001_DLL_Sideload_Host_UserWritable_Parent_Spawns_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, script interpreter or proxy-execution binary spawned by a parent executable running from a user-writable location (Temp, Downloads, Public, ProgramData, Roaming profile, Recycle Bin). This is the lineage pattern of DLL side-loading and search-order hijacking: a legitimate executable is staged next to a planted DLL outside its normal install directory, loads the DLL, and the payload then launches child processes under the trusted host. The rule keys on parent location and child type, not on any specific binary, DLL name or command line."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.001"
    mitre_technique_name = "Hijack Execution Flow: DLL"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry that populates both parent (principal.process) and child (target.process) image paths, from EDR, Sysmon Event ID 1 or Security Event 4688 with parent data."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and self-extracting packages run from Downloads or Temp that launch cmd or PowerShell; portable admin tools run from user folders; developer build tools and test harnesses; application updaters staging in ProgramData or Roaming that call script interpreters; legitimate vendor setup bootstrappers."
    tuning_guidance = "Add approved parent executable paths to %global_allowed_admin_tools, approved script-launching parents to %global_allowed_script_hosts, EDR/AV agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. If a software updater is noisy, exclude it by executable name in the parent path, not by install directory. Consider raising severity when the child is a shell and the parent is in Downloads or Recycle Bin."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Parent is an executable running from a user-writable staging location
    $proc.principal.process.file.full_path = /\\(users\\[^\\]+\\(appdata\\local\\temp|appdata\\roaming|downloads|desktop|music|pictures|videos)|users\\public|programdata|windows\\temp|\$recycle\.bin)\\.*\.exe$/ nocase

    // Child is a shell, script interpreter or proxy-execution binary
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32)\.exe$/ nocase

    // Parent is not itself a shell or script host (focus on non-interpreter hosts)
    not $proc.principal.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase

    // Exclude trusted security agents by executable name
    not $proc.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|SenseCnCProxy)\.exe$/ nocase

    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1574.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
