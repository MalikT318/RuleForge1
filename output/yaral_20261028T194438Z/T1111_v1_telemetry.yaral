/*
  MITRE Technique : T1111 - Multi-Factor Authentication Interception
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:10:14.272608+00:00
  Reference       : https://attack.mitre.org/techniques/T1111
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1111_Credential_Provider_Registration_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry write under the Windows Credential Providers or Credential Provider Filters keys by a process that is not an approved installer or security tool. Adversaries register a rogue credential provider, or a filter that hides legitimate providers, to capture smart card PINs, passwords and OTP or token input at the logon UI. This detects the persistent registry state change rather than the command line that produced it."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1111"
    mitre_technique_name = "Multi-Factor Authentication Interception"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events) normalised to REGISTRY_MODIFICATION with target.registry.registry_key populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate installation or upgrade of MFA or SSO products (smart card middleware, token vendors, password-manager or biometric logon providers), Windows feature updates and servicing, and software deployment tooling pushing logon agents."
    tuning_guidance = "Add approved deployment or installer binaries to %global_allowed_admin_tools and endpoint security agents to %global_allowed_security_tools. If the MFA vendor installs via msiexec, scope the exclusion to the deployment tool's parent process rather than excluding msiexec globally. Review hits on the Credential Provider Filters key first; legitimate changes there are rare."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Windows\\CurrentVersion\\Authentication\\Credential Provider(s|\s+Filters)\\/ nocase
    not $reg.principal.process.file.full_path = /\\(TiWorker|TrustedInstaller)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1111")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
