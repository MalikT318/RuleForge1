/*
  MITRE Technique : T1526 - Cloud Service Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:26:58.773356+00:00
  Reference       : https://attack.mitre.org/techniques/T1526
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1526_Login_Then_Cloud_Service_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "An identity authenticates and, within 10 minutes, makes multiple List/Describe/Get API calls against cloud service inventory (functions, audit trails, threat-detection services, clusters, storage, subscriptions). This sequence is typical of post-compromise cloud service discovery."
    mitre_tactic = "Discovery"
    mitre_technique = "T1526"
    mitre_technique_name = "Cloud Service Discovery"
    log_prerequisites = "Requires identity provider sign-in logs (USER_LOGIN) and cloud provider audit logs (USER_RESOURCE_ACCESS) with metadata.product_event_type populated with the API operation name, and a consistent principal.user.userid across both sources."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Cloud administrators and engineers onboarding to an account, infrastructure-as-code pipelines, cloud posture management and inventory tooling, FinOps and asset discovery scripts, newly provisioned automation identities."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, approved cloud service principals to %global_allowed_cloud_principals, and named administrators to %global_allowed_admin_users. Raise or lower the #cloud threshold in the condition to fit client baseline volume. Extend the operation-name regex with provider-specific read operations where the client's audit log format differs."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid != ""
    $auth.principal.user.userid = $user
    not $auth.principal.user.userid in %global_allowed_admin_users
    not $auth.principal.user.userid in %global_allowed_service_accounts

    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /(^|\.)(List|Describe|Get)(Functions|Trails|TrailStatus|Detectors|Clusters|Buckets|Services|Applications|Subscriptions|Stacks|Projects|ManagementGroups|ConfigurationRecorders|SecurityHubs|Pipelines|Topics|Queues|Instances|Hubs|Sinks)/ nocase
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts

    $auth.metadata.event_timestamp.seconds <= $cloud.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1526")
    $primary_entity = array_distinct($user)
    $discovery_api_calls = array_distinct($cloud.metadata.product_event_type)
    $discovery_call_count = count($cloud.metadata.id)
    $login_source_ips = array_distinct($auth.principal.ip)
    $api_source_ips = array_distinct($cloud.principal.ip)

  condition:
    $auth and #cloud >= 5
}
