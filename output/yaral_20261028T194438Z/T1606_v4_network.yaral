/*
  MITRE Technique : T1606 - Forge Web Credentials
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:22:00.168446+00:00
  Reference       : https://attack.mitre.org/techniques/T1606
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1606_SaaS_Federated_Token_Endpoint_NonBrowser_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external, non-browser HTTP client posting to a federation or token-issuance endpoint (SAML, WS-Federation, OAuth/OIDC token, SSO assertion consumer). Forged credential material, such as a forged SAML assertion or self-minted token, is presented this way by scripts and HTTP libraries rather than by interactive browsers. Internal address space is excluded via reference list."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1606"
    mitre_technique_name = "Forge Web Credentials"
    log_prerequisites = "Requires web proxy, WAF, reverse proxy or SaaS/identity front-door HTTP telemetry normalised to NETWORK_HTTP with network.http.method, network.http.user_agent, target.url and principal.ip populated."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Legitimate service integrations and automation using HTTP libraries for OAuth client-credentials or token refresh; SSO health monitors and synthetic transaction probes; sanctioned penetration tests; CI/CD pipelines and mobile app SDKs that use native HTTP stacks."
    tuning_guidance = "Add known integration accounts to %global_allowed_service_accounts, authorised scanner and testing sources to %global_allowed_scanners, and approved automation principals to %global_allowed_cloud_principals. Narrow the target.url regex to the tenant's federation paths if volume is high. Extend the user-agent regex with additional non-browser client signatures observed locally."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /\/(saml2?|wsfed|ws-fed|wstrust|sso|oauth2?|openid-connect|adfs\/ls)(\/|\?|$)|\/(token|assertion|acs)(\/|\?|$)/ nocase
    $http.network.http.user_agent = /(python-requests|python-urllib|aiohttp|curl\/|wget\/|go-http-client|okhttp|libwww-perl|java\/|apache-httpclient|node-fetch|axios|powershell|winhttp|ruby|httpie|postman)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.user.userid in %global_allowed_service_accounts
    not $http.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1606")
    $primary_entity = array_distinct($http.principal.ip)
    $target_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)
    $user_ids = array_distinct($http.principal.user.userid)

  condition:
    $http
}
