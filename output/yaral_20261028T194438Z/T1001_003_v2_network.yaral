/*
  MITRE Technique : T1001.003 - Protocol or Service Impersonation
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:09:49.709041+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_003_Cleartext_HTTP_On_TLS_Port_Linux_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects cleartext HTTP observed by an IDS/IPS on a TLS service port (443/8443) to an external destination, from clients whose user agent suggests a Linux host or command-line or scripting HTTP library. Malware that impersonates TLS or HTTPS to blend in with web traffic often produces this protocol/port mismatch, which the network sensor identifies through payload inspection."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001.003"
    mitre_technique_name = "Data Obfuscation: Protocol or Service Impersonation"
    log_prerequisites = "Requires IDS/IPS or network security appliance logs with protocol (application-layer) identification, normalised to NETWORK_HTTP with target.port, network.http.user_agent and target.ip populated. Do not run against decrypted proxy logs where TLS ports legitimately show HTTP."
    platform = "Linux"
    log_source = "ips"
    false_positives = "Misconfigured internal tools or load balancers that speak plaintext HTTP on 443/8443, vendor appliances with non-standard management APIs, security scanners and pentest traffic, and TLS-inspecting proxies that log decrypted HTTP on port 443."
    tuning_guidance = "Add authorised scanners to %global_allowed_scanners, trusted destination domains to %global_allowed_domains, and approved source addresses to %global_allowed_mgmt_sources. If the sensor decrypts TLS, scope the rule to non-inspected segments or disable it for that client."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.port = 443 or $http.target.port = 8443
    $http.network.http.user_agent = /(linux|x11|curl|wget|python|go-http|libwww|java|^$)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1001.003")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_ips = array_distinct($http.target.ip)
    $destination_ports = array_distinct($http.target.port)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
