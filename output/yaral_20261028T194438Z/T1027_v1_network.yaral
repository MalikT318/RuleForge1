/*
  MITRE Technique : T1027 - Obfuscated Files or Information
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Network Devices
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:35:51.264045+00:00
  Reference       : https://attack.mitre.org/techniques/T1027
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_Network_Encoded_Payload_In_HTTP_URL {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP request to an external destination whose URL carries a very long base64-style encoded blob, either as a query parameter value or as a path segment. This is a network-side indicator of obfuscated payloads, encoded staging data, or encoded tasking in transit. It is endpoint-independent and does not rely on process or command-line telemetry."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027"
    mitre_technique_name = "Obfuscated Files or Information"
    log_prerequisites = "IPS or network security appliance with HTTP/URL inspection (decrypted or cleartext HTTP) normalised to UDM NETWORK_HTTP with target.url populated."
    platform = "Network Devices"
    log_source = "ips"
    false_positives = "OAuth/SAML/SSO redirects carrying long tokens, analytics and advertising beacons with encoded parameters, cloud storage pre-signed URLs, software update checks, web apps that pass encoded state in the query string."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains. Add vulnerability scanners and sanctioned testing hosts to %global_allowed_scanners. Raise the {120,} / {150,} length thresholds if SSO or telemetry traffic is noisy. Populate %rfc1918_internal with the internal address space."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    (
      $net.target.url = /[?&][^=&#]{1,40}=[A-Za-z0-9+\/%_-]{120,}={0,3}(&|#|$)/ or
      $net.target.url = /\/[A-Za-z0-9+_-]{150,}={0,2}(\?|#|$)/
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1027")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $request_urls = array_distinct($net.target.url)

  condition:
    $net
}
