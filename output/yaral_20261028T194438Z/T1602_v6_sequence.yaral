/*
  MITRE Technique : T1602 - Data from Configuration Repository
  Tactic(s)       : Collection
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:17:21.435529+00:00
  Reference       : https://attack.mitre.org/techniques/T1602
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_SNMP_Poll_Then_Config_Transfer_Protocol {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects one external source connecting to the SNMP service of a device and then, within 10 minutes, connecting to the same device on a configuration-transfer service (TFTP or Smart Install). This pattern matches the collection of device configuration from a management repository, as seen in SNMP and Smart Install abuse."
    mitre_tactic = "Collection"
    mitre_technique = "T1602"
    mitre_technique_name = "Data from Configuration Repository"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. The firewall must log permitted traffic to management-plane services."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "External network monitoring or MSSP polling platforms that also push or pull configuration backups, unlisted vulnerability scanners, remote-site management over public WAN addresses, and zero-touch provisioning of newly deployed devices."
    tuning_guidance = "Add approved management and monitoring source addresses to %global_allowed_mgmt_sources and authorised scanners to %global_allowed_scanners. To cover insider activity, relax the %rfc1918_internal source exclusion and rely on the allowlists instead. Tune the 10m window to the client's polling cadence."

  events:
    $snmp.metadata.event_type = "NETWORK_CONNECTION"
    $snmp.target.port = 161
    not $snmp.principal.ip in %rfc1918_internal
    not $snmp.principal.ip in %global_allowed_mgmt_sources
    not $snmp.principal.ip in %global_allowed_scanners
    $snmp.principal.ip = $src_ip
    $snmp.target.ip = $dst_ip

    $cfg.metadata.event_type = "NETWORK_CONNECTION"
    ($cfg.target.port = 69 or $cfg.target.port = 4786)
    not $cfg.principal.ip in %rfc1918_internal
    not $cfg.principal.ip in %global_allowed_mgmt_sources
    not $cfg.principal.ip in %global_allowed_scanners
    $cfg.principal.ip = $src_ip
    $cfg.target.ip = $dst_ip

    $snmp.metadata.event_timestamp.seconds <= $cfg.metadata.event_timestamp.seconds

  match:
    $src_ip, $dst_ip over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1602")
    $primary_entity = array_distinct($dst_ip)
    $source_ips = array_distinct($src_ip)
    $config_ports = array_distinct($cfg.target.port)
    $snmp_event_count = count($snmp.metadata.id)
    $config_event_count = count($cfg.metadata.id)
    $first_seen = min($snmp.metadata.event_timestamp.seconds)
    $last_seen = max($cfg.metadata.event_timestamp.seconds)

  condition:
    $snmp and $cfg
}
