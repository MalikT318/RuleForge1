/*
  MITRE Technique : T1556.004 - Network Device Authentication
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:19:06.227231+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_004_External_Mgmt_Access_Then_Device_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A non-approved external source connects to a network device's management ports (SSH/Telnet), then the same device initiates an outbound file-transfer or remote-shell connection (FTP, SSH, Telnet, TFTP) to an external address within 10 minutes. This pattern is consistent with use of a hard-coded backdoor password on a patched device image, followed by configuration exfiltration or tool staging. It is detected from perimeter-observable behaviour and does not depend on the implanted password."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.004"
    mitre_technique_name = "Modify Authentication Process: Network Device Authentication"
    log_prerequisites = "Firewall or perimeter connection and flow logs that cover traffic to and from network device management interfaces, with source and destination IP and destination port populated. Devices must have static, identifiable IPs so inbound and outbound records share the same address."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Third-party managed-service providers or ISPs administering customer-edge devices from unlisted addresses; devices that back up configuration or firmware to external SFTP/FTP/TFTP servers shortly after an admin session; vendor support sessions; NAT or shared-address designs that cause unrelated hosts to share one IP."
    tuning_guidance = "Add approved administrative jump hosts and MSP source addresses to %global_allowed_mgmt_sources (this also suppresses approved egress destinations). Add known backup or update destinations to %global_allowed_domains. Narrow the destination port set if the environment has legitimate device-originated SFTP or FTP transfers. Lengthen or shorten the 10m window to match the client's change-window behaviour."

  events:
    $mgmt.metadata.event_type = "NETWORK_CONNECTION"
    ($mgmt.target.port = 22 or $mgmt.target.port = 23)
    not $mgmt.principal.ip in %rfc1918_internal
    not $mgmt.principal.ip in %global_allowed_mgmt_sources
    $mgmt.target.ip = $device_ip

    $egress.metadata.event_type = "NETWORK_CONNECTION"
    ($egress.target.port = 21 or $egress.target.port = 22 or $egress.target.port = 23 or $egress.target.port = 69)
    not $egress.target.ip in %rfc1918_internal
    not $egress.target.ip in %global_allowed_mgmt_sources
    not $egress.target.hostname in %global_allowed_domains
    $egress.principal.ip = $device_ip

    $mgmt.metadata.event_timestamp.seconds <= $egress.metadata.event_timestamp.seconds

  match:
    $device_ip over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1556.004")
    $primary_entity = array_distinct($device_ip)
    $source_ips = array_distinct($mgmt.principal.ip)
    $mgmt_ports = array_distinct($mgmt.target.port)
    $egress_destinations = array_distinct($egress.target.ip)
    $egress_ports = array_distinct($egress.target.port)
    $mgmt_event_count = count($mgmt.metadata.id)

  condition:
    $mgmt and $egress
}
