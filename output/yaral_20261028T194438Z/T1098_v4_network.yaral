/*
  MITRE Technique : T1098 - Account Manipulation
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:40:13.768137+00:00
  Reference       : https://attack.mitre.org/techniques/T1098
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_External_Source_To_Kerberos_Password_Change_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a connection from a non-internal source address to the Kerberos password change/set service (port 464) on a Windows domain controller. Legitimate password changes are made from internal or VPN-assigned clients. An external source reaching this port suggests an adversary changing or resetting credentials remotely to keep or elevate access to an account."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098"
    mitre_technique_name = "Account Manipulation"
    log_prerequisites = "Requires network connection telemetry (firewall, NDR or DC host network logs) for domain controllers, normalised to UDM NETWORK_CONNECTION with principal.ip, target.port and target.hostname populated. Correlates with identity provider directory audit data for the same tenant."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Domain controllers published to the internet for remote-user self-service password change, NAT or VPN egress addresses not listed in the internal address list, approved remote administration or pen-test sources, and cloud-hosted domain controllers in hybrid deployments."
    tuning_guidance = "Add approved VPN concentrator, NAT egress and bastion addresses to %global_allowed_mgmt_sources. Add authorised testing sources to %global_allowed_scanners. Confirm %rfc1918_internal covers all internal ranges used by the client. Raise severity if the source is later seen in successful identity sign-in events for the same account."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 464
    $net.principal.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1098")
    $primary_entity = array_distinct($net.target.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $target_ips = array_distinct($net.target.ip)

  condition:
    $net
}
