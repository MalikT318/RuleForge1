/*
  MITRE Technique : T1535 - Unused/Unsupported Cloud Regions
  Tactic(s)       : Stealth
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:34:06.587360+00:00
  Reference       : https://attack.mitre.org/techniques/T1535
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1535_Cloud_Region_Enablement_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a configuration change that enables or opts in a geographic cloud region for an account. Adversaries enable normally unused regions to deploy resources (for example cryptomining) where monitoring and detection services may be absent. This rule works at the account configuration layer, not on resource creation or command lines, so it fires before any workload is deployed."
    mitre_tactic = "Stealth"
    mitre_technique = "T1535"
    mitre_technique_name = "Unused/Unsupported Cloud Regions"
    log_prerequisites = "Cloud control-plane audit logs (management events) ingested and normalised to UDM SETTING_MODIFICATION, with metadata.product_event_type populated with the API action name."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Planned geographic expansion or compliance-driven regional onboarding; cloud centre-of-excellence or landing-zone automation enabling opt-in regions; infrastructure-as-code pipelines run by platform teams; new-account provisioning workflows."
    tuning_guidance = "Add approved platform administrators to %global_allowed_admin_users, and landing-zone or provisioning automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Change records for approved region launches should be correlated by the analyst. If the cloud provider uses a different action name for region enablement, extend the product_event_type regex."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /(enable|opt.?in).{0,12}region/ nocase
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1535")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $source_ips = array_distinct($cloud.principal.ip)
    $api_action = array_distinct($cloud.metadata.product_event_type)
    $region = array_distinct($cloud.target.location.name)

  condition:
    $cloud
}
