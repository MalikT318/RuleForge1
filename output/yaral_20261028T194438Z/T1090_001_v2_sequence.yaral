/*
  MITRE Technique : T1090.001 - Internal Proxy
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:26:43.046262+00:00
  Reference       : https://attack.mitre.org/techniques/T1090/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1090_001_Internal_Relay_Inbound_Then_Outbound {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the network pattern of an internal proxy or relay. An internal host accepts a connection from another internal host on a typical proxy or peer-to-peer port (SOCKS, HTTP proxy, alternate proxy, SMB), then opens an outbound connection to an external address within 10 minutes. This is consistent with C2 traffic being relayed through a compromised internal system."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1090.001"
    mitre_technique_name = "Proxy: Internal Proxy"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs that record both internal east-west sessions and outbound sessions, with principal.ip and target.ip normalised in UDM. East-west traffic must traverse a logged enforcement point."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate forward proxies, web gateways, SMB file servers that also reach out to cloud services, jump hosts and bastions, VPN concentrators, patch or software distribution relays, and cloud-sync servers."
    tuning_guidance = "Add authorised scanners to %global_allowed_scanners. Add approved management and relay sources to %global_allowed_mgmt_sources and %global_allowed_remote_mgmt. Add known-good external destinations to %global_allowed_domains. Narrow or extend the inbound port list per customer. Consider limiting to non-server segments if the customer has many dual-homed servers."

  events:
    $in.metadata.event_type = "NETWORK_CONNECTION"
    (
      $in.target.port = 1080 or
      $in.target.port = 3128 or
      $in.target.port = 8080 or
      $in.target.port = 8888 or
      $in.target.port = 9050 or
      $in.target.port = 445
    )
    $in.principal.ip in %rfc1918_internal
    $in.target.ip in %rfc1918_internal
    $in.principal.ip != $in.target.ip
    not $in.principal.ip in %global_allowed_scanners
    not $in.principal.ip in %global_allowed_mgmt_sources
    not $in.target.ip in %global_allowed_remote_mgmt
    $in.target.ip = $relay_ip

    $out.metadata.event_type = "NETWORK_CONNECTION"
    $out.principal.ip in %rfc1918_internal
    not $out.target.ip in %rfc1918_internal
    not $out.target.hostname in %global_allowed_domains
    $out.principal.ip = $relay_ip

    $in.metadata.event_timestamp.seconds <= $out.metadata.event_timestamp.seconds

  match:
    $relay_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1090.001")
    $primary_entity = array_distinct($relay_ip)
    $inbound_sources = array_distinct($in.principal.ip)
    $inbound_ports = array_distinct($in.target.port)
    $outbound_destinations = array_distinct($out.target.ip)
    $inbound_count = count($in.metadata.id)
    $outbound_count = count($out.metadata.id)

  condition:
    $in and $out
}
