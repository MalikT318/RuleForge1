/*
  MITRE Technique : T1205 - Traffic Signaling
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:07:46.389075+00:00
  Reference       : https://attack.mitre.org/techniques/T1205
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_Port_Knocking_Low_Volume_Multi_Port_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects the network-observable signature of port knocking. One external source makes a small, deliberate number of connection attempts to several distinct destination ports on a single internal host within two minutes. The count is deliberately capped, because a knock sequence is typically 3 to 8 ports, while a broad port scan touches far more. The rule evaluates one firewall connection event type and aggregates it per source and destination pair."
    mitre_tactic = "Stealth, Persistence, Command and Control"
    mitre_technique = "T1205"
    mitre_technique_name = "Traffic Signaling"
    log_prerequisites = "Perimeter firewall or proxy connection logs, including denied or dropped attempts, normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logging of dropped traffic must be enabled, since knock ports are normally closed."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Low-rate or slow vulnerability scanners not yet in the scanner list, external uptime or health monitors probing several service ports, legitimate clients retrying a multi-port application (VoIP, FTP passive, game servers), authorised port-knocking used by administrators for SSH access, and misconfigured clients retrying across ports."
    tuning_guidance = "Add known external scanning or monitoring sources to %global_allowed_scanners and approved administrator source addresses to %global_allowed_mgmt_sources. Raise or lower the distinct port bounds (currently 3 to 8) and the connection cap (currently 16) according to the client's baseline. Narrow the rule to protected internal segments by adding a target.ip CIDR check with net.ip_in_range_cidr(). Lengthen the match window to detect slow knock sequences, at the cost of more noise."

  events:
    $fw.metadata.event_type = "NETWORK_CONNECTION"
    $fw.principal.ip = $src_ip
    $fw.target.ip = $dst_ip
    $fw.target.port > 0
    not $fw.principal.ip in %rfc1918_internal
    $fw.target.ip in %rfc1918_internal
    not $fw.principal.ip in %global_allowed_scanners
    not $fw.principal.ip in %global_allowed_mgmt_sources

  match:
    $src_ip, $dst_ip over 2m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1205")
    $primary_entity = array_distinct($dst_ip)
    $source_address = array_distinct($src_ip)
    $distinct_ports = count_distinct($fw.target.port)
    $conn_count = count($fw.metadata.id)
    $probed_ports = array_distinct($fw.target.port)
    $first_seen = min($fw.metadata.event_timestamp.seconds)
    $last_seen = max($fw.metadata.event_timestamp.seconds)

  condition:
    $fw and $distinct_ports >= 3 and $distinct_ports <= 8 and $conn_count <= 16
}
