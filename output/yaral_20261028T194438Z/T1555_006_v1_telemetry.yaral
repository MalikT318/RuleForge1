/*
  MITRE Technique : T1555.006 - Cloud Secrets Management Stores
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:00:44.911827+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_006_Secret_Store_Permission_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a permission or access-policy change on a cloud secrets management store (secret resource policy, IAM policy on a secret, key vault access policy or role assignment scoped to a vault). Attackers with sufficient privileges grant themselves or another identity read access to secrets before retrieving credential material. This rule covers the resulting permission state change rather than the retrieval command line."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.006"
    mitre_technique_name = "Credentials from Password Stores: Cloud Secrets Management Stores"
    log_prerequisites = "Cloud control-plane audit logs ingested and parsed to UDM (resource policy / IAM policy / access policy change events normalised to RESOURCE_PERMISSIONS_CHANGE, with metadata.product_event_type and target.resource.name populated). Management-plane logging for the secrets service must be enabled."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Infrastructure-as-code pipelines and CI/CD service identities that manage secret policies, platform teams onboarding new applications or vaults, cloud governance/automation that applies baseline access policies, and planned secret-access reviews by administrators."
    tuning_guidance = "Add automation and pipeline identities to %global_allowed_cloud_principals and named administrators to %global_allowed_admin_users. If a client uses a naming convention that does not include 'secret' or 'vault' in resource names, extend the target.resource.name regex for that tenant. Consider raising severity when the principal is first seen modifying secret permissions."

  events:
    $perm.metadata.event_type = "RESOURCE_PERMISSIONS_CHANGE"
    $perm.metadata.product_event_type = /(PutResourcePolicy|SetIamPolicy|accessPolicies\/write|roleAssignments\/write)/ nocase
    $perm.target.resource.name = /(secret|vault)/ nocase
    $perm.principal.user.userid != ""
    not $perm.principal.user.userid in %global_allowed_cloud_principals
    not $perm.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1555.006")
    $primary_entity = array_distinct($perm.principal.user.userid)
    $api_actions = array_distinct($perm.metadata.product_event_type)
    $secret_resources = array_distinct($perm.target.resource.name)
    $source_ips = array_distinct($perm.principal.ip)

  condition:
    $perm
}
