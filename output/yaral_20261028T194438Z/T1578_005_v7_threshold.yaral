/*
  MITRE Technique : T1578.005 - Modify Cloud Compute Configurations
  Tactic(s)       : Defense Impairment
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:57:13.210619+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_005_Cloud_Compute_Config_Tampering_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single cloud identity performs several compute-affecting configuration changes within ten minutes: service quota or limit increases, region or location enablement, or tenant-wide compute policy modifications. Any one change is routine. A burst from one principal matches adversary preparation for resource hijacking, such as raising quotas, enabling unused regions and relaxing VM size or location policies to evade defenses."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578.005"
    mitre_technique_name = "Modify Cloud Compute Configurations"
    log_prerequisites = "Cloud control-plane audit logging (management/admin write events) must be enabled and normalized to UDM SETTING_MODIFICATION with metadata.product_event_type and principal.user.userid populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Planned capacity expansion or new-region onboarding by cloud platform teams, infrastructure-as-code pipelines applying quota or policy changes, landing-zone or governance automation, and FinOps/cost-management tooling adjusting limits."
    tuning_guidance = "Add automation and pipeline identities to %global_allowed_service_accounts, approved cloud administrators to %global_allowed_admin_users, and approved platform principals to %global_allowed_cloud_principals. Raise the #cfg threshold for tenants with frequent quota activity. Extend or narrow the product_event_type regex to match the client's audit event naming."

  events:
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.metadata.product_event_type = /(quota|servicelimit|increaselimit|enableregion|regionoptin|optinregion|allowedlocation|allowedregion|policyassignment|policydefinition|vmsize|computelimit)/ nocase
    $cfg.principal.user.userid != ""
    $cfg.principal.user.userid = $user
    not $cfg.principal.user.userid in %global_allowed_service_accounts
    not $cfg.principal.user.userid in %global_allowed_admin_users
    not $cfg.principal.user.userid in %global_allowed_cloud_principals

  match:
    $user over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($cfg.metadata.id)
    $mitre_technique_id = array_distinct("T1578.005")
    $primary_entity = array_distinct($user)
    $api_actions = array_distinct($cfg.metadata.product_event_type)
    $target_resources = array_distinct($cfg.target.resource.name)
    $source_ips = array_distinct($cfg.principal.ip)
    $first_seen = min($cfg.metadata.event_timestamp.seconds)
    $last_seen = max($cfg.metadata.event_timestamp.seconds)

  condition:
    #cfg >= 3
}
