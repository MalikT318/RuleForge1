/*
  MITRE Technique : T1016.002 - Wi-Fi Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:47:46.422458+00:00
  Reference       : https://attack.mitre.org/techniques/T1016/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_002_Netsh_WLAN_Profile_Export_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects netsh.exe writing an XML file to disk, which is the artefact of 'netsh wlan export profile' (with or without key=clear) dumping saved Wi-Fi profiles and, optionally, their plaintext keys. The rule is file-creation based and does not match command-line text, so it complements process-creation rules and still fires when the command line is obfuscated, truncated or not captured. Target platform is Windows; the rule keys on an effect of the netsh WLAN helper rather than on process arguments."
    mitre_tactic = "Discovery, Credential Access"
    mitre_technique = "T1016.002"
    mitre_technique_name = "System Network Configuration Discovery: Wi-Fi Discovery"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry with populated principal process path and target file path (EDR file-write events or Sysmon Event ID 11)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT or network administrators exporting WLAN or LAN profiles for migration or standardisation, RMM or deployment scripts that distribute Wi-Fi profiles, helpdesk troubleshooting of wireless connectivity, and golden-image build processes."
    tuning_guidance = "Add approved RMM and deployment tooling to %global_allowed_admin_tools (matched on the parent process path). Add named administrators to %global_allowed_admin_users. Add unattended automation accounts to %global_allowed_service_accounts. Raise severity when the host is a non-IT workstation or the export lands in a user-writable or temp directory. This rule needs file-write telemetry; if the EDR does not report file creation by netsh.exe, pair it with the existing command-line detection."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\netsh\.exe$/ nocase
    $file.target.file.full_path = /\.xml$/ nocase
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1016.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $user = array_distinct($file.principal.user.userid)
    $exported_file = array_distinct($file.target.file.full_path)

  condition:
    $file
}
