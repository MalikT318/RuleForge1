/*
  MITRE Technique : T1071.002 - File Transfer Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:06:15.581269+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_002_ESXi_Service_Parent_Spawns_Transfer_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi management or guest-hosting daemon (hostd, vpxa, rhttpproxy, vmx, sfcbd, openwsman, slpd and similar) spawning a file-transfer client such as wget, curl, scp, sftp, ftpget, ftpput, tftp or nc. These daemons never run transfer clients in normal operation. A child of this kind usually means the daemon was exploited, for example through a management-plane or SLP vulnerability or a VM escape, and the attacker is staging tools or running C2 over file-transfer protocols. Detection relies on process lineage only and does not match command lines."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.002"
    mitre_technique_name = "Application Layer Protocol: File Transfer Protocols"
    log_prerequisites = "ESXi shell/process execution logging forwarded to Chronicle and parsed to UDM PROCESS_LAUNCH with populated parent (principal.process.file.full_path) and child (target.process.file.full_path) paths."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Vendor or backup agents that run under a management daemon and download or upload files; host-profile or patch scripts launched by vpxa; approved monitoring plugins calling curl from sfcbd providers; admin troubleshooting under a daemon-spawned shell."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts, and approved automation accounts to %global_allowed_service_accounts. Add EDR or agent binaries to %global_allowed_security_tools. If the host fleet runs custom daemons, extend the parent regex for those services."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(hostd|hostd-worker|vpxa|fdm|rhttpproxy|vmx|vmx-[a-z0-9_-]+|sfcbd|sfcb-[a-z0-9_-]+|openwsmand|slpd|vobd|vmware-vmx|nfcd)$/ nocase
    $proc.target.process.file.full_path = /\/(wget|curl|scp|sftp|ftpget|ftpput|tftp|nc|netcat)$/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1071.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
