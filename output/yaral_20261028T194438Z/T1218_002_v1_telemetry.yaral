/*
  MITRE Technique : T1218.002 - Control Panel
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:43:21.585439+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_002_ControlPanel_CPL_Registry_Registration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry value being set under the Control Panel Cpls key (HKCU/HKLM, including per-user hives). Registering a CPL module there makes the payload load whenever control.exe or the Control Panel starts, so it can be used for persistence and proxy execution. The rule detects the registry state change rather than the control.exe command line."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.002"
    mitre_technique_name = "System Binary Proxy Execution: Control Panel"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon Event ID 12/13/14) normalised to UDM REGISTRY_MODIFICATION, with target.registry.registry_key populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Hardware vendor driver or utility installers (GPU, audio, printer, and OEM control panel applets), legitimate third-party software that registers its own CPL applet, and IT deployment or packaging tools."
    tuning_guidance = "Add approved installers and deployment binaries to %global_allowed_admin_tools. Add EDR or AV agents to %global_allowed_security_tools. Review principal.process.file.full_path and the registry value data. CPL files outside the Windows system directory, especially in user-writable locations, are high fidelity."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Microsoft\\Windows\\CurrentVersion\\Control Panel\\Cpls$/ nocase
    not $reg.target.registry.registry_value_data = /^(%systemroot%|[a-z]:\\windows)\\system32\\[^\\]+\.cpl$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1218.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $registry_value_data = array_distinct($reg.target.registry.registry_value_data)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
