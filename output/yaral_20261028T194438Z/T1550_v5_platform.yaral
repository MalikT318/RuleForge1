/*
  MITRE Technique : T1550 - Use Alternate Authentication Material
  Tactic(s)       : Lateral Movement
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:36:06.087684+00:00
  Reference       : https://attack.mitre.org/techniques/T1550
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1550_SaaS_Token_Replay_Risk_Signal_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a SaaS or identity provider sign-in event whose security result indicates replayed, stolen or anomalous authentication material (access token, refresh token, session cookie or primary refresh token) instead of a fresh credential and MFA challenge. This covers token-based lateral movement into cloud applications and does not depend on endpoint process telemetry."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1550"
    mitre_technique_name = "Use Alternate Authentication Material"
    log_prerequisites = "Requires identity provider or SaaS sign-in audit logs normalised to UDM USER_LOGIN. The risk or detection text must be populated in security_result.summary or security_result.description."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Users who roam between networks or VPN exit points with a long-lived session, legitimate automation using cached refresh tokens, browser or device re-registration, and conditional-access re-evaluation events labelled as token anomalies."
    tuning_guidance = "Add automation and integration accounts to %global_allowed_service_accounts and approved cloud or integration principals to %global_allowed_cloud_principals. If the identity provider labels risk events differently, extend the keyword regex rather than loosening the event type. Raise or lower $risk_score per client based on how reliable their token-risk signal is."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    (
      $auth.security_result.summary = /(replay(ed)?|stolen|anomalous|forged|hijack(ed)?|suspicious|unfamiliar|reuse[d]?)[\s_\-]*(access[\s_\-]*)?(token|cookie|session|refresh[\s_\-]*token|prt|ticket)|(token|cookie|session)[\s_\-]*(replay|theft|hijack|issuer[\s_\-]*anomaly|anomaly)|pass[\s_\-]*the[\s_\-]*(cookie|token)|attacker[\s_\-]*in[\s_\-]*the[\s_\-]*middle/ nocase or
      $auth.security_result.description = /(replay(ed)?|stolen|anomalous|forged|hijack(ed)?|suspicious|unfamiliar|reuse[d]?)[\s_\-]*(access[\s_\-]*)?(token|cookie|session|refresh[\s_\-]*token|prt|ticket)|(token|cookie|session)[\s_\-]*(replay|theft|hijack|issuer[\s_\-]*anomaly|anomaly)|pass[\s_\-]*the[\s_\-]*(cookie|token)|attacker[\s_\-]*in[\s_\-]*the[\s_\-]*middle/ nocase
    )
    $auth.principal.user.userid != ""
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1550")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $source_ips = array_distinct($auth.principal.ip)
    $target_apps = array_distinct($auth.target.application)
    $risk_summaries = array_distinct($auth.security_result.summary)

  condition:
    $auth
}
