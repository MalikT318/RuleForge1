/*
  MITRE Technique : T1092 - Communication Through Removable Media
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:36:48.766523+00:00
  Reference       : https://attack.mitre.org/techniques/T1092
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1092_Linux_Removable_Media_Exec_Then_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a process launched from removable media (executed directly from a /media or /run/media mount, or an interpreter running a script from one), followed within 10 minutes by a new file written to removable media on the same Linux host. This pattern is consistent with command and result relay over removable media between an air-gapped host and an Internet-connected host."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1092"
    mitre_technique_name = "Communication Through Removable Media"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to UDM PROCESS_LAUNCH and FILE_CREATION events, with full target paths and process command lines populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Users running installers or scripts from a USB stick and saving output to it; field engineers and technicians using portable toolkits; offline patching or provisioning from media; backup or imaging jobs not yet in the allowlist; desktop file managers copying files to a USB drive after a script run."
    tuning_guidance = "Add approved backup and imaging process paths to %global_allowed_backup_processes. Add approved provisioning or deployment tooling to %global_allowed_admin_tools. Add hosts or parent processes that legitimately run scripts to %global_allowed_script_hosts. Mount points under /mnt are deliberately excluded because they are commonly network or fixed mounts. If clients mount removable media there, extend the path regexes accordingly."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $proc.target.process.file.full_path = /^\/(run\/)?media\/[^\/]+\/.+/ nocase
      or
      (
        $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|python[0-9.]*|perl|ruby)$/ nocase
        and $proc.target.process.command_line = /\s\/(run\/)?media\/[^\/\s]+\/\S+/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    $proc.principal.hostname = $hostname

    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(run\/)?media\/[^\/]+\/.+/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1092")
    $primary_entity = array_distinct($hostname)
    $launched_processes = array_distinct($proc.target.process.file.full_path)
    $launch_command_lines = array_distinct($proc.target.process.command_line)
    $written_files = array_distinct($file.target.file.full_path)
    $writing_processes = array_distinct($file.principal.process.file.full_path)
    $acting_users = array_distinct($proc.principal.user.userid)

  condition:
    $proc and $file
}
