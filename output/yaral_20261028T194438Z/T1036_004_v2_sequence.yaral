/*
  MITRE Technique : T1036.004 - Masquerade Task or Service
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:02:37.836082+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_004_Linux_Masqueraded_Unit_Then_Temp_Exec {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a systemd unit file created with a name imitating a legitimate system service (systemd-*, dbus, NetworkManager, rsyslog, cron and similar) by a process that is not a package manager, followed within 10 minutes on the same host by systemd launching a binary from a world-writable or user-writable location such as /tmp, /var/tmp, /dev/shm, /run/user or a hidden home directory. The sequence indicates a persistence service dressed up as a trusted one."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.004"
    mitre_technique_name = "Masquerading: Masquerade Task or Service"
    log_prerequisites = "Requires Linux EDR or auditd telemetry normalised to UDM FILE_CREATION (with the creating process populated) and PROCESS_LAUNCH (with the parent process populated)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management (Ansible, Puppet, Chef, Salt) deploying custom units with system-style names; software installers that unpack to /tmp and run via systemd; self-extracting vendor agents; CI runners and build hosts; admins testing services from /tmp."
    tuning_guidance = "Add configuration-management and deployment binaries to %global_allowed_admin_tools (matched against the process creating the unit file and against the binary launched by systemd). Add expected EDR/AV agents to %global_allowed_security_tools. Extend the legitimate-name regex with names that are common in your estate, or narrow the temp-directory regex for build hosts."

  events:
    $unit.metadata.event_type = "FILE_CREATION"
    $unit.target.file.full_path = /^\/(etc|usr\/lib|lib|run)\/systemd\/(system|user)\/(systemd-[^\/]+|dbus[^\/]*|networkmanager[^\/]*|network|networking|cron|crond|anacron|rsyslog|syslog|sshd?|auditd|polkit[^\/]*|udev[^\/]*|snapd[^\/]*|apt-daily[^\/]*|accounts-daemon|irqbalance|getty[^\/]*|multipathd|cups[^\/]*|avahi-daemon|atd|chronyd?|ntpd?|firewalld|gdm|lightdm|packagekit|vmtoolsd|open-vm-tools)\.(service|timer)$/ nocase
    not $unit.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|yum|dnf|zypper|snapd|packagekitd|pacman|apk|unattended-upgrade|systemctl|systemd)$/ nocase
    not $unit.principal.process.file.full_path in %global_allowed_admin_tools
    not $unit.principal.process.file.full_path in %global_allowed_security_tools
    $unit.principal.hostname = $host

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/systemd$/ nocase
    $proc.target.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/user\/[^\/]+|home\/[^\/]+\/\.[^\/]+|root\/\.[^\/]+)\// nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $host

    $unit.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $host over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1036.004")
    $primary_entity = array_distinct($host)
    $unit_files = array_distinct($unit.target.file.full_path)
    $unit_creators = array_distinct($unit.principal.process.file.full_path)
    $launched_binaries = array_distinct($proc.target.process.file.full_path)
    $launch_count = count($proc.metadata.id)

  condition:
    $unit and $proc
}
