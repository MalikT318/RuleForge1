/*
  MITRE Technique : T1574.001 - DLL
  Tactic(s)       : Stealth, Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:29:12.662011+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_001_DLL_Sideload_Staged_Binary_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side indicator of DLL side-loading or hijacking. A process running from a world-writable or staging directory (ProgramData, Users\\Public, Temp, PerfLogs, Recycle Bin) opens an outbound connection to an external address on a web port. Side-loading attackers copy a trusted executable next to a malicious DLL in such a directory, and the hijacked process then beacons out. The rule keys on the execution location and the network behaviour, not on binary names, so it still fires if the host executable or DLL is renamed."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.001"
    mitre_technique_name = "Hijack Execution Flow: DLL"
    log_prerequisites = "Requires endpoint network telemetry that records the initiating process path (EDR network events or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-machine installers and updaters that run from ProgramData or Temp and phone home. Portable or self-extracting applications run from Temp. Collaboration and browser updaters that stage in ProgramData. Software-deployment and RMM agents staged in Temp. Developer build tools."
    tuning_guidance = "Add approved deployment and RMM binaries to %global_allowed_admin_tools and %global_allowed_remote_mgmt. Add EDR/AV agents to %global_allowed_security_tools. Add vendor update and CDN destinations to %global_allowed_domains. Keep %rfc1918_internal current. Pair with an endpoint module-load rule to confirm an unsigned DLL load in the same process."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(programdata|users\\public|windows\\temp|perflogs|\$recycle\.bin|users\\[^\\]+\\appdata\\local\\temp)\\.+\.exe$/ nocase
    $net.target.ip != ""
    (
      $net.target.port = 443 or
      $net.target.port = 80 or
      $net.target.port = 8080 or
      $net.target.port = 8443
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|MpCmdRun|NisSrv)\.exe$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1574.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
