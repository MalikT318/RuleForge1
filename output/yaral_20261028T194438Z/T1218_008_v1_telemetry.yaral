/*
  MITRE Technique : T1218.008 - Odbcconf
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:51:08.238369+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_008_Odbcconf_Registry_Driver_Or_COM_Registration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects odbcconf.exe writing to the registry locations that ODBC driver registration and COM DLL registration use (ODBCINST.INI driver entries, or CLSID InprocServer32/LocalServer32 entries). This is the state change left by odbcconf proxy-executing a DLL through REGSVR or by registering a rogue ODBC driver. It does not depend on command-line logging."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.008"
    mitre_technique_name = "System Binary Proxy Execution: Odbcconf"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon registry events) that populates the acting process path (principal.process.file.full_path) and target.registry.registry_key."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate database client or driver installers that call odbcconf.exe to register ODBC drivers or data sources, and IT packaging or deployment jobs that script odbcconf.exe."
    tuning_guidance = "Add approved deployment or installer parent processes to %global_allowed_admin_tools, and software-deployment service accounts to %global_allowed_service_accounts. Admin accounts can be added to %global_allowed_admin_users. If ODBC driver installs are common in an environment, narrow the key regex to CLSID InprocServer32 or LocalServer32 only. Copies of odbcconf.exe renamed by an attacker are not matched by the process-name filter. Pair this rule with a process-lineage rule to cover that gap."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.principal.process.file.full_path = /\\odbcconf\.exe$/ nocase
    $reg.target.registry.registry_key = /(\\ODBCINST\.INI\\|\\CLSID\\\{[^}]+\}\\(InprocServer32|LocalServer32))/ nocase
    not $reg.principal.process.parent_process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1218.008")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_value_names = array_distinct($reg.target.registry.registry_value_name)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
