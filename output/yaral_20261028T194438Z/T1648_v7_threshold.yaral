/*
  MITRE Technique : T1648 - Serverless Execution
  Tactic(s)       : Execution
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:50:34.769159+00:00
  Reference       : https://attack.mitre.org/techniques/T1648
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1648_SaaS_Mass_Automation_Flow_Changes {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single user created, edited, published or re-permissioned five or more serverless automation workflows (cloud flows or apps) within ten minutes. One workflow change is routine. A burst can mean an adversary with a compromised account is staging serverless execution, event-triggered persistence, or data-moving automations in the tenant."
    mitre_tactic = "Execution"
    mitre_technique = "T1648"
    mitre_technique_name = "Serverless Execution"
    log_prerequisites = "Unified audit logs for the workflow automation workload must be ingested and normalised to UDM, with the audit operation name populated in metadata.product_event_type and the actor in principal.user.userid."
    platform = "SaaS"
    log_source = "m365"
    false_positives = "Citizen developers building or iterating on flows, tenant migrations, solution deployments by approved automation service accounts, CI/CD pipelines publishing flows, and training sessions or hackathons."
    tuning_guidance = "Add expected automation service accounts to %global_allowed_service_accounts and platform or citizen-developer administrators to %global_allowed_admin_users. Raise the #flow threshold for tenants with heavy automation use. Review the flow names and operations in outcome before escalating."

  events:
    $flow.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"
    $flow.metadata.product_event_type = /^(CreateFlow|EditFlow|EditFlowPermission|PublishFlow|CreateApp|EditApp|PublishApp)$/ nocase
    $flow.principal.user.userid = $user
    not $flow.principal.user.userid in %global_allowed_service_accounts
    not $flow.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1648")
    $primary_entity = array_distinct($user)
    $event_count = count($flow.metadata.id)
    $operations = array_distinct($flow.metadata.product_event_type)
    $resource_names = array_distinct($flow.target.resource.name)
    $source_ips = array_distinct($flow.principal.ip)

  condition:
    #flow >= 5
}
