/*
  MITRE Technique : T1036.003 - Rename Legitimate Utilities
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:00:50.325770+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_003_Linux_Service_Parent_Spawns_Binary_From_Writable_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server or database service process spawning a child whose executable image sits in a world-writable staging directory (/tmp, /var/tmp, /dev/shm, /run/shm). Legitimate utilities such as shells, curl, wget, python and busybox are often copied and renamed into these directories to dodge name-based detections. Service daemons almost never execute binaries from these locations, so the detection pivots on the anomalous parent-child lineage and the child image location rather than on the child name or command line."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.003"
    mitre_technique_name = "Masquerading: Rename Legitimate Utilities"
    log_prerequisites = "Requires Linux EDR or auditd (execve) telemetry normalised to UDM PROCESS_LAUNCH with populated principal.process.file.full_path (parent) and target.process.file.full_path (child)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web applications or CMS plugins that legitimately unpack and run helper binaries from /tmp (image converters, PDF renderers); Java application servers running JNI or native helpers extracted to /tmp; database maintenance or backup scripts staged in /tmp; CI or deployment agents running as a service child."
    tuning_guidance = "Add approved parent daemons or wrappers to %global_allowed_script_hosts. Add approved helper binaries that run from temp directories to %global_allowed_admin_tools. Add known service accounts that legitimately run staged binaries to %global_allowed_service_accounts. If java or postgres are too noisy in a given tenant, scope them using the parent allowlist rather than editing the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|php-fpm[0-9.]*|lighttpd|caddy|tomcat[0-9]*|java|node|mysqld|mariadbd|postgres|mongod|redis-server|squid|cupsd)$/ nocase
    $proc.target.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/shm)\// nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1036.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
