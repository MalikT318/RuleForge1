/*
  MITRE Technique : T1529 - System Shutdown/Reboot
  Tactic(s)       : Impact
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:29:31.337167+00:00
  Reference       : https://attack.mitre.org/techniques/T1529
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1529_Inbound_Remote_Shutdown_Capable_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a connection from an external (non-internal) source to an internal Windows host on ports that carry remote shutdown/reboot capability: MSRPC (135), SMB named pipes (445, used by the winreg InitiateSystemShutdownEx path) and WinRM (5985/5986, used by Restart-Computer and Stop-Computer). Firewalls cannot see the shutdown command itself, so this is a low-fidelity network precursor signal to pair with endpoint shutdown telemetry. It is not proof of a shutdown."
    mitre_tactic = "Impact"
    mitre_technique = "T1529"
    mitre_technique_name = "System Shutdown/Reboot"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with populated principal.ip, target.ip and target.port, recorded at a boundary where external sources reach internal hosts (inbound allow, VPN or NAT-in)."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Authorised remote administration arriving via VPN concentrators or jump hosts, vulnerability scanners, partner or MSP management connectivity, cloud-hosted RMM or backup platforms that use SMB or WinRM, and internet-exposed file shares by design."
    tuning_guidance = "Add approved external management and scanner source addresses to %global_allowed_mgmt_sources. Ensure %rfc1918_internal covers all internal and VPN client pools so legitimate VPN-sourced traffic is not treated as external. Correlate hits with endpoint shutdown events (T1529 process-based rules) before escalating. Consider raising severity if the target host is a server or domain controller."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 135 or
      $net.target.port = 445 or
      $net.target.port = 5985 or
      $net.target.port = 5986
    )
    not $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1529")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
