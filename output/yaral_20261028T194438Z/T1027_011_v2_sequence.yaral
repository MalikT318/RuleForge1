/*
  MITRE Technique : T1027.011 - Fileless Storage
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:55:21.954821+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_011_Linux_Shm_File_Created_Then_Executed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A file is written to a RAM-backed fileless storage directory (/dev/shm, /run/shm, /var/run, /var/lock) and the same path is then executed as a process on the same host within five minutes. This staging-then-execute pattern is used by Linux malware to avoid disk artefacts and read-only filesystem protections. The rule matches on the file path join, not on command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.011"
    mitre_technique_name = "Obfuscated Files or Information: Fileless Storage"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that produces both file creation and process launch events with full file paths and hostnames."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers or installers that unpack helpers to /dev/shm or /run, HPC and MPI jobs, database or browser sandboxes using shared memory, container runtimes, and self-extracting or JIT-based software."
    tuning_guidance = "Add legitimate writer binaries to %global_allowed_admin_tools, trusted security agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Add approved parent interpreters to %global_allowed_script_hosts. If /var/run or /var/lock is noisy in a client environment, narrow the directory regex to /dev/shm and /run/shm."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(dev\/shm|run\/shm|var\/run|var\/lock)\// nocase
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $path
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /^\/(dev\/shm|run\/shm|var\/run|var\/lock)\// nocase
    $proc.principal.hostname = $hostname
    $proc.target.process.file.full_path = $path
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1027.011")
    $primary_entity = array_distinct($proc.principal.hostname)
    $executed_path = array_distinct($proc.target.process.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $users = array_distinct($proc.principal.user.userid)
    $launch_count = count($proc.metadata.id)

  condition:
    $file and $proc
}
