/*
  MITRE Technique : T1137 - Office Application Startup
  Tactic(s)       : Persistence
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:13:54.106635+00:00
  Reference       : https://attack.mitre.org/techniques/T1137
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_Office_Persistence_Registry_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Multiple registry modifications to Office persistence and security-control locations (add-ins, Outlook Today home page, Office test Perf DLL hook, startup template options, macro trust settings) on a single host within 10 minutes. One such write can be benign. A burst from a non-Office, non-approved process indicates Office Application Startup persistence being staged or macro defences being weakened."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137"
    mitre_technique_name = "Office Application Startup"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event IDs 12/13/14 or equivalent) normalised to REGISTRY_MODIFICATION with target.registry.registry_key populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office or third-party add-in installers and updaters (PDF, CRM, e-signature, telephony plug-ins), software deployment tools, Group Policy or MDM applying Office trust and macro policy, and IT staff configuring Office on a gold image."
    tuning_guidance = "Add deployment, packaging and patching binaries to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. Raise the #reg threshold on hosts where add-in installation is frequent, such as VDI image-build hosts. Review the outcome variable $modified_keys to identify noisy add-in vendors, then exclude the writer process by executable name."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Microsoft\\Office( test)?\\.*(\\Addins\\|\\Special\\Perf|\\Outlook\\Today|\\Security\\(AccessVBOM|VBAWarnings|Trusted Locations)|\\Options\\(GlobalDotName|Startup)|\\Outlook\\Security\\EnableUnsafeClientMailRules)/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path = /\\(OfficeClickToRun|OfficeC2RClient|integratedoffice)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(re.regex($reg.target.registry.registry_key, `(?i)\\Security\\(AccessVBOM|VBAWarnings|Trusted Locations)`), 85, 70))
    $event_count = count($reg.metadata.id)
    $mitre_technique_id = array_distinct("T1137")
    $primary_entity = array_distinct($host)
    $modified_keys = array_distinct($reg.target.registry.registry_key)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 3
}
