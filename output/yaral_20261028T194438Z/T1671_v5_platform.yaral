/*
  MITRE Technique : T1671 - Cloud Application Integration
  Tactic(s)       : Persistence
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:15:00.526875+00:00
  Reference       : https://attack.mitre.org/techniques/T1671
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1671_SaaS_OAuth_App_Consent_Or_Credential_Grant {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects SaaS audit events where an OAuth application is consented to, granted delegated permissions or app roles, or has new credentials or secrets added. Adversaries use these actions to keep API access to tenant data after the original account is disabled or its password is reset."
    mitre_tactic = "Persistence"
    mitre_technique = "T1671"
    mitre_technique_name = "Cloud Application Integration"
    log_prerequisites = "Requires unified audit logs from the tenant identity directory, ingested and parsed into UDM with metadata.product_event_type populated with the audit operation name."
    platform = "SaaS"
    log_source = "m365"
    false_positives = "Legitimate user or admin consent to approved business applications, onboarding of new SaaS integrations, scheduled secret or certificate rotation by application owners, and IT-managed deployment of line-of-business apps."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation or deployment identities to %global_allowed_service_accounts. If secret-rotation noise is high, remove the credential-related alternatives from the operation regex or exclude the owning service accounts. Confirm that the tenant's parser maps these operations to SETTING_MODIFICATION and adjust the event type if a client maps them differently."

  events:
    $saas.metadata.event_type = "SETTING_MODIFICATION"
    $saas.metadata.product_event_type = /^(consent to application|add delegated permission grant|add app role assignment (grant )?to (service principal|user)|add oauth2permissiongrant|add service principal credentials|update application\s*[-–]\s*certificates and secrets management)/ nocase
    $saas.principal.user.userid != ""
    not $saas.principal.user.userid in %global_allowed_admin_users
    not $saas.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1671")
    $primary_entity = array_distinct($saas.principal.user.userid)
    $operation = array_distinct($saas.metadata.product_event_type)
    $source_ip = array_distinct($saas.principal.ip)
    $target_app = array_distinct($saas.target.resource.name)

  condition:
    $saas
}
