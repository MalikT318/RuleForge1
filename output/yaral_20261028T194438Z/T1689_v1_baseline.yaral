/*
  MITRE Technique : T1689 - Downgrade Attack
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:36:44.396286+00:00
  Reference       : https://attack.mitre.org/techniques/T1689
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1689_PowerShell_Version2_Downgrade {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects powershell.exe launched with the -Version 2 switch (including abbreviated forms such as -v 2 or -ver 2.0). This forces the legacy engine, which lacks Script Block Logging, AMSI and Constrained Language Mode. It is the classic PowerShell downgrade attack used to run scripts without being logged or scanned."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1689"
    mitre_technique_name = "Downgrade Attack"
    log_prerequisites = "Requires EDR process telemetry, Sysmon Event ID 1 or Windows Event 4688 with command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy administrative or deployment scripts that deliberately target PowerShell 2.0 for compatibility, application compatibility testing, and software installers that probe for the v2 engine. Rare in modern estates."
    tuning_guidance = "Add approved legacy automation parents to %global_allowed_admin_tools or %global_allowed_script_hosts. Confirm whether the PowerShell 2.0 Windows feature is enabled on the host. If it is, disable it to remove the downgrade path. Review the parent process and user for any hit that is not allow-listed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\powershell(_ise)?\.exe$/ nocase
    $proc.target.process.command_line = /[\s][-\/\u2013](v|ve|ver|vers|versi|versio|version)[\s:]+["']?2(\.0)?["']?(\s|$)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1689")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
