/*
  MITRE Technique : T1095 - Non-Application Layer Protocol
  Tactic(s)       : Command and Control
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:38:58.704362+00:00
  Reference       : https://attack.mitre.org/techniques/T1095
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1095_Linux_Raw_Protocol_Tooling_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated launches on a single Linux host of built-in network utilities (ping, netcat variants, socat) with flag combinations that indicate non-application layer channels: ICMP echo with oversized or patterned payloads, UDP or raw-socket relays, and SOCKS tunnelling. A single invocation is usually benign. Five or more within ten minutes on one host suggests ICMP/UDP covert-channel or tunnelled C2 activity."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1095"
    mitre_technique_name = "Non-Application Layer Protocol"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to PROCESS_LAUNCH with full command lines."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Network engineers running MTU or path testing with ping -s; monitoring and health-check scripts using ping payload options; admins testing UDP services with nc -u; socat-based service wrappers or port forwards; configuration management run by approved tooling."
    tuning_guidance = "Add approved parent tooling to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and authorised testing sources to %global_allowed_scanners. Raise the #proc threshold on hosts that run frequent network diagnostics. Review $commands in the outcome to confirm the flags in use."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.hostname = $host
    (
      (
        $proc.target.process.file.full_path = /\/ping6?$/ nocase and
        $proc.target.process.command_line = /(\s-[a-z]*s\s*[0-9]{3,}\b|\s-p\s*[0-9a-f]{16,}\b|\s--size[=\s]+[0-9]{3,}\b|\s--pattern[=\s]+[0-9a-f]{16,}\b)/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\/(nc|ncat|netcat|nc\.openbsd|nc\.traditional)$/ nocase and
        $proc.target.process.command_line = /(\s-[a-z]*u[a-z]*\s|\s--udp\b|\s--proxy-type\s+socks[45]?\b)/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\/socat$/ nocase and
        $proc.target.process.command_line = /(\budp[46]?(-listen|-connect|-datagram|-recvfrom|-sendto)?:|\bsocks[45a]*\b|\bip-sendto\b|\bip[46]?-recv\b|\brawer\b|\bpacket(-|:)|\bsctp[46]?(-|:))/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path in %global_allowed_scanners

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1095")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $binaries = array_distinct($proc.target.process.file.full_path)
    $commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 5
}
