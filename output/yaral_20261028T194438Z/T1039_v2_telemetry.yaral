/*
  MITRE Technique : T1039 - Data from Network Shared Drive
  Tactic(s)       : Collection
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:24:51.187749+00:00
  Reference       : https://attack.mitre.org/techniques/T1039
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1039_Network_Share_Mapping_Registry_State_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects registry state changes created when a Windows user context connects to or maps a network share: persistent drive mapping keys (HKU\\<SID>\\Network\\<drive letter>) and UNC entries under Explorer\\MountPoints2. The change is written by a process other than Explorer, which points to scripted or command-driven share access rather than normal browsing. Adversaries use this access to find and collect data from network shared drives before exfiltration. The rule works at the registry layer, so it still fires if command-line logging is evaded or the tool is renamed."
    mitre_tactic = "Collection"
    mitre_technique = "T1039"
    mitre_technique_name = "Data from Network Shared Drive"
    log_prerequisites = "Requires Windows endpoint telemetry with registry value-set/key-create auditing (EDR or Sysmon registry events) that includes HKU user hive paths and the initiating process."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy or logon-script drive mappings, login scripts run by management agents, backup or file-sync clients mapping shares, IT staff mapping drives with net use or PowerShell, profile management software."
    tuning_guidance = "Add approved mapping tools and logon-script hosts to %global_allowed_admin_tools and %global_allowed_script_hosts. Add service identities to %global_allowed_service_accounts and named admins to %global_allowed_admin_users. If GPO drive mapping is noisy, add the process that applies it (for example the Group Policy client host) to %global_allowed_script_hosts. Raise severity when the same host or user also shows archive creation or large outbound transfers."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(\\Network\\[a-z]$|\\Explorer\\MountPoints2\\##)/ nocase
    not $reg.principal.process.file.full_path = /\\explorer\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_script_hosts
    not $reg.principal.user.userid in %global_allowed_service_accounts
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1039")
    $primary_entity = array_distinct($reg.principal.hostname)
    $user = array_distinct($reg.principal.user.userid)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $initiating_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
