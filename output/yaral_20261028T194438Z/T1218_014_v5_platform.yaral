/*
  MITRE Technique : T1218.014 - MMC
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:01:31.361951+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_014_MSC_File_Dropped_In_User_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a Microsoft Management Console (.msc) file in a user-writable location (user profile, temp, ProgramData, Public) by a process other than mmc.exe. Adversaries stage malicious .msc consoles this way before launching them through mmc.exe for proxy execution. This rule works on file-creation telemetry rather than process command lines. It is not a Linux, macOS or cloud rule, because MMC and .msc files exist only on Windows."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.014"
    mitre_technique_name = "System Binary Proxy Execution: MMC"
    log_prerequisites = "Requires endpoint file-creation telemetry with the creating process path populated (EDR file events or Sysmon Event ID 11)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators copying or exporting custom consoles with Explorer or file-sync tools, software installers that drop .msc snap-in consoles under ProgramData, and RMM or deployment agents distributing admin consoles."
    tuning_guidance = "Add approved deployment and RMM binaries to %global_allowed_admin_tools and endpoint security agents to %global_allowed_security_tools. If admins routinely save consoles under their profile, narrow the path regex or add their creating tools to the allowlist."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.msc$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|windows\\temp|programdata|users\\public)\\.*\.msc$/ nocase
    not $file.principal.process.file.full_path = /\\mmc\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1218.014")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_msc_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $creating_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
