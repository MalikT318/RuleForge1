/*
  MITRE Technique : T1059.004 - Unix Shell
  Tactic(s)       : Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:10:54.640783+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_004_ESXi_Shell_Access_Setting_Enabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change on an ESXi host that enables or loosens interactive Unix shell access: starting or enabling the ESXi Shell or SSH services (TSM, TSM-SSH), extending shell timeouts, or suppressing the shell-enabled warning. This detects the resulting setting state change rather than the shell commands run afterwards, so it still fires when command-line logging is evaded or the shell is BusyBox-based."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.004"
    mitre_technique_name = "Command and Scripting Interpreter: Unix Shell"
    log_prerequisites = "ESXi hostd and shell logs forwarded to Chronicle and parsed into UDM SETTING_MODIFICATION events, with the setting or service name in target.resource.name or metadata.description."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Approved administrators enabling SSH or the ESXi Shell for troubleshooting, patching or support sessions; host provisioning and automation that toggles shell services; vendor support engagements; lockdown-mode maintenance windows."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Add jump-host or management addresses to %global_allowed_mgmt_sources. Correlate with change tickets and maintenance windows. If the parser places the setting name in a different field, adjust the field references."

  events:
    $set.metadata.event_type = "SETTING_MODIFICATION"
    (
      $set.target.resource.name = /(^|[\.\s_-])(TSM(-SSH)?|ESXiShell(Interactive)?TimeOut|SuppressShellWarning|ESXi\s*Shell)($|[\.\s_-])/ nocase or
      $set.metadata.description = /(TSM-SSH|ESXiShell(Interactive)?TimeOut|SuppressShellWarning|ESXi\s*Shell\s+(has been\s+)?(enabled|started)|SSH\s+(access\s+)?(has been\s+)?(enabled|started))/ nocase
    )
    not $set.metadata.description = /(disabled|stopped|deactivated)/ nocase
    not $set.principal.user.userid in %global_allowed_admin_users
    not $set.principal.user.userid in %global_allowed_service_accounts
    not $set.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1059.004")
    $primary_entity = array_distinct(strings.coalesce($set.target.hostname, $set.principal.hostname))
    $acting_user = array_distinct($set.principal.user.userid)
    $setting_name = array_distinct($set.target.resource.name)
    $source_ips = array_distinct($set.principal.ip)

  condition:
    $set
}
