/*
  MITRE Technique : T1654 - Log Enumeration
  Tactic(s)       : Discovery
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:58:44.796505+00:00
  Reference       : https://attack.mitre.org/techniques/T1654
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1654_Linux_Log_Archive_Staged_In_Temp_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a compressed archive whose name references system or authentication logs (auth, secure, syslog, messages, wtmp, btmp, lastlog, audit, journal) inside a world-writable staging directory (/tmp, /var/tmp, /dev/shm). This is the file artifact left when an adversary bulk-collects logs for offline review or exfiltration, and it is detected at the file-creation layer, independent of command-line logging."
    mitre_tactic = "Discovery"
    mitre_technique = "T1654"
    mitre_technique_name = "Log Enumeration"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-creation events (for example, watches on /tmp, /var/tmp and /dev/shm) normalised to UDM FILE_CREATION with principal.process and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators or support staff bundling logs for a vendor ticket, sosreport or diagnostic collectors writing to /tmp, backup or log-shipping jobs staging archives, and troubleshooting scripts run by engineers."
    tuning_guidance = "Add approved log collection and diagnostic tooling to %global_allowed_admin_tools, backup jobs to %global_allowed_backup_processes, and automation accounts to %global_allowed_service_accounts. Add EDR and agent binaries to %global_allowed_security_tools. If the rule is noisy, narrow the keyword group in the file name regex."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.*(auth|secure|syslog|messages|wtmp|btmp|lastlog|audit|journal|var[-_]?log).*\.(tar|tgz|tar\.gz|gz|zip|bz2|xz|7z)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path = /\/(logrotate|rsyslogd|syslog-ng|journald|systemd-journald|auditd|sosreport|cron|anacron)$/ nocase

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1654")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_files = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $acting_users = array_distinct($file.principal.user.userid)

  condition:
    $file
}
