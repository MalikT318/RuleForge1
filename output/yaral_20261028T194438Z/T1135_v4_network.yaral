/*
  MITRE Technique : T1135 - Network Share Discovery
  Tactic(s)       : Discovery
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:04:29.183352+00:00
  Reference       : https://attack.mitre.org/techniques/T1135
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1135_Linux_Outbound_SMB_Share_Discovery_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux host opening an SMB/NetBIOS session (TCP 445 or 139) to a non-internal destination. Network-side view of share enumeration or mounting from a Linux endpoint, complementing command-line detections. Internal address space is excluded through a reference list, so the rule surfaces SMB leaving the environment, which is rarely legitimate and is typical of share discovery against exposed or attacker-controlled hosts."
    mitre_tactic = "Discovery"
    mitre_technique = "T1135"
    mitre_technique_name = "Network Share Discovery"
    log_prerequisites = "Requires Linux endpoint network connection telemetry (EDR or auditd socket/connect events) populating principal.hostname, target.ip, target.port and ideally principal.process.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Authorised external vulnerability or attack-surface scanners, hosts that legitimately mount cloud-hosted SMB file services, Samba servers or domain-joined hosts talking to cloud or remote-site domain controllers, approved administrator and remote support tooling."
    tuning_guidance = "Add scanner hosts to %global_allowed_scanners. Add approved admin or file-sync binaries to %global_allowed_admin_tools. Ensure %rfc1918_internal covers all internal and VPN-routed address space for each client. Hosts that legitimately use cloud SMB services should be exempted by hostname via %global_allowed_scanners or have the rule scoped per client."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 445 or $net.target.port = 139)
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_scanners
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path = /\/(smbd|nmbd|winbindd)$/ nocase

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1135")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_processes = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
