/*
  MITRE Technique : T1497.003 - Time Based Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:06:29.770710+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_003_Linux_NonTimeDaemon_NTP_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux process that is not a time-synchronisation daemon opening an outbound connection to an external host on port 123 (NTP). Malware uses direct NTP queries to obtain a trusted time source, then compares it with the local clock to spot sandboxes that accelerate or skew time. The rule matches processes running from world-writable staging directories (/tmp, /var/tmp, /dev/shm) or scripting interpreters and shells, rather than the standard time daemons."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1497.003"
    mitre_technique_name = "Virtualization/Sandbox Evasion: Time Based Checks"
    log_prerequisites = "Requires Linux endpoint network telemetry (EDR or auditd with connect syscall auditing) that populates principal.process.file.full_path, target.ip and target.port on NETWORK_CONNECTION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Admin or monitoring scripts (python, perl, bash) that check clock drift against external NTP servers; containers or appliances with a custom time-sync script; configuration-management or RMM tooling that validates time sync; developer test tooling."
    tuning_guidance = "Add approved time-check tooling to %global_allowed_admin_tools. Add known monitoring hosts to %global_allowed_scanners if scanners probe NTP. Extend %rfc1918_internal if internal NTP servers use non-RFC1918 space. Extend the time-daemon exclusion regex if the client uses a different native time agent."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 123
    $net.principal.process.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|.*\/(python[0-9.]*|perl|ruby|php|node|bash|sh|dash|zsh)$)/ nocase
    not $net.principal.process.file.full_path = /\/(chronyd|ntpd|ntpdate|sntp|ntpsec|openntpd|systemd-timesyncd|timesyncd)$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.target.ip in %rfc1918_internal

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1497.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $process_command_line = array_distinct($net.principal.process.command_line)
    $ntp_destination_ips = array_distinct($net.target.ip)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
