/*
  MITRE Technique : T1552.006 - Group Policy Preferences
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:54:48.780486+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_006_GPP_Credential_XML_File_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a non-standard process reading a Group Policy Preferences XML file that can embed cpassword credentials (Groups, Services, ScheduledTasks, DataSources, Printers, Drives) from SYSVOL or a local copy. This is file-access telemetry rather than process command-line matching, so it adds coverage for in-memory tooling (PowerShell, .NET, Python) that never spawns a distinctive child process. GPP is a Windows/Active Directory mechanism with no Linux, macOS or cloud equivalent, so this variant stays on Windows with a different telemetry source."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.006"
    mitre_technique_name = "Unsecured Credentials: Group Policy Preferences"
    log_prerequisites = "Requires endpoint file-read telemetry (EDR or Sysmon-equivalent file access events) that records SYSVOL UNC paths or local copies of Policies folders, or domain controller file-share auditing (Event 5145) normalised to FILE_READ."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy client processing run by an unlisted process, GPO backup and migration utilities, policy auditing and compliance tools, administrators using GPMC or editors on legitimate GPP files, and security scanners that audit for cpassword exposure."
    tuning_guidance = "Add approved GPO management, audit and backup binaries to %global_allowed_admin_tools, %global_allowed_backup_processes or %global_allowed_security_tools. Add approved scanning sources to %global_allowed_scanners. Add expected admin accounts to %global_allowed_admin_users. If the Group Policy client generates noise in your EDR, add its process name to the executable-name exclusion regex."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /\\policies\\\{[0-9a-f\-]{36}\}\\(machine|user)\\preferences\\(groups|services|scheduledtasks|datasources|printers|drives)\\(groups|services|scheduledtasks|datasources|printers|drives)\.xml$/ nocase
    not $file.principal.process.file.full_path = /\\(svchost|gpupdate|taskhostw|MsMpEng|MsSense|SenseIR|dfsrs|lsass)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1552.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $accessing_user = array_distinct($file.principal.user.userid)
    $accessing_process = array_distinct($file.principal.process.file.full_path)
    $gpp_file_path = array_distinct($file.target.file.full_path)

  condition:
    $file
}
