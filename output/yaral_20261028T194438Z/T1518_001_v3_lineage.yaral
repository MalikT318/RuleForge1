/*
  MITRE Technique : T1518.001 - Security Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:20:21.610523+00:00
  Reference       : https://attack.mitre.org/techniques/T1518/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_001_Linux_Service_Parent_Spawns_Security_Software_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux web server, application server, database, or print service process spawning a shell or script interpreter whose command line enumerates installed security software, such as EDR agents, auditd, SELinux/AppArmor, or antivirus. Server-side service processes do not normally run security tooling discovery, so this lineage often indicates web shell or post-exploitation activity."
    mitre_tactic = "Discovery"
    mitre_technique = "T1518.001"
    mitre_technique_name = "Software Discovery: Security Software Discovery"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve logging with parent and child process paths and full command lines populated in UDM."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Application health-check or deployment scripts run by a service account; monitoring agents launched from Java or Node services that check agent status; configuration management hooks run by a database or web service; admins using a web-based control panel that queries service status."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts, security or monitoring agents to %global_allowed_security_tools, and known administrative accounts to %global_allowed_admin_users. If java or node parents are noisy for a client, remove them from the parent regex for that tenant only."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9.]*|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|cupsd)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ksh|csh|tcsh|python[0-9.]*|perl|ruby|php[0-9.]*)$/ nocase
    $proc.target.process.command_line = /(ps\s|pgrep|pidof|systemctl|service\s|chkconfig|dpkg|rpm\s|apt\s|yum\s|which\s|command\s+-v|getenforce|sestatus|aa-status|auditctl|ls\s|find\s|locate\s|cat\s|grep)/ nocase
    $proc.target.process.command_line = /(auditd|audispd|osquery|falco|wazuh|ossec|clamd|clamav|freshclam|rkhunter|chkrootkit|aide|tripwire|sentinel|falcon|crowdstrike|carbonblack|cbagent|cbdaemon|sysmon|selinux|apparmor|fail2ban|splunkd|filebeat|auditbeat|elastic-agent|qualys|nessus|tanium|cylance|sophos|mdatp|defender|eset|trendmicro|ds_agent|cloudwatch-agent|google-osconfig|stackdriver)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1518.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
