/*
  MITRE Technique : T1499.002 - Service Exhaustion Flood
  Tactic(s)       : Impact
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:18:24.679005+00:00
  Reference       : https://attack.mitre.org/techniques/T1499/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1499_002_Cloud_Availability_Protection_Setting_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a configuration change (SETTING_MODIFICATION) to a cloud service-availability protection control: web application firewall policy, rate-limit or throttling rule, DDoS protection plan, or autoscaling group/policy capacity. Adversaries with control-plane access weaken these controls to make a service-exhaustion flood more effective, or to degrade capacity directly. This rule detects the control-plane state change rather than the flood traffic or any command line."
    mitre_tactic = "Impact"
    mitre_technique = "T1499.002"
    mitre_technique_name = "Endpoint Denial of Service: Service Exhaustion Flood"
    log_prerequisites = "Cloud control-plane audit logs (management or admin activity) ingested and normalised to UDM with metadata.product_event_type populated. Data-plane or request logs are not required."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Infrastructure-as-code pipelines and CI/CD deployment roles, planned WAF rule tuning by security engineering, autoscaling policy changes during capacity planning or cost optimisation, break-glass changes during an incident, managed cloud-posture automation."
    tuning_guidance = "Add pipeline and automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and approved change owners to %global_allowed_admin_users. Narrow the protection-keyword regex if a client's naming produces noise, or raise severity for production-tagged resources via downstream enrichment."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /(update|put|set|modify|disable|detach|disassociate|remove|write|patch)/ nocase
    $cloud.metadata.product_event_type = /(webacl|waf|firewallpolicies|securitypolicies|ratelimit|ratebased|throttl|ddos|autoscal|scalinggroup|scalingpolicy|desiredcapacity)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1499.002")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_actions = array_distinct($cloud.metadata.product_event_type)
    $affected_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
