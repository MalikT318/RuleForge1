/*
  MITRE Technique : T1218.013 - Mavinject
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:59:43.510364+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_013_Mavinject_Outbound_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound connection to a non-internal address initiated by the App-V injector (mavinject) process, identified by image name or by its injection switches (/INJECTRUNNING, /HMODULE) in the process command line. Mavinject is a local injection utility with no legitimate reason to talk to external hosts, so this indicates abuse for proxy execution, for example a payload staged over the network or a hijacked mavinject instance beaconing. This is network-side coverage that complements process-creation command-line rules."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.013"
    mitre_technique_name = "System Binary Proxy Execution: Mavinject"
    log_prerequisites = "Requires endpoint network telemetry (EDR or Sysmon Event ID 3) that populates the initiating process path and command line on NETWORK_CONNECTION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare. Possible sources are App-V or application-virtualization management tooling, software packaging and deployment agents, and security testing or red-team exercises that run mavinject deliberately."
    tuning_guidance = "Add approved packaging and deployment tooling to %global_allowed_admin_tools. Add authorised red-team or testing tooling to %global_allowed_security_tools. Maintain %rfc1918_internal to cover the client's internal address space."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.principal.process.file.full_path = /\\mavinject(32)?\.exe$/ nocase or
      $net.principal.process.command_line = /\bmavinject(32)?(\.exe)?\b.*\/(injectrunning|hmodule)/ nocase
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.013")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_command_line = array_distinct($net.principal.process.command_line)
    $initiating_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
