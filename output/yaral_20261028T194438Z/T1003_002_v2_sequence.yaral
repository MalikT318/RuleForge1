/*
  MITRE Technique : T1003.002 - Security Account Manager
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:39:06.091478+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_002_SAM_And_SYSTEM_Hive_Read_By_Same_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects one process reading both the SAM and SYSTEM registry hive files within ten minutes on the same host. The SYSTEM hive holds the boot key needed to decrypt SAM hashes, so reading both is the signature of offline local credential extraction. This includes copies taken from live config paths or from Volume Shadow Copy paths. The rule is based on file access telemetry rather than process command lines."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.002"
    mitre_technique_name = "OS Credential Dumping: Security Account Manager"
    log_prerequisites = "Requires endpoint file-read telemetry (EDR or Sysmon-equivalent file access auditing) that populates principal.process.file.full_path and target.file.full_path for reads of the Windows config hive files."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and imaging agents, endpoint security scanners, forensic or IR collection tooling, and system recovery utilities that read the hive files. Volume Shadow Copy based backup jobs are also possible."
    tuning_guidance = "Add backup and imaging binaries to %global_allowed_backup_processes. Add EDR/AV agents to %global_allowed_security_tools. Add approved IR or admin collection tooling to %global_allowed_admin_tools. The rule requires SAM to be read before SYSTEM; if the telemetry shows high-volume noise from a specific process, add that process to the lists rather than loosening the regexes."

  events:
    $sam.metadata.event_type = "FILE_READ"
    $sam.target.file.full_path = /\\windows\\system32\\config\\sam$/ nocase
    not $sam.principal.process.file.full_path in %global_allowed_backup_processes
    not $sam.principal.process.file.full_path in %global_allowed_security_tools
    not $sam.principal.process.file.full_path in %global_allowed_admin_tools
    not $sam.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|vssvc|TrustedInstaller)\.exe$/ nocase
    $sam.principal.hostname = $hostname
    $sam.principal.process.file.full_path = $proc_path

    $sys.metadata.event_type = "FILE_READ"
    $sys.target.file.full_path = /\\windows\\system32\\config\\system$/ nocase
    not $sys.principal.process.file.full_path in %global_allowed_backup_processes
    not $sys.principal.process.file.full_path in %global_allowed_security_tools
    not $sys.principal.process.file.full_path in %global_allowed_admin_tools
    not $sys.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|vssvc|TrustedInstaller)\.exe$/ nocase
    $sys.principal.hostname = $hostname
    $sys.principal.process.file.full_path = $proc_path

    $sam.metadata.event_timestamp.seconds <= $sys.metadata.event_timestamp.seconds

  match:
    $hostname, $proc_path over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1003.002")
    $primary_entity = array_distinct($hostname)
    $reading_process = array_distinct($proc_path)
    $reading_user = array_distinct($sam.principal.user.userid)
    $sam_paths = array_distinct($sam.target.file.full_path)
    $system_paths = array_distinct($sys.target.file.full_path)
    $read_event_count = count($sam.metadata.id)

  condition:
    $sam and $sys
}
