/*
  MITRE Technique : T1558.002 - Silver Ticket
  Tactic(s)       : Credential Access
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:43:10.956969+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_002_Kerberos_Network_Logon_Volume_Single_Account {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single non-machine account performs an unusually high number of Kerberos network logons within ten minutes. Forged service tickets (silver tickets) are replayed directly against target services without KDC interaction, so abuse tends to appear as bursts of service-ticket network logons from one account. Each logon is benign on its own; the volume from one identity is the signal."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.002"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Silver Ticket"
    log_prerequisites = "Requires Windows domain authentication logs (Security event 4624 or equivalent identity provider sign-in logs) normalised to USER_LOGIN, with the extensions.auth.mechanism and extensions.auth.auth_details fields populated."
    platform = "Windows"
    log_source = "identity"
    false_positives = "File servers, SQL or SharePoint front-ends, and application accounts that legitimately generate many Kerberos service logons; vulnerability scanners with credentialed scans; backup and monitoring jobs; users running mass file-share operations."
    tuning_guidance = "Add known high-volume service accounts to %global_allowed_service_accounts, administrator accounts to %global_allowed_admin_users, and credentialed scanner source hosts to %global_allowed_scanners. Raise the #auth threshold in busy environments. Review the outcome variables $distinct_targets and $source_ips to separate scripted ticket reuse from normal usage."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.extensions.auth.mechanism = "NETWORK"
    $auth.extensions.auth.auth_details = /kerberos/ nocase
    $auth.principal.user.userid != ""
    $auth.target.hostname != ""
    not $auth.principal.user.userid = /\$$/ nocase
    not $auth.principal.user.userid = /^(anonymous logon|local service|network service|system)$/ nocase
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users
    not $auth.principal.hostname in %global_allowed_scanners
    $auth.principal.user.userid = $user

  match:
    $user over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1558.002")
    $primary_entity = array_distinct($user)
    $event_count = count($auth.metadata.id)
    $distinct_targets = array_distinct($auth.target.hostname)
    $source_ips = array_distinct($auth.principal.ip)
    $source_hosts = array_distinct($auth.principal.hostname)

  condition:
    #auth >= 30
}
