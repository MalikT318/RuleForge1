/*
  MITRE Technique : T1622 - Debugger Evasion
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:48:30.493656+00:00
  Reference       : https://attack.mitre.org/techniques/T1622
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1622_Linux_TracerPid_Debugger_Check {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a process launch whose command line reads the TracerPid field from /proc/<pid>/status (self, $$ or a numeric PID) using a shell utility. Malware on Linux uses this check to learn whether a debugger or tracer is attached and to change its behaviour or disengage. The rule matches the combination of a /proc status read and the TracerPid field, so it still fires if the utility or script is renamed."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1622"
    mitre_technique_name = "Debugger Evasion"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records normalised to UDM PROCESS_LAUNCH with full command-line capture."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers and reverse engineers checking whether a process is traced, performance and troubleshooting scripts, container health checks, anti-tamper checks in licensed software, and monitoring agents that read process status."
    tuning_guidance = "Add approved monitoring and EDR parent processes to %global_allowed_security_tools, approved inventory and troubleshooting tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Exclude known developer or build hosts through %global_allowed_script_hosts if they are noisy."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /tracerpid/ nocase
    $proc.target.process.command_line = /\/proc\/(self|\$\$|[0-9]+)\/status/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1622")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
