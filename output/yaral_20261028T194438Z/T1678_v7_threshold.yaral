/*
  MITRE Technique : T1678 - Delay Execution
  Tactic(s)       : Stealth
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:25:39.532158+00:00
  Reference       : https://attack.mitre.org/techniques/T1678
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1678_Repeated_Delay_Command_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated launches of native delay or sleep commands (ping -n with a high count, timeout /t, choice /t, waitfor /t, Start-Sleep) on a single Windows host within 10 minutes. A single delay command is benign. A burst of them is consistent with malware or droppers stalling execution to outlast sandbox analysis windows or to wait for prior commands to finish."
    mitre_tactic = "Stealth"
    mitre_technique = "T1678"
    mitre_technique_name = "Delay Execution"
    log_prerequisites = "Requires EDR process telemetry, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrative and logon scripts that pause between steps, software installers and updaters, RMM and deployment tooling, build and CI agents, and batch files that use timeout or ping to wait for a service to start."
    tuning_guidance = "Add approved deployment and RMM binaries to %global_allowed_admin_tools and trusted script-launching parents to %global_allowed_script_hosts. Raise the #proc threshold on noisy build or server hosts. Lower it for high-value assets. Review the parent process and full command lines in the alert before escalating."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(\bping(\.exe)?\s+.*[-\/]n\s+\d{2,}|\btimeout(\.exe)?\s+.*\/t\s+\d+|\bchoice(\.exe)?\s+.*\/t\s+\d+|\bwaitfor(\.exe)?\s+.*\/t\s+\d+|\bstart-sleep\b)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  match:
    $host over 10m

  outcome:
    $risk_score = max(55)
    $command_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1678")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 5
}
