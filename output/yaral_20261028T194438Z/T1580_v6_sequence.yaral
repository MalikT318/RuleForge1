/*
  MITRE Technique : T1580 - Cloud Infrastructure Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:58:46.723098+00:00
  Reference       : https://attack.mitre.org/techniques/T1580
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1580_Compute_Then_Storage_Discovery_Sequence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a single cloud identity enumerating compute resources (instances, snapshots, volumes, images, networks) and then enumerating storage resources (buckets, bucket ACLs/policies, public access blocks) within ten minutes. This compute-then-storage discovery sweep is a common post-compromise reconnaissance pattern for mapping an IaaS environment."
    mitre_tactic = "Discovery"
    mitre_technique = "T1580"
    mitre_technique_name = "Cloud Infrastructure Discovery"
    log_prerequisites = "Requires cloud control-plane audit logs, including read-only and management API calls, ingested and parsed into UDM with metadata.product_event_type and principal.user.userid populated. For AWS this means CloudTrail management events with read events enabled."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Cloud posture and asset-inventory tooling, CMDB sync jobs, IaC pipelines running plan/refresh, FinOps and cost-optimisation tools, backup and DR orchestration, and administrators or engineers doing legitimate environment reviews or troubleshooting."
    tuning_guidance = "Add automation and inventory identities to %global_allowed_service_accounts, and approved cloud service principals to %global_allowed_cloud_principals. Raise the severity or add a source-IP exclusion for identities that have never performed discovery before. Extend the product_event_type regexes if the client uses additional cloud providers or API naming."

  events:
    $compute.metadata.event_type = "USER_RESOURCE_ACCESS"
    $compute.metadata.product_event_type = /(DescribeInstances|DescribeSnapshots|DescribeVolumes|DescribeImages|DescribeVpcs|DescribeSubnets|DescribeSecurityGroups|compute\.instances\.(list|aggregatedList)|compute\.snapshots\.list|compute\.disks\.(list|aggregatedList)|virtualMachines\/read|snapshots\/read)/ nocase
    $compute.principal.user.userid != ""
    $compute.principal.user.userid = $user
    not $compute.principal.user.userid in %global_allowed_service_accounts
    not $compute.principal.user.userid in %global_allowed_cloud_principals

    $storage.metadata.event_type = "USER_RESOURCE_ACCESS"
    $storage.metadata.product_event_type = /(ListBuckets|HeadBucket|GetBucketAcl|GetBucketPolicy|GetPublicAccessBlock|GetBucketLocation|storage\.buckets\.(list|get|getIamPolicy)|storageAccounts\/read)/ nocase
    $storage.principal.user.userid != ""
    $storage.principal.user.userid = $user
    not $storage.principal.user.userid in %global_allowed_service_accounts
    not $storage.principal.user.userid in %global_allowed_cloud_principals

    $compute.metadata.event_timestamp.seconds <= $storage.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1580")
    $primary_entity = array_distinct($user)
    $compute_actions = array_distinct($compute.metadata.product_event_type)
    $storage_actions = array_distinct($storage.metadata.product_event_type)
    $source_ips = array_distinct($compute.principal.ip)
    $compute_event_count = count($compute.metadata.id)
    $storage_event_count = count($storage.metadata.id)

  condition:
    $compute and $storage
}
