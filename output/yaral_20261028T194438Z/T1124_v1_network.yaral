/*
  MITRE Technique : T1124 - System Time Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:31:09.039970+00:00
  Reference       : https://attack.mitre.org/techniques/T1124
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1124_Outbound_NTP_To_External_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects a client sending NTP (UDP/123) traffic to an external, non-internal destination as seen at the network perimeter. Domain-joined Windows hosts normally sync time from a domain controller, so direct external time queries can indicate System Time Discovery, such as sandbox or uptime checks, time zone inference, or malware beaconing to time sources. This is a network-side complement to endpoint command-line detections."
    mitre_tactic = "Discovery"
    mitre_technique = "T1124"
    mitre_technique_name = "System Time Discovery"
    log_prerequisites = "Requires firewall or perimeter network telemetry normalised to UDM NETWORK_CONNECTION with target.ip, target.port, and network.ip_protocol populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Domain controllers or the PDC emulator syncing with external stratum servers, standalone or non-domain-joined workstations using default Windows Time settings, network appliances, printers and IoT devices with built-in NTP clients, and guest or BYOD networks."
    tuning_guidance = "Add the source addresses of authorised time-sync hosts (PDC emulator, edge NTP servers, network appliances) to %global_allowed_mgmt_sources. Add known-good external time providers to %global_allowed_domains if the log source populates target.hostname. Consider routing this rule to a low-priority queue or using it as an enrichment signal."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 123
    $net.network.ip_protocol = "UDP"
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1124")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
