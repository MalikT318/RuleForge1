/*
  MITRE Technique : T1669 - Wi-Fi Networks
  Tactic(s)       : Initial Access
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:13:30.099227+00:00
  Reference       : https://attack.mitre.org/techniques/T1669
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1669_Wireless_Intrusion_Verdict_On_Network_Appliance {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network security appliance (IDS/IPS with wireless intrusion prevention) reporting a wireless attack verdict, such as a rogue or evil-twin access point, deauthentication or disassociation flood, or unauthorized wireless client association. These are close-access and Wi-Fi-based initial access behaviours. Written for the network device management plane rather than endpoints, so it complements any existing Windows coverage."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1669"
    mitre_technique_name = "Wi-Fi Networks"
    log_prerequisites = "Requires IDS/IPS or wireless-IPS-capable network security appliance logs normalised to UDM NETWORK_CONNECTION with security_result.description populated. Appliance wireless detection signatures must be enabled and forwarded."
    platform = "Network Devices"
    log_source = "ips"
    false_positives = "Authorised wireless penetration tests or site surveys, neighbouring-tenant access points flagged as rogue in shared buildings, misconfigured or newly deployed corporate access points, roaming-related deauthentication noise, and guest-network devices misidentified as unauthorised clients."
    tuning_guidance = "Add authorised wireless testing hosts and survey tooling to %global_allowed_scanners (matched on principal.hostname). Tune the appliance's rogue AP classification to mark known neighbour or corporate SSIDs as friendly, and consider raising the severity only for verdicts on corporate-SSID impersonation."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.security_result.description = /(rogue\s+(ap|access\s+point)|evil[\s_-]?twin|(de-?auth(entication)?|disassoc(iation)?)\s+(flood|attack)|wireless\s+intrusion|unauthori[sz]ed\s+(wireless|wifi|wi-fi|access\s+point|ap)|ad[\s-]?hoc\s+network|wifi\s+(attack|intrusion)|wi-fi\s+(attack|intrusion))/ nocase or
      $net.security_result.summary = /(rogue\s+(ap|access\s+point)|evil[\s_-]?twin|(de-?auth(entication)?|disassoc(iation)?)\s+(flood|attack)|wireless\s+intrusion|unauthori[sz]ed\s+(wireless|wifi|wi-fi|access\s+point|ap))/ nocase
    )
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1669")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.target.hostname))
    $source_ips = array_distinct($net.principal.ip)
    $target_ips = array_distinct($net.target.ip)
    $verdict_descriptions = array_distinct($net.security_result.description)

  condition:
    $net
}
