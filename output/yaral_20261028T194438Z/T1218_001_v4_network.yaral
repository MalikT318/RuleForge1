/*
  MITRE Technique : T1218.001 - Compiled HTML File
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:42:36.012547+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_001_HHExe_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Windows HTML Help executable (hh.exe) initiating a network connection to a non-internal address. Legitimate CHM viewing is local and rarely needs outbound access, so external connections from hh.exe indicate a remotely hosted CHM being fetched and executed, or a CHM payload calling out to download a second stage or establish C2. This is network-side coverage that complements any process command-line detection. Limitation: a copied and renamed hh.exe will not match the image-name filter."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.001"
    mitre_technique_name = "System Binary Proxy Execution: Compiled HTML File"
    log_prerequisites = "Requires Windows endpoint network connection telemetry with process attribution (EDR or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Opening online help links or remote .chm files from an intranet or vendor site with a public address; legacy applications that fetch help content over HTTP(S) via hh.exe; software vendors whose help content is hosted on external CDNs."
    tuning_guidance = "Add known-good vendor help or CDN domains to %global_allowed_domains. Confirm %rfc1918_internal covers all internal address space for each client. Add approved internal help servers with public addressing to %global_allowed_domains. Exclude approved hosts with %global_allowed_admin_tools if needed."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\hh\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $destination_hosts = array_distinct($net.target.hostname)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
