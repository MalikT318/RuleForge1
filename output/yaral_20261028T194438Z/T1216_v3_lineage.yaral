/*
  MITRE Technique : T1216 - System Script Proxy Execution
  Tactic(s)       : Stealth
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:32:35.485513+00:00
  Reference       : https://attack.mitre.org/techniques/T1216
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1216_Unexpected_Parent_Spawns_Script_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office application, web server, print spooler or database service spawning a script host (cscript, wscript, PowerShell) that runs a signed script from the Windows system directories. This is the parent-child lineage typical of System Script Proxy Execution, where a trusted Microsoft-signed script is abused to proxy execution of attacker content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1216"
    mitre_technique_name = "System Script Proxy Execution"
    log_prerequisites = "Requires Windows endpoint process telemetry (EDR, Sysmon Event ID 1 or Security Event 4688 with command-line auditing) that populates parent and child process paths and the child command line."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Line-of-business Office macros or add-ins that call administrative VBScript, IIS or Tomcat applications that run maintenance scripts, SQL Server jobs that invoke cscript for housekeeping, print management scripts launched by the spooler, and software deployment or monitoring agents that run under these parents."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts and approved management tooling to %global_allowed_admin_tools. If a specific web or database server legitimately runs scripts, add its parent process path to %global_allowed_script_hosts rather than editing the parent regex. Narrow or widen the parent list to match the client estate."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|php-cgi|tomcat[0-9]*|spoolsv|sqlservr|mysqld|postgres|oracle)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cscript|wscript|powershell|pwsh)\.exe$/ nocase
    $proc.target.process.command_line = /(\\windows\\(system32|syswow64)\\.*\.(vbs|wsf|js)|syncappvpublishingserver|pubprn)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1216")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
