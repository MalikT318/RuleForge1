/*
  MITRE Technique : T1546.011 - Application Shimming
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:15:52.222942+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_011_AppCompat_Shim_Registry_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Multiple registry writes under the AppCompatFlags Custom or InstalledSDB keys on a single host within ten minutes. This is the registry footprint of a custom shim database being registered (for example by sdbinst.exe or a direct registry write). A single write can be benign; a burst of writes to these keys on one host indicates shim database installation, a known persistence and privilege escalation mechanism."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.011"
    mitre_technique_name = "Event Triggered Execution: Application Shimming"
    log_prerequisites = "Requires Windows endpoint registry modification telemetry (EDR or Sysmon registry events) populating target.registry.registry_key and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate application compatibility fixes deployed by IT (Microsoft Compatibility Administrator, sdbinst.exe via software deployment), vendor installers that register compatibility shims for legacy applications, and Windows servicing and update components."
    tuning_guidance = "Add approved deployment and compatibility tooling executable paths to %global_allowed_admin_tools and EDR agents to %global_allowed_security_tools. Raise the threshold in the condition if installers that write several values per shim produce noise. Review the registry_keys and writer_processes outcome values to confirm the database path is not in a user-writable location."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Microsoft\\Windows NT\\CurrentVersion\\AppCompatFlags\\(Custom|InstalledSDB)(\\|$)/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($reg.target.registry.registry_key = /InstalledSDB/ nocase, 80, 65))
    $event_count = count($reg.metadata.id)
    $mitre_technique_id = array_distinct("T1546.011")
    $primary_entity = array_distinct($host)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_name)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 3
}
