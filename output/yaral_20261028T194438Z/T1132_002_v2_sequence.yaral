/*
  MITRE Technique : T1132.002 - Non-Standard Encoding
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:47:41.747523+00:00
  Reference       : https://attack.mitre.org/techniques/T1132/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1132_002_ESXi_SSH_Login_Then_Staged_Binary_NonStandard_Port_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an SSH login to an ESXi host followed within 10 minutes by an outbound connection to an external address, on a non-standard port, from a process running out of a world-writable staging location (/tmp, /var/tmp, /dev/shm, /scratch). A hypervisor has no legitimate reason to run such a binary and talk to the internet on an unusual port. This pattern matches a custom or non-standard-encoded C2 channel, where the traffic is not a recognised protocol and the process is dropped by an interactive session. The rule detects the network behaviour and process lineage, not the command line."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1132.002"
    mitre_technique_name = "Data Encoding: Non-Standard Encoding"
    log_prerequisites = "ESXi authentication logs (sshd/hostd) normalised to USER_LOGIN, plus host-level network connection telemetry with originating process path normalised to NETWORK_CONNECTION. Requires principal.process.file.full_path to be populated on connection events."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators running diagnostic or support binaries from /tmp after an SSH session, vendor support bundles uploading to external endpoints on custom ports, third-party agents staged in /scratch, and backup or monitoring tooling that makes outbound calls on custom ports."
    tuning_guidance = "Add approved management source addresses to %global_allowed_mgmt_sources, named administrators to %global_allowed_admin_users, and approved agent or support binaries to %global_allowed_admin_tools or %global_allowed_security_tools. If the parser does not populate target.application with the SSH service name, replace that filter with the equivalent field in the client's ESXi parser. Widen the excluded standard port list if the client has approved egress services."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.target.application = /ssh/ nocase
    not $login.principal.ip in %global_allowed_mgmt_sources
    not $login.target.user.userid in %global_allowed_admin_users
    $login.target.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|scratch)\// nocase
    not $net.target.ip in %rfc1918_internal
    $net.target.port != 443
    $net.target.port != 80
    $net.target.port != 53
    $net.target.port != 123
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    $net.principal.hostname = $hostname

    $login.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1132.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $login_users = array_distinct($login.target.user.userid)
    $login_sources = array_distinct($login.principal.ip)
    $staged_processes = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $connection_count = count($net.metadata.id)

  condition:
    $login and $net
}
