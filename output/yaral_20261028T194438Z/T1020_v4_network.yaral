/*
  MITRE Technique : T1020 - Automated Exfiltration
  Tactic(s)       : Exfiltration
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:30:27.616088+00:00
  Reference       : https://attack.mitre.org/techniques/T1020
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1020_Large_Outbound_Transfer_Firewall {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a single outbound firewall/proxy connection from an internal Windows host to an external destination that carries a very large volume of uploaded data (over 50 MB). Large one-way uploads to external addresses are characteristic of scripted or scheduled bulk exfiltration after collection. This is a network-side detection and does not rely on endpoint process or command-line telemetry."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1020"
    mitre_technique_name = "Automated Exfiltration"
    log_prerequisites = "Firewall, proxy or perimeter logs normalised to UDM NETWORK_CONNECTION with network.sent_bytes populated and the source IP/hostname of internal Windows hosts. Session-close or flow-summary logging must be enabled, because byte counters are only present in those records."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Cloud backup and file-sync clients, OS and software update uploads of telemetry or crash dumps, approved large file transfers to partners, video conferencing and media uploads, and migration jobs to cloud storage."
    tuning_guidance = "Add known-good destination domains (backup vendors, SaaS storage, update services) to %global_allowed_domains and approved source addresses to %global_allowed_mgmt_sources. Raise or lower the sent_bytes threshold per client based on baseline upload volumes. If the log source reports only per-packet events with no byte counters, this rule will not fire."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.sent_bytes > 52428800
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1020")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
