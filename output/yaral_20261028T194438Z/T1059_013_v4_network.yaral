/*
  MITRE Technique : T1059.013 - Container CLI/API
  Tactic(s)       : Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:26:15.568770+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_013_Container_API_Exec_From_External_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects HTTP requests from non-internal sources to container management API endpoints that run, exec into, attach to, build or pull containers (Docker Engine API and Kubernetes pod exec/attach). This is the network-side footprint of abusing the container CLI/API/SDK remotely, and is additive to endpoint command-line detections."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.013"
    mitre_technique_name = "Command and Scripting Interpreter: Container CLI/API"
    log_prerequisites = "Requires HTTP request telemetry normalised to NETWORK_HTTP with target.url populated, from cloud-provider-side sources in front of container management APIs (managed load balancer, API gateway or API server request logs). Plain control-plane audit events that do not populate NETWORK_HTTP will not trigger this rule."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "CI/CD runners and remote build agents calling the container API from public egress addresses, SaaS container management or monitoring platforms, administrators connecting from home or VPN egress IPs, and developers using remote Docker contexts."
    tuning_guidance = "Add approved administrative or pipeline source addresses to %global_allowed_mgmt_sources, automation identities to %global_allowed_service_accounts, and named administrators to %global_allowed_admin_users. If the Docker API is never legitimately reachable externally, keep severity at High or raise it to Critical."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(v[0-9]+(\.[0-9]+)?\/)?(containers\/(create|[^\/?]+\/(exec|attach|start))|exec\/[^\/?]+\/start|build|images\/create)(\?|$|\/)|\/api\/v1\/namespaces\/[^\/]+\/pods\/[^\/]+\/(exec|attach)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_mgmt_sources
    not $http.principal.user.userid in %global_allowed_service_accounts
    not $http.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.013")
    $primary_entity = array_distinct($http.target.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)

  condition:
    $http
}
