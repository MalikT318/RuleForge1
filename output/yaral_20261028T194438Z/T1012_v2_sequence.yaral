/*
  MITRE Technique : T1012 - Query Registry
  Tactic(s)       : Discovery
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:23:52.889421+00:00
  Reference       : https://attack.mitre.org/techniques/T1012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1012_Script_Host_Registry_Query_Then_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A script interpreter or command shell launches reg.exe to query security- or inventory-relevant registry areas (installed software, autoruns, LSA, Defender, policies). The same host's interpreter then makes an external network connection within 10 minutes. This sequence points to automated discovery followed by C2 or exfiltration, rather than a single administrative query."
    mitre_tactic = "Discovery"
    mitre_technique = "T1012"
    mitre_technique_name = "Query Registry"
    log_prerequisites = "Requires endpoint process-launch telemetry with parent process and command line, plus endpoint network-connection telemetry that records the initiating process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin or inventory scripts that query the registry and then call out to external management or licensing services; software deployment and RMM tooling; login scripts run via cmd or PowerShell; developers testing installers."
    tuning_guidance = "Add approved parent interpreters or script-host paths to %global_allowed_script_hosts. Add RMM and inventory tooling to %global_allowed_admin_tools. Known-good external destinations can be excluded by adding a domain-based exclusion if network telemetry carries a hostname. Raise severity if the registry query covers LSA or security-provider keys."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\reg\.exe$/ nocase
    $proc.target.process.command_line = /\bquery\b/ nocase
    $proc.target.process.command_line = /(CurrentVersion|\\Uninstall|\\Run(Once)?\b|\\Lsa\b|SecurityProviders|Windows Defender|\\Policies\\|Terminal Server|\\Services\\)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_script_hosts
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    $net.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1012")
    $primary_entity = array_distinct($proc.principal.hostname)
    $registry_query_commands = array_distinct($proc.target.process.command_line)
    $querying_users = array_distinct($proc.principal.user.userid)
    $destination_ips = array_distinct($net.target.ip)
    $query_count = count($proc.metadata.id)

  condition:
    $proc and $net
}
