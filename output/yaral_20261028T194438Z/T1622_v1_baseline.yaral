/*
  MITRE Technique : T1622 - Debugger Evasion
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:47:41.591672+00:00
  Reference       : https://attack.mitre.org/techniques/T1622
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1622_Linux_TracerPid_Debugger_Check {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a process launched with a command line that reads the TracerPid field from /proc/<pid>/status (self, numeric PID or shell PID variable). This is the standard Linux anti-debugging check for ptrace/strace/gdb attachment, used by malware to disengage or hide behaviour when analysed."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1622"
    mitre_technique_name = "Debugger Evasion"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records normalised to UDM PROCESS_LAUNCH with full command-line capture."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers and reverse engineers checking trace state, application or test startup scripts that test for a tracer, system health/diagnostic scripts, container or process-inspection tooling, and security agents inspecting process status."
    tuning_guidance = "Add approved diagnostic, monitoring and inventory tooling to %global_allowed_admin_tools and approved security agents to %global_allowed_security_tools (matched against the parent process path). Consider raising severity when the parent is in /tmp, /dev/shm or /var/tmp, or when the user is a service account."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /tracerpid/ nocase
    $proc.target.process.command_line = /\/proc\/(self|[0-9]+|\$\$|\$\{?pid\}?|\$\(.*\))\/status/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1622")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
