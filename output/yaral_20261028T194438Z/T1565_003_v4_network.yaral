/*
  MITRE Technique : T1565.003 - Runtime Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:43:47.012073+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_003_Linux_Staging_Dir_Process_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a process executing from a Linux staging location (/tmp, /var/tmp, /dev/shm or an in-memory memfd) that opens an outbound connection to a non-internal address. Adversaries who tamper with application binaries or data-handling components to manipulate runtime data often use dropped or modified code from these locations to retrieve manipulation instructions, replacement data or tooling from external hosts. This rule is the network-side companion to endpoint file-modification coverage and does not rely on destination, tool name or hash."
    mitre_tactic = "Impact"
    mitre_technique = "T1565.003"
    mitre_technique_name = "Data Manipulation: Runtime Data Manipulation"
    log_prerequisites = "Linux EDR or auditd network telemetry that populates principal.process.file.full_path, target.ip and principal.hostname on NETWORK_CONNECTION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developer or CI build and test binaries run from /tmp; self-extracting installers or AppImage-style software that unpack to /tmp and call out to license or update servers; containers or sandboxes that mount scratch space under /tmp; admin scripts staging tools in /var/tmp."
    tuning_guidance = "Add approved tooling paths to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. Add automation accounts to %global_allowed_service_accounts. Add build and CI hosts to %global_allowed_script_hosts or scope them out at the log-source level. Review the destination_ips and process_path outcomes before suppressing."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/memfd:)/ nocase
    $net.principal.hostname != ""
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1565.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
