/*
  MITRE Technique : T1041 - Exfiltration Over C2 Channel
  Tactic(s)       : Exfiltration
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:00:04.284045+00:00
  Reference       : https://attack.mitre.org/techniques/T1041
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1041_Linux_Firewall_Large_Asymmetric_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a single long-lived outbound flow from an internal host to an external address on a common C2 or web port, where the volume sent is very large and almost nothing comes back. This upload-heavy asymmetry is typical of bulk data exfiltration over an established C2 channel, for example from a compromised Linux server staging and pushing archives or database dumps. The rule uses perimeter flow telemetry only and does not depend on process or command-line data."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1041"
    mitre_technique_name = "Exfiltration Over C2 Channel"
    log_prerequisites = "Requires firewall, proxy or perimeter flow logs normalised to UDM NETWORK_FLOW with network.sent_bytes and network.received_bytes populated, and with the source address as seen at the egress point."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Off-site backup and replication jobs, log shipping and telemetry forwarders, large artifact or container image pushes, database dumps sent to cloud storage, and software mirrors or CI/CD uploads from Linux servers."
    tuning_guidance = "Add known-good destination domains (backup providers, CDNs, vendor update and telemetry endpoints) to %global_allowed_domains. The firewall cannot identify the OS of the source, so scope the rule to Linux server address ranges through asset context or log-source filtering in each tenant. Adjust the sent_bytes threshold (default about 100 MB) and the received_bytes ceiling (default about 1 MB) to the client's normal egress baseline."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    $net.network.sent_bytes > 104857600
    $net.network.received_bytes < 1048576
    (
      $net.target.port = 443 or
      $net.target.port = 80 or
      $net.target.port = 8080 or
      $net.target.port = 8443 or
      $net.target.port = 53
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1041")
    $primary_entity = array_distinct($net.principal.ip)
    $source_hostname = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
