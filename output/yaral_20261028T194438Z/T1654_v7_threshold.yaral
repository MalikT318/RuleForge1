/*
  MITRE Technique : T1654 - Log Enumeration
  Tactic(s)       : Discovery
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:00:00.980193+00:00
  Reference       : https://attack.mitre.org/techniques/T1654
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1654_IaaS_Bulk_Log_Enumeration_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single cloud identity issues a high volume of log-read, log-query, or log-listing API calls within ten minutes. Each call is benign alone, but bulk enumeration of audit and log stores can indicate an adversary hunting for authentication records, security tooling, or hosts, or monitoring defender activity."
    mitre_tactic = "Discovery"
    mitre_technique = "T1654"
    mitre_technique_name = "Log Enumeration"
    log_prerequisites = "Cloud control-plane audit logging, including data-plane read events for log services, must be enabled and ingested into UDM with metadata.product_event_type populated. Some providers do not log log-read calls by default."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "SIEM or log-forwarding integrations using user-bound credentials, incident responders and auditors reviewing logs, cloud operations staff troubleshooting, compliance evidence collection scripts, and monitoring or dashboard tooling polling log stores."
    tuning_guidance = "Add log-shipper, monitoring, and automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Add named auditors and responders to %global_allowed_admin_users. Add authorised assessment identities to %global_allowed_scanners. Raise the #cloud threshold (default 20) for noisy tenants. Extend the product_event_type regex with provider-specific log-read operations as needed."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /(GetLogEvents|FilterLogEvents|DescribeLogStreams|DescribeLogGroups|GetQueryResults|LookupEvents|GetLogRecord|ListLogEntries|entries\.list|Microsoft\.Insights\/(logs|eventtypes)\/.*(read|query))/ nocase
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_scanners

  match:
    $user over 10m

  outcome:
    $risk_score = max(55)
    $event_count = count($cloud.metadata.id)
    $distinct_log_resources = count_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)
    $operations = array_distinct($cloud.metadata.product_event_type)
    $mitre_technique_id = array_distinct("T1654")
    $primary_entity = array_distinct($user)

  condition:
    #cloud >= 20
}
