/*
  MITRE Technique : T1497.002 - User Activity Based Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:04:44.317176+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_002_Linux_User_Activity_Sandbox_Checks {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects Linux process launches whose command line probes for signs of a real interactive user. This covers counting files in user directories such as Desktop and Documents, counting shell or browser history entries, and querying X11 or kernel input devices for mouse position or idle time. Malware uses these checks to tell a live workstation from a sandbox or analysis VM before it activates."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1497.002"
    mitre_technique_name = "Virtualization/Sandbox Evasion: User Activity Based Checks"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to UDM PROCESS_LAUNCH with full command lines populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Admin or helper scripts that count files in home directories (disk-usage or backup reporting); desktop environment utilities and screen lockers or idle-timeout daemons that call idle-time or input-device queries; accessibility and remote-desktop tooling; developers testing input automation; user profile audit and migration scripts."
    tuning_guidance = "Add approved IT, inventory and RMM tooling to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Add trusted wrapper scripts or script-host parents to %global_allowed_script_hosts. If a client runs a desktop fleet with idle-lock agents, add those agent binaries to %global_allowed_admin_tools. Raise the risk score when the parent process is a world-writable path such as /tmp or /dev/shm."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /((\b(ls|find|cat|stat|wc)\b.*(\.bash_history|\.zsh_history|\.mozilla\/firefox|\.config\/(google-chrome|chromium)|recently-used\.xbel|\/(Desktop|Documents|Downloads)\b).*\|\s*wc\s+-l)|(\bxdotool\s+getmouselocation|\bxinput\s+(query-state|test)\b|\bxprintidle\b|\/dev\/input\/(mice|mouse[0-9]+|event[0-9]+)))/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1497.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
