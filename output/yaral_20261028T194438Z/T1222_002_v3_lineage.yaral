/*
  MITRE Technique : T1222.002 - Linux and Mac Permissions
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:20:46.341870+00:00
  Reference       : https://attack.mitre.org/techniques/T1222/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_002_Linux_ServiceParent_Spawns_Permission_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux permission or attribute utility (chmod, chown, chattr, setfacl) launched directly by a network-facing service process such as a web server, application server, database, print spooler or file server daemon. These services should not normally alter file modes or ownership. This lineage points to a web shell, SQL command execution or exploited service making a dropped payload executable, setuid, world-writable, root-owned or immutable."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1222.002"
    mitre_technique_name = "File and Directory Permissions Modification: Linux and Mac File and Directory Permissions Modification"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd (execve / SYSCALL records) that populates the parent process path, child process path and command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package post-install scripts or deployment hooks run by a web or database service account, CMS or application self-update routines that set file modes, database engines adjusting data directory ownership at startup, and CUPS filters adjusting spool file permissions."
    tuning_guidance = "Add approved deployment or configuration tooling parent paths to %global_allowed_admin_tools. Add legitimate automation accounts to %global_allowed_service_accounts. Add approved administrators to %global_allowed_admin_users. Extend the parent process regex with environment-specific service daemons if needed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|tomcat[0-9]*|catalina|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|smbd)$/ nocase
    $proc.target.process.file.full_path = /\/(chmod|chown|chgrp|chattr|setfacl)$/ nocase
    (
      $proc.target.process.command_line = /chmod\s+(-[a-zA-Z]+\s+)*([ugoa]*[+=][rwxXst]*[xs]|0?777|[2467][0-7]{3})(\s|$)/ nocase or
      $proc.target.process.command_line = /(chown|chgrp)\s+(-[a-zA-Z]+\s+)*(root|0)([:.][a-z0-9_-]+)?\s/ nocase or
      $proc.target.process.command_line = /chattr\s+(-[a-zA-Z]+\s+)*[+-][a-zA-Z]*i/ nocase or
      $proc.target.process.command_line = /setfacl\s/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1222.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
