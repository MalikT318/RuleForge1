/*
  MITRE Technique : T1059.003 - Windows Command Shell
  Tactic(s)       : Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:09:38.286602+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_003_Dropped_Batch_File_Executed_By_Cmd {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A batch file (.bat/.cmd) is written to a user-writable staging location and cmd.exe then executes a batch file from that kind of location. The cmd.exe is spawned by an Office, script-host, or other proxy-execution parent on the same host within 5 minutes. This points to a dropper that stages and runs a batch script rather than an interactive shell session."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.003"
    mitre_technique_name = "Command and Scripting Interpreter: Windows Command Shell"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event 11) and process-launch telemetry with parent process and command line (Sysmon Event 1 or Windows Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters that drop and run temporary .cmd files, logon or deployment scripts staged to ProgramData, helpdesk macros, and legacy line-of-business applications that launch batch files from Office or script hosts."
    tuning_guidance = "Add approved deployment and patching tools to %global_allowed_admin_tools (file creator). Add approved parent processes or hosts to %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts. If a particular installer is noisy, add its process to %global_allowed_admin_tools instead of widening the path regex."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(appdata\\|temp\\|programdata\\|users\\public\\).*\.(bat|cmd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\cmd\.exe$/ nocase
    $proc.target.process.command_line = /\\(appdata|temp|programdata|users\\public)\\[^"]*\.(bat|cmd)/ nocase
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|wscript|cscript|mshta|powershell|pwsh|rundll32|regsvr32|wmiprvse|msiexec)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $dropped_batch_files = array_distinct($file.target.file.full_path)
    $dropper_processes = array_distinct($file.principal.process.file.full_path)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $executed_command_lines = array_distinct($proc.target.process.command_line)
    $affected_users = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
