/*
  MITRE Technique : T1556.006 - Multi-Factor Authentication
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:22:40.542594+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_006_Login_Followed_By_MFA_Change_SaaS {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an external SaaS sign-in followed within 10 minutes by the same account disabling, removing, resetting or registering an MFA factor or authentication method. This pattern is typical of an adversary who has just obtained access to an account and then weakens or replaces MFA to keep it."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.006"
    mitre_technique_name = "Modify Authentication Process: Multi-Factor Authentication"
    log_prerequisites = "Requires identity provider sign-in logs normalised to USER_LOGIN and directory/audit logs for MFA factor or authentication-method changes normalised to USER_CHANGE_PERMISSIONS, with metadata.product_event_type populated."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Users enrolling a new phone or authenticator after a device replacement, first-time MFA enrolment during onboarding, self-service MFA reset after a lost device, and helpdesk-driven resets performed from the user's own session."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts and administrators who legitimately manage MFA to %global_allowed_admin_users. If the tenant maps MFA changes to a different UDM event type, adjust the event type on $mfa. If the identity provider uses unusual event naming, extend the two product_event_type regexes. Consider raising severity when the sign-in and MFA change come from a new external IP."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.principal.user.userid = $user
    not $login.principal.ip in %rfc1918_internal
    not $login.principal.user.userid in %global_allowed_service_accounts

    $mfa.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $mfa.principal.user.userid = $user
    $mfa.metadata.product_event_type = /(mfa|multi.?factor|factor|authenticator|security.?info|strong.?auth|authentication.?method)/ nocase
    $mfa.metadata.product_event_type = /(deactivat|disabl|remov|delet|reset|unenrol|unenroll|enrol|enroll|regist|add|creat|updat)/ nocase
    not $mfa.principal.user.userid in %global_allowed_admin_users
    not $mfa.principal.user.userid in %global_allowed_service_accounts

    $login.metadata.event_timestamp.seconds <= $mfa.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1556.006")
    $primary_entity = array_distinct($user)
    $login_source_ips = array_distinct($login.principal.ip)
    $mfa_change_events = array_distinct($mfa.metadata.product_event_type)
    $mfa_change_count = count($mfa.metadata.id)

  condition:
    $login and $mfa
}
