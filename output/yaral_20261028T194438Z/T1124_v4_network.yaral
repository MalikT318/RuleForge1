/*
  MITRE Technique : T1124 - System Time Discovery
  Tactic(s)       : Discovery
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:31:58.063080+00:00
  Reference       : https://attack.mitre.org/techniques/T1124
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1124_ESXi_External_Time_Source_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an ESXi host opening an NTP (UDP/123) connection to an external, non-internal address from a process other than the standard time daemons. Hosts normally sync from internal time sources, so this suggests ad-hoc time or time-zone discovery, or sandbox and uptime checks, run from the hypervisor shell (for example ntpdate-style or scripted NTP queries). It is network-side coverage that complements any process command-line detections."
    mitre_tactic = "Discovery"
    mitre_technique = "T1124"
    mitre_technique_name = "System Time Discovery"
    log_prerequisites = "ESXi hosts, or an upstream firewall or flow sensor, must produce network connection telemetry normalised to UDM NETWORK_CONNECTION with principal.hostname, target.ip and target.port populated. Process attribution on the connection is optional but improves precision."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "ESXi hosts deliberately configured to sync from public NTP pools or vendor time services; the native time daemon where process attribution is missing; newly built hosts before the internal time source is configured; approved admin or monitoring tooling checking clock drift."
    tuning_guidance = "Add approved public time-service hostnames to %global_allowed_domains. Add approved admin or monitoring binaries to %global_allowed_admin_tools. Ensure %rfc1918_internal covers all internal NTP sources. If hosts legitimately use public NTP, restrict the rule to hosts where the connecting process is not the time daemon, or lower the severity."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 123
    $net.network.ip_protocol = "UDP"
    $net.principal.hostname != ""
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path = /\/(ntpd|chronyd|sntp)$/ nocase

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1124")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $source_process = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
