/*
  MITRE Technique : T1546.017 - Udev Rules
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:25:10.745853+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/017
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_017_Udev_Rules_Bulk_Write_Per_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several udev rule files are created within ten minutes on a single Linux host by a process that is not a package manager or approved admin tool. One rules file is routine. Repeated writes to the udev rule directories in a short window can indicate persistence through RUN+= action keys, or staging of several trigger rules."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1546.017"
    mitre_technique_name = "Event Triggered Execution: Udev Rules"
    log_prerequisites = "Requires Linux EDR or auditd file telemetry (watch rules on /etc/udev/rules.d and /usr/lib/udev/rules.d) normalised to UDM FILE_CREATION events with principal.process and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package installs or upgrades (dpkg, rpm, dnf, apt) that ship several rules files, configuration management (Ansible, Puppet, Chef, Salt) pushing device rules, hardware or driver installers (GPU, storage, USB, virtualisation guest tools), and golden image build pipelines."
    tuning_guidance = "Add configuration management agents and deployment tooling to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Raise the #file threshold on hosts that are frequently provisioned or rebuilt. Alert priority should rise when the writer is a shell, an interpreter, or a process running from /tmp, /dev/shm, or /var/tmp."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(etc|run|usr\/lib|usr\/local\/lib|lib)\/udev\/rules\.d\/[^\/]+\.rules$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\/(dpkg|rpm|apt|apt-get|dnf|yum|zypper|pacman|snapd|systemd-udevd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1546.017")
    $primary_entity = array_distinct($file.principal.hostname)
    $event_count = count($file.metadata.id)
    $rule_files = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
