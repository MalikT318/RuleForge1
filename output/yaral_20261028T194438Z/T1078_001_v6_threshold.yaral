/*
  MITRE Technique : T1078.001 - Default Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:30:21.322447+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_001_IdP_Default_Account_Repeated_Logins {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated sign-in activity against a built-in or default account identity (administrator, admin, root, guest, sa and similar) within one hour. A single sign-in to a default account can be benign, but sustained volume against one default account indicates credential guessing, password spraying or reuse of a default or stolen credential."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.001"
    mitre_technique_name = "Valid Accounts: Default Accounts"
    log_prerequisites = "Requires identity provider sign-in logs normalised to UDM USER_LOGIN with target.user.userid populated."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Break-glass or emergency administrator accounts used during incidents, legacy applications or scripts that authenticate with a default admin account, helpdesk lockout and unlock cycles, directory sync or migration jobs, and authorised penetration tests."
    tuning_guidance = "Add approved break-glass and service identities to %global_allowed_service_accounts or %global_allowed_admin_users. Raise the threshold (#auth >= 5) for tenants with noisy legacy authentication, or lower it for high-security tenants. Extend the default account name regex with local naming conventions if needed."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.user.userid = /^([^\\]+\\)?(administrator|admin|root|guest|defaultaccount|sa|krbtgt)(@.+)?$/ nocase
    $auth.target.user.userid = $user
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users

  match:
    $user over 1h

  outcome:
    $risk_score = max(70)
    $login_count = count($auth.metadata.id)
    $source_ips = array_distinct($auth.principal.ip)
    $mitre_technique_id = array_distinct("T1078.001")
    $primary_entity = array_distinct($user)

  condition:
    #auth >= 5
}
