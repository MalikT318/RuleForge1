/*
  MITRE Technique : T1548.005 - Temporary Elevated Cloud Access
  Tactic(s)       : Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:34:40.924230+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_005_Office_Suite_Delegation_Or_Elevated_Role_Grant {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects tenant audit events that grant or activate temporary elevated access in an office suite tenant. Covered mechanisms are API client domain-wide delegation authorization, management role assignments (including impersonation roles), and just-in-time privileged role activation. Attackers abuse these to act as other accounts or to gain short-term admin privileges without changing their own standing permissions."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.005"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Temporary Elevated Cloud Access"
    log_prerequisites = "Requires unified admin audit logs from the office suite tenant, ingested and normalised to UDM SETTING_MODIFICATION with metadata.product_event_type populated with the audit operation name. Admin and directory role audit categories must be enabled."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Planned admin role assignments, scheduled just-in-time role activations by on-call admins, approved migration or backup tooling that needs impersonation or domain-wide delegation, onboarding of approved third-party integrations."
    tuning_guidance = "Add named administrators to %global_allowed_admin_users, automation and integration identities to %global_allowed_cloud_principals, and service accounts to %global_allowed_service_accounts. If just-in-time activations are too noisy, remove the activation alternation from the operation regex and keep delegation and role-assignment operations."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /^(AUTHORIZE_API_CLIENT_ACCESS|New-ManagementRoleAssignment|Add-ManagementRoleEntry|Add member to role completed \(PIM activation\)|Add eligible member to role|Add member to role)$/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_cloud_principals
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1548.005")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $operation = array_distinct($setting.metadata.product_event_type)
    $source_ips = array_distinct($setting.principal.ip)
    $target_names = array_distinct($setting.target.resource.name)

  condition:
    $setting
}
