/*
  MITRE Technique : T1484 - Domain or Tenant Policy Modification
  Tactic(s)       : Defense Impairment, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:31:32.322570+00:00
  Reference       : https://attack.mitre.org/techniques/T1484
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1484_IdP_Federation_Trust_Setting_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a change to tenant-level federation, domain authentication, trust, or external identity provider settings in an identity provider's directory audit log, performed by an account that is not an approved administrator or service account. Attackers with sufficient privilege use these changes to add an adversary-controlled federation trust or identity provider, which lets them forge tokens the tenant will accept and so evade authentication controls and escalate privileges."
    mitre_tactic = "Defense Impairment, Privilege Escalation"
    mitre_technique = "T1484"
    mitre_technique_name = "Domain or Tenant Policy Modification"
    log_prerequisites = "Requires identity provider directory/admin audit logs ingested and normalised to UDM SETTING_MODIFICATION, with the operation name populated in metadata.product_event_type and the actor in principal.user.userid."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Planned domain onboarding or federation migrations, SSO or identity provider integration projects, certificate rollover on an existing federation trust, M&A tenant consolidation, and identity governance automation running under an unlisted account."
    tuning_guidance = "Add named administrators who legitimately manage federation to %global_allowed_admin_users and automation or provisioning accounts to %global_allowed_service_accounts. If the tenant's audit operation names differ, adjust the object regex. Pair with change-management tickets and consider raising severity when the actor has no prior admin activity."

  events:
    $idp.metadata.event_type = "SETTING_MODIFICATION"
    $idp.metadata.product_event_type = /(federat|domain.?authentication|domain.?trust|trust.?(relationship|setting)|idp\.lifecycle|identity.?provider|external.?identity)/ nocase
    not $idp.metadata.product_event_type = /^(get|list|view|read)\b/ nocase
    $idp.principal.user.userid != ""
    not $idp.principal.user.userid in %global_allowed_admin_users
    not $idp.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1484")
    $primary_entity = array_distinct($idp.principal.user.userid)
    $operation = array_distinct($idp.metadata.product_event_type)
    $target_object = array_distinct($idp.target.resource.name)
    $source_ip = array_distinct($idp.principal.ip)

  condition:
    $idp
}
