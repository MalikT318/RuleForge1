/*
  MITRE Technique : T1553.004 - Install Root Certificate
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:05:07.374190+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_004_Linux_CA_Certificate_Download_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a command-line or scripting HTTP client on a Linux host fetching a certificate file (.crt, .cer, .pem, .der, .p7b) from an external destination. Attackers typically stage a rogue root CA this way before installing it into the system trust store (/usr/local/share/ca-certificates, /etc/pki/ca-trust/source/anchors) so that traffic to adversary-controlled TLS servers is trusted. Pair with endpoint file-write and update-ca-certificates / update-ca-trust detections."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.004"
    mitre_technique_name = "Subvert Trust Controls: Install Root Certificate"
    log_prerequisites = "Requires Linux EDR network telemetry that populates NETWORK_HTTP events with the initiating process path (principal.process.file.full_path) and target.url. Plain auditd/syslog alone usually does not produce URL-level data."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators or configuration management pulling an internal or corporate CA bundle from an external PKI portal; package and bootstrap scripts (cloud-init, container image builds, CI runners) downloading vendor CA certificates; developers fetching test certificates."
    tuning_guidance = "Add approved PKI and vendor distribution domains to %global_allowed_domains. Add approved provisioning and configuration tooling binaries to %global_allowed_admin_tools. Add hosts or parent tooling that legitimately run scripts, such as build servers, to %global_allowed_script_hosts. Internal destinations are already excluded via %rfc1918_internal."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.principal.process.file.full_path = /\/(curl|wget|python[0-9.]*|perl|ruby)$/ nocase
    $net.target.url = /\.(crt|cer|pem|der|p7b)([?#].*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1553.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $downloaded_url = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)
    $client_process = array_distinct($net.principal.process.file.full_path)
    $client_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
