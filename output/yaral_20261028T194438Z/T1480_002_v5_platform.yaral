/*
  MITRE Technique : T1480.002 - Mutual Exclusion
  Tactic(s)       : Stealth
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:27:40.722319+00:00
  Reference       : https://attack.mitre.org/techniques/T1480/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1480_002_Linux_Mutex_Lock_File_From_Volatile_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a process executing from a volatile, world-writable directory (/tmp, /var/tmp, /dev/shm) that creates a lock, PID or mutex file under /tmp, /var/tmp, /dev/shm, /run or /var/run. Linux malware commonly takes a lock on such a file to ensure only one instance runs, and exits if the lock is already held. Combining the unusual execution location with the lock-file behaviour avoids alerting on ordinary system daemons, and the rule does not depend on specific file names or malware families."
    mitre_tactic = "Stealth"
    mitre_technique = "T1480.002"
    mitre_technique_name = "Execution Guardrails: Mutual Exclusion"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-creation records that populate principal.process.file.full_path and target.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Installers, self-extracting packages or build and CI jobs that run from /tmp and use lock files; user-compiled software run from /tmp or /dev/shm; software-deployment and configuration-management agents staging in /tmp; containers whose runtime uses /tmp as a working directory."
    tuning_guidance = "Add approved deployment or admin tooling binary paths to %global_allowed_admin_tools and EDR/AV agent binaries to %global_allowed_security_tools. Build and CI hosts that legitimately execute from /tmp can be handled with %global_allowed_script_hosts. Raise severity when the host is a production server or when the same process also makes outbound connections."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run|var\/run)\/([^\/]+\/)*[^\/]*\.(lock|lck|pid|mutex)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1480.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $lock_file = array_distinct($file.target.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
