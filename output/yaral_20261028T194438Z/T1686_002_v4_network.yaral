/*
  MITRE Technique : T1686.002 - Network Device Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:30:45.646956+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_002_External_Access_To_Device_Management_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a connection from an external (non-internal) source address to a network device management-plane port (SSH, Telnet, SNMP, NETCONF, or alternate HTTPS admin ports) that is not in the approved management source list. Reaching the management interface from the internet is the access step that precedes firewall policy, ACL, or zone tampering to disable or weaken perimeter controls. This rule gives network-side coverage that does not depend on endpoint process telemetry."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.002"
    mitre_technique_name = "Network Device Firewall"
    log_prerequisites = "Firewall or perimeter connection logs that record accepted and denied traffic to device-owned interfaces, normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Management-plane traffic must be logged (for example, a rule or policy that logs traffic to the device itself)."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Managed-service or vendor support staff connecting from provider address space, remote administrators on dynamic ISP addresses, internet-wide scanners and research crawlers probing SSH or alternate HTTPS ports on exposed interfaces, and legitimate SNMP monitoring from an external SaaS platform. Servers that legitimately publish SSH or 8443 services to the internet can also match."
    tuning_guidance = "Add approved admin, jump-host, and provider source addresses to %global_allowed_mgmt_sources. Add known scanner sources to %global_allowed_scanners. Add known-good vendor domains or sources through the existing lists. If a client publishes services on these ports, restrict by adding the sources or approved targets to the lists, or remove the port from the rule for that tenant. Consider raising severity when the connection is accepted rather than denied, if the log source populates that information."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 161 or
      $net.target.port = 830 or
      $net.target.port = 4443 or
      $net.target.port = 8443 or
      $net.target.port = 10443
    )
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1686.002")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $management_ports = array_distinct($net.target.port)

  condition:
    $net
}
