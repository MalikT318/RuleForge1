/*
  MITRE Technique : T1573.002 - Asymmetric Cryptography
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:26:06.206434+00:00
  Reference       : https://attack.mitre.org/techniques/T1573/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1573_002_Linux_IPS_Repeated_NonStandard_Port_TLS_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source makes many TLS/HTTPS-classified outbound connections to external addresses on non-standard ports within 10 minutes, as seen by network security sensors. One such connection is usually benign. Sustained volume on unusual ports is consistent with a C2 channel hiding in public-key encrypted traffic (RSA/ECDH key exchange) outside the standard web port."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1573.002"
    mitre_technique_name = "Encrypted Channel: Asymmetric Cryptography"
    log_prerequisites = "IDS/IPS or network security appliance telemetry normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip, target.port and network.application_protocol populated. Sensors must cover Linux server and workload segments; scope per client to those segments, since the sensor does not identify the OS."
    platform = "Linux"
    log_source = "ips"
    false_positives = "Linux hosts running legitimate TLS services on custom ports (package mirrors, container registries, VPN or SD-WAN agents, monitoring and telemetry agents, SaaS sync clients, git over HTTPS on alternate ports), and authorised vulnerability scanners."
    tuning_guidance = "Add approved scanner or source addresses to %global_allowed_scanners, known-good vendor and update destinations to %global_allowed_domains, and approved management sources to %global_allowed_mgmt_sources. Raise the #net threshold for noisy build or registry hosts. Extend the port exclusions in the rule if a client runs common TLS services on other ports."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.application_protocol = "HTTPS" nocase
    $net.target.port != 443
    $net.target.port != 8443
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains
    $net.principal.ip = $src

  match:
    $src over 10m

  outcome:
    $risk_score = max(if($net.target.port >= 1024, 65, 50))
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1573.002")
    $primary_entity = array_distinct($src)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 10
}
