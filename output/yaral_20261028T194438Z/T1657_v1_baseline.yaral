/*
  MITRE Technique : T1657 - Financial Theft
  Tactic(s)       : Impact
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:00:21.600423+00:00
  Reference       : https://attack.mitre.org/techniques/T1657
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1657_M365_Inbox_Rule_Financial_Keyword_Hide_Or_Forward {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of a mailbox inbox rule that matches financial keywords (invoice, payment, wire, bank, remittance and similar) and forwards, redirects, deletes or moves the matching mail. This is a core business email compromise (BEC) behaviour. After taking over an account, the attacker hides payment conversations from the victim while redirecting funds to attacker-controlled accounts."
    mitre_tactic = "Impact"
    mitre_technique = "T1657"
    mitre_technique_name = "Financial Theft"
    log_prerequisites = "Requires Microsoft 365 unified audit log ingestion with Exchange mailbox and admin audit events (New-InboxRule, Set-InboxRule, UpdateInboxRules) parsed to UDM. The serialized rule parameters (conditions and actions) must be mapped to target.resource.name. Validate this mapping against the client's parser before deployment."
    platform = "SaaS"
    log_source = "m365"
    false_positives = "Finance or accounts-payable staff who legitimately filter invoice mail into folders or forward it to a shared AP mailbox. Users who file newsletters or payment receipts into subfolders. Mail-flow automation set up by administrators or migration tooling."
    tuning_guidance = "Add approved automation and service identities to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. If the client's finance team routinely forwards invoice mail internally, extend the action regex to flag only external forwarding or deletion. Raise the risk score when the same user also has an anomalous sign-in."

  events:
    $audit.metadata.event_type = "SETTING_MODIFICATION"
    $audit.metadata.product_event_type = /^(New-InboxRule|Set-InboxRule|UpdateInboxRules)$/ nocase
    $audit.target.resource.name = /(invoice|payment|wire|bank|remittance|swift|iban|routing\s*number|account\s*number|purchase\s*order|payroll)/ nocase
    $audit.target.resource.name = /(ForwardTo|ForwardAsAttachmentTo|RedirectTo|DeleteMessage|MoveToFolder|SoftDeleteMessage|MarkAsRead)/ nocase
    $audit.principal.user.userid != ""
    not $audit.principal.user.userid in %global_allowed_service_accounts
    not $audit.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1657")
    $primary_entity = array_distinct($audit.principal.user.userid)
    $source_ips = array_distinct($audit.principal.ip)
    $rule_operation = array_distinct($audit.metadata.product_event_type)
    $rule_details = array_distinct($audit.target.resource.name)

  condition:
    $audit
}
