/*
  MITRE Technique : T1055.015 - ListPlanting
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:04:56.938641+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_015_ListPlanting_Unexpected_Parent_Spawns_Host_Or_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Process-lineage anomaly associated with ListPlanting staging. An Office application, web server worker, database service or print spooler launches a command shell, script interpreter or a GUI process that hosts a SysListView32 control (explorer, task manager, registry editor, MMC). ListPlanting injects code into list-view host processes, and injector stages commonly start from exploited or macro-driven parents like these. This rule does not observe the injection itself and is a lineage-based indicator that should be paired with process-injection or memory telemetry for confirmation."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.015"
    mitre_technique_name = "Process Injection: ListPlanting"
    log_prerequisites = "Windows endpoint process-creation telemetry with populated parent (principal.process) and child (target.process) image paths, from any EDR, Sysmon Event ID 1, or Windows Security Event 4688 with parent process logging."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros or add-ins that legitimately launch cmd or PowerShell (finance and reporting workbooks), SQL Server jobs that use xp_cmdshell, web applications that shell out for admin or deployment tasks, print spooler helper processes, and IT automation launched from Outlook or Office."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts, sanctioned management tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. To reduce noise from database or spooler parents, remove sqlservr or spoolsv from the parent regex per client. Use the parent_process and child_process outcome values to triage."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|w3wp|httpd|nginx|tomcat[0-9]*|sqlservr|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|explorer|taskmgr|regedit|mmc)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1055.015")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
