/*
  MITRE Technique : T1007 - System Service Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:15:27.805512+00:00
  Reference       : https://attack.mitre.org/techniques/T1007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1007_Linux_Service_Discovery_Then_Tmp_Staging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A shell or interpreter runs a service or scheduled-job enumeration command (systemctl list-units/list-unit-files/--type=service, service --status-all, chkconfig --list, crontab -l). Within 10 minutes the same host creates a file in a world-writable staging directory (/tmp, /var/tmp, /dev/shm) via a shell, downloader or interpreter. This pairing of discovery followed by staging is typical of automated post-exploitation and cryptominer or botnet installers that tailor their payload to the services found."
    mitre_tactic = "Discovery"
    mitre_technique = "T1007"
    mitre_technique_name = "System Service Discovery"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry that populates full command lines (PROCESS_LAUNCH), plus file creation telemetry (FILE_CREATION) with the creating process path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management runs (Ansible, Puppet, Chef, Salt) that check service state and write temp files; admins troubleshooting over SSH who then download or edit files in /tmp; package installers and post-install scripts; CI/CD build agents; monitoring or inventory scripts that run crontab -l and use temp files."
    tuning_guidance = "Add approved automation, deployment and inventory binaries to %global_allowed_admin_tools and approved script parents to %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts. To reduce noise further, restrict the staging event to executable-style file names or to the same user as the discovery event. To increase sensitivity, shorten the window or require two distinct discovery commands."

  events:
    $disc.metadata.event_type = "PROCESS_LAUNCH"
    $disc.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|python[0-9.]*|perl)$/ nocase
    (
      $disc.target.process.command_line = /\bsystemctl\b.*\b(list-units|list-unit-files|list-timers|--type=service)\b/ nocase or
      $disc.target.process.command_line = /\bservice\s+--status-all\b/ nocase or
      $disc.target.process.command_line = /\bchkconfig\s+--list\b/ nocase or
      $disc.target.process.command_line = /\bcrontab\s+-l\b/ nocase
    )
    not $disc.principal.process.file.full_path in %global_allowed_admin_tools
    not $disc.principal.process.file.full_path in %global_allowed_script_hosts
    not $disc.principal.user.userid in %global_allowed_service_accounts
    $disc.principal.hostname = $host

    $stage.metadata.event_type = "FILE_CREATION"
    $stage.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/./ nocase
    $stage.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|curl|wget|python[0-9.]*|perl)$/ nocase
    not $stage.principal.process.file.full_path in %global_allowed_admin_tools
    not $stage.principal.user.userid in %global_allowed_service_accounts
    $stage.principal.hostname = $host

    $disc.metadata.event_timestamp.seconds <= $stage.metadata.event_timestamp.seconds

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1007")
    $primary_entity = array_distinct($host)
    $discovery_commands = array_distinct($disc.target.process.command_line)
    $discovery_users = array_distinct($disc.principal.user.userid)
    $staged_files = array_distinct($stage.target.file.full_path)
    $staging_processes = array_distinct($stage.principal.process.file.full_path)
    $staged_file_count = count($stage.metadata.id)

  condition:
    $disc and $stage
}
