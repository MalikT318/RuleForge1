/*
  MITRE Technique : T1070.009 - Clear Persistence
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:12:49.244029+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_009_ESXi_Daemon_Parent_Spawns_Persistence_Cleanup {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi management or network daemon (hostd, vpxa, rhttpproxy, openwsmand, sfcbd, slpd, snmpd and similar) spawning a shell, interpreter or file/account removal utility that acts on persistence locations. Targeted locations include local.sh and rc.local.d, init.d, cron spool, SSH authorized_keys, bootbank/state archives, VIB removal and local account removal. Administrators normally run these cleanups from an interactive SSH or DCUI session, not from a service daemon. A daemon as the parent suggests exploitation of a management service or a webshell-style implant removing its own persistence artifacts."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.009"
    mitre_technique_name = "Indicator Removal: Clear Persistence"
    log_prerequisites = "ESXi shell and process execution logging forwarded to the SIEM with parent process path and child command line populated, normalised as PROCESS_LAUNCH."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Lifecycle or patching workflows run by management agents (for example VIB removal during an agent upgrade), vendor-supplied maintenance scripts launched by hostd, approved automation that decommissions local accounts through the management API, and configuration management tooling cleaning up startup scripts."
    tuning_guidance = "Add approved automation parent binaries to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Review hits where the parent is rhttpproxy or openwsmand first, as these are externally reachable. If hostd-driven upgrade scripts cause noise, scope the allowlist to those specific parent paths rather than removing the daemon from the parent regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(hostd|hostd-worker|vpxa|rhttpproxy|openwsmand|sfcbd|sfcb-[a-z0-9_-]+|slpd|snmpd|vmsyslogd|vmware-fdm|fdm)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|ash|bash|busybox|python[0-9.]*|perl|rm|sed|esxcli|crontab)$/ nocase
    $proc.target.process.command_line = /(\brm\b|\bsed\s+-i|\btruncate\b|\bcrontab\s+-r|>\s*\/etc\/|vib\s+remove|account\s+remove|\bunlink\b)/ nocase
    $proc.target.process.command_line = /(local\.sh|rc\.local\.d|\/etc\/init\.d|\/etc\/rc\.local|cron(tabs)?\/root|\/etc\/cron|authorized_keys|bootbank|state\.tgz|local\.tgz|\/etc\/vmware\/hostd|vib\s+remove|account\s+remove)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1070.009")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
