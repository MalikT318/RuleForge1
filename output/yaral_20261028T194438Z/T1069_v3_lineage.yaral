/*
  MITRE Technique : T1069 - Permission Groups Discovery
  Tactic(s)       : Discovery
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:55:50.681470+00:00
  Reference       : https://attack.mitre.org/techniques/T1069
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1069_Unexpected_Parent_Spawns_Group_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, script interpreter or built-in discovery utility performing group or permission enumeration when its parent is an Office application, web server worker, print spooler, database service or document reader. These parents do not normally enumerate local or domain groups, so this lineage points to macro, web shell, or exploited-service activity."
    mitre_tactic = "Discovery"
    mitre_technique = "T1069"
    mitre_technique_name = "Permission Groups Discovery"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent and child image paths and full command lines (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office add-ins or macros that query group membership for access checks, IIS or Tomcat applications that run group lookups for authorization, SQL Server jobs run through xp_cmdshell for admin tasks, and RMM or inventory agents launched from these parents."
    tuning_guidance = "Add legitimate parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts. Add known automation accounts to %global_allowed_service_accounts. Extend or narrow the parent regex to match the client's own web and database stack."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|acrord32|foxitreader|w3wp|httpd|nginx|tomcat\d*|php-cgi|sqlservr|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|net|net1|whoami|dsquery|nltest|wmic)\.exe$/ nocase
    $proc.target.process.command_line = /(\bnet1?(\.exe)?\s+(localgroup|group)\b|\bwhoami(\.exe)?\s+\/(groups|all|priv)|\bdsquery\b.*\bgroup\b|\bnltest\b.*\/(domain_trusts|dclist|dsgetdc)|get-(ad|local)group(member)?|win32_group(user)?|adsisearcher|directorysearcher|\bmemberof\b|domain admins|enterprise admins)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1069")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
