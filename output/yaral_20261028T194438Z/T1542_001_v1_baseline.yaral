/*
  MITRE Technique : T1542.001 - System Firmware
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:42:14.424378+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_001_Firmware_Transfer_TFTP_Network_Device {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects TFTP (port 69) connections seen at the network perimeter where neither endpoint is an approved management source. TFTP is the classic unauthenticated protocol for pushing or pulling network device firmware images and boot configurations, so this is the network-observable signal of a possible unauthorised firmware or bootloader replacement. It is a proxy for the transfer, not proof that firmware was flashed."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.001"
    mitre_technique_name = "Pre-OS Boot: System Firmware"
    log_prerequisites = "Requires firewall or perimeter connection and flow logs with source and destination IP and destination port populated, and a populated %global_allowed_mgmt_sources list for each client. Devices that transfer firmware across a monitored segment must be in scope."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate firmware upgrades staged from an unlisted admin workstation or TFTP server; PXE or network boot and zero-touch provisioning of new devices; lab or staging networks; automated configuration backup tools that use TFTP."
    tuning_guidance = "Add approved TFTP servers, jump hosts and provisioning systems to %global_allowed_mgmt_sources. Restrict the rule to the segments that carry device management traffic. For clients with no legitimate TFTP use, raise severity to Critical. Correlate hits with change tickets and device management-plane logs for firmware upgrade events."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1542.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
