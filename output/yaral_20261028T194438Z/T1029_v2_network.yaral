/*
  MITRE Technique : T1029 - Scheduled Transfer
  Tactic(s)       : Exfiltration
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:49:27.086878+00:00
  Reference       : https://attack.mitre.org/techniques/T1029
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1029_Linux_OffHours_Large_Outbound_Transfer_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects large outbound transfers to external destinations over file-transfer protocol ports (SSH/SCP/SFTP, FTP/FTPS, rsync) during off-hours. This is the network-side signature of data exfiltration scheduled via cron or systemd timers on Linux servers to blend in with quiet periods. Uses only perimeter telemetry (no process fields)."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1029"
    mitre_technique_name = "Scheduled Transfer"
    log_prerequisites = "Firewall, proxy or perimeter flow logs normalised to UDM NETWORK_CONNECTION with network.sent_bytes populated and target.ip/target.port present. Perimeter must see egress traffic from Linux server segments."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Off-hours offsite backups and replication (rsync/SFTP), log shipping, nightly vendor or partner file exchanges, mirror or repository synchronisation, scheduled managed-service data pulls, CI/CD artifact uploads."
    tuning_guidance = "Off-hours window is evaluated in UTC (22:00-04:59); adjust the hour bounds per client time zone. Raise or lower the sent_bytes threshold per client baseline. Add known-good partner or backup destinations to %global_allowed_domains. Scope to Linux server segments in the client's log-source or parser configuration, since firewall logs carry no OS information."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %rfc1918_internal
    (
      $net.target.port = 22 or
      $net.target.port = 2222 or
      $net.target.port = 21 or
      $net.target.port = 990 or
      $net.target.port = 873
    )
    $net.network.sent_bytes > 10000000
    (
      timestamp.get_hour($net.metadata.event_timestamp.seconds, "UTC") >= 22 or
      timestamp.get_hour($net.metadata.event_timestamp.seconds, "UTC") < 5
    )
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1029")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
