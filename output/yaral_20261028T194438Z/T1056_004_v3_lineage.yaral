/*
  MITRE Technique : T1056.004 - Credential API Hooking
  Tactic(s)       : Collection, Credential Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:51:17.278541+00:00
  Reference       : https://attack.mitre.org/techniques/T1056/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1056_004_Credential_Process_Anomalous_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects Windows credential-handling processes (lsass, LogonUI, CredentialUIBroker, consent) launched by a parent other than their expected OS parent. Credential API hooking and credential interception depend on running inside or impersonating these processes. A masqueraded, hollowed or relaunched copy with the wrong lineage is a strong indicator. This is a lineage-based detection and does not look at command lines."
    mitre_tactic = "Collection, Credential Access"
    mitre_technique = "T1056.004"
    mitre_technique_name = "Input Capture: Credential API Hooking"
    log_prerequisites = "Requires EDR or Sysmon process-creation telemetry (Sysmon Event ID 1 or equivalent) that populates both the parent (principal.process.file.full_path) and child (target.process.file.full_path) image paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "EDR/AV or forensic tooling that spawns or re-launches these binaries, some virtual desktop or remote session brokers that start LogonUI or consent through a non-standard parent, and debugging or test harnesses used by IT and developers. Telemetry that records a wrapper or session-manager parent instead of the real one can also trigger it."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools and legitimate admin or session tooling to %global_allowed_admin_tools. Validate that the client EDR records the true parent image for these four processes before deploying. Extend the expected-parent regexes only after confirming a benign lineage in the client's environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path != ""
    (
      (
        $proc.target.process.file.full_path = /\\lsass\.exe$/ nocase and
        not $proc.principal.process.file.full_path = /\\wininit\.exe$/ nocase
      ) or
      (
        $proc.target.process.file.full_path = /\\logonui\.exe$/ nocase and
        not $proc.principal.process.file.full_path = /\\winlogon\.exe$/ nocase
      ) or
      (
        $proc.target.process.file.full_path = /\\(credentialuibroker|consent)\.exe$/ nocase and
        not $proc.principal.process.file.full_path = /\\svchost\.exe$/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1056.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
