/*
  MITRE Technique : T1666 - Modify Cloud Resource Hierarchy
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:06:45.341258+00:00
  Reference       : https://attack.mitre.org/techniques/T1666
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1666_Cloud_Org_Hierarchy_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects configuration changes to the cloud resource hierarchy: an account leaving or being removed from an organization, organizational units or folders being created, moved or deleted, and management group or subscription re-parenting or tenant transfer. Adversaries use these changes to detach resources from central guardrails, logging and policy, or to hijack subscriptions. The rule works at the control-plane configuration layer, so it does not depend on endpoint command-line telemetry."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1666"
    mitre_technique_name = "Modify Cloud Resource Hierarchy"
    log_prerequisites = "Cloud control-plane audit logs (management or activity events, including organization, management group, subscription and folder or project operations) ingested and parsed into UDM with metadata.product_event_type and principal.user.userid populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Planned cloud landing-zone or account-vending automation, organization restructuring projects, merger and acquisition onboarding, subscription or project migrations, and cloud platform team administrators performing approved hierarchy changes."
    tuning_guidance = "Add approved administrator identities to %global_allowed_admin_users, and landing-zone, account-vending and IaC pipeline identities to %global_allowed_cloud_principals or %global_allowed_service_accounts. If a specific operation is too noisy in your environment, remove it from the product_event_type regex rather than allowlisting broad identities. Consider raising severity to Critical for LeaveOrganization and tenant-transfer operations."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /(LeaveOrganization|RemoveAccountFromOrganization|MoveAccount|CreateOrganizationalUnit|DeleteOrganizationalUnit|MoveProject|MoveFolder|DeleteFolder|managementGroups\/(subscriptions\/)?(write|delete)|subscriptions\/aliases\/write|changeTenantRequest)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1666")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_operations = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)
    $target_resources = array_distinct($cloud.target.resource.name)

  condition:
    $cloud
}
