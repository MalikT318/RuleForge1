/*
  MITRE Technique : T1567.002 - Exfiltration to Cloud Storage
  Tactic(s)       : Exfiltration
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:57:27.133589+00:00
  Reference       : https://attack.mitre.org/techniques/T1567/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_002_ESXi_Shell_Login_Then_External_HTTPS_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an interactive SSH or shell login to an ESXi host from a source outside the approved management sources, followed within 10 minutes by an outbound HTTPS connection from the same host to an external destination that is not a known-good domain. ESXi hosts rarely initiate internet connections of their own, so this sequence indicates possible staging and upload of VM or datastore data to a cloud storage service."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567.002"
    mitre_technique_name = "Exfiltration Over Web Service: Exfiltration to Cloud Storage"
    log_prerequisites = "Requires ESXi authentication logs (hostd/shell/SSH) normalised to USER_LOGIN, and outbound connection telemetry from the host (for example vmkernel firewall logging or forwarded flow data) normalised to NETWORK_CONNECTION. Both must carry the ESXi hostname."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators connecting over SSH from a non-allowlisted jump host while the host reaches vendor update or patch repositories, telemetry or licensing endpoints, vendor support uploads (log bundles), backup agents or monitoring agents using HTTPS to external endpoints."
    tuning_guidance = "Add jump hosts and bastion addresses to %global_allowed_mgmt_sources. Add admin accounts to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Add update, vendor and support domains to %global_allowed_domains. Add approved backup binaries to %global_allowed_backup_processes."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.application = /ssh|shell/ nocase
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.principal.user.userid in %global_allowed_admin_users
    not $auth.principal.user.userid in %global_allowed_service_accounts
    $auth.target.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 443
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    $net.principal.hostname = $hostname

    $auth.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1567.002")
    $primary_entity = array_distinct($hostname)
    $login_users = array_distinct($auth.principal.user.userid)
    $login_sources = array_distinct($auth.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $max_bytes_sent = max($net.network.sent_bytes)
    $connection_count = count($net.metadata.id)

  condition:
    $auth and $net
}
