/*
  MITRE Technique : T1567.002 - Exfiltration to Cloud Storage
  Tactic(s)       : Exfiltration
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:58:18.488166+00:00
  Reference       : https://attack.mitre.org/techniques/T1567/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_002_ESXi_Outbound_Firewall_Ruleset_Enabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi host configuration change that enables an outbound client firewall ruleset (HTTP/FTP/SSH client) or sets a ruleset to allow all IPs. ESXi blocks outbound web and file-transfer traffic by default, so opening these rulesets is a prerequisite for staging data to external cloud storage from the hypervisor. This rule covers the host configuration change itself rather than process command lines."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567.002"
    mitre_technique_name = "Exfiltration Over Web Service: Exfiltration to Cloud Storage"
    log_prerequisites = "ESXi hostd and shell logs forwarded to Chronicle and parsed into SETTING_MODIFICATION events, with the log message in metadata.description."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Planned patching or upgrades that use the HTTP client ruleset, backup or replication agents that need outbound access, authorised admins enabling outbound access for log shipping or content library sync, and host profile or automation remediation."
    tuning_guidance = "Add named administrators to %global_allowed_admin_users and automation or backup accounts to %global_allowed_service_accounts. Correlate with change tickets. If the firewall change message format differs in a tenant, adjust the regex on metadata.description."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.description = /firewall.*(rule\s?set|ruleset)/ nocase
    $setting.metadata.description = /(httpClient|ftpClient|sshClient|allowed[\s_-]?all)/ nocase
    $setting.metadata.description = /(enable|enabled|allowed[\s_-]?all)/ nocase
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1567.002")
    $primary_entity = array_distinct($setting.principal.hostname)
    $acting_user = array_distinct($setting.principal.user.userid)
    $change_detail = array_distinct($setting.metadata.description)

  condition:
    $setting
}
