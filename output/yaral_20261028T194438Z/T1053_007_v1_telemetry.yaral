/*
  MITRE Technique : T1053.007 - Container Orchestration Job
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:19:07.233493+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_007_K8s_CronJob_Resource_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a Kubernetes CronJob through the control-plane API. This is a configuration and state-change detection at the orchestration API layer, not a process or command-line detection. A newly created CronJob schedules recurring container execution and can give an adversary persistence and code execution on cluster nodes. It fires regardless of whether the CronJob was created with kubectl, a raw API call, a client library or a stolen service-account token."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.007"
    mitre_technique_name = "Scheduled Task/Job: Container Orchestration Job"
    log_prerequisites = "Requires Kubernetes control-plane audit logging enabled at Metadata level or higher, ingested and normalised to UDM RESOURCE_CREATION with the API request path populated in target.url and the caller identity in principal.user.userid."
    platform = "Containers"
    log_source = "container"
    false_positives = "CI/CD pipelines and GitOps controllers deploying scheduled workloads, platform teams deploying maintenance, backup or certificate-rotation CronJobs, Helm chart installs that include CronJobs, and operators that create CronJobs as part of their reconciliation."
    tuning_guidance = "Add GitOps, CI/CD and operator identities to %global_allowed_service_accounts, and named platform administrators to %global_allowed_admin_users. Review the namespace in the request path and consider raising severity for CronJobs created in kube-system or by identities that have never created one before."

  events:
    $k8s.metadata.event_type = "RESOURCE_CREATION"
    $k8s.target.url = /\/apis\/batch\/[^\/]+\/namespaces\/[^\/]+\/cronjobs/ nocase
    $k8s.principal.user.userid != ""
    not $k8s.principal.user.userid = /^system:(kube-|node:)/ nocase
    not $k8s.principal.user.userid in %global_allowed_service_accounts
    not $k8s.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1053.007")
    $primary_entity = array_distinct($k8s.principal.user.userid)
    $request_path = array_distinct($k8s.target.url)
    $source_ips = array_distinct($k8s.principal.ip)

  condition:
    $k8s
}
