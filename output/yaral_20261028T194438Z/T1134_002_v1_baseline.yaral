/*
  MITRE Technique : T1134.002 - Create Process with Token
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:54:52.090709+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_002_Runas_Alternate_Credential_Process_Launch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects runas.exe launching a process under another user's security context using /user: combined with /savecred (cached credentials) or /netonly (alternate network credentials). This is the built-in command-line path to CreateProcessWithLogonW/CreateProcessWithTokenW and is commonly used to escalate privileges or move laterally."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.002"
    mitre_technique_name = "Access Token Manipulation: Create Process with Token"
    log_prerequisites = "Requires EDR process telemetry, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators using runas /netonly to reach resources in another domain or forest, helpdesk staff running tools as a privileged account, legacy login scripts or shortcuts using /savecred, developers testing under service accounts."
    tuning_guidance = "Add approved admin tooling parents to %global_allowed_admin_tools, named administrators to %global_allowed_admin_users, and automation accounts to %global_allowed_service_accounts. If /netonly is too noisy for a client, require /savecred only. Raise severity when the launching host is a server or the target account is a privileged account."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\runas\.exe$/ nocase
    $proc.target.process.command_line = /\/user:/ nocase
    $proc.target.process.command_line = /\/(savecred|netonly)\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1134.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
