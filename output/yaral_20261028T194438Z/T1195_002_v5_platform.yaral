/*
  MITRE Technique : T1195.002 - Compromise Software Supply Chain
  Tactic(s)       : Initial Access
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:43:00.131855+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_002_Windows_Updater_Installer_Download_Untrusted_Domain {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows-native updater or installer client (BITS, WinHTTP, Windows Update Agent, Windows Installer) downloading an executable installer package (.exe, .msi, .msp, .msix, .appx) from an external host that is not in the known-good domain list. This is the network-observable result of a compromised update or distribution channel delivering a trojanised release. Rule intent: the Windows platform requirement is mandatory, so the 'alternate platform' angle could not be applied; this rule is Windows-only and has no endpoint process fields."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.002"
    mitre_technique_name = "Supply Chain Compromise: Compromise Software Supply Chain"
    log_prerequisites = "Requires firewall or proxy logs with HTTP inspection (full URL, host and user-agent) normalised to NETWORK_HTTP. HTTPS traffic must be decrypted or the URL and user-agent will not be populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate software vendors whose update CDNs are missing from the allowlist, new or rarely used vendor download hosts, IT-approved software deployment from external mirrors, and Windows Update or Delivery Optimization peers hosted on uncommon domains."
    tuning_guidance = "Add known-good vendor and CDN domains to %global_allowed_domains. Entries must match target.hostname exactly, so list the full update hostnames. Internal destinations are already excluded through %rfc1918_internal. Review the source host and URL in the first week, then promote confirmed vendor update hosts to the allowlist."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /(bits|winhttp|windows-update-agent|windows installer|delivery-optimization|cryptoapi)/ nocase
    $net.target.url = /\.(exe|msi|msp|msix|msixbundle|appx|appxbundle)(\?.*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1195.002")
    $primary_entity = array_distinct($net.principal.ip)
    $download_urls = array_distinct($net.target.url)
    $download_hosts = array_distinct($net.target.hostname)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
