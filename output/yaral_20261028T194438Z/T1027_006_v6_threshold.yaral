/*
  MITRE Technique : T1027.006 - HTML Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:48:08.102850+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_006_Linux_Client_Bulk_HTML_Fetch_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single Linux client (identified by browser user agent) fetches many HTML-type documents from external, non-allowlisted destinations within 10 minutes. HTML smuggling lands the payload inside an HTML or SVG document, so the network-visible footprint is a burst of HTML retrievals followed by a client-side file build. Each fetch is benign on its own; the volume from one source is the signal. This is a low-fidelity hunting-grade detection that should be correlated with endpoint file-creation telemetry."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.006"
    mitre_technique_name = "Obfuscated Files or Information: HTML Smuggling"
    log_prerequisites = "Requires proxy or firewall logs normalised to NETWORK_HTTP with populated principal.ip, target.url and network.http.user_agent (TLS inspection or explicit proxy needed for URL visibility)."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Developers and analysts browsing documentation sites, web scraping or link-checking jobs run from a browser-like user agent, internal portals fronted by an external CDN, and webmail or SaaS applications that serve .html resources."
    tuning_guidance = "Add known-good external domains (CDNs, vendors, documentation sites) to %global_allowed_domains. Raise the #http threshold on noisy developer subnets. Add authorised crawlers or scanners to %global_allowed_scanners. Pair alerts with endpoint FILE_CREATION events in the user Downloads or /tmp directories for confirmation."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.principal.ip = $src_ip
    $http.target.url = /\.(html?|xhtml|shtml|svg)(\?.*)?$/ nocase
    $http.network.http.user_agent = /\(X11;[^)]*Linux/ nocase
    not $http.network.http.user_agent = /Android/ nocase
    $http.network.http.response_code = 200
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1027.006")
    $primary_entity = array_distinct($src_ip)
    $event_count = count($http.metadata.id)
    $distinct_domains = array_distinct($http.target.hostname)
    $sample_urls = array_distinct($http.target.url)

  condition:
    #http >= 8
}
