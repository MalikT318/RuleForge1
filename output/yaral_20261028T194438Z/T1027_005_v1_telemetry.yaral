/*
  MITRE Technique : T1027.005 - Indicator Removal from Tools
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:44:49.857735+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_005_Linux_Staged_Binary_Altered_By_Binary_Manipulation_Tool {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a file in a world-writable staging directory (/tmp, /var/tmp, /dev/shm) being modified by a binary-manipulation utility such as strip, objcopy, patchelf, upx, dd or a hex editor. Adversaries use these to alter a detected or quarantined payload so it no longer matches AV/EDR signatures. The rule keys on the resulting file-modification event, so it still fires if command-line logging is evaded. It is not a process-creation or command-line rule."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.005"
    mitre_technique_name = "Obfuscated Files or Information: Indicator Removal from Tools"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd (watch rules on /tmp, /var/tmp, /dev/shm) that populates the writing process path (principal.process.file.full_path) on FILE_MODIFICATION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers and build pipelines running strip/objcopy/patchelf on compiled artifacts in /tmp; packaging and CI jobs; software installers that repack binaries in temp directories; dd used for disk or image work in /tmp or /dev/shm."
    tuning_guidance = "Add approved build, packaging and deployment tooling to %global_allowed_admin_tools. Add imaging and backup software to %global_allowed_backup_processes. Add CI/build service accounts to %global_allowed_service_accounts. Add EDR/AV agents to %global_allowed_security_tools. Extend the file-extension exclusion if noisy non-executable artifacts appear."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    $file.principal.process.file.full_path = /\/(strip|sstrip|objcopy|patchelf|upx|dd|truncate|xxd|hexedit|bbe|ghex)$/ nocase
    not $file.target.file.full_path = /\.(log|txt|json|conf|cfg|out|csv|pid|lock|swp)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
