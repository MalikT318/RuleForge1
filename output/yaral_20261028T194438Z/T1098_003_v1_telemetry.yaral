/*
  MITRE Technique : T1098.003 - Additional Cloud Roles
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:43:51.974138+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_003_Cloud_IAM_Role_Policy_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a control-plane configuration change that grants additional roles or permissions inside a cloud tenant. Covers attaching or embedding IAM policies, publishing or promoting a policy version, changing a role trust policy, adding a user to a group, and writing role assignments or IAM bindings. Because it keys on the resulting permission state change rather than any CLI, SDK or console command line, it still fires however the API call is made."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.003"
    mitre_technique_name = "Account Manipulation: Additional Cloud Roles"
    log_prerequisites = "Cloud control-plane audit logging must be enabled and ingested with management (write) events, normalized to UDM with metadata.product_event_type populated with the API operation name."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Infrastructure-as-code pipelines and CI/CD deployment roles, cloud landing-zone and account-vending automation, identity governance or access-request tooling, planned admin onboarding and offboarding, and break-glass access during incidents."
    tuning_guidance = "Add pipeline and automation identities to %global_allowed_service_accounts, approved administrators to %global_allowed_admin_users, and approved service principals to %global_allowed_cloud_principals. If volume is still high, restrict the operation regex to the highest-risk actions (policy version changes, trust policy updates, role assignment writes). Any change made by a user created within the last 24 hours deserves priority review."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /^(Attach(User|Role|Group)Policy|Put(User|Role|Group)Policy|CreatePolicyVersion|SetDefaultPolicyVersion|UpdateAssumeRolePolicy|AddUserToGroup|SetIamPolicy|Microsoft\.Authorization\/roleAssignments\/write)$/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1098.003")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_operation = array_distinct($cloud.metadata.product_event_type)
    $target_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
