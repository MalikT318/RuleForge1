/*
  MITRE Technique : T1112 - Modify Registry
  Tactic(s)       : Defense Impairment, Persistence
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:13:43.762403+00:00
  Reference       : https://attack.mitre.org/techniques/T1112
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1112_Registry_Defense_Impairment_Volume_Per_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of registry modifications on a single host within 10 minutes that touch defense-relevant configuration. Targets include Defender policy and exclusions, UAC policy, WDigest and LSA protection, Office macro security, Image File Execution Options, and RDP enablement. Any single change can be legitimate administration, but several across these areas in a short window is characteristic of an adversary impairing defenses or setting up persistence through registry edits. Complements process command-line rules because it works from registry telemetry regardless of which tool or API made the change."
    mitre_tactic = "Defense Impairment, Persistence"
    mitre_technique = "T1112"
    mitre_technique_name = "Modify Registry"
    log_prerequisites = "Requires Windows registry modification telemetry (EDR or Sysmon registry events 12/13/14, normalised to REGISTRY_MODIFICATION) with target.registry.registry_key and principal.hostname populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy application, endpoint management and RMM agents, security product installers and updaters, OS feature updates and servicing, golden image or build scripts, administrators hardening or reconfiguring a host, Office deployment and configuration tooling."
    tuning_guidance = "Add approved deployment and management binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Add automation accounts to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Raise the #reg threshold for noisy environments such as VDI build pools, or lower it for high-value servers."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(\\Policies\\Microsoft\\Windows Defender|\\Microsoft\\Windows Defender\\(Real-Time Protection|Exclusions|Features|Spynet)|\\Policies\\Microsoft\\Windows\\System|\\Microsoft\\Windows\\CurrentVersion\\Policies\\System|\\Control\\SecurityProviders\\WDigest|\\Control\\Lsa|\\Office\\[0-9.]+\\[^\\]+\\Security|\\Windows NT\\CurrentVersion\\Image File Execution Options|\\Control\\Terminal Server|\\Policies\\Microsoft\\Windows\\WindowsUpdate|\\Microsoft\\Security Center)/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|MpCmdRun|TrustedInstaller|TiWorker)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    not $reg.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1112")
    $primary_entity = array_distinct($host)
    $event_count = count($reg.metadata.id)
    $distinct_keys = count_distinct($reg.target.registry.registry_key)
    $modified_keys = array_distinct($reg.target.registry.registry_key)
    $value_names = array_distinct($reg.target.registry.registry_value_name)
    $acting_processes = array_distinct($reg.principal.process.file.full_path)
    $acting_users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 4
}
