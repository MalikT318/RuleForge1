/*
  MITRE Technique : T1218.015 - Electron Applications
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:03:17.966101+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_015_Electron_App_Package_Tampering_By_Script_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of an Electron application's resources\\app.asar archive or unpacked resources\\app JavaScript/HTML files by a script interpreter or LOLBin. Writing to these files plants malicious JavaScript that runs inside a trusted, signed Electron host such as a chat or collaboration client. This is a file-integrity detection and does not depend on process command lines, so it complements command-line rules. Because the Windows platform is mandatory for this deliverable, the alternate-platform angle was applied as a different telemetry mechanism (file modification) rather than a non-Windows OS."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.015"
    mitre_technique_name = "System Binary Proxy Execution: Electron Applications"
    log_prerequisites = "Requires EDR or Sysmon file-modification telemetry (Sysmon Event ID 11/23 equivalent) with the writing process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developers building or repackaging Electron apps with node or npm tooling, software deployment scripts that patch or customise Electron apps, IT packaging workflows, and legitimate app updaters launched through script hosts."
    tuning_guidance = "Add approved packaging or deployment tooling to %global_allowed_admin_tools, approved script-running hosts and parents to %global_allowed_script_hosts, and EDR agents to %global_allowed_security_tools. On developer workstations, scope out build hosts through %global_allowed_script_hosts."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\\resources\\(app\.asar|app\\.+\.(js|mjs|cjs|html))$/ nocase
    $file.principal.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32|node|python[0-9.]*|bitsadmin|certutil|curl)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1218.015")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
