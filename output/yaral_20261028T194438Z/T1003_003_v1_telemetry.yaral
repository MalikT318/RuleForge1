/*
  MITRE Technique : T1003.003 - NTDS
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:40:35.604362+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_003_NTDS_Database_Copy_File_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of an Active Directory database file (ntds.dit) outside the default NTDS directory. This is the file artifact left by Volume Shadow Copy extraction, ntdsutil IFM media creation, and raw-volume copy methods, whatever tool or command line was used. It is detected at the file layer, so it does not depend on command-line logging."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.003"
    mitre_technique_name = "OS Credential Dumping: NTDS"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) that populates target.file.full_path and the writing process path. Ideally enabled on domain controllers and on servers or workstations where staging may occur."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "AD backup and recovery software restoring or staging ntds.dit; authorised IFM media creation for offline domain controller promotion; AD disaster-recovery tests; AD health or migration tooling copying the database; the legitimate creation of ntds.dit in the default directory during DC promotion is excluded."
    tuning_guidance = "Add approved backup or imaging agents to %global_allowed_backup_processes and approved AD administration tooling to %global_allowed_admin_tools. If DC promotion is performed from non-standard paths, scope an exception by host. Consider alerting separately on ntds.dit files created on non-DC hosts, which are higher fidelity."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\ntds(_[^\\]*)?\.dit$/ nocase
    not $file.target.file.full_path = /^[a-z]:\\windows\\ntds\\[^\\]+$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1003.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
