/*
  MITRE Technique : T1202 - Indirect Command Execution
  Tactic(s)       : Stealth
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:54:37.416871+00:00
  Reference       : https://attack.mitre.org/techniques/T1202
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1202_Indirect_Exec_Utility_Spawns_Interpreter_Then_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A built-in utility that can execute commands indirectly (forfiles /c, pcalua -a, scriptrunner -appvscript, or ssh -o ProxyCommand/LocalCommand) spawns a script interpreter or proxy-execution binary. That same spawned process then makes an outbound connection to a non-internal address within 10 minutes. This points to command execution that bypasses cmd/PowerShell restrictions and then reaches out for staging or C2."
    mitre_tactic = "Stealth"
    mitre_technique = "T1202"
    mitre_technique_name = "Indirect Command Execution"
    log_prerequisites = "Requires EDR or Sysmon process launch telemetry with parent process command line, and network connection telemetry with the originating process path and PID, from the same endpoint sensor."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin or logon scripts using forfiles for batch file operations that then download content; application compatibility tooling (pcalua) launching installers that phone home; App-V deployment using scriptrunner; developers using ssh ProxyCommand or LocalCommand for jump hosts and git tunnelling; RMM or software deployment tooling."
    tuning_guidance = "Add approved automation accounts to %global_allowed_service_accounts and approved deployment or RMM interpreters to %global_allowed_admin_tools. Add known-good destinations to %global_allowed_domains where destination hostnames are populated. If PID is not populated on network events for a client, remove the pid join and rely on the hostname join, accepting lower precision. Developer-heavy tenants may need to narrow the ssh branch."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(forfiles|pcalua|scriptrunner|ssh)\.exe$/ nocase
    $proc.principal.process.command_line = /(forfiles(\.exe)?"?\s.*\/c\s|pcalua(\.exe)?"?\s.*-a\s*\S|scriptrunner(\.exe)?"?\s.*-appvscript|ssh(\.exe)?"?\s.*-o\s*"?(proxycommand|localcommand))/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|mshta|wscript|cscript|rundll32|regsvr32|msiexec|certutil|bitsadmin)\.exe$/ nocase
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname
    $proc.target.process.pid = $pid

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(cmd|powershell|pwsh|mshta|wscript|cscript|rundll32|regsvr32|msiexec|certutil|bitsadmin)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    $net.principal.hostname = $hostname
    $net.principal.process.pid = $pid

    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $pid over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1202")
    $primary_entity = array_distinct($hostname)
    $launcher_utility = array_distinct($proc.principal.process.file.full_path)
    $launcher_command_line = array_distinct($proc.principal.process.command_line)
    $spawned_process = array_distinct($proc.target.process.file.full_path)
    $spawned_command_line = array_distinct($proc.target.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc and $net
}
