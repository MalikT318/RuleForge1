/*
  MITRE Technique : T1563 - Remote Service Session Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:07:18.585752+00:00
  Reference       : https://attack.mitre.org/techniques/T1563
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_Linux_Internal_Remote_Session_Lateral_SSH_Telnet {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects east-west SSH or telnet connections between internal addresses from a source that is not an approved management source. Hijacked SSH sessions (agent forwarding abuse, ControlMaster socket reuse, a compromised jump host) appear on the perimeter as interactive remote-service traffic originating from hosts that do not normally administer other servers. This is a network-level proxy for T1563.001. The firewall cannot see the session itself, so the rule flags unexpected lateral remote-service paths for triage."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1563"
    mitre_technique_name = "Remote Service Session Hijacking"
    log_prerequisites = "Requires firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with internal east-west traffic visibility (internal segmentation firewalls or flow logging between server VLANs). The rule is blind to traffic that never crosses a logging enforcement point."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Administrators connecting from workstations not yet in the management-source list, bastion and jump hosts, configuration management and orchestration servers, backup and monitoring systems that use SSH, developer pipelines deploying over SSH, and legitimate server-to-server SSH or rsync jobs."
    tuning_guidance = "Add bastion hosts, jump servers, automation controllers and admin subnets to %global_allowed_mgmt_sources. Add authorised scanning hosts to %global_allowed_scanners. Ensure %rfc1918_internal covers the tenant's internal ranges. For noisy environments, raise severity only for sources that are themselves servers, or pair this rule with endpoint SSH-agent and socket-access detections."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 22 or $net.target.port = 23)
    $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1563")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
