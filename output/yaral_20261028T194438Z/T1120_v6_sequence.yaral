/*
  MITRE Technique : T1120 - Peripheral Device Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:28:15.938262+00:00
  Reference       : https://attack.mitre.org/techniques/T1120
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1120_Linux_Peripheral_Enumeration_Sequence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Low"
    description = "Detects a Linux host running a hardware enumeration utility (USB, PCI or hardware listing) followed within ten minutes by a second, different peripheral discovery action, such as reading USB, input or disk device nodes, querying udev, or listing cameras or printers. Two separate discovery methods on one host in a short window indicate deliberate peripheral reconnaissance rather than a single routine lookup."
    mitre_tactic = "Discovery"
    mitre_technique = "T1120"
    mitre_technique_name = "Peripheral Device Discovery"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records normalised to UDM PROCESS_LAUNCH with populated target.process.file.full_path, target.process.command_line and principal.hostname."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "System administrators troubleshooting hardware, configuration management and inventory agents, hardware inventory and asset tooling, desktop environments and udev helper scripts, provisioning and imaging scripts, and driver or kernel module installers."
    tuning_guidance = "Add inventory, configuration management and RMM binaries to %global_allowed_admin_tools. Add trusted automation accounts to %global_allowed_service_accounts. Add EDR and monitoring agents to %global_allowed_security_tools. If noise remains on servers, restrict the rule to interactive or non-root users, or raise the risk score only when the parent process is a shell or script interpreter."

  events:
    $enum.metadata.event_type = "PROCESS_LAUNCH"
    $enum.target.process.file.full_path = /\/(lsusb|lspci|lshw|usb-devices|hwinfo)$/ nocase
    not $enum.principal.process.file.full_path in %global_allowed_admin_tools
    not $enum.principal.process.file.full_path in %global_allowed_security_tools
    not $enum.principal.user.userid in %global_allowed_service_accounts
    $enum.principal.hostname = $hostname

    $probe.metadata.event_type = "PROCESS_LAUNCH"
    not $probe.target.process.file.full_path = /\/(lsusb|lspci|lshw|usb-devices|hwinfo)$/ nocase
    $probe.target.process.command_line = /(\/sys\/bus\/usb|\/proc\/bus\/(usb|input)|\/dev\/disk\/by-id|udevadm\s+(info|trigger|monitor)|v4l2-ctl\s+.*--list-devices|lpstat\s+-[a-z]*v|dmesg.*(usb|input|hid)|\blsblk\b|\bblkid\b|\bsmartctl\s+--scan)/ nocase
    not $probe.principal.process.file.full_path in %global_allowed_admin_tools
    not $probe.principal.process.file.full_path in %global_allowed_security_tools
    not $probe.principal.user.userid in %global_allowed_service_accounts
    $probe.principal.hostname = $hostname

    $enum.metadata.event_timestamp.seconds <= $probe.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1120")
    $primary_entity = array_distinct($hostname)
    $enum_commands = array_distinct($enum.target.process.command_line)
    $probe_commands = array_distinct($probe.target.process.command_line)
    $users = array_distinct($probe.principal.user.userid)
    $first_seen = min($enum.metadata.event_timestamp.seconds)
    $last_seen = max($probe.metadata.event_timestamp.seconds)

  condition:
    $enum and $probe
}
