/*
  MITRE Technique : T1091 - Replication Through Removable Media
  Tactic(s)       : Lateral Movement, Initial Access
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:35:08.075686+00:00
  Reference       : https://attack.mitre.org/techniques/T1091
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1091_Bulk_Executable_Writes_To_NonSystem_Drive {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of executable, script, shortcut or autorun.inf file creations on a non-system drive letter (D: to Z:) on a single host within 10 minutes. Staging many executable payloads or an autorun.inf onto removable media is consistent with replication through removable media. One such write is benign; the volume is the signal."
    mitre_tactic = "Lateral Movement, Initial Access"
    mitre_technique = "T1091"
    mitre_technique_name = "Replication Through Removable Media"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating target.file.full_path and principal.hostname. Drive-type context is not required; the rule uses drive letters other than C: as a proxy for removable or secondary volumes."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and imaging software restoring files to secondary volumes, software deployment or build jobs writing to data drives, developers compiling to non-system partitions, administrators copying installers or tool kits to USB drives or secondary disks, and users syncing portable applications to a USB stick."
    tuning_guidance = "Add approved backup or imaging processes to %global_allowed_backup_processes, deployment and build tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. If a client has fixed data drives that receive frequent executable writes, raise the threshold from 10 or narrow the drive-letter range. Review $written_paths and $writing_processes in the outcome to confirm whether the target volume is removable."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^[d-z]:\\.*(autorun\.inf|\.(exe|scr|dll|lnk|vbs|vbe|js|jse|hta|bat|cmd|ps1|cpl))$/ nocase
    not $file.target.file.full_path = /\\(\$recycle\.bin|system volume information)\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $event_count = count($file.metadata.id)
    $risk_score = max(if(count($file.metadata.id) >= 25, 80, 55))
    $mitre_technique_id = array_distinct("T1091")
    $primary_entity = array_distinct($host)
    $written_paths = array_distinct($file.target.file.full_path)
    $writing_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 10
}
