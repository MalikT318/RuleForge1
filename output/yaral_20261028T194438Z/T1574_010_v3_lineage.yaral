/*
  MITRE Technique : T1574.010 - Services File Permissions Weakness
  Tactic(s)       : Stealth, Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:39:52.585247+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_010_Services_Spawning_Anomalous_Child {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Windows Service Control Manager (services.exe) launching a child process that is either a shell/script interpreter or an executable located in a user-writable directory. A legitimate service binary normally lives in a protected location. This lineage is a strong result-based indicator that a service binary was replaced or hijacked through weak file or folder permissions and is now executing with service-account privileges, often SYSTEM."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.010"
    mitre_technique_name = "Hijack Execution Flow: Services File Permissions Weakness"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path populated (EDR, Sysmon Event ID 1, or Security Event 4688 with parent process)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Third-party software whose services run from ProgramData or AppData (collaboration clients, browser updaters, developer tooling); remote execution tools that create a service which starts cmd.exe or powershell.exe; software installers and uninstallers that use a service to run a script; legitimate vendor services that wrap batch files."
    tuning_guidance = "Add approved service binaries and their vendors to %global_allowed_admin_tools and EDR/AV engines to %global_allowed_security_tools; both lists are matched against the child process path. Add the executable name to the name-based exclusion regex rather than a directory path. Review recurring hits to confirm whether the folder ACLs permit non-admin writes, since that is the underlying weakness."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\windows\\system32\\services\.exe$/ nocase
    (
      $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase or
      $proc.target.process.file.full_path = /\\users\\[^\\]+\\(appdata|downloads|desktop|documents)\\/ nocase or
      $proc.target.process.file.full_path = /\\users\\public\\/ nocase or
      $proc.target.process.file.full_path = /\\programdata\\/ nocase or
      $proc.target.process.file.full_path = /\\(windows\\)?temp\\/ nocase or
      $proc.target.process.file.full_path = /\\\$recycle\.bin\\/ nocase
    )
    not $proc.target.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|NisSrv)\.exe$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1574.010")
    $primary_entity = array_distinct($proc.principal.hostname)
    $child_process_path = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
