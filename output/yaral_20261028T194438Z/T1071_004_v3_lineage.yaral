/*
  MITRE Technique : T1071.004 - DNS
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:09:40.541663+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_004_Linux_Service_Parent_Spawns_DNS_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, database or cache daemon directly launching a DNS query utility (dig, nslookup, host, drill, resolvectl). These service processes resolve names through libc and do not normally exec resolver utilities. This lineage anomaly is typical of a webshell, injected code or database command execution being used for DNS-based C2, tunnelling or data exfiltration. The rule keys on parent-child process lineage rather than command-line content. The direct parent is the only lineage visible, so an intermediate shell (daemon > sh > dig) is not covered here."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.004"
    mitre_technique_name = "Application Layer Protocol: DNS"
    log_prerequisites = "Linux endpoint process-creation telemetry (EDR or auditd execve) populating parent and child process paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web applications or health-check scripts that deliberately shell out to dig or nslookup for DNS diagnostics, database maintenance jobs or stored procedures calling host lookups, monitoring plugins launched by a daemon, and admin troubleshooting through a web-based management panel."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts. Add known scanner sources to %global_allowed_scanners. If a specific application legitimately runs DNS checks, exclude its parent path rather than loosening the child pattern."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9.]*|mysqld|mariadbd|postgres|mongod|redis-server|memcached)$/ nocase
    $proc.target.process.file.full_path = /\/(dig|nslookup|host|drill|resolvectl|systemd-resolve)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1071.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
