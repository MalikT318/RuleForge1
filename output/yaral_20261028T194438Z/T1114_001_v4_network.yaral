/*
  MITRE Technique : T1114.001 - Local Email Collection
  Tactic(s)       : Collection
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:18:22.570899+00:00
  Reference       : https://attack.mitre.org/techniques/T1114/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_001_Outlook_Data_File_Network_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an HTTP request to an external destination where the URL references an Outlook data file (.pst or .ost). Email archives are normally not sent over HTTP by endpoint processes, so this indicates staging or exfiltration of locally collected email. Complements endpoint file-access coverage by observing the network side of the collection."
    mitre_tactic = "Collection"
    mitre_technique = "T1114.001"
    mitre_technique_name = "Email Collection: Local Email Collection"
    log_prerequisites = "Requires endpoint network telemetry (EDR or Sysmon-equivalent) normalised to UDM NETWORK_HTTP with target.url populated, and principal.hostname populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Users uploading a PST archive to approved cloud storage or a migration portal, mailbox migration or eDiscovery tooling, backup agents that copy Outlook data files, and helpdesk staff transferring archives during device refresh."
    tuning_guidance = "Add approved backup and imaging processes to %global_allowed_backup_processes, add approved migration or storage domains to %global_allowed_domains, and add sanctioned IT tooling to %global_allowed_admin_tools. Scope severity by whether the source process is a script host or archiver rather than a browser."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\.(pst|ost)([?#;]|$)/ nocase
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1114.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_user = array_distinct($net.principal.user.userid)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
