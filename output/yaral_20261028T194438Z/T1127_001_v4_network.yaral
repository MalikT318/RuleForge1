/*
  MITRE Technique : T1127.001 - MSBuild
  Tactic(s)       : Stealth, Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:37:41.383095+00:00
  Reference       : https://attack.mitre.org/techniques/T1127/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1127_001_MSBuild_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects MSBuild.exe initiating an outbound network connection to a non-internal address. Legitimate builds are mostly local, so an external connection from the build engine suggests an inline task or project file fetching a payload, staging data, or beaconing to C2. This is a network-side detection and does not depend on command-line matching."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1127.001"
    mitre_technique_name = "Trusted Developer Utilities Proxy Execution: MSBuild"
    log_prerequisites = "Requires endpoint network telemetry that attributes each connection to the initiating process (EDR network events or Sysmon Event ID 3) and populates principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developer workstations and build servers restoring NuGet packages or downloading SDK components, CI/CD agents pulling dependencies, Visual Studio telemetry or licensing checks, and build tasks that publish artifacts to external repositories."
    tuning_guidance = "Add build servers and developer hosts to %global_allowed_script_hosts. Add known-good package and vendor domains to %global_allowed_domains. Add approved build-automation service accounts to %global_allowed_service_accounts. Consider raising severity on hosts that are not developer or build systems."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\msbuild\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1127.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ports = array_distinct($net.target.port)
    $source_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
