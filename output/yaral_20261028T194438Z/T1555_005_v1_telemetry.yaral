/*
  MITRE Technique : T1555.005 - Password Managers
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:58:59.037699+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_005_Linux_Password_Vault_Staged_In_Temp_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a password manager vault or database file (KeePass, Password Safe, 1Password, Enpass and similar formats) in a world-writable or volatile staging location such as /tmp, /var/tmp, /dev/shm or /run/user. Legitimate vault use rarely writes these files to temporary paths, so this artifact indicates the vault was copied for offline cracking or exfiltration. It is detected at the file-state layer and does not depend on command-line logging."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.005"
    mitre_technique_name = "Credentials from Password Stores: Password Managers"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-write/create rules normalised to UDM FILE_CREATION, with target.file.full_path and principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Users or admins temporarily copying or converting a vault to move it between machines, password manager sync or import/export utilities writing temp files, backup or imaging jobs staging files under /tmp, and help-desk vault recovery."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes and sanctioned sync, migration or IT tooling to %global_allowed_admin_tools. Extend the extension list for vault formats used in the customer environment, or the directory list for additional staging paths."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/user\/[0-9]+|var\/spool)\/.*\.(kdbx?|psafe3|1pif|opvault|agilekeychain|enpassdb|walletx)$/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1555.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $vault_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
