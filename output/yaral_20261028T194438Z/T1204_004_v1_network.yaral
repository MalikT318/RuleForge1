/*
  MITRE Technique : T1204.004 - Malicious Copy and Paste
  Tactic(s)       : Execution
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:03:57.103547+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_004_Linux_ClickFix_Script_Fetch_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Network-side detection of the Linux ClickFix pattern. A host fetches a shell or script payload from an external destination using a command-line HTTP client user-agent (curl, wget, fetch, python-requests), as happens when a user pastes a 'curl ... | bash' one-liner from a fake CAPTCHA or error page. Observed in proxy or firewall HTTP logs, with no dependency on endpoint process fields."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.004"
    mitre_technique_name = "User Execution: Malicious Copy and Paste"
    log_prerequisites = "Requires proxy or firewall HTTP logging (TLS-inspected or cleartext) that populates network.http.user_agent and target.url, normalised to NETWORK_HTTP."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Developers and admins installing software with curl/wget from external sites, package bootstrap scripts, CI/CD runners, configuration management agents, and vendor installers fetched via one-liners."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains. Add build servers, jump hosts and automation hosts to %global_allowed_script_hosts. Limit scope to end-user workstation subnets if server fleets are noisy. Without TLS inspection, user-agent and URL are not visible and the rule will not fire."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /^(curl|wget|fetch|python-requests|python-urllib|libwww-perl)\b/ nocase
    $net.target.url = /(\.(sh|bash|py|pl)(\?.*)?$|\/(verify|captcha|fix|recaptcha|human|robot|install|update|setup)[^\/]*$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1204.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
