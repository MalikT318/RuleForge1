/*
  MITRE Technique : T1563.001 - SSH Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:08:54.349970+00:00
  Reference       : https://attack.mitre.org/techniques/T1563/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_001_Outbound_SSH_To_External_From_Internal_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host opening an SSH (TCP/22) connection to an external, non-internal destination. A firewall cannot see SSH agent hijacking itself. This rule flags the network-side outcome: a compromised Linux host reusing a victim's forwarded agent or socket to pivot to a remote system. Server-class hosts rarely initiate outbound SSH to the internet, so the event is worth triage."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1563.001"
    mitre_technique_name = "Remote Service Session Hijacking: SSH Hijacking"
    log_prerequisites = "Requires firewall, proxy or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated for egress traffic. Endpoint telemetry is not required."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Developers or CI/CD runners using git over SSH to hosted repositories, administrators managing cloud VMs or partner systems from approved bastions, managed file-transfer (SFTP/rsync over SSH) to vendors, and automated backup or configuration-sync jobs."
    tuning_guidance = "Add bastion, jump host and approved admin source addresses to %global_allowed_mgmt_sources. Add known-good external SSH endpoints (for example code-hosting or vendor SFTP hostnames) to %global_allowed_domains. Scope the rule to server subnets at the tenant level if developer workstation noise is high. Raise severity for production server segments."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 22
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1563.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
