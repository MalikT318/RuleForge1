/*
  MITRE Technique : T1572 - Protocol Tunneling
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:19:17.873411+00:00
  Reference       : https://attack.mitre.org/techniques/T1572
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1572_Linux_DNS_Tunnel_Pattern_Then_Direct_External_Resolver {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A single internal source emits DNS queries with very long, encoded-looking labels (typical of DNS tunnelling) and then, within ten minutes, connects directly to an external address on port 53 or 853, bypassing the internal resolver. The two together indicate data encapsulated in DNS or DNS-over-TLS toward attacker-controlled infrastructure. Detection is purely network-observable and relies on perimeter telemetry, so it covers Linux servers whose egress passes the perimeter without needing process data."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1572"
    mitre_technique_name = "Protocol Tunneling"
    log_prerequisites = "Requires perimeter or firewall logs normalised to UDM NETWORK_DNS (with query names) and NETWORK_CONNECTION (with source IP and destination IP/port). The firewall or DNS inspection feed must populate principal.ip."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Security products that encode data in DNS lookups (DNS-based reputation or AV cloud lookups, anti-spam DNSBLs), CDN and cloud hostnames with long generated labels, mail DKIM/SPF lookups, hosts legitimately configured to use an external public resolver or DoT, and vulnerability scanners."
    tuning_guidance = "Add known-good domains with long generated labels to %global_allowed_domains. Add scanner or approved resolver-forwarder source IPs to %global_allowed_scanners. Adjust the label length threshold (currently 40+ characters) per environment, and extend the exclusion set if your DNS forwarders legitimately talk to external resolvers."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /[a-z0-9_\-]{40,}\.[a-z0-9\-\.]+$/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.ip in %global_allowed_scanners
    $dns.principal.ip = $src_ip

    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 53 or $net.target.port = 853)
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    $net.principal.ip = $src_ip

    $dns.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1572")
    $primary_entity = array_distinct($src_ip)
    $dns_query_count = count($dns.metadata.id)
    $tunnel_queries = array_distinct($dns.network.dns.questions.name)
    $external_resolver_ips = array_distinct($net.target.ip)
    $external_ports = array_distinct($net.target.port)

  condition:
    $dns and $net
}
