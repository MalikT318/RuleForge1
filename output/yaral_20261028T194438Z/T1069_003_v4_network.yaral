/*
  MITRE Technique : T1069.003 - Cloud Groups
  Tactic(s)       : Discovery
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:01:01.722251+00:00
  Reference       : https://attack.mitre.org/techniques/T1069/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1069_003_External_Directory_Group_Enumeration_API {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects successful HTTP GET requests from an external (non-internal) source to directory API endpoints that list groups, group members or owners, directory roles, role assignments or a user's group memberships. This is the network-side footprint of cloud permission-group discovery by an adversary using a stolen token or credentials, whichever client tool is used. Complements process/command-line based detections."
    mitre_tactic = "Discovery"
    mitre_technique = "T1069.003"
    mitre_technique_name = "Permission Groups Discovery: Cloud Groups"
    log_prerequisites = "Requires normalised HTTP/API request telemetry (NETWORK_HTTP) for the tenant directory API with target.url, network.http.method, network.http.response_code, principal.ip and principal.user.userid populated, for example from a proxy, CASB or API gateway feed. Without URL-level visibility the rule will not fire."
    platform = "Identity Provider"
    log_source = "m365"
    false_positives = "Approved identity governance or access-review products, SaaS integrations syncing groups, helpdesk and onboarding automation, administrators working remotely over VPN or from home, and security posture or compliance scanners."
    tuning_guidance = "Add automation and integration accounts to %global_allowed_service_accounts, service principals to %global_allowed_cloud_principals, and named administrators to %global_allowed_admin_users. Add authorised scanner source IPs to %global_allowed_scanners. Ensure %rfc1918_internal covers all corporate egress and VPN address space as plain strings. To reduce volume, raise severity only for users with no prior group-listing history."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.network.http.response_code = 200
    $http.target.url = /\/(v1\.0|beta|v1)\/(groups|directoryRoles|roleManagement\/directory\/(roleAssignments|roleDefinitions)|(me|users\/[^\/?]+)\/(memberOf|getMemberGroups|transitiveMemberOf)|groups\/[^\/?]+\/(members|owners))(\/|\?|$)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.user.userid in %global_allowed_service_accounts
    not $http.principal.user.userid in %global_allowed_admin_users
    not $http.principal.user.userid in %global_allowed_cloud_principals
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1069.003")
    $primary_entity = array_distinct($http.principal.user.userid)
    $source_ips = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)

  condition:
    $http
}
