/*
  MITRE Technique : T1547.010 - Port Monitors
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:38:05.823287+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_010_Port_Monitor_Driver_Registry_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated writes of the Driver value under HKLM\\SYSTEM\\CurrentControlSet\\Control\\Print\\Monitors\\<name> on a single host within ten minutes. A port monitor DLL registered there is loaded by the print spooler (spoolsv.exe) as SYSTEM at boot, giving persistence and privilege escalation. One write can be a normal printer install, but a burst of writes on one host is suspicious. Risk score rises with volume."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.010"
    mitre_technique_name = "Boot or Logon Autostart Execution: Port Monitors"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events, event IDs 12/13/14) normalised to UDM REGISTRY_MODIFICATION with target.registry.registry_key populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Printer driver and print management software installs, such as multi-function printer suites, print servers, and virtual PDF printers. Software deployment and RMM tooling that pushes print configuration to many ports. Imaging or golden-image build processes."
    tuning_guidance = "Add approved print and deployment tooling to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Raise the #reg threshold on estates with frequent print server changes. Triage by checking whether the DLL path in the Driver value sits outside System32 or is unsigned."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control\\Print\\Monitors\\[^\\]+/ nocase
    (
      $reg.target.registry.registry_value_name = "Driver" nocase or
      $reg.target.registry.registry_key = /\\Driver$/ nocase
    )
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $event_count = count($reg.metadata.id)
    $risk_score = max(if($event_count >= 6, 90, 70))
    $mitre_technique_id = array_distinct("T1547.010")
    $primary_entity = array_distinct($host)
    $monitor_keys = array_distinct($reg.target.registry.registry_key)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $affected_users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 3
}
