/*
  MITRE Technique : T1219.001 - IDE Tunneling
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:06:06.603726+00:00
  Reference       : https://attack.mitre.org/techniques/T1219/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1219_001_IDE_Tunnel_Relay_Web_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound proxy or firewall HTTP/HTTPS observations where the destination hostname contains a tunnel-service label and resolves to a non-internal address. Remote-development IDE tunnels (for example VS Code 'code tunnel' and similar IDE relay services) reach their relay over web egress to tunnel-service hostnames. The rule keys on the generic tunnel label, not a specific vendor domain or endpoint process, so it also covers renamed binaries and new relay hostnames."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1219.001"
    mitre_technique_name = "Remote Access Tools: IDE Tunneling"
    log_prerequisites = "Requires web proxy or next-generation firewall logs that populate the destination hostname (SNI, CONNECT host or HTTP Host) in target.hostname, normalised to NETWORK_HTTP. Source host or IP should be populated in principal.ip."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Approved developer use of remote-development tunnels; ZTNA, VPN and SASE agents that use 'tunnel' hostnames; legitimate Cloudflare or Azure tunnel-based publishing; software update or telemetry endpoints containing the word tunnel; security research and lab hosts."
    tuning_guidance = "Add sanctioned tunnel-service hostnames to %global_allowed_domains (exact hostname match). Add approved developer subnets or jump hosts to %global_allowed_mgmt_sources. Consider raising severity for server VLANs, where developer tunnelling is not expected."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.hostname = /tunnel/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1219.001")
    $primary_entity = array_distinct($net.principal.ip)
    $tunnel_hostnames = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
