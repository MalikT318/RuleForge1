/*
  MITRE Technique : T1132.001 - Standard Encoding
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:46:23.631704+00:00
  Reference       : https://attack.mitre.org/techniques/T1132/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1132_001_Network_Base64_Encoded_HTTP_Payload_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP requests to external destinations where the URL query value or final path segment is a long Base64-encoded string. This is the network-observable result of C2 data encoded with a standard scheme (T1132.001), such as beacon check-ins, task retrieval or data staging over GET parameters. It does not depend on endpoint process or command-line telemetry."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1132.001"
    mitre_technique_name = "Data Encoding: Standard Encoding"
    log_prerequisites = "Requires firewall or web proxy logs normalised to UDM NETWORK_HTTP with target.url populated (full URL logging or SSL inspection for HTTPS). Without URL visibility the rule cannot fire."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate SaaS and telemetry APIs that pass Base64 tokens or state blobs in the URL (OAuth/SAML redirects, software update checks, analytics beacons, CDN signed URLs, OCSP-over-HTTP requests, browser safe-browsing lookups)."
    tuning_guidance = "Add known-good vendor and SaaS domains to %global_allowed_domains. Add expected egress sources such as scanners or proxies to %global_allowed_scanners if they generate matching requests. Raise the minimum Base64 length in the regex (60 for query values, 80 for path segments) in noisy estates. Cross-reference hits with endpoint telemetry on the same source IP to find the initiating process."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url != ""
    (
      $net.target.url = /[?&][A-Za-z0-9_\-]{1,30}=[A-Za-z0-9+\/]{60,}(%3D|=){0,2}(&|$)/ or
      $net.target.url = /\/[A-Za-z0-9+\-_]{80,}(%3D|=){0,2}(\?|$)/
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1132.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $sample_urls = array_distinct($net.target.url)

  condition:
    $net
}
