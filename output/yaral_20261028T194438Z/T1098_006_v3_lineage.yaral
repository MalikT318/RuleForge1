/*
  MITRE Technique : T1098.006 - Additional Container Cluster Roles
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:49:05.415468+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_006_Container_Server_Process_Spawns_RBAC_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application runtime or database process inside a container spawning a shell, kubectl/oc client or HTTP client whose invocation references Kubernetes RBAC objects (RoleBinding, ClusterRoleBinding, cluster-admin, the RBAC API group). Server and database processes do not normally administer cluster roles. This pattern suggests a compromised workload using its service-account token to grant additional permissions to an attacker-controlled account. The detection is anchored on the anomalous parent-child lineage rather than on the command line alone."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.006"
    mitre_technique_name = "Account Manipulation: Additional Container Cluster Roles"
    log_prerequisites = "Requires container runtime or node-level process telemetry that records in-container process launches with parent process path and full command line."
    platform = "Containers"
    log_source = "container"
    false_positives = "Application-embedded Kubernetes operators or controllers written in Java, Node or Python that legitimately shell out to kubectl to manage RBAC. CI/CD runner or GitOps agent containers. Database or application init/bootstrap scripts that create their own RoleBindings during deployment. Admins using debug shells in app containers."
    tuning_guidance = "Add approved operator or deployment parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts. Add automation identities to %global_allowed_service_accounts. Extend the parent-process regex with site-specific server runtimes if needed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|httpd|apache2|php-fpm[0-9.]*|php|tomcat|catalina|java|node|gunicorn|uwsgi|ruby|puma|mysqld|mariadbd|postgres|mongod|redis-server)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|ash|zsh|kubectl|oc|curl|wget)$/ nocase
    $proc.target.process.command_line = /(clusterrolebinding|rolebinding|rbac\.authorization\.k8s\.io|cluster-admin|auth\s+reconcile)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1098.006")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
