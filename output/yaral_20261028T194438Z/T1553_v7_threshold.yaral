/*
  MITRE Technique : T1553 - Subvert Trust Controls
  Tactic(s)       : Defense Impairment
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:00:09.544941+00:00
  Reference       : https://attack.mitre.org/techniques/T1553
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_Trust_Control_Registry_Tampering_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Several registry modifications to Windows trust-control settings occur on a single host within ten minutes. The settings covered are the machine root and trusted-publisher certificate stores, the attachment zone-information (Mark-of-the-Web) policy, WinTrust software publishing state, signature verification (SIP/trust provider) registrations and Software Restriction Policy code identifiers. One such change can be routine. A burst on one host suggests an adversary installing a rogue root certificate, disabling download warnings or hijacking signature validation to run untrusted code."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553"
    mitre_technique_name = "Subvert Trust Controls"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event IDs 12/13/14 or equivalent) normalised to REGISTRY_MODIFICATION with principal.process populated, covering HKLM and HKU hives."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy refresh applying attachment or certificate policies, enterprise PKI or MDM agents deploying internal root and trusted-publisher certificates, software installers registering their own publisher certificates, endpoint security agents, and administrators hardening or imaging hosts."
    tuning_guidance = "Add PKI, MDM, GPO and deployment tooling to %global_allowed_admin_tools, EDR and AV agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Raise the #reg threshold on hosts that are imaged or built frequently. Severity can be raised when $keys contains root-store or SIP/trust-provider entries."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(Microsoft\\SystemCertificates\\(ROOT|TrustedPublisher)\\Certificates|Policies\\Microsoft\\SystemCertificates\\(Root|TrustedPublisher)|Policies\\Attachments|Microsoft\\Cryptography\\OID\\EncodingType 0\\CryptSIPDll|Microsoft\\Cryptography\\Providers\\Trust\\FinalPolicy|WinTrust\\Trust Providers\\Software Publishing|Policies\\Microsoft\\Windows\\Safer\\CodeIdentifiers)/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($reg.metadata.id)
    $mitre_technique_id = array_distinct("T1553")
    $primary_entity = array_distinct($host)
    $keys = array_distinct($reg.target.registry.registry_key)
    $value_names = array_distinct($reg.target.registry.registry_value_name)
    $actor_processes = array_distinct($reg.principal.process.file.full_path)
    $actor_users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 3
}
