/*
  MITRE Technique : T1567.001 - Exfiltration to Code Repository
  Tactic(s)       : Exfiltration
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:56:45.570405+00:00
  Reference       : https://attack.mitre.org/techniques/T1567/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_001_ESXi_Burst_Outbound_HTTPS_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single ESXi host makes a burst of outbound HTTPS connections to external addresses within ten minutes. Hypervisor hosts normally talk only to internal management, storage and update endpoints, so sustained external 443 egress is consistent with data being pushed to a hosted code repository API. This rule counts connection volume and does not inspect command lines."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567.001"
    mitre_technique_name = "Exfiltration Over Web Service: Exfiltration to Code Repository"
    log_prerequisites = "Requires ESXi host network connection telemetry (vmkernel / firewall connection logging) normalised to NETWORK_CONNECTION with principal.hostname and target.ip populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Hosts configured to pull patches or offline bundles from external vendor depots, hosts registering with cloud-based management or licensing services, backup or replication agents using external object storage, and scripted VIB or image downloads during maintenance windows."
    tuning_guidance = "Add approved patching and backup binaries to %global_allowed_admin_tools and %global_allowed_backup_processes, and add vendor update or cloud service domains to %global_allowed_domains. Raise the #net threshold for hosts with legitimate external update traffic. Lower it for isolated management clusters that should have no external egress."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname = $host
    $net.target.port = 443
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_backup_processes

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1567.001")
    $primary_entity = array_distinct($host)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)

  condition:
    #net >= 15
}
