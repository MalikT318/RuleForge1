/*
  MITRE Technique : T1525 - Implant Internal Image
  Tactic(s)       : Persistence
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:24:14.763892+00:00
  Reference       : https://attack.mitre.org/techniques/T1525
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1525_Container_Image_Pushed_To_Registry_By_Unapproved_Principal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a container image manifest being pushed or a layer upload being completed in an internal registry by an identity that is not an approved CI/CD pipeline, service account, or administrator. Adversaries who implant a backdoored image in a registry get persistence whenever the orchestrator pulls the 'latest' tag. The rule keys on the registry write API, not on image names, tags, or hashes."
    mitre_tactic = "Persistence"
    mitre_technique = "T1525"
    mitre_technique_name = "Implant Internal Image"
    log_prerequisites = "Cloud control-plane audit logs with container registry write and data-event logging enabled, normalised to UDM RESOURCE_CREATION with metadata.product_event_type, principal.user.userid and target.resource.name populated."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Developers pushing test images by hand, new CI/CD pipelines or runners not yet in the allowlist, registry replication or pull-through cache jobs, image build and promotion automation using a new identity, and break-glass administrator activity."
    tuning_guidance = "Add approved build pipeline identities to %global_allowed_service_accounts, approved federated or workload identities to %global_allowed_cloud_principals, and named release engineers to %global_allowed_admin_users. Review the API-name regex if the client's registry audit logs use different operation names."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /(^|[.\/])(PutImage|InitiateLayerUpload|CompleteLayerUpload|BatchImportLayerPart|registries\/push\/write|UploadDockerImage|CreateDockerImage)$/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1525")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $source_ips = array_distinct($cloud.principal.ip)
    $registry_resource = array_distinct($cloud.target.resource.name)
    $api_operation = array_distinct($cloud.metadata.product_event_type)

  condition:
    $cloud
}
