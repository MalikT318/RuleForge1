/*
  MITRE Technique : T1204.003 - Malicious Image
  Tactic(s)       : Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:02:44.857550+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_003_Container_Pod_Created_Then_Interactive_Exec {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A workload (pod) is created outside system namespaces and the same identity opens an interactive exec/attach session into a pod within 10 minutes. This pattern is consistent with deploying an untrusted or backdoored container image and then hands-on interaction with it. It is control-plane coverage and does not depend on process command lines."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.003"
    mitre_technique_name = "User Execution: Malicious Image"
    log_prerequisites = "Requires container orchestration control-plane audit logs ingested and normalised to UDM, with request URI mapped to target.url and the acting identity mapped to principal.user.userid. Audit policy must record pod create and pods/exec or pods/attach requests at Metadata level or higher."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Developers deploying a test pod and debugging it with exec, break-glass troubleshooting, CI/CD pipelines that deploy and then run smoke tests via exec, and operators running one-off debug pods."
    tuning_guidance = "Add CI/CD and automation identities to %global_allowed_service_accounts, platform or SRE engineers to %global_allowed_admin_users, and approved deployment controllers to %global_allowed_cloud_principals. If the audit pipeline exposes the image reference, add a registry allowlist condition on the creation event using %global_allowed_domains."

  events:
    $create.metadata.event_type = "RESOURCE_CREATION"
    $create.target.url = /\/api\/v1\/namespaces\/[^\/]+\/pods\/?$/ nocase
    not $create.target.url = /\/namespaces\/(kube-system|kube-public|kube-node-lease)\// nocase
    not $create.principal.user.userid in %global_allowed_service_accounts
    not $create.principal.user.userid in %global_allowed_cloud_principals
    not $create.principal.user.userid in %global_allowed_admin_users
    $create.principal.user.userid = $user

    $exec.metadata.event_type = "USER_RESOURCE_ACCESS"
    $exec.target.url = /\/pods\/[^\/]+\/(exec|attach)(\?|$)/ nocase
    not $exec.target.url = /\/namespaces\/(kube-system|kube-public|kube-node-lease)\// nocase
    not $exec.principal.user.userid in %global_allowed_service_accounts
    not $exec.principal.user.userid in %global_allowed_cloud_principals
    not $exec.principal.user.userid in %global_allowed_admin_users
    $exec.principal.user.userid = $user

    $create.metadata.event_timestamp.seconds <= $exec.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1204.003")
    $primary_entity = array_distinct($user)
    $created_pods = array_distinct($create.target.resource.name)
    $create_urls = array_distinct($create.target.url)
    $exec_urls = array_distinct($exec.target.url)
    $source_ips = array_distinct($create.principal.ip)
    $exec_count = count($exec.metadata.id)

  condition:
    $create and $exec
}
