/*
  MITRE Technique : T1578 - Modify Cloud Compute Infrastructure
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:48:39.186332+00:00
  Reference       : https://attack.mitre.org/techniques/T1578
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_Cloud_Compute_Infrastructure_Setting_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects configuration changes to compute infrastructure components (instance attributes, instance metadata or service-account bindings, snapshot and image attributes, snapshot or disk access grants) made by a principal that is not an approved automation or administrative identity. Adversaries alter compute configuration to weaken defenses, gain access that existing restrictions block, or hide evidence. The rule detects the resulting control-plane configuration change, not any client-side command line."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578"
    mitre_technique_name = "Modify Cloud Compute Infrastructure"
    log_prerequisites = "Cloud control-plane audit logging (management or admin activity events) must be enabled and ingested into UDM with metadata.product_event_type and principal.user.userid populated. Write or management events must be included, not read-only events."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Infrastructure-as-code pipelines and deployment automation, autoscaling and image-baking workflows, backup and snapshot lifecycle tooling, cloud administrators performing approved maintenance (resizing, metadata or service-account changes), and migration projects."
    tuning_guidance = "Add automation and pipeline identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Add named platform administrators to %global_allowed_admin_users. If a client has noisy change windows, raise severity only for changes made outside business hours or from unusual source addresses at the SOAR layer."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /(Modify(Instance|Snapshot|Image)Attribute|ModifyInstanceMetadataOptions|ModifyVolumeAttribute|compute\.(instances|snapshots|disks|images)\.(setMetadata|setServiceAccount|setMachineType|setIamPolicy|setLabels)|Microsoft\.Compute\/(snapshots|disks|images|virtualMachines)\/(write|beginGetAccess\/action|extensions\/write))/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1578")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_action = array_distinct($cloud.metadata.product_event_type)
    $target_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
