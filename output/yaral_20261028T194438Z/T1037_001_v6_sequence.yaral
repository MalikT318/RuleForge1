/*
  MITRE Technique : T1037.001 - Logon Script (Windows)
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:20:41.693743+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_001_Logon_Script_Dropped_Then_UserInitMprLogonScript_Set {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A script file is written to a user-writable location and, within ten minutes on the same host, the HKCU Environment UserInitMprLogonScript registry value is set. This is the classic logon-script persistence pattern. The script is staged first, then registered to run at every logon."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.001"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Logon Script (Windows)"
    log_prerequisites = "Requires endpoint file-creation and registry-modification telemetry (EDR or Sysmon Event IDs 11 and 13). Registry events must populate target.registry.registry_key and registry_value_name."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate IT-managed logon-script deployment tooling, software deployment or profile management agents, and administrators configuring per-user logon scripts. Some enterprise migration or VDI profile tools also write this value."
    tuning_guidance = "Add approved deployment, RMM or profile tooling to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts and named admins to %global_allowed_admin_users. Registry events are keyed on the value name, so a Sysmon config that does not log HKU Environment writes will leave the rule blind."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(\\users\\[^\\]+\\(appdata|downloads|desktop|documents)|\\users\\public|\\programdata|\\windows\\temp)\\.*\.(bat|cmd|vbs|vbe|js|jse|wsf|ps1)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Environment$/ nocase
    $reg.target.registry.registry_value_name = "UserInitMprLogonScript" nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_admin_users
    $reg.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1037.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $dropped_scripts = array_distinct($file.target.file.full_path)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $acting_users = array_distinct($reg.principal.user.userid)
    $registering_processes = array_distinct($reg.principal.process.file.full_path)

  condition:
    $file and $reg
}
