/*
  MITRE Technique : T1027.015 - Compression
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:01:53.919889+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_015_Interpreter_Writes_Archive_To_Staging_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects the file artifact of compression-based obfuscation or staging: a script interpreter or proxy-execution binary (PowerShell, WScript, CScript, MSHTA, Rundll32, Regsvr32) writes an archive or compressed container (zip, 7z, rar, gz, cab) into a user-writable staging location (Temp, AppData, Downloads, ProgramData, Public). Working from the file-creation layer means it still fires when command-line logging is evaded or obfuscated."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.015"
    mitre_technique_name = "Obfuscated Files or Information: Compression"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with the writing process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin or backup scripts that compress logs with Compress-Archive, software installers or updaters that use PowerShell to unpack or stage cab/zip packages, RMM and deployment tooling, and developer build scripts."
    tuning_guidance = "Add approved parent or writer process paths to %global_allowed_script_hosts, %global_allowed_admin_tools or %global_allowed_backup_processes. Add known automation hosts to %global_allowed_script_hosts. Narrow the staging-path regex for environments where scripts routinely write archives to ProgramData."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32)\.exe$/ nocase
    $file.target.file.full_path = /\.(zip|7z|rar|gz|tgz|cab)$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop)|programdata|windows\\temp|users\\public)\\/ nocase
    not $file.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1027.015")
    $primary_entity = array_distinct($file.principal.hostname)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $archive_path = array_distinct($file.target.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
