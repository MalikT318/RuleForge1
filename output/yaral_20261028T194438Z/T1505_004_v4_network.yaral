/*
  MITRE Technique : T1505.004 - IIS Components
  Tactic(s)       : Persistence
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:31:56.867403+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_004_IIS_Worker_Outbound_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the IIS worker process initiating an outbound network connection to an external address. IIS hosts normally only receive requests. A malicious ISAPI extension/filter or native IIS module loaded into the worker process can proxy command and control traffic, beacon out, or pull second-stage content. This is the network-side result of IIS component persistence, independent of how the component was installed."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.004"
    mitre_technique_name = "Server Software Component: IIS Components"
    log_prerequisites = "Requires endpoint network telemetry that records the initiating process path (EDR network events or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web applications calling external APIs (payment gateways, SaaS, identity providers, mail relays); certificate revocation (CRL/OCSP) and update checks from the worker process; Exchange/OWA and SharePoint back-end proxying or federation; application telemetry and licensing callbacks; reverse-proxy or ARR deployments forwarding to external origins."
    tuning_guidance = "Add known-good external destinations to %global_allowed_domains (matched against target.hostname). Review the destination IPs and ports in the outcome. For servers that legitimately call external services, baseline per host. Correlate hits with recent DLL creation in the inetsrv, ISAPI or application directories from the endpoint-side detections."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\w3wp\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1505.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $destination_hosts = array_distinct($net.target.hostname)

  condition:
    $net
}
