/*
  MITRE Technique : T1677 - Poisoned Pipeline Execution
  Tactic(s)       : Execution
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:23:29.547247+00:00
  Reference       : https://attack.mitre.org/techniques/T1677
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1677_CICD_Pipeline_Config_Mass_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single user modified multiple CI/CD pipeline definition files (workflow, pipeline or build configuration) within ten minutes. Each edit is routine on its own, but rapid repeated changes to pipeline definitions by one identity can indicate Direct Pipeline Execution, where an adversary injects commands into build configuration to run attacker code or leak pipeline secrets."
    mitre_tactic = "Execution"
    mitre_technique = "T1677"
    mitre_technique_name = "Poisoned Pipeline Execution"
    log_prerequisites = "Requires SaaS source-control or CI/CD audit logs that record content updates with the file path populated in target.file.full_path, normalised to USER_RESOURCE_UPDATE_CONTENT."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Developers or platform engineers refactoring pipelines, bulk migrations between CI systems, repository template roll-outs, dependency-update bots committing workflow changes, and onboarding of new repositories."
    tuning_guidance = "Add automation and bot accounts to %global_allowed_service_accounts and named DevOps or platform administrators to %global_allowed_admin_users. Raise the #audit threshold for organisations with heavy pipeline-as-code churn. Lower it for high-assurance repositories."

  events:
    $audit.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"
    $audit.target.file.full_path = /(^|\/)(\.github\/workflows\/[^\/]+\.ya?ml|\.gitlab-ci\.ya?ml|Jenkinsfile[^\/]*|azure-pipelines\.ya?ml|\.circleci\/config\.yml|bitbucket-pipelines\.yml|\.buildkite\/[^\/]+\.ya?ml)$/ nocase
    $audit.principal.user.userid = $user
    not $audit.principal.user.userid in %global_allowed_service_accounts
    not $audit.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($audit.metadata.id)
    $mitre_technique_id = array_distinct("T1677")
    $primary_entity = array_distinct($user)
    $modified_files = array_distinct($audit.target.file.full_path)
    $source_ips = array_distinct($audit.principal.ip)

  condition:
    #audit >= 5
}
