/*
  MITRE Technique : T1124 - System Time Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:32:14.320418+00:00
  Reference       : https://attack.mitre.org/techniques/T1124
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1124_External_NTP_Time_Query_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects an internal host sending NTP (port 123) traffic to an external destination that is not an approved time source. Domain-joined Windows hosts normally sync time through the domain hierarchy, so direct external time queries can indicate system time discovery, such as w32tm /stripchart against an external server, or sandbox and uptime evasion checks. This is perimeter-based coverage and does not depend on process command lines. Note: the requested alternate-platform angle conflicts with the mandatory Windows platform requirement, so this rule follows the Windows requirement and adds coverage through the firewall log source."
    mitre_tactic = "Discovery"
    mitre_technique = "T1124"
    mitre_technique_name = "System Time Discovery"
    log_prerequisites = "Requires firewall, proxy or perimeter logs normalised to UDM NETWORK_CONNECTION with populated principal.ip, target.ip and target.port."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Standalone or workgroup Windows hosts, kiosks, and appliances syncing to public time pools; domain controllers or PDC emulators syncing upstream; mobile or remote laptops with a hard-coded external time server; IoT and OT devices."
    tuning_guidance = "Add approved time source domains to %global_allowed_domains. Add domain controllers, PDC emulators and approved time-sync sources to %global_allowed_mgmt_sources. Consider promoting to a Threshold rule if hosts with legitimate external NTP generate volume."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 123
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(30)
    $mitre_technique_id = array_distinct("T1124")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)

  condition:
    $net
}
