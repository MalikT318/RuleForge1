/*
  MITRE Technique : T1021.005 - VNC
  Tactic(s)       : Lateral Movement
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:41:46.602602+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_005_VNC_Pivot_Chain_Firewall {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a VNC (RFB) chain across a pivot host: one host opens a VNC-range connection to a pivot, and within 10 minutes that same pivot opens its own VNC-range connection to a different host. This is chained remote desktop control, a lateral movement pattern that is rare in normal operations. It is observed only from firewall or perimeter connection logs."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.005"
    mitre_technique_name = "Remote Services: VNC"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. East-west (internal segment) traffic must traverse a logging inspection point for the pivot to be visible."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Helpdesk or IT staff hopping through a jump host with VNC, lab or training environments, remote support gateways that relay VNC sessions, and VNC repeaters or proxies in OT/ICS and kiosk management."
    tuning_guidance = "Add approved helpdesk, jump host and remote support source addresses to %global_allowed_mgmt_sources. Tune the port range if clients run VNC on non-default ports. Consider scoping the rule to server or sensitive network segments in high-noise environments."

  events:
    $hop1.metadata.event_type = "NETWORK_CONNECTION"
    $hop1.target.port >= 5900
    $hop1.target.port <= 5909
    not $hop1.principal.ip in %global_allowed_mgmt_sources
    $hop1.target.ip = $pivot

    $hop2.metadata.event_type = "NETWORK_CONNECTION"
    $hop2.target.port >= 5900
    $hop2.target.port <= 5909
    not $hop2.principal.ip in %global_allowed_mgmt_sources
    $hop2.principal.ip = $pivot
    $hop2.target.ip != $hop1.principal.ip

    $hop1.metadata.event_timestamp.seconds <= $hop2.metadata.event_timestamp.seconds

  match:
    $pivot over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1021.005")
    $primary_entity = array_distinct($pivot)
    $initial_sources = array_distinct($hop1.principal.ip)
    $onward_targets = array_distinct($hop2.target.ip)
    $first_hop_ports = array_distinct($hop1.target.port)
    $second_hop_ports = array_distinct($hop2.target.port)
    $connection_count = count($hop2.metadata.id)

  condition:
    $hop1 and $hop2
}
