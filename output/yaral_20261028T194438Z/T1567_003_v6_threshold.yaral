/*
  MITRE Technique : T1567.003 - Exfiltration to Text Storage Sites
  Tactic(s)       : Exfiltration
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:00:41.863816+00:00
  Reference       : https://attack.mitre.org/techniques/T1567/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_003_Linux_Repeated_Scripted_Uploads_To_Unlisted_External_Site {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single Linux host sends repeated HTTP POST or PUT requests from a scripted or command-line HTTP client to the same external, non-allowlisted site within ten minutes. This is the network-side pattern of data being pushed to text storage or paste sites, which are normally reached through a browser or an approved integration. One upload is benign; sustained, repeated uploads to one unlisted destination are not."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567.003"
    mitre_technique_name = "Exfiltration Over Web Service: Exfiltration to Text Storage Sites"
    log_prerequisites = "Forward proxy, secure web gateway or firewall with HTTP inspection that populates network.http.method, network.http.user_agent, target.hostname and principal.hostname (or a host name resolved from the source IP). No endpoint process telemetry is needed."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Linux servers or CI/CD runners posting to SaaS APIs, webhooks, telemetry or monitoring endpoints, package or artifact publishing, log shippers, and backup or cloud CLIs uploading to vendor endpoints not yet in the allowlist."
    tuning_guidance = "Add known-good vendor, SaaS and API domains to %global_allowed_domains. Add automation identities to %global_allowed_service_accounts. Raise the #http threshold on busy build or integration hosts, or lower it to 5 for high-security server segments. Extend the user-agent regex with other approved scripted clients if needed."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(POST|PUT)$/ nocase
    $http.network.http.user_agent = /(curl|wget|python|libwww|go-http-client|okhttp|java|ruby|perl|node|axios|httpie)/ nocase
    $http.network.sent_bytes > 0
    $http.target.hostname != ""
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.user.userid in %global_allowed_service_accounts
    $http.principal.hostname = $host
    $http.target.hostname = $domain

  match:
    $host, $domain over 10m

  outcome:
    $risk_score = max(if($http.network.sent_bytes > 10000, 80, 60))
    $mitre_technique_id = array_distinct("T1567.003")
    $primary_entity = array_distinct($host)
    $event_count = count($http.metadata.id)
    $total_bytes_sent = sum($http.network.sent_bytes)
    $destination_domains = array_distinct($domain)
    $user_agents = array_distinct($http.network.http.user_agent)
    $source_users = array_distinct($http.principal.user.userid)

  condition:
    #http >= 8
}
