/*
  MITRE Technique : T1052.001 - Exfiltration over USB
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:42:24.724799+00:00
  Reference       : https://attack.mitre.org/techniques/T1052/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1052_001_Linux_File_Write_To_Removable_Media_Mount {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects file creation beneath the standard Linux removable-media automount locations (/media/<user>/<label>/ and /run/media/<user>/<label>/), which is where USB mass-storage devices are mounted by udisks and desktop automounters. Writing files to these paths indicates data being copied to a USB-connected physical device, a primary signal for exfiltration over USB."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1052.001"
    mitre_technique_name = "Exfiltration Over Physical Medium: Exfiltration over USB"
    log_prerequisites = "Requires Linux EDR file-event telemetry or auditd file-write/create rules (e.g. watches on removable mount paths) that populate target.file.full_path and the acting process. Removable media must be mounted under /media or /run/media (default for udisks2 and desktop automounters)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Users legitimately saving files to personal USB drives, approved backup or imaging jobs writing to removable disks, IT staff provisioning or imaging USB media, and software installers or live-media tools writing to USB drives."
    tuning_guidance = "Add approved backup and imaging binaries to %global_allowed_backup_processes, and service or automation accounts to %global_allowed_service_accounts. For hosts that mount USB devices elsewhere (e.g. custom /mnt paths via fstab or udev rules), extend the path regex per client. Raise severity or restrict to sensitive-data hosts for air-gapped or high-value environments."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(run\/)?media\/[^\/]+\/[^\/]+\/.+/ nocase
    not $file.target.file.full_path = /(\/\.Trash-[0-9]+\/|\/\.Trash\/|System Volume Information|\/lost\+found\/|\/\.fseventsd\/)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1052.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $user = array_distinct($file.principal.user.userid)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $process_command_line = array_distinct($file.principal.process.command_line)
    $removable_media_file = array_distinct($file.target.file.full_path)

  condition:
    $file
}
