/*
  MITRE Technique : T1652 - Device Driver Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:54:31.733939+00:00
  Reference       : https://attack.mitre.org/techniques/T1652
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1652_Windows_Driver_Enumeration_Utility {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects enumeration of installed device drivers on a Windows host. Covers the built-in driverquery utility, plus command lines that query driver inventory through WMI/CIM driver classes (Win32_SystemDriver, Win32_PnPSignedDriver), 'sc query type= driver', or pnputil driver enumeration. Adversaries use this to profile the host, identify security tooling or virtualization drivers, and find vulnerable drivers."
    mitre_tactic = "Discovery"
    mitre_technique = "T1652"
    mitre_technique_name = "Device Driver Discovery"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with full command lines (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT inventory and asset-management scripts, RMM health checks, patching and driver-update tooling, helpdesk staff troubleshooting hardware or BSOD issues, software installers validating driver state, and vulnerability or compliance scanners."
    tuning_guidance = "Add approved inventory/RMM parent processes to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Raise severity when the parent is a script host, Office application, or a remote-execution service. Consider pairing with other discovery commands on the same host for a higher-confidence alert."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $proc.target.process.file.full_path = /\\driverquery\.exe$/ nocase or
      $proc.target.process.command_line = /(win32_systemdriver|win32_pnpsigneddriver|enumdevicedrivers|enum-drivers|\bquery\b.*\btype=\s*driver\b)/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1652")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
