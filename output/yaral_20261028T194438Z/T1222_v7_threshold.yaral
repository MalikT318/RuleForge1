/*
  MITRE Technique : T1222 - File and Directory Permissions Modification
  Tactic(s)       : Defense Impairment
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:17:32.472601+00:00
  Reference       : https://attack.mitre.org/techniques/T1222
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_Linux_Mass_Permission_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of permission or attribute changes (chmod, chown, chgrp, setfacl, chattr) on a single Linux host within 10 minutes. Each command carries a high-risk modifier: recursive scope, world-writable mode, setuid/setgid bits, or an immutable-attribute change. A single occurrence is routine administration. High volume suggests an adversary loosening access controls on protected files, staging persistence, or locking files to hinder remediation."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1222"
    mitre_technique_name = "File and Directory Permissions Modification"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL events normalised to PROCESS_LAUNCH with populated command_line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management (Ansible, Puppet, Chef, Salt), package installs and upgrades, application deployment scripts, container image builds, developers fixing project ownership, and backup restores."
    tuning_guidance = "Add approved automation and deployment binaries to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Raise the #proc threshold on build servers or config-managed hosts. Lower it on hardened servers where permission changes are rare."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(chmod|chown|chgrp|setfacl|chattr)$/ nocase
    $proc.target.process.command_line = /\s(-[a-z]*r[a-z]*|--recursive|0?777|[ugoa]*\+[rwx]*s|[0-7]?[4-7][0-7]{3}|[-+]i)\s/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1222")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 10
}
