/*
  MITRE Technique : T1578 - Modify Cloud Compute Infrastructure
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:48:23.379024+00:00
  Reference       : https://attack.mitre.org/techniques/T1578
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_Cloud_Compute_Infrastructure_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects deletion of cloud compute infrastructure components (instances, disks/volumes, snapshots, machine images) by an identity that is not an approved automation or administrative principal. Adversaries delete or terminate compute components to remove forensic evidence, destroy backups and snapshots, or evade defenses."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578"
    mitre_technique_name = "Modify Cloud Compute Infrastructure"
    log_prerequisites = "Cloud control-plane audit logging must be enabled for management and write/delete API calls (e.g. AWS CloudTrail management events, Azure Activity Log, GCP Admin Activity audit logs) and normalised to UDM RESOURCE_DELETION with metadata.product_event_type populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Autoscaling and infrastructure-as-code pipelines (Terraform, CloudFormation, ARM/Bicep), scheduled snapshot-retention and AMI/image lifecycle jobs, FinOps cleanup of idle volumes, dev/test environment teardown, and planned decommissioning by cloud administrators."
    tuning_guidance = "Add CI/CD, autoscaling and lifecycle-management identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named cloud administrators to %global_allowed_admin_users. If instance termination is too noisy in a given tenant, remove the instance-delete alternatives from the regex and keep snapshot, image and disk deletion."

  events:
    $cloud.metadata.event_type = "RESOURCE_DELETION"
    $cloud.metadata.product_event_type = /(DeleteSnapshot|DeregisterImage|TerminateInstances|DeleteVolume|compute\.(snapshots|images|instances|disks)\.delete|Microsoft\.Compute\/(snapshots|images|virtualMachines|disks)\/delete)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1578")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_actions = array_distinct($cloud.metadata.product_event_type)
    $deleted_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
