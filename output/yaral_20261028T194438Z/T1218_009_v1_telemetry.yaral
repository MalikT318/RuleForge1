/*
  MITRE Technique : T1218.009 - Regsvcs/Regasm
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:52:47.202258+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_009_Regasm_Regsvcs_CodeBase_Registry_Registration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects regasm.exe or regsvcs.exe writing a CodeBase value under a COM CLSID InprocServer32 key. This is the registry state change left when a .NET assembly is registered from a file location with /codebase. Attackers use this to proxy-execute code through [ComRegisterFunction] and to persist a COM-hijack pointing at an attacker-supplied assembly. The rule works on the resulting registry artifact, so it still fires when command-line logging is evaded or the command line is obfuscated."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.009"
    mitre_technique_name = "System Binary Proxy Execution: Regsvcs/Regasm"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events) that populates principal.process.file.full_path, target.registry.registry_key and target.registry.registry_value_name."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developers registering .NET COM components with /codebase, software installers and build or deployment pipelines registering managed COM assemblies, and legacy line-of-business applications that register interop assemblies."
    tuning_guidance = "Add approved deployment tooling to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Review the codebase_paths outcome and prioritise user-writable locations (Temp, AppData, Public, ProgramData). Exclude build servers or developer workstations with %global_allowed_admin_users."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.principal.process.file.full_path = /\\(regasm|regsvcs)\.exe$/ nocase
    $reg.target.registry.registry_key = /\\CLSID\\\{[0-9a-f\-]+\}\\InprocServer32/ nocase
    $reg.target.registry.registry_value_name = "CodeBase" nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1218.009")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $codebase_paths = array_distinct($reg.target.registry.registry_value_data)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
