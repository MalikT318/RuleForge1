/*
  MITRE Technique : T1556.002 - Password Filter DLL
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:17:04.470177+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_002_LSA_Notification_Packages_Registry_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of the LSA 'Notification Packages' registry value, which controls which password filter DLLs the Local Security Authority loads. Registering a malicious password filter lets an adversary capture plain-text passwords at every password change. This rule is registry-based and complements command-line process detections. The technique is Windows-only (LSA password filters), so there is no valid Linux, macOS or cloud equivalent and the rule targets Windows."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.002"
    mitre_technique_name = "Modify Authentication Process: Password Filter DLL"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events, Event IDs 12/13/14 equivalent) covering HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa. Must be collected from domain controllers and member servers."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate installation of third-party password policy or password synchronisation products (e.g. enterprise password complexity enforcement, self-service password reset agents), Microsoft security baseline or hardening scripts, and OS servicing or upgrades."
    tuning_guidance = "Add approved deployment or patching tooling to %global_allowed_admin_tools and endpoint security agents to %global_allowed_security_tools. After a change is verified as an approved password filter product, allowlist the installer process. Investigate the referenced DLL in System32 (creation time, signer) for any hit."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\control\\lsa$/ nocase
    $reg.target.registry.registry_value_name = /^notification packages$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1556.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $modifying_user = array_distinct($reg.principal.user.userid)
    $registry_key = array_distinct($reg.target.registry.registry_key)

  condition:
    $reg
}
