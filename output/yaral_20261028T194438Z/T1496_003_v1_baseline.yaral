/*
  MITRE Technique : T1496.003 - SMS Pumping
  Tactic(s)       : Impact
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:55:34.926210+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_003_SMS_Pumping_OTP_Message_Trigger {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects cloud control-plane API calls that send an SMS or voice one-time-passcode message (OTP or verification resend, forgot-password code, direct text, voice or OTP message send) made by an unauthenticated caller or by a principal that is not an approved messaging identity. This is the primary SMS-pumping primitive: public verification endpoints abused to generate paid SMS traffic to attacker-controlled number ranges. A single event is a low-volume signal and is intended to feed alert aggregation, so correlate per source IP in SOAR or with the threshold variants of this technique."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.003"
    mitre_technique_name = "Resource Hijacking: SMS Pumping"
    log_prerequisites = "Cloud provider audit logs normalised to UDM, including data-plane or identity-service API events for managed identity and messaging services. These must populate metadata.product_event_type, principal.ip and principal.user.userid."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate end users requesting a verification code or password reset, application back-ends sending authorised OTP messages, QA and load-test harnesses, and marketing or notification services sending transactional SMS."
    tuning_guidance = "Add approved messaging service identities to %global_allowed_cloud_principals and named operators to %global_allowed_admin_users. Add authorised testing sources to %global_allowed_scanners. Raise severity or risk_score when the same principal.ip appears repeatedly in the SOAR playbook. Extend the product_event_type regex if the tenant normalises SMS-sending API names differently."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /^(ResendConfirmationCode|ForgotPassword|GetUserAttributeVerificationCode|SendTextMessage|SendVoiceMessage|SendOTPMessage|SendUserVerificationCode|SendVerificationCode)$/ nocase
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1496.003")
    $primary_entity = array_distinct($cloud.principal.ip)
    $api_actions = array_distinct($cloud.metadata.product_event_type)
    $caller_ids = array_distinct($cloud.principal.user.userid)
    $target_resources = array_distinct($cloud.target.resource.name)

  condition:
    $cloud
}
