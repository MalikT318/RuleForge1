/*
  MITRE Technique : T1574.013 - KernelCallbackTable
  Tactic(s)       : Stealth, Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:46:08.389711+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_013_KernelCallbackTable_GUI_Process_Handle_From_UserWritable {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process running from a user-writable location opening a handle to a core GUI process (shell, notepad, winlogon, etc.). KernelCallbackTable hijacking requires a cross-process handle to rewrite the PEB callback table of a user32-loaded victim before it is triggered, for example via WM_COPYDATA. This rule uses PROCESS_OPEN handle telemetry instead of command-line matching. KernelCallbackTable is a Windows-only mechanism with no Linux, macOS or cloud equivalent, so the rule is written for Windows, the only valid platform for this technique."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.013"
    mitre_technique_name = "Hijack Execution Flow: KernelCallbackTable"
    log_prerequisites = "Requires EDR or Sysmon-equivalent process-access telemetry (Sysmon Event ID 10 or equivalent) normalised to PROCESS_OPEN with populated principal and target process paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Screen-capture, accessibility, overlay and game-companion utilities installed per-user, per-user installed updaters and shell extensions, user-profile-installed collaboration clients, and unlisted endpoint security or backup agents."
    tuning_guidance = "Add approved EDR/AV agents to %global_allowed_security_tools, IT tooling to %global_allowed_admin_tools, and imaging software to %global_allowed_backup_processes. Where per-user installed utilities are noisy, add them to %global_allowed_admin_tools. Extend or narrow the victim process regex to fit the client's GUI process baseline."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.process.file.full_path = /(?i)\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|programdata|windows\\temp|users\\public|temp)\\/
    $open.target.process.file.full_path = /\\(explorer|notepad|mspaint|calc|winlogon|dwm|sihost|taskhostw|ctfmon|runtimebroker|searchhost|wordpad)\.exe$/ nocase
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1574.013")
    $primary_entity = array_distinct($open.principal.hostname)
    $source_process = array_distinct($open.principal.process.file.full_path)
    $victim_process = array_distinct($open.target.process.file.full_path)
    $acting_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
