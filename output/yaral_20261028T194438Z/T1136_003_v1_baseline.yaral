/*
  MITRE Technique : T1136.003 - Cloud Account
  Tactic(s)       : Persistence
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:10:51.776004+00:00
  Reference       : https://attack.mitre.org/techniques/T1136/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_003_Cloud_Account_Created_By_Unapproved_Principal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a new cloud directory account (user or service identity) by an actor that is not an approved administrator, provisioning service account, or approved cloud principal. Adversaries create secondary cloud accounts to keep credentialed access that does not depend on implants or remote access tools."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136.003"
    mitre_technique_name = "Create Account: Cloud Account"
    log_prerequisites = "Requires identity provider directory audit logs that map account-creation events to UDM USER_CREATION, with principal.user.userid (actor) and target.user.userid (new account) populated."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "HR-driven joiner workflows not yet allowlisted, identity governance or SCIM provisioning connectors, help-desk staff onboarding users, directory sync services, break-glass account creation during incident response, and bulk migration projects."
    tuning_guidance = "Add legitimate provisioning accounts to %global_allowed_service_accounts, named administrators to %global_allowed_admin_users, and automation or sync identities to %global_allowed_cloud_principals. For noisy tenants, add the allowlisted actors per client rather than widening the rule logic."

  events:
    $iam.metadata.event_type = "USER_CREATION"
    $iam.target.user.userid != ""
    $iam.principal.user.userid != ""
    not $iam.principal.user.userid in %global_allowed_admin_users
    not $iam.principal.user.userid in %global_allowed_service_accounts
    not $iam.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1136.003")
    $primary_entity = array_distinct($iam.principal.user.userid)
    $created_account = array_distinct($iam.target.user.userid)
    $source_ip = array_distinct($iam.principal.ip)

  condition:
    $iam
}
