/*
  MITRE Technique : T1485 - Data Destruction
  Tactic(s)       : Impact
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:36:52.707222+00:00
  Reference       : https://attack.mitre.org/techniques/T1485
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1485_ESXi_Mass_Datastore_File_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of deletions of virtual machine files (virtual disks, VM configuration, NVRAM, memory and suspend state) under the datastore mount point on a single ESXi host within 10 minutes. A single deletion is routine, but bulk removal of VM base files indicates destruction of guest data and availability, as seen in hypervisor-targeting ransomware and wiper activity. Snapshot delta, sesparse, changed-block-tracking and numbered snapshot disk files are excluded to reduce noise from snapshot consolidation."
    mitre_tactic = "Impact"
    mitre_technique = "T1485"
    mitre_technique_name = "Data Destruction"
    log_prerequisites = "ESXi hostd, shell and file-operation logs forwarded to Chronicle and parsed into UDM FILE_DELETION events with principal.hostname and target.file.full_path populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Planned decommissioning of VMs, storage migration or datastore cleanup by administrators, backup and replication software removing temporary files, template or VDI pool recycling, and orchestration tooling deleting ephemeral VMs."
    tuning_guidance = "Add automation accounts to %global_allowed_service_accounts, named administrators to %global_allowed_admin_users, and backup or replication processes to %global_allowed_backup_processes. Raise the #file threshold on hosts with large VDI or ephemeral VM churn. Lower it for small, static environments."

  events:
    $file.metadata.event_type = "FILE_DELETION"
    $file.principal.hostname = $host
    $file.target.file.full_path = /^\/vmfs\/volumes\/.+\.(vmdk|vmx|vmxf|nvram|vmem|vmss|vswp|vmsd)$/ nocase
    not $file.target.file.full_path = /-(delta|sesparse|ctk|\d{6})\.vmdk$/ nocase
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  match:
    $host over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1485")
    $primary_entity = array_distinct($host)
    $deleted_file_count = count($file.metadata.id)
    $deleted_paths = array_distinct($file.target.file.full_path)
    $acting_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 10
}
