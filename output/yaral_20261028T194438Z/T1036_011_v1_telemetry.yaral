/*
  MITRE Technique : T1036.011 - Overwrite Process Arguments
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:13:43.557590+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_011_Proc_Cmdline_Mem_Overwrite_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a write to /proc/<pid>/mem or /proc/<pid>/cmdline (or /proc/self/...) by a process running from a world-writable staging location (/tmp, /var/tmp, /dev/shm) or a hidden-file path. This is the file-level artifact of a process overwriting its in-memory argv to spoof its name and hide how it was launched. It is not based on command-line matching, so it still fires when command-line logging is evaded or the visible command line has already been spoofed."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.011"
    mitre_technique_name = "Masquerading: Overwrite Process Arguments"
    log_prerequisites = "Requires Linux EDR file-write telemetry covering /proc pseudo-files, or auditd rules watching writes to /proc/*/mem and /proc/*/cmdline, normalised to FILE_MODIFICATION with principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Debuggers and tracers (gdb, lldb, strace) and live-patching or checkpoint/restore tooling run from a temp directory. Developer builds or test binaries in /tmp that legitimately write to their own /proc/self/mem. Packers and self-modifying runtimes. Security and EDR agents that unpack to /tmp."
    tuning_guidance = "Add approved agent and tooling binary paths to %global_allowed_security_tools or %global_allowed_admin_tools. Debuggers are already excluded by executable name. For developer-heavy hosts, scope by hostname or exclude build-user activity through your SOAR playbook. If a client has no EDR coverage of /proc writes, the rule will not fire and a kernel-level (eBPF or auditd) source is needed."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/proc\/(self|[0-9]+)\/(mem|cmdline)$/
    $file.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/|\/\.[^\/]+$/
    not $file.principal.process.file.full_path = /\/(gdb|gdbserver|lldb|strace|ltrace|criu)$/
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1036.011")
    $primary_entity = array_distinct($file.principal.hostname)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $written_proc_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
