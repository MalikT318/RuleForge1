/*
  MITRE Technique : T1134.004 - Parent PID Spoofing
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:59:26.871649+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_004_Handle_Open_To_Spoofable_Parent_From_UserWritable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process running from a user-writable location that opens a handle to a core Windows process commonly used as a spoofed parent (explorer, svchost, winlogon, services, spoolsv, wininit). PPID spoofing requires the creator to first obtain a process handle to the chosen parent with the create-process access right, so the handle request is visible even when the child process command line is hidden or altered. Detection works at the PROCESS_OPEN layer rather than on process-creation command lines."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.004"
    mitre_technique_name = "Access Token Manipulation: Parent PID Spoofing"
    log_prerequisites = "Requires endpoint telemetry that records process handle opens (EDR process-access events or Sysmon Event ID 10) normalised to PROCESS_OPEN with populated principal and target process paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Security and EDR agents, backup or imaging software, remote support and RMM tools installed under ProgramData or user profiles, software installers and updaters running from Temp, accessibility and screen-capture utilities, and developer debugging tools."
    tuning_guidance = "Add approved tool paths to %global_allowed_security_tools, %global_allowed_admin_tools or %global_allowed_backup_processes. If the telemetry exposes the granted access mask (PROCESS_CREATE_PROCESS, 0x0080), add a condition on it to sharply reduce volume. Pair this rule with a process-launch parent/child mismatch rule for higher fidelity."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\(explorer|svchost|winlogon|services|spoolsv|wininit)\.exe$/ nocase
    $open.principal.process.file.full_path = /(\\users\\[^\\]+\\|\\programdata\\|\\windows\\temp\\|\\temp\\|\\appdata\\|\\users\\public\\|\\perflogs\\|\\\$recycle\.bin\\)/ nocase
    $open.principal.process.pid != $open.target.process.pid
    not $open.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|SenseCncProxy)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1134.004")
    $primary_entity = array_distinct($open.principal.hostname)
    $source_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $acting_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
