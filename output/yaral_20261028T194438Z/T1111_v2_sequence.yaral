/*
  MITRE Technique : T1111 - Multi-Factor Authentication Interception
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:10:31.324800+00:00
  Reference       : https://attack.mitre.org/techniques/T1111
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1111_Linux_PAM_Module_Drop_Then_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a new shared object written to a PAM module directory, followed within 10 minutes on the same host by a modification of a /etc/pam.d service file. This sequence is how an adversary installs a malicious PAM module to capture passwords and MFA one-time codes, or to bypass the second factor, during SSH, sudo, or login authentication."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1111"
    mitre_technique_name = "Multi-Factor Authentication Interception"
    log_prerequisites = "Requires Linux EDR or auditd file telemetry with FILE_CREATION and FILE_MODIFICATION events that populate target.file.full_path and principal.process.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package manager installs or upgrades of PAM modules (for example Google Authenticator, Duo, SSSD, or fprintd), configuration management runs, and authentication profile tools such as authselect or pam-auth-update."
    tuning_guidance = "Add approved package managers, configuration management agents, and deployment tooling to %global_allowed_admin_tools. Add trusted agents to %global_allowed_security_tools. The built-in regex already excludes common package manager and authentication profile tool executables. Extend the module directory regex if a distribution uses a non-standard PAM path."

  events:
    $pam_mod.metadata.event_type = "FILE_CREATION"
    $pam_mod.target.file.full_path = /^\/(usr\/)?lib(64)?\/([^\/]+\/)*security\/[^\/]+\.so(\.[0-9]+)*$/ nocase
    not $pam_mod.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|yum|dnf|zypper|pacman|packagekitd|unattended-upgr|snapd)$/ nocase
    not $pam_mod.principal.process.file.full_path in %global_allowed_admin_tools
    not $pam_mod.principal.process.file.full_path in %global_allowed_security_tools
    $pam_mod.principal.hostname = $hostname

    $pam_cfg.metadata.event_type = "FILE_MODIFICATION"
    $pam_cfg.target.file.full_path = /^\/etc\/pam\.d\/[^\/]+$/ nocase
    not $pam_cfg.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|yum|dnf|zypper|pacman|packagekitd|unattended-upgr|snapd|authselect|authconfig|pam-auth-update)$/ nocase
    not $pam_cfg.principal.process.file.full_path in %global_allowed_admin_tools
    not $pam_cfg.principal.process.file.full_path in %global_allowed_security_tools
    $pam_cfg.principal.hostname = $hostname

    $pam_mod.metadata.event_timestamp.seconds <= $pam_cfg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1111")
    $primary_entity = array_distinct($pam_cfg.principal.hostname)
    $dropped_modules = array_distinct($pam_mod.target.file.full_path)
    $modified_pam_configs = array_distinct($pam_cfg.target.file.full_path)
    $module_writer_processes = array_distinct($pam_mod.principal.process.file.full_path)
    $config_writer_processes = array_distinct($pam_cfg.principal.process.file.full_path)
    $acting_users = array_distinct($pam_cfg.principal.user.userid)

  condition:
    $pam_mod and $pam_cfg
}
