/*
  MITRE Technique : T1040 - Network Sniffing
  Tactic(s)       : Credential Access, Discovery
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:27:35.578873+00:00
  Reference       : https://attack.mitre.org/techniques/T1040
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1040_Remote_Packet_Capture_Stream_To_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a perimeter-observed connection to an external destination on a port used by remote packet-capture and mirrored-traffic streaming protocols (RPCAP passive/active mode and TZSP). Legitimate use of these protocols is almost always internal, so an internal host reaching an external address on them suggests captured traffic is being streamed out, or a host is being used as a remote sniffer. This is network-side coverage that complements endpoint command-line detections."
    mitre_tactic = "Credential Access, Discovery"
    mitre_technique = "T1040"
    mitre_technique_name = "Network Sniffing"
    log_prerequisites = "Requires firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated for outbound sessions."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Authorised vendor or MSSP troubleshooting that streams packet captures to an external analysis host, third-party network performance monitoring sending mirrored traffic to a cloud collector, penetration tests, and unrelated services that use these high ports as ephemeral or custom application ports."
    tuning_guidance = "Add authorised testing sources to %global_allowed_scanners and approved capture or monitoring sources to %global_allowed_mgmt_sources. Add known-good external collector domains or IPs to the exclusion lists used by the client. If a client has custom applications on these ports, scope exclusions to the specific source host using %global_allowed_admin_tools or a tenant-level allowlist. Raise severity if the source is a server or domain controller."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 2002 or $net.target.port = 2003 or $net.target.port = 37008)
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1040")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
