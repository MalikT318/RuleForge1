/*
  MITRE Technique : T1547.014 - Active Setup
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:42:28.049666+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_014_ActiveSetup_StubPath_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound connection to a non-internal address from a process spawned by runonce.exe, the Windows component that executes Active Setup StubPath commands at user logon. A payload planted under HKLM\\SOFTWARE\\Microsoft\\Active Setup\\Installed Components often calls out to C2 or downloads a second stage at the first logon after the key is created. This is network-side coverage that complements endpoint registry and command-line detections."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.014"
    mitre_technique_name = "Boot or Logon Autostart Execution: Active Setup"
    log_prerequisites = "Requires endpoint network-connection telemetry (EDR or Sysmon Event ID 3 equivalent) that populates the initiating process and its parent process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers or per-user component setup (browser, runtime, or productivity suite first-run tasks) that use Active Setup and download content at first logon. Corporate deployment agents that run through runonce.exe. Other RunOnce-based activity (T1547.001) that also runs via runonce.exe and reaches the internet."
    tuning_guidance = "Add approved deployment or setup binaries to %global_allowed_admin_tools. Add EDR/AV agents to %global_allowed_security_tools. If a client's software estate legitimately downloads at first logon, allowlist the initiating process executable name rather than an install path. Correlate with endpoint registry events on Active Setup\\Installed Components\\*\\StubPath for the same host to raise confidence."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.parent_process.file.full_path = /\\runonce\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR)\.exe$/ nocase

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1547.014")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $initiating_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
