/*
  MITRE Technique : T1021.008 - Direct Cloud VM Connections
  Tactic(s)       : Lateral Movement
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:46:11.251782+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_008_Cloud_VM_Console_Enabled_Then_Direct_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects one cloud identity first enabling or altering direct VM console and SSH-key access settings, then opening a direct interactive connection to cloud-hosted compute within ten minutes. This sequence is typical of an adversary using valid accounts to pivot into virtual infrastructure through cloud-native console channels instead of the network."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.008"
    mitre_technique_name = "Remote Services: Direct Cloud VM Connections"
    log_prerequisites = "Cloud control-plane audit logs (management and data-plane API events) ingested and normalised to UDM, with metadata.product_event_type and principal.user.userid populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Cloud engineers doing break-glass troubleshooting of an unreachable VM; migration or onboarding automation that enables console access and then verifies it; infrastructure-as-code pipelines; support staff using approved session tooling."
    tuning_guidance = "Add known administrator accounts to %global_allowed_admin_users, automation identities to %global_allowed_service_accounts, and approved cloud service principals to %global_allowed_cloud_principals. If the product_event_type regexes miss a provider's action names, extend them. Raise severity when the target resource is production or the user is not an administrator."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(EnableSerialConsoleAccess|SetCommonInstanceMetadata|instances\.setMetadata|serialConsole|serialPort|ModifyInstanceMetadataOptions)/ nocase
    $setting.principal.user.userid = $user
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_cloud_principals

    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.metadata.product_event_type = /(SendSerialConsoleSSHPublicKey|SendSSHPublicKey|StartSession|connectSerialPort|serialPorts|SerialConsole)/ nocase
    $access.principal.user.userid = $user
    not $access.principal.user.userid in %global_allowed_admin_users
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_cloud_principals

    $setting.metadata.event_timestamp.seconds <= $access.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1021.008")
    $primary_entity = array_distinct($user)
    $setting_actions = array_distinct($setting.metadata.product_event_type)
    $access_actions = array_distinct($access.metadata.product_event_type)
    $target_resources = array_distinct($access.target.resource.name)
    $source_ips = array_distinct($access.principal.ip)
    $access_event_count = count($access.metadata.id)

  condition:
    $setting and $access
}
