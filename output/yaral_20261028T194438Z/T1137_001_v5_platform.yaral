/*
  MITRE Technique : T1137.001 - Office Template Macros
  Tactic(s)       : Persistence
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:15:02.047940+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_001_Office_Template_Macro_File_Written_To_Cloud_Storage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a macro-enabled Office base template (Word Normal.dotm, Excel Personal.xlsb or XLSTART add-ins, or a macro-enabled .dotm/.xltm/.potm file in a Templates folder) being written or modified in a Microsoft 365 or Google Workspace tenant. Roaming profile, folder redirection and OneDrive known-folder sync move these files into cloud storage. An adversary who plants a macro in a base template for persistence therefore produces a content-update audit event. Templates that load on every Office application start are a persistence mechanism."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.001"
    mitre_technique_name = "Office Application Startup: Office Template Macros"
    log_prerequisites = "Requires Microsoft 365 or Google Workspace unified audit logs with file activity (file modified or uploaded) ingested and normalised to UDM, with target.file.full_path populated. Requires OneDrive/SharePoint or Drive audit coverage."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate template authors and corporate template or add-in publishers updating shared templates, IT administrators deploying standard Normal.dotm or Personal.xlsb files, users with OneDrive known-folder or roaming profile sync who legitimately keep macros in a personal template, and Excel add-in (.xlam) development."
    tuning_guidance = "Add approved template publishers to %global_allowed_admin_users and automation or deployment accounts to %global_allowed_service_accounts. If a business unit legitimately uses a shared macro template library, narrow the path regex or exclude its owners. Review the principal IP and user for other anomalous activity, and confirm via endpoint telemetry whether the macro content is malicious."

  events:
    $file.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"
    $file.target.file.full_path = /(\/|\\)(normal|normalemail)\.dotm$|(\/|\\)personal\.xlsb$|(\/|\\)xlstart(\/|\\)[^\/\\]+\.(xlsb|xltm|xlam)$|(\/|\\)templates(\/|\\)[^\/\\]+\.(dotm|xltm|potm)$/ nocase
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1137.001")
    $primary_entity = array_distinct($file.principal.user.userid)
    $template_path = array_distinct($file.target.file.full_path)
    $source_ip = array_distinct($file.principal.ip)

  condition:
    $file
}
