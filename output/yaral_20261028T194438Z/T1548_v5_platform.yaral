/*
  MITRE Technique : T1548 - Abuse Elevation Control Mechanism
  Tactic(s)       : Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:27:36.428726+00:00
  Reference       : https://attack.mitre.org/techniques/T1548
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_Office_Suite_Privileged_Role_Granted_By_Unapproved_Actor {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a privileged administrative role or impersonation permission being granted to an account in the Office Suite tenant by an actor who is not an approved administrator or service account. Adversaries abuse the cloud identity control plane to elevate a compromised account (or itself) to an administrative role, which circumvents intended privilege-elevation controls."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548"
    mitre_technique_name = "Abuse Elevation Control Mechanism"
    log_prerequisites = "Requires Microsoft 365 / Google Workspace unified audit logs and directory audit logs ingested via the identity provider feed, with role or permission assignment events normalised to USER_CHANGE_PERMISSIONS. Role names must be populated in target.user.attribute.roles.name or metadata.description."
    platform = "Office Suite"
    log_source = "identity"
    false_positives = "Planned onboarding of new administrators, privileged identity management just-in-time role activations, helpdesk delegation workflows, and MSP or partner delegated-admin provisioning performed by accounts not yet allowlisted."
    tuning_guidance = "Add named administrators to %global_allowed_admin_users, automation and provisioning identities to %global_allowed_service_accounts, and approved application or service principals to %global_allowed_cloud_principals. Self-assignment (actor equals target) raises the risk score automatically; review those first."

  events:
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    (
      $perm.target.user.attribute.roles.name = /(global admin|company admin|super admin|privileged role admin|privileged authentication admin|application impersonation|exchange admin|security admin|user access admin|sharepoint admin|compliance admin)/ nocase or
      $perm.metadata.description = /(global admin|company admin|super admin|privileged role admin|privileged authentication admin|application impersonation|exchange admin|security admin|user access admin|sharepoint admin|compliance admin)/ nocase
    )
    $perm.principal.user.userid != ""
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(if($perm.principal.user.userid = $perm.target.user.userid, 90, 75))
    $mitre_technique_id = array_distinct("T1548")
    $primary_entity = array_distinct($perm.target.user.userid)
    $actor = array_distinct($perm.principal.user.userid)
    $granted_roles = array_distinct($perm.target.user.attribute.roles.name)
    $source_ips = array_distinct($perm.principal.ip)

  condition:
    $perm
}
