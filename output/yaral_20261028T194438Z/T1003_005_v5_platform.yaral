/*
  MITRE Technique : T1003.005 - Cached Domain Credentials
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:45:50.863432+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_005_Linux_SSSD_Quest_Credential_Cache_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a file read of the Linux cached domain credential stores (SSSD cache_<domain>.ldb or Quest VAS vas_auth.vdb) by any process other than the legitimate authentication daemons. Dumping these databases with tdbdump, ldbsearch, cp, python or a custom binary yields cached password hashes for offline cracking. Detection is based on file-access telemetry (auditd watch rules or EDR file-read events) rather than process command lines, and complements existing command-line detections."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.005"
    mitre_technique_name = "OS Credential Dumping: Cached Domain Credentials"
    log_prerequisites = "Requires Linux file-read telemetry for /var/lib/sss/db/ and /var/opt/quest/vas/authcache/. With auditd, add watch rules such as: -w /var/lib/sss/db -p r -k sssd_cache and -w /var/opt/quest/vas/authcache -p r -k vas_cache. The telemetry must be normalised to UDM FILE_READ with principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup or imaging agents reading /var/lib/sss; EDR or AV agents scanning the files; configuration management or SSSD troubleshooting by admins (sssctl, sss_cache, sss_debuglevel); package updates of sssd or the Quest agent; filesystem snapshot or migration tools."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes, EDR/AV agents to %global_allowed_security_tools, and admin or config-management tooling to %global_allowed_admin_tools. If SSSD is installed in a non-standard location, extend the daemon-path exclusion regex. Make sure the SSSD and Quest daemon reads themselves are not audited at high volume, or rely on the path exclusion."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /^\/var\/lib\/sss\/db\/cache_[^\/]+\.ldb$|^\/var\/opt\/quest\/vas\/authcache\/vas_auth\.vdb$/ nocase
    not $file.principal.process.file.full_path = /^\/(usr\/)?(sbin|libexec|lib|lib64|lib\/x86_64-linux-gnu)(\/sssd)?\/(sssd|sssd_[a-z]+)$|^\/opt\/quest\/sbin\/vasd$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1003.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $accessed_file = array_distinct($file.target.file.full_path)
    $reading_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
