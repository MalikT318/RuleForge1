/*
  MITRE Technique : T1548.003 - Sudo and Sudo Caching
  Tactic(s)       : Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:32:25.019199+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_003_Sudoers_Modified_Then_Sudo_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a write to /etc/sudoers or /etc/sudoers.d/ by a non-approved process, followed within 10 minutes on the same host by a shell spawned directly by sudo. This sequence suggests an adversary weakened the sudo policy (for example NOPASSWD or a new privileged user) and then used it to obtain an elevated shell. It relies on file integrity and process lineage rather than command-line matching."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.003"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Sudo and Sudo Caching"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry covering /etc/sudoers and /etc/sudoers.d/, plus process launch telemetry with parent process path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators editing sudoers with visudo, configuration management agents (Ansible, Puppet, Chef, Salt) pushing sudoers.d fragments, package installs that drop sudoers.d files, followed by an admin legitimately running sudo to open a shell, and provisioning or golden-image build hosts."
    tuning_guidance = "Add approved configuration-management and editing tools to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Add named administrators to %global_allowed_admin_users. Add build or provisioning hosts to %global_allowed_script_hosts."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/sudoers(\.d\/[^\/]+)?$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|yum|dnf|zypper)$/ nocase
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/sudo$/ nocase
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|csh|tcsh)$/ nocase
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.hostname in %global_allowed_script_hosts
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1548.003")
    $primary_entity = array_distinct($hostname)
    $modified_sudoers_files = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $writer_users = array_distinct($file.principal.user.userid)
    $sudo_shell_users = array_distinct($proc.principal.user.userid)
    $sudo_shell_count = count($proc.metadata.id)

  condition:
    $file and $proc
}
