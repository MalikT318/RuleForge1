/*
  MITRE Technique : T1003.006 - DCSync
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:47:48.566925+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_006_DCSync_Replication_Network_IPS_Verdict {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Network-layer detection of DCSync. An IDS/IPS verdict flags directory replication (DRSUAPI / DRSGetNCChanges) RPC traffic towards a domain controller from a source that is not an approved replication peer. This covers DCSync launched from any host, including unmanaged or non-Windows hosts with no EDR, and complements process command-line rules."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.006"
    mitre_technique_name = "OS Credential Dumping: DCSync"
    log_prerequisites = "IDS/IPS with directory-replication or credential-dumping signatures enabled and inspecting RPC traffic to domain controllers. The signature name or description must be mapped into UDM security_result.rule_name or security_result.description."
    platform = "Windows"
    log_source = "ips"
    false_positives = "Legitimate domain controller to domain controller replication, directory synchronisation servers (e.g. identity sync connectors), identity governance and migration tools, authorised vulnerability scanners or red-team sources, and noisy signature matches on benign RPC traffic."
    tuning_guidance = "Add the addresses of all domain controllers and directory sync servers to %global_allowed_mgmt_sources. Add authorised security testing sources to %global_allowed_scanners. If the IPS vendor uses different signature wording, align the regex with the client's signature taxonomy. Because mapping to UDM varies by vendor, do not rely on security_result.action."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.security_result.rule_name = /(drsuapi|drsgetncchanges|ms-drsr|dcsync|directory[\s_-]*replication|replication[\s_-]*service)/ nocase or
      $net.security_result.description = /(drsuapi|drsgetncchanges|ms-drsr|dcsync|directory[\s_-]*replication|replication[\s_-]*service)/ nocase
    )
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1003.006")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $source_ips = array_distinct($net.principal.ip)
    $target_dcs = array_distinct(strings.coalesce($net.target.hostname, $net.target.ip))
    $signature_names = array_distinct($net.security_result.rule_name)

  condition:
    $net
}
