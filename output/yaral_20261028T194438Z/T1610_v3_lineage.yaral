/*
  MITRE Technique : T1610 - Deploy Container
  Tactic(s)       : Execution
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:29:18.695119+00:00
  Reference       : https://attack.mitre.org/techniques/T1610
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1610_Container_Deploy_From_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a container deployment command (run, create, apply, runp) executed by a container CLI or a shell whose parent is a web server, application runtime, or database service. Such services have no legitimate reason to launch containers. This lineage typically indicates remote code execution on a workload or node, followed by deployment of an attacker-controlled or privileged container."
    mitre_tactic = "Execution"
    mitre_technique = "T1610"
    mitre_technique_name = "Deploy Container"
    log_prerequisites = "Requires container-runtime or node-level process telemetry (in-container or host PROCESS_LAUNCH) with parent process path and full command line populated."
    platform = "Containers"
    log_source = "container"
    false_positives = "CI/CD agents running on a Java or Node runtime that build and launch containers (for example build servers); web-based admin consoles or dashboards that intentionally deploy containers; developer sandbox hosts; application platforms that launch job containers from a service process."
    tuning_guidance = "Add approved CI/CD or orchestration parent binaries to %global_allowed_admin_tools. Add approved automation hosts or parent runtimes to %global_allowed_script_hosts. Add deployment service accounts to %global_allowed_service_accounts. If the java or node parents are too noisy for a client, narrow the parent regex per tenant."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|php-fpm[0-9.]*|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server)$/ nocase
    $proc.target.process.file.full_path = /\/(docker|podman|nerdctl|crictl|ctr|kubectl|sh|bash|dash|ash)$/ nocase
    $proc.target.process.command_line = /\b(docker|podman|nerdctl|crictl|ctr|kubectl)\b.*\b(run|create|apply|runp)\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1610")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
