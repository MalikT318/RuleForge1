/*
  MITRE Technique : T1185 - Browser Session Hijacking
  Tactic(s)       : Collection
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:30:32.668246+00:00
  Reference       : https://attack.mitre.org/techniques/T1185
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1185_Browser_Process_Injection_By_NonBrowser {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a non-browser process injecting code or a thread into a web browser process. Injection into a browser is the core mechanism of browser session hijacking (man-in-the-browser, browser pivoting). It lets the adversary inherit the user's cookies, authenticated sessions and client certificates."
    mitre_tactic = "Collection"
    mitre_technique = "T1185"
    mitre_technique_name = "Browser Session Hijacking"
    log_prerequisites = "Requires Windows endpoint telemetry that reports cross-process injection events (remote thread creation, process hollowing or memory write into another process), normalised to PROCESS_INJECTION with principal and target process paths populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Accessibility and screen-reader software, password managers and autofill helpers, DLP and web-filtering agents, endpoint security products, browser-vendor updaters and elevation helpers, remote support tools, and application-compatibility shims."
    tuning_guidance = "Add legitimate injecting binaries to %global_allowed_security_tools (EDR/DLP/web-filter agents) or %global_allowed_admin_tools (deployment and support tooling). Review the $source_process outcome per client to identify recurring benign injectors before adding them to the lists."

  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.target.process.file.full_path = /\\(chrome|msedge|firefox|brave|opera|vivaldi|iexplore)\.exe$/ nocase
    $inj.principal.process.file.full_path != ""
    not $inj.principal.process.file.full_path = /\\(chrome|msedge|firefox|brave|opera|vivaldi|iexplore)\.exe$/ nocase
    not $inj.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|GoogleUpdate|MicrosoftEdgeUpdate|elevation_service)\.exe$/ nocase
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1185")
    $primary_entity = array_distinct($inj.principal.hostname)
    $source_process = array_distinct($inj.principal.process.file.full_path)
    $target_browser = array_distinct($inj.target.process.file.full_path)
    $affected_user = array_distinct($inj.principal.user.userid)

  condition:
    $inj
}
