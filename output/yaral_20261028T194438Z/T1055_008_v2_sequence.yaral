/*
  MITRE Technique : T1055.008 - Ptrace System Calls
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:54:25.836544+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_008_Ptrace_Injection_From_Dropped_Binary {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a file written to a world-writable staging directory (/tmp, /var/tmp, /dev/shm) and then, within 5 minutes on the same host, that same file path acting as the source process of a ptrace-style process injection into another process. This dropped-then-injects lineage is characteristic of ptrace code injection and does not depend on command-line matching."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.008"
    mitre_technique_name = "Process Injection: Ptrace System Calls"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that normalises file creation and ptrace-based process injection (PROCESS_INJECTION) with principal process path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers or support engineers running debuggers, tracers or profilers from a temporary directory; CI/CD build agents that compile and debug test binaries in /tmp; crash-reporting or APM agents that unpack helpers into /var/tmp; authorised red-team exercises."
    tuning_guidance = "Add approved debugging, profiling and deployment tooling to %global_allowed_admin_tools (file writer side) and %global_allowed_security_tools (injecting process side). Add named administrators to %global_allowed_admin_users. Exclude known build or CI hosts by suppressing at the client level. Widen the staging directory regex if the client uses other writable staging paths."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    $file.target.file.full_path = $path
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users

    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    $inj.principal.process.file.full_path = $path
    $inj.principal.hostname = $host
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.user.userid in %global_allowed_admin_users

    $file.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $host, $path over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.008")
    $primary_entity = array_distinct($host)
    $injector_path = array_distinct($path)
    $injected_targets = array_distinct($inj.target.process.file.full_path)
    $injecting_users = array_distinct($inj.principal.user.userid)
    $first_drop_time = min($file.metadata.event_timestamp.seconds)
    $injection_count = count($inj.metadata.id)

  condition:
    $file and $inj
}
