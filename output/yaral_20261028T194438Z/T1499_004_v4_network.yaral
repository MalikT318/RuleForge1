/*
  MITRE Technique : T1499.004 - Application or System Exploitation
  Tactic(s)       : Impact
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:22:59.828966+00:00
  Reference       : https://attack.mitre.org/techniques/T1499/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1499_004_External_DNS_TKEY_TSIG_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects DNS queries for the TKEY or TSIG meta record types arriving at a Linux DNS server from an external (non-RFC1918) source. These are control-plane record types that ordinary resolvers and clients do not send to a public-facing name server. Malformed or unexpected queries of this kind are a known way to trigger assertion failures and crashes in DNS daemons such as BIND (Sucuri BIND9 DoS, 2015), which can cause a persistent denial of service if the service auto-restarts and is re-exploited. This is a network-side detection and complements endpoint rules for the same technique."
    mitre_tactic = "Impact"
    mitre_technique = "T1499.004"
    mitre_technique_name = "Endpoint Denial of Service: Application or System Exploitation"
    log_prerequisites = "Requires DNS server query logging (for example BIND query logs shipped via syslog or an EDR/network sensor on the Linux DNS host) normalised to NETWORK_DNS with principal.ip as the client and network.dns.questions.type populated. Linux endpoint telemetry is expected to be present for correlation."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Authorised vulnerability scanners and DNS conformance testing; external secondary or partner name servers that legitimately use TSIG-signed transactions; DNSSEC or dynamic-update tooling run from outside the internal address space; research scanners probing the internet."
    tuning_guidance = "Add approved external secondary or partner DNS servers to %global_allowed_mgmt_sources. Add scanners and testing sources to %global_allowed_scanners. If TSIG is used legitimately with external peers, remove the TSIG (250) condition or tighten it with the allowlists. Pair with a crash or restart rule on the DNS daemon to raise confidence."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    ($dns.network.dns.questions.type = 249 or $dns.network.dns.questions.type = 250)
    not $dns.principal.ip in %rfc1918_internal
    not $dns.principal.ip in %global_allowed_mgmt_sources
    not $dns.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1499.004")
    $primary_entity = array_distinct($dns.target.hostname)
    $source_ips = array_distinct($dns.principal.ip)
    $queried_names = array_distinct($dns.network.dns.questions.name)

  condition:
    $dns
}
