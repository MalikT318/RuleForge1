/*
  MITRE Technique : T1482 - Domain Trust Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:30:13.833158+00:00
  Reference       : https://attack.mitre.org/techniques/T1482
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1482_Domain_Trust_Discovery_LDAP_Volume_From_Script_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single host makes a burst of LDAP / LDAPS / Global Catalog connections from a scripting or living-off-the-land process within ten minutes. Individual LDAP queries are routine, but sustained volume from an interpreter is typical of scripted Active Directory and domain trust enumeration (DirectorySearcher, DSEnumerateDomainTrusts or .NET trust methods). This detects the network result rather than the command line, so it complements process-creation rules."
    mitre_tactic = "Discovery"
    mitre_technique = "T1482"
    mitre_technique_name = "Domain Trust Discovery"
    log_prerequisites = "Requires EDR or Sysmon network connection telemetry (Sysmon Event ID 3 equivalent) with the initiating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin PowerShell scripts for AD reporting, IT inventory and identity-governance scripts, logon scripts that query LDAP, RMM health checks, and vulnerability or AD assessment tools."
    tuning_guidance = "Add approved AD tooling to %global_allowed_admin_tools, scanners to %global_allowed_scanners, and approved script hosts to %global_allowed_script_hosts. Raise the connection threshold (#net >= 10) for environments with heavy scripted AD automation."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(powershell|pwsh|cscript|wscript|mshta|rundll32|regsvr32|cmd|wmic|installutil|msbuild)\.exe$/ nocase
    (
      $net.target.port = 389 or
      $net.target.port = 636 or
      $net.target.port = 3268 or
      $net.target.port = 3269
    )
    $net.principal.hostname = $host
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_script_hosts
    not $net.principal.hostname in %global_allowed_scanners

  match:
    $host over 10m

  outcome:
    $risk_score = max(55)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1482")
    $primary_entity = array_distinct($host)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_processes = array_distinct($net.principal.process.file.full_path)
    $users = array_distinct($net.principal.user.userid)

  condition:
    #net >= 10
}
