/*
  MITRE Technique : T1556.007 - Hybrid Identity
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:24:21.851347+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_007_External_Access_Federation_Sync_Endpoints {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects HTTP requests from non-internal sources to hybrid identity management endpoints: the directory provisioning/sync web service, federation metadata and the federation MEX endpoint. Adversaries use these endpoints to read token-signing material, change federation or sync settings, or register rogue sync and pass-through agents so they can backdoor cloud authentication tied to on-premises identities. The rule keys on URL path structure rather than domains, tool names or user agents, so it still fires if the tooling or hosting changes."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.007"
    mitre_technique_name = "Modify Authentication Process: Hybrid Identity"
    log_prerequisites = "Requires NETWORK_HTTP telemetry with target.url and principal.ip populated, for example from a secure web gateway, reverse proxy or WAF in front of the federation service, or identity provider HTTP audit logs. Hosts running the hybrid sync or federation roles should forward their proxy or egress logs."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Legitimate hybrid identity sync servers or federation proxies that egress through a public NAT address. Authorised administrators managing federation or sync settings from remote or VPN addresses. Third-party SaaS applications and relying parties that fetch federation metadata for trust establishment. Identity governance or provisioning platforms that call the provisioning service. External security assessments."
    tuning_guidance = "Add the egress addresses of hybrid sync and federation servers and of approved admin jump hosts to %global_allowed_mgmt_sources. Add named administrator accounts to %global_allowed_admin_users and automation or sync accounts to %global_allowed_service_accounts. If federation metadata fetches by partners are noisy, restrict the URL regex to the provisioning service and MEX endpoints only."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(provisioningservice\.svc|federationmetadata\/2007-06\/federationmetadata\.xml|adfs\/services\/trust\/mex)/ nocase
    $http.principal.ip != ""
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_mgmt_sources
    not $http.principal.user.userid in %global_allowed_admin_users
    not $http.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1556.007")
    $primary_entity = array_distinct(strings.coalesce($http.principal.user.userid, $http.principal.ip))
    $source_ips = array_distinct($http.principal.ip)
    $target_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
