/*
  MITRE Technique : T1539 - Steal Web Session Cookie
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:38:37.608532+00:00
  Reference       : https://attack.mitre.org/techniques/T1539
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1539_M365_Session_Token_Theft_Risk_Signin {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a cloud sign-in event that the identity provider has flagged as a stolen or replayed session token or cookie. Flagged risk types include anomalous token, token issuer anomaly, attacker-in-the-middle and session hijack. The detection relies on the platform's own risk classification, not on attacker infrastructure, so it still fires when a phishing proxy or replay host changes."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1539"
    mitre_technique_name = "Steal Web Session Cookie"
    log_prerequisites = "Microsoft 365 / Entra ID sign-in and risk detection events ingested and normalised to UDM USER_LOGIN. Identity-protection risk detection names must be populated in security_result.summary or security_result.description (requires an identity-protection licence tier on the tenant)."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Users switching between VPN, mobile and corporate networks mid-session; legitimate token refresh from roaming devices; shared or kiosk devices; service or automation accounts using long-lived tokens; users who were already remediated but whose risk event was re-logged."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Triage by checking whether the session IP differs from the original sign-in IP and whether new MFA methods or inbox rules were created afterwards. Treat alerts for privileged users as critical. If a tenant's connector populates the risk type in a different field, extend the two security_result regex conditions accordingly."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid != ""
    (
      $auth.security_result.summary = /(anomalous\s*token|token\s*issuer\s*anomal|attacker\s*in\s*the\s*middle|adversary\s*in\s*the\s*middle|aitm|session\s*(hijack|replay)|token\s*(replay|theft)|stolen\s*(session|cookie|token)|pass\s*the\s*cookie)/ nocase or
      $auth.security_result.description = /(anomalous\s*token|token\s*issuer\s*anomal|attacker\s*in\s*the\s*middle|adversary\s*in\s*the\s*middle|aitm|session\s*(hijack|replay)|token\s*(replay|theft)|stolen\s*(session|cookie|token)|pass\s*the\s*cookie)/ nocase
    )
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1539")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $source_ips = array_distinct($auth.principal.ip)
    $target_application = array_distinct($auth.target.application)
    $risk_summary = array_distinct($auth.security_result.summary)

  condition:
    $auth
}
