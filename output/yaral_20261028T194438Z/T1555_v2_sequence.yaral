/*
  MITRE Technique : T1555 - Credentials from Password Stores
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:52:12.792243+00:00
  Reference       : https://attack.mitre.org/techniques/T1555
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_Secret_Access_Policy_Change_Then_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the same cloud identity modifying permissions or access policy on a secrets vault or secret store, then reading secret values within ten minutes. This pattern indicates an adversary granting themselves access to a password store and harvesting stored credentials."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555"
    mitre_technique_name = "Credentials from Password Stores"
    log_prerequisites = "Requires cloud control-plane audit logs with secret/vault data-plane read events enabled (secret read operations are often not logged by default), normalised to UDM RESOURCE_PERMISSIONS_CHANGE and USER_RESOURCE_ACCESS with metadata.product_event_type and principal.user.userid populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Infrastructure-as-code pipelines that update vault access and immediately deploy applications reading secrets; administrators onboarding a new application or rotating secrets; break-glass access during incidents; automated secret rotation functions."
    tuning_guidance = "Add CI/CD and automation identities to %global_allowed_service_accounts, approved administrators to %global_allowed_admin_users, and approved cloud service principals to %global_allowed_cloud_principals. If the event is too noisy, extend the permission-change regex only to the high-risk operations used in the tenant."

  events:
    $perm.metadata.event_type = "RESOURCE_PERMISSIONS_CHANGE"
    $perm.metadata.product_event_type = /(PutResourcePolicy|SetIamPolicy|vaults\/write|accessPolicies\/write|roleAssignments\/write|UpdateSecret|SetSecretPolicy)/ nocase
    $perm.target.resource.name = /(secret|vault)/ nocase
    $perm.principal.user.userid = $user
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_cloud_principals

    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.metadata.product_event_type = /(GetSecretValue|BatchGetSecretValue|AccessSecretVersion|secrets\/getSecret|vaults\/secrets\/read|SecretGet)/ nocase
    $access.principal.user.userid = $user
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_admin_users
    not $access.principal.user.userid in %global_allowed_cloud_principals

    $perm.metadata.event_timestamp.seconds <= $access.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555")
    $primary_entity = array_distinct($user)
    $secrets_read = array_distinct($access.target.resource.name)
    $read_count = count($access.metadata.id)
    $policy_changes = array_distinct($perm.metadata.product_event_type)
    $source_ips = array_distinct($access.principal.ip)

  condition:
    $perm and $access
}
