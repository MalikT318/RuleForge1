/*
  MITRE Technique : T1048.002 - Exfiltration Over Asymmetric Encrypted Non-C2 Protocol
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:35:32.273853+00:00
  Reference       : https://attack.mitre.org/techniques/T1048/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1048_002_Linux_Large_Outbound_Encrypted_Transfer_Firewall {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a large outbound data transfer from an internal host to an external address over a port normally used for asymmetrically encrypted file transfer protocols (SSH/SFTP/SCP, FTPS, alternate SSH). Observed purely from the network perimeter, so it complements endpoint command-line detections and still fires if the attacker renames tools or uses custom clients."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1048.002"
    mitre_technique_name = "Exfiltration Over Alternative Protocol: Exfiltration Over Asymmetric Encrypted Non-C2 Protocol"
    log_prerequisites = "Requires firewall, proxy, or perimeter flow logs normalised to UDM NETWORK_CONNECTION with populated principal.ip, target.ip, target.port and network.sent_bytes (bytes from internal client to external server)."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Approved offsite backup or replication jobs over SFTP/rsync-over-SSH, software mirroring or CI/CD artefact pushes, vendor managed file transfer, admins copying large files to cloud-hosted VMs, Git-over-SSH pushing very large repositories."
    tuning_guidance = "Add known-good external SFTP/vendor domains to %global_allowed_domains. Adjust the network.sent_bytes threshold (default ~50 MB) per environment baseline. Extend the port list for client-specific encrypted transfer services. Scope the rule to Linux server address ranges in the client's parser or ingestion label if workstation SSH use is noisy."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 22 or $net.target.port = 2222 or $net.target.port = 990 or $net.target.port = 989)
    $net.network.sent_bytes > 52428800
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1048.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
