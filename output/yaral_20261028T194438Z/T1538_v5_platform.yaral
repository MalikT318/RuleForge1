/*
  MITRE Technique : T1538 - Cloud Service Dashboard
  Tactic(s)       : Discovery
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:37:50.994543+00:00
  Reference       : https://attack.mitre.org/techniques/T1538
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1538_OfficeSuite_Admin_Dashboard_Login_NonAdmin {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a sign-in to an administrative, security, or compliance dashboard application in the Office Suite tenant by an account that is not a named administrator or approved service account. Adversaries with stolen credentials use these GUI dashboards to enumerate tenant configuration, users, security findings, and licensed services without making API calls. Written for the SaaS control plane, so it assumes no endpoint telemetry."
    mitre_tactic = "Discovery"
    mitre_technique = "T1538"
    mitre_technique_name = "Cloud Service Dashboard"
    log_prerequisites = "Requires unified audit log ingestion with sign-in events normalised to USER_LOGIN. The target application name must be populated in target.application and the user in principal.user.userid."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Newly promoted or delegated administrators not yet in the admin list, helpdesk or compliance staff with scoped dashboard roles, MSP or partner delegated-admin sessions, auditors and security analysts reviewing the tenant, and automation that signs in interactively."
    tuning_guidance = "Add named administrators to %global_allowed_admin_users and automation or break-glass identities to %global_allowed_service_accounts. Narrow or widen the application-name regex to match how the tenant's audit pipeline populates target.application. If the volume is high, route the alert to a user-risk correlation (e.g. anomalous location or impossible travel) instead of alerting directly."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.application = /(admin(istration)?\s*(center|portal|console)|security\s*(&|and)?\s*compliance|compliance\s*(center|portal)|defender|purview|management\s*(portal|console)|cloud\s*portal|command\s*center)/ nocase
    $auth.principal.user.userid != ""
    not $auth.principal.user.userid in %global_allowed_admin_users
    not $auth.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1538")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $dashboard_apps = array_distinct($auth.target.application)
    $source_ips = array_distinct($auth.principal.ip)

  condition:
    $auth
}
