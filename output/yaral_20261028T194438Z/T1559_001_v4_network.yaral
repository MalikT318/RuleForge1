/*
  MITRE Technique : T1559.001 - Component Object Model
  Tactic(s)       : Execution
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:52:30.802556+00:00
  Reference       : https://attack.mitre.org/techniques/T1559/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_001_COM_Surrogate_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a COM surrogate (dllhost.exe) or Microsoft Management Console (mmc.exe) process opening an outbound connection to a non-internal address. These processes host COM/DCOM objects and rarely initiate internet connections themselves. External traffic from them suggests a COM object is being abused for fileless download, execution or command and control."
    mitre_tactic = "Execution"
    mitre_technique = "T1559.001"
    mitre_technique_name = "Inter-Process Communication: Component Object Model"
    log_prerequisites = "Requires Windows endpoint network telemetry that records the initiating process path (EDR or Sysmon Event ID 3), normalised to UDM NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "MMC snap-ins that contact vendor or cloud services (certificate revocation checks, Azure or Intune consoles). Thumbnail and shell extension hosting through the COM surrogate on cloud-backed file shares. Third-party COM servers hosted in dllhost.exe that call licensing or update services. Security agents that inject into these processes."
    tuning_guidance = "Add approved admin consoles and agents to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. Add known vendor destinations to %global_allowed_domains if the telemetry carries a hostname. Raise severity for servers with no interactive admin use. Review the destination IPs in the outcome."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(dllhost|mmc)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1559.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
