/*
  MITRE Technique : T1055.001 - Dynamic-link Library Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:46:24.590984+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_001_Injection_Host_Process_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows process that normally never initiates external network traffic (notepad, calc, werfault, dllhost, rundll32 and similar) connecting to a non-internal address. This is a network-side indicator of DLL injection, where injected code in a benign host process beacons out or downloads a payload. Complements process-creation rules by observing the post-injection network behaviour."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.001"
    mitre_technique_name = "Process Injection: Dynamic-link Library Injection"
    log_prerequisites = "Requires endpoint network telemetry that populates the owning process path on outbound connections (EDR network events or Sysmon Event ID 3), normalised to UDM NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Werfault.exe uploading crash reports, rundll32.exe or dllhost.exe launched by legitimate shell or COM components that reach the internet, taskhostw.exe running cloud sync tasks, proxy or VPN clients that make these processes appear to connect externally, and Office or Store apps that legitimately host these binaries."
    tuning_guidance = "Add approved process paths to %global_allowed_admin_tools or %global_allowed_security_tools. Add known-good vendor destinations (for example Microsoft error-reporting domains) to %global_allowed_domains. If rundll32 or werfault is too noisy in a given tenant, remove it from the process regex for that tenant only after reviewing baseline traffic."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(notepad|calc|mspaint|wordpad|werfault|dllhost|rundll32|searchprotocolhost|taskhostw|conhost)\.exe$/ nocase
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not re.regex($net.target.ip, `^(127\.|169\.254\.|::1$)`)
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1055.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
