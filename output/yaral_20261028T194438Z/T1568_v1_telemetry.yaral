/*
  MITRE Technique : T1568 - Dynamic Resolution
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:02:26.413071+00:00
  Reference       : https://attack.mitre.org/techniques/T1568
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1568_ESXi_Host_DNS_Resolver_Setting_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a configuration change to the hypervisor host's DNS resolver settings (name servers, search domains, resolver file or static host mapping). Changing how a host resolves names can redirect command-and-control lookups to attacker-controlled infrastructure or support dynamic resolution of C2 endpoints. The rule keys on the resulting setting change rather than the command that produced it, so it still fires when command-line logging is evaded."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1568"
    mitre_technique_name = "Dynamic Resolution"
    log_prerequisites = "ESXi hostd and shell logs ingested and parsed into UDM SETTING_MODIFICATION events, with the acting user and host name populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Planned network re-addressing or DNS server migrations, host provisioning and re-IP workflows, automation profiles that enforce host configuration, and administrators fixing name-resolution problems."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation or lifecycle accounts to %global_allowed_service_accounts. Add trusted management source addresses to %global_allowed_mgmt_sources. Suppress during approved change windows or after host build, and alert more urgently when the change is made by an unusual account or from an unexpected source."

  events:
    $set.metadata.event_type = "SETTING_MODIFICATION"
    (
      $set.target.resource.name = /(dns|resolv\.conf|nameserver|search\s*domain|\/etc\/hosts)/ nocase or
      $set.security_result.description = /(dns|resolv\.conf|nameserver|search\s*domain|\/etc\/hosts)/ nocase
    )
    not $set.principal.user.userid in %global_allowed_admin_users
    not $set.principal.user.userid in %global_allowed_service_accounts
    not $set.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1568")
    $primary_entity = array_distinct($set.principal.hostname)
    $acting_user = array_distinct($set.principal.user.userid)
    $changed_setting = array_distinct($set.target.resource.name)

  condition:
    $set
}
