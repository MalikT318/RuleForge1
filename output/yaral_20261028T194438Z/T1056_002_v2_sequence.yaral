/*
  MITRE Technique : T1056.002 - GUI Input Capture
  Tactic(s)       : Collection, Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:47:09.411954+00:00
  Reference       : https://attack.mitre.org/techniques/T1056/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1056_002_Linux_Dropped_Script_Then_Password_Dialog {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a script written to a world-writable staging directory (/tmp, /var/tmp, /dev/shm) followed within 10 minutes on the same host by a shell or interpreter launching a GUI dialog utility configured to collect hidden or password input. This pattern indicates a malicious script spoofing a credential prompt (GUI Input Capture) rather than legitimate administrative use."
    mitre_tactic = "Collection, Credential Access"
    mitre_technique = "T1056.002"
    mitre_technique_name = "Input Capture: GUI Input Capture"
    log_prerequisites = "Requires Linux endpoint telemetry (EDR or auditd) that produces both FILE_CREATION events with the creating process and PROCESS_LAUNCH events with parent process path and command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate desktop installers or admin shell scripts that stage a helper script in /tmp and then use zenity, kdialog or yad to ask the user for a password (for example, custom sudo or VPN wrappers); IT-authored login helper scripts; developers testing dialog-based scripts on workstations."
    tuning_guidance = "Add approved script-launching parents or hosts to %global_allowed_script_hosts, and approved deployment tooling that writes scripts to /tmp to %global_allowed_admin_tools. Servers without a GUI should rarely produce a hit, so consider raising severity there. If a vetted internal wrapper triggers the rule, exclude its parent process path through the reference lists rather than editing the regexes."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+\.(sh|bash|py|pl|rb)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(zenity|kdialog|yad|xdialog|dialog|whiptail)$/ nocase
    $proc.target.process.command_line = /(--password|--hide-text|--passwordbox|--insecure|--entry)/ nocase
    $proc.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|python[0-9.]*|perl|ruby)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1056.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $dropped_scripts = array_distinct($file.target.file.full_path)
    $dialog_commands = array_distinct($proc.target.process.command_line)
    $affected_users = array_distinct($proc.principal.user.userid)
    $event_count = count($proc.metadata.id)

  condition:
    $file and $proc
}
