/*
  MITRE Technique : T1564.013 - Bind Mounts
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:33:29.498974+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_013_Staged_Binary_Then_Proc_Bind_Mount {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a binary executed from a world-writable staging directory (/tmp, /var/tmp, /dev/shm) followed within 10 minutes, on the same host, by a bind mount that overlays a /proc/<pid> directory. This is the technique used to hide a malicious process behind a benign process's /proc entry. The rule adds execution-staging context to the mount event and does not rely on the mount command line alone."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.013"
    mitre_technique_name = "Hide Artifacts: Bind Mounts"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry with full command lines, normalised to UDM PROCESS_LAUNCH with principal.hostname populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software installers or build jobs that run helper binaries from /tmp and then bind mount /proc paths (chroot/rootfs builders, image build pipelines); container or sandbox tooling that bind mounts /proc/<pid> entries; administrators troubleshooting namespaces."
    tuning_guidance = "Add approved deployment, build and orchestration parent processes to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. If build hosts are noisy, exclude them by adding their launcher processes to %global_allowed_script_hosts or by scoping the rule per client."

  events:
    $stage.metadata.event_type = "PROCESS_LAUNCH"
    $stage.target.process.file.full_path = /^\/(dev\/shm|var\/tmp|tmp)\// nocase
    not $stage.principal.process.file.full_path in %global_allowed_admin_tools
    not $stage.principal.user.userid in %global_allowed_service_accounts
    $stage.principal.hostname = $hostname

    $mnt.metadata.event_type = "PROCESS_LAUNCH"
    $mnt.target.process.file.full_path = /\/mount$/ nocase
    $mnt.target.process.command_line = /(\s-[a-zA-Z]*B\b|--r?bind\b|\s-o\s*\S*bind)/
    $mnt.target.process.command_line = /\/proc\/[0-9]+/
    not $mnt.principal.process.file.full_path in %global_allowed_admin_tools
    not $mnt.principal.user.userid in %global_allowed_service_accounts
    $mnt.principal.hostname = $hostname

    $stage.metadata.event_timestamp.seconds <= $mnt.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1564.013")
    $primary_entity = array_distinct($mnt.principal.hostname)
    $staged_binaries = array_distinct($stage.target.process.file.full_path)
    $staged_command_lines = array_distinct($stage.target.process.command_line)
    $mount_command_lines = array_distinct($mnt.target.process.command_line)
    $acting_users = array_distinct($mnt.principal.user.userid)
    $first_stage_time = min($stage.metadata.event_timestamp.seconds)
    $last_mount_time = max($mnt.metadata.event_timestamp.seconds)

  condition:
    $stage and $mnt
}
