/*
  MITRE Technique : T1622 - Debugger Evasion
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:48:12.620589+00:00
  Reference       : https://attack.mitre.org/techniques/T1622
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1622_Linux_Service_Parent_Spawns_Debugger_Check {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, database, print or application service process spawning a shell, script interpreter or text utility whose command line reads the TracerPid field from /proc/<pid>/status. Service daemons rarely run debugger checks. This pattern indicates a webshell, exploited service or dropped implant testing for a debugger or sandbox before continuing."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1622"
    mitre_technique_name = "Debugger Evasion"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records (with full command-line arguments) normalised to UDM PROCESS_LAUNCH, with principal.process.file.full_path populated for the parent."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Application health-check or diagnostic scripts run by a service wrapper; developers or support staff debugging a service under a service account; APM or profiling agents launched by the application runtime; security tooling that inspects /proc/<pid>/status for tracer state."
    tuning_guidance = "Add legitimate parent process paths (for example monitoring wrappers or APM launchers) to %global_allowed_script_hosts, and approved diagnostic tooling to %global_allowed_admin_tools. Extend the parent-name regex with client-specific service daemons if needed. Review hits from hosts under active debugging or incident response before suppressing."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|php-fpm[0-9.]*|lighttpd|tomcat[0-9]*|catalina|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|node|gunicorn|uwsgi)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ash|ksh|python[0-9.]*|perl|ruby|php[0-9.]*|grep|egrep|cat|awk|gawk|sed|head|tail|cut|strings)$/ nocase
    $proc.target.process.command_line = /tracerpid/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1622")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
