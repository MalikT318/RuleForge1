/*
  MITRE Technique : T1087.001 - Local Account
  Tactic(s)       : Discovery
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:52:38.900540+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_001_ESXi_Account_Enum_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects local account enumeration on an ESXi host (esxcli system account list, or reads of /etc/passwd or /etc/shadow) by a shell or utility whose parent is an unexpected management-plane daemon or script interpreter. Normal interactive enumeration comes from an SSH login shell. A web proxy, CIM/WBEM broker, SNMP, host agent or Python parent suggests exploitation of a management service or a scripted implant."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.001"
    mitre_technique_name = "Account Discovery: Local Account"
    log_prerequisites = "ESXi shell and process execution logging forwarded to Chronicle and parsed into PROCESS_LAUNCH events with parent process path and command line populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Vendor or backup agents that run esxcli through the host agent, health-check or inventory scripts run from Python, configuration-management tooling, and admins running troubleshooting scripts via management daemons."
    tuning_guidance = "Add approved automation parents to %global_allowed_admin_tools or %global_allowed_script_hosts. Add known automation accounts to %global_allowed_service_accounts. If a Python-based inventory job is noisy, allowlist its interpreter path instead of removing python from the parent regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(rhttpproxy|envoy|openwsman|sfcbd|sfcb-[a-z_]+|slpd|snmpd|vpxa|hostd|python[0-9.]*)$/ nocase
    $proc.target.process.file.full_path = /\/(esxcli|sh|ash|bash|busybox|cat|grep|awk|sed|head|tail|less|more|getent)$/ nocase
    $proc.target.process.command_line = /(system\s+account\s+list|\/etc\/(passwd|shadow)|getent\s+passwd)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1087.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
