/*
  MITRE Technique : T1505.003 - Web Shell
  Tactic(s)       : Persistence
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:30:51.711254+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_003_WebShell_Repeated_Script_POST_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source sends a high volume of HTTP POST requests to server-side script endpoints (php, asp, aspx, jsp, jspx, cgi, cfm) within ten minutes, as seen at the network perimeter. A single request is benign. Sustained, repeated command-style POSTs to script endpoints match the client-to-web-shell interaction pattern (for example, China Chopper-style clients)."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.003"
    mitre_technique_name = "Server Software Component: Web Shell"
    log_prerequisites = "Firewall, reverse proxy, or WAF logs normalised to NETWORK_HTTP with network.http.method, target.url and principal.ip populated. Requires URL visibility (TLS inspection or a reverse proxy in front of published web servers)."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate web applications with chatty POST endpoints (login forms, AJAX or API handlers, CMS admin panels), payment gateway callbacks, monitoring and synthetic-transaction probes, load-test tools, and authorised vulnerability scanners."
    tuning_guidance = "Add approved scanners to %global_allowed_scanners and trusted partner or management sources to %global_allowed_mgmt_sources. Add known-good destinations to %global_allowed_domains. Raise the #net threshold for busy, application-heavy sites, or lower it for sites that serve only static content."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.url = /\.(php[0-9]?|phtml|asp|aspx|ashx|asmx|jsp|jspx|cgi|cfm)(\?.*)?$/ nocase
    $net.principal.ip = $src
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  match:
    $src over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1505.003")
    $primary_entity = array_distinct($src)
    $targeted_hosts = array_distinct($net.target.hostname)
    $targeted_urls = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    #net >= 25
}
