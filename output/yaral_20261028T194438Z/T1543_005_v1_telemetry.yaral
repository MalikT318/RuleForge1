/*
  MITRE Technique : T1543.005 - Container Service
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:57:01.249159+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_005_K8s_DaemonSet_Creation_Audit {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a Kubernetes DaemonSet through the API server, as recorded in audit logs. DaemonSets schedule a pod on every node, including nodes added later, so an adversary can use one for cluster-wide persistence or privilege escalation. This rule works on the resulting control-plane resource creation, not on any command line, so it still fires whichever client tool or direct API call was used."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.005"
    mitre_technique_name = "Create or Modify System Process: Container Service"
    log_prerequisites = "Kubernetes API server audit logging enabled at Metadata level or higher for apps/v1 daemonsets, and ingested into Chronicle with the request URI mapped to target.url and the requesting identity mapped to principal.user.userid."
    platform = "Containers"
    log_source = "container"
    false_positives = "Legitimate platform components deployed as DaemonSets (CNI plugins, log shippers, monitoring and security agents, CSI drivers), GitOps controllers and CI/CD service accounts, cluster upgrades and managed-cluster add-ons, and platform engineers deploying approved node agents."
    tuning_guidance = "Add GitOps and CI/CD deployer identities and cluster add-on controllers to %global_allowed_service_accounts. Add named platform administrators to %global_allowed_admin_users. Add trusted cloud or identity principals to %global_allowed_cloud_principals. Review matches in kube-system with extra care, because attackers also use that namespace to blend in. Consider raising severity for creations by human users or from external source IPs."

  events:
    $res.metadata.event_type = "RESOURCE_CREATION"
    $res.target.url = /\/apis\/apps\/v1\/(namespaces\/[^\/]+\/)?daemonsets/ nocase
    not $res.principal.user.userid in %global_allowed_service_accounts
    not $res.principal.user.userid in %global_allowed_admin_users
    not $res.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1543.005")
    $primary_entity = array_distinct($res.principal.user.userid)
    $request_uri = array_distinct($res.target.url)
    $source_ips = array_distinct($res.principal.ip)

  condition:
    $res
}
