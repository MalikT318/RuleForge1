/*
  MITRE Technique : T1555.003 - Credentials from Web Browsers
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:56:27.111424+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_003_Non_Browser_HTTP_Post_Exfil_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side detection of the exfiltration step that follows browser credential theft. A non-browser process, either a scripting host or a binary running from a user-writable location, sends an HTTP POST to an external destination. Credential stealers typically stage Login Data, Cookies or decrypted password blobs and upload them this way. Browsers and allowlisted tooling are excluded. This rule complements endpoint rules that match the command line or file access by observing the outbound upload instead."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.003"
    mitre_technique_name = "Credentials from Password Stores: Credentials from Web Browsers"
    log_prerequisites = "Requires NETWORK_HTTP telemetry (proxy, secure web gateway, or EDR network sensor) with process attribution on principal.process.file.full_path and the HTTP method populated. Without process attribution the rule will not match."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software updaters or telemetry agents that run from AppData or Temp and POST to vendor endpoints; user-installed per-user applications (chat clients, sync tools, installers); admin PowerShell or Python scripts calling external REST APIs; developer tooling."
    tuning_guidance = "Add approved vendor and SaaS destinations to %global_allowed_domains. Add approved RMM and deployment binaries to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. Add approved automation hosts to %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts. Raise severity when the same host also triggers a file-access or command-line rule for browser credential stores."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.principal.process.file.full_path = /(\\(powershell|pwsh|wscript|cscript|mshta|python[w]?|rundll32|regsvr32|curl|bitsadmin|certutil)\.exe$|\\users\\[^\\]+\\appdata\\(local\\temp|roaming)\\|\\users\\public\\|\\users\\[^\\]+\\downloads\\|\\windows\\temp\\)/ nocase
    not $net.principal.process.file.full_path = /\\(chrome|msedge|firefox|brave|opera|iexplore|vivaldi|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1555.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_user = array_distinct($net.principal.user.userid)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_urls = array_distinct($net.target.url)

  condition:
    $net
}
