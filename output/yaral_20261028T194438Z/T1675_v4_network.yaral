/*
  MITRE Technique : T1675 - ESXi Administration Command
  Tactic(s)       : Execution
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:20:43.096110+00:00
  Reference       : https://attack.mitre.org/techniques/T1675
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1675_ESXi_External_Mgmt_SDK_Guest_Ops_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects HTTP requests to the hypervisor management API (SOAP SDK endpoint) or the guest file-transfer endpoint, which are used to run guest operations such as starting programs, listing processes and files, and transferring files in and out of guest VMs. The request comes from a source outside internal address space and outside approved management sources. Approved administration should originate from internal or allow-listed management networks, so external-origin access suggests abuse of the ESXi management plane to execute commands on guests."
    mitre_tactic = "Execution"
    mitre_technique = "T1675"
    mitre_technique_name = "ESXi Administration Command"
    log_prerequisites = "Requires ESXi management-plane HTTP request logging (reverse proxy / hostd request logs) or network sensor telemetry parsed into UDM NETWORK_HTTP with principal.ip (client) and target.url populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Remote administrators connecting through a VPN or NAT with a public egress address that is not in %global_allowed_mgmt_sources; managed-service or cloud-based backup, monitoring and orchestration platforms calling the management API from external addresses; vulnerability scanners and authorised penetration tests; NAT'd internal clients that appear with a public source address."
    tuning_guidance = "Add VPN egress, jump host, orchestration and backup source addresses to %global_allowed_mgmt_sources. Add named administrator accounts to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Add authorised scanner sources to %global_allowed_scanners. Confirm that principal.ip holds the real client address rather than a proxy address."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\/(sdk|guestFile)(\/|\?|$)/ nocase
    $net.network.http.method = /^(POST|GET|PUT)$/ nocase
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.user.userid in %global_allowed_admin_users
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1675")
    $primary_entity = array_distinct($net.target.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $requested_urls = array_distinct($net.target.url)
    $source_users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
