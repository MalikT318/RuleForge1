/*
  MITRE Technique : T1046 - Network Service Discovery
  Tactic(s)       : Discovery
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:29:06.672960+00:00
  Reference       : https://attack.mitre.org/techniques/T1046
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1046_Network_Device_External_Probe_Of_Service_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external (non-internal) source connecting to ports commonly probed during network service discovery: Telnet, RPC, NetBIOS, SMB, RDP, VNC, SNMP, and common database listeners. The rule observes perimeter connection logs only and needs no endpoint process data. Because it is a single-event rule it cannot count ports; it flags each probe of a high-value service port. Pair it with a threshold or sequence rule if scan-volume detection is also needed."
    mitre_tactic = "Discovery"
    mitre_technique = "T1046"
    mitre_technique_name = "Network Service Discovery"
    log_prerequisites = "Requires firewall, proxy, or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip and target.port populated. Logs should include permitted and denied connections for best coverage."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners and attack-surface monitoring services, internet-wide research scanners, legitimately published services (RDP gateways, VPN-adjacent services, database endpoints for partners), and third-party managed-service access."
    tuning_guidance = "Add authorised scanner sources to %global_allowed_scanners and trusted management or partner source addresses to %global_allowed_mgmt_sources. Edit the port list to match the services each client legitimately publishes. If the client perimeter already logs only denied traffic, raise severity or pair with a volume-based rule."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 23 or
      $net.target.port = 135 or
      $net.target.port = 139 or
      $net.target.port = 161 or
      $net.target.port = 445 or
      $net.target.port = 1433 or
      $net.target.port = 2323 or
      $net.target.port = 3306 or
      $net.target.port = 3389 or
      $net.target.port = 5432 or
      $net.target.port = 5900
    )
    $net.target.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1046")
    $primary_entity = array_distinct($net.principal.ip)
    $probed_target_ips = array_distinct($net.target.ip)
    $probed_ports = array_distinct($net.target.port)

  condition:
    $net
}
