/*
  MITRE Technique : T1218.011 - Rundll32
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:56:26.589680+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_011_Rundll32_Unexpected_Parent_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects rundll32.exe launched by a parent process that should never spawn it, such as Office applications, web server workers, the print spooler, database engines, or script hosts. This lineage is typical of macro, web shell, spooler exploitation, and script-based payloads that proxy execution through rundll32. Detection rests on the parent-child relationship, not on the command line or the DLL being loaded."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.011"
    mitre_technique_name = "System Binary Proxy Execution: Rundll32"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with parent process path populated (EDR or Sysmon Event ID 1 / Security Event 4688 with parent image)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office or mail clients launching rundll32 for the shell link handler or the Open With dialog (partly excluded by the rule); print management or driver installation spawned by the spooler; line-of-business plugins or database maintenance jobs that legitimately call rundll32; administrative scripts run through wscript or cscript."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts. If Office link-handling noise remains, extend the benign-handler exclusion on the command line. Remove parent families that are noisy in a given environment (for example the print spooler on print servers) after review."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\rundll32\.exe$/ nocase
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|php-cgi|tomcat[0-9]*|spoolsv|sqlservr|mysqld|postgres|wscript|cscript|mshta)\.exe$/ nocase
    not $proc.target.process.command_line = /(url|ieframe)\.dll\s*,\s*(FileProtocolHandler|OpenURL)|shell32(\.dll)?\s*,\s*OpenAs_RunDLL/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.011")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
