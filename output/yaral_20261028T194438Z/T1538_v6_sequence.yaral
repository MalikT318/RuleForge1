/*
  MITRE Technique : T1538 - Cloud Service Dashboard
  Tactic(s)       : Discovery
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:38:06.050340+00:00
  Reference       : https://attack.mitre.org/techniques/T1538
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1538_SaaS_External_Login_Then_Dashboard_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A user signs in from a non-internal source address and, within 10 minutes, accesses several distinct administrative dashboard or console views. This pattern is consistent with an adversary using stolen credentials to browse a cloud service dashboard and enumerate services, assets and findings."
    mitre_tactic = "Discovery"
    mitre_technique = "T1538"
    mitre_technique_name = "Cloud Service Dashboard"
    log_prerequisites = "Requires identity provider sign-in events normalised to USER_LOGIN with principal.ip populated, and SaaS application audit events normalised to USER_RESOURCE_ACCESS with target.resource.name populated. Both sources must carry a consistent principal.user.userid."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Administrators or security analysts working remotely or over VPN or home networks, helpdesk staff reviewing tenant consoles, MSP technicians performing onboarding or audits, newly joined staff exploring consoles, and automated portal health checks that run under named accounts."
    tuning_guidance = "Add expected privileged operators to %global_allowed_admin_users and automation identities to %global_allowed_service_accounts. Raise or lower the distinct-view threshold (#access >= 3) per client. Adjust the dashboard regex on target.resource.name to match how each client's SaaS audit log names console views. Make sure %rfc1918_internal covers client egress ranges, or add a per-client source exclusion."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.principal.user.userid = $user
    not $login.principal.ip in %rfc1918_internal
    not $login.principal.user.userid in %global_allowed_service_accounts
    not $login.principal.user.userid in %global_allowed_admin_users

    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.principal.user.userid = $user
    $access.target.resource.name = /(dashboard|console|command[-_ ]?center|admin[-_ ]?center|security[-_ ]?center|asset[-_ ]?inventory)/ nocase
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_admin_users

    $login.metadata.event_timestamp.seconds <= $access.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1538")
    $primary_entity = array_distinct($user)
    $source_ips = array_distinct($login.principal.ip)
    $dashboard_views = array_distinct($access.target.resource.name)
    $access_count = count($access.metadata.id)

  condition:
    $login and #access >= 3
}
