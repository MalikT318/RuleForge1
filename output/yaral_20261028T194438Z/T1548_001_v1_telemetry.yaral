/*
  MITRE Technique : T1548.001 - Setuid and Setgid
  Tactic(s)       : Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:28:16.472049+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_001_Linux_SUID_SGID_Artifact_In_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a file attribute or permission change (chmod-style, setuid/setgid) on a file inside a world-writable or user-controlled staging location such as /tmp, /var/tmp, /dev/shm, /run/user or a user home directory. It pivots on the file-modification artifact reported by auditd or EDR file telemetry rather than on process command lines. Legitimate software does not normally set privileged mode bits on files in these locations, so a hit suggests a SUID/SGID backdoor or privilege-escalation helper being staged."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.001"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Setuid and Setgid"
    log_prerequisites = "Requires Linux auditd (with file attribute change syscalls such as chmod, fchmod, fchmodat audited on writable paths) or EDR file-modification telemetry normalised to UDM FILE_MODIFICATION."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers and CI build agents setting executable bits on build output in /tmp or home directories; installers and self-extracting packages that unpack to /tmp; configuration management or deployment tooling staging binaries; container or package build processes; administrators legitimately testing SUID behaviour."
    tuning_guidance = "Add approved deployment and build tooling to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and build or CI hosts to %global_allowed_script_hosts. Narrow or extend the staging directory regex to match client filesystem layouts. If the auditd pipeline does not populate metadata.description, rely on the chmod-style process condition and make sure the audit rules cover chmod syscalls."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/user\/[0-9]+|home\/[^\/]+)\// nocase
    (
      $file.metadata.description = /(setuid|setgid|suid|sgid|chmod|fchmod|fchmodat|chattr|mode change|permission change)/ nocase or
      $file.principal.process.file.full_path = /\/(chmod|install)$/ nocase
    )
    not $file.principal.process.file.full_path = /\/(dpkg|rpm|apt|apt-get|yum|dnf|zypper|snapd|packagekitd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1548.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)
    $acting_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
