/*
  MITRE Technique : T1027.010 - Command Obfuscation
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:54:47.679672+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_010_Command_Obfuscation_Volume_Per_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of script-interpreter launches on a single host within 10 minutes whose command lines each carry a command-obfuscation marker: caret insertion, environment-variable substring slicing, [char] casting, string-concatenation splitting, Base64 decode calls, or encoded-command arguments. One such command can be benign; repeated use points to an obfuscated payload or staged script execution."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.010"
    mitre_technique_name = "Obfuscated Files or Information: Command Obfuscation"
    log_prerequisites = "Requires EDR process telemetry, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and deployment scripts that use encoded commands, RMM and patching agents, admin automation that builds strings by concatenation, and build or CI hosts running many PowerShell scripts."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts, deployment and RMM tooling to %global_allowed_admin_tools, and admin accounts to %global_allowed_admin_users. Raise the #proc threshold for noisy build or automation hosts. Review the $sample_commands outcome for common benign patterns."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(\^[^\^]{0,3}){4,}|%[a-z0-9_]+:~-?\d+(,-?\d+)?%|\[char\]\s*\(?\d+|frombase64string|\s-e(nc|ncodedcommand)?\s+[a-z0-9+\/=]{20,}|'\s*\+\s*'|"\s*\+\s*"|\)\s*-join\s*['"]{2}|\{\d+\}\{\d+\}.{0,40}-f\s/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($proc.target.process.command_line = /frombase64string|\s-e(nc|ncodedcommand)?\s+[a-z0-9+\/=]{20,}/ nocase, 80, 55))
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1027.010")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $sample_commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 5
}
