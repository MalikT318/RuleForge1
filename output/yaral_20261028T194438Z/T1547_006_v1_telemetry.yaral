/*
  MITRE Technique : T1547.006 - Kernel Modules and Extensions
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:31:54.591532+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_006_Linux_Kernel_Module_Persistence_File_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of file artifacts that make a Linux kernel module load at boot or that stage a kernel object: new modules-load.d or modprobe.d config files, a new /etc/modules file, a .ko module dropped under /lib/modules, or a .ko file written to a world-writable staging directory. Detection works on the resulting file state, so it still fires when command-line logging is evaded or the loader binary is renamed."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.006"
    mitre_technique_name = "Boot or Logon Autostart Execution: Kernel Modules and Extensions"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules (for example -w /etc/modules-load.d -p wa and -w /lib/modules -p wa) normalised to UDM FILE_CREATION with principal.process populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package manager installs or kernel updates, DKMS rebuilds for third-party drivers (GPU, VPN, hypervisor guest tools), configuration management agents (Ansible, Puppet, Chef, Salt) laying down modules-load.d or modprobe.d files, golden-image or provisioning builds, and kernel developers compiling modules in /tmp."
    tuning_guidance = "Add approved deployment and configuration-management binaries to %global_allowed_admin_tools by full path. Add approved automation accounts to %global_allowed_service_accounts. The built-in package manager and DKMS exclusion is by executable name. Extend it only if a client uses a different package tool. Because the rule covers FILE_CREATION only, pair it with a FILE_MODIFICATION variant if appends to an existing /etc/modules are a concern."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(etc\/(modules-load\.d\/[^\/]+\.conf|modprobe\.d\/[^\/]+\.conf|modules)|(usr\/)?lib\/modules\/[^\/]+\/.+\.ko(\.(xz|zst|gz))?|(tmp|var\/tmp|dev\/shm)\/.*\.ko)$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|yum|dnf|zypper|packagekitd|unattended-upgrade|dkms|depmod|dracut|update-initramfs|kmod|systemd-modules-load)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
