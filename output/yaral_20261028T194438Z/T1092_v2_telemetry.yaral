/*
  MITRE Technique : T1092 - Communication Through Removable Media
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:35:40.765579+00:00
  Reference       : https://attack.mitre.org/techniques/T1092
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1092_Linux_Command_Artifact_On_Removable_Media {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of hidden files or script/command-style files on removable media mount points (/media, /run/media). This file-artifact layer covers command or data relay between hosts over removable media (for example, an air-gapped host staging instructions or collected data for an internet-connected host). It does not depend on command-line logging."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1092"
    mitre_technique_name = "Communication Through Removable Media"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry with full target path and the creating process path. Removable media must be mounted under the standard desktop auto-mount locations /media/<user>/ or /run/media/<user>/."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Users copying scripts or dotfiles to USB drives for legitimate transfer, backup or imaging utilities, IT staff provisioning media with installers, file-manager thumbnail or metadata dotfiles, and developers who keep repositories on external disks."
    tuning_guidance = "Add approved backup or imaging software to %global_allowed_backup_processes. Add deployment tooling to %global_allowed_admin_tools. Add provisioning accounts to %global_allowed_service_accounts. Add approved hosts (kiosks, imaging stations) to %global_allowed_script_hosts. If media is mounted elsewhere (for example /mnt), extend the path prefix regex per client."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(run\/)?media\/[^\/]+\/(.*\/)?(\.[^\/]+|[^\/]+\.(sh|bash|py|pl|rb|elf|bin|cmd|bat|job|cron))$/ nocase
    not $file.target.file.full_path = /\/\.(Trash|fseventsd|Spotlight|TemporaryItems|Trashes)[^\/]*(\/|$)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1092")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_files = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
