/*
  MITRE Technique : T1048.003 - Exfiltration Over Unencrypted Non-C2 Protocol
  Tactic(s)       : Exfiltration
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:38:42.790788+00:00
  Reference       : https://attack.mitre.org/techniques/T1048/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1048_003_ESXi_Unencrypted_Egress_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single ESXi host makes many outbound connections to external addresses over unencrypted protocols (FTP, TFTP, Telnet, HTTP) within ten minutes. Single connections are routine, but repeated plaintext egress from a hypervisor is consistent with data staged from datastores or VM files being exfiltrated over a non-C2 protocol."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1048.003"
    mitre_technique_name = "Exfiltration Over Alternative Protocol: Exfiltration Over Unencrypted Non-C2 Protocol"
    log_prerequisites = "ESXi host network connection telemetry (firewall or vmkernel connection logging) forwarded to Chronicle and normalised to NETWORK_CONNECTION with principal.hostname and target.ip/port populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Host patching or image downloads over HTTP from internal or vendor depots that resolve to public addresses, HTTP-based VIB or ISO retrieval, authorised backup or replication tooling using plain HTTP, vulnerability scanners probing the host, and NTP/proxy-based update checks."
    tuning_guidance = "Add approved patch/depot domains to %global_allowed_domains, approved management or backup destinations to %global_allowed_mgmt_sources, and scanner sources to %global_allowed_scanners. Raise the #net threshold on hosts that routinely pull updates over HTTP."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname = $host
    (
      $net.target.port = 21 or
      $net.target.port = 23 or
      $net.target.port = 69 or
      $net.target.port = 80
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1048.003")
    $primary_entity = array_distinct($host)
    $event_count = count($net.metadata.id)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 10
}
