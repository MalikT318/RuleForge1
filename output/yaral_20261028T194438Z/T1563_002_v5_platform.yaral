/*
  MITRE Technique : T1563.002 - RDP Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:11:07.334959+00:00
  Reference       : https://attack.mitre.org/techniques/T1563/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_002_RDP_Session_Hijack_Tscon_Dest_Switch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the session-takeover command-line pattern used for RDP hijacking: a session ID followed by the /dest: switch (for example 'tscon <id> /dest:rdp-tcp#N'), launched directly, via cmd, or through a service binPath. Matches on the argument combination rather than the binary name, so a renamed tscon.exe is still caught. Platform note: RDP hijacking via Terminal Services is Windows-only, so this variant is written for Windows with a service-wrapper and renamed-binary focus; no Linux, macOS or cloud equivalent of this mechanism exists."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1563.002"
    mitre_technique_name = "Remote Service Session Hijacking: RDP Hijacking"
    log_prerequisites = "Requires EDR process telemetry, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Helpdesk or administrators legitimately reconnecting or moving disconnected sessions on RDS or terminal servers; session-management scripts; RMM tooling that reassigns console sessions."
    tuning_guidance = "Add approved session-management tooling to %global_allowed_admin_tools (matched on parent process path) and named administrators to %global_allowed_admin_users. For RDS farms with frequent legitimate session reassignment, scope exclusions to the specific parent process or admin account rather than the host."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(^|\s|"|')\d{1,5}\s+\/dest:\S+/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1563.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $hijack_command = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
