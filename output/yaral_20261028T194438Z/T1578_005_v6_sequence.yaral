/*
  MITRE Technique : T1578.005 - Modify Cloud Compute Configurations
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:56:57.124724+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_005_Compute_Config_Change_Then_Instance_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A cloud identity changes compute-governing configuration (service quota, region enablement, or tenant-wide policy) and then launches new compute instances within ten minutes. This is a common precursor to resource hijacking such as cryptomining, where the adversary raises limits or widens the allowed deployment scope and then consumes the capacity."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578.005"
    mitre_technique_name = "Modify Cloud Compute Configurations"
    log_prerequisites = "Cloud control-plane audit logs ingested and normalised to UDM with principal.user.userid and metadata.product_event_type populated. Configuration changes must map to SETTING_MODIFICATION and instance launches to RESOURCE_CREATION."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate capacity planning, where a cloud engineer raises a quota and deploys instances in the same session. Infrastructure-as-code pipelines and autoscaling bootstrap automation. Landing-zone or policy-as-code deployments that assign policies and create VMs together. New-project or new-region onboarding by platform teams."
    tuning_guidance = "Add approved platform engineers to %global_allowed_admin_users. Add pipeline and automation identities to %global_allowed_service_accounts and %global_allowed_cloud_principals. Extend the product_event_type regexes with provider-specific API names seen in your environment. Raise the instance count threshold by editing the outcome, or alert on it downstream."

  events:
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.metadata.product_event_type = /(quota|enableregion|regionoptin|optinregion|policyassignment|orgpolic|allowedlocations|allowedvmsku)/ nocase
    $cfg.principal.user.userid != ""
    $cfg.principal.user.userid = $actor
    not $cfg.principal.user.userid in %global_allowed_admin_users
    not $cfg.principal.user.userid in %global_allowed_service_accounts
    not $cfg.principal.user.userid in %global_allowed_cloud_principals

    $create.metadata.event_type = "RESOURCE_CREATION"
    $create.metadata.product_event_type = /(runinstances|instances\.insert|instances\.bulkinsert|virtualmachines.*write|createvirtualmachine|createinstance)/ nocase
    $create.principal.user.userid = $actor
    not $create.principal.user.userid in %global_allowed_service_accounts
    not $create.principal.user.userid in %global_allowed_cloud_principals

    $cfg.metadata.event_timestamp.seconds <= $create.metadata.event_timestamp.seconds

  match:
    $actor over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1578.005")
    $primary_entity = array_distinct($actor)
    $config_actions = array_distinct($cfg.metadata.product_event_type)
    $config_targets = array_distinct($cfg.target.resource.name)
    $created_resources = array_distinct($create.target.resource.name)
    $instance_launch_count = count($create.metadata.id)
    $source_ips = array_distinct($cfg.principal.ip)

  condition:
    $cfg and $create
}
