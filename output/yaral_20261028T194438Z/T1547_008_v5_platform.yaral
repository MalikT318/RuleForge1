/*
  MITRE Technique : T1547.008 - LSASS Driver
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:34:44.393773+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_008_LSA_Security_Package_Registry_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modification of the LSA Security Packages, Authentication Packages or Notification Packages values, which load DLLs into lsass.exe at boot. This is registry-based coverage that complements command-line rules. T1547.008 exists only on Windows, so the alternate-platform pivot was not applicable and the rule targets Windows."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.008"
    mitre_technique_name = "Boot or Logon Autostart Execution: LSASS Driver"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon registry events) normalised to UDM REGISTRY_MODIFICATION with target.registry.registry_key populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate installs of password-filter, smart-card, MFA or credential-provider software that registers a Notification or Security Package; Windows servicing and feature installs; domain-join and hardening tools."
    tuning_guidance = "Add approved installer and deployment binaries to %global_allowed_admin_tools and approved EDR or security agents to %global_allowed_security_tools. Review the modified value data to confirm the DLL is signed and located in System32."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      (
        $reg.target.registry.registry_key = /\\Control\\Lsa(\\OSConfig)?$/ nocase and
        $reg.target.registry.registry_value_name = /^(Security|Authentication|Notification) Packages$/ nocase
      ) or
      $reg.target.registry.registry_key = /\\Control\\Lsa(\\OSConfig)?\\(Security|Authentication|Notification) Packages$/ nocase
    )
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.008")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $registry_value_data = array_distinct($reg.target.registry.registry_value_data)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
