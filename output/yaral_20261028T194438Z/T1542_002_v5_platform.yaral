/*
  MITRE Technique : T1542.002 - Component Firmware
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:45:17.038807+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_002_Component_Firmware_Flash_Cmdline {
  // NOTE: The brief asked for an alternate-platform pivot but also mandated platform = Windows
  // and log_source = windows_endpoint. The mandatory Windows constraints were followed. This
  // variant uses the native Windows storage-firmware cmdlet and generic firmware-flash flag
  // combinations on the command line.
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process launch that flashes component firmware (storage, NIC, RAID/HBA, BMC, GPU) from the command line. Branch 1 matches the native Windows Update-StorageFirmware cmdlet with an image path. Branch 2 matches generic flash/update flags combined with a firmware image file extension and a component keyword. Malicious component firmware persists below the OS and survives re-imaging."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.002"
    mitre_technique_name = "Pre-OS Boot: Component Firmware"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command lines (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing). PowerShell invocations of Update-StorageFirmware are matched via the host process command line."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Hardware vendor firmware update utilities run by IT, OEM driver and firmware update suites, RMM or patching platforms pushing storage/NIC firmware, datacentre provisioning scripts, and lab or imaging staff updating drives."
    tuning_guidance = "Add approved firmware deployment tooling (parent or launching process path) to %global_allowed_admin_tools. Add named firmware administrators to %global_allowed_admin_users. Expect a handful of hits during scheduled hardware maintenance windows. Correlate with change tickets before escalating."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $proc.target.process.command_line = /\bUpdate-StorageFirmware\b/ nocase and
        $proc.target.process.command_line = /-ImagePath\b/ nocase
      )
      or
      (
        $proc.target.process.command_line = /(\s|^)[-\/](flash|fwupdate|updatefw|fwflash)\b/ nocase and
        $proc.target.process.command_line = /\.(rom|bin|fw|fwu|cap|img)\b/ nocase and
        $proc.target.process.command_line = /\b(nic|nvme|ssd|hdd|disk|bmc|gpu|raid|hba|controller)\b/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1542.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $launched_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
