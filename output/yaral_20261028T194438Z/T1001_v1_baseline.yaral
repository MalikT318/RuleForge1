/*
  MITRE Technique : T1001 - Data Obfuscation
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:03:42.993126+00:00
  Reference       : https://attack.mitre.org/techniques/T1001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_ESXi_Protocol_Port_Mismatch_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi hypervisor host making outbound connections to external addresses where the firewall's protocol identification shows DNS or HTTP running on a port that does not normally carry it. This is protocol impersonation or port-protocol mismatch, a common way to obfuscate C2 traffic. ESXi management hosts rarely initiate any internet-bound DNS or HTTP traffic on non-standard ports."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001"
    mitre_technique_name = "Data Obfuscation"
    log_prerequisites = "Requires perimeter firewall or proxy logs with application-layer protocol identification (network.application_protocol) and ESXi management-interface source addresses resolved to a hostname through asset enrichment or DNS/DHCP. Hypervisor management VMkernel traffic must traverse the logging firewall."
    platform = "ESXi"
    log_source = "firewall"
    false_positives = "Approved patching or vCenter-managed update traffic through a proxy on a custom port, HTTP-based vendor health-check or support-bundle uploads, split-DNS or internal resolvers on non-standard ports that resolve outside the internal address list, and firewall DPI misclassification of encrypted traffic."
    tuning_guidance = "Add known update and vendor endpoints to %global_allowed_domains. Adjust the ESXi hostname regex to the client's naming convention, or replace it with an asset-label filter if asset enrichment is available. Extend the permitted HTTP port exclusions for client-specific proxy ports. Confirm the firewall reports application_protocol reliably before enabling."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname = /(esxi?|vmhost)/ nocase
    not $net.target.ip in %rfc1918_internal
    (
      ($net.network.application_protocol = "DNS" and $net.target.port != 53)
      or
      (
        $net.network.application_protocol = "HTTP" and
        $net.target.port != 80 and
        $net.target.port != 443 and
        $net.target.port != 8080 and
        $net.target.port != 8443
      )
    )
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $observed_protocols = array_distinct($net.network.application_protocol)

  condition:
    $net
}
