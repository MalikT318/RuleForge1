/*
  MITRE Technique : T1027.014 - Polymorphic Code
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:00:27.982637+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_014_Dropper_Writes_And_Executes_Fresh_Binary {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A process writes a new executable into a user-writable staging directory and, within five minutes, launches that same file as its own child. This drop-and-execute pattern is typical of polymorphic droppers and mutation engines that emit a freshly mutated binary on each run, so no two copies share a signature."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.014"
    mitre_technique_name = "Obfuscated Files or Information: Polymorphic Code"
    log_prerequisites = "Requires endpoint telemetry that normalises file creation (FILE_CREATION) with the writing process, and process launch (PROCESS_LAUNCH) with parent and child image paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software updaters and self-updating applications that stage and run a new installer from temp or ProgramData, developer build and test loops, portable-app launchers, and software deployment agents that unpack and execute payloads."
    tuning_guidance = "Add approved deployment, patching and updater binaries to %global_allowed_admin_tools, approved script and launcher parents to %global_allowed_script_hosts, and EDR/AV agents to %global_allowed_security_tools. Tighten or extend the staging-directory regex per client if needed."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\[^\\]+\\appdata\\(local|roaming)(\\temp)?|users\\public|programdata|windows\\temp)\\([^\\]+\\)*[^\\]+\.(exe|scr|com)$/ nocase
    $file.target.file.full_path = $path
    $file.principal.process.file.full_path = $dropper
    $file.principal.hostname = $hostname
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path = /\\(msiexec|TrustedInstaller|TiWorker|MsMpEng|wuauclt)\.exe$/ nocase

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = $path
    $proc.principal.process.file.full_path = $dropper
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $path, $dropper over 5m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1027.014")
    $primary_entity = array_distinct($hostname)
    $dropped_file = array_distinct($path)
    $dropper_process = array_distinct($dropper)
    $dropper_user = array_distinct($proc.principal.user.userid)
    $launch_count = count($proc.metadata.id)

  condition:
    $file and $proc
}
