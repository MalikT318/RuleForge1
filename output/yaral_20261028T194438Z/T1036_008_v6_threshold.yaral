/*
  MITRE Technique : T1036.008 - Masquerade File Type
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:10:23.152538+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_008_Linux_Double_Extension_File_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several files with masquerading double extensions are created on one Linux host within ten minutes. The pattern is a benign document or image extension followed by a script or executable extension (e.g. name.jpg.sh, name.pdf.elf), or the reverse (name.php.jpg). Adversaries use these names to disguise payloads staged through upload handlers or ingress transfer. A single event is plausible, but a burst on one host is not."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.008"
    mitre_technique_name = "Masquerading: Masquerade File Type"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-creation records (path watches on writable and web-upload directories) normalised to UDM FILE_CREATION with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software build and packaging pipelines producing artifacts such as name.txt.sh templates, web CMS or backup plugins writing sanitised upload copies, configuration-management agents rendering templated files, developer test fixtures, and mirrored or extracted archives containing double-extension samples."
    tuning_guidance = "Add approved build, deployment and automation binaries to %global_allowed_admin_tools, and CI or service accounts to %global_allowed_service_accounts. Raise the #file threshold on build servers or web hosts with noisy upload handlers. Scope to a single host group if needed."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(jpe?g|png|gif|bmp|ico|svg|txt|pdf|docx?|xlsx?|mp3|mp4)\.(sh|bash|elf|bin|php[0-9]?|phtml|py|pl|rb|so|run|out)$|\.(php[0-9]?|phtml|jsp|sh|py|pl|elf)\.(jpe?g|png|gif|bmp|ico|txt|pdf)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1036.008")
    $primary_entity = array_distinct($host)
    $masquerade_paths = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
