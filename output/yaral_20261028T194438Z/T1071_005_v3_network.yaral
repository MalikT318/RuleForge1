/*
  MITRE Technique : T1071.005 - Publish/Subscribe Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:11:16.632910+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_005_Egress_PubSub_Broker_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound connections from internal hosts to external destinations on well-known publish/subscribe broker ports (MQTT, AMQP, STOMP, XMPP). Adversaries abuse pub/sub brokers for command and control because the traffic blends in with legitimate messaging. This rule observes the behaviour from the network perimeter and does not depend on endpoint process telemetry."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.005"
    mitre_technique_name = "Application Layer Protocol: Publish/Subscribe Protocols"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with target.ip and target.port populated. Egress traffic must be logged, not only denied traffic."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate IoT or OT devices using MQTT to a cloud broker, SaaS messaging integrations (managed AMQP or MQTT services), corporate XMPP or chat federation, developer or test hosts using public brokers, and vulnerability scanners probing broker ports."
    tuning_guidance = "Add known-good broker domains to %global_allowed_domains and approved scanner or test source hosts to %global_allowed_scanners. Populate %global_allowed_admin_users or per-client exceptions as needed. For environments with heavy IoT use, scope the rule to non-IoT network segments or raise the severity only when the destination is not in %global_allowed_domains."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 1883 or
      $net.target.port = 8883 or
      $net.target.port = 5672 or
      $net.target.port = 5671 or
      $net.target.port = 61613 or
      $net.target.port = 61614 or
      $net.target.port = 5222 or
      $net.target.port = 5269
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1071.005")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
