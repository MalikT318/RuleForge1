/*
  MITRE Technique : T1020.001 - Traffic Duplication
  Tactic(s)       : Exfiltration
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:32:34.148258+00:00
  Reference       : https://attack.mitre.org/techniques/T1020/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1020_001_Mirroring_Protocol_Egress_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single internal source sends a high volume of tunnelled traffic-mirroring protocols (VXLAN, TZSP, GRE as used by ERSPAN or cloud traffic mirroring) to an external destination within 10 minutes. Each flow is benign on its own. Sustained volume to a non-internal receiver indicates mirrored or duplicated traffic being exfiltrated."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1020.001"
    mitre_technique_name = "Automated Exfiltration: Traffic Duplication"
    log_prerequisites = "Firewall or perimeter flow/connection logs that populate principal.ip, target.ip and target.port or network.ip_protocol, normalised to NETWORK_CONNECTION."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate VXLAN overlay or SD-WAN tunnels to external peers, GRE tunnels to cloud security gateways or SASE providers, authorised packet-capture or network-monitoring services hosted off-site, and cloud traffic-mirroring to approved external analysers."
    tuning_guidance = "Add approved tunnel and management sources to %global_allowed_mgmt_sources. Raise the #net threshold in high-volume environments with many overlay tunnels. If a legitimate analyser or tunnel peer repeatedly triggers, exclude its source host via %global_allowed_mgmt_sources rather than widening the ports."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 4789 or $net.target.port = 37008 or $net.network.ip_protocol = "GRE")
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    $net.principal.ip = $src

  match:
    $src over 10m

  outcome:
    $event_count = count($net.metadata.id)
    $risk_score = max(if($event_count >= 100, 85, 65))
    $mitre_technique_id = array_distinct("T1020.001")
    $primary_entity = array_distinct($src)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 20
}
