/*
  MITRE Technique : T1563 - Remote Service Session Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:06:27.246598+00:00
  Reference       : https://attack.mitre.org/techniques/T1563
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_Remote_Session_Ports_From_External_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a firewall-observed connection from a non-internal source address to a Windows interactive remote-session service port (RDP, Telnet, VNC). Interactive session services reachable from outside the internal address space are a common path for hijacking or tunnelling into existing remote sessions (T1563.002 RDP hijacking). This is the network-side view and uses no endpoint process fields."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1563"
    mitre_technique_name = "Remote Service Session Hijacking"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Authorised vendor or MSP remote support over RDP, admins working remotely through a jump host or VPN concentrator whose address is not in the allowlist, external vulnerability scanning, internet-exposed RDP honeypots, and NAT or VPN egress addresses that appear as non-internal sources."
    tuning_guidance = "Add VPN concentrator, jump host, bastion and approved vendor source addresses to %global_allowed_mgmt_sources. Add authorised scanners to %global_allowed_scanners. Extend or reduce the port set to match the services the client exposes. Treat any hit on an internet-facing Windows server as high priority."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 3389 or $net.target.port = 23 or $net.target.port = 5900)
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1563")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
