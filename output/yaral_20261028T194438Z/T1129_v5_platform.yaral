/*
  MITRE Technique : T1129 - Shared Modules
  Tactic(s)       : Execution
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:42:37.794623+00:00
  Reference       : https://attack.mitre.org/techniques/T1129
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1129_Linux_Shared_Object_Download_Via_CLI_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux-style command-line HTTP client (curl, wget, scripting HTTP libraries) fetching a shared object (.so) file from an external destination. Perimeter telemetry cannot see dlopen/dlsym or the module load itself, so this rule detects the network-observable staging step that precedes T1129 shared module execution on Linux. Treat a hit as a lead to confirm on the endpoint, not as proof of module loading."
    mitre_tactic = "Execution"
    mitre_technique = "T1129"
    mitre_technique_name = "Shared Modules"
    log_prerequisites = "Requires firewall or web proxy logs with HTTP URL and user-agent visibility (TLS inspection or explicit proxy for HTTPS), normalised to UDM NETWORK_HTTP."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Build and CI systems pulling libraries, developers fetching vendor runtime libraries, configuration management or provisioning scripts downloading .so files from vendor sites, and container image build steps."
    tuning_guidance = "Add trusted vendor and mirror domains to %global_allowed_domains. If internal build hosts are noisy, exclude them by adding approved scanner or build source hostnames to %global_allowed_scanners and extending the exclusion. Without TLS inspection, HTTPS URLs are not visible and the rule only covers cleartext HTTP or proxied traffic."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\.so(\.[0-9]+)*($|\?)/ nocase
    $net.network.http.user_agent = /^(curl|wget|python-requests|python-urllib|go-http-client|libwww-perl)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1129")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
