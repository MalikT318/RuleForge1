/*
  MITRE Technique : T1001.001 - Junk Data
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:06:09.734021+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_001_Unexpected_Parent_Spawns_Shell_Junk_Data_C2 {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter spawned by an unexpected parent process (Office application, web server, print spooler, database service) whose command line both generates random or padding data and sends it over the network. This combination is characteristic of junk-data obfuscation of C2 traffic, where random content is added to requests so they are harder to decode or signature."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001.001"
    mitre_technique_name = "Data Obfuscation: Junk Data"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command lines (EDR, Sysmon Event ID 1 or Security Event 4688 with command-line auditing) populating principal.process.file.full_path and target.process.command_line."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros or add-ins that call web services with generated IDs or nonces, web applications that shell out to PowerShell for HTTP calls with random tokens, database jobs (SQL Agent) invoking scripted web requests, and legitimate line-of-business automation launched from Office or IIS."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts, approved tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. The parent process list can be narrowed or widened to fit the environment (for example add application-server hosts). If noise remains, require the child to be PowerShell only."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|onenote|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|spoolsv|sqlservr|mysqld|postgres)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|powershell_ise)\.exe$/ nocase
    $proc.target.process.command_line = /(get-random|\[char\]|-join|randomnumbergenerator|newguid|\[guid\]::|\[convert\]::tobase64string|rand\(\))/ nocase
    $proc.target.process.command_line = /(uploadstring|uploaddata|invoke-webrequest|invoke-restmethod|net\.webclient|system\.net\.http|net\.sockets|\b(iwr|irm|curl|wget)\b|bitsadmin)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1001.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
