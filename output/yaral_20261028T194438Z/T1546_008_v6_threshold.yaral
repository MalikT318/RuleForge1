/*
  MITRE Technique : T1546.008 - Accessibility Features
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:11:23.511955+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_008_Accessibility_Binary_IFEO_Registry_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Multiple Image File Execution Options Debugger/GlobalFlag registry writes targeting Windows accessibility binaries (sticky keys, utility manager, on-screen keyboard, narrator, magnifier and similar) on one host within ten minutes. This indicates hijacking of accessibility features to obtain a pre-logon SYSTEM shell. The rule detects the registry persistence mechanism, not process command lines."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.008"
    mitre_technique_name = "Event Triggered Execution: Accessibility Features"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (registry value set events) normalised to UDM REGISTRY_MODIFICATION with target.registry.registry_key and registry_value_name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Application compatibility or accessibility tooling configuration, developers or QA debugging accessibility components, enterprise imaging or hardening scripts that set IFEO values, and assistive technology installers."
    tuning_guidance = "Add approved deployment or hardening tooling to %global_allowed_admin_tools, EDR/AV writers to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Raise the #reg threshold if a client's baseline shows regular multi-key writes from authorised sources."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Image File Execution Options\\(sethc|utilman|osk|narrator|magnify|displayswitch|atbroker)\.exe$/ nocase
    $reg.target.registry.registry_value_name = /^(debugger|globalflag)$/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(85)
    $event_count = count($reg.metadata.id)
    $mitre_technique_id = array_distinct("T1546.008")
    $primary_entity = array_distinct($host)
    $modified_keys = array_distinct($reg.target.registry.registry_key)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $writer_users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 2
}
