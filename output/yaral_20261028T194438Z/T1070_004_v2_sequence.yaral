/*
  MITRE Technique : T1070.004 - File Deletion
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:04:44.236357+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_004_ESXi_SSH_Login_Then_Log_Or_Staging_File_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an interactive login to an ESXi host from a non-approved source, followed within 10 minutes by file deletion in log, temp or staging locations on the same host. This pattern is typical of an adversary removing dropped tooling and shell or auth log traces to reduce forensic evidence. It is based on file-deletion telemetry correlated with a preceding login, not on process command-line matching."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.004"
    mitre_technique_name = "Indicator Removal: File Deletion"
    log_prerequisites = "ESXi host logs (hostd, shell, auth, vmkernel) forwarded to Chronicle and parsed into USER_LOGIN and FILE_DELETION UDM events with principal.hostname populated. Requires remote syslog from the hosts."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators cleaning temporary files or old patch bundles in /tmp or /scratch/downloads after maintenance; automated log rotation triggered under a login session; host patching and upgrade tooling; backup or monitoring agents that log in and clean up staging files."
    tuning_guidance = "Add approved jump hosts and admin workstation addresses to %global_allowed_mgmt_sources. Add named admins to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Add patching and deployment tooling to %global_allowed_admin_tools. If /tmp deletions are too noisy in a given environment, narrow the path regex to the log directories only."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.principal.hostname = $hostname
    not $login.principal.ip in %global_allowed_mgmt_sources
    not $login.target.user.userid in %global_allowed_admin_users
    not $login.target.user.userid in %global_allowed_service_accounts

    $del.metadata.event_type = "FILE_DELETION"
    $del.principal.hostname = $hostname
    $del.target.file.full_path = /^\/(var\/log\/|scratch\/log\/|scratch\/downloads\/|tmp\/|var\/tmp\/)/ nocase
    not $del.principal.process.file.full_path in %global_allowed_admin_tools
    not $del.principal.user.userid in %global_allowed_service_accounts

    $login.metadata.event_timestamp.seconds <= $del.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1070.004")
    $primary_entity = array_distinct($del.principal.hostname)
    $login_users = array_distinct($login.target.user.userid)
    $login_source_ips = array_distinct($login.principal.ip)
    $deleted_paths = array_distinct($del.target.file.full_path)
    $deletion_count = count($del.metadata.id)

  condition:
    $login and $del
}
