/*
  MITRE Technique : T1187 - Forced Authentication
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:33:56.036400+00:00
  Reference       : https://attack.mitre.org/techniques/T1187
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1187_Outbound_SMB_Then_WebDAV_Fallback {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects forced-authentication behaviour in which an internal host attempts an outbound SMB connection (TCP 445) to an external address and then, within 10 minutes, makes WebDAV-style HTTP requests (PROPFIND or a WebDAV mini-redirector user agent) to the same external address. This is the Windows SMB-to-WebDAV fallback pattern that leaks NTLM credentials to an attacker-controlled server."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1187"
    mitre_technique_name = "Forced Authentication"
    log_prerequisites = "Requires perimeter firewall or proxy logs normalised to UDM. Firewall connection logs must populate NETWORK_CONNECTION with principal.ip, target.ip and target.port. Proxy or HTTP inspection logs must populate NETWORK_HTTP with network.http.method or network.http.user_agent. Both sources must record the same client source IP."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Users with legitimately mapped WebDAV or cloud file shares on external providers not in the allowed domains list, and sanctioned penetration tests or vulnerability scans. Misconfigured clients or applications that attempt SMB to a hosted file service and then fall back to WebDAV. Corporate NAT or proxy addresses that aggregate many clients under one source IP."
    tuning_guidance = "Add approved external WebDAV and file-sharing domains to %global_allowed_domains. Add scanner and authorised testing source addresses to %global_allowed_scanners. If the proxy and firewall report different source IPs because of NAT, align the source IP normalisation before deployment. Raise the severity or enable alerting only where outbound 445 is blocked at the perimeter, since that makes any attempt notable."

  events:
    $smb.metadata.event_type = "NETWORK_CONNECTION"
    $smb.target.port = 445
    not $smb.target.ip in %rfc1918_internal
    not $smb.principal.ip in %global_allowed_scanners
    $smb.principal.ip = $src
    $smb.target.ip = $dst

    $web.metadata.event_type = "NETWORK_HTTP"
    (
      $web.network.http.method = /^PROPFIND$/ nocase or
      $web.network.http.user_agent = /(?i)(WebDAV|DavClnt|MiniRedir)/
    )
    not $web.target.ip in %rfc1918_internal
    not $web.target.hostname in %global_allowed_domains
    not $web.principal.ip in %global_allowed_scanners
    $web.principal.ip = $src
    $web.target.ip = $dst

    $smb.metadata.event_timestamp.seconds <= $web.metadata.event_timestamp.seconds

  match:
    $src, $dst over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1187")
    $primary_entity = array_distinct($smb.principal.ip)
    $external_destination = array_distinct($smb.target.ip)
    $smb_attempt_count = count($smb.metadata.id)
    $webdav_request_count = count($web.metadata.id)
    $webdav_hosts = array_distinct($web.target.hostname)
    $webdav_user_agents = array_distinct($web.network.http.user_agent)

  condition:
    $smb and $web
}
