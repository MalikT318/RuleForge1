/*
  MITRE Technique : T1059.003 - Windows Command Shell
  Tactic(s)       : Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:10:07.823599+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_003_Cmd_Shell_Outbound_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Windows command shell (cmd.exe) itself initiating an outbound network connection to a non-internal address. cmd.exe is a local interpreter and rarely opens sockets, so this pattern is characteristic of reverse shells, interactive cmd sessions forwarded over a C2 channel, and cmd-driven tool downloads. It is network-side coverage that complements process-creation and command-line detections."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.003"
    mitre_technique_name = "Command and Scripting Interpreter: Windows Command Shell"
    log_prerequisites = "Requires endpoint network telemetry that attributes each connection to its originating process (EDR or Sysmon Event ID 3 equivalent) and populates principal.process.file.full_path and target.ip."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Batch files that fetch content with built-in utilities where the connection is attributed to cmd.exe, legacy logon or deployment scripts reaching external update servers, RMM or software deployment tooling that spawns cmd.exe, and developer build scripts that pull packages from external repositories."
    tuning_guidance = "Add approved parent processes or hosts to %global_allowed_script_hosts. Add RMM and deployment tooling to %global_allowed_admin_tools and %global_allowed_remote_mgmt. Add service accounts that run scheduled batch jobs to %global_allowed_service_accounts. Add known-good external destinations to %global_allowed_domains if the log source populates target.hostname."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\cmd\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not re.regex($net.target.ip, /^(127\.|169\.254\.|::1$|fe80:)/)
    not $net.principal.process.parent_process.file.full_path in %global_allowed_script_hosts
    not $net.principal.process.parent_process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.parent_process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $parent_process = array_distinct($net.principal.process.parent_process.file.full_path)
    $source_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
