/*
  MITRE Technique : T1127.001 - MSBuild
  Tactic(s)       : Stealth, Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:37:27.074405+00:00
  Reference       : https://attack.mitre.org/techniques/T1127/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1127_001_MSBuild_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects MSBuild.exe launched by a parent process that should never build projects, such as an Office application, web server worker, database service, print spooler, WMI provider host, or script and proxy-execution host. Legitimate MSBuild use comes from developer tooling, build agents, or installers. Launch from these parents indicates inline-task proxy execution of attacker code. The detection keys on process lineage, not the command line."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1127.001"
    mitre_technique_name = "Trusted Developer Utilities Proxy Execution: MSBuild"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry that populates both parent (principal.process) and child (target.process) image paths, from EDR, Sysmon Event ID 1, or Security Event 4688 with parent process logging."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Build or CI agents that run as a web server or service-hosted process; developer workstations where Office or script-based tooling legitimately triggers builds (VSTO or Office add-in development); software deployment scripts launched through wscript, cscript, or rundll32 that call MSBuild; SQL Server CLR or SSIS build tasks on development servers."
    tuning_guidance = "Add approved parent process paths of build and deployment tooling to %global_allowed_admin_tools. Add developer or build hosts and sanctioned script-host parents to %global_allowed_script_hosts. Extend or narrow the parent regex as needed for the client estate."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\msbuild\.exe$/ nocase
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|onenote|mspub|visio|msaccess|acrord32|w3wp|httpd|nginx|tomcat\d*|php-cgi|sqlservr|spoolsv|wmiprvse|mshta|wscript|cscript|rundll32|regsvr32)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1127.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
