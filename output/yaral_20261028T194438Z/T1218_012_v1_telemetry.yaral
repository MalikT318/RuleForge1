/*
  MITRE Technique : T1218.012 - Verclsid
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:57:28.595274+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_012_Verclsid_COM_CLSID_Hijack_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a COM CLSID InprocServer32 or LocalServer32 registry value being set to a script moniker, remote URL, scriptlet runtime (scrobj), or a user-writable path. Verclsid.exe can be made to load such a registration (verclsid.exe /S /C {CLSID}) and proxy execution of attacker code. Detection pivots on the registry state change rather than the verclsid command line."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.012"
    mitre_technique_name = "System Binary Proxy Execution: Verclsid"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon Event ID 12/13/14) with registry key and value data populated in UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-user application installers and updaters that register COM servers under AppData or ProgramData, developer machines registering test COM components, software packaging and deployment tooling."
    tuning_guidance = "Add approved installer and deployment binaries to %global_allowed_admin_tools, security agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. If per-user installers are noisy, exclude them by parent executable name through the admin tools list rather than by install path."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Classes\\(Wow6432Node\\)?CLSID\\\{[0-9a-f\-]{36}\}\\(InprocServer32|LocalServer32)$/ nocase
    $reg.target.registry.registry_value_data = /(scrobj\.dll|^script:|https?:\/\/|\\users\\[^\\]+\\(appdata|downloads|desktop|documents)\\|\\users\\public\\|\\programdata\\|\\windows\\temp\\|\\temp\\)/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1218.012")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_data = array_distinct($reg.target.registry.registry_value_data)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
