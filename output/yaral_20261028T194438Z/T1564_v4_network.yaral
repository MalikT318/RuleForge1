/*
  MITRE Technique : T1564 - Hide Artifacts
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:12:34.739687+00:00
  Reference       : https://attack.mitre.org/techniques/T1564
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_ESXi_Shell_Utility_External_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi host opening an outbound network connection to an external address from a shell-level transfer, tunnelling or scripting utility (ssh/dbclient, nc/socat, wget/curl, python/perl, busybox, openssl). Hypervisors rarely make such connections. Adversaries use them to pull tooling or exfiltrate data from a host that few security controls watch, and the same channels are used to stage hidden artifacts such as rogue VMs and relocated payloads. Complements command-line rules by observing the network side of the activity."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564"
    mitre_technique_name = "Hide Artifacts"
    log_prerequisites = "ESXi network connection telemetry (shell or process-attributed connection events) normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated, for example from syslog forwarding or a hypervisor-aware sensor."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators downloading patches, VIBs or ISOs with wget/curl from vendor depots; support staff using ssh to reach external jump or support hosts; backup or monitoring scripts that call external endpoints; vendor-supplied python health scripts."
    tuning_guidance = "Add approved admin tooling paths to %global_allowed_admin_tools, approved patch and depot domains to %global_allowed_domains, and approved destination addresses to %global_allowed_mgmt_sources. Further tune by restricting to hosts where outbound internet access is not expected."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(ssh|dbclient|nc|ncat|netcat|socat|wget|curl|python[0-9.]*|perl|busybox|openssl)$/ nocase
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1564")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_process = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
