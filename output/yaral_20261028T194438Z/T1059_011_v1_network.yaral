/*
  MITRE Technique : T1059.011 - Lua
  Tactic(s)       : Execution
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:22:04.849788+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_011_Lua_Script_Or_Client_Over_Web {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound web requests from an internal client to an external destination that either retrieve a .lua script or use a Lua HTTP client user-agent. Lua payloads such as stagers and embedded-interpreter malware are typically fetched or beaconed over HTTP. This gives network-side coverage independent of endpoint process command-line rules."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.011"
    mitre_technique_name = "Command and Scripting Interpreter: Lua"
    log_prerequisites = "Requires proxy or firewall logs with HTTP inspection that populate target.url or network.http.user_agent. Plain connection-only logs will not match."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Games and game launchers that download Lua assets, applications with embedded Lua plugins or update mechanisms, developers fetching Lua libraries or packages, network and monitoring tooling that uses Lua HTTP clients."
    tuning_guidance = "Add known-good vendor and CDN domains to %global_allowed_domains. Exclude scanner sources with %global_allowed_scanners. Exclude approved sources with %global_allowed_mgmt_sources. Keep %rfc1918_internal populated so internal traffic is ignored."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    (
      $net.target.url = /\.lua([?#].*)?$/ nocase or
      $net.network.http.user_agent = /luasocket|lua-resty|^lua[\/ ]/ nocase
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1059.011")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
