/*
  MITRE Technique : T1602.002 - Network Device Configuration Dump
  Tactic(s)       : Collection
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:20:32.032407+00:00
  Reference       : https://attack.mitre.org/techniques/T1602/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_002_Network_Device_Config_Dump_Mgmt_Protocols {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network-observable attempts to pull configuration from network devices over management protocols. Smart Install (TCP/4786) is flagged from any source outside the approved management sources, since it should not be reachable except from the vendor director. SNMP (161) and TFTP (69), the usual channels for reading or exporting configs, are flagged when the source is outside internal address space."
    mitre_tactic = "Collection"
    mitre_technique = "T1602.002"
    mitre_technique_name = "Data from Configuration Repository: Network Device Configuration Dump"
    log_prerequisites = "Firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip and target.port populated. Management-plane traffic must traverse a logging enforcement point."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Unlisted network management or monitoring servers polling SNMP, authorised external vulnerability scanning, MSP or vendor remote monitoring over SNMP, legitimate Smart Install director deployments or zero-touch provisioning of new switches, and internet scanners hitting exposed management ports (noisy but still worth review)."
    tuning_guidance = "Add approved NMS, config-backup, TFTP and Smart Install director addresses to %global_allowed_mgmt_sources. Add authorised scanner sources to %global_allowed_scanners. Populate %rfc1918_internal so internal SNMP and TFTP is not treated as external. Consider raising severity to Critical if Smart Install is observed from an external source."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 4786 or
      (
        ($net.target.port = 161 or $net.target.port = 69) and
        not $net.principal.ip in %rfc1918_internal
      )
    )
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1602.002")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $dest_ports = array_distinct($net.target.port)

  condition:
    $net
}
