/*
  MITRE Technique : T1567.001 - Exfiltration to Code Repository
  Tactic(s)       : Exfiltration
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:56:09.100037+00:00
  Reference       : https://attack.mitre.org/techniques/T1567/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_001_Code_Repo_API_Upload_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a large outbound HTTP write (POST/PUT/PATCH) to an external URL that follows the content-upload API structure of a code-hosting service (repository contents, blobs, commits, snippets/gists). Observed at the proxy or firewall, this is network-side evidence of data being pushed to a code repository, a channel that blends in with normal developer traffic."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567.001"
    mitre_technique_name = "Exfiltration Over Web Service: Exfiltration to Code Repository"
    log_prerequisites = "Requires proxy or next-generation firewall logs with TLS inspection (or URL visibility) that populate network.http.method, target.url and network.sent_bytes. Without TLS inspection, the URL path is not visible and this rule will not fire."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Developers and DevOps engineers committing legitimate large files to approved external repositories, CI/CD build agents pushing artifacts, documentation or package publishing workflows, and sanctioned backup-to-repository jobs."
    tuning_guidance = "Add sanctioned repository domains to %global_allowed_domains and build or automation accounts to %global_allowed_service_accounts. Adjust the network.sent_bytes threshold (default 250000 bytes) per client. Raise it for development-heavy tenants, lower it for tenants with no developer population. In tenants where no external repository use is expected, consider raising severity."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT|PATCH)$/ nocase
    $net.target.url = /\/(repos\/[^\/]+\/[^\/]+\/(contents|git\/(blobs|trees|commits))|api\/v[0-9]+\/projects\/[^\/]+\/repository\/(files|commits)|2\.0\/repositories\/[^\/]+\/[^\/]+\/(src|commits)|gists|snippets)(\/|\?|$)/ nocase
    $net.network.sent_bytes > 250000
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1567.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_urls = array_distinct($net.target.url)
    $source_users = array_distinct($net.principal.user.userid)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
