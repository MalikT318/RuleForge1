/*
  MITRE Technique : T1070.004 - File Deletion
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:05:39.693055+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_004_ESXi_Staging_Artifact_And_Log_File_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects deletion of script, binary or archive artifacts from ESXi writable staging locations (/tmp, /var/tmp, /scratch, datastore volumes), or deletion of core ESXi log files in /var/log. Both are typical post-intrusion cleanup, for example after tool staging or ransomware preparation on a hypervisor. The rule uses file-deletion telemetry rather than process command-line matching, so it complements existing rm/unlink command-line detections."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1070.004"
    mitre_technique_name = "Indicator Removal: File Deletion"
    log_prerequisites = "Requires ESXi host telemetry normalised to UDM FILE_DELETION events, for example through file-integrity or audit forwarding from the host with hostd, vmkernel and shell logs ingested. Without a file-deletion-capable feed this rule will not fire."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Patching and VIB installs that clean up staged bundles in /tmp or /scratch/downloads; backup or migration jobs removing temporary archives on datastores; admin housekeeping of staged scripts; log rotation or support-bundle collection that removes rotated logs."
    tuning_guidance = "Add approved admin and automation accounts to %global_allowed_admin_users or %global_allowed_service_accounts. Add patching, backup or management tooling parent processes to %global_allowed_admin_tools. If datastore archive cleanup is noisy, narrow the extension list or add the backup tooling to %global_allowed_backup_processes."

  events:
    $file.metadata.event_type = "FILE_DELETION"
    $file.target.file.full_path = /^(\/(tmp|var\/tmp|scratch(\/downloads|\/tmp)?|vmfs\/volumes\/[^\/]+(\/[^\/]+)?)\/.*\.(sh|py|pl|elf|bin|so|tgz|tar|gz|zip|b64|enc)|\/var\/log\/(shell|auth|hostd|vmkernel|vmksummary|vobd|fdm|esxupdate)\.log(\.\d+)?)$/ nocase
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1070.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $deleted_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)
    $acting_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
