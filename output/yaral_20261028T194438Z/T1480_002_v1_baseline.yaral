/*
  MITRE Technique : T1480.002 - Mutual Exclusion
  Tactic(s)       : Stealth
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:26:43.358327+00:00
  Reference       : https://attack.mitre.org/techniques/T1480/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1480_002_Linux_Staging_Dir_Process_Creates_Lock_File {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process executing from a world-writable staging directory (/tmp, /dev/shm, /var/tmp) that creates a lock, PID or mutex-style file in a volatile location. Linux malware commonly uses such a file as an execution mutex, taking an exclusive lock so that only one instance of the implant runs. Legitimate software rarely runs from staging directories and also creates lock files there."
    mitre_tactic = "Stealth"
    mitre_technique = "T1480.002"
    mitre_technique_name = "Execution Guardrails: Mutual Exclusion"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-creation events with the creating process path populated (principal.process.file.full_path and target.file.full_path)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Self-extracting installers or vendor update scripts run from /tmp; developer or CI build jobs executing binaries from scratch directories; portable admin tools staged temporarily by IT; containers whose entrypoints run from /tmp."
    tuning_guidance = "Add approved staging-directory tooling to %global_allowed_admin_tools. Add approved interpreter hosts and parents to %global_allowed_script_hosts. Exclude known CI or build hosts via a host-scoped allowlist at the client level. Review the lock file name and creating process path in the outcome before escalating."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /^\/(tmp|dev\/shm|var\/tmp)\// nocase
    $file.target.file.full_path = /^\/(var\/run|run|dev\/shm|tmp|var\/tmp)\/([^\/]+\/)?[^\/]*\.(lock|lck|pid|mutex|mtx)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1480.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $lock_file_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
