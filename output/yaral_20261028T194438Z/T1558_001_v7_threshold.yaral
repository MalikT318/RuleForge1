/*
  MITRE Technique : T1558.001 - Golden Ticket
  Tactic(s)       : Credential Access
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:41:06.197395+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_001_Golden_Ticket_Kerberos_Ticket_Manipulation_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of Kerberos ticket manipulation commands on a single host within 10 minutes. This covers ticket cache purge or TGT inspection via klist, and command-line parameters used to forge or inject tickets (krbtgt account, ticket file, domain SID, pass-the-ticket, Kerberos encryption keys). One klist call is benign; repeated ticket handling and forging arguments from one host indicate golden ticket creation or use."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.001"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Golden Ticket"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command lines (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators troubleshooting Kerberos with klist (purge, tgt, get), helpdesk or RMM scripts that reset ticket caches, authorised red team or purple team exercises, and Kerberos diagnostic scripts run during domain migrations."
    tuning_guidance = "Add approved admin tooling parent processes to %global_allowed_admin_tools, EDR and security agents to %global_allowed_security_tools, and named administrators to %global_allowed_admin_users. Raise the threshold from 3 if klist-based troubleshooting is common in the environment. Add authorised testing hosts to %global_allowed_scanners if their hostnames are tracked there."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(\bklist(\.exe)?\s+(purge|tgt|get\s|add_bind)|[\/\-](ptt|krbtgt|ticket|sids?|rc4|aes128|aes256)[:=]|\bkrbtgt\b.*[\/\-](rc4|aes128|aes256|ptt|sid)|[\/\-]ptt\b)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1558.001")
    $primary_entity = array_distinct($host)
    $event_count = count($proc.metadata.id)
    $users = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)

  condition:
    #proc >= 3
}
