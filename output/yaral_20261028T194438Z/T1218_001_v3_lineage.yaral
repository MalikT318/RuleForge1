/*
  MITRE Technique : T1218.001 - Compiled HTML File
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:42:24.142666+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_001_HtmlHelp_Parent_Spawns_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the HTML Help executable (hh.exe) acting as the PARENT of a shell, script interpreter, or proxy-execution LOLBin. Legitimate CHM viewing does not spawn child interpreters. This is the lineage signature of a weaponised CHM running embedded script or ActiveX content. The rule keys on process lineage rather than command-line content, so it complements command-line rules for hh.exe."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.001"
    mitre_technique_name = "System Binary Proxy Execution: Compiled HTML File"
    log_prerequisites = "Windows endpoint process-creation telemetry (EDR or Sysmon Event ID 1) with populated parent and child process image paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy software help systems that launch helper scripts or cmd.exe from a CHM (rare). Help-authoring and documentation build hosts. Application installers that display CHM help and then launch a follow-on tool. Admin-run test or training scenarios."
    tuning_guidance = "Add approved child tooling to %global_allowed_admin_tools. Add documentation or help-authoring hosts to %global_allowed_script_hosts. Add known automation accounts to %global_allowed_service_accounts. Review the child_command_lines outcome to decide whether a legacy application needs a scoped exclusion."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\hh\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|msiexec|wmic|forfiles|installutil|regasm|regsvcs|msbuild)\.exe$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.hostname in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $affected_user = array_distinct($proc.principal.user.userid)
    $child_processes = array_distinct($proc.target.process.file.full_path)
    $child_command_lines = array_distinct($proc.target.process.command_line)
    $parent_command_lines = array_distinct($proc.principal.process.command_line)

  condition:
    $proc
}
