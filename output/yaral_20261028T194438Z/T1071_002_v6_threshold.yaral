/*
  MITRE Technique : T1071.002 - File Transfer Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:06:58.584433+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_002_Network_Excessive_Outbound_File_Transfer_Protocols {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source opens a high volume of outbound connections to external destinations on file-transfer protocol ports (FTP, TFTP, SMB, FTPS) within ten minutes. Individual connections are normal; sustained volume to external hosts can indicate C2 or staging over file-transfer protocols that blend in with expected traffic."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.002"
    mitre_technique_name = "Application Layer Protocol: File Transfer Protocols"
    log_prerequisites = "Firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate B2B or vendor FTP/FTPS exchanges, scheduled partner file drops, firmware or config pulls via TFTP, cloud-hosted SMB file shares, vulnerability scanners and backup jobs pushing to offsite storage."
    tuning_guidance = "Add authorised scanner and automation source addresses to %global_allowed_scanners, add known-good partner or vendor domains to %global_allowed_domains, and raise or lower the #net threshold per client baseline. Consider narrowing the port set where SMB to the internet is already blocked."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 21 or
      $net.target.port = 69 or
      $net.target.port = 445 or
      $net.target.port = 990
    )
    $net.principal.ip = $src
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  match:
    $src over 10m

  outcome:
    $risk_score = max(if($net.target.port = 21 or $net.target.port = 69, 70, 55))
    $mitre_technique_id = array_distinct("T1071.002")
    $primary_entity = array_distinct($src)
    $event_count = count($net.metadata.id)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 15
}
