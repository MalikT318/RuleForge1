/*
  MITRE Technique : T1129 - Shared Modules
  Tactic(s)       : Execution
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:42:02.564883+00:00
  Reference       : https://attack.mitre.org/techniques/T1129
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1129_Linux_Shared_Object_Download_Over_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP request seen at the proxy or perimeter for an ELF shared object (.so, including versioned names such as .so.1) from an external destination. Linux hosts that fetch loadable shared modules over the network, usually with a command-line client or script, can stage payloads for dlopen/LD_PRELOAD-style execution. The rule uses only network-side telemetry and does not depend on the initiating process."
    mitre_tactic = "Execution"
    mitre_technique = "T1129"
    mitre_technique_name = "Shared Modules"
    log_prerequisites = "Requires proxy or firewall logs normalised to NETWORK_HTTP with target.url populated (URL-aware inspection or a forward proxy). The user agent field is optional but improves precision. HTTPS traffic needs TLS inspection to expose the URL path."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Software vendors or internal build and CI jobs that fetch .so libraries from external artifact hosts, package mirrors serving raw shared objects, language runtime installers (Python, Node, Java native extensions), and developers pulling prebuilt native libraries."
    tuning_guidance = "Add known-good vendor, CDN and artifact domains to %global_allowed_domains. Keep %rfc1918_internal current so internal mirrors are excluded. Package-manager user agents are already excluded; extend that regex if clients use other updaters. Consider raising severity for source hosts that are servers and have no software-install history."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\/[^\/?#]+\.so(\.[0-9]+)*([?#].*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.network.http.user_agent = /(apt|dnf|yum|zypper|libzypp|pacman|rpm)/ nocase

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1129")
    $primary_entity = array_distinct($net.principal.ip)
    $requested_url = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
