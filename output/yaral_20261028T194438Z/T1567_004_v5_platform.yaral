/*
  MITRE Technique : T1567.004 - Exfiltration Over Webhook
  Tactic(s)       : Exfiltration
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:01:51.720882+00:00
  Reference       : https://attack.mitre.org/techniques/T1567/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_004_SaaS_Outbound_Webhook_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of an outbound webhook or event-subscription integration in a SaaS or cloud control plane audit log. Adversaries with a compromised account can register a webhook that pushes emails, chat messages, repository events or tickets to an attacker-controlled HTTP endpoint, giving repeated automated exfiltration with no endpoint process activity. This rule is control-plane only and complements endpoint command-line detections."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567.004"
    mitre_technique_name = "Exfiltration Over Web Service: Exfiltration Over Webhook"
    log_prerequisites = "Requires SaaS or cloud audit logs that record integration, webhook or subscription creation, normalised to RESOURCE_CREATION with metadata.product_event_type populated. Admin or audit logging for integrations must be enabled in each SaaS tenant."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Developers and DevOps engineers wiring up CI/CD, ticketing or chat notifications; IT or business owners adding sanctioned integrations; onboarding of new SaaS apps; approved automation and service accounts creating hooks during deployments."
    tuning_guidance = "Add approved integration service accounts to %global_allowed_cloud_principals and named administrators to %global_allowed_admin_users. If the SaaS source emits webhook creation as a different event type, deploy a sibling copy of this rule for that type. Extend the product_event_type regex with any tenant-specific action names. Raise severity for non-admin users or first-seen creators using SOAR enrichment of $primary_entity."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /(web_?hook|service_?hook|event_?subscription|outgoing_?hook|incoming_?hook)[._\- ]?(create|add|register|enable|subscribe)|(create|add|register|enable|subscribe)[._\- ]?(web_?hook|service_?hook|event_?subscription|outgoing_?hook|incoming_?hook)|hook\.create|hooks?\.add/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1567.004")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $source_ips = array_distinct($cloud.principal.ip)
    $action_names = array_distinct($cloud.metadata.product_event_type)
    $webhook_target_urls = array_distinct($cloud.target.url)
    $resource_names = array_distinct($cloud.target.resource.name)

  condition:
    $cloud
}
