/*
  MITRE Technique : T1599 - Network Boundary Bridging
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:59:37.581492+00:00
  Reference       : https://attack.mitre.org/techniques/T1599
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1599_Network_Device_Mgmt_Port_Access_From_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a connection from a non-internal source address to a network-device management-plane port (Telnet, SSH, SNMP, NETCONF over SSH, vendor config-push, or router admin ports) as seen in perimeter firewall or flow telemetry. Adversaries who compromise boundary devices need to reach the device management plane from the untrusted side before they can reconfigure policy and bridge network boundaries."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1599"
    mitre_technique_name = "Network Boundary Bridging"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with populated principal.ip, target.ip and target.port. Populate %rfc1918_internal, %global_allowed_mgmt_sources and %global_allowed_scanners for each client."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised vendor or MSP remote administration from public addresses, external vulnerability scanners and attack-surface monitoring, SNMP polling by a cloud-hosted monitoring service, and legitimate NAT-ed management traffic where the logged source is a public address."
    tuning_guidance = "Add approved administrator and monitoring source addresses to %global_allowed_mgmt_sources. Add external scanner addresses to %global_allowed_scanners. Ensure %rfc1918_internal is populated for the client. If a port is legitimately exposed (for example public SSH bastion), narrow the port list or exclude that destination via the allowlists."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 23 or
      $net.target.port = 22 or
      $net.target.port = 161 or
      $net.target.port = 830 or
      $net.target.port = 4786 or
      $net.target.port = 8291
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1599")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
