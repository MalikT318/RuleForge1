/*
  MITRE Technique : T1105 - Ingress Tool Transfer
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:12:22.043252+00:00
  Reference       : https://attack.mitre.org/techniques/T1105
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1105_ESXi_Payload_File_Staged_In_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of an executable, script or archive payload in world-writable or volatile ESXi staging locations (/tmp, /var/tmp, /scratch, /dev/shm, /store). This is the file artifact left behind when a tool is pulled onto a hypervisor by wget, curl, scp, sftp or similar transfer methods, regardless of the command line used. Detection is on the resulting file state, not process arguments."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1105"
    mitre_technique_name = "Ingress Tool Transfer"
    log_prerequisites = "ESXi host file-activity telemetry (shell, hostd, file integrity or audit events) normalised to UDM FILE_CREATION with target.file.full_path populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators manually uploading maintenance scripts or offline patch bundles (VIB/zip), vendor support tooling and diagnostic collection, backup and monitoring agents dropping helper scripts, automated host-configuration or deployment tooling."
    tuning_guidance = "Add approved deployment, patching and automation binaries to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and named administrators to %global_allowed_admin_users. Extend the extension list or staging directories per client if required."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|scratch|dev\/shm|store)\/.+\.(sh|py|pl|elf|bin|so|run|vib|zip|tgz|tar|gz)$/ nocase
    not $file.principal.process.file.full_path = /\/(hostd|vpxa|esxupdate|vmware-[a-z0-9_-]+)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1105")
    $primary_entity = array_distinct($file.principal.hostname)
    $staged_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
