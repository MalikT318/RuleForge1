/*
  MITRE Technique : T1048.001 - Exfiltration Over Symmetric Encrypted Non-C2 Protocol
  Tactic(s)       : Exfiltration
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:34:35.667426+00:00
  Reference       : https://attack.mitre.org/techniques/T1048/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1048_001_Large_Outbound_NonStandard_Port_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a single outbound connection to an external address on a non-standard, non-web port that carries a large volume of data (over 50 MB sent). This is the network-side signature of bulk data leaving over a self-encrypted or custom channel that is separate from normal web and mail traffic. The rule uses only firewall or perimeter telemetry and does not depend on the initiating process."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1048.001"
    mitre_technique_name = "Exfiltration Over Alternative Protocol: Exfiltration Over Symmetric Encrypted Non-C2 Protocol"
    log_prerequisites = "Requires firewall, proxy or perimeter NETWORK_CONNECTION logs with network.sent_bytes, target.ip and target.port populated, at connection close or in periodic session updates. Egress traffic from Windows hosts must traverse the logging device."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Offsite backup and replication jobs on custom ports, cloud storage sync clients, VPN or tunnel concentrators, game or media distribution, large software or telemetry uploads to vendors on custom ports, and approved managed file transfer."
    tuning_guidance = "Add known-good destination domains to %global_allowed_domains. Adjust the 52428800-byte threshold (50 MB) per client baseline. Extend the excluded port list with the client's sanctioned custom egress ports. Consider scoping to Windows server and workstation subnets if the firewall also logs non-Windows egress."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "TCP"
    $net.network.sent_bytes > 52428800
    $net.target.port > 0
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 8080
    $net.target.port != 8443
    $net.target.port != 53
    $net.target.port != 123
    $net.target.port != 25
    $net.target.port != 465
    $net.target.port != 587
    $net.target.port != 993
    $net.target.port != 995
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1048.001")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
