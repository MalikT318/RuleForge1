/*
  MITRE Technique : T1037 - Boot or Logon Initialization Scripts
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:18:52.406662+00:00
  Reference       : https://attack.mitre.org/techniques/T1037
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_Outbound_TFTP_FTP_Init_Script_Retrieval {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal source initiating an outbound TFTP (UDP/69) or FTP (TCP/21) connection to an external destination. Network devices with boot or logon initialization scripts (startup-config scripts, init scripts, embedded-event or login-banner hooks) commonly fetch scripts and configuration over these cleartext protocols. Adversaries abuse the same mechanism to stage or refresh persistent initialization scripts from external infrastructure. Both protocols are rarely legitimate across the perimeter to the internet."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037"
    mitre_technique_name = "Boot or Logon Initialization Scripts"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated for egress traffic."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate firmware or configuration backup jobs to cloud-hosted TFTP/FTP servers, vendor-managed device provisioning (zero-touch deployment), legacy applications and scanners using FTP to external partners, and authorised penetration tests."
    tuning_guidance = "Add approved management or provisioning source addresses to %global_allowed_mgmt_sources, approved vendor FTP/TFTP hostnames to %global_allowed_domains, and authorised testing sources to %global_allowed_scanners. If FTP to external partners is common for a client, restrict the rule to TFTP (port 69) for that tenant."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 69 or $net.target.port = 21)
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1037")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
