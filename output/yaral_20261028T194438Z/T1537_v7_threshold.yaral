/*
  MITRE Technique : T1537 - Transfer Data to Cloud Account
  Tactic(s)       : Exfiltration
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:36:41.502207+00:00
  Reference       : https://attack.mitre.org/techniques/T1537
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1537_SaaS_Mass_External_Sharing_Link_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a single user creating a high volume of file or folder sharing links or sharing invitations within ten minutes. Each sharing event is benign on its own, but bulk creation of anonymous or external sharing links is a cloud-native way to hand victim data to an attacker-controlled account on the same service."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1537"
    mitre_technique_name = "Transfer Data to Cloud Account"
    log_prerequisites = "Requires Microsoft 365 unified audit log ingestion with file and folder sharing operations (SharePoint and OneDrive) normalized to UDM, with metadata.product_event_type populated."
    platform = "SaaS"
    log_source = "m365"
    false_positives = "Project hand-offs or onboarding where a user shares many documents at once, collaboration with external partners or auditors, migration and content-management service accounts, and bulk sharing by site owners during reorganizations."
    tuning_guidance = "Add automation and migration identities to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Raise or lower the #share threshold per client based on baseline sharing volume. Scale response with the share_count outcome value."

  events:
    $share.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"
    $share.metadata.product_event_type = /(AnonymousLinkCreated|SharingInvitationCreated|SharingSet|SecureLinkCreated|AddedToSecureLink|CompanyLinkCreated|AnonymousLinkUsed)/ nocase
    $share.principal.user.userid = $user
    not $share.principal.user.userid in %global_allowed_service_accounts
    not $share.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1537")
    $primary_entity = array_distinct($user)
    $share_count = count($share.metadata.id)
    $shared_resources = array_distinct($share.target.file.full_path)
    $source_ips = array_distinct($share.principal.ip)
    $share_operations = array_distinct($share.metadata.product_event_type)

  condition:
    #share >= 15
}
