/*
  MITRE Technique : T1098.005 - Device Registration
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:47:40.051802+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_005_Device_Registration_Endpoint_NonSystem_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects HTTP traffic to Entra ID / Intune device registration and enrollment services from a process that is not a native Windows device-registration component. Legitimate Entra join, hybrid join and MDM enrollment run through a small set of OS binaries. Scripting hosts, user-writable binaries and other unexpected processes reaching these services suggest rogue device registration, as done by AADInternals-style tooling to bypass conditional access or MFA."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.005"
    mitre_technique_name = "Account Manipulation: Device Registration"
    log_prerequisites = "Requires EDR or proxy-enriched NETWORK_HTTP telemetry with the initiating process path (principal.process.file.full_path) and the full URL (target.url) or target hostname populated. TLS inspection or an endpoint sensor that records URLs is needed."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Autopilot or provisioning scripts run by IT, MDM/RMM agents performing enrollment, third-party identity or SSO clients, browsers during interactive work-account sign-in, and packaging or imaging tools used by deployment teams."
    tuning_guidance = "Add approved enrollment and provisioning binaries to %global_allowed_admin_tools, MDM and remote management agents to %global_allowed_remote_mgmt, and security agents to %global_allowed_security_tools. Add approved provisioning service accounts to %global_allowed_service_accounts. If your proxy does not record the initiating process, this rule will not evaluate for that source."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    (
      $http.target.url = /(enterpriseregistration\.windows\.net|device\.login\.microsoftonline\.com|\/EnrollmentServer\/)/ nocase or
      $http.target.hostname = /(enterpriseregistration\.windows\.net|device\.login\.microsoftonline\.com)$/ nocase
    )
    $http.principal.process.file.full_path = /.+/
    not $http.principal.process.file.full_path = /\\(dsregcmd|deviceenroller|omadmclient|svchost|CloudExperienceHostBroker|aadbrokerplugin|backgroundtaskhost|msedge|MicrosoftEdgeUpdate|ccmexec)\.exe$/ nocase
    not $http.principal.process.file.full_path in %global_allowed_admin_tools
    not $http.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $http.principal.process.file.full_path in %global_allowed_security_tools
    not $http.principal.user.userid in %global_allowed_service_accounts
    not $http.target.ip in %rfc1918_internal

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1098.005")
    $primary_entity = array_distinct($http.principal.hostname)
    $initiating_process = array_distinct($http.principal.process.file.full_path)
    $initiating_user = array_distinct($http.principal.user.userid)
    $registration_url = array_distinct($http.target.url)

  condition:
    $http
}
