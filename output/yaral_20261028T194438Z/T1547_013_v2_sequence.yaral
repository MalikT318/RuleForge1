/*
  MITRE Technique : T1547.013 - XDG Autostart Entries
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:40:13.837510+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_013_XDG_Autostart_Entry_After_Staged_Payload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A file is written to a world-writable staging directory (/tmp, /var/tmp, /dev/shm) by a shell, interpreter or download utility. A .desktop file is then created in an XDG autostart location (/etc/xdg/autostart or ~/.config/autostart) on the same host within 10 minutes, by a process that is not a package manager. This sequence suggests a staged payload being wired up for execution at the next desktop login."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.013"
    mitre_technique_name = "Boot or Logon Autostart Execution: XDG Autostart Entries"
    log_prerequisites = "Requires Linux EDR or auditd file telemetry that populates FILE_CREATION events with principal.process.file.full_path and target.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Desktop application installers or user-level setup scripts that unpack into /tmp and then register an autostart entry; configuration management or provisioning scripts; users manually enabling startup applications through a desktop settings tool after downloading software; golden-image and VDI build pipelines."
    tuning_guidance = "Add provisioning and deployment binaries to %global_allowed_admin_tools, approved script-running processes to %global_allowed_script_hosts, and approved support tooling to %global_allowed_remote_mgmt. If desktop-environment settings daemons create autostart files in your estate, extend the process-name exclusion in the autostart event. Linux servers without a desktop environment should rarely see this activity, so the rule can be raised in severity there."

  events:
    $drop.metadata.event_type = "FILE_CREATION"
    $drop.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+/ nocase
    $drop.principal.process.file.full_path = /\/(bash|sh|dash|zsh|curl|wget|python[0-9.]*|perl|ruby)$/ nocase
    not $drop.principal.process.file.full_path in %global_allowed_script_hosts
    $drop.principal.hostname = $hostname

    $auto.metadata.event_type = "FILE_CREATION"
    $auto.target.file.full_path = /(^\/etc\/xdg\/autostart|\/\.config\/autostart)\/[^\/]+\.desktop$/ nocase
    not $auto.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|dnf|yum|zypper|packagekitd|snapd|flatpak|gnome-session|gnome-control-center|gnome-tweaks|ksmserver|plasmashell|systemsettings|xfce4-session|xfce4-session-settings)$/ nocase
    not $auto.principal.process.file.full_path in %global_allowed_admin_tools
    not $auto.principal.process.file.full_path in %global_allowed_remote_mgmt
    $auto.principal.hostname = $hostname

    $drop.metadata.event_timestamp.seconds <= $auto.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.013")
    $primary_entity = array_distinct($auto.principal.hostname)
    $staged_files = array_distinct($drop.target.file.full_path)
    $autostart_files = array_distinct($auto.target.file.full_path)
    $writer_processes = array_distinct($auto.principal.process.file.full_path)
    $users = array_distinct($auto.principal.user.userid)

  condition:
    $drop and $auto
}
