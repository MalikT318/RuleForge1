/*
  MITRE Technique : T1176 - Software Extensions
  Tactic(s)       : Persistence
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:26:14.958437+00:00
  Reference       : https://attack.mitre.org/techniques/T1176
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_Linux_Bulk_Extension_Installs {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects several browser or IDE extension manifests being created on a single Linux host within ten minutes. One extension install is routine, but a burst of installs, especially driven by a shell or scripting interpreter, indicates extension-based persistence being staged. The rule covers Chromium-family browser extension manifests, Firefox .xpi packages and VS Code extension package.json files."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176"
    mitre_technique_name = "Software Extensions"
    log_prerequisites = "Requires Linux EDR file-creation telemetry or auditd file-watch rules covering user profile extension directories, normalised to UDM FILE_CREATION with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers setting up a new workstation or syncing IDE extensions, browser profile sync restoring extensions on first sign-in, enterprise browser policy pushing a set of extensions, configuration management or golden-image provisioning."
    tuning_guidance = "Add provisioning and configuration-management binaries to %global_allowed_admin_tools. Add known deployment accounts to %global_allowed_admin_users. Raise the #file threshold for developer-heavy hosts. Risk score is automatically higher when a shell or scripting interpreter writes the extension files."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(\/\.config\/(google-chrome[^\/]*|chromium|microsoft-edge[^\/]*|BraveSoftware\/Brave-Browser)\/[^\/]+\/Extensions\/[^\/]+\/[^\/]+\/manifest\.json|\/\.mozilla\/firefox\/[^\/]+\/extensions\/[^\/]+\.xpi|\/\.vscode(-server|-oss)?\/extensions\/[^\/]+\/package\.json)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($file.principal.process.file.full_path = /\/(bash|sh|dash|zsh|python[0-9.]*|perl|curl|wget)$/ nocase, 85, 60))
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1176")
    $primary_entity = array_distinct($host)
    $users = array_distinct($file.principal.user.userid)
    $extension_files = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)

  condition:
    #file >= 4
}
