/*
  MITRE Technique : T1078 - Valid Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:27:57.839245+00:00
  Reference       : https://attack.mitre.org/techniques/T1078
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_Network_Device_External_Mgmt_Plane_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a connection from an external (non-internal) source address to a network-device management-plane service (SSH, Telnet, NETCONF over SSH, alternate HTTPS admin port) on an internal address. Valid-account abuse against network devices (VPN appliances, routers, switches, firewalls) requires reaching these management services, so the perimeter firewall sees the access even when the device or endpoint telemetry does not. Complements process-creation detections by observing the network side of the credential use."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078"
    mitre_technique_name = "Valid Accounts"
    log_prerequisites = "Perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Reference lists %rfc1918_internal and %global_allowed_mgmt_sources must be maintained per client."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised remote administration by network engineers or MSP staff from unlisted egress addresses, third-party vendor support sessions, approved vulnerability scanners or external attack-surface monitoring, and internet background scanning when the firewall also logs denied traffic."
    tuning_guidance = "Add approved administrator, jump-host and MSP egress addresses to %global_allowed_mgmt_sources and approved external scanners to %global_allowed_scanners. If the firewall logs denied connections, restrict the log feed or add an action filter at the parser level so only permitted sessions are evaluated. Management ports can be adjusted if clients use non-standard admin ports."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 830 or
      $net.target.port = 8443
    )
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1078")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
