/*
  MITRE Technique : T1003.007 - Proc Filesystem
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:49:52.769299+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_007_Proc_Mem_Maps_Mass_Read_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a high volume of reads of /proc/<PID>/mem or /proc/<PID>/maps files on a single Linux host within 10 minutes. A single read of one of these files is common in debugging and monitoring. Sweeping many process memory interfaces in a short window matches credential-scraping behaviour that searches every process's memory for secrets."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.007"
    mitre_technique_name = "OS Credential Dumping: Proc Filesystem"
    log_prerequisites = "Requires Linux EDR file-access telemetry or auditd file watch rules on /proc/*/mem and /proc/*/maps, normalised to UDM FILE_READ with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Debuggers and profilers (gdb, strace, perf), crash dump and core collectors, runtime memory-introspection tooling, JVM or language-runtime diagnostic agents, EDR or AV memory scanners, and backup or checkpoint/restore tooling (for example CRIU)."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools, backup and checkpoint tools to %global_allowed_backup_processes, and approved diagnostics or RMM binaries to %global_allowed_admin_tools. Trusted service accounts can be added to %global_allowed_service_accounts. Raise the #file threshold on developer or debugging hosts, and lower it on hardened servers. Make sure auditd rules watch only /proc/*/mem and /proc/*/maps, to limit volume."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /^\/proc\/[0-9]+\/(mem|maps)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(75)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1003.007")
    $primary_entity = array_distinct($host)
    $reading_processes = array_distinct($file.principal.process.file.full_path)
    $reading_users = array_distinct($file.principal.user.userid)
    $sample_files = array_distinct($file.target.file.full_path)

  condition:
    #file >= 25
}
