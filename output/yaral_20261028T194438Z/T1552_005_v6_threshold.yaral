/*
  MITRE Technique : T1552.005 - Cloud Instance Metadata API
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:53:16.982501+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_005_Instance_Role_Credential_API_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of credential, identity and enumeration API calls made within 10 minutes by an instance-role session (session name is an instance ID) from a non-internal source address. This is the downstream result of instance metadata credentials being stolen through the metadata API or an SSRF flaw and then used off-host. A single call is benign; the volume and source are not."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.005"
    mitre_technique_name = "Unsecured Credentials: Cloud Instance Metadata API"
    log_prerequisites = "Cloud control-plane audit logs normalised to UDM USER_RESOURCE_ACCESS with principal.user.userid (role session identity or ARN), principal.ip and metadata.product_event_type (API name) populated. Management-event logging must be enabled."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Workloads reaching the cloud API through a public NAT or egress IP (an external address from the rule's perspective), auto-scaling and configuration-management tooling run under instance roles, CI/CD runners on cloud instances, inventory and cost-management agents, and approved security scanners."
    tuning_guidance = "Add known automation role sessions to %global_allowed_service_accounts or %global_allowed_cloud_principals. Add corporate NAT or egress addresses to %global_allowed_mgmt_sources and approved scanners to %global_allowed_scanners. Raise the #cloud threshold for noisy tenants. The session-name regex assumes instance-ID session names (i-xxxxxxxx); adjust it if the provider names sessions differently."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.principal.user.userid = /(^|\/)i-[0-9a-f]{8,17}$/ nocase
    $cloud.metadata.product_event_type = /^(GetCallerIdentity|ListBuckets|ListRoles|ListUsers|ListPolicies|ListAttachedRolePolicies|ListRolePolicies|GetRole|GetSecretValue|ListSecrets|GetParameter|GetParameters|GetParametersByPath|DescribeInstances|DescribeSecurityGroups|ListAccessKeys|GetAccountAuthorizationDetails)$/ nocase
    $cloud.principal.ip != ""
    not $cloud.principal.ip in %rfc1918_internal
    not $cloud.principal.ip in %global_allowed_mgmt_sources
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    $cloud.principal.user.userid = $user

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($cloud.metadata.id)
    $mitre_technique_id = array_distinct("T1552.005")
    $primary_entity = array_distinct($user)
    $source_ips = array_distinct($cloud.principal.ip)
    $api_calls = array_distinct($cloud.metadata.product_event_type)

  condition:
    #cloud >= 15
}
