/*
  MITRE Technique : T1071.005 - Publish/Subscribe Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:11:30.936989+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_005_PubSub_Broker_Port_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound connections from internal Windows hosts to external destinations on well-known publish/subscribe broker ports (MQTT, AMQP, STOMP, XMPP). Observed at the network perimeter, this can indicate C2 tunnelled through a message broker. Corporate networks rarely send pub/sub traffic to arbitrary internet brokers."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.005"
    mitre_technique_name = "Application Layer Protocol: Publish/Subscribe Protocols"
    log_prerequisites = "Requires firewall or proxy perimeter logs normalised to UDM NETWORK_CONNECTION with target.ip and target.port populated. Logs must cover egress traffic from Windows client and server segments."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "IoT or building-management systems using cloud MQTT brokers, SaaS and cloud messaging integrations (managed AMQP/MQTT services), developers testing brokers, and corporate XMPP chat clients on 5222/5223."
    tuning_guidance = "Add known-good broker FQDNs to %global_allowed_domains (matched on target.hostname when populated). Ensure %rfc1918_internal is populated for the tenant. For tenants with legitimate IoT or XMPP use, remove the relevant ports (e.g. 5222/5223) or scope by source segment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 1883 or
      $net.target.port = 8883 or
      $net.target.port = 5672 or
      $net.target.port = 5671 or
      $net.target.port = 61613 or
      $net.target.port = 61614 or
      $net.target.port = 5222 or
      $net.target.port = 5223
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1071.005")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
