/*
  MITRE Technique : T1087 - Account Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:51:22.066495+00:00
  Reference       : https://attack.mitre.org/techniques/T1087
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_IdP_Login_Unknown_Account_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external sign-in attempt that the identity provider rejected because the supplied account does not exist (unknown user, invalid username, user-not-found). Valid-account enumeration produces many of these before password spraying or phishing. Each event is a low-confidence signal on its own. Alert volume per source IP indicates active enumeration, so use this rule as the building block for a downstream threshold or aggregation."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087"
    mitre_technique_name = "Account Discovery"
    log_prerequisites = "Identity provider sign-in logs normalised to USER_LOGIN with failure reason text populated in security_result.summary or security_result.description, and the attempted account in target.user.userid."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Users mistyping their username, stale bookmarks or cached credentials on mobile and mail clients after account deletion or rename, offboarded users whose devices still try to sign in, misconfigured applications or service integrations pointing at removed accounts, authorised external penetration tests."
    tuning_guidance = "Add expected automation or integration accounts to %global_allowed_service_accounts. Internal source ranges are already excluded through %rfc1918_internal. Pair this rule with a threshold or aggregation by source IP (for example 10 or more distinct attempted usernames in 10 minutes) to prioritise real enumeration. Adjust the failure-reason regex if the tenant's log parser puts the reason in a different field."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    (
      $auth.security_result.summary = /(unknown user|no such user|user (was )?not found|user does not exist|invalid user ?name|invalid account|account (was )?not found|account does not exist|\b50034\b)/ nocase or
      $auth.security_result.description = /(unknown user|no such user|user (was )?not found|user does not exist|invalid user ?name|invalid account|account (was )?not found|account does not exist|\b50034\b)/ nocase
    )
    $auth.target.user.userid != ""
    not $auth.principal.ip in %rfc1918_internal
    not $auth.target.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1087")
    $primary_entity = array_distinct($auth.principal.ip)
    $attempted_user = array_distinct($auth.target.user.userid)
    $failure_reason = array_distinct($auth.security_result.summary)

  condition:
    $auth
}
