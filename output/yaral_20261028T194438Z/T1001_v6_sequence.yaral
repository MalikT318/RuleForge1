/*
  MITRE Technique : T1001 - Data Obfuscation
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:05:11.293072+00:00
  Reference       : https://attack.mitre.org/techniques/T1001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_Linux_Encode_To_Staging_Then_Upload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a Linux host encoding or obfuscating data (base64, hex, openssl enc) into a world-writable staging path such as /tmp, /var/tmp or /dev/shm, followed within 10 minutes by a curl or wget invocation that uploads data from that staging area. This pattern is consistent with data obfuscation ahead of command-and-control traffic."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001"
    mitre_technique_name = "Data Obfuscation"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry normalised to PROCESS_LAUNCH with full command-line capture, including shell wrapper invocations such as sh -c."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup and log-shipping scripts that encode then upload archives, CI/CD build agents posting artifacts from /tmp, configuration management tooling, monitoring agents submitting encoded payloads, and administrators manually testing APIs."
    tuning_guidance = "Add approved automation binaries to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Add approved script-launching parents to %global_allowed_script_hosts. If a client has noisy build servers, exclude them by adding their parent process to the allowlists rather than loosening the regexes."

  events:
    $enc.metadata.event_type = "PROCESS_LAUNCH"
    $enc.target.process.command_line = /\b(base64|xxd\s+-p|openssl\s+enc|basenc|uuencode)\b.*>>?\s*['"]?\/(tmp|var\/tmp|dev\/shm)\// nocase
    not $enc.principal.process.file.full_path in %global_allowed_admin_tools
    not $enc.principal.process.file.full_path in %global_allowed_script_hosts
    $enc.principal.hostname = $hostname

    $send.metadata.event_type = "PROCESS_LAUNCH"
    $send.target.process.file.full_path = /\/(curl|wget)$/ nocase
    $send.target.process.command_line = /(\s|^)(--data-binary|--data-raw|--data|--post-file|--upload-file|-d|-T)(\s+|=)@?['"]?\/(tmp|var\/tmp|dev\/shm)\// nocase
    not $send.principal.process.file.full_path in %global_allowed_admin_tools
    not $send.principal.user.userid in %global_allowed_service_accounts
    $send.principal.hostname = $hostname

    $enc.metadata.event_timestamp.seconds <= $send.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1001")
    $primary_entity = array_distinct($hostname)
    $encoding_commands = array_distinct($enc.target.process.command_line)
    $upload_commands = array_distinct($send.target.process.command_line)
    $users = array_distinct($send.principal.user.userid)

  condition:
    $enc and $send
}
