/*
  MITRE Technique : T1027.006 - HTML Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:47:48.407160+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_006_Proxy_Oversized_HTML_Document_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows client downloading an unusually large HTML-type document from an external, non-allowlisted site through a proxy or firewall. HTML smuggling embeds the payload (JavaScript Blob or Data URL) inside the HTML itself, so the delivery page is far larger than a normal web page. This is network-side coverage of the delivery stage only and does not depend on endpoint process or command-line telemetry."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.006"
    mitre_technique_name = "Obfuscated Files or Information: HTML Smuggling"
    log_prerequisites = "Requires proxy or firewall logs with URL inspection that populate NETWORK_HTTP events with target.url, network.http.user_agent, network.http.response_code and network.received_bytes."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Large single-page web applications, saved or generated HTML reports, online documentation and e-book downloads, webmail or SaaS pages with inlined assets, and vendor portals serving bundled HTML."
    tuning_guidance = "Add known-good external sites to %global_allowed_domains. Raise or lower the network.received_bytes threshold to match client baseline traffic. Add trusted scanner or crawler sources to %global_allowed_scanners if they generate noise. Deployments whose firewall logs lack user-agent data should remove the Windows user-agent condition."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET"
    $http.network.http.response_code = 200
    $http.target.url = /\.(html?|xhtml|mhtml?)(\?.*)?$/ nocase
    $http.network.http.user_agent = /Windows NT/ nocase
    $http.network.received_bytes > 1500000
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1027.006")
    $primary_entity = array_distinct($http.principal.ip)
    $source_hostname = array_distinct($http.principal.hostname)
    $requested_url = array_distinct($http.target.url)
    $destination_ips = array_distinct($http.target.ip)
    $max_received_bytes = max($http.network.received_bytes)

  condition:
    $http
}
