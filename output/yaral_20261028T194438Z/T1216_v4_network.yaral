/*
  MITRE Technique : T1216 - System Script Proxy Execution
  Tactic(s)       : Stealth
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:32:53.659899+00:00
  Reference       : https://attack.mitre.org/techniques/T1216
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1216_Signed_Script_Host_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows script host (cscript/wscript) running a script from a system directory, or using a script: moniker, that opens a network connection to a non-internal address. Microsoft-signed proxy scripts (for example the Printing_Admin_Scripts content) have no legitimate reason to reach external hosts, so this indicates remote payload retrieval or proxy execution of attacker-controlled content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1216"
    mitre_technique_name = "System Script Proxy Execution"
    log_prerequisites = "Requires EDR or Sysmon-equivalent network connection telemetry (Sysmon Event ID 3 or equivalent) with process image path and process command line populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy logon or inventory VBScript/WSF run from system directories that call external web services; software deployment or RMM scripts using cscript/wscript; admin automation that fetches updates."
    tuning_guidance = "Add approved automation hosts to %global_allowed_script_hosts, approved tooling to %global_allowed_admin_tools, and known-good destination domains to %global_allowed_domains. Review %rfc1918_internal for completeness if internal traffic still alerts."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(cscript|wscript)\.exe$/ nocase
    $net.principal.process.command_line = /script:|\\(system32|syswow64)\\.*\.(vbs|wsf)|\\printing_admin_scripts\\/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1216")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $script_command_lines = array_distinct($net.principal.process.command_line)

  condition:
    $net
}
