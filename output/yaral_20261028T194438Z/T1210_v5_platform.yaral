/*
  MITRE Technique : T1210 - Exploitation of Remote Services
  Tactic(s)       : Lateral Movement
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:17:32.362089+00:00
  Reference       : https://attack.mitre.org/techniques/T1210
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1210_ESXi_Remote_Service_Exposure_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a host configuration change on an ESXi host that enables or exposes a historically exploited remote service (service location protocol/CIM SLP daemon or the managed object browser). The change is made by an account that is not a named administrator and from a source outside approved management addresses. This is a post-exploitation and pre-exploitation staging indicator for remote service exploitation (T1210) against the hypervisor. It does not depend on process command lines, so it complements existing process-creation coverage."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1210"
    mitre_technique_name = "Exploitation of Remote Services"
    log_prerequisites = "ESXi hostd and shell logs forwarded to Google SecOps and parsed into UDM SETTING_MODIFICATION events, with the setting or firewall ruleset name populated in target.resource.name."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorised administrators or lifecycle and automation tooling enabling SLP or the managed object browser for troubleshooting, hardware vendor management integrations that depend on CIM/SLP, and host profile remediation re-applying baseline settings."
    tuning_guidance = "Add named administrators to %global_allowed_admin_users, automation accounts to %global_allowed_service_accounts, and jump hosts or vCenter addresses to %global_allowed_mgmt_sources. If your parser stores the setting name in a different field, adjust the target.resource.name match accordingly."

  events:
    $set.metadata.event_type = "SETTING_MODIFICATION"
    $set.target.resource.name = /(cimslp|\bslpd?\b|openslp|enablemob)/ nocase
    not $set.principal.user.userid in %global_allowed_admin_users
    not $set.principal.user.userid in %global_allowed_service_accounts
    not $set.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1210")
    $primary_entity = array_distinct(strings.coalesce($set.principal.hostname, $set.target.hostname))
    $acting_user = array_distinct($set.principal.user.userid)
    $source_ips = array_distinct($set.principal.ip)
    $changed_settings = array_distinct($set.target.resource.name)

  condition:
    $set
}
