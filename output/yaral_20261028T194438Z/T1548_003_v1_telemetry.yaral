/*
  MITRE Technique : T1548.003 - Sudo and Sudo Caching
  Tactic(s)       : Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:32:05.653863+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_003_Sudoers_File_Modified_By_Unapproved_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of /etc/sudoers or a file under /etc/sudoers.d/ by a process or user that is not an approved administration tool. Adversaries edit sudoers to grant themselves passwordless or elevated sudo rights, such as NOPASSWD entries, or to disable timestamp_timeout and tty_tickets protections. This rule detects the resulting file state change rather than the command line, so it still fires when the edit is made with echo, tee, sed, a script, or a renamed binary."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.003"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Sudo and Sudo Caching"
    log_prerequisites = "Requires Linux endpoint file-integrity telemetry (EDR file events or auditd watches on /etc/sudoers and /etc/sudoers.d) normalized to UDM FILE_MODIFICATION with principal.process and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management agents (Ansible, Puppet, Chef, Salt), package installs or upgrades that drop sudoers.d snippets, cloud-init and provisioning scripts, administrators editing sudoers with visudo, golden-image build pipelines."
    tuning_guidance = "Add approved configuration management and package manager binaries (full path) to %global_allowed_admin_tools, and named administrator accounts to %global_allowed_admin_users. Because a single-event rule can target only one event type, deploy a clone with metadata.event_type = FILE_CREATION to cover newly dropped /etc/sudoers.d/ snippets. Use %global_allowed_service_accounts for automation accounts if this is needed."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/sudoers(\.tmp|\.d\/.+)?$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1548.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $modifying_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
