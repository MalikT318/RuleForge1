/*
  MITRE Technique : T1569.003 - Systemctl
  Tactic(s)       : Execution
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:13:12.399697+00:00
  Reference       : https://attack.mitre.org/techniques/T1569/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_003_Systemd_Unit_File_Written_By_Shell_Or_Temp_Binary {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a systemd unit file (.service, .timer, .socket, or a service drop-in .conf) in a system or user systemd directory by a shell, scripting interpreter, file-copy or download utility, or a binary running from a writable location. Attackers drop a unit file and then start it with systemctl to execute code. This rule detects the resulting file artifact, so it still fires when command-line logging is evaded or the systemctl invocation is obfuscated."
    mitre_tactic = "Execution"
    mitre_technique = "T1569.003"
    mitre_technique_name = "System Services: Systemctl"
    log_prerequisites = "Requires Linux EDR file-creation telemetry or auditd file watches (-w /etc/systemd/system -p wa, /usr/lib/systemd/system, /lib/systemd/system, and user config paths) normalised to UDM FILE_CREATION with principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package post-install scripts (dpkg/rpm maintainer scripts run via sh/cp), configuration management agents (Ansible, Puppet, Chef, Salt) writing units through shells or python, golden-image and provisioning scripts, container or cloud bootstrap scripts, and admins deploying custom services by hand."
    tuning_guidance = "Add configuration-management and deployment binaries to %global_allowed_admin_tools, approved provisioning hosts or parents to %global_allowed_script_hosts, and automation accounts to %global_allowed_service_accounts. Review recurring hits by unit name and creating process before allow-listing."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/etc\/systemd\/(system|user)\/|\/usr\/lib\/systemd\/(system|user)\/|\/lib\/systemd\/(system|user)\/|\/run\/systemd\/(system|user)\/|(\/home\/[^\/]+|\/root)\/\.config\/systemd\/user\/)([^\/]+\/)?[^\/]+\.(service|timer|socket|conf)$/ nocase
    $file.target.file.full_path = /(\.(service|timer|socket)$|\.(service|timer|socket)\.d\/[^\/]+\.conf$)/ nocase
    $file.principal.process.file.full_path = /(\/(bash|sh|dash|zsh|ksh|csh|tcsh|fish|python[0-9.]*|perl|ruby|php|node|curl|wget|tee|cp|mv|dd|install|sed)$|^\/(tmp|var\/tmp|dev\/shm|home|root)\/)/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|rpm|yum|dnf|apt|apt-get|zypper|snapd|packagekitd|cloud-init|unattended-upgrade)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1569.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $unit_file_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $creating_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
