/*
  MITRE Technique : T1570 - Lateral Tool Transfer
  Tactic(s)       : Lateral Movement
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:16:01.918421+00:00
  Reference       : https://attack.mitre.org/techniques/T1570
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1570_ESXi_SSH_Login_From_Unapproved_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a successful SSH session to an ESXi host from a source address outside the approved management sources, by an account that is not a named administrator. SSH/SCP/SFTP is the native channel for staging tools on a hypervisor (for example, pushing ransomware binaries or scripts to /tmp or datastores) during lateral movement. This is additive to process command-line detections because it uses management-plane authentication telemetry rather than process creation."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1570"
    mitre_technique_name = "Lateral Tool Transfer"
    log_prerequisites = "ESXi auth/shell logs (sshd entries in auth.log or syslog) forwarded to Chronicle and parsed to USER_LOGIN with source IP and target user populated. Requires %global_allowed_mgmt_sources to be populated per client with jump hosts and admin workstation addresses."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators connecting from new jump hosts or workstations not yet in the allowlist, backup and patching tools that use SSH or SCP, monitoring and automation systems, break-glass root access during an incident."
    tuning_guidance = "Add approved jump hosts and admin subnets' addresses to %global_allowed_mgmt_sources. Add named administrators to %global_allowed_admin_users. If the parser does not populate security_result.summary with the sshd outcome, adjust or remove that success filter and rely on the allowlists. Consider raising severity for hosts in production clusters."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    (
      $auth.network.application_protocol = "SSH" or
      $auth.target.application = /sshd/ nocase or
      $auth.principal.application = /sshd/ nocase
    )
    $auth.security_result.summary = /accepted|success/ nocase
    $auth.target.hostname != ""
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.target.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1570")
    $primary_entity = array_distinct($auth.target.hostname)
    $source_ips = array_distinct($auth.principal.ip)
    $logon_users = array_distinct($auth.target.user.userid)

  condition:
    $auth
}
