/*
  MITRE Technique : T1552.001 - Credentials In Files
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:45:22.261571+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_001_Container_Credential_File_Read_Then_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a process inside a container or Linux node reading a credential-bearing file (Kubernetes service account token, kubeconfig, container registry auth, cloud CLI credentials, netrc/pgpass/git-credentials) and then opening an outbound connection to a non-internal address on the same host within 10 minutes. This sequence indicates credentials harvested from files and potentially exfiltrated or reused externally."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.001"
    mitre_technique_name = "Unsecured Credentials: Credentials In Files"
    log_prerequisites = "Requires container runtime or node-level file-access telemetry (FILE_READ, for example eBPF/auditd watches on credential paths) and network connection telemetry from the same container or node, normalised to UDM with a populated principal.hostname."
    platform = "Linux"
    log_source = "container"
    false_positives = "Legitimate workloads that read their own service account token and call an external API (CI runners, operators, cloud-integrated applications, external secret managers); cloud CLI or registry login helpers run by administrators; GitOps and deployment agents."
    tuning_guidance = "Add approved agents and operators to %global_allowed_admin_tools, EDR or runtime security sensors to %global_allowed_security_tools, and known-good external destinations by hostname to %global_allowed_domains. Narrow or extend the credential path regex per client. Watch-rule coverage on credential paths must be enabled for FILE_READ events to be generated."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /(\/(var\/)?run\/secrets\/kubernetes\.io\/serviceaccount\/token$|\/\.docker\/config\.json$|\/\.kube\/config$|\/\.aws\/credentials$|\/\.config\/gcloud\/(credentials\.db|application_default_credentials\.json)$|\/\.azure\/(accessTokens|msal_token_cache)\.json$|\/\.git-credentials$|\/\.netrc$|\/\.pgpass$)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    $net.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1552.001")
    $primary_entity = array_distinct($hostname)
    $credential_files = array_distinct($file.target.file.full_path)
    $reader_processes = array_distinct($file.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $file_read_count = count($file.metadata.id)

  condition:
    $file and $net
}
