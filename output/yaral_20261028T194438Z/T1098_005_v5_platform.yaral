/*
  MITRE Technique : T1098.005 - Device Registration
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:47:55.757742+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_005_IdP_Device_Or_MFA_Registration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects registration or enrollment of a new device or MFA authenticator against a user account in identity provider audit logs. Adversaries with stolen credentials enroll their own device or authenticator to defeat MFA and conditional access and to keep persistent access. This covers the identity control plane only and does not depend on endpoint process telemetry."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.005"
    mitre_technique_name = "Account Manipulation: Device Registration"
    log_prerequisites = "Identity provider directory audit logs ingested and normalized to UDM with metadata.product_event_type populated, plus principal.user.userid for the acting identity."
    platform = "Identity Provider"
    log_source = "cloud_audit"
    false_positives = "New-hire onboarding and MFA self-enrollment, employee device refresh or replacement, bulk device provisioning by the helpdesk or autopilot-style enrollment services, BYOD programme enrollment, and MFA re-registration after a lost phone."
    tuning_guidance = "Add provisioning and enrollment automation identities to %global_allowed_service_accounts, helpdesk or identity administrators to %global_allowed_admin_users, and approved integration principals to %global_allowed_cloud_principals. Raise severity or route to triage when the same user also has a risky sign-in or password reset shortly before the registration. Review client-specific audit event names and extend the regex if their audit log uses different wording."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /(register|registered|enroll|enrol|activate|add).{0,40}(device|factor|mfa|authenticator|security.?info|auth.?method)|(device|factor|mfa|authenticator|security.?info|auth.?method).{0,40}(register|registered|enroll|enrol|activate|added)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1098.005")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $audit_event_names = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)
    $target_resources = array_distinct($cloud.target.resource.name)

  condition:
    $cloud
}
