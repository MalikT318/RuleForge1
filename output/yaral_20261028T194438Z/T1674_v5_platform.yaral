/*
  MITRE Technique : T1674 - Input Injection
  Tactic(s)       : Execution
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:18:45.824285+00:00
  Reference       : https://attack.mitre.org/techniques/T1674
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1674_RunMRU_Typed_Interpreter_Command {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Run dialog (Win+R) history entry recording an interpreter or LOLBin invoked with download, encoded or hidden-window arguments. Keystroke-injection tooling and HID attack devices commonly open the Run dialog and type such a command on the user's behalf, and Explorer writes it to the RunMRU registry key."
    mitre_tactic = "Execution"
    mitre_technique = "T1674"
    mitre_technique_name = "Input Injection"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 13 or equivalent) that includes registry value data for HKCU Explorer RunMRU."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or helpdesk staff typing PowerShell or cmd one-liners into the Run dialog, power users running legitimate scripts, and IT onboarding or break-fix sessions."
    tuning_guidance = "Add named administrators to %global_allowed_admin_users and approved support or jump hosts to %global_allowed_script_hosts. Review the matched RunMRU value data in the alert. If the EDR does not populate registry value data, this rule will not fire."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\RunMRU$/ nocase
    $reg.target.registry.registry_value_data = /(?i)\b(powershell|pwsh|cmd|mshta|wscript|cscript|rundll32|regsvr32|bitsadmin|curl|certutil)\b.*(\s-e(nc|ncodedcommand)?\s|-w(indowstyle)?\s+hidden|\biex\b|downloadstring|downloadfile|invoke-webrequest|\biwr\b|invoke-expression|https?:|\s/c\s|urlcache)/
    not $reg.principal.user.userid in %global_allowed_admin_users
    not $reg.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1674")
    $primary_entity = array_distinct($reg.principal.hostname)
    $user = array_distinct($reg.principal.user.userid)
    $runmru_value = array_distinct($reg.target.registry.registry_value_data)

  condition:
    $reg
}
