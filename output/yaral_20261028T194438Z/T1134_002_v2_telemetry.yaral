/*
  MITRE Technique : T1134.002 - Create Process with Token
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:55:09.160421+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_002_Token_Source_Handle_Open_SYSTEM_Process_From_UserWritable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process running from a user-writable location (user profile, Temp, ProgramData, Public) that opens a handle to a SYSTEM-context process such as winlogon, lsass, services, wininit or spoolsv. Opening these processes is the prerequisite for harvesting or duplicating a SYSTEM token, which is then passed to CreateProcessWithTokenW to spawn a process in another security context. The rule detects the process-handle request rather than the command line, so it still fires when command-line logging is evaded or the tooling is renamed."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.002"
    mitre_technique_name = "Access Token Manipulation: Create Process with Token"
    log_prerequisites = "Requires EDR or Sysmon-equivalent process-access telemetry (Sysmon Event ID 10 or equivalent) normalised to PROCESS_OPEN with principal.process and target.process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Security agents, DLP and backup software installed under ProgramData or user profile paths; per-user software updaters and installers that query system processes; debuggers or profilers run by developers from user directories; portable admin or diagnostic utilities used by IT staff."
    tuning_guidance = "Add EDR/AV agent binaries to %global_allowed_security_tools, imaging and backup agents to %global_allowed_backup_processes, and approved IT tooling to %global_allowed_admin_tools. Add known service accounts to %global_allowed_service_accounts. If a customer runs agents from ProgramData, add the executable path to the appropriate list rather than widening the name exclusion."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\(winlogon|lsass|services|wininit|spoolsv)\.exe$/ nocase
    $open.principal.process.file.full_path = /\\(Users\\[^\\]+\\(AppData|Downloads|Desktop|Documents)|Users\\Public|Windows\\Temp|ProgramData|Temp)\\/ nocase
    not $open.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|SenseCncProxy|NisSrv|csrss|smss|svchost|lsass|services|winlogon|wininit|werfault|taskmgr|procexp|procexp64)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1134.002")
    $primary_entity = array_distinct($open.principal.hostname)
    $source_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $source_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
