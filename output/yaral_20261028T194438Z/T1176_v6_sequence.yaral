/*
  MITRE Technique : T1176 - Software Extensions
  Tactic(s)       : Persistence
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:25:54.395046+00:00
  Reference       : https://attack.mitre.org/techniques/T1176
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_Extension_Package_Download_Then_NonStandard_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A Windows client downloads a browser or IDE extension package (.crx, .vsix, .xpi) from a domain outside the known-good list, then opens an external connection on a non-standard high port within 10 minutes. This pattern is consistent with a side-loaded or malicious extension installing and then establishing C2 outside normal web channels."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176"
    mitre_technique_name = "Software Extensions"
    log_prerequisites = "Requires firewall or web-proxy logs normalised to UDM NETWORK_HTTP (with target.url and target.hostname) and NETWORK_CONNECTION (with principal.ip, target.ip, target.port). Proxy must log full URLs; TLS inspection is needed to see URLs over HTTPS."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Developers side-loading internal or third-party extensions from private artifact repositories or GitHub releases; IT staff packaging enterprise extensions; legitimate applications using custom high ports (VoIP, gaming, P2P, vendor agents) shortly after a download."
    tuning_guidance = "Add approved extension distribution and vendor domains to %global_allowed_domains. Add developer or build egress sources to %global_allowed_mgmt_sources if appropriate. Raise the port threshold or add destination exclusions for known custom-port services."

  events:
    $dl.metadata.event_type = "NETWORK_HTTP"
    $dl.network.http.method = "GET" nocase
    $dl.target.url = /\.(crx|vsix|xpi)(\?|#|$)/ nocase
    not $dl.target.hostname in %global_allowed_domains
    $dl.principal.ip = $src_ip

    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %rfc1918_internal
    $net.target.port > 1024
    not $net.target.hostname in %global_allowed_domains
    $net.principal.ip = $src_ip

    $dl.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1176")
    $primary_entity = array_distinct($src_ip)
    $extension_urls = array_distinct($dl.target.url)
    $download_hosts = array_distinct($dl.target.hostname)
    $egress_ips = array_distinct($net.target.ip)
    $egress_ports = array_distinct($net.target.port)
    $connection_count = count($net.metadata.id)

  condition:
    $dl and $net
}
