/*
  MITRE Technique : T1105 - Ingress Tool Transfer
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:13:00.221289+00:00
  Reference       : https://attack.mitre.org/techniques/T1105
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1105_Linux_CLI_Downloader_UserAgent_External_Payload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects proxy or firewall HTTP telemetry where a command-line download client (curl, wget, libwww-perl, Python HTTP libraries, fetch) requests a payload-like file (script, ELF, binary, shared object, kernel module, archive, package) from an external destination. The client is identified by its HTTP user-agent and the file type by the URL, so the rule needs no endpoint process data. It adds network-side coverage of Linux ingress tool transfer alongside process-based detections."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1105"
    mitre_technique_name = "Ingress Tool Transfer"
    log_prerequisites = "Requires web proxy or next-generation firewall logs with HTTP inspection that populate network.http.user_agent and target.url (plain HTTP, or HTTPS with TLS inspection). Source IP must be populated."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Administrators or automation downloading installers, packages or scripts from vendor sites; CI/CD build agents; configuration management bootstrapping; container image builds fetching binaries; monitoring agent installers."
    tuning_guidance = "Add known-good vendor, repository and CDN domains to %global_allowed_domains. Add build servers, automation hosts and jump hosts to %global_allowed_script_hosts. Extend the file-extension list for environment-specific payload types. If volume is high, raise severity only when the destination is a bare IP or newly seen domain."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.user_agent = /^(curl|wget|libwww-perl|lwp-|python-requests|python-urllib|fetch)/ nocase
    $http.network.http.method = "GET" nocase
    $http.target.url = /\.(sh|bash|elf|bin|py|pl|so|ko|run|tgz|tar\.gz|gz|deb|rpm|appimage)(\?.*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1105")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
