/*
  MITRE Technique : T1176.001 - Browser Extensions
  Tactic(s)       : Persistence
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:27:19.731014+00:00
  Reference       : https://attack.mitre.org/techniques/T1176/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_001_NonBrowser_Extension_Package_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux process that is not a web browser fetching a browser extension package (.crx or .xpi) over HTTP(S) from an external destination. Adversaries stage malicious extensions with command-line downloaders or scripts, then side-load them into Chromium or Firefox profiles for persistence. Browsers installing from their own stores are excluded by process name."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176.001"
    mitre_technique_name = "Software Extensions: Browser Extensions"
    log_prerequisites = "Requires HTTP telemetry (NETWORK_HTTP) with target.url populated, from a forward proxy or from Linux endpoint network telemetry with process attribution. Rule is most precise when principal.process.file.full_path is populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers packaging or testing browser extensions, configuration management or software deployment pulling enterprise-managed extension packages, automated QA/browser test harnesses, and package mirroring jobs. Proxy-sourced events with no process attribution will not be excluded by process name."
    tuning_guidance = "Add approved deployment and automation binaries to %global_allowed_admin_tools, trusted extension hosting domains to %global_allowed_domains, and script-host parents to %global_allowed_script_hosts. Extend the browser process-name regex if the estate uses additional Chromium or Firefox derivatives."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\.(crx|xpi)(\?.*)?$/ nocase
    not $http.principal.process.file.full_path = /\/(chrome|google-chrome|google-chrome-stable|chromium|chromium-browser|firefox|firefox-bin|brave|brave-browser|opera|vivaldi|msedge|microsoft-edge|microsoft-edge-stable)$/ nocase
    not $http.principal.process.file.full_path in %global_allowed_admin_tools
    not $http.principal.process.parent_process.file.full_path in %global_allowed_script_hosts
    not $http.target.hostname in %global_allowed_domains
    not $http.target.ip in %rfc1918_internal

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1176.001")
    $primary_entity = array_distinct($http.principal.hostname)
    $download_urls = array_distinct($http.target.url)
    $download_processes = array_distinct($http.principal.process.file.full_path)
    $source_users = array_distinct($http.principal.user.userid)

  condition:
    $http
}
