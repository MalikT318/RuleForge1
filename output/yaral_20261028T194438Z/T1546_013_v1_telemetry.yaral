/*
  MITRE Technique : T1546.013 - PowerShell Profile
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:18:14.458364+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_013_PowerShell_Profile_File_Written {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a PowerShell profile script (profile.ps1 or a host-specific variant for the console, ISE or VS Code). The path covers the all-users location under the PowerShell install directory and per-user Documents locations, for both Windows PowerShell 5.x and PowerShell 7. The rule works on the resulting file artifact, so it fires regardless of how the profile was written (echo, Out-File, Set-Content, .NET API, copy) and is not affected by command-line obfuscation or logging gaps. A new profile gives the attacker code that runs every time PowerShell starts, which supports persistence and privilege escalation when a higher-privileged account loads it."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.013"
    mitre_technique_name = "Event Triggered Execution: PowerShell Profile"
    log_prerequisites = "Requires endpoint file telemetry that records file creation events with the full target path and the writing process (EDR file events or Sysmon Event ID 11) normalised to UDM FILE_CREATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or configuration management (DSC, Group Policy preferences, Ansible, Chef, Puppet) deploying standard corporate profiles; developers and power users customising their own profile; user-profile creation or roaming-profile and folder-redirection sync restoring profile.ps1; software installers (PowerShell 7, oh-my-posh, posh-git, Azure and AWS CLI tooling, VS Code extensions) that create a profile; OneDrive Known Folder Move syncing Documents."
    tuning_guidance = "Add approved deployment and configuration-management binaries to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. This rule covers FILE_CREATION only. Deploy a cloned copy that uses FILE_MODIFICATION to cover appends to an existing profile, and tune it separately because its volume will be higher. Consider raising severity for the all-users profile under the PowerShell install directory, since it executes for every user including administrators."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(WindowsPowerShell|PowerShell)\\(v1\.0\\|7\\)?(Microsoft\.(PowerShell|PowerShellISE|VSCode)_)?profile\.ps1$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546.013")
    $primary_entity = array_distinct($file.principal.hostname)
    $profile_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
