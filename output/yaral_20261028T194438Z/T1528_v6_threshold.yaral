/*
  MITRE Technique : T1528 - Steal Application Access Token
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:28:33.133116+00:00
  Reference       : https://attack.mitre.org/techniques/T1528
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1528_SaaS_Burst_Token_Issuance_Per_User {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single user identity completes an unusually high volume of application authentications (token issuances) in the unified audit log within ten minutes. Each login is benign on its own. A burst can indicate stolen refresh or access tokens being replayed to mint new tokens across many SaaS applications, or a malicious or consented app harvesting tokens on the user's behalf."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1528"
    mitre_technique_name = "Steal Application Access Token"
    log_prerequisites = "Requires unified audit logs for sign-in and application authentication events, normalised to USER_LOGIN with principal.user.userid and target.application populated."
    platform = "SaaS"
    log_source = "m365"
    false_positives = "Users opening many SaaS apps at once after a browser restart or SSO session expiry; desktop or mobile suites that refresh tokens for several apps together; automation or sync clients run under user identities; shared kiosk or VDI logons."
    tuning_guidance = "Add automation and integration identities to %global_allowed_service_accounts and administrator accounts to %global_allowed_admin_users. Raise the #auth threshold (default 15) in tenants with heavy single-sign-on usage. Review the $applications and $source_ips outcome values for unfamiliar apps or sources."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid = $user
    $auth.target.application != ""
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($auth.metadata.id)
    $mitre_technique_id = array_distinct("T1528")
    $primary_entity = array_distinct($user)
    $applications = array_distinct($auth.target.application)
    $source_ips = array_distinct($auth.principal.ip)

  condition:
    #auth >= 15
}
