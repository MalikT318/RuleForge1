/*
  MITRE Technique : T1572 - Protocol Tunneling
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:19:51.942476+00:00
  Reference       : https://attack.mitre.org/techniques/T1572
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1572_Outbound_Internal_Protocol_To_External_Tunnel {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects outbound connections from internal hosts to external (non-RFC1918) addresses on ports normally reserved for internal administrative and file-sharing protocols (SSH, Telnet, RPC, SMB, RDP, WinRM). These protocols are normally blocked at the perimeter, so an allowed egress connection suggests encapsulation or port forwarding to external infrastructure (T1572), or a tunnel endpoint on a standard port."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1572"
    mitre_technique_name = "Protocol Tunneling"
    log_prerequisites = "Firewall, proxy or perimeter logs normalised to UDM NETWORK_CONNECTION with direction, source host or IP, destination IP and destination port populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Administrators using SSH, RDP or WinRM to approved external or cloud-hosted servers; vendor remote support sessions; hybrid-cloud management traffic; SFTP or SSH-based file transfer to partners; Azure/AWS bastion access."
    tuning_guidance = "Add approved administrative source addresses to %global_allowed_mgmt_sources and known-good external destinations to %global_allowed_domains. Narrow or extend the port list per client egress policy. If the client legitimately permits one of these protocols outbound (for example SSH for developers), remove that port or scope it to specific sources."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.direction = "OUTBOUND"
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 135 or
      $net.target.port = 445 or
      $net.target.port = 3389 or
      $net.target.port = 5985 or
      $net.target.port = 5986
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1572")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
