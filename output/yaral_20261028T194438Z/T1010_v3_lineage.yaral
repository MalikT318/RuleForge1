/*
  MITRE Technique : T1010 - Application Window Discovery
  Tactic(s)       : Discovery
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:18:21.354295+00:00
  Reference       : https://attack.mitre.org/techniques/T1010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1010_Unexpected_Parent_Window_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office application, web server, database service or print spooler spawning a shell, script interpreter or tasklist that carries window-enumeration indicators (window titles, window-handle APIs, tasklist verbose output). Legitimate use of these parents does not include enumerating open application windows, so this lineage points to post-exploitation or malicious-document discovery activity. The rule is driven by process lineage and uses the command line only as a secondary qualifier."
    mitre_tactic = "Discovery"
    mitre_technique = "T1010"
    mitre_technique_name = "Application Window Discovery"
    log_prerequisites = "Requires Windows EDR process telemetry or Sysmon Event ID 1 that populates both parent (principal.process) and child (target.process) image paths and the child command line."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros or add-ins from legitimate business tooling that query window titles for automation or screen-capture; web or database administration scripts launched by IIS, SQL Server or MySQL agent jobs; RMM or support tooling started from an Office process; accessibility or UI-automation test harnesses."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts, approved admin tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Add security agents that spawn helpers to %global_allowed_security_tools. If a particular parent family is noisy, remove it from the parent regex for that client rather than weakening the window-enumeration qualifier."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat[0-9]*|sqlservr|mysqld|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|tasklist)\.exe$/ nocase
    $proc.target.process.command_line = /(MainWindowTitle|EnumWindows|EnumChildWindows|GetForegroundWindow|GetWindowText|FindWindow|AppActivate|user32|tasklist.*\/v)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1010")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
