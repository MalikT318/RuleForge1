/*
  MITRE Technique : T1678 - Delay Execution
  Tactic(s)       : Stealth
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:24:11.309484+00:00
  Reference       : https://attack.mitre.org/techniques/T1678
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1678_Linux_Delayed_Execution_Timer_Or_AtJob_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a systemd timer unit (system, runtime or per-user) or an at(1) spool job file by a process that is not a package manager or approved admin tool. These native scheduling artifacts let malware defer execution to outlast sandbox analysis windows or separate itself in time from the initial compromise. The rule works at the file-artifact layer, so it fires even when command-line logging is evaded or the scheduling utility is renamed."
    mitre_tactic = "Stealth"
    mitre_technique = "T1678"
    mitre_technique_name = "Delay Execution"
    log_prerequisites = "Linux EDR or auditd file-watch telemetry (FILE_CREATION) covering /etc/systemd, /run/systemd, user ~/.config/systemd and /var/spool/at or /var/spool/cron/atjobs, normalised to UDM."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management (Ansible, Puppet, Chef, Salt) deploying timers; administrators legitimately scheduling jobs with at; software installers dropping timer units outside a package manager; users creating personal systemd timers."
    tuning_guidance = "Add approved deployment and configuration-management binaries to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and named administrators to %global_allowed_admin_users. Extend the package-manager regex if a client uses another installer. Consider raising severity when the creating process runs from /tmp, /dev/shm or /var/tmp."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/etc\/systemd\/(system|user)\/[^\/]+\.timer|\/run\/systemd\/system\/[^\/]+\.timer|\/home\/[^\/]+\/\.config\/systemd\/user\/[^\/]+\.timer|\/root\/\.config\/systemd\/user\/[^\/]+\.timer|\/var\/spool\/(cron\/atjobs|at)\/[^\/]+)$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|rpm|apt|apt-get|yum|dnf|zypper|pacman|snapd|packagekitd|unattended-upgrade)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1678")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $creating_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
