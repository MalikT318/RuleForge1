/*
  MITRE Technique : T1553.005 - Mark-of-the-Web Bypass
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:07:09.192528+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_005_Non_Browser_Container_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a non-browser Windows process (scripting host or built-in download utility) fetching a container file (disk image or archive) over HTTP from an external destination. Downloads made this way typically carry no Zone.Identifier Mark-of-the-Web tag, and files later mounted or extracted from the container also lose it, bypassing SmartScreen and Protected View."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.005"
    mitre_technique_name = "Subvert Trust Controls: Mark-of-the-Web Bypass"
    log_prerequisites = "Requires NETWORK_HTTP telemetry with the URL and the originating process path populated, for example EDR network events or a proxy or secure web gateway log enriched with endpoint process context."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or deployment scripts pulling ISO or VHD images and archives with PowerShell, curl or BITS. Software packaging pipelines and patch or driver downloaders. Developers fetching zip or 7z archives from public repositories."
    tuning_guidance = "Add approved vendor or CDN domains to %global_allowed_domains. Add approved deployment and RMM binaries to %global_allowed_admin_tools. If zip and gz archives are too noisy, remove them from the extension regex and keep the disk image types. Raise severity when the same host later launches a process from a mounted image path."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\.(iso|img|vhd|vhdx|arj|7z|rar|gz|zip)([?#].*)?$/ nocase
    $net.principal.process.file.full_path = /\\(powershell|pwsh|curl|bitsadmin|certutil|wscript|cscript|mshta|wget)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1553.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $downloaded_urls = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)
    $downloader_process = array_distinct($net.principal.process.file.full_path)
    $downloader_cmdline = array_distinct($net.principal.process.command_line)

  condition:
    $net
}
