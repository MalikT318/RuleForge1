/*
  MITRE Technique : T1496.004 - Cloud Service Hijacking
  Tactic(s)       : Impact
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:58:15.978551+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_004_Cloud_Messaging_Or_AI_Service_Enabled_Then_Abused {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects one identity creating or enabling a messaging or AI-inference capability (sender identity, sending quota, model access) and then calling bulk-send or model-invocation APIs within 10 minutes. This is the typical pattern of cloud service hijacking for spam and phishing delivery or LLMJacking."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.004"
    mitre_technique_name = "Resource Hijacking: Cloud Service Hijacking"
    log_prerequisites = "Cloud control-plane and data-event audit logs normalised to UDM, with metadata.product_event_type and principal.user.userid populated. Messaging send and model invocation calls must be logged (data-event logging enabled)."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Developers or platform teams onboarding a new email-sending or AI workload and testing it straight away; infrastructure-as-code pipelines that provision and exercise a service in one run; legitimate marketing or notification launches."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, approved cloud service principals to %global_allowed_cloud_principals, and named platform administrators to %global_allowed_admin_users. If the join is too noisy, require a higher count of usage events in the condition (e.g. #use >= 3) or shorten the window."

  events:
    $enable.metadata.event_type = "RESOURCE_CREATION"
    $enable.metadata.product_event_type = /(CreateEmailIdentity|VerifyEmailIdentity|VerifyDomainIdentity|CreateSenderIdentity|PutAccountSendingAttributes|UpdateAccountSendingEnabled|PutFoundationModelEntitlement|PutUseCaseForModelAccess|CreateModelInvocationJob|CreateProvisionedModelThroughput)/ nocase
    $enable.principal.user.userid = $user
    not $enable.principal.user.userid in %global_allowed_service_accounts
    not $enable.principal.user.userid in %global_allowed_cloud_principals
    not $enable.principal.user.userid in %global_allowed_admin_users

    $use.metadata.event_type = "USER_RESOURCE_ACCESS"
    $use.metadata.product_event_type = /(SendBulkEmail|SendBulkTemplatedEmail|SendEmail|SendRawEmail|SendTemplatedEmail|InvokeModel|InvokeModelWithResponseStream|Converse|ConverseStream)/ nocase
    $use.principal.user.userid = $user
    not $use.principal.user.userid in %global_allowed_service_accounts
    not $use.principal.user.userid in %global_allowed_cloud_principals
    not $use.principal.user.userid in %global_allowed_admin_users

    $enable.metadata.event_timestamp.seconds <= $use.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1496.004")
    $primary_entity = array_distinct($user)
    $enable_actions = array_distinct($enable.metadata.product_event_type)
    $usage_actions = array_distinct($use.metadata.product_event_type)
    $usage_count = count($use.metadata.id)
    $source_ips = array_distinct($use.principal.ip)

  condition:
    $enable and $use
}
