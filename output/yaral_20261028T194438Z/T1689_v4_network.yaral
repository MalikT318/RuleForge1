/*
  MITRE Technique : T1689 - Downgrade Attack
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:37:34.278817+00:00
  Reference       : https://attack.mitre.org/techniques/T1689
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1689_Linux_Plaintext_HTTP_Payload_Fetch_Downgrade {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux host using a scripted HTTP client (curl, wget, python, perl, etc.) to retrieve an executable, script or package-type object over cleartext HTTP on port 80 from an external destination. Fetching payloads over unencrypted HTTP is the network-side result of protocol downgrade (SSL stripping, forced http:// fallback, disabled TLS verification). Cleartext transfers are exposed to tampering and adversary-in-the-middle manipulation."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1689"
    mitre_technique_name = "Downgrade Attack"
    log_prerequisites = "Requires NETWORK_HTTP telemetry (web proxy, network sensor or EDR network events) with target.url, target.port and network.http.user_agent populated for Linux hosts."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers and mirrors that legitimately use HTTP (apt, yum, dnf, zypper), internal automation pulling installers from vendor HTTP mirrors, legacy appliance firmware or bootstrap scripts, and admins testing downloads manually."
    tuning_guidance = "Add approved package managers and deployment tooling to %global_allowed_admin_tools, add trusted mirror and vendor domains to %global_allowed_domains, and confirm %rfc1918_internal covers the client's internal address space. For noisy environments, raise severity only when the same host also shows follow-on process execution from /tmp or /dev/shm."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.port = 80
    $net.target.url = /^http:\/\// nocase
    $net.target.url = /\.(sh|bash|py|pl|rb|elf|bin|so|run|deb|rpm|apk|tar|tgz|tar\.gz|zip)(\?.*)?$/ nocase
    $net.network.http.user_agent = /^(curl|wget|python-requests|python-urllib|libwww-perl|go-http-client|ruby|lwp)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1689")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)
    $source_users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
