/*
  MITRE Technique : T1620 - Reflective Code Loading
  Tactic(s)       : Stealth
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:44:51.679567+00:00
  Reference       : https://attack.mitre.org/techniques/T1620
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1620_Linux_Service_Parent_Spawns_Memory_Backed_Exec {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing service process (web server, application server or database) launching a child that executes from anonymous memory or a memory-backed path (/proc/<pid>/fd/N, memfd:, /dev/shm), or an interpreter whose command line uses memfd_create or those paths. These are hallmarks of reflective or fileless code loading originating from an unexpected parent, typically after web shell or service exploitation."
    mitre_tactic = "Stealth"
    mitre_technique = "T1620"
    mitre_technique_name = "Reflective Code Loading"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records (with SYSCALL path and parent process populated) normalised to UDM PROCESS_LAUNCH with principal.process.file.full_path and target.process.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Container runtimes and sandboxed services that execute from memfd (runc re-exec uses /proc/self/exe and memfd), JIT or plugin frameworks, some database extensions or backup hooks that stage binaries in /dev/shm, and developer or admin troubleshooting on app servers."
    tuning_guidance = "Add approved parent processes or script hosts to %global_allowed_script_hosts. Add legitimate management or deployment tooling to %global_allowed_admin_tools. Extend the parent regex with local service binary names if needed. On container hosts, review runc and containerd parents before enabling in blocking playbooks."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|php-fpm[0-9.]*|lighttpd|tomcat[0-9]*|mysqld|mariadbd|postgres|mongod|redis-server)$/ nocase
    (
      $proc.target.process.file.full_path = /^\/(proc\/(self|[0-9]+)\/fd\/[0-9]+|dev\/shm\/.+|memfd:.*)/ nocase or
      (
        $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|python[0-9.]*|perl|ruby|php[0-9.]*)$/ nocase and
        $proc.target.process.command_line = /(memfd_create|\/proc\/(self|[0-9]+)\/fd\/[0-9]+|\/dev\/shm\/)/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1620")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
