/*
  MITRE Technique : T1535 - Unused/Unsupported Cloud Regions
  Tactic(s)       : Stealth
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:35:13.955402+00:00
  Reference       : https://attack.mitre.org/techniques/T1535
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1535_Burst_Resource_Creation_Rarely_Used_Region {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single cloud identity creates several resources within ten minutes in regions that are opt-in, newly launched or rarely enabled. This is a common pattern when an adversary with compromised credentials deploys infrastructure (for example cryptominers) where nobody is monitoring. One creation event is benign. A burst by one identity in these regions is not."
    mitre_tactic = "Stealth"
    mitre_technique = "T1535"
    mitre_technique_name = "Unused/Unsupported Cloud Regions"
    log_prerequisites = "Cloud control-plane audit logs ingested and normalised to UDM RESOURCE_CREATION events, with the region populated in target.location.name and the acting identity in principal.user.userid."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Organisations that legitimately operate in opt-in regions for data residency or latency (for example Africa, Middle East, Israel, Hong Kong or newer European regions). Infrastructure-as-code pipelines and autoscaling or DR tests that deploy several resources at once. Cloud-provider-managed automation."
    tuning_guidance = "Add IaC pipeline and automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. If the tenant legitimately uses a listed region, remove it from the region regex for that client. If your parser populates the region in principal.location.name instead of target.location.name, change the field. Raise the #cloud threshold for noisy environments."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.target.location.name = /^(af-south-1|ap-east-1|ap-south-2|ap-southeast-3|ap-southeast-4|ap-southeast-5|eu-south-1|eu-south-2|eu-central-2|me-south-1|me-central-1|il-central-1|ca-west-1|africa-south1|me-central1|me-central2|me-west1|southamerica-west1|asia-south2|europe-central2|europe-southwest1|southafricanorth|southafricawest|uaecentral|uaenorth|qatarcentral|israelcentral|brazilsoutheast|norwaywest|switzerlandwest|germanynorth|jioindiacentral|jioindiawest)$/ nocase
    $cloud.principal.user.userid = $user
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($cloud.metadata.id)
    $mitre_technique_id = array_distinct("T1535")
    $primary_entity = array_distinct($user)
    $regions = array_distinct($cloud.target.location.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    #cloud >= 3
}
