/*
  MITRE Technique : T1127 - Trusted Developer Utilities Proxy Execution
  Tactic(s)       : Stealth, Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:36:36.115675+00:00
  Reference       : https://attack.mitre.org/techniques/T1127
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1127_Dev_Utility_Mass_Executable_Drop_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single host has a trusted developer utility (MSBuild, csc, vbc, jsc, InstallUtil, RegAsm, RegSvcs, debuggers, scripting REPLs, ilasm) write several executable or script files into user-writable staging locations within ten minutes. One compile output is routine; repeated drops of binaries or scripts by these utilities suggest proxy execution or payload staging. The rule uses file-creation telemetry, so it complements command-line detections."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1127"
    mitre_technique_name = "Trusted Developer Utilities Proxy Execution"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with the creating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developer workstations and build servers compiling into temp or ProgramData folders, PowerShell Add-Type compiling inline C# (csc.exe writing temp DLLs), software installers running InstallUtil, RegAsm or RegSvcs, and CI/CD agents."
    tuning_guidance = "Add build servers and developer hosts to %global_allowed_script_hosts. Add approved build or deployment tooling to %global_allowed_admin_tools. Add build service accounts to %global_allowed_service_accounts. Raise the #file threshold on developer-heavy estates. Escalate manually when $event_count is high or when $dev_utilities contains non-compiler utilities such as debuggers or InstallUtil."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(msbuild|csc|vbc|jsc|installutil|regasm|regsvcs|cdb|ntsd|windbg|kd|rcsi|csi|dnx|ilasm|aspnet_compiler)\.exe$/ nocase
    $file.target.file.full_path = /(\\users\\[^\\]+\\appdata\\|\\windows\\temp\\|\\programdata\\|\\users\\public\\).*\.(dll|exe|scr|ps1|vbs|js|hta|bat|cmd)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.hostname in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1127")
    $primary_entity = array_distinct($host)
    $dev_utilities = array_distinct($file.principal.process.file.full_path)
    $dropped_files = array_distinct($file.target.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 5
}
