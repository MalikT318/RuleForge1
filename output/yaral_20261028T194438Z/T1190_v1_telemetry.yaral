/*
  MITRE Technique : T1190 - Exploit Public-Facing Application
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:35:46.491854+00:00
  Reference       : https://attack.mitre.org/techniques/T1190
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1190_ESXi_Network_Daemon_Drops_Executable_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a script or executable artifact in a world-writable staging location (/tmp, /var/tmp, /dev/shm, /store/packages) by a network-facing hypervisor management daemon (SLP, host agent, reverse proxy, management agent). Network-facing daemons do not normally write executable content to these paths. A write here is a strong indicator of successful remote exploitation of an exposed service, such as an SLP heap overflow or a management-plane RCE, and follows the exploit regardless of the payload or command line used."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1190"
    mitre_technique_name = "Exploit Public-Facing Application"
    log_prerequisites = "ESXi host file-activity telemetry (shell, hostd, auditd-style file events) forwarded to Chronicle and normalised to FILE_CREATION with principal.process populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Host patching or VIB/offline-bundle installs staged through the host agent; vendor-supplied support or health-check scripts unpacked to /tmp; hardware vendor agent installation; backup or monitoring agent self-updates; admin-initiated troubleshooting that unpacks scripts via a management daemon."
    tuning_guidance = "Add legitimate patch, VIB and agent-deployment process paths to %global_allowed_admin_tools. Add known automation accounts to %global_allowed_service_accounts. Add EDR or monitoring agents to %global_allowed_security_tools. If the estate patches through the host agent, schedule patch windows and review hits outside them."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.hostname != ""
    $file.principal.process.file.full_path = /\/(slpd|openslpd|hostd|rhttpproxy|vpxa|fdm|sfcbd|envoy|vsanmgmtd|vmware-hostd)$/ nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|store\/packages)\/.*\.(py|sh|pl|so|elf|bin|cgi|php|jsp)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1190")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_files = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
