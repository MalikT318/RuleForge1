/*
  MITRE Technique : T1036.010 - Masquerade Account Name
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:13:03.835185+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_010_IaaS_Masquerading_Account_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a cloud or directory account whose name matches or approximates a privileged, generic or service-style account name (admin, root, support, backup, svc-*, kube-*, or leetspeak variants such as adm1n or r00t). Adversaries use these names to make a newly created account blend in with legitimate administrative or service identities. Covers the IaaS control plane (IAM user creation) using audit events, with no endpoint process fields."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.010"
    mitre_technique_name = "Masquerading: Masquerade Account Name"
    log_prerequisites = "Requires cloud control-plane or identity audit logs that populate USER_CREATION with principal.user.userid (actor) and target.user.userid (created account), for example IAM user creation and directory user creation events."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Legitimate provisioning of service, backup or break-glass accounts that use conventional names; infrastructure-as-code pipelines and onboarding automation creating svc-* or admin-* identities; migration projects recreating existing account names."
    tuning_guidance = "Add provisioning pipelines and automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Add named administrators who legitimately create privileged accounts to %global_allowed_admin_users. If the service-prefix branch is noisy, remove it and keep the exact generic-name and lookalike branches."

  events:
    $iam.metadata.event_type = "USER_CREATION"
    $iam.target.user.userid != ""
    $iam.target.user.userid = /^((adm[i1l]n([i1l]strat[o0]r)?|r[o0]{2}t|sup{1,2}[o0]rt|he[l1]p(desk)?|sys(tem|adm[i1l]n)?|sec(urity)?(adm[i1l]n)?|backup|bkp|ssh|deploy|devops|operator|owner|superuser)|(svc|service|sa|system|backup|bkp|kube|k8s|cluster|cloud|azure|aws|gcp)[-_.][a-z0-9._-]+)(@.*)?$/ nocase
    not $iam.principal.user.userid in %global_allowed_service_accounts
    not $iam.principal.user.userid in %global_allowed_cloud_principals
    not $iam.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1036.010")
    $primary_entity = array_distinct($iam.target.user.userid)
    $creating_actor = array_distinct($iam.principal.user.userid)
    $source_ips = array_distinct($iam.principal.ip)

  condition:
    $iam
}
