/*
  MITRE Technique : T1048.002 - Exfiltration Over Asymmetric Encrypted Non-C2 Protocol
  Tactic(s)       : Exfiltration
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:36:27.845248+00:00
  Reference       : https://attack.mitre.org/techniques/T1048/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1048_002_Large_Outbound_SSH_SFTP_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a single large outbound transfer from an internal Linux host to an external address over a port used by an asymmetrically encrypted file-transfer protocol (SSH/SCP/SFTP on 22 or 2222, FTPS on 990). Linux servers rarely push tens of megabytes to the internet over these protocols, so this is a network-side indicator of bulk exfiltration over an alternate encrypted channel. Based only on perimeter flow telemetry (destination, port, bytes sent); no endpoint process fields are used."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1048.002"
    mitre_technique_name = "Exfiltration Over Alternative Protocol: Exfiltration Over Asymmetric Encrypted Non-C2 Protocol"
    log_prerequisites = "Requires firewall, proxy or perimeter flow logs normalised to UDM NETWORK_CONNECTION with target.port, target.ip and network.sent_bytes populated. Egress from Linux server segments must pass through the logging perimeter."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Offsite backup or replication jobs over SFTP/rsync-over-SSH, approved managed file transfer to partners, Git over SSH pushing large repositories, vendor support uploads, software mirror synchronisation, and bastion or jump hosts proxying admin transfers."
    tuning_guidance = "Add approved backup, jump-host or MFT source addresses to %global_allowed_mgmt_sources. Add known-good external destination hostnames to %global_allowed_domains. Adjust the sent_bytes threshold (default 50 MB) per client baseline. Extend the port list if a client runs SSH on additional non-standard ports."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 22 or $net.target.port = 2222 or $net.target.port = 990)
    $net.network.sent_bytes > 52428800
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1048.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
