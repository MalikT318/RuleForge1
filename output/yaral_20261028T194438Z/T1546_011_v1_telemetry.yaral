/*
  MITRE Technique : T1546.011 - Application Shimming
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:14:33.197971+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_011_AppCompatFlags_Shim_Registry_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modification under the AppCompatFlags InstalledSDB or Custom keys, which is where Windows records installed application shim databases (.sdb). Adversaries register malicious shims here for persistence or privilege escalation. The rule detects the resulting registry state change, so it still fires if the shim is installed through an API, a renamed sdbinst.exe or a script, with no command line involved."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.011"
    mitre_technique_name = "Event Triggered Execution: Application Shimming"
    log_prerequisites = "Requires Windows endpoint registry telemetry normalised to REGISTRY_MODIFICATION (EDR or Sysmon registry events 12/13/14) with target.registry.registry_key populated. The registry audit policy must cover the AppCompatFlags key if native Windows Security events are used."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate application compatibility fixes deployed by IT through sdbinst or the Compatibility Administrator, software installers that register their own shims, enterprise application packaging and remediation tooling, and Windows servicing or upgrade activity."
    tuning_guidance = "Add approved deployment and packaging binaries to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. Review the writing process path in the outcome: a shim registered by a script host, a user-writable path or an Office process is high confidence. Correlate with FILE_CREATION of .sdb files outside the AppPatch directories if a follow-up rule is needed."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\software\\(wow6432node\\)?microsoft\\windows nt\\currentversion\\appcompatflags\\(installedsdb|custom)(\\|$)/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546.011")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value = array_distinct($reg.target.registry.registry_value_name)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
