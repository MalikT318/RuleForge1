/*
  MITRE Technique : T1578 - Modify Cloud Compute Infrastructure
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:49:22.848471+00:00
  Reference       : https://attack.mitre.org/techniques/T1578
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_Cloud_Instance_Created_Then_Deleted_Same_Principal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a single cloud identity creating a compute instance or VM and then deleting a compute instance or VM within ten minutes. This create-use-destroy pattern is used to run activity from short-lived infrastructure and remove evidence of it, consistent with modification of cloud compute infrastructure to evade defenses."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578"
    mitre_technique_name = "Modify Cloud Compute Infrastructure"
    log_prerequisites = "Cloud control-plane audit logs (management and administrative API activity) ingested and normalised to UDM, with metadata.product_event_type and principal.user.userid populated for compute create and delete operations."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "CI/CD pipelines and infrastructure-as-code runs that build and tear down ephemeral test environments, autoscaling and spot-fleet orchestration, developer sandboxes, chaos-engineering tools, and ephemeral build or ML training workers."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts and permitted cloud service principals to %global_allowed_cloud_principals. Add named platform engineers to %global_allowed_admin_users if they routinely run short-lived instances. Extend the product_event_type regexes if a client's audit logs use different operation names. Lengthen or shorten the 10m window to match client change cadence."

  events:
    $create.metadata.event_type = "RESOURCE_CREATION"
    $create.metadata.product_event_type = /(RunInstances|virtualMachines\/write|compute\.instances\.insert|instances\.insert|CreateInstance)/ nocase
    $create.principal.user.userid != ""
    not $create.principal.user.userid in %global_allowed_service_accounts
    not $create.principal.user.userid in %global_allowed_cloud_principals
    not $create.principal.user.userid in %global_allowed_admin_users
    $create.principal.user.userid = $user

    $delete.metadata.event_type = "RESOURCE_DELETION"
    $delete.metadata.product_event_type = /(TerminateInstances|DeleteInstance|virtualMachines\/delete|compute\.instances\.delete|instances\.delete)/ nocase
    $delete.principal.user.userid != ""
    not $delete.principal.user.userid in %global_allowed_service_accounts
    not $delete.principal.user.userid in %global_allowed_cloud_principals
    not $delete.principal.user.userid in %global_allowed_admin_users
    $delete.principal.user.userid = $user

    $create.metadata.event_timestamp.seconds <= $delete.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1578")
    $primary_entity = array_distinct($user)
    $source_ips = array_distinct($create.principal.ip)
    $created_resources = array_distinct($create.target.resource.name)
    $deleted_resources = array_distinct($delete.target.resource.name)
    $create_operations = array_distinct($create.metadata.product_event_type)
    $delete_operations = array_distinct($delete.metadata.product_event_type)
    $first_create_time = min($create.metadata.event_timestamp.seconds)
    $last_delete_time = max($delete.metadata.event_timestamp.seconds)

  condition:
    $create and $delete
}
