/*
  MITRE Technique : T1685.004 - Disable or Modify Linux Audit System Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:21:22.474637+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_004_Linux_Audit_Config_Tampering {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of Linux Audit system configuration artifacts (audit.rules, rules.d fragments, auditd.conf, audisp plugin configs, libaudit.conf) by a process that is not a package manager or an approved admin or security tool. Operates at the file-state layer, so it still fires when command-line logging is evaded, for example through direct editor writes, scripted echo/tee redirection, or a dropped binary writing the file."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.004"
    mitre_technique_name = "Disable or Modify Linux Audit System Log"
    log_prerequisites = "Requires Linux EDR file telemetry, or auditd with file watches (-w) on /etc/audit/ normalised into UDM FILE_MODIFICATION events with principal process populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package manager upgrades of the audit package; configuration management (Ansible, Puppet, Chef, Salt) pushing hardened audit rules; CIS/STIG hardening scripts; administrators legitimately tuning audit rules; augenrules regeneration of audit.rules via a shell during service restart or boot."
    tuning_guidance = "Add configuration management agents, hardening tooling and patching tools to %global_allowed_admin_tools, and EDR/security agents that manage audit rules to %global_allowed_security_tools. If augenrules regeneration via a shell alerts in a given environment, allowlist the approved parent or tool in %global_allowed_admin_tools. Package manager names are excluded inline by executable name."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/(audit\/(audit\.rules|auditd\.conf|audisp-remote\.conf|rules\.d\/[^\/]+|plugins\.d\/[^\/]+|audit-stop\.rules)|libaudit\.conf)$/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|yum|dnf|zypper|packagekitd|unattended-upgrade)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
