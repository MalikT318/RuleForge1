/*
  MITRE Technique : T1566.002 - Spearphishing Link
  Tactic(s)       : Initial Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:48:50.039859+00:00
  Reference       : https://attack.mitre.org/techniques/T1566/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1566_002_IdP_External_Login_Then_Privilege_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the post-click outcome of a spearphishing link against an identity provider: a user signs in from an external address and, within 10 minutes, the same account changes permissions (role, group or MFA/authorization settings). This pattern is typical of credential or session theft through a phishing link, followed by the attacker securing access. Detects the result of the phish, not the email or the link itself."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1566.002"
    mitre_technique_name = "Phishing: Spearphishing Link"
    log_prerequisites = "Requires identity provider sign-in logs and directory audit logs normalised to UDM USER_LOGIN and USER_CHANGE_PERMISSIONS, with principal.user.userid populated on both event types and principal.ip populated on sign-in events."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Remote administrators or helpdesk staff who sign in externally and immediately adjust permissions; new-hire onboarding or access-request automation; users enrolling or changing their own authentication methods after a legitimate remote sign-in; break-glass account use."
    tuning_guidance = "Add named administrators to %global_allowed_admin_users and automation or provisioning identities to %global_allowed_service_accounts. Add approved management egress addresses to %global_allowed_mgmt_sources. If volume is high, restrict the second event further by adding a regex on the permission-change description for sensitive roles or authentication-method changes."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.principal.user.userid = $user
    not $login.principal.ip in %rfc1918_internal
    not $login.principal.ip in %global_allowed_mgmt_sources
    not $login.principal.user.userid in %global_allowed_service_accounts
    not $login.principal.user.userid in %global_allowed_admin_users

    $change.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $change.principal.user.userid = $user
    not $change.principal.user.userid in %global_allowed_service_accounts
    not $change.principal.user.userid in %global_allowed_admin_users

    $login.metadata.event_timestamp.seconds <= $change.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1566.002")
    $primary_entity = array_distinct($user)
    $login_source_ips = array_distinct($login.principal.ip)
    $login_count = count($login.metadata.id)
    $change_count = count($change.metadata.id)
    $first_login_time = min($login.metadata.event_timestamp.seconds)
    $last_change_time = max($change.metadata.event_timestamp.seconds)

  condition:
    $login and $change
}
