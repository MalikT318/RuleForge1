/*
  MITRE Technique : T1499 - Endpoint Denial of Service
  Tactic(s)       : Impact
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:15:05.166632+00:00
  Reference       : https://attack.mitre.org/techniques/T1499
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1499_Linux_Service_Daemon_Spawns_Shell_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter launched directly by a network-facing service daemon (web server, reverse proxy, database, cache or DNS service) on a Linux host or inside a container. Such daemons almost never spawn interactive interpreters in normal operation. This lineage anomaly indicates exploitation or abuse of the service, which is a common precursor to resource exhaustion, forced crashes or service shutdown (Endpoint Denial of Service). The rule keys on parent-child process lineage, not on command-line content."
    mitre_tactic = "Impact"
    mitre_technique = "T1499"
    mitre_technique_name = "Endpoint Denial of Service"
    log_prerequisites = "Container runtime or node-level process telemetry that populates both the parent (principal.process) and child (target.process) executable paths for PROCESS_LAUNCH events, such as runtime security events, EDR on container hosts, or auditd execve events."
    platform = "Linux"
    log_source = "container"
    false_positives = "Database archive, backup or maintenance hooks (e.g. a database service running a shell-based archive command), web applications that legitimately shell out (CGI scripts, image processing, legacy PHP exec), container entrypoint or init wrappers where the service binary is PID 1 and execs a shell, and administrators debugging a service."
    tuning_guidance = "Add approved parent binaries or wrappers to %global_allowed_script_hosts. Add approved child tooling to %global_allowed_admin_tools. Add known automation accounts to %global_allowed_service_accounts. Where database archive hooks are common, scope the exclusion by parent path rather than disabling the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9.]*|tomcat[0-9]*|haproxy|envoy|mysqld|mariadbd|postgres|mongod|redis-server|memcached|named|unbound)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|ash|zsh|ksh|csh|tcsh|python[0-9.]*|perl|ruby|node)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1499")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
