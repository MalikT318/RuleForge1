/*
  MITRE Technique : T1498 - Network Denial of Service
  Tactic(s)       : Impact
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:09:03.511369+00:00
  Reference       : https://attack.mitre.org/techniques/T1498
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_IaaS_Reflection_Amplification_Inbound_Flow {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a single large inbound UDP flow record from an external source using a well-known reflection/amplification service port (DNS, NTP, SNMP, CLDAP, SSDP, memcached, chargen) toward a high ephemeral port on a cloud-hosted workload. Large unsolicited UDP responses from these ports are the network-observable signature of reflection/amplification DDoS (T1498.002) against IaaS-hosted resources."
    mitre_tactic = "Impact"
    mitre_technique = "T1498"
    mitre_technique_name = "Network Denial of Service"
    log_prerequisites = "Requires perimeter firewall or cloud network flow telemetry (e.g. VPC/VNet flow logs or cloud firewall logs) normalised to UDM NETWORK_FLOW with principal.ip, principal.port, target.ip, target.port, network.ip_protocol and network.sent_bytes populated. Flow records must be per-flow aggregates, not sampled to zero."
    platform = "IaaS"
    log_source = "firewall"
    false_positives = "Cloud-hosted recursive DNS resolvers, NTP clients or SNMP managers legitimately receiving large responses from external servers; large legitimate DNS zone/response bursts; external vendor monitoring or scanners; bulk SSDP or memcached use across peered networks."
    tuning_guidance = "Adjust the network.sent_bytes threshold (default 5,000,000 bytes per flow record) to match the flow aggregation interval of the client. Add approved external sources to %global_allowed_scanners and approved management or peering sources to %global_allowed_mgmt_sources. Remove ports from the list that the client legitimately uses for large external UDP responses (e.g. DNS on resolver hosts)."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    $net.network.ip_protocol = "UDP"
    (
      $net.principal.port = 53 or
      $net.principal.port = 123 or
      $net.principal.port = 161 or
      $net.principal.port = 389 or
      $net.principal.port = 1900 or
      $net.principal.port = 11211 or
      $net.principal.port = 19
    )
    $net.target.port >= 1024
    $net.network.sent_bytes >= 5000000
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1498")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $reflection_ports = array_distinct($net.principal.port)
    $max_flow_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
