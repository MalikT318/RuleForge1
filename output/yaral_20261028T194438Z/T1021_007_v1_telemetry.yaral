/*
  MITRE Technique : T1021.007 - Cloud Services
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:44:39.184818+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_007_Federation_Auth_Setting_Change_Office {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a tenant-level configuration change to identity federation, domain authentication or directory synchronization settings in the unified audit log. Adversaries who have compromised an administrator can change these trust settings so that forged or federated identities can sign in to cloud services and perform management actions as a valid user. This is a configuration-state signal that does not depend on any endpoint command-line telemetry."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.007"
    mitre_technique_name = "Remote Services: Cloud Services"
    log_prerequisites = "Requires Microsoft 365 unified audit logs (directory and admin activity) ingested and normalised to UDM SETTING_MODIFICATION, with the operation name populated in metadata.product_event_type."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Planned identity migrations, adding or verifying a new domain, SSO or federation provider changes, directory sync reconfiguration by identity engineering, and tenant onboarding by the managed service provider."
    tuning_guidance = "Add approved identity administrators to %global_allowed_admin_users and automation or provisioning identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Suppress during approved change windows. Narrow or extend the operation-name regex to match the audit operations your tenant emits."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(set|update|add|remove|enable|disable)[a-z\s_-]*(federation|domain authentication|dirsync|directory sync|sso|single sign)/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1021.007")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $operation = array_distinct($setting.metadata.product_event_type)
    $changed_resource = array_distinct($setting.target.resource.name)
    $source_ip = array_distinct($setting.principal.ip)

  condition:
    $setting
}
