/*
  MITRE Technique : T1003.008 - /etc/passwd and /etc/shadow
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:50:47.246544+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_008_Linux_Service_Parent_Spawns_Credential_File_Reader {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing or service-type parent process (web server, application server, database, print service) spawning a shell, script interpreter or file-reading utility that touches /etc/shadow, /etc/passwd or related credential stores, or runs unshadow. Pivots on process lineage: these services should not launch interactive shells or credential-file readers. This pattern indicates a webshell, command injection or a compromised service dumping password hashes for offline cracking."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.008"
    mitre_technique_name = "OS Credential Dumping: /etc/passwd and /etc/shadow"
    log_prerequisites = "Linux EDR or auditd execve telemetry normalised to UDM PROCESS_LAUNCH with populated parent (principal.process) and child (target.process) image paths and child command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Application health-check or deployment scripts launched by Tomcat/Java or Node services that read /etc/passwd to resolve users; database maintenance or backup jobs spawned by mysqld/postgres that call shell utilities; PHP or CGI apps that legitimately look up local accounts; CUPS filters invoking helper scripts; configuration management hooks started from a service wrapper."
    tuning_guidance = "Add legitimate parent binaries (full path) to %global_allowed_script_hosts and approved admin or deployment binaries to %global_allowed_admin_tools. If a specific application legitimately resolves local users, allowlist its parent path rather than loosening the child or command-line conditions. To reduce noise further, remove /etc/passwd from the command-line regex and keep only the shadow, gshadow and opasswd targets."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9.]*|php-cgi|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|cups-browsed|smbd|vsftpd|proftpd)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ksh|csh|tcsh|ash|python[0-9.]*|perl|ruby|php[0-9.]*|cat|head|tail|less|more|cp|dd|base64|xxd|awk|sed|grep|tar|unshadow)$/ nocase
    $proc.target.process.command_line = /(\/etc\/(shadow|gshadow|passwd|security\/opasswd)\b|\bunshadow\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1003.008")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
