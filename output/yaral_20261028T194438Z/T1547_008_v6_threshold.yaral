/*
  MITRE Technique : T1547.008 - LSASS Driver
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:34:59.281718+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_008_LSA_Package_Registry_Modification_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Multiple modifications to LSA package registry values (Authentication Packages, Security Packages, Notification Packages) under HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa on a single host within ten minutes. Registering an LSA DLL is a known LSASS driver persistence mechanism, and repeated writes indicate staged DLL registration or tampering."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.008"
    mitre_technique_name = "Boot or Logon Autostart Execution: LSASS Driver"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon registry events) with registry key, value name, and writing process populated in UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Smart card, MFA, or credential provider software installs and upgrades; password filter products (password policy enforcement); third-party authentication or SSO agents; OS servicing and feature updates; golden image build tasks."
    tuning_guidance = "Add approved installers and deployment tooling to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Lower the threshold to #reg >= 1 for high-security environments once baselined, or raise it if installers generate noise. Review $value_names and $writer_processes in the outcome to triage."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control\\Lsa(\\OSConfig)?$/ nocase
    $reg.target.registry.registry_value_name = /^(Authentication Packages|Security Packages|Notification Packages)$/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1547.008")
    $primary_entity = array_distinct($host)
    $event_count = count($reg.metadata.id)
    $value_names = array_distinct($reg.target.registry.registry_value_name)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 3
}
