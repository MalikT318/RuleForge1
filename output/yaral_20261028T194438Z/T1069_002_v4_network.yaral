/*
  MITRE Technique : T1069.002 - Domain Groups
  Tactic(s)       : Discovery
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:59:25.782028+00:00
  Reference       : https://attack.mitre.org/techniques/T1069/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1069_002_Outbound_LDAP_Directory_Query_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a host (intended for Linux server and workstation segments) opening an LDAP, LDAPS or Global Catalog connection (TCP 389, 636, 3268, 3269) to a non-internal destination, as seen at the network perimeter. Directory protocols should normally stay on internal address space. Domain group and membership enumeration (for example ldapsearch against a directory service) that crosses the perimeter suggests discovery against an externally reachable or attacker-controlled directory, or enumeration through a tunnel or proxy. This rule complements endpoint command-line detections by observing the network side. The firewall does not know the initiating process or the OS, so scope the rule to Linux source subnets or assets at deployment."
    mitre_tactic = "Discovery"
    mitre_technique = "T1069.002"
    mitre_technique_name = "Permission Groups Discovery: Domain Groups"
    log_prerequisites = "Requires firewall, proxy or perimeter NETWORK_CONNECTION logs with populated principal.hostname or principal.ip, target.ip and target.port. Egress traffic must be logged, including allowed connections."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Linux hosts legitimately joined to a cloud-hosted or managed directory service (hosted LDAPS, SSSD or realm-joined hosts using a cloud directory), SaaS identity connectors and LDAP sync agents, authentication appliances, and vendor-managed identity federation reaching external LDAP endpoints."
    tuning_guidance = "Add known-good directory provider domains to %global_allowed_domains (matched on target.hostname when the log provides it). Add approved identity sync or scanner sources to %global_allowed_mgmt_sources and %global_allowed_scanners. Add approved service account identifiers to %global_allowed_service_accounts. Scope to Linux source subnets or asset groups per client. If a client has a cloud-hosted directory, consider raising severity only for destinations outside the allowlist."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 389 or
      $net.target.port = 636 or
      $net.target.port = 3268 or
      $net.target.port = 3269
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1069.002")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
