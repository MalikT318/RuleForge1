/*
  MITRE Technique : T1560 - Archive Collected Data
  Tactic(s)       : Collection
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:56:44.020656+00:00
  Reference       : https://attack.mitre.org/techniques/T1560
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1560_Archive_Staged_By_Script_Host_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a compressed archive file (zip, 7z, rar, tar, gz, cab, bz2) in a common staging location (public, ProgramData, Windows Temp, PerfLogs, Recycle Bin, user Temp) written by a scripting host or command interpreter. Covers archive staging prior to exfiltration from the file-creation side, independent of process command-line matching, so it still fires when command-line arguments are obfuscated or the archiver is a built-in library called from script. Written for Windows because the task specification marks Windows as the mandatory target platform."
    mitre_tactic = "Collection"
    mitre_technique = "T1560"
    mitre_technique_name = "Archive Collected Data"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating principal.process.file.full_path and target.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin or deployment scripts that package logs or installers, IT support scripts collecting diagnostics, software installers or updaters launched through cmd or PowerShell that unpack or create cab files in ProgramData or Temp, scheduled log-rotation scripts, backup scripts."
    tuning_guidance = "Add approved automation or packaging tooling to %global_allowed_admin_tools, approved backup software to %global_allowed_backup_processes, trusted script hosts to %global_allowed_script_hosts, and EDR or AV agents to %global_allowed_security_tools. Narrow the staging directory regex or the archive extension list if a client has legitimate recurring workflows in a specific location. Raise severity when correlated with subsequent outbound network activity from the same host."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta)\.exe$/ nocase
    $file.target.file.full_path = /\\(users\\public|programdata|windows\\temp|perflogs|\$recycle\.bin|users\\[^\\]+\\appdata\\local\\temp)\\.*\.(zip|7z|rar|tar|gz|tgz|bz2|cab)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1560")
    $primary_entity = array_distinct($file.principal.hostname)
    $archive_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
