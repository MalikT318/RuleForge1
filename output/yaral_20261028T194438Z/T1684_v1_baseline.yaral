/*
  MITRE Technique : T1684 - Social Engineering
  Tactic(s)       : Stealth
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:29:26.503371+00:00
  Reference       : https://attack.mitre.org/techniques/T1684
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1684_Admin_Initiated_Password_Reset_Third_Party {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a password change or reset on one identity performed by a different, non-allowlisted identity. This is the typical outcome of a help desk social engineering attack, where an adversary impersonates a user or executive and persuades an operator to reset credentials. The rule fires on the user-authorised action itself, so it does not depend on the lure channel (voice, email, chat)."
    mitre_tactic = "Stealth"
    mitre_technique = "T1684"
    mitre_technique_name = "Social Engineering"
    log_prerequisites = "Identity provider directory/audit logs normalised to UDM USER_CHANGE_PASSWORD with both principal.user.userid (actor) and target.user.userid (subject) populated."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Routine help desk password resets, onboarding and offboarding workflows, IAM automation not yet allowlisted, scheduled credential rotation performed by administrators, self-service reset flows that log a system actor."
    tuning_guidance = "Add approved help desk and IAM administrators to %global_allowed_admin_users and automation or provisioning identities to %global_allowed_service_accounts. In high-volume environments, pair this rule with MFA-reset or new-device-login detections for the same target user and raise severity on a match."

  events:
    $auth.metadata.event_type = "USER_CHANGE_PASSWORD"
    $auth.principal.user.userid != ""
    $auth.target.user.userid != ""
    $auth.principal.user.userid != $auth.target.user.userid
    not $auth.principal.user.userid in %global_allowed_admin_users
    not $auth.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1684")
    $primary_entity = array_distinct($auth.target.user.userid)
    $actor_user = array_distinct($auth.principal.user.userid)
    $actor_ip = array_distinct($auth.principal.ip)

  condition:
    $auth
}
