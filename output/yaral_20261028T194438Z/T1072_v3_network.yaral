/*
  MITRE Technique : T1072 - Software Deployment Tools
  Tactic(s)       : Execution, Lateral Movement
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:15:02.924647+00:00
  Reference       : https://attack.mitre.org/techniques/T1072
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1072_External_Source_To_Deployment_Mgmt_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a perimeter-observed connection from a non-internal source address to an internal host on a port used by centralized software deployment and endpoint management services (client notification, distribution/update point HTTP/HTTPS, remote control). Management planes should only be reached from internal or explicitly approved sources, so external reachability suggests exposure or an adversary attempting to abuse the deployment infrastructure for remote execution or lateral movement."
    mitre_tactic = "Execution, Lateral Movement"
    mitre_technique = "T1072"
    mitre_technique_name = "Software Deployment Tools"
    log_prerequisites = "Requires firewall or network perimeter connection logs normalised to UDM NETWORK_CONNECTION with populated principal.ip, target.ip and target.port, with inbound traffic logged at the perimeter."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Internet-based client management gateways or cloud management proxies deliberately published to the internet, VPN or NAT egress addresses appearing as non-internal sources, authorised vulnerability scanners, third-party managed-service providers administering the deployment platform, and port reuse by unrelated applications on the same port numbers."
    tuning_guidance = "Add approved external management or VPN egress addresses to %global_allowed_mgmt_sources and scanner addresses to %global_allowed_scanners. If the client publishes an internet-facing management gateway, scope the exception to that destination via a customer-specific exclusion. Adjust the port set to the deployment tooling in use at the client."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 8530 or
      $net.target.port = 8531 or
      $net.target.port = 10123 or
      $net.target.port = 2701 or
      $net.target.port = 2702
    )
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1072")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
