/*
  MITRE Technique : T1553.004 - Install Root Certificate
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:04:53.849816+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_004_Unexpected_Parent_Spawns_Root_Cert_Install {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process that should not manage certificates (Office application, web server, print spooler, database service or script host) spawning a certificate tool or PowerShell command that installs a certificate into a trusted root store. Matches the combination of the parent lineage, the certificate-import action and the Root store target rather than any specific payload."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.004"
    mitre_technique_name = "Subvert Trust Controls: Install Root Certificate"
    log_prerequisites = "Requires Windows EDR or Sysmon process-creation telemetry with parent process path and full child command line (or Windows Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web or application servers that run certificate-provisioning scripts at deploy time, database installers or agents that import a private CA, Office add-ins or macros used by IT for PKI enrolment, and software deployment tooling launched from a script host."
    tuning_guidance = "Add approved deployment and PKI tooling parent paths to %global_allowed_admin_tools and sanctioned automation hosts or parents to %global_allowed_script_hosts. If a specific web application legitimately imports certificates, allowlist its parent process path rather than loosening the child command-line logic."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Unexpected parent: Office, web server, print spooler, database service, script host
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|onenote|w3wp|httpd|nginx|php-cgi|tomcat[0-9]*|spoolsv|sqlservr|mshta|wscript|cscript)\.exe$/ nocase

    (
      // certutil adding to a Root / AuthRoot store
      (
        $proc.target.process.file.full_path = /\\certutil\.exe$/ nocase and
        $proc.target.process.command_line = /-addstore/ nocase and
        $proc.target.process.command_line = /\b(root|authroot)\b/ nocase
      )
      or
      // PowerShell importing a certificate into a Root store
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase and
        $proc.target.process.command_line = /(import-certificate|import-pfxcertificate|x509store|certutil)/ nocase and
        $proc.target.process.command_line = /\broot\b/ nocase
      )
      or
      // certmgr adding to a Root store
      (
        $proc.target.process.file.full_path = /\\certmgr\.exe$/ nocase and
        $proc.target.process.command_line = /\/add/ nocase and
        $proc.target.process.command_line = /\broot\b/ nocase
      )
    )

    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1553.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
