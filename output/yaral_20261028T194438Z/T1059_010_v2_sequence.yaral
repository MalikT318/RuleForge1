/*
  MITRE Technique : T1059.010 - AutoHotKey & AutoIT
  Tactic(s)       : Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:20:49.352987+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_010_AutoIt_AHK_Script_Drop_Then_Execute {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An AutoIt (.au3) or AutoHotkey (.ahk) script is written to a user-writable directory and a process is then launched on the same host with that script path on its command line within five minutes. This catches the drop-then-run pattern used by phishing payloads and loaders such as DarkGate, and does not depend on the interpreter filename."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.010"
    mitre_technique_name = "Command and Scripting Interpreter: AutoHotKey & AutoIT"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (FILE_CREATION with target.file.full_path populated) and process-launch telemetry with command lines (PROCESS_LAUNCH)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Power users and administrators who keep AutoHotkey or AutoIt automation scripts in Downloads, Desktop or AppData. Software packagers and IT deployment scripts that stage .au3 or .ahk files in temp folders. Gaming and productivity macro users. Installers that extract and run AutoIt-based setup helpers."
    tuning_guidance = "Add approved dropper or parent process paths to %global_allowed_script_hosts and approved deployment or automation tooling to %global_allowed_admin_tools. Exclude hosts used by IT automation teams through %global_allowed_script_hosts. If noise remains, raise severity only when the dropper is a browser, mail client, Office application or archiver."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(appdata|temp|downloads|desktop|programdata|users\\public)\\.*\.(au3|ahk)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /\\(appdata|temp|downloads|desktop|programdata|users\\public)\\.*\.(au3|ahk)\b/ nocase
    not $proc.target.process.file.full_path = /\\(notepad|notepad\+\+|code|explorer|wordpad)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1059.010")
    $primary_entity = array_distinct($hostname)
    $dropped_scripts = array_distinct($file.target.file.full_path)
    $dropper_processes = array_distinct($file.principal.process.file.full_path)
    $launched_processes = array_distinct($proc.target.process.file.full_path)
    $launch_command_lines = array_distinct($proc.target.process.command_line)
    $affected_users = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
