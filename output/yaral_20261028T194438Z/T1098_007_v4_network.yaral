/*
  MITRE Technique : T1098.007 - Additional Local or Domain Groups
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:51:09.562975+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_007_Net_Binary_NonInternal_Directory_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "The Windows net/net1 group-management binaries open a directory or SAM-related connection (SMB, RPC endpoint mapper, LDAP, LDAPS, Global Catalog) to a destination outside internal address space. Local and domain group changes made with 'net group' or 'net localgroup /domain' are carried to the domain controller over these channels. Traffic leaving the internal address space from these binaries is anomalous and may indicate group membership changes against an externally routed or cloud-hosted domain controller, or abuse through a tunnel or relay. This is network-side coverage that complements endpoint command-line rules. It does not inspect command lines."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.007"
    mitre_technique_name = "Account Manipulation: Additional Local or Domain Groups"
    log_prerequisites = "Requires endpoint network telemetry (EDR or Sysmon Event ID 3 equivalent) that records the initiating process path and destination IP and port, normalised to NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Hybrid or cloud-hosted domain controllers reached over routable non-RFC1918 addresses; cross-forest administration over NAT; admins managing groups through a VPN or jump-host with public addressing; IT automation using net.exe against cloud-hosted file servers."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Add legitimate cloud-hosted domain controller addresses to %global_allowed_mgmt_sources. If the tenant uses public IP space internally, populate %global_allowed_mgmt_sources accordingly. Consider raising severity when the destination port is 389, 636, 3268 or 3269 and the user is not an administrator."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\net1?\.exe$/ nocase
    (
      $net.target.port = 445 or
      $net.target.port = 135 or
      $net.target.port = 389 or
      $net.target.port = 636 or
      $net.target.port = 3268 or
      $net.target.port = 3269
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.principal.user.userid in %global_allowed_admin_users
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1098.007")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
