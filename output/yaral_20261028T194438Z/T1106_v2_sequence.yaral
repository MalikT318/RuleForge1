/*
  MITRE Technique : T1106 - Native API
  Tactic(s)       : Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:01:20.270103+00:00
  Reference       : https://attack.mitre.org/techniques/T1106
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1106_Linux_Dropped_Binary_Staging_Dir_Executed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a file created in a world-writable Linux staging directory (/tmp, /var/tmp, /dev/shm) that is then executed from the same path on the same host within 10 minutes. This drop-then-execute pattern is how implants, loaders and downloaded payloads reach the kernel exec and fork APIs. The rule correlates file creation with process execution on the same path, so it does not depend on command-line content."
    mitre_tactic = "Execution"
    mitre_technique = "T1106"
    mitre_technique_name = "Native API"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that produces both FILE_CREATION events (with target.file.full_path) and PROCESS_LAUNCH events (with target.process.file.full_path), normalised to UDM."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software installers and package managers that unpack helper binaries to /tmp, CI/CD build agents, compilers and test harnesses producing temporary executables, configuration management agents (Ansible modules), self-extracting installers, and developer workstations."
    tuning_guidance = "Add approved deployment and configuration tooling to %global_allowed_admin_tools, approved automation hosts or parents to %global_allowed_script_hosts, and build or service accounts to %global_allowed_service_accounts. Extend the package manager regex if the environment uses other installers. On build servers, scope the rule out by host using a host-based exclusion."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/[^\/]+/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|yum|dnf|zypper|snapd|pacman|unattended-upgrade)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $path

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/[^\/]+/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname
    $proc.target.process.file.full_path = $path

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1106")
    $primary_entity = array_distinct($hostname)
    $executed_path = array_distinct($path)
    $dropper_process = array_distinct($file.principal.process.file.full_path)
    $launching_parent = array_distinct($proc.principal.process.file.full_path)
    $executing_user = array_distinct($proc.principal.user.userid)
    $exec_count = count($proc.metadata.id)

  condition:
    $file and $proc
}
