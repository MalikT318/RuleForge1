/*
  MITRE Technique : T1566.004 - Spearphishing Voice
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:51:53.773286+00:00
  Reference       : https://attack.mitre.org/techniques/T1566/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1566_004_Vishing_MFA_Method_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a change to a user's multi-factor authentication or security-info configuration (method registered, added, updated, reset or deleted) in tenant audit logs. Voice phishing and help-desk social engineering commonly end with the victim or a deceived help-desk agent enrolling an attacker-controlled MFA method or resetting existing MFA. The rule detects this resulting configuration state change instead of command-line activity, which an attacker cannot avoid once the call succeeds."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1566.004"
    mitre_technique_name = "Phishing: Spearphishing Voice"
    log_prerequisites = "Requires tenant unified audit logs and directory audit logs, including authentication-method and security-info operations, ingested and normalised to SETTING_MODIFICATION with metadata.product_event_type populated."
    platform = "Identity Provider"
    log_source = "m365"
    false_positives = "New-hire MFA enrolment, users replacing a lost or upgraded phone, legitimate help-desk MFA resets, conditional-access registration campaigns, and identity lifecycle automation."
    tuning_guidance = "Add help-desk and identity administrator accounts to %global_allowed_admin_users, and provisioning or lifecycle automation accounts to %global_allowed_service_accounts. Add approved identity service principals to %global_allowed_cloud_principals. For stricter alerting, raise severity when the change follows a recent password reset or a burst of MFA prompts for the same user."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(register|add|update|change|reset|delete|remov|disable).*(security\s?info|authentication\s?method|strong\s?authentication|mfa|multi.?factor|phone\s?method|mobile\s?phone)/ nocase
    $setting.target.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1566.004")
    $primary_entity = array_distinct(strings.coalesce($setting.target.user.userid, $setting.principal.user.userid))
    $actor = array_distinct($setting.principal.user.userid)
    $operation = array_distinct($setting.metadata.product_event_type)
    $source_ip = array_distinct($setting.principal.ip)

  condition:
    $setting
}
