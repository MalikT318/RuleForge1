/*
  MITRE Technique : T1564.008 - Email Hiding Rules
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:27:00.398611+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_008_M365_Inbox_Rule_Hides_Mail {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of a mailbox inbox rule in the Microsoft 365 unified audit log whose actions hide inbound mail: delete, move to a low-visibility folder (RSS, Junk, Archive, Deleted Items), or mark as read. Adversaries use such rules after account compromise to hide security alerts, replies to internal phishing, and C2 mail from the mailbox owner."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.008"
    mitre_technique_name = "Hide Artifacts: Email Hiding Rules"
    log_prerequisites = "Requires Microsoft 365 Exchange mailbox auditing (New-InboxRule, Set-InboxRule, UpdateInboxRules) ingested through the unified audit log. The rule action parameters must be parsed into security_result.description."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Users building legitimate housekeeping rules (newsletters to a folder, auto-archive, mark-as-read for notification mail), shared-mailbox administrators, helpdesk staff migrating rules, and mail-flow automation run by approved admins."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and automation or migration accounts to %global_allowed_service_accounts. If rule parameters land in a different field in your parser mapping, move the hiding-action regex to that field. Review the $rule_details and $source_ips outcome values during triage. Rules that delete mail or move it to RSS Feeds or Conversation History, or that filter on security keywords such as phish, malware, or suspicious, deserve priority."

  events:
    $set.metadata.event_type = "SETTING_MODIFICATION"
    $set.metadata.product_event_type = /^(New-InboxRule|Set-InboxRule|UpdateInboxRules)$/ nocase
    $set.security_result.description = /(DeleteMessage|MoveToFolder|MarkAsRead|SoftDeleteMessage|PermanentDelete|Deleted Items|RSS (Feeds|Subscriptions)|Conversation History|Junk|Archive)/ nocase
    $set.principal.user.userid != ""
    not $set.principal.user.userid in %global_allowed_admin_users
    not $set.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1564.008")
    $primary_entity = array_distinct($set.principal.user.userid)
    $operation = array_distinct($set.metadata.product_event_type)
    $rule_details = array_distinct($set.security_result.description)
    $source_ips = array_distinct($set.principal.ip)

  condition:
    $set
}
