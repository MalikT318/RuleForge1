/*
  MITRE Technique : T1078 - Valid Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : ESXi
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:28:16.037053+00:00
  Reference       : https://attack.mitre.org/techniques/T1078
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_ESXi_Mgmt_Access_From_Unapproved_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network connections to ESXi host management services (the vSphere host agent/authentication port 902, or SSH to a host named like a hypervisor) from a source that is not an approved management source or scanner. ESXi accounts are frequently abused with stolen valid credentials, and the network-visible sign is a management session originating outside the expected admin or jump-host space."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078"
    mitre_technique_name = "Valid Accounts"
    log_prerequisites = "Requires perimeter or internal segmentation firewall logs normalised to UDM NETWORK_CONNECTION or NETWORK_FLOW with source IP, destination IP and destination port populated. Firewall policy must log allowed traffic to the hypervisor management VLAN."
    platform = "ESXi"
    log_source = "firewall"
    false_positives = "vCenter or backup servers not yet listed as approved management sources, new admin jump hosts or VPN pools, vulnerability scanners and monitoring probes, DR or migration tooling connecting to hosts, and disaster-recovery site changes."
    tuning_guidance = "Add jump hosts, vCenter, backup and VPN admin pool addresses to %global_allowed_mgmt_sources and authorised scanner sources to %global_allowed_scanners. The SSH branch relies on hypervisor-style hostnames in firewall logs, so adjust or drop it if the client's naming differs. Port 902 is ESXi-specific and needs no hostname match."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 902 or
      (
        $net.target.port = 22 and
        $net.target.hostname = /(esx|vmhost|hypervisor)/ nocase
      )
    )
    $net.principal.ip != ""
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1078")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
