/*
  MITRE Technique : T1136 - Create Account
  Tactic(s)       : Persistence
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:05:32.766096+00:00
  Reference       : https://attack.mitre.org/techniques/T1136
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_ESXi_Local_Account_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a new local account on an ESXi host (host-level audit event for account creation, e.g. via esxcli, the host client, or the hostd API). Rogue local accounts on ESXi give attackers persistent credentialed access to the hypervisor that survives the removal of remote access tooling and is often missed by endpoint-centric monitoring. NOTE: the mandated log_source is cloud_audit; ESXi host audit events must be normalised into UDM USER_CREATION through that ingestion path or the rule will not see them."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136"
    mitre_technique_name = "Create Account"
    log_prerequisites = "ESXi host audit events (hostd account-created audit messages) forwarded and parsed into UDM USER_CREATION with target.user.userid, target.hostname and, where available, principal.user.userid and metadata.product_event_type. Verify the ingestion label cloud_audit actually carries ESXi host audit events for each client before relying on this rule."
    platform = "ESXi"
    log_source = "cloud_audit"
    false_positives = "Planned break-glass or local service account creation by hypervisor admins; automated host provisioning and lifecycle tooling (kickstart, host profiles, configuration management) creating local accounts; backup or monitoring integrations that provision a dedicated local account on new hosts."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and provisioning/automation identities to %global_allowed_service_accounts. If the parser does not populate metadata.product_event_type, relax or remove that regex and instead scope the rule to ESXi hosts by hostname. Review a 14-day baseline of new-host build activity before enabling auto-response."

  events:
    $acct.metadata.event_type = "USER_CREATION"
    $acct.metadata.product_event_type = /esx\.audit\.account\.created|account.*(created|added)/ nocase
    $acct.target.user.userid != ""
    not $acct.principal.user.userid in %global_allowed_admin_users
    not $acct.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1136")
    $primary_entity = array_distinct($acct.target.hostname)
    $created_account = array_distinct($acct.target.user.userid)
    $creating_user = array_distinct($acct.principal.user.userid)
    $source_ips = array_distinct($acct.principal.ip)

  condition:
    $acct
}
