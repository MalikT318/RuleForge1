/*
  MITRE Technique : T1518.002 - Backup Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:24:00.351933+00:00
  Reference       : https://attack.mitre.org/techniques/T1518/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_002_Linux_Backup_Software_Discovery_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated enumeration of backup software on a single Linux host within ten minutes. Each discovery command (process listing, service query, package query, file search, cron listing) is benign alone. Five or more that reference backup products or backup keywords in a short window suggest an adversary scoping backups before inhibiting recovery or encrypting data."
    mitre_tactic = "Discovery"
    mitre_technique = "T1518.002"
    mitre_technique_name = "Software Discovery: Backup Software Discovery"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records (SYSCALL/EXECVE) normalised to PROCESS_LAUNCH with full command-line arguments."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup administrators checking agent or job status, configuration management and inventory scripts, monitoring agents polling backup service health, package audits during software upgrades, and troubleshooting sessions run by sysadmins."
    tuning_guidance = "Add backup agents and orchestration parents to %global_allowed_backup_processes, inventory and patching tooling to %global_allowed_admin_tools, and monitoring or automation accounts to %global_allowed_service_accounts. Raise the #proc threshold on hosts that run backup servers. Lower it for high-value servers that should never be queried for backup software."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(ps|pgrep|pidof|systemctl|service|chkconfig|which|whereis|locate|find|ls|grep|egrep|dpkg|dpkg-query|rpm|apt|apt-cache|yum|dnf|zypper|snap|crontab)$/ nocase
    $proc.target.process.command_line = /(veeam|bacula|bareos|amanda|rsnapshot|restic|borg|duplicity|timeshift|acronis|commvault|netbackup|networker|avamar|rubrik|cohesity|urbackup|backintime|dsmc|backup)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($proc.target.process.command_line = /(?i)(veeam|bacula|bareos|amanda|rsnapshot|restic|borg|duplicity|timeshift|acronis|commvault|netbackup|networker|avamar|rubrik|cohesity|urbackup|backintime|dsmc)/, 65, 45))
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1518.002")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 5
}
