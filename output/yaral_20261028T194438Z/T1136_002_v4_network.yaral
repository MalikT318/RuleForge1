/*
  MITRE Technique : T1136.002 - Domain Account
  Tactic(s)       : Persistence
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:10:02.794821+00:00
  Reference       : https://attack.mitre.org/techniques/T1136/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_002_External_Source_To_AD_Management_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a connection from a non-internal source address to an internal host on Active Directory management-plane ports: LDAP, LDAPS, Global Catalog, SMB/SAMR, RPC endpoint mapper, kpasswd and AD Web Services. These are the channels used to create domain accounts remotely, for example net user /add /domain, New-ADUser or SAMR/LDAP account creation. Account creation itself is not visible in firewall telemetry. This rule flags the network precondition: directory services reachable from outside the trusted address space. It should be paired with endpoint or Windows Security coverage (event 4720 or process telemetry) for confirmation."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136.002"
    mitre_technique_name = "Create Account: Domain Account"
    log_prerequisites = "Requires firewall or perimeter NETWORK_CONNECTION logs with populated principal.ip, target.ip and target.port. The %rfc1918_internal reference list must be populated for the tenant."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Internet-exposed domain controllers or hybrid identity sync, VPN or remote-access address pools that are not in the internal list, partner or cloud-hosted AD trusts, vulnerability scanners, managed-service jump hosts, and internet background scanning if the perimeter permits the traffic."
    tuning_guidance = "Add approved remote administration and VPN egress source addresses to %global_allowed_mgmt_sources. Add authorised scanners to %global_allowed_scanners. Confirm that %rfc1918_internal covers all of the client's internal and VPN pool space. If directory ports should never be reachable externally, raise severity and route to a block-and-investigate playbook."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 389 or
      $net.target.port = 636 or
      $net.target.port = 3268 or
      $net.target.port = 3269 or
      $net.target.port = 445 or
      $net.target.port = 135 or
      $net.target.port = 464 or
      $net.target.port = 9389
    )
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1136.002")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
