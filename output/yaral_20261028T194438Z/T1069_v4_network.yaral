/*
  MITRE Technique : T1069 - Permission Groups Discovery
  Tactic(s)       : Discovery
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:56:11.821463+00:00
  Reference       : https://attack.mitre.org/techniques/T1069
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1069_Linux_Group_Enumeration_API_Via_CLI_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux host using a non-browser CLI or interpreter client (curl, wget, python, perl, ruby, node, php) to request group, role or membership enumeration endpoints on an external identity or cloud API. It matches URL path and query patterns such as memberOf, transitiveMemberOf, directoryRoles, IdP group and role listings, and IAM ListGroups or GetAccountAuthorizationDetails actions. This is the network-side view of permission group discovery and complements endpoint command-line detections."
    mitre_tactic = "Discovery"
    mitre_technique = "T1069"
    mitre_technique_name = "Permission Groups Discovery"
    log_prerequisites = "Requires Linux endpoint telemetry or a forward proxy with TLS inspection that populates NETWORK_HTTP with target.url and the originating process path. Without URL visibility for HTTPS traffic this rule cannot evaluate."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Identity governance and access review scripts, IAM audit automation, configuration management or provisioning jobs (SCIM sync, Terraform helpers), DevOps staff querying cloud IAM from a jump host, and CI runners that validate group membership."
    tuning_guidance = "Add approved automation binaries to %global_allowed_admin_tools. Add trusted vendor or IdP API domains to %global_allowed_domains. Add approved script-running hosts to %global_allowed_script_hosts. Narrow or extend the client process regex to match the client estate."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.principal.process.file.full_path = /\/(curl|wget|python[0-9.]*|perl|ruby|node|php)$/ nocase
    $net.target.url = /(\/(memberOf|transitiveMemberOf|directoryRoles|roleAssignments)(\/|\?|$)|\/v1\.0\/(groups|directoryRoles)|\/api\/v1\/(groups|users\/[^\/]+\/(groups|roles))|Action=(ListGroups|ListGroupsForUser|ListAttachedUserPolicies|ListRolePolicies|GetAccountAuthorizationDetails))/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1069")
    $primary_entity = array_distinct($net.principal.hostname)
    $client_process = array_distinct($net.principal.process.file.full_path)
    $requested_url = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
