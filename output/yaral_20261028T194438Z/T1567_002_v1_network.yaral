/*
  MITRE Technique : T1567.002 - Exfiltration to Cloud Storage
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:57:05.175245+00:00
  Reference       : https://attack.mitre.org/techniques/T1567/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_002_Linux_Large_Upload_To_External_Storage_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a single large outbound HTTP PUT or POST upload from an internal source to an external host whose name looks like an object or file storage service. The upload size is the main signal, so the rule does not depend on a specific provider or domain and still fires if the attacker changes cloud storage vendor. It is a network-side view of exfiltration to cloud storage, independent of endpoint process telemetry."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567.002"
    mitre_technique_name = "Exfiltration Over Web Service: Exfiltration to Cloud Storage"
    log_prerequisites = "Requires firewall or forward-proxy logs with HTTP method, destination hostname, and bytes sent (network.sent_bytes). TLS inspection or SNI logging is needed to populate target.hostname for HTTPS traffic. Source IPs of Linux servers should be identifiable in the client's asset inventory for triage."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Approved offsite backup or archive jobs to object storage, CI/CD artifact publishing, container image and package pushes, log shipping to cloud buckets, data-science or ETL pipelines uploading datasets, and admins manually transferring large files to sanctioned storage."
    tuning_guidance = "Add sanctioned storage and vendor domains to %global_allowed_domains. Add automation and backup accounts to %global_allowed_service_accounts. Adjust the 50 MB sent_bytes threshold (52428800) per client baseline. Tighten the hostname keyword regex if a client's naming conventions cause noise."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(PUT|POST)$/ nocase
    $net.network.sent_bytes > 52428800
    $net.target.hostname = /(^|[.\-])(s3|blob|bucket|buckets|storage|objectstorage|drive|files|fileshare|upload|uploads|share|cloudfiles|docs)([.\-]|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1567.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $max_bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
