/*
  MITRE Technique : T1564.007 - VBA Stomping
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:24:40.516577+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_007_Linux_Office_Suite_Spawns_Shell_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux office suite process (LibreOffice/OpenOffice, WPS, OnlyOffice) spawning a shell or script interpreter. This is a process-lineage detection for the execution result of a macro-laden document, including documents using VBA stomping to hide macro source. Office suites rarely launch shells during normal document handling. Note that LibreOffice executes VBA from source rather than p-code, so this rule provides lineage-based coverage of macro-driven execution on Linux hosts instead of detecting the stomping itself."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.007"
    mitre_technique_name = "Hide Artifacts: VBA Stomping"
    log_prerequisites = "Requires Linux EDR or auditd (execve) telemetry normalised to UDM PROCESS_LAUNCH with populated parent (principal.process.file.full_path) and child (target.process.file.full_path) image paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Office-suite extensions or Java helper scripts launched via sh by the suite itself, document-conversion or headless rendering pipelines on servers, desktop integration helpers (xdg-open, printing, mail-merge wrappers), and legitimate macro-based automation in business documents."
    tuning_guidance = "Add approved document-conversion hosts or parent paths to %global_allowed_script_hosts. Add approved automation tooling to %global_allowed_admin_tools. Raise severity on workstations where macros are blocked by policy. Review the child process and user outcome fields before escalating."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(soffice(\.bin)?|oosplash|libreoffice[0-9.]*|lowriter|localc|loimpress|wps|wpp|DesktopEditors)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ksh|csh|tcsh|fish|python[0-9.]*|perl|ruby|php|node|lua)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1564.007")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
