/*
  MITRE Technique : T1187 - Forced Authentication
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:33:19.975545+00:00
  Reference       : https://attack.mitre.org/techniques/T1187
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1187_Outbound_SMB_To_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows client making an outbound SMB/NetBIOS session (TCP 445/139) to a non-internal destination as seen at the network perimeter. Windows automatically sends NTLM credential material when it connects to an SMB share, so a connection to an external host is the typical network footprint of forced authentication (UNC links in documents, shortcut/icon files, or template injection). Legitimate SMB should not leave the corporate boundary."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1187"
    mitre_technique_name = "Forced Authentication"
    log_prerequisites = "Requires firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with populated principal.ip, target.ip and target.port, with egress traffic on TCP 445/139 logged (allowed and blocked). Attempts blocked at the firewall are still valuable if the platform logs them as connection events."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Approved SMB access to cloud file services reached over the internet (for example a cloud-hosted file share or Azure Files over 445), site-to-site or VPN traffic where the remote subnet is not in the internal address list, partner or MSP file exchange, and vulnerability scanners probing SMB."
    tuning_guidance = "Populate %rfc1918_internal with all internal and routed private ranges. Add known-good SMB destination names to %global_allowed_domains, and authorised scanner or management source addresses to %global_allowed_scanners. Consider raising severity if the firewall log shows the connection was allowed and not just blocked."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 445 or $net.target.port = 139)
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1187")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
