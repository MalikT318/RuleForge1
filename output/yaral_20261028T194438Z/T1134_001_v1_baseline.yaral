/*
  MITRE Technique : T1134.001 - Token Impersonation/Theft
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:52:52.970992+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_001_Token_Theft_Privileged_Process_Handle {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process running from a user-writable location, or a scripting/LOLBin interpreter, opening a handle to a core SYSTEM-level Windows process (winlogon, lsass, services, wininit, spoolsv). Opening such a process is the prerequisite step for token theft: OpenProcessToken, then DuplicateTokenEx, then ImpersonateLoggedOnUser or SetThreadToken. The rule keys on the handle-open behaviour and the source process characteristics, not on any tool name, so renamed or recompiled binaries still match."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.001"
    mitre_technique_name = "Access Token Manipulation: Token Impersonation/Theft"
    log_prerequisites = "Requires Windows endpoint process-access telemetry that normalises to PROCESS_OPEN with principal and target process paths populated (EDR process-access events or Sysmon Event ID 10)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "EDR/AV agents and backup software that are not yet in the allowlists, IT management and RMM agents, software installers or updaters running from ProgramData or Temp, crash-dump and diagnostic utilities, and developer or debugging tools opening system processes."
    tuning_guidance = "Add EDR/AV agent paths to %global_allowed_security_tools, RMM and deployment tools to %global_allowed_admin_tools, and imaging or backup software to %global_allowed_backup_processes. Tuning on the source process path is preferred over host-level exclusions. If lsass noise is high because of credential-access coverage elsewhere, remove lsass from the target regex and keep winlogon, services and wininit."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\(winlogon|lsass|services|wininit|spoolsv)\.exe$/ nocase
    (
      $open.principal.process.file.full_path = /(\\users\\[^\\]+\\|\\programdata\\|\\windows\\temp\\|\\appdata\\|\\temp\\|\\public\\)/ nocase or
      $open.principal.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32|msbuild|installutil)\.exe$/ nocase
    )
    not $open.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|csrss|svchost|smss|wininit|winlogon|lsass|services|taskmgr)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1134.001")
    $primary_entity = array_distinct($open.principal.hostname)
    $source_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $source_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
