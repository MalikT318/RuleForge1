/*
  MITRE Technique : T1564.011 - Ignore Process Interrupts
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:29:25.712131+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_011_Logoff_Termination_Behavior_Registry_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects registry modifications to the Windows settings that control how running processes and services are terminated at logoff and shutdown (AutoEndTasks, WaitToKillAppTimeout, HungAppTimeout, WaitToKillServiceTimeout). Changing them lets a process outlive the session or resist termination, which approximates ignoring process interrupts (T1564.011) at the configuration-state layer rather than the command line. Treat this as a supporting, low-fidelity signal. Windows has no direct registry equivalent of nohup, so the rule cannot see PowerShell -ErrorAction SilentlyContinue."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.011"
    mitre_technique_name = "Hide Artifacts: Ignore Process Interrupts"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 13) that populates target.registry.registry_key, registry_value_name and the modifying principal process."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy and logon-script based desktop tuning, RDS/VDI/Citrix session-timeout optimisation, server hardening or performance baselines, shutdown-delay tweaks by admins, and OEM or system-tuning utilities."
    tuning_guidance = "Add approved deployment and tuning tools to %global_allowed_admin_tools, GPO or automation accounts to %global_allowed_service_accounts, and EDR agents to %global_allowed_security_tools. Review the modifying process and user first: a user-writable process path or a non-admin user changing these values is the high-value case. If your fleet is noisy, narrow it to the user-hive Control Panel\\Desktop key."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      (
        $reg.target.registry.registry_key = /\\Control Panel\\Desktop$/ nocase and
        $reg.target.registry.registry_value_name = /^(AutoEndTasks|WaitToKillAppTimeout|HungAppTimeout)$/ nocase
      ) or
      (
        $reg.target.registry.registry_key = /\\CurrentControlSet\\Control$/ nocase and
        $reg.target.registry.registry_value_name = /^WaitToKillServiceTimeout$/ nocase
      )
    )
    not $reg.principal.process.file.full_path = /\\svchost\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1564.011")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_value = array_distinct($reg.target.registry.registry_value_name)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
