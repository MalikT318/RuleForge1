/*
  MITRE Technique : T1565.001 - Stored Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:39:54.737554+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_001_DB_CLI_Destructive_Data_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a command-line database client (SQL Server, MySQL, PostgreSQL or SQLite clients) launched with an inline destructive or modifying SQL statement (DELETE FROM, TRUNCATE TABLE, DROP TABLE/DATABASE, UPDATE ... SET). Adversaries use these clients to alter or destroy data at rest to affect business processes or hide activity."
    mitre_tactic = "Impact"
    mitre_technique = "T1565.001"
    mitre_technique_name = "Data Manipulation: Stored Data Manipulation"
    log_prerequisites = "Requires EDR or Sysmon process telemetry (or Windows Event 4688 with command-line auditing enabled) populating target.process.command_line."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "DBAs running maintenance or purge scripts, application installers and upgrade routines, ETL and data-cleanup jobs, developers on test systems, patching and deployment tooling."
    tuning_guidance = "Add approved parent tooling to %global_allowed_admin_tools or %global_allowed_script_hosts. Add DBA and automation accounts to %global_allowed_admin_users or %global_allowed_service_accounts. This rule covers Windows only; Linux, macOS and cloud variants need separate rules with their own log_source."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(sqlcmd|osql|isql|mysql|psql|sqlite3)\.exe$/ nocase
    (
      $proc.target.process.command_line = /\b(truncate\s+table|drop\s+(table|database)|delete\s+from)\b/ nocase or
      $proc.target.process.command_line = /\bupdate\s+\S+\s+set\b/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1565.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $users = array_distinct($proc.principal.user.userid)
    $db_client = array_distinct($proc.target.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
