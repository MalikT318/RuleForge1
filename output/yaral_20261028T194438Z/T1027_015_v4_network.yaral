/*
  MITRE Technique : T1027.015 - Compression
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:02:43.300690+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_015_Linux_Archive_Download_From_Bare_IP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux command-line downloader or scripting runtime fetching a compressed archive (zip, 7z, rar, gzip, tar, bzip2, xz) over HTTP(S) from a bare external IP address rather than a named host. This is a network-side view of staged, compressed payload delivery, and it complements endpoint command-line detections for compression-based obfuscation."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.015"
    mitre_technique_name = "Obfuscated Files or Information: Compression"
    log_prerequisites = "Requires Linux endpoint telemetry that records outbound HTTP with the full URL (target.url) and the initiating process path, normalised to NETWORK_HTTP. Network-only sources without process attribution will not match."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators or provisioning scripts pulling tarballs from internal-style mirrors or lab hosts addressed by IP, CI/CD build agents, software vendors that distribute archives from IP-addressed update servers, and configuration management bootstrap scripts."
    tuning_guidance = "Add approved deployment or provisioning binaries to %global_allowed_admin_tools, known-good external hosts to %global_allowed_domains, and automation accounts to %global_allowed_service_accounts. If the false-positive rate is still high, require a writable staging directory in the process path or widen coverage by removing the bare-IP URL condition."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.principal.process.file.full_path = /\/(curl|wget|python[0-9.]*|perl|ruby|php)$/ nocase
    $net.target.url = /^https?:\/\/[0-9]{1,3}(\.[0-9]{1,3}){3}(:[0-9]+)?\// nocase
    $net.target.url = /\.(zip|7z|rar|gz|tgz|bz2|xz|tar|zst)(\?.*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1027.015")
    $primary_entity = array_distinct($net.principal.hostname)
    $downloader_process = array_distinct($net.principal.process.file.full_path)
    $download_url = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
