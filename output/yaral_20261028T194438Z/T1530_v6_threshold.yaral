/*
  MITRE Technique : T1530 - Data from Cloud Storage
  Tactic(s)       : Collection
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 1h
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:03:23.295645+00:00
  Reference       : https://attack.mitre.org/techniques/T1530
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1530_Cloud_Storage_Bulk_Object_Access_By_Principal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single identity performs a high volume of object read or list operations against cloud storage within one hour. Each read is benign on its own; bulk volume from one principal indicates possible collection or staging of data from cloud storage."
    mitre_tactic = "Collection"
    mitre_technique = "T1530"
    mitre_technique_name = "Data from Cloud Storage"
    log_prerequisites = "Requires cloud provider audit logs with object-level (data event) logging enabled for storage services, normalised to USER_RESOURCE_ACCESS with principal.user.userid, target.resource.name and metadata.product_event_type populated. Object-level data events are often disabled by default and must be enabled per client."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Backup and replication jobs running under user-named identities, data engineering and analytics pipelines, migration projects, e-discovery or compliance exports, and developers syncing large buckets."
    tuning_guidance = "Add known automation identities to %global_allowed_service_accounts, approved cloud service principals to %global_allowed_cloud_principals, and administrator accounts that routinely perform bulk exports to %global_allowed_admin_users. Raise or lower the #cloud threshold per client based on a 30-day baseline of storage reads per principal."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.target.resource.resource_type = "STORAGE_BUCKET"
    $cloud.metadata.product_event_type = /(GetObject|ListObjects|ListBucket|GetBlob|ListBlobs|ReadBlob|storage\.objects\.(get|list)|objects\.(get|list))/ nocase
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 1h

  outcome:
    $risk_score = max(70)
    $event_count = count($cloud.metadata.id)
    $mitre_technique_id = array_distinct("T1530")
    $primary_entity = array_distinct($user)
    $buckets_accessed = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    #cloud >= 100
}
