/*
  MITRE Technique : T1098.001 - Additional Cloud Credentials
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:41:17.074790+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_001_IdP_App_Credential_Added_Then_Permission_Grant {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "The same identity adds a new secret or certificate to an application or service principal and then, within 10 minutes, grants that or another application permissions, app roles or consent. Adding credentials followed by privilege expansion is a common cloud persistence and privilege escalation pattern (e.g. post-compromise abuse of application credentials). It is more specific than a single credential-add event."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.001"
    mitre_technique_name = "Account Manipulation: Additional Cloud Credentials"
    log_prerequisites = "Requires Microsoft 365 / Entra ID directory audit logs ingested and normalised to UDM, with metadata.product_event_type and principal.user.userid populated for application and service principal management operations."
    platform = "Identity Provider"
    log_source = "m365"
    false_positives = "Application owners rotating secrets and approving API permissions during a planned deployment; CI/CD or IaC pipelines that register applications and assign permissions with a single identity; IT admins onboarding new SaaS integrations; managed-service onboarding."
    tuning_guidance = "Add automation and deployment identities to %global_allowed_service_accounts, approved administrators to %global_allowed_admin_users, and approved service principals to %global_allowed_cloud_principals. If permission grants in your tenant are logged under different operation names, adjust the product_event_type regex on the $perm event. Consider shortening the window for tenants with heavy automation."

  events:
    $cred.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"
    $cred.metadata.product_event_type = /(add|update).*(service principal credentials|service principal|application).*(credential|certificates and secrets|key)|add service principal credentials|update application . certificates and secrets management/ nocase
    $cred.principal.user.userid = $user
    not $cred.principal.user.userid in %global_allowed_service_accounts
    not $cred.principal.user.userid in %global_allowed_admin_users
    not $cred.principal.user.userid in %global_allowed_cloud_principals

    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.metadata.product_event_type = /(app role assignment|delegated permission grant|consent to application|oauth2permissiongrant)/ nocase
    $perm.principal.user.userid = $user
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_cloud_principals

    $cred.metadata.event_timestamp.seconds <= $perm.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1098.001")
    $primary_entity = array_distinct($user)
    $credential_operations = array_distinct($cred.metadata.product_event_type)
    $permission_operations = array_distinct($perm.metadata.product_event_type)
    $credential_targets = array_distinct($cred.target.resource.name)
    $source_ips = array_distinct($cred.principal.ip)
    $first_credential_event = min($cred.metadata.event_timestamp.seconds)
    $last_permission_event = max($perm.metadata.event_timestamp.seconds)

  condition:
    $cred and $perm
}
