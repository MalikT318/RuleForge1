/*
  MITRE Technique : T1137 - Office Application Startup
  Tactic(s)       : Persistence
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:13:14.089753+00:00
  Reference       : https://attack.mitre.org/techniques/T1137
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_002_Office_Test_Special_Perf_Registry_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modification under the Office test\\Special\\Perf key. Office loads the DLL named there into every Office application at startup, giving per-user persistence without macros or add-in registration. The key is not created by a normal Office install or update. Written for Windows endpoints, as this rule's platform requirement mandates."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.002"
    mitre_technique_name = "Office Application Startup: Office Test"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 12/13/14 or equivalent) that populates target.registry.registry_key."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare. Possible sources are software packaging or deployment tools that configure Office performance test hooks, Office developer or QA teams testing performance harnesses, and security agents that snapshot or restore the registry."
    tuning_guidance = "Add approved deployment or packaging binaries to %global_allowed_admin_tools and endpoint security agents to %global_allowed_security_tools. Add authorised developer-workstation accounts to %global_allowed_admin_users. Investigate every other hit: read the DLL path in registry_value_data and review the host for the dropped DLL."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Software\\Microsoft\\Office test\\Special\\Perf/ nocase
    not $reg.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1137.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $user = array_distinct($reg.principal.user.userid)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_data = array_distinct($reg.target.registry.registry_value_data)
    $writer_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
