/*
  MITRE Technique : T1499.004 - Application or System Exploitation
  Tactic(s)       : Impact
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:22:36.321648+00:00
  Reference       : https://attack.mitre.org/techniques/T1499/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1499_004_Inbound_External_Windows_Service_Exposure {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an inbound connection from an external source to a Windows-specific service port (SMB, NetBIOS, RPC, RDP, WinRM) that the perimeter permitted. Remotely triggered crash or DoS exploits against Windows services (for example SMB or RDP memory-corruption flaws) need this network reachability first. This is a network-side precursor and exposure signal for T1499.004. It does not prove a crash occurred, so correlate with endpoint service-crash telemetry."
    mitre_tactic = "Impact"
    mitre_technique = "T1499.004"
    mitre_technique_name = "Endpoint Denial of Service: Application or System Exploitation"
    log_prerequisites = "Firewall, proxy, or perimeter logs normalised to UDM NETWORK_CONNECTION with network.direction, principal.ip, target.ip and target.port populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability scanners, VPN or partner links that legitimately use SMB or RDP, remote administration over an approved jump path, and deliberately published RDP or WinRM services."
    tuning_guidance = "Populate %global_allowed_scanners and %global_allowed_mgmt_sources with approved external sources. Add accepted exposure paths to %global_allowed_remote_mgmt. Any hit on a host that should not be internet-reachable is a firewall policy issue to fix first. Raise severity for clients without a published RDP or SMB service."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.direction = "INBOUND"
    (
      $net.target.port = 445 or
      $net.target.port = 139 or
      $net.target.port = 135 or
      $net.target.port = 3389 or
      $net.target.port = 5985 or
      $net.target.port = 5986
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1499.004")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
