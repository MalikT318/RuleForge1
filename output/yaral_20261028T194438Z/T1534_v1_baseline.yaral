/*
  MITRE Technique : T1534 - Internal Spearphishing
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:32:07.964440+00:00
  Reference       : https://attack.mitre.org/techniques/T1534
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1534_Linux_CLI_Mail_Client_Sends_Attachment {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux command-line mail client (mail, mailx, s-nail, mutt, neomutt) launched with an attachment option and an explicit email recipient. A compromised host or account can use this to send phishing payloads to other users in the same organization from a trusted internal sender. Matching the client, the attach flag and a recipient address together keeps this behavioral and independent of any specific payload, domain or filename."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1534"
    mitre_technique_name = "Internal Spearphishing"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records with full command-line capture, normalized to UDM PROCESS_LAUNCH."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Cron jobs and monitoring scripts mailing reports or logs as attachments, backup or audit tools mailing results, administrators sending files by hand, and application service accounts with legitimate mail workflows."
    tuning_guidance = "Add automation and reporting service accounts to %global_allowed_service_accounts. Add approved parent processes (job schedulers, report generators) to %global_allowed_script_hosts or %global_allowed_admin_tools. Review recurring hits per host and exclude by parent process rather than by recipient."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(mail|mailx|s-nail|mutt|neomutt)$/ nocase
    $proc.target.process.command_line = /(\s-a\s|\s--attach\b|\s-A\s)/ nocase
    $proc.target.process.command_line = /[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1534")
    $primary_entity = array_distinct($proc.principal.hostname)
    $sending_user = array_distinct($proc.principal.user.userid)
    $mail_client = array_distinct($proc.target.process.file.full_path)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
