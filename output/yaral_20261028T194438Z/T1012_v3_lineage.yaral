/*
  MITRE Technique : T1012 - Query Registry
  Tactic(s)       : Discovery
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:24:10.132352+00:00
  Reference       : https://attack.mitre.org/techniques/T1012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1012_Registry_Query_From_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry querying (reg query, PowerShell registry provider access, or WSH RegRead) from a shell, script interpreter or reg.exe that was spawned by an Office application, web server worker, print spooler or database service. Those parents should not normally enumerate the registry, so this lineage points to macro execution, webshell activity or exploitation of a service followed by system discovery."
    mitre_tactic = "Discovery"
    mitre_technique = "T1012"
    mitre_technique_name = "Query Registry"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Line-of-business Office add-ins or macros that read licensing or version keys, web applications (for example IIS-hosted admin portals) that shell out to read configuration, database maintenance jobs run via agent or xp_cmdshell, print management software, and software installers launched from Office or a web server."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts and sanctioned IT tooling to %global_allowed_admin_tools. Add known automation identities to %global_allowed_service_accounts. To widen coverage, extend the parent regex with other server or document-handling processes used by the client."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Unexpected parent: Office, web server, print spooler, database service
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|spoolsv|sqlservr|mysqld|postgres)\.exe$/ nocase

    // Child: registry utility, shell or script interpreter
    $proc.target.process.file.full_path = /\\(reg|cmd|powershell|pwsh|wscript|cscript)\.exe$/ nocase

    // Registry query intent in the child command line
    $proc.target.process.command_line = /(\breg(\.exe)?"?\s+query\b|\bget-itemproperty\b|\bget-childitem\b.*\bhk(lm|cu):|\bhk(lm|cu):\\|registry::|\[microsoft\.win32\.registry\]|\bregread\b)/ nocase

    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1012")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
