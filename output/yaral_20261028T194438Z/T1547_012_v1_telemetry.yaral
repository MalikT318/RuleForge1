/*
  MITRE Technique : T1547.012 - Print Processors
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:38:23.260206+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_012_Print_Processor_Driver_Registry_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry modification of the Driver value under a Print Processors subkey of the Print Environments hive. This is the registry state change that registers a DLL for loading by the print spooler service (spoolsv.exe) as SYSTEM at boot. It fires on the resulting registry artifact, whether the key was written directly or through the AddPrintProcessor API, and does not depend on command-line logging."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.012"
    mitre_technique_name = "Boot or Logon Autostart Execution: Print Processors"
    log_prerequisites = "Requires Windows registry modification telemetry (EDR registry events or Sysmon Event ID 12/13) with registry key paths and value names populated in UDM. The registry key under HKLM\\SYSTEM\\*ControlSet*\\Control\\Print\\Environments must be in scope for collection."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate print driver or print management software installers registering a custom print processor (for example enterprise print servers, document imaging and PDF printer suites), Windows servicing or feature updates rewriting the default winprint processor entry, and IT deployment tooling provisioning print infrastructure."
    tuning_guidance = "Add approved print and deployment installer binaries to %global_allowed_admin_tools and endpoint security agents to %global_allowed_security_tools. When AddPrintProcessor is used, the registry write may come from spoolsv.exe on behalf of the calling process. Review the originating process and the DLL placed in the print-processor directory before excluding it. Consider scoping exclusions to known print server hosts."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control\\Print\\Environments\\[^\\]+\\Print Processors\\[^\\]+/ nocase
    (
      $reg.target.registry.registry_value_name = "Driver" nocase or
      $reg.target.registry.registry_key = /\\Driver$/ nocase
    )
    not $reg.principal.process.file.full_path = /\\(TiWorker|TrustedInstaller)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.012")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $modifying_processes = array_distinct($reg.principal.process.file.full_path)
    $acting_users = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
