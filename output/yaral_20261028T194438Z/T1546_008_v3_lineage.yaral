/*
  MITRE Technique : T1546.008 - Accessibility Features
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:10:41.418349+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_008_Accessibility_Binary_Spawns_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects a Windows accessibility feature binary (Sticky Keys, Utility Manager, On-Screen Keyboard, Narrator, Magnifier, Display Switch, AT Broker) acting as the parent of a shell or script interpreter. These binaries never legitimately spawn command interpreters. This lineage indicates the binary or its Image File Execution Options debugger reference was replaced to obtain a pre-logon SYSTEM shell (e.g. via the RDP logon screen)."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.008"
    mitre_technique_name = "Event Triggered Execution: Accessibility Features"
    log_prerequisites = "Requires Windows endpoint process telemetry with parent process path populated (EDR or Sysmon Event ID 1, or Security Event 4688 with parent process name)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare. Possible sources: authorised helpdesk or assistive-technology software that wraps accessibility tools in scripts, accessibility-compliance test automation, and red team or purple team exercises."
    tuning_guidance = "Add approved parent process paths or wrappers to %global_allowed_script_hosts. Confirm with the client that no assistive-technology tooling launches interpreters from these binaries. Correlate hits with registry changes under Image File Execution Options and with file modification of the accessibility binaries in System32."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(sethc|utilman|osk|narrator|magnify|displayswitch|atbroker)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|powershell_ise|wscript|cscript|mshta|rundll32|regsvr32)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(92)
    $mitre_technique_id = array_distinct("T1546.008")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
