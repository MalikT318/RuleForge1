/*
  MITRE Technique : T1059.009 - Cloud API
  Tactic(s)       : Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:19:17.557699+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_009_CloudAPI_Programmatic_Login_Then_Permission_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an identity authenticating through a programmatic client (CLI, SDK, scripting library or shell module, identified by user agent) and then changing user or role permissions within five minutes. This sequence is typical of an adversary using stolen credentials or tokens to run privileged cloud API calls, not a console user working interactively."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.009"
    mitre_technique_name = "Command and Scripting Interpreter: Cloud API"
    log_prerequisites = "Requires identity provider or cloud IAM sign-in logs and directory/permission audit logs normalised to UDM, with network.http.user_agent populated on both USER_LOGIN and USER_CHANGE_PERMISSIONS events."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Administrators or DevOps engineers scripting IAM changes from a CLI, infrastructure-as-code pipelines applying role bindings, onboarding or offboarding automation, and identity governance tooling that uses SDKs."
    tuning_guidance = "Add automation and pipeline identities to %global_allowed_service_accounts, named administrators who legitimately script IAM changes to %global_allowed_admin_users, and approved management source addresses to %global_allowed_mgmt_sources. Extend or narrow the user-agent regex to match the client mix in each tenant."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.network.http.user_agent = /(\bcli\b|sdk|powershell|boto|python|curl|go-http-client|java\/|node|ruby|libcurl)/ nocase
    $auth.principal.user.userid = $user
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users
    not $auth.principal.ip in %global_allowed_mgmt_sources

    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.network.http.user_agent = /(\bcli\b|sdk|powershell|boto|python|curl|go-http-client|java\/|node|ruby|libcurl)/ nocase
    $perm.principal.user.userid = $user
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.ip in %global_allowed_mgmt_sources

    $auth.metadata.event_timestamp.seconds <= $perm.metadata.event_timestamp.seconds

  match:
    $user over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.009")
    $primary_entity = array_distinct($user)
    $login_source_ips = array_distinct($auth.principal.ip)
    $login_user_agents = array_distinct($auth.network.http.user_agent)
    $permission_targets = array_distinct($perm.target.user.userid)
    $permission_change_count = count($perm.metadata.id)

  condition:
    $auth and $perm
}
