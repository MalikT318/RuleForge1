/*
  MITRE Technique : T1218.005 - Mshta
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:48:23.529206+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_005_Mshta_External_Network_Then_Child_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects mshta.exe making an outbound connection to a non-internal address and then spawning a shell, script interpreter or proxy-execution binary on the same host within 10 minutes. This sequence is typical of remote HTA or scriptlet retrieval followed by payload execution. It is based on network behaviour and process lineage, not command-line matching."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.005"
    mitre_technique_name = "System Binary Proxy Execution: Mshta"
    log_prerequisites = "Requires Windows endpoint telemetry that reports both process-attributed network connections and process launches with parent process path (EDR or Sysmon Event IDs 1 and 3)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy line-of-business applications delivered as HTA files that fetch content from external servers and launch helper scripts, software installers or kiosk applications built on HTA, and IT automation that uses mshta to display remote content."
    tuning_guidance = "Add approved child tooling to %global_allowed_admin_tools. Add hosts that legitimately run HTA-based applications to %global_allowed_script_hosts. Extend the child-process regex for environment-specific interpreters. If the EDR does not attribute network connections to the process, this rule will not fire."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\mshta\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_script_hosts
    $net.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\mshta\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|rundll32|regsvr32|certutil|bitsadmin|msiexec|curl)\.exe$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $net.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1218.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $child_processes = array_distinct($proc.target.process.file.full_path)
    $affected_users = array_distinct($proc.principal.user.userid)

  condition:
    $net and $proc
}
