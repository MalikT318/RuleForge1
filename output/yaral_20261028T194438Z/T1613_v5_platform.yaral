/*
  MITRE Technique : T1613 - Container and Resource Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:35:54.458826+00:00
  Reference       : https://attack.mitre.org/techniques/T1613
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1613_Container_Runtime_And_API_Discovery_From_Workload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a process inside a container or on a container node querying the container runtime socket or the Kubernetes API with a mounted service-account token to enumerate containers, images, pods, nodes, services, secrets or deployments. Adversaries who land in a workload use these queries for resource discovery before lateral movement."
    mitre_tactic = "Discovery"
    mitre_technique = "T1613"
    mitre_technique_name = "Container and Resource Discovery"
    log_prerequisites = "Requires Linux or container runtime process-launch telemetry (EDR/runtime sensor or auditd execve) that includes full command lines for in-container processes."
    platform = "Containers"
    log_source = "container"
    false_positives = "Monitoring and observability agents, CI/CD runners, service-mesh and operator sidecars, cluster autoscalers, backup tooling, and admins or developers troubleshooting from a debug pod."
    tuning_guidance = "Add approved tooling parent or process paths to %global_allowed_admin_tools and automation identities to %global_allowed_service_accounts. Review hosts that fire repeatedly and exclude known operator workloads. Raise severity if the query comes from a web-facing or recently exec'd pod."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(--unix-socket\s+\S*\.sock\S*\s.*\/(containers|images|networks|volumes|nodes|services)(\/json)?(\?|"|'|\s|$))|(serviceaccount\/token.*(\/api\/v1\/(namespaces|pods|nodes|services|secrets|configmaps)|\/apis\/(apps|batch)\/v1\/(deployments|daemonsets|statefulsets|jobs)))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1613")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
