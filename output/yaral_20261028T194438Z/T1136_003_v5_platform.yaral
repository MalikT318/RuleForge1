/*
  MITRE Technique : T1136.003 - Cloud Account
  Tactic(s)       : Persistence
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:11:33.258247+00:00
  Reference       : https://attack.mitre.org/techniques/T1136/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_003_IdP_Cloud_Account_Created_By_Unapproved_Actor {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a new identity provider (cloud directory) account by an actor that is not an approved administrator, service account or cloud principal. Adversaries with sufficient directory access create secondary accounts to keep credentialed access without deploying persistent remote access tooling. Self-registration is excluded."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136.003"
    mitre_technique_name = "Create Account: Cloud Account"
    log_prerequisites = "Requires identity provider directory audit logs that normalize account creation to USER_CREATION, with the acting identity in principal.user.userid and the new account in target.user.userid."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "HR-driven joiner provisioning from unlisted automation or SCIM connectors, help desk staff onboarding users, delegated administrators, migration or tenant consolidation projects, B2B guest invitations created by regular users."
    tuning_guidance = "Add approved provisioning and automation identities to %global_allowed_service_accounts, cloud or app principals that provision users to %global_allowed_cloud_principals, and named administrators or help desk staff to %global_allowed_admin_users. Raise severity for creations outside change windows or when the new account is later granted privileged roles."

  events:
    $auth.metadata.event_type = "USER_CREATION"
    $auth.principal.user.userid != ""
    $auth.target.user.userid != ""
    $auth.principal.user.userid != $auth.target.user.userid
    not $auth.principal.user.userid in %global_allowed_admin_users
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1136.003")
    $primary_entity = array_distinct($auth.target.user.userid)
    $creating_actor = array_distinct($auth.principal.user.userid)
    $source_ips = array_distinct($auth.principal.ip)

  condition:
    $auth
}
