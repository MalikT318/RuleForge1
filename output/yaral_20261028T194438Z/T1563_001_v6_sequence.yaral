/*
  MITRE Technique : T1563.001 - SSH Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:09:26.839802+00:00
  Reference       : https://attack.mitre.org/techniques/T1563/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_001_SSH_Inbound_Then_Outbound_Pivot {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an SSH pivot chain seen at the network perimeter. A host receives an inbound SSH connection (TCP/22) and, within 10 minutes, opens an outbound SSH connection to a different internal host. This is consistent with SSH session or agent hijacking, where an attacker with access to a live session or agent socket reuses the victim's trust relationships to move laterally. A firewall cannot see the hijack itself, so the rule detects the network-observable hop chain."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1563.001"
    mitre_technique_name = "Remote Service Session Hijacking: SSH Hijacking"
    log_prerequisites = "Firewall, proxy or perimeter flow logs normalised to UDM NETWORK_CONNECTION events with principal.ip, target.ip and target.port populated. Internal east-west SSH traffic must be visible to the logging device."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Bastion and jump hosts, configuration management and orchestration servers (for example Ansible controllers), CI/CD runners, backup or file-transfer hosts that chain SSH or SCP, and admins using ProxyJump or agent forwarding legitimately."
    tuning_guidance = "Add bastion, jump host and automation controller source addresses to %global_allowed_mgmt_sources. Known-good chains are excluded when the pivot host is in that list. Ensure %rfc1918_internal covers the customer's internal address space. If east-west SSH is noisy, shorten the window or scope to critical server segments."

  events:
    $ssh_in.metadata.event_type = "NETWORK_CONNECTION"
    $ssh_in.target.port = 22
    $ssh_in.target.ip = $pivot
    not $ssh_in.principal.ip in %global_allowed_mgmt_sources

    $ssh_out.metadata.event_type = "NETWORK_CONNECTION"
    $ssh_out.target.port = 22
    $ssh_out.principal.ip = $pivot
    $ssh_out.target.ip in %rfc1918_internal
    not $ssh_out.principal.ip in %global_allowed_mgmt_sources

    // The onward hop must go to a different host than the one that connected in
    $ssh_in.principal.ip != $ssh_out.target.ip
    $ssh_in.target.ip != $ssh_out.target.ip

    $ssh_in.metadata.event_timestamp.seconds <= $ssh_out.metadata.event_timestamp.seconds

  match:
    $pivot over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1563.001")
    $primary_entity = array_distinct($pivot)
    $inbound_source_ips = array_distinct($ssh_in.principal.ip)
    $onward_target_ips = array_distinct($ssh_out.target.ip)
    $onward_connection_count = count($ssh_out.metadata.id)

  condition:
    $ssh_in and $ssh_out
}
