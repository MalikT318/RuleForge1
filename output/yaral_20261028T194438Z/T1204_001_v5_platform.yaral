/*
  MITRE Technique : T1204.001 - Malicious Link
  Tactic(s)       : Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:59:50.158816+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_001_Browser_Download_Of_Executable_Content_Via_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows browser fetching directly executable or script-capable content (installers, scripts, shortcuts, disk images, macro-enabled documents) from an external destination, as seen by the perimeter. This is the network-observable result of a user following a malicious link (T1204.001) and complements process-creation detections. Platform is Windows, identified from the Windows browser user-agent."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.001"
    mitre_technique_name = "User Execution: Malicious Link"
    log_prerequisites = "Requires proxy or firewall logs with HTTP URL inspection (TLS inspection recommended) that populate target.url and network.http.user_agent. Plain firewall flow logs without URL visibility will not trigger this rule."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate software or installer downloads by users or admins, vendor update portals not in the allowed domain list, internal developers downloading scripts or archives, and IT staff retrieving ISO or MSI packages."
    tuning_guidance = "Add known-good vendor, CDN and update domains to %global_allowed_domains. Narrow the extension list per client if software downloads are common. Raise severity when the same host also shows a follow-on process launch rule hit. Consider requiring http.referral_url from webmail or a messaging domain in high-noise environments."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.network.http.user_agent = /Mozilla\/5\.0 \(Windows NT/ nocase
    $net.target.url = /\.(exe|msi|msix|scr|hta|js|jse|vbs|vbe|wsf|iso|img|lnk|bat|cmd|ps1|jar|cpl|dll|docm|xlsm|pptm)(\?.*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1204.001")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $requested_urls = array_distinct($net.target.url)
    $referrers = array_distinct($net.network.http.referral_url)
    $destination_hosts = array_distinct($net.target.hostname)

  condition:
    $net
}
