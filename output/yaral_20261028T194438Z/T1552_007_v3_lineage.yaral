/*
  MITRE Technique : T1552.007 - Container API
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:55:55.843899+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_007_Container_API_Credential_Access_From_Service_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing or data-tier service process (web server, application runtime, or database) spawning a shell, script interpreter, or HTTP client inside a container where the child command references container or Kubernetes API credential material, such as the service account token, the in-cluster API endpoint, the container runtime socket, or secrets and log API paths. A service process spawning an interpreter to reach these artifacts indicates a compromised workload harvesting credentials through the container APIs."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.007"
    mitre_technique_name = "Unsecured Credentials: Container API"
    log_prerequisites = "Requires container runtime or EDR process telemetry that records in-container process launches with parent process path and full command line."
    platform = "Containers"
    log_source = "container"
    false_positives = "Health-check or readiness scripts launched by an application runtime that query the Kubernetes API; sidecar or init patterns where a Java or Node service shells out to kubectl-style helpers; legitimate operators running diagnostics through a web-console process; CI agents running in containers."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts, approved tooling to %global_allowed_admin_tools, and EDR or runtime security agents to %global_allowed_security_tools. If Java or Node parents are noisy in a given environment, tune the parent regex rather than the child or API indicator logic."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|httpd|apache2|php-fpm[0-9.]*|tomcat[0-9.]*|java|gunicorn|uwsgi|node|mysqld|postgres|mongod|redis-server)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|ash|zsh|python[0-9.]*|perl|ruby|curl|wget)$/ nocase
    $proc.target.process.command_line = /(serviceaccount\/token|KUBERNETES_SERVICE_HOST|kubernetes\.default|docker\.sock|\/api\/v1\/(namespaces\/[^\/]+\/)?secrets|\/containers\/[^\/]+\/logs)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1552.007")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
