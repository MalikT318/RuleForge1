/*
  MITRE Technique : T1114 - Email Collection
  Tactic(s)       : Collection
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:16:05.161572+00:00
  Reference       : https://attack.mitre.org/techniques/T1114
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_Mailbox_Rule_Configuration_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a mailbox configuration change that creates or modifies an inbox rule or updates the rule set. Adversaries use these rules to forward, redirect, or silently copy a victim's email for collection. This rule pivots on the resulting configuration state change in the unified audit log, not on any command line."
    mitre_tactic = "Collection"
    mitre_technique = "T1114"
    mitre_technique_name = "Email Collection"
    log_prerequisites = "Requires unified audit logs with mailbox audit events ingested and normalised to SETTING_MODIFICATION, with the operation name populated in metadata.product_event_type and the acting account in principal.user.userid."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Users creating legitimate inbox rules (filing, out-of-office, newsletter sorting); help-desk staff configuring rules for users; mailbox migration tooling; mail clients that sync rules; shared-mailbox automation set up by administrators."
    tuning_guidance = "Add automation and migration accounts to %global_allowed_service_accounts, helpdesk and mail administrators to %global_allowed_admin_users, and approved service principals to %global_allowed_cloud_principals. If the parser maps rule parameters, add a condition on the forward, redirect, or delete action to cut volume. Raise severity when the actor is also seen in a risky sign-in."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /^(New-InboxRule|Set-InboxRule|UpdateInboxRules)$/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1114")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $operations = array_distinct($setting.metadata.product_event_type)
    $source_ips = array_distinct($setting.principal.ip)

  condition:
    $setting
}
