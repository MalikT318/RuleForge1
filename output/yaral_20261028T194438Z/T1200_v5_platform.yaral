/*
  MITRE Technique : T1200 - Hardware Additions
  Tactic(s)       : Initial Access
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:50:35.693785+00:00
  Reference       : https://attack.mitre.org/techniques/T1200
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1200_Linux_Udev_Device_Event_Spawns_Payload_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the udev device manager (systemd-udevd/udevd) launching a shell, scripting interpreter or network utility with download, reverse-shell, staging or execution arguments. This is the result of a hardware addition (for example a USB HID keystroke injector, USB network adapter or rogue device) triggering a malicious udev RUN rule or device-event handler on Linux."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1200"
    mitre_technique_name = "Hardware Additions"
    log_prerequisites = "Linux EDR or auditd execve telemetry normalised to UDM PROCESS_LAUNCH with parent process path and full command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Custom udev rules that run vendor provisioning scripts, device-mounting helpers that fetch firmware or configuration, kiosk or lab hosts that auto-configure peripherals, and docking or storage automation maintained by IT."
    tuning_guidance = "Add approved helper binaries to %global_allowed_admin_tools, and kiosk, lab or provisioning hosts that legitimately script device events to %global_allowed_script_hosts. Review the command_lines outcome to identify the udev rule responsible, usually under /etc/udev/rules.d or /lib/udev/rules.d."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(systemd-udevd|udevd)$/ nocase
    $proc.target.process.file.full_path = /\/(bash|dash|sh|zsh|ksh|ash|python[0-9.]*|perl|ruby|php|curl|wget|nc|ncat|netcat|socat)$/ nocase
    $proc.target.process.command_line = /(\/dev\/tcp\/|\bcurl\b|\bwget\b|\bnc(at)?\b|\bnetcat\b|\bsocat\b|\bmkfifo\b|base64\s+(-d|--decode)|\bchmod\s+\+?[ugoa]*\+?x|\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\bbash\s+-i|python[0-9.]*\s+-c|perl\s+-e)/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1200")
    $primary_entity = array_distinct($proc.principal.hostname)
    $command_lines = array_distinct($proc.target.process.command_line)
    $child_processes = array_distinct($proc.target.process.file.full_path)
    $affected_users = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
