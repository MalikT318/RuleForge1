/*
  MITRE Technique : T1003.002 - Security Account Manager
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:38:46.667310+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_002_SAM_Hive_Dump_File_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a file named like a Windows SAM, SECURITY or SYSTEM registry hive (optionally with a save/backup extension) outside the native hive and backup locations. This is the file artifact left by offline SAM extraction such as 'reg save', hive copies from volume shadow copies, or in-memory dumpers that write hives to disk. It does not depend on command-line logging."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.002"
    mitre_technique_name = "OS Credential Dumping: Security Account Manager"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with the creating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and imaging software staging registry hives, system recovery or migration tools, forensic and IR collection by authorised staff, and software deployment tooling that exports registry hives for offline servicing."
    tuning_guidance = "Add approved backup and imaging process paths to %global_allowed_backup_processes, EDR/AV agents to %global_allowed_security_tools, and IT or IR tooling to %global_allowed_admin_tools. Extend the directory exclusions if a client has an approved hive staging location."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(sam|security|system)(\.(save|hive|bak|dmp|out|txt|tmp))?$/ nocase
    not $file.target.file.full_path = /\\windows\\(system32|syswow64|sysnative)\\config\\/ nocase
    not $file.target.file.full_path = /\\windows\\(winsxs|servicing|softwaredistribution|repair)\\/ nocase
    not $file.target.file.full_path = /\\system volume information\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1003.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $dumped_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
