/*
  MITRE Technique : T1056.003 - Web Portal Capture
  Tactic(s)       : Collection, Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:50:02.858011+00:00
  Reference       : https://attack.mitre.org/techniques/T1056/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1056_003_Portal_Credential_Exfil_POST_To_IP_Literal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an HTTP POST sent to an external destination addressed by a raw IP literal rather than a domain name. A compromised Linux-hosted web or VPN login portal that harvests submitted credentials commonly forwards them to attacker infrastructure this way. The rule uses only perimeter proxy or firewall HTTP telemetry and does not depend on endpoint process data. It gives network-side coverage that complements process and command-line detections."
    mitre_tactic = "Collection, Credential Access"
    mitre_technique = "T1056.003"
    mitre_technique_name = "Input Capture: Web Portal Capture"
    log_prerequisites = "Requires firewall, secure web gateway, or proxy logs normalised to NETWORK_HTTP with network.http.method and target.url populated (TLS inspection or explicit proxy logging for HTTPS). Most effective when scoped to the DMZ or portal subnet egress, where the sources are Linux-based externally facing VPN or web login servers."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legacy appliances or IoT and monitoring agents that post telemetry to a bare IP, software licensing or update checks addressed by IP, unmanaged cloud health probes, and developer or test systems calling APIs by IP."
    tuning_guidance = "Add known-good vendor and update destinations to %global_allowed_domains. Scope the rule to the DMZ or portal egress segment to cut noise from user workstations. Confirm %rfc1918_internal covers all internal ranges for the client. Alerts on a portal server should be followed by integrity checks of login page files (for example under /var/www and the appliance web roots)."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.url = /^https?:\/\/(\d{1,3}\.){3}\d{1,3}(:\d+)?(\/|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    $net.principal.ip != ""

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1056.003")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_urls = array_distinct($net.target.url)

  condition:
    $net
}
