/*
  MITRE Technique : T1190 - Exploit Public-Facing Application
  Tactic(s)       : Initial Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:36:08.071325+00:00
  Reference       : https://attack.mitre.org/techniques/T1190
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1190_Inbound_Web_Exposure_Then_Server_Outbound_Callback {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An external source connects to a host on a commonly exposed web or management port, and within 10 minutes the same host initiates an outbound connection to an external address on a high, non-web port. This inbound-then-outbound pattern is consistent with successful exploitation of a public-facing application that results in a reverse shell, staging download, or C2 callback. The rule uses only perimeter network telemetry and does not duplicate process or command-line detections."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1190"
    mitre_technique_name = "Exploit Public-Facing Application"
    log_prerequisites = "Firewall or perimeter logs normalised to UDM NETWORK_CONNECTION, with principal.ip, target.ip and target.port populated for both inbound and outbound sessions. The firewall must log traffic in both directions, and internal NAT addresses should be visible, so the server's internal IP is the same in the inbound target and the outbound source."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Internet-facing servers that legitimately make outbound calls on high ports, such as patch or update agents, licensing and telemetry services, mail relays, SaaS API integrations, and VoIP or video services. Authorised external scanners and uptime monitors that trigger the inbound leg. Servers behind NAT where several hosts share one translated address."
    tuning_guidance = "Add authorised external scanners and monitoring sources to %global_allowed_scanners, and known-good vendor and update destinations to %global_allowed_domains. Extend the inbound port list to match the exposed services at each client, for example 8000, 8888 or 9443. If a client has server-to-internet traffic on a legitimate high port, raise the outbound port threshold or add that port to the exclusions. Where firewall logs do not resolve target.hostname, the domain exclusion has no effect, so rely on narrowing the ports."

  events:
    // Event 1: external source reaches an internal host on a commonly exposed service port
    $in.metadata.event_type = "NETWORK_CONNECTION"
    not $in.principal.ip in %rfc1918_internal
    not $in.target.ip in %rfc1918_internal
    not $in.principal.ip in %global_allowed_scanners
    ($in.target.port = 80 or $in.target.port = 443 or $in.target.port = 8080 or $in.target.port = 8443 or $in.target.port = 445 or $in.target.port = 3389 or $in.target.port = 1433)
    $in.target.ip = $host_ip

    // Event 2: the same host initiates an outbound connection to an external address on a high, non-web port
    $out.metadata.event_type = "NETWORK_CONNECTION"
    $out.principal.ip = $host_ip
    not $out.target.ip in %rfc1918_internal
    not $out.target.hostname in %global_allowed_domains
    $out.target.port > 1024
    $out.target.port != 8080
    $out.target.port != 8443

    $in.metadata.event_timestamp.seconds <= $out.metadata.event_timestamp.seconds

  match:
    $host_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1190")
    $primary_entity = array_distinct($host_ip)
    $inbound_source_ips = array_distinct($in.principal.ip)
    $inbound_ports = array_distinct($in.target.port)
    $outbound_dest_ips = array_distinct($out.target.ip)
    $outbound_dest_ports = array_distinct($out.target.port)
    $inbound_event_count = count($in.metadata.id)
    $outbound_event_count = count($out.metadata.id)

  condition:
    $in and $out
}
