/*
  MITRE Technique : T1484.002 - Trust Modification
  Tactic(s)       : Defense Impairment, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:35:14.108785+00:00
  Reference       : https://attack.mitre.org/techniques/T1484/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1484_002_Burst_Of_Domain_Trust_Changes_By_Single_Account {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single account generates several domain trust creation, modification, removal or trusted-forest information events within ten minutes. A single trust change can be routine administration. A burst from one account suggests an adversary adding or altering trust or federation relationships to forge tokens or gain access to a trusting domain."
    mitre_tactic = "Defense Impairment, Privilege Escalation"
    mitre_technique = "T1484.002"
    mitre_technique_name = "Domain or Tenant Policy Modification: Trust Modification"
    log_prerequisites = "Requires Active Directory domain controller Security event logs (trust events 4706, 4707, 4716, 4865, 4866, 4867) with the 'Audit Authentication Policy Change' subcategory enabled, ingested and normalized to UDM as SETTING_MODIFICATION with metadata.product_event_type populated. Verify the event type mapping for these IDs in each client parser."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Planned domain or forest migrations, new trust build-outs after mergers or acquisitions, trust validation or re-creation during troubleshooting, and automated identity management tooling performing bulk trust updates."
    tuning_guidance = "Add approved identity administrators to %global_allowed_admin_users and migration or automation accounts to %global_allowed_service_accounts. Raise the threshold in the condition if a client runs frequent trust maintenance. Lower it to #trust >= 2 in environments that should never change trusts. Suppress during documented change windows."

  events:
    $trust.metadata.event_type = "SETTING_MODIFICATION"
    $trust.metadata.product_event_type = /^(4706|4707|4716|4865|4866|4867)$/
    $trust.principal.user.userid = $user
    not $trust.principal.user.userid in %global_allowed_admin_users
    not $trust.principal.user.userid in %global_allowed_service_accounts

  match:
    $user over 10m

  outcome:
    $risk_score = max(75)
    $event_count = count($trust.metadata.id)
    $mitre_technique_id = array_distinct("T1484.002")
    $primary_entity = array_distinct($user)
    $source_hosts = array_distinct($trust.principal.hostname)
    $event_ids = array_distinct($trust.metadata.product_event_type)

  condition:
    #trust >= 3
}
