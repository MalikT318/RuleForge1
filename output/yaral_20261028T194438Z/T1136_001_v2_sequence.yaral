/*
  MITRE Technique : T1136.001 - Local Account
  Tactic(s)       : Persistence
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:07:33.008638+00:00
  Reference       : https://attack.mitre.org/techniques/T1136/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_001_ESXi_Local_Account_Created_Then_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A new local account is created on an ESXi host and that same account then authenticates to the same host within 10 minutes. Creating a local account and immediately using it is a common way to establish secondary credentialed access that outlasts the original foothold. The rule uses account-management and authentication events rather than command-line matching."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136.001"
    mitre_technique_name = "Create Account: Local Account"
    log_prerequisites = "ESXi hostd and shell logs forwarded and parsed into UDM, with local account creation normalised as USER_CREATION and authentication as USER_LOGIN. The new account name must populate target.user.userid on both events."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators provisioning break-glass, backup, monitoring or automation accounts and testing them straight away; host build and remediation automation; lifecycle tooling that creates service accounts during host onboarding."
    tuning_guidance = "Add named administrators to %global_allowed_admin_users and expected automation or monitoring account names to %global_allowed_service_accounts. Account-creation events whose creator is not populated by the parser are still evaluated, so confirm creator mapping per client. Lengthen or shorten the 10m window if onboarding workflows are slower or faster."

  events:
    $create.metadata.event_type = "USER_CREATION"
    $create.target.user.userid = $new_user
    $create.principal.hostname = $hostname
    not $create.principal.user.userid in %global_allowed_admin_users
    not $create.target.user.userid in %global_allowed_service_accounts

    $login.metadata.event_type = "USER_LOGIN"
    $login.target.user.userid = $new_user
    $login.principal.hostname = $hostname
    not $login.target.user.userid in %global_allowed_service_accounts

    $create.metadata.event_timestamp.seconds <= $login.metadata.event_timestamp.seconds

  match:
    $hostname, $new_user over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1136.001")
    $primary_entity = array_distinct($hostname)
    $new_account = array_distinct($new_user)
    $created_by = array_distinct($create.principal.user.userid)
    $login_sources = array_distinct($login.principal.ip)
    $login_count = count($login.metadata.id)

  condition:
    $create and $login
}
