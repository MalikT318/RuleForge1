/*
  MITRE Technique : T1055.009 - Proc Memory
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:56:05.140243+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_009_Proc_Maps_Read_Then_Proc_Mem_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the core proc memory injection sequence on Linux: a process reads another process's memory map from /proc/<pid>/maps and then writes to /proc/<pid>/mem on the same host within five minutes. The first step enumerates stack and gadget offsets, and the second overwrites target memory. Detection relies on file-access telemetry, not command lines, so it covers dd, scripts and compiled implants alike."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.009"
    mitre_technique_name = "Process Injection: Proc Memory"
    log_prerequisites = "Requires Linux EDR or auditd file-access telemetry (watches on /proc/*/maps reads and /proc/*/mem writes) normalised to FILE_READ and FILE_MODIFICATION with principal.process.pid populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Debuggers (gdb, lldb), profilers and tracers, JVM and language-runtime diagnostics, crash dumpers, EDR/AV memory scanners, backup or checkpoint/restore tooling (CRIU), and developer workstations doing live debugging."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools, debugging and diagnostic tooling to %global_allowed_admin_tools, and checkpoint or imaging software to %global_allowed_backup_processes. If principal.process.pid is not populated by your sensor, replace the pid join with a join on hostname only and narrow by user."

  events:
    $read.metadata.event_type = "FILE_READ"
    $read.target.file.full_path = /^\/proc\/[0-9]+\/maps$/ nocase
    $read.principal.hostname = $hostname
    $read.principal.process.pid = $pid
    not $read.principal.process.file.full_path in %global_allowed_security_tools
    not $read.principal.process.file.full_path in %global_allowed_admin_tools
    not $read.principal.process.file.full_path in %global_allowed_backup_processes

    $write.metadata.event_type = "FILE_MODIFICATION"
    $write.target.file.full_path = /^\/proc\/[0-9]+\/mem$/ nocase
    $write.principal.hostname = $hostname
    $write.principal.process.pid = $pid
    not $write.principal.process.file.full_path in %global_allowed_security_tools
    not $write.principal.process.file.full_path in %global_allowed_admin_tools
    not $write.principal.process.file.full_path in %global_allowed_backup_processes

    $read.metadata.event_timestamp.seconds <= $write.metadata.event_timestamp.seconds

  match:
    $hostname, $pid over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.009")
    $primary_entity = array_distinct($write.principal.hostname)
    $actor_process = array_distinct($write.principal.process.file.full_path)
    $actor_user = array_distinct($write.principal.user.userid)
    $maps_files_read = array_distinct($read.target.file.full_path)
    $mem_files_written = array_distinct($write.target.file.full_path)
    $mem_write_count = count($write.metadata.id)

  condition:
    $read and $write
}
