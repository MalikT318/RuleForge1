/*
  MITRE Technique : T1134.004 - Parent PID Spoofing
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:59:42.152519+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_004_Anomalous_Parent_Spawns_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, script interpreter, or proxy-execution LOLBin launched by a parent process that should never spawn one (Office applications, print spooler, web server workers, database services). This is the lineage anomaly produced by spearphishing, web shells, service exploitation, and PPID-spoofing tradecraft that re-parents a child under an unexpected process."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.004"
    mitre_technique_name = "Access Token Manipulation: Parent PID Spoofing"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry (EDR or Sysmon Event ID 1 or Security Event 4688 with command-line auditing) that populates both the parent and child process image paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate line-of-business Office macros or add-ins that call cmd or PowerShell; web applications that deliberately shell out from IIS or Tomcat workers (reporting, PDF generation, deployment hooks); SQL Server Agent jobs or xp_cmdshell used by DBAs; print-driver installers or vendor print management software spawning cmd from spoolsv; software packaging and RMM tools running under these parents."
    tuning_guidance = "Add approved parent process paths (for example a known application-specific w3wp or sqlservr workflow) to %global_allowed_script_hosts. Add approved deployment, RMM, and patching binaries to %global_allowed_admin_tools. If a single parent family is noisy in a client environment, remove it from the parent regex in a client-scoped copy of the rule rather than loosening the child pattern."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|spoolsv|w3wp|httpd|nginx|tomcat\d*|php-cgi|inetinfo|sqlservr|sqlagent|mysqld)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|msbuild|installutil)\.exe$/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1134.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
