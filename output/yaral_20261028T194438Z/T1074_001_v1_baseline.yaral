/*
  MITRE Technique : T1074.001 - Local Data Staging
  Tactic(s)       : Collection
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:17:57.322064+00:00
  Reference       : https://attack.mitre.org/techniques/T1074/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_001_ESXi_Data_Staged_To_Local_Temp_Directory {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi shell command that archives or copies sensitive host or datastore content (VM datastore files, credential files, host configuration) into a world-writable local staging location such as /tmp, /var/tmp, /scratch, /dev/shm or /var/run. This is the typical precursor to exfiltration or ransomware data theft on a hypervisor."
    mitre_tactic = "Collection"
    mitre_technique = "T1074.001"
    mitre_technique_name = "Data Staged: Local Data Staging"
    log_prerequisites = "ESXi shell command auditing forwarded to Chronicle and parsed into PROCESS_LAUNCH events with target.process.command_line populated (shell.log or equivalent). Syslog forwarding must be enabled on the host."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Support-bundle or diagnostic collection by administrators, manual configuration backups (for example copying /etc/vmware before an upgrade), approved backup or migration scripts that stage data in /tmp or /scratch, and patching tooling that unpacks archives locally."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes, admin tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Add named administrators to %global_allowed_admin_users if they routinely collect support bundles. Raise severity for non-admin accounts or hosts that have recently had SSH enabled."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    // Native archive or copy utility invoked from the ESXi shell
    $proc.target.process.command_line = /(^|[\/\s])(tar|cp|gzip|zip|7z|7za|dd)\s/ nocase
    // Destination is a local staging directory
    $proc.target.process.command_line = /(\s|=|>)\/(tmp|var\/tmp|scratch|dev\/shm|var\/run)\// nocase
    // Source is datastore content, credential files or host configuration
    $proc.target.process.command_line = /\/vmfs\/volumes\/|\/etc\/(shadow|passwd|vmware\/)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1074.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $staging_command = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
