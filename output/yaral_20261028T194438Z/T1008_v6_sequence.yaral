/*
  MITRE Technique : T1008 - Fallback Channels
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:17:21.476137+00:00
  Reference       : https://attack.mitre.org/techniques/T1008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1008_ESXi_Firewall_Change_Then_Alternate_Channel {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an ESXi host firewall policy change made through esxcli, followed within ten minutes on the same host by an outbound tunnelling or raw socket utility (ssh port forwarding, nc, ncat, socat). This pattern is consistent with an operator opening or loosening egress rules and switching to an alternate command-and-control channel after the primary channel was blocked or lost."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1008"
    mitre_technique_name = "Fallback Channels"
    log_prerequisites = "ESXi shell and hostd command logging forwarded and parsed into UDM PROCESS_LAUNCH events with principal.hostname, principal.user.userid, target.process.file.full_path and target.process.command_line populated. Shell audit logging (shell.log or syslog forwarding) must be enabled on each host."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators changing firewall rulesets during host build, patching or troubleshooting and then using ssh or nc to test connectivity; backup and monitoring integrations that set up port-forwarded sessions; vendor support sessions."
    tuning_guidance = "Add approved admin accounts to %global_allowed_admin_users and approved tooling or parent processes to %global_allowed_admin_tools. Run known maintenance windows through a change-window exclusion. Raise the risk score or severity for hosts that are not expected to have SSH enabled."

  events:
    $fw.metadata.event_type = "PROCESS_LAUNCH"
    $fw.target.process.file.full_path = /\/esxcli$/ nocase
    $fw.target.process.command_line = /network\s+firewall\s+(ruleset|set)/ nocase
    $fw.target.process.command_line = /(--enabled\s+(true|false)|--allowed-all\s+true|allowedip\s+add|--ip-address)/ nocase
    not $fw.principal.user.userid in %global_allowed_admin_users
    not $fw.principal.process.file.full_path in %global_allowed_admin_tools
    $fw.principal.hostname = $hostname

    $chan.metadata.event_type = "PROCESS_LAUNCH"
    $chan.target.process.file.full_path = /\/(ssh|nc|ncat|socat)$/ nocase
    $chan.target.process.command_line = /(\s-[RDL]\s*\S*\d{2,5}\b|\s-[a-z]*[ze][a-z]*\s|\s\d{2,5}\s*$)/ nocase
    not $chan.principal.user.userid in %global_allowed_admin_users
    not $chan.principal.process.file.full_path in %global_allowed_admin_tools
    $chan.principal.hostname = $hostname

    $fw.metadata.event_timestamp.seconds <= $chan.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1008")
    $primary_entity = array_distinct($hostname)
    $firewall_commands = array_distinct($fw.target.process.command_line)
    $channel_commands = array_distinct($chan.target.process.command_line)
    $acting_users = array_distinct($chan.principal.user.userid)
    $channel_event_count = count($chan.metadata.id)

  condition:
    $fw and $chan
}
