/*
  MITRE Technique : T1497.003 - Time Based Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:05:38.189918+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_003_Time_Based_Sandbox_Evasion_Sleep_Timing_Check {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a PowerShell command line that samples the system clock or tick counter, calls a sleep function, and then calculates elapsed time. This is the classic sandbox time-acceleration check: the code sleeps and verifies that the expected time actually passed. The rule needs all three behaviours in one command line (time sample, sleep, elapsed-time calculation or comparison), which keeps fidelity high and does not depend on tool names or payloads."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1497.003"
    mitre_technique_name = "Virtualization/Sandbox Evasion: Time Based Checks"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command lines (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin scripts that benchmark or time operations, polling and retry loops that measure a timeout with Start-Sleep and Get-Date, software installers and health-check scripts run by RMM or deployment tooling, and developer or QA performance tests."
    tuning_guidance = "Add approved RMM, deployment and monitoring parent processes to %global_allowed_admin_tools or %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts. If timeout-loop scripts are noisy, raise the bar by requiring an additional discovery or execution indicator, or promote this to a sequence rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
    $proc.target.process.command_line = /(start-sleep|threading\.thread\]::sleep|\[thread\]::sleep|\bsleep\s+-(s|m|seconds|milliseconds))/ nocase
    $proc.target.process.command_line = /(get-date|\[datetime\]::(utc)?now|gettickcount|\[environment\]::tickcount|lastbootuptime|stopwatch|gettimeofday|getsystemtimeasfiletime)/ nocase
    $proc.target.process.command_line = /(new-timespan|\.subtract\(|\.totalseconds|\.totalmilliseconds|\.totalminutes|\s-(lt|le|gt|ge)\s|\)\s*-\s*\$[a-z_]+|\$[a-z_]+\s*-\s*\$[a-z_]+)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1497.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
