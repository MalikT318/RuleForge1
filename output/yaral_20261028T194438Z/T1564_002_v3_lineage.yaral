/*
  MITRE Technique : T1564.002 - Hidden Users
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:15:54.174276+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_002_Hidden_User_Registry_Write_Unexpected_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a write to the Winlogon SpecialAccounts UserList registry key, which hides an account from the Windows logon screen, by a process that does not normally manage accounts. Writers covered are Office applications, web server and database service processes, the print spooler, script interpreters and proxy-execution LOLBins. Detection pivots on the lineage anomaly of the writing process, not on a command line, so it covers hidden-user creation done through scripts, macros, web shells or injected code as well as reg.exe."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.002"
    mitre_technique_name = "Hide Artifacts: Hidden Users"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon registry value-set events) that populates principal.process.file.full_path and target.registry.registry_key. Registry auditing of the Winlogon\\SpecialAccounts key must be enabled where the agent does not collect it by default."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Enterprise kiosk, shared-workstation or service-account provisioning scripts that hide local accounts; image-build and deployment tooling run through PowerShell or cmd; IT admins hiding break-glass or management accounts by hand with reg.exe."
    tuning_guidance = "Add approved provisioning or deployment binaries to %global_allowed_admin_tools, approved automation hosts or parents to %global_allowed_script_hosts, and security agents to %global_allowed_security_tools. If a customer legitimately hides accounts at scale, scope the exclusion to the specific writer process rather than disabling the rule."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Winlogon\\SpecialAccounts\\UserList/ nocase
    $reg.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|onenote|w3wp|httpd|nginx|tomcat\d*|java|php-cgi|sqlservr|mysqld|spoolsv|powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32|wmic|msiexec|reg|certutil|bitsadmin)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_script_hosts
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1564.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $hidden_account_value = array_distinct($reg.target.registry.registry_value_name)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
