/*
  MITRE Technique : T1001.003 - Protocol or Service Impersonation
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:10:25.212094+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_003_Browser_UA_From_NonBrowser_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects outbound HTTP requests to external destinations where a script interpreter or LOLBin (not a browser) presents a browser-style User-Agent. This process/protocol-identity mismatch is characteristic of C2 frameworks that impersonate legitimate web traffic (malleable C2 profiles). Native PowerShell User-Agents are excluded so only spoofed identities fire."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001.003"
    mitre_technique_name = "Data Obfuscation: Protocol or Service Impersonation"
    log_prerequisites = "Requires EDR or network sensor NETWORK_HTTP telemetry that populates the originating process path and the HTTP User-Agent (network.http.user_agent)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrative or deployment scripts that deliberately set a browser User-Agent to download from vendor sites; mshta or HTA-based legacy business applications using the default MSIE-style User-Agent; developer build tooling (MSBuild, PowerShell web scraping); RMM and software packaging scripts."
    tuning_guidance = "Add approved automation parent or tooling paths to %global_allowed_admin_tools, approved hosts to %global_allowed_script_hosts, and known-good vendor or CDN domains to %global_allowed_domains. Consider adding service accounts to %global_allowed_service_accounts if a specific automation account is noisy."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|rundll32|regsvr32|msbuild|installutil|regasm|regsvcs|cmstp|msiexec)\.exe$/ nocase
    $http.network.http.user_agent = /^Mozilla\// nocase
    not $http.network.http.user_agent = /(WindowsPowerShell|PowerShell)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.principal.process.file.full_path in %global_allowed_admin_tools
    not $http.principal.hostname in %global_allowed_script_hosts
    not $http.principal.user.userid in %global_allowed_service_accounts
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1001.003")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_process = array_distinct($http.principal.process.file.full_path)
    $spoofed_user_agent = array_distinct($http.network.http.user_agent)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)

  condition:
    $http
}
