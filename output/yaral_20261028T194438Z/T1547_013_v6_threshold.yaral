/*
  MITRE Technique : T1547.013 - XDG Autostart Entries
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:41:19.172432+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_013_XDG_Autostart_Desktop_File_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several .desktop files are created in XDG autostart directories (/etc/xdg/autostart or a user's .config/autostart) on one host within 10 minutes. A single autostart entry is routine, but a burst of them from non-package-manager processes suggests persistence being planted for desktop login. Severity is scaled in outcome, with system-wide /etc/xdg writes scoring higher."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.013"
    mitre_technique_name = "Boot or Logon Autostart Execution: XDG Autostart Entries"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry with the writing process and target path populated (watch rules on /etc/xdg/autostart and ~/.config/autostart for auditd)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Desktop provisioning or first-login profile setup scripts, configuration management (Ansible, Puppet, Chef) pushing autostart entries, desktop environment first-run wizards, users installing several GUI apps via AppImage or manual installers, golden-image builds."
    tuning_guidance = "Add approved provisioning or config-management binaries to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Package-manager writers are already excluded by process name. Raise the threshold (#file >= 3) on VDI or developer-workstation fleets where autostart churn is common."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/etc\/xdg|\/home\/[^\/]+\/\.config|\/root\/\.config)\/autostart\/[^\/]+\.desktop$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|dnf|yum|zypper|pacman|packagekitd|snapd|flatpak)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(re.regex($file.target.file.full_path, /^\/etc\/xdg\//), 85, 65))
    $mitre_technique_id = array_distinct("T1547.013")
    $primary_entity = array_distinct($host)
    $file_count = count($file.metadata.id)
    $autostart_paths = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
