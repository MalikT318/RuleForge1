/*
  MITRE Technique : T1008 - Fallback Channels
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:16:58.754596+00:00
  Reference       : https://attack.mitre.org/techniques/T1008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1008_Linux_Egress_DNS_Over_TCP_Fallback {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux host making an outbound TCP connection on port 53 to an external destination. Standard DNS runs over UDP, and TCP/53 to the internet from a server is a known fallback channel when the primary C2 channel (HTTP/S) is blocked. Detection uses only perimeter network telemetry, so no endpoint process fields are used."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1008"
    mitre_technique_name = "Fallback Channels"
    log_prerequisites = "Requires firewall or perimeter NETWORK_CONNECTION logs with source/destination IP, destination port and IP protocol. The source asset must be enriched so principal.platform is populated as LINUX (for example from asset inventory or CMDB enrichment in Chronicle). The firewall does not report the initiating process."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Linux servers or resolvers configured to use public DNS resolvers over TCP; large DNS responses or zone transfers that fall back to TCP; DNS forwarders on Linux; security or monitoring tooling performing DNS health checks."
    tuning_guidance = "Add known-good external resolver or vendor domains to %global_allowed_domains. Keep %rfc1918_internal current so that internal resolvers are excluded. Restrict scope to egress segments that should not reach external DNS directly. If the tenant does not enrich principal.platform, remove that condition and scope by egress firewall zone."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.platform = "LINUX"
    $net.network.ip_protocol = "TCP"
    $net.target.port = 53
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1008")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)

  condition:
    $net
}
