/*
  MITRE Technique : T1014 - Rootkit
  Tactic(s)       : Stealth
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:26:11.598462+00:00
  Reference       : https://attack.mitre.org/techniques/T1014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1014_Linux_Hidden_Or_KernelMasquerade_Process_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound connection to a non-internal address from a Linux process that shows rootkit-style concealment traits. The process either runs from a volatile staging directory (/dev/shm, /tmp, /var/tmp, /run/shm), runs from a hidden dot-directory or dot-file inside a system path, or presents a kernel-thread style bracketed name such as [kworker/0:1] in its command line. Real kernel threads never open external sockets, so this pattern points to a userland implant hiding itself, a common rootkit companion for C2 or exfiltration."
    mitre_tactic = "Stealth"
    mitre_technique = "T1014"
    mitre_technique_name = "Rootkit"
    log_prerequisites = "Linux endpoint network telemetry (EDR or auditd SOCKADDR/connect records) that populates principal.process.file.full_path, principal.process.command_line, and target.ip on NETWORK_CONNECTION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers or installers staging binaries in /tmp or /var/tmp, containers and CI runners executing from /tmp, self-extracting or portable applications, in-memory JIT runtimes using /dev/shm, and legitimate software that installs into hidden directories under /var or /opt."
    tuning_guidance = "Add approved tooling binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Add approved remote support tooling to %global_allowed_remote_mgmt. Add known-good update or vendor destinations to %global_allowed_domains where hostname data is available. Review CI/build hosts and container hosts first and scope the rule down if /tmp execution is routine there."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname != ""
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    (
      $net.principal.process.file.full_path = /^\/(dev\/shm|run\/shm|tmp|var\/tmp)\// nocase or
      $net.principal.process.file.full_path = /^\/(usr|lib|lib64|var|etc|opt|boot|proc|dev|sys)\/(.*\/)?\.[^\/]+(\/|$)/ nocase or
      $net.principal.process.command_line = /^\[(kworker|ksoftirqd|kthreadd|migration|rcu_|watchdog|kswapd|khugepaged|jbd2)[^\]]*\]/ nocase
    )
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1014")
    $primary_entity = array_distinct($net.principal.hostname)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $process_cmdline = array_distinct($net.principal.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
