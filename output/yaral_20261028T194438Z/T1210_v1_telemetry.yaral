/*
  MITRE Technique : T1210 - Exploitation of Remote Services
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:16:17.720686+00:00
  Reference       : https://attack.mitre.org/techniques/T1210
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1210_Linux_NetworkService_Drops_Payload_Or_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing service daemon (web server, database, file-sharing, mail, FTP or cache service) creating a script or executable payload in a world-writable staging directory, or creating cron or systemd persistence files. Services do not normally write these artifacts, so this is a file-level indicator that a remote service was exploited and is running attacker-controlled code. It is independent of command-line logging."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1210"
    mitre_technique_name = "Exploitation of Remote Services"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-creation records (for example watches on /tmp, /var/tmp, /dev/shm, /etc/cron.*, /etc/systemd/system and /var/spool/cron) that populate principal.process.file.full_path and target.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web applications that write temporary shell or Python helper scripts (for example report generators, plugin installers, CMS updaters). Database maintenance or backup jobs run by the database daemon. Mail or FTP daemons using helper scripts. Configuration-management runs that execute through a service worker."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools and agents to %global_allowed_security_tools. For noisy applications, narrow the extension list or add the service binary to %global_allowed_admin_tools after review. Java and Node-based application servers are deliberately excluded because they routinely extract native libraries to /tmp; add them in a tenant-specific copy if required."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|php[0-9.]*|tomcat[0-9]*|mysqld|mariadbd|postgres|smbd|nmbd|redis-server|mongod|named|vsftpd|proftpd|exim4?|postfix|sendmail|dovecot)$/ nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+\.(sh|py|pl|so|elf|bin)$|^\/etc\/(cron\.[a-z]+\/|cron\.d\/|systemd\/system\/)|^\/var\/spool\/cron\// nocase
    $file.principal.hostname = $hostname
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1210")
    $primary_entity = array_distinct($hostname)
    $service_process = array_distinct($file.principal.process.file.full_path)
    $created_files = array_distinct($file.target.file.full_path)
    $service_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
