/*
  MITRE Technique : T1561 - Disk Wipe
  Tactic(s)       : Impact
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:03:37.790359+00:00
  Reference       : https://attack.mitre.org/techniques/T1561
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1561_Wiper_Worm_SMB_Then_RemoteExec_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects worm-like wiper propagation from the network perimeter view: one internal source makes many SMB (445) connections to internal destinations, then connects to remote execution ports (RPC endpoint mapper 135 or WinRM 5985/5986) within 10 minutes. Destructive disk-wiping malware spreads this way, copying itself over admin shares and then launching remotely before wiping disks."
    mitre_tactic = "Impact"
    mitre_technique = "T1561"
    mitre_technique_name = "Disk Wipe"
    log_prerequisites = "Requires firewall or east-west network flow logs normalised to UDM NETWORK_CONNECTION or NETWORK_FLOW, with principal.ip, target.ip, and target.port populated. Internal segmentation or datacenter firewalls must see the SMB traffic; perimeter-only logging will not."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Vulnerability scanners and asset discovery tools, patch and software deployment servers, domain controllers and file servers replicating with many peers, backup servers, RMM or remote administration consoles, and admin jump hosts."
    tuning_guidance = "Add approved scanner, patching, and management sources to %global_allowed_scanners and %global_allowed_mgmt_sources. Raise the #smb threshold in the condition for environments with chatty file servers. Confirm %rfc1918_internal covers the client's internal addressing. Alerts should be triaged alongside endpoint telemetry showing raw disk writes or boot configuration changes."

  events:
    $smb.metadata.event_type = "NETWORK_CONNECTION"
    $smb.target.port = 445
    $smb.target.ip in %rfc1918_internal
    not $smb.principal.ip in %global_allowed_scanners
    not $smb.principal.ip in %global_allowed_mgmt_sources
    $smb.principal.ip = $src

    $rpc.metadata.event_type = "NETWORK_CONNECTION"
    ($rpc.target.port = 135 or $rpc.target.port = 5985 or $rpc.target.port = 5986)
    $rpc.target.ip in %rfc1918_internal
    not $rpc.principal.ip in %global_allowed_scanners
    not $rpc.principal.ip in %global_allowed_mgmt_sources
    $rpc.principal.ip = $src

    $smb.metadata.event_timestamp.seconds <= $rpc.metadata.event_timestamp.seconds

  match:
    $src over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1561")
    $primary_entity = array_distinct($smb.principal.ip)
    $smb_destinations = array_distinct($smb.target.ip)
    $rpc_destinations = array_distinct($rpc.target.ip)
    $smb_connection_count = count($smb.metadata.id)
    $rpc_connection_count = count($rpc.metadata.id)

  condition:
    #smb >= 10 and #rpc >= 1
}
