/*
  MITRE Technique : T1132.002 - Non-Standard Encoding
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:47:57.617988+00:00
  Reference       : https://attack.mitre.org/techniques/T1132/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1132_002_Network_Encoded_Blob_In_HTTP_URL {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP(S) requests, as seen by a proxy or firewall, where the URL carries a very long unbroken run of Base64-style characters (including URL-safe or modified alphabets) in a query value or path segment. Non-standard or modified encodings of C2 data typically appear as long opaque blobs in URLs and diverge from normal application parameters. The rule works from network-side telemetry only and does not depend on endpoint process data."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1132.002"
    mitre_technique_name = "Data Encoding: Non-Standard Encoding"
    log_prerequisites = "Requires proxy or firewall logs with full URL visibility (TLS inspection or explicit proxy) normalised to UDM NETWORK_HTTP, with target.url, target.hostname, target.ip and principal.ip or principal.hostname populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "SaaS and analytics beacons, OAuth/SSO redirects and JWT-bearing URLs, cloud storage pre-signed URLs, software update and telemetry endpoints, ad and tracking pixels, and browser-based web apps passing serialised state in query strings."
    tuning_guidance = "Add known-good external domains (SaaS, update services, CDNs) to %global_allowed_domains. Raise or lower the {100,} run length in the regex to match the client's baseline. Add approved scanners or proxies to %global_allowed_scanners if they generate such URLs. Review repeat sources by principal host, since C2 beaconing tends to produce many alerts to the same destination."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /[?\/&=;][A-Za-z0-9+_\-%]{100,}={0,2}([&#;\/]|$)/
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1132.002")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $sample_url = array_distinct($net.target.url)

  condition:
    $net
}
