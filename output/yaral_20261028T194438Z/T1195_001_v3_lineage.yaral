/*
  MITRE Technique : T1195.001 - Compromise Software Dependencies and Development Tools
  Tactic(s)       : Initial Access
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:40:17.662268+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_001_Linux_Package_Manager_Spawns_Download_Exec_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a package manager or language runtime (npm, node, yarn, pip, python, gem, composer, cargo, maven, gradle) spawning a shell whose command line performs download-and-execute, decode-and-execute, staging to a world-writable directory, or a /dev/tcp reverse shell. This lineage anomaly is characteristic of malicious install or lifecycle hooks in compromised or typosquatted dependencies."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.001"
    mitre_technique_name = "Supply Chain Compromise: Compromise Software Dependencies and Development Tools"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry with parent and child process paths and full command lines populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate install scripts that fetch binaries (for example node-gyp, puppeteer or playwright browser downloads, rustup or Homebrew-style bootstrap scripts), CI/CD build agents, developer workstations, and internal build tooling that pipes curl output to a shell."
    tuning_guidance = "Add approved build or CI hosts to %global_allowed_script_hosts and approved package tooling or wrapper parent paths to %global_allowed_admin_tools. Extend the parent regex if the client uses other package managers. Review the matching command line and destination before suppressing."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(npm|npx|node|nodejs|yarn|pnpm|pip|pip3|python[0-9.]*|gem|bundle|composer|cargo|mvn|gradle)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ash)$/ nocase
    (
      $proc.target.process.command_line = /(curl|wget)[^|;]*\|\s*(sudo\s+)?(\/bin\/)?(ba|da|z)?sh\b/ nocase or
      $proc.target.process.command_line = /base64\s+(-d|--decode)[^|]*\|\s*(\/bin\/)?(ba|da)?sh\b/ nocase or
      $proc.target.process.command_line = /\/dev\/tcp\// nocase or
      $proc.target.process.command_line = /(curl|wget)[^;&|]*(-o|-O|>)\s*\/(tmp|var\/tmp|dev\/shm)\/[^;&|]*(;|&&)\s*(chmod|sh|bash|\.\/|\/(tmp|var\/tmp|dev\/shm)\/)/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1195.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
