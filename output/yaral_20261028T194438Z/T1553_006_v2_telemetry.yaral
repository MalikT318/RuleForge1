/*
  MITRE Technique : T1553.006 - Code Signing Policy Modification
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:08:39.692653+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_006_Code_Signing_Policy_Registry_Tamper {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry-level changes to Windows code signing enforcement settings, regardless of the tool or command line used. Covered settings: Driver Signing policy, Hypervisor-Enforced Code Integrity (HVCI), Code Integrity vulnerable driver blocklist, the Authenticode WinTrust Software Publishing State, and the CheckExeSignatures download setting. Attackers weaken these to load unsigned or self-signed drivers and code."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.006"
    mitre_technique_name = "Subvert Trust Controls: Code Signing Policy Modification"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 12/13/14 equivalent) normalised to REGISTRY_MODIFICATION with target.registry.registry_key and registry_value_name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Driver developers and test labs changing signing policy; enterprise security baselines or GPO and MDM pushes of HVCI or driver blocklist settings; OS servicing and feature updates; endpoint hardening or compliance tooling; IT deployment agents."
    tuning_guidance = "Add approved deployment, hardening and RMM binaries to %global_allowed_admin_tools, and EDR/AV agents to %global_allowed_security_tools. Add named admin accounts that legitimately manage these settings to %global_allowed_admin_users. Developer or test-lab hosts can be handled with a host-scoped exception at the tenant level. Check the process that wrote the change, and whether the host rebooted afterwards, when triaging."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(\\Control\\DeviceGuard\\Scenarios\\HypervisorEnforcedCodeIntegrity|\\Control\\CI\\Config|\\Driver Signing|\\WinTrust\\Trust Providers\\Software Publishing|\\Internet Explorer\\Download)(\\|$)/ nocase
    $reg.target.registry.registry_value_name = /^(Enabled|VulnerableDriverBlocklistEnable|Policy|BehaviorOnFailedVerify|State|CheckExeSignatures)$/ nocase
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1553.006")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $modified_value = array_distinct($reg.target.registry.registry_value_name)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
