/*
  MITRE Technique : T1115 - Clipboard Data
  Tactic(s)       : Collection
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:24:14.362825+00:00
  Reference       : https://attack.mitre.org/techniques/T1115
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1115_Clipboard_Read_By_Script_From_Suspicious_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a scripting interpreter reading clipboard contents (Get-Clipboard, the gcb alias, the .NET Clipboard class, or GetClipboardData P/Invoke) when launched by an Office application, script host, LOLBin or server process. Interactive admin use is excluded because the parent must be one that does not normally read user clipboards."
    mitre_tactic = "Collection"
    mitre_technique = "T1115"
    mitre_technique_name = "Clipboard Data"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 / Windows Event 4688 with command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate automation or helper scripts that read the clipboard, such as productivity macros, VBA add-ins, accessibility tooling, and RMM or desktop-automation agents. Developers testing scripts launched from an IDE or script host."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts and approved tooling to %global_allowed_admin_tools. Review repeat hits per host before allowlisting. Tighten the parent regex if a client has Office automation that legitimately reads the clipboard."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|powershell_ise|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(get-clipboard|\bgcb\b|windows\.forms\.clipboard|getclipboarddata)/ nocase
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|wscript|cscript|mshta|rundll32|regsvr32|wmiprvse|w3wp|sqlservr|msiexec)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1115")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
