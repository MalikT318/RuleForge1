/*
  MITRE Technique : T1021.006 - Windows Remote Management
  Tactic(s)       : Lateral Movement
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:44:26.001090+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_006_WinRM_Port_Fanout_Firewall {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single source opens a high volume of connections to the WinRM service ports (TCP 5985 HTTP and 5986 HTTPS) within ten minutes. One WinRM connection is routine administration, but many in a short window from one source indicates lateral movement or WinRM-based remote execution sweeps using valid accounts. Detection is based purely on network-observable behaviour (destination port and connection volume per source), so it is independent of the tooling used."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.006"
    mitre_technique_name = "Remote Services: Windows Remote Management"
    log_prerequisites = "Requires firewall, proxy or perimeter/internal segmentation logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. East-west (internal) traffic must pass through a logging firewall for this to be effective."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Approved RMM and patching platforms, configuration management servers, jump hosts and PAM gateways, monitoring and inventory systems polling many servers over WinRM, vulnerability scanners, and administrators running scripted fleet maintenance."
    tuning_guidance = "Add approved management servers and jump hosts to %global_allowed_mgmt_sources, scanners to %global_allowed_scanners, and RMM or remote management sources to %global_allowed_remote_mgmt. Raise the #net threshold in noisy environments (for example 25) or lower it for segments where WinRM should be rare. Review $destination_ips and $destination_count in the outcome to separate fan-out across many hosts from repeated connections to a single server."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port >= 5985
    $net.target.port <= 5986
    $net.principal.ip = $src_ip
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_remote_mgmt

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1021.006")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 10
}
