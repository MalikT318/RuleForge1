/*
  MITRE Technique : T1553.002 - Code Signing
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:01:45.018227+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_002_Code_Signing_Material_Staged_In_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of code signing certificate or private key containers (.pfx, .p12, .pvk, .spc) in user-writable staging locations by a process that is not an approved administrative, security or backup tool. This is file-creation telemetry rather than command-line matching. It covers stolen or exported signing material being staged for use in signing malware. The target platform is Windows; the 'alternate platform' angle was overridden by the mandatory Windows platform requirement, and the rule gains its coverage by using file-creation telemetry."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1553.002"
    mitre_technique_name = "Subvert Trust Controls: Code Signing"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developers exporting signing certificates for build pipelines, PKI administrators exporting certificates manually, users saving certificate files from a browser or email client, software installers that drop bundled PFX files."
    tuning_guidance = "Add approved PKI, build and deployment tooling to %global_allowed_admin_tools, certificate-enrolling automation accounts to %global_allowed_service_accounts, and backup agents to %global_allowed_backup_processes. Consider raising severity for hosts with no developer role."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata\\|downloads\\|desktop\\|documents\\)|users\\public\\|programdata\\|windows\\temp\\|\$recycle\.bin\\).*\.(pfx|p12|pvk|spc)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR)\.exe$/ nocase

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1553.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
