/*
  MITRE Technique : T1668 - Exclusive Control
  Tactic(s)       : Persistence
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:10:24.992823+00:00
  Reference       : https://attack.mitre.org/techniques/T1668
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1668_Remote_Access_Service_Disabled_Via_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a registry change that sets the Start value of a remote-access or legacy-protocol service (RDP, WinRM, SMB server, SMBv1, Remote Registry, SSH) to Disabled (4). Adversaries who have gained a foothold may close these entry points to keep other threat actors out and keep exclusive control of the host. The rule works on the registry state change, so it still fires when the command line is hidden or obfuscated, or when the change is made through an API or script."
    mitre_tactic = "Persistence"
    mitre_technique = "T1668"
    mitre_technique_name = "Exclusive Control"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon registry events, equivalent to Sysmon Event ID 12/13) that populates target.registry.registry_key, registry_value_name and registry_value_data."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Security hardening baselines (for example disabling SMBv1 or Remote Registry), GPO or DSC enforcement, vendor hardening tools, server decommissioning, image build and sysprep processes, administrators intentionally disabling RDP or WinRM."
    tuning_guidance = "Add approved hardening or configuration management binaries to %global_allowed_admin_tools, named administrators to %global_allowed_admin_users, and EDR or security agents to %global_allowed_security_tools. Review per-client hardening baselines first; if SMBv1 or Remote Registry disablement is standard, narrow the service list in the key regex. Raise severity for servers that do not have a documented hardening policy."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(CurrentControlSet|ControlSet\d+)\\Services\\(TermService|UmRdpService|SessionEnv|WinRM|LanmanServer|RemoteRegistry|mrxsmb10|sshd)$/ nocase
    $reg.target.registry.registry_value_name = "Start" nocase
    $reg.target.registry.registry_value_data = /^(4|0x0*4)$/
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1668")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $actor_process = array_distinct($reg.principal.process.file.full_path)
    $actor_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
