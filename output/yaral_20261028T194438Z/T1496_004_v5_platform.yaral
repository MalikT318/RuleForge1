/*
  MITRE Technique : T1496.004 - Cloud Service Hijacking
  Tactic(s)       : Impact
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:57:59.657857+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_004_Cloud_Messaging_Or_AI_Service_Enablement {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects control-plane changes that enable or unlock resource-intensive hosted services commonly abused for cloud service hijacking: lifting bulk email or SMS sending restrictions, enabling account-level sending, or granting access to hosted generative AI models. Adversaries with compromised credentials often enable these services first, then use them for spam or phishing campaigns or for LLM abuse at the victim's expense."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.004"
    mitre_technique_name = "Resource Hijacking: Cloud Service Hijacking"
    log_prerequisites = "Cloud control-plane audit logs (management API activity) ingested and normalised to UDM, with metadata.product_event_type populated with the API action name and principal.user.userid populated with the calling identity."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate onboarding of a new email, SMS or AI workload; cloud platform or DevOps teams provisioning new accounts or regions; infrastructure-as-code pipelines applying baseline account settings; approved innovation or data-science teams enabling model access."
    tuning_guidance = "Add approved automation identities to %global_allowed_cloud_principals and named cloud administrators to %global_allowed_admin_users. If the product_event_type values differ in the client's UDM parser, adjust the action-name regex. Consider raising severity when the caller is a newly created identity or the source is an unusual geography."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /^(PutAccountDetails|UpdateAccountSendingEnabled|PutAccountSendingAttributes|SetSMSAttributes|PutFoundationModelEntitlement|CreateFoundationModelAgreement|PutUseCaseForModelAccess)$/ nocase
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1496.004")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_actions = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)
    $target_resources = array_distinct($cloud.target.resource.name)

  condition:
    $cloud
}
