/*
  MITRE Technique : T1560 - Archive Collected Data
  Tactic(s)       : Collection
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:55:36.204084+00:00
  Reference       : https://attack.mitre.org/techniques/T1560
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1560_Archive_Created_In_Staging_Location {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a compressed archive (zip, 7z, rar, tar, gz and similar) in a common Windows staging location such as user Temp, Public, ProgramData, PerfLogs, Windows Temp or the Recycle Bin. Detection is based on the resulting file artifact rather than command-line content, so it still fires when the archiving tool or its arguments change, and when command-line logging is evaded. Archives staged in these writable, rarely-audited locations are a typical precursor to exfiltration."
    mitre_tactic = "Collection"
    mitre_technique = "T1560"
    mitre_technique_name = "Archive Collected Data"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters unpacking payloads into Temp or ProgramData; backup, imaging and diagnostic collection tools; IT support scripts bundling logs; crash-dump and log-bundling utilities; legitimate users saving archives to Public folders."
    tuning_guidance = "Add approved archiving, backup and deployment executables to %global_allowed_admin_tools and %global_allowed_backup_processes, and EDR or AV agents to %global_allowed_security_tools. Extend the process-name exclusion regex for noisy installer or updater binaries seen in the client environment. Consider raising severity when the creating process is a script host or LOLBin."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\public|programdata|windows\\temp|perflogs|\$recycle\.bin|users\\[^\\]+\\appdata\\local\\temp)\\.*\.(zip|zipx|7z|rar|tar|tgz|gz|bz2|xz)$/ nocase
    not $file.principal.process.file.full_path = /\\(msiexec|TiWorker|TrustedInstaller|MsMpEng|MsSense|SenseIR|wuauclt|svchost)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1560")
    $primary_entity = array_distinct($file.principal.hostname)
    $archive_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
