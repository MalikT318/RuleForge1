/*
  MITRE Technique : T1135 - Network Share Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:05:11.309692+00:00
  Reference       : https://attack.mitre.org/techniques/T1135
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1135_Linux_SMB_Connection_Burst_Share_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single Linux host opens a high volume of outbound SMB connections (TCP 445/139) within ten minutes. A single SMB connection is benign, but a burst indicates sweeping for network shares, such as scripted smbclient, smbmap, or crackmapexec-style enumeration, or a custom tool. Detection is based on network behaviour, not command-line content, so it complements process-creation rules."
    mitre_tactic = "Discovery"
    mitre_technique = "T1135"
    mitre_technique_name = "Network Share Discovery"
    log_prerequisites = "Requires Linux endpoint network telemetry (EDR network events or auditd connect syscalls) normalised to NETWORK_CONNECTION with principal.hostname, target.ip and target.port populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Vulnerability scanners and asset inventory tools, backup agents, file-server migration or sync jobs, automounters and cifs/autofs clients touching many file servers, configuration management or RMM agents, admins running audits."
    tuning_guidance = "Add scanner hosts to %global_allowed_scanners, approved backup/sync/inventory binaries to %global_allowed_admin_tools, and service accounts to %global_allowed_service_accounts. The condition counts SMB connections, not distinct destinations, so review $destination_ips in the outcome. Raise the #net threshold in busy file-server or jump-host environments, and lower it for sensitive segments."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 445 or $net.target.port = 139)
    $net.target.ip != ""
    $net.principal.hostname = $host
    not $net.principal.hostname in %global_allowed_scanners
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($net.target.port = 445, 65, 55))
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1135")
    $primary_entity = array_distinct($host)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_processes = array_distinct($net.principal.process.file.full_path)
    $initiating_users = array_distinct($net.principal.user.userid)

  condition:
    #net >= 20
}
