/*
  MITRE Technique : T1027.017 - SVG Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:05:06.817048+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/017
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_017_SVG_Direct_Fetch_From_External_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows browser-style client directly retrieving an SVG file (.svg/.svgz) from an external host with no referring page. SVG smuggling lures typically arrive as a link in an email or chat message, so the SVG is loaded as a top-level document. In that case the browser sends no Referer header, unlike legitimate SVG sub-resources, which are fetched by a parent web page. The SVG can carry embedded script that assembles or downloads a payload or redirects the user."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.017"
    mitre_technique_name = "Obfuscated Files or Information: SVG Smuggling"
    log_prerequisites = "Requires forward-proxy or secure web gateway logs normalised to NETWORK_HTTP with target.url, network.http.method, network.http.response_code, network.http.user_agent and network.http.referral_url populated. TLS inspection is needed to see full URLs for HTTPS traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Users opening links to legitimate SVG assets (logos, diagrams, documentation, icon sets) from a typed or bookmarked URL. Developers and designers browsing SVG repositories or CDNs. Web apps that fetch SVGs without sending a Referer header, for example under a strict referrer policy."
    tuning_guidance = "Add known-good CDN, vendor and asset domains to %global_allowed_domains. Confirm that the proxy populates network.http.referral_url; if it does not, the empty-referrer condition will match every SVG request, so remove that line or restrict the rule to proxies that log it. Raise severity when the same host also shows a subsequent download of an archive, script or executable, or a PROCESS_LAUNCH from a browser."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET"
    $net.network.http.response_code = 200
    $net.target.url = /\.svgz?([?#].*)?$/ nocase
    $net.network.http.user_agent = /Mozilla\/.*Windows NT/ nocase
    $net.network.http.referral_url = ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1027.017")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $requested_urls = array_distinct($net.target.url)
    $destination_hosts = array_distinct($net.target.hostname)

  condition:
    $net
}
