/*
  MITRE Technique : T1216.002 - SyncAppvPublishingServer
  Tactic(s)       : Stealth
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:36:58.491429+00:00
  Reference       : https://attack.mitre.org/techniques/T1216/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1216_002_AppV_Publishing_Script_PowerShell_Injection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows script host running the App-V publishing sync script and spawning PowerShell with extra statements chained after the sync cmdlet's argument (for example `n; {payload}`). This is the proxy-execution pattern used to run arbitrary PowerShell through a signed Microsoft script. Legitimate App-V syncs do not chain additional statements. The ATT&CK technique is Windows-only, so the Linux/macOS/cloud angle was not applied and this variant targets a different Windows telemetry angle: the child PowerShell command line."
    mitre_tactic = "Stealth"
    mitre_technique = "T1216.002"
    mitre_technique_name = "System Script Proxy Execution: SyncAppvPublishingServer"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 / Windows Event 4688 with command-line auditing, populated for both the parent and child process."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Enterprise App-V deployments with custom publishing-refresh wrappers, software packaging and testing teams, and admins troubleshooting App-V client sync. Legitimate syncs normally pass only server-URL style arguments and do not chain statements."
    tuning_guidance = "Add App-V automation and packaging accounts to %global_allowed_service_accounts, and named administrators to %global_allowed_admin_users. Add approved packaging tooling that launches PowerShell to %global_allowed_admin_tools. Review hits where the chained payload contains download, encoding, or hidden-window arguments first."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(wscript|cscript)\.exe$/ nocase
    $proc.principal.process.command_line = /SyncAppvPublishingServer/ nocase
    $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
    $proc.target.process.command_line = /Sync-?AppvPublishingServer[^;]{0,200};\s*\S/ nocase
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1216.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_command_line = array_distinct($proc.principal.process.command_line)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
