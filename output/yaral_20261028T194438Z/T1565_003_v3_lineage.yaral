/*
  MITRE Technique : T1565.003 - Runtime Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:43:30.101310+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_003_Unexpected_Parent_Spawns_Shell_Data_Manipulation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office application, web server, database service or print spooler spawning a shell or script interpreter whose command line changes file associations or tampers with executable and library files. This is a runtime data manipulation pattern: the adversary alters how data is opened or displayed, or replaces the application that displays it. The parent-child lineage is the primary signal, and the command-line combination narrows it to manipulation activity."
    mitre_tactic = "Impact"
    mitre_technique = "T1565.003"
    mitre_technique_name = "Data Manipulation: Runtime Data Manipulation"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web or database application installers and updaters that run shell commands. Office add-ins or macros that legitimately register file handlers. Software deployment run from a web-hosted management console. Print driver installation scripts launched by the spooler. Admin maintenance scripts run through application servers."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts and deployment or RMM tooling to %global_allowed_admin_tools. Add known automation accounts to %global_allowed_service_accounts. If a client runs a line-of-business web or database application that legitimately spawns shells, allowlist that parent by executable name rather than by install path."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|w3wp|httpd|nginx|php-cgi|tomcat\d*|sqlservr|mysqld|postgres|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(\bassoc\s+\.\w+\s*=|\bftype\s+\S+\s*=|\\shell\\open\\command|\\explorer\\fileexts\\|\\software\\classes\\\.\w+|\b(takeown|icacls|cacls)\b.*\.(exe|dll)\b|\b(copy|xcopy|move|robocopy|replace)\b.*\.(exe|dll)\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1565.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
