/*
  MITRE Technique : T1561.001 - Disk Content Wipe
  Tactic(s)       : Impact
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:04:55.270221+00:00
  Reference       : https://attack.mitre.org/techniques/T1561/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1561_001_SMB_Then_RemoteExec_Wiper_Propagation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the network-observable propagation precursor to a destructive disk wipe. A firewall cannot see the wipe itself, so this rule looks for the worm-like spread described for T1561.001. One source opens an SMB session to a destination and, within 10 minutes, opens a remote-execution channel (RPC endpoint mapper, WinRM HTTP or WinRM HTTPS) to the same destination. This is the usual push-and-execute pattern wiper malware uses to reach many hosts."
    mitre_tactic = "Impact"
    mitre_technique = "T1561.001"
    mitre_technique_name = "Disk Wipe: Disk Content Wipe"
    log_prerequisites = "Firewall, proxy or perimeter connection logs with source IP, destination IP and destination port populated. The firewall must see east-west or inter-segment traffic."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Domain administrators and patching or software deployment tools that copy files over SMB and then run remote commands. Vulnerability scanners, configuration management servers and backup orchestration."
    tuning_guidance = "Add scanner source addresses to %global_allowed_scanners and approved admin or jump hosts to %global_allowed_mgmt_sources. Raise the window or require fan-out to several destinations if noisy. Review the destination_count and destination_ips outcomes for broad fan-out, which is the strongest wiper-spread signal."

  events:
    $smb.metadata.event_type = "NETWORK_CONNECTION"
    $smb.target.port = 445
    $smb.principal.ip = $src
    $smb.target.ip = $dst
    not $smb.principal.ip in %global_allowed_scanners
    not $smb.principal.ip in %global_allowed_mgmt_sources

    $rexec.metadata.event_type = "NETWORK_CONNECTION"
    ($rexec.target.port = 135 or $rexec.target.port = 5985 or $rexec.target.port = 5986)
    $rexec.principal.ip = $src
    $rexec.target.ip = $dst
    not $rexec.principal.ip in %global_allowed_scanners
    not $rexec.principal.ip in %global_allowed_mgmt_sources

    $smb.metadata.event_timestamp.seconds <= $rexec.metadata.event_timestamp.seconds

  match:
    $src, $dst over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1561.001")
    $primary_entity = array_distinct($src)
    $destination_ips = array_distinct($dst)
    $destination_count = count($rexec.metadata.id)
    $smb_connection_count = count($smb.metadata.id)
    $remote_exec_ports = array_distinct($rexec.target.port)

  condition:
    $smb and $rexec
}
