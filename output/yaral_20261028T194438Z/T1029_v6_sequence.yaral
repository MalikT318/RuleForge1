/*
  MITRE Technique : T1029 - Scheduled Transfer
  Tactic(s)       : Exfiltration
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:50:35.052521+00:00
  Reference       : https://attack.mitre.org/techniques/T1029
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1029_Linux_Repeated_Alt_Protocol_Outbound_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects two large outbound transfers from the same internal source to the same external destination on file-transfer ports (FTP, SFTP/SCP, rsync, FTPS) within ten minutes. This repeat pattern indicates scheduled or interval-based exfiltration, such as a cron job or systemd timer on a Linux host pushing data out in batches. Detection uses perimeter flow telemetry only (destination, port, volume, timing)."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1029"
    mitre_technique_name = "Scheduled Transfer"
    log_prerequisites = "Requires firewall, proxy, or perimeter NETWORK_FLOW telemetry with principal.ip, target.ip, target.port, and network.sent_bytes populated. Egress traffic from Linux servers must traverse the logging perimeter."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Scheduled off-site backups over SFTP or rsync, log shipping, vendor file-exchange jobs, mirror or repository synchronisation, and automated data-feed deliveries to partners."
    tuning_guidance = "Add known-good partner or backup destination domains to %global_allowed_domains. Raise or lower the network.sent_bytes threshold to suit client baseline volumes. Extend or trim the port list for client-specific transfer protocols. Internal destinations are already excluded via %rfc1918_internal."

  events:
    $first.metadata.event_type = "NETWORK_FLOW"
    $first.principal.ip = $src_ip
    $first.target.ip = $dst_ip
    (
      $first.target.port = 21 or
      $first.target.port = 22 or
      $first.target.port = 873 or
      $first.target.port = 990 or
      $first.target.port = 2121
    )
    $first.network.sent_bytes > 1000000
    not $first.target.ip in %rfc1918_internal
    not $first.target.hostname in %global_allowed_domains

    $second.metadata.event_type = "NETWORK_FLOW"
    $second.principal.ip = $src_ip
    $second.target.ip = $dst_ip
    (
      $second.target.port = 21 or
      $second.target.port = 22 or
      $second.target.port = 873 or
      $second.target.port = 990 or
      $second.target.port = 2121
    )
    $second.network.sent_bytes > 1000000
    not $second.target.ip in %rfc1918_internal
    not $second.target.hostname in %global_allowed_domains

    $first.metadata.event_timestamp.seconds < $second.metadata.event_timestamp.seconds

  match:
    $src_ip, $dst_ip over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1029")
    $primary_entity = array_distinct($src_ip)
    $destination_ips = array_distinct($dst_ip)
    $destination_ports = array_distinct($second.target.port)
    $max_first_sent_bytes = max($first.network.sent_bytes)
    $max_second_sent_bytes = max($second.network.sent_bytes)
    $first_seen = min($first.metadata.event_timestamp.seconds)
    $last_seen = max($second.metadata.event_timestamp.seconds)

  condition:
    $first and $second
}
