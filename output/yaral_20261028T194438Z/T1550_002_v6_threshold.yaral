/*
  MITRE Technique : T1550.002 - Pass the Hash
  Tactic(s)       : Lateral Movement
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:39:56.222444+00:00
  Reference       : https://attack.mitre.org/techniques/T1550/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1550_002_NTLM_Network_Logon_Volume_Single_Account {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single non-machine account produces a high volume of NTLM network logons (logon type 3) within ten minutes. This is consistent with pass-the-hash lateral movement, where a stolen NTLM hash is replayed against one or more systems. A single NTLM network logon is routine; sustained volume for one account is not."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1550.002"
    mitre_technique_name = "Use Alternate Authentication Material: Pass the Hash"
    log_prerequisites = "Requires Windows Security event 4624 (logon type 3, authentication package NTLM) normalised to UDM USER_LOGIN. Needs extensions.auth.mechanism and extensions.auth.auth_details to be populated by the parser. Collect from servers and domain controllers."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy applications and file or print clients that fall back to NTLM, scheduled jobs and backup agents using named accounts, vulnerability scanners with credentialed scans, IT admins running bulk remote management, and misconfigured SPNs that force NTLM instead of Kerberos."
    tuning_guidance = "Add expected automation accounts to %global_allowed_service_accounts, credentialed scanner sources to %global_allowed_scanners, and administrators to %global_allowed_admin_users. Raise the #auth threshold on noisy file servers or domain controllers. Scale severity upward when array_distinct($target_hosts) shows many distinct systems."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.extensions.auth.mechanism = "NETWORK"
    $auth.extensions.auth.auth_details = /NTLM/ nocase
    $auth.target.user.userid = $user
    not $auth.target.user.userid = /\$$/
    not $auth.target.user.userid = /^(anonymous logon|-)$/ nocase
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.principal.hostname in %global_allowed_scanners

  match:
    $user over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1550.002")
    $primary_entity = array_distinct($user)
    $event_count = count($auth.metadata.id)
    $target_hosts = array_distinct($auth.target.hostname)
    $source_hosts = array_distinct($auth.principal.hostname)
    $source_ips = array_distinct($auth.principal.ip)

  condition:
    #auth >= 10
}
