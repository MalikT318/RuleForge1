/*
  MITRE Technique : T1569.002 - Service Execution
  Tactic(s)       : Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:11:59.428302+00:00
  Reference       : https://attack.mitre.org/techniques/T1569/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_002_SCM_Binary_External_SMB_RPC_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Windows service control manager client (sc.exe) or the service control manager (services.exe) opening SMB or RPC connections (TCP 135/139/445) to non-internal addresses. Remote service creation and execution uses MSRPC/SMB to the target's service control manager. Legitimate use of this path to an external address is rare, so it indicates remote service execution toward an internet-facing host, a misrouted or tunnelled lateral movement attempt, or exposed SMB/RPC abuse."
    mitre_tactic = "Execution"
    mitre_technique = "T1569.002"
    mitre_technique_name = "System Services: Service Execution"
    log_prerequisites = "Requires endpoint network connection telemetry (EDR or Sysmon Event ID 3) that populates the initiating process path, target IP and target port."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators managing services on remote hosts reached over VPN or NAT with public addressing, cloud-hosted Windows servers managed from corporate endpoints, MSP or RMM tooling that uses sc.exe against customer-owned public IPs, and split-tunnel VPN clients whose internal addresses appear as non-RFC1918."
    tuning_guidance = "Add approved management source addresses to %global_allowed_mgmt_sources. Add sanctioned admin or RMM parent binaries to %global_allowed_admin_tools. Confirm %rfc1918_internal covers all private ranges used by the client, including VPN pools."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(sc|services)\.exe$/ nocase
    (
      $net.target.port = 445 or
      $net.target.port = 135 or
      $net.target.port = 139
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1569.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $initiating_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
