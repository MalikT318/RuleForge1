/*
  MITRE Technique : T1547.006 - Kernel Modules and Extensions
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:33:21.039679+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_006_Linux_Kernel_Module_File_Staging_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects several kernel module files (.ko, .ko.xz, .ko.zst, .ko.gz) created on one Linux host within ten minutes, either in world-writable or user-controlled staging locations or inside the kernel module tree, by something other than a package manager or module build tool. Creating one module file can be benign, but repeated creation outside normal package or DKMS workflows suggests LKM rootkit staging or installation for boot persistence."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.006"
    mitre_technique_name = "Boot or Logon Autostart Execution: Kernel Modules and Extensions"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-write events (FILE_CREATION) with populated target.file.full_path and principal.process.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package manager kernel or driver updates, DKMS rebuilds after kernel upgrades, out-of-tree driver installers (GPU, VPN, hypervisor guest additions), kernel developers building modules, configuration management pushing approved drivers."
    tuning_guidance = "Add approved deployment, driver installer or build tooling to %global_allowed_admin_tools. Add approved automation accounts to %global_allowed_service_accounts. Raise the #file threshold on build servers or kernel developer hosts. Extend the executable-name exclusion if the client uses another package or module build tool."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|root|home\/[^\/]+|usr\/lib\/modules|lib\/modules)\/.*\.ko(\.(xz|zst|gz))?$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\/(dpkg|rpm|dnf|yum|apt|apt-get|aptitude|dkms|kmod|depmod|modprobe|update-initramfs|dracut|mkinitcpio|pacman|zypper|packagekitd|unattended-upgr)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1547.006")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $module_paths = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
