/*
  MITRE Technique : T1113 - Screen Capture
  Tactic(s)       : Collection
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:14:17.245424+00:00
  Reference       : https://attack.mitre.org/techniques/T1113
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1113_Linux_Screenshot_Staged_Then_Exfil_Channel {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "An image file (png, jpg, bmp, gif, xwd, ppm) is written to a world-writable staging directory (/tmp, /var/tmp, /dev/shm) by a non-browser process. The same host then makes an external connection from a generic transfer or scripting utility within 10 minutes. This pattern matches screen capture followed by staging and exfiltration. It is file-write and network based, not command-line based, so it complements process-creation screenshot rules."
    mitre_tactic = "Collection"
    mitre_technique = "T1113"
    mitre_technique_name = "Screen Capture"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that produces FILE_CREATION events with process attribution and NETWORK_CONNECTION events with process attribution, both carrying principal.hostname."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Users saving screenshots or exported charts to /tmp and uploading them to a support ticket or cloud service. Headless browser or test automation (Selenium, CI runners) that renders images to /tmp. Documentation or monitoring tools that generate graphs and push them externally. Remote support tooling."
    tuning_guidance = "Add approved screenshot, reporting and automation tooling to %global_allowed_admin_tools. Add approved support and remote-access tooling to %global_allowed_remote_mgmt. Add CI and automation hosts or parent processes to %global_allowed_script_hosts. Add backup agents to %global_allowed_backup_processes. Add EDR and security agents to %global_allowed_security_tools. Extend the browser exclusion regex if other known renderers create image files in /tmp."

  events:
    $shot.metadata.event_type = "FILE_CREATION"
    $shot.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.*\.(png|jpe?g|bmp|gif|xwd|ppm)$/ nocase
    not $shot.principal.process.file.full_path = /\/(firefox|firefox-bin|chrome|chromium|chromium-browser|brave|opera|msedge)$/ nocase
    not $shot.principal.process.file.full_path in %global_allowed_admin_tools
    not $shot.principal.process.file.full_path in %global_allowed_security_tools
    not $shot.principal.process.file.full_path in %global_allowed_backup_processes
    not $shot.principal.process.file.full_path in %global_allowed_script_hosts
    $shot.principal.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(curl|wget|nc|ncat|netcat|socat|python[0-9.]*|perl|ruby|scp|sftp|rclone)$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    $net.principal.hostname = $hostname

    $shot.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1113")
    $primary_entity = array_distinct($hostname)
    $image_files = array_distinct($shot.target.file.full_path)
    $capture_processes = array_distinct($shot.principal.process.file.full_path)
    $transfer_processes = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $image_count = count($shot.metadata.id)

  condition:
    $shot and $net
}
