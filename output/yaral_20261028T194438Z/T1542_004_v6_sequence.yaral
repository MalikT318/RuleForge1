/*
  MITRE Technique : T1542.004 - ROMMONkit
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:49:29.210495+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_004_ROMMON_Mgmt_Access_Then_TFTP_Image_Pull {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a network device receiving an administrative SSH or Telnet session from an unapproved source and, within ten minutes, initiating a TFTP request (UDP/69) to a server that is not an approved management or config source. This is the network-observable precursor to a ROMMON or boot image replacement (T1542.004). The reload and the image itself are not visible in perimeter logs, so this rule flags the staging behaviour."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.004"
    mitre_technique_name = "Pre-OS Boot: ROMMONkit"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip, target.port and network.ip_protocol populated. The firewall must see both management-plane sessions to the device and TFTP traffic originating from the device. Populate %global_allowed_mgmt_sources with approved admin jump hosts and approved TFTP/config servers."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Planned firmware upgrades or config backups performed from an admin workstation not yet in the allowlist, network automation or provisioning systems, zero-touch provisioning of new devices, and lab or staging devices that use TFTP routinely."
    tuning_guidance = "Add approved admin jump hosts and approved TFTP/config servers to %global_allowed_mgmt_sources; either side matching removes the event. If the firewall logs TFTP as NETWORK_FLOW instead of NETWORK_CONNECTION, change the event type on $tftp. Correlate hits with change-management windows. Consider raising severity if the TFTP server is external."

  events:
    $mgmt.metadata.event_type = "NETWORK_CONNECTION"
    ($mgmt.target.port = 22 or $mgmt.target.port = 23)
    $mgmt.target.ip != ""
    not $mgmt.principal.ip in %global_allowed_mgmt_sources
    $mgmt.target.ip = $device_ip

    $tftp.metadata.event_type = "NETWORK_CONNECTION"
    $tftp.target.port = 69
    $tftp.network.ip_protocol = "UDP"
    not $tftp.target.ip in %global_allowed_mgmt_sources
    $tftp.principal.ip = $device_ip

    $mgmt.metadata.event_timestamp.seconds <= $tftp.metadata.event_timestamp.seconds

  match:
    $device_ip over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1542.004")
    $primary_entity = array_distinct($device_ip)
    $mgmt_source_ips = array_distinct($mgmt.principal.ip)
    $tftp_server_ips = array_distinct($tftp.target.ip)
    $mgmt_session_count = count($mgmt.metadata.id)
    $tftp_request_count = count($tftp.metadata.id)

  condition:
    $mgmt and $tftp
}
