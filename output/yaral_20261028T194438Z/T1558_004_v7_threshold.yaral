/*
  MITRE Technique : T1558.004 - AS-REP Roasting
  Tactic(s)       : Credential Access
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:47:06.873132+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_004_ASREP_Roasting_Preauth_Enumeration_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated process launches on a single host within ten minutes whose command lines enumerate Active Directory accounts with Kerberos preauthentication disabled (DoesNotRequirePreAuth attribute or the DONT_REQ_PREAUTH userAccountControl bit 4194304 via LDAP bitwise matching). This is the target-discovery step that precedes AS-REP Roasting. A single query is common in AD audits, but several in a short window on one host indicates targeted roasting preparation."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.004"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: AS-REP Roasting"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command lines (EDR, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "AD hygiene and security audit scripts that look for accounts without preauthentication, identity-governance tooling, authorised red team and vulnerability scanning exercises, and admins manually reviewing account flags."
    tuning_guidance = "Add approved audit and admin tooling to %global_allowed_admin_tools, authorised scanner hosts or binaries to %global_allowed_scanners, and named administrator accounts to %global_allowed_admin_users. Raise the #proc threshold in noisy environments where scheduled AD audits run regularly."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(DoesNotRequirePreAuth|userAccountControl:1\.2\.840\.113556\.1\.4\.803:=4194304|userAccountControl\s*-band\s*4194304)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_scanners
    not $proc.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1558.004")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
