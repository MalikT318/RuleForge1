/*
  MITRE Technique : T1049 - System Network Connections Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:39:00.844536+00:00
  Reference       : https://attack.mitre.org/techniques/T1049
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1049_Outbound_SMB_RPC_NetBIOS_To_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a perimeter connection to an external destination on the Windows session and connection enumeration ports (RPC 135, NetBIOS 137/139, SMB 445). Net use and net session query remote systems over these protocols, so traffic on them leaving the network suggests remote connection or session discovery, or a probe of an exposed Windows service. Endpoint command-line rules do not see this activity. Detection relies only on destination port and the absence of an internal destination."
    mitre_tactic = "Discovery"
    mitre_technique = "T1049"
    mitre_technique_name = "System Network Connections Discovery"
    log_prerequisites = "Firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Egress traffic must be logged, including denied connections. Requires the %rfc1918_internal list to be populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate SMB or RPC to cloud file services over VPN or direct tunnels, hybrid Azure Files or remote office shares reached by public address, authorised vulnerability scanners and external attack-surface tools, misconfigured clients and malware-driven worm noise, M&A or partner file-share integrations."
    tuning_guidance = "Add authorised scanner source IPs to %global_allowed_scanners. Add approved management or jump-host source IPs to %global_allowed_mgmt_sources. Keep %rfc1918_internal current so internal traffic is excluded. For hybrid cloud shares, exclude the known destinations by tenant or consider a higher-volume Threshold variant."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 135 or
      $net.target.port = 137 or
      $net.target.port = 139 or
      $net.target.port = 445
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1049")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
