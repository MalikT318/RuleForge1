/*
  MITRE Technique : T1548.005 - Temporary Elevated Cloud Access
  Tactic(s)       : Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:34:56.481150+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_005_Cloud_Temporary_Elevation_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single identity performs a burst of role activation, role assumption, impersonation or permission-grant operations within 10 minutes. Each operation is normally benign, but repeated temporary elevation by one principal suggests abuse of just-in-time access, role passing or service-account impersonation to gain short-term privileges."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.005"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Temporary Elevated Cloud Access"
    log_prerequisites = "Cloud control-plane audit logs (IaaS audit trail, activity log or admin audit) and identity directory audit logs, normalised to UDM USER_CHANGE_PERMISSIONS with principal.user.userid and metadata.product_event_type populated."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Administrators activating just-in-time roles for planned maintenance, CI/CD pipelines and automation assuming roles repeatedly, onboarding or migration projects granting many roles, break-glass drills."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, cloud service principals to %global_allowed_cloud_principals and named administrators to %global_allowed_admin_users. Raise the #perm threshold for tenants with heavy automated role assumption."

  events:
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.metadata.product_event_type = /(elevat|assume|impersonat|activate|token|passrole|roleassign|setiampolicy|grant|addmember)/ nocase
    $perm.principal.user.userid = $user
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_cloud_principals
    not $perm.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($perm.metadata.id)
    $mitre_technique_id = array_distinct("T1548.005")
    $primary_entity = array_distinct($user)
    $operations = array_distinct($perm.metadata.product_event_type)
    $target_users = array_distinct($perm.target.user.userid)
    $source_ips = array_distinct($perm.principal.ip)

  condition:
    #perm >= 5
}
