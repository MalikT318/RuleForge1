/*
  MITRE Technique : T1559.002 - Dynamic Data Exchange
  Tactic(s)       : Execution
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:54:29.257527+00:00
  Reference       : https://attack.mitre.org/techniques/T1559/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_002_Office_Spawned_Shell_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Network-side detection of Dynamic Data Exchange (DDE) abuse. A command interpreter or LOLBin whose parent process is a Microsoft Office application (Word, Excel, PowerPoint, Outlook) makes an outbound connection to a non-internal address. A poisoned document or CSV using DDE typically launches a shell from Office, and that shell then pulls down a payload. The rule looks at the network behaviour of the Office-spawned child, not the document content."
    mitre_tactic = "Execution"
    mitre_technique = "T1559.002"
    mitre_technique_name = "Inter-Process Communication: Dynamic Data Exchange"
    log_prerequisites = "Endpoint network telemetry that populates the parent process path of the connecting process (EDR network connection events or Sysmon Event ID 3 enriched with process lineage). Internal ranges must be maintained in %rfc1918_internal."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office add-ins or macros that legitimately launch a script host to call a web service, line-of-business integrations driven from Excel or Outlook, RMM or deployment tooling launched from Office, and mail-merge or reporting workflows that call external APIs."
    tuning_guidance = "Add approved tooling binaries to %global_allowed_admin_tools and approved script-hosting binaries to %global_allowed_script_hosts. Keep %rfc1918_internal current for each client. If a client has a legitimate Office-to-script workflow, scope it by adding the child process path to %global_allowed_script_hosts rather than disabling the rule."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.parent_process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio)\.exe$/ nocase
    $net.principal.process.file.full_path = /\\(cmd|powershell|pwsh|mshta|certutil|bitsadmin|regsvr32|rundll32|wscript|cscript|msiexec|curl)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1559.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $user = array_distinct($net.principal.user.userid)
    $office_parent = array_distinct($net.principal.process.parent_process.file.full_path)
    $child_process = array_distinct($net.principal.process.file.full_path)
    $child_command_line = array_distinct($net.principal.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
