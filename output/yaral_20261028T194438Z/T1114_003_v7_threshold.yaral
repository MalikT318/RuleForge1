/*
  MITRE Technique : T1114.003 - Email Forwarding Rule
  Tactic(s)       : Collection
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:22:43.057395+00:00
  Reference       : https://attack.mitre.org/techniques/T1114/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_003_Mailbox_Forwarding_Rule_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a single user account creating or modifying several mailbox inbox, forwarding or transport rules within ten minutes. One rule change is routine, but a burst of them from one account is typical of an adversary setting up mail forwarding or redirection to collect email and persist after a credential reset."
    mitre_tactic = "Collection"
    mitre_technique = "T1114.003"
    mitre_technique_name = "Email Collection: Email Forwarding Rule"
    log_prerequisites = "Requires unified audit logs with mailbox administration and inbox-rule operations ingested and normalised to UDM, with metadata.product_event_type and principal.user.userid populated."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Users reorganising mail after joining a new team, assistants managing a delegated mailbox, IT onboarding or offboarding scripts that set mailbox forwarding in bulk, migration tooling, and shared-mailbox administration."
    tuning_guidance = "Add automation and migration accounts to %global_allowed_service_accounts and helpdesk or mail administrators to %global_allowed_admin_users. Raise the #audit threshold for tenants with heavy bulk administration. Where the log parser exposes the rule parameters, narrow the events to forwarding or redirect parameters to improve precision."

  events:
    $audit.metadata.event_type = "SETTING_MODIFICATION"
    $audit.metadata.product_event_type = /^(New-InboxRule|Set-InboxRule|UpdateInboxRules|Set-Mailbox|New-TransportRule|Set-TransportRule)$/ nocase
    $audit.principal.user.userid = $user
    not $audit.principal.user.userid in %global_allowed_service_accounts
    not $audit.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $event_count = count($audit.metadata.id)
    $risk_score = max(if($event_count >= 10, 85, 60))
    $mitre_technique_id = array_distinct("T1114.003")
    $primary_entity = array_distinct($user)
    $operations = array_distinct($audit.metadata.product_event_type)
    $source_ips = array_distinct($audit.principal.ip)

  condition:
    #audit >= 3
}
