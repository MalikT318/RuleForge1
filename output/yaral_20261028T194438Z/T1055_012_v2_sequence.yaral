/*
  MITRE Technique : T1055.012 - Process Hollowing
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:59:17.321346+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_012_Hollowed_Process_Injection_Then_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a process-injection event targeting a commonly hollowed Windows system binary, followed within 5 minutes by that same process (same host and PID) making an external network connection. This points to a hollowed process executing injected code and beaconing out. The rule keys on injection telemetry and the follow-on network behaviour, not on process-creation command lines."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.012"
    mitre_technique_name = "Process Injection: Process Hollowing"
    log_prerequisites = "Requires endpoint telemetry that emits process-injection / remote memory-write events (EDR or Sysmon-equivalent) and network connection events with process attribution and PID populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "EDR/AV agents and DLP or accessibility software that inject into system processes; application compatibility shims; backup or imaging agents; legitimate software that injects hooks into explorer.exe or similar; debuggers and developer tooling."
    tuning_guidance = "Add approved injectors to %global_allowed_security_tools, %global_allowed_admin_tools or %global_allowed_backup_processes. Tune the hollowed-binary list in the regex for the environment. Add known-good external destinations by extending the exclusion with %global_allowed_domains if the network telemetry carries a hostname."

  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.target.process.file.full_path = /\\(svchost|rundll32|regsvr32|dllhost|werfault|notepad|msiexec|searchprotocolhost|conhost|wuauclt|taskhost|taskhostw|explorer)\.exe$/ nocase
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes
    $inj.principal.hostname = $hostname
    $inj.target.process.pid = $pid

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(svchost|rundll32|regsvr32|dllhost|werfault|notepad|msiexec|searchprotocolhost|conhost|wuauclt|taskhost|taskhostw|explorer)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    $net.principal.hostname = $hostname
    $net.principal.process.pid = $pid

    $inj.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $pid over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.012")
    $primary_entity = array_distinct($hostname)
    $injector_processes = array_distinct($inj.principal.process.file.full_path)
    $hollowed_processes = array_distinct($inj.target.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $inj and $net
}
