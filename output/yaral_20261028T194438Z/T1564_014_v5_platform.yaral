/*
  MITRE Technique : T1564.014 - Extended Attributes
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:36:07.677425+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_014_Linux_Xattr_Payload_Write_File_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a file-metadata modification event (auditd setxattr or EDR file telemetry) where the acting process wrote a large or encoded value into a user. or trusted. extended attribute. This is the staging step of hiding a second-stage payload in xattrs. Matching is on the attribute namespace and value characteristics rather than the binary name, so renamed utilities are still caught, and it does not depend on PROCESS_LAUNCH."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.014"
    mitre_technique_name = "Hide Artifacts: Extended Attributes"
    log_prerequisites = "Linux auditd (setxattr/fsetxattr/lsetxattr syscall rules, with the acting process command line enriched) or Linux EDR file-metadata telemetry normalised to UDM FILE_MODIFICATION with principal.process.command_line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup and restore tools (rsync -X, tar --xattrs, cp --preserve=xattr) replaying attributes; package managers and file-integrity or labeling tools writing long values; application installers that tag files; admins manually testing xattrs."
    tuning_guidance = "Add approved backup tooling to %global_allowed_backup_processes, deployment and RMM tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Increase the {80,} value-length threshold if legitimate tagging produces noise. Review the process lineage and any later read of the same file's attributes before escalating."

  events:
    $xattr.metadata.event_type = "FILE_MODIFICATION"
    $xattr.principal.process.command_line = /(?i)(\s-n|--name)[\s=]+["']?(user|trusted)\.[^\s"']+/
    $xattr.principal.process.command_line = /(?i)((\s-v|--value)[\s=]+["']?(0s|0x)?[A-Za-z0-9+\/=_-]{80,}|base64|\/dev\/tcp|\b(curl|wget|eval|bash|sh|python[0-9.]*|perl)\b)/
    not $xattr.principal.process.file.full_path in %global_allowed_backup_processes
    not $xattr.principal.process.file.full_path in %global_allowed_admin_tools
    not $xattr.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1564.014")
    $primary_entity = array_distinct($xattr.principal.hostname)
    $acting_user = array_distinct($xattr.principal.user.userid)
    $acting_process = array_distinct($xattr.principal.process.file.full_path)
    $modified_file = array_distinct($xattr.target.file.full_path)
    $command_line = array_distinct($xattr.principal.process.command_line)

  condition:
    $xattr
}
