/*
  MITRE Technique : T1610 - Deploy Container
  Tactic(s)       : Execution
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:29:34.497935+00:00
  Reference       : https://attack.mitre.org/techniques/T1610
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1610_External_Container_Create_API_Call {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an HTTP request from a non-internal source to a container runtime API or Kubernetes API that creates a container or pod (POST to a container-create or namespaced pod-create endpoint). This is the network-side view of an adversary deploying a container through an exposed or abused control plane. It does not depend on endpoint telemetry, image names or the tool used."
    mitre_tactic = "Execution"
    mitre_technique = "T1610"
    mitre_technique_name = "Deploy Container"
    log_prerequisites = "Requires NETWORK_HTTP events with method and URL populated, from sources such as an API gateway, ingress or load balancer logs, a service mesh, or network sensors that can inspect the container API in cleartext or after TLS termination."
    platform = "Containers"
    log_source = "container"
    false_positives = "External CI/CD runners or SaaS deployment platforms that legitimately create containers or pods through a public API endpoint; managed Kubernetes control-plane callers on public endpoints; NAT or VPN egress addresses that do not fall in the internal address list; authorised red-team or scanner activity."
    tuning_guidance = "Add approved CI/CD and deployment source addresses to %global_allowed_mgmt_sources. Add automation identities to %global_allowed_service_accounts. Confirm that %rfc1918_internal covers all internal and VPN address space for the client. Where the API is only reachable internally, any hit is a strong signal and the rule can be raised to Critical."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.url = /\/(v[0-9]+(\.[0-9]+)?\/)?containers\/create(\?|$)|\/api\/v1\/namespaces\/[^\/]+\/pods\/?(\?|$)/ nocase
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1610")
    $primary_entity = array_distinct($net.target.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $target_urls = array_distinct($net.target.url)
    $source_users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
