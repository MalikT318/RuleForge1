/*
  MITRE Technique : T1574.007 - Path Interception by PATH Environment Variable
  Tactic(s)       : Stealth, Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:35:15.785108+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_007_Linux_Bulk_Command_Shadowing_Binaries_In_Path_Dirs {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Several files named after core system commands (ls, ps, sudo, ssh, curl and similar) are created within ten minutes on one host, in directories that are user-writable or that usually precede /usr/bin in $PATH (/usr/local/bin, ~/bin, ~/.local/bin, /tmp, /var/tmp, /dev/shm). A single such file can be benign. Several in a short window indicate an adversary staging trojanised binaries so they run in place of the legitimate commands (PATH interception). This rule uses file-creation telemetry and is independent of command-line detections."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.007"
    mitre_technique_name = "Hijack Execution Flow: Path Interception by PATH Environment Variable"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry (path watches on /usr/local/bin, /usr/local/sbin, /home, /root, /tmp, /var/tmp, /dev/shm) normalised to UDM FILE_CREATION with principal.hostname and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management and software deployment (Ansible, Puppet, Chef, Salt) installing wrappers into /usr/local/bin; developers building tools or wrappers named after system commands in ~/bin or ~/.local/bin; CI build agents writing test fixtures to /tmp; BusyBox or container image builds that create command symlinks or copies."
    tuning_guidance = "Add approved deployment and automation binaries to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Raise the #file threshold on build servers, or scope the rule away from build hosts. Extend the command-name list for client-specific wrappers if needed."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/usr\/local\/(s)?bin|\/home\/[^\/]+\/(\.local\/)?bin|\/root\/(\.local\/)?bin|\/tmp|\/var\/tmp|\/dev\/shm)\/(ls|ps|cat|cp|mv|rm|sudo|su|ssh|scp|sshd|curl|wget|id|whoami|netstat|ss|ip|find|grep|sh|bash|python3?|perl|passwd|login|top|systemctl|crontab|tar|git|apt|apt-get|yum|dnf)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|yum|dnf|snapd|pacman|zypper)$/ nocase

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1574.007")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $created_paths = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
