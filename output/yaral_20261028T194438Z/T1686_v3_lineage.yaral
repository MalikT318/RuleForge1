/*
  MITRE Technique : T1686 - Disable or Modify System Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:27:15.771682+00:00
  Reference       : https://attack.mitre.org/techniques/T1686
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_ESXi_Firewall_Change_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi firewall configuration command (esxcli/localcli network firewall set, unload, ruleset set, ruleset allowedip, ruleset rule) launched by an unexpected parent process such as a scripting interpreter, download utility, netcat, cron, or a web/management service daemon. Interactive administration normally comes from a login shell, so this lineage suggests scripted or remotely driven tampering with host firewall policy."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686"
    mitre_technique_name = "Disable or Modify System Firewall"
    log_prerequisites = "ESXi shell and process execution logging forwarded to Chronicle with parent and child process paths populated, normalised to PROCESS_LAUNCH."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Host configuration or compliance automation (Python-based hardening or remediation scripts), cron-driven configuration enforcement, vendor management agents or plugins that adjust rulesets, and lifecycle or patching tooling that temporarily opens a ruleset."
    tuning_guidance = "Add approved automation parents to %global_allowed_script_hosts or %global_allowed_admin_tools, and approved automation identities to %global_allowed_admin_users or %global_allowed_service_accounts. If a management daemon legitimately drives firewall changes in your environment, remove it from the parent regex rather than excluding the whole host."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(esxcli|localcli)$/ nocase
    $proc.target.process.command_line = /network\s+firewall\s+(set|unload|ruleset\s+(set|allowedip|rule))/ nocase
    $proc.principal.process.file.full_path = /\/(python[0-9.]*|perl|wget|curl|nc|netcat|crond?|lighttpd|rhttpproxy|sfcbd|openwsman)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1686")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
