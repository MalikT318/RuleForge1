/*
  MITRE Technique : T1553 - Subvert Trust Controls
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:59:44.872361+00:00
  Reference       : https://attack.mitre.org/techniques/T1553
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_004_Linux_CA_Anchor_Drop_Then_Trust_Store_Update {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a certificate file written into a Linux system CA trust anchor directory, followed within 10 minutes on the same host by execution of the trust store update utility. This sequence installs a new root CA into the system trust store, which lets an adversary subvert TLS validation, intercept traffic, or make signed malicious content appear trusted."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.004"
    mitre_technique_name = "Subvert Trust Controls: Install Root Certificate"
    log_prerequisites = "Requires Linux EDR or auditd file creation telemetry for CA anchor directories and process launch telemetry with parent process path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate enterprise root CA deployment by configuration management or provisioning scripts, corporate TLS inspection proxy certificate rollout, container image builds that add an internal CA, and developers trusting a local test CA."
    tuning_guidance = "Add approved configuration management and deployment tooling to %global_allowed_admin_tools. Add automation accounts that deploy corporate CAs to %global_allowed_service_accounts. Extend the package manager exclusions if your distribution uses other installers. Consider scoping out build hosts if container builds are noisy."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(usr\/local\/share\/ca-certificates|etc\/pki\/ca-trust\/source\/anchors|usr\/share\/pki\/ca-trust-source\/anchors|etc\/ca-certificates\/trust-source\/anchors)\/.+\.(crt|pem|cer|0)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|yum|dnf|rpm|snapd)$/ nocase
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(update-ca-certificates|update-ca-trust)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path = /\/(dpkg|apt|apt-get|yum|dnf|rpm|snapd)$/ nocase
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1553.004")
    $primary_entity = array_distinct($hostname)
    $certificate_paths = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $update_commands = array_distinct($proc.target.process.command_line)
    $actor_users = array_distinct($proc.principal.user.userid)
    $anchor_write_count = count($file.metadata.id)

  condition:
    $file and $proc
}
