/*
  MITRE Technique : T1543 - Create or Modify System Process
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:52:25.916161+00:00
  Reference       : https://attack.mitre.org/techniques/T1543
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_003_Unexpected_Parent_Spawns_Service_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows service being created or reconfigured by a process whose parent is an Office application, web server, database service or print spooler. These parents should never legitimately manage services, so the lineage points to exploitation or a webshell establishing SYSTEM-level persistence."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.003"
    mitre_technique_name = "Create or Modify System Process: Windows Service"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path populated (EDR, Sysmon Event ID 1, or Security Event 4688 with process creation auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Database or web application installers and upgrade routines that register their own services, print driver or vendor management agents that launch as children of spoolsv.exe, and Office-based deployment add-ins run by IT. These are rare and warrant review."
    tuning_guidance = "Add legitimate installer or agent parent binaries to %global_allowed_admin_tools, approved script-host parents to %global_allowed_script_hosts, and deployment accounts to %global_allowed_service_accounts. To broaden coverage, add other unexpected parent process names to the parent regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    // Anomalous parent: Office, web server, database, or print spooler
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|mspub|visio|onenote|w3wp|httpd|nginx|php-cgi|tomcat\d*w?|sqlservr|mysqld|spoolsv)\.exe$/ nocase
    // Child is a service-management binary, or a shell/interpreter performing service operations
    (
      (
        $proc.target.process.file.full_path = /\\sc\.exe$/ nocase and
        $proc.target.process.command_line = /\b(create|config)\b/ nocase
      ) or
      (
        $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh)\.exe$/ nocase and
        $proc.target.process.command_line = /\b(sc(\.exe)?\s+(create|config)|New-Service|Set-Service)\b/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1543.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
