/*
  MITRE Technique : T1016 - System Network Configuration Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:44:22.415594+00:00
  Reference       : https://attack.mitre.org/techniques/T1016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_SNMP_Network_Config_Query_From_Unapproved_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Firewall-observed SNMP (UDP/161) connection from a source that is not an approved management or scanning source. SNMP lets an adversary read interface addresses, routing tables and ARP caches from network devices and hosts (T1016). This is a network-perimeter variant that does not rely on process telemetry. Written for network device and cross-OS coverage because a firewall log carries no host OS or process context, so it complements the endpoint rules rather than replacing the Windows one."
    mitre_tactic = "Discovery"
    mitre_technique = "T1016"
    mitre_technique_name = "System Network Configuration Discovery"
    log_prerequisites = "Firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with target.port and principal.ip populated. Internal east-west traffic must be logged for full coverage."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Network monitoring and NMS platforms, IT asset inventory tools, vulnerability scanners and new management hosts not yet added to the allowlists."
    tuning_guidance = "Add approved NMS and monitoring server addresses to %global_allowed_mgmt_sources. Add authorised scanners to %global_allowed_scanners. Review the destination devices in $target_devices to decide whether a recurring source should be allowlisted."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 161
    $net.principal.ip != ""
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1016")
    $primary_entity = array_distinct($net.principal.ip)
    $target_devices = array_distinct($net.target.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
