/*
  MITRE Technique : T1040 - Network Sniffing
  Tactic(s)       : Credential Access, Discovery
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:27:16.836253+00:00
  Reference       : https://attack.mitre.org/techniques/T1040
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1040_Egress_Packet_Capture_Stream_Firewall {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a perimeter-observed connection from an internal source to an external destination on ports used to stream mirrored or sniffed traffic off-network. TZSP (UDP 37008) is used by network device packet-sniffer streaming and the remote packet capture protocol (TCP 2002) is used for remote capture. A network device or host exporting captured packets to an external collector indicates network sniffing and data staging."
    mitre_tactic = "Credential Access, Discovery"
    mitre_technique = "T1040"
    mitre_technique_name = "Network Sniffing"
    log_prerequisites = "Firewall, proxy or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated for egress traffic."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Managed network monitoring or packet-broker services hosted by an external provider, vendor-assisted troubleshooting sessions with remote packet capture, cloud-hosted IDS/NDR collectors receiving mirrored traffic, and unrelated services that use TCP 2002 as an ephemeral or application port."
    tuning_guidance = "Add approved monitoring or troubleshooting source addresses to %global_allowed_mgmt_sources and approved scanning or testing sources to %global_allowed_scanners. Add known-good external collector domains to %global_allowed_domains. Review the observed destination before blocking, and consider removing port 2002 for clients with known application use."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 37008 or $net.target.port = 2002)
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1040")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
