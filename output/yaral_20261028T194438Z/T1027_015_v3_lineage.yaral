/*
  MITRE Technique : T1027.015 - Compression
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:02:27.002001+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_015_Unexpected_Parent_Spawns_Archiver {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a compression or archive utility (7-Zip, RAR, tar, makecab, expand, compact) launched by a parent process that should never perform archiving: an Office application, web server worker, database service or print spooler. This lineage anomaly indicates payload packing or staging for obfuscation or exfiltration following document exploitation, a web shell, or database command execution. It keys on process lineage rather than command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.015"
    mitre_technique_name = "Obfuscated Files or Information: Compression"
    log_prerequisites = "Requires Windows endpoint process telemetry (EDR or Sysmon Event ID 1 or Security Event 4688 with parent process populated) normalised to UDM PROCESS_LAUNCH with principal.process.file.full_path (parent) and target.process.file.full_path (child)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Line-of-business Office macros or add-ins that zip exports; web applications that legitimately shell out to an archiver for report or backup generation; database maintenance jobs that compress backups via sqlservr child processes; print or document workflows using makecab or expand; software installers launched from an Office parent."
    tuning_guidance = "Add approved archiving parents or wrappers to %global_allowed_admin_tools, approved script or automation parents to %global_allowed_script_hosts, and known automation accounts to %global_allowed_service_accounts. If web or database servers legitimately archive, scope the exclusion by adding the specific parent executable name to %global_allowed_admin_tools rather than removing the parent from the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat\d*|php-cgi|sqlservr|mysqld|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(7z|7za|7zr|7zg|winrar|rar|unrar|tar|makecab|expand|compact)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1027.015")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
