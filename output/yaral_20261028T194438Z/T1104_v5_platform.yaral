/*
  MITRE Technique : T1104 - Multi-Stage Channels
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:00:11.431340+00:00
  Reference       : https://attack.mitre.org/techniques/T1104
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1104_Linux_Shell_Staged_Download_Chmod_Execute {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux shell invocation whose command line chains a curl/wget download, a chmod that makes the file executable, and execution of the result from a world-writable staging area (/tmp, /var/tmp, /dev/shm). This is the typical first-stage loader step that fetches a second-stage implant or RAT, which is the core of multi-stage command and control."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1104"
    mitre_technique_name = "Multi-Stage Channels"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records normalised to UDM PROCESS_LAUNCH, with target.process.command_line populated and the full shell -c argument string captured."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software installers and bootstrap scripts that download a helper into /tmp and run it; CI/CD runners and build agents; configuration management or provisioning (cloud-init, user-data) scripts; developers testing tools manually."
    tuning_guidance = "Add approved deployment or automation parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts. Add provisioning and CI service accounts to %global_allowed_service_accounts. Review hits from build hosts and consider scoping those hosts to a lower severity downstream."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ash|ksh)$/ nocase
    $proc.target.process.command_line = /\b(curl|wget)\b/ nocase
    $proc.target.process.command_line = /\bchmod\s+(-[a-zA-Z]+\s+)*([ugoa]*\+x|[0-7]{3,4})\b/ nocase
    $proc.target.process.command_line = /(\/tmp|\/var\/tmp|\/dev\/shm)\b/ nocase
    $proc.target.process.command_line = /(;|&&|\|\|)\s*(nohup\s+|setsid\s+|exec\s+)?(\.\/|\/tmp\/|\/var\/tmp\/|\/dev\/shm\/)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1104")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
