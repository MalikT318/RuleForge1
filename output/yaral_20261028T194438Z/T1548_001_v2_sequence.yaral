/*
  MITRE Technique : T1548.001 - Setuid and Setgid
  Tactic(s)       : Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:28:37.162704+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_001_Dropped_Binary_Executes_Elevated_Setuid {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A non-root user creates a file in a world-writable staging directory (/tmp, /var/tmp, /dev/shm). Within 10 minutes the same path is executed and the new process runs as root while the launching user is not root, without sudo, su or doas as the parent. This is the result of a setuid-root binary planted for privilege escalation or persistence. The rule does not match chmod command lines, so it complements command-line detections."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.001"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Setuid and Setgid"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that populates FILE_CREATION and PROCESS_LAUNCH events, including principal.user.userid and target.user.userid (effective user) on process launch."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software installers or build systems that unpack setuid helpers into /tmp and run them, container or CI runners with user-namespace remapping, admin scripts that stage and run privileged helpers, and legitimate setuid utilities copied to /tmp for testing."
    tuning_guidance = "Add approved deployment and build tooling to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Extend the staging directory regex with client-specific writable paths if needed. If target.user.userid is not populated for a client's EDR, validate the field mapping before enabling."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    $file.principal.user.userid != "root"
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $path

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    $proc.target.user.userid = "root"
    $proc.principal.user.userid != "root"
    $proc.principal.user.userid != $proc.target.user.userid
    not $proc.principal.process.file.full_path = /\/(sudo|su|doas)$/ nocase
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname
    $proc.target.process.file.full_path = $path

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1548.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $dropping_users = array_distinct($file.principal.user.userid)
    $executing_users = array_distinct($proc.principal.user.userid)
    $elevated_users = array_distinct($proc.target.user.userid)
    $executed_paths = array_distinct($proc.target.process.file.full_path)
    $dropper_processes = array_distinct($file.principal.process.file.full_path)
    $first_seen = min($file.metadata.event_timestamp.seconds)
    $last_seen = max($proc.metadata.event_timestamp.seconds)

  condition:
    $file and $proc
}
