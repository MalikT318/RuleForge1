/*
  MITRE Technique : T1071.001 - Web Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:04:51.329797+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_001_ESXi_Outbound_Web_From_Unexpected_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi host making an outbound web-port connection (80, 443, 8080, 8443) to an external address from a user-space process that is not a standard hypervisor management daemon. Hypervisors normally talk to internal management servers, so web traffic to the internet from a shell, script interpreter or renamed binary suggests command-and-control over web protocols, tool staging or exfiltration."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.001"
    mitre_technique_name = "Application Layer Protocol: Web Protocols"
    log_prerequisites = "ESXi network connection telemetry (firewall or connection logging, syslog forwarding) normalised to UDM NETWORK_CONNECTION with principal.hostname, target.ip, target.port and, ideally, principal.process.file.full_path populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Hosts patched directly from an online depot, management or monitoring agents reaching vendor cloud endpoints, administrators manually downloading VIBs, ISOs or patches from the shell, and licence or telemetry check-ins from third-party VIB agents."
    tuning_guidance = "Add approved vendor, depot and update domains to %global_allowed_domains. Add approved agent binaries to %global_allowed_admin_tools. Add backup or security agents to %global_allowed_security_tools. Extend the daemon-name regex if clients run additional approved native services. Where principal.process is not populated the rule does not fire, so confirm field mapping per client."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname != ""
    $net.principal.process.file.full_path != ""
    ($net.target.port = 80 or $net.target.port = 443 or $net.target.port = 8080 or $net.target.port = 8443)
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path = /\/(hostd|vpxa|fdm|vmware-fdm|vmsyslogd|rhttpproxy|sfcbd|sfcb-[a-z_]+|ntpd|chronyd|vobd|vmkeventd|esxupdate|lwsmd|sshd|dropbear|vsanmgmtd|vsantraced|clomd|epd|vmtoolsd|nsx-[a-z_-]+|nsxa)$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1071.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $destination_hosts = array_distinct($net.target.hostname)
    $source_processes = array_distinct($net.principal.process.file.full_path)
    $process_commands = array_distinct($net.principal.process.command_line)

  condition:
    $net
}
