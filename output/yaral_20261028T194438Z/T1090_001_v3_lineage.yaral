/*
  MITRE Technique : T1090.001 - Internal Proxy
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:27:01.513218+00:00
  Reference       : https://attack.mitre.org/techniques/T1090/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1090_001_ESXi_Mgmt_Daemon_Spawns_Shell_Or_Relay {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi management or service daemon (hostd, vpxa, rhttpproxy, openwsmand, sfcbd, slpd, FDM) spawning a shell, script interpreter or network relay binary. These daemons do not normally launch interactive shells or tunnelling utilities. This lineage anomaly indicates exploitation of a management service, or an adversary turning the hypervisor into an internal proxy or pivot for command and control. The rule matches on parent-child lineage only, not on command-line content."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1090.001"
    mitre_technique_name = "Proxy: Internal Proxy"
    log_prerequisites = "ESXi shell and process execution logging forwarded to Chronicle and parsed into UDM PROCESS_LAUNCH with populated parent (principal.process) and child (target.process) file paths."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Built-in hostd or vpxa health-check and support-bundle scripts that invoke sh or python; vendor or third-party VIB agents (monitoring, backup, hardware management) that run under sfcbd or hostd and launch helper scripts; VMware-supported troubleshooting or patching workflows initiated by the management plane."
    tuning_guidance = "Add approved parent binaries (for example third-party VIB agents) to %global_allowed_admin_tools or %global_allowed_script_hosts. Baseline per-cluster hostd and vpxa child behaviour for a week before enforcing alerting. Raise severity for hosts outside maintenance windows."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(hostd|vpxa|rhttpproxy|openwsmand|sfcbd|sfcb-[a-z_-]+|slpd|vmware-fdm|vmsyslogd)$/ nocase
    $proc.target.process.file.full_path = /\/(ash|sh|bash|dash|busybox|python[0-9.]*|perl|nc|ncat|socat|ssh)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1090.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
