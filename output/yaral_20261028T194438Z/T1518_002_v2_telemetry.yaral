/*
  MITRE Technique : T1518.002 - Backup Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:22:09.647738+00:00
  Reference       : https://attack.mitre.org/techniques/T1518/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_002_Backup_Agent_Process_Handle_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a process requesting a handle to a backup agent or backup service process (enterprise backup, imaging, or Windows Backup engine). Enumerating and opening backup agent processes is a common precursor to inhibiting recovery or encrypting data. This rule works at the process-handle layer rather than the command line, so it still fires when command-line logging is evaded or the enumeration tool is renamed."
    mitre_tactic = "Discovery"
    mitre_technique = "T1518.002"
    mitre_technique_name = "Software Discovery: Backup Software Discovery"
    log_prerequisites = "Requires Windows endpoint telemetry that records process handle requests (EDR process-access events or Sysmon Event ID 10) normalised to UDM PROCESS_OPEN with populated principal and target process paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup management consoles and monitoring agents querying backup service processes, RMM or patching tools, EDR/AV agents scanning processes, performance and diagnostic tools, and administrators troubleshooting backup jobs."
    tuning_guidance = "Add approved backup and imaging software to %global_allowed_backup_processes, EDR and AV agents to %global_allowed_security_tools, RMM and monitoring tools to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. If the target-name regex misses a client's backup product, extend it with that product's agent process names."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\[^\\]*(veeam|acronis|cobian|backupexec|bengine|beremote|cvd|cvfwd|dpmra|avamar|rubrik|datto|axcient|paragon|macrium|reflect|shadowprotect|spxservice|crashplan|carbonite|idrive|duplicati|nbwin|bpcd|wbengine)[^\\]*\.exe$/ nocase
    $open.principal.process.file.full_path != ""
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    not $open.principal.process.file.full_path = /\\(csrss|smss|wininit|services|svchost|lsass|winlogon|taskmgr|resmon|MsMpEng|MsSense|SenseIR|SenseCncProxy)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1518.002")
    $primary_entity = array_distinct($open.principal.hostname)
    $source_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $acting_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
