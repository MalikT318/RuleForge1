/*
  MITRE Technique : T1547.006 - Kernel Modules and Extensions
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:32:49.901567+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_006_Linux_Kernel_Module_Download_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux host fetching a loadable kernel module file (.ko, optionally compressed) over HTTP(S) from an external destination. Staging an LKM from outside the network is a precursor to kernel-mode rootkit or boot-persistence installation. This is network-side coverage that complements process-creation rules for insmod/modprobe."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.006"
    mitre_technique_name = "Boot or Logon Autostart Execution: Kernel Modules and Extensions"
    log_prerequisites = "Requires Linux endpoint telemetry that emits NETWORK_HTTP events with target.url populated (EDR network sensor or host-based proxy/URL logging). Internal destinations are excluded via %rfc1918_internal."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Out-of-tree driver installs (GPU, Wi-Fi, DKMS builds fetching prebuilt modules), kernel developers and QA pulling test modules, hardware vendors' driver update utilities, and approved configuration management or patching tooling that distributes .ko files from external mirrors."
    tuning_guidance = "Add approved driver or mirror domains to %global_allowed_domains, approved deployment and patching binaries to %global_allowed_admin_tools, and trusted automation accounts to %global_allowed_service_accounts. Consider scoping high-severity alerting to servers where out-of-tree drivers are never expected."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\.ko(\.(xz|gz|zst|bz2))?([?#].*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.process.file.full_path in %global_allowed_admin_tools
    not $http.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1547.006")
    $primary_entity = array_distinct($http.principal.hostname)
    $requested_urls = array_distinct($http.target.url)
    $destination_ips = array_distinct($http.target.ip)
    $initiating_process = array_distinct($http.principal.process.file.full_path)

  condition:
    $http
}
