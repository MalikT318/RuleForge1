/*
  MITRE Technique : T1496.001 - Compute Hijacking
  Tactic(s)       : Impact
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:52:49.538162+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_001_Container_Workload_Created_By_Anonymous_Principal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a container workload (pod, deployment, daemonset, job, cronjob, replicaset or statefulset) through the Kubernetes API by an anonymous or unauthenticated principal. Attackers who find exposed or misconfigured cluster APIs use this path to deploy cryptocurrency-mining containers at scale. Legitimate clusters should never allow anonymous workload creation, so the detection targets the access-control failure that enables compute hijacking rather than any miner artifact."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.001"
    mitre_technique_name = "Resource Hijacking: Compute Hijacking"
    log_prerequisites = "Kubernetes API server audit logging enabled at Metadata level or higher, and ingested into Chronicle through the managed cluster provider's cloud audit log pipeline. The parser must populate metadata.product_event_type with the API verb (for example io.k8s.apps.v1.daemonsets.create) and principal.user.userid with the authenticated user."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Misconfigured but sanctioned bootstrap or CI tooling that submits workloads without credentials, cluster-admin break-glass testing, authorised penetration tests or red-team exercises, and some managed-cluster provisioning flows that briefly use unauthenticated requests during setup."
    tuning_guidance = "Add approved provisioning or CI service identities to %global_allowed_service_accounts and %global_allowed_cloud_principals. Add the source addresses of authorised testers and management hosts to %global_allowed_mgmt_sources and %global_allowed_scanners. If anonymous workload creation is confirmed legitimate in a given tenant, fix the cluster RBAC rather than suppressing the rule broadly."

  events:
    $res.metadata.event_type = "RESOURCE_CREATION"
    $res.metadata.product_event_type = /\.(pods|deployments|daemonsets|replicasets|statefulsets|jobs|cronjobs)\.create$/ nocase
    $res.principal.user.userid = /^system:(anonymous|unauthenticated)$/ nocase
    not $res.principal.user.userid in %global_allowed_service_accounts
    not $res.principal.user.userid in %global_allowed_cloud_principals
    not $res.principal.ip in %global_allowed_mgmt_sources
    not $res.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1496.001")
    $primary_entity = array_distinct($res.principal.ip)
    $source_user = array_distinct($res.principal.user.userid)
    $api_action = array_distinct($res.metadata.product_event_type)
    $workload_name = array_distinct($res.target.resource.name)

  condition:
    $res
}
