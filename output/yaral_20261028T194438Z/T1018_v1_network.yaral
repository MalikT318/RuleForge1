/*
  MITRE Technique : T1018 - Remote System Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:27:28.258747+00:00
  Reference       : https://attack.mitre.org/techniques/T1018
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1018_Network_Discovery_Protocols_To_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects perimeter-observed traffic using name-resolution and device-discovery protocols (NetBIOS name service, LLMNR, mDNS, SSDP, SNMP) sent to a non-internal destination. These protocols are meant to stay on the local segment and rarely cross the perimeter. Egress to an external address suggests a compromised host or device sweeping for remote systems, or misdirected discovery traffic."
    mitre_tactic = "Discovery"
    mitre_technique = "T1018"
    mitre_technique_name = "Remote System Discovery"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Internal address space must be maintained in %rfc1918_internal."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Cloud-hosted SNMP monitoring or NMS platforms polling external-facing devices, misconfigured clients leaking NetBIOS/LLMNR/mDNS/SSDP traffic through a default route, authorised external vulnerability scanners, VPN or split-tunnel clients on guest networks, and ISP or managed-service CPE management."
    tuning_guidance = "Add authorised scanner and monitoring source addresses to %global_allowed_scanners, approved management destinations or sources to %global_allowed_mgmt_sources, and external monitoring hostnames to %global_allowed_domains. If SNMP to cloud monitoring is common for a client, enforce the exclusion through %global_allowed_mgmt_sources rather than editing the rule."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 137 or
      $net.target.port = 161 or
      $net.target.port = 1900 or
      $net.target.port = 5353 or
      $net.target.port = 5355
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1018")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
