/*
  MITRE Technique : T1003.005 - Cached Domain Credentials
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:44:17.126032+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_005_Linux_Cached_Credential_DB_Copied_Outside_Native_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a copy of an SSSD or Quest Authentication Services cached-credential database (cache_<domain>.ldb, vas_auth.vdb) outside its native directory. Adversaries with root copy these files to a staging location (/tmp, /dev/shm, /var/tmp, home directories) so they can run tdbdump or ldbsearch against them offline and crack the cached domain password hashes. This rule detects the resulting file artifact rather than the command line, so it still fires when command-line logging is evaded or the copy tool is renamed."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.005"
    mitre_technique_name = "OS Credential Dumping: Cached Domain Credentials"
    log_prerequisites = "Requires Linux EDR file-creation telemetry or auditd file-watch rules (for example -w /var/lib/sss/db -p r and file-creation syscall auditing) normalised to UDM FILE_CREATION with target.file.full_path and principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup and imaging agents snapshotting /var/lib/sss; administrators copying the SSSD cache for troubleshooting or migration; configuration management or golden-image tooling; sosreport or support-bundle collectors."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes, approved admin and support tooling to %global_allowed_admin_tools, and EDR agents to %global_allowed_security_tools. Service accounts that legitimately snapshot the SSSD cache can be listed in %global_allowed_service_accounts. Set auditd watches on the native cache directories so copies are attributed to the correct process."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\/(cache_[^\/]+\.ldb|vas_auth\.vdb)[^\/]*$/ nocase
    not $file.target.file.full_path = /^\/var\/lib\/sss\/(db|mc)\// nocase
    not $file.target.file.full_path = /^\/var\/opt\/quest\/vas\/authcache\// nocase
    not $file.principal.process.file.full_path = /\/(sssd|sssd_be|sssd_nss|sssd_pam|sss_cache|vasd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1003.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
