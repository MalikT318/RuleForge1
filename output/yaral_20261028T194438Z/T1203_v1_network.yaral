/*
  MITRE Technique : T1203 - Exploitation for Client Execution
  Tactic(s)       : Execution
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:55:12.087902+00:00
  Reference       : https://attack.mitre.org/techniques/T1203
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1203_Office_Client_UserAgent_Fetches_Payload_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound HTTP request to an external destination whose user-agent identifies a Microsoft Office client and whose URL points to an executable, script, or remote-template file type. This is the network-side footprint of a client-application exploit or malicious document retrieving a second-stage payload or remote template. It is observed at the proxy or firewall with no dependency on endpoint process telemetry."
    mitre_tactic = "Execution"
    mitre_technique = "T1203"
    mitre_technique_name = "Exploitation for Client Execution"
    log_prerequisites = "Requires proxy or firewall HTTP logs normalised to NETWORK_HTTP, with network.http.user_agent and target.url populated. TLS inspection is needed to see the URL and user-agent on HTTPS traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Office add-ins or templates hosted on external vendor sites, legitimate remote template (.dot/.dotm) loading from third-party SaaS, software deployment tools that use an Office-style user-agent, and security sandboxes detonating documents."
    tuning_guidance = "Add known-good vendor and template-hosting domains to %global_allowed_domains. If internal address space is not matched, confirm %rfc1918_internal is populated for the tenant. Narrow the extension list if remote-template loading is common in the client environment."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /(ms-office|microsoft office|msoffice|office\/1[0-9]\.|officeclicktorun|excel\/|winword\/|powerpoint\/)/ nocase
    $net.target.url = /\.(exe|dll|hta|scr|cpl|js|jse|vbs|vbe|wsf|ps1|msi|sct|xsl|dotm|dot|jar)([?#].*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1203")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
