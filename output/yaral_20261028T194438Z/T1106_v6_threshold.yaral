/*
  MITRE Technique : T1106 - Native API
  Tactic(s)       : Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:02:22.466677+00:00
  Reference       : https://attack.mitre.org/techniques/T1106
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1106_Linux_Proc_Mem_Write_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated writes to /proc/<pid>/mem on a single Linux host within 10 minutes. Writing to another process's memory file is the file-interface equivalent of the ptrace and process_vm_writev native APIs, and is used for code injection and in-memory execution. One write can be a debugger or runtime; a burst of them from non-approved processes is not normal."
    mitre_tactic = "Execution"
    mitre_technique = "T1106"
    mitre_technique_name = "Native API"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-write auditing on /proc/*/mem, normalised to UDM FILE_MODIFICATION with principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Debuggers and tracers (gdb, lldb, strace) used by developers or SREs, JIT runtimes and language profilers, crash-dump and live-patching tooling, and APM agents that attach to running processes."
    tuning_guidance = "Add approved debuggers, profilers and patching agents to %global_allowed_admin_tools. Add EDR and AV agents to %global_allowed_security_tools. Raise the #file threshold on developer or build hosts. The rule groups by host, so tune per host role."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/proc\/[0-9]+\/mem$/
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\/(gdb|gdbserver|lldb|strace|ltrace|perf)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1106")
    $primary_entity = array_distinct($host)
    $write_count = count($file.metadata.id)
    $targeted_mem_files = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $writer_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 5
}
