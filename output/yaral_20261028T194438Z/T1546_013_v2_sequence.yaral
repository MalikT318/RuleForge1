/*
  MITRE Technique : T1546.013 - PowerShell Profile
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:18:36.772193+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_013_PowerShell_Profile_Written_Then_PowerShell_Launched {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a PowerShell profile script (profile.ps1 or a host-specific *_profile.ps1) being created on a host, followed within 10 minutes by a PowerShell session starting on the same host without -NoProfile. This is the persistence and privilege-escalation pattern where a planted profile executes on the next PowerShell start. The file-creation leg is the primary signal. Only FILE_CREATION is used because a default install has no profile, so an attacker normally has to create one. Edits to an existing profile are not covered by this variant."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.013"
    mitre_technique_name = "Event Triggered Execution: PowerShell Profile"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 equivalent) with the writing process populated, plus process launch telemetry for powershell.exe and pwsh.exe."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or developers customising their own profile with an editor, Group Policy or configuration management (DSC, Ansible, Intune) deploying standard profiles, developer tooling that installs shell integrations (Oh My Posh, posh-git, Azure/Conda initialisers), and golden-image or logon-time provisioning scripts."
    tuning_guidance = "Add configuration management and deployment binaries to %global_allowed_admin_tools. Add EDR and AV agents to %global_allowed_security_tools. Add approved parent processes that launch PowerShell to %global_allowed_script_hosts. For environments with managed profiles, consider tightening the file-path regex to user-writable locations only. Add a companion rule for FILE_MODIFICATION to cover edits to existing profiles."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(windowspowershell|powershell)(\\v1\.0|\\7)?\\(microsoft\.[a-z]+_)?profile\.ps1$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    $ps.metadata.event_type = "PROCESS_LAUNCH"
    $ps.target.process.file.full_path = /\\(powershell|pwsh|powershell_ise)\.exe$/ nocase
    not $ps.target.process.command_line = /\s[-\/]nop/ nocase
    not $ps.principal.process.file.full_path in %global_allowed_script_hosts
    $ps.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $ps.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546.013")
    $primary_entity = array_distinct($file.principal.hostname)
    $profile_paths = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $writer_users = array_distinct($file.principal.user.userid)
    $powershell_launchers = array_distinct($ps.principal.process.file.full_path)
    $powershell_users = array_distinct($ps.principal.user.userid)
    $powershell_launch_count = count($ps.metadata.id)

  condition:
    $file and $ps
}
