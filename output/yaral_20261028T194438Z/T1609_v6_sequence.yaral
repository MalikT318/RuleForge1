/*
  MITRE Technique : T1609 - Container Administration Command
  Tactic(s)       : Execution
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:28:06.611198+00:00
  Reference       : https://attack.mitre.org/techniques/T1609
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1609_Container_Exec_Then_Shell_Launch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an exec request against a pod through the container orchestration API, followed within ten minutes by a shell process launching inside the same pod. This sequence is the signature of kubectl exec or docker exec style remote command execution in a running container."
    mitre_tactic = "Execution"
    mitre_technique = "T1609"
    mitre_technique_name = "Container Administration Command"
    log_prerequisites = "Requires Kubernetes audit logs at Request level or higher, normalised as USER_RESOURCE_ACCESS with target.url holding the request URI and target.resource.name holding the pod name. Also requires in-container process telemetry from a runtime sensor, normalised as PROCESS_LAUNCH with principal.resource.name holding the pod name. The pod name must be populated consistently in both sources for the join to work."
    platform = "Containers"
    log_source = "container"
    false_positives = "SRE and developer live debugging, break-glass troubleshooting, CI/CD jobs that exec into pods for smoke tests or migrations, database administrators running maintenance shells, and operators or controllers that use the exec subresource."
    tuning_guidance = "Add approved admin accounts to %global_allowed_admin_users and automation identities to %global_allowed_service_accounts. Add approved parent processes or tooling to %global_allowed_admin_tools. Allow-list known break-glass or CI pods by extending the exclusions on the pod name. If the pod name is not populated in the runtime telemetry, change the join key to a field that is shared across both sources."

  events:
    $audit.metadata.event_type = "USER_RESOURCE_ACCESS"
    $audit.target.url = /\/pods\/[^\/?]+\/exec(\?|$)/ nocase
    $audit.target.resource.name = $pod
    not $audit.principal.user.userid in %global_allowed_admin_users
    not $audit.principal.user.userid in %global_allowed_service_accounts

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(ba|da|a|z|k|c|tc)?sh$/ nocase
    $proc.principal.resource.name = $pod
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    $audit.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $pod over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1609")
    $primary_entity = array_distinct($pod)
    $api_users = array_distinct($audit.principal.user.userid)
    $api_source_ips = array_distinct($audit.principal.ip)
    $shell_paths = array_distinct($proc.target.process.file.full_path)
    $shell_commands = array_distinct($proc.target.process.command_line)
    $exec_event_count = count($audit.metadata.id)

  condition:
    $audit and $proc
}
