/*
  MITRE Technique : T1003.007 - Proc Filesystem
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:49:38.512569+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_007_Linux_Proc_Mem_Read_By_Foreign_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process reading /proc/<PID>/mem of a different process on Linux. Credential-dumping techniques read another process's virtual memory through the proc filesystem to harvest cleartext passwords, tokens and cached hashes. Legitimate processes rarely read another process's memory, because a process normally touches only its own /proc/self/mem. This rule uses file-access telemetry (FILE_READ) rather than command-line matching, so it still fires when the dumper is a renamed binary, a compiled tool, or an in-memory script interpreter."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.007"
    mitre_technique_name = "OS Credential Dumping: Proc Filesystem"
    log_prerequisites = "Requires Linux file-read telemetry that populates principal.process.pid, principal.process.file.full_path and target.file.full_path. This means EDR file-access events or auditd file-watch rules (for example a -w or -S openat/read audit rule on /proc/*/mem), normalised to FILE_READ."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Interactive debuggers and tracers run by admins or developers, crash and core-dump handlers, JVM/.NET/language-runtime profilers and APM agents, live-migration or checkpoint/restore tooling (container checkpointing), EDR/AV memory scanners, and backup or imaging agents."
    tuning_guidance = "Add approved EDR/AV and memory-scanning agents to %global_allowed_security_tools. Add approved debugging, profiling and APM tooling to %global_allowed_admin_tools. Add backup or checkpointing agents to %global_allowed_backup_processes. Add known automation accounts to %global_allowed_service_accounts. Consider extending the path regex to include maps if the environment can tolerate the extra volume, since maps reads are common in monitoring agents."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /^\/proc\/[0-9]+\/mem$/ nocase
    $file.principal.hostname != ""
    $file.principal.process.file.full_path != ""
    $file.principal.process.pid != ""
    re.capture($file.target.file.full_path, "^/proc/([0-9]+)/mem$") != $file.principal.process.pid
    not $file.principal.process.file.full_path = /\/(systemd-coredump|systemd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1003.007")
    $primary_entity = array_distinct($file.principal.hostname)
    $reader_process = array_distinct($file.principal.process.file.full_path)
    $reader_user = array_distinct($file.principal.user.userid)
    $memory_files_read = array_distinct($file.target.file.full_path)

  condition:
    $file
}
