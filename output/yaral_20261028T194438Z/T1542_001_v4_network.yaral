/*
  MITRE Technique : T1542.001 - System Firmware
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:42:59.920866+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_001_Firmware_Image_Download_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP request, seen at the network perimeter, that fetches a firmware or UEFI/BIOS image or capsule file (for example .cap, .rom, .fd, .wph, .efi) from an external host that is not a known-good domain. Adversaries who modify system firmware for persistence must first stage a firmware image on the host. This rule observes that staging from the network side and does not depend on any endpoint process fields."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.001"
    mitre_technique_name = "Pre-OS Boot: System Firmware"
    log_prerequisites = "Requires forward-proxy, secure web gateway or firewall logs with full URL visibility (HTTP inspection or TLS decryption) that populate target.url and target.hostname for outbound traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate OEM BIOS/UEFI/firmware updates for Windows endpoints, hardware vendor update utilities pulling from vendor CDNs not yet in the allowlist, IT staff downloading firmware for servers or peripherals, and security researchers."
    tuning_guidance = "Add OEM and hardware vendor update domains to %global_allowed_domains. Internal destinations are already excluded through %rfc1918_internal. If the extension list is noisy, remove less specific extensions from the regex. Treat any hit from a user workstation that is not in an IT or engineering role as high priority and correlate with endpoint firmware-tool activity."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\.(cap|rom|fd|wph|efi|scap)([?#&].*)?$/ nocase
    $net.target.url = /(bios|uefi|firmware|bootrom|capsule)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1542.001")
    $primary_entity = array_distinct($net.principal.ip)
    $source_hostname = array_distinct($net.principal.hostname)
    $destination_host = array_distinct($net.target.hostname)
    $destination_ip = array_distinct($net.target.ip)
    $requested_url = array_distinct($net.target.url)

  condition:
    $net
}
