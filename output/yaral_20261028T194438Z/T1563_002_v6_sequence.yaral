/*
  MITRE Technique : T1563.002 - RDP Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:11:24.942176+00:00
  Reference       : https://attack.mitre.org/techniques/T1563/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_002_RDP_Session_Enum_Then_Tscon_Hijack {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects RDP session hijacking: an RDP/terminal session enumeration command (quser, qwinsta, query session/user) followed within 10 minutes on the same host by tscon.exe being launched with a numeric session ID, which takes over another user's session without credentials."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1563.002"
    mitre_technique_name = "Remote Service Session Hijacking: RDP Hijacking"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with full command lines (EDR, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Helpdesk or administrators using tscon to switch or reconnect user sessions on RDS/terminal servers, session-management or RMM scripts that enumerate sessions and then connect to them, and legitimate shadowing or support workflows."
    tuning_guidance = "Add approved session-management tooling to %global_allowed_admin_tools and helpdesk or administrator accounts to %global_allowed_admin_users. Hosts that routinely use tscon (RDS or Citrix servers) can be excluded by adding their management parent processes to %global_allowed_admin_tools. Raise the risk score where tscon runs as SYSTEM from a service or cmd parent."

  events:
    $enum.metadata.event_type = "PROCESS_LAUNCH"
    $enum.target.process.file.full_path = /\\(quser|qwinsta|query)\.exe$/ nocase
    $enum.target.process.command_line = /\b(quser|qwinsta)\b|\bquery(\.exe)?"?\s+(session|user)/ nocase
    not $enum.principal.process.file.full_path in %global_allowed_admin_tools
    not $enum.principal.user.userid in %global_allowed_admin_users
    $enum.principal.hostname = $hostname

    $tscon.metadata.event_type = "PROCESS_LAUNCH"
    $tscon.target.process.file.full_path = /\\tscon\.exe$/ nocase
    $tscon.target.process.command_line = /\btscon(\.exe)?"?\s+\d+/ nocase
    not $tscon.principal.process.file.full_path in %global_allowed_admin_tools
    not $tscon.principal.user.userid in %global_allowed_admin_users
    $tscon.principal.hostname = $hostname

    $enum.metadata.event_timestamp.seconds <= $tscon.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1563.002")
    $primary_entity = array_distinct($hostname)
    $enum_commands = array_distinct($enum.target.process.command_line)
    $tscon_commands = array_distinct($tscon.target.process.command_line)
    $tscon_parents = array_distinct($tscon.principal.process.file.full_path)
    $users = array_distinct($tscon.principal.user.userid)
    $tscon_count = count($tscon.metadata.id)

  condition:
    $enum and $tscon
}
