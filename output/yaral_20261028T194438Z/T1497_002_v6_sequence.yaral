/*
  MITRE Technique : T1497.002 - User Activity Based Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:05:01.289797+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_002_User_Activity_Check_Then_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A script interpreter runs a command line that probes for user activity (input idle time, cursor position, key state, recent documents, typed URLs, browser history), then the same host makes an external connection from a script interpreter within 10 minutes. This pattern is typical of sandbox-evasion checks that gate payload retrieval or C2 check-in."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1497.002"
    mitre_technique_name = "Virtualization/Sandbox Evasion: User Activity Based Checks"
    log_prerequisites = "Requires EDR or Sysmon process launch telemetry with full command lines (or Windows Event 4688 with command-line auditing), plus network connection telemetry with process attribution."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Endpoint inventory or user-experience monitoring scripts that read idle time or recent files and then report to external SaaS. Login or logoff scripts that clean up recent items. Admin scripts that check for an active user before a reboot or patch and then call an external API. Software packagers and test automation that simulate input."
    tuning_guidance = "Add approved parent processes and script hosts to %global_allowed_script_hosts. Add known-good external domains (vendor telemetry, update services) to %global_allowed_domains. Review the command-line outcome fields to refine the activity-probe regex for your environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(GetLastInputInfo|GetCursorPos|GetAsyncKeyState|Forms\.Cursor\]::Position|RecentDocs|TypedURLs|\\Microsoft\\Windows\\Recent|\\User Data\\Default\\History)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    $proc.principal.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    $net.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1497.002")
    $primary_entity = array_distinct($hostname)
    $probe_command_lines = array_distinct($proc.target.process.command_line)
    $users = array_distinct($proc.principal.user.userid)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $proc and $net
}
