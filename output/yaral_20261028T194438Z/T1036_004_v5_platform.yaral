/*
  MITRE Technique : T1036.004 - Masquerade Task or Service
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:03:35.627129+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_004_Service_Registry_Masquerade_DisplayName {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows service key under CurrentControlSet\\Services being given a DisplayName or Description that starts with 'Windows' or 'Microsoft', a common way to disguise a malicious service as an OS component. The logic is registry-based and does not depend on process command lines, so it complements existing PROCESS_LAUNCH rules. It fires when the registry write comes from a process other than approved installers, admin tooling or security agents. The platform stays Windows because the log source and registry mechanism are Windows-only."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.004"
    mitre_technique_name = "Masquerading: Masquerade Task or Service"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events) with registry_value_name and registry_value_data populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Third-party software installers that brand services as 'Microsoft ...' or 'Windows ...' (for example update agents and runtimes), software deployment tooling, and in-place Windows feature or servicing changes."
    tuning_guidance = "Add approved deployment and RMM binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. If the rule is noisy because legitimate installers write via the service control manager, add those installer process names to the exclusions or raise severity only when the same host also shows a service ImagePath in a user-writable location."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(CurrentControlSet|ControlSet\d+)\\Services\\[^\\]+$/ nocase
    $reg.target.registry.registry_value_name = /^(DisplayName|Description)$/ nocase
    $reg.target.registry.registry_value_data = /^@?(Windows|Microsoft)\s+\S+/ nocase
    not $reg.principal.process.file.full_path = /\\(msiexec|TrustedInstaller|TiWorker|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1036.004")
    $primary_entity = array_distinct($reg.principal.hostname)
    $service_keys = array_distinct($reg.target.registry.registry_key)
    $masquerade_values = array_distinct($reg.target.registry.registry_value_data)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
