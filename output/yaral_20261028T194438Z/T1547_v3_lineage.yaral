/*
  MITRE Technique : T1547 - Boot or Logon Autostart Execution
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:21:44.880499+00:00
  Reference       : https://attack.mitre.org/techniques/T1547
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_Linux_Service_Daemon_Spawns_Autostart_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server or database daemon spawning a persistence-capable child: a scheduler/init/kernel-module utility, or a shell touching autostart locations (cron, systemd, init scripts, profile.d, rc.local, ld.so.preload). These daemons have no legitimate reason to configure boot or logon autostart, so this lineage typically indicates web shell or database-command-execution exploitation followed by persistence."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547"
    mitre_technique_name = "Boot or Logon Autostart Execution"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records with parent process path, child process path and command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web hosting control panels or CMS plugins that manage cron jobs through the web server user; database maintenance jobs that launch shells to schedule backups; application self-installers or update mechanisms run under the web or database service account; containerised entrypoints where the daemon is PID 1 and launches setup scripts."
    tuning_guidance = "Add approved management or deployment parent binaries to %global_allowed_admin_tools and approved script-launching parents to %global_allowed_script_hosts. Extend the parent daemon regex for site-specific services (for example other application servers). For hosting-panel environments, allowlist the panel binary rather than disabling the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|php-cgi|tomcat[0-9]*|mysqld|mariadbd|postgres|mongod|redis-server)$/ nocase
    (
      $proc.target.process.file.full_path = /\/(crontab|chkconfig|update-rc\.d|insmod|modprobe|at|batch)$/ nocase
      or
      (
        $proc.target.process.file.full_path = /\/(ba|da|z|k|c|tc)?sh$/ nocase
        and $proc.target.process.command_line = /(\/etc\/cron|\/var\/spool\/cron|\/etc\/systemd\/|\/usr\/lib\/systemd\/|\/etc\/rc\.local|\/etc\/init\.d|\/etc\/profile\.d|\/etc\/ld\.so\.preload|\.bashrc|\.bash_profile|systemctl\s+(enable|daemon-reload)|update-rc\.d|chkconfig)/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\/systemctl$/ nocase
        and $proc.target.process.command_line = /\b(enable|link|daemon-reload)\b/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
