/*
  MITRE Technique : T1003.004 - LSA Secrets
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:43:10.911713+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_004_LSA_Secrets_Hive_Export_From_Anomalous_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects an unexpected parent process (Office application, web server, print spooler or database service) spawning a registry utility or shell/script interpreter that exports the SECURITY hive or LSA Secrets key. This lineage anomaly indicates a compromised application being used to harvest LSA secrets, which contain service account credentials. The rule pivots on the parent-child relationship and uses the command line only as a narrowing condition."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.004"
    mitre_technique_name = "OS Credential Dumping: LSA Secrets"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Database or application maintenance jobs that script registry backups from a service process, vendor installers or support tooling launched from a web or print service context, and security assessment tooling. All are rare for this parent lineage."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts. Add approved backup and imaging software to %global_allowed_backup_processes. Add EDR or AV agents to %global_allowed_security_tools. Extend the parent regex with additional application-tier services that are not expected to spawn shells in the client environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|onenote|mspub|visio|w3wp|httpd|nginx|tomcat\d*|php-cgi|spoolsv|sqlservr|mysqld|postgres|oracle)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(reg|cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /\b(save|export|copy)\b.*(hklm|hkey_local_machine)\\security\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1003.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
