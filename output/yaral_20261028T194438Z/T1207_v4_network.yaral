/*
  MITRE Technique : T1207 - Rogue Domain Controller
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:15:05.290020+00:00
  Reference       : https://attack.mitre.org/techniques/T1207
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1207_Rogue_DC_Directory_Replication_Ports_To_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an internal host opening connections to external destinations on Active Directory RPC endpoint mapper, LDAP, LDAPS or Global Catalog ports. Rogue domain controller (DCShadow) activity depends on DRSUAPI/RPC and LDAP replication traffic. These protocols should never leave the perimeter. Outbound use suggests a rogue DC registration, replication with attacker-controlled infrastructure, or tunnelled directory manipulation."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1207"
    mitre_technique_name = "Rogue Domain Controller"
    log_prerequisites = "Firewall, proxy or perimeter flow logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. The firewall must see egress traffic from internal segments, including DC and server VLANs."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Hybrid identity or directory-sync connectors reaching cloud-hosted domain controllers or directory services; site-to-site or partner LDAP federation not routed over private address space; managed LDAP/LDAPS-based SaaS integrations (HR, SSO, email); vendor support access; misconfigured clients querying public IPs on port 389/636."
    tuning_guidance = "Add approved source addresses (hybrid sync servers, directory connectors) to %global_allowed_mgmt_sources. Add known-good external directory service domains to %global_allowed_domains. Confirm %rfc1918_internal covers all private and internal ranges for the client, including CGNAT or private-routed ranges. Review principal.ip hosts that are not domain controllers first."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 135 or
      $net.target.port = 389 or
      $net.target.port = 636 or
      $net.target.port = 3268 or
      $net.target.port = 3269
    )
    $net.principal.ip in %rfc1918_internal
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1207")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
