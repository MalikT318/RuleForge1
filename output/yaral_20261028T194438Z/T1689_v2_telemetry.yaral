/*
  MITRE Technique : T1689 - Downgrade Attack
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:37:00.573214+00:00
  Reference       : https://attack.mitre.org/techniques/T1689
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1689_Linux_Crypto_Policy_Config_Weakening {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects modification of system-wide cryptographic and SSH protocol configuration files on Linux (crypto-policies, OpenSSL config, sshd/ssh client config) by a process that is not a package manager or an approved admin tool. Attackers edit these files to re-enable legacy protocol versions, weak ciphers or weak key exchange, which forces the system into a less secure mode and enables traffic interception. Detection is based on the file state change, not the command line, so it still fires when the editing command is obfuscated or not logged."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1689"
    mitre_technique_name = "Downgrade Attack"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules (-w on /etc/crypto-policies, /etc/ssl, /etc/pki/tls, /etc/ssh) normalised to UDM FILE_MODIFICATION with principal.process and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management agents (Ansible, Puppet, Chef, Salt) pushing hardening or baseline changes; administrators legitimately editing sshd_config; OS package upgrades that rewrite openssl.cnf; compliance remediation tooling; image build pipelines."
    tuning_guidance = "Add configuration management and deployment binaries to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and named administrators to %global_allowed_admin_users. If sshd_config.d drop-ins are too noisy, narrow the path regex to the crypto-policies and openssl.cnf paths. Consider raising severity for servers with a strict hardening baseline."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/(crypto-policies\/(config|local\.d\/.+)|ssl\/openssl\.cnf|pki\/tls\/openssl\.cnf|ssh\/(sshd_config|ssh_config)(\.d\/.+)?)$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|rpm|apt|apt-get|dnf|yum|zypper|packagekitd|unattended-upgrade)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1689")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_files = array_distinct($file.target.file.full_path)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
