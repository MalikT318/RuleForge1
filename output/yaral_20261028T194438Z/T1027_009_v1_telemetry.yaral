/*
  MITRE Technique : T1027.009 - Embedded Payloads
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:51:25.051779+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_009_Linux_Decoded_Payload_Staged_In_Temp {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a decoder, extractor or scripting-runtime process creating a hidden or binary-typed file (dot-prefixed name, .so, .bin, .elf or .dat) in a world-writable staging directory (/tmp, /var/tmp, /dev/shm). This is the file artifact left when a payload embedded in a script, document or binary is decoded and dropped to disk, regardless of how the command line was written or obfuscated."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.009"
    mitre_technique_name = "Obfuscated Files or Information: Embedded Payloads"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry that populates principal.process.file.full_path and target.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers and installers unpacking helper libraries to /tmp; self-extracting vendor installers; Python, Perl or Ruby applications that write hidden temp files or native libraries (.so) during startup; CI/CD runners and build agents; configuration management agents; developer workstations."
    tuning_guidance = "Add approved installers, build tooling and deployment binaries to %global_allowed_admin_tools. Add known script-running parents or hosts such as CI runners to %global_allowed_script_hosts. Add EDR and AV agents to %global_allowed_security_tools. Add service accounts that legitimately stage temp files to %global_allowed_service_accounts. Consider raising severity for files created under /dev/shm, since it is memory-backed and rarely used by legitimate software."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(base64|basenc|xxd|uudecode|openssl|python[0-9.]*|perl|ruby|php[0-9.]*)$/ nocase
    $file.target.file.full_path = /^\/(dev\/shm|tmp|var\/tmp)\/(.*\/)?(\.[^\/]+|[^\/]+\.(so|bin|elf|dat))$/ nocase
    not $file.target.file.full_path = /^\/(tmp|var\/tmp)\/\.(X11-unix|ICE-unix|font-unix|XIM-unix|Test-unix)(\/|$)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.parent_process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.009")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
