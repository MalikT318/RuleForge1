/*
  MITRE Technique : T1056.003 - Web Portal Capture
  Tactic(s)       : Collection, Credential Access
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:49:23.220246+00:00
  Reference       : https://attack.mitre.org/techniques/T1056/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1056_003_Portal_Credential_Exfil_Outbound_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects outbound HTTP requests from an internal Linux-hosted web or portal server to an external destination where the URL carries credential-style parameters (username, password, email, token). This is the network footprint of a tampered login page, such as a VPN or webmail portal, forwarding captured credentials to an attacker collector. It works from perimeter or proxy telemetry alone and complements endpoint command-line detections."
    mitre_tactic = "Collection, Credential Access"
    mitre_technique = "T1056.003"
    mitre_technique_name = "Input Capture: Web Portal Capture"
    log_prerequisites = "Requires firewall or proxy telemetry with HTTP URL visibility (TLS inspection or explicit proxy) normalised to UDM NETWORK_HTTP with target.url, target.hostname, target.ip and network.http.method populated."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Server-side SSO or OAuth callbacks to third-party identity providers, payment or CAPTCHA verification calls, legitimate partner API integrations that pass user identifiers in the query string, and outbound requests generated by monitoring or synthetic-login checks."
    tuning_guidance = "Add known-good external identity providers, vendors and SaaS endpoints to %global_allowed_domains. Where the client can identify portal and gateway hosts, scope the rule to those principal hosts in a client-level copy, since outbound web requests from them should be rare. Raise severity for internet-facing portals."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(GET|POST)$/ nocase
    $net.target.url = /[?&;](user(name)?|userid|login|email|pass(word|wd|phrase)?|pwd|cred(ential)?s?|token|otp)=[^&\s]+/ nocase
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1056.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $request_urls = array_distinct($net.target.url)

  condition:
    $net
}
