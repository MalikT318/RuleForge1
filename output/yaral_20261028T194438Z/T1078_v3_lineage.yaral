/*
  MITRE Technique : T1078 - Valid Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:27:38.445764+00:00
  Reference       : https://attack.mitre.org/techniques/T1078
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_Container_Service_Process_Spawns_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter launched inside a container by a network-facing service parent such as a web server, application gateway, database or cache. These services almost never spawn interactive shells. The lineage usually means someone is using a valid session, stolen credential or exposed service account to execute commands through the service. The rule matches on process lineage only, not on command-line content."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078"
    mitre_technique_name = "Valid Accounts"
    log_prerequisites = "Requires container runtime or node-level sensor telemetry that records in-container process launches, with parent and child executable paths populated in UDM (principal.process.file.full_path and target.process.file.full_path)."
    platform = "Containers"
    log_source = "container"
    false_positives = "Database or web images that run shell-based entrypoint, health-check or init scripts (for example postgres archive_command, mysqld wrapper scripts, nginx or httpd reload hooks); PHP or CGI applications that call system() or exec() by design; CI or test containers; admin debugging sessions in non-production namespaces."
    tuning_guidance = "Add approved parent binaries or hosts that legitimately run scripts (entrypoint wrappers, health-check parents) to %global_allowed_script_hosts. Add approved automation identities to %global_allowed_service_accounts. Add approved tooling binaries to %global_allowed_admin_tools. Trim the parent regex for services that routinely spawn scripts in a given client, or raise the severity for internet-facing workloads."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|httpd|apache2|lighttpd|caddy|haproxy|php-fpm[0-9.]*|gunicorn|uwsgi|tomcat[0-9]*|mysqld|mariadbd|postgres|mongod|redis-server|memcached)$/ nocase
    (
      $proc.target.process.file.full_path = /\/(sh|bash|dash|ash|zsh|ksh|csh|tcsh|busybox)$/ nocase or
      $proc.target.process.file.full_path = /\/(python[0-9.]*|perl|ruby|php[0-9.]*)$/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.hostname in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1078")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
