/*
  MITRE Technique : T1200 - Hardware Additions
  Tactic(s)       : Initial Access
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:49:44.445359+00:00
  Reference       : https://attack.mitre.org/techniques/T1200
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1200_Outbound_Remote_Access_Tunnel_From_Internal_Device {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal device initiating an outbound TCP connection to an external address on a remote-access or tunnelling port (SSH, Telnet, RDP, VNC). Implanted hardware such as drop boxes, pocket computers and rogue gateways often call home over these protocols to give the attacker a foothold. Detection uses only perimeter-observable data (destination, port and protocol) and does not depend on the endpoint, so it still fires when the device has no agent."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1200"
    mitre_technique_name = "Hardware Additions"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip, target.port and network.ip_protocol populated, covering egress traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Administrators using SSH or RDP to cloud-hosted servers, vendor remote support sessions, developers pushing to external Git over SSH, approved jump hosts, and scheduled vulnerability scans."
    tuning_guidance = "Add approved admin jump hosts and management source IPs to %global_allowed_mgmt_sources and authorised scanner sources to %global_allowed_scanners. Add known-good external destinations to %global_allowed_domains. If a client legitimately allows broad egress SSH or RDP, restrict the rule to subnets where only managed endpoints are expected, or raise severity only when the source is not in the asset inventory."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "TCP"
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 3389 or
      $net.target.port = 5900
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1200")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
