/*
  MITRE Technique : T1137.005 - Outlook Rules
  Tactic(s)       : Persistence
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:20:42.596974+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_005_Outlook_Unsafe_Client_Mail_Rules_Enabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry write to the Outlook Security key value that enables 'unsafe' client mail rules (the 'Start application' and 'Run a script' rule actions). Attackers set this value so a malicious Outlook rule can execute code when a crafted email arrives. Detection is on the resulting registry state change rather than command-line activity, so it fires whichever tool or method made the change (reg.exe, PowerShell, WMI, a direct API call, or a custom binary)."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.005"
    mitre_technique_name = "Office Application Startup: Outlook Rules"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon Event ID 13) normalised to UDM REGISTRY_MODIFICATION with target.registry.registry_key and registry_value_name populated. HKCU and HKEY_USERS hives must be monitored."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy line-of-business Outlook add-ins or mail-automation workflows that need script or application rules; IT deployment scripts or login scripts that set Outlook client security values; Office installers or repair operations; administrators testing mail-rule automation."
    tuning_guidance = "Add approved deployment or configuration tooling to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. If a client legitimately uses unsafe client mail rules, add the approved writer process to %global_allowed_admin_tools. Where a client enforces this value via Group Policy (Software\\Policies path), the rule does not match it. Consider raising severity if the value data is non-zero and the writer is an interpreter or LOLBin."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Software\\Microsoft\\Office\\[0-9]+\.[0-9]+\\Outlook\\Security$/ nocase
    $reg.target.registry.registry_value_name = /^EnableUnsafeClientMailRules$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path = /\\OfficeClickToRun\.exe$/ nocase

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1137.005")
    $primary_entity = array_distinct($reg.principal.hostname)
    $acting_user = array_distinct($reg.principal.user.userid)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_data = array_distinct($reg.target.registry.registry_value_data)

  condition:
    $reg
}
