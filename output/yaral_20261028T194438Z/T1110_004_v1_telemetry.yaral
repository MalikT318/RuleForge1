/*
  MITRE Technique : T1110.004 - Credential Stuffing
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:08:25.860026+00:00
  Reference       : https://attack.mitre.org/techniques/T1110/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1110_004_IaaS_Account_Lockout_From_External_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an identity-provider authentication event whose result shows the target account was locked out (smart lockout, too many failed attempts) when the attempt came from an external source address. The lockout is the state change that credential stuffing or password spraying leaves on the account, and it is visible even when the attacker's tooling and request pattern are not. Covers identities used to access IaaS consoles and APIs."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1110.004"
    mitre_technique_name = "Brute Force: Credential Stuffing"
    log_prerequisites = "Identity provider sign-in logs normalised to UDM USER_LOGIN with security_result.summary populated with the failure or lockout reason, and principal.ip populated with the client address."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Legitimate users who mistype a password repeatedly or have stale credentials cached on a mobile device or mail client. Password-expiry events that cause automation or sync clients to retry with old credentials. Authorised penetration tests or red-team exercises. Corporate VPN or proxy egress addresses that are not in the internal address list."
    tuning_guidance = "Add known service identities with stale-credential retry behaviour to %global_allowed_service_accounts. Add authorised testing or scanning sources to %global_allowed_scanners. Add named administrators who are frequently locked out to %global_allowed_admin_users. If the identity provider uses different lockout wording, extend the security_result.summary regex. For stuffing across many accounts, pair this rule with a Threshold rule grouped by source address."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.security_result.summary = /(account.{0,30}lock|lock(ed)?[ _-]?out|locked[ _-]?out|smart[ _-]?lockout|too many (failed|invalid|incorrect))/ nocase
    $auth.target.user.userid != ""
    not $auth.principal.ip in %rfc1918_internal
    not $auth.principal.ip in %global_allowed_scanners
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1110.004")
    $primary_entity = array_distinct($auth.target.user.userid)
    $source_ips = array_distinct($auth.principal.ip)
    $lockout_reason = array_distinct($auth.security_result.summary)

  condition:
    $auth
}
