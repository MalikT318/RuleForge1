/*
  MITRE Technique : T1102 - Web Service
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:53:13.886629+00:00
  Reference       : https://attack.mitre.org/techniques/T1102
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1102_ESXi_Outbound_HTTP_Firewall_Ruleset_Enabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an ESXi host firewall configuration change that enables the outbound HTTP/HTTPS client ruleset (httpClient). ESXi hosts normally have no reason to make outbound web requests. Enabling this ruleset is a prerequisite for a compromised hypervisor to relay C2 traffic or pull payloads through legitimate external web services. This detects the host configuration change itself, not a process command line."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1102"
    mitre_technique_name = "Web Service"
    log_prerequisites = "ESXi hostd logs forwarded to Chronicle and parsed so that firewall configuration change messages populate metadata.description on SETTING_MODIFICATION events. Verify that the parser maps the hostd 'Firewall configuration has changed' message."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Planned patching or upgrades that pull from an online depot, lifecycle or update manager integrations that temporarily enable the httpClient ruleset, vendor support sessions, and host provisioning or baseline automation."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation or lifecycle service accounts to %global_allowed_service_accounts. If patching windows are predictable, consider suppressing by host group at the SOAR layer. Review correlated outbound NETWORK_CONNECTION events from the same host after any alert."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.description = /firewall\s+configuration\s+has\s+changed/ nocase
    $setting.metadata.description = /httpclient/ nocase
    $setting.metadata.description = /(enable|enabled|allowedall|true)/ nocase
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1102")
    $primary_entity = array_distinct(strings.coalesce($setting.principal.hostname, $setting.target.hostname))
    $acting_user = array_distinct($setting.principal.user.userid)
    $change_detail = array_distinct($setting.metadata.description)

  condition:
    $setting
}
