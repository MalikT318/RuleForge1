/*
  MITRE Technique : T1547.006 - Kernel Modules and Extensions
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:32:15.501686+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_006_Linux_Staged_Kernel_Module_Then_Load_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a kernel module (.ko) file written to a user-writable or volatile staging location, followed within 10 minutes on the same host by creation of a boot-time module-load configuration or a new module in the kernel module tree. This sequence is typical of LKM rootkit installation and persistence. It relies on file telemetry only, so it complements command-line based insmod/modprobe detections."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.006"
    mitre_technique_name = "Boot or Logon Autostart Execution: Kernel Modules and Extensions"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file watch rules (-w /etc/modules-load.d -p wa, plus path watches on /tmp, /dev/shm, /var/tmp and /lib/modules) normalised to UDM FILE_CREATION events with principal.hostname and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Out-of-tree driver builds (DKMS, GPU/VPN/virtualisation guest additions), kernel or driver package installs and upgrades, kernel developers and module build pipelines, configuration management pushing modules-load.d entries, golden-image build jobs."
    tuning_guidance = "Add approved deployment, build and driver tooling executables to %global_allowed_admin_tools. Add EDR and security agents that stage or write module files to %global_allowed_security_tools. Adjust the package manager and DKMS process-name exclusion regex to match the distributions in the client estate. Consider excluding known build hosts via a host-scoped allowlist."

  events:
    $ko.metadata.event_type = "FILE_CREATION"
    $ko.target.file.full_path = /^\/(tmp|dev\/shm|var\/tmp|run\/user\/[0-9]+|home\/[^\/]+|root)\/.*\.ko(\.(xz|zst|gz))?$/ nocase
    not $ko.principal.process.file.full_path in %global_allowed_admin_tools
    not $ko.principal.process.file.full_path in %global_allowed_security_tools
    not $ko.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|dnf|yum|zypper|dkms|pacman)$/ nocase
    $ko.principal.hostname = $host

    $persist.metadata.event_type = "FILE_CREATION"
    $persist.target.file.full_path = /^(\/etc\/modules-load\.d\/[^\/]+\.conf|\/etc\/modules|\/(usr\/)?lib\/modules\/.+\.ko(\.(xz|zst|gz))?)$/ nocase
    not $persist.principal.process.file.full_path in %global_allowed_admin_tools
    not $persist.principal.process.file.full_path in %global_allowed_security_tools
    not $persist.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|dnf|yum|zypper|dkms|pacman|depmod)$/ nocase
    $persist.principal.hostname = $host

    $ko.metadata.event_timestamp.seconds <= $persist.metadata.event_timestamp.seconds

  match:
    $host over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1547.006")
    $primary_entity = array_distinct($host)
    $staged_module_paths = array_distinct($ko.target.file.full_path)
    $persistence_paths = array_distinct($persist.target.file.full_path)
    $staging_processes = array_distinct($ko.principal.process.file.full_path)
    $persistence_processes = array_distinct($persist.principal.process.file.full_path)
    $acting_users = array_distinct($persist.principal.user.userid)

  condition:
    $ko and $persist
}
