/*
  MITRE Technique : T1573 - Encrypted Channel
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:22:19.279119+00:00
  Reference       : https://attack.mitre.org/techniques/T1573
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1573_Linux_Repeated_Encrypted_Channel_Nonstandard_Port_Beaconing {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal host makes many outbound connections to the same external IP on alternate TLS/encrypted-channel ports within ten minutes. Each connection is benign on its own, but the repeated, regular volume to one destination on non-standard encrypted ports is consistent with beaconing over a custom or self-managed encrypted C2 channel."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1573"
    mitre_technique_name = "Encrypted Channel"
    log_prerequisites = "Requires firewall, proxy or perimeter egress logs normalised to UDM NETWORK_CONNECTION with principal.hostname, target.ip and target.port populated. The firewall cannot see the initiating process, so Linux server scope is determined by the client's egress policy (Linux server subnets or hostnames feeding this log source)."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Software update and package mirrors on alternate HTTPS ports, container registries, monitoring and log shipping agents using 8443/9443, management consoles and API gateways, VPN or SaaS agents using alternate TLS ports, and backup clients polling cloud endpoints."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains and vulnerability or monitoring scanners to %global_allowed_scanners. Raise the #net threshold in the condition for noisy estates, or lower it for high-value server segments. Add or remove ports in the events block to match the client's approved egress ports."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 8443 or
      $net.target.port = 4443 or
      $net.target.port = 9443 or
      $net.target.port = 7443 or
      $net.target.port = 10443 or
      $net.target.port = 8444 or
      $net.target.port = 2083 or
      $net.target.port = 2087
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners
    $net.principal.hostname = $host
    $net.target.ip = $dst

  match:
    $host, $dst over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1573")
    $primary_entity = array_distinct($host)
    $destination_ips = array_distinct($dst)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 20
}
