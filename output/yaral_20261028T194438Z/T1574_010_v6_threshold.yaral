/*
  MITRE Technique : T1574.010 - Services File Permissions Weakness
  Tactic(s)       : Stealth, Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:40:46.507404+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_010_Service_Binary_Overwrite_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Multiple existing executable or DLL files under service binary locations (Program Files, ProgramData, System32) were modified by a non-installer process on a single host within 10 minutes. A single modification can be an update, but repeated overwrites by an unexpected writer suggest replacement of service binaries through weak file permissions."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.010"
    mitre_technique_name = "Hijack Execution Flow: Services File Permissions Weakness"
    log_prerequisites = "Requires EDR or Sysmon file modification telemetry (Sysmon Event ID 11 or equivalent) with writer process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software updaters running outside the standard installer names, application self-update services, patch or deployment tooling, developer builds writing into Program Files, and backup or restore jobs."
    tuning_guidance = "Add approved updaters and deployment tools to %global_allowed_admin_tools, security agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Raise the #file threshold on hosts with frequent legitimate software deployment."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^[a-z]:\\(program files( \(x86\))?|programdata|windows\\system32)\\.+\.(exe|dll)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\\(msiexec|trustedinstaller|tiworker|msmpeng|mousocoreworker|wuauclt|musnotification)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($file.target.file.full_path = /\\windows\\system32\\/ nocase, 85, 65))
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1574.010")
    $primary_entity = array_distinct($host)
    $modified_files = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
