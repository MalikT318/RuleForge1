/*
  MITRE Technique : T1556.009 - Conditional Access Policies
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:28:10.648305+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_009_Conditional_Access_Policy_Tampering_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a single identity performing several access-policy or conditional-access modifications (create, update, delete, attach, detach) within ten minutes. One policy edit is routine administration, but a burst from one account suggests an adversary loosening MFA, location, device or IAM condition constraints to keep access to a compromised account."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.009"
    mitre_technique_name = "Modify Authentication Process: Conditional Access Policies"
    log_prerequisites = "Requires cloud and identity audit logs (control-plane or directory audit events) normalised to UDM RESOURCE_PERMISSIONS_CHANGE, with metadata.product_event_type and principal.user.userid populated."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Planned zero-trust or MFA rollouts, infrastructure-as-code pipelines applying policy changes, IAM clean-up projects, break-glass administration during incidents, and bulk policy migrations by cloud administrators."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and automation or pipeline identities to %global_allowed_service_accounts. Raise the #iam threshold for tenants with heavy IaC activity. Lower it to 2 for tenants with tightly controlled policy change windows."

  events:
    $iam.metadata.event_type = "RESOURCE_PERMISSIONS_CHANGE"
    $iam.metadata.product_event_type = /(conditional.?access|(put|create|update|delete|set|attach|detach|remove|add)[a-z]*policy|setiampolicy)/ nocase
    $iam.principal.user.userid = $user
    not $iam.principal.user.userid in %global_allowed_admin_users
    not $iam.principal.user.userid in %global_allowed_service_accounts

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($iam.metadata.id)
    $mitre_technique_id = array_distinct("T1556.009")
    $primary_entity = array_distinct($user)
    $source_ips = array_distinct($iam.principal.ip)
    $policy_actions = array_distinct($iam.metadata.product_event_type)

  condition:
    #iam >= 3
}
