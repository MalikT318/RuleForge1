/*
  MITRE Technique : T1114 - Email Collection
  Tactic(s)       : Collection
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:16:59.918226+00:00
  Reference       : https://attack.mitre.org/techniques/T1114
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_External_Login_Then_Mailbox_Access_Grant {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a user signing in from an external (non-RFC1918) address and, within ten minutes, the same account making a mailbox-access change (delegate or full-access grant, mailbox forwarding, or an application consent to mail data). This sequence is typical of account takeover followed by email collection setup."
    mitre_tactic = "Collection"
    mitre_technique = "T1114"
    mitre_technique_name = "Email Collection"
    log_prerequisites = "Requires identity provider sign-in logs normalised to USER_LOGIN with principal.ip and principal.user.userid, and directory or mail audit logs normalised to USER_CHANGE_PERMISSIONS with metadata.product_event_type populated."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Remote administrators or helpdesk staff granting mailbox delegation from home or VPN egress addresses, mailbox migrations, onboarding of executive assistants, approved mail-integration application consent by legitimate users."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts. Add administrators who legitimately manage mailbox permissions to %global_allowed_admin_users. Add trusted egress sources to %global_allowed_mgmt_sources if the sign-in IP is expected. Narrow the product_event_type regex if client audit event naming differs."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid = $user
    not $auth.principal.ip in %rfc1918_internal
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users

    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.principal.user.userid = $user
    $perm.metadata.product_event_type = /(mailbox.*(permission|delegate|folder|forward)|full.?access|send.?as|consent.*(application|grant)|forwarding)/ nocase
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_admin_users

    $auth.metadata.event_timestamp.seconds <= $perm.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1114")
    $primary_entity = array_distinct($user)
    $source_ips = array_distinct($auth.principal.ip)
    $permission_actions = array_distinct($perm.metadata.product_event_type)
    $login_count = count($auth.metadata.id)

  condition:
    $auth and $perm
}
