/*
  MITRE Technique : T1543.003 - Windows Service
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:55:25.208679+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_003_Service_ImagePath_Registry_Suspicious_Target {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows service ImagePath registry value being set to a LOLBin or script host, a user-writable or staging directory, or a UNC path. Service configuration lives in HKLM\\SYSTEM\\CurrentControlSet\\Services, so this catches service persistence however the service was created (sc.exe, direct registry writes, API calls, driver loading), including when command-line logging is evaded."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.003"
    mitre_technique_name = "Create or Modify System Process: Windows Service"
    log_prerequisites = "Requires registry telemetry with registry value data populated (EDR registry events or Sysmon Event ID 12/13) covering HKLM\\SYSTEM\\CurrentControlSet\\Services."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters that register services from ProgramData or Temp during setup, RMM or deployment agents, developer machines installing test services, and legitimate services wrapped by cmd.exe or powershell.exe."
    tuning_guidance = "Add approved installer, deployment and RMM binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. If a client has an in-house service that legitimately runs from ProgramData, tighten the data regex for that environment or exclude its writer process through the reference lists."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\services\\[^\\]+(\\imagepath)?$/ nocase
    (
      $reg.target.registry.registry_value_name = "ImagePath" nocase or
      $reg.target.registry.registry_key = /\\imagepath$/ nocase
    )
    $reg.target.registry.registry_value_data = /(%comspec%|\\cmd\.exe|powershell|pwsh|mshta|rundll32|regsvr32|wscript|cscript|\\users\\[^\\]+\\|\\appdata\\|\\temp\\|\\programdata\\|\\perflogs\\|\\windows\\debug\\|^"?\\\\[^\\]+\\)/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1543.003")
    $primary_entity = array_distinct($reg.principal.hostname)
    $service_registry_key = array_distinct($reg.target.registry.registry_key)
    $image_path_value = array_distinct($reg.target.registry.registry_value_data)
    $writer_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
