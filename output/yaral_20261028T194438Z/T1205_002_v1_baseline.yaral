/*
  MITRE Technique : T1205.002 - Socket Filters
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:12:17.387735+00:00
  Reference       : https://attack.mitre.org/techniques/T1205/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_002_Inbound_External_To_Ephemeral_Port_Windows {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an inbound connection from an external source to an internal Windows host on a port in the Windows dynamic/ephemeral range (49152-65535). Passive backdoors that use a WinPcap/Npcap-style socket filter wait for a crafted trigger packet without a conventional listening service, so unsolicited external traffic to a high port is the network-observable sign. A firewall cannot see the filter itself, so this is a proxy signal for the technique."
    mitre_tactic = "Stealth, Persistence, Command and Control"
    mitre_technique = "T1205.002"
    mitre_technique_name = "Traffic Signaling: Socket Filters"
    log_prerequisites = "Firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with network.direction, principal.ip, target.ip and target.port populated. Log permitted inbound sessions, not only denied ones."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Published services running on high ports, NAT or port-forwarded applications, VoIP/RTP and media streaming, P2P or game traffic, passive-mode FTP data channels, external vulnerability scanners, and approved remote support tools using dynamic ports."
    tuning_guidance = "Add authorised scanner sources to %global_allowed_scanners and approved management or partner source addresses to %global_allowed_mgmt_sources. Add known service accounts' hosts or sanctioned source identifiers to the matching allow-lists. Tune the port floor per client if a published service legitimately listens on a high port. Correlate hits with a subsequent outbound connection from the same internal host to raise confidence."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.direction = "INBOUND"
    $net.target.port >= 49152
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1205.002")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
