/*
  MITRE Technique : T1497.001 - System Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:02:16.587864+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_001_Linux_Sandbox_External_IP_Geo_Check_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux scripting or download utility, or a binary running from a world-writable staging directory, making an outbound HTTP request to an external 'what is my IP / geolocation / public IP' style lookup. Malware uses this network check to fingerprint the victim's egress address and ASN, and to detect sandbox or analysis environments, before deciding whether to detonate or fetch a second-stage payload. Matching is on lookup-style URL semantics, not on specific domains, so renamed tools and rotated lookup services are still detected."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1497.001"
    mitre_technique_name = "Virtualization/Sandbox Evasion: System Checks"
    log_prerequisites = "Requires Linux endpoint telemetry or a network sensor that produces NETWORK_HTTP events with principal.process.file.full_path populated and target.url or target.hostname extracted. Encrypted traffic needs TLS inspection or an endpoint agent that records the URL."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Admin or provisioning scripts (cloud-init, Ansible, configuration management) that look up the public IP; dynamic DNS update clients; monitoring or inventory scripts using curl or wget; developers testing network egress from a shell; legitimate geo-aware software installers."
    tuning_guidance = "Add approved lookup and vendor domains to %global_allowed_domains. Add approved automation binaries to %global_allowed_admin_tools. Add service accounts that run egress checks to %global_allowed_service_accounts. Raise severity when the process runs from /tmp, /var/tmp or /dev/shm, or when the host has no business reason to run interactive interpreters. Pair with the endpoint-side T1497.001 variants for higher confidence."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.principal.process.file.full_path = /(^\/(tmp|var\/tmp|dev\/shm)\/)|(\/(curl|wget|python[0-9.]*|perl|ruby|php[0-9.]*|nodejs|node|busybox)$)/ nocase
    $http.target.url = /(my-?ip|check-?ip|ip-?(info|api|lookup|echo|geo|address)|geo-?(ip|locat)|public-?ip|external-?ip|what-?is-?my)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.process.file.full_path in %global_allowed_admin_tools
    not $http.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1497.001")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_process = array_distinct($http.principal.process.file.full_path)
    $source_user = array_distinct($http.principal.user.userid)
    $requested_url = array_distinct($http.target.url)
    $destination_ips = array_distinct($http.target.ip)

  condition:
    $http
}
