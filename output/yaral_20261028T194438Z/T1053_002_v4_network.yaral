/*
  MITRE Technique : T1053.002 - At
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:13:10.382799+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_002_At_Utility_External_RPC_SMB_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Windows at.exe scheduler utility opening a network connection to a non-internal address on RPC/SMB ports (135, 139, 445) or the dynamic RPC range. at.exe talks to the remote Task Scheduler service (ATSVC) over these channels when scheduling jobs on another host. It has no legitimate reason to reach outside internal address space, so this indicates remote job scheduling against an externally reachable system, a pivot through a VPN or NAT range not covered by the internal list, or at.exe being abused as a remote-execution channel."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.002"
    mitre_technique_name = "Scheduled Task/Job: At"
    log_prerequisites = "Requires endpoint network-connection telemetry (Sysmon Event ID 3 or equivalent EDR) that populates the initiating process path, normalised to UDM NETWORK_CONNECTION. The %rfc1918_internal list must be populated for the tenant."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators scheduling jobs on hosts reached via a routable non-RFC1918 management range (e.g. carrier-grade NAT, public-addressed internal servers, IPv6 internal space); lab or test environments using public address space; legacy automation that still calls at.exe against remote servers."
    tuning_guidance = "Add legitimate administrator accounts to %global_allowed_admin_users and automation identities to %global_allowed_service_accounts. Where the client uses public or IPv6 ranges internally, extend %rfc1918_internal accordingly. To hunt internal lateral scheduling, clone the rule, remove the %rfc1918_internal exclusion and baseline per host. A renamed at.exe is not caught here; the endpoint process-launch rules and Windows event 4698/106 cover that case."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\at\.exe$/ nocase
    (
      $net.target.port = 135 or
      $net.target.port = 139 or
      $net.target.port = 445 or
      $net.target.port >= 49152
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.user.userid in %global_allowed_admin_users
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1053.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
