/*
  MITRE Technique : T1498.001 - Direct Network Flood
  Tactic(s)       : Impact
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:10:45.858139+00:00
  Reference       : https://attack.mitre.org/techniques/T1498/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_001_Inbound_OneSided_Volumetric_Flood {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a single perimeter flow record in which an external source sends a very large volume of UDP or ICMP traffic toward an internal destination and receives almost nothing back. One-sided, high-volume, stateless traffic is characteristic of a direct network flood (DoS/DDoS) against a Windows-hosted service. Network-side detection that does not depend on endpoint telemetry."
    mitre_tactic = "Impact"
    mitre_technique = "T1498.001"
    mitre_technique_name = "Network Denial of Service: Direct Network Flood"
    log_prerequisites = "Firewall or perimeter flow logs normalised to UDM NETWORK_FLOW with principal.ip, target.ip, network.ip_protocol, network.sent_bytes and network.received_bytes populated. Flow records must be aggregated or periodic (for example, long-lived flow summaries), not per-packet."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Authorised stress tests or load tests from external providers, vulnerability scanners, large legitimate UDP streams (media, VoIP, VPN tunnels, backup replication) terminating on internal hosts, asymmetric flow logging that omits the return direction, and CDN or partner traffic."
    tuning_guidance = "Add authorised scanner and load-test sources to %global_allowed_scanners and trusted partner or management addresses to %global_allowed_mgmt_sources. Adjust the sent_bytes threshold (default 100 MB per flow record) to match the flow export interval and the normal inbound volume of the client. If the firewall does not log the return direction, remove the received_bytes condition."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    ($net.network.ip_protocol = "UDP" or $net.network.ip_protocol = "ICMP")
    $net.network.sent_bytes > 100000000
    $net.network.received_bytes < 1000
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1498.001")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}

Wait — I excluded **internal** target addresses by mistake. A flood against an internal Windows host needs the target to be inside the network, so the rule above never fires on that traffic. Corrected rule:

rule MSSP_T1498_001_Inbound_OneSided_Volumetric_Flood {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a single perimeter flow record in which an external source sends a very large volume of UDP or ICMP traffic toward an internal destination and receives almost nothing back. One-sided, high-volume, stateless traffic is characteristic of a direct network flood (DoS/DDoS) against a Windows-hosted service. Network-side detection that does not depend on endpoint telemetry."
    mitre_tactic = "Impact"
    mitre_technique = "T1498.001"
    mitre_technique_name = "Network Denial of Service: Direct Network Flood"
    log_prerequisites = "Firewall or perimeter flow logs normalised to UDM NETWORK_FLOW with principal.ip, target.ip, network.ip_protocol, network.sent_bytes and network.received_bytes populated. Flow records must be aggregated or periodic (for example, long-lived flow summaries), not per-packet."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Authorised stress tests or load tests from external providers, vulnerability scanners, large legitimate UDP streams (media, VoIP, VPN tunnels, backup replication) terminating on internal hosts, asymmetric flow logging that omits the return direction, and CDN or partner traffic."
    tuning_guidance = "Add authorised scanner and load-test sources to %global_allowed_scanners and trusted partner or management addresses to %global_allowed_mgmt_sources. Adjust the sent_bytes threshold (default 100 MB per flow record) to match the flow export interval and the normal inbound volume of the client. If the firewall does not log the return direction, remove the received_bytes condition."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    ($net.network.ip_protocol = "UDP" or $net.network.ip_protocol = "ICMP")
    $net.network.sent_bytes > 100000000
    $net.network.received_bytes < 1000
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1498.001")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
