/*
  MITRE Technique : T1053 - Scheduled Task/Job
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:11:12.519725+00:00
  Reference       : https://attack.mitre.org/techniques/T1053
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_Linux_K8s_Exec_Then_CronJob_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an identity that execs into a running container (pods/exec) and then creates a Kubernetes CronJob within one hour. This pattern suggests hands-on access to a workload followed by scheduled-execution persistence through the cluster scheduler, a container-native form of T1053. It does not rely on process command-line matching."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053"
    mitre_technique_name = "Scheduled Task/Job"
    log_prerequisites = "Requires Kubernetes API server audit logs ingested and normalised to UDM. Exec requests must map to USER_RESOURCE_ACCESS and CronJob creation to RESOURCE_CREATION, with the request URI populated in target.url and the caller in principal.user.userid."
    platform = "Linux"
    log_source = "container"
    false_positives = "Platform engineers or SREs debugging a pod and then deploying a legitimate CronJob, CI/CD pipelines or GitOps controllers that use one identity for both actions, and operators or controllers that create CronJobs on behalf of applications."
    tuning_guidance = "Add automation and controller identities to %global_allowed_service_accounts and named platform administrators to %global_allowed_admin_users. Both lists are applied to both events. If audit logs normalise the request URI to a different field in your tenant, adjust the target.url patterns. Consider extending the match window for slow-moving operators."

  events:
    $exec.metadata.event_type = "USER_RESOURCE_ACCESS"
    $exec.target.url = /\/pods\/[^\/]+\/exec/ nocase
    $exec.principal.user.userid != ""
    $exec.principal.user.userid = $user
    not $exec.principal.user.userid in %global_allowed_service_accounts
    not $exec.principal.user.userid in %global_allowed_admin_users

    $cron.metadata.event_type = "RESOURCE_CREATION"
    $cron.target.url = /\/apis\/batch\/[^\/]+\/(namespaces\/[^\/]+\/)?cronjobs/ nocase
    $cron.principal.user.userid = $user
    not $cron.principal.user.userid in %global_allowed_service_accounts
    not $cron.principal.user.userid in %global_allowed_admin_users

    $exec.metadata.event_timestamp.seconds <= $cron.metadata.event_timestamp.seconds

  match:
    $user over 1h

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1053")
    $primary_entity = array_distinct($user)
    $exec_count = count($exec.metadata.id)
    $cronjob_names = array_distinct($cron.target.resource.name)
    $source_ips = array_distinct($cron.principal.ip)

  condition:
    $exec and $cron
}
