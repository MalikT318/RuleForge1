/*
  MITRE Technique : T1557 - Adversary-in-the-Middle
  Tactic(s)       : Credential Access, Collection
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:30:04.653348+00:00
  Reference       : https://attack.mitre.org/techniques/T1557
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1557_Name_Resolution_Poisoning_Response_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single host sends a high volume of UDP flows sourced from LLMNR (5355) or NetBIOS Name Service (137) ports. Normal hosts rarely do this. A poisoning tool such as an LLMNR/NBT-NS responder behaves this way when it answers broadcast or multicast name-resolution queries from many victims to position itself as an adversary-in-the-middle."
    mitre_tactic = "Credential Access, Collection"
    mitre_technique = "T1557"
    mitre_technique_name = "Adversary-in-the-Middle"
    log_prerequisites = "Firewall or network perimeter flow logs that record source port, destination IP and IP protocol for east-west or intra-VLAN traffic, normalised to UDM NETWORK_FLOW. Perimeter-only logging will not see same-segment poisoning."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate file or print servers and domain controllers answering NetBIOS name queries, Windows hosts responding to LLMNR in busy segments, network discovery or inventory tools, and mDNS/NBNS proxies."
    tuning_guidance = "Add known legitimate name-service responders (WINS/NBNS servers, domain controllers) to %global_allowed_mgmt_sources and authorised discovery sources to %global_allowed_scanners. Raise the threshold on large flat networks. Lower it where east-west flow logging is sparse."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    $net.network.ip_protocol = "UDP"
    ($net.principal.port = 5355 or $net.principal.port = 137)
    $net.principal.ip = $src_ip
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1557")
    $primary_entity = array_distinct($src_ip)
    $flow_count = count($net.metadata.id)
    $victim_ips = array_distinct($net.target.ip)
    $source_ports = array_distinct($net.principal.port)

  condition:
    #net >= 25
}
