/*
  MITRE Technique : T1071 - Application Layer Protocol
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : ESXi
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:02:49.887243+00:00
  Reference       : https://attack.mitre.org/techniques/T1071
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_ESXi_Host_Outbound_AppLayer_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi hypervisor host initiating an outbound connection to an external address on a common application-layer protocol port (web, DNS, SMTP). Hypervisor management interfaces rarely talk to the internet, so this traffic can indicate C2 blended into allowed protocols, such as a tunnelled implant or a reverse shell over 443. Observed from the network perimeter, so it complements process and command-line detections on the host."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071"
    mitre_technique_name = "Application Layer Protocol"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.hostname (or DNS/asset-resolved name), target.ip and target.port populated. ESXi management and vmkernel interfaces must traverse the logging firewall."
    platform = "ESXi"
    log_source = "firewall"
    false_positives = "ESXi hosts reaching vendor update and patch repositories, licensing or telemetry endpoints, NTP/DNS/SMTP relays hosted outside RFC1918 space, cloud-connected management (e.g. hybrid cloud or backup service endpoints), and vulnerability scanners using the host as a source."
    tuning_guidance = "Add approved vendor, update and cloud-service domains to %global_allowed_domains. Add approved ESXi management or update-proxy source addresses to %global_allowed_mgmt_sources. The ESXi host identification relies on a hostname containing esx, esxi or vmhost as a separate token; adjust the principal.hostname regex if the client uses a different naming convention. Extend the port list for client-specific application protocols."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname = /(^|[-_.])(esxi?|vmhost)/ nocase
    (
      $net.target.port = 80 or
      $net.target.port = 443 or
      $net.target.port = 8080 or
      $net.target.port = 8443 or
      $net.target.port = 53 or
      $net.target.port = 25
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1071")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
