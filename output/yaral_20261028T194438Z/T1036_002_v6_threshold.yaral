/*
  MITRE Technique : T1036.002 - Right-to-Left Override
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:59:53.561160+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_002_RTLO_Filename_Burst_Linux {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several files whose names contain the Unicode right-to-left override character (U+202E) are created on one Linux host within ten minutes. A single such file can be a legitimate non-Latin filename. A burst suggests an extracted phishing archive, a dropper staging disguised payloads, or a masquerading campaign."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.002"
    mitre_technique_name = "Masquerading: Right-to-Left Override"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-creation records normalised to UDM FILE_CREATION with target.file.full_path populated. The pipeline must preserve non-ASCII characters in file paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Users who legitimately handle Arabic or Hebrew filenames and some bidirectional-text editors. File sync clients, backup or restore jobs, and archive extraction of such content. Security scanners and test tooling that generate RTLO samples."
    tuning_guidance = "Add approved sync, backup and deployment processes to %global_allowed_backup_processes or %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Raise the count threshold on hosts used by bidirectional-language users. Lower it to 2 for servers where such filenames are never expected."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\x{202E}/
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1036.002")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $rtlo_files = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
