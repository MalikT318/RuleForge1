/*
  MITRE Technique : T1505.001 - SQL Stored Procedures
  Tactic(s)       : Persistence
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:26:16.889907+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_001_SQL_Server_Spawns_Shell_Or_LOLBin {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the SQL Server database engine process (sqlservr.exe) spawning a command interpreter, scripting host or common living-off-the-land binary. This lineage is the result of xp_cmdshell, CLR assembly or startup stored procedure abuse used for persistence or command execution. The rule keys on the parent/child relationship, not on command-line content."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.001"
    mitre_technique_name = "Server Software Component: SQL Stored Procedures"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry (EDR or Sysmon Event ID 1 or Security Event 4688 with parent process populated) on hosts running SQL Server."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "DBA-approved xp_cmdshell use for file operations, ETL or backup scripts, legacy application jobs that shell out from T-SQL, and vendor database maintenance or monitoring tools run through the engine."
    tuning_guidance = "Add database servers with approved xp_cmdshell workflows to %global_allowed_script_hosts. Add approved child tooling to %global_allowed_admin_tools. Where xp_cmdshell is formally disabled for a client, the rule can be raised to Critical."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\sqlservr\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|regsvr32|rundll32|certutil|bitsadmin|msbuild|installutil|whoami|net|net1|nltest|schtasks|sc)\.exe$/ nocase
    not $proc.principal.hostname in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1505.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
