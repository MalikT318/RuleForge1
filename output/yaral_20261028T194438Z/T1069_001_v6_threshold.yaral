/*
  MITRE Technique : T1069.001 - Local Groups
  Tactic(s)       : Discovery
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:58:11.818321+00:00
  Reference       : https://attack.mitre.org/techniques/T1069/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1069_001_Local_Group_Enumeration_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a high volume of Windows local group membership enumeration events (Security events 4798 and 4799) from a single host within 10 minutes. A single enumeration is routine OS behaviour, but repeated enumeration of local groups such as Administrators is typical of adversary discovery of privileged accounts. This rule uses audit-log telemetry rather than process command lines, so it also catches enumeration through PowerShell, WMI, .NET or API calls."
    mitre_tactic = "Discovery"
    mitre_technique = "T1069.001"
    mitre_technique_name = "Permission Groups Discovery: Local Groups"
    log_prerequisites = "Requires Windows Security event log forwarding with Audit Security Group Management and Audit User Account Management enabled (events 4798 and 4799), normalised to UDM USER_RESOURCE_ACCESS with metadata.product_event_type populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT inventory and compliance agents, RMM and patching tools, vulnerability scanners with authenticated checks, endpoint security agents, login scripts and management consoles that check group membership, and administrators troubleshooting access."
    tuning_guidance = "Add approved enumerating processes to %global_allowed_admin_tools or %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Raise the #grp threshold on hosts with heavy management tooling, or lower it for high-value servers."

  events:
    $grp.metadata.event_type = "USER_RESOURCE_ACCESS"
    $grp.metadata.product_event_type = /^(4798|4799)$/
    $grp.principal.hostname = $host
    not $grp.principal.user.userid = /\$$/
    not $grp.principal.user.userid in %global_allowed_service_accounts
    not $grp.principal.process.file.full_path in %global_allowed_admin_tools
    not $grp.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($grp.target.group.group_display_name = /(?i)(administrators|remote desktop users|backup operators|domain admins)/, 75, 50))
    $mitre_technique_id = array_distinct("T1069.001")
    $primary_entity = array_distinct($host)
    $event_count = count($grp.metadata.id)
    $enumerated_groups = array_distinct($grp.target.group.group_display_name)
    $enumerating_users = array_distinct($grp.principal.user.userid)
    $caller_processes = array_distinct($grp.principal.process.file.full_path)

  condition:
    #grp >= 10
}
