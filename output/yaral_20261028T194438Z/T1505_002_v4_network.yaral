/*
  MITRE Technique : T1505.002 - Transport Agent
  Tactic(s)       : Persistence
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:28:30.672647+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_002_Exchange_Transport_Process_Unexpected_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Exchange transport process (the host process for transport agents) opening an outbound connection to an external address on a port other than standard mail relay or DNS ports. A malicious transport agent loaded into the transport pipeline (for example, one that beacons to C2 or exfiltrates intercepted mail over HTTP/HTTPS or a custom port) produces this egress pattern. Normal transport traffic is SMTP, which this rule excludes."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.002"
    mitre_technique_name = "Server Software Component: Transport Agent"
    log_prerequisites = "Requires Windows endpoint network telemetry (EDR network connection events or Sysmon Event ID 3) with the initiating process path populated, collected from Exchange servers."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Hybrid Exchange / Exchange Online connectors using HTTPS, third-party mail security, DLP, archiving or journaling agents that call out to cloud services, antispam or reputation lookups over non-SMTP ports, and SMTP relays on non-standard ports."
    tuning_guidance = "Add approved vendor or cloud service domains to %global_allowed_domains. Review Exchange servers with legitimate hybrid or third-party agent egress and extend the port exclusions if a customer uses a custom relay port. Scope to Exchange servers only if the tenant's EDR reports a large number of non-Exchange hosts."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(EdgeTransport|MSExchangeTransport)\.exe$/ nocase
    $net.target.port != 25
    $net.target.port != 587
    $net.target.port != 465
    $net.target.port != 53
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1505.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $transport_process = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
