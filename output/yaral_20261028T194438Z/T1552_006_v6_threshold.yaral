/*
  MITRE Technique : T1552.006 - Group Policy Preferences
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:55:03.096938+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_006_GPP_Preference_Files_Bulk_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single host reads several Group Policy Preference XML files (Groups, Services, ScheduledTasks, DataSources, Printers, Drives) from SYSVOL within ten minutes. Any one read is normal Group Policy processing. Sweeping reads by a non-system process indicate harvesting of cpassword values."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.006"
    mitre_technique_name = "Unsecured Credentials: Group Policy Preferences"
    log_prerequisites = "Requires endpoint file-read telemetry (EDR or Sysmon-equivalent) that records file access to SYSVOL UNC paths and populates the acting process and target file path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy management and auditing tools, GPP migration or cleanup scripts, configuration compliance scanners, administrators reviewing policies, and RMM or deployment agents that read policy files."
    tuning_guidance = "Add approved audit and management binaries to %global_allowed_admin_tools, scanners to %global_allowed_security_tools, and named administrators to %global_allowed_admin_users. Raise the #file threshold if noisy. The svchost.exe exclusion covers the native Group Policy client service."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /\\sysvol\\.+\\policies\\.+\\preferences\\.+\\(groups|services|scheduledtasks|datasources|printers|drives)\.xml$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\\svchost\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1552.006")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $files_read = array_distinct($file.target.file.full_path)
    $reading_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 5
}
