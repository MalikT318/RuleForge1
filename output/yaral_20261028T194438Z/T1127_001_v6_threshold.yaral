/*
  MITRE Technique : T1127.001 - MSBuild
  Tactic(s)       : Stealth, Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:38:15.126662+00:00
  Reference       : https://attack.mitre.org/techniques/T1127/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1127_001_MSBuild_Executable_Drop_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "MSBuild.exe writes several executable or script files into user-writable staging locations on one host within ten minutes. A single file write is common in builds, but repeated drops of binaries and scripts into temp, AppData, ProgramData or Public paths indicate inline-task payload staging or proxy execution. This rule uses file-creation telemetry only, so it adds coverage beyond command-line process-launch rules."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1127.001"
    mitre_technique_name = "Trusted Developer Utilities Proxy Execution: MSBuild"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon Event ID 11) that populates the writing process path and the target file path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developer workstations and CI/build servers compiling projects, NuGet or package restore operations, Visual Studio or .NET SDK build caches, and software packaging pipelines that emit DLLs to temp or ProgramData."
    tuning_guidance = "Add build servers and developer hosts to %global_allowed_script_hosts. Add approved build tooling that launches MSBuild to %global_allowed_admin_tools. Raise the threshold on developer-heavy tenants. If a tenant has noisy IDE or SDK cache paths, narrow the staging-path regex per tenant."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\msbuild\.exe$/ nocase
    $file.target.file.full_path = /\.(exe|dll|scr|ps1|bat|cmd|vbs|js|hta)$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\appdata\\(local|roaming)|programdata|windows\\temp|users\\public)\\/ nocase
    $file.principal.hostname = $host
    not $file.principal.hostname in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1127.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_files = array_distinct($file.target.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
