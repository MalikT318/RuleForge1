/*
  MITRE Technique : T1001.001 - Junk Data
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:06:59.501778+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_001_Junk_Data_Random_Padding_Then_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a script interpreter launched with command-line logic that generates random or junk bytes and sends them over a web or socket client, followed within 10 minutes by an external network connection from a script interpreter on the same host. This pattern is consistent with padding C2 traffic with meaningless data to defeat simple decoding and signature inspection."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001.001"
    mitre_technique_name = "Data Obfuscation: Junk Data"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command lines (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing) and network connection telemetry (EDR or Sysmon Event ID 3) attributing connections to the originating process."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrative or developer scripts that generate random values (nonces, test payloads, jitter or back-off delays) and call web APIs; load-testing and fuzzing scripts; software packaging or deployment scripts; RMM health-check scripts that upload telemetry."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts and approved tooling to %global_allowed_admin_tools. If benign automation is noisy, add its executable to %global_allowed_admin_tools or scope it by host. Raise severity for servers or hosts with no scripting baseline. Add trusted external destinations to %global_allowed_domains if the network telemetry carries a domain."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|wscript|cscript)\.exe$/ nocase
    $proc.target.process.command_line = /(Get-Random|RNGCryptoServiceProvider|RandomNumberGenerator|GetNonZeroBytes|GetBytes\(|New-Object\s+(System\.)?Random|\[System\.Random\]|\[Random\]|Math\.random)/ nocase
    $proc.target.process.command_line = /(WebClient|UploadData|UploadString|Invoke-WebRequest|Invoke-RestMethod|HttpWebRequest|XMLHTTP|TcpClient|Net\.Sockets)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    $net.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1001.001")
    $primary_entity = array_distinct($hostname)
    $junk_command_lines = array_distinct($proc.target.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $connection_count = count($net.metadata.id)

  condition:
    $proc and $net
}
