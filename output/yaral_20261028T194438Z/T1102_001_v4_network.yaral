/*
  MITRE Technique : T1102.001 - Dead Drop Resolver
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:54:44.552344+00:00
  Reference       : https://attack.mitre.org/techniques/T1102/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1102_001_ScriptHost_HTTP_UserContent_Fetch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows scripting host or LOLBin (PowerShell, WScript, CScript, MSHTA, Regsvr32, Rundll32) issuing an outbound HTTP GET to an external host for a user-content or raw-content style URL path (raw, paste, snippet, gist). Dead drop resolvers are typically fetched this way: a small piece of attacker-controlled text on a legitimate web service that points to the real C2 infrastructure. This is a network-side detection and does not rely on process command lines."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1102.001"
    mitre_technique_name = "Web Service: Dead Drop Resolver"
    log_prerequisites = "Requires NETWORK_HTTP telemetry with principal process attribution and target.url populated, for example from an EDR network sensor, Sysmon-equivalent telemetry with HTTP inspection, or a TLS-inspecting proxy that correlates the process."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin or deployment scripts that download raw configuration or script files from code-hosting or paste services; DevOps tooling and package bootstrap scripts (PowerShell installers fetching raw files); developer workstations; software installers using rundll32 or regsvr32 helpers."
    tuning_guidance = "Add approved vendor, CDN and code-hosting domains to %global_allowed_domains. Add approved automation parents or hosts to %global_allowed_script_hosts and approved tooling binaries to %global_allowed_admin_tools. Developer and build-server populations can be handled by allowlisting the principal process in %global_allowed_script_hosts. Pair with an endpoint rule on the same host for higher confidence."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|regsvr32|rundll32)\.exe$/ nocase
    $http.network.http.method = "GET" nocase
    $http.target.url = /\/(raw|rawusercontent|snippets?|pastes?|gists?)(\/|\?|$)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.process.file.full_path in %global_allowed_script_hosts
    not $http.principal.process.file.full_path in %global_allowed_admin_tools
    not $http.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1102.001")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_process = array_distinct($http.principal.process.file.full_path)
    $contacted_hosts = array_distinct($http.target.hostname)
    $contacted_urls = array_distinct($http.target.url)
    $affected_user = array_distinct($http.principal.user.userid)

  condition:
    $http
}
