/*
  MITRE Technique : T1600 - Weaken Encryption
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:03:49.029521+00:00
  Reference       : https://attack.mitre.org/techniques/T1600
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_Weak_Encryption_Negotiated_Network_Device {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a perimeter or network-device connection that negotiated deprecated or broken cryptography: SSL 2.0/3.0, TLS 1.0/1.1, or NULL, EXPORT, anonymous, RC2/RC4, DES/3DES or MD5-based cipher suites. This is the network-observable result of weakened device encryption (reduced key space, disabled crypto hardware, modified system image), where the device downgrades the protection on traffic it terminates or forwards."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1600"
    mitre_technique_name = "Weaken Encryption"
    log_prerequisites = "Firewall, proxy or VPN gateway connection logs that populate the UDM network.tls.version and/or network.tls.cipher fields (TLS/SSL inspection or VPN session logging enabled). Without these fields the rule cannot fire."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legacy clients, appliances, printers, OT/IoT or partner systems that cannot negotiate modern TLS; vulnerability scanners and compliance tools probing for weak ciphers; devices running old firmware that was never hardened; lab or test equipment."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners. If a known legacy system is a persistent source, remediate it or exclude it narrowly rather than widening the cipher regexes. Review which destination devices terminate the weak sessions. A device that previously negotiated strong ciphers and now negotiates weak ones is the highest-fidelity signal for this technique."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.network.tls.version = /^(ssl|tls)[\s_-]*v?(1([._][01])?|2(\.0)?|3(\.0)?)$/ nocase or
      $net.network.tls.cipher = /(NULL|EXPORT|_EXP_|EXP-|anon|ADH|AECDH|RC4|RC2|3DES|MD5|(^|[^A-Za-z0-9])DES([^A-Za-z0-9]|$))/ nocase
    )
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1600")
    $primary_entity = array_distinct(strings.coalesce($net.target.hostname, $net.principal.hostname))
    $tls_versions = array_distinct($net.network.tls.version)
    $tls_ciphers = array_distinct($net.network.tls.cipher)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
