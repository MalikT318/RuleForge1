/*
  MITRE Technique : T1574.010 - Services File Permissions Weakness
  Tactic(s)       : Stealth, Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:39:14.213647+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_010_Service_Binary_Overwritten_By_UserLevel_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an existing executable, DLL or driver in a service-hosting location (Program Files, ProgramData, System32, SysWOW64) being modified by a process running from a user-writable path or by a script interpreter. This is the file-level result of replacing a service binary through weak file or directory permissions. It is detected from the file artifact rather than the command line, so it still fires when command-line logging is evaded."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.010"
    mitre_technique_name = "Hijack Execution Flow: Services File Permissions Weakness"
    log_prerequisites = "Requires EDR or Sysmon-equivalent file-modification telemetry (Sysmon Event ID 11/23-style) with the writing process path populated in principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-machine software updaters that stage from AppData or Temp, application installers run by a user with local admin rights, developers rebuilding binaries into ProgramData, and in-place patching by IT tooling not yet on the allowlist."
    tuning_guidance = "Add approved deployment and patching tooling to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Add further trusted installer or updater executable names to the writer-name exclusion regex. Raise severity or add a service-correlation rule where the modified binary is a known service ImagePath."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^[a-z]:\\(program files( \(x86\))?|programdata|windows\\(system32|syswow64))\\.+\.(exe|dll|sys)$/ nocase
    (
      $file.principal.process.file.full_path = /(\\users\\[^\\]+\\|\\users\\public\\|\\windows\\temp\\|\\perflogs\\|\\\$recycle\.bin\\)/ nocase or
      $file.principal.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|wmic)\.exe$/ nocase
    )
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path = /\\(msiexec|trustedinstaller|tiworker|wuauclt|usoclient|musnotification|svchost|mpcmdrun|msmpeng|sensecm|senseir|dism|dismhost|wusa)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1574.010")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
