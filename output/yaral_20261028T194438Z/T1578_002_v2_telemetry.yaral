/*
  MITRE Technique : T1578.002 - Create Cloud Instance
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:51:40.704269+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_002_Cloud_Compute_Instance_Created_By_Unapproved_Principal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a new compute instance or virtual machine recorded as a control-plane RESOURCE_CREATION state change by an identity that is not an approved service account, cloud principal or administrator. Adversaries create instances, often to mount snapshots of existing volumes, so they can work outside the firewall rules and permissions applied to existing workloads. The rule keys on the resource-creation event in the audit trail rather than on any command line, so it fires regardless of which CLI, SDK, console or IaC tool made the call."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578.002"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Create Cloud Instance"
    log_prerequisites = "Cloud provider control-plane audit logs with management or admin write events enabled and normalised to UDM RESOURCE_CREATION, with metadata.product_event_type and principal.user.userid populated. Required in every monitored account, subscription and project."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Autoscaling groups and managed instance groups scaling out under unlisted identities; CI/CD and infrastructure-as-code pipelines deploying compute; developers or engineers building legitimate test or dev VMs; disaster-recovery drills and migration tooling; managed container or batch services launching worker nodes under their own identities."
    tuning_guidance = "Add automation and pipeline identities to %global_allowed_service_accounts, approved federated or service principals to %global_allowed_cloud_principals, and named platform engineers to %global_allowed_admin_users. Because the principal is matched as a string, make sure the list entries use the same identifier format (ARN, email or object ID) that the client's logs populate in principal.user.userid. Consider raising severity for production accounts, and correlate with snapshot creation by the same principal (T1578.001) for higher confidence."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /(RunInstances|compute\.instances\.(insert|bulkInsert)|virtualMachines\/write|instances\.insert|CreateInstance)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1578.002")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_action = array_distinct($cloud.metadata.product_event_type)
    $created_resource = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
