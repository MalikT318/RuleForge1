/*
  MITRE Technique : T1098.007 - Additional Local or Domain Groups
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:50:45.740841+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_007_Linux_Service_Parent_Spawns_Group_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing service process (web server, application server, database, print service) launching a group-membership modification utility, or a shell that invokes one or touches /etc/group, /etc/gshadow or /etc/sudoers. These services have no legitimate reason to add accounts to local groups such as sudo, wheel or docker. This usually means a webshell, RCE or injected service is persisting privileged access. The detection pivots on process lineage rather than on the group-change command line alone."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.007"
    mitre_technique_name = "Account Manipulation: Additional Local or Domain Groups"
    log_prerequisites = "Linux endpoint process telemetry (EDR or auditd execve) populating both parent (principal.process) and child (target.process) executable paths, with command lines for shell children."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Application installers or package post-install scripts run under a service parent, such as a database or Tomcat package upgrade. Hosting control panels (web-hosting automation) that create site users and groups from a PHP or Java process. Self-service provisioning portals that run behind a web server. Configuration management agents launched via a Java or Node runtime."
    tuning_guidance = "Add approved provisioning parents or helper binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_admin_users. For hosting platforms that legitimately manage users from a web process, narrow the parent regex or allowlist that parent binary. Generic runtimes (java, node) are the noisiest parents. Allowlist specific wrapper binaries rather than removing them."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|php[0-9.]*|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|cupsd)$/ nocase
    (
      $proc.target.process.file.full_path = /\/(usermod|gpasswd|adduser|addgroup|groupmems)$/ nocase
      or
      (
        $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ash|ksh)$/ nocase
        and $proc.target.process.command_line = /(\b(usermod|gpasswd|adduser|addgroup|groupmems)\b|\/etc\/(group|gshadow|sudoers))/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(88)
    $mitre_technique_id = array_distinct("T1098.007")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
