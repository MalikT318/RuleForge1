/*
  MITRE Technique : T1499.001 - OS Exhaustion Flood
  Tactic(s)       : Impact
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:17:00.839024+00:00
  Reference       : https://attack.mitre.org/techniques/T1499/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1499_001_Firewall_TCP_Flood_Protection_Windows_Service_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Perimeter firewall flood-protection telemetry (SYN/ACK/connection-state exhaustion or DoS protection triggers) for connections from an external source to a port normally served by Windows hosts (SMB, RPC, RDP, WinRM, Kerberos, LDAP, Global Catalog). Detects the network-observable result of an OS state-table exhaustion flood rather than any endpoint command line."
    mitre_tactic = "Impact"
    mitre_technique = "T1499.001"
    mitre_technique_name = "Endpoint Denial of Service: OS Exhaustion Flood"
    log_prerequisites = "Firewall or network perimeter logs normalised to UDM NETWORK_CONNECTION with security_result.summary or security_result.description populated by the device's flood or DoS protection feature. The device must have SYN-flood or DoS protection logging enabled."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Authorised stress or load testing, vulnerability scanners and penetration tests, misconfigured or aggressively retrying clients, large legitimate bursts such as a branch office reconnecting after an outage, and a firewall flood threshold set too low for the environment."
    tuning_guidance = "Add authorised test and scan sources to %global_allowed_scanners and approved management or partner source addresses to %global_allowed_mgmt_sources. Adjust the target.port list to the services each client exposes. If the firewall's flood-protection wording differs, extend the summary/description regex. Raise severity for internet-facing server segments."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.security_result.summary = /(syn|ack|tcp|udp|icmp)[\s_\-]{0,3}(flood|exhaust)|flood[\s_\-]{0,3}(detect|protect|attack|threshold)|half[\s_\-]?open|(dos|ddos)[\s_\-]{0,3}(protect|attack|detect)|(connection|session|state)[\s_\-]{0,3}table[\s_\-]{0,3}(exhaust|full|limit)/ nocase or
      $net.security_result.description = /(syn|ack|tcp|udp|icmp)[\s_\-]{0,3}(flood|exhaust)|flood[\s_\-]{0,3}(detect|protect|attack|threshold)|half[\s_\-]?open|(dos|ddos)[\s_\-]{0,3}(protect|attack|detect)|(connection|session|state)[\s_\-]{0,3}table[\s_\-]{0,3}(exhaust|full|limit)/ nocase
    )
    (
      $net.target.port = 135 or
      $net.target.port = 139 or
      $net.target.port = 445 or
      $net.target.port = 3389 or
      $net.target.port = 5985 or
      $net.target.port = 5986 or
      $net.target.port = 88 or
      $net.target.port = 389 or
      $net.target.port = 636 or
      $net.target.port = 3268
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1499.001")
    $primary_entity = array_distinct(strings.coalesce($net.target.hostname, $net.target.ip))
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
