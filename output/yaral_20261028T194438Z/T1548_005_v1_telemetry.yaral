/*
  MITRE Technique : T1548.005 - Temporary Elevated Cloud Access
  Tactic(s)       : Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:33:42.623808+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_005_IdP_Self_Elevation_To_Privileged_Role {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a directory permission-change audit event in which an identity activates, assigns or is granted a privileged administrative role for itself (self-service just-in-time elevation). This catches temporary privilege elevation at the identity configuration layer, not through process command lines."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.005"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Temporary Elevated Cloud Access"
    log_prerequisites = "Requires identity provider directory/role-management audit logs ingested and normalised to USER_CHANGE_PERMISSIONS, with the actor in principal.user.userid, the recipient in target.user.userid, and the activity and role name in metadata.product_event_type or metadata.description."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Legitimate administrators using approved just-in-time role activation during change windows, helpdesk staff activating delegated admin roles, break-glass account tests, and onboarding automation that assigns roles to itself."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users, automation identities to %global_allowed_service_accounts, and approved service principals to %global_allowed_cloud_principals. Adjust the privileged role regex to match the role naming used by the client. If the client's logs put the role in a different field, change the metadata.description match accordingly. Raise severity for activations outside business hours or without an associated change ticket."

  events:
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.metadata.product_event_type = /(activat|elevat|assign|grant|add.*(member|role)|role.*(add|assign|grant)|impersonat|delegat)/ nocase
    $perm.metadata.description = /(global admin|company admin|super admin|org(anization)? admin|privileged (role|authentication)|security admin|application admin|cloud application admin|user admin|exchange admin|conditional access admin|owner|administrator)/ nocase
    $perm.principal.user.userid != ""
    $perm.principal.user.userid = $perm.target.user.userid
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1548.005")
    $primary_entity = array_distinct($perm.target.user.userid)
    $actor = array_distinct($perm.principal.user.userid)
    $source_ip = array_distinct($perm.principal.ip)
    $activity = array_distinct($perm.metadata.product_event_type)

  condition:
    $perm
}
