/*
  MITRE Technique : T1090.003 - Multi-hop Proxy
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:31:26.481715+00:00
  Reference       : https://attack.mitre.org/techniques/T1090/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1090_003_ESXi_SSH_Forwarding_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change on an ESXi host that enables SSH TCP forwarding, gateway ports, or tunnel devices. These settings let a compromised hypervisor act as a relay hop and chain proxied C2 traffic through the management network. It is detected as a host setting change rather than by process command line."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1090.003"
    mitre_technique_name = "Proxy: Multi-hop Proxy"
    log_prerequisites = "ESXi hostd and shell logs forwarded and parsed to UDM SETTING_MODIFICATION events. The sshd or host configuration change text must be populated in metadata.description or target.resource.name."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators who temporarily enable SSH forwarding for troubleshooting or vendor support, host profile or configuration management pushes that reapply sshd settings, and initial host build or hardening automation."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation or host-profile accounts to %global_allowed_service_accounts. If a change window is routine, scope it by account rather than by host. Confirm that the client's ESXi parser populates metadata.description or target.resource.name with the setting text."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    (
      $setting.metadata.description = /(allowtcpforwarding|gatewayports|permittunnel|allowstreamlocalforwarding)/ nocase or
      $setting.target.resource.name = /(allowtcpforwarding|gatewayports|permittunnel|allowstreamlocalforwarding)/ nocase
    )
    not $setting.metadata.description = /(allowtcpforwarding|gatewayports|permittunnel|allowstreamlocalforwarding)\W+(no|none)\W*$/ nocase
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1090.003")
    $primary_entity = array_distinct($setting.principal.hostname)
    $acting_user = array_distinct($setting.principal.user.userid)
    $changed_setting = array_distinct($setting.target.resource.name)

  condition:
    $setting
}
