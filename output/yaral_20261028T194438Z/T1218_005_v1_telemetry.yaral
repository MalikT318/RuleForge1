/*
  MITRE Technique : T1218.005 - Mshta
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:48:06.483660+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_005_Mshta_Registry_Persistence_Or_HTA_Handler_Hijack {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry state changes that persist or enable mshta.exe proxy execution: an autorun key (Run/RunOnce) whose value launches mshta, or modification of the .hta file-handler command (htafile\\shell\\open\\command) to something other than the genuine mshta.exe binary. Works at the registry layer, so it still fires if process command-line logging is evaded or the HTA is launched later by the autorun mechanism."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1218.005"
    mitre_technique_name = "System Binary Proxy Execution: Mshta"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon Event IDs 12/13/14) populating target.registry.registry_key and target.registry.registry_value_data."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy line-of-business applications that register an HTA-based launcher at logon, software installers that register HTA handlers, IT logon scripts deployed through autorun keys, and RMM or deployment tools writing Run keys."
    tuning_guidance = "Add approved installer and deployment binaries to %global_allowed_admin_tools and approved administrator accounts to %global_allowed_admin_users. If a client has a legitimate HTA-based autorun application, exclude the writing parent process via %global_allowed_admin_tools rather than loosening the regex."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      (
        $reg.target.registry.registry_key = /\\CurrentVersion\\Run(Once|Services|ServicesOnce)?(\\|$)/ nocase and
        $reg.target.registry.registry_value_data = /\bmshta(\.exe)?\b/ nocase
      )
      or
      (
        $reg.target.registry.registry_key = /\\Classes\\htafile\\shell\\open\\command/ nocase and
        not $reg.target.registry.registry_value_data = /^"?[a-z]:\\windows\\(system32|syswow64)\\mshta\.exe/ nocase
      )
    )
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.005")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_data = array_distinct($reg.target.registry.registry_value_data)
    $writer_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
