/*
  MITRE Technique : T1685.005 - Clear Windows Event Logs
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:23:41.261653+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_005_Log_Clearing_From_Anomalous_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects Windows event log clearing or log-file deletion carried out by a shell, script interpreter or wevtutil that was spawned by a parent process that should never launch administrative tooling. Such parents include Office applications, web server worker processes, the print spooler and database services. Office or web-facing code that clears logs usually indicates macro, web shell or service exploitation followed by anti-forensics. The rule pivots on process lineage, so it adds coverage beyond generic command-line detections."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.005"
    mitre_technique_name = "Clear Windows Event Logs"
    log_prerequisites = "Requires Windows endpoint process telemetry (EDR, Sysmon Event ID 1 or Security Event 4688 with parent process and command-line auditing enabled), populated in UDM as PROCESS_LAUNCH with principal.process (parent) and target.process (child)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Database or web application maintenance jobs that rotate or clear event logs via a script, installers or patching run from a service host, line-of-business applications with built-in log housekeeping, and administrators testing from an unusual parent."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts. Extend the parent regex with client-specific exposed services where needed. Where a legitimate housekeeping job is identified, exclude it by its parent executable rather than by install path."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|onenote|visio|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|sqlservr|spoolsv|mysqld|postgres|oracle)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(wevtutil|cmd|powershell|pwsh|wscript|cscript|mshta|wmic)\.exe$/ nocase
    $proc.target.process.command_line = /(\bwevtutil\b.*\b(cl|clear-log)\b|\bclear-eventlog\b|\bremove-eventlog\b|\bclearlog\b|\b(del|erase|remove-item|rm)\b.*\\winevt\\logs)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1685.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
