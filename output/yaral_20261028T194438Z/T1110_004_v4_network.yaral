/*
  MITRE Technique : T1110.004 - Credential Stuffing
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:09:17.371894+00:00
  Reference       : https://attack.mitre.org/techniques/T1110/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1110_004_ESXi_External_Mgmt_Port_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a connection from external address space to ESXi management-plane services (vSphere authd 902, CIM 5989, or SSH/HTTPS on hosts named as ESXi). ESXi management interfaces are the usual target of credential stuffing and password spraying, and they should never be reachable from the internet. This is a network-side view that complements endpoint and hostd/shell authentication rules."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1110.004"
    mitre_technique_name = "Brute Force: Credential Stuffing"
    log_prerequisites = "Firewall, proxy or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip, target.port. target.hostname is needed for the SSH/HTTPS branch. Populate %rfc1918_internal and %global_allowed_mgmt_sources for each client."
    platform = "ESXi"
    log_source = "firewall"
    false_positives = "Authorised remote administrators or MSP jump hosts connecting over VPN-NAT or public IPs, cloud-hosted vCenter or backup/DR services reaching hosts on port 902, authorised external vulnerability scans, and monitoring platforms polling CIM on port 5989."
    tuning_guidance = "Add approved admin, jump-host and vCenter/DR source addresses to %global_allowed_mgmt_sources. Add external scanner sources to %global_allowed_scanners. The SSH/HTTPS branch relies on ESXi hosts having an esx/vmhost naming convention in target.hostname; adjust the regex per client if their naming differs. Pair with a threshold rule on repeated hits from one source if volume is high."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 902 or
      $net.target.port = 5989 or
      (
        ($net.target.port = 22 or $net.target.port = 443) and
        $net.target.hostname = /(esx|vmhost)/ nocase
      )
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1110.004")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
