/*
  MITRE Technique : T1091 - Replication Through Removable Media
  Tactic(s)       : Lateral Movement, Initial Access
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:34:51.696498+00:00
  Reference       : https://attack.mitre.org/techniques/T1091
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1091_Autorun_Inf_Drop_Then_Root_Executable_Launch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an autorun.inf file written to the root of a non-system drive, followed within 10 minutes by an executable launched from the root of the same drive on the same host. This pattern matches Autorun-style propagation from removable media."
    mitre_tactic = "Lateral Movement, Initial Access"
    mitre_technique = "T1091"
    mitre_technique_name = "Replication Through Removable Media"
    log_prerequisites = "Requires Windows endpoint telemetry (EDR or Sysmon) that populates FILE_CREATION and PROCESS_LAUNCH events with full file paths and principal hostnames."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy installer or setup media (USB or mounted ISO) that ships an autorun.inf with a root-level setup executable, IT imaging or provisioning drives, portable-application USB suites, and secondary fixed data drives (D: and above) used for software staging."
    tuning_guidance = "Add approved deployment or provisioning tools to %global_allowed_admin_tools and backup or imaging writers to %global_allowed_backup_processes. Add EDR agents to %global_allowed_security_tools. For environments with fixed secondary drives, consider correlating with removable-device insertion telemetry or raising the severity only when the launched process runs from an interactive user session."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^[abd-z]:\\autorun\.inf$/ nocase
    $file.principal.hostname = $hostname
    $drive = strings.to_lower(re.capture($file.target.file.full_path, "^([a-zA-Z]):\\\\"))
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /^[abd-z]:\\[^\\]+\.(exe|scr|com|pif|bat|cmd)$/ nocase
    $proc.principal.hostname = $hostname
    $drive = strings.to_lower(re.capture($proc.target.process.file.full_path, "^([a-zA-Z]):\\\\"))
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $drive over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1091")
    $primary_entity = array_distinct($hostname)
    $autorun_paths = array_distinct($file.target.file.full_path)
    $launched_processes = array_distinct($proc.target.process.file.full_path)
    $launched_command_lines = array_distinct($proc.target.process.command_line)
    $affected_users = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
