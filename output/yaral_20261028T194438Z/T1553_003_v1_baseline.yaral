/*
  MITRE Technique : T1553.003 - SIP and Trust Provider Hijacking
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:02:15.697544+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_003_SIP_Trust_Provider_Registry_Hijack {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modification of Subject Interface Package (CryptSIPDll*) or Trust Provider (Cryptography\\Providers\\Trust\\*) registrations. Adversaries redirect these to a malicious DLL so that signature validation (WinVerifyTrust) reports unsigned or tampered code as validly signed, bypassing application control and signature checks."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.003"
    mitre_technique_name = "Subvert Trust Controls: SIP and Trust Provider Hijacking"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon registry events) with registry key paths and the initiating process path populated for HKLM\\SOFTWARE\\Microsoft\\Cryptography and the WOW6432Node equivalent."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers or updaters that register custom SIPs or trust providers (for example PowerShell or .NET updates, code-signing or document-signing products, some security and PKI agents); Windows servicing (TrustedInstaller) is excluded by process name."
    tuning_guidance = "Add approved installers, deployment tools and signing-product agents to %global_allowed_admin_tools, and EDR/AV agents to %global_allowed_security_tools. Review the initiating process and the DLL path written; legitimate SIP DLLs reside in System32 or a vendor's signed install directory."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Microsoft\\Cryptography\\(OID\\EncodingType\s0\\CryptSIPDll[A-Za-z0-9]+|Providers\\Trust\\(FinalPolicy|Initialization|Message|Signature|Certificate|CertCheck|Cleanup|DiagnosticPolicy))/ nocase
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1553.003")
    $primary_entity = array_distinct($reg.principal.hostname)
    $user = array_distinct($reg.principal.user.userid)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_name)
    $initiating_process = array_distinct($reg.principal.process.file.full_path)
    $initiating_command_line = array_distinct($reg.principal.process.command_line)

  condition:
    $reg
}
