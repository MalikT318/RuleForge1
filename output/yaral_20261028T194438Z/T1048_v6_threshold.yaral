/*
  MITRE Technique : T1048 - Exfiltration Over Alternative Protocol
  Tactic(s)       : Exfiltration
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:33:17.870287+00:00
  Reference       : https://attack.mitre.org/techniques/T1048
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1048_Volumetric_Alt_Protocol_Egress_Per_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single internal source sends a high volume of outbound flows to external destinations over alternative exfiltration protocols (FTP, TFTP, SMTP/SMTPS, FTPS, SMB) within ten minutes. Each flow is benign on its own; the repeated volume to non-internal space is the signal. Network-observable coverage that complements any process or command-line detection."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1048"
    mitre_technique_name = "Exfiltration Over Alternative Protocol"
    log_prerequisites = "Firewall, proxy or perimeter flow logs normalised to UDM NETWORK_FLOW with principal.ip, target.ip, target.port and network.sent_bytes populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Mail relays and application servers sending SMTP externally, managed file transfer or FTP/SFTP business integrations, cloud backup jobs, branch SMB traffic over WAN, vulnerability scanners and bulk-mail marketing platforms."
    tuning_guidance = "Add approved scanners and known egress-heavy sources to %global_allowed_scanners. Raise the #flow threshold for noisy mail or file-transfer servers. If the firewall populates hostname instead of IP, change the grouping field to principal.hostname. Use the total_bytes outcome to prioritise triage."

  events:
    $flow.metadata.event_type = "NETWORK_FLOW"
    (
      $flow.target.port = 20 or
      $flow.target.port = 21 or
      $flow.target.port = 25 or
      $flow.target.port = 69 or
      $flow.target.port = 445 or
      $flow.target.port = 465 or
      $flow.target.port = 587 or
      $flow.target.port = 989 or
      $flow.target.port = 990
    )
    $flow.network.sent_bytes > 0
    $flow.principal.ip = $src_ip
    not $flow.target.ip in %rfc1918_internal
    not $flow.principal.ip in %global_allowed_scanners

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(if($flow.network.sent_bytes > 10000000, 85, 65))
    $mitre_technique_id = array_distinct("T1048")
    $primary_entity = array_distinct($src_ip)
    $flow_count = count($flow.metadata.id)
    $total_bytes = sum($flow.network.sent_bytes)
    $destination_ips = array_distinct($flow.target.ip)
    $destination_ports = array_distinct($flow.target.port)

  condition:
    #flow >= 10
}
