/*
  MITRE Technique : T1003.007 - Proc Filesystem
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:49:19.405179+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_007_Proc_Memory_Scraper_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux process, or its parent shell, whose command line reads /proc/<pid>/mem or /proc/<pid>/maps while the process makes an outbound connection to a non-internal address. This is the network-side signature of credential material scraped from process memory and staged or exfiltrated in the same pipeline, such as a shell loop piped to a network client, a /dev/tcp redirect, or an interpreter that reads memory and posts the result. Complements command-line detections by firing on the external egress rather than the memory read."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.007"
    mitre_technique_name = "OS Credential Dumping: Proc Filesystem"
    log_prerequisites = "Linux endpoint telemetry that populates NETWORK_CONNECTION events with principal process and parent process command lines (EDR or auditd with socket/connect auditing enriched with process context)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Debuggers, profilers, or crash-dump and diagnostic tooling that read /proc/<pid>/maps and report to an external endpoint; backup or security agents inspecting process memory and phoning home; admin troubleshooting scripts that read /proc/<pid>/maps and upload to a vendor support portal."
    tuning_guidance = "Add approved diagnostic and monitoring binaries to %global_allowed_security_tools or %global_allowed_admin_tools, imaging software to %global_allowed_backup_processes, and automation accounts to %global_allowed_service_accounts. Vulnerability scanning hosts can be added to %global_allowed_scanners. Review the command_line outcome to confirm that a pid-based /proc/*/mem or maps reference is present."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.principal.process.command_line = /\/proc\/(\d+|\$\{?\w+\}?|self|\*|\$\([^)]*\))\/(mem|maps)\b/ nocase or
      $net.principal.process.parent_process.command_line = /\/proc\/(\d+|\$\{?\w+\}?|self|\*|\$\([^)]*\))\/(mem|maps)\b/ nocase
    )
    $net.target.port > 0
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1003.007")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $command_line = array_distinct($net.principal.process.command_line)
    $parent_command_line = array_distinct($net.principal.process.parent_process.command_line)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
