/*
  MITRE Technique : T1021.004 - SSH
  Tactic(s)       : Lateral Movement
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:40:27.525388+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_004_Linux_Service_Parent_Spawns_SSH_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an SSH client binary (ssh, scp, sftp, sshpass, autossh) launched directly by a web server, database, file-sharing, DNS or print service process on Linux. These services have no legitimate reason to open outbound SSH sessions. This lineage anomaly commonly indicates a web shell or a compromised service account pivoting to other hosts with valid credentials or keys. Detection uses process lineage only, not command-line content."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.004"
    mitre_technique_name = "Remote Services: SSH"
    log_prerequisites = "Requires Linux EDR or auditd (execve) process telemetry normalised to UDM PROCESS_LAUNCH, with parent (principal.process) and child (target.process) full paths populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web or database applications with a legitimate SSH-based feature (SFTP deployment or export plugins, backup or replication jobs invoked by the service, monitoring checks run from nginx/apache CGI), and admin-built management panels that wrap ssh/scp."
    tuning_guidance = "Add approved parent binaries to %global_allowed_script_hosts and approved management or deployment tooling to %global_allowed_admin_tools. Extend or narrow the parent service regex to match the environment's service inventory."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|php[0-9.]*|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|named|smbd|vsftpd|proftpd|cupsd)$/ nocase
    $proc.target.process.file.full_path = /\/(ssh|scp|sftp|sshpass|autossh)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1021.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
