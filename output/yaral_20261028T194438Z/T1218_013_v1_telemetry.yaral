/*
  MITRE Technique : T1218.013 - Mavinject
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:58:55.687510+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_013_Mavinject_Process_Handle_Open {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Microsoft Application Virtualization Injector (mavinject / mavinject32) requesting a handle to another process. This is the state change that precedes DLL injection or import descriptor injection through /INJECTRUNNING or /HMODULE. The rule keys on the process handle request, not the command line, so it still fires when command-line logging is evaded, obfuscated or truncated."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.013"
    mitre_technique_name = "System Binary Proxy Execution: Mavinject"
    log_prerequisites = "Requires EDR or Sysmon-equivalent process-access telemetry (Sysmon Event ID 10 or an EDR handle-open event) normalised to PROCESS_OPEN with principal and target process paths populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Microsoft App-V client operations that attach virtualised applications to running processes; software packaging or sequencing workstations; IT staff testing App-V deployments."
    tuning_guidance = "Add approved App-V or packaging tooling paths to %global_allowed_admin_tools, and service accounts that run App-V integration to %global_allowed_service_accounts. Where App-V is not deployed, any hit is highly suspicious. Where the handle-open telemetry is noisy, confirm the target process is not an EDR agent by adding it to %global_allowed_security_tools."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.process.file.full_path = /\\mavinject(32)?\.exe$/ nocase
    $open.target.process.file.full_path != ""
    not $open.target.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1218.013")
    $primary_entity = array_distinct($open.principal.hostname)
    $target_processes = array_distinct($open.target.process.file.full_path)
    $acting_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
