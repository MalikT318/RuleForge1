/*
  MITRE Technique : T1213 - Data from Information Repositories
  Tactic(s)       : Collection
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:22:33.720290+00:00
  Reference       : https://attack.mitre.org/techniques/T1213
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_OfficeSuite_External_Repository_Sharing {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of an anonymous (anyone-with-the-link) sharing link, or a sharing invitation, against content in a collaboration site or personal document library. Adversaries with a compromised account abuse external sharing to mine and expose information held in internal repositories, and the same sharing action is also a data exfiltration path to external recipients. This rule covers the cloud control-plane angle and does not depend on endpoint process telemetry."
    mitre_tactic = "Collection"
    mitre_technique = "T1213"
    mitre_technique_name = "Data from Information Repositories"
    log_prerequisites = "Requires unified audit log ingestion with file and site sharing activity (document library sharing and link events) normalised to USER_RESOURCE_ACCESS with metadata.product_event_type populated."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Employees legitimately sharing documents with customers, partners or vendors; marketing or communications teams publishing anonymous links; project sites with approved guest collaboration; migration or sync service accounts re-creating sharing links."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users, automation and migration accounts to %global_allowed_service_accounts, and approved integration principals to %global_allowed_cloud_principals. Raise severity for accounts with recent risky sign-ins, or restrict the target.url pattern to sites that hold sensitive content."

  events:
    $acc.metadata.event_type = "USER_RESOURCE_ACCESS"
    $acc.metadata.product_event_type = /^(AnonymousLinkCreated|SharingInvitationCreated)$/ nocase
    $acc.target.url = /\/(sites|teams|personal)\// nocase
    $acc.principal.user.userid != ""
    not $acc.principal.user.userid in %global_allowed_admin_users
    not $acc.principal.user.userid in %global_allowed_service_accounts
    not $acc.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1213")
    $primary_entity = array_distinct($acc.principal.user.userid)
    $shared_resources = array_distinct($acc.target.url)
    $sharing_action = array_distinct($acc.metadata.product_event_type)
    $source_ips = array_distinct($acc.principal.ip)

  condition:
    $acc
}
