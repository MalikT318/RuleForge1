/*
  MITRE Technique : T1552.004 - Private Keys
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:51:05.578113+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_004_Private_Key_File_Transfer_To_External_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an HTTP upload (POST/PUT) whose URL references a private key or certificate-bundle file (.key, .pem, .pfx, .p12, .ppk, .pgp, .gpg, or default SSH key names) sent to an external destination. This is the network-side signature of private key exfiltration after on-host key harvesting, and adds coverage independent of process or command-line telemetry. Public-certificate extensions (.cer, .crt, .p7b) are deliberately excluded to reduce noise."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.004"
    mitre_technique_name = "Unsecured Credentials: Private Keys"
    log_prerequisites = "Requires forward-proxy, secure web gateway, or TLS-inspecting perimeter logs that populate network.http.method and target.url in UDM NETWORK_HTTP events. Without TLS inspection, URL paths for HTTPS traffic are not visible and the rule will not fire."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Administrators or CI/CD pipelines uploading certificates to approved SaaS key vaults, PKI enrollment portals, or certificate management services; backup or sync tools moving key files to approved cloud storage; developers pushing keys to code or secrets platforms; vendor support portals accepting certificate bundles."
    tuning_guidance = "Add approved vendor, PKI, and cloud key-management domains to %global_allowed_domains. Internal destinations are already excluded via %rfc1918_internal. Narrow or widen the extension list as needed, for example add .cer if environment policy treats it as sensitive. If the proxy logs only the hostname and not the full URL, this rule needs an alternative data source."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT)$/ nocase
    $net.target.url = /(?i)(\.(key|pem|pfx|p12|ppk|pgp|gpg)([?#;\/]|$)|\/id_(rsa|dsa|ecdsa|ed25519)([?#;\/]|$))/
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1552.004")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
