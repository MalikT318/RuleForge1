/*
  MITRE Technique : T1132 - Data Encoding
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:43:57.664572+00:00
  Reference       : https://attack.mitre.org/techniques/T1132
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1132_ESXi_Remote_Login_Then_Encoded_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an SSH/shell login to an ESXi host from a source outside the approved management sources, followed within ten minutes by a shell command that pipes data between an encoder/decoder (base64, openssl enc, xxd, uuencode) and a network transfer utility. This pattern indicates encoded command-and-control or payload staging after interactive access. Coverage comes from the login-to-encoded-transfer sequence rather than from a standalone command-line match."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1132"
    mitre_technique_name = "Data Encoding"
    log_prerequisites = "Requires ESXi authentication logs (hostd/sshd) normalised to USER_LOGIN with principal.ip and target.application populated, and ESXi shell command logging (shell.log) normalised to PROCESS_LAUNCH with command_line populated. Both must carry the ESXi hostname in principal.hostname."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators from non-allowlisted jump hosts moving configuration or support bundles with base64 or openssl; backup, patching or monitoring scripts that encode data before curl/wget upload; vendor support sessions; automation that decodes downloaded payloads."
    tuning_guidance = "Add approved jump host and management addresses to %global_allowed_mgmt_sources, named administrators to %global_allowed_admin_users, automation accounts to %global_allowed_service_accounts, and sanctioned tooling parent processes to %global_allowed_admin_tools. Confirm that target.application is populated for SSH logins in the client's parser and adjust the login filter if it is not."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.target.application = /ssh/ nocase
    not $login.principal.ip in %global_allowed_mgmt_sources
    not $login.target.user.userid in %global_allowed_admin_users
    not $login.target.user.userid in %global_allowed_service_accounts
    $login.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(\b(base64|uuencode|xxd\s+-p|openssl\s+(enc|base64))\b.*\|\s*(\S*\/)?(nc|ncat|curl|wget|ssh|scp)\b|\b(curl|wget|nc|ncat)\b.*\|\s*(\S*\/)?(base64\s+(-d|--decode)|openssl\s+(enc|base64)\s+.*-d|xxd\s+-r|uudecode)\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    $login.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1132")
    $primary_entity = array_distinct($hostname)
    $source_ips = array_distinct($login.principal.ip)
    $login_users = array_distinct($login.target.user.userid)
    $encoded_commands = array_distinct($proc.target.process.command_line)
    $login_count = count($login.metadata.id)
    $command_count = count($proc.metadata.id)

  condition:
    $login and $proc
}
