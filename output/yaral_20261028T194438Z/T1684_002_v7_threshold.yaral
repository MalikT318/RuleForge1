/*
  MITRE Technique : T1684.002 - Email Spoofing
  Tactic(s)       : Stealth
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:34:44.621677+00:00
  Reference       : https://attack.mitre.org/techniques/T1684/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1684_002_Linux_Bulk_Mail_Sender_Header_Override {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated use of local mail-submission binaries on a single Linux host with command-line options that override the envelope sender or the From header (-f, -r, -a From:, -S from=), within 10 minutes. A single override is common in scripts, but a burst from one host indicates scripted sender spoofing, phishing relay, or abuse of a compromised host as a mail origin."
    mitre_tactic = "Stealth"
    mitre_technique = "T1684.002"
    mitre_technique_name = "Email Spoofing"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry normalised to UDM PROCESS_LAUNCH with full command-line capture."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Cron jobs and monitoring or alerting scripts that set a custom envelope sender, application notification mailers, mailing-list or bounce-handling software, and admins testing mail relay configuration."
    tuning_guidance = "Add known automation accounts to %global_allowed_service_accounts. Add approved mailer parents (monitoring agents, application wrappers) to %global_allowed_script_hosts. Raise the #proc threshold for noisy mail-relay hosts, or lower it for hosts that should never send mail."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(sendmail|mail|mailx|s-nail|mutt|msmtp|ssmtp|exim4?)$/ nocase
    $proc.target.process.command_line = /(\s-[fr]\s*\S*@\S+|\s-a\s+[\x22\x27]?from:|\s-S\s+[\x22\x27]?(from|sender)=|[\x22\x27]from:\s*\S+@)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1684.002")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $sample_command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 5
}
