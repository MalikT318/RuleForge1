/*
  MITRE Technique : T1055.001 - Dynamic-link Library Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:45:49.075020+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_001_DLL_Drop_Then_Cross_Process_Injection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A process writes a DLL to a user-writable or staging directory and then, within five minutes on the same host, performs process injection into a different process. This is consistent with DLL injection, where the payload is staged to disk and then loaded into a remote process."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.001"
    mitre_technique_name = "Process Injection: Dynamic-link Library Injection"
    log_prerequisites = "Requires endpoint telemetry that reports file creation (FILE_CREATION) and remote-thread or memory-write injection (PROCESS_INJECTION) with populated principal and target process paths, for example Sysmon Event IDs 11 and 8 or equivalent EDR sensors."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters that drop helper DLLs and hook into other processes, application compatibility shims, game anti-cheat and overlay software, accessibility and input tools, developer debuggers and profilers, and unlisted EDR/DLP agents."
    tuning_guidance = "Add approved installers, deployment and patching tooling to %global_allowed_admin_tools. Add EDR/AV and DLP agents to %global_allowed_security_tools. Add approved backup or imaging agents to %global_allowed_backup_processes. If a legitimate developer tool is noisy, scope it with %global_allowed_script_hosts rather than widening the path regex."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\[^\\]+\\appdata\\(local\\temp|local|roaming)|users\\public|programdata|windows\\temp|perflogs)\\.*\.dll$/ nocase
    $file.principal.hostname = $hostname
    $file.principal.process.file.full_path = $injector
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.hostname = $hostname
    $inj.principal.process.file.full_path = $injector
    $inj.target.process.file.full_path != $inj.principal.process.file.full_path
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes

    $file.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname, $injector over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.001")
    $primary_entity = array_distinct($inj.principal.hostname)
    $dropped_dlls = array_distinct($file.target.file.full_path)
    $injecting_process = array_distinct($inj.principal.process.file.full_path)
    $injected_targets = array_distinct($inj.target.process.file.full_path)
    $acting_users = array_distinct($inj.principal.user.userid)
    $dll_drop_count = count($file.metadata.id)

  condition:
    $file and $inj
}
