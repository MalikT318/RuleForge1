/*
  MITRE Technique : T1119 - Automated Collection
  Tactic(s)       : Collection
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:25:27.749624+00:00
  Reference       : https://attack.mitre.org/techniques/T1119
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1119_IaaS_Grant_Then_Bulk_Resource_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An identity grants itself or an application data-access permissions (consent, role, credential or key grant), then the same identity performs a burst of read, list, export or download resource access within 10 minutes. This pattern is consistent with scripted or API-driven bulk collection of cloud data (T1119) rather than interactive browsing."
    mitre_tactic = "Collection"
    mitre_technique = "T1119"
    mitre_technique_name = "Automated Collection"
    log_prerequisites = "Requires identity provider directory-audit and application-access logs normalised to UDM USER_CHANGE_PERMISSIONS and USER_RESOURCE_ACCESS with principal.user.userid and metadata.product_event_type populated."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Newly onboarded integrations (SaaS connectors, backup, SIEM or data-pipeline apps) that receive consent and immediately sync data; admin-led migrations; eDiscovery and compliance exports; automation accounts that rotate credentials and then read data."
    tuning_guidance = "Add approved automation identities to %global_allowed_service_accounts, approved cloud service principals to %global_allowed_cloud_principals, and named administrators to %global_allowed_admin_users. Raise the #access threshold in the condition for environments with chatty integrations, or narrow the product_event_type regexes to the event names used by the client's identity provider."

  events:
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.metadata.product_event_type = /(consent|grant|app.?role|oauth|permission|credential|secret|access.?key|delegat)/ nocase
    $perm.principal.user.userid != ""
    $perm.principal.user.userid = $user
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_cloud_principals

    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.metadata.product_event_type = /(list|get|read|download|export|search|query|sync)/ nocase
    $access.target.resource.name != ""
    $access.principal.user.userid = $user
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_cloud_principals

    $perm.metadata.event_timestamp.seconds <= $access.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1119")
    $primary_entity = array_distinct($perm.principal.user.userid)
    $access_count = count($access.metadata.id)
    $accessed_resources = array_distinct($access.target.resource.name)
    $grant_events = array_distinct($perm.metadata.product_event_type)
    $source_ips = array_distinct($access.principal.ip)

  condition:
    $perm and #access >= 10
}
