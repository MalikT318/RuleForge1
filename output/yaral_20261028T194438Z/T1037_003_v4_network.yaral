/*
  MITRE Technique : T1037.003 - Network Logon Script
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:22:03.080900+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_003_Logon_Script_Interpreter_External_SMB {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a logon-script-capable process (userinit, winlogon, or a script interpreter) opening an SMB/NetBIOS session (TCP 445/139) to a non-internal address. Legitimate network logon scripts are fetched from the internal NETLOGON/SYSVOL share on a domain controller. A logon script path that resolves to an external SMB server indicates a hijacked logon script assignment (AD scriptPath or GPO) that stages or runs attacker-controlled content at logon."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.003"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Network Logon Script"
    log_prerequisites = "Requires endpoint network telemetry that records the initiating process (EDR network events or Sysmon Event ID 3) with the destination IP and port populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Roaming or VPN-connected users whose logon scripts run against a domain controller or file server reached through a public or NAT address that is not in %rfc1918_internal; cloud-hosted domain controllers or Azure Files shares accessed over SMB; approved admin scripts mapping external file shares; backup or sync scripts using SMB to a hosted storage provider."
    tuning_guidance = "Ensure %rfc1918_internal covers the client's internal and VPN address space. Add legitimate cloud file share or hybrid DC addresses to %global_allowed_mgmt_sources. Add approved script host binaries or parent processes to %global_allowed_script_hosts and RMM/deployment tooling to %global_allowed_admin_tools. Pivot on the host's recent USER_LOGIN events and the user's AD scriptPath attribute to confirm."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 445 or $net.target.port = 139)
    $net.principal.process.file.full_path = /\\(userinit|winlogon|cmd|wscript|cscript|powershell|pwsh|mshta)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.principal.process.file.full_path in %global_allowed_script_hosts
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1037.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $affected_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
