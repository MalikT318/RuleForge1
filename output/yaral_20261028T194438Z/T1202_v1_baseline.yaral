/*
  MITRE Technique : T1202 - Indirect Command Execution
  Tactic(s)       : Stealth
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:53:14.589827+00:00
  Reference       : https://attack.mitre.org/techniques/T1202
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1202_Indirect_Command_Execution_LOLBin_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects built-in Windows utilities launched with the specific flags that make them execute another program or command on the caller's behalf, bypassing cmd.exe or interpreter restrictions. Covers forfiles /c launching an interpreter or LOLBin, pcalua -a, scriptrunner -appvscript, ssh -o ProxyCommand/LocalCommand, and wsl -e/--exec launching Windows binaries or shells."
    mitre_tactic = "Stealth"
    mitre_technique = "T1202"
    mitre_technique_name = "Indirect Command Execution"
    log_prerequisites = "Requires Windows process creation telemetry with full command line (EDR or Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or batch scripts using forfiles /c to run housekeeping commands, software deployment or RMM jobs that use ssh ProxyCommand/ProxyJump equivalents, developers using wsl -e to call Windows tools, and legacy installers launched through the Program Compatibility Assistant."
    tuning_guidance = "Add approved deployment, RMM and automation parent processes to %global_allowed_admin_tools, approved script-host parents to %global_allowed_script_hosts, and named administrator accounts to %global_allowed_admin_users. Tighten or extend the forfiles interpreter list per client if legitimate housekeeping scripts trigger it."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $proc.target.process.file.full_path = /\\forfiles\.exe$/ nocase and
        $proc.target.process.command_line = /\s[\/-]c\s+[\x22\x27]?([^\s\x22\x27]*\\)?(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|msiexec|certutil|bitsadmin|curl)(\.exe)?\b/ nocase
      ) or
      (
        $proc.target.process.file.full_path = /\\pcalua\.exe$/ nocase and
        $proc.target.process.command_line = /\s-a\s*\S/ nocase
      ) or
      (
        $proc.target.process.file.full_path = /\\scriptrunner\.exe$/ nocase and
        $proc.target.process.command_line = /-appvscript/ nocase
      ) or
      (
        $proc.target.process.file.full_path = /\\ssh\.exe$/ nocase and
        $proc.target.process.command_line = /-o\s*[\x22\x27]?\s*(ProxyCommand|LocalCommand)/ nocase
      ) or
      (
        $proc.target.process.file.full_path = /\\wsl\.exe$/ nocase and
        $proc.target.process.command_line = /\s(-e|--exec)\s+.*(\.exe|\/bin\/(ba)?sh\s+-c|\bpowershell|\bcmd\b)/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1202")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $proxy_binary = array_distinct($proc.target.process.file.full_path)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
