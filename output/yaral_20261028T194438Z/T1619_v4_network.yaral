/*
  MITRE Technique : T1619 - Cloud Storage Object Discovery
  Tactic(s)       : Discovery
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:43:11.749082+00:00
  Reference       : https://attack.mitre.org/techniques/T1619
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1619_Network_Storage_Bucket_Listing_Request {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP request to an external object-storage API that uses bucket or container listing query semantics (list-type, comp=list with restype=container, delimiter, max-keys). These requests enumerate stored objects and are typically the first step before bulk object retrieval. Detection is based on the storage REST API request structure, not on a provider name, domain, or tool."
    mitre_tactic = "Discovery"
    mitre_technique = "T1619"
    mitre_technique_name = "Cloud Storage Object Discovery"
    log_prerequisites = "Requires storage-access or HTTP request telemetry that is normalised to NETWORK_HTTP with metadata.event_type, network.http.method, and target.url populated, plus target.ip or principal.user.userid where available. Examples are object-storage server access or data-plane logs, egress proxy logs, and cloud-hosted web gateway logs. Management-plane-only audit logs that omit data-plane requests will not generate matching events."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Backup and data-protection jobs that enumerate buckets before copying, data-lake and ETL pipelines listing prefixes, storage sync clients, CI/CD artifact retrieval, cost and inventory reporting, DLP and CSPM scanners, and administrators browsing storage through a console or CLI."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts and %global_allowed_cloud_principals. Add authorised scanners to %global_allowed_scanners. Add known-good storage endpoints to %global_allowed_domains. For noisy tenants, promote to a Threshold rule that groups by principal.user.userid and counts listing requests over a short window. Review the actor against expected job schedules before escalating."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.target.url = /[?&](list-type=[0-9]+|restype=container|comp=list|delimiter=|max-keys=)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.user.userid in %global_allowed_cloud_principals
    not $net.principal.hostname in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1619")
    $primary_entity = array_distinct(strings.coalesce($net.principal.user.userid, $net.principal.hostname))
    $source_ips = array_distinct($net.principal.ip)
    $storage_hosts = array_distinct($net.target.hostname)
    $listing_urls = array_distinct($net.target.url)

  condition:
    $net
}
