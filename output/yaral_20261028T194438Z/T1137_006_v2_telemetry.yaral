/*
  MITRE Technique : T1137.006 - Add-ins
  Tactic(s)       : Persistence
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:22:34.417500+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_006_Office_Addin_File_Dropped {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of an Office add-in artifact (XLL, WLL, XLA/XLAM, PPA/PPAM, or a Word startup template) in an Office auto-load location such as the per-user AddIns, Word STARTUP or Excel XLSTART folders. Office loads these files at application start, so a new file there is a persistence mechanism. The rule keys on the resulting file artifact rather than command-line activity, so it still fires if process command-line logging is evaded."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.006"
    mitre_technique_name = "Office Application Startup: Add-ins"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with target.file.full_path and the writing process populated. The Office Suite add-in artifacts are observed through the endpoint where Office is installed, because M365 and Workspace audit logs do not record local add-in file drops."
    platform = "Office Suite"
    log_source = "windows_endpoint"
    false_positives = "Legitimate third-party Excel or Word add-in installers (finance, ERP and reporting plug-ins), IT software deployment of approved add-ins, users saving their own macro-enabled add-ins (XLAM) or startup templates, Office updates and repairs."
    tuning_guidance = "Add approved deployment and packaging tools to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. If a client has a sanctioned add-in, add its installer process to %global_allowed_admin_tools instead of widening the regex. Consider raising severity when the writing process is a script host, an Office application, or a process launched from a user-writable directory."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\Microsoft\\(AddIns|Word\\STARTUP|Excel\\XLSTART|Templates|Outlook)\\[^\\]+\.(xll|wll|xla|xlam|ppa|ppam|dotm|vba)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1137.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $user = array_distinct($file.principal.user.userid)
    $addin_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
