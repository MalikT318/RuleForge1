/*
  MITRE Technique : T1505.005 - Terminal Services DLL
  Tactic(s)       : Persistence
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:33:25.924413+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_005_TermServ_DLL_Tamper_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, script interpreter, or file/registry utility that touches the Terminal Services DLL (termsrv.dll) or the TermService Parameters/ServiceDll configuration and was spawned by an unexpected parent process such as an Office application, web server worker, database service, print spooler, WMI provider host, or script host. Legitimate Terminal Services changes come from servicing or admin tooling, not from document, web, or database processes. Lineage from such parents indicates exploitation or hands-on-keyboard persistence via ServiceDll hijacking."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.005"
    mitre_technique_name = "Server Software Component: Terminal Services DLL"
    log_prerequisites = "Requires Windows EDR or Sysmon process-creation telemetry (Sysmon Event ID 1 or Security Event 4688 with command-line auditing) populating parent process path, child process path, and command line."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Third-party RDP wrapper or concurrent-session tooling installed by IT through a script host, software deployment agents running as a child of a web or database service, and patching or hardening scripts launched by RMM tooling that reference termsrv.dll or the TermService key."
    tuning_guidance = "Add approved deployment, patching and RMM parent binaries to %global_allowed_admin_tools. Add approved automation hosts to %global_allowed_script_hosts. Add EDR and AV agents to %global_allowed_security_tools. If the parent process list is too noisy in a client environment, remove generic interpreters (mshta, wscript, cscript) from the parent regex and re-validate. Encoded PowerShell commands will not match the command-line filter, so pair this rule with script-block logging detections."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|sqlservr|spoolsv|wmiprvse|mshta|wscript|cscript)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|reg|regedit|sc|takeown|icacls|cacls|xcopy|robocopy|certutil|bitsadmin)\.exe$/ nocase
    $proc.target.process.command_line = /(termsrv\.dll|termservice\\parameters|termservice.*servicedll)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1505.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
