/*
  MITRE Technique : T1552.003 - Shell History
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:49:30.305320+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_003_macOS_Shell_History_File_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a non-shell process reading a user's persistent shell history file on macOS (zsh, bash, sh, fish). Adversaries search these files for credentials typed as command-line arguments. This is file-access based coverage, not process command-line matching. The request named Windows as the target platform but also required an alternate-platform angle and the macOS log source, so this rule covers macOS only."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.003"
    mitre_technique_name = "Unsecured Credentials: Shell History"
    log_prerequisites = "macOS endpoint telemetry that records file open/read events with the acting process path and target file path (for example from the Endpoint Security framework)."
    platform = "macOS"
    log_source = "macos_endpoint"
    false_positives = "Backup and imaging agents, endpoint security scanners, Spotlight indexing, user-initiated reads of their own history by admins or developers (for example cat, grep, or a text editor), and migration or provisioning tooling."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes, EDR/AV agents to %global_allowed_security_tools, and IT automation to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. If reads by common utilities such as cat or grep from interactive users are too noisy, raise severity only for non-interactive parents or add approved administrator accounts to %global_allowed_admin_users."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /^\/(Users\/[^\/]+|var\/root)\/(\.(bash_history|zsh_history|zhistory|sh_history)|\.zsh_sessions\/[^\/]+\.history|\.local\/share\/fish\/fish_history)$/ nocase
    not $file.principal.process.file.full_path = /\/(bash|zsh|sh|dash|ksh|tcsh|csh|fish|login)$/ nocase
    not $file.principal.process.file.full_path = /\/(mds|mds_stores|mdworker|mdworker_shared|fseventsd|backupd|Finder|Terminal)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1552.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $reading_process = array_distinct($file.principal.process.file.full_path)
    $history_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
