/*
  MITRE Technique : T1659 - Content Injection
  Tactic(s)       : Initial Access, Command and Control
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:02:47.213435+00:00
  Reference       : https://attack.mitre.org/techniques/T1659
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1659_Cleartext_Linux_Client_Executable_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a command-line or scripted HTTP client fetching an executable or script-type object over cleartext HTTP (port 80) from an external destination. Cleartext delivery of active content is the network condition that lets an on-path or on-side adversary inject or replace the payload in transit (T1659). The rule matches the combination of cleartext transport, an active-content URL suffix and a non-browser client user agent. It does not rely on specific domains, IPs or filenames."
    mitre_tactic = "Initial Access, Command and Control"
    mitre_technique = "T1659"
    mitre_technique_name = "Content Injection"
    log_prerequisites = "Requires proxy or perimeter firewall logs with URL inspection that populate network.http.user_agent, target.url and target.port, normalised to NETWORK_HTTP. Firewalls that cannot see the URL or user agent will not trigger this rule."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legacy internal build or provisioning scripts pulling installers over HTTP from external mirrors, package or repository mirrors serving .sh/.run installers, vendor agent installers distributed over cleartext, and authorised vulnerability or compliance scanners."
    tuning_guidance = "Add known-good external mirror and vendor domains to %global_allowed_domains. Add scanner source addresses to %global_allowed_scanners. If the proxy listens on a non-standard port, adjust the target.port condition for that client environment. Enforce HTTPS or integrity checking on legitimate flows to remove them at source."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.port = 80
    $http.network.http.method = "GET" nocase
    $http.target.url = /\.(sh|bash|elf|bin|run|so|py|pl)(\?[^\/]*)?$/ nocase
    $http.network.http.user_agent = /^(curl|wget|python-requests|python-urllib|go-http-client|libwww-perl|lwp-trivial)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1659")
    $primary_entity = array_distinct($http.principal.ip)
    $source_hostname = array_distinct($http.principal.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
