/*
  MITRE Technique : T1218.010 - Regsvr32
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:54:37.058763+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_010_Regsvr32_External_Connection_Then_Child_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Regsvr32 makes an outbound connection to a non-internal address and then spawns a shell, script host or other proxy-execution binary on the same host within 10 minutes. This is the typical Squiblydoo pattern: remote scriptlet or DLL retrieval followed by payload execution. The rule uses network telemetry and process lineage only, with no command-line matching, so it complements command-line detections."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.010"
    mitre_technique_name = "System Binary Proxy Execution: Regsvr32"
    log_prerequisites = "Requires endpoint telemetry that records network connections with the initiating process (EDR or Sysmon Event ID 3) and process launches with parent process (EDR, Sysmon Event ID 1 or Windows Event 4688)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers or updaters that run regsvr32 to download components and then launch a helper process; RMM or deployment tooling registering remote components; developer machines registering COM components fetched from internal or cloud build shares that resolve to public addresses."
    tuning_guidance = "Add approved deployment or packaging binaries to %global_allowed_admin_tools (matched against the child process path). Add known-good hostnames, such as build or packaging servers, to %global_allowed_script_hosts. Add vendor or CDN domains to %global_allowed_domains (applied to target.hostname when populated). Raise the match window or require specific child processes if noise remains."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\regsvr32\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    $net.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\regsvr32\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|msiexec|certutil|bitsadmin|wmic)\.exe$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.hostname in %global_allowed_script_hosts
    $proc.principal.hostname = $hostname

    $net.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(88)
    $mitre_technique_id = array_distinct("T1218.010")
    $primary_entity = array_distinct($hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $child_processes = array_distinct($proc.target.process.file.full_path)
    $users = array_distinct($proc.principal.user.userid)
    $connection_count = count($net.metadata.id)

  condition:
    $net and $proc
}
