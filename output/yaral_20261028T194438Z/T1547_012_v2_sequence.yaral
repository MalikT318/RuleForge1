/*
  MITRE Technique : T1547.012 - Print Processors
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:38:39.789638+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_012_Print_Processor_DLL_Drop_Then_Registration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a DLL written into the system print-processor directory (spool\\prtprocs) followed on the same host within 10 minutes by a registry write under a Print Processors key. This drop-then-register sequence is how a malicious print processor is installed for persistence and SYSTEM-level execution inside the print spooler. It relies on file and registry telemetry rather than command-line matching."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.012"
    mitre_technique_name = "Boot or Logon Autostart Execution: Print Processors"
    log_prerequisites = "Requires EDR or Sysmon file-creation and registry-modification telemetry normalised to UDM FILE_CREATION and REGISTRY_MODIFICATION, with principal.hostname populated on both."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate printer driver or print-management software installs (vendor driver packages, print server migrations), OS servicing and cumulative updates, and IT deployment tooling that stages print processors."
    tuning_guidance = "Add approved deployment, driver-install and patching tool paths to %global_allowed_admin_tools. Review the file-writer and registry-writer process outcomes to identify recurring benign installers. Extend the installer-name regex if a client has a standard print-management agent."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\spool\\prtprocs\\[^\\]+\\[^\\]+\.dll$/ nocase
    not $file.principal.process.file.full_path = /\\(drvinst|TrustedInstaller|TiWorker)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control\\Print\\Environments\\[^\\]+\\Print Processors\\/ nocase
    not $reg.principal.process.file.full_path = /\\(drvinst|TrustedInstaller|TiWorker)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    $reg.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1547.012")
    $primary_entity = array_distinct($hostname)
    $dropped_dlls = array_distinct($file.target.file.full_path)
    $file_writer_processes = array_distinct($file.principal.process.file.full_path)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_writer_processes = array_distinct($reg.principal.process.file.full_path)
    $registry_users = array_distinct($reg.principal.user.userid)

  condition:
    $file and $reg
}
