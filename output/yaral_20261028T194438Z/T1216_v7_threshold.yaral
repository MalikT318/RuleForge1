/*
  MITRE Technique : T1216 - System Script Proxy Execution
  Tactic(s)       : Stealth
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:33:51.894305+00:00
  Reference       : https://attack.mitre.org/techniques/T1216
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1216_Signed_Script_Proxy_Execution_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated launches of the Windows script hosts (wscript/cscript) running a script from a protected Windows system directory while passing a remote location or a script: moniker as an argument. This is the signed-script proxy execution pattern, where a trusted Microsoft script is used to run attacker-supplied code. A single launch can be benign. Several on one host within 10 minutes indicate abuse."
    mitre_tactic = "Stealth"
    mitre_technique = "T1216"
    mitre_technique_name = "System Script Proxy Execution"
    log_prerequisites = "Requires Windows EDR process telemetry or Sysmon Event ID 1 / Windows Security Event 4688 with command-line auditing enabled, normalised to UDM PROCESS_LAUNCH with target.process.command_line populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators and RMM or deployment tooling running built-in VBScript or WSF utilities against remote hosts or UNC shares. Licensing and activation scripts. Logon scripts that call system scripts with UNC arguments. Inventory and health-check automation."
    tuning_guidance = "Add approved parent tooling to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Add approved script-launching parents to %global_allowed_script_hosts. Raise the #proc threshold for noisy estates, or lower it to 2 for high-security client segments."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(wscript|cscript)\.exe$/ nocase
    $proc.target.process.command_line = /\\(system32|syswow64|sysnative)\\[^"]*\.(vbs|wsf)/ nocase
    $proc.target.process.command_line = /(script:|https?:\/\/|\\\\[a-z0-9_.\-]+\\)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1216")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
