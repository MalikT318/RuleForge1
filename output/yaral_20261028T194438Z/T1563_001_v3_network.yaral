/*
  MITRE Technique : T1563.001 - SSH Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:08:39.502946+00:00
  Reference       : https://attack.mitre.org/techniques/T1563/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_001_Outbound_SSH_To_External_From_Internal_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side indicator of SSH hijacking or agent-forwarding abuse: a connection to TCP/22 from an internal Linux host to a non-internal destination, from a source not on the approved management-source list. A hijacked SSH agent socket lets an attacker authenticate onward with the victim's keys, so the hijacked session appears as ordinary SSH egress from a server that does not normally originate SSH to external addresses. Perimeter logs cannot see the agent socket or the hijacked session, so this is a behavioural indicator to correlate with endpoint telemetry, not proof of hijacking."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1563.001"
    mitre_technique_name = "Remote Service Session Hijacking: SSH Hijacking"
    log_prerequisites = "Firewall, proxy or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Requires egress traffic to be logged."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Administrators or CI/CD runners that SSH or run git over SSH to external hosts (code repositories, SFTP partners, cloud instances), approved jump hosts and bastions not yet in the allowlist, and managed file-transfer or backup jobs that use SFTP."
    tuning_guidance = "Add bastion, jump host and automation source addresses to %global_allowed_mgmt_sources. Keep %rfc1918_internal current for the client's internal address space. If a client runs SSH on non-standard ports, extend the port condition per client. Consider raising severity for servers that should never originate SSH."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 22
    $net.principal.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1563.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
