/*
  MITRE Technique : T1547.001 - Registry Run Keys / Startup Folder
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:23:10.319339+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_001_RunKey_Registry_Write_Suspicious_Target {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry state change in a Windows Run, RunOnce, RunOnceEx or Policies\\Explorer\\Run autostart key (including Wow6432Node) where the written value points to a user-writable or staging location, or invokes a script interpreter or proxy-execution binary. This detects the persistence artifact itself rather than the command line that created it, so it still fires when the write comes from an API call, script, or renamed tool."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.001"
    mitre_technique_name = "Boot or Logon Autostart Execution: Registry Run Keys / Startup Folder"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events, equivalent to Sysmon Event ID 12/13) that populates target.registry.registry_key and target.registry.registry_value_data."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-user applications that register autostart entries from AppData (collaboration clients, cloud sync clients, updaters, chat apps); software installers that write Run keys pointing at temp or ProgramData paths; admin logon scripts that use cmd or PowerShell in a Run value; RMM and software deployment tooling."
    tuning_guidance = "Add approved deployment and RMM writer binaries to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. For noisy per-user applications, extend the writer-process name exclusion in the rule by executable name, not install path. Raise severity if the value data also contains encoded or download-cradle strings."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Software\\(Wow6432Node\\)?Microsoft\\Windows\\CurrentVersion\\(Run|RunOnce|RunOnceEx|RunServices|RunServicesOnce|Policies\\Explorer\\Run)(\\|$)/ nocase
    $reg.target.registry.registry_value_data = /(\\users\\[^\\]+\\appdata\\|\\appdata\\(local|roaming)\\|\\windows\\temp\\|\\temp\\|\\users\\public\\|\\perflogs\\|\\\$recycle\.bin\\|\b(powershell|pwsh|mshta|wscript|cscript|rundll32|regsvr32|msbuild|installutil|certutil|bitsadmin)(\.exe)?\b|\bcmd(\.exe)?\s+\/[ck]\b)/ nocase
    not $reg.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|OneDrive|OneDriveSetup)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1547.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $registry_value_data = array_distinct($reg.target.registry.registry_value_data)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
