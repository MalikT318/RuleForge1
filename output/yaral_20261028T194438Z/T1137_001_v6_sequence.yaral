/*
  MITRE Technique : T1137.001 - Office Template Macros
  Tactic(s)       : Persistence
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:15:20.229605+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_001_Office_Template_Write_Then_Office_Spawns_Script {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A non-Office process writes a file into an Office base-template or startup location (Normal.dotm, Word STARTUP, Excel XLSTART), followed within 10 minutes on the same host by an Office application spawning a script interpreter or LOLBin. This is consistent with a malicious template macro executing on application start."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.001"
    mitre_technique_name = "Office Application Startup: Office Template Macros"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (with the creating process populated) and process-launch telemetry with parent process lineage, normalised to UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Template deployment by IT (GPO logon scripts, RMM or software-distribution agents copying corporate templates or Normal.dotm); Office add-ins and legitimate macro-enabled workbooks that launch cmd or PowerShell; profile-migration or backup-restore tools that restore template files; user-profile roaming solutions."
    tuning_guidance = "Add template-deployment tooling to %global_allowed_admin_tools and EDR or backup agents to %global_allowed_security_tools. Add known-good Office parent-to-script workflows to %global_allowed_script_hosts. If the Office-child list is too noisy, remove cmd and rundll32 first. Consider shortening the 10m window on noisy estates."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\microsoft\\(templates\\[^\\]+\.(dotm|dotx|dot)|excel\\xlstart\\[^\\]+\.(xlsb|xlsm|xlam|xls)|word\\startup\\[^\\]+\.(dotm|dot|wll))$/ nocase
    not $file.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|onenote|msaccess|mspub)\.exe$/ nocase
    not $file.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1137.001")
    $primary_entity = array_distinct($hostname)
    $template_paths = array_distinct($file.target.file.full_path)
    $template_writer = array_distinct($file.principal.process.file.full_path)
    $office_parent = array_distinct($proc.principal.process.file.full_path)
    $spawned_child = array_distinct($proc.target.process.file.full_path)
    $child_command_lines = array_distinct($proc.target.process.command_line)
    $affected_users = array_distinct($proc.principal.user.userid)
    $event_count = count($proc.metadata.id)

  condition:
    $file and $proc
}
