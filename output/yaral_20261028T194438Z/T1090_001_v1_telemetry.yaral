/*
  MITRE Technique : T1090.001 - Internal Proxy
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:26:24.408950+00:00
  Reference       : https://attack.mitre.org/techniques/T1090/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1090_001_Linux_Proxy_Relay_Artifact_Dropped {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a proxy, relay or port-forwarding artifact on a Linux host. This covers a config file written to a world-writable staging directory (/tmp, /var/tmp, /dev/shm), or a systemd service unit with proxy/relay/forwarding semantics in its name written to a system or user unit directory. Both are common ways to set up and persist an internal proxy hop for C2 traffic. The rule looks at the resulting file state, not the command line, so it still fires when command-line logging is evaded or the binary is renamed."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1090.001"
    mitre_technique_name = "Proxy: Internal Proxy"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd (PATH/CREATE records) normalised to UDM FILE_CREATION with target.file.full_path and principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate reverse proxy, tunnel or load-balancer deployments by admins or configuration management; developers testing proxies from /tmp; container or CI jobs that generate temporary proxy configs; package post-install scripts that register proxy services."
    tuning_guidance = "Add configuration management, deployment and package tooling to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. If a client legitimately runs proxy services, narrow the keyword group in the path regex or add their administrators to %global_allowed_admin_users."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.*(proxy|socks|relay|redir|portfwd|portmap|tunnel|forward)[^\/]*\.(conf|cfg|ini|json|ya?ml|service)$|^\/(etc\/systemd\/system|usr\/lib\/systemd\/system|lib\/systemd\/system|home\/[^\/]+\/\.config\/systemd\/user|root\/\.config\/systemd\/user)\/[^\/]*(proxy|socks|relay|redir|portfwd|portmap|tunnel|forward)[^\/]*\.service$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1090.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
