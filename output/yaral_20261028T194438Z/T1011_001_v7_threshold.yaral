/*
  MITRE Technique : T1011.001 - Exfiltration Over Bluetooth
  Tactic(s)       : Exfiltration
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:23:18.224260+00:00
  Reference       : https://attack.mitre.org/techniques/T1011/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1011_001_Bluetooth_Transfer_Activity_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated use of the native Windows Bluetooth file transfer wizard, or script interpreters invoking Bluetooth/OBEX/RFCOMM APIs, on a single host within 10 minutes. One launch is benign. Repeated launches suggest staged data being pushed over a Bluetooth channel instead of the monitored network path."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1011.001"
    mitre_technique_name = "Exfiltration Over Other Network Medium: Exfiltration Over Bluetooth"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with full command lines (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Users legitimately sending files to phones, headsets or peripherals via the Bluetooth wizard. Developers and QA staff testing Bluetooth applications. IT staff pairing devices. Hardware vendor utilities that script the Windows Bluetooth APIs."
    tuning_guidance = "Add approved admin and pairing tooling to %global_allowed_admin_tools and approved script parents to %global_allowed_script_hosts. Add named administrator accounts to %global_allowed_admin_users. Raise the #proc threshold on endpoints where Bluetooth file transfer is a normal business workflow. Consider alerting only on hosts without a business need for Bluetooth."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $proc.target.process.file.full_path = /\\fsquirt\.exe$/ nocase
      or
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|python[0-9.]*)\.exe$/ nocase
        and $proc.target.process.command_line = /(Windows\.Devices\.Bluetooth|Windows\.Devices\.Enumeration|BluetoothDevice|BluetoothClient|BluetoothDeviceInfo|ObexPush|RfcommServiceProvider|RfcommDeviceService|bthprops)/ nocase
      )
    )
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1011.001")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $processes = array_distinct($proc.target.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
