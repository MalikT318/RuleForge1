/*
  MITRE Technique : T1027.001 - Binary Padding
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:38:37.561565+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_001_Oversized_Executable_Download_By_Script_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a scripting host or built-in download utility pulling an executable-type file (exe, dll, scr, msi, bin, jar) from an external server where the HTTP response is abnormally large (over 50 MB). Legitimate tooling downloaded this way is normally small. Very large executable payloads are characteristic of binary padding, where junk data is appended to inflate the file and evade size-limited scanners and hash blocklists."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.001"
    mitre_technique_name = "Obfuscated Files or Information: Binary Padding"
    log_prerequisites = "Requires NETWORK_HTTP events carrying principal process path, target URL and network.received_bytes (EDR network telemetry, Sysmon-equivalent, or a TLS-inspecting proxy joined to endpoint attribution). Endpoint coverage is assumed. This rule complements process command-line detections."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers or driver packages fetched by PowerShell or msiexec from vendor CDNs, RMM or patch-deployment scripts, developer or build automation pulling large artefacts, and administrators scripting ISO or MSI downloads."
    tuning_guidance = "Add approved vendor download domains to %global_allowed_domains, approved deployment or patching tooling to %global_allowed_admin_tools, and approved script-running parent processes to %global_allowed_script_hosts. The size threshold (52428800 bytes) can be raised in noisy environments or lowered to about 20 MB for high-sensitivity clients."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.principal.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta|certutil|bitsadmin|curl|rundll32|regsvr32|msiexec)\.exe$/ nocase
    $net.target.url = /\.(exe|dll|scr|msi|bin|jar)(\?.*)?$/ nocase
    $net.network.received_bytes > 52428800
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1027.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $downloader_process = array_distinct($net.principal.process.file.full_path)
    $download_url = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)
    $max_received_bytes = max($net.network.received_bytes)

  condition:
    $net
}
