/*
  MITRE Technique : T1222.002 - Linux and Mac Permissions
  Tactic(s)       : Defense Impairment
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:22:10.328859+00:00
  Reference       : https://attack.mitre.org/techniques/T1222/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_002_Linux_Bulk_Permission_Changes {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of risky file permission or ownership changes (recursive, world-writable, setuid/setgid, or immutable-attribute changes) against sensitive Linux directories on a single host within 10 minutes. A single chmod or chown is routine, but repeated risky changes on system paths suggest an adversary altering ACLs to gain access or lock out others."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1222.002"
    mitre_technique_name = "File and Directory Permissions Modification: Linux and Mac File and Directory Permissions Modification"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd (execve) records normalised to UDM PROCESS_LAUNCH with full command lines."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management runs (Ansible, Puppet, Chef), package installs and upgrades, application deployment scripts, web server or database setup, backup restores, and admins performing bulk remediation of permissions."
    tuning_guidance = "Add approved automation parent processes to %global_allowed_admin_tools, approved automation accounts to %global_allowed_service_accounts, and approved deployment hosts or parent shells to %global_allowed_script_hosts. Raise the #proc threshold on build or deployment servers. Narrow the sensitive-path regex if a client legitimately manages /opt or /home permissions in bulk."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(chmod|chown|chgrp|setfacl|chattr)$/ nocase
    $proc.target.process.command_line = /(\s-[a-zA-Z]*R|--recursive|\b[0-7]?777\b|\b[2467][0-7]{3}\b|[ugoa]*\+[rwx]*s\b|\bo\+[rwx]*w|\ba\+[rwx]*w|\bchattr\s+[-+][a-zA-Z]*i|\bsetfacl\s)/ nocase
    $proc.target.process.command_line = /\s\/(etc|root|boot|bin|sbin|lib|lib64|usr|opt|home|var\/(log|spool|www|lib)|tmp|dev\/shm)(\/|\s|$)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(re.regex($proc.target.process.command_line, `(?i)(\b[0-7]?777\b|\b[2467][0-7]{3}\b|\+s\b|chattr)`), 70, 50))
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1222.002")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 10
}
