/*
  MITRE Technique : T1574.013 - KernelCallbackTable
  Tactic(s)       : Stealth, Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:45:29.108729+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_013_Unexpected_Parent_Spawns_Sacrificial_GUI_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office application, web server, database service, print spooler or script host launching a bare, argument-less built-in GUI process (notepad, mspaint, calc, wordpad and similar). Adversaries using KernelCallbackTable hijacking commonly start a sacrificial GUI process, because only a process that has loaded user32.dll has a KernelCallbackTable in its PEB. They then rewrite a callback pointer, such as fnCOPYDATA, and trigger it with a window message. The memory write itself is not visible in process-launch telemetry, so this rule covers the lineage precursor: a non-interactive parent that has no legitimate reason to spawn a GUI utility with no document or arguments."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.013"
    mitre_technique_name = "Hijack Execution Flow: KernelCallbackTable"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with parent process path and full command line (EDR, Sysmon Event ID 1 or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Macros or add-ins that open Notepad or Calculator for a user; admins or helpdesk scripts run through wscript/cscript/mshta that open GUI utilities; web or database applications that shell out for diagnostics; legacy line-of-business software launching Notepad to show logs."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts and approved IT tooling to %global_allowed_admin_tools. Extend or narrow the parent and child regexes per client application estate. Because the rule is an indirect lineage precursor, correlate it with process-injection or process-open telemetry on the same host before escalating."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|w3wp|httpd|nginx|tomcat\d*|sqlservr|spoolsv|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(notepad|mspaint|calc|wordpad|write|charmap)\.exe$/ nocase
    $proc.target.process.command_line = /^"?[a-z]:\\[^"]*\\(notepad|mspaint|calc|wordpad|write|charmap)\.exe"?\s*$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1574.013")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
