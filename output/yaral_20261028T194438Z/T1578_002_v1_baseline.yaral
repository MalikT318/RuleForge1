/*
  MITRE Technique : T1578.002 - Create Cloud Instance
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:51:23.080654+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_002_Cloud_Instance_Created_By_Unapproved_Principal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a new virtual machine instance in a cloud account by an identity that is not an approved automation or service principal. Adversaries create instances to sidestep the firewall rules, security agents and permissions on existing workloads, for example to mount copied volume snapshots and stage data."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578.002"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Create Cloud Instance"
    log_prerequisites = "Cloud control-plane audit logs (management or admin activity events) ingested and parsed to UDM RESOURCE_CREATION with metadata.product_event_type and principal.user.userid populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Infrastructure-as-code pipelines, autoscaling groups and managed node pools launching instances, developers or administrators provisioning test VMs, disaster-recovery and migration tooling, and CI/CD runners that create ephemeral build hosts."
    tuning_guidance = "Add pipeline, autoscaling and provisioning identities to %global_allowed_service_accounts and approved cloud service principals to %global_allowed_cloud_principals. Review high-volume creators per tenant first. Raise severity when the creating identity is a first-time creator, the region is unusual for the tenant, or the event follows a snapshot or volume-copy event from the same identity."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /(RunInstances|virtualMachines\/write|instances\.(insert|bulkInsert)|instances\.insert)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1578.002")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_action = array_distinct($cloud.metadata.product_event_type)
    $instance_name = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)
    $region = array_distinct($cloud.target.location.name)

  condition:
    $cloud
}
