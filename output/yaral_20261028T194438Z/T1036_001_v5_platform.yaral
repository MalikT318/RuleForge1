/*
  MITRE Technique : T1036.001 - Invalid Code Signature
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:58:02.693282+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_001_Signed_Binary_Name_Dropped_Outside_System_Paths {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of an executable file on disk that carries the name of a core Microsoft-signed Windows binary (for example svchost.exe or lsass.exe) outside the trusted OS directories. Adversaries copy the name and metadata of signed programs onto unsigned payloads to look legitimate. Signature validation fields are rarely populated in UDM, so this rule uses file-creation telemetry (not PROCESS_LAUNCH command-line matching) and flags the name and location mismatch as a proxy for an invalid or imitated signature. Note: the requested alternate-platform angle conflicts with the mandatory Windows target platform, so this rule covers Windows through file-creation telemetry."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.001"
    mitre_technique_name = "Masquerading: Invalid Code Signature"
    log_prerequisites = "Requires endpoint file-creation telemetry populating target.file.full_path (EDR or Sysmon Event ID 11)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows servicing and feature updates staging OS binaries in temporary folders, software deployment or imaging tools, security product self-update, developers or admins copying system binaries for testing or forensics, and offline image servicing."
    tuning_guidance = "Add legitimate installers or deployment tooling to %global_allowed_admin_tools, and EDR or AV agents to %global_allowed_security_tools. Add approved automation accounts to %global_allowed_service_accounts. Extend the servicing-path or servicing-process exclusions if a client uses non-standard patching staging locations."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(svchost|lsass|csrss|smss|wininit|winlogon|services|spoolsv|taskhostw|dllhost|conhost|RuntimeBroker|SearchIndexer|fontdrvhost|sihost|ctfmon)\.exe$/ nocase
    not $file.target.file.full_path = /^[a-z]:\\(windows\\(system32|syswow64|winsxs|servicing|softwaredistribution|systemapps|immersivecontrolpanel)|\$winreagent|\$windows\.~bt|windows\.old)\\/ nocase
    not $file.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|MoUsoCoreWorker|wuauclt|musNotification|msiexec|SetupHost|WaaSMedic|SetupPrep|dismhost|dism)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1036.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
