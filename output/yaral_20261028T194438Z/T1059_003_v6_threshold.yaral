/*
  MITRE Technique : T1059.003 - Windows Command Shell
  Tactic(s)       : Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:10:37.600401+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_003_Batch_File_Drop_Volume_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several batch or command script files (.bat/.cmd) are created in user-writable or staging locations on a single host within ten minutes. One dropped script is usually benign, but a burst of them indicates staged cmd.exe execution by malware, droppers or hands-on-keyboard activity. This rule uses file-creation telemetry and does not match process command lines, so it complements process-launch detections."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.003"
    mitre_technique_name = "Command and Scripting Interpreter: Windows Command Shell"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) normalised to UDM FILE_CREATION with target.file.full_path and principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters unpacking temporary batch files, RMM and software deployment agents, developer build tooling, logon-script staging, and admin automation that generates .cmd wrappers."
    tuning_guidance = "Add approved deployment, patching and RMM binaries to %global_allowed_admin_tools. Add build servers or known scripting hosts to %global_allowed_script_hosts. Raise the #file threshold for noisy environments. Review the writer_processes and dropped_files outcome values to identify recurring benign installers."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\[^\\]+\\appdata\\(local|roaming)(\\low)?|users\\public|programdata|windows\\temp|windows\\tasks|perflogs)\\.*\.(bat|cmd)$/ nocase
    not $file.principal.process.file.full_path = /\\(msiexec|trustedinstaller|tiworker|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.hostname in %global_allowed_script_hosts
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1059.003")
    $primary_entity = array_distinct($host)
    $file_count = count($file.metadata.id)
    $dropped_files = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $affected_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 5
}
