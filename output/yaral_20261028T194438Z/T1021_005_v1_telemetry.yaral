/*
  MITRE Technique : T1021.005 - VNC
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:41:30.875301+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_005_Linux_VNC_Server_Config_Artifact_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of VNC server state or configuration files on a Linux host: a per-user .vnc directory (password, config, xstartup), system-wide VNC configuration directories, VNC password files, or a systemd unit for a VNC service. These files are the persistent result of enabling VNC remote desktop access, so the rule still fires when command-line logging is evaded or the VNC binary is renamed."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.005"
    mitre_technique_name = "Remote Services: VNC"
    log_prerequisites = "Requires Linux EDR or auditd file telemetry (FILE_CREATION) with target.file.full_path and principal.process.file.full_path populated. Auditd needs watch rules on /etc, /etc/systemd and user home directories."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate administrators or users configuring VNC for remote support; package installation of a VNC server (systemd unit and /etc config files); golden-image and configuration-management runs (Ansible, Puppet, Chef) deploying VNC settings; first-run initialisation of desktop environments with built-in screen sharing."
    tuning_guidance = "Add approved deployment and configuration tooling to %global_allowed_admin_tools and approved remote support tooling to %global_allowed_remote_mgmt. Add named administrator accounts to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. On servers that should never expose a desktop, raise severity. Correlate with a new listening port 5900-5999 from network telemetry for higher confidence."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(\/\.vnc\/(passwd|config|xstartup|[^\/]+\.passwd)$|\/etc\/(tigervnc|vnc)\/[^\/]+$|\/etc\/(x11vnc|vnc)[^\/]*\.(pass|passwd)$|\/systemd\/(system|user)\/[^\/]*vnc[^\/]*\.service$)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1021.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
