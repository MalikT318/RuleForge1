/*
  MITRE Technique : T1558.005 - Ccache Files
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:47:44.029475+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_005_Ccache_File_Written_By_Non_Kerberos_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a Kerberos credential cache (ccache) file by a process that is not a recognised Kerberos or login component. Legitimate ccache files are written by kinit, sshd (GSSAPI delegation), sssd/KCM, PAM login stacks and similar. A ccache written by a shell, interpreter, copy utility or unknown binary suggests ticket theft, ticket conversion, or staging of stolen tickets for Pass-the-Ticket use. The rule works from the file artifact, so it does not depend on command-line logging."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.005"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Ccache Files"
    log_prerequisites = "Linux endpoint telemetry (EDR or auditd file-watch rules on /tmp, /var/tmp, /dev/shm and home directories) that populates FILE_CREATION events with target.file.full_path, principal.process.file.full_path and principal.user.userid."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators copying or backing up ccache files for troubleshooting; custom SSO or PAM modules and containers that write ccache files from non-standard binaries; automation such as Ansible, cron jobs or CI runners that call kinit through wrapper scripts or set KRB5CCNAME to a custom path; Kerberos-enabled web or database services that cache service tickets."
    tuning_guidance = "Add approved custom authentication helpers or wrapper binaries to %global_allowed_admin_tools by full process path. Add Kerberos-enabled service or automation accounts to %global_allowed_service_accounts. If the environment uses a non-standard ccache naming scheme, review the legitimate writer binary list in the regex before widening the file-name pattern."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(^|\/)(krb5cc_[^\/]*|[^\/]+\.ccache|krb5\.ccache)$/ nocase
    $file.principal.process.file.full_path != ""
    not $file.principal.process.file.full_path = /\/(kinit|ksu|k5start|krenew|sshd|sssd|sssd_kcm|sssd_pam|gssproxy|login|su|sudo|gdm-session-worker|gdm-password|lightdm|sddm|systemd|systemd-logind|cron|crond|atd|vlock|xrdp-sesman|krb5kdc|kadmind)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1558.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $ccache_paths = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $acting_users = array_distinct($file.principal.user.userid)

  condition:
    $file
}
