/*
  MITRE Technique : T1547.003 - Time Providers
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:26:48.691351+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_003_TimeProvider_DLL_Drop_Then_Registration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a DLL file created on a host followed within ten minutes by a W32Time TimeProviders DllName registry value being set to a non-default provider DLL on the same host. This sequence indicates a malicious time provider being staged and registered for persistence, which loads at boot as Local Service."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.003"
    mitre_technique_name = "Boot or Logon Autostart Execution: Time Providers"
    log_prerequisites = "Requires EDR or Sysmon file creation telemetry (Sysmon EID 11) and registry modification telemetry (Sysmon EID 12/13) with registry value data populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Third-party time synchronisation or hypervisor guest tooling installing a custom time provider; legitimate vendor installers and patching agents that drop DLLs and register a provider; GPO or deployment tooling configuring custom NTP providers."
    tuning_guidance = "Add approved deployment, patching or installer binaries to %global_allowed_admin_tools. Add EDR or AV agents to %global_allowed_security_tools if they write DLLs during updates. If a vendor time provider is approved, extend the DllName value-data exclusion for it rather than disabling the rule."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.dll$/ nocase
    not $file.target.file.full_path = /\\(WinSxS|servicing|SoftwareDistribution|Installer)\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Services\\W32Time\\TimeProviders\\/ nocase
    $reg.target.registry.registry_value_name = /^DllName$/ nocase
    not $reg.target.registry.registry_value_data = /(^|\\)(w32time|vmictimeprovider)\.dll$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1547.003")
    $primary_entity = array_distinct($hostname)
    $dropped_dlls = array_distinct($file.target.file.full_path)
    $dropper_processes = array_distinct($file.principal.process.file.full_path)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registered_dll_values = array_distinct($reg.target.registry.registry_value_data)
    $registering_processes = array_distinct($reg.principal.process.file.full_path)
    $registering_users = array_distinct($reg.principal.user.userid)

  condition:
    $file and $reg
}
