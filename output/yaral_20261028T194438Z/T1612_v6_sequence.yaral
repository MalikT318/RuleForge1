/*
  MITRE Technique : T1612 - Build Image on Host
  Tactic(s)       : Stealth
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:34:15.992936+00:00
  Reference       : https://attack.mitre.org/techniques/T1612
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1612_Container_Image_Build_Then_Privileged_Run {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A container image is built directly on a host with a container CLI (build, buildx build, bud), and within 10 minutes a container is started or created on the same host with privileged or host-level options (--privileged, host PID or network namespace, root filesystem bind mount, container runtime socket mount). This build-then-deploy pattern lets an adversary create a custom image locally and avoid registry-based image scanning."
    mitre_tactic = "Stealth"
    mitre_technique = "T1612"
    mitre_technique_name = "Build Image on Host"
    log_prerequisites = "Requires container host process telemetry (EDR or auditd execve) with full command lines for container CLI binaries, normalised to UDM PROCESS_LAUNCH with principal.hostname populated."
    platform = "Containers"
    log_source = "container"
    false_positives = "CI/CD build agents that build and test images on the same node, developers on shared build hosts, image-builder tooling that runs privileged helper containers, and local test environments."
    tuning_guidance = "Add CI runner and build tooling binaries or parent processes to %global_allowed_admin_tools. Add build pipeline and automation accounts to %global_allowed_service_accounts. If dedicated build nodes are noisy, exclude them by adding their parent processes to %global_allowed_admin_tools."

  events:
    $build.metadata.event_type = "PROCESS_LAUNCH"
    $build.target.process.file.full_path = /\/(docker|podman|nerdctl|buildah|buildctl)$/ nocase
    $build.target.process.command_line = /\s(build|buildx\s+build|image\s+build|bud)(\s|$)/ nocase
    not $build.principal.process.file.full_path in %global_allowed_admin_tools
    not $build.principal.user.userid in %global_allowed_service_accounts
    $build.principal.hostname = $hostname

    $run.metadata.event_type = "PROCESS_LAUNCH"
    $run.target.process.file.full_path = /\/(docker|podman|nerdctl)$/ nocase
    $run.target.process.command_line = /\s(run|create)\s/ nocase
    $run.target.process.command_line = /(--privileged|--pid[= ]host|--net(work)?[= ]host|(-v|--volume)[= ]\/:|docker\.sock|containerd\.sock)/ nocase
    not $run.principal.process.file.full_path in %global_allowed_admin_tools
    not $run.principal.user.userid in %global_allowed_service_accounts
    $run.principal.hostname = $hostname

    $build.metadata.event_timestamp.seconds <= $run.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1612")
    $primary_entity = array_distinct($build.principal.hostname)
    $build_commands = array_distinct($build.target.process.command_line)
    $run_commands = array_distinct($run.target.process.command_line)
    $acting_users = array_distinct($build.principal.user.userid)
    $event_count = count($run.metadata.id)

  condition:
    $build and $run
}
