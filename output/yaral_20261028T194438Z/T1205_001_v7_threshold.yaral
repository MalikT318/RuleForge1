/*
  MITRE Technique : T1205.001 - Port Knocking
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:12:02.410475+00:00
  Reference       : https://attack.mitre.org/techniques/T1205/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_001_Linux_Port_Knock_Firewall_Recent_Module_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of iptables/ip6tables rule commands on a single Linux host that use the 'recent' match module with set/rcheck/update/remove operations within 10 minutes. This is the standard host-firewall construction for port knocking, where a sequence of connection attempts to closed ports dynamically opens a hidden service port. One such rule is common in hardening; several stateful knock-stage rules created together are not."
    mitre_tactic = "Stealth, Persistence, Command and Control"
    mitre_technique = "T1205.001"
    mitre_technique_name = "Traffic Signaling: Port Knocking"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records with full command-line arguments, normalised to PROCESS_LAUNCH."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators building SSH brute-force rate-limiting rules with the recent module, configuration management runs (Ansible, Puppet, Chef, Salt) applying firewall baselines, hardening scripts and benchmark remediation, and legitimate knock daemons on bastion hosts."
    tuning_guidance = "Add configuration management and deployment parent processes to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Add approved administrator accounts to %global_allowed_admin_users. Raise the #proc threshold for hosts that routinely apply rate-limit rules, such as bastions. Lower it to 2 on servers that should never use the recent module."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/ip6?tables(-legacy|-nft)?$/ nocase
    $proc.target.process.command_line = /-m\s+recent\b|--match\s+recent\b/ nocase
    $proc.target.process.command_line = /--(set|rcheck|update|remove)\b/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1205.001")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $sample_commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
