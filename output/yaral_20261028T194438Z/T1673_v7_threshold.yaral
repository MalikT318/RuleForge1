/*
  MITRE Technique : T1673 - Virtual Machine Discovery
  Tactic(s)       : Discovery
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:17:24.622584+00:00
  Reference       : https://attack.mitre.org/techniques/T1673
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1673_ESXi_VM_Discovery_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated virtual machine enumeration on a single ESXi host within ten minutes, using the hypervisor CLIs to list registered or running VMs and query their power state or summary. A single listing is routine administration. A burst of these commands from a shell session is typical of ransomware and intruder reconnaissance before VM shutdown or encryption."
    mitre_tactic = "Discovery"
    mitre_technique = "T1673"
    mitre_technique_name = "Virtual Machine Discovery"
    log_prerequisites = "ESXi shell command auditing or process execution events forwarded and normalised to UDM PROCESS_LAUNCH with principal.hostname and target.process.command_line populated. The shell, hostd and auth logs must be ingested."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Backup and replication agents that enumerate VMs before snapshots, monitoring or inventory scripts run from the ESXi shell, patching and lifecycle tooling, and administrators troubleshooting over SSH."
    tuning_guidance = "Add approved backup, monitoring and inventory parent processes to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Raise the #proc threshold on hosts where scheduled inventory scripts run frequently. Prioritise alerts where the same host also shows SSH enablement or off-hours logins."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(esxcli\b.*\bvm\s+process\s+list|vim-cmd\s+vmsvc\/(getallvms|get\.summary|get\.runtime|get\.guest|power\.getstate))/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1673")
    $primary_entity = array_distinct($host)
    $event_count = count($proc.metadata.id)
    $users = array_distinct($proc.principal.user.userid)
    $commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
