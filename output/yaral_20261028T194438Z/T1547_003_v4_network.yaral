/*
  MITRE Technique : T1547.003 - Time Providers
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:27:27.714934+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_003_W32Time_Host_Unexpected_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an svchost instance hosting the Windows Time service (W32Time, runs as LocalService) making an outbound connection to an external address on a port other than NTP/123. W32Time only needs UDP/123 for time synchronisation. A malicious time provider DLL registered under the W32Time TimeProviders registry key is loaded into this service process at boot, so any other external traffic from it suggests C2 or staging from the persistence implant."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.003"
    mitre_technique_name = "Boot or Logon Autostart Execution: Time Providers"
    log_prerequisites = "Requires Windows endpoint network telemetry (EDR or Sysmon Event ID 3) that populates principal.process.file.full_path, principal.process.command_line, target.ip and target.port."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Time zone auto-update or location-based services hosted in the LocalService svchost group, Windows diagnostics or telemetry components sharing the LocalService group, and proxy or NAT'd NTP implementations that use a non-standard port."
    tuning_guidance = "Add known-good external destination domains to %global_allowed_domains. Confirm that EDR populates principal.process.command_line for svchost; if it does not, the rule will not fire. Review the matched hosts' HKLM\\SYSTEM\\CurrentControlSet\\Services\\W32Time\\TimeProviders subkeys and the DllName values. Extend the port exclusion if the client uses a non-standard NTP port."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\system32\\svchost\.exe$/ nocase
    $net.principal.process.command_line = /(-k\s+"?LocalService\b|-s\s+w32time)/ nocase
    $net.target.port != 123
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1547.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $service_command_line = array_distinct($net.principal.process.command_line)

  condition:
    $net
}
