/*
  MITRE Technique : T1555.002 - Securityd Memory
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:53:48.592735+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_002_Linux_Credential_Daemon_Memory_Dump_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a memory-dump or core-file artifact in a user-writable staging location (/tmp, /var/tmp, /dev/shm, /root, /home) that is named after a credential-holding daemon (keyring, kwallet, gpg-agent, ssh-agent, securityd) or matches the default gcore output pattern core.<pid>. This is the Linux analogue of reading securityd memory to recover keychain secrets, detected at the resulting file artifact rather than the command line."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.002"
    mitre_technique_name = "Credentials from Password Stores: Securityd Memory"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-write/create records (PATH/SYSCALL) normalised to UDM FILE_CREATION, with target.file.full_path and principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers or admins running gcore/gdb for legitimate debugging, application crash dumps written to /tmp, backup or forensic tooling that images process memory, and security agents collecting memory samples."
    tuning_guidance = "Add approved debugging, backup and EDR binaries to %global_allowed_admin_tools, %global_allowed_backup_processes and %global_allowed_security_tools. Add named engineers to %global_allowed_admin_users. Widen the daemon-name alternation to include site-specific secret-store daemons. Remove the core.<pid> alternative on developer workstations if it is too noisy."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|root|home\/[^\/]+)\/(.*\/)?([^\/]*(keyring|kwallet|securityd|gpg-agent|ssh-agent)[^\/]*\.(dmp|dump|core|mem|raw|bin)|core\.[0-9]+)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1555.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $dump_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
