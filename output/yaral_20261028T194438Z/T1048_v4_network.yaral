/*
  MITRE Technique : T1048 - Exfiltration Over Alternative Protocol
  Tactic(s)       : Exfiltration
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:32:42.555650+00:00
  Reference       : https://attack.mitre.org/techniques/T1048
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1048_Perimeter_Outbound_Alt_Protocol_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host opening an outbound connection to an external address on a protocol commonly abused for exfiltration that is rarely needed directly across the internet perimeter: FTP/FTPS, TFTP, SMTP, SMB/NetBIOS or rsync. Observed from the network side, so it works regardless of endpoint tooling or the binary used."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1048"
    mitre_technique_name = "Exfiltration Over Alternative Protocol"
    log_prerequisites = "Requires firewall, proxy or perimeter connection/flow logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Egress (internal-to-external) traffic must be logged, including permitted sessions."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate mail servers and relays or applications sending SMTP direct to the internet, managed file transfer or vendor FTP/SFTP-adjacent integrations, backup or replication jobs using rsync, cloud-hosted SMB shares (for example Azure Files) reached by approved systems, and vulnerability scanners."
    tuning_guidance = "Add approved mail relays, managed file transfer hosts and backup servers to %global_allowed_mgmt_sources by source address. Add known-good partner or vendor domains to %global_allowed_domains. If SMTP egress from mail gateways is normal for the client, allowlist those gateways rather than removing ports. Consider raising severity to High where SMB (445/139) egress is not expected anywhere."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip in %rfc1918_internal
    not $net.target.ip in %rfc1918_internal
    (
      $net.target.port = 21 or
      $net.target.port = 69 or
      $net.target.port = 25 or
      $net.target.port = 465 or
      $net.target.port = 587 or
      $net.target.port = 990 or
      $net.target.port = 139 or
      $net.target.port = 445 or
      $net.target.port = 873
    )
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1048")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $bytes_out = max($net.network.sent_bytes)

  condition:
    $net
}
