/*
  MITRE Technique : T1216.002 - SyncAppvPublishingServer
  Tactic(s)       : Stealth
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:35:49.322045+00:00
  Reference       : https://attack.mitre.org/techniques/T1216/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1216_002_SyncAppvPublishingServer_Proxy_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the App-V publishing script (SyncAppvPublishingServer.vbs, or its .exe counterpart) launched with a semicolon-delimited argument. This is the injection pattern used to proxy arbitrary PowerShell through a signed Microsoft component, for example SyncAppvPublishingServer.vbs \"n; <powershell>\". Legitimate App-V publishing passes a server name or URL and never a semicolon-chained command."
    mitre_tactic = "Stealth"
    mitre_technique = "T1216.002"
    mitre_technique_name = "System Script Proxy Execution: SyncAppvPublishingServer"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with full command lines (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare. Possible sources are App-V administrators or packaging scripts that chain extra commands in the publishing-server argument, software deployment tooling that wraps App-V sync calls, and security testing or red-team exercises."
    tuning_guidance = "Add approved deployment or App-V management parent processes to %global_allowed_admin_tools, and EDR or security agent binaries to %global_allowed_security_tools. If the client does not use App-V, the rule can be kept as-is or the severity raised."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /SyncAppvPublishingServer(\.vbs|\.exe)?["']?\s+.*;/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1216.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
