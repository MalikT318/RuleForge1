/*
  MITRE Technique : T1573.002 - Asymmetric Cryptography
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:25:23.796961+00:00
  Reference       : https://attack.mitre.org/techniques/T1573/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1573_002_ESXi_Staged_Process_External_TLS {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi host process running from a world-writable staging location (/tmp, /var/tmp, /dev/shm, scratch, or a datastore volume) opening an outbound connection to an external address on a TLS-bearing port. Hypervisor hosts normally talk only to internal management, NTP and DNS endpoints. An unmanaged binary beaconing to the internet over public-key encrypted channels (TLS/SSH) is a strong sign of encrypted command and control. The rule observes the network side and does not depend on command-line content."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1573.002"
    mitre_technique_name = "Encrypted Channel: Asymmetric Cryptography"
    log_prerequisites = "ESXi network connection telemetry with the originating process path populated (for example host agent or security sensor forwarding connection events with process attribution), normalised to UDM NETWORK_CONNECTION."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators running a one-off update or patch download script from /tmp or a datastore; third-party backup, monitoring or hardware-vendor agents deployed into /scratch or a datastore volume that call out to vendor cloud services; temporary support or diagnostic upload tools used by vendor support."
    tuning_guidance = "Add approved agent and tooling binary paths to %global_allowed_admin_tools, %global_allowed_backup_processes or %global_allowed_security_tools. Add approved management or jump-host source addresses to %global_allowed_mgmt_sources. Add known vendor update domains to %global_allowed_domains. Extend or reduce the port list to match the environment's approved outbound TLS services."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|scratch|vmfs\/volumes)\// nocase
    (
      $net.target.port = 443 or
      $net.target.port = 8443 or
      $net.target.port = 4443 or
      $net.target.port = 22 or
      $net.target.port = 993 or
      $net.target.port = 995
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.target.hostname in %global_allowed_domains
    not $net.target.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1573.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_process = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
