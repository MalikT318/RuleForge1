/*
  MITRE Technique : T1222 - File and Directory Permissions Modification
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:16:15.952796+00:00
  Reference       : https://attack.mitre.org/techniques/T1222
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_Unexpected_Parent_Permission_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects file or directory permission and ownership modification (icacls, cacls, xcacls, takeown, Set-Acl) launched by an unexpected parent process: an Office application, web server worker, print spooler, or database service. These parents do not normally change ACLs. When they do, it usually indicates macro, web shell, or service exploitation."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1222"
    mitre_technique_name = "File and Directory Permissions Modification"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Application installers or updaters spawned from a database or web server service that reset ACLs on data or content directories; IIS or SQL Server maintenance scripts; Office add-ins or deployment macros run by IT; software packaging tools."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts. Add automation identities to %global_allowed_service_accounts. Add EDR and AV agents to %global_allowed_security_tools. If a web or database parent is legitimately used for deployment, exclude it by executable name, not by install path."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Unexpected parent: Office, web server, print spooler, database service
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|onenote|visio|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|spoolsv|sqlservr|mysqld|postgres|oracle)\.exe$/ nocase

    // Child: the permission tool itself or a shell/script host that wraps it
    $proc.target.process.file.full_path = /\\(icacls|cacls|xcacls|takeown|cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase

    // Behaviour: permission/ownership modification arguments
    $proc.target.process.command_line = /(\b(icacls|xcacls|cacls)(\.exe)?\b.*\/(grant|deny|setowner|reset|inheritance|remove)|\btakeown(\.exe)?\b.*\/f\b|\bSet-Acl\b|\bSetAccessControl\b|\bSetOwner\b)/ nocase

    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1222")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
