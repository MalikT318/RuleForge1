/*
  MITRE Technique : T1490 - Inhibit System Recovery
  Tactic(s)       : Impact
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:40:38.312479+00:00
  Reference       : https://attack.mitre.org/techniques/T1490
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1490_Containers_Backup_Snapshot_Deletion_Then_Recovery_Config_Tamper {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects one identity deleting snapshot, backup or recovery-point resources and then, within 10 minutes, modifying or disabling backup, retention, versioning or snapshot-policy settings. This pairing is typical of an adversary removing recovery options in container platform environments (managed Kubernetes clusters, VolumeSnapshot objects, persistent volume snapshots, container registries) ahead of destructive or ransomware activity. The rule uses control-plane audit events, not in-container command lines, so it complements process-based detections."
    mitre_tactic = "Impact"
    mitre_technique = "T1490"
    mitre_technique_name = "Inhibit System Recovery"
    log_prerequisites = "Requires cloud control-plane audit logging (API-level resource deletion and setting-modification events, including Kubernetes API audit logs for VolumeSnapshot objects) ingested and normalised to UDM with metadata.product_event_type and principal.user.userid populated."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Scheduled snapshot lifecycle or retention clean-up run by automation, infrastructure-as-code pipelines that replace backup policies, cluster decommissioning or migration, and administrators rotating backup configuration during planned maintenance."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, approved cloud or identity principals to %global_allowed_cloud_principals, and named administrators to %global_allowed_admin_users. Narrow the product_event_type regexes if a client's provider uses different event naming. Consider raising severity when the deleted resources belong to production clusters."

  events:
    $del.metadata.event_type = "RESOURCE_DELETION"
    $del.metadata.product_event_type = /(delete|remove|destroy|purge).*(snapshot|backup|recoverypoint|restorepoint|volumesnapshot)/ nocase
    $del.principal.user.userid = $user
    not $del.principal.user.userid in %global_allowed_service_accounts
    not $del.principal.user.userid in %global_allowed_cloud_principals
    not $del.principal.user.userid in %global_allowed_admin_users

    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.metadata.product_event_type = /(put|update|set|modify|disable|delete|remove|stop|suspend).*(backup|retention|lifecycle|versioning|snapshotpolicy|snapshotschedule|replication)/ nocase
    $cfg.principal.user.userid = $user
    not $cfg.principal.user.userid in %global_allowed_service_accounts
    not $cfg.principal.user.userid in %global_allowed_cloud_principals
    not $cfg.principal.user.userid in %global_allowed_admin_users

    $del.metadata.event_timestamp.seconds <= $cfg.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1490")
    $primary_entity = array_distinct($del.principal.user.userid)
    $deleted_resources = array_distinct($del.target.resource.name)
    $deletion_api_calls = array_distinct($del.metadata.product_event_type)
    $modified_settings = array_distinct($cfg.target.resource.name)
    $setting_api_calls = array_distinct($cfg.metadata.product_event_type)
    $source_ips = array_distinct($del.principal.ip)
    $deletion_count = count($del.metadata.id)

  condition:
    $del and $cfg
}
