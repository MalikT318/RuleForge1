/*
  MITRE Technique : T1561 - Disk Wipe
  Tactic(s)       : Impact
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:02:35.223466+00:00
  Reference       : https://attack.mitre.org/techniques/T1561
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1561_Outbound_SMB_NetBIOS_To_External_Wiper_Propagation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Perimeter firewall observes an internal asset initiating SMB (TCP/445) or NetBIOS session service (TCP/139) connections to an external, non-internal destination. Worm-capable disk-wiping malware propagates over SMB and Windows admin shares, and this is its network-side signature. Legitimate SMB across the internet perimeter is rare in a well-configured environment, so this is a high-signal indicator of wiper propagation, internet-wide SMB scanning, or a pre-staged destructive campaign. Endpoint coverage is assumed to handle the disk-write side."
    mitre_tactic = "Impact"
    mitre_technique = "T1561"
    mitre_technique_name = "Disk Wipe"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with target.ip and target.port populated, and egress logging enabled for allowed and denied traffic. The %rfc1918_internal list must be populated with the client's internal address strings."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Cloud-hosted file shares reached over SMB (for example Azure Files over TCP/445 via approved paths), site-to-site or VPN-tunnelled SMB logged with public peer addresses, authorised external vulnerability scanning and penetration tests, misconfigured clients or NAS devices attempting SMB to public addresses, and inbound-response flows logged with reversed direction."
    tuning_guidance = "Add authorised scanner and pentest source addresses to %global_allowed_scanners and approved management or jump sources to %global_allowed_mgmt_sources. Ensure %rfc1918_internal is complete for the client, including any private ranges used over VPN. If the client legitimately uses cloud SMB shares, scope the destination with an allow-list in %global_allowed_domains where the destination hostname is populated."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 445 or
      $net.target.port = 139
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1561")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
