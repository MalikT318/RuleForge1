/*
  MITRE Technique : T1560.002 - Archive via Library
  Tactic(s)       : Collection
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:59:44.896570+00:00
  Reference       : https://attack.mitre.org/techniques/T1560/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1560_002_Linux_Archive_Upload_Via_Script_Runtime {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux script runtime (Python, Perl, Ruby, PHP, Node) sending an HTTP POST or PUT to an external destination where the request URL targets an archive file (zip, tar, gz, bz2, xz, 7z, rar, zst). Interpreters that build archives with in-process libraries such as zlib, libzip, or rarfile leave no archiver utility in the process tree, so this network-side view complements endpoint command-line detections."
    mitre_tactic = "Collection"
    mitre_technique = "T1560.002"
    mitre_technique_name = "Archive Collected Data: Archive via Library"
    log_prerequisites = "Requires Linux endpoint network telemetry (EDR or auditd-derived) that populates NETWORK_HTTP events with principal process path, HTTP method, and target URL."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Build and CI jobs publishing artifacts to external registries, application backup or log-shipping scripts uploading archives to cloud storage, package publishing tools (e.g. Python or Node package uploads), and legitimate data-science or ETL jobs pushing compressed datasets."
    tuning_guidance = "Add approved destination domains to %global_allowed_domains, backup and archiving agents to %global_allowed_backup_processes, and approved automation or deployment tooling to %global_allowed_admin_tools. Scope noisy build hosts via %global_allowed_script_hosts. Consider raising severity when sent_bytes is large."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT)$/ nocase
    $net.target.url = /\.(zip|tar|tgz|gz|bz2|tbz2|xz|7z|rar|zst)(\?|#|$)/ nocase
    $net.principal.process.file.full_path = /\/(python[0-9.]*|perl|ruby|php[0-9.]*|node|nodejs)$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1560.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_urls = array_distinct($net.target.url)
    $source_processes = array_distinct($net.principal.process.file.full_path)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
