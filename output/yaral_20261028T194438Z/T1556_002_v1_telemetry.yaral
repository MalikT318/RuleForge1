/*
  MITRE Technique : T1556.002 - Password Filter DLL
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:16:01.465221+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_002_LSA_Notification_Packages_Registry_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry change to the LSA 'Notification Packages' value, which lists the password filter DLLs the Local Security Authority loads. Registering a malicious password filter lets an adversary capture plain-text credentials on every password change. This rule watches the registry state change itself, so it fires regardless of how the change was made (reg.exe, PowerShell, WMI, API calls or custom tooling) and does not depend on command-line logging."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.002"
    mitre_technique_name = "Modify Authentication Process: Password Filter DLL"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events 12/13/14) that populates target.registry.registry_key and the writing process path. Domain controllers and any host with local accounts of interest should be covered."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate third-party password policy or password-sync products (for example enterprise password complexity filters or self-service reset agents) registering their filter DLL during install or upgrade; Windows servicing or role installation touching the default scecli package; software deployment and configuration management tooling pushing approved password-filter changes."
    tuning_guidance = "Add approved deployment, patching and configuration-management binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Review the registry_value_data outcome to confirm whether the added package is a known vendor filter. Expect a few changes during change windows on domain controllers; correlate with change tickets."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control\\Lsa(\\|$)/ nocase
    (
      $reg.target.registry.registry_value_name = /^Notification Packages$/ nocase or
      $reg.target.registry.registry_key = /\\Notification Packages$/ nocase
    )
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1556.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_data = array_distinct($reg.target.registry.registry_value_data)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
