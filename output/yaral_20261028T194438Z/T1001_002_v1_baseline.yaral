/*
  MITRE Technique : T1001.002 - Steganography
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:07:36.846673+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_002_ESXi_Image_Embedded_Payload_Extraction {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi shell command that extracts hidden data from an image file and decodes or executes it. Two patterns are matched. The first pipes an image file into a decoder or interpreter (base64 -d, xxd -r, openssl -d, sh, python). The second uses dd with an offset (skip=) to carve bytes out of an image file. Both are typical steganographic C2 payload handling on a hypervisor, where no legitimate workflow decodes image content."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001.002"
    mitre_technique_name = "Data Obfuscation: Steganography"
    log_prerequisites = "ESXi shell command auditing forwarded to Chronicle and parsed to PROCESS_LAUNCH with target.process.command_line populated. This normally requires shell.log or syslog forwarding of executed commands."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators carving or re-encoding VM console screenshots or branding images on a datastore, support staff running dd or base64 against image files while troubleshooting, and custom host-customisation scripts that base64-decode embedded image assets (for example for a vendor UI plugin or an installer bundle)."
    tuning_guidance = "Add approved admin or automation parent binaries to %global_allowed_admin_tools and approved automation accounts to %global_allowed_service_accounts. Review recurring hits by principal.hostname and command_line before allowlisting. Do not allowlist by image file name or directory."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line != ""
    (
      $proc.target.process.command_line = /\.(jpe?g|png|gif|bmp|ico|webp)\b.*\|\s*(base64\s+(-d|--decode)|xxd\s+-r|openssl\s+\S+\s+.*-d|(ba|a)?sh|python[0-9.]*)(\s|$)/ nocase
      or
      $proc.target.process.command_line = /\bdd\b.*\bif=\S+\.(jpe?g|png|gif|bmp|ico|webp)\b.*\bskip=/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1001.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
