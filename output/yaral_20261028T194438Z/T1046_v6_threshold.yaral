/*
  MITRE Technique : T1046 - Network Service Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:29:59.885655+00:00
  Reference       : https://attack.mitre.org/techniques/T1046
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1046_IaaS_K8s_API_Service_Enumeration_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single identity issues a high volume of Kubernetes API read requests against service, endpoint, endpoint-slice and node collections within ten minutes. This pattern is typical of in-cluster service discovery with a stolen or abused service-account token or user credential. Each request is benign on its own; the volume from one identity is the signal."
    mitre_tactic = "Discovery"
    mitre_technique = "T1046"
    mitre_technique_name = "Network Service Discovery"
    log_prerequisites = "Requires Kubernetes API server audit logs (request URI and authenticated user) ingested and parsed to UDM USER_RESOURCE_ACCESS events."
    platform = "IaaS"
    log_source = "container"
    false_positives = "Service meshes, ingress controllers, DNS and service-discovery controllers, monitoring and observability agents, GitOps and deployment tooling, autoscalers, and admins running kubectl get across namespaces."
    tuning_guidance = "Add known automation identities to %global_allowed_service_accounts and %global_allowed_cloud_principals, and named cluster administrators to %global_allowed_admin_users. Raise the #k8s threshold on large, busy clusters. Severity scales through $risk_score once the request count reaches 100."

  events:
    $k8s.metadata.event_type = "USER_RESOURCE_ACCESS"
    $k8s.target.url = /\/(services|endpoints|endpointslices|nodes)(\?|\/|$)/ nocase
    $k8s.principal.user.userid != ""
    $k8s.principal.user.userid = $user
    not $k8s.principal.user.userid = /^system:(node:|kube-|apiserver|kube-proxy)/ nocase
    not $k8s.principal.user.userid in %global_allowed_service_accounts
    not $k8s.principal.user.userid in %global_allowed_cloud_principals
    not $k8s.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $event_count = count($k8s.metadata.id)
    $risk_score = if($event_count >= 100, 80, 50)
    $mitre_technique_id = array_distinct("T1046")
    $primary_entity = array_distinct($user)
    $source_ips = array_distinct($k8s.principal.ip)
    $requested_urls = array_distinct($k8s.target.url)

  condition:
    #k8s >= 25
}
