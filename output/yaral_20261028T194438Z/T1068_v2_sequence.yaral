/*
  MITRE Technique : T1068 - Exploitation for Privilege Escalation
  Tactic(s)       : Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:53:45.502274+00:00
  Reference       : https://attack.mitre.org/techniques/T1068
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1068_Container_Pod_Create_Then_Exec_Same_Identity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a single identity creating a pod or workload resource and then opening an exec/attach session into a container within 10 minutes, using Kubernetes and container runtime audit telemetry. This create-then-exec pattern is the usual path for container escape and node privilege escalation: an attacker deploys a privileged or host-mounted pod, then enters it to abuse the host kernel or runtime. The rule uses API-level audit events, not process command lines, so it complements process-creation detections."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1068"
    mitre_technique_name = "Exploitation for Privilege Escalation"
    log_prerequisites = "Requires Kubernetes API audit logs (or equivalent container runtime control-plane audit) ingested into UDM with RESOURCE_CREATION events for pod creation and USER_RESOURCE_ACCESS events for exec/attach subresource calls, with principal.user.userid populated."
    platform = "Linux"
    log_source = "container"
    false_positives = "Developers and SREs who deploy and then debug their own workloads, CI/CD pipelines that create test pods and exec into them, and break-glass troubleshooting by cluster operators."
    tuning_guidance = "Add CI/CD and automation identities to %global_allowed_service_accounts and cluster administrators to %global_allowed_admin_users. If the parser exposes privileged or hostPath indicators for pod specs, add them to the $create pre-filter to sharply reduce volume. Consider excluding system namespaces if the audit parser exposes namespace in target.resource.name."

  events:
    $create.metadata.event_type = "RESOURCE_CREATION"
    $create.target.resource.resource_subtype = /^pods?$/ nocase
    $create.principal.user.userid = $user
    not $create.principal.user.userid in %global_allowed_service_accounts
    not $create.principal.user.userid in %global_allowed_admin_users

    $exec.metadata.event_type = "USER_RESOURCE_ACCESS"
    $exec.target.resource.name = /(^|\/)(exec|attach)$/ nocase
    $exec.principal.user.userid = $user
    not $exec.principal.user.userid in %global_allowed_service_accounts
    not $exec.principal.user.userid in %global_allowed_admin_users

    $create.metadata.event_timestamp.seconds <= $exec.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1068")
    $primary_entity = array_distinct($user)
    $created_resources = array_distinct($create.target.resource.name)
    $exec_targets = array_distinct($exec.target.resource.name)
    $source_ips = array_distinct($exec.principal.ip)
    $event_count = count($exec.metadata.id)

  condition:
    $create and $exec
}
