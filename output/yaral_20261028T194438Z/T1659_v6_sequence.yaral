/*
  MITRE Technique : T1659 - Content Injection
  Tactic(s)       : Initial Access, Command and Control
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:03:43.827818+00:00
  Reference       : https://attack.mitre.org/techniques/T1659
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1659_Cleartext_Executable_Download_Then_Uncommon_Port_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Windows client that downloads an executable or script over unencrypted HTTP from an external server, then within 10 minutes opens an outbound connection to a different external IP on a high, non-standard port. Content injected into cleartext web traffic (on-path or on-side) can deliver a payload to the client, which then calls back to attacker infrastructure. The rule uses only perimeter-visible behaviour: cleartext payload delivery followed by follow-on egress."
    mitre_tactic = "Initial Access, Command and Control"
    mitre_technique = "T1659"
    mitre_technique_name = "Content Injection"
    log_prerequisites = "Requires firewall or proxy logs that normalise to UDM NETWORK_HTTP (with target.url and user agent) and NETWORK_CONNECTION or NETWORK_FLOW-style connection events with principal.ip and target.port populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legacy software updaters and vendor installers that fetch binaries over HTTP; patch and driver distribution points; OS-native download mechanisms such as BITS fetching from unlisted CDNs; developer or admin workstations using non-standard ports for legitimate tools."
    tuning_guidance = "Add known-good download hosts to %global_allowed_domains. Add vulnerability scanners and authorised test sources to %global_allowed_scanners. Add software deployment or patching source IPs to %global_allowed_admin_tools. If the client population is noisy, narrow the user agent regex or the file-extension list."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.port = 80
    $http.target.url = /\.(exe|dll|msi|scr|hta|ps1|vbs|js|jar|bat)(\?.*)?$/ nocase
    $http.network.http.user_agent = /(Windows NT|WinHTTP|WindowsPowerShell|Microsoft BITS)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_admin_tools
    $http.principal.ip = $src_ip

    $conn.metadata.event_type = "NETWORK_CONNECTION"
    $conn.target.port > 1024
    $conn.target.port != 8080
    $conn.target.port != 8443
    not $conn.target.ip in %rfc1918_internal
    not $conn.target.hostname in %global_allowed_domains
    not $conn.principal.ip in %global_allowed_scanners
    $conn.target.ip != $http.target.ip
    $conn.principal.ip = $src_ip

    $http.metadata.event_timestamp.seconds <= $conn.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1659")
    $primary_entity = array_distinct($src_ip)
    $download_urls = array_distinct($http.target.url)
    $download_server_ips = array_distinct($http.target.ip)
    $egress_ips = array_distinct($conn.target.ip)
    $egress_ports = array_distinct($conn.target.port)

  condition:
    $http and $conn
}
