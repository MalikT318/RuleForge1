/*
  MITRE Technique : T1496.004 - Cloud Service Hijacking
  Tactic(s)       : Impact
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:57:16.189165+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_004_SaaS_Messaging_Or_AI_Service_Enablement {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects control-plane changes that enable or unlock resource-intensive hosted services: bulk email and messaging sending (leaving sandbox or restricted mode, re-enabling account sending) and generative AI model access (use-case submission, model agreements or entitlements). Adversaries with compromised cloud credentials make these changes before sending spam or phishing at scale, or reselling hijacked model capacity. Matching the API action rather than a specific payload or tool keeps the rule effective when the attacker changes infrastructure."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.004"
    mitre_technique_name = "Resource Hijacking: Cloud Service Hijacking"
    log_prerequisites = "Cloud control-plane audit logs with management-event API activity ingested and normalised to UDM, with metadata.product_event_type and principal.user.userid populated."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate onboarding of transactional email or messaging capability by platform or marketing teams, planned requests to raise sending limits, approved AI/ML teams enabling model access, and infrastructure-as-code pipelines applying these settings."
    tuning_guidance = "Add automation and pipeline identities to %global_allowed_service_accounts, named cloud administrators to %global_allowed_admin_users, and approved federated or service principals to %global_allowed_cloud_principals. Review alerts for first-time actors or unusual source locations. Extend or trim the product_event_type action list to match the services in use by each client."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /^(UpdateAccountSendingEnabled|PutAccountDetails|PutAccountSendingAttributes|PutAccountProductionAccessAttributes|PutUseCaseForModelAccess|CreateFoundationModelAgreement|PutFoundationModelEntitlement|SetSMSAttributes|SetSMSSandboxPhoneNumber)$/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1496.004")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_action = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)
    $target_resource = array_distinct($cloud.target.resource.name)

  condition:
    $cloud
}
