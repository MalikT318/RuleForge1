/*
  MITRE Technique : T1137.005 - Outlook Rules
  Tactic(s)       : Persistence
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:21:38.264470+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_005_Outlook_Unsafe_Rules_Enabled_Then_Child_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the Outlook client-side rule safeguard (EnableUnsafeClientMailRules) being set in the Outlook Security registry key, followed within 10 minutes by Outlook spawning a shell or script host on the same host. This pattern indicates a malicious Outlook rule configured to run an application or script when a crafted email arrives."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.005"
    mitre_technique_name = "Office Application Startup: Outlook Rules"
    log_prerequisites = "Requires Windows endpoint telemetry with registry modification events (EDR or Sysmon event ID 13) and process creation events with parent process lineage (EDR, Sysmon event ID 1, or Windows Event 4688 with command line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Enterprise mail-automation or workflow add-ins that legitimately enable unsafe client rules, GPO or deployment tooling that sets Office security values, administrators testing rule-based automation, and Outlook add-ins or helper scripts that launch cmd or a script host."
    tuning_guidance = "Add approved deployment and configuration tooling to %global_allowed_admin_tools, which excludes it as the registry writer and as the spawned child. Add automation accounts to %global_allowed_service_accounts. If a client uses a legitimate Outlook-driven script, exclude it by parent or child executable name rather than install path. To widen coverage, create a sibling rule for REGISTRY_CREATION, since a value set for the first time may be normalised as creation instead of modification."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Microsoft\\Office\\[0-9.]+\\Outlook\\Security$/ nocase
    $reg.target.registry.registry_value_name = /^EnableUnsafeClientMailRules$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    $reg.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\outlook\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|regsvr32)\.exe$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $reg.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1137.005")
    $primary_entity = array_distinct($hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_writers = array_distinct($reg.principal.process.file.full_path)
    $child_processes = array_distinct($proc.target.process.file.full_path)
    $child_command_lines = array_distinct($proc.target.process.command_line)
    $affected_users = array_distinct($proc.principal.user.userid)

  condition:
    $reg and $proc
}
