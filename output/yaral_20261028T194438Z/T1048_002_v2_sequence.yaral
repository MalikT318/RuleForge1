/*
  MITRE Technique : T1048.002 - Exfiltration Over Asymmetric Encrypted Non-C2 Protocol
  Tactic(s)       : Exfiltration
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:35:57.165878+00:00
  Reference       : https://attack.mitre.org/techniques/T1048/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1048_002_ESXi_SSH_Login_Then_Outbound_SSH_Firewall_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Successful login to an ESXi host from a source outside the approved management sources, followed within 10 minutes by a host firewall or ruleset change that opens the outbound SSH client path. This is a typical precursor to exfiltrating datastore or VM data over SCP/SFTP, an asymmetrically encrypted non-C2 channel. Detection is based on the management-plane authentication event and the configuration change, not on command lines."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1048.002"
    mitre_technique_name = "Exfiltration Over Alternative Protocol: Exfiltration Over Asymmetric Encrypted Non-C2 Protocol"
    log_prerequisites = "ESXi hostd, shell and auth logs forwarded and parsed into UDM, with USER_LOGIN and SETTING_MODIFICATION events. The ESXi hostname must be populated in principal.hostname on both event types, and metadata.description must carry the original log message text."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators using ad-hoc SSH sessions from jump hosts missing from the management source list; planned maintenance such as host backup, config export or support-bundle upload that enables the outbound SSH client; automation tooling that toggles firewall rulesets."
    tuning_guidance = "Add jump-host and bastion addresses to %global_allowed_mgmt_sources. Add named administrators to %global_allowed_admin_users. Add automation accounts to %global_allowed_service_accounts. Suppress during approved change windows."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.metadata.description = /(accepted|authenticated|session opened|logged in)/ nocase
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.target.user.userid in %global_allowed_admin_users
    $auth.principal.hostname = $host

    $set.metadata.event_type = "SETTING_MODIFICATION"
    $set.metadata.description = /(sshClient|firewall.*rule\s?set.*(enable|allowedall)|allowedall)/ nocase
    not $set.principal.user.userid in %global_allowed_service_accounts
    $set.principal.hostname = $host

    $auth.metadata.event_timestamp.seconds <= $set.metadata.event_timestamp.seconds

  match:
    $host over 10m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1048.002")
    $primary_entity = array_distinct($host)
    $login_source_ips = array_distinct($auth.principal.ip)
    $login_users = array_distinct($auth.target.user.userid)
    $config_change_users = array_distinct($set.principal.user.userid)
    $first_login_time = min($auth.metadata.event_timestamp.seconds)
    $last_change_time = max($set.metadata.event_timestamp.seconds)

  condition:
    $auth and $set
}
