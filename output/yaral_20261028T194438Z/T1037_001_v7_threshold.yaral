/*
  MITRE Technique : T1037.001 - Logon Script (Windows)
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:20:54.968615+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_001_Logon_Script_Registry_Repeated_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Repeated modification of the UserInitMprLogonScript value under a user's Environment registry key on a single host within ten minutes. Adversaries set this value to run a script at every logon for persistence. Repeated writes suggest tooling that is staging, correcting or re-applying the persistence entry."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.001"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Logon Script (Windows)"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 13) normalised to REGISTRY_MODIFICATION, with target.registry.registry_key and registry_value_name populated, and a principal hostname."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate logon-script deployment by IT, such as RMM or software deployment agents, profile-management or user-environment tooling, and admins testing a logon script on a workstation."
    tuning_guidance = "Add approved deployment and RMM binaries to %global_allowed_admin_tools and approved administrator accounts to %global_allowed_admin_users. Add security agents to %global_allowed_security_tools. Raise the threshold above 2 if script-deployment tooling writes this value repeatedly in your environment. Lower it to 1 where any write to this value should alert."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Environment$/ nocase
    $reg.target.registry.registry_value_name = /^UserInitMprLogonScript$/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1037.001")
    $primary_entity = array_distinct($host)
    $modification_count = count($reg.metadata.id)
    $modifying_processes = array_distinct($reg.principal.process.file.full_path)
    $modifying_users = array_distinct($reg.principal.user.userid)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $script_values = array_distinct($reg.target.registry.registry_value_data)

  condition:
    #reg >= 2
}
