/*
  MITRE Technique : T1566.004 - Spearphishing Voice
  Tactic(s)       : Initial Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:52:13.597026+00:00
  Reference       : https://attack.mitre.org/techniques/T1566/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1566_004_Vishing_Installer_Download_Then_RemoteAccess_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Network-observable pattern of a voice-phishing (vishing) lure. An internal host downloads an executable or installer package over HTTP from an external site not on the known-good domain list, then within ten minutes opens an outbound connection to an external address on a well-known remote-access or remote-desktop port. This matches a victim being coached by phone to fetch and run a remote management tool, which gives the adversary interactive access."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1566.004"
    mitre_technique_name = "Phishing: Spearphishing Voice"
    log_prerequisites = "Requires perimeter firewall or web proxy logs with NETWORK_HTTP events that populate target.url and target.hostname, plus NETWORK_CONNECTION events that populate principal.ip, target.ip and target.port. Egress traffic must be logged with the pre-NAT internal source address."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "IT staff or help desk installing approved remote support tools from vendor sites not yet on the allowed domain list, legitimate software installers downloaded by users who then use sanctioned remote assistance, managed-service-provider technicians, and RDP or VNC to external partner or cloud-hosted systems."
    tuning_guidance = "Add vendor download and update domains to %global_allowed_domains. Add IT admin, help desk and jump-host source addresses to %global_allowed_mgmt_sources. Extend the file extension regex or remove ports that are legitimately used in the client environment. Keep %rfc1918_internal populated so internal destinations are excluded."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\.(exe|msi|msix|scr|bat|ps1|vbs|js|iso|img)(\?.*)?$/ nocase
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_mgmt_sources
    $http.principal.ip = $src_ip

    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 5938 or
      $net.target.port = 7070 or
      $net.target.port = 6568 or
      $net.target.port = 5900 or
      $net.target.port = 3389 or
      $net.target.port = 5650 or
      $net.target.port = 8040
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    $net.principal.ip = $src_ip

    $http.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1566.004")
    $primary_entity = array_distinct($src_ip)
    $downloaded_urls = array_distinct($http.target.url)
    $download_hosts = array_distinct($http.target.hostname)
    $remote_access_dest_ips = array_distinct($net.target.ip)
    $remote_access_ports = array_distinct($net.target.port)
    $connection_count = count($net.metadata.id)

  condition:
    $http and $net
}
