/*
  MITRE Technique : T1127.003 - JamPlus
  Tactic(s)       : Stealth, Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:40:49.756039+00:00
  Reference       : https://attack.mitre.org/techniques/T1127/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1127_003_JamPlus_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a JamPlus build utility process, identified by its image name or by a .jam build script on its command line, opening a network connection to an external address. JamPlus is a local build tool and does not normally make outbound connections. Outbound traffic from it suggests a malicious .jam script is staging payloads or calling C2 under a trusted developer tool. This is network-side coverage that complements process-creation rules."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1127.003"
    mitre_technique_name = "Trusted Developer Utilities Proxy Execution: JamPlus"
    log_prerequisites = "Requires endpoint network telemetry (EDR or Sysmon Event ID 3 equivalent) that populates the initiating process path and, ideally, the process command line on NETWORK_CONNECTION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Game or asset developers whose JamPlus build scripts fetch dependencies, SDKs or packages from external hosts; build servers and CI agents running JamPlus; developer workstations with legitimate JamPlus workflows."
    tuning_guidance = "Add approved build tooling and parent process paths to %global_allowed_admin_tools. Add known-good package or SDK domains to %global_allowed_domains. Exclude build-server hosts through a client-specific scoped copy of the rule. If the image path is missing from network telemetry, the command-line .jam match is the only path that fires."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.principal.process.file.full_path = /\\(jam|jamplus)\.exe$/ nocase or
      $net.principal.process.command_line = /\.jam\b/ nocase
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1127.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $initiating_command_line = array_distinct($net.principal.process.command_line)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
