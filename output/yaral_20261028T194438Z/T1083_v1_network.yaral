/*
  MITRE Technique : T1083 - File and Directory Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:23:04.637522+00:00
  Reference       : https://attack.mitre.org/techniques/T1083
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1083_External_WebDAV_Directory_Listing {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows WebDAV client issuing a PROPFIND request (a remote directory and file listing) to an external destination, observed at the perimeter. The Windows WebDAV mini-redirector is the client, and the request enumerates files and folders on a remote share outside the organisation. This is network-side coverage for T1083 and does not depend on endpoint command-line telemetry."
    mitre_tactic = "Discovery"
    mitre_technique = "T1083"
    mitre_technique_name = "File and Directory Discovery"
    log_prerequisites = "Requires proxy or perimeter logs normalised to UDM NETWORK_HTTP with network.http.method and network.http.user_agent populated. TLS inspection is needed to see the HTTP method on HTTPS traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Users mapping or browsing sanctioned cloud file services over WebDAV (for example SharePoint/OneDrive mapped drives, hosted file shares), backup or sync clients using WebDAV, and partner file exchange over WebDAV."
    tuning_guidance = "Add sanctioned WebDAV provider domains to %global_allowed_domains. Add service accounts that legitimately use mapped WebDAV drives to %global_allowed_service_accounts. If the proxy does not log the user agent, remove the user-agent condition and rely on the PROPFIND method with domain exclusions."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "PROPFIND" nocase
    $net.network.http.user_agent = /(microsoft-webdav-miniredir|davclnt)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1083")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $source_users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
