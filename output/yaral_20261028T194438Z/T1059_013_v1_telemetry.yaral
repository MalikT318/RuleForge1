/*
  MITRE Technique : T1059.013 - Container CLI/API
  Tactic(s)       : Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:25:31.223057+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_013_Container_API_Exec_Attach_Control_Plane {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a container-orchestration control-plane API call to the exec or attach subresource of a pod, which runs commands inside a running container. The rule pivots on the API request in cloud audit telemetry and does not depend on process command-line logging. It still fires when the attacker uses an SDK, a raw HTTPS client, or a renamed CLI, because the call produces the same API record."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.013"
    mitre_technique_name = "Command and Scripting Interpreter: Container CLI/API"
    log_prerequisites = "Orchestrator audit logging must be enabled at a level that records request URIs for pod subresource calls (Metadata level or higher) and ingested into Chronicle. The request URI must be normalised to target.url and the caller identity to principal.user.userid."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Developers and SREs debugging workloads, CI/CD or GitOps tooling running smoke tests via exec, operators and controllers that use exec for health checks or database maintenance, and break-glass troubleshooting sessions during incidents."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts and %global_allowed_cloud_principals. Add on-call and platform engineers to %global_allowed_admin_users. For clusters where exec is routine in non-production, scope the rule per client by raising severity only for production namespaces, using the namespace segment of target.url."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.target.url = /\/api\/v1\/namespaces\/[^\/]+\/pods\/[^\/]+\/(exec|attach)(\?|$)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1059.013")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $request_uri = array_distinct($cloud.target.url)
    $target_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
