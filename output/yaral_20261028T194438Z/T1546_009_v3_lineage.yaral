/*
  MITRE Technique : T1546.009 - AppCert DLLs
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:12:05.206883+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_009_AppCertDLLs_Anomalous_Parent_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, script interpreter or registry utility that references the AppCertDLLs Session Manager value and was spawned by a parent that should never configure it, such as an Office application, web server worker, database service or print spooler. AppCert DLLs are loaded into every process that calls CreateProcess-family APIs, so a hijacked parent configuring one signals exploitation, macro abuse or webshell activity used for persistence and privilege escalation."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.009"
    mitre_technique_name = "Event Triggered Execution: AppCert DLLs"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate installers or management agents launched through a database service (for example SQL Agent jobs run by an administrator), web-based management consoles that shell out to configure the registry, and security assessment or penetration-testing activity. Occurrences are rare."
    tuning_guidance = "Add approved deployment or management parent binaries to %global_allowed_admin_tools. Add trusted script-hosting parents to %global_allowed_script_hosts. Extend the parent regex with environment-specific line-of-business services if they should never configure Session Manager keys."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|onenote|visio|w3wp|httpd|nginx|tomcat\d*|php-cgi|inetinfo|sqlservr|mysqld|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|reg|regedit|wscript|cscript|mshta|wmic)\.exe$/ nocase
    $proc.target.process.command_line = /AppCertDLLs/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1546.009")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
