/*
  MITRE Technique : T1537 - Transfer Data to Cloud Account
  Tactic(s)       : Exfiltration
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:35:44.419994+00:00
  Reference       : https://attack.mitre.org/techniques/T1537
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1537_IaaS_Snapshot_Image_Sharing_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change that exposes a cloud compute or database snapshot, machine image or managed disk to another account. This covers snapshot or image permission attribute modifications and managed disk or snapshot access-grant (SAS-style) operations. These are the control-plane state changes used to transfer backups of cloud instances to an adversary-controlled account in the same provider. Detection is at the configuration-change layer, not at command-line or process level."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1537"
    mitre_technique_name = "Transfer Data to Cloud Account"
    log_prerequisites = "Cloud control-plane audit logging (management/admin activity events) must be enabled and ingested, with API operation names populated in metadata.product_event_type and the calling identity in principal.user.userid."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate cross-account AMI/snapshot sharing for DR, golden image pipelines, multi-account landing zones, managed service provider backup tooling, migration projects, and vendor-managed forensics or backup access grants."
    tuning_guidance = "Add CI/CD, image-pipeline and backup automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Add named cloud administrators who routinely share images to %global_allowed_admin_users. Review recurring hits per principal before allowlisting."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /(Modify(Snapshot|Image|DBSnapshot|DBClusterSnapshot|FpgaImage)Attribute|(snapshots|disks)\/beginGetAccess|(snapshots|disks)\/grantAccess)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1537")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_operation = array_distinct($cloud.metadata.product_event_type)
    $target_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
