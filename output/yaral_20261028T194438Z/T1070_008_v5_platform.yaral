/*
  MITRE Technique : T1070.008 - Clear Mailbox Data
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:11:24.018350+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_008_Exchange_Mail_Artifact_File_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects deletion of Exchange transport/message-tracking log files or PST mailbox export files by a process that is not Outlook or an Exchange service. Adversaries remove exported PST files and mail flow logs to erase evidence of mailbox collection or phishing. This rule uses FILE_DELETION telemetry and complements command-line rules that look for Remove-MailboxExportRequest."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.008"
    mitre_technique_name = "Indicator Removal: Clear Mailbox Data"
    log_prerequisites = "Requires EDR or Sysmon file-deletion telemetry (Sysmon Event ID 23/26 or equivalent) from Exchange servers and user endpoints, normalised to UDM FILE_DELETION with principal process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Exchange log-retention or cleanup scripts run by admins, backup and archival software, manual PST housekeeping by users or help desk, Outlook profile repair performed by deployment tooling."
    tuning_guidance = "Add approved cleanup tooling to %global_allowed_admin_tools, backup agents to %global_allowed_backup_processes, and scheduled log-maintenance accounts to %global_allowed_service_accounts. If PST housekeeping by end users is noisy, scope the rule to Exchange servers using an asset or hostname filter at the tenant level."

  events:
    $file.metadata.event_type = "FILE_DELETION"
    $file.target.file.full_path = /(\\TransportRoles\\Logs\\.+\.(log|blg)$|\.pst$)/ nocase
    not $file.principal.process.file.full_path = /\\(outlook|EdgeTransport|MSExchange[^\\]*|Microsoft\.Exchange[^\\]*|MsMpEng)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1070.008")
    $primary_entity = array_distinct($file.principal.hostname)
    $deleted_files = array_distinct($file.target.file.full_path)
    $deleting_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
