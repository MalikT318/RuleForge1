/*
  MITRE Technique : T1570 - Lateral Tool Transfer
  Tactic(s)       : Lateral Movement
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:15:24.053314+00:00
  Reference       : https://attack.mitre.org/techniques/T1570
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1570_Unexpected_Parent_Spawns_Transfer_Utility_Remote_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process lineage anomaly: an Office application, web server worker, database service, print spooler or WMI provider host spawning a shell, script interpreter or built-in file-transfer utility whose command line targets a remote UNC path, admin share or remote URL. Office, web, database and spooler processes do not normally copy files between hosts, so this lineage points to lateral tool transfer from an exploited or abused service. The rule keys on the parent-child relationship rather than on a specific copy command."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1570"
    mitre_technique_name = "Lateral Tool Transfer"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry that populates both the parent (principal.process) and child (target.process) image paths and the child command line. Sources include EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Line-of-business Office macros or add-ins that copy files to file shares; web applications or IIS-hosted apps that legitimately stage files to remote shares; SQL Server jobs (xp_cmdshell) that copy backups or exports to network locations; print or document-management workflows; WMI-based software deployment or inventory."
    tuning_guidance = "Add approved deployment, RMM and backup parent binaries to %global_allowed_admin_tools. Add hosts or parent processes that are permitted to run scripts (for example SQL job servers or application servers with known file-staging workflows) to %global_allowed_script_hosts. If a specific parent is noisy in one environment, narrow that tenant's exclusion lists rather than loosening the parent regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|w3wp|httpd|nginx|tomcat\d*|php-cgi|sqlservr|mysqld|spoolsv|wmiprvse)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|robocopy|xcopy|bitsadmin|certutil|curl|scp|sftp|ftp|tftp|esentutl|expand|net|net1)\.exe$/ nocase
    $proc.target.process.command_line = /(\\\\[^\\\s"']+\\[^\\\s"']+|https?:\/\/|ftp:\/\/)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1570")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
