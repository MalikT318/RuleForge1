/*
  MITRE Technique : T1534 - Internal Spearphishing
  Tactic(s)       : Lateral Movement
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:32:41.420252+00:00
  Reference       : https://attack.mitre.org/techniques/T1534
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1534_Non_Mail_Client_Direct_SMTP_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows process other than a known mail client or mail server opening an outbound SMTP or SMTP-submission connection (TCP 25, 465, 587) to a non-internal address. A compromised internal account or host can use this to send phishing mail directly, bypassing the corporate mail gateway, to reach other users while appearing to be a trusted internal sender."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1534"
    mitre_technique_name = "Internal Spearphishing"
    log_prerequisites = "Requires endpoint network telemetry that records the initiating process path (EDR or Sysmon Event ID 3 normalised to UDM NETWORK_CONNECTION)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Line-of-business applications and scripts that send alert or report mail directly to a SaaS relay, scanner-to-email or multifunction device software, monitoring agents, backup software email notifications, and developers testing SMTP code."
    tuning_guidance = "Add approved mail-sending binaries to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and authorised testing sources to %global_allowed_scanners. If mail clients other than Outlook or Thunderbird are sanctioned, add their executable names to %global_allowed_admin_tools. Expected SaaS mail relay destinations can be handled by adding them to the process allowlist; do not hardcode addresses in the rule."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 25 or $net.target.port = 465 or $net.target.port = 587)
    $net.principal.process.file.full_path = /\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path = /\\(outlook|olk|hxoutlook|thunderbird|msexchangetransport|edgetransport|w3wp|mailenable|hmailserver)\.exe$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_scanners
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1534")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $source_user = array_distinct($net.principal.user.userid)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
