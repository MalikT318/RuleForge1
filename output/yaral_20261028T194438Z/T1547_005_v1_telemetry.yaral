/*
  MITRE Technique : T1547.005 - Security Support Provider
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:29:53.749458+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_005_LSA_Security_Packages_Registry_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of the LSA 'Security Packages' or 'OSConfig\\Security Packages' registry values, which define the Security Support Provider DLLs loaded into the LSASS process at boot. Detection is based on the resulting registry state change rather than command-line activity, so it fires regardless of whether the change was made via reg.exe, PowerShell, WMI, a custom binary or direct API calls."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.005"
    mitre_technique_name = "Boot or Logon Autostart Execution: Security Support Provider"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon Event ID 12/13) with registry key path and value name populated. Registry auditing of HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa must be enabled where EDR does not capture it by default."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate installation of third-party authentication products (smart card middleware, SSO or credential provider agents, endpoint security agents that register an SSP), Windows servicing or feature updates that rewrite the Security Packages value, and approved admin or deployment tooling."
    tuning_guidance = "Add approved software deployment and RMM binaries to %global_allowed_admin_tools, EDR/AV agents that legitimately register an SSP to %global_allowed_security_tools, and automation identities to %global_allowed_service_accounts. Review hosts with recurring benign hits to confirm a known authentication product is installed."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\CurrentControlSet\\Control\\Lsa(\\OSConfig)?$/ nocase
    $reg.target.registry.registry_value_name = /^Security Packages$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1547.005")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
