/*
  MITRE Technique : T1037.003 - Network Logon Script
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:22:43.144907+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_003_Logon_Script_Dropped_Then_Assigned {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a script file written to a NETLOGON or SYSVOL share path, followed within 10 minutes on the same host by a command that assigns a logon script to a user account (net user /scriptpath, dsmod -loscr, or Set-ADUser/Set-ADObject scriptPath). Together these indicate network logon script persistence."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.003"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Network Logon Script"
    log_prerequisites = "Requires EDR or Sysmon file creation telemetry (including writes to UNC or SYSVOL paths) and process launch telemetry with command lines (Sysmon Event 1 and 11, or Windows Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Domain administrators legitimately deploying or updating logon scripts, GPO management and deployment automation, identity provisioning scripts that set the scriptPath attribute during onboarding, and migration tooling."
    tuning_guidance = "Add approved deployment and GPO tooling to %global_allowed_admin_tools and named administrators to %global_allowed_admin_users. Add provisioning accounts to %global_allowed_service_accounts if the rule is extended. The join assumes the script is written and assigned from the same host, usually an admin workstation or a domain controller. If scripts are staged from a separate host, add a second rule variant joined on the user."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(netlogon|sysvol)\\.*\.(bat|cmd|vbs|vbe|js|wsf|ps1)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(\/scriptpath[:=\s]|-scriptpath\b|scriptpath\s*=|dsmod\s+user.*-loscr)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1037.003")
    $primary_entity = array_distinct($hostname)
    $script_paths = array_distinct($file.target.file.full_path)
    $assign_commands = array_distinct($proc.target.process.command_line)
    $acting_users = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
