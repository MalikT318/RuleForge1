/*
  MITRE Technique : T1543.003 - Windows Service
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:56:31.128628+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_003_Service_Registry_ImagePath_Suspicious_Location {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry-level creation or modification of a Windows service execution value (ImagePath, ServiceDll or FailureCommand) that points at a user-writable or staging location, a network share, or an interpreter or LOLBin. This catches services registered by direct registry writes, Native API calls such as CreateServiceW, and driver loaders that never launch sc.exe. It is registry-based, so it complements command-line rules. T1543.003 is Windows-only, so the alternate-platform angle is not applicable and this rule targets Windows registry telemetry."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.003"
    mitre_technique_name = "Create or Modify System Process: Windows Service"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events 12/13/14) with registry_key and registry_value_data populated, and monitoring of HKLM\\SYSTEM\\CurrentControlSet\\Services."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters that register services from ProgramData or AppData, per-user installers of vendor agents, RMM or deployment tools, and developers testing services or drivers from temp build directories."
    tuning_guidance = "Add approved deployment and RMM binaries to %global_allowed_admin_tools, security agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. If a vendor installer legitimately registers services from ProgramData, allowlist its parent process name rather than the path."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(CurrentControlSet|ControlSet\d{3})\\Services\\/ nocase
    (
      $reg.target.registry.registry_value_name = /^(ImagePath|ServiceDll|FailureCommand)$/ nocase or
      $reg.target.registry.registry_key = /\\(ImagePath|ServiceDll|FailureCommand)$/ nocase
    )
    $reg.target.registry.registry_value_data = /(\\users\\[^\\]+\\|\\appdata\\|\\temp\\|\\programdata\\|\\perflogs\\|\\users\\public\\|\$recycle\.bin|^\\\\[^\\]+\\|cmd(\.exe)?\s+\/c|powershell|pwsh|mshta|rundll32|regsvr32|wscript|cscript|-enc)/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1543.003")
    $primary_entity = array_distinct($reg.principal.hostname)
    $service_keys = array_distinct($reg.target.registry.registry_key)
    $service_values = array_distinct($reg.target.registry.registry_value_data)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $writer_users = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
