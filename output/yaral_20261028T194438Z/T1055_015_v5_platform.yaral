/*
  MITRE Technique : T1055.015 - ListPlanting
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:05:31.405465+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_015_ListPlanting_Injection_Into_ListView_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process injecting code into a built-in Windows process that hosts a SysListView32 list-view control (shell, Task Manager, Registry Editor, MMC), the target pattern used by ListPlanting. ListPlanting exists only on Windows, so the alternate-platform angle cannot apply; this rule adds coverage through injection telemetry (PROCESS_INJECTION) rather than process-creation command lines."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.015"
    mitre_technique_name = "Process Injection: ListPlanting"
    log_prerequisites = "Requires Windows endpoint telemetry that reports cross-process injection (remote thread creation, memory write, or APC activity) and normalises it to PROCESS_INJECTION with populated principal and target process paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Accessibility and screen-reader software, shell extensions and desktop customisation tools, application compatibility shims, remote support tools, and legitimate EDR/AV agents not yet in the allowlist."
    tuning_guidance = "Add approved injecting binaries to %global_allowed_security_tools, %global_allowed_admin_tools or %global_allowed_remote_mgmt. Extend the victim process regex if other list-view hosting applications are relevant for the client."

  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.target.process.file.full_path = /\\(explorer|taskmgr|regedit|mmc|perfmon|resmon)\.exe$/ nocase
    $inj.principal.process.file.full_path != ""
    not $inj.principal.process.file.full_path = $inj.target.process.file.full_path
    not $inj.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|csrss|wininit|services|lsass|winlogon)\.exe$/ nocase
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.015")
    $primary_entity = array_distinct($inj.principal.hostname)
    $injector_process = array_distinct($inj.principal.process.file.full_path)
    $victim_process = array_distinct($inj.target.process.file.full_path)
    $injecting_user = array_distinct($inj.principal.user.userid)

  condition:
    $inj
}
