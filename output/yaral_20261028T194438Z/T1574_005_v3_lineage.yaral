/*
  MITRE Technique : T1574.005 - Executable Installer File Permissions Weakness
  Tactic(s)       : Stealth, Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:30:56.093549+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_005_SYSTEM_Temp_Installer_Parent_Spawns_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a SYSTEM-context executable running from an unpacked installer subdirectory under a Temp folder (user Temp or Windows\\Temp) spawning a shell or script interpreter. Installers that unpack to writable Temp subdirectories can have their payloads overwritten by a low-privilege user. A SYSTEM process launched from that location that spawns an interpreter is a strong indicator of installer binary hijacking and privilege escalation."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.005"
    mitre_technique_name = "Hijack Execution Flow: Executable Installer File Permissions Weakness"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 / Windows Event 4688 with parent process path, child process path and the principal user populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate self-extracting installers and MSI custom actions that run as SYSTEM from Temp and call cmd or PowerShell for post-install steps; software deployment agents staging packages in Temp; vendor updaters; RMM tooling."
    tuning_guidance = "Add approved deployment or updater parent binaries to %global_allowed_admin_tools, approved script-running parents to %global_allowed_script_hosts, and security agents to %global_allowed_security_tools. Add automation identities to %global_allowed_service_accounts. Review recurring installer parents before allowlisting them."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    // Parent: executable inside a subdirectory of a Temp folder (installer unpack location)
    $proc.principal.process.file.full_path = /\\(windows\\temp|appdata\\local\\temp)\\[^\\]+\\.*\.exe$/ nocase
    // Parent is running with SYSTEM privileges
    $proc.principal.user.userid = /^(system|nt authority\\system)$/ nocase
    // Child: shell or script interpreter
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1574.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
