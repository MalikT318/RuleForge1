/*
  MITRE Technique : T1571 - Non-Standard Port
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:18:18.968044+00:00
  Reference       : https://attack.mitre.org/techniques/T1571
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1571_Linux_HTTP_NonStd_Port_Then_Followup_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A host makes an HTTP-style request to an external destination on a non-standard web port, then opens a further connection on an unprivileged port to the same external IP within 10 minutes. The pattern suggests a web protocol being tunnelled over an unusual port for command and control, followed by a second channel or session on the same server."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1571"
    mitre_technique_name = "Non-Standard Port"
    log_prerequisites = "Requires perimeter firewall or proxy logs normalised to UDM NETWORK_HTTP (with HTTP method and target.port populated) and NETWORK_CONNECTION events, with principal.ip and target.ip populated. A firewall log does not identify the initiating process. Scope the rule to Linux server address space through the client's log-source or asset configuration."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Internal tooling and package mirrors on custom ports, vendor SaaS agents that use high ports, developer or CI hosts reaching external APIs on alternate ports, and approved vulnerability scanners."
    tuning_guidance = "Add known-good external destinations to %global_allowed_domains, scanner sources to %global_allowed_scanners, and approved Linux automation hosts to %global_allowed_admin_tools. Widen the excluded standard-port list in the first event if the client uses common alternates such as 8000 or 9443. Restrict to Linux server subnets via log-source scoping."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(GET|POST|PUT|CONNECT|HEAD)$/ nocase
    $http.target.port > 0
    $http.target.port != 80
    $http.target.port != 443
    $http.target.port != 8080
    $http.target.port != 8443
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_scanners
    $http.principal.ip = $src_ip
    $http.target.ip = $dst_ip

    $conn.metadata.event_type = "NETWORK_CONNECTION"
    $conn.target.port >= 1024
    $conn.target.port != 8080
    $conn.target.port != 8443
    not $conn.target.ip in %rfc1918_internal
    not $conn.target.hostname in %global_allowed_domains
    not $conn.principal.hostname in %global_allowed_scanners
    $conn.principal.ip = $src_ip
    $conn.target.ip = $dst_ip

    $http.metadata.event_timestamp.seconds <= $conn.metadata.event_timestamp.seconds

  match:
    $src_ip, $dst_ip over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1571")
    $primary_entity = array_distinct($src_ip)
    $destination_ips = array_distinct($dst_ip)
    $http_ports = array_distinct($http.target.port)
    $followup_ports = array_distinct($conn.target.port)
    $http_event_count = count($http.metadata.id)
    $conn_event_count = count($conn.metadata.id)

  condition:
    $http and $conn
}
