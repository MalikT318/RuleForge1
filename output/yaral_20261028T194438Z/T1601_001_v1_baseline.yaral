/*
  MITRE Technique : T1601.001 - Patch System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:12:21.986007+00:00
  Reference       : https://attack.mitre.org/techniques/T1601/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_001_Perimeter_TFTP_Image_Transfer_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects TFTP (UDP/69) sessions that cross the network perimeter to a non-internal address. TFTP is the standard unauthenticated, plaintext protocol used to push or pull network device operating system images and configurations. A transfer to or from an external host is a strong sign that an adversary is staging a modified system image (ROMMON/IOS-style monolithic firmware) on a device, or exfiltrating one. Legitimate image management almost always stays inside the management network."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1601.001"
    mitre_technique_name = "Modify System Image: Patch System Image"
    log_prerequisites = "Firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with target.port, target.ip and network.ip_protocol populated. Perimeter policy must log permitted and denied UDP/69 sessions."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Vendor-supported remote firmware or config staging by a managed service or ISP, lab or branch devices that fetch images from an externally hosted TFTP server during provisioning, misconfigured devices attempting TFTP backups to a cloud-hosted server, and authorised penetration tests."
    tuning_guidance = "Add approved management or provisioning source addresses to %global_allowed_mgmt_sources. Add approved scanning or testing sources to %global_allowed_scanners. Keep %rfc1918_internal current so internal TFTP is excluded. If the client legitimately uses an outsourced image repository, exclude that destination through %global_allowed_domains where the log carries a hostname, or lower severity for that tenant."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    $net.network.ip_protocol = "UDP"
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1601.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
