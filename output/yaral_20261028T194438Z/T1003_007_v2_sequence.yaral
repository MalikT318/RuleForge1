/*
  MITRE Technique : T1003.007 - Proc Filesystem
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:48:44.099968+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_007_Proc_Maps_Then_Mem_Read_Sequence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the same process reading /proc/<pid>/maps and then /proc/<pid>/mem on one Linux host within ten minutes. This is the memory-scraping pattern used to locate readable regions and dump credentials from other processes. Reads of /proc/self are excluded."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.007"
    mitre_technique_name = "OS Credential Dumping: Proc Filesystem"
    log_prerequisites = "Requires Linux EDR or auditd file-access telemetry normalised to FILE_READ with target.file.full_path and principal.process.pid populated for /proc reads."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Debuggers (gdb, strace), profilers, crash dumpers, JVM or runtime diagnostic tooling, EDR or AV memory scanners, backup or forensic acquisition tools, and developers troubleshooting on shared hosts."
    tuning_guidance = "Add approved debugging, monitoring and administration binaries to %global_allowed_admin_tools. Add EDR and AV agents to %global_allowed_security_tools. Add backup or imaging processes to %global_allowed_backup_processes. If auditd does not record the pid, enable pid enrichment or switch the join to principal.user.userid."

  events:
    $maps.metadata.event_type = "FILE_READ"
    $maps.target.file.full_path = /^\/proc\/[0-9]+\/maps$/
    not $maps.target.file.full_path = /^\/proc\/self\//
    not $maps.principal.process.file.full_path in %global_allowed_admin_tools
    not $maps.principal.process.file.full_path in %global_allowed_security_tools
    not $maps.principal.process.file.full_path in %global_allowed_backup_processes
    $maps.principal.hostname = $hostname
    $maps.principal.process.pid = $pid

    $mem.metadata.event_type = "FILE_READ"
    $mem.target.file.full_path = /^\/proc\/[0-9]+\/mem$/
    not $mem.target.file.full_path = /^\/proc\/self\//
    not $mem.principal.process.file.full_path in %global_allowed_admin_tools
    not $mem.principal.process.file.full_path in %global_allowed_security_tools
    not $mem.principal.process.file.full_path in %global_allowed_backup_processes
    $mem.principal.hostname = $hostname
    $mem.principal.process.pid = $pid

    $maps.metadata.event_timestamp.seconds <= $mem.metadata.event_timestamp.seconds

  match:
    $hostname, $pid over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1003.007")
    $primary_entity = array_distinct($hostname)
    $reader_process = array_distinct($mem.principal.process.file.full_path)
    $reader_user = array_distinct($mem.principal.user.userid)
    $maps_files = array_distinct($maps.target.file.full_path)
    $mem_files = array_distinct($mem.target.file.full_path)
    $mem_read_count = count($mem.metadata.id)

  condition:
    $maps and $mem
}
