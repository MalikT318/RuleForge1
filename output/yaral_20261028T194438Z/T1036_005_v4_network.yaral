/*
  MITRE Technique : T1036.005 - Match Legitimate Resource Name or Location
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:05:10.070895+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_005_Masqueraded_System_Binary_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound external network connection initiated by a process that carries the name of a core Windows system binary but runs from outside the trusted OS directories (System32, SysWOW64, WinSxS). Core OS processes such as svchost, lsass, csrss and winlogon are only expected to run from those locations, so an external connection from a same-named binary elsewhere indicates masquerading. This is a network-side detection that does not depend on process command-line content."
    mitre_tactic = "Stealth, Defense Evasion"
    mitre_technique = "T1036.005"
    mitre_technique_name = "Masquerading: Match Legitimate Resource Name or Location"
    log_prerequisites = "Requires Windows endpoint network telemetry that records the initiating process image path (EDR network events or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Portable or sandboxed copies of OS binaries used by software packagers or forensic tooling; EDR/AV products that report the image path in device-path form (\\Device\\HarddiskVolumeN\\Windows\\System32\\...) rather than a drive letter; side-by-side component servicing from staging directories; OS images mounted or extracted to non-standard drive layouts."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools and approved deployment or packaging tooling to %global_allowed_admin_tools. If a client's EDR reports device-path form, extend the trusted-path regex for that tenant. Further internal destinations can be excluded via %rfc1918_internal; known-good external vendor domains can be handled with %global_allowed_domains if a DNS-based variant is created."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(svchost|lsass|csrss|smss|wininit|winlogon|services|spoolsv|dllhost|taskhostw|conhost|searchindexer|runtimebroker)\.exe$/ nocase
    not $net.principal.process.file.full_path = /^[a-z]:\\windows\\(system32|syswow64|winsxs)\\/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1036.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $masquerading_process_path = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
