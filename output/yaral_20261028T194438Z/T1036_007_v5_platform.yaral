/*
  MITRE Technique : T1036.007 - Double File Extension
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:08:21.979356+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_007_Double_Extension_Executable_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a file whose name ends in a benign document or media extension followed by an executable or script extension (for example report.pdf.exe or invoice.docx.scr). This is file-write telemetry rather than process-creation command-line matching, so it catches the masquerading payload when it is dropped, before it runs. The requested non-Windows pivot was not applied because the mandatory target platform is Windows; the additive angle here is FILE_CREATION."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.007"
    mitre_technique_name = "Masquerading: Double File Extension"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR file-write events or Sysmon Event ID 11) normalised to UDM FILE_CREATION with target.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers or build pipelines that generate files such as setup.txt.exe, developer compilation output, document-conversion or export utilities that write temporary files with stacked extensions, and backup or sync clients restoring previously renamed files."
    tuning_guidance = "Add approved deployment, build and RMM tooling to %global_allowed_admin_tools, and trusted EDR/AV agents to %global_allowed_security_tools. Add automation accounts that legitimately produce such files to %global_allowed_service_accounts. If build servers are noisy, scope them out by host in the SIEM or SOAR layer. The decoy extension list can be extended per client."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\[^\\]*\.(txt|pdf|docx?|xlsx?|pptx?|rtf|csv|jpe?g|png|gif|bmp|zip|mp3|mp4|odt|ods)\s*\.(exe|scr|com|pif|bat|cmd|js|jse|vbs|vbe|wsf|wsh|hta|lnk|ps1|msi|jar|cpl)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1036.007")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_files = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
