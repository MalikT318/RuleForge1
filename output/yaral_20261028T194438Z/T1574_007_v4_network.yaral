/*
  MITRE Technique : T1574.007 - Path Interception by PATH Environment Variable
  Tactic(s)       : Stealth, Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:34:41.577143+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_007_Linux_PATH_Hijacked_Binary_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound connection to an external address from a process whose binary name matches a common system utility or interpreter, but which runs from a world-writable or user-controlled directory (/tmp, /var/tmp, /dev/shm, hidden or bin directories under /home) instead of a system binary directory. This is the network-side result of PATH interception: a planted binary placed ahead of the legitimate one in $PATH executes and beacons out or pulls a payload."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.007"
    mitre_technique_name = "Hijack Execution Flow: Path Interception by PATH Environment Variable"
    log_prerequisites = "Requires Linux endpoint network telemetry (EDR or auditd socket/connect events) that populates principal.process.file.full_path and target.ip on NETWORK_CONNECTION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers or build agents running toolchains from ~/bin or hidden tool directories; CI runners executing from /tmp workspaces; self-extracting installers or package managers staging binaries in /tmp; containers that mount user paths."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools and EDR or security agents to %global_allowed_security_tools. Known script-hosting build hosts can be added to %global_allowed_script_hosts. Restrict the home-directory portion of the path regex if developer workstations are noisy."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/user\/[0-9]+|home\/[^\/]+\/(\.[^\/]+|bin))\/(.*\/)?(sudo|su|ssh|scp|sftp|ls|ps|cat|curl|wget|bash|sh|dash|zsh|python[0-9.]*|perl|systemctl|netstat|ss|grep|find|id|whoami|git|apt|apt-get|yum|dnf|crontab|ping|nc|openssl)$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1574.007")
    $primary_entity = array_distinct($net.principal.hostname)
    $hijacked_binary = array_distinct($net.principal.process.file.full_path)
    $process_command_line = array_distinct($net.principal.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
