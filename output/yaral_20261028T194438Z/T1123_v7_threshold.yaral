/*
  MITRE Technique : T1123 - Audio Capture
  Tactic(s)       : Collection
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:30:50.164746+00:00
  Reference       : https://attack.mitre.org/techniques/T1123
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1123_Linux_Repeated_Audio_Capture_Utility_Launch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated launches of audio capture utilities on a single Linux host within 10 minutes. The utilities are ALSA, PulseAudio and PipeWire recorders, or ffmpeg and sox reading from a sound input device. A single launch is benign, but repeated recording sessions from one host suggest covert microphone capture (T1123), for example chunked recordings staged for later exfiltration."
    mitre_tactic = "Collection"
    mitre_technique = "T1123"
    mitre_technique_name = "Audio Capture"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry that populates full process command lines (UDM PROCESS_LAUNCH with target.process.command_line)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Desktop users recording meetings or podcasts, VoIP and conferencing test scripts, speech-recognition or accessibility tooling, media production workstations, automated audio-hardware QA or call-center test harnesses, and developer builds that exercise audio capture."
    tuning_guidance = "Add approved recording or QA tooling parents to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Add known media or kiosk hosts to %global_allowed_script_hosts. Raise the #proc threshold on hosts where audio recording is routine. Lower it to 2 for servers and headless systems that have no legitimate need for a microphone."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $proc.target.process.command_line = /\b(arecord|parecord|parec|pw-record|pw-cat)\b.*(\s-(d|f|r|c|t)\b|--(duration|format|rate|channels|record)|\.(wav|mp3|ogg|flac|raw|opus|aac)\b)/ nocase or
      $proc.target.process.command_line = /\b(ffmpeg|avconv)\b.*\s-f\s+(alsa|pulse|oss|jack|sndio)\b/ nocase or
      $proc.target.process.command_line = /\bsox\b.*\s-t\s+(alsa|pulseaudio|oss|waveaudio)\b/ nocase or
      $proc.target.process.command_line = /\b(ffmpeg|avconv|sox)\b.*\/dev\/snd\// nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.hostname in %global_allowed_script_hosts
    $proc.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1123")
    $primary_entity = array_distinct($host)
    $event_count = count($proc.metadata.id)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $capture_commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
