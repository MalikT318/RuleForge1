/*
  MITRE Technique : T1600.002 - Disable Crypto Hardware
  Tactic(s)       : Defense Impairment
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:10:15.125269+00:00
  Reference       : https://attack.mitre.org/techniques/T1600/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_002_Crypto_Hardware_Disable_Config_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Several configuration-change events on a single network device within ten minutes reference disabling, bypassing or turning off the dedicated hardware crypto engine, accelerator or offload. Each change alone may be maintenance. Repeated changes on one device suggest an adversary forcing software encryption, typically alongside cipher weakening."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1600.002"
    mitre_technique_name = "Weaken Encryption: Disable Crypto Hardware"
    log_prerequisites = "Firewall or network device management-plane syslog and configuration/command audit logs, parsed into UDM SETTING_MODIFICATION with the change text in metadata.description or security_result.description."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Planned maintenance or hardware troubleshooting (for example isolating a faulty crypto module), firmware or OS upgrades that re-apply crypto configuration, and configuration-management or automation pushes that re-send the full configuration."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation or config-push accounts to %global_allowed_service_accounts. Raise the #setting threshold if config replay produces noise. Correlate hits with change tickets."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.principal.hostname = $host
    (
      $setting.metadata.description = /(no\s+crypto\s+(engine|accelerator|hw|hardware)|crypto[\s_-]*(engine|accelerator|hardware|hw|offload).{0,40}(disable|off|bypass)|(disable|bypass|turn\s+off).{0,40}(hardware|hw)[\s_-]*(crypto|encrypt)|(hardware|hw)[\s_-]*(crypto|encryption)[\s_-]*(disabled|off|bypass))/ nocase
      or
      $setting.security_result.description = /(no\s+crypto\s+(engine|accelerator|hw|hardware)|crypto[\s_-]*(engine|accelerator|hardware|hw|offload).{0,40}(disable|off|bypass)|(disable|bypass|turn\s+off).{0,40}(hardware|hw)[\s_-]*(crypto|encrypt)|(hardware|hw)[\s_-]*(crypto|encryption)[\s_-]*(disabled|off|bypass))/ nocase
    )
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $event_count = count($setting.metadata.id)
    $risk_score = max(if(count($setting.metadata.id) >= 6, 90, 75))
    $mitre_technique_id = array_distinct("T1600.002")
    $primary_entity = array_distinct($host)
    $acting_users = array_distinct($setting.principal.user.userid)

  condition:
    #setting >= 3
}
