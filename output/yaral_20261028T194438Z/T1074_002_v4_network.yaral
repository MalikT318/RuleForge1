/*
  MITRE Technique : T1074.002 - Remote Data Staging
  Tactic(s)       : Collection
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:20:25.225479+00:00
  Reference       : https://attack.mitre.org/techniques/T1074/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_002_ESXi_Shell_Transfer_Utility_External_Staging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi host shell file-transfer or socket utility (scp, sftp, ssh, rsync, nc, curl, wget) opening an outbound connection to a non-internal address on a typical file-transfer port (FTP, SSH/SFTP, rsync, SMB). On a hypervisor this is a network-side indicator of data being pushed to a remote staging system before exfiltration. Internal address space is excluded through a reference list, so the rule focuses on staging on external or cloud-hosted infrastructure."
    mitre_tactic = "Collection"
    mitre_technique = "T1074.002"
    mitre_technique_name = "Data Staged: Remote Data Staging"
    log_prerequisites = "ESXi shell and network connection telemetry normalised to UDM NETWORK_CONNECTION, with principal.process.file.full_path populated. This usually requires a host-level agent or syslog forwarding with process attribution."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators pushing support bundles or logs to a vendor or external support server, backup or replication tooling using scp or rsync to an offsite target, host patching or VIB downloads through curl or wget on a transfer port, and monitoring scripts that report to external endpoints."
    tuning_guidance = "Add approved admin or automation binaries to %global_allowed_admin_tools, and backup or replication binaries to %global_allowed_backup_processes. Add sanctioned management or backup source hosts to %global_allowed_mgmt_sources. Confirm %rfc1918_internal covers all internal and VPN ranges for the client. Narrow or widen the port list to match the client's approved transfer protocols."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(scp|sftp|ssh|rsync|nc|curl|wget)$/ nocase
    (
      $net.target.port = 21 or
      $net.target.port = 22 or
      $net.target.port = 445 or
      $net.target.port = 873
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.principal.hostname in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1074.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $transfer_process = array_distinct($net.principal.process.file.full_path)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
