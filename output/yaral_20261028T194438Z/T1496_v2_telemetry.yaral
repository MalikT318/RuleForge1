/*
  MITRE Technique : T1496 - Resource Hijacking
  Tactic(s)       : Impact
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:50:01.713671+00:00
  Reference       : https://attack.mitre.org/techniques/T1496
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_Cloud_Compute_Quota_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a configuration change that raises or modifies a service quota or limit in a cloud tenant. Adversaries who compromise cloud credentials often lift compute quotas first so they can launch large numbers of instances for cryptomining or proxy abuse. This rule detects the configuration state change at the control-plane layer, not any command line or process."
    mitre_tactic = "Impact"
    mitre_technique = "T1496"
    mitre_technique_name = "Resource Hijacking"
    log_prerequisites = "Cloud control-plane audit logs (management and admin activity) normalised to UDM SETTING_MODIFICATION, with metadata.product_event_type and principal.user.userid populated."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate capacity planning by cloud or platform teams, planned scale-out for product launches or seasonal load, new project or account onboarding, and infrastructure-as-code pipelines or automation accounts that raise quotas as part of normal deployment."
    tuning_guidance = "Add automation and IaC identities to %global_allowed_service_accounts, approved platform engineers to %global_allowed_admin_users, and approved cloud service principals to %global_allowed_cloud_principals. If the tenant is noisy, correlate with a following burst of RESOURCE_CREATION by the same principal. Review the principal's recent USER_LOGIN events for new locations or ASNs."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /quota/ nocase
    $cloud.metadata.product_event_type = /(increase|raise|request|update|modify|set|put|change)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1496")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $source_ips = array_distinct($cloud.principal.ip)
    $api_actions = array_distinct($cloud.metadata.product_event_type)
    $changed_resources = array_distinct($cloud.target.resource.name)

  condition:
    $cloud
}
