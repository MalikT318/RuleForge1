/*
  MITRE Technique : T1048.001 - Exfiltration Over Symmetric Encrypted Non-C2 Protocol
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:33:35.987628+00:00
  Reference       : https://attack.mitre.org/techniques/T1048/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1048_001_Large_Outbound_Transfer_NonStandard_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a large volume of data sent from an internal host to an external address over a TCP port that is not a standard web, DNS, mail or time service. Bulk transfers over unusual encrypted channels (SSH/SFTP, FTPS, custom TLS or attacker-chosen ports) are characteristic of exfiltration over a symmetric-encrypted non-C2 protocol. Detection is based on the perimeter flow only, so it works regardless of the process or tool that initiated the transfer."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1048.001"
    mitre_technique_name = "Exfiltration Over Alternative Protocol: Exfiltration Over Symmetric Encrypted Non-C2 Protocol"
    log_prerequisites = "Firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with network.sent_bytes, target.ip and target.port populated. Logs must record session byte counts at connection close or in periodic updates."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Offsite backup and replication jobs, SFTP or managed file transfer to business partners, cloud storage sync clients on non-standard ports, software or game distribution, VPN or tunnelling services, and large developer pushes over SSH to external Git hosting."
    tuning_guidance = "Add known-good destination domains to %global_allowed_domains. Adjust the 50 MB sent_bytes threshold per client baseline (lower for low-volume environments, higher for data-heavy ones). Extend the excluded port list with client-specific sanctioned services. Ensure %rfc1918_internal is populated so internal traffic is excluded."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "TCP"
    $net.network.sent_bytes >= 52428800
    $net.target.port > 0
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 53
    $net.target.port != 123
    $net.target.port != 25
    $net.target.port != 587
    $net.target.port != 465
    $net.target.port != 993
    $net.target.port != 995
    $net.target.port != 8080
    $net.target.port != 8443
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1048.001")
    $primary_entity = array_distinct($net.principal.ip)
    $source_hostname = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
