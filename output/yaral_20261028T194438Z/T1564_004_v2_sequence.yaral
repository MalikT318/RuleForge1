/*
  MITRE Technique : T1564.004 - NTFS File Attributes
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:18:58.223788+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_004_ADS_Created_Then_Executed_From_Stream {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects creation of an NTFS Alternate Data Stream (excluding common benign streams such as Zone.Identifier) followed within ten minutes by a process launched from an image path that resides inside an alternate data stream on the same host. This chain indicates payload hiding in NTFS attributes and its subsequent execution."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.004"
    mitre_technique_name = "Hide Artifacts: NTFS File Attributes"
    log_prerequisites = "Requires endpoint telemetry that records NTFS stream creation as FILE_CREATION with the stream suffix in the file path (e.g. Sysmon Event ID 15 or EDR equivalent), plus process launch telemetry with the full image path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Browsers and download managers writing custom streams, backup and sync clients (cloud storage, file replication) writing metadata streams, document management and DLP agents tagging files, legacy installers using streams, and admin scripts that legitimately store data in streams."
    tuning_guidance = "Add approved RMM, deployment and backup binaries to %global_allowed_admin_tools, and EDR/AV agents to %global_allowed_security_tools. Extend the benign stream-name exclusion regex with additional stream names seen in the client environment (e.g. vendor DLP tags)."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^[a-z]:\\.+\\[^\\:]+:[^\\:]+/ nocase
    not $file.target.file.full_path = /:(Zone\.Identifier|SmartScreen|encryptable|favicon|\$DATA$)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /^[a-z]:\\.+\\[^\\:]+:[^\\]+$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1564.004")
    $primary_entity = array_distinct($hostname)
    $stream_paths = array_distinct($file.target.file.full_path)
    $executed_images = array_distinct($proc.target.process.file.full_path)
    $launch_commands = array_distinct($proc.target.process.command_line)
    $users = array_distinct($proc.principal.user.userid)
    $stream_event_count = count($file.metadata.id)

  condition:
    $file and $proc
}
