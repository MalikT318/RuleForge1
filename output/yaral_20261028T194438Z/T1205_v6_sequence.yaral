/*
  MITRE Technique : T1205 - Traffic Signaling
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:09:22.888336+00:00
  Reference       : https://attack.mitre.org/techniques/T1205
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_Linux_Knock_Firewall_Rules_Then_Persisted {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Linux host where an iptables-family command builds stateful 'recent' module rules (the classic port-knocking primitive: --set, --rcheck, --update) and, within 10 minutes, a firewall or boot-time network startup file is modified. This pattern indicates a hidden, signal-triggered port being created and made persistent."
    mitre_tactic = "Stealth, Persistence, Command and Control"
    mitre_technique = "T1205"
    mitre_technique_name = "Traffic Signaling"
    log_prerequisites = "Requires Linux EDR or auditd process-execution telemetry with full command lines, plus file modification telemetry for /etc paths, both normalised to UDM with principal.hostname populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators hardening SSH with rate-limit or brute-force protection rules built on the recent module; configuration management tools (Ansible, Puppet, Chef) deploying firewall policy; netfilter-persistent or iptables-save writing rules after an approved change; fail2ban-style tooling; golden-image build pipelines."
    tuning_guidance = "Add configuration management and firewall tooling to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Rate-limiting rules typically use --update with --hitcount on a single service port. If these are common in the client environment, review the matched command lines and add the owning tooling to the allowlist rather than loosening the regex."

  events:
    $fw.metadata.event_type = "PROCESS_LAUNCH"
    $fw.target.process.file.full_path = /\/(iptables|ip6tables|iptables-nft|ip6tables-nft|iptables-legacy|ip6tables-legacy)$/ nocase
    $fw.target.process.command_line = /(-m|--match)\s+recent\b/ nocase
    $fw.target.process.command_line = /--(set|rcheck|update|rdest|rsource)\b/ nocase
    not $fw.principal.process.file.full_path in %global_allowed_admin_tools
    $fw.principal.hostname = $hostname

    $persist.metadata.event_type = "FILE_MODIFICATION"
    $persist.target.file.full_path = /^\/etc\/(iptables\/rules\.v[46]|sysconfig\/ip6?tables|nftables\.conf|rc\.local|network\/if-(pre-)?up\.d\/.+)$/ nocase
    not $persist.principal.process.file.full_path in %global_allowed_admin_tools
    not $persist.principal.user.userid in %global_allowed_service_accounts
    $persist.principal.hostname = $hostname

    $fw.metadata.event_timestamp.seconds <= $persist.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1205")
    $primary_entity = array_distinct($hostname)
    $knock_commands = array_distinct($fw.target.process.command_line)
    $persisted_files = array_distinct($persist.target.file.full_path)
    $acting_users = array_distinct($fw.principal.user.userid)
    $fw_event_count = count($fw.metadata.id)

  condition:
    $fw and $persist
}
