/*
  MITRE Technique : T1059.001 - PowerShell
  Tactic(s)       : Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:07:56.686892+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_001_PowerShell_Drops_Executable_Then_Executes {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A PowerShell host process (powershell.exe or pwsh.exe) writes an executable (.exe, .scr or .com) to a user-writable staging location, and that same file is launched as a process on the same host within five minutes. This is the download-and-execute or drop-and-run pattern typical of PowerShell stagers. It keys on the file-write to process-launch chain, not on PowerShell command-line content."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.001"
    mitre_technique_name = "Command and Scripting Interpreter: PowerShell"
    log_prerequisites = "Requires endpoint telemetry that populates FILE_CREATION with the principal process path and PROCESS_LAUNCH with the target process path (EDR or Sysmon Event IDs 11 and 1)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate PowerShell-based installers or bootstrappers that unpack and run a setup executable from a temp folder, software deployment and RMM scripts, developer build scripts, and package managers invoked through PowerShell (for example Chocolatey or winget wrappers)."
    tuning_guidance = "Add approved deployment or RMM parent binaries to %global_allowed_admin_tools. Add build servers and admin jump hosts that routinely script installs to %global_allowed_script_hosts. If installer noise persists, narrow the staging directory regex for the affected client."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\appdata\\|users\\public\\|programdata\\|windows\\temp\\|temp\\).*\.(exe|scr|com)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.hostname in %global_allowed_script_hosts
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $path

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(users\\[^\\]+\\appdata\\|users\\public\\|programdata\\|windows\\temp\\|temp\\).*\.(exe|scr|com)$/ nocase
    $proc.principal.hostname = $hostname
    $proc.target.process.file.full_path = $path

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1059.001")
    $primary_entity = array_distinct($hostname)
    $dropped_file = array_distinct($path)
    $dropper_process = array_distinct($file.principal.process.file.full_path)
    $dropper_command_line = array_distinct($file.principal.process.command_line)
    $launched_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file and $proc
}
