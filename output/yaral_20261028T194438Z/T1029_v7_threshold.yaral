/*
  MITRE Technique : T1029 - Scheduled Transfer
  Tactic(s)       : Exfiltration
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:50:49.629119+00:00
  Reference       : https://attack.mitre.org/techniques/T1029
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1029_Recurring_Outbound_Bulk_Transfers_Firewall {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source repeatedly sends large volumes of data to the same external destination within 10 minutes, consistent with scheduled or interval-based exfiltration. Each connection is benign on its own. The repetition to one destination is the signal."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1029"
    mitre_technique_name = "Scheduled Transfer"
    log_prerequisites = "Requires perimeter firewall or proxy connection/flow logs that populate principal.ip, target.ip and network.sent_bytes. No endpoint process fields are used."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Cloud backup and sync clients, software or OS update distribution, telemetry and log shipping agents, scheduled replication jobs, video conferencing uploads, legitimate large file uploads to SaaS."
    tuning_guidance = "Add known-good destinations to %global_allowed_domains and approved source addresses (backup servers, scanners, management hosts) to %global_allowed_mgmt_sources. Raise the byte threshold or the #net count for noisy sources. Lower them for high-value segments."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src_ip
    $net.target.ip = $dst_ip
    $net.network.sent_bytes >= 1000000
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  match:
    $src_ip, $dst_ip over 10m

  outcome:
    $risk_score = max(if($net.network.sent_bytes >= 50000000, 80, 55))
    $mitre_technique_id = array_distinct("T1029")
    $primary_entity = array_distinct($src_ip)
    $destination_ips = array_distinct($dst_ip)
    $destination_ports = array_distinct($net.target.port)
    $connection_count = count($net.metadata.id)
    $total_bytes_sent = sum($net.network.sent_bytes)

  condition:
    #net >= 5
}
