/*
  MITRE Technique : T1127 - Trusted Developer Utilities Proxy Execution
  Tactic(s)       : Stealth, Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:35:23.276453+00:00
  Reference       : https://attack.mitre.org/techniques/T1127
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1127_DevUtility_Proxy_Launch_Then_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A trusted developer utility (build, compile, install or debug binary) is launched by an Office, script-host or other non-developer parent and then makes an outbound connection to an external address from the same host within 10 minutes. This behaviour suggests proxy execution of a remote or staged payload through a signed binary. It does not rely on command-line content, so it complements process-creation rules."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1127"
    mitre_technique_name = "Trusted Developer Utilities Proxy Execution"
    log_prerequisites = "Requires EDR or Sysmon process launch telemetry (with parent process) and network connection telemetry attributed to the originating process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developer workstations or build agents where scripts invoke MSBuild or a compiler that restores packages from external feeds, software installers that run InstallUtil or RegAsm and check licensing online, and debugging tools that download symbols from external symbol servers."
    tuning_guidance = "Add legitimate build orchestrators and deployment tooling to %global_allowed_admin_tools. Add approved script-host parents to %global_allowed_script_hosts. Add package feeds and symbol servers to %global_allowed_domains. If developer hosts are noisy, add a host exclusion in a client-specific copy of the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(msbuild|csc|vbc|jsc|installutil|regasm|regsvcs|rcsi|dnx|cdb|ntsd|windbg|kd)\.exe$/ nocase
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|wscript|cscript|mshta|powershell|pwsh|cmd|wmiprvse|rundll32|regsvr32|explorer)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    $proc.principal.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(msbuild|csc|vbc|jsc|installutil|regasm|regsvcs|rcsi|dnx|cdb|ntsd|windbg|kd)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    $net.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1127")
    $primary_entity = array_distinct($net.principal.hostname)
    $dev_utility_paths = array_distinct($proc.target.process.file.full_path)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $launch_command_lines = array_distinct($proc.target.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $connection_count = count($net.metadata.id)

  condition:
    $proc and $net
}
