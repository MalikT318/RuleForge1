/*
  MITRE Technique : T1518.001 - Security Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:21:08.135568+00:00
  Reference       : https://attack.mitre.org/techniques/T1518/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_001_Linux_Security_Agent_Enum_Then_Config_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a Linux host where a process or service listing, or a package query, is filtered for security tooling keywords. Within 10 minutes the same host then inspects security control status or configuration (SELinux, AppArmor, auditd, ClamAV, OSSEC/Wazuh paths). This sequence indicates an adversary profiling defensive software before follow-on actions."
    mitre_tactic = "Discovery"
    mitre_technique = "T1518.001"
    mitre_technique_name = "Software Discovery: Security Software Discovery"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to PROCESS_LAUNCH with full command lines, plus a populated principal.hostname."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management and compliance scanners (CIS benchmark and hardening audits), system administrators troubleshooting agents, monitoring health checks, vulnerability scanner authenticated checks, and software inventory jobs."
    tuning_guidance = "Add approved agents and compliance tooling to %global_allowed_security_tools and %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Add hardening or inventory scripts to %global_allowed_script_hosts and scanner hosts to %global_allowed_scanners. If noise persists, raise severity only when the user is interactive or the parent is a shell spawned from a network service."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(ps|pgrep|pidof|systemctl|service|chkconfig|dpkg|rpm|snap|apt|yum|dnf)$/ nocase
    $proc.target.process.command_line = /(auditd|clamd|clamav|freshclam|ossec|wazuh|falco|osquery|aide|rkhunter|chkrootkit|fail2ban|tripwire|sysmon|antivirus|endpoint[-_ ]?(agent|protection)|edr)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    $cfg.metadata.event_type = "PROCESS_LAUNCH"
    $cfg.target.process.command_line = /(\b(sestatus|getenforce|aa-status|apparmor_status|auditctl)\b|\/etc\/(audit|selinux|apparmor\.d|clamav|ossec)|\/var\/ossec|\/var\/log\/audit)/ nocase
    not $cfg.principal.process.file.full_path in %global_allowed_security_tools
    not $cfg.principal.process.file.full_path in %global_allowed_admin_tools
    not $cfg.principal.user.userid in %global_allowed_service_accounts
    $cfg.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $cfg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1518.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $users = array_distinct($proc.principal.user.userid)
    $enum_commands = array_distinct($proc.target.process.command_line)
    $probe_commands = array_distinct($cfg.target.process.command_line)
    $first_seen = min($proc.metadata.event_timestamp.seconds)
    $last_seen = max($cfg.metadata.event_timestamp.seconds)

  condition:
    $proc and $cfg
}
