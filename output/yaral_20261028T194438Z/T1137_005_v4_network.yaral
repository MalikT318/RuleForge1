/*
  MITRE Technique : T1137.005 - Outlook Rules
  Tactic(s)       : Persistence
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:21:01.255798+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_005_Outlook_External_SMB_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Outlook process opening an SMB/NetBIOS connection (TCP 445/139) to a non-internal address. Malicious Outlook rules (for example a 'start application' rule action) can point at a remote UNC path or WebDAV/SMB share to pull and run a payload when a crafted email arrives. Outlook has no normal need to speak SMB to external hosts, so this is a high-fidelity network-side indicator of rule-based persistence or execution."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.005"
    mitre_technique_name = "Office Application Startup: Outlook Rules"
    log_prerequisites = "Requires endpoint network telemetry that records the initiating process (EDR or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Outlook opening PST/OST or attachments on SMB shares reached through VPN or SD-WAN that uses non-RFC1918 addressing (e.g. CGNAT 100.64.0.0/10); cloud-hosted file shares (SMB over 445 to a cloud storage service); hybrid migration tooling; users opening UNC-linked content from trusted partner shares."
    tuning_guidance = "Add legitimate external SMB endpoints to %global_allowed_domains (via target.hostname). Add any non-RFC1918 internal or VPN ranges to %rfc1918_internal. Add approved hosts running mail-support tooling to %global_allowed_admin_tools via the parent process, and approved scanning sources to %global_allowed_scanners."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\outlook\.exe$/ nocase
    ($net.target.port = 445 or $net.target.port = 139)
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1137.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $user = array_distinct($net.principal.user.userid)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
