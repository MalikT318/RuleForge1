/*
  MITRE Technique : T1569 - System Services
  Tactic(s)       : Execution
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:10:09.196443+00:00
  Reference       : https://attack.mitre.org/techniques/T1569
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_Linux_Systemd_Run_Transient_Service_Suspicious_Payload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects systemd-run creating a transient service or scope whose command line runs a payload from a world-writable directory (/tmp, /var/tmp, /dev/shm), or an inline download-and-execute, reverse-shell or decode-and-execute pattern. Adversaries use transient systemd units to execute code through the service manager, detached from the invoking session, without writing a persistent unit file."
    mitre_tactic = "Execution"
    mitre_technique = "T1569"
    mitre_technique_name = "System Services"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records (SYSCALL/EXECVE) normalised to UDM PROCESS_LAUNCH with full command-line arguments."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators or configuration management running one-off maintenance jobs via systemd-run, CI/CD runners and build agents executing scripts from /tmp, package or installer post-install scripts, and developers testing resource-limited units."
    tuning_guidance = "Add approved automation parents to %global_allowed_admin_tools or %global_allowed_script_hosts, automation accounts to %global_allowed_service_accounts, and named administrators to %global_allowed_admin_users. Add host-specific exclusions only after confirming the parent process and account."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/systemd-run$/ nocase
    $proc.target.process.command_line = /(\/(tmp|var\/tmp|dev\/shm)\/[^\s]+|\b(curl|wget)\b.*\|\s*(ba|da|z|k)?sh\b|\/dev\/(tcp|udp)\/|\bbase64\s+(-d|--decode)\b|\b(python[0-9.]*|perl|ruby)\s+-(c|e)\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1569")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
