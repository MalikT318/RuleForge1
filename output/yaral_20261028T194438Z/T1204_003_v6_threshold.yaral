/*
  MITRE Technique : T1204.003 - Malicious Image
  Tactic(s)       : Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:03:41.899036+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_003_Mass_Container_Workload_Creation_By_Identity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single identity creates many container workloads (pods, deployments, daemonsets, jobs) within ten minutes. One workload creation is routine. A burst from one non-allowlisted identity is consistent with deployment of a backdoored or look-alike image at scale, such as cryptomining payloads spread across a cluster. This rule is control-plane based and does not depend on process command lines."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.003"
    mitre_technique_name = "User Execution: Malicious Image"
    log_prerequisites = "Cloud/orchestration control-plane audit logs normalised to UDM RESOURCE_CREATION with principal.user.userid and target.resource.resource_subtype populated. Audit policy must record create verbs on workload resources."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "CI/CD pipelines and GitOps controllers, autoscalers and operators, batch or job schedulers, cluster bootstrap, and admins doing scheduled rollouts or migrations."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Raise the #cloud threshold for clusters with heavy batch workloads. Review target_resources and source_ips in the outcome to check image provenance."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.target.resource.resource_subtype = /^(pods?|deployments?|daemonsets?|replicasets?|statefulsets?|jobs?|cronjobs?|containers?)$/ nocase
    $cloud.principal.user.userid != ""
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1204.003")
    $primary_entity = array_distinct($user)
    $event_count = count($cloud.metadata.id)
    $target_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    #cloud >= 10
}
