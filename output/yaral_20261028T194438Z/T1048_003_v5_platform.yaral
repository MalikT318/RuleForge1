/*
  MITRE Technique : T1048.003 - Exfiltration Over Unencrypted Non-C2 Protocol
  Tactic(s)       : Exfiltration
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:38:24.453540+00:00
  Reference       : https://attack.mitre.org/techniques/T1048/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1048_003_Large_Outbound_Cleartext_Protocol_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a single flow record from an internal source to an external destination on a cleartext protocol port (FTP, SMTP, TFTP, HTTP) with a large outbound byte count. This is consistent with bulk data exfiltration over an unencrypted non-C2 protocol, observed at the network perimeter and not on the endpoint."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1048.003"
    mitre_technique_name = "Exfiltration Over Alternative Protocol: Exfiltration Over Unencrypted Non-C2 Protocol"
    log_prerequisites = "Requires perimeter firewall or proxy flow/connection logs with byte counters (network.sent_bytes) populated and normalised to UDM NETWORK_FLOW. Logs must record session close or summary records, since byte counts are often only present there."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Software or OS update downloads over HTTP that are misattributed in direction, large legitimate HTTP uploads to partners, authorised FTP/SFTP-gateway or managed file transfer jobs, bulk mail relay through SMTP, backup or replication jobs to external sites, vulnerability scanners, and approved network admin transfers (config or firmware pushes over TFTP/FTP)."
    tuning_guidance = "Add known sources (backup, MFT, mail relays) to %global_allowed_mgmt_sources or %global_allowed_scanners. Add trusted destination hostnames to %global_allowed_domains. Adjust the 10 MB (10485760 byte) threshold per client baseline. Remove port 80 on clients where large HTTP uploads are routine, or lower the threshold for FTP/TFTP, which are rarely legitimate across the perimeter."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    ($net.target.port = 21 or $net.target.port = 25 or $net.target.port = 69 or $net.target.port = 80)
    $net.network.sent_bytes > 10485760
    not $net.target.ip in %rfc1918_internal
    $net.principal.ip != ""
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1048.003")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
