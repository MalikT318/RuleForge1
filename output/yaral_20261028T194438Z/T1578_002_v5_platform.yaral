/*
  MITRE Technique : T1578.002 - Create Cloud Instance
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:52:05.158685+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_002_Cloud_Instance_Created_By_Unapproved_Principal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a new compute instance or virtual machine in a cloud account by a principal that is not an approved automation identity, service account, or named administrator. Adversaries create instances to bypass the firewall rules and permissions of existing workloads, for example to mount stolen snapshots under a permissive security policy."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578.002"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Create Cloud Instance"
    log_prerequisites = "Cloud control-plane audit logs with management or admin write activity enabled, ingested and normalised to UDM RESOURCE_CREATION. Requires principal.user.userid to be populated, and either target.resource.resource_type or metadata.product_event_type."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Developers or engineers launching test instances manually; autoscaling groups, infrastructure-as-code pipelines, and managed container or batch services whose identities are not yet in the allowlists; disaster-recovery drills; new-project or new-account onboarding."
    tuning_guidance = "Add CI/CD, autoscaling, and IaC identities to %global_allowed_service_accounts. Add approved identity-provider service principals to %global_allowed_cloud_principals. Add named platform administrators to %global_allowed_admin_users. If the rule is still noisy in a specific tenant, raise severity only for instance creation outside business hours or in regions the client does not normally use, and correlate with a prior snapshot-sharing or snapshot-copy event."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    (
      $cloud.target.resource.resource_type = "VIRTUAL_MACHINE" or
      $cloud.metadata.product_event_type = /(RunInstances|instances\.insert|instances\.bulkInsert|virtualMachines\/write|virtualMachineScaleSets\/write)/ nocase
    )
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1578.002")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $source_ips = array_distinct($cloud.principal.ip)
    $created_resources = array_distinct($cloud.target.resource.name)
    $api_calls = array_distinct($cloud.metadata.product_event_type)

  condition:
    $cloud
}
