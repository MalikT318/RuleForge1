/*
  MITRE Technique : T1547.008 - LSASS Driver
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:33:52.079714+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_008_LSA_Package_Registry_After_System32_DLL_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a new DLL written to System32 or SysWOW64 by a non-trusted process, followed within 10 minutes on the same host by a modification of the LSA Authentication, Notification or Security Packages registry values. This sequence indicates an LSASS driver or package being staged and registered for persistence inside lsass.exe."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.008"
    mitre_technique_name = "Boot or Logon Autostart Execution: LSASS Driver"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon EID 11) and registry-modification telemetry (Sysmon EID 13) normalised to UDM FILE_CREATION and REGISTRY_MODIFICATION, with principal.hostname populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate installation of third-party authentication providers (smart card middleware, MFA credential providers, password filter products such as password-policy enforcers, SSO agents) and Windows servicing or feature updates that modify LSA packages."
    tuning_guidance = "Add approved installer or deployment binaries to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. Review the writer process and DLL path outcomes for password-filter or MFA vendor products and allow-list their installer executables. Servicing processes are already excluded by name."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\windows\\(system32|syswow64)\\[^\\]+\.dll$/ nocase
    not $file.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control\\Lsa(\\OSConfig)?$/ nocase
    $reg.target.registry.registry_value_name = /^(Authentication Packages|Notification Packages|Security Packages)$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1547.008")
    $primary_entity = array_distinct($reg.principal.hostname)
    $dropped_dlls = array_distinct($file.target.file.full_path)
    $dll_writer_processes = array_distinct($file.principal.process.file.full_path)
    $lsa_values_modified = array_distinct($reg.target.registry.registry_value_name)
    $registry_writer_processes = array_distinct($reg.principal.process.file.full_path)
    $registry_event_count = count($reg.metadata.id)

  condition:
    $file and $reg
}
