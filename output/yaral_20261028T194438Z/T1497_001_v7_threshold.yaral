/*
  MITRE Technique : T1497.001 - System Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:03:20.913281+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_001_VM_Artifact_Check_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of five or more Windows commands on one host within ten minutes that probe for virtualization or sandbox artifacts. The probes cover registry queries for hypervisor keys, WMI/CIM queries of hardware identity classes, and process or service enumeration for guest-tool components. A single check is common admin activity, but repeated checks in a short window suggest scripted sandbox-evasion logic in malware."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1497.001"
    mitre_technique_name = "Virtualization/Sandbox Evasion: System Checks"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with full command lines populated (EDR, Sysmon Event ID 1, or Windows Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Hardware and asset inventory scripts, RMM health checks, VDI and hypervisor guest-tool installers or updaters, virtualization administrators and developers working on VM hosts, software licensing checks, and endpoint security agents that fingerprint the environment."
    tuning_guidance = "Add inventory, RMM and deployment tooling to %global_allowed_admin_tools, security agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. In virtualization-heavy estates (VDI, lab, or developer hosts), raise the threshold above 5 or exclude the affected hosts' parent processes via %global_allowed_script_hosts. Severity can be raised when the host is a physical endpoint."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(reg|wmic|powershell|pwsh|cmd|tasklist|sc|cscript|wscript)\.exe$/ nocase
    $proc.target.process.command_line = /((reg(\.exe)?\s+query|get-itemproperty|get-childitem).*(vmware|vbox|virtualbox|qemu|vmtools|vmmouse|vmhgfs|vboxguest|xenvbd|hyper-v|virtualmachine))|((wmic|get-wmiobject|get-ciminstance|gwmi).*(win32_computersystem|win32_bios|win32_baseboard|win32_videocontroller|win32_diskdrive|win32_pnpentity|msacpi_thermalzonetemperature))|((tasklist|get-process|sc(\.exe)?\s+query|get-service).*(vmtoolsd|vmwaretray|vmwareuser|vboxservice|vboxtray|vmsrvc|vmusrvc|prl_tools|qemu-ga|xenservice))/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1497.001")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $sample_commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 5
}
