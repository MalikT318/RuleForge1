/*
  MITRE Technique : T1568 - Dynamic Resolution
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:04:06.991214+00:00
  Reference       : https://attack.mitre.org/techniques/T1568
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1568_Linux_DGA_Like_DNS_Volume_Per_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single Linux host issues a high volume of DNS queries for long, random-looking second-level domain labels within ten minutes. This is typical of domain generation algorithm (DGA) malware cycling through computed C2 domains. Any one lookup is benign; the volume of algorithmic-looking names from one host is the signal."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1568"
    mitre_technique_name = "Dynamic Resolution"
    log_prerequisites = "Requires Linux endpoint telemetry that records DNS queries with the question name and initiating host, from EDR or auditd and resolver logs normalised to UDM NETWORK_DNS. Hosts that only forward DNS to a central resolver without local telemetry are not covered."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "CDN and cloud services with long machine-generated hostnames, container and Kubernetes node tooling, software update and telemetry services, browsers using DNS prefetch, mail servers checking DNSBLs, and security or measurement tools that bulk-resolve names."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains and EDR or monitoring agents to %global_allowed_security_tools. Raise the #dns threshold on busy hosts such as DNS forwarders, mail relays and build servers. Tune the label-length quantifier (currently 14 or more characters) per environment."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.principal.hostname = $host
    $dns.network.dns.questions.name = /^[a-z0-9]{14,}\.([a-z0-9-]+\.)*[a-z]{2,}$/ nocase
    not re.regex($dns.network.dns.questions.name, /(?i)\.(arpa|local|internal|lan|localdomain)$/)
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($dns.metadata.id)
    $queried_domains = array_distinct($dns.network.dns.questions.name)
    $source_processes = array_distinct($dns.principal.process.file.full_path)
    $mitre_technique_id = array_distinct("T1568")
    $primary_entity = array_distinct($host)

  condition:
    #dns >= 15
}
