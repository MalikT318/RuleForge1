/*
  MITRE Technique : T1036.003 - Rename Legitimate Utilities
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:00:11.672709+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_003_Linux_Utility_Copied_To_Staging_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects the file artifact of a renamed or relocated utility on Linux: a copy, move or install tool creates an extension-less file in a world-writable staging directory (/tmp, /var/tmp, /dev/shm). Attackers copy binaries such as curl, python or busybox to these locations under a new name to evade name-based and path-based detections. This rule works on the resulting FILE_CREATION state change, so it still fires when command-line logging is evaded."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.003"
    mitre_technique_name = "Masquerading: Rename Legitimate Utilities"
    log_prerequisites = "Requires Linux EDR or auditd file telemetry that records file creation with the creating process path (principal.process.file.full_path) populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software installers and package managers staging binaries in /tmp, CI/CD runners and build agents, administrators copying tools for troubleshooting, container or application bootstrap scripts, and self-extracting updaters."
    tuning_guidance = "Add approved deployment and RMM tooling to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and trusted jump or build hosts to %global_allowed_script_hosts. Extend the staging directory regex for environment-specific scratch paths. Consider raising severity when the creating user is root or the host is a server with no interactive admin activity."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(cp|mv|install|rsync|busybox)$/ nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/([^\/]+\/)*[^\/.]+$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1036.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_files = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    $file
}
