/*
  MITRE Technique : T1547.001 - Registry Run Keys / Startup Folder
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:24:40.278728+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_001_Run_Key_Mass_Registry_Writes {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several registry writes to Run, RunOnce, RunOnceEx or Policies\\Explorer\\Run autostart keys on a single host within ten minutes. One autostart write is common during software installs. Repeated writes across these keys in a short window point to persistence staging, multi-key redundancy or malware installers."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.001"
    mitre_technique_name = "Boot or Logon Autostart Execution: Registry Run Keys / Startup Folder"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events 12/13/14) normalised to REGISTRY_MODIFICATION with target.registry.registry_key and principal.hostname populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters registering several autostart entries, profile or logon scripts that set per-user Run values, golden-image or VDI provisioning, RMM and deployment agents, and security agents re-registering themselves."
    tuning_guidance = "Add approved installer, deployment or RMM binaries to %global_allowed_admin_tools and EDR or AV agent binaries to %global_allowed_security_tools. Raise the #reg threshold on VDI or imaging-heavy estates. Lower it to 2 on hardened servers where autostart changes should be rare."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\CurrentVersion\\(Policies\\Explorer\\)?(Run|RunOnce|RunOnceEx)(\\|$)/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1547.001")
    $primary_entity = array_distinct($host)
    $event_count = count($reg.metadata.id)
    $distinct_value_names = count_distinct($reg.target.registry.registry_value_name)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 3
}
