/*
  MITRE Technique : T1074 - Data Staged
  Tactic(s)       : Collection
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:16:32.111299+00:00
  Reference       : https://attack.mitre.org/techniques/T1074
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_Linux_Archive_Staged_In_Temp_Directory {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of an archive or compressed file (tar, gzip, zip, 7z, rar, xz, zstd and similar) in a world-writable staging location (/tmp, /var/tmp, /dev/shm). Adversaries commonly consolidate collected data into a single archive in these directories before exfiltration. Detection is based on the resulting file artifact rather than command-line content, so it still fires when command-line logging is evaded or the archiving utility is renamed."
    mitre_tactic = "Collection"
    mitre_technique = "T1074"
    mitre_technique_name = "Data Staged"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-creation events normalised to UDM FILE_CREATION with target.file.full_path and principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup and imaging jobs writing temporary archives, package managers and installers unpacking bundles in /tmp, application log-rotation or support-bundle collection scripts, administrators gathering diagnostics for vendor support, CI/build agents, and software deployment tooling."
    tuning_guidance = "Add approved backup software to %global_allowed_backup_processes, deployment/RMM tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Extend the package-manager process-name exclusion if specific build or CI hosts are noisy. Consider raising severity for servers that hold sensitive data."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.*\.(tar|tar\.gz|tgz|tar\.bz2|tbz2|tar\.xz|txz|tar\.zst|zip|7z|rar|gz|bz2|xz|zst)$/ nocase
    not $file.principal.process.file.full_path = /\/(apt|apt-get|dpkg|dnf|yum|rpm|zypper|unattended-upgrade|snapd|packagekitd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1074")
    $primary_entity = array_distinct($file.principal.hostname)
    $staged_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
