/*
  MITRE Technique : T1600.001 - Reduce Key Space
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:06:25.695611+00:00
  Reference       : https://attack.mitre.org/techniques/T1600/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_001_Weak_Cipher_Negotiated_External_Session {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a network session to an external destination in which a weak or deprecated cipher or protocol version was negotiated (export-grade, NULL, anonymous, RC4, DES/3DES, RC2, SSLv2/v3, TLS 1.0). Observed from the network side, this is the result of reduced cipher strength or key space on a network device, as in T1600.001. It can also come from legacy peers, so treat hits as indicators of weakened crypto configuration."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1600.001"
    mitre_technique_name = "Weaken Encryption: Reduce Key Space"
    log_prerequisites = "Firewall or proxy perimeter logs that record negotiated TLS parameters (network.tls.cipher, network.tls.version), for example with TLS inspection or a TLS-aware flow logging profile. Without these fields the rule will not fire."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legacy servers, embedded or IoT devices and old partner or vendor endpoints that only support deprecated ciphers; authorised vulnerability scanners and TLS configuration audits; legacy VPN or appliance-to-appliance links not yet upgraded."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners. Add known-good legacy vendor destinations to %global_allowed_domains. Correlate hits with recent configuration changes on the source network device. Tighten the cipher or version regex if the client's legacy estate is noisy."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.network.tls.cipher = /(EXPORT|_NULL_|_anon_|_anon$|RC4|RC2|DES40|_DES_|3DES|_40_|_56_)/ nocase or
      $net.network.tls.version = /(SSL\s?v?[23]|TLS\s?v?1\.0|TLSv1$)/ nocase
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1600.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $negotiated_ciphers = array_distinct($net.network.tls.cipher)
    $negotiated_versions = array_distinct($net.network.tls.version)

  condition:
    $net
}
