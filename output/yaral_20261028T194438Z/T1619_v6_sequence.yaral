/*
  MITRE Technique : T1619 - Cloud Storage Object Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:43:43.659976+00:00
  Reference       : https://attack.mitre.org/techniques/T1619
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1619_Cloud_Storage_List_Then_Object_Retrieval {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A single identity enumerates cloud storage (bucket or object listing APIs) and then retrieves objects within 10 minutes. This is the discovery-then-collection pattern, where an adversary uses listing results to choose which objects to read."
    mitre_tactic = "Discovery"
    mitre_technique = "T1619"
    mitre_technique_name = "Cloud Storage Object Discovery"
    log_prerequisites = "Cloud control-plane and data-event audit logging must be enabled for object storage (object-level read and list events), normalised to USER_RESOURCE_ACCESS with metadata.product_event_type populated and principal.user.userid set."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Backup and data-sync jobs, ETL and analytics pipelines, CI/CD artifact fetchers, data engineers browsing buckets, storage migration tooling, and legitimate console or CLI use by administrators."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, approved cloud service principals to %global_allowed_cloud_principals, and named administrators to %global_allowed_admin_users. If noisy, add a count threshold on the retrieval side or restrict the list-event regex to bucket-level enumeration."

  events:
    $list.metadata.event_type = "USER_RESOURCE_ACCESS"
    $list.metadata.product_event_type = /^(ListBuckets|ListObjects|ListObjectsV2|ListObjectVersions|ListBlobs|ListContainers|storage\.buckets\.list|storage\.objects\.list)$/ nocase
    $list.principal.user.userid != ""
    not $list.principal.user.userid in %global_allowed_service_accounts
    not $list.principal.user.userid in %global_allowed_cloud_principals
    not $list.principal.user.userid in %global_allowed_admin_users
    $list.principal.user.userid = $user

    $get.metadata.event_type = "USER_RESOURCE_ACCESS"
    $get.metadata.product_event_type = /^(GetObject|GetObjectVersion|GetBlob|DownloadBlob|storage\.objects\.get)$/ nocase
    $get.principal.user.userid != ""
    not $get.principal.user.userid in %global_allowed_service_accounts
    not $get.principal.user.userid in %global_allowed_cloud_principals
    not $get.principal.user.userid in %global_allowed_admin_users
    $get.principal.user.userid = $user

    $list.metadata.event_timestamp.seconds <= $get.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1619")
    $primary_entity = array_distinct($list.principal.user.userid)
    $list_call_count = count($list.metadata.id)
    $get_call_count = count($get.metadata.id)
    $list_api_calls = array_distinct($list.metadata.product_event_type)
    $get_api_calls = array_distinct($get.metadata.product_event_type)
    $source_ips = array_distinct($list.principal.ip)
    $listed_resources = array_distinct($list.target.resource.name)
    $retrieved_resources = array_distinct($get.target.resource.name)

  condition:
    $list and $get
}
