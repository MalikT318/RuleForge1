/*
  MITRE Technique : T1564.008 - Email Hiding Rules
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:26:38.961764+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_008_Linux_ManageSieve_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux host opening an outbound connection to an external ManageSieve service (TCP/4190). ManageSieve is the protocol used to create and edit server-side mail filter rules (Sieve), which can move, mark-as-read or discard inbound mail. A non-allowlisted process pushing Sieve rules to an external mail server may indicate an adversary hiding inbound email in a compromised mailbox. This is a network-side detection and does not rely on process command lines."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.008"
    mitre_technique_name = "Hide Artifacts: Email Hiding Rules"
    log_prerequisites = "Requires Linux endpoint EDR or auditd network connection telemetry normalised to UDM NETWORK_CONNECTION with principal.hostname, target.ip, target.port and principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate mail clients or scripts (for example Thunderbird/Sieve extensions, Roundcube/managesieve plugins, user-run sieve sync tools) managing filters on a hosted mail provider; IT migration or mail-provisioning automation; mail administrators managing external mail servers."
    tuning_guidance = "Add approved mail clients and provisioning tooling to %global_allowed_admin_tools, and mail automation accounts to %global_allowed_service_accounts. Servers that legitimately host or relay to ManageSieve endpoints should be added to %global_allowed_mgmt_sources. Loopback destinations are already excluded by regex. Raise severity for hosts that are not mail clients or user workstations (e.g., servers)."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 4190
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not re.regex($net.target.ip, `^(127\.|::1$)`)
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.target.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1564.008")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $initiating_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
