/*
  MITRE Technique : T1021.004 - SSH
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:39:55.550441+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_004_Linux_Sshd_Config_Modified_By_NonAdmin_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects modification of the OpenSSH server configuration (/etc/ssh/sshd_config or an sshd_config.d drop-in) by a process that is not a package manager or an approved administrative tool. Adversaries who hold valid accounts alter sshd settings (enabling root login, password authentication, TCP forwarding or extra listeners) to enable or ease SSH-based lateral movement. The rule detects the resulting file state change rather than command lines, so it still fires when command-line logging is evaded."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.004"
    mitre_technique_name = "Remote Services: SSH"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file watches (-w /etc/ssh/ -p wa) normalised to UDM FILE_MODIFICATION with principal.process and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management and automation agents, golden-image or cloud-init provisioning, manual hardening by administrators, OS package upgrades that rewrite sshd_config, compliance remediation tooling."
    tuning_guidance = "Add approved configuration-management and hardening binaries to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts or %global_allowed_admin_users. Add approved provisioning hosts to %global_allowed_script_hosts. Extend the package-manager name regex if the client uses other package tooling."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/ssh\/(sshd_config|sshd_config\.d\/[^\/]+)$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|rpm|apt|apt-get|yum|dnf|zypper|snapd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1021.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
