/*
  MITRE Technique : T1074.001 - Local Data Staging
  Tactic(s)       : Collection
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:18:30.359832+00:00
  Reference       : https://attack.mitre.org/techniques/T1074/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_001_Linux_Server_Daemon_Spawns_Staging_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing or data-serving daemon (web server, application server, database, cache) spawning a shell whose command line copies, moves or archives data into a world-writable staging location (/tmp, /var/tmp, /dev/shm). Daemons rarely spawn interactive shells to stage data; this lineage typically indicates web shell or injected-command activity collecting data prior to exfiltration."
    mitre_tactic = "Collection"
    mitre_technique = "T1074.001"
    mitre_technique_name = "Data Staged: Local Data Staging"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records normalised to UDM PROCESS_LAUNCH with parent process path and full child command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Application health-check or maintenance scripts launched by the web or application server, CMS or plugin update routines, database-initiated export or backup jobs (e.g. cron-like hooks inside the DB service), deployment tooling that runs under the application server user, log rotation helpers writing temp archives."
    tuning_guidance = "Add legitimate parent daemons or wrapper hosts to %global_allowed_script_hosts, approved deployment and maintenance binaries to %global_allowed_admin_tools, and backup agents to %global_allowed_backup_processes. Extend the parent daemon regex with customer-specific application servers if needed. Review recurring hits by parent path and command line before allowlisting."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|php-cgi|tomcat[0-9]*|mysqld|mariadbd|postgres|mongod|redis-server)$/ nocase
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|csh|tcsh|ash)$/ nocase
    $proc.target.process.command_line = /\b(tar|zip|7z|7za|gzip|bzip2|xz|cp|mv|rsync|dd)\b/ nocase
    $proc.target.process.command_line = /(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1074.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $staging_command = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
