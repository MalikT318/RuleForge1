/*
  MITRE Technique : T1556.008 - Network Provider DLL
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:26:44.798562+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_008_Network_Provider_Registry_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Multiple registry writes to Windows network provider configuration (the NetworkProvider Order list or a service's NetworkProvider subkey) on a single host within ten minutes. Registering a malicious credential-manager DLL normally needs several writes: adding the provider to the Order list and setting the ProviderPath, Class and Name values under the service's NetworkProvider key. Detects the persistence and credential-capture result rather than any specific command line or tool."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.008"
    mitre_technique_name = "Modify Authentication Process: Network Provider DLL"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR registry-write events or Sysmon Event ID 13) that populates target.registry.registry_key and the principal process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Installers or upgrades of legitimate network providers or remote-access software (VPN clients, VDI/Citrix agents, OpenSSH, file-sync and cloud-drive clients, WebDAV redirector changes), OS feature enablement or servicing, and software deployment tooling."
    tuning_guidance = "Add approved installer and deployment binaries to %global_allowed_admin_tools. Raise the #reg threshold on hosts with frequent legitimate provider changes. Review the writer_processes and registry_keys outcome values and confirm that the referenced ProviderPath DLL is signed and located in System32."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(Control\\NetworkProvider\\Order|Services\\[^\\]+\\NetworkProvider)(\\|$)/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(80)
    $event_count = count($reg.metadata.id)
    $mitre_technique_id = array_distinct("T1556.008")
    $primary_entity = array_distinct($host)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_name)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $acting_users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 2
}
