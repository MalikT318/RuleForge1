/*
  MITRE Technique : T1574.006 - Dynamic Linker Hijacking
  Tactic(s)       : Stealth, Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:33:09.129970+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_006_Linux_LD_SO_Preload_File_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of /etc/ld.so.preload, the system-wide file that forces the Linux dynamic linker to load listed shared libraries into every dynamically linked process. Adversaries use this for stealthy persistence, userland rootkits and credential or network hooking. The rule keys on the file write itself rather than process command lines, so it covers editors, scripts, dropped binaries and in-memory tooling regardless of how the write was made."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.006"
    mitre_technique_name = "Hijack Execution Flow: Dynamic Linker Hijacking"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd with a write/attribute watch on /etc/ld.so.preload (for example auditctl -w /etc/ld.so.preload -p wa), normalised to UDM FILE_MODIFICATION with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate security or performance agents that preload an instrumentation or sandbox library, APM or memory-allocator tooling (for example profiling or allocator-replacement libraries) installed by the administrator, configuration management runs (Ansible, Puppet, Chef, Salt) that deploy a preload entry, and HPC or container-hardening tooling."
    tuning_guidance = "Add approved configuration-management, deployment and RMM binaries to %global_allowed_admin_tools and EDR or security agent binaries to %global_allowed_security_tools. Add automation accounts to %global_allowed_service_accounts. The file is normally absent or empty on most distributions, so any write by an unlisted process warrants review. Deploy a companion rule on FILE_CREATION for the same path, since the first write to a non-existent file may be normalised as a creation event by some sensors."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/ld\.so\.preload$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1574.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_command_line = array_distinct($file.principal.process.command_line)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
