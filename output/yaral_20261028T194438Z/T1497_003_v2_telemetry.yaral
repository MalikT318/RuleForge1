/*
  MITRE Technique : T1497.003 - Time Based Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:05:54.499212+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_003_Linux_Time_Config_Tampering {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects modification of Linux time-related configuration files (timezone, hardware clock adjustment, NTP/chrony/timesyncd configuration) by a process that is not a package manager, configuration-management agent, or approved admin tool. Malware and sandbox-evasion tooling may alter the system clock, timezone or time synchronisation to defeat time-based sandbox checks or to skew the timing of its own sleep/uptime comparisons. Detection is at the file-state-change layer, not the command line. This covers the time-manipulation facet of T1497.003 only; in-process timing calls such as clock_gettime and sleep sampling produce no file artifact."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1497.003"
    mitre_technique_name = "Virtualization/Sandbox Evasion: Time Based Checks"
    log_prerequisites = "Linux EDR file-modification telemetry or auditd file-watch rules (-w on /etc/localtime, /etc/adjtime, /etc/ntp.conf, /etc/chrony*, /etc/systemd/timesyncd.conf) normalised into UDM FILE_MODIFICATION with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package updates of tzdata or chrony/ntp packages, configuration-management agents (Ansible, Puppet, Chef, Salt) pushing NTP settings, cloud-init or provisioning scripts on first boot, administrators manually changing timezone or NTP servers, and image build pipelines."
    tuning_guidance = "Add approved provisioning and patching binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Extend the process-name exclusion regex for any client-specific configuration agent. Consider scoping to servers where time configuration is expected to be static."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/(localtime|timezone|adjtime|ntp\.conf|ntpsec\/ntp\.conf|chrony\.conf|chrony\/.*\.conf|systemd\/timesyncd\.conf|systemd\/timesyncd\.conf\.d\/.*)$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|yum|dnf|zypper|packagekitd|systemd-timedated|systemd-timesyncd|chronyd|cloud-init|ansible[^\/]*|puppet|chef-client|salt-minion)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1497.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_files = array_distinct($file.target.file.full_path)
    $actor_process = array_distinct($file.principal.process.file.full_path)
    $actor_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
