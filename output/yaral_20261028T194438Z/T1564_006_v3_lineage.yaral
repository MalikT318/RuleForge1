/*
  MITRE Technique : T1564.006 - Run Virtual Instance
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:22:53.571760+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_006_Linux_Unexpected_Parent_Spawns_Hypervisor {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a hypervisor or emulator process (QEMU, VirtualBox, VMware, libvirt tooling) launched by an unexpected parent on Linux. Unexpected parents are web servers, application servers, database services, or binaries running from world-writable staging directories (/tmp, /var/tmp, /dev/shm). Legitimate virtualization is started by init, systemd, libvirtd, or an admin shell. A web or database service, or a dropped binary, starting a VM is a strong sign of an adversary hiding activity inside a virtual instance after exploitation."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.006"
    mitre_technique_name = "Hide Artifacts: Run Virtual Instance"
    log_prerequisites = "Linux EDR or auditd (execve) process telemetry populating principal.process.file.full_path (parent) and target.process.file.full_path (child)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Dev/test or CI hosts where a build agent or web-based management panel (e.g. a self-hosted VM management UI running under a web server or Java app server) legitimately launches QEMU/VirtualBox; vendor appliances running a database service that also manages guest VMs; automation scripts staged in /tmp by approved provisioning tooling."
    tuning_guidance = "Add approved provisioning, CI, and VM-management parent binaries to %global_allowed_admin_tools. Add approved automation accounts to %global_allowed_service_accounts. For hosts where virtualization is a normal workload, scope the rule by exclusion rather than disabling it."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /(^\/(tmp|var\/tmp|dev\/shm)\/|\/(httpd|apache2|nginx|lighttpd|php-fpm[0-9.]*|tomcat[0-9]*|mysqld|mariadbd|postgres|mongod|redis-server)$)/ nocase
    $proc.target.process.file.full_path = /\/(qemu-system-[a-z0-9_]+|qemu-kvm|VBoxHeadless|VBoxManage|VBoxSDL|vmware-vmx|vmrun|virsh|virt-install|firecracker|cloud-hypervisor)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1564.006")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
