/*
  MITRE Technique : T1102.001 - Dead Drop Resolver
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:54:08.235140+00:00
  Reference       : https://attack.mitre.org/techniques/T1102/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1102_001_Linux_Staged_Process_Web_Lookup_Then_NonStandard_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Linux process running from a world-writable staging directory, or an interpreter, that connects to a named external host over HTTPS and then connects to a different external IP on a non-standard high port within ten minutes. This is the dead drop resolver pattern: the process reads a pointer from a legitimate web service, then contacts the C2 address it resolved. It uses network telemetry and process lineage joined by host and PID, so it does not depend on command-line content."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1102.001"
    mitre_technique_name = "Web Service: Dead Drop Resolver"
    log_prerequisites = "Requires Linux EDR or auditd-derived network connection telemetry normalised to UDM NETWORK_CONNECTION. Events must populate principal.hostname, principal.process.pid, principal.process.file.full_path, target.ip, target.port and, for the HTTPS lookup, target.hostname."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developer or data-science scripts run from /tmp that call a web API and then a custom-port service; self-updating agents unpacked in /tmp or /var/tmp; interpreter-based monitoring or automation that talks to a SaaS API and then a non-standard-port endpoint; CI build runners."
    tuning_guidance = "Add approved automation binaries to %global_allowed_admin_tools, approved script hosts to %global_allowed_script_hosts, and known-good SaaS or vendor domains to %global_allowed_domains. If interpreter noise is high, narrow the process path regex on $web to the staging directories only. Raise the $c2.target.port threshold to reduce noise from ephemeral-port traffic."

  events:
    $web.metadata.event_type = "NETWORK_CONNECTION"
    $web.target.port = 443
    $web.target.hostname != ""
    $web.principal.process.file.full_path = /(^\/(tmp|dev\/shm|var\/tmp)\/)|(\/(python[0-9.]*|perl|ruby|php|node)$)/ nocase
    not $web.target.ip in %rfc1918_internal
    not $web.target.hostname in %global_allowed_domains
    not $web.principal.process.file.full_path in %global_allowed_admin_tools
    not $web.principal.process.file.full_path in %global_allowed_script_hosts
    $web.principal.hostname = $hostname
    $web.principal.process.pid = $pid

    $c2.metadata.event_type = "NETWORK_CONNECTION"
    $c2.target.port > 1024
    $c2.target.port != 8080
    $c2.target.port != 8443
    not $c2.target.ip in %rfc1918_internal
    not $c2.principal.process.file.full_path in %global_allowed_admin_tools
    not $c2.principal.process.file.full_path in %global_allowed_script_hosts
    $c2.principal.hostname = $hostname
    $c2.principal.process.pid = $pid

    $web.target.ip != $c2.target.ip
    $web.metadata.event_timestamp.seconds <= $c2.metadata.event_timestamp.seconds

  match:
    $hostname, $pid over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1102.001")
    $primary_entity = array_distinct($web.principal.hostname)
    $process_path = array_distinct($web.principal.process.file.full_path)
    $lookup_domains = array_distinct($web.target.hostname)
    $lookup_ips = array_distinct($web.target.ip)
    $c2_ips = array_distinct($c2.target.ip)
    $c2_ports = array_distinct($c2.target.port)
    $c2_connection_count = count($c2.metadata.id)

  condition:
    $web and $c2
}
