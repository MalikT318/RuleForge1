/*
  MITRE Technique : T1686.001 - Cloud Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:28:40.244635+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_001_CloudFirewall_Create_Then_Open_Ingress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "The same cloud identity creates a new security group, firewall, or network ACL and then adds or modifies ingress or egress rules within 10 minutes. This is the typical pattern of an adversary building a permissive network path to reach cloud-hosted instances, for example to expose services or support cryptomining. It complements process and command-line rules by working at the cloud control plane."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.001"
    mitre_technique_name = "Cloud Firewall"
    log_prerequisites = "Requires cloud control-plane audit logs ingested and parsed into UDM. Firewall or security group creation must map to RESOURCE_CREATION. Rule authorization or update must map to SETTING_MODIFICATION. metadata.product_event_type and principal.user.userid must be populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Infrastructure-as-code pipelines and CI/CD roles that create a network boundary and its rules in one run; legitimate cloud engineers standing up new environments; autoscaling or managed-service automation that provisions security groups; migration projects."
    tuning_guidance = "Add automation and pipeline identities to %global_allowed_service_accounts. Add approved cloud automation principals to %global_allowed_cloud_principals. Add named network or platform administrators to %global_allowed_admin_users. If a client's parser maps rule changes to another event type, align the $fw_open event_type for that client."

  events:
    $fw_create.metadata.event_type = "RESOURCE_CREATION"
    $fw_create.metadata.product_event_type = /(CreateSecurityGroup|CreateNetworkAcl$|CreateFirewall|networkSecurityGroups\/write|compute\.firewalls\.insert)/ nocase
    $fw_create.principal.user.userid != ""
    $fw_create.principal.user.userid = $user
    not $fw_create.principal.user.userid in %global_allowed_service_accounts
    not $fw_create.principal.user.userid in %global_allowed_admin_users
    not $fw_create.principal.user.userid in %global_allowed_cloud_principals

    $fw_open.metadata.event_type = "SETTING_MODIFICATION"
    $fw_open.metadata.product_event_type = /(AuthorizeSecurityGroupIngress|AuthorizeSecurityGroupEgress|CreateNetworkAclEntry|ReplaceNetworkAclEntry|securityRules\/write|compute\.firewalls\.(patch|update))/ nocase
    $fw_open.principal.user.userid = $user

    $fw_create.metadata.event_timestamp.seconds <= $fw_open.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1686.001")
    $primary_entity = array_distinct($user)
    $create_actions = array_distinct($fw_create.metadata.product_event_type)
    $open_actions = array_distinct($fw_open.metadata.product_event_type)
    $created_resources = array_distinct($fw_create.target.resource.name)
    $modified_resources = array_distinct($fw_open.target.resource.name)
    $source_ips = array_distinct($fw_open.principal.ip)
    $first_seen = min($fw_create.metadata.event_timestamp.seconds)
    $last_seen = max($fw_open.metadata.event_timestamp.seconds)

  condition:
    $fw_create and $fw_open
}
