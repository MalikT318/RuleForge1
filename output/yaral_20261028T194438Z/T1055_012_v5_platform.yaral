/*
  MITRE Technique : T1055.012 - Process Hollowing
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:00:15.631894+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_012_Process_Hollowing_Injection_Into_Host_Binary {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process-injection event in which a process running from a user-writable location injects into a different process that is a commonly hollowed Windows host binary. This uses injection and memory-manipulation telemetry rather than process-creation command lines, so it complements command-line rules for process hollowing. The Windows requirement takes precedence over the alternate-platform angle, so coverage is added by pivoting on the event type."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.012"
    mitre_technique_name = "Process Injection: Process Hollowing"
    log_prerequisites = "Requires endpoint telemetry that emits process-injection or remote-memory-write events, such as Sysmon CreateRemoteThread or ProcessAccess, or EDR injection sensors, normalised to PROCESS_INJECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers or updaters running from temp or ProgramData, game anti-cheat and overlay software, application-compatibility shims, developer debuggers and profilers, and unlisted EDR, DLP or backup agents."
    tuning_guidance = "Add legitimate injecting parent binaries to %global_allowed_security_tools, %global_allowed_admin_tools or %global_allowed_backup_processes. Extend the allowlist by executable name, not install path. Adjust the target host-binary list or the user-writable path regex per customer after reviewing a 14-day baseline."

  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.process.file.full_path = /(\\users\\[^\\]+\\(appdata|downloads|desktop|documents)\\|\\programdata\\|\\windows\\temp\\|\\temp\\|\\users\\public\\)/ nocase
    $inj.target.process.file.full_path = /\\(svchost|rundll32|regsvr32|dllhost|explorer|notepad|werfault|searchprotocolhost|msiexec|taskhost|taskhostw|conhost|wmiprvse|spoolsv|runtimebroker)\.exe$/ nocase
    $inj.principal.process.file.full_path != $inj.target.process.file.full_path
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.012")
    $primary_entity = array_distinct($inj.principal.hostname)
    $injecting_process = array_distinct($inj.principal.process.file.full_path)
    $injected_process = array_distinct($inj.target.process.file.full_path)
    $acting_user = array_distinct($inj.principal.user.userid)

  condition:
    $inj
}
