/*
  MITRE Technique : T1606.002 - SAML Tokens
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:25:14.599408+00:00
  Reference       : https://attack.mitre.org/techniques/T1606/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1606_002_Federation_Trust_Or_Signing_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects a tenant configuration change to domain federation or authentication settings, or to token-signing certificate configuration. Attackers who can add a federation trust or swap the token-signing certificate can then forge SAML tokens that the tenant trusts. The rule detects the resulting setting change in the audit log, not any tool or command line."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1606.002"
    mitre_technique_name = "Forge Web Credentials: SAML Tokens"
    log_prerequisites = "Requires m365 unified audit logs with directory and domain administration events ingested and normalised to SETTING_MODIFICATION, with metadata.product_event_type populated with the audit operation name."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Planned federation onboarding or migration, domain additions or conversions between managed and federated, scheduled token-signing certificate rollover, and identity-provider automation performing certificate auto-rollover."
    tuning_guidance = "Add named administrators who own federation changes to %global_allowed_admin_users and automation or sync accounts to %global_allowed_service_accounts. Correlate hits with an approved change ticket. Any hit outside a change window should be treated as a possible forged-token precursor."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(federation\s+settings|domain\s+authentication|token.?signing|federat(ed|ion)\s+(trust|domain|configuration))/ nocase
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1606.002")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $operations = array_distinct($setting.metadata.product_event_type)
    $changed_resources = array_distinct($setting.target.resource.name)
    $source_ips = array_distinct($setting.principal.ip)

  condition:
    $setting
}
