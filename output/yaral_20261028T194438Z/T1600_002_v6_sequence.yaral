/*
  MITRE Technique : T1600.002 - Disable Crypto Hardware
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:09:55.262431+00:00
  Reference       : https://attack.mitre.org/techniques/T1600/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_002_Mgmt_Access_Then_Crypto_Hardware_Disabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A network device receives a management-plane connection (SSH, Telnet, HTTPS or NETCONF) from a source outside the approved management sources. Within ten minutes the same device logs a configuration change that disables or bypasses dedicated hardware cryptography, forcing software encryption. This is the behaviour associated with disabling crypto hardware."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1600.002"
    mitre_technique_name = "Weaken Encryption: Disable Crypto Hardware"
    log_prerequisites = "Requires perimeter firewall or network device connection logs (NETWORK_CONNECTION) for management-plane sessions, and device configuration-change syslog (SETTING_MODIFICATION) with the change text parsed into security_result.description. The device hostname must be populated consistently as target.hostname in connection logs and principal.hostname in configuration logs."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised engineers working from an unlisted jump host or VPN pool during planned crypto module maintenance, hardware replacement or troubleshooting, and firmware or licence upgrades that toggle crypto acceleration. Automation and orchestration platforms that push configuration from an unlisted source."
    tuning_guidance = "Add jump hosts, bastions and network-management servers to %global_allowed_mgmt_sources. Add named engineers to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Extend the management port list if the estate uses non-standard management ports. Extend the configuration-text regex if the estate logs crypto changes with different wording."

  events:
    $mgmt.metadata.event_type = "NETWORK_CONNECTION"
    (
      $mgmt.target.port = 22 or
      $mgmt.target.port = 23 or
      $mgmt.target.port = 443 or
      $mgmt.target.port = 830
    )
    $mgmt.target.hostname != ""
    not $mgmt.principal.ip in %global_allowed_mgmt_sources
    $mgmt.target.hostname = $device

    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.security_result.description = /((no|disable[d]?|bypass(ed)?)\s+.{0,30}(crypto|encryption)\s+(engine|accelerator|hardware|module|offload)|(crypto|encryption)\s+(engine|accelerator|hardware|module|offload).{0,40}(disable[d]?|off|bypass(ed)?|shutdown)|(disable[d]?|no)\s+.{0,20}(hardware|hw)\s*[-_ ]?(crypto|encryption|accel))/ nocase
    not $cfg.principal.user.userid in %global_allowed_admin_users
    not $cfg.principal.user.userid in %global_allowed_service_accounts
    $cfg.principal.hostname = $device

    $mgmt.metadata.event_timestamp.seconds <= $cfg.metadata.event_timestamp.seconds

  match:
    $device over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1600.002")
    $primary_entity = array_distinct($device)
    $mgmt_source_ips = array_distinct($mgmt.principal.ip)
    $mgmt_ports = array_distinct($mgmt.target.port)
    $changing_users = array_distinct($cfg.principal.user.userid)
    $config_messages = array_distinct($cfg.security_result.description)
    $mgmt_session_count = count($mgmt.metadata.id)

  condition:
    $mgmt and $cfg
}
