/*
  MITRE Technique : T1202 - Indirect Command Execution
  Tactic(s)       : Stealth
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:54:01.360599+00:00
  Reference       : https://attack.mitre.org/techniques/T1202
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1202_Indirect_Exec_Utility_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects built-in indirect command execution utilities (Program Compatibility Assistant, forfiles, ScriptRunner) initiating a network connection to an external address. These binaries exist to launch other programs and have no normal need for outbound connectivity, so a connection suggests abuse for proxy execution or payload retrieval."
    mitre_tactic = "Stealth, Defense Evasion"
    mitre_technique = "T1202"
    mitre_technique_name = "Indirect Command Execution"
    log_prerequisites = "Requires Windows endpoint network telemetry that records the originating process (EDR network events or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION, with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare. Possible sources are legacy application compatibility shims that call out to licensing or update servers, administrator scripts that use forfiles to run network-aware tooling, and EDR or sandbox products that proxy connections on behalf of the process."
    tuning_guidance = "Add approved administrative tooling to %global_allowed_admin_tools. Add known-good external destinations to %global_allowed_domains. Extend %rfc1918_internal if the tenant uses additional private or CGNAT ranges. Coverage depends on the host process name; attackers can copy these utilities under another name, so pair this rule with the process-lineage variants of T1202."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(pcalua|forfiles|scriptrunner)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1202")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_user = array_distinct($net.principal.user.userid)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $initiating_command_line = array_distinct($net.principal.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
