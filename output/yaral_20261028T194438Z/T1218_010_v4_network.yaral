/*
  MITRE Technique : T1218.010 - Regsvr32
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:55:07.504041+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_010_Regsvr32_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects regsvr32.exe itself initiating a network connection to an external address. Legitimate DLL registration is a local operation, so outbound traffic from this binary is characteristic of Squiblydoo-style remote scriptlet (SCT) or DLL retrieval and execution. This is a network-side detection that does not depend on process command-line matching."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.010"
    mitre_technique_name = "System Binary Proxy Execution: Regsvr32"
    log_prerequisites = "Requires endpoint network telemetry that attributes outbound connections to the originating process (EDR network events or Sysmon Event ID 3), normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Regsvr32 registering a DLL or OCX from an external or UNC path that resolves outside internal ranges, software installers or updaters that call regsvr32 and fetch components, CRL/OCSP certificate validation traffic triggered by signature checks on the loaded module, and proxy or VPN egress addresses that fall outside internal ranges."
    tuning_guidance = "Add known-good vendor or update destinations to %global_allowed_domains. Add approved service or deployment accounts to %global_allowed_admin_users. Make sure %rfc1918_internal covers client-specific internal and proxy address space."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\regsvr32\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.010")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $destination_hosts = array_distinct($net.target.hostname)
    $users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
