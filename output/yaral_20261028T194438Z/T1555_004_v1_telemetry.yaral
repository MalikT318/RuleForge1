/*
  MITRE Technique : T1555.004 - Windows Credential Manager
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:57:18.405614+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_004_Credential_Vault_File_Staged_Outside_Vault {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of Windows Credential Locker artifacts (.vcrd credential files or Policy.vpol key files) outside the legitimate Microsoft Vault directories. This indicates that vault contents were copied or staged for offline decryption. The rule works at the file-artifact layer, so it fires regardless of the tool or command line used to copy the files."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.004"
    mitre_technique_name = "Credentials from Password Stores: Windows Credential Manager"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with target.file.full_path populated, covering user profile and temp directories."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and imaging software copying user profiles, profile migration tools (USMT, roaming profile or user-state migration), forensic or IR collection by authorised responders, endpoint security agents quarantining or snapshotting files."
    tuning_guidance = "Add backup and imaging binaries to %global_allowed_backup_processes, EDR and AV agents to %global_allowed_security_tools, and migration or automation accounts to %global_allowed_service_accounts. If a client uses profile migration tooling, add the executable to %global_allowed_admin_tools."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(\.vcrd|\\policy\.vpol)$/ nocase
    not $file.target.file.full_path = /\\Microsoft\\(Vault|Credentials)\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1555.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $staged_file_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
