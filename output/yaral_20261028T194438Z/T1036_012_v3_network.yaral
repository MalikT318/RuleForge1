/*
  MITRE Technique : T1036.012 - Browser Fingerprint
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:16:40.462974+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_012_Browser_UA_To_Bare_IP_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP request carrying a browser-style User-Agent (Mozilla/4.0 or 5.0) sent to an external destination addressed by a bare IPv4 literal instead of a domain name. Real browsers are almost always pointed at named sites. Implants and scripts commonly spoof a browser User-Agent to blend into proxy traffic while talking to raw-IP C2 or staging hosts. This is a network-side observation of browser fingerprint spoofing and does not rely on process or command-line telemetry."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.012"
    mitre_technique_name = "Masquerading: Browser Fingerprint"
    log_prerequisites = "Requires proxy or perimeter firewall logs with HTTP inspection that populate network.http.user_agent and target.hostname (or the Host header) for outbound web traffic. TLS-intercepted or plain HTTP traffic is needed, because the User-Agent is not visible in uninspected TLS."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Package mirrors, internal-style appliances or cloud metadata and health-check endpoints addressed by public IP; CDN or vendor update services addressed by IP; vulnerability scanners and monitoring probes using browser User-Agents; developers testing web services on external IP-addressed hosts; proxy logs that record the destination IP in the hostname field for all CONNECT requests."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains and scanner or monitoring sources to %global_allowed_scanners. If the proxy writes the destination IP into target.hostname for every request, scope the rule to Linux server egress subnets or add the affected sources to %global_allowed_scanners. Raise severity for server-class hosts that have no interactive browser use."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /^Mozilla\/[45]\.0/ nocase
    $net.target.hostname = /^\d{1,3}(\.\d{1,3}){3}$/
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1036.012")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
