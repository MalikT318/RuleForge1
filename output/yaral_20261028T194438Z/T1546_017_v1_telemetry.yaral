/*
  MITRE Technique : T1546.017 - Udev Rules
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:23:48.778603+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/017
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_017_Udev_Rule_File_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a udev rule file (*.rules) in any of the system udev rule directories by a process other than a package manager or an approved admin tool. Adversaries drop rules containing RUN+= action keys to execute payloads when a device event fires, giving persistence and root-level execution. This rule detects the resulting file artifact, so it still fires when command-line logging is evaded."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1546.017"
    mitre_technique_name = "Event Triggered Execution: Udev Rules"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules on the udev rule directories (/etc/udev/rules.d, /run/udev/rules.d, /usr/lib/udev/rules.d, /usr/local/lib/udev/rules.d, /lib/udev/rules.d), with the writing process populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package installs and upgrades that ship udev rules (drivers, hardware vendor utilities, container runtimes, virtualization guest tools), configuration management agents (Ansible, Puppet, Chef, Salt), image build pipelines, and administrators adding custom device rules for storage, USB or GPU hardware."
    tuning_guidance = "Add approved configuration-management and deployment binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Extend the package-manager process regex if the client uses other installers. Pair with a FILE_MODIFICATION variant for in-place edits of existing rule files. Triage by reviewing the file content for RUN+= and shell, interpreter or /tmp, /dev/shm, /var/tmp references."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(etc|run|usr\/lib|usr\/local\/lib|lib)\/udev\/rules\.d\/[^\/]+\.rules$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|rpm|apt|apt-get|aptitude|yum|dnf|zypper|pacman|snapd|packagekitd|unattended-upgrade|systemd-udevd|udevadm)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546.017")
    $primary_entity = array_distinct($file.principal.hostname)
    $rule_file_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
