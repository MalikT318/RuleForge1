/*
  MITRE Technique : T1669 - Wi-Fi Networks
  Tactic(s)       : Initial Access
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:12:44.135472+00:00
  Reference       : https://attack.mitre.org/techniques/T1669
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1669_Wireless_Client_Outbound_Windows_Service_Exposure {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "IPS-observed outbound connection from an internal client to an external address on Windows-native service ports (SMB, NetBIOS, RPC, RDP, WinRM). Windows clients should never reach these services across the internet. On a rogue, evil-twin or open Wi-Fi network, this is a network-side sign of a compromised or redirected wireless client (T1669). Typical causes are an adversary-in-the-middle position, NTLM or SMB relay and credential capture, or a Windows device bridged onto an attacker-controlled wireless segment."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1669"
    mitre_technique_name = "Wi-Fi Networks"
    log_prerequisites = "IPS or network security appliance logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. The sensor must see egress traffic from client and wireless segments. Complements Windows endpoint telemetry, which is assumed to be present."
    platform = "Windows"
    log_source = "ips"
    false_positives = "Misconfigured VPN or split-tunnel clients, cloud file shares reached over SMB over QUIC or WebDAV, approved remote support or RMM sessions over RDP or WinRM, external vulnerability scanners and penetration tests, and branch or lab hosts that deliberately expose RDP or WinRM through NAT."
    tuning_guidance = "Add authorised scanner source IPs to %global_allowed_scanners. Add approved external management or jump destinations to %global_allowed_mgmt_sources. Keep %rfc1918_internal current so internal traffic is excluded. Narrow or widen the port list to match the client environment. Run for 7 days in alert-only mode and review the top talkers."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 445 or
      $net.target.port = 139 or
      $net.target.port = 135 or
      $net.target.port = 3389 or
      $net.target.port = 5985 or
      $net.target.port = 5986
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1669")
    $primary_entity = array_distinct($net.principal.ip)
    $source_hostname = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
