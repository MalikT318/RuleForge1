/*
  MITRE Technique : T1036.001 - Invalid Code Signature
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:57:04.007842+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_001_Signed_Binary_Lookalike_Dropped_Then_Executed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A process writes an executable into a user-writable or staging directory using the filename of a well-known signed OS or vendor binary, and that same file is executed within 10 minutes. Copying the name and metadata of a signed program onto an unsigned binary is how invalid-signature mimicry is staged. Legitimate copies of these binaries live in system or vendor install locations, so a lookalike that is dropped and then run from a temp, download, desktop, public or ProgramData path is high-signal. The rule matches on the file-creation to execution sequence, not on command lines."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.001"
    mitre_technique_name = "Masquerading: Invalid Code Signature"
    log_prerequisites = "Requires endpoint telemetry with FILE_CREATION events carrying full file paths and the writing process, plus PROCESS_LAUNCH events with the launched image path. Both must populate principal.hostname."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Vendor installers or updaters that extract a binary with a standard name to a temp folder and run it (browser, collaboration and updater stubs), software packaging or build pipelines that stage binaries, and administrators testing or copying system tools to a working folder."
    tuning_guidance = "Add approved deployment, packaging and RMM tooling to %global_allowed_admin_tools. Add EDR and AV agents to %global_allowed_security_tools. Add approved script or installer parents to %global_allowed_script_hosts. If a specific vendor updater is noisy, remove its name from the filename alternation or add its writer process to the allowlists. Extend the filename list with the signed binaries most often impersonated in your clients' environments."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata\\local\\temp|downloads|desktop)|programdata|users\\public|windows\\temp)\\([^\\]+\\)*(svchost|taskhostw|conhost|runtimebroker|searchindexer|dllhost|sihost|ctfmon|spoolsv|wuauclt|msedge|microsoftedgeupdate|onedrive|teams|googleupdate|acrord32|adobearm|zoom|msmpeng|officeclicktorun)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path = /\\(msiexec|trustedinstaller|tiworker|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $path

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(users\\[^\\]+\\(appdata\\local\\temp|downloads|desktop)|programdata|users\\public|windows\\temp)\\([^\\]+\\)*[^\\]+\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    $proc.principal.hostname = $hostname
    $proc.target.process.file.full_path = $path

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1036.001")
    $primary_entity = array_distinct($hostname)
    $dropped_file_path = array_distinct($path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $launching_parents = array_distinct($proc.principal.process.file.full_path)
    $affected_users = array_distinct($proc.principal.user.userid)
    $first_drop_time = min($file.metadata.event_timestamp.seconds)
    $first_exec_time = min($proc.metadata.event_timestamp.seconds)

  condition:
    $file and $proc
}
