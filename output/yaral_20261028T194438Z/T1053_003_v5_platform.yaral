/*
  MITRE Technique : T1053.003 - Cron
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:15:07.361774+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_003_Linux_Cron_File_Created_By_Non_Package_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a file in a Linux cron location (/etc/crontab, /etc/cron.d, /etc/cron.hourly|daily|weekly|monthly|yearly, /var/spool/cron and /var/spool/cron/crontabs) by a process that is not a package manager or an approved admin tool. This file-based detection covers persistence and execution via cron even when the job is planted by a script, an editor, or a direct write, with no crontab command line to match. It also covers ESXi-style direct crontab edits under /var/spool/cron/crontabs."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.003"
    mitre_technique_name = "Scheduled Task/Job: Cron"
    log_prerequisites = "Linux endpoint file-creation telemetry from EDR or auditd (watch rules on /etc/cron*, /etc/crontab and /var/spool/cron) normalised to UDM FILE_CREATION with principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management (Ansible, Puppet, Chef, Salt) deploying cron jobs; package installs and upgrades that ship cron.d entries; administrators editing crontabs by hand; backup, monitoring and log-rotation agents registering their own jobs during install."
    tuning_guidance = "Add configuration-management and deployment binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Extend the package-manager regex if the estate uses other installers. Raise severity for writers running from /tmp, /dev/shm or /var/tmp, or for interactive shells under non-admin users."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(etc\/(crontab$|cron\.(d|hourly|daily|weekly|monthly|yearly)\/)|var\/spool\/cron\/)/ nocase
    not $file.target.file.full_path = /(\.swp|\.swx|\.placeholder|~)$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|rpm|apt|apt-get|yum|dnf|zypper|unattended-upgrade|packagekitd|snapd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1053.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $cron_file_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
