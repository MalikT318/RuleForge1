/*
  MITRE Technique : T1087.002 - Domain Account
  Tactic(s)       : Discovery
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:55:15.638281+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_002_Bulk_LDAP_Directory_Dump_Firewall {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a single network flow to LDAP, LDAPS or Global Catalog ports in which the directory server returned an unusually large volume of data. This is consistent with bulk enumeration of Active Directory domain accounts and groups (for example ldapsearch-style dumps or collection tooling) and is observed from the perimeter or internal segmentation firewall, so it is independent of process command-line telemetry."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.002"
    mitre_technique_name = "Account Discovery: Domain Account"
    log_prerequisites = "Requires firewall or segmentation-gateway flow logs normalised to NETWORK_FLOW with target.port and network.received_bytes populated (session-end or periodic flow records), with visibility of client-to-domain-controller traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Directory synchronisation (identity sync connectors), IAM/PAM and SSO platforms, vulnerability and asset-inventory scanners, mail or collaboration servers refreshing address lists, legitimate admin AD reporting, and large initial profile or logon bursts from VDI pools."
    tuning_guidance = "Add scanner and identity-sync source addresses or hostnames to %global_allowed_scanners. Raise or lower the network.received_bytes threshold (5000000) to suit the client's directory size; larger directories may need a higher value. Review the destination in $dc_ips to confirm it is a domain controller."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    ($net.target.port = 389 or $net.target.port = 636 or $net.target.port = 3268 or $net.target.port = 3269)
    $net.network.received_bytes > 5000000
    not $net.principal.hostname in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1087.002")
    $primary_entity = array_distinct($net.principal.ip)
    $dc_ips = array_distinct($net.target.ip)
    $ldap_ports = array_distinct($net.target.port)
    $max_received_bytes = max($net.network.received_bytes)

  condition:
    $net
}
