/*
  MITRE Technique : T1125 - Video Capture
  Tactic(s)       : Collection
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:33:59.516608+00:00
  Reference       : https://attack.mitre.org/techniques/T1125
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1125_Linux_Outbound_Video_Stream_Protocol_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host opening an outbound connection to an external destination on a video-streaming protocol port (RTSP 554/8554 or RTMP 1935/1936). A Linux host that has been co-opted to stream camera or video capture off-network (T1125) produces this perimeter pattern. Linux hosts are not distinguishable in perimeter telemetry, so the rule is scoped to Linux estates by deployment: apply it to Linux server and workstation address groups. It has no process visibility and is a network-side indicator only, so pair it with Linux EDR or auditd rules for /dev/video* access."
    mitre_tactic = "Collection"
    mitre_technique = "T1125"
    mitre_technique_name = "Video Capture"
    log_prerequisites = "Firewall, proxy or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Internal-to-external traffic must be visible, ideally with pre-NAT source addresses."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate IP camera or CCTV cloud relays, live-streaming and broadcast workstations, video conferencing or media servers that publish via RTMP or RTSP, and approved remote monitoring appliances."
    tuning_guidance = "Add approved media, camera and broadcast source addresses to %global_allowed_mgmt_sources. Add sanctioned streaming vendor domains to %global_allowed_domains. Scope the rule to Linux host address groups per client. Raise severity for hosts with no history of streaming traffic. Pair with Linux auditd or EDR detections for /dev/video* access to confirm capture on the host."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 554 or
      $net.target.port = 8554 or
      $net.target.port = 1935 or
      $net.target.port = 1936
    )
    $net.principal.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1125")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
