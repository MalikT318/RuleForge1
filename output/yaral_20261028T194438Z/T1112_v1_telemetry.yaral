/*
  MITRE Technique : T1112 - Modify Registry
  Tactic(s)       : Defense Impairment, Persistence
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:12:10.096463+00:00
  Reference       : https://attack.mitre.org/techniques/T1112
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1112_Registry_Security_Control_Tamper {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry state changes that disable or weaken host security controls: Microsoft Defender real-time, behaviour, and tamper protection settings, and the WDigest UseLogonCredential setting that forces plaintext credentials into memory. Detection is based on the resulting registry modification, not the command line, so it still fires when the change is made through reg.exe, PowerShell, WMI, a remote registry call, or a direct API call."
    mitre_tactic = "Defense Impairment, Persistence"
    mitre_technique = "T1112"
    mitre_technique_name = "Modify Registry"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (value-set events) that populates the target registry key, value name, and modifying process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Enterprise endpoint management or GPO-driven Defender policy changes, third-party AV installers that deliberately turn off Defender during installation or removal, security product upgrades, and administrators hardening or troubleshooting hosts."
    tuning_guidance = "Add approved management and deployment binaries to %global_allowed_admin_tools and authorised security agents to %global_allowed_security_tools. Review the registry_value_data in the outcome: a disable value of 1 on Defender keys, or UseLogonCredential set to 1, is the highest-risk pattern. Where registry_value_data is reliably populated, add a data condition to cut noise further."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      (
        $reg.target.registry.registry_key = /\\(Policies\\Microsoft\\)?Windows Defender(\\|$)/ nocase and
        $reg.target.registry.registry_value_name = /^(DisableAntiSpyware|DisableAntiVirus|DisableRealtimeMonitoring|DisableBehaviorMonitoring|DisableOnAccessProtection|DisableIOAVProtection|DisableScriptScanning|DisableBlockAtFirstSeen|TamperProtection)$/ nocase
      ) or
      (
        $reg.target.registry.registry_key = /\\Control\\SecurityProviders\\WDigest$/ nocase and
        $reg.target.registry.registry_value_name = /^UseLogonCredential$/ nocase
      )
    )
    not $reg.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|MpCmdRun|SecurityHealthService|TrustedInstaller|TiWorker)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1112")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $modified_value_name = array_distinct($reg.target.registry.registry_value_name)
    $modified_value_data = array_distinct($reg.target.registry.registry_value_data)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
