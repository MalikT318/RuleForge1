/*
  MITRE Technique : T1195 - Supply Chain Compromise
  Tactic(s)       : Initial Access
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:38:43.943316+00:00
  Reference       : https://attack.mitre.org/techniques/T1195
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_SaaS_Software_Delivery_Artifact_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a SaaS audit event where a build pipeline, release, package, registry artifact or dependency manifest is published or modified by an account that is not an approved service account or administrator. Unauthorised changes to software delivery resources are a common supply chain compromise path (T1195)."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195"
    mitre_technique_name = "Supply Chain Compromise"
    log_prerequisites = "Requires SaaS application audit logs (source code hosting, CI/CD, package registry or software distribution platform) normalised to USER_RESOURCE_UPDATE_CONTENT with principal.user.userid, target.resource.name and metadata.product_event_type populated. NOTE: the requested log_source tag macos_endpoint does not produce SaaS audit events, so ingest the SaaS audit feed for this rule to evaluate."
    platform = "SaaS"
    log_source = "macos_endpoint"
    false_positives = "Developers or release managers legitimately publishing releases, CI service accounts not yet allowlisted, scheduled dependency-update bots, and bulk migrations of repositories or packages."
    tuning_guidance = "Add CI/CD and release automation identities to %global_allowed_service_accounts, release engineers to %global_allowed_admin_users, and approved cloud or identity principals to %global_allowed_cloud_principals. Narrow the target.resource.name keywords to the client's naming conventions if volume is high."

  events:
    $saas.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"
    $saas.target.resource.name = /(release|package|artifact|registry|pipeline|workflow|build|dependency|manifest|lockfile)/ nocase
    $saas.metadata.product_event_type = /(publish|upload|push|update|modify|edit|overwrite|replace)/ nocase
    $saas.principal.user.userid != ""
    not $saas.principal.user.userid in %global_allowed_service_accounts
    not $saas.principal.user.userid in %global_allowed_admin_users
    not $saas.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1195")
    $primary_entity = array_distinct($saas.principal.user.userid)
    $modified_resources = array_distinct($saas.target.resource.name)
    $actions = array_distinct($saas.metadata.product_event_type)
    $source_ips = array_distinct($saas.principal.ip)

  condition:
    $saas
}
