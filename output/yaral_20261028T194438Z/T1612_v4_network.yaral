/*
  MITRE Technique : T1612 - Build Image on Host
  Tactic(s)       : Stealth
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:33:42.728302+00:00
  Reference       : https://attack.mitre.org/techniques/T1612
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1612_External_Docker_API_Image_Build_Request {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an HTTP POST to the container engine remote API build endpoint (/build or /vX.YY/build) from a non-internal source address. A remote build request lets an adversary build a custom image on the host from a vanilla base image, bypassing registry-based image monitoring."
    mitre_tactic = "Stealth"
    mitre_technique = "T1612"
    mitre_technique_name = "Build Image on Host"
    log_prerequisites = "Requires NETWORK_HTTP telemetry that includes the request method and URL path for traffic to the container engine API. Sources can be a TLS-terminating proxy, a network sensor decoding the exposed API, or API gateway logs in front of the container host."
    platform = "Containers"
    log_source = "container"
    false_positives = "Remote CI/CD runners or build farms outside the internal address space that legitimately build images through the engine API. Developer workstations on VPN pools not covered by the internal address list. Authorised security testing of exposed container APIs."
    tuning_guidance = "Add approved CI/CD runner and build-server source addresses to %global_allowed_mgmt_sources. Add scanner addresses to %global_allowed_mgmt_sources as well. Confirm %rfc1918_internal covers all VPN and internal address pools for the client. A hit should be treated as high priority because the container engine API should not be reachable from external sources."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.url = /^(https?:\/\/[^\/]+)?\/(v[0-9]+(\.[0-9]+)?\/)?build(\?.*)?$/ nocase
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1612")
    $primary_entity = array_distinct($net.target.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $target_ips = array_distinct($net.target.ip)
    $request_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
