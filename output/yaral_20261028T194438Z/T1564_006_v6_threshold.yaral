/*
  MITRE Technique : T1564.006 - Run Virtual Instance
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:23:45.483396+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_006_Linux_VM_Artifacts_Staged_In_User_Writable_Paths {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several virtual machine disk or configuration files (qcow2, vmdk, vdi, vhd/vhdx, ova/ovf, vmx, vbox) are created in user-writable or volatile Linux locations (/tmp, /var/tmp, /dev/shm, /root, /home, /run/user) on one host within 10 minutes. Staging VM images outside managed hypervisor storage is consistent with an adversary preparing to run a hidden virtual instance (for example QEMU or VirtualBox) to evade host-based security tooling. One file is often benign. A burst of them is not."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.006"
    mitre_technique_name = "Hide Artifacts: Run Virtual Instance"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry normalised to UDM FILE_CREATION with target.file.full_path and principal.hostname populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers and QA staff building or converting VM images, CI/CD build agents (Packer, Vagrant, image builders), cloud-image download or conversion scripts, malware analysis labs, backup or restore tooling extracting VM exports, and training workstations."
    tuning_guidance = "Add approved image-building tooling to %global_allowed_admin_tools, approved backup tooling to %global_allowed_backup_processes, and build or automation accounts to %global_allowed_service_accounts. Raise the #file threshold on developer or lab hosts. Managed hypervisor storage such as /var/lib/libvirt/images is deliberately out of scope."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|root|home\/[^\/]+|run\/user\/[0-9]+)\/.*\.(qcow2?|vmdk|vdi|vhdx?|ova|ovf|vmx|vbox)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($file.target.file.full_path = /(?i)\.(vmdk|vdi|vhdx?|qcow2?)$/, 65, 50))
    $mitre_technique_id = array_distinct("T1564.006")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $distinct_files = count_distinct($file.target.file.full_path)
    $users = array_distinct($file.principal.user.userid)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $sample_paths = array_distinct($file.target.file.full_path)

  condition:
    #file >= 3
}
