/*
  MITRE Technique : T1047 - Windows Management Instrumentation
  Tactic(s)       : Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:31:27.883644+00:00
  Reference       : https://attack.mitre.org/techniques/T1047
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1047_WMI_MOF_File_Dropped_In_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a WMI Managed Object Format (.mof) file in a user-writable or staging directory. Adversaries drop MOF files and compile them (mofcomp or the WMI service) to register permanent event subscriptions, which gives WMI-based execution and persistence. WMI is a Windows-only technology, so this rule keeps Windows as the platform instead of pivoting to Linux, macOS or cloud. It adds coverage on the FILE_CREATION artefact rather than process command lines."
    mitre_tactic = "Execution"
    mitre_technique = "T1047"
    mitre_technique_name = "Windows Management Instrumentation"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent) with the target file path and the creating process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and vendor agents (database engines, hardware management suites, monitoring agents) that stage MOF files in temp or ProgramData during install or upgrade. Developers and admins authoring WMI providers or MOF files. Patch and deployment tooling that unpacks MOF files to temp directories."
    tuning_guidance = "Add approved installer, deployment and RMM binaries to %global_allowed_admin_tools. Add EDR and AV agents to %global_allowed_security_tools. Add known service accounts that stage MOFs to %global_allowed_service_accounts. If a vendor repeatedly stages MOFs in a specific directory, restrict the path regex per client rather than removing the rule."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(temp|appdata|programdata|users\\public|perflogs|downloads|\$recycle\.bin)\\.*\.mof$/ nocase
    not $file.principal.process.file.full_path = /\\(msiexec|TrustedInstaller|TiWorker|wmiprvse|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1047")
    $primary_entity = array_distinct($file.principal.hostname)
    $mof_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
