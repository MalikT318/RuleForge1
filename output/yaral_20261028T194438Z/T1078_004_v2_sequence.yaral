/*
  MITRE Technique : T1078.004 - Cloud Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:34:11.693898+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_004_Cloud_Account_External_Login_Then_Privilege_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A cloud account signs in from a non-internal source address and then performs a permission or role change within one hour. This pattern is typical of a compromised valid cloud account being used to escalate privileges or establish persistence."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.004"
    mitre_technique_name = "Valid Accounts: Cloud Accounts"
    log_prerequisites = "Requires identity provider and cloud audit logs that populate USER_LOGIN (with principal.ip and principal.user.userid) and USER_CHANGE_PERMISSIONS (with principal.user.userid as the acting account)."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Administrators working remotely or over VPN or a home connection who sign in and immediately grant roles; onboarding or offboarding automation; break-glass account use; just-in-time privilege elevation workflows."
    tuning_guidance = "Add expected administrators to %global_allowed_admin_users, automation identities to %global_allowed_service_accounts, and corporate VPN or egress addresses to %global_allowed_mgmt_sources. Tighten further by adding a regex on metadata.description for high-privilege role names if the client's log source populates it."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.principal.user.userid != ""
    not $login.principal.ip in %rfc1918_internal
    not $login.principal.ip in %global_allowed_mgmt_sources
    not $login.principal.user.userid in %global_allowed_service_accounts
    not $login.principal.user.userid in %global_allowed_admin_users
    $login.principal.user.userid = $user

    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.principal.user.userid != ""
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_admin_users
    $perm.principal.user.userid = $user

    $login.metadata.event_timestamp.seconds <= $perm.metadata.event_timestamp.seconds

  match:
    $user over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1078.004")
    $primary_entity = array_distinct($user)
    $login_source_ips = array_distinct($login.principal.ip)
    $permission_targets = array_distinct($perm.target.user.userid)
    $login_count = count($login.metadata.id)
    $permission_change_count = count($perm.metadata.id)

  condition:
    $login and $perm
}
