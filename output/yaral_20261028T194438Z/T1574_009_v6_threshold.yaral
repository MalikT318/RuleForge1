/*
  MITRE Technique : T1574.009 - Path Interception by Unquoted Path
  Tactic(s)       : Stealth, Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:38:55.616984+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_009_Unquoted_Path_Interception_File_Drops {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Multiple executable files created on one host within 10 minutes at classic unquoted-path interception points: the drive root (e.g. C:\\Program.exe) or directly inside the Program Files root. A single such file is rare, and several in a short window indicate planted binaries awaiting a service or shortcut that resolves an unquoted path. This is file-creation telemetry, not process command-line logic."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.009"
    mitre_technique_name = "Hijack Execution Flow: Path Interception by Unquoted Path"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating target.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy installers or updaters that write stub executables to the drive root or Program Files root, software deployment and patching tools, and developer or build activity on workstations. Imaging and golden-image build hosts may also trigger it."
    tuning_guidance = "Add approved installers and deployment tooling to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Add automation accounts to %global_allowed_service_accounts. Raise the #file threshold for build or imaging hosts. Lower it to 2 in hardened estates."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^[a-z]:\\(program|documents|common|my)\.(exe|com|scr)$|^[a-z]:\\program files( \(x86\))?\\[^\\]+\.(exe|com|scr)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(75)
    $file_count = count($file.metadata.id)
    $dropped_paths = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $mitre_technique_id = array_distinct("T1574.009")
    $primary_entity = array_distinct($host)

  condition:
    #file >= 3
}
