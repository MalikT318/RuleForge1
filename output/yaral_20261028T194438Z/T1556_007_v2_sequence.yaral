/*
  MITRE Technique : T1556.007 - Hybrid Identity
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:23:58.531853+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_007_Hybrid_Identity_Sync_Privilege_Grant_Then_External_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A privilege or role assignment tied to directory synchronization, federation, or pass-through authentication connector functions is granted to an account. Within 10 minutes the same account then signs in from an external address. Hybrid identity sync and connector accounts are non-interactive, so an external interactive sign-in right after a privilege grant indicates a backdoored hybrid authentication path or a hijacked sync account."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.007"
    mitre_technique_name = "Modify Authentication Process: Hybrid Identity"
    log_prerequisites = "Requires identity provider directory audit logs normalized to USER_CHANGE_PERMISSIONS (with the role or change description populated in metadata.description) and sign-in logs normalized to USER_LOGIN with source IP populated."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Planned hybrid identity deployment or migration where an admin grants a sync role and then tests the account from outside the corporate network; help-desk staff validating a new connector account over a VPN or cloud egress IP; break-glass account testing."
    tuning_guidance = "Add approved identity administrators to %global_allowed_admin_users. Add corporate VPN and egress addresses to %global_allowed_mgmt_sources. Extend the description regex with role names used in the client's tenant. Tighten the window or require additional login-failure context for noisy tenants."

  events:
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.metadata.description = /(directory.?sync|synchroniz|federat|pass.?through|hybrid|connector|identity.?sync|domain.?trust|token.?sign)/ nocase
    $perm.target.user.userid != ""
    not $perm.principal.user.userid in %global_allowed_admin_users
    $perm.target.user.userid = $user

    $login.metadata.event_type = "USER_LOGIN"
    $login.target.user.userid = $user
    $login.principal.ip != ""
    not $login.principal.ip in %rfc1918_internal
    not $login.principal.ip in %global_allowed_mgmt_sources

    $perm.metadata.event_timestamp.seconds <= $login.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1556.007")
    $primary_entity = array_distinct($user)
    $granting_admin = array_distinct($perm.principal.user.userid)
    $change_description = array_distinct($perm.metadata.description)
    $login_source_ips = array_distinct($login.principal.ip)
    $login_count = count($login.metadata.id)

  condition:
    $perm and $login
}
