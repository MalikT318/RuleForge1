/*
  MITRE Technique : T1219.003 - Remote Access Hardware
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:09:48.055936+00:00
  Reference       : https://attack.mitre.org/techniques/T1219/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1219_003_Windows_New_Composite_HID_Device_Registered {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects first-time registration of a composite USB HID device (keyboard and mouse presented as multiple interfaces) in the Windows PnP Enum registry hive. IP-KVM and remote access hardware such as TinyPilot or PiKVM enumerate this way when plugged into a host. The rule watches the registry state change left by device enumeration, so it does not depend on command-line logging, and it matches on the HID composite-interface structure rather than any vendor or product ID."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1219.003"
    mitre_technique_name = "Remote Access Tools: Remote Access Hardware"
    log_prerequisites = "Requires endpoint registry telemetry covering HKLM\\SYSTEM\\CurrentControlSet\\Enum\\HID (for example Sysmon registry events 12/13 with that path in the config, or EDR registry-creation telemetry). Many default Sysmon configurations do not monitor this path and must be extended."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate new peripherals with composite HID interfaces (gaming keyboards and mice, docks, headsets, KVM switches, barcode scanners, smart-card readers, hardware tokens), new hardware provisioning, OS imaging or driver staging, and approved lab or datacenter IP-KVM deployments."
    tuning_guidance = "Add provisioning and driver-deployment tooling to %global_allowed_admin_tools. Add IT staff accounts that perform hardware setup to %global_allowed_admin_users. Prioritise hits on servers, VDI hosts and locked-down workstations, and correlate with asset records for authorised hardware changes. For noisy fleets, tighten the regex to specific servers via asset context."

  events:
    $reg.metadata.event_type = "REGISTRY_CREATION"
    $reg.target.registry.registry_key = /\\(CurrentControlSet|ControlSet[0-9]{3})\\Enum\\HID\\VID_[0-9a-f]{4}&PID_[0-9a-f]{4}&MI_[0-9]{2}\\/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1219.003")
    $primary_entity = array_distinct($reg.principal.hostname)
    $device_registry_keys = array_distinct($reg.target.registry.registry_key)
    $writer_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
