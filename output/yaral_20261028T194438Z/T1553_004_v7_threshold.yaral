/*
  MITRE Technique : T1553.004 - Install Root Certificate
  Tactic(s)       : Defense Impairment
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:05:58.935779+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_004_Excessive_Root_Cert_Store_Registry_Writes {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Multiple writes to the Windows Trusted Root Certification Authorities registry store (machine, user or Group Policy store) on a single host within ten minutes. A single certificate write can be routine, but a burst suggests an adversary or malware silently installing rogue root CAs to suppress TLS warnings or enable HTTPS interception."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.004"
    mitre_technique_name = "Subvert Trust Controls: Install Root Certificate"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event IDs 12/13/14 or equivalent) normalised to REGISTRY_MODIFICATION with target.registry.registry_key populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy or Intune/MDM certificate deployment, enterprise PKI auto-enrolment, software installers that add their own CA (VPN clients, TLS-inspecting proxies and agents, dev tooling), OS image builds or first-boot provisioning, and Windows root certificate update mechanisms."
    tuning_guidance = "Add approved deployment and PKI tooling to %global_allowed_admin_tools, and EDR or security agents that manage certificates to %global_allowed_security_tools. Add service accounts that run certificate enrolment to %global_allowed_service_accounts. Raise the threshold (#reg >= 3) for environments with frequent certificate rollouts. Consider scheduling-based exclusions for provisioning windows."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SystemCertificates\\Root\\Certificates\\/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $event_count = count($reg.metadata.id)
    $risk_score = max(if($event_count >= 10, 85, 65))
    $mitre_technique_id = array_distinct("T1553.004")
    $primary_entity = array_distinct($host)
    $users = array_distinct($reg.principal.user.userid)
    $writing_processes = array_distinct($reg.principal.process.file.full_path)
    $registry_keys = array_distinct($reg.target.registry.registry_key)

  condition:
    #reg >= 3
}
