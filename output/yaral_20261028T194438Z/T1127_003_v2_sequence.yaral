/*
  MITRE Technique : T1127.003 - JamPlus
  Tactic(s)       : Stealth, Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:40:17.706520+00:00
  Reference       : https://attack.mitre.org/techniques/T1127/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1127_003_JamPlus_Dropped_Jam_File_Then_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A .jam build script is written to a user-writable location and, within ten minutes on the same host, a process is launched with that .jam file as an argument. This is the JamPlus proxy-execution pattern, where a trusted build utility runs attacker-supplied script content. The file-drop stage supplies the additive signal beyond command-line-only detection."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1127.003"
    mitre_technique_name = "Trusted Developer Utilities Proxy Execution: JamPlus"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry and process-launch telemetry with command lines (EDR or Sysmon Event IDs 11 and 1)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Game and software studios that use JamPlus as a build system, developers cloning or extracting repositories that contain .jam files and building them, and build agents that stage .jam files in temp directories."
    tuning_guidance = "Add approved build, deployment, or developer tooling to %global_allowed_admin_tools. Add build-host parent processes to %global_allowed_script_hosts. For developer-heavy tenants, scope the rule to non-developer hosts or raise severity only when the creating process is a browser, mail client, or archive tool."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.jam$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(downloads|desktop|documents|appdata)|temp|programdata|users\\public)\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /\.jam(\s|"|'|$)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1127.003")
    $primary_entity = array_distinct($hostname)
    $jam_files = array_distinct($file.target.file.full_path)
    $dropper_processes = array_distinct($file.principal.process.file.full_path)
    $executed_processes = array_distinct($proc.target.process.file.full_path)
    $executed_command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $file and $proc
}
