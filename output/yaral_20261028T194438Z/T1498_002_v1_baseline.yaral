/*
  MITRE Technique : T1498.002 - Reflection Amplification
  Tactic(s)       : Impact
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:12:00.810192+00:00
  Reference       : https://attack.mitre.org/techniques/T1498/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_002_Inbound_UDP_Amplification_Response_Flow {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a single large inbound UDP flow from an external host whose source port is a well-known amplification service (DNS, NTP, SNMP, CLDAP, SSDP, chargen, memcached). This pattern is the network-observable result of a reflection amplification DoS, where spoofed requests make third-party reflectors send oversized replies to the victim."
    mitre_tactic = "Impact"
    mitre_technique = "T1498.002"
    mitre_technique_name = "Network Denial of Service: Reflection Amplification"
    log_prerequisites = "Requires perimeter firewall flow or connection logs normalised to UDM NETWORK_FLOW, with network.ip_protocol, principal.port and network.sent_bytes (bytes sent by the reflector toward the protected host) populated. Flow records must be summarised per flow or per interval, not per packet."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate large DNS zone or response transfers over UDP, NTP or SNMP polling of external providers, SSDP or CLDAP traffic from approved partners, large bulk replies from a recursive resolver or external time source, and authorised DDoS-resilience or load testing."
    tuning_guidance = "Add approved scanners and test sources to %global_allowed_scanners. Raise or lower the network.sent_bytes threshold to match the client's link capacity and flow-summarisation interval. Remove ports the client legitimately uses with external peers, such as 53 or 123 for external recursive resolvers or NTP pools. Pair with a threshold or sequence variant for distributed multi-reflector attacks."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    $net.network.ip_protocol = "UDP"
    (
      $net.principal.port = 19 or
      $net.principal.port = 53 or
      $net.principal.port = 123 or
      $net.principal.port = 161 or
      $net.principal.port = 389 or
      $net.principal.port = 1900 or
      $net.principal.port = 11211
    )
    $net.network.sent_bytes > 500000
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1498.002")
    $primary_entity = array_distinct($net.target.ip)
    $reflector_ips = array_distinct($net.principal.ip)
    $reflector_ports = array_distinct($net.principal.port)
    $max_flow_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
