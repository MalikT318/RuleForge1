/*
  MITRE Technique : T1566.004 - Spearphishing Voice
  Tactic(s)       : Initial Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:53:19.644088+00:00
  Reference       : https://attack.mitre.org/techniques/T1566/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1566_004_Linux_Outbound_RemoteAccess_Port_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal host makes a burst of outbound connections to external destinations on well-known remote-access and remote-desktop ports within ten minutes. After a voice-phishing call, victims are often talked into installing a remote management tool, and its relay or session traffic shows up at the perimeter as repeated outbound connections to these ports. Each connection is benign on its own; the volume from one host to external space is the signal."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1566.004"
    mitre_technique_name = "Phishing: Spearphishing Voice"
    log_prerequisites = "Requires firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. The firewall cannot identify the OS, so scope the rule to Linux workstation and server segments through asset enrichment or log routing."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Approved RMM or remote-support tooling and its keepalives, administrators using RDP or VNC to external or cloud-hosted systems, vendor support sessions, and bastion or jump hosts."
    tuning_guidance = "Add approved jump hosts and management source addresses to %global_allowed_mgmt_sources and sanctioned vendor or RMM relay domains to %global_allowed_domains. Raise the #net threshold for noisy segments. Triage the hosts that fired and confirm whether the user recently received a support call."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 5938 or
      $net.target.port = 6568 or
      $net.target.port = 7070 or
      $net.target.port = 5500 or
      $net.target.port = 5900 or
      $net.target.port = 3389
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains
    $net.principal.ip = $src_ip

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1566.004")
    $primary_entity = array_distinct($src_ip)
    $event_count = count($net.metadata.id)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 10
}
