/*
  MITRE Technique : T1007 - System Service Discovery
  Tactic(s)       : Discovery
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:15:37.181695+00:00
  Reference       : https://attack.mitre.org/techniques/T1007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1007_Rapid_Service_Discovery_Commands {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of service-discovery commands (sc query/queryex, tasklist /svc, net start, schtasks /query, wmic service, Get-Service) on a single Windows host within ten minutes. Each command is benign on its own; the volume indicates automated discovery of registered services and scheduled tasks."
    mitre_tactic = "Discovery"
    mitre_technique = "T1007"
    mitre_technique_name = "System Service Discovery"
    log_prerequisites = "Requires EDR process telemetry, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT inventory and health-check scripts, RMM and patching agents, monitoring agents polling service state, administrators troubleshooting services, software installers verifying dependent services."
    tuning_guidance = "Add approved RMM, inventory and monitoring parent processes to %global_allowed_admin_tools. Add known automation hosts or parent script hosts to %global_allowed_script_hosts. Add service accounts that legitimately poll service state to %global_allowed_service_accounts. Raise the threshold in the condition if noisy."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $proc.target.process.file.full_path = /\\sc\.exe$/ nocase and
        $proc.target.process.command_line = /\b(query|queryex|qc|enumdepend)\b/ nocase
      ) or
      (
        $proc.target.process.file.full_path = /\\tasklist\.exe$/ nocase and
        $proc.target.process.command_line = /\/svc/ nocase
      ) or
      (
        $proc.target.process.file.full_path = /\\net1?\.exe$/ nocase and
        $proc.target.process.command_line = /\bstart\s*$/ nocase
      ) or
      (
        $proc.target.process.file.full_path = /\\schtasks\.exe$/ nocase and
        $proc.target.process.command_line = /\/query/ nocase
      ) or
      (
        $proc.target.process.file.full_path = /\\wmic\.exe$/ nocase and
        $proc.target.process.command_line = /\bservice\b/ nocase
      ) or
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase and
        $proc.target.process.command_line = /\bget-(service|scheduledtask)\b/ nocase
      )
    )
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(
      if(count($proc.metadata.id) >= 15, 70,
      if(count($proc.metadata.id) >= 10, 55, 40))
    )
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1007")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 6
}
