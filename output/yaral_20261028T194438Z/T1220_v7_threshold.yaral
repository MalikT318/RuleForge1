/*
  MITRE Technique : T1220 - XSL Script Processing
  Tactic(s)       : Stealth
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:13:20.068017+00:00
  Reference       : https://attack.mitre.org/techniques/T1220
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1220_XSL_Script_Processing_Repeated_Wmic_Format_Loads {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated WMIC executions on a single host within 10 minutes that use the /format switch to load a custom XSL stylesheet from a file path, UNC share, or URL rather than a built-in output format. A single such call can be benign, but repeated stylesheet loads indicate XSL script processing used to run embedded script code and bypass application control."
    mitre_tactic = "Stealth"
    mitre_technique = "T1220"
    mitre_technique_name = "XSL Script Processing"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 / Windows Event 4688 with command-line auditing enabled, normalised to UDM PROCESS_LAUNCH."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or inventory scripts that use custom XSL stylesheets to format WMIC output, RMM and asset-management agents, legacy deployment scripts, and software packaging or testing."
    tuning_guidance = "Add approved parent processes or tooling to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Raise the #proc threshold on hosts with heavy legitimate WMIC reporting. Lower it to 1 for high-value assets where WMIC /format with a custom stylesheet is never expected."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\wmic\.exe$/ nocase
    $proc.target.process.command_line = /[\/-]format\s*:\s*["']?([a-z]:\\|\\\\|https?:\/\/|ftp:\/\/|[^\s"']*\.(xsl|xslt)\b|[^\s"']*[\\\/])/ nocase
    not $proc.target.process.command_line = /[\/-]format\s*:\s*["']?(list|csv|table|htable|hform|rawxml|mof|value)["']?(\s|$)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1220")
    $primary_entity = array_distinct($host)
    $event_count = count($proc.metadata.id)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
