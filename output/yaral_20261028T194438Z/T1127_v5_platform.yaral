/*
  MITRE Technique : T1127 - Trusted Developer Utilities Proxy Execution
  Tactic(s)       : Stealth, Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:36:15.125375+00:00
  Reference       : https://attack.mitre.org/techniques/T1127
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1127_Dev_Utility_Outbound_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a trusted developer or debugger utility (MSBuild, Roslyn scripting hosts, DNX, JScript compiler, Windows debuggers) opening a network connection to an external address. This is a network-telemetry detection, not a command-line rule. It catches proxy execution where the utility fetches or runs a remote payload or beacons out. The requested non-Windows pivot was not applied because the mandatory target platform is Windows, so the pivot is to NETWORK_CONNECTION telemetry instead."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1127"
    mitre_technique_name = "Trusted Developer Utilities Proxy Execution"
    log_prerequisites = "Requires Windows endpoint network telemetry with the initiating process path populated (EDR network events or Sysmon Event ID 3)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Build servers and developer workstations restoring packages (NuGet/npm) via MSBuild; CI/CD agents; developers debugging with WinDbg and symbol servers; Visual Studio build tasks."
    tuning_guidance = "Add build servers and developer hosts to %global_allowed_script_hosts. Add package feeds and symbol servers to %global_allowed_domains. Add approved build tooling paths to %global_allowed_admin_tools."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(msbuild|rcsi|csi|dnx|jsc|cdb|ntsd|kd|windbg|adplus)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1127")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
