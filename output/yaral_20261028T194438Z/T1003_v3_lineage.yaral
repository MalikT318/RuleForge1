/*
  MITRE Technique : T1003 - OS Credential Dumping
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:36:03.143212+00:00
  Reference       : https://attack.mitre.org/techniques/T1003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_Anomalous_Parent_Spawns_Credential_Access_Child {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects a process that should never be handling credential stores (Office application, web server worker, print spooler, or database service) launching a shell, script interpreter, or credential-capable built-in binary whose command line references credential material (SAM/SECURITY/SYSTEM hives, NTDS.dit, LSASS, shadow copies, MiniDump). The detection pivots on the anomalous parent-child lineage, so renaming or recompiling the dumping tool does not evade it."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003"
    mitre_technique_name = "OS Credential Dumping"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry that populates parent process path, child process path and child command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Database maintenance jobs where sqlservr spawns cmd or powershell for backup tasks that touch shadow copies; backup agents invoked through a web or database service; Office macros in IT-authored tooling that export registry hives; vulnerability or forensic tooling run via a web console."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, and backup software to %global_allowed_backup_processes. Add approved automation hosts to %global_allowed_script_hosts. If a client runs SQL-driven backups, tighten by excluding that parent through the allowlists rather than removing the sqlservr branch."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|spoolsv|sqlservr|mysqld)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|powershell_ise|pwsh|wscript|cscript|mshta|rundll32|reg|ntdsutil|vssadmin|esentutl|wmic)\.exe$/ nocase
    $proc.target.process.command_line = /(ntds\.dit|\\config\\(sam|security|system)\b|hklm\\(sam|security|system)\b|lsass|comsvcs|minidump|ntdsutil|harddiskvolumeshadowcopy|shadowcopy|list\s+shadows)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
