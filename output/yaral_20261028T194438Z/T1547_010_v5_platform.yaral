/*
  MITRE Technique : T1547.010 - Port Monitors
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:37:49.428795+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_010_Print_Monitor_Driver_Registry_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a write to the Driver value of a subkey under the Print Monitors registry key. This is how a port monitor DLL is registered so spoolsv.exe loads it as SYSTEM at boot. T1547.010 is Windows-only, so this variant is registry-telemetry based and complements existing process command-line coverage. It also catches AddMonitor API abuse and direct registry writes that never spawn a command line."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.010"
    mitre_technique_name = "Boot or Logon Autostart Execution: Port Monitors"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry value-set events) covering HKLM\\SYSTEM\\CurrentControlSet\\Control\\Print\\Monitors."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Printer, scanner and print-management software installers registering legitimate vendor port monitors (for example, third-party TCP/IP or USB port monitors); Windows servicing and OS upgrades; software deployment tooling pushing print drivers."
    tuning_guidance = "Add approved installer or deployment binaries to %global_allowed_admin_tools and endpoint agents to %global_allowed_security_tools. Review the writing process and the new Driver DLL location; legitimate monitors are signed vendor DLLs, usually in System32. Hosts that legitimately install print software (print servers) can be tuned by writer process rather than by host."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(CurrentControlSet|ControlSet\d{3})\\Control\\Print\\Monitors\\[^\\]+/ nocase
    $reg.target.registry.registry_value_name = "Driver" nocase
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1547.010")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $writer_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
