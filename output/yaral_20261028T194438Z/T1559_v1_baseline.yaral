/*
  MITRE Technique : T1559 - Inter-Process Communication
  Tactic(s)       : Execution
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:49:29.733982+00:00
  Reference       : https://attack.mitre.org/techniques/T1559
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_Office_DDE_DCOM_Host_Spawns_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a COM/DDE-capable host process launching a command or script interpreter. The parent is either an Office application (the typical DDE and COM automation execution path) or mmc.exe started with -Embedding (the DCOM MMC20.Application remote-execution path). Legitimate use of these hosts rarely spawns shells or script engines."
    mitre_tactic = "Execution"
    mitre_technique = "T1559"
    mitre_technique_name = "Inter-Process Communication"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and parent command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros or add-ins from line-of-business applications that call cmd or PowerShell, document automation and reporting tools, admins running MMC snap-ins that legitimately start helper scripts, and software deployment or RMM tooling that drives Office or MMC through COM."
    tuning_guidance = "Add approved parent binaries or automation hosts to %global_allowed_script_hosts and sanctioned deployment tooling to %global_allowed_admin_tools. Add known automation accounts to %global_allowed_service_accounts. Review recurring hits by parent command line and child command line before widening exclusions."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32)\.exe$/ nocase
    (
      $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio)\.exe$/ nocase
      or
      (
        $proc.principal.process.file.full_path = /\\mmc\.exe$/ nocase
        and $proc.principal.process.command_line = /-embedding/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1559")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
