/*
  MITRE Technique : T1499.001 - OS Exhaustion Flood
  Tactic(s)       : Impact
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:17:26.138418+00:00
  Reference       : https://attack.mitre.org/techniques/T1499/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1499_001_Inbound_TCP_Connection_Flood_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a flood of small, short inbound TCP connection records from external sources to a single destination address and port within five minutes, as seen in perimeter firewall logs. This pattern is characteristic of SYN/ACK state-exhaustion floods that exhaust the OS connection table on a Linux server. A flood cannot be expressed as one flow record, so volume is aggregated per victim IP and port. It is additive to endpoint rules because it needs no process telemetry."
    mitre_tactic = "Impact"
    mitre_technique = "T1499.001"
    mitre_technique_name = "Endpoint Denial of Service: OS Exhaustion Flood"
    log_prerequisites = "Requires firewall or perimeter connection logging with allowed and denied or dropped flows, normalised to UDM NETWORK_CONNECTION with network.direction, principal.ip, target.ip and target.port populated."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Flash-crowd traffic to public services after marketing events or outages, load balancer health checks or CDN origin pulls from external ranges, uncatalogued vulnerability scanners, large legitimate API clients behind NAT, and monitoring probes."
    tuning_guidance = "Add authorised scanner and probe source IPs to %global_allowed_scanners and approved external management sources to %global_allowed_mgmt_sources. Raise or lower the #net threshold per client to match baseline connection rates for public-facing Linux services. Consider a longer window for low-traffic environments."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.direction = "INBOUND"
    $net.network.ip_protocol = "TCP"
    $net.network.sent_bytes <= 200
    $net.target.ip = $dst_ip
    $net.target.port = $dst_port
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $dst_ip, $dst_port over 5m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1499.001")
    $primary_entity = array_distinct($dst_ip)
    $connection_count = count($net.metadata.id)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    #net >= 500
}
