/*
  MITRE Technique : T1553.004 - Install Root Certificate
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:04:20.122378+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_004_Root_Certificate_Store_Registry_Install {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a certificate being written to the Windows Trusted Root Certification Authorities store through the registry (machine, user or Group Policy root store). Each trusted root is stored as a key named by its SHA-1 thumbprint under SystemCertificates\\Root\\Certificates, so this catches installs made by certutil, PowerShell, the Import-Certificate cmdlets, custom malware or direct registry edits. It does not depend on the tool used."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.004"
    mitre_technique_name = "Subvert Trust Controls: Install Root Certificate"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 12/13 equivalent) that populates target.registry.registry_key and principal.process.file.full_path, with coverage of HKLM and HKU/HKCU SystemCertificates keys."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows automatic root certificate updates via svchost (excluded by default). Enterprise PKI and GPO or Intune/SCCM certificate distribution. Endpoint security agents or TLS-inspection proxies installing their inspection CA. VPN, developer and local-proxy tools (for example local debugging proxies) that add a CA. Software installers and OS feature updates."
    tuning_guidance = "Add deployment, PKI and MDM binaries to %global_allowed_admin_tools. Add EDR, AV and TLS-inspection agents to %global_allowed_security_tools. Add automation accounts that legitimately push CAs to %global_allowed_service_accounts, and named PKI administrators to %global_allowed_admin_users. If a client's EDR does not report registry writes made by Windows system processes, the svchost exclusion can be removed. Correlate hits with a follow-on external TLS connection from the same host for higher confidence."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\SystemCertificates\\Root\\Certificates\\[0-9a-f]{40}/ nocase
    not $reg.principal.process.file.full_path = /\\windows\\system32\\svchost\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1553.004")
    $primary_entity = array_distinct($reg.principal.hostname)
    $acting_process = array_distinct($reg.principal.process.file.full_path)
    $acting_command_line = array_distinct($reg.principal.process.command_line)
    $acting_user = array_distinct($reg.principal.user.userid)
    $certificate_key = array_distinct($reg.target.registry.registry_key)

  condition:
    $reg
}
