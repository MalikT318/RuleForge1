/*
  MITRE Technique : T1001.001 - Junk Data
  Tactic(s)       : Command and Control
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:07:17.232413+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_001_Linux_Junk_Data_Piped_To_Network_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Repeated shell command lines on one Linux host within 10 minutes that generate random or junk data (/dev/urandom, /dev/random, openssl rand) and send it straight to the network via a pipe to nc/ncat/socat/curl/wget, a /dev/tcp or /dev/udp redirect, or a curl binary POST from stdin. A single occurrence is usually benign. A burst suggests an implant padding or obfuscating C2 traffic with junk data."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001.001"
    mitre_technique_name = "Data Obfuscation: Junk Data"
    log_prerequisites = "Requires Linux EDR or auditd (execve) process telemetry that populates the full shell command line (for example bash -c '...') in PROCESS_LAUNCH events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Network load and throughput testing (iperf-style scripts using urandom), backup or storage benchmarking scripts, entropy or crypto test harnesses, developer scripts that post random payloads to test APIs, approved RMM or automation tooling."
    tuning_guidance = "Add approved automation parent processes to %global_allowed_admin_tools, test or benchmarking hosts to %global_allowed_script_hosts, and automation accounts to %global_allowed_service_accounts. Raise the #proc threshold for noisy environments. Root-owned activity is scored higher in outcome."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(ba|da|z|k|a)?sh$/ nocase
    $proc.target.process.command_line = /(\/dev\/u?random|openssl\s+rand).*(\|\s*(nc|ncat|netcat|socat|curl|wget)\b|\/dev\/(tcp|udp)\/|--data-binary\s+@-)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.hostname in %global_allowed_script_hosts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($proc.principal.user.userid = "root", 75, 55))
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1001.001")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $sample_command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 5
}
