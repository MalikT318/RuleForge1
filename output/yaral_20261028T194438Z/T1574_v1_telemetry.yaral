/*
  MITRE Technique : T1574 - Hijack Execution Flow
  Tactic(s)       : Stealth, Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:26:22.989264+00:00
  Reference       : https://attack.mitre.org/techniques/T1574
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_006_Linux_Dynamic_Linker_Config_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of the Linux dynamic linker configuration files /etc/ld.so.preload, /etc/ld.so.conf and /etc/ld.so.conf.d/*. Writing to these files causes attacker-controlled shared libraries to be loaded into every dynamically linked process, or changes the library search order. This is a common user-space rootkit and persistence technique. The rule works on the resulting file artifact and does not depend on command-line logging, so it still fires if the write comes from a script, a renamed binary, or an in-memory editor."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.006"
    mitre_technique_name = "Hijack Execution Flow: Dynamic Linker Hijacking"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules (-w /etc/ld.so.preload -p wa and -w /etc/ld.so.conf.d -p wa) normalised to UDM FILE_MODIFICATION with target.file.full_path and principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers installing or removing libraries (dpkg, rpm, apt, dnf, yum, zypper), ldconfig runs, configuration management agents (Ansible, Puppet, Chef, Salt) deploying library paths, vendor installers for database, GPU or HPC software that register library directories, and legitimate security or APM agents that use ld.so.preload."
    tuning_guidance = "Add approved configuration-management and deployment binaries to %global_allowed_admin_tools. Add security or monitoring agents that legitimately use LD_PRELOAD-style injection to %global_allowed_security_tools. Extend the package-manager executable-name regex if the client uses other package tooling. Any write to /etc/ld.so.preload that is not from a known tool should be investigated. Creation of a new ld.so.preload arrives as FILE_CREATION; deploy a sibling rule if the EDR reports creation separately."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/ld\.so\.(preload|conf)$|^\/etc\/ld\.so\.conf\.d\/[^\/]+$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|yum|dnf|zypper|ldconfig|packagekitd|unattended-upgrade|snapd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1574.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
