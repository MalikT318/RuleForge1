/*
  MITRE Technique : T1480 - Execution Guardrails
  Tactic(s)       : Stealth
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:23:44.292218+00:00
  Reference       : https://attack.mitre.org/techniques/T1480
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1480_ESXi_Shell_Environment_Guardrail_Check {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi shell command line that queries host-specific identity values (hostname, version, management IP, host summary) through command substitution, tests the result in a conditional, and then runs or exits on the outcome. This is the execution-guardrail pattern used by hypervisor ransomware and implant scripts to confirm they are on the intended host before encrypting, killing VMs or staging payloads."
    mitre_tactic = "Stealth"
    mitre_technique = "T1480"
    mitre_technique_name = "Execution Guardrails"
    log_prerequisites = "ESXi shell command auditing forwarded to SIEM (shell.log or hostd/syslog process-execution records) and parsed into UDM PROCESS_LAUNCH events with the full command line populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrator maintenance and troubleshooting scripts that branch on hostname or version, host-profile and kickstart post-install scripts, vendor or backup agent install scripts, and orchestration or compliance tooling that runs over SSH."
    tuning_guidance = "Add approved automation parent binaries to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Add named administrators to %global_allowed_admin_users if they run scripted maintenance. If a client has noisy configuration-management scripts, add those parent binaries to %global_allowed_script_hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(sh|ash|bash|busybox)$/ nocase
    $proc.target.process.command_line = /(\$\(|`)\s*(hostname|uname\s+-[nrv]|esxcli\s+system\s+(hostname|version|uuid)\s+get|esxcli\s+network\s+ip\s+interface\s+ipv4\s+get|vim-cmd\s+hostsvc\/hostsummary|esxcli\s+storage\s+filesystem\s+list)/ nocase
    $proc.target.process.command_line = /(\bif\b|\btest\b|\[\[?\s|&&|\|\|)/ nocase
    $proc.target.process.command_line = /(\bexit\b|\.\/|chmod\s+\+x|nohup|esxcli\s+vm\s+process\s+kill|vmkfstools|\/tmp\/|\/scratch\/|\/vmfs\/volumes\/)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1480")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
