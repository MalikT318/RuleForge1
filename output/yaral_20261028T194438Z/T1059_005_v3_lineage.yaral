/*
  MITRE Technique : T1059.005 - Visual Basic
  Tactic(s)       : Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:13:06.737250+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_005_Unexpected_Parent_Spawns_VBScript_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows VBScript/HTA host (wscript, cscript, mshta) launched by a parent that should not normally run scripts: an Office application, web server worker, SQL Server service or print spooler. This lineage is typical of VBA macro, web shell and service-exploitation execution of Visual Basic payloads. The detection depends only on the parent and child process images, not on command-line content."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.005"
    mitre_technique_name = "Command and Scripting Interpreter: Visual Basic"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry (EDR, Sysmon Event ID 1 or Security Event 4688 with parent process populated) normalised to UDM PROCESS_LAUNCH with principal.process.file.full_path (parent) and target.process.file.full_path (child)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Office macros or add-ins that call wscript/cscript (finance or legacy line-of-business workbooks), Outlook rules or add-ins running VBScript, intranet or legacy ASP applications on IIS that shell out to cscript, SQL Server maintenance jobs that run VBScript, print-management scripts launched by the spooler, and software installers that launch mshta from an Office-hosted wizard."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts (for example a known IIS-hosted maintenance application or a signed line-of-business Office add-in launcher). Add approved IT deployment or RMM binaries to %global_allowed_admin_tools. If a specific client legitimately uses Office-to-VBScript automation, scope the exclusion to the parent path rather than removing the parent from the regex. Consider lowering severity for server-class parents (sqlservr, spoolsv) where noisy."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|php-cgi|tomcat[0-9]*|sqlservr|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(wscript|cscript|mshta)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1059.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
