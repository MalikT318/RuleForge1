/*
  MITRE Technique : T1218.015 - Electron Applications
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:02:59.714545+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_015_Linux_Electron_Debug_Flags_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound external network connection made by a process whose command line carries Electron/Chromium code-execution or debugging switches (remote debugging, inspector, GPU/renderer launcher prefixes, custom subprocess path). These switches let an Electron-hosted application run attacker-chosen code or expose a debug channel, and the external connection suggests C2, payload retrieval or remote control. Complements process-creation command-line detections by observing the network side."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.015"
    mitre_technique_name = "System Binary Proxy Execution: Electron Applications"
    log_prerequisites = "Linux EDR or auditd network telemetry that populates principal.process.command_line on NETWORK_CONNECTION events, with target.ip normalised to UDM."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers running Electron or Chromium-based apps with --inspect or --remote-debugging-port, automated browser testing and web scraping (headless Chromium with remote debugging), CI runners, and kiosk or UI-test frameworks that connect to external services."
    tuning_guidance = "Add approved test and automation tooling to %global_allowed_admin_tools, add known-good external destinations to %global_allowed_domains, and exclude developer or CI hosts by narrowing scope per tenant. Raise severity if the process path is in /tmp, /dev/shm or /var/tmp."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.command_line = /--(remote-debugging-(port|pipe)|inspect(-brk|-port)?|gpu-launcher|renderer-cmd-prefix|utility-cmd-prefix|browser-subprocess-path)\b/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1218.015")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $process_cmdline = array_distinct($net.principal.process.command_line)

  condition:
    $net
}
