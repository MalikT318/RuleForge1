/*
  MITRE Technique : T1567.001 - Exfiltration to Code Repository
  Tactic(s)       : Exfiltration
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:56:29.982625+00:00
  Reference       : https://attack.mitre.org/techniques/T1567/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_001_Linux_NonBrowser_Push_To_Code_Repo_API {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects HTTP write operations (POST/PUT/PATCH) from a non-browser client to external code-repository push or content-upload API paths, such as git smart-HTTP receive-pack, repository contents/blob APIs, and repository file/commit APIs. Non-browser user agents (curl, wget, scripting runtimes, git) are characteristic of Linux servers and automation. This is the network-observable result of exfiltration to a code repository. It is independent of process or command-line telemetry and does not depend on repository domain names, so it covers self-hosted and SaaS repositories alike."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567.001"
    mitre_technique_name = "Exfiltration Over Web Service: Exfiltration to Code Repository"
    log_prerequisites = "Requires forward proxy or perimeter firewall logs with TLS inspection (or an explicit proxy) that populate the HTTP method, full URL path and user agent as NETWORK_HTTP events. Without decrypted URL visibility this rule will not fire."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "CI/CD runners, build servers and release automation pushing to external repositories; developers or admins using the git CLI or curl from Linux jump hosts; configuration-management and GitOps tooling committing state to hosted repositories; backup of infrastructure-as-code to a hosted repository."
    tuning_guidance = "Add approved build, CI and automation hosts to %global_allowed_script_hosts and approved automation accounts to %global_allowed_service_accounts. Internal destinations are excluded through %rfc1918_internal. Clients that sanction a specific external repository for developer use should restrict this rule to server subnets, or raise the severity only for hosts that never normally push code."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT|PATCH)$/ nocase
    $net.target.url = /(\/git-receive-pack|\/repos\/[^\/]+\/[^\/]+\/(contents|git\/(blobs|trees|commits))|\/api\/v[0-9]+\/projects\/[^\/]+\/repository\/(files|commits)|\/2\.0\/repositories\/[^\/]+\/[^\/]+\/src)/ nocase
    $net.network.http.user_agent = /^(curl|libcurl|wget|python|go-http-client|git\/|okhttp|java|ruby|node|axios|perl|php)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1567.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
