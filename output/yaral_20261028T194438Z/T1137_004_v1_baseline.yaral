/*
  MITRE Technique : T1137.004 - Outlook Home Page
  Tactic(s)       : Persistence
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:18:34.212120+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_004_Outlook_Home_Page_WebView_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a write to the Outlook WebView registry key that sets a folder home page URL. Adversaries use this to load a malicious HTML page, which executes code whenever Outlook opens the folder. Any process writing this value is suspicious, because legitimate use of the setting is rare in managed environments."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.004"
    mitre_technique_name = "Office Application Startup: Outlook Home Page"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon registry value set events) normalised to REGISTRY_MODIFICATION with target.registry.registry_key and registry_value_name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Corporate Outlook customisation or GPO and login scripts that deliberately set a folder home page, Office deployment or configuration tooling, and profile migration utilities."
    tuning_guidance = "Add approved deployment or configuration binaries to %global_allowed_admin_tools and endpoint agents to %global_allowed_security_tools. If the organisation intentionally sets folder home pages, add the managing tool or account to those lists rather than loosening the key regex."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Software\\Microsoft\\Office\\[0-9]+\.[0-9]+\\Outlook\\WebView\\[^\\]+$/ nocase
    $reg.target.registry.registry_value_name = "URL" nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1137.004")
    $primary_entity = array_distinct($reg.principal.hostname)
    $user = array_distinct($reg.principal.user.userid)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $writer_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
