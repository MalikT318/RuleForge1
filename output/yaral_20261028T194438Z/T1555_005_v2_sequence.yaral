/*
  MITRE Technique : T1555.005 - Password Managers
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:59:18.956537+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_005_Password_Manager_Process_Access_Then_Dump_File {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A non-password-manager process opens a handle to a running password manager process and the same process then writes a memory dump or vault copy to disk on the same host within 10 minutes. This pattern indicates credential or master-key extraction from password manager memory."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.005"
    mitre_technique_name = "Credentials from Password Stores: Password Managers"
    log_prerequisites = "Requires EDR or Sysmon process-access telemetry (Sysmon Event ID 10 or equivalent) normalised to PROCESS_OPEN, plus file creation telemetry (Sysmon Event ID 11 or equivalent) normalised to FILE_CREATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "EDR/AV agents scanning password manager processes, backup and imaging software, crash-reporting tools (WerFault) producing dumps, administrators or developers debugging password manager software, and IT support tooling collecting diagnostics."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools, backup software to %global_allowed_backup_processes, and sanctioned diagnostic or support tooling to %global_allowed_admin_tools. If a corporate password manager is not in the process name regex, extend the alternation list. If crash-reporting noise is high, add the reporting binary to the exclusion list."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\(keepass|keepassxc|1password|bitwarden|lastpass|lpwinmetro|dashlane|enpass|roboform|nordpass|keeper|passwordsafe|pwsafe)[^\\]*\.exe$/ nocase
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    not $open.principal.process.file.full_path = /\\(csrss|svchost|services|wininit|winlogon|explorer|taskmgr|MsMpEng|MsSense|SenseIR|WerFault)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    $open.principal.hostname = $hostname
    $open.principal.process.file.full_path = $actor

    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(dmp|mdmp|dump|kdbx)$/ nocase
    not $file.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|WerFault)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    $file.principal.hostname = $hostname
    $file.principal.process.file.full_path = $actor

    $open.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname, $actor over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555.005")
    $primary_entity = array_distinct($hostname)
    $accessing_process = array_distinct($actor)
    $targeted_password_manager = array_distinct($open.target.process.file.full_path)
    $written_files = array_distinct($file.target.file.full_path)
    $accessing_user = array_distinct($open.principal.user.userid)
    $open_event_count = count($open.metadata.id)

  condition:
    $open and $file
}
