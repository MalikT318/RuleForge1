/*
  MITRE Technique : T1547 - Boot or Logon Autostart Execution
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:21:21.157446+00:00
  Reference       : https://attack.mitre.org/techniques/T1547
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_Dropped_Payload_Then_Autorun_Registry_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A process writes an executable or script to a user-writable location and, within ten minutes, the same process image on the same host modifies a logon-autostart registry key (Run, RunOnce, Policies Run, Winlogon Shell or Userinit). This file-drop-then-autorun sequence is typical of persistence set up by droppers, loaders and installers of unwanted software. It is independent of command-line matching."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547"
    mitre_technique_name = "Boot or Logon Autostart Execution"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11) and registry-modification telemetry (Sysmon Event IDs 12/13/14) with the initiating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers and updaters that drop binaries in ProgramData or AppData and register a Run key (collaboration clients, browsers, VPN clients, cloud-storage sync agents); RMM and software deployment tooling; user-profile logon scripts."
    tuning_guidance = "Add approved installer, updater and deployment process paths to %global_allowed_admin_tools. Add EDR and AV agent paths to %global_allowed_security_tools. Add approved remote support tooling to %global_allowed_remote_mgmt. Raise the severity for non-administrative users or lengthen the dropped-file extension list as needed."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(exe|dll|scr|bat|cmd|ps1|vbs|vbe|js|jse|hta|wsf|lnk)$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\appdata\\|programdata\\|users\\public\\|windows\\temp\\|windows\\tasks\\)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $file.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|TrustedInstaller|msiexec)\.exe$/ nocase
    $file.principal.hostname = $hostname
    $file.principal.process.file.full_path = $proc_path

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(Microsoft\\Windows\\CurrentVersion\\(Run|RunOnce|RunServices|RunServicesOnce|Policies\\Explorer\\Run)|Microsoft\\Windows NT\\CurrentVersion\\Winlogon)(\\|$)/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path in %global_allowed_remote_mgmt
    $reg.principal.hostname = $hostname
    $reg.principal.process.file.full_path = $proc_path

    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname, $proc_path over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1547")
    $primary_entity = array_distinct($hostname)
    $dropper_process = array_distinct($proc_path)
    $dropped_files = array_distinct($file.target.file.full_path)
    $autorun_keys = array_distinct($reg.target.registry.registry_key)
    $autorun_values = array_distinct($reg.target.registry.registry_value_name)
    $acting_users = array_distinct($reg.principal.user.userid)
    $dropped_file_count = count($file.metadata.id)

  condition:
    $file and $reg
}
