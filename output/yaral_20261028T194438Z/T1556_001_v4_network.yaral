/*
  MITRE Technique : T1556.001 - Domain Controller Authentication
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:15:09.568833+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_001_LSASS_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Local Security Authority process (lsass.exe) initiating a network connection to a non-internal destination. On a domain controller, LSASS normally talks only to internal peers (Kerberos, LDAP, RPC, replication). An outbound connection to external address space suggests the authentication process has been patched or injected, as with Skeleton Key-style implants, and is beaconing, staging or exfiltrating credentials."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.001"
    mitre_technique_name = "Modify Authentication Process: Domain Controller Authentication"
    log_prerequisites = "Requires endpoint network telemetry that attributes outbound connections to the originating process (EDR network events or Sysmon Event ID 3), normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated. Collect from domain controllers."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Hybrid identity DCs (e.g. Entra ID / Azure AD Connect or password-protection proxy components) contacting cloud endpoints; certificate revocation (CRL/OCSP) or AIA lookups to external CAs; external trust or NTP-related lookups in unusual topologies; misattributed process names from some sensors on proxied connections."
    tuning_guidance = "Add known-good external vendor, identity-provider and CA domains to %global_allowed_domains. Ensure %rfc1918_internal reflects all internal address space for the client. Scope deployment to domain controller hosts where possible. If a hybrid DC legitimately reaches cloud services, tune by destination domain rather than disabling the rule."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\lsass\.exe$/ nocase
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip = /^(127\.|::1$|fe80:)/ nocase
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1556.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $destination_hosts = array_distinct($net.target.hostname)

  condition:
    $net
}
