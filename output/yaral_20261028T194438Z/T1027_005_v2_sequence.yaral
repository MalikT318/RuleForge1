/*
  MITRE Technique : T1027.005 - Indicator Removal from Tools
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:45:12.516813+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_005_Quarantined_Binary_Recreated_Same_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a security tool removing an executable from a user-writable location, followed within five minutes by a script host, shell or downloader re-creating an executable at the identical path on the same host. This is consistent with an adversary re-deploying a tool after it was quarantined, typically modified or repacked to remove the detected indicator."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.005"
    mitre_technique_name = "Obfuscated Files or Information: Indicator Removal from Tools"
    log_prerequisites = "Requires endpoint file telemetry (FILE_DELETION and FILE_CREATION with principal process attribution) from an EDR or Sysmon (Event IDs 23/26 and 11). The security tool performing quarantine or removal must be listed in %global_allowed_security_tools."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Security tool remediation followed by an automated redeployment of the same legitimate package, software updaters that delete and rewrite binaries in ProgramData or AppData, developer build and test loops, and RMM or patching scripts that reinstall after AV false-positive detections."
    tuning_guidance = "Populate %global_allowed_security_tools with the EDR/AV engine process paths used by each client (the deletion side only fires for these). Add approved deployment, update and patching tooling to %global_allowed_admin_tools. Add the re-creating process names of sanctioned installers to the same list, or narrow the path regex for environments with heavy developer activity."

  events:
    $del.metadata.event_type = "FILE_DELETION"
    $del.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop)|programdata|windows\\temp)\\.*\.(exe|dll|scr|com)$/ nocase
    $del.principal.process.file.full_path in %global_allowed_security_tools
    $del.principal.hostname = $hostname
    $del.target.file.full_path = $path

    $drop.metadata.event_type = "FILE_CREATION"
    $drop.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop)|programdata|windows\\temp)\\.*\.(exe|dll|scr|com)$/ nocase
    $drop.principal.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|curl|wmic|msiexec)\.exe$/ nocase
    not $drop.principal.process.file.full_path in %global_allowed_security_tools
    not $drop.principal.process.file.full_path in %global_allowed_admin_tools
    $drop.principal.hostname = $hostname
    $drop.target.file.full_path = $path

    $del.metadata.event_timestamp.seconds <= $drop.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.005")
    $primary_entity = array_distinct($hostname)
    $recreated_path = array_distinct($path)
    $removing_process = array_distinct($del.principal.process.file.full_path)
    $recreating_process = array_distinct($drop.principal.process.file.full_path)
    $recreating_user = array_distinct($drop.principal.user.userid)
    $recreate_count = count($drop.metadata.id)

  condition:
    $del and $drop
}
