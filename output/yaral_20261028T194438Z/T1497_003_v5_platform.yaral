/*
  MITRE Technique : T1497.003 - Time Based Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:06:47.085985+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_003_Uptime_Gated_Execution_Check {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows script host or shell reading system uptime or tick-count values (LastBootUpTime, Get-Uptime, TickCount, net statistics, systeminfo boot time) in the same command line as conditional or sleep logic. This pattern is typical of sandbox-evasion gating, where a payload checks how long the system has been up and exits or delays if the value looks like a fresh analysis VM. Windows coverage only, because the mandatory platform requirement for this rule is Windows."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1497.003"
    mitre_technique_name = "Virtualization/Sandbox Evasion: Time Based Checks"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 with full command-line capture, or Windows Security Event 4688 with command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT inventory and compliance scripts that report uptime and branch on thresholds (for example, pending-reboot checks), patch orchestration scripts, monitoring agents, and admins running ad hoc troubleshooting one-liners."
    tuning_guidance = "Add approved inventory, patching and monitoring parent processes to %global_allowed_admin_tools. Add approved automation hosts to %global_allowed_script_hosts. Add service accounts that run scheduled health-check scripts to %global_allowed_service_accounts. Consider raising severity when the parent process is an Office application or runs from a user-writable path."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(lastbootuptime|get-uptime|\[environment\]::tickcount|tickcount64|net1?\s+stat(istic)?s?\s+(workstation|server|srv)|systeminfo.*boot\s+time)/ nocase
    $proc.target.process.command_line = /(\bif\b|\s-(lt|gt|le|ge)\s|\bexit\b|start-sleep|timeout\s+\/t|\bsleep\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1497.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
