/*
  MITRE Technique : T1134 - Access Token Manipulation
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:51:12.494631+00:00
  Reference       : https://attack.mitre.org/techniques/T1134
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_Process_Handle_To_SYSTEM_Token_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a non-system process requesting a handle to a SYSTEM-context core Windows process (winlogon, wininit, services, spoolsv, TrustedInstaller). Opening these processes is the first step of token theft, where an adversary duplicates a SYSTEM token to escalate from administrator to SYSTEM. This works at the process-handle layer, so it still fires when command-line logging is evaded or the tooling is renamed."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134"
    mitre_technique_name = "Access Token Manipulation"
    log_prerequisites = "Requires EDR process-access telemetry or Sysmon Event ID 10 (ProcessAccess) normalised to UDM PROCESS_OPEN, with principal and target process paths populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "EDR/AV agents and backup software that open handles to core processes; remote management and support tools; system diagnostics (Task Manager, Process Explorer, debuggers) used by administrators; crash handlers; software deployment agents."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools, RMM and diagnostic tooling to %global_allowed_admin_tools, and imaging software to %global_allowed_backup_processes. Where the telemetry carries the granted-access mask, filter further on duplicate-handle/query access rights. If a client runs legitimate system utilities from non-standard locations, add them to the allowlists rather than loosening the target regex."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\(winlogon|wininit|services|spoolsv|TrustedInstaller)\.exe$/ nocase
    $open.principal.process.file.full_path != ""
    not $open.principal.process.file.full_path = /^[a-z]:\\windows\\system32\\(csrss|svchost|smss|wininit|winlogon|services|lsass|werfault|wermgr|taskmgr|dllhost|sihost)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1134")
    $primary_entity = array_distinct($open.principal.hostname)
    $source_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $source_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
