/*
  MITRE Technique : T1497 - Virtualization/Sandbox Evasion
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:59:52.004238+00:00
  Reference       : https://attack.mitre.org/techniques/T1497
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_Script_Interpreter_Public_IP_Geo_Lookup {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows script interpreter or LOLBin (PowerShell, wscript, cscript, mshta, rundll32, regsvr32) making an outbound HTTP request to an external host whose name or URL matches generic public-IP or geolocation lookup patterns. Malware commonly does this to learn its external IP, ISP or country and so decide whether it is running in a sandbox or analysis VM before it detonates or fetches a payload. The rule matches the behaviour (a non-browser scripting process performing an IP/geo self-lookup), not any specific service."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1497"
    mitre_technique_name = "Virtualization/Sandbox Evasion"
    log_prerequisites = "Requires NETWORK_HTTP telemetry (EDR network events, secure web proxy or Sysmon-equivalent) that populates the initiating process path and the target URL or hostname."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin or inventory scripts that record the public IP of a host, RMM and monitoring agents, software installers that check geography for licensing, and developers testing connectivity from PowerShell."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools, trusted script hosts to %global_allowed_script_hosts, and sanctioned lookup domains to %global_allowed_domains. Extend the process regex for client-specific interpreters, or tighten it to PowerShell and script hosts only if volume is high."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32)\.exe$/ nocase
    $http.target.url = /(my-?ip|what-?is-?my-?ip|check-?ip|ip-?echo|geo-?ip|ip-?geo|ip-?info|ip-?lookup|ip-?api|external-?ip|public-?ip|get-?ip|ifconfig\.(me|co)|icanhazip)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.process.file.full_path in %global_allowed_admin_tools
    not $http.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1497")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_process = array_distinct($http.principal.process.file.full_path)
    $lookup_url = array_distinct($http.target.url)
    $destination_ips = array_distinct($http.target.ip)

  condition:
    $http
}
