/*
  MITRE Technique : T1134.003 - Make and Impersonate Token
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:57:52.247676+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_003_Script_Interpreter_LogonUser_Token_API {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows script interpreter launched with a command line that combines inline native-API definition (Add-Type, DllImport, GetProcAddress) with the LogonUser family and a token impersonation API (ImpersonateLoggedOnUser, SetThreadToken, CreateProcessWithTokenW and similar). This is the in-memory pattern for creating a new logon session with known credentials and applying the resulting token to a thread, rather than stealing an existing token."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.003"
    mitre_technique_name = "Access Token Manipulation: Make and Impersonate Token"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command-line capture (EDR, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrator or developer scripts that test credentials or run code as another user, IT automation and deployment frameworks that wrap LogonUser, and security testing or red-team exercises that have not been allow-listed."
    tuning_guidance = "Add approved automation parent processes to %global_allowed_admin_tools, approved automation accounts to %global_allowed_service_accounts, and approved scripting hosts to %global_allowed_script_hosts. Review the command line in the outcome to confirm whether the credential source is legitimate."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|powershell_ise|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(Add-Type|DllImport|GetProcAddress|GetDelegateForFunctionPointer|advapi32)/ nocase
    $proc.target.process.command_line = /\bLogonUser(A|W|Ex|ExW|ExA|ExExW)?\b/ nocase
    $proc.target.process.command_line = /(ImpersonateLoggedOnUser|SetThreadToken|DuplicateTokenEx|CreateProcessWithTokenW|CreateProcessAsUser|ImpersonateSelf)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1134.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
