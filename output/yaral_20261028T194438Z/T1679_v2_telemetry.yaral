/*
  MITRE Technique : T1679 - Selective Exclusion
  Tactic(s)       : Stealth
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:26:27.224044+00:00
  Reference       : https://attack.mitre.org/techniques/T1679
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1679_Targeted_Document_Extension_Appended_File_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the file-artifact result of selective-exclusion ransomware behaviour. Ransomware that skips executables, libraries and shortcuts (.exe, .dll, .lnk) to keep the host usable still encrypts user data, and the encrypted copy is commonly written as an original data file name plus an appended unfamiliar extension (for example report.docx.x7k2q9). This rule fires when an unapproved process creates a file whose name is a high-value data extension followed by a second, unfamiliar extension. Known-benign suffixes (tmp, bak, part, crdownload and similar) and common user-facing applications are excluded."
    mitre_tactic = "Stealth"
    mitre_technique = "T1679"
    mitre_technique_name = "Selective Exclusion"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating target.file.full_path and principal.process.file.full_path. File rename operations must be reported as FILE_CREATION by the sensor for the encrypted copy to be seen."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup, sync, or migration tools that append their own suffix to data files; file-conversion utilities; archive or DLP agents; developer tooling that writes versioned copies such as file.csv.20240101; admin scripts that append custom extensions."
    tuning_guidance = "Add legitimate writers to %global_allowed_backup_processes, %global_allowed_admin_tools, or %global_allowed_security_tools. Extend the benign-suffix exclusion regex with customer-specific extensions that appear in the baseline. Run in alert-only mode for 7 days before enabling response actions. Tune alerts using $primary_entity and $writer_process."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(doc|docx|xls|xlsx|ppt|pptx|pdf|rtf|odt|txt|csv|jpg|jpeg|png|psd|sql|sqlite|mdb|accdb|vmdk|vhd|vhdx|zip)\.[a-z0-9_\-]{4,15}$/ nocase
    not $file.target.file.full_path = /\.(tmp|temp|bak|backup|old|part|partial|crdownload|download|lock|swp|orig|sav|new|dat|log|etl)$/ nocase
    not $file.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|winword|excel|powerpnt|outlook|onedrive|chrome|msedge|firefox|teams)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1679")
    $primary_entity = array_distinct($file.principal.hostname)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $created_file = array_distinct($file.target.file.full_path)
    $affected_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
