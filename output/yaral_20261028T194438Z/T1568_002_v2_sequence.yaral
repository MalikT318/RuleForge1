/*
  MITRE Technique : T1568.002 - Domain Generation Algorithms
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:05:48.563105+00:00
  Reference       : https://attack.mitre.org/techniques/T1568/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1568_002_DGA_Lookups_Then_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects DGA-like behaviour on one Windows host. At least three DNS lookups for algorithmic-looking domains (a single long label containing a run of five or more consonants) are followed within 10 minutes by an outbound connection to a public IP from a process running out of a user-writable location. This indicates malware cycling through generated domains and then reaching a C2 server."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1568.002"
    mitre_technique_name = "Dynamic Resolution: Domain Generation Algorithms"
    log_prerequisites = "Requires EDR or Sysmon DNS query telemetry (NETWORK_DNS with the questions name populated) and network connection telemetry (NETWORK_CONNECTION) with process context, both normalised to UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "CDN or telemetry hostnames with random-looking labels, software updaters and installers running from AppData or ProgramData, anti-virus cloud lookups, peer-to-peer or collaboration clients, and developer tooling that generates random hostnames."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains, security agents to %global_allowed_security_tools, and approved admin tooling to %global_allowed_admin_tools. Raise the #dns threshold to reduce noise, or lengthen the label minimum in the DNS regex."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(?i)^[a-z0-9]{12,30}\.[a-z]{2,10}$/
    $dns.network.dns.questions.name = /(?i)[bcdfghjklmnpqrstvwxz]{5,}/
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.process.file.full_path = /\\(chrome|msedge|firefox|brave|iexplore)\.exe$/ nocase
    not $dns.principal.process.file.full_path in %global_allowed_security_tools
    $dns.principal.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /(?i)\\(users\\[^\\]+\\|programdata\\|windows\\temp\\)/
    not $net.principal.process.file.full_path = /\\(chrome|msedge|firefox|brave|iexplore)\.exe$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.target.ip in %rfc1918_internal
    $net.principal.hostname = $hostname

    $dns.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1568.002")
    $primary_entity = array_distinct($dns.principal.hostname)
    $dga_like_domains = array_distinct($dns.network.dns.questions.name)
    $dga_domain_count = count_distinct($dns.network.dns.questions.name)
    $connecting_processes = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    #dns >= 3 and $net
}
