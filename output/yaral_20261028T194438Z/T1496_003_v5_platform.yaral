/*
  MITRE Technique : T1496.003 - SMS Pumping
  Tactic(s)       : Impact
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:56:27.376587+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_003_SMS_Spend_Limit_Or_Sandbox_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a cloud control-plane change to messaging (SMS) spend limits, quotas, sandbox or sender and origination settings. SMS pumping fraud depends on removing these guardrails so that abused OTP or verification flows can send large volumes of messages. The rule flags the enabling change, not the traffic volume."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.003"
    mitre_technique_name = "Resource Hijacking: SMS Pumping"
    log_prerequisites = "Cloud provider audit logs (management or admin activity events) ingested and normalised to UDM with metadata.product_event_type populated. SMS or messaging service configuration changes must be logged."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate onboarding of SMS or MFA capabilities, planned marketing or notification campaigns that need higher spend limits, moving a messaging account out of its sandbox, sender ID or origination number registration by the messaging team, and infrastructure-as-code pipeline runs."
    tuning_guidance = "Add approved deployment or automation identities to %global_allowed_cloud_principals and %global_allowed_service_accounts. Add named messaging administrators to %global_allowed_admin_users. Triage by checking whether the change was followed by a spike in outbound SMS or OTP requests, and whether a change ticket exists."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /((sms|text[_ -]?messag|short[_ -]?messag).*(spend|limit|quota|sandbox|attribute|origination|sender|pool|registration)|(spend|quota|limit|sandbox).*(sms|text[_ -]?messag|short[_ -]?messag))/ nocase
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1496.003")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $source_ips = array_distinct($cloud.principal.ip)
    $changed_setting = array_distinct($cloud.metadata.product_event_type)
    $target_resource = array_distinct($cloud.target.resource.name)

  condition:
    $cloud
}
