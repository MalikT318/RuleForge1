/*
  MITRE Technique : T1021.002 - SMB/Windows Admin Shares
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:35:58.790262+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_002_SMB_Admin_Share_Remote_Executable_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an executable or script file written into the Windows directory by the kernel-level System process. Remote file writes over SMB (for example to ADMIN$ or C$) are performed by the System process, not by a user-mode process, so this is the file artifact left by remote tool staging before service, scheduled-task or WMI execution. It does not depend on command-line logging."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.002"
    mitre_technique_name = "Remote Services: SMB/Windows Admin Shares"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon Event ID 11) that records the writing process. Kernel SMB server writes must be attributed to the System process."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software deployment platforms that push installers or agents to ADMIN$ (SCCM/Intune-style distribution, RMM tools), GPO or login-script deployment, legitimate admin remote patching, and imaging or migration tools."
    tuning_guidance = "Add approved deployment binary names or paths to %global_allowed_admin_tools and deployment or automation accounts to %global_allowed_service_accounts. If System-process attribution is not available in the EDR, the rule will not fire. Validate in a pilot and consider restricting to server or workstation groups at the client level."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /(^|\\)system$/ nocase
    $file.target.file.full_path = /^[a-z]:\\windows\\([^\\]+\\)?[^\\]+\.(exe|dll|bat|cmd|ps1|vbs|js|scr|msi)$/ nocase
    $file.principal.hostname != ""
    not $file.target.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1021.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_files = array_distinct($file.target.file.full_path)
    $source_ips = array_distinct($file.principal.ip)

  condition:
    $file
}
