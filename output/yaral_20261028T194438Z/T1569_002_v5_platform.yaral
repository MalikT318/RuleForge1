/*
  MITRE Technique : T1569.002 - Service Execution
  Tactic(s)       : Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:12:20.055323+00:00
  Reference       : https://attack.mitre.org/techniques/T1569/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_002_Service_ImagePath_Registry_Suspicious_Command {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows service ImagePath registry value written with an interpreter or LOLBin command line, a user-writable or temp path, or a remote UNC share. This is the registry result of service-based execution (remote-exec tooling, sc.exe, or direct SCM API calls) and does not depend on process command-line matching. T1569.002 is a Windows-only technique, so the alternate-platform angle cannot apply. This rule gives additive Windows coverage by pivoting on registry telemetry instead of PROCESS_LAUNCH."
    mitre_tactic = "Execution"
    mitre_technique = "T1569.002"
    mitre_technique_name = "System Services: Service Execution"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry value-set events) that populates target.registry.registry_key and registry_value_data for HKLM\\SYSTEM\\*ControlSet*\\Services."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters that register services from temp or extracted directories, RMM and deployment agents, driver or agent installers, and admins creating test services."
    tuning_guidance = "Add approved deployment and RMM binaries to %global_allowed_admin_tools and EDR/AV installers to %global_allowed_security_tools. Narrow the path alternatives in the value-data regex if installers that stage in user or temp paths are noisy. Confirm the sensor records the ImagePath value name or key; the rule accepts either form."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      $reg.target.registry.registry_key = /\\services\\[^\\]+\\imagepath$/ nocase or
      (
        $reg.target.registry.registry_key = /\\services\\[^\\]+$/ nocase and
        $reg.target.registry.registry_value_name = "ImagePath" nocase
      )
    )
    $reg.target.registry.registry_value_data = /(%comspec%|\\cmd(\.exe)?"?\s+\/[ck]|powershell|pwsh|mshta|rundll32|regsvr32|wscript|cscript|\\users\\|\\windows\\temp\\|\\temp\\|\\appdata\\|\\perflogs\\|\\\\[^\\]+\\[a-z]\$)/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1569.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $service_registry_key = array_distinct($reg.target.registry.registry_key)
    $service_image_path = array_distinct($reg.target.registry.registry_value_data)
    $writer_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
