/*
  MITRE Technique : T1686.002 - Network Device Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:31:26.647408+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_002_Firewall_External_Sweep_Of_Internal_Admin_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single external source opens a high volume of connections to internal hosts on remote administration and lateral movement ports within 10 minutes. Each connection is benign on its own, but a high volume reaching internal address space on these ports is the observable result of a weakened or disabled perimeter firewall policy, such as an allow-any rule added by an adversary. It also catches exposed management services being swept."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.002"
    mitre_technique_name = "Network Device Firewall"
    log_prerequisites = "Perimeter firewall connection or traffic logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs must be collected from the perimeter or edge device. The rule is most useful when denied traffic is not logged, because connections that appear are then ones the policy allowed."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and penetration tests, external vendor or MSP remote support, VPN concentrators or NAT gateways that aggregate many users behind one address, partner site-to-site links, and load balancers or health-check services."
    tuning_guidance = "Add authorised scanner and pen-test sources to %global_allowed_scanners. Add approved management or partner source addresses to %global_allowed_mgmt_sources. Raise the #net threshold on busy perimeters or lower it on small sites. Edit the port list to match the services each client exposes. Review rule hits alongside SETTING_MODIFICATION events on the same device to confirm a policy change."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src
    not $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 445 or
      $net.target.port = 1433 or
      $net.target.port = 3306 or
      $net.target.port = 3389 or
      $net.target.port = 5900 or
      $net.target.port = 5985 or
      $net.target.port = 5986
    )
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src over 10m

  outcome:
    $risk_score = max(if($net.target.port = 3389 or $net.target.port = 445 or $net.target.port = 5985, 80, 65))
    $mitre_technique_id = array_distinct("T1686.002")
    $primary_entity = array_distinct($src)
    $connection_count = count($net.metadata.id)
    $internal_targets = array_distinct($net.target.ip)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    #net >= 30
}
