/*
  MITRE Technique : T1059 - Command and Scripting Interpreter
  Tactic(s)       : Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Containers
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:06:48.390479+00:00
  Reference       : https://attack.mitre.org/techniques/T1059
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_Container_Egress_Script_Fetch_By_CLI_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a command-line HTTP client (curl, wget, scripting-library user agents) in a container or cluster network segment fetching a shell or interpreter script from an external destination. This is the network-side footprint of an adversary staging a script for execution through an interpreter, for example a download piped to a shell after a container compromise or exec session. Detection relies on proxy or firewall HTTP telemetry (user agent, URL, destination) and does not depend on endpoint process fields."
    mitre_tactic = "Execution"
    mitre_technique = "T1059"
    mitre_technique_name = "Command and Scripting Interpreter"
    log_prerequisites = "Requires firewall or proxy logs normalised to NETWORK_HTTP with network.http.user_agent, target.url, target.hostname and target.ip populated (TLS inspection or an explicit forward proxy is needed to see URL and user agent). Egress traffic from container nodes and pod networks must traverse the perimeter device."
    platform = "Containers"
    log_source = "firewall"
    false_positives = "Container image builds and CI runners pulling install scripts; init or entrypoint scripts that bootstrap packages at start-up; package manager and language toolchain installers; health-check or configuration scripts fetched from external vendor endpoints; administrators troubleshooting from a debug pod."
    tuning_guidance = "Add known-good external vendor and CDN domains to %global_allowed_domains. Add build-farm, CI runner and approved bootstrap hosts to %global_allowed_script_hosts. Narrow or widen the script extension and user-agent regexes to match the environment. Group repeated alerts by principal.hostname in the SOAR playbook to reduce noise from image build fleets."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.network.http.user_agent = /^(curl|wget|python-requests|python-urllib|libwww-perl|ruby)/ nocase
    $net.target.url = /\.(sh|bash|py|pl|rb)(\?.*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1059")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_host = array_distinct($net.target.hostname)
    $destination_ip = array_distinct($net.target.ip)
    $fetched_url = array_distinct($net.target.url)
    $user_agent = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
