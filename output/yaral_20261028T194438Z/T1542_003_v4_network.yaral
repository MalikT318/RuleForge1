/*
  MITRE Technique : T1542.003 - Bootkit
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:47:04.353659+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_003_Boot_Utility_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows boot-configuration or disk-layout utility (BCD, EFI system partition, MBR/VBR tooling) opening a network connection to an external address. These binaries have no legitimate reason to initiate outbound traffic. Such a connection suggests process hollowing, injection or abuse by bootkit staging or command-and-control activity."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.003"
    mitre_technique_name = "Pre-OS Boot: Bootkit"
    log_prerequisites = "Requires EDR or Sysmon network connection telemetry (Sysmon Event ID 3 or equivalent) with the initiating process path populated, normalised to UDM NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare. Possible sources are IT imaging or recovery tooling that wraps these utilities and proxies traffic under the same process, remote-management agents invoking diskpart or bcdboot during OS deployment, and EDR telemetry that mis-attributes the connecting process."
    tuning_guidance = "Add approved deployment or imaging tooling binaries to %global_allowed_admin_tools and approved security agents to %global_allowed_security_tools. If the network telemetry attributes connections to the wrong process, validate the principal.process.file.full_path mapping for that client before widening the exclusions."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(bcdedit|bcdboot|bootsect|bootrec|mountvol|diskpart|reagentc)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1542.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $initiating_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
