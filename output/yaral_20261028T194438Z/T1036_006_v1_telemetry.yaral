/*
  MITRE Technique : T1036.006 - Space after Filename
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:06:01.594884+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_006_Trailing_Space_File_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a file on Linux whose name has one or more trailing spaces after a file extension (for example 'invoice.pdf ') in user-writable or staging locations. Trailing spaces in filenames are used to masquerade a file's true type and to evade extension-based handling or visual inspection. Detection is based on the resulting file artifact rather than the command line, so it still fires if command-line logging is evaded."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.006"
    mitre_technique_name = "Masquerading: Space after Filename"
    log_prerequisites = "Requires Linux EDR file-creation telemetry or auditd file-creation events (path/PATH records) normalized to UDM FILE_CREATION with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "File managers or browsers saving downloads with accidentally trailing-space names, users copying files from other operating systems or network shares, archive extraction of badly named files, and backup or sync tools restoring such files. Occasional developer or build artifacts with odd names."
    tuning_guidance = "Add approved tooling binaries that legitimately create such files to %global_allowed_admin_tools, and automation or service accounts to %global_allowed_service_accounts. Extend or narrow the directory prefixes in the path regex to match client filesystem layout. Consider raising severity when the creating process is a shell, scripting interpreter, or network download utility."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|home\/[^\/]+|root|opt|srv|mnt|media|var\/www)\/.*[^\/ ]\.[a-z0-9]{1,10} +$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1036.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
