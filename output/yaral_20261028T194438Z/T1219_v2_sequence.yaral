/*
  MITRE Technique : T1219 - Remote Access Tools
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:04:15.267979+00:00
  Reference       : https://attack.mitre.org/techniques/T1219
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1219_Windows_Userland_Binary_Service_Install_Then_External_Connect {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A process running from a user-writable location (Temp, Downloads, Desktop, AppData, ProgramData) writes a Windows service ImagePath value and then makes an outbound connection to an external address within ten minutes. This is typical of a self-installing remote access agent that sets up service persistence and then connects to its relay or controller. It is detected by behaviour and does not depend on a tool name, hash or destination."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1219"
    mitre_technique_name = "Remote Access Tools"
    log_prerequisites = "Requires EDR or Sysmon registry value-set telemetry (REGISTRY_MODIFICATION with principal process path populated) and network connection telemetry with the initiating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers or updaters that run from Temp or ProgramData, register a service and call home (for example vendor setup bootstrappers, RMM or helpdesk agents deployed outside the approved list, and VPN or collaboration clients). Software deployment tooling running from staging folders can also match."
    tuning_guidance = "Add approved remote management and RMM executable paths to %global_allowed_remote_mgmt. Add deployment and patching tooling to %global_allowed_admin_tools. Add EDR and AV agents to %global_allowed_security_tools. Add automation accounts to %global_allowed_service_accounts. Add approved destination domains to %global_allowed_domains if the log source populates target.hostname."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\CurrentControlSet\\Services\\[^\\]+$/ nocase
    $reg.target.registry.registry_value_name = /^ImagePath$/ nocase
    $reg.principal.process.file.full_path = /\\(Users\\[^\\]+\\(AppData|Downloads|Desktop)|Windows\\Temp|ProgramData|Temp)\\.+\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    $reg.principal.hostname = $hostname
    $reg.principal.process.file.full_path = $procpath

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(Users\\[^\\]+\\(AppData|Downloads|Desktop)|Windows\\Temp|ProgramData|Temp)\\.+\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    $net.principal.hostname = $hostname
    $net.principal.process.file.full_path = $procpath

    $reg.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $procpath over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1219")
    $primary_entity = array_distinct($hostname)
    $service_keys = array_distinct($reg.target.registry.registry_key)
    $service_image_path = array_distinct($reg.target.registry.registry_value_data)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $connection_count = count($net.metadata.id)
    $acting_users = array_distinct($reg.principal.user.userid)

  condition:
    $reg and $net
}
