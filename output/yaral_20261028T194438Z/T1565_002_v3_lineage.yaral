/*
  MITRE Technique : T1565.002 - Transmitted Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:41:26.660754+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_002_Linux_Service_Parent_Spawns_Traffic_Manipulation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, database or similar network-facing service process spawning a shell or script interpreter whose command line redirects, proxies or rewrites network traffic or name resolution (NAT/REDIRECT rules, traffic shaping, listener relays, hosts/resolv.conf edits). These are common ways to intercept or alter data in transit. Service daemons should not launch shells to do this, so the parent-child lineage is the key signal."
    mitre_tactic = "Impact"
    mitre_technique = "T1565.002"
    mitre_technique_name = "Data Manipulation: Transmitted Data Manipulation"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to UDM PROCESS_LAUNCH with populated parent process path, child process path and command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web application admin panels or hosting control panels that legitimately manage firewall or NAT rules; container or orchestration helpers running under a service parent; database or web hooks running approved network configuration scripts; legitimate CGI-based network appliances."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts and approved automation accounts to %global_allowed_service_accounts. Extend the parent process regex with environment-specific service daemons if needed. Review hosts that are expected to act as gateways or proxies and exclude them via the same lists."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9.]*|php-cgi|mysqld|mariadbd|postgres|mongod|redis-server)$/ nocase
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|python[0-9.]*|perl|ruby)$/ nocase
    $proc.target.process.command_line = /((iptables|ip6tables|nft)\b.*(-t\s+nat|-j\s+(redirect|dnat|snat|masquerade|tproxy)|\bnat\b))|(\btc\s+qdisc\b.*\bnetem\b)|(\b(socat|ncat|nc)\b.*(listen|\s-l))|(sed\s+(-i|--in-place).*\/etc\/(hosts|resolv\.conf))|(>>?\s*\/etc\/(hosts|resolv\.conf))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1565.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
