/*
  MITRE Technique : T1056 - Input Capture
  Tactic(s)       : Collection, Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:44:41.194731+00:00
  Reference       : https://attack.mitre.org/techniques/T1056
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1056_003_Linux_Web_Portal_Credential_POST_Then_Outbound {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Network-observable web portal capture (T1056.003) on a Linux host. A credential-style HTTP POST to a login-like URL on a high, non-standard port is followed within 10 minutes by that same server opening an outbound connection to an external address. This pattern fits a rogue or phishing login portal on a Linux server that relays captured credentials. It uses no endpoint process data and does not duplicate command-line rules."
    mitre_tactic = "Collection, Credential Access"
    mitre_technique = "T1056.003"
    mitre_technique_name = "Input Capture: Web Portal Capture"
    log_prerequisites = "Requires perimeter or proxy telemetry that normalises HTTP requests (method and URL) as NETWORK_HTTP and egress flows as NETWORK_CONNECTION, with target and principal IPs populated. HTTP method and URL visibility needs TLS inspection or a reverse proxy in front of the Linux server."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate internal web applications (admin consoles, dev or test portals, self-hosted SSO or wiki tools) on high ports that also call external APIs, webhooks or update services. Vulnerability scanners and authorised pen-test sources probing login pages."
    tuning_guidance = "Add authorised scanner and test source addresses to %global_allowed_scanners. Add known-good external destinations (vendor APIs, update services) to %global_allowed_domains. Add approved management source addresses to %global_allowed_mgmt_sources. If the environment uses non-standard login ports legitimately, raise the port threshold or restrict by asset in a client-specific copy of the rule."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /(login|logon|signin|sign-in|auth|passwd|password|credential|account)/ nocase
    $http.target.port >= 1024
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources
    $http.target.ip = $srv_ip

    $out.metadata.event_type = "NETWORK_CONNECTION"
    not $out.target.ip in %rfc1918_internal
    not $out.target.hostname in %global_allowed_domains
    $out.principal.ip = $srv_ip

    $http.metadata.event_timestamp.seconds <= $out.metadata.event_timestamp.seconds

  match:
    $srv_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1056.003")
    $primary_entity = array_distinct($srv_ip)
    $post_count = count($http.metadata.id)
    $client_ips = array_distinct($http.principal.ip)
    $login_urls = array_distinct($http.target.url)
    $outbound_ips = array_distinct($out.target.ip)
    $outbound_ports = array_distinct($out.target.port)

  condition:
    $http and $out
}
