/*
  MITRE Technique : T1574.014 - AppDomainManager
  Tactic(s)       : Stealth, Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:47:00.617831+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_014_AppDomainManager_Config_Drop_Then_Exe_Launch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a .NET application configuration file (<app>.exe.config) written to a user-writable directory, followed within 10 minutes by launch of the matching executable on the same host. This is the staging pattern for AppDomainManager injection, where a tampered or planted .config makes a benign .NET binary load an attacker assembly. The rule uses file-creation and process-launch lineage only, with no command-line matching."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.014"
    mitre_technique_name = "Hijack Execution Flow: AppDomainManager"
    log_prerequisites = "Requires endpoint FILE_CREATION telemetry (full target path populated) and PROCESS_LAUNCH telemetry with target process path from an EDR or Sysmon (Event IDs 11 and 1)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-user .NET application installers and auto-updaters (Squirrel-style updaters, portable .NET tools) that write .exe.config files into AppData, ProgramData or Temp and then launch the app. Developers building .NET applications in user-writable paths. Software deployment tooling not yet allow-listed."
    tuning_guidance = "Add approved installer, deployment and developer tooling to %global_allowed_admin_tools (matched against the process that wrote the config). Add known automation accounts to %global_allowed_service_accounts. If a specific updater is noisy, exclude it by executable name, not install directory."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\[^\\]+\\appdata|programdata|users\\public|windows\\temp|temp)\\.*\.exe\.config$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path = /\\(msiexec|TiWorker|TrustedInstaller)\.exe$/ nocase
    $file.principal.hostname = $hostname
    $exe_path = strings.to_lower(re.capture($file.target.file.full_path, "(?i)^(.*\\.exe)\\.config$"))

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(users\\[^\\]+\\appdata|programdata|users\\public|windows\\temp|temp)\\/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname
    $exe_path = strings.to_lower($proc.target.process.file.full_path)

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $exe_path over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1574.014")
    $primary_entity = array_distinct($file.principal.hostname)
    $config_files = array_distinct($file.target.file.full_path)
    $config_writer_processes = array_distinct($file.principal.process.file.full_path)
    $launched_executables = array_distinct($proc.target.process.file.full_path)
    $launch_parents = array_distinct($proc.principal.process.file.full_path)
    $affected_users = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
