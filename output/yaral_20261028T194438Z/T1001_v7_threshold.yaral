/*
  MITRE Technique : T1001 - Data Obfuscation
  Tactic(s)       : Command and Control
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:05:31.083814+00:00
  Reference       : https://attack.mitre.org/techniques/T1001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_ESXi_Repetitive_Outbound_Beaconing {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single ESXi host makes a high volume of repeated outbound connections to the same external destination within 10 minutes. ESXi hypervisors rarely initiate internet traffic beyond updates, NTP and vCenter or licensing endpoints, so a regular, repetitive pattern suggests obfuscated or disguised C2 traffic (beaconing, protocol impersonation, junk-data padding) from a compromised host."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001"
    mitre_technique_name = "Data Obfuscation"
    log_prerequisites = "Perimeter firewall or proxy logs normalised to UDM NETWORK_CONNECTION with principal.hostname (or a resolved asset name), target.ip and target.port populated. The ESXi management or VMkernel interface must route through the logging perimeter device."
    platform = "ESXi"
    log_source = "firewall"
    false_positives = "Patch and update checks to vendor repositories, licensing or telemetry check-ins, NTP or syslog forwarding to external collectors, cloud-backed backup or replication traffic, and vSAN or SRM witness connections to external sites."
    tuning_guidance = "Firewall logs cannot identify the platform, so ESXi hosts are matched by hostname convention. Adjust the principal.hostname regex to the client's ESXi naming standard, or replace it with an asset-group condition. Add known-good vendor domains to %global_allowed_domains, approved external management or backup endpoints to %global_allowed_mgmt_sources, and approved scanners to %global_allowed_scanners. Raise the #net threshold if legitimate recurring services are noisy."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname = /(esx|vmhost|vmware-host)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners
    $net.target.port != 123
    $net.target.port != 53
    $net.principal.hostname = $host
    $net.target.ip = $dst

  match:
    $host, $dst over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1001")
    $primary_entity = array_distinct($host)
    $event_count = count($net.metadata.id)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 20
}
