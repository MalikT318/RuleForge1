/*
  MITRE Technique : T1036.012 - Browser Fingerprint
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:15:58.694114+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_012_Spoofed_Browser_UA_To_Raw_IP_Destination {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects HTTP requests through a firewall or proxy that present a desktop-browser User-Agent claiming a Windows or macOS platform while requesting a bare external IP address as the destination, with no DNS hostname. Real browsers almost never browse to raw IPs. Implants and scripts running on Linux hosts often spoof Windows or macOS browser User-Agent strings to blend in with normal web traffic. Linux servers and containers normally run curl, wget, package managers or language HTTP libraries, not Windows or macOS browsers."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.012"
    mitre_technique_name = "Masquerading: Browser Fingerprint"
    log_prerequisites = "Requires firewall or web proxy logs with HTTP inspection (TLS inspection for HTTPS) that populate network.http.user_agent and target.url, normalised to NETWORK_HTTP."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Administrators browsing to device management interfaces or appliances by IP address from a jump host; Linux desktops or VDI with real browsers reaching IP-addressed external services; Linux hosts using headless browsers for automation or testing; vendor update checks addressed by IP; security scanners that spoof browser User-Agents."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains and scanner or testing source addresses to %global_allowed_scanners. To scope strictly to Linux servers, add a filter on the source asset platform or a Linux server subnet group if the client's proxy logs populate it. Raise severity when the source is a server segment with no expected interactive browsing."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.user_agent = /^Mozilla\/\d\.\d.*(Windows NT|Macintosh|Mac OS X)/ nocase
    $http.target.url = /^(https?:\/\/)?\d{1,3}(\.\d{1,3}){3}(:\d+)?(\/|$)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1036.012")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $destination_ips = array_distinct($http.target.ip)
    $user_agents = array_distinct($http.network.http.user_agent)
    $urls = array_distinct($http.target.url)

  condition:
    $http
}
