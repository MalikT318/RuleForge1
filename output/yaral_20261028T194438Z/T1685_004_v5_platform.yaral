/*
  MITRE Technique : T1685.004 - Disable or Modify Linux Audit System Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:22:31.480727+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_004_Linux_Audit_Config_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of Linux Audit (auditd) configuration, rule or plugin files by a process that is not an approved configuration manager or package manager. Adversaries edit audit.rules, rules.d fragments, auditd.conf or audisp plugin configs to remove watches, suppress events or disable logging. This is file-integrity based coverage and is independent of the command-line used to make the change."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.004"
    mitre_technique_name = "Disable or Modify Linux Audit System Log"
    log_prerequisites = "Linux EDR or auditd file-integrity telemetry (PATH/WATCH records or EDR file events) normalised to UDM FILE_MODIFICATION with principal.process.file.full_path and target.file.full_path populated. The audit config directories must be in scope of file monitoring."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package installs or upgrades of the audit package, configuration management (Ansible, Puppet, Chef, Salt) pushing compliance baselines such as CIS or STIG audit rules, augenrules regenerating audit.rules, authorised administrators tuning audit rules during change windows, golden image build pipelines."
    tuning_guidance = "Add configuration management agents and deployment tooling to %global_allowed_admin_tools, EDR/compliance agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Named administrators who legitimately tune audit rules can be added to %global_allowed_admin_users. Consider pairing with change-window suppression at the SOAR layer."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/(audit\/(audit\.rules|auditd\.conf|rules\.d\/.+|plugins\.d\/.+|audit-stop\.rules)|audisp\/.+|libaudit\.conf)$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|rpm|yum|dnf|apt|apt-get|zypper|augenrules|packagekitd|unattended-upgr(ade|ades)?)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $modifying_command = array_distinct($file.principal.process.command_line)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
