/*
  MITRE Technique : T1538 - Cloud Service Dashboard
  Tactic(s)       : Discovery
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:37:35.175123+00:00
  Reference       : https://attack.mitre.org/techniques/T1538
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1538_IdP_Admin_Dashboard_Browse_External_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects interactive browser access to administrative console, portal or dashboard URL paths from an external (non-internal) source address, by a user who is not a named administrator. Adversaries with stolen credentials use cloud and identity dashboards to enumerate tenants, applications, users and resources through the GUI without making API calls. The rule observes the HTTP request on the network side and does not depend on endpoint telemetry."
    mitre_tactic = "Discovery"
    mitre_technique = "T1538"
    mitre_technique_name = "Cloud Service Dashboard"
    log_prerequisites = "Requires HTTP or web-session telemetry normalised to NETWORK_HTTP (for example identity-aware proxy, reverse proxy or web gateway fronting the identity and cloud admin portals) with principal.ip, principal.user.userid, target.url and network.http.user_agent populated."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Helpdesk and delegated administrators working remotely who are not yet in the admin user list; contractors or MSP staff using admin portals from their own networks; remote staff on VPN split-tunnel; legitimate self-service portal users where the portal path contains 'portal' or 'dashboard'."
    tuning_guidance = "Add named administrators to %global_allowed_admin_users, automation identities to %global_allowed_service_accounts, and trusted egress or VPN addresses to %global_allowed_mgmt_sources. Add known-good destination domains to %global_allowed_domains. If end-user self-service portals generate noise, narrow the URL path regex to admin-only paths. Correlate hits with USER_LOGIN events from the same user and source IP (new device, new geography, failed MFA) to prioritise."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.target.url = /\/(admin|adminconsole|console|portal|dashboard|cloud-?console)(\/|\?|#|$)/ nocase
    $net.network.http.user_agent = /^Mozilla\// nocase
    not $net.network.http.user_agent = /(curl|wget|python|powershell|okhttp|go-http|postman|java)/ nocase
    $net.principal.user.userid != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.user.userid in %global_allowed_admin_users
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1538")
    $primary_entity = array_distinct($net.principal.user.userid)
    $source_ips = array_distinct($net.principal.ip)
    $accessed_urls = array_distinct($net.target.url)

  condition:
    $net
}
