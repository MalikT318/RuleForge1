/*
  MITRE Technique : T1070 - Indicator Removal
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:02:28.431655+00:00
  Reference       : https://attack.mitre.org/techniques/T1070
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_ESXi_Syslog_Redirected_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi host sending syslog traffic (UDP/TCP 514, 601, 1514, TLS 6514) to a non-internal destination. When an adversary reconfigures the remote log host to an external or attacker-controlled collector, or away from the sanctioned internal collector, evidence stops reaching the SIEM and local logs can then be wiped or altered without trace. This is network-side coverage of log-pipeline tampering and complements endpoint command-line rules."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070"
    mitre_technique_name = "Indicator Removal"
    log_prerequisites = "Requires network connection telemetry attributed to the ESXi host (firewall, flow, or host-level connection logs) normalised to UDM NETWORK_CONNECTION with principal.hostname and target.ip populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Legitimate forwarding to a cloud-hosted SIEM or managed log service, a new collector rollout or migration, DR-site collectors with public addressing, and vendor support sessions that temporarily redirect logs."
    tuning_guidance = "Add sanctioned external collector domains to %global_allowed_domains. Make sure %rfc1918_internal covers all internal collector address space. Review hosts that alert repeatedly and confirm the loghost setting matches the approved configuration baseline."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname != ""
    (
      $net.target.port = 514 or
      $net.target.port = 601 or
      $net.target.port = 1514 or
      $net.target.port = 6514
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1070")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
