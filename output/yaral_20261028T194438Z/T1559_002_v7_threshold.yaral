/*
  MITRE Technique : T1559.002 - Dynamic Data Exchange
  Tactic(s)       : Execution
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:55:20.496646+00:00
  Reference       : https://attack.mitre.org/techniques/T1559/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_002_Office_DDE_Repeated_Child_Process_Spawn {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects multiple script, shell or LOLBin child processes launched by Office applications on a single host within 10 minutes. A single Office child process can be benign. Repeated spawns are consistent with Dynamic Data Exchange (DDE) or DDEAUTO payloads in documents, spreadsheets or embedded objects that execute commands without VBA macros."
    mitre_tactic = "Execution"
    mitre_technique = "T1559.002"
    mitre_technique_name = "Inter-Process Communication: Dynamic Data Exchange"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and child command line populated (EDR, Sysmon Event ID 1 or Windows Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office add-ins and macro-enabled finance or reporting workbooks that call cmd or PowerShell, document management and DLP plugins, line-of-business integrations driven from Excel or Access, IT automation that opens Office documents and runs helpers, and installers launched from Office."
    tuning_guidance = "Add approved parent Office hosts or automation parents to %global_allowed_script_hosts. Add sanctioned child tooling to %global_allowed_admin_tools. Raise the #proc threshold for noisy hosts such as finance workstations that use Excel automation. Lower it to 2 for high-security environments."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|mshta|wscript|cscript|rundll32|regsvr32|msiexec|certutil|bitsadmin|forfiles|conhost)\.exe$/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1559.002")
    $primary_entity = array_distinct($host)
    $office_parents = array_distinct($proc.principal.process.file.full_path)
    $child_processes = array_distinct($proc.target.process.file.full_path)
    $child_command_lines = array_distinct($proc.target.process.command_line)
    $affected_users = array_distinct($proc.principal.user.userid)

  condition:
    #proc >= 3
}
