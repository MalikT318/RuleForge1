/*
  MITRE Technique : T1204 - User Execution
  Tactic(s)       : Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:57:13.218015+00:00
  Reference       : https://attack.mitre.org/techniques/T1204
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_Risky_File_Download_Then_Uncommon_Port_Callback {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A Windows client downloads an executable, script, shortcut, disk-image or archive file over HTTP from an external site, then within 10 minutes opens an outbound connection from the same source IP to a different external address on a high, non-web port. This sequence is consistent with a user opening a lured payload that then calls back to attacker infrastructure. It uses perimeter network telemetry only and does not duplicate process command-line detections."
    mitre_tactic = "Execution"
    mitre_technique = "T1204"
    mitre_technique_name = "User Execution"
    log_prerequisites = "Requires firewall or web proxy logs normalised to UDM NETWORK_HTTP (with target.url populated) and NETWORK_CONNECTION (with principal.ip, target.ip and target.port) from the same egress point."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Software installers and updaters from vendors not in the allowed domain list, developers downloading tooling or archives, and legitimate applications using high ports (VoIP, gaming, P2P, custom line-of-business apps, VPN clients)."
    tuning_guidance = "Add known-good vendor and CDN domains to %global_allowed_domains. Add scanner or authorised testing source IPs to %global_allowed_scanners. If high-port noise is excessive, extend the port exclusions or restrict the rule to specific client subnets. Consider raising the risk score when the download is from an uncommon domain."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\.(exe|msi|scr|dll|js|jse|vbs|vbe|wsf|hta|lnk|iso|img|ps1|bat|cmd|jar|zip|rar|7z)(\?.*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners
    $http.principal.ip = $ip

    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %rfc1918_internal
    $net.target.port >= 1024
    $net.target.port != 8080
    $net.target.port != 8443
    not $net.principal.ip in %global_allowed_scanners
    $net.principal.ip = $ip

    $http.target.ip != $net.target.ip

    $http.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1204")
    $primary_entity = array_distinct($http.principal.ip)
    $downloaded_urls = array_distinct($http.target.url)
    $download_hosts = array_distinct($http.target.hostname)
    $callback_ips = array_distinct($net.target.ip)
    $callback_ports = array_distinct($net.target.port)
    $callback_count = count($net.metadata.id)

  condition:
    $http and $net
}
