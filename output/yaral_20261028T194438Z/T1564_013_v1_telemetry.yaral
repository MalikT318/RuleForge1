/*
  MITRE Technique : T1564.013 - Bind Mounts
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:33:06.041737+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_013_Bind_Mount_Over_Proc_Systemd_Unit {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a systemd .mount unit file whose name resolves to a mount point under /proc/<PID> (for example proc-1234.mount). systemd derives the unit name from the mount path, so a unit named this way bind-mounts over a process's /proc directory. This is the technique adversaries use to overlay a malicious process's /proc entry with a benign one and hide it from ps, top and similar tools. The rule detects the persistent file artifact rather than the mount command line, so it still fires when command-line logging is evaded or the mount is made through unit files or configuration management."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.013"
    mitre_technique_name = "Hide Artifacts: Bind Mounts"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd watches (-w) on /etc/systemd/system, /run/systemd and /usr/lib/systemd/system, normalised to FILE_CREATION with principal process and hostname populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Very rare. Possible sources are hardening or sandboxing tools that deliberately mount over /proc (for example hidepid configuration automation), container or sandbox runtimes that generate transient mount units, and configuration management or admin tooling that writes custom mount units."
    tuning_guidance = "Add approved configuration management, container runtime or deployment binaries to %global_allowed_admin_tools. Add known automation accounts to %global_allowed_service_accounts. Add named administrators to %global_allowed_admin_users if they legitimately author mount units. Pair with a companion rule on /etc/fstab changes if the client's EDR emits FILE_MODIFICATION for that path."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(etc|run|usr\/lib|lib)\/systemd\/(system|transient)\/proc-[0-9]+[^\/]*\.mount$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1564.013")
    $primary_entity = array_distinct($file.principal.hostname)
    $mount_unit_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $creating_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
