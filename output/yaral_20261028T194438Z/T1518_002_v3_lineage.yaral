/*
  MITRE Technique : T1518.002 - Backup Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:22:30.099737+00:00
  Reference       : https://attack.mitre.org/techniques/T1518/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_002_Linux_Service_Parent_Spawns_Backup_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter spawned by an unexpected parent (web server, application runtime, database service or print spooler) whose command line enumerates installed backup software, agents, jobs or snapshot configuration on a Linux host. Services such as nginx, php-fpm, mysqld or cupsd do not normally run backup discovery. This lineage usually indicates web shell or post-exploitation activity that is scoping backups before data destruction, inhibiting recovery or ransomware."
    mitre_tactic = "Discovery"
    mitre_technique = "T1518.002"
    mitre_technique_name = "Software Discovery: Backup Software Discovery"
    log_prerequisites = "Requires Linux EDR or auditd (execve) process-launch telemetry that populates the parent process path, child process path and child command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Application-hosted admin panels or monitoring plugins that check backup agent status; Java-based CI/CD or management servers (e.g. Jenkins) that shell out to inspect packages and services; database maintenance jobs run from the DB service account (e.g. a backup-verification wrapper started by mysqld or postgres); and custom health checks started by Tomcat or Node.js applications."
    tuning_guidance = "Add legitimate parent process paths (monitoring agents, application servers that run approved health checks) to %global_allowed_script_hosts. Add approved backup or admin tooling parents to %global_allowed_admin_tools. If Java or Node.js parents are too noisy for a client, narrow the parent regex to the web and database daemons actually deployed in that environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|caddy|php-fpm[0-9.]*|php[0-9.]*|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|cupsd)$/ nocase
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|ash|csh|tcsh|python[0-9.]*|perl|ruby)$/ nocase
    $proc.target.process.command_line = /(veeam|bacula|bareos|amanda|restic|borg|duplicity|rsnapshot|timeshift|acronis|commvault|netbackup|networker|rubrik|cohesity|dsmc|tsm|backup|snapshot)/ nocase
    $proc.target.process.command_line = /(dpkg\s+(-l|--list)|rpm\s+-q|apt(-get)?\s+(list|search)|yum\s+(list|info)|dnf\s+(list|info)|systemctl\s+(list|status|is-active)|service\s+--status-all|ps\s+(aux|-ef|-e)|pgrep|find\s|locate\s|which\s|command\s+-v|crontab\s+-l|ls\s|cat\s+\/etc\/cron)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1518.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
