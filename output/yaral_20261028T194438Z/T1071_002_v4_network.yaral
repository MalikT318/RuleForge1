/*
  MITRE Technique : T1071.002 - File Transfer Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:06:28.399616+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_002_Outbound_File_Transfer_Protocol_To_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects perimeter-observed connections from internal hosts to external addresses on file transfer protocol ports (FTP, TFTP, SMB, FTPS). These protocols are rarely allowed outbound to the internet and are used by adversaries for C2 and exfiltration because they blend with file-transfer traffic. Network-side coverage that complements endpoint command-line detections."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.002"
    mitre_technique_name = "Application Layer Protocol: File Transfer Protocols"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with target.ip and target.port populated, for traffic leaving the client network."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate vendor or partner FTP/FTPS drop sites, firmware or software update servers using FTP, business-to-business file exchange, SMB over WAN to approved cloud file shares, and TFTP to externally hosted network device management."
    tuning_guidance = "Add known-good external file transfer destinations to %global_allowed_domains. Make sure %rfc1918_internal is populated for the client so internal traffic is excluded. If a client legitimately uses outbound SMB or FTP, narrow the port list or add approved destinations before deployment. Consider raising severity for 445 and 69, which are almost never legitimate outbound."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 21 or
      $net.target.port = 69 or
      $net.target.port = 445 or
      $net.target.port = 990
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1071.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_ips = array_distinct($net.principal.ip)

  condition:
    $net
}
