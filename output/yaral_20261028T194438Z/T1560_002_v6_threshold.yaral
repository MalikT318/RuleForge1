/*
  MITRE Technique : T1560.002 - Archive via Library
  Tactic(s)       : Collection
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:00:20.301560+00:00
  Reference       : https://attack.mitre.org/techniques/T1560/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1560_002_Linux_Bulk_Archive_Staging_By_Library {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of archive files (zip, rar, 7z, tar, gz, bz2, xz, zst) written to world-writable staging directories (/tmp, /var/tmp, /dev/shm) on one Linux host within 10 minutes by a process that is not a standard archive utility. This points to a script or compiled program using a compression or encryption library (Python zipfile/rarfile/zlib, libzip, libbz2) to stage collected data for exfiltration. One archive is routine; several in a short window from a non-utility process is not. This is file-creation volume telemetry and does not depend on process command lines."
    mitre_tactic = "Collection"
    mitre_technique = "T1560.002"
    mitre_technique_name = "Archive Collected Data: Archive via Library"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-creation events normalised to UDM FILE_CREATION, with principal.process.file.full_path and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Application and language-runtime crash or log bundlers, CI/build agents packaging artifacts in /tmp, backup or snapshot scripts staging in /tmp, configuration management agents, and developers running Python packaging or test suites."
    tuning_guidance = "Add approved packaging, build and deployment binaries to %global_allowed_admin_tools and backup agents to %global_allowed_backup_processes. Raise the #file threshold on build servers. Severity scales in outcome: archives in /dev/shm score higher. Add trusted build hosts via a separate allowlist if required."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.*\.(zip|rar|7z|tar|gz|tgz|bz2|xz|zst)$/ nocase
    $file.principal.process.file.full_path != ""
    not $file.principal.process.file.full_path = /\/(tar|gzip|bzip2|zip|7z|7za|7zr|xz|zstd|dpkg|apt|apt-get|rpm|yum|dnf)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(re.regex($file.target.file.full_path, `^/dev/shm/`), 80, 60))
    $mitre_technique_id = array_distinct("T1560.002")
    $primary_entity = array_distinct($host)
    $archive_count = count($file.metadata.id)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $archive_paths = array_distinct($file.target.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 5
}
