/*
  MITRE Technique : T1686 - Disable or Modify System Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:26:56.053303+00:00
  Reference       : https://attack.mitre.org/techniques/T1686
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_Firewall_Block_Then_Allow_Same_Flow {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the network-observable result of a firewall policy being disabled or loosened. An external source is repeatedly blocked from reaching an internal host on a sensitive remote-access or management port, and then the same source, destination and port is allowed through within 10 minutes. A block-to-allow flip on an identical flow suggests a rule was removed, a profile disabled, or a permissive rule added."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686"
    mitre_technique_name = "Disable or Modify System Firewall"
    log_prerequisites = "Perimeter firewall traffic logs normalised to UDM NETWORK_CONNECTION, with principal.ip, target.ip, target.port and security_result.action populated for both allowed and blocked traffic. Both outcomes must be logged; if deny logging is suppressed the rule cannot fire."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Planned change windows where a port is intentionally opened for a vendor or contractor; new NAT or publishing rules for a service; HA failover or policy reload where rules briefly evaluate differently; dynamic or geo-based policies that flip an address between block and allow; authorised penetration tests."
    tuning_guidance = "Add approved test and scanner sources to %global_allowed_scanners and known management or jump-host sources to %global_allowed_mgmt_sources. Adjust the sensitive port list to the client's exposure profile. Raise the #deny threshold on noisy internet-facing perimeters. If security_result.action values differ in the client's parser, align the BLOCK and ALLOW strings. Correlate hits with change-management tickets."

  events:
    $deny.metadata.event_type = "NETWORK_CONNECTION"
    $deny.security_result.action = "BLOCK"
    (
      $deny.target.port = 22 or
      $deny.target.port = 23 or
      $deny.target.port = 445 or
      $deny.target.port = 1433 or
      $deny.target.port = 3306 or
      $deny.target.port = 3389 or
      $deny.target.port = 5900 or
      $deny.target.port = 5985 or
      $deny.target.port = 5986
    )
    not $deny.principal.ip in %rfc1918_internal
    $deny.target.ip in %rfc1918_internal
    not $deny.principal.ip in %global_allowed_scanners
    not $deny.principal.ip in %global_allowed_mgmt_sources
    $deny.principal.ip = $src_ip
    $deny.target.ip = $dst_ip
    $deny.target.port = $dst_port

    $allow.metadata.event_type = "NETWORK_CONNECTION"
    $allow.security_result.action = "ALLOW"
    (
      $allow.target.port = 22 or
      $allow.target.port = 23 or
      $allow.target.port = 445 or
      $allow.target.port = 1433 or
      $allow.target.port = 3306 or
      $allow.target.port = 3389 or
      $allow.target.port = 5900 or
      $allow.target.port = 5985 or
      $allow.target.port = 5986
    )
    not $allow.principal.ip in %rfc1918_internal
    $allow.target.ip in %rfc1918_internal
    not $allow.principal.ip in %global_allowed_scanners
    not $allow.principal.ip in %global_allowed_mgmt_sources
    $allow.principal.ip = $src_ip
    $allow.target.ip = $dst_ip
    $allow.target.port = $dst_port

    $deny.metadata.event_timestamp.seconds <= $allow.metadata.event_timestamp.seconds

  match:
    $src_ip, $dst_ip, $dst_port over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1686")
    $primary_entity = array_distinct($dst_ip)
    $source_ips = array_distinct($src_ip)
    $exposed_ports = array_distinct($dst_port)
    $blocked_count = count($deny.metadata.id)
    $allowed_count = count($allow.metadata.id)
    $first_block_time = min($deny.metadata.event_timestamp.seconds)
    $first_allow_time = min($allow.metadata.event_timestamp.seconds)

  condition:
    #deny >= 2 and $allow
}
