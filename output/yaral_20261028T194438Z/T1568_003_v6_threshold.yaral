/*
  MITRE Technique : T1568.003 - DNS Calculation
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:08:46.506273+00:00
  Reference       : https://attack.mitre.org/techniques/T1568/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1568_003_ESXi_Outbound_HighPort_Fanout {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single ESXi host makes many outbound connections to external addresses on non-standard high ports within ten minutes. This pattern fits DNS-calculated C2, where the destination port is derived from resolved address octets and so keeps changing. Hypervisors normally talk to a small, stable set of external endpoints on well-known ports, so port fan-out is anomalous. Severity is scaled in outcome when ports fall in the ephemeral range."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1568.003"
    mitre_technique_name = "Dynamic Resolution: DNS Calculation"
    log_prerequisites = "ESXi host firewall or network connection telemetry forwarded and normalised to NETWORK_CONNECTION with principal.hostname, target.ip and target.port populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Host agents reaching vendor update or telemetry services on custom ports, backup or replication appliances, NTP/syslog/SNMP forwarders on non-default ports, vulnerability scanning of the host, and monitoring integrations using custom ports."
    tuning_guidance = "Add approved agent or backup binaries to %global_allowed_admin_tools. Add known-good vendor and update domains to %global_allowed_domains. Raise the #net threshold on noisy hosts. Extend the port exclusions if the tenant uses standard custom service ports."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname = $host
    $net.target.port > 1024
    $net.target.port != 8080
    $net.target.port != 8443
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($net.target.port > 49152, 75, 55))
    $mitre_technique_id = array_distinct("T1568.003")
    $primary_entity = array_distinct($host)
    $connection_count = count($net.metadata.id)
    $distinct_port_count = count_distinct($net.target.port)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 15
}
