/*
  MITRE Technique : T1176.001 - Browser Extensions
  Tactic(s)       : Persistence
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:28:14.699780+00:00
  Reference       : https://attack.mitre.org/techniques/T1176/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_001_Repeated_Browser_Extension_Package_Downloads {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single Windows host downloads several browser extension packages (.crx/.xpi) over HTTP(S) from external, non-allowlisted destinations within ten minutes. One download is routine; repeated sideloading-style package retrievals may indicate silent or malicious extension installation for persistence."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176.001"
    mitre_technique_name = "Software Extensions: Browser Extensions"
    log_prerequisites = "Requires proxy or firewall logs with HTTP URL visibility (TLS inspection or URL-aware filtering) normalised to NETWORK_HTTP, with principal.hostname, target.url, target.hostname and the HTTP user agent populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Enterprise extension deployment from an internal or self-hosted update server, developers testing extensions, browser profile migrations or reinstalls, and IT staff packaging extensions."
    tuning_guidance = "Add approved extension hosting and vendor domains to %global_allowed_domains and administrator accounts to %global_allowed_admin_users. Raise the #http threshold on noisy estates. If the proxy does not populate the user agent or hostname, relax or remove the user-agent condition or group by principal.ip instead."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\.(crx|xpi)([?#].*)?$/ nocase
    $http.network.http.user_agent = /Windows NT/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.user.userid in %global_allowed_admin_users
    $http.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($http.metadata.id)
    $mitre_technique_id = array_distinct("T1176.001")
    $primary_entity = array_distinct($host)
    $destination_hosts = array_distinct($http.target.hostname)
    $requested_urls = array_distinct($http.target.url)

  condition:
    #http >= 3
}
