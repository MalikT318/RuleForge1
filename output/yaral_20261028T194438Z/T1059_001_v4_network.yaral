/*
  MITRE Technique : T1059.001 - PowerShell
  Tactic(s)       : Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:08:30.743799+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_001_PowerShell_Outbound_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a PowerShell host process (Windows PowerShell, PowerShell 7 or ISE) opening an outbound network connection to an external address. This is the network footprint of download cradles, staged payload retrieval, and PowerShell-based C2 or reverse shells. It is additive to command-line rules because it fires on the observed connection, even when the command line is obfuscated, encoded, or loaded from a script file. Risk rises when the destination port is not 80 or 443."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.001"
    mitre_technique_name = "Command and Scripting Interpreter: PowerShell"
    log_prerequisites = "Requires Windows endpoint network telemetry (EDR network events or Sysmon Event ID 3) with the initiating process path populated, normalised to NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate admin scripts that call external APIs, PowerShell Gallery or NuGet module installs, Windows Update and Defender signature scripts, Azure/M365 management modules (Connect-AzAccount, Connect-MgGraph), RMM or deployment agents that run PowerShell, and inventory or monitoring scripts that report to SaaS platforms."
    tuning_guidance = "Add approved vendor and cloud-management domains to %global_allowed_domains. Add approved parent or hosting tools to %global_allowed_admin_tools. Add known automation or jump hosts to %global_allowed_script_hosts. Add approved service accounts to %global_allowed_service_accounts. Consider raising severity for servers that should never browse the internet."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(powershell|pwsh|powershell_ise)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.parent_process.file.full_path in %global_allowed_admin_tools
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(if($net.target.port != 80 and $net.target.port != 443, 75, 50))
    $mitre_technique_id = array_distinct("T1059.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_user = array_distinct($net.principal.user.userid)
    $powershell_path = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
