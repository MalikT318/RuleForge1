/*
  MITRE Technique : T1059.006 - Python
  Tactic(s)       : Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:14:13.544251+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_006_Linux_Python_Script_Dropped_In_Staging_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a Python script (.py) in a world-writable staging directory (/tmp, /var/tmp, /dev/shm) by a process that is not an approved admin, script-host or security tool and not a package manager. Dropping a script to disk before running it is a common step in Python-based execution, downloader stagers and post-exploitation frameworks. The rule keys on the file artifact, so it still fires when command-line logging is evaded or the interpreter is invoked indirectly."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.006"
    mitre_technique_name = "Command and Scripting Interpreter: Python"
    log_prerequisites = "Linux endpoint telemetry (EDR or auditd with file-write watches on /tmp, /var/tmp and /dev/shm) that populates UDM FILE_CREATION events with target.file.full_path and principal.process.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers and installers unpacking helper scripts, pip/setuptools build directories, CI/CD runners and test frameworks (pytest temp dirs), configuration management agents, developers and admins writing scratch scripts, and software installers that stage Python helpers."
    tuning_guidance = "Add approved deployment, CI and RMM binaries to %global_allowed_admin_tools. Add approved automation parents to %global_allowed_script_hosts. Add EDR and AV agents to %global_allowed_security_tools. Add service accounts that legitimately stage scripts to %global_allowed_service_accounts. On build servers, scope with host exclusions or extend the staging-path exclusion regex for known build directories."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.*\.py$/ nocase
    not $file.target.file.full_path = /^\/(tmp|var\/tmp)\/(pip-|pytest-of-|pymp-|tmp[a-z0-9_]*\/site-packages)/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|yum|dnf|zypper|snapd|pip|pip3|unattended-upgrade)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1059.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
