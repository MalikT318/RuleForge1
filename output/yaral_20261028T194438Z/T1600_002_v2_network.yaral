/*
  MITRE Technique : T1600.002 - Disable Crypto Hardware
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:08:41.772376+00:00
  Reference       : https://attack.mitre.org/techniques/T1600/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_002_Outbound_TFTP_Device_Image_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects TFTP (UDP/69) traffic from an internal source to an external destination, as seen by a perimeter firewall. TFTP is the usual way to stage a modified system image on a network device. Pushing such an image is how an adversary typically disables dedicated crypto hardware, forcing weaker software encryption (T1601 leading to T1600.002). This is a network-side proxy indicator and cannot see the configuration change itself. It should be paired with management-plane SETTING_MODIFICATION telemetry from the device."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1600.002"
    mitre_technique_name = "Weaken Encryption: Disable Crypto Hardware"
    log_prerequisites = "Firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Egress TFTP must traverse the logging firewall."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate vendor-directed firmware or config transfers to external TFTP servers, remote-site PXE or provisioning workflows, lab or test networks, and misconfigured legacy devices backing up configs offsite."
    tuning_guidance = "Add approved network-device management source addresses to %global_allowed_mgmt_sources. Add vendor or provisioning destinations to %global_allowed_domains. Review %rfc1918_internal to confirm it covers all private ranges the client uses. If the client has no legitimate external TFTP, keep the severity at High and route to the network engineering team."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1600.002")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
