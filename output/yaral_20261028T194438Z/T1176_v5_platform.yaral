/*
  MITRE Technique : T1176 - Software Extensions
  Tactic(s)       : Persistence
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:25:36.180287+00:00
  Reference       : https://attack.mitre.org/techniques/T1176
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_Linux_Browser_IDE_Extension_Dropped_By_Script {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, scripting interpreter, downloader, or file-copy utility writing into a Linux browser or IDE extension location. Covered locations are per-user Chromium-family extension directories, Firefox user extension directories, VS Code extension directories, Chrome/Chromium external-extension JSON descriptors, and Chrome/Edge/Firefox managed policy files used to force-install extensions. Legitimate installs normally come from the application or a package manager, not a script, so this indicates sideloaded or forced-install extension persistence."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176"
    mitre_technique_name = "Software Extensions"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry (watches on user .config, .mozilla, .vscode and /etc/opt/chrome, /etc/chromium, /etc/firefox policy paths) with the writing process path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management (Ansible, Puppet, Chef, Salt) deploying managed browser policies; enterprise provisioning scripts that pre-seed approved extensions; developer dotfile bootstrap scripts restoring VS Code extensions; golden-image build pipelines."
    tuning_guidance = "Add approved configuration-management and deployment binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Extend the writer-process list or path regex for browsers or IDEs specific to the client."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(\/\.config\/(google-chrome[^\/]*|chromium|BraveSoftware\/[^\/]+|microsoft-edge[^\/]*|vivaldi[^\/]*)\/.+\/Extensions\/|\/\.mozilla\/firefox\/[^\/]+\/extensions\/[^\/]+|\/\.vscode(-server|-oss)?\/extensions\/[^\/]+|\/(usr\/share|opt\/google)\/(google-chrome|chromium|chrome)\/extensions\/[^\/]+\.json$|\/etc\/(opt\/chrome|chromium|opt\/edge)\/policies\/managed\/[^\/]+\.json$|\/(usr\/lib|usr\/lib64|etc)\/(firefox|firefox-esr)\/(distribution|policies)\/[^\/]+\.json$)/ nocase
    $file.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|python[0-9.]*|perl|ruby|php|node|curl|wget|cp|mv|tar|unzip|install|tee|dd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1176")
    $primary_entity = array_distinct($file.principal.hostname)
    $extension_paths = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $writer_command_lines = array_distinct($file.principal.process.command_line)
    $acting_users = array_distinct($file.principal.user.userid)

  condition:
    $file
}
