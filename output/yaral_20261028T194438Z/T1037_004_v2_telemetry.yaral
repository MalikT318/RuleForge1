/*
  MITRE Technique : T1037.004 - RC Scripts
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:23:20.380727+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_004_ESXi_RC_Script_File_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of ESXi startup (RC) script files such as /etc/rc.local.d/local.sh, /etc/rc.local, or scripts under /etc/init.d. ESXi keeps most system files in memory and discards changes on reboot, so local.sh is one of the few ways to persist across reboots. Detection is on the resulting file state change, so it still fires when command-line logging is evaded or the editing tool is renamed."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.004"
    mitre_technique_name = "Boot or Logon Initialization Scripts: RC Scripts"
    log_prerequisites = "ESXi host file-integrity or audit telemetry forwarded to Chronicle and parsed into UDM FILE_MODIFICATION events with target.file.full_path populated. Shell, hostd and vmkernel syslog forwarding alone may not produce file events."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Legitimate host configuration by administrators (for example adding startup commands to local.sh), driver or VIB installation and patching that touches /etc/init.d, host profile or configuration management remediation, and automated provisioning during host build."
    tuning_guidance = "Add approved patching, provisioning and configuration management binaries to %global_allowed_admin_tools. Add named administrators who legitimately maintain local.sh to %global_allowed_admin_users. Review any modification outside a change window. The path regex can be narrowed to /etc/rc.local.d/ only if /etc/init.d is too noisy during patching."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/(rc\.local(\.d\/[^\/]+)?|rc\.d\/[^\/]+|init\.d\/[^\/]+)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1037.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)
    $acting_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
