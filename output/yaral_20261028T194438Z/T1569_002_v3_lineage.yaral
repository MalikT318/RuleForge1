/*
  MITRE Technique : T1569.002 - Service Execution
  Tactic(s)       : Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:11:42.120485+00:00
  Reference       : https://attack.mitre.org/techniques/T1569/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_002_Services_Exe_Spawns_Interpreter_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Service Control Manager (services.exe) directly spawning a shell, script interpreter, or common living-off-the-land proxy binary. Legitimate services normally run their own service executable (often under svchost.exe) rather than launching an interpreter straight from services.exe. This lineage is characteristic of PsExec-style temporary services, 'sc create' with a command-shell binPath, and remote service execution. The rule pivots on parent-child lineage rather than command-line content."
    mitre_tactic = "Execution"
    mitre_technique = "T1569.002"
    mitre_technique_name = "System Services: Service Execution"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry (EDR, Sysmon Event ID 1, or Security Event 4688 with parent process populated) that is normalised to UDM PROCESS_LAUNCH with principal.process (parent) and target.process (child) populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Third-party software or agents installed as services that wrap a batch or PowerShell launcher; RMM and patching agents running scripts via a service; legacy vendor applications whose service binPath is cmd.exe /c; software installers and uninstallers using temporary services; admins using PsExec for legitimate remote administration."
    tuning_guidance = "Add approved RMM, deployment, and PsExec-style tooling to %global_allowed_admin_tools (matched on the child image path). Add known service accounts to %global_allowed_service_accounts. Add approved script-launching hosts or processes to %global_allowed_script_hosts. If a specific legacy service is noisy, prefer allowlisting by the child executable name rather than by install path."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\services\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|regsvr32|rundll32|bitsadmin|certutil)\.exe$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1569.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
