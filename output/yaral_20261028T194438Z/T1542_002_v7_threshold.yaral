/*
  MITRE Technique : T1542.002 - Component Firmware
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:45:52.665347+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_002_Component_Firmware_Update_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated firmware flash or update command lines (storage firmware cmdlets, flash/write/update-firmware switches) on a single Windows host within 10 minutes. One firmware update can be routine, but a burst of flash activity suggests an attempt to modify component firmware (storage, NIC or peripheral controllers) to persist below the operating system."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.002"
    mitre_technique_name = "Pre-OS Boot: Component Firmware"
    log_prerequisites = "Requires Windows EDR process telemetry, Sysmon Event ID 1 or Windows Security Event 4688 with command-line auditing enabled. PowerShell script-block logging is recommended as supporting context."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Hardware vendor firmware update utilities, OEM driver and firmware update managers, datacenter or storage maintenance scripts, RMM or patching tools pushing SSD/NVMe/NIC firmware, and lab or hardware-refresh staging."
    tuning_guidance = "Add approved patching and hardware-maintenance tooling to %global_allowed_admin_tools (matched on the parent process path) and named admins to %global_allowed_admin_users. Raise the #proc threshold for estates with frequent scheduled firmware campaigns. Review the cmdlines in the outcome and alert on hosts outside maintenance windows."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(update-storagefirmware|(flash|write|update|upgrade|burn)[-_ ]?(fw|firmware|bios|nvram|rom)\b|(fw|firmware)[-_ ]?(flash|write|update|upgrade|burn)\b|\s[\/-]{1,2}(flash|flashfw|fwupdate|updatefw)\b)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1542.002")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
