/*
  MITRE Technique : T1543.005 - Container Service
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:58:04.581714+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_005_K8s_DaemonSet_Created_By_Unapproved_Principal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a Kubernetes DaemonSet through the control-plane API by a principal that is not an approved admin or automation identity. A DaemonSet schedules a pod on every node, including nodes added later, so adversaries use it for cluster-wide persistence and for privilege escalation onto hosts when the pod spec is privileged or mounts the host filesystem. This rule uses Kubernetes audit telemetry and does not duplicate command-line detections."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.005"
    mitre_technique_name = "Create or Modify System Process: Container Service"
    log_prerequisites = "Kubernetes API server audit logging must be enabled at Metadata level or higher and ingested into UDM, with create events for apps/v1 resources normalized to RESOURCE_CREATION. The requested resource path must be populated in target.resource.name and the caller identity in principal.user.userid."
    platform = "Containers"
    log_source = "container"
    false_positives = "Cluster add-on installation (CNI, CSI, logging, monitoring, or security agents), GitOps or CI/CD controllers deploying node agents, platform engineers rolling out legitimate node-level tooling, and managed-Kubernetes provider automation."
    tuning_guidance = "Add GitOps controllers, CI/CD deployers, and cluster add-on installer identities to %global_allowed_service_accounts. Add platform engineers to %global_allowed_admin_users. Add managed-service control-plane identities to %global_allowed_cloud_principals. Do not exclude by namespace, because attackers also deploy to kube-system to blend in."

  events:
    $k8s.metadata.event_type = "RESOURCE_CREATION"
    $k8s.target.resource.name = /\/daemonsets(\/|$)/ nocase
    $k8s.principal.user.userid != ""
    not $k8s.principal.user.userid in %global_allowed_service_accounts
    not $k8s.principal.user.userid in %global_allowed_admin_users
    not $k8s.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1543.005")
    $primary_entity = array_distinct($k8s.principal.user.userid)
    $daemonset_resource = array_distinct($k8s.target.resource.name)
    $source_ips = array_distinct($k8s.principal.ip)

  condition:
    $k8s
}
