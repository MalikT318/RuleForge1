/*
  MITRE Technique : T1561.001 - Disk Content Wipe
  Tactic(s)       : Impact
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:04:29.051825+00:00
  Reference       : https://attack.mitre.org/techniques/T1561/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1561_001_Network_Raw_Disk_Driver_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an HTTP GET for a kernel driver file (.sys) from an external destination, as seen at the proxy or firewall. Disk-wiping malware commonly stages a signed third-party raw-disk driver over the network to gain direct disk access before overwriting disk content. This is a network-side precursor signal for Disk Content Wipe, not proof of a wipe."
    mitre_tactic = "Impact"
    mitre_technique = "T1561.001"
    mitre_technique_name = "Disk Wipe: Disk Content Wipe"
    log_prerequisites = "Requires proxy or firewall logs with HTTP URL inspection (decrypted or cleartext) that populate target.url and network.http.method. Internal address space must be loaded in %rfc1918_internal."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate hardware vendors, OEM update utilities, GPU/chipset/peripheral driver downloads, Windows Update or driver catalog mirrors not yet in the allowlist, IT staff downloading drivers for imaging or deployment, and security or backup agents that fetch kernel components."
    tuning_guidance = "Add vendor and update domains to %global_allowed_domains. Exclude approved scanners or deployment sources by adding them to %global_allowed_scanners and extending the events block if needed. Raise severity or correlate with endpoint driver-load or raw disk access telemetry when the same source IP later shows mass process or file destruction. Verify that the proxy populates target.url, because without it this rule will not match."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.target.url = /\.sys(\?[^\/]*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1561.001")
    $primary_entity = array_distinct($net.principal.ip)
    $source_hostnames = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
