/*
  MITRE Technique : T1025 - Data from Removable Media
  Tactic(s)       : Collection
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:48:54.130080+00:00
  Reference       : https://attack.mitre.org/techniques/T1025
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1025_Removable_Media_Rapid_Enumeration_Copy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of shell or copy-utility launches on a single Windows host that list, read or copy content from non-system drive letters (D: through Z:), the typical location of USB or optical media. Any single command is benign, but five or more in ten minutes suggests automated collection from removable media."
    mitre_tactic = "Collection"
    mitre_technique = "T1025"
    mitre_technique_name = "Data from Removable Media"
    log_prerequisites = "Requires EDR process telemetry, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Users copying files from USB drives, software installation from optical media, IT staff imaging or provisioning workstations, login scripts and logon-mapped network drives (D: to Z:), backup and sync jobs, and data-loss-prevention or inventory scripts."
    tuning_guidance = "Add approved admin tooling to %global_allowed_admin_tools, backup software to %global_allowed_backup_processes, and automation accounts to %global_allowed_service_accounts. Raise the #proc threshold on hosts that use mapped network drives heavily. Use the $event_count, $users and $sample_commands outcome values for triage. Scope the drive-letter pattern to your environment's removable-media letters if they are known."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|xcopy|robocopy|tree|forfiles)\.exe$/ nocase
    $proc.target.process.command_line = /\b(dir|copy|xcopy|robocopy|tree|type|move|get-childitem|gci|forfiles)\b/ nocase
    $proc.target.process.command_line = /(^|[\s"'=])[d-z]:(\\|\s|"|'|$)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(re.regex($proc.target.process.file.full_path, /(?i)\\(xcopy|robocopy)\.exe$/), 70, 50))
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1025")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $sample_commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 5
}
