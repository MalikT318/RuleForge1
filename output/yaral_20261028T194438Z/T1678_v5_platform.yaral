/*
  MITRE Technique : T1678 - Delay Execution
  Tactic(s)       : Stealth
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:25:06.046322+00:00
  Reference       : https://attack.mitre.org/techniques/T1678
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1678_Cmd_Delay_Then_Chained_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a cmd.exe command line that uses a native delay primitive (ping count, timeout, or choice with a timer of 10 or more) and then chains into a delete, copy, or execution command. This is the typical pattern of malware and droppers that wait out sandbox time limits, or wait for the parent to exit, before launching a payload or self-deleting. Written for Windows only because the delay primitives are native Windows binaries. The requested Linux/macOS/cloud pivot was not applied, as the mandatory platform and log source for this rule are Windows."
    mitre_tactic = "Stealth"
    mitre_technique = "T1678"
    mitre_technique_name = "Delay Execution"
    log_prerequisites = "Requires EDR process telemetry, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters that wait before restarting a service or deleting a temp file, legacy batch and logon scripts using ping or timeout as a sleep, IT deployment scripts, and developer build scripts."
    tuning_guidance = "Add approved deployment or RMM parent processes to %global_allowed_admin_tools and approved script-running parents to %global_allowed_script_hosts. If installer noise is high, raise the minimum timer digits in the delay regex or narrow the chained-command list."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\cmd\.exe$/ nocase
    $proc.target.process.command_line = /\b(ping(\.exe)?\s+[^&]*-n\s+\d{2,}|timeout(\.exe)?\s+[^&]*\/t\s+\d{2,}|choice(\.exe)?\s+[^&]*\/t\s+\d{2,})/ nocase
    $proc.target.process.command_line = /&\s*(del|erase|start|move|copy|rundll32|regsvr32|powershell|pwsh|wscript|cscript|mshta)\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1678")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
