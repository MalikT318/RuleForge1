/*
  MITRE Technique : T1558.005 - Ccache Files
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:47:26.295209+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_005_Linux_Ccache_File_Copy_Or_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a file-reading, copying, encoding or transfer utility launched with a Kerberos credential cache (ccache) path as an argument, such as krb5cc_<uid> in /tmp or /run/user, the SSSD ccache store, or gssproxy client files. Adversaries copy or exfiltrate these files to reuse the victim's Kerberos tickets (Pass-the-Ticket). Legitimate Kerberos tooling (kinit, klist, kdestroy) is not in the matched utility set."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.005"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Ccache Files"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records normalised to UDM PROCESS_LAUNCH with full command-line capture."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators backing up or troubleshooting Kerberos caches, backup or configuration-management agents copying /tmp or /var/lib/, support scripts that cat or tar ccache files for diagnostics, and developers testing Kerberos-authenticated applications."
    tuning_guidance = "Add approved parent tooling (backup, configuration management, RMM) to %global_allowed_admin_tools, add automation accounts to %global_allowed_service_accounts, and add security agents to %global_allowed_security_tools. Review hosts that legitimately hold many ccache files, such as jump hosts and Kerberized application servers."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(cp|mv|cat|base64|xxd|od|hexdump|dd|tar|zip|gzip|scp|sftp|rsync|curl|wget|nc|ncat|socat|openssl|python[0-9.]*|perl|ruby)$/ nocase
    $proc.target.process.command_line = /(krb5cc|krb5\.ccache|\/sss\/db\/ccache_|\/gssproxy\/clients\/)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1558.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
