/*
  MITRE Technique : T1218.009 - Regsvcs/Regasm
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:53:06.811511+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_009_Regsvcs_Regasm_External_Network_Then_Child_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects Regsvcs or Regasm making an outbound connection to an external address and then spawning a child process on the same host within ten minutes. These .NET registration utilities do not normally use the network or launch other programs. This sequence indicates a malicious assembly running through [ComRegisterFunction] or [ComUnregisterFunction] to fetch a payload or launch a follow-on stage. It relies on network and process-lineage behaviour, not on command-line arguments."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.009"
    mitre_technique_name = "System Binary Proxy Execution: Regsvcs/Regasm"
    log_prerequisites = "Requires Windows endpoint telemetry that provides both network connections (with the initiating process path) and process launches with parent process path, for example EDR or Sysmon Event IDs 1 and 3."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developer workstations or build servers registering .NET assemblies that download dependencies. Installers or deployment tooling that run regasm/regsvcs and call back to vendor licensing or telemetry endpoints. Console-host child processes if not excluded."
    tuning_guidance = "Add approved deployment or installer child processes to %global_allowed_admin_tools. Add known-good external vendor destinations to your environment-specific exclusions. Exclude build servers by host-level scoping at the SOAR or rule-exception layer. Extend the child-process exclusion regex if other benign helper processes appear."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(regasm|regsvcs)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    $net.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(regasm|regsvcs)\.exe$/ nocase
    not $proc.target.process.file.full_path = /\\(conhost|regasm|regsvcs)\.exe$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $net.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1218.009")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $child_processes = array_distinct($proc.target.process.file.full_path)
    $child_command_lines = array_distinct($proc.target.process.command_line)
    $affected_users = array_distinct($proc.principal.user.userid)
    $network_event_count = count($net.metadata.id)

  condition:
    $net and $proc
}
