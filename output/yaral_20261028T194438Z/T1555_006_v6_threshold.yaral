/*
  MITRE Technique : T1555.006 - Cloud Secrets Management Stores
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:01:56.514600+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_006_Cloud_Secret_Retrieval_Volume_Per_Identity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single cloud identity retrieved secret values from a cloud secrets management store at high volume within 10 minutes. One secret read is routine, but bulk retrieval by one identity is consistent with credential harvesting after account compromise or abuse of an over-privileged workload role."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.006"
    mitre_technique_name = "Credentials from Password Stores: Cloud Secrets Management Stores"
    log_prerequisites = "Cloud control-plane audit logs with data-plane secret access events enabled (for example CloudTrail secret read events, Key Vault diagnostic logs, GCP Data Access audit logs for Secret Manager) and ingested into UDM as USER_RESOURCE_ACCESS with metadata.product_event_type populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "CI/CD pipelines and deployment automation fetching many secrets at release time; application cold starts or autoscaling events where many instances fetch secrets under one role; secret rotation or inventory tooling; configuration-management and migration jobs; administrators performing planned secret audits."
    tuning_guidance = "Add automation and workload identities to %global_allowed_service_accounts, approved cloud service principals to %global_allowed_cloud_principals, and named administrators to %global_allowed_admin_users. Raise the #cloud threshold (default 10) for tenants with chatty application roles. Confirm that the product_event_type values in the regex match the tenant's parser output."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /(GetSecretValue|BatchGetSecretValue|AccessSecretVersion|secrets\.versions\.access|SecretGet|SecretList|vaults\/secrets\/(read|getsecret))/ nocase
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1555.006")
    $primary_entity = array_distinct($user)
    $event_count = count($cloud.metadata.id)
    $secrets_accessed = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)
    $api_actions = array_distinct($cloud.metadata.product_event_type)

  condition:
    #cloud >= 10
}
