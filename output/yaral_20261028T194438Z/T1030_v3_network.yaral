/*
  MITRE Technique : T1030 - Data Transfer Size Limits
  Tactic(s)       : Exfiltration
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:51:45.951715+00:00
  Reference       : https://attack.mitre.org/techniques/T1030
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1030_Network_Outbound_Just_Under_Size_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a single outbound connection to an external destination where the bytes sent fall in a narrow band just under a common 1 MiB transfer or DLP alerting threshold, while almost nothing is received back. This one-way, size-capped upload pattern is characteristic of data exfiltrated in fixed-size chunks to stay below network transfer thresholds. Each chunk is evaluated on its own, so repeated chunks produce repeated alerts for the same source."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1030"
    mitre_technique_name = "Data Transfer Size Limits"
    log_prerequisites = "Requires firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with network.sent_bytes and network.received_bytes populated (session-close or periodic accounting logs)."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Cloud backup or sync clients that upload in 1 MiB blocks, telemetry and crash-report uploaders, software that chunks API uploads to SaaS platforms, and video or conferencing uploads. Legitimate one-way upload streams of this size also trigger it."
    tuning_guidance = "Add known-good SaaS and backup destinations to %global_allowed_domains. Adjust the sent_bytes band to match the client's DLP or egress alert threshold (for example 5 MiB). Because the rule fires per connection, consider routing alerts to a SOAR step that counts repeated hits per source IP before escalating. Confirm %rfc1918_internal is populated for the tenant."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.sent_bytes >= 983040
    $net.network.sent_bytes <= 1048576
    $net.network.received_bytes < 10240
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1030")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $bytes_sent = max($net.network.sent_bytes)

  condition:
    $net
}
