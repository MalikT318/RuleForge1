/*
  MITRE Technique : T1571 - Non-Standard Port
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:16:57.660472+00:00
  Reference       : https://attack.mitre.org/techniques/T1571
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1571_NonStandard_Port_Web_Protocol_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Perimeter telemetry identifies HTTP or HTTPS application traffic leaving the network for an external destination on a port not normally used for web traffic (not 80, 443, 8080 or 8443). Adversaries use protocol and port mismatches such as HTTPS over 587 or 8088 to evade port-based filtering and muddle parsing. Relies on the firewall's application identification rather than on the port, and does not depend on the initiating process."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1571"
    mitre_technique_name = "Non-Standard Port"
    log_prerequisites = "Firewall or proxy logs normalised to UDM NETWORK_CONNECTION with network.application_protocol populated by application identification or deep packet inspection. Not suitable for firewalls that only classify by port number."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Vendor software and SaaS agents using custom web ports, developer or test web servers exposed externally, web-based management consoles on custom ports, VPN or remote-access gateways tunnelling over HTTPS, and legitimate APIs on alternate ports such as 8000, 8444 or 9443."
    tuning_guidance = "Add known-good external destinations to %global_allowed_domains. Add approved internal sources, such as proxies and management hosts, to %global_allowed_mgmt_sources. Extend the allowed port list in the rule with additional approved web ports per client. Per-client baselining is recommended: review the top destination port and domain pairs for a week before enabling alerting."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.network.application_protocol = "HTTP" or $net.network.application_protocol = "HTTPS")
    $net.target.port > 0
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 8080
    $net.target.port != 8443
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1571")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $application_protocols = array_distinct($net.network.application_protocol)

  condition:
    $net
}
