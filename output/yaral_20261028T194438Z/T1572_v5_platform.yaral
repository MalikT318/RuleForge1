/*
  MITRE Technique : T1572 - Protocol Tunneling
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:20:07.565857+00:00
  Reference       : https://attack.mitre.org/techniques/T1572
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1572_Linux_Egress_SSH_NonStandard_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Perimeter telemetry shows SSH-identified traffic leaving the internal network for an external destination on a non-standard port. Linux servers commonly originate this traffic when SSH port forwarding or SOCKS tunnelling is used to reach C2 or to pivot, and a non-default port suggests an attempt to evade port-based egress filtering. Detection relies only on firewall or proxy application identification, so it does not depend on endpoint command lines."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1572"
    mitre_technique_name = "Protocol Tunneling"
    log_prerequisites = "Firewall or proxy logs normalised to UDM NETWORK_CONNECTION with network.application_protocol populated by the device's application identification (layer-7 inspection enabled) and the egress direction logged."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Administrators or developers using SSH on a custom port to reach external git hosts, partner or vendor bastions, or cloud-hosted jump boxes. Managed file-transfer (SFTP) jobs to external partners on non-default ports. Approved remote support or management sources."
    tuning_guidance = "Add known admin jump hosts and management sources to %global_allowed_mgmt_sources and authorised testing sources to %global_allowed_scanners. Confirm application identification is enabled on the egress policy, since otherwise the rule will not fire. For clients with legitimate external SSH on custom ports, scope exceptions by source host or maintain the approved source list. Consider raising severity for server subnets that should have no SSH egress."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.application_protocol = "SSH"
    $net.target.port != 22
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1572")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
