/*
  MITRE Technique : T1123 - Audio Capture
  Tactic(s)       : Collection
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:29:12.457846+00:00
  Reference       : https://attack.mitre.org/techniques/T1123
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1123_Microphone_Access_Registry_Tampering {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a non-standard process changing Windows microphone privacy state in the registry. This covers the CapabilityAccessManager ConsentStore microphone 'Value' being set to Allow, and writes to the AppPrivacy LetAppsAccessMicrophone policy. Adversaries do this to enable silent audio capture without a user prompt. It works at the registry state-change layer, so it fires regardless of how the change was made (reg.exe, PowerShell, .NET, direct API) or whether command-line logging is evaded."
    mitre_tactic = "Collection"
    mitre_technique = "T1123"
    mitre_technique_name = "Audio Capture"
    log_prerequisites = "Requires Windows registry modification telemetry (EDR or Sysmon Event ID 12/13) with the registry key, value name and writing process populated. Registry value data is used for the ConsentStore branch, so it should be populated where available."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows Settings app and Group Policy processing (excluded by executable name), enterprise MDM or RMM tooling that deploys privacy baselines, conferencing or softphone installers that pre-grant microphone consent, and VDI or image-build scripts that configure privacy settings."
    tuning_guidance = "Add approved deployment and MDM binaries to %global_allowed_admin_tools, EDR agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. During a rollout of privacy baselines, expect the LetAppsAccessMicrophone branch to fire on managing hosts; tune by writer process rather than by key. If the ConsentStore branch is noisy on a client and value data is not populated, confirm the field mapping before relaxing the Allow condition."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      (
        $reg.target.registry.registry_key = /\\CapabilityAccessManager\\ConsentStore\\microphone(\\|$)/ nocase
        $reg.target.registry.registry_value_name = "Value" nocase
        $reg.target.registry.registry_value_data = /^allow$/ nocase
      )
      or
      (
        $reg.target.registry.registry_key = /\\Policies\\Microsoft\\Windows\\AppPrivacy$/ nocase
        $reg.target.registry.registry_value_name = "LetAppsAccessMicrophone" nocase
      )
    )
    not $reg.principal.process.file.full_path = /\\(SystemSettings|svchost)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1123")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_name)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $acting_users = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
