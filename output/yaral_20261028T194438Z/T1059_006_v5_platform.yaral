/*
  MITRE Technique : T1059.006 - Python
  Tactic(s)       : Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:15:21.394916+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_006_ESXi_Python_Script_Staged_In_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a Python script (.py) in world-writable or staging locations on an ESXi host (/tmp, /var/tmp, /dev/shm, /scratch, /var/run, or a datastore under /vmfs/volumes). ESXi administration rarely drops Python scripts into these paths. Attackers and ransomware operators do so to stage tooling for later execution through the ESXi shell. This rule does not match process command lines, so it complements existing PROCESS_LAUNCH detections."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.006"
    mitre_technique_name = "Command and Scripting Interpreter: Python"
    log_prerequisites = "ESXi host telemetry forwarded to Chronicle (hostd, shell, and file-operation or audit events) and parsed to FILE_CREATION with target.file.full_path populated. Standard ESXi syslog without file-operation auditing will not produce these events."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorised admin or automation scripts staged to /tmp or a datastore, lifecycle or patch remediation workflows that unpack helper scripts, support bundle collection, and third-party backup or monitoring agents that stage Python helpers."
    tuning_guidance = "Add approved automation accounts to %global_allowed_service_accounts, named administrators to %global_allowed_admin_users, and approved deployment or patching tooling to %global_allowed_admin_tools. If datastore-based script repositories are legitimate, narrow the vmfs/volumes branch of the path regex or exclude the writing process."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|scratch|var\/run|vmfs\/volumes)\/.*\.py$/ nocase
    $file.principal.hostname != ""
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1059.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $script_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)
    $writer_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
