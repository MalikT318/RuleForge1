/*
  MITRE Technique : T1176.002 - IDE Extensions
  Tactic(s)       : Persistence
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:30:04.425024+00:00
  Reference       : https://attack.mitre.org/techniques/T1176/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_002_VSIX_Download_Then_External_SSH {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A host downloads an IDE extension package (.vsix) through the perimeter and, within ten minutes, opens an outbound SSH connection to an external address. This pattern fits a newly installed IDE extension, malicious or a benign Remote-SSH extension abused for tunnelling, establishing persistent remote access."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176.002"
    mitre_technique_name = "Software Extensions: IDE Extensions"
    log_prerequisites = "Requires proxy or firewall logs normalised to NETWORK_HTTP with target.url populated (TLS inspection is needed to see URLs for HTTPS traffic), plus NETWORK_CONNECTION logs with target.port and principal.ip populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Developers installing legitimate extensions and then SSHing to external servers or cloud VMs, DevOps and engineering workstations using Remote-SSH, and software teams that mirror extensions internally."
    tuning_guidance = "Add known-good extension distribution hosts to %global_allowed_domains. Add approved jump hosts and developer subnets' source addresses to %global_allowed_mgmt_sources. If the environment has no TLS inspection, the HTTP leg will rarely match and the rule needs a different first-stage signal."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\.vsix($|[?#])/ nocase
    $http.network.http.method = "GET" nocase
    not $http.target.hostname in %global_allowed_domains
    not $http.target.ip in %rfc1918_internal
    $http.principal.ip = $src_ip

    $ssh.metadata.event_type = "NETWORK_CONNECTION"
    $ssh.target.port = 22
    not $ssh.target.ip in %rfc1918_internal
    not $ssh.principal.ip in %global_allowed_mgmt_sources
    $ssh.principal.ip = $src_ip

    $http.metadata.event_timestamp.seconds <= $ssh.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1176.002")
    $primary_entity = array_distinct($src_ip)
    $extension_urls = array_distinct($http.target.url)
    $ssh_destination_ips = array_distinct($ssh.target.ip)
    $ssh_connection_count = count($ssh.metadata.id)

  condition:
    $http and $ssh
}
