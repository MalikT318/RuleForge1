/*
  MITRE Technique : T1528 - Steal Application Access Token
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:27:25.683270+00:00
  Reference       : https://attack.mitre.org/techniques/T1528
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1528_SaaS_OAuth_Consent_Or_App_Credential_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects configuration changes in the tenant identity plane that give an application standing access to user data or API tokens: OAuth consent grants, delegated permission grants, app role assignments, and new secrets or certificates on application or service principal objects. These are the resulting state changes when an adversary steals or mints application access tokens, such as through illicit consent phishing or by planting credentials on an existing app registration. The rule works on the tenant configuration change, not on any endpoint command line."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1528"
    mitre_technique_name = "Steal Application Access Token"
    log_prerequisites = "Microsoft 365 unified audit log with Entra ID (Azure AD) directory audit events ingested and normalised to UDM SETTING_MODIFICATION, with the audit operation name in metadata.product_event_type."
    platform = "SaaS"
    log_source = "m365"
    false_positives = "Legitimate IT-led onboarding of third-party SaaS apps, user consent to approved apps, developers rotating app secrets or certificates, automated secret-rotation pipelines, and identity governance tooling."
    tuning_guidance = "Add approved admin accounts to %global_allowed_admin_users and automation or secret-rotation identities to %global_allowed_cloud_principals. Raise severity when the grant is made by a non-admin user or from an unfamiliar source IP. If the client's connector uses different operation names, adjust the regex on metadata.product_event_type."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(consent to application|add oauth2permissiongrant|add service principal credentials|add app role assignment grant|update application.{0,5}certificates and secrets)/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1528")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $operation = array_distinct($setting.metadata.product_event_type)
    $target_app = array_distinct($setting.target.application)
    $source_ips = array_distinct($setting.principal.ip)

  condition:
    $setting
}
