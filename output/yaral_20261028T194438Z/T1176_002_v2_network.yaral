/*
  MITRE Technique : T1176.002 - IDE Extensions
  Tactic(s)       : Persistence
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:28:50.392783+00:00
  Reference       : https://attack.mitre.org/techniques/T1176/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_002_VSIX_Extension_Download_Unapproved_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP request for an IDE extension package (.vsix) from an external host that is not in the approved known-good domain list. This is the network-side signature of a malicious or side-loaded IDE extension being fetched outside the official marketplace or an approved internal mirror. Variant 2: network-side observation."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176.002"
    mitre_technique_name = "Software Extensions: IDE Extensions"
    log_prerequisites = "Requires proxy or firewall logs with HTTP URL visibility (TLS inspection or explicit proxy) normalised to UDM NETWORK_HTTP, with target.url and target.hostname populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Developers installing extensions from vendor-hosted or GitHub release pages, internal extension mirrors not yet allow-listed, CI/CD build agents that package or fetch .vsix files, and marketplace CDN hosts not yet in the allowed domain list."
    tuning_guidance = "Add official marketplace and CDN domains, approved internal extension mirrors and vendor sites to %global_allowed_domains. Without these entries, legitimate marketplace downloads will alert, so populate the list per tenant before enabling. Consider restricting to developer subnets if network segmentation allows."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\.vsix(\?|#|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1176.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_urls = array_distinct($net.target.url)

  condition:
    $net
}
