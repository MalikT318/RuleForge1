/*
  MITRE Technique : T1565 - Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:37:30.256803+00:00
  Reference       : https://attack.mitre.org/techniques/T1565
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_Script_Host_External_Database_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a scripting host or native SQL client process (PowerShell, Windows Script Host, mshta, sqlcmd, osql, bcp) opening an outbound connection to a well-known database service port on a non-internal address. Interactive or scripted access to an external data store is a network-side indicator of remote data insertion, deletion or alteration, which is characteristic of Data Manipulation. The connection alone does not prove modification, so treat this as a triage lead and review the host's process and file activity."
    mitre_tactic = "Impact"
    mitre_technique = "T1565"
    mitre_technique_name = "Data Manipulation"
    log_prerequisites = "Requires EDR or Sysmon-equivalent network connection telemetry with the initiating process path populated (Sysmon Event ID 3 or equivalent)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "DBA and developer workstations running sqlcmd or PowerShell database modules against cloud-hosted databases, ETL and reporting scripts, scheduled maintenance jobs, vendor support sessions, and software deployment scripts that call SaaS database endpoints."
    tuning_guidance = "Add approved DBA and automation parent processes to %global_allowed_script_hosts or %global_allowed_admin_tools. Add service accounts that run sanctioned data jobs to %global_allowed_service_accounts. Add sanctioned external database endpoints to %global_allowed_domains. If client volume is high, restrict the port list to the database engines actually in use and raise severity for servers with no business need for outbound database access."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|sqlcmd|osql|bcp)\.exe$/ nocase
    (
      $net.target.port = 1433 or
      $net.target.port = 1521 or
      $net.target.port = 3306 or
      $net.target.port = 5432 or
      $net.target.port = 27017
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_script_hosts
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1565")
    $primary_entity = array_distinct($net.principal.hostname)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $initiating_user = array_distinct($net.principal.user.userid)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
