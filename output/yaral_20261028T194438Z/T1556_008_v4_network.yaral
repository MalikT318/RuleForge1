/*
  MITRE Technique : T1556.008 - Network Provider DLL
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:26:06.708019+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_008_Network_Provider_Host_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Windows network provider notification host (mpnotify.exe) initiating an outbound connection to a non-internal address. mpnotify.exe only relays logon credentials to registered network provider DLLs over local RPC and has no legitimate reason to talk to external hosts. A malicious network provider DLL (NPLogonNotify credential harvester) runs inside this process, so external traffic from it is a strong indicator of cleartext credential exfiltration."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.008"
    mitre_technique_name = "Modify Authentication Process: Network Provider DLL"
    log_prerequisites = "Requires Windows endpoint network telemetry with process attribution (EDR network events or Sysmon Event ID 3) populating principal.process.file.full_path and target.ip. Populate %rfc1918_internal with the internal address space, including loopback if it is not already covered."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare. Possible sources are EDR or proxy agents that hook mpnotify.exe and relay telemetry, VPN or SSO credential providers that run in-process and contact a cloud endpoint during logon, and loopback or link-local addresses missing from %rfc1918_internal."
    tuning_guidance = "Confirm %rfc1918_internal covers all client internal ranges, including loopback and link-local. If a client uses a third-party credential provider that legitimately calls out during logon, scope an exception by that client's environment rather than by adding to this rule. Where internal staging hosts are a concern, run a variant without the internal exclusion. Review hits together with registry changes under the NetworkProvider\\Order and Services\\<provider>\\NetworkProvider keys on the same host."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\mpnotify\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1556.008")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $logon_users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
