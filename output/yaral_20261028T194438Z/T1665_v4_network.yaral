/*
  MITRE Technique : T1665 - Hide Infrastructure
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:05:22.903853+00:00
  Reference       : https://attack.mitre.org/techniques/T1665
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1665_Linux_DNS_Long_Encoded_Label_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects DNS queries to external domains whose subdomain label is abnormally long or is an encoded or hash-like string (long hex, or base32/base64-style). Adversaries hiding C2 infrastructure behind obfuscated, algorithmically generated or per-victim unique hostnames, and tunnelling C2 data over DNS, produce this pattern. Linux hosts that query such names warrant review. The rule uses resolver telemetry only and does not depend on endpoint process fields."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1665"
    mitre_technique_name = "Hide Infrastructure"
    log_prerequisites = "DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name populated. Linux client hosts should be identifiable by principal.hostname."
    platform = "Linux"
    log_source = "dns"
    false_positives = "CDN and cloud-provider generated hostnames, DKIM/DMARC and other email-authentication lookups, content-addressed storage and container registries, software update services using hashed subdomains, DNS-based blocklist lookups, and security products doing DNS-based file reputation lookups."
    tuning_guidance = "Add known-good registered domains to %global_allowed_domains (apex domain such as example.com). Add authorised scanner sources to %global_allowed_scanners and approved resolver or forwarder hosts to %global_allowed_mgmt_sources if they generate noisy lookups. Tune the label-length thresholds (45 or more characters, 32 or more hex characters) per environment after reviewing baseline volume."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(?i)(^|\.)([0-9a-f]{32,}|[a-z0-9_-]{45,})\.[a-z0-9-]+(\.[a-z0-9-]+)*\.?$/
    not $dns.network.dns.questions.name = /(?i)\.(arpa|local|localdomain|internal|lan|home|corp)\.?$/
    not $dns.network.dns.questions.name = /(?i)^_[a-z0-9-]+\._(tcp|udp|tls)\./
    $apex = re.capture($dns.network.dns.questions.name, `(?i)([a-z0-9-]+\.[a-z0-9-]+)\.?$`)
    not $apex in %global_allowed_domains
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.network.dns.answers.data in %rfc1918_internal
    not $dns.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1665")
    $primary_entity = array_distinct($dns.principal.hostname)
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $apex_domains = array_distinct($apex)
    $resolver_ips = array_distinct($dns.target.ip)

  condition:
    $dns
}
