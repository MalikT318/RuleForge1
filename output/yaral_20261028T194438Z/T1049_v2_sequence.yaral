/*
  MITRE Technique : T1049 - System Network Connections Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:39:23.792546+00:00
  Reference       : https://attack.mitre.org/techniques/T1049
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1049_Linux_Netconn_Discovery_Then_Staging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A shell, interpreter or web-server process launches a network-connection listing utility (netstat, ss, lsof, conntrack) with connection-enumeration flags. The same user on the same host then creates a file in a world-writable staging directory (/tmp, /var/tmp, /dev/shm) via a shell or interpreter within 10 minutes. This indicates connection discovery whose output is being captured for review or exfiltration. It adds sequence and staging coverage on top of single-command detections."
    mitre_tactic = "Discovery"
    mitre_technique = "T1049"
    mitre_technique_name = "System Network Connections Discovery"
    log_prerequisites = "Requires Linux EDR or auditd (execve and file-creation telemetry) with parent process, user and hostname populated in UDM."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Admins troubleshooting connectivity and saving output to /tmp; monitoring or inventory agents run via shell wrappers; configuration management runs (Ansible, Puppet, Chef); support scripts that collect diagnostics bundles."
    tuning_guidance = "Add approved IT tooling parents to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and approved script-running processes to %global_allowed_script_hosts. If still noisy, restrict the staging file regex to specific extensions, or require a non-interactive parent (web server or interpreter only)."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(netstat|ss|lsof|conntrack)$/ nocase
    $proc.target.process.command_line = /(\s-[a-z]*[antupl][a-z]*(\s|$)|\s-i(\s|$|[a-z0-9:@])|--(tcp|udp|all|numeric|processes|listening))/ nocase
    $proc.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|python[0-9.]*|perl|php[0-9.]*|ruby|node|java|nginx|httpd|apache2|php-fpm[0-9.]*)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname
    $proc.principal.user.userid = $user

    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/[^\/]+$/ nocase
    $file.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|python[0-9.]*|perl|php[0-9.]*|ruby|node)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname
    $file.principal.user.userid = $user

    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname, $user over 10m

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1049")
    $primary_entity = array_distinct($hostname)
    $acting_user = array_distinct($user)
    $discovery_commands = array_distinct($proc.target.process.command_line)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $staged_files = array_distinct($file.target.file.full_path)
    $discovery_count = count($proc.metadata.id)

  condition:
    $proc and $file
}
