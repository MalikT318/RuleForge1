/*
  MITRE Technique : T1027.017 - SVG Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:05:43.582184+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/017
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_017_SVG_Referred_Payload_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external HTTP request for an archive, disk image, executable or script file where the referring page is an SVG file. This is the network signature of an SVG with an embedded script that downloads a second-stage payload, as opposed to assembling it locally. It is independent of process command lines and endpoint telemetry."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.017"
    mitre_technique_name = "Obfuscated Files or Information: SVG Smuggling"
    log_prerequisites = "Requires web proxy or firewall HTTP logs normalised to NETWORK_HTTP with target.url and network.http.referral_url populated. TLS inspection is needed for HTTPS traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Web applications that render an SVG viewer or diagram page and offer file downloads (documentation portals, design or diagramming tools, CMS and asset libraries). Software vendor sites that link installers from an SVG-based page."
    tuning_guidance = "Add known-good download hosts to %global_allowed_domains. Check that the proxy populates the referrer field. If principal.hostname is empty on perimeter logs, pivot on the source_ips outcome. Narrow the payload extension list if a client has legitimate SVG-driven download workflows."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.referral_url = /\.svg([?#].*)?$/ nocase
    $net.target.url = /\.(zip|rar|7z|iso|img|vhd|vhdx|cab|exe|msi|dll|scr|js|jse|vbs|vbe|hta|wsf|lnk)([?#].*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1027.017")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $requested_urls = array_distinct($net.target.url)
    $referring_urls = array_distinct($net.network.http.referral_url)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
