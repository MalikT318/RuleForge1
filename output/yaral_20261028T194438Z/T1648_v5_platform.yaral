/*
  MITRE Technique : T1648 - Serverless Execution
  Tactic(s)       : Execution
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:50:03.332579+00:00
  Reference       : https://attack.mitre.org/techniques/T1648
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1648_Cloud_Serverless_Function_Created_By_Interactive_Principal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a serverless function, function URL, event-source trigger or workflow in a cloud control plane by a principal that is not an approved automation identity. Adversaries create serverless code to execute arbitrary commands, mine crypto, run under a more privileged attached role, or persist through event triggers. This rule targets the control-plane creation event and does not depend on function names, runtimes or code content."
    mitre_tactic = "Execution"
    mitre_technique = "T1648"
    mitre_technique_name = "Serverless Execution"
    log_prerequisites = "Cloud control-plane audit logs (management or admin activity events) ingested and parsed to UDM with metadata.product_event_type populated. Function, trigger and workflow create APIs must be mapped to RESOURCE_CREATION."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Developers deploying functions manually in non-production accounts, CI/CD pipelines or infrastructure-as-code roles not yet in the allowlists, platform teams onboarding new serverless workloads, and managed services that create helper functions during provisioning."
    tuning_guidance = "Add CI/CD, deployment and infrastructure-as-code identities to %global_allowed_service_accounts. Add approved federated or service principals to %global_allowed_cloud_principals. Add named platform engineers to %global_allowed_admin_users. Raise severity for production accounts or projects at the SOAR layer by using the $function_names and $source_ips outcome values. Correlate with role-attachment or PassRole activity from the same principal as a follow-on investigation."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /(CreateFunction|CreateEventSourceMapping|functions\.(create|insert)|sites\/functions\/write|workflows\.create|CreateStateMachine)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1648")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $function_names = array_distinct($cloud.target.resource.name)
    $api_calls = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
