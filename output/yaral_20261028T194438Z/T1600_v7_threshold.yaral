/*
  MITRE Technique : T1600 - Weaken Encryption
  Tactic(s)       : Defense Impairment
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:05:43.636756+00:00
  Reference       : https://attack.mitre.org/techniques/T1600
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_Cleartext_Mgmt_Protocol_Volume_Per_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single source opens many connections to cleartext management or transfer ports (Telnet, TFTP) within ten minutes. Each connection is individually common, but sustained volume suggests a network device's encryption has been weakened or disabled (for example SSH or crypto hardware disabled, or a modified image forcing plaintext management), or an adversary is exploiting the resulting cleartext channel."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1600"
    mitre_technique_name = "Weaken Encryption"
    log_prerequisites = "Firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip and target.port populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legacy equipment or OT/ICS gear that only supports Telnet or TFTP, firmware or config backup jobs using TFTP, PXE or network boot services, vulnerability scanners and inventory tools, and lab or staging networks."
    tuning_guidance = "Add approved management jump hosts and config-backup servers to %global_allowed_mgmt_sources. Add authorised scanner sources to %global_allowed_scanners. Raise the #net threshold in environments with legacy plaintext devices, and scope the sensor to perimeter segments if internal TFTP is routine."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 23 or $net.target.port = 2323 or $net.target.port = 69)
    $net.principal.ip = $src_ip
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(if($net.target.port = 23 or $net.target.port = 2323, 70, 55))
    $mitre_technique_id = array_distinct("T1600")
    $primary_entity = array_distinct($src_ip)
    $event_count = count($net.metadata.id)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 10
}
