/*
  MITRE Technique : T1505 - Server Software Component
  Tactic(s)       : Persistence
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:25:02.556714+00:00
  Reference       : https://attack.mitre.org/techniques/T1505
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_ESXi_Unsigned_VIB_Acceptance_Level_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi host configuration change that lowers the software acceptance level to community or unsigned, or forces a VIB install while skipping signature checks. Adversaries use this to install a malicious VIB, which is a persistent server software component that survives reboots and runs inside the hypervisor. This rule uses host configuration change telemetry (SETTING_MODIFICATION), not process command lines."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505"
    mitre_technique_name = "Server Software Component"
    log_prerequisites = "ESXi hostd and esxupdate logs forwarded via syslog and parsed to UDM SETTING_MODIFICATION events, with the log message text in metadata.description."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Lab or test hosts that run community-supported drivers (for example, community NIC or storage drivers on unsupported hardware). Admins applying vendor VIBs with the force option during troubleshooting. Lifecycle management tooling temporarily changing acceptance level during patching."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation or lifecycle accounts to %global_allowed_service_accounts. If the parser places the message text in a different field, adjust the metadata.description match. Consider scoping lab hosts out through client-specific exceptions."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    (
      $setting.metadata.description = /acceptance\s*-?level.{0,80}(community|communitysupported)/ nocase or
      $setting.metadata.description = /(vib|software).{0,60}(install|update).{0,120}(no-sig-check|--force|communitysupported)/ nocase
    )
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1505")
    $primary_entity = array_distinct($setting.principal.hostname)
    $acting_user = array_distinct($setting.principal.user.userid)
    $change_detail = array_distinct($setting.metadata.description)

  condition:
    $setting
}
