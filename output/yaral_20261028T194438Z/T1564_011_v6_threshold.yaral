/*
  MITRE Technique : T1564.011 - Ignore Process Interrupts
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:30:53.243039+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_011_Linux_Excessive_Hangup_Immune_Launches {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of hangup-immune process launches (nohup or setsid binaries) on a single Linux host within 10 minutes. A single launch is routine admin behaviour. Repeated launches in a short window suggest scripted detachment of payloads, miners or reverse shells so that they survive session logoff or C2 drops. Severity scales upward in outcome when the launched command references world-writable staging directories."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.011"
    mitre_technique_name = "Ignore Process Interrupts"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records normalised to UDM PROCESS_LAUNCH with target.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management and deployment runs (Ansible, Puppet, Chef) starting background jobs; CI/CD agents; admins running batch jobs over SSH; init or wrapper scripts that daemonise helpers with setsid; cron-driven maintenance scripts using nohup."
    tuning_guidance = "Add approved automation parents to %global_allowed_script_hosts, deployment or patching tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Raise the #proc threshold for hosts such as build servers or batch nodes that legitimately detach many jobs."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(nohup|setsid)$/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($proc.target.process.command_line = /(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/)/ nocase, 80, 50))
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1564.011")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $launched_commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 5
}
