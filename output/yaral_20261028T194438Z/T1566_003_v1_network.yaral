/*
  MITRE Technique : T1566.003 - Spearphishing via Service
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:49:58.444636+00:00
  Reference       : https://attack.mitre.org/techniques/T1566/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1566_003_Linux_Browser_Download_Executable_Via_Referral {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux desktop browser, identified by an X11 Linux user agent, downloading an executable, script or package file from an external, non-allowlisted site after following a link from another page (referrer present). This is the network-side result of a user clicking a payload link delivered through a third-party service such as personal webmail, social media or messaging. It observes proxy or firewall HTTP telemetry only and does not depend on endpoint process data."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1566.003"
    mitre_technique_name = "Phishing: Spearphishing via Service"
    log_prerequisites = "Requires proxy or firewall HTTP logs with URL, user agent and referrer populated (TLS inspection or explicit proxy). Without decryption the URL and referrer fields are empty and the rule will not fire."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Developers and admins downloading install scripts, packages or AppImages from documentation or vendor pages; open-source project download pages; internal portals hosted on external domains."
    tuning_guidance = "Add known-good vendor, repository and CDN domains to %global_allowed_domains. Internal address space is excluded through %rfc1918_internal. Extend or narrow the file extension list per client. For noisy developer subnets, consider a customer-specific copy of the rule."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.user_agent = /\(X11;[^)]*Linux/ nocase
    $http.network.http.referral_url != ""
    $http.target.url = /\.(sh|bash|elf|bin|run|appimage|deb|rpm|py|pl|so|jar)(\?.*)?$/ nocase
    $http.network.http.response_code >= 200
    $http.network.http.response_code < 300
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1566.003")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $download_urls = array_distinct($http.target.url)
    $referrers = array_distinct($http.network.http.referral_url)

  condition:
    $http
}
