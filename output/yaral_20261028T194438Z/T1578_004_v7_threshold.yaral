/*
  MITRE Technique : T1578.004 - Revert Cloud Instance
  Tactic(s)       : Defense Impairment
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:55:43.312118+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_004_Rapid_Snapshot_Restore_By_Principal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single cloud principal performs several snapshot, backup or root-volume restore/revert operations within ten minutes. One restore is routine, but a burst can mean an adversary is rolling instances or storage back to a prior state to erase evidence of their activity."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578.004"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Revert Cloud Instance"
    log_prerequisites = "Cloud control-plane audit logs (management/admin activity events) ingested and normalised to UDM, with metadata.product_event_type and principal.user.userid populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Disaster-recovery tests and failover drills, DevOps pipelines rebuilding environments from snapshots, autoscaling or golden-image automation, database refresh jobs for dev/test, and admins recovering from a genuine outage or accidental deletion."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts and %global_allowed_cloud_principals, and DR/platform admins to %global_allowed_admin_users. Raise the #cloud threshold for tenants with frequent environment refreshes. Review the target_resources and source_ips outcome values to separate pipelines from interactive misuse."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /(Restore.*(Snapshot|Volume|Instance|Disk|Backup)|Revert.*(Snapshot|Instance|Disk)|ReplaceRootVolume)/ nocase
    $cloud.principal.user.userid != ""
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($cloud.metadata.id)
    $mitre_technique_id = array_distinct("T1578.004")
    $primary_entity = array_distinct($user)
    $api_calls = array_distinct($cloud.metadata.product_event_type)
    $target_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    #cloud >= 3
}
