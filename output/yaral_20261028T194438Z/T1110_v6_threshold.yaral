/*
  MITRE Technique : T1110 - Brute Force
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:03:41.123027+00:00
  Reference       : https://attack.mitre.org/techniques/T1110
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1110_IaaS_Repeated_Failed_Logins_Single_User {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects ten or more failed interactive or API sign-in attempts against a single cloud account within ten minutes, consistent with password guessing, brute force or password spraying that has narrowed onto one identity. Individual failed logins are benign; the volume against one account is not. Risk score scales up with attempt volume."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1110"
    mitre_technique_name = "Brute Force"
    log_prerequisites = "Requires cloud provider and identity sign-in audit logs normalised to UDM USER_LOGIN events, with the target account in target.user.userid and the failure indicated by security_result.action = BLOCK or a failure description in security_result.summary."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Users who forgot or recently rotated a password, expired credentials in scripts or CI/CD pipelines retrying automatically, misconfigured service integrations with stale secrets, helpdesk-driven password resets, and authorised penetration tests or credential-audit exercises."
    tuning_guidance = "Add known automation identities to %global_allowed_service_accounts and approved cloud service principals to %global_allowed_cloud_principals. Raise the #auth threshold for tenants with noisy shared accounts, or lower it for high-value administrative accounts. Review the source IP outcome to separate one noisy client from distributed spraying."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    (
      $auth.security_result.action = "BLOCK" or
      $auth.security_result.summary = /(fail|invalid|incorrect|denied|bad (user|password)|wrong password)/ nocase
    )
    $auth.target.user.userid = $user
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_cloud_principals

  match:
    $user over 10m

  outcome:
    $failure_count = count($auth.metadata.id)
    $risk_score = max(if($failure_count >= 50, 85, if($failure_count >= 25, 70, 55)))
    $mitre_technique_id = array_distinct("T1110")
    $primary_entity = array_distinct($user)
    $source_ips = array_distinct($auth.principal.ip)
    $source_countries = array_distinct($auth.principal.location.country_or_region)

  condition:
    #auth >= 10
}
