/*
  MITRE Technique : T1069.002 - Domain Groups
  Tactic(s)       : Discovery
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:59:59.786166+00:00
  Reference       : https://attack.mitre.org/techniques/T1069/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1069_002_Linux_LDAP_Directory_Enumeration_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a single source host making an unusually high volume of LDAP, LDAPS or Global Catalog connections within ten minutes. Bulk directory queries such as ldapsearch or scripted group enumeration open many short-lived connections to directory servers. This is network-observable evidence of domain group and permission discovery. The rule needs no endpoint command-line data, so it complements process-creation detections. A single LDAP connection is normal for domain-joined Linux hosts; the volume is the signal."
    mitre_tactic = "Discovery"
    mitre_technique = "T1069.002"
    mitre_technique_name = "Permission Groups Discovery: Domain Groups"
    log_prerequisites = "Requires firewall, proxy or perimeter flow logs normalised to UDM NETWORK_CONNECTION with principal.ip and target.port populated. Internal east-west traffic to directory servers must be visible to the sensor. Linux scoping is done through the source-host allowlists or per-client asset context because firewall logs carry no OS or process data."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Domain-joined Linux hosts running SSSD or Winbind with aggressive enumeration or cache refresh, identity-sync and provisioning servers, application servers doing per-request LDAP authentication, vulnerability scanners and directory-health monitoring."
    tuning_guidance = "Add sanctioned scanners and identity or sync hosts to %global_allowed_scanners and automation accounts to %global_allowed_service_accounts. Raise the #net threshold if busy authentication servers still fire. Scope to Linux sources using per-client asset context. Severity is scaled in outcome by connection volume."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 389 or
      $net.target.port = 636 or
      $net.target.port = 3268 or
      $net.target.port = 3269
    )
    $net.principal.ip = $src_ip
    not $net.principal.hostname in %global_allowed_scanners
    not $net.principal.user.userid in %global_allowed_service_accounts

  match:
    $src_ip over 10m

  outcome:
    $event_count = count($net.metadata.id)
    $risk_score = max(if($event_count >= 100, 80, 55))
    $mitre_technique_id = array_distinct("T1069.002")
    $primary_entity = array_distinct($src_ip)
    $directory_servers = array_distinct($net.target.ip)
    $directory_ports = array_distinct($net.target.port)

  condition:
    #net >= 25
}
