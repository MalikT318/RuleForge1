/*
  MITRE Technique : T1495 - Firmware Corruption
  Tactic(s)       : Impact
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:47:41.132285+00:00
  Reference       : https://attack.mitre.org/techniques/T1495
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1495_Linux_Firmware_Upload_Over_HTTP_From_Unapproved_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an HTTP POST or PUT to a URL whose path indicates a firmware, BIOS or system-image upgrade endpoint (for example the management interface of a Linux-based network appliance) when the source is not an approved management source. This is the network-observable stage of firmware corruption: pushing an unauthorised or malformed image to a device's flash. A perimeter log cannot see the initiating process or the contents of a host-local flash. Local flashing tools on a Linux host (flashrom, writes to /dev/mtd*) need endpoint telemetry and a separate rule."
    mitre_tactic = "Impact"
    mitre_technique = "T1495"
    mitre_technique_name = "Firmware Corruption"
    log_prerequisites = "Requires firewall, proxy or perimeter logs normalised to UDM NETWORK_HTTP with network.http.method and target.url populated. For HTTPS this needs TLS inspection or a reverse proxy in front of the management plane."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Authorised firmware upgrades by network or infrastructure teams, vendor-driven maintenance windows, automated patch orchestration, lab or staging devices, and web applications that legitimately use the word firmware in an upload path (for example asset-management portals)."
    tuning_guidance = "Add jump hosts, network automation servers and change-window sources to %global_allowed_mgmt_sources. Add known-good vendor update destinations to %global_allowed_domains. If the URL keywords are too broad for a client, tighten the regex to that client's device families, or scope the rule to management-VLAN destinations. Suppress during approved change windows through the SOAR playbook."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(POST|PUT)$/ nocase
    $http.target.url = /(firmware|fw[_-]?(upgrade|update|upload)|sysupgrade|bios[_-]?(update|flash|upload)|flash[_-]?(rom|image|upload)|(image|firmware)[_-]?upload)/ nocase
    not $http.principal.ip in %global_allowed_mgmt_sources
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1495")
    $primary_entity = array_distinct($http.target.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $target_urls = array_distinct($http.target.url)
    $http_methods = array_distinct($http.network.http.method)

  condition:
    $http
}
