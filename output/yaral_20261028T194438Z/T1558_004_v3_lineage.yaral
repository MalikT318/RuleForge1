/*
  MITRE Technique : T1558.004 - AS-REP Roasting
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:45:50.273202+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_004_ASREP_Roasting_Unexpected_Parent_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter spawned by an unexpected parent (Office application, web server worker, print spooler, or database service) whose command line enumerates accounts with Kerberos preauthentication disabled (DONT_REQ_PREAUTH / userAccountControl bit 4194304). This is the discovery step of AS-REP Roasting. Such reconnaissance from these parents indicates webshell, macro, or service-exploitation activity."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.004"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: AS-REP Roasting"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare. Possible sources: web-based or database-driven identity management and auditing applications that run AD queries via PowerShell from a service process, SQL Agent jobs running legitimate AD hygiene or audit scripts, and authorised penetration tests or red-team exercises."
    tuning_guidance = "Add approved parent processes (for example SQL Agent audit jobs or identity governance services) to %global_allowed_script_hosts. Add approved AD audit tooling to %global_allowed_admin_tools. Add authorised security testers to %global_allowed_scanners. Extend the parent process regex with other server-side processes that should never spawn interpreters in your environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|onenote|w3wp|httpd|nginx|tomcat\d*|php-cgi|spoolsv|sqlservr|sqlagent)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|powershell_ise)\.exe$/ nocase
    $proc.target.process.command_line = /(DoesNotRequirePreAuth|PreauthNotRequired|DONT_REQ_PREAUTH|useraccountcontrol(:1\.2\.840\.113556\.1\.4\.803:)?\s*(=|-band|-eq)?\s*4194304)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_scanners

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1558.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
