/*
  MITRE Technique : T1556.007 - Hybrid Identity
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:23:42.422446+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_007_Hybrid_Identity_Federation_Auth_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change (SETTING_MODIFICATION) to hybrid identity authentication in the identity provider's directory audit log. Covered changes are federation trust or domain authentication settings, pass-through authentication, and directory synchronization features. These are the configuration states an adversary alters to backdoor cloud authentication tied to on-premises identities, for example by adding a rogue federation trust or token-signing certificate, or by switching a domain's authentication type. The rule works on the resulting configuration change rather than process command lines, so it still fires when endpoint command-line logging is evaded."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.007"
    mitre_technique_name = "Modify Authentication Process: Hybrid Identity"
    log_prerequisites = "Requires identity provider directory/audit logs ingested and normalised to UDM SETTING_MODIFICATION, with the operation name in metadata.product_event_type and the actor in principal.user.userid. Applies to hybrid environments with on-premises Windows AD / AD FS synchronised to a cloud identity provider."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Planned federation or domain onboarding by identity administrators, directory sync tooling or its service account adjusting sync features, tenant migrations or mergers, scheduled token-signing certificate rollover, and pass-through authentication agent upgrades or re-registrations."
    tuning_guidance = "Add expected sync and automation accounts to %global_allowed_service_accounts, named identity administrators to %global_allowed_admin_users, and approved cloud service principals to %global_allowed_cloud_principals. Correlate alerts with change-management tickets. If the log source uses different operation names, widen or narrow the product_event_type regex per client."

  events:
    $set.metadata.event_type = "SETTING_MODIFICATION"
    $set.metadata.product_event_type = /(federat|set domain authentication|pass.?through|dirsync|directory sync|sync(hronization)? (feature|setting)|token.?signing|trusted (domain|realm))/ nocase
    not $set.principal.user.userid in %global_allowed_service_accounts
    not $set.principal.user.userid in %global_allowed_admin_users
    not $set.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1556.007")
    $primary_entity = array_distinct($set.principal.user.userid)
    $operation = array_distinct($set.metadata.product_event_type)
    $changed_object = array_distinct($set.target.resource.name)
    $source_ip = array_distinct($set.principal.ip)

  condition:
    $set
}
