/*
  MITRE Technique : T1036.009 - Break Process Trees
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:10:38.480288+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_009_Linux_Daemonized_Process_Pidfile_From_Staging_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a PID or lock file under /run or /var/run by a process executing from a world-writable staging directory (/tmp, /var/tmp, /dev/shm) or a hidden directory. Double-fork and daemon() style process-tree breaking leaves this file artifact: the detached payload records its PID or takes a single-instance lock. Legitimate system daemons run from packaged locations such as /usr/sbin, so a pidfile written by a binary running from a staging path indicates a detached, re-parented implant. The rule works from the resulting file state and does not depend on command-line logging."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.009"
    mitre_technique_name = "Masquerading: Break Process Trees"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-write events that populate principal.process.file.full_path and target.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers or CI jobs testing a daemon built in /tmp or a hidden build directory, portable or self-extracting applications that run from /tmp, container entrypoints that unpack to /tmp and daemonize, and user-installed tools in hidden directories (for example ~/.local or ~/.cache) that write pidfiles."
    tuning_guidance = "Add approved binaries or agents to %global_allowed_admin_tools or %global_allowed_security_tools. If a client runs legitimate software from hidden directories, narrow the hidden-directory branch of the regex or exclude the parent via %global_allowed_admin_tools. Raise the risk score for servers and lower it for developer workstations."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(var\/)?run\/[^\/]+\.(pid|lock)$/ nocase
    $file.principal.process.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/)|\/\.[^\/.][^\/]*\/[^\/]+$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1036.009")
    $primary_entity = array_distinct($file.principal.hostname)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $created_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
