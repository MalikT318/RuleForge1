/*
  MITRE Technique : T1102.003 - One-Way Communication
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:58:43.752313+00:00
  Reference       : https://attack.mitre.org/techniques/T1102/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1102_003_Linux_Repeated_Web_Fetch_To_Staging_Dirs {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a single Linux host where command-line HTTP download utilities (curl, wget, aria2c) create many files in world-writable staging directories (/tmp, /var/tmp, /dev/shm) within 10 minutes. This pattern fits a one-way web-service C2 implant polling a legitimate site for instructions and saving each response locally to be parsed and executed, with no output sent back over the same channel. A single download is benign; the repeated volume is the signal. This rule uses file-creation telemetry and does not match process command lines."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1102.003"
    mitre_technique_name = "Web Service: One-Way Communication"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry (FILE_CREATION) with the creating process path populated in principal.process.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management and deployment scripts that fetch packages or artifacts into /tmp, CI/CD build agents, monitoring or health-check scripts that poll an HTTP endpoint, software installers, and container image build processes."
    tuning_guidance = "Add approved automation binaries to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Raise the #file threshold on build servers or CI hosts, or exclude them via %global_allowed_script_hosts. Review the staged_files and users outcome values to confirm that the files are repeatedly fetched small payloads from the same process lineage."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(curl|wget|aria2c)$/ nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1102.003")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $staged_files = array_distinct($file.target.file.full_path)
    $users = array_distinct($file.principal.user.userid)
    $fetch_processes = array_distinct($file.principal.process.file.full_path)

  condition:
    #file >= 8
}
