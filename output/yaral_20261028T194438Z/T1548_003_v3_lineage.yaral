/*
  MITRE Technique : T1548.003 - Sudo and Sudo Caching
  Tactic(s)       : Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:32:39.329261+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_003_Service_Daemon_Spawns_Sudo {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects sudo or sudoedit launched directly by a web server, application server, database, print or similar network-facing service process. Such daemons do not normally invoke sudo, so this lineage often indicates a web shell or exploited service attempting privilege escalation through sudo rights or cached sudo credentials. The rule matches on process lineage only, not on command-line content."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.003"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Sudo and Sudo Caching"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records, normalised to PROCESS_LAUNCH with parent (principal.process) and child (target.process) executable paths populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legacy web-based admin panels (e.g. hosting control panels), CI/CD or deployment agents running as java or node, database maintenance or backup jobs that call sudo from the database service account, and monitoring agents run under an application server."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools. Add legitimate automation accounts to %global_allowed_service_accounts. Add approved script hosts to %global_allowed_script_hosts. If java or node parents are noisy in your environment, narrow the parent regex to the specific daemons that should never invoke sudo."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(sudo|sudoedit)$/ nocase
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|php[0-9.]*|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|smbd|vsftpd|proftpd)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1548.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
