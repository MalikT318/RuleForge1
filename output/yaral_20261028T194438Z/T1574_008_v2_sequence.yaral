/*
  MITRE Technique : T1574.008 - Path Interception by Search Order Hijacking
  Tactic(s)       : Stealth, Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:35:55.932289+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_008_SystemBinary_Dropped_Outside_System32_Then_Executed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects search order hijacking staging: an executable bearing the name of a built-in Windows command-line binary is written to a location outside the protected system directories and then launched from that same path on the same host within 10 minutes. Windows searches the calling program's own directory before System32 for commands given without a full path, so a planted look-alike binary executes in place of the real one."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.008"
    mitre_technique_name = "Hijack Execution Flow: Path Interception by Search Order Hijacking"
    log_prerequisites = "Requires endpoint telemetry that populates both FILE_CREATION (with the writing process) and PROCESS_LAUNCH events with full image paths and hostname."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Portable admin or developer toolkits that ship their own copies of utilities such as ping or reg, software installers or updaters that stage and run helper binaries, Git-for-Windows or Cygwin style environments that bundle look-alike utilities, and application build or test pipelines."
    tuning_guidance = "Add approved installers and deployment tooling to %global_allowed_admin_tools, EDR or AV agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Extend or trim the system-binary name list to suit the estate. The join key is lower-cased so path case differences do not break correlation."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(net|net1|cmd|powershell|pwsh|ipconfig|whoami|tasklist|systeminfo|nltest|reg|sc|schtasks|certutil|ping|nslookup|netsh|wmic|taskkill|find|findstr|mshta|rundll32|regsvr32)\.exe$/ nocase
    not $file.target.file.full_path = /^[a-z]:\\windows\\(system32|syswow64|winsxs|servicing|softwaredistribution)\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname
    $path = strings.to_lower($file.target.file.full_path)

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(net|net1|cmd|powershell|pwsh|ipconfig|whoami|tasklist|systeminfo|nltest|reg|sc|schtasks|certutil|ping|nslookup|netsh|wmic|taskkill|find|findstr|mshta|rundll32|regsvr32)\.exe$/ nocase
    not $proc.target.process.file.full_path = /^[a-z]:\\windows\\(system32|syswow64|winsxs|servicing|softwaredistribution)\\/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname
    $path = strings.to_lower($proc.target.process.file.full_path)

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1574.008")
    $primary_entity = array_distinct($hostname)
    $hijacked_path = array_distinct($proc.target.process.file.full_path)
    $dropper_process = array_distinct($file.principal.process.file.full_path)
    $launching_parent = array_distinct($proc.principal.process.file.full_path)
    $launch_command_line = array_distinct($proc.target.process.command_line)
    $launch_user = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
