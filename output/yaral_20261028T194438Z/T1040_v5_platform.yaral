/*
  MITRE Technique : T1040 - Network Sniffing
  Tactic(s)       : Credential Access, Discovery
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:27:56.224107+00:00
  Reference       : https://attack.mitre.org/techniques/T1040
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1040_Linux_Packet_Capture_Stream_To_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects perimeter-observed packet-capture streaming from an internal source to a non-internal destination. This covers remote capture daemons (rpcap, as used by Linux rpcapd/libpcap remote capture), TZSP-encapsulated sniffer streams, and VXLAN-encapsulated mirrored traffic. A Linux host that has been turned into a sniffer, or a compromised Linux sensor or traffic-mirroring agent, exports captured packets this way. A perimeter log cannot see the sniffing itself or the originating process, so this rule covers the network-visible exfiltration of captured traffic. It complements endpoint command-line detections and does not replace them."
    mitre_tactic = "Credential Access, Discovery"
    mitre_technique = "T1040"
    mitre_technique_name = "Network Sniffing"
    log_prerequisites = "Firewall, proxy or perimeter flow logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip, target.port and network.ip_protocol populated. Egress traffic must be logged, not only denied traffic."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Authorised cloud traffic-mirroring or network-monitoring appliances sending VXLAN or TZSP to an external or SaaS analysis service, managed NDR or IDS sensor vendors, approved remote packet-capture troubleshooting sessions by network engineers, and unrelated services that happen to use TCP 2002."
    tuning_guidance = "Add legitimate sensor and mirroring source addresses to %global_allowed_mgmt_sources and approved testing sources to %global_allowed_scanners. If TCP 2002 is noisy in an environment, remove that port clause for that client. Review the destination for ownership before escalating."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      ($net.network.ip_protocol = "TCP" and $net.target.port = 2002) or
      ($net.network.ip_protocol = "UDP" and $net.target.port = 37008) or
      ($net.network.ip_protocol = "UDP" and $net.target.port = 4789)
    )
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1040")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
