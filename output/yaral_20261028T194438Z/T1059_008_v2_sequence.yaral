/*
  MITRE Technique : T1059.008 - Network Device CLI
  Tactic(s)       : Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:17:42.375499+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_008_External_Mgmt_Session_Then_Device_Outbound_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an external source reaching a network device's CLI management ports (SSH or Telnet), followed within five minutes by the same device initiating an outbound FTP or TFTP connection to an external address. This pattern is consistent with an adversary using the device CLI to pull in malicious software or configuration, or to push the running config out. It is network-observable and does not rely on process or command-line telemetry."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.008"
    mitre_technique_name = "Command and Scripting Interpreter: Network Device CLI"
    log_prerequisites = "Perimeter firewall or flow logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. The firewall must see both the inbound management session and the device's outbound traffic."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised remote administration from unlisted vendor or MSP source addresses, scheduled configuration backups to an off-site TFTP/FTP server, firmware updates pulled from vendor FTP sites, and out-of-band admin access by on-call engineers."
    tuning_guidance = "Add approved administration source addresses to %global_allowed_mgmt_sources and authorised scanners to %global_allowed_scanners. If a device legitimately sends backups or pulls firmware over FTP/TFTP, tune the second event to exclude its address, or reduce the ports. Widen or narrow the 5m window if needed."

  events:
    $inbound.metadata.event_type = "NETWORK_CONNECTION"
    ($inbound.target.port = 22 or $inbound.target.port = 23)
    not $inbound.principal.ip in %rfc1918_internal
    not $inbound.principal.ip in %global_allowed_mgmt_sources
    not $inbound.principal.ip in %global_allowed_scanners
    $inbound.target.ip = $device_ip

    $outbound.metadata.event_type = "NETWORK_CONNECTION"
    ($outbound.target.port = 21 or $outbound.target.port = 69)
    not $outbound.target.ip in %rfc1918_internal
    $outbound.principal.ip = $device_ip

    $inbound.metadata.event_timestamp.seconds <= $outbound.metadata.event_timestamp.seconds

  match:
    $device_ip over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.008")
    $primary_entity = array_distinct($device_ip)
    $mgmt_source_ips = array_distinct($inbound.principal.ip)
    $outbound_dest_ips = array_distinct($outbound.target.ip)
    $outbound_ports = array_distinct($outbound.target.port)
    $inbound_session_count = count($inbound.metadata.id)

  condition:
    $inbound and $outbound
}
