/*
  MITRE Technique : T1566.003 - Spearphishing via Service
  Tactic(s)       : Initial Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:50:21.341147+00:00
  Reference       : https://attack.mitre.org/techniques/T1566/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1566_003_Webmail_Session_Then_Risky_File_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a host accessing a web-based mail or messaging service and then, within 10 minutes, downloading a high-risk file type (script, shortcut, disk image, executable, archive, macro document) over HTTP from a different external host. This pattern is consistent with spearphishing via a third-party service, where a lure link or attachment is delivered through personal webmail, chat or messaging platforms and bypasses enterprise email controls. Detection uses only proxy/firewall-visible hostname and URL patterns. No process fields are used, so it complements any endpoint command-line detection."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1566.003"
    mitre_technique_name = "Phishing: Spearphishing via Service"
    log_prerequisites = "Requires proxy or firewall logs normalised to UDM NETWORK_HTTP with principal.hostname, target.hostname, target.url and network.http.method populated. TLS inspection or a URL-aware proxy is needed to see full URLs for HTTPS traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Users legitimately downloading installers, archives or documents from vendor sites after checking webmail. Software distribution via direct download links. Corporate-hosted webmail or chat portals matching the hostname pattern. Developers and IT staff fetching tools or scripts."
    tuning_guidance = "Add corporate mail, chat and vendor download domains to %global_allowed_domains. This list is applied to both the messaging-service hostname and the download hostname. Add known jump hosts or admin workstations to %global_allowed_admin_tools if the host name list is shared. If the proxy does not populate principal.hostname, switch the join key to principal.ip. Narrow or widen the file extension list per client risk appetite."

  events:
    $mail.metadata.event_type = "NETWORK_HTTP"
    $mail.target.hostname = /(^|\.)(webmail|mail|inbox|messenger|chat|dm|message|messages)\./ nocase
    not $mail.target.hostname in %global_allowed_domains
    not $mail.target.ip in %rfc1918_internal
    $mail.principal.hostname = $host

    $dl.metadata.event_type = "NETWORK_HTTP"
    $dl.network.http.method = "GET" nocase
    $dl.target.url = /\.(iso|img|lnk|hta|js|jse|vbs|vbe|wsf|scr|exe|msi|dll|zip|rar|7z|docm|xlsm|one)(\?.*)?$/ nocase
    not $dl.target.hostname in %global_allowed_domains
    not $dl.target.ip in %rfc1918_internal
    $dl.target.hostname != $mail.target.hostname
    $dl.principal.hostname = $host

    $mail.metadata.event_timestamp.seconds <= $dl.metadata.event_timestamp.seconds

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1566.003")
    $primary_entity = array_distinct($host)
    $messaging_hosts = array_distinct($mail.target.hostname)
    $download_hosts = array_distinct($dl.target.hostname)
    $download_urls = array_distinct($dl.target.url)
    $download_count = count($dl.metadata.id)

  condition:
    $mail and $dl
}
