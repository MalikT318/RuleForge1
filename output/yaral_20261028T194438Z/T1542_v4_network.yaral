/*
  MITRE Technique : T1542 - Pre-OS Boot
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:41:01.135937+00:00
  Reference       : https://attack.mitre.org/techniques/T1542
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_Outbound_PXE_TFTP_Boot_Traffic {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects pre-OS network boot protocol traffic (TFTP on UDP/69 or PXE proxy-DHCP on UDP/4011) leaving the internal network for an external destination. Legitimate network boot services stay on internal address space. Outbound boot-protocol traffic can mean a Windows host is fetching a boot image, bootloader or firmware payload from an external server, or that boot configuration was tampered with to persist below the OS."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542"
    mitre_technique_name = "Pre-OS Boot"
    log_prerequisites = "Requires perimeter firewall or proxy logs that record allowed and denied connections with destination IP, destination port and IP protocol, normalised to UDM NETWORK_CONNECTION. Endpoint process fields are not used. Logs must be collected from the egress boundary."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Cloud-hosted or remote-site provisioning and imaging services (e.g. OS deployment over VPN or SD-WAN), vendor-hosted PXE or network-boot services, misconfigured DHCP options pointing at an external boot server, and authorised red-team or penetration tests."
    tuning_guidance = "Add sanctioned deployment or imaging server source addresses to %global_allowed_mgmt_sources. Confirm %rfc1918_internal covers all of the client's internal and VPN address space. For clients with remote-site provisioning, consider raising the threshold or restricting the rule to non-provisioning VLANs. Treat any hit from a server-class host as high priority."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "UDP"
    ($net.target.port = 69 or $net.target.port = 4011)
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1542")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
