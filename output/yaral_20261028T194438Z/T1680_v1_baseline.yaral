/*
  MITRE Technique : T1680 - Local Storage Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:28:15.517419+00:00
  Reference       : https://attack.mitre.org/techniques/T1680
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1680_ESXi_Local_Storage_Discovery_CLI {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects enumeration of local storage on an ESXi host from the shell. Covers esxcli/localcli storage namespaces (core device, adapter and path, filesystem, vmfs, nmp device) with list/get verbs, plus partedUtil partition-table reads and vmkfstools volume queries. Ransomware operators run these commands to find datastores and VMDK volumes before encryption."
    mitre_tactic = "Discovery"
    mitre_technique = "T1680"
    mitre_technique_name = "Local Storage Discovery"
    log_prerequisites = "Requires ESXi shell command auditing (shell.log or hostd) or syslog forwarding normalised to UDM PROCESS_LAUNCH with target.process.command_line populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators checking datastore capacity or troubleshooting storage paths, backup and monitoring agents that query datastore state over SSH, patching and host-profile compliance scripts, and storage vendor health-check tooling."
    tuning_guidance = "Add approved admin accounts to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Add backup, monitoring and inventory parent processes to %global_allowed_admin_tools. Treat a hit as higher risk when it follows an SSH login from an unexpected source or is followed by VM power-off or file-encryption activity."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /\b(esxcli|localcli)\s+(--?\S+\s+)*storage\s+(core\s+(device|adapter|path)|filesystem|vmfs|nmp\s+device)\s+(list|get)\b|\bpartedUtil\s+(getptbl|get)\b|\bvmkfstools\s+(-P|-D|-g|--queryspace)\b/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1680")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
