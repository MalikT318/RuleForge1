/*
  MITRE Technique : T1578.004 - Revert Cloud Instance
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:55:24.623404+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_004_Snapshot_Restore_Then_Volume_Attach {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects one identity creating a volume or instance state from a snapshot (a restore) and then attaching or swapping that restored storage onto a compute instance within ten minutes. This sequence reverts an instance to an earlier state and can erase evidence of attacker activity."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578.004"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Revert Cloud Instance"
    log_prerequisites = "Cloud control-plane audit logging for management and data-plane volume/snapshot API calls must be enabled and ingested with metadata.product_event_type populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Disaster-recovery drills, authorised rollback after a failed change or patch, auto-scaling or infrastructure-as-code pipelines that restore volumes from golden snapshots, and backup validation jobs."
    tuning_guidance = "Add automation and pipeline identities to %global_allowed_service_accounts, approved cloud service principals to %global_allowed_cloud_principals, and named DR administrators to %global_allowed_admin_users. Extend the product_event_type regexes for additional provider API names if needed."

  events:
    $restore.metadata.event_type = "RESOURCE_CREATION"
    $restore.metadata.product_event_type = /^(CreateVolume|CreateReplaceRootVolumeTask|RestoreSnapshotFromRecycleBin|RestoreDBInstanceFromDBSnapshot|RestoreDBClusterFromSnapshot|.*compute\.disks\.insert|.*snapshots\.restore.*)$/ nocase
    $restore.principal.user.userid = $user
    not $restore.principal.user.userid in %global_allowed_service_accounts
    not $restore.principal.user.userid in %global_allowed_admin_users
    not $restore.principal.user.userid in %global_allowed_cloud_principals

    $attach.metadata.event_type = "SETTING_MODIFICATION"
    $attach.metadata.product_event_type = /^(AttachVolume|ReplaceRootVolume|.*compute\.instances\.attachDisk|.*disks\.attach.*)$/ nocase
    $attach.principal.user.userid = $user
    not $attach.principal.user.userid in %global_allowed_service_accounts
    not $attach.principal.user.userid in %global_allowed_admin_users
    not $attach.principal.user.userid in %global_allowed_cloud_principals

    $restore.metadata.event_timestamp.seconds <= $attach.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1578.004")
    $primary_entity = array_distinct($user)
    $restore_actions = array_distinct($restore.metadata.product_event_type)
    $attach_actions = array_distinct($attach.metadata.product_event_type)
    $source_ips = array_distinct($restore.principal.ip)
    $event_count = count($attach.metadata.id)

  condition:
    $restore and $attach
}
