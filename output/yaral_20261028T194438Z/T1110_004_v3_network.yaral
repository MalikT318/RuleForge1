/*
  MITRE Technique : T1110.004 - Credential Stuffing
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:09:00.780045+00:00
  Reference       : https://attack.mitre.org/techniques/T1110/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1110_004_Inbound_External_Connection_To_Mgmt_Service_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an inbound connection from an external (non-internal) source address to a commonly credential-stuffed management or authentication service port (SSH, Telnet, FTP, SMB/NetBIOS, LDAP, Kerberos, RDP, MSSQL, Oracle, MySQL, VNC), as observed at the network perimeter. A single connection is a precursor signal. The risk lies in exposed authentication services being reachable from the internet, where credential stuffing and password spraying occur."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1110.004"
    mitre_technique_name = "Brute Force: Credential Stuffing"
    log_prerequisites = "Firewall, proxy or perimeter logs that record permitted and denied connections with source IP, destination IP and destination port. Logs must be normalised to UDM NETWORK_CONNECTION."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and penetration tests, internet-wide research scanners hitting exposed services, vendor or MSP remote support over SSH/RDP, site-to-site partner links, legitimate remote administrators connecting from unlisted addresses."
    tuning_guidance = "Add approved administrative source addresses to %global_allowed_mgmt_sources and scanner sources to %global_allowed_scanners. If volume is high on internet-exposed segments, narrow the port list to services that should never be internet-facing, or promote this to a Threshold rule grouped by principal.ip and target.ip. Ensure %rfc1918_internal is populated for each client."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 21 or
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 88 or
      $net.target.port = 139 or
      $net.target.port = 389 or
      $net.target.port = 445 or
      $net.target.port = 1433 or
      $net.target.port = 1521 or
      $net.target.port = 3306 or
      $net.target.port = 3389 or
      $net.target.port = 5900
    )
    $net.principal.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1110.004")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
