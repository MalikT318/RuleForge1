/*
  MITRE Technique : T1542 - Pre-OS Boot
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:41:18.548542+00:00
  Reference       : https://attack.mitre.org/techniques/T1542
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_Linux_Perimeter_TFTP_Netboot_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects TFTP (UDP/69) traffic leaving the internal network for an external destination. TFTP is the transport for PXE/network boot and bootloader or firmware image retrieval, which is how pre-OS boot code can be replaced or staged on Linux servers and appliances. Legitimate netboot stays inside the internal network, so a perimeter-crossing TFTP flow is anomalous. The firewall cannot see the initiating process or OS, so scope the rule to Linux server and appliance segments through tuning."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542"
    mitre_technique_name = "Pre-OS Boot"
    log_prerequisites = "Requires firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with target.port, network.ip_protocol and principal.ip populated. Egress TFTP must not be dropped before logging."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legacy network device or appliance backup and config jobs using TFTP to an off-site server, vendor-hosted PXE or provisioning services, lab or colocation provisioning across a routed boundary, and authorised red-team or scanner activity."
    tuning_guidance = "Add approved provisioning or management source addresses to %global_allowed_mgmt_sources and authorised testing sources to %global_allowed_scanners. If the client has multiple sites that route internal traffic via the perimeter, make sure %rfc1918_internal covers all internal space. Restrict deployment to Linux server and appliance segments where the firewall log tags them."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    $net.network.ip_protocol = "UDP"
    $net.principal.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1542")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
