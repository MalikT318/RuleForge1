/*
  MITRE Technique : T1558.004 - AS-REP Roasting
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:45:34.331860+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_004_ASREP_Preauth_Disabled_On_Account {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a directory account change that sets the 'Do not require Kerberos preauthentication' flag (DONT_REQ_PREAUTH in userAccountControl). Attackers set this flag on accounts they control or have write access to, making them AS-REP roastable. This detects the configuration state change rather than the roasting tool's command line, so it fires regardless of tool name, renaming, or command-line obfuscation."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.004"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: AS-REP Roasting"
    log_prerequisites = "Domain controller Windows Security log event 4738 (user account changed) with Audit User Account Management enabled, ingested and normalised to UDM. The preauth change text must be present in security_result.description or metadata.description."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy applications or non-Windows Kerberos clients that require preauthentication to be disabled and were approved by IT. Identity management or provisioning automation. Planned administrator changes during account migrations."
    tuning_guidance = "Add approved identity management or provisioning accounts to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Accounts with a documented business need for disabled preauthentication should be handled through the SOAR playbook or a client-specific exclusion. If the log source also emits 4738 events where the flag is removed, suppress those downstream or in the client copy of the rule."

  events:
    $uac.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    (
      $uac.security_result.description = /don.?t[\s_]+req(uire)?[\s_]+(kerberos[\s_]+)?pre-?auth/ nocase or
      $uac.metadata.description = /don.?t[\s_]+req(uire)?[\s_]+(kerberos[\s_]+)?pre-?auth/ nocase
    )
    $uac.target.user.userid != ""
    not $uac.principal.user.userid in %global_allowed_admin_users
    not $uac.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1558.004")
    $primary_entity = array_distinct($uac.target.user.userid)
    $changed_by = array_distinct($uac.principal.user.userid)
    $source_host = array_distinct($uac.principal.hostname)

  condition:
    $uac
}
