/*
  MITRE Technique : T1218.010 - Regsvr32
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:54:55.678113+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_010_Regsvr32_Anomalous_Parent_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects regsvr32.exe launched by a parent process that should never proxy-execute it (Office, PDF readers, web server workers, database services, print spooler, WMI provider host, script hosts). Also detects regsvr32.exe spawning a shell, script interpreter or rundll32, which is a typical Squiblydoo or scriptlet execution outcome. Detection is based on process lineage, not on command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.010"
    mitre_technique_name = "System Binary Proxy Execution: Regsvr32"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with parent and child image paths (EDR, Sysmon Event ID 1, or Windows Security Event 4688 with parent process populated)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy Office or PDF add-in installers registering COM components, software deployment or patching tools that call regsvr32 from a script host, web application installers or updaters running under a web server worker, vendor installers that chain regsvr32 into cmd.exe, and RMM-driven scripts."
    tuning_guidance = "Add approved deployment or RMM parent binaries to %global_allowed_admin_tools and approved script-host parents to %global_allowed_script_hosts. If the parent list is too noisy for a client, remove wscript, cscript or mshta from the parent regex after reviewing the baseline. Review the child-spawn branch separately if installer noise appears."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $proc.target.process.file.full_path = /\\regsvr32\.exe$/ nocase
        and $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|acrord32|acrobat|foxitreader|w3wp|httpd|nginx|tomcat\d*|php-cgi|sqlservr|spoolsv|wmiprvse|mshta|wscript|cscript)\.exe$/ nocase
      )
      or
      (
        $proc.principal.process.file.full_path = /\\regsvr32\.exe$/ nocase
        and $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32)\.exe$/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.010")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
