/*
  MITRE Technique : T1082 - System Information Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:49:38.785227+00:00
  Reference       : https://attack.mitre.org/techniques/T1082
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1082_Linux_SysInfo_File_Read_From_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a process running from a world-writable or user-staging location (/tmp, /var/tmp, /dev/shm, /run/user, hidden home directories) that reads OS and hardware identity files such as /etc/os-release, /proc/version, /proc/cpuinfo or /sys/class/dmi/id/*. This catches system information discovery by dropped binaries, implants and scripts through direct file access, with no dependence on discovery command lines (uname, lsb_release, hostnamectl), so it complements process-creation rules."
    mitre_tactic = "Discovery"
    mitre_technique = "T1082"
    mitre_technique_name = "System Information Discovery"
    log_prerequisites = "Requires Linux file-read telemetry normalised to UDM FILE_READ with principal.process.file.full_path populated: either EDR file-access events or auditd with read watches (-w) on /etc/os-release, /etc/*-release, /proc/version and /sys/class/dmi/id."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software installers or self-extracting packages run from /tmp that check the distribution; containerised or snap/flatpak apps staging under /run/user; configuration management or inventory agents run from temporary directories; developers running locally built binaries from hidden home directories; hardware or compatibility check scripts."
    tuning_guidance = "Add approved inventory, RMM and deployment binaries to %global_allowed_admin_tools, EDR and AV agents to %global_allowed_security_tools, and approved script interpreters or launchers to %global_allowed_script_hosts. If auditd is the source, keep watch rules narrow to the listed files to control volume. Escalate when the same host also shows external network connections from the same process."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /^\/(proc\/(version|cpuinfo|meminfo)|etc\/(os-release|lsb-release|issue|[a-z_-]+-release)|sys\/class\/dmi\/id\/[a-z_]+)$/ nocase
    $file.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/user\/[0-9]+|home\/[^\/]+\/\.[^\/]+)\// nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1082")
    $primary_entity = array_distinct($file.principal.hostname)
    $reading_process = array_distinct($file.principal.process.file.full_path)
    $file_read = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
