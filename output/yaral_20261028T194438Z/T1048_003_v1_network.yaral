/*
  MITRE Technique : T1048.003 - Exfiltration Over Unencrypted Non-C2 Protocol
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:37:15.242472+00:00
  Reference       : https://attack.mitre.org/techniques/T1048/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1048_003_Firewall_Large_Outbound_Cleartext_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a large outbound transfer to an external address over a protocol that is unencrypted by design (FTP, TFTP, SMTP, rsync daemon), as seen in firewall connection logs. Large volumes of data leaving over these cleartext services are characteristic of exfiltration over an alternate, non-C2 protocol."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1048.003"
    mitre_technique_name = "Exfiltration Over Alternative Protocol: Exfiltration Over Unencrypted Non-C2 Protocol"
    log_prerequisites = "Firewall or perimeter connection logs normalised to NETWORK_CONNECTION with target.port, target.ip and network.sent_bytes populated (session-end or accounting logging enabled on the firewall)."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate B2B file transfers to partners over FTP/SFTP-fallback, outbound mail relays sending large attachments or bulk mail, software and firmware distribution via TFTP or rsync to external mirrors, and offsite backup jobs using rsync."
    tuning_guidance = "Add known transfer or mail-relay source addresses to %global_allowed_mgmt_sources, add approved partner or vendor destinations to %global_allowed_domains, and raise or lower the sent_bytes threshold (default about 10 MB) per client baseline. Ports can be trimmed if SMTP relay is noisy."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 20 or
      $net.target.port = 21 or
      $net.target.port = 25 or
      $net.target.port = 69 or
      $net.target.port = 873
    )
    $net.network.sent_bytes > 10485760
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1048.003")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
