/*
  MITRE Technique : T1113 - Screen Capture
  Tactic(s)       : Collection
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:14:36.737912+00:00
  Reference       : https://attack.mitre.org/techniques/T1113
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1113_Anomalous_Parent_Spawns_Screen_Capture {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects screen-capture activity originating from an anomalous parent process lineage: an Office application, web server, print spooler or database service spawning either a script interpreter that references screen-grab APIs, or a native screen/step recording utility. Pivots on lineage rather than on the capture command line alone."
    mitre_tactic = "Collection"
    mitre_technique = "T1113"
    mitre_technique_name = "Screen Capture"
    log_prerequisites = "Requires Windows EDR or Sysmon-equivalent process launch telemetry with parent process path and child command line populated (Sysmon Event ID 1 or Windows Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros or add-ins that legitimately render or export screen content, web or reporting applications that produce screenshots through a shell, database or print-server maintenance scripts, helpdesk or QA tooling launched from a document, and security testing."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts, approved IT and RMM tooling to %global_allowed_admin_tools, and approved support tooling to %global_allowed_remote_mgmt. Extend the parent regex with additional internet-facing or line-of-business service executables where needed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|w3wp|httpd|nginx|tomcat\d*|php-cgi|spoolsv|sqlservr|mysqld|oracle)\.exe$/ nocase
    (
      (
        $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta)\.exe$/ nocase and
        $proc.target.process.command_line = /(copyfromscreen|printwindow|bitblt|primaryscreen\.bounds|getdesktopwindow|system\.drawing.*(graphics|bitmap))/ nocase
      )
      or
      $proc.target.process.file.full_path = /\\(psr|snippingtool|screenclippinghost)\.exe$/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1113")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
