/*
  MITRE Technique : T1574.013 - KernelCallbackTable
  Tactic(s)       : Stealth, Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:45:10.084439+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_013_KernelCallbackTable_Handle_Then_Injection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A non-allowlisted process opens a handle to a common GUI host process and then performs process injection into the same target from the same source on the same host within 10 minutes. This is the memory-write staging used for KernelCallbackTable hijacking, where the PEB callback table is overwritten (for example fnCOPYDATA) and a window message triggers the payload. The rule detects the injection result, not the API calls or command lines."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.013"
    mitre_technique_name = "Hijack Execution Flow: KernelCallbackTable"
    log_prerequisites = "Requires endpoint telemetry that emits process-handle-open (PROCESS_OPEN) and remote memory write or injection (PROCESS_INJECTION) events with source and target process paths, such as an EDR or Sysmon Event IDs 10 and 8."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Accessibility and screen-reader software, input method editors, game overlays, remote support or screen-sharing agents, application-compatibility shims, and software installers or updaters that touch explorer or other GUI processes. Debuggers used by developers on GUI applications."
    tuning_guidance = "Add legitimate source process paths to %global_allowed_security_tools, %global_allowed_admin_tools, %global_allowed_remote_mgmt or %global_allowed_backup_processes. Extend or narrow the GUI target process regex to suit the customer's environment. Raise the severity on servers where interactive GUI processes should not be targeted at all."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.hostname = $hostname
    $open.principal.process.file.full_path = $src_proc
    $open.target.process.file.full_path = $tgt_proc
    $open.target.process.file.full_path = /\\(explorer|notepad|mspaint|calc|calculator|wordpad|taskmgr|mstsc|snippingtool|winword|excel|outlook)\.exe$/ nocase
    $open.principal.process.file.full_path != ""
    $src_proc != $tgt_proc
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $open.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|csrss|wininit|winlogon|services|lsass|svchost)\.exe$/ nocase

    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.hostname = $hostname
    $inj.principal.process.file.full_path = $src_proc
    $inj.target.process.file.full_path = $tgt_proc
    $inj.target.process.file.full_path = /\\(explorer|notepad|mspaint|calc|calculator|wordpad|taskmgr|mstsc|snippingtool|winword|excel|outlook)\.exe$/ nocase
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.process.file.full_path in %global_allowed_remote_mgmt

    $open.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname, $src_proc, $tgt_proc over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1574.013")
    $primary_entity = array_distinct($open.principal.hostname)
    $source_processes = array_distinct($open.principal.process.file.full_path)
    $target_processes = array_distinct($inj.target.process.file.full_path)
    $source_users = array_distinct($open.principal.user.userid)
    $open_event_count = count($open.metadata.id)
    $injection_event_count = count($inj.metadata.id)

  condition:
    $open and $inj
}
