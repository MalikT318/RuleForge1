/*
  MITRE Technique : T1505.004 - IIS Components
  Tactic(s)       : Persistence
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:31:42.063681+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_004_IIS_Worker_Process_Spawns_Shell_Or_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the IIS worker process (w3wp.exe) spawning a command shell, script interpreter, or common living-off-the-land binary. A malicious ISAPI extension or filter, IIS native module, or web shell loaded into the worker process typically shows up as this parent-child lineage anomaly. Legitimate IIS workers almost never launch interactive shells or script hosts. The rule matches on lineage only and does not depend on command-line content."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.004"
    mitre_technique_name = "Server Software Component: IIS Components"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry (EDR, Sysmon Event ID 1, or Security Event 4688 with parent process populated) normalised to UDM PROCESS_LAUNCH with principal.process.file.full_path (parent) and target.process.file.full_path (child)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy web applications that deliberately shell out (for example report generators, PDF or image converters, or custom deployment pages); web-based admin or hosting control panels; application warm-up or health-check scripts launched by the worker process; authorised penetration tests against IIS servers."
    tuning_guidance = "Add known-good IIS servers that legitimately shell out to %global_allowed_script_hosts (matched on principal.hostname). Add application pool identities or service accounts that are expected to do this to %global_allowed_service_accounts. Once a specific child process is confirmed legitimate for an application, narrow the child regex or exclude the child path via %global_allowed_admin_tools."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\w3wp\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|powershell_ise|pwsh|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|wmic|whoami|net|net1|nltest|schtasks|sc|msbuild|csc|installutil|forfiles)\.exe$/ nocase
    not $proc.principal.hostname in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1505.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
