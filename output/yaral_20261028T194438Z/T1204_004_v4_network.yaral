/*
  MITRE Technique : T1204.004 - Malicious Copy and Paste
  Tactic(s)       : Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:04:57.024861+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_004_ClickFix_PowerShell_Stager_Proxy_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound HTTP(S) request from a Windows host carrying the default PowerShell web-client user agent and fetching a script or executable payload type, or addressing a raw IP-literal URL, on an external destination outside the known-good domain list. This is the network-side footprint of a ClickFix style copy-and-paste stager, where a user pastes a command that downloads the next stage. Detection is based on proxy or firewall telemetry and does not depend on process command-line visibility."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.004"
    mitre_technique_name = "User Execution: Malicious Copy and Paste"
    log_prerequisites = "Requires firewall or web proxy logs normalised to NETWORK_HTTP with network.http.user_agent and target.url populated. TLS inspection is needed to see the URL and user agent for HTTPS traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Administrative or deployment scripts that download installers or modules with PowerShell Invoke-WebRequest or Invoke-RestMethod, software packaging and provisioning pipelines, developer workstations, and IT automation fetching .ps1 or .zip content from unlisted vendor or CDN domains."
    tuning_guidance = "Add vendor, CDN and update domains to %global_allowed_domains. Add build servers, jump hosts and administrative workstations that legitimately script downloads to %global_allowed_script_hosts. Consider widening the URL regex to all PowerShell-user-agent traffic to external non-allowlisted domains in high-maturity environments, and lowering severity if deployment tooling is noisy."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.user_agent = /PowerShell\/\d/ nocase
    $http.target.url = /^(https?:\/\/)?\d{1,3}(\.\d{1,3}){3}|\.(ps1|hta|exe|dll|msi|bat|vbs|js|zip|cab)(\?|$)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1204.004")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
