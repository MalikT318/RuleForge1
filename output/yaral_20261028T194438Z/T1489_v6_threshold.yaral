/*
  MITRE Technique : T1489 - Service Stop
  Tactic(s)       : Impact
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:40:00.878857+00:00
  Reference       : https://attack.mitre.org/techniques/T1489
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1489_ESXi_Bulk_Service_Stop_Config_Changes {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects several ESXi host service stop, disable or startup-policy change events (hostd service-system tasks and setting changes) on a single host within ten minutes. Ransomware operators and destructive actors stop management, HA, backup-agent and other host services before VM encryption or data destruction. One change is routine administration; a burst on one host is not. This rule uses host configuration/setting events rather than process command lines, so it complements existing PROCESS_LAUNCH command-line rules."
    mitre_tactic = "Impact"
    mitre_technique = "T1489"
    mitre_technique_name = "Service Stop"
    log_prerequisites = "ESXi hostd logs forwarded to Chronicle and parsed into SETTING_MODIFICATION UDM events with the event text populated in metadata.description."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Planned host maintenance or patching windows, host remediation or lifecycle tooling restarting services, configuration management pushing host profiles, administrators troubleshooting hostd/vpxa, backup agent upgrades."
    tuning_guidance = "Add expected administrators to %global_allowed_admin_users and automation or lifecycle accounts to %global_allowed_service_accounts. Raise the #cfg threshold in noisy environments, or suppress during approved change windows."

  events:
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.metadata.description = /(ServiceSystem\.(stop|uninstall|updatepolicy)|service\W+(stop|stopped|disabled)|(stop|stopping|disable|disabling)\W+(service|daemon))/ nocase
    $cfg.principal.hostname = $host
    not $cfg.principal.user.userid in %global_allowed_admin_users
    not $cfg.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(75)
    $event_count = count($cfg.metadata.id)
    $mitre_technique_id = array_distinct("T1489")
    $primary_entity = array_distinct($host)
    $acting_users = array_distinct($cfg.principal.user.userid)
    $event_descriptions = array_distinct($cfg.metadata.description)

  condition:
    #cfg >= 3
}
