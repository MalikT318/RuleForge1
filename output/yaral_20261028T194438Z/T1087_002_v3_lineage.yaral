/*
  MITRE Technique : T1087.002 - Domain Account
  Tactic(s)       : Discovery
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:54:28.544680+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_002_Domain_Account_Discovery_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a built-in domain enumeration utility or script interpreter launched from a parent process that should never perform Active Directory discovery. Parents include Office applications, PDF readers, web server and application server processes, the print spooler, and database services. The child must also carry a domain-scoped enumeration argument. This pivots on process lineage, which indicates exploitation, macro or webshell execution, or a post-exploitation implant."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.002"
    mitre_technique_name = "Account Discovery: Domain Account"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with parent process path, child process path and command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Line-of-business Office macros or add-ins that query Active Directory for user lookups; web applications or SharePoint/IIS-hosted apps that legitimately shell out to AD queries; SQL Server jobs (xp_cmdshell) used by admins for AD reporting; print management scripts launched by spoolsv."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts or %global_allowed_admin_tools, and approved automation accounts to %global_allowed_service_accounts. To broaden coverage, extend the parent regex with client-specific application server process names. To narrow it, remove parents that are noisy in a specific environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|acrord32|acrobat|foxitreader|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|spoolsv|sqlservr|mysqld|postgres|oracle)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(net|net1|nltest|dsquery|dsget|csvde|ldifde|powershell|pwsh|cmd)\.exe$/ nocase
    $proc.target.process.command_line = /(\/domain\b|\bdclist\b|domain_trusts|\bdsquery\s+(user|group|\*)|\bdsget\b|\bcsvde\b|\bldifde\b|get-ad(user|group|groupmember|computer|domain)|adsisearcher|directorysearcher|directoryservices)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1087.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
