/*
  MITRE Technique : T1195.003 - Compromise Hardware Supply Chain
  Tactic(s)       : Initial Access
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:44:09.603109+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_003_WPBT_Firmware_Injected_Binary_Written {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of the Windows Platform Binary Table (WPBT) payload file in System32. At boot, Windows writes a binary that firmware supplied through the ACPI WPBT table to this fixed OS-defined path, then executes it. A hardware or firmware supply-chain implant can use this to run native code on every boot without any process-creation or command-line evidence. This rule works on the resulting file artifact rather than process or command-line telemetry. It only covers implants that use the WPBT mechanism, not all hardware supply-chain compromise."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.003"
    mitre_technique_name = "Supply Chain Compromise: Compromise Hardware Supply Chain"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon Event ID 11) covering the System32 directory, including files written by the boot-time session manager."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "OEM anti-theft or device-management agents that legitimately use WPBT persistence (laptop vendor service engines, endpoint-recovery agents). Newly provisioned devices on first boot after a legitimate firmware update. Vendor BIOS updates that refresh the WPBT payload."
    tuning_guidance = "Review the first alert per device model to baseline legitimate OEM WPBT use. Add approved OEM agent or firmware-update tooling paths to %global_allowed_admin_tools. Add endpoint security agents that write to this path to %global_allowed_security_tools. Confirm the device has not set DisableWpbtExecution, and escalate any detection on devices from an unverified supply channel."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\windows\\(system32|sysnative)\\wpbbin\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1195.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
