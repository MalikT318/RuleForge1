/*
  MITRE Technique : T1137.005 - Outlook Rules
  Tactic(s)       : Persistence
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:21:18.328726+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_005_Mailbox_Rule_Suspicious_Action_M365 {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of a mailbox (inbox) rule in a cloud mail tenant whose parameters forward, redirect, delete, or launch an application on inbound mail. Attackers use such rules for persistence, for hiding security or reply messages from the victim, and for exfiltration. The detection keys on the audit operation and the rule action parameters, so it does not depend on a rule name, destination address, or client IP."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.005"
    mitre_technique_name = "Office Application Startup: Outlook Rules"
    log_prerequisites = "Requires mailbox audit and admin audit logging enabled in the tenant, with Exchange operations ingested via the unified audit log. The operation name must be mapped into metadata.product_event_type and the rule parameters into security_result.description. Verify this mapping in the client parser."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Users creating legitimate auto-forwarding rules (for example to a personal or shared mailbox), out-of-office style automation, delete-on-arrival rules for newsletters, helpdesk or migration staff creating rules on behalf of users, and mail-flow or archiving integrations managed by service accounts."
    tuning_guidance = "Add approved automation and integration identities to %global_allowed_service_accounts and named mail administrators or helpdesk staff to %global_allowed_admin_users. If the client parser puts rule parameters in a different field, adjust the security_result.description match accordingly. Consider raising severity when the actor session is also flagged for risky sign-in."

  events:
    $set.metadata.event_type = "SETTING_MODIFICATION"
    $set.metadata.product_event_type = /^(New-InboxRule|Set-InboxRule|UpdateInboxRules)$/ nocase
    $set.security_result.description = /(ForwardTo|ForwardAsAttachmentTo|RedirectTo|DeleteMessage|PermanentDelete|MoveToFolder.{0,40}(Deleted|RSS|Junk|Conversation History)|StartApplication|RunApplication|ServerApplication)/ nocase
    not $set.principal.user.userid in %global_allowed_service_accounts
    not $set.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1137.005")
    $primary_entity = array_distinct($set.principal.user.userid)
    $source_ips = array_distinct($set.principal.ip)
    $operation = array_distinct($set.metadata.product_event_type)
    $affected_mailbox = array_distinct($set.target.user.userid)

  condition:
    $set
}
