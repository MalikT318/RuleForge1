/*
  MITRE Technique : T1003.006 - DCSync
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:47:08.174497+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_006_IPS_DRS_Replication_Signature_NonDC {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network security appliance (IDS/IPS) detections for Active Directory directory replication RPC traffic (DRSUAPI / DsGetNCChanges) between hosts. This is the on-the-wire signature of DCSync. Legitimate replication occurs only between domain controllers, so any hit whose source is not an approved replication partner or authorised scanner suggests credential theft."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.006"
    mitre_technique_name = "OS Credential Dumping: DCSync"
    log_prerequisites = "IDS/IPS with the DCE/RPC and directory replication protocol decoder enabled, with sensors placed to see east-west traffic to and from domain controllers, and signature names or descriptions populated in security_result. Events must be normalised to UDM NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "ips"
    false_positives = "Legitimate replication between domain controllers (new DC promotion, site-to-site replication), Azure AD Connect or other directory-sync servers, identity management and migration tools, authorised AD security assessments or purple-team exercises."
    tuning_guidance = "Add the source IP addresses of all domain controllers and directory-sync servers to %global_allowed_mgmt_sources. Add authorised security testing sources to %global_allowed_scanners. The rule deliberately does not exclude %rfc1918_internal because DCSync is internal east-west traffic and excluding internal space would blind it. Adjust the signature-name regex to match the IPS vendor's naming. Severity can be raised for hits where the target is a domain controller."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.security_result.rule_name = /(drsuapi|dsgetncchanges|dsreplicaget|drs[\s_-]?replica|directory[\s_-]?replication)/ nocase or
      $net.security_result.description = /(drsuapi|dsgetncchanges|dsreplicaget|drs[\s_-]?replica|directory[\s_-]?replication)/ nocase
    )
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1003.006")
    $primary_entity = array_distinct($net.principal.ip)
    $source_hostnames = array_distinct($net.principal.hostname)
    $target_ips = array_distinct($net.target.ip)
    $signature_names = array_distinct($net.security_result.rule_name)

  condition:
    $net
}
