/*
  MITRE Technique : T1059.008 - Network Device CLI
  Tactic(s)       : Execution
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:17:26.512425+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_008_External_Source_To_Device_CLI_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a connection from a non-internal source address to the remote CLI management ports of a network device (Telnet 23, SSH 22). Network CLI access is how adversaries run commands on routers, switches and firewalls, and it should only come from approved management sources. Reaching the CLI from external address space suggests exposed management-plane access, or an attacker obtaining a device CLI session."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.008"
    mitre_technique_name = "Command and Scripting Interpreter: Network Device CLI"
    log_prerequisites = "Firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs must show traffic towards device management addresses."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Approved vendor or MSSP remote support over SSH from external addresses, administrators on VPN or carrier-NAT addresses, internet-wide SSH scanners and brute-force noise against an exposed SSH port, and external monitoring or configuration-backup services."
    tuning_guidance = "Add approved administration source addresses to %global_allowed_mgmt_sources and authorised security testing sources to %global_allowed_scanners. If SSH noise is high on internet-facing addresses, restrict the rule to management subnets by tuning the target scope in the client environment, or raise severity only for Telnet. Any Telnet from external sources should be treated as high priority."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 22 or $net.target.port = 23)
    $net.principal.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(
      if($net.target.port = 23, 85, 65)
    )
    $mitre_technique_id = array_distinct("T1059.008")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $cli_ports = array_distinct($net.target.port)

  condition:
    $net
}
