/*
  MITRE Technique : T1505.006 - vSphere Installation Bundles
  Tactic(s)       : Persistence
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:34:45.098763+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_006_ESXi_Login_Then_VIB_Acceptance_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a user login to an ESXi host followed within ten minutes by a host configuration change to the software acceptance level or community-supported VIB settings on the same host. Lowering the acceptance level is a prerequisite for installing unsigned or untrusted vSphere Installation Bundles that persist across reboots. This rule uses authentication and configuration-change telemetry rather than process command lines."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.006"
    mitre_technique_name = "Server Software Component: vSphere Installation Bundles"
    log_prerequisites = "ESXi hostd and auth logs forwarded and parsed into UDM. Logins must map to USER_LOGIN and configuration changes to SETTING_MODIFICATION, with the acceptance-level text present in metadata.description or target.resource.name. The ESXi host must populate principal.hostname consistently on both event types."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Planned patching or driver or agent installs by administrators who relax the acceptance level temporarily; lifecycle-management or hardware-vendor tooling; lab and test hosts that run community-supported bundles by design."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. If hostname fields differ between login and configuration events in your parser, adjust the join field. Raise severity on production clusters outside change windows."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $hostname
    $auth.target.user.userid != ""
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.target.user.userid in %global_allowed_service_accounts

    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.principal.hostname = $hostname
    (
      $cfg.metadata.description = /(acceptance[\s_\-]?level|communitysupported|host[\s_\-]?acceptance)/ nocase or
      $cfg.target.resource.name = /(acceptance[\s_\-]?level|communitysupported|host[\s_\-]?acceptance)/ nocase
    )
    not $cfg.principal.user.userid in %global_allowed_admin_users
    not $cfg.principal.user.userid in %global_allowed_service_accounts

    $auth.metadata.event_timestamp.seconds <= $cfg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1505.006")
    $primary_entity = array_distinct($hostname)
    $login_users = array_distinct($auth.target.user.userid)
    $config_users = array_distinct($cfg.principal.user.userid)
    $changed_settings = array_distinct($cfg.target.resource.name)
    $login_count = count($auth.metadata.id)
    $first_login = min($auth.metadata.event_timestamp.seconds)
    $last_change = max($cfg.metadata.event_timestamp.seconds)

  condition:
    $auth and $cfg
}
