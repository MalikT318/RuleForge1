/*
  MITRE Technique : T1027.010 - Command Obfuscation
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:53:52.943528+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_010_Linux_Service_Parent_Spawns_Obfuscated_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing service or database process (web server, PHP handler, database or cache daemon) spawning a shell or script interpreter whose arguments carry command-obfuscation constructs: base64 or hex decoding, IFS substitution, ANSI-C quoting, string reversal, or decode-and-pipe-to-shell. Pivots on the anomalous parent-child lineage, so renamed payloads or changed obfuscation tools do not evade it. This is typical of web shell or injection-driven execution."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.010"
    mitre_technique_name = "Obfuscated Files or Information: Command Obfuscation"
    log_prerequisites = "Linux EDR or auditd execve telemetry normalised to UDM PROCESS_LAUNCH with populated parent process path, child process path and command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate web applications or admin panels that shell out to helper scripts using base64 or printf; database maintenance jobs or stored procedures that run shell commands (e.g. PostgreSQL archive_command, MySQL backup hooks); deployment hooks launched from application servers."
    tuning_guidance = "Add approved parent processes or script-running hosts to %global_allowed_script_hosts. Add sanctioned maintenance tooling to %global_allowed_admin_tools. Extend the parent-process regex with additional service daemons (e.g. application-specific runtimes) per client environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9\.]*|php-cgi|mysqld|mariadbd|postgres|redis-server|mongod|tomcat[0-9]*)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|ash|zsh|ksh|python[0-9\.]*|perl|ruby)$/ nocase
    $proc.target.process.command_line = /(base64\s+(-d|--decode)|\$\{IFS\}|\$'\\x[0-9a-f]{2}|(\\x[0-9a-f]{2}){3,}|\\[0-7]{3}.*\\[0-7]{3}.*\\[0-7]{3}|\brev\b|xxd\s+-r|\|\s*(sh|bash|dash)\b|\beval\b.*\$\()/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.hostname in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.010")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
