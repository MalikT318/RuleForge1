/*
  MITRE Technique : T1564.002 - Hidden Users
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:16:37.376215+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_002_Linux_Hidden_User_Config_Churn {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several modifications to Linux display-manager and AccountsService configuration files that control user visibility (SystemAccount flags, hidden-users lists, greeter user-list settings) occur on one host within ten minutes. Adversaries use these files to hide accounts they create from login screens and user lists. A single edit is routine; repeated edits by a non-allowlisted actor suggest account concealment."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.002"
    mitre_technique_name = "Hide Artifacts: Hidden Users"
    log_prerequisites = "Requires Linux EDR or auditd file-modification telemetry (watch rules on /var/lib/AccountsService, /etc/lightdm, /etc/gdm3, /etc/sddm.conf*) normalised to UDM FILE_MODIFICATION with principal process and user populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management (Ansible, Puppet, Chef, Salt) pushing desktop or login-manager settings, golden-image builds, kiosk or lab provisioning, administrators hardening greeter settings, desktop sessions updating AccountsService user files at login."
    tuning_guidance = "Add configuration management and provisioning binaries to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Raise the #file threshold on workstation fleets with heavy desktop use, and review the modified_files outcome to identify noisy paths."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/(var\/lib\/AccountsService\/users\/[^\/]+|etc\/lightdm\/(users\.conf|lightdm\.conf|lightdm\.conf\.d\/.+)|etc\/gdm3?\/.+|etc\/dconf\/db\/(gdm|lightdm)\.d\/.+|etc\/sddm\.conf(\.d\/.+)?)$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|rpm|apt|apt-get|yum|dnf|accounts-daemon)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1564.002")
    $primary_entity = array_distinct($host)
    $modified_files = array_distinct($file.target.file.full_path)
    $actor_users = array_distinct($file.principal.user.userid)
    $actor_processes = array_distinct($file.principal.process.file.full_path)

  condition:
    #file >= 3
}
