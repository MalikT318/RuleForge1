/*
  MITRE Technique : T1557.003 - DHCP Spoofing
  Tactic(s)       : Credential Access, Collection
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:34:29.645747+00:00
  Reference       : https://attack.mitre.org/techniques/T1557/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1557_003_Rogue_DHCP_Server_Reply_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects DHCP server-to-client traffic (UDP source port 67 to destination port 68) originating from a non-internal address. Legitimate DHCP servers and relays answer from internal address space, so DHCP replies sourced from outside it observed at the perimeter indicate a spoofed or rogue DHCP server, or an adversary-controlled relay, trying to push malicious gateway or DNS settings to Windows clients."
    mitre_tactic = "Credential Access, Collection"
    mitre_technique = "T1557.003"
    mitre_technique_name = "Adversary-in-the-Middle: DHCP Spoofing"
    log_prerequisites = "Firewall or perimeter logs that record UDP connections with source and destination ports and populated principal.ip, target.ip and network.ip_protocol. Logging of permitted and denied traffic on DHCP ports (67/68) is required."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "ISP or cloud-provided DHCP on WAN or guest interfaces, DHCP relay or helper appliances using non-internal addresses, misconfigured NAT that rewrites DHCP source addresses, branch-office or VPN gateways that proxy DHCP, lab or segmented networks using non-RFC1918 address space."
    tuning_guidance = "Add approved DHCP server and relay addresses to %global_allowed_mgmt_sources. Ensure %rfc1918_internal covers all internal ranges the client uses, including any non-RFC1918 internal space. Consider scoping the rule to interfaces or zones where DHCP should never cross the perimeter."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "UDP" nocase
    $net.principal.port = 67
    $net.target.port = 68
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1557.003")
    $primary_entity = array_distinct($net.principal.ip)
    $victim_ips = array_distinct($net.target.ip)
    $event_count = count($net.metadata.id)

  condition:
    $net
}
