/*
  MITRE Technique : T1546.016 - Installer Packages
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:22:41.559229+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_016_Linux_Installer_Script_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell executing a package maintainer or installer scriptlet (dpkg preinst/postinst/prerm/postrm or an rpm-tmp scriptlet) when the parent process is not a recognised package manager. Legitimate installer scripts are launched by dpkg, rpm and similar tools. Execution from any other lineage, such as a web server, database service, cron, an interactive shell or a script interpreter, suggests the installer script mechanism is being abused to run elevated persistence content."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.016"
    mitre_technique_name = "Event Triggered Execution: Installer Packages"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry normalised to UDM PROCESS_LAUNCH with populated parent (principal.process) and child (target.process) paths and command lines."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Python-based package front ends (dnf, yum, PackageKit, unattended-upgrade wrappers) that run rpm or dpkg scriptlets in-process under a python interpreter parent; configuration management agents (Ansible, Puppet, Chef, Salt) or image build tooling that invokes maintainer scripts manually; administrators re-running a postinst script by hand while troubleshooting; container image builds replaying package scripts."
    tuning_guidance = "Add legitimate parent binaries (package front ends, config management agents, image build tooling) to %global_allowed_admin_tools. If python-based package managers generate noise, add their interpreter paths to the same list or extend the parent-name exclusion regex. Hosts used for packaging or build work can be handled with %global_allowed_script_hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(bash|sh|dash|ash|zsh|ksh)$/ nocase
    $proc.target.process.command_line = /\/var\/lib\/dpkg\/info\/[^\s\/]+\.(preinst|postinst|prerm|postrm)\b|\/var\/tmp\/rpm-tmp\.[a-z0-9]+/ nocase
    $proc.principal.process.file.full_path != ""
    not $proc.principal.process.file.full_path = /\/(dpkg|dpkg-deb|dpkg-preconfigure|dpkg-reconfigure|apt|apt-get|aptitude|rpm|rpmbuild|yum|dnf|dnf-3|microdnf|zypper|snapd|packagekitd|unattended-upgrade|pacman)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546.016")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
