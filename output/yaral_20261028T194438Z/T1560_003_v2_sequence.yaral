/*
  MITRE Technique : T1560.003 - Archive via Custom Method
  Tactic(s)       : Collection
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:00:58.443563+00:00
  Reference       : https://attack.mitre.org/techniques/T1560/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1560_003_Custom_Archive_Staging_Then_External_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A process running from a user-writable location writes several opaque, non-standard container files (.dat, .bin, .enc, .pak and similar) into staging directories, then the same process on the same host connects to an external address within ten minutes. This pattern is consistent with data compressed or encrypted by a custom routine, such as XOR or a stream cipher, and then sent out. It does not depend on command-line strings or known archiver utilities."
    mitre_tactic = "Collection"
    mitre_technique = "T1560.003"
    mitre_technique_name = "Archive Collected Data: Archive via Custom Method"
    log_prerequisites = "Requires EDR or Sysmon-equivalent file-creation telemetry (Sysmon Event 11) and network-connection telemetry (Sysmon Event 3) with the initiating process path populated on both."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software updaters and installers that unpack .dat/.bin/.pak payloads and then call home; game launchers and collaboration clients that cache data files and sync to cloud services; browser and telemetry agents that run from AppData; custom in-house applications that write proprietary data files and upload them."
    tuning_guidance = "Add approved updater, deployment and RMM binaries to %global_allowed_admin_tools, backup tools to %global_allowed_backup_processes, and security agents to %global_allowed_security_tools. Add known-good vendor and CDN destinations to %global_allowed_domains. Raise the #file threshold in the condition or narrow the extension list for noisy environments."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|programdata|windows\\temp|users\\public)\\/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|programdata|windows\\temp|users\\public)\\.*\.(dat|bin|enc|pak|tmp|bak|dmp|out)$/ nocase
    not $file.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|svchost|msiexec|TrustedInstaller)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname
    $file.principal.process.file.full_path = $proc_path

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|programdata|windows\\temp|users\\public)\\/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    $net.principal.hostname = $hostname
    $net.principal.process.file.full_path = $proc_path

    $file.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $proc_path over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1560.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $staged_files = array_distinct($file.target.file.full_path)
    $staged_file_count = count($file.metadata.id)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3 and $net
}
