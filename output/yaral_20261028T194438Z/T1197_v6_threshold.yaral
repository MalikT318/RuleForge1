/*
  MITRE Technique : T1197 - BITS Jobs
  Tactic(s)       : Stealth, Persistence, Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:47:39.266695+00:00
  Reference       : https://attack.mitre.org/techniques/T1197
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1197_BITS_Temp_File_Burst_Per_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of BITS transfer temporary files (BIT<hex>.tmp) created by svchost.exe in user-writable locations on a single host within 10 minutes. A single BITS download is routine, but repeated BITS staging in user-writable paths indicates BITS job abuse for payload download, persistence, or repeated transfers. The rule is based on file-creation telemetry of the BITS service rather than command lines, so it also covers BITS jobs created through PowerShell cmdlets or COM, where no bitsadmin command line exists. Risk score scales with volume."
    mitre_tactic = "Stealth, Persistence, Execution"
    mitre_technique = "T1197"
    mitre_technique_name = "BITS Jobs"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent) with populated principal process path and target file path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software deployment agents and endpoint management clients that use BITS to pull content, application updaters (browsers, collaboration clients, game launchers), OS feature-update downloads, and bulk user-initiated downloads from applications that rely on BITS."
    tuning_guidance = "Add service accounts of approved deployment tooling to %global_allowed_service_accounts. Extend the benign path exclusion for any client-specific update cache directories. Raise the threshold (#file) on hosts such as build servers or software distribution points that legitimately pull many files through BITS."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\svchost\.exe$/ nocase
    $file.target.file.full_path = /\\BIT[0-9A-F]{1,8}\.tmp$/ nocase
    $file.target.file.full_path = /\\(Users|ProgramData|Temp)\\/ nocase
    not $file.target.file.full_path = /\\(SoftwareDistribution|Delivery Optimization|WindowsUpdate)\\/ nocase
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $event_count = count($file.metadata.id)
    $risk_score = max(if($event_count >= 20, 80, 55))
    $mitre_technique_id = array_distinct("T1197")
    $primary_entity = array_distinct($host)
    $bits_temp_paths = array_distinct($file.target.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 5
}
