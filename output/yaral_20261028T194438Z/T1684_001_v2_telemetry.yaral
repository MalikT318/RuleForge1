/*
  MITRE Technique : T1684.001 - Impersonation
  Tactic(s)       : Stealth
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:31:17.008641+00:00
  Reference       : https://attack.mitre.org/techniques/T1684/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1684_001_SaaS_Mailbox_SendAs_Delegation_Granted {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change that grants another identity the right to send as, or fully access, a mailbox (Add-RecipientPermission or Add-MailboxPermission). Adversaries who compromise a tenant use these grants to impersonate executives, finance staff or vendors in BEC and internal spearphishing, and the grant persists after the attacker's session ends. Detection is on the resulting tenant configuration change rather than on any command line."
    mitre_tactic = "Stealth"
    mitre_technique = "T1684.001"
    mitre_technique_name = "Impersonation"
    log_prerequisites = "Requires Exchange Online admin audit events from the unified audit log, ingested with metadata.product_event_type populated with the cmdlet or operation name and normalized to SETTING_MODIFICATION."
    platform = "SaaS"
    log_source = "m365"
    false_positives = "Helpdesk or messaging administrators granting shared-mailbox or executive-assistant delegation, onboarding and offboarding automation, mailbox migration tooling, and legitimate shared-mailbox send-as setup."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users, provisioning and migration accounts to %global_allowed_service_accounts, and approved automation identities to %global_allowed_cloud_principals. If shared-mailbox provisioning is noisy, escalate only when the acting user is not in an approved list or when the target mailbox belongs to a privileged user."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /^(Add-RecipientPermission|Add-MailboxPermission)$/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1684.001")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $target_mailbox = array_distinct($setting.target.user.userid)
    $operation = array_distinct($setting.metadata.product_event_type)
    $source_ip = array_distinct($setting.principal.ip)

  condition:
    $setting
}
