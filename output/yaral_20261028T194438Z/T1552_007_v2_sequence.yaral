/*
  MITRE Technique : T1552.007 - Container API
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:55:38.736533+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_007_K8s_Secrets_Read_Then_Workload_Or_Token_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A Kubernetes identity reads or lists Secrets through the API server and, within ten minutes, the same identity creates a pod or requests a service-account token. This pattern matches an adversary harvesting credentials through the Container API and then using them to run workloads or mint tokens. It does not depend on in-container command lines."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.007"
    mitre_technique_name = "Unsecured Credentials: Container API"
    log_prerequisites = "Kubernetes API server audit logs at Metadata level or higher, normalized to UDM with principal.user.userid and target.url (request URI) populated. Secret get/list requests must be audited."
    platform = "Containers"
    log_source = "container"
    false_positives = "GitOps and deployment controllers that read secrets then create pods, operators and Helm releases, CI/CD runners, secret-sync and external-secrets controllers, cluster admins doing maintenance."
    tuning_guidance = "Add automation and controller identities to %global_allowed_service_accounts and named cluster administrators to %global_allowed_admin_users. Core control-plane identities (system:kube-*, system:node:*, system:apiserver) are excluded by regex. If audit logs do not populate metadata.product_event_type, remove that filter and rely on target.url."

  events:
    $secret.metadata.event_type = "USER_RESOURCE_ACCESS"
    $secret.target.url = /\/api\/v1\/(namespaces\/[^\/]+\/)?secrets(\/|\?|$)/ nocase
    $secret.metadata.product_event_type = /^(get|list)$/ nocase
    $secret.principal.user.userid = $user
    not $secret.principal.user.userid = /^system:(kube-|node:|apiserver|masters)/ nocase
    not $secret.principal.user.userid in %global_allowed_service_accounts
    not $secret.principal.user.userid in %global_allowed_admin_users

    $create.metadata.event_type = "RESOURCE_CREATION"
    $create.target.url = /\/api\/v1\/namespaces\/[^\/]+\/(pods|serviceaccounts\/[^\/]+\/token)(\?|$)/ nocase
    $create.principal.user.userid = $user
    not $create.principal.user.userid in %global_allowed_service_accounts
    not $create.principal.user.userid in %global_allowed_admin_users

    $secret.metadata.event_timestamp.seconds <= $create.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1552.007")
    $primary_entity = array_distinct($user)
    $secret_requests = array_distinct($secret.target.url)
    $created_resources = array_distinct($create.target.url)
    $source_ips = array_distinct($secret.principal.ip)
    $secret_access_count = count($secret.metadata.id)

  condition:
    $secret and $create
}
