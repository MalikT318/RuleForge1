/*
  MITRE Technique : T1219.003 - Remote Access Hardware
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:10:43.245766+00:00
  Reference       : https://attack.mitre.org/techniques/T1219/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1219_003_Linux_External_VNC_RFB_Remote_Console_Session {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side detection of a Linux host opening a connection to an external address on the VNC/RFB port range (5900-5909). IP-KVM and remote access hardware (for example PiKVM- or TinyPilot-class devices) commonly expose or relay an RFB/VNC console, so an external RFB session from a server or workstation is an indicator of an out-of-band interactive command and control channel. The rule matches the protocol behaviour (RFB ports to non-internal destinations) rather than any product name, binary name or hosting address."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1219.003"
    mitre_technique_name = "Remote Access Software: Remote Access Hardware"
    log_prerequisites = "Linux endpoint telemetry (EDR or auditd with network connection auditing) normalised to UDM NETWORK_CONNECTION, with principal.hostname, target.ip, target.port and principal.process.file.full_path populated. The %rfc1918_internal reference list must be populated for the tenant."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators using VNC clients to reach cloud-hosted or partner-managed systems, approved remote support tooling that tunnels RFB, lab or hosting-provider out-of-band consoles, and developer tooling that forwards VNC for remote desktops or test automation."
    tuning_guidance = "Add approved remote support and VNC client binaries to %global_allowed_remote_mgmt, approved out-of-band console destinations to %global_allowed_mgmt_sources, and sanctioned administrative tools to %global_allowed_admin_tools. Hosts that legitimately act as VNC jump points can be excluded by allowing their client process. Consider raising severity for servers with no history of RFB traffic."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port >= 5900
    $net.target.port <= 5909
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1219.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
