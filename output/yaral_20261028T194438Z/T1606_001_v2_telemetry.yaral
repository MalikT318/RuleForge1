/*
  MITRE Technique : T1606.001 - Web Cookies
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:23:31.348668+00:00
  Reference       : https://attack.mitre.org/techniques/T1606/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1606_001_Linux_Browser_Cookie_Store_Modified_By_NonBrowser {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of a browser cookie database (Firefox cookies.sqlite or Chromium-family Cookies) by a process that is not a browser. Forged session cookies are injected into a browser cookie store this way so the adversary can replay them against web applications and bypass MFA. This rule works at the file-artifact layer, so it still fires if command-line logging is evaded."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1606.001"
    mitre_technique_name = "Forge Web Credentials: Web Cookies"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-write watches on user browser profile directories, normalised to UDM FILE_MODIFICATION with principal process path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Browser sync or profile-migration utilities, backup or restore agents, enterprise browser management or profile provisioning scripts, privacy and cleanup tools that edit cookie stores, QA and web-testing automation (headless browser drivers, test frameworks) that seed cookies on purpose."
    tuning_guidance = "Add approved profile management, cleanup and test automation binaries to %global_allowed_admin_tools. Add backup and restore agents to %global_allowed_backup_processes. Add EDR agents to %global_allowed_security_tools. Add dedicated test or automation accounts to %global_allowed_service_accounts. To cover more browsers, extend the browser path and process-name regexes."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    (
      $file.target.file.full_path = /\/\.mozilla\/firefox\/[^\/]+\/cookies\.sqlite$/ nocase or
      $file.target.file.full_path = /\/\.config\/(google-chrome|google-chrome-beta|chromium|microsoft-edge|BraveSoftware\/Brave-Browser|vivaldi|opera)\/[^\/]+\/(Network\/)?Cookies$/ nocase or
      $file.target.file.full_path = /\/snap\/(chromium|firefox|brave)\/[^\/]+\/.*\/(cookies\.sqlite|Cookies)$/ nocase
    )
    $file.principal.process.file.full_path != ""
    not $file.principal.process.file.full_path = /\/(firefox|firefox-bin|firefox-esr|chrome|google-chrome|chromium|chromium-browser|brave|brave-browser|msedge|microsoft-edge|opera|vivaldi-bin|vivaldi)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1606.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_cookie_store = array_distinct($file.target.file.full_path)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
