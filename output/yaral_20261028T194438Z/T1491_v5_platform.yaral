/*
  MITRE Technique : T1491 - Defacement
  Tactic(s)       : Impact
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:42:56.707963+00:00
  Reference       : https://attack.mitre.org/techniques/T1491
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_ESXi_Host_Banner_And_UI_Defacement {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects shell commands on an ESXi host that alter user-visible content: the DCUI/SSH login banners (/etc/motd, /etc/issue), the host welcome message (esxcli system welcomemsg, Annotations.WelcomeMessage advanced setting), or web UI assets under the hostd docroot. Ransomware and hacktivist operators use these changes to deliver ransom notes or claim credit."
    mitre_tactic = "Impact"
    mitre_technique = "T1491"
    mitre_technique_name = "Defacement"
    log_prerequisites = "ESXi shell command logging (shell.log / hostd) forwarded and parsed into UDM PROCESS_LAUNCH events with target.process.command_line populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators legitimately setting a compliance or legal login banner (motd, issue, welcome message) during host build or hardening; configuration management or host-profile remediation scripts; vendor patching or VIB installs that replace web UI assets."
    tuning_guidance = "Add approved configuration-management binaries or parents to %global_allowed_admin_tools and named change-window administrators to %global_allowed_admin_users. Once the standard banner is rolled out, a banner change outside a change window is high-fidelity."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(esxcli\s+system\s+welcomemsg\s+set|esxcli\s+system\s+settings\s+advanced\s+set\s.*Annotations[\/.]WelcomeMessage|(>>?|\btee\b|\bcp\b|\bmv\b|\bsed\s+-i)[^|;&]*(\/etc\/(motd|issue)\b|\/usr\/lib\/vmware\/hostd\/docroot\/[^\s]*\.(html?|js|css|png|jpe?g|svg)))/ nocase
    $proc.principal.hostname = $hostname
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1491")
    $primary_entity = array_distinct($hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
