/*
  MITRE Technique : T1218.013 - Mavinject
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:59:57.737632+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_013_Mavinject_Process_Injection_Telemetry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Microsoft Application Virtualization Injector (mavinject) acting as the source of a process injection event. Mavinject is Windows-only, so no Linux/macOS/cloud equivalent exists and this rule is written for Windows. It is additive to command-line rules because it keys on EDR injection telemetry (PROCESS_INJECTION) rather than PROCESS_LAUNCH arguments. It still fires when the command line is obfuscated, wrapped, or truncated."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.013"
    mitre_technique_name = "System Binary Proxy Execution: Mavinject"
    log_prerequisites = "Requires Windows EDR or Sysmon-equivalent telemetry that records remote-thread, process-injection or handle-based injection and is normalised to PROCESS_INJECTION (for example Sysmon Event ID 8)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Microsoft App-V client operations that attach virtualised applications to running processes; software packaging and sequencing workflows; IT staff testing App-V deployments."
    tuning_guidance = "Add approved App-V or packaging tooling to %global_allowed_admin_tools. Add EDR or AV agents that generate injection events to %global_allowed_security_tools. Where App-V is not deployed, no tuning should be required and any hit warrants investigation."

  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.process.file.full_path = /\\mavinject(32)?\.exe$/ nocase
    $inj.target.process.file.full_path != ""
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.013")
    $primary_entity = array_distinct($inj.principal.hostname)
    $injector_process = array_distinct($inj.principal.process.file.full_path)
    $injected_process = array_distinct($inj.target.process.file.full_path)
    $acting_user = array_distinct($inj.principal.user.userid)

  condition:
    $inj
}
