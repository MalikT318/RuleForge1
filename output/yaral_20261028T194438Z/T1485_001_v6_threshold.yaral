/*
  MITRE Technique : T1485.001 - Lifecycle-Triggered Deletion
  Tactic(s)       : Impact
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:38:12.621053+00:00
  Reference       : https://attack.mitre.org/techniques/T1485/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1485_001_Cloud_Bucket_Lifecycle_Policy_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single identity modified storage bucket or storage account lifecycle/management policies several times within ten minutes. Adversaries apply short-expiry deletion lifecycle rules to destroy all objects (ransomware-style data destruction) or to wipe log buckets. One policy change is routine; a burst from one principal is not."
    mitre_tactic = "Impact"
    mitre_technique = "T1485.001"
    mitre_technique_name = "Data Destruction: Lifecycle-Triggered Deletion"
    log_prerequisites = "Cloud control-plane audit logs (object storage management events) ingested and normalised to UDM SETTING_MODIFICATION with metadata.product_event_type populated, and principal.user.userid mapped to the calling identity."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Infrastructure-as-code pipelines applying lifecycle policies across many buckets, cloud cost-optimisation or storage governance tooling, bulk onboarding of new buckets, administrators doing planned retention clean-up, and data-platform migrations."
    tuning_guidance = "Add automation identities and IaC pipeline roles to %global_allowed_service_accounts, approved cloud service principals to %global_allowed_cloud_principals, and named storage admins to %global_allowed_admin_users. Raise the #cloud threshold in noisy tenants. The generic bucket update API match can be narrowed if product_event_type values in a tenant are very broad."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /(PutBucketLifecycle|PutBucketLifecycleConfiguration|managementPolicies\/write|storage\.buckets\.(update|patch))/ nocase
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($cloud.metadata.id)
    $mitre_technique_id = array_distinct("T1485.001")
    $primary_entity = array_distinct($user)
    $affected_resources = array_distinct($cloud.target.resource.name)
    $api_calls = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    #cloud >= 3
}
