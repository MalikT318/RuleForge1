/*
  MITRE Technique : T1553.005 - Mark-of-the-Web Bypass
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:07:29.088532+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_005_MOTW_SaveZoneInformation_Policy_Tampering {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of the Windows Attachment Manager SaveZoneInformation policy value. This policy controls whether Zone.Identifier (Mark-of-the-Web) alternate data streams are written to downloaded files. Tampering with it stops MOTW tagging, which bypasses SmartScreen and Office Protected View. MOTW is an NTFS feature specific to Windows, so no Linux, macOS or cloud equivalent exists. This variant is therefore written for Windows registry telemetry."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.005"
    mitre_technique_name = "Subvert Trust Controls: Mark-of-the-Web Bypass"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events) that populates target.registry.registry_key, registry_value_name and the writing process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy or MDM pushes that intentionally change Attachment Manager behaviour, IT hardening or baseline scripts, software deployment tools, and legacy line-of-business applications whose installers relax download-tagging behaviour."
    tuning_guidance = "Add approved deployment and hardening tooling to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. The rule does not filter on the written value, because registry value data is inconsistently populated across sources. Review $registry_value_data in the outcome: a value of 1 means zone information is NOT saved (malicious), and 2 is the Windows default (benign). If value data is reliably populated in your tenant, add a filter on it to cut noise further."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\Attachments$/ nocase
    $reg.target.registry.registry_value_name = /^SaveZoneInformation$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1553.005")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_data = array_distinct($reg.target.registry.registry_value_data)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
