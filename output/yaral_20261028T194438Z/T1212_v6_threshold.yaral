/*
  MITRE Technique : T1212 - Exploitation for Credential Access
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:21:07.654285+00:00
  Reference       : https://attack.mitre.org/techniques/T1212
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1212_IdP_Excessive_External_Logins_Per_User {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single user account generates an unusually high number of sign-in events from external (non-RFC1918) source addresses within ten minutes. This volume can indicate authentication token replay, forged or stolen ticket reuse, or exploitation of an authentication flaw to obtain or abuse credentials. Each sign-in alone is benign; the burst is the signal."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1212"
    mitre_technique_name = "Exploitation for Credential Access"
    log_prerequisites = "Requires identity provider sign-in logs normalised to UDM USER_LOGIN with principal.user.userid and principal.ip populated."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Users behind shared corporate or VPN egress that is not in RFC1918 space, mobile clients refreshing sessions repeatedly, single-sign-on integrations that generate many sign-in events per session, password-manager or sync clients, load tests and automation using personal accounts."
    tuning_guidance = "Add known automation accounts to %global_allowed_service_accounts and privileged admin accounts that legitimately generate bursts to %global_allowed_admin_users. Raise the #auth threshold (default 15) in noisy tenants. Review the distinct_source_ips outcome: many different IPs for one user is higher confidence than one IP."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid = $user
    $auth.principal.user.userid != ""
    not $auth.principal.ip in %rfc1918_internal
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($auth.metadata.id)
    $distinct_source_ips = array_distinct($auth.principal.ip)
    $target_applications = array_distinct($auth.target.application)
    $mitre_technique_id = array_distinct("T1212")
    $primary_entity = array_distinct($user)

  condition:
    #auth >= 15
}
