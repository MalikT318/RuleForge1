/*
  MITRE Technique : T1211 - Exploitation for Stealth
  Tactic(s)       : Stealth
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:18:08.424064+00:00
  Reference       : https://attack.mitre.org/techniques/T1211
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1211_Linux_Logging_Daemon_Spawns_Shell_Or_Transfer_Tool {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux logging, auditing or telemetry daemon (syslog, auditd, journald, log forwarders) spawning a shell, scripting interpreter or network transfer utility. These daemons have no normal need to launch such children, so this is a strong post-exploitation signal of a vulnerable logging or monitoring component being abused to run code stealthily from a trusted, rarely scrutinised process lineage."
    mitre_tactic = "Stealth"
    mitre_technique = "T1211"
    mitre_technique_name = "Exploitation for Stealth"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records (SYSCALL/EXECVE) normalised to UDM PROCESS_LAUNCH with parent process path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Rsyslog omprog or pipe outputs invoking helper scripts, auditd action scripts (for example admin_space_left_action or audispd plugins), log forwarders with exec-based input plugins, and custom log-rotation or health-check hooks launched directly by the daemon."
    tuning_guidance = "Add approved parent daemon paths to %global_allowed_script_hosts and sanctioned helper binaries to %global_allowed_admin_tools. Review the child command line in the alert before escalation; interactive shells or download utilities launched from these daemons should be treated as true positives."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(rsyslogd|syslog-ng|auditd|audispd|systemd-journald|journald|fluentd|fluent-bit|td-agent|osqueryd)$/ nocase
    (
      $proc.target.process.file.full_path = /\/(ba|da|a|z|k|c|tc)?sh$/ nocase or
      $proc.target.process.file.full_path = /\/(python[0-9.]*|perl|php|nc|ncat|netcat|socat|curl|wget|tftp)$/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1211")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
