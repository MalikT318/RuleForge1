/*
  MITRE Technique : T1056.003 - Web Portal Capture
  Tactic(s)       : Collection, Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:50:22.232615+00:00
  Reference       : https://attack.mitre.org/techniques/T1056/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1056_003_Portal_Server_Repeated_External_Small_POSTs {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects one internal source repeatedly sending small HTTP POST requests to external destinations that are not on the known-good domain list within ten minutes. This is the network-observable result of a compromised login portal (VPN, web mail, RD Web, ADFS-style page) relaying captured credentials to an attacker-controlled collector. The individual POST is benign; the repeated small-body pattern to unapproved external hosts is not."
    mitre_tactic = "Collection, Credential Access"
    mitre_technique = "T1056.003"
    mitre_technique_name = "Input Capture: Web Portal Capture"
    log_prerequisites = "Requires firewall or proxy logs that normalise to NETWORK_HTTP with HTTP method, source IP, destination IP/host and sent bytes populated. TLS inspection is needed to see the method on encrypted traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Windows-hosted web servers that legitimately call external APIs (payment, SMS or MFA gateways, webhooks), telemetry and licensing beacons from server software, monitoring agents, and SaaS integrations not yet in the known-good domain list."
    tuning_guidance = "Add legitimate external API and vendor domains to %global_allowed_domains. Raise the #http threshold on noisy hosts. Prioritise alerts where the source IP belongs to an internet-facing portal server. Review the destination hosts in the outcome for rare or newly registered domains."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.network.sent_bytes > 0
    $http.network.sent_bytes < 4096
    $http.principal.ip = $src_ip
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1056.003")
    $primary_entity = array_distinct($src_ip)
    $post_count = count($http.metadata.id)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $total_bytes_sent = sum($http.network.sent_bytes)

  condition:
    #http >= 10
}
