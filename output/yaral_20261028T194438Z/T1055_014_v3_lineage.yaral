/*
  MITRE Technique : T1055.014 - VDSO Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:03:15.721364+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_014_Linux_Service_Daemon_Spawns_Shell_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter launched directly by a network-facing or service daemon (web server, database, print, DNS, file-sharing or container runtime). VDSO hijacking and other in-memory injection run attacker code under a legitimate process, and the usual first visible result is that process spawning a shell. The rule pivots on the parent-child lineage and does not inspect command lines or the injection primitive itself."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.014"
    mitre_technique_name = "Process Injection: VDSO Hijacking"
    log_prerequisites = "Linux EDR or auditd (execve records) with parent and child process image paths populated in UDM PROCESS_LAUNCH events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "PHP or CGI applications that call exec/system through a web server; PostgreSQL archive_command, COPY PROGRAM or backup hooks; MySQL/MariaDB UDF or event scripts; CUPS filter and backend scripts; container runtime health checks; Samba root-preexec or logon scripts; management agents that run as a child of these daemons."
    tuning_guidance = "Add legitimate parent daemon paths (for example a PHP-driven application server) to %global_allowed_script_hosts. Add approved automation wrappers to %global_allowed_admin_tools. If a daemon is noisy on a particular client, narrow the parent list or scope an exclusion to that client's tenant instead of loosening the child-process match."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9.]*|tomcat[0-9]*|mysqld|mariadbd|postgres|mongod|redis-server|memcached|cupsd|named|smbd|dockerd|containerd)$/ nocase
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|csh|tcsh|ash|python[0-9.]*|perl|ruby|node)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.014")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
