/*
  MITRE Technique : T1673 - Virtual Machine Discovery
  Tactic(s)       : Discovery
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:16:32.381531+00:00
  Reference       : https://attack.mitre.org/techniques/T1673
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1673_ESXi_External_Mgmt_API_VM_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects HTTP requests to the hypervisor management API (SOAP /sdk endpoint or host web UI) from a non-internal source that is not on the approved management-source list. Remote VM inventory enumeration via the management API is a common precursor to service stop and encryption activity."
    mitre_tactic = "Discovery"
    mitre_technique = "T1673"
    mitre_technique_name = "Virtual Machine Discovery"
    log_prerequisites = "Requires ESXi reverse-proxy or hostd HTTP request logging, normalised to UDM NETWORK_HTTP with principal.ip, target.url and network.http.method populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Remote administrators or MSP staff connecting from public addresses, cloud-hosted backup or monitoring platforms polling the API, external vulnerability scanners, and VPN egress addresses that are not in the internal list."
    tuning_guidance = "Add approved management and VPN egress addresses to %global_allowed_mgmt_sources. Add monitoring and backup service accounts to %global_allowed_service_accounts. Add authorised scanner sources to %global_allowed_scanners. Confirm the client's internal ranges are present in %rfc1918_internal."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\/(sdk|ui)(\/|\?|$)/ nocase
    $net.network.http.method = /^(POST|GET)$/ nocase
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1673")
    $primary_entity = array_distinct($net.target.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $requested_urls = array_distinct($net.target.url)
    $source_users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
