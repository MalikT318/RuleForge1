/*
  MITRE Technique : T1566 - Phishing
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:44:59.533846+00:00
  Reference       : https://attack.mitre.org/techniques/T1566
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1566_SaaS_OAuth_Consent_Grant_Setting_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a delegated application consent or OAuth permission grant by a non-administrative user in the identity provider. Consent phishing lures users into approving a malicious third-party application, which gives the attacker persistent token-based access without stealing credentials or passing MFA. The rule detects the resulting configuration change in the tenant, not the phishing message or any endpoint command line."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1566"
    mitre_technique_name = "Phishing"
    log_prerequisites = "Identity provider directory audit logs that record application consent and permission grant events, normalised to UDM SETTING_CREATION with metadata.product_event_type populated."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Legitimate users consenting to sanctioned productivity or collaboration apps, new SaaS onboarding projects, developers registering internal test applications, and admin-approved consent workflows that run under a user context."
    tuning_guidance = "Add approved application names to %global_allowed_cloud_principals. Add administrators who routinely grant consent to %global_allowed_admin_users. Add automation accounts to %global_allowed_service_accounts. If the product_event_type naming differs in your tenant, adjust the regex on metadata.product_event_type."

  events:
    $setting.metadata.event_type = "SETTING_CREATION"
    $setting.metadata.product_event_type = /(consent|oauth2?\s*permission|permission\s*grant|delegated\s*permission|app(lication)?\s*role\s*assignment)/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.target.resource.name in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1566")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $granted_app = array_distinct($setting.target.resource.name)
    $source_ip = array_distinct($setting.principal.ip)
    $event_name = array_distinct($setting.metadata.product_event_type)

  condition:
    $setting
}
