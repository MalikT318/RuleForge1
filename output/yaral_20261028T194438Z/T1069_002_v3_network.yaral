/*
  MITRE Technique : T1069.002 - Domain Groups
  Tactic(s)       : Discovery
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:59:09.483234+00:00
  Reference       : https://attack.mitre.org/techniques/T1069/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1069_002_External_Directory_Protocol_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects perimeter-observed connections from an internal host to a non-internal destination on directory service ports (LDAP 389, LDAPS 636, Global Catalog 3268/3269). Domain group enumeration (T1069.002) uses these protocols, and they should not cross the perimeter to external addresses. This catches enumeration against externally reachable or hybrid directory endpoints, enumeration tunneled out through a pivot, and LDAP-based reconnaissance from a compromised host. It complements endpoint command-line detections. Internal-to-internal LDAP never reaches a perimeter firewall, so this rule cannot see in-network enumeration and is not a substitute for endpoint coverage."
    mitre_tactic = "Discovery"
    mitre_technique = "T1069.002"
    mitre_technique_name = "Permission Groups Discovery: Domain Groups"
    log_prerequisites = "Requires firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.hostname, target.ip and target.port populated for outbound traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Hosts authenticating to cloud-hosted or hybrid directory services over LDAPS (managed directory services, cloud identity sync), third-party SaaS directory integrations, vendor or partner federated LDAP, authorised vulnerability scanners and penetration tests, and branch sites reaching a domain controller across the perimeter."
    tuning_guidance = "Add known scanners to %global_allowed_scanners. Internal address space is excluded via %rfc1918_internal. If the client uses a cloud directory over LDAPS, exclude those sync hosts by adding them to %global_allowed_scanners, or narrow the rule to the cleartext ports (389, 3268) only. Consider pairing with the endpoint rules for this technique to raise confidence."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 389 or
      $net.target.port = 636 or
      $net.target.port = 3268 or
      $net.target.port = 3269
    )
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1069.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
