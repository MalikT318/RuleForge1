/*
  MITRE Technique : T1059.003 - Windows Command Shell
  Tactic(s)       : Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:09:19.063130+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_003_Batch_Script_Dropped_By_Untrusted_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a .bat or .cmd batch file in a user-writable or staging location (user profile, temp, Public, ProgramData) by a process that does not normally author batch scripts: Office, browsers, archivers, or script hosts. This detects the file artifact that precedes Windows Command Shell execution, so it still fires when command-line logging is evaded or obfuscated."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.003"
    mitre_technique_name = "Command and Scripting Interpreter: Windows Command Shell"
    log_prerequisites = "Requires EDR or Sysmon-equivalent file creation telemetry (Sysmon Event ID 11 or equivalent) populating principal.process.file.full_path and target.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Browser or archive extraction of legitimate vendor installers that bundle .bat/.cmd files, developers and admins unpacking scripts from downloads, software installers that write batch helpers to Temp, Office macro-based business tooling, and IT staff using PowerShell to generate maintenance scripts."
    tuning_guidance = "Add approved script-generating parent processes to %global_allowed_script_hosts, deployment and RMM tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. If the rule is noisy on developer workstations, scope those hosts out via %global_allowed_script_hosts or remove the interpreter processes from the parent regex."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata\\local\\temp|appdata\\roaming|downloads|desktop)|windows\\temp|users\\public|programdata)\\([^\\]+\\)*[^\\]+\.(bat|cmd)$/ nocase
    $file.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|onenote|mshta|wscript|cscript|powershell|pwsh|chrome|msedge|firefox|iexplore|winrar|7z|7zfm|7zg)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1059.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file = array_distinct($file.target.file.full_path)
    $dropper_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
