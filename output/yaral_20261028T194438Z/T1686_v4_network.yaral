/*
  MITRE Technique : T1686 - Disable or Modify System Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:27:33.094801+00:00
  Reference       : https://attack.mitre.org/techniques/T1686
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_Inbound_Internet_To_Windows_Mgmt_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects perimeter-observed connections from external (non-internal) source addresses to Windows administrative and remote-access service ports (RDP, SMB, RPC, NetBIOS, WinRM). Such traffic is normally blocked at the perimeter and host firewall, so a flow that reaches these ports from the Internet suggests a firewall profile was disabled, a rule was added or loosened, or a service was moved to a permitted port. This is the network-side counterpart to endpoint firewall-tampering detections."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686"
    mitre_technique_name = "Disable or Modify System Firewall"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with populated principal.ip and target.port. Logs should capture traffic at the Internet edge of the Windows server segments."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Intentionally published services such as RDP gateways, VPN or jump hosts, internet-facing SMB or WinRM for a managed workflow; authorised external vulnerability scans and penetration tests; managed-service-provider remote access from provider egress addresses; internet background scanning that is allowed through by a permissive policy (which is still a finding)."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners and approved external administration or MSP source addresses to %global_allowed_mgmt_sources. If the firewall log records the verdict, the client can restrict the rule to allowed sessions in a local copy. Keep %rfc1918_internal populated with all internal and carrier-grade NAT space for the tenant."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 3389 or
      $net.target.port = 445 or
      $net.target.port = 135 or
      $net.target.port = 139 or
      $net.target.port = 5985 or
      $net.target.port = 5986
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1686")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
