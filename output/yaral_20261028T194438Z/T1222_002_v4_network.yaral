/*
  MITRE Technique : T1222.002 - Linux and Mac Permissions
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:21:01.889794+00:00
  Reference       : https://attack.mitre.org/techniques/T1222/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_002_Linux_Network_Egress_From_Staged_Executable {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound external network connection initiated by a process whose binary runs from a world-writable staging directory (/tmp, /var/tmp, /dev/shm). Attackers typically download a payload and use chmod to make it executable (T1222.002), so a staged binary beaconing to an external host is the network-side result of that permission change. This is an indirect, result-based detection and complements endpoint chmod/chown monitoring."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1222.002"
    mitre_technique_name = "File and Directory Permissions Modification: Linux and Mac File and Directory Permissions Modification"
    log_prerequisites = "Requires Linux endpoint telemetry (EDR or auditd) that produces NETWORK_CONNECTION events with principal.process.file.full_path populated. Network-only sources (firewall, flow) without process attribution will not match."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software installers or package builds that run from /tmp, CI/CD runners and build agents, self-extracting installers, developer test binaries, configuration management agents bootstrapping from /tmp, containers using /tmp for helper binaries."
    tuning_guidance = "Add approved tooling binary paths to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Add known-good external destinations (vendor update services) to %global_allowed_domains if the log source populates target.hostname and extend the rule with that exclusion. Correlate with endpoint chmod/chown PROCESS_LAUNCH events on the same host for triage."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    $net.target.port > 0
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1222.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $staged_binaries = array_distinct($net.principal.process.file.full_path)
    $acting_users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
