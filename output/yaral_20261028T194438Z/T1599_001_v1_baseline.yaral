/*
  MITRE Technique : T1599.001 - Network Address Translation Traversal
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:01:33.262937+00:00
  Reference       : https://attack.mitre.org/techniques/T1599/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1599_001_NAT_Configuration_Change_On_Border_Device {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a management-plane configuration change that creates or modifies Network Address Translation (NAT, SNAT, DNAT, PAT, masquerade or port-forward) settings on a firewall or border device. An adversary with control of a boundary device can use NAT changes to route traffic between trusted and untrusted networks or to obscure the origin of their traffic. Changes made by accounts or sources outside the approved administrator, service account and management source lists are flagged."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1599.001"
    mitre_technique_name = "Network Boundary Bridging: Network Address Translation Traversal"
    log_prerequisites = "Requires firewall or border device configuration audit / change logs (admin command or config commit events) forwarded to Chronicle and normalised to SETTING_MODIFICATION, with the change description or object name populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Planned change-window NAT work for new services or migrations, HA peer configuration synchronisation, network automation (Ansible, Terraform, orchestration controllers) pushing NAT policy, and initial provisioning of new devices."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users, automation and orchestration accounts to %global_allowed_service_accounts, and jump hosts or management subnets to %global_allowed_mgmt_sources. Correlate hits with change tickets. If the log source populates only one of metadata.description or target.resource.name, the other branch is harmless and can be left in place."

  events:
    $set.metadata.event_type = "SETTING_MODIFICATION"
    (
      $set.metadata.description = /\b(nat|snat|dnat|pat|masquerade|port[-_ ]?forward(ing)?|static[-_ ]nat|nat[-_ ](rule|policy|pool))\b/ nocase or
      $set.target.resource.name = /\b(nat|snat|dnat|pat|masquerade|port[-_ ]?forward(ing)?|static[-_ ]nat|nat[-_ ](rule|policy|pool))\b/ nocase
    )
    not $set.principal.user.userid in %global_allowed_admin_users
    not $set.principal.user.userid in %global_allowed_service_accounts
    not $set.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1599.001")
    $primary_entity = array_distinct(strings.coalesce($set.target.hostname, $set.principal.hostname))
    $actor = array_distinct($set.principal.user.userid)
    $source_ip = array_distinct($set.principal.ip)
    $change_detail = array_distinct($set.metadata.description)
    $changed_object = array_distinct($set.target.resource.name)

  condition:
    $set
}
