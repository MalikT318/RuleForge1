/*
  MITRE Technique : T1036.009 - Break Process Trees
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:11:43.212394+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_009_Linux_Orphaned_Exec_From_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a binary executed from a world-writable or volatile Linux location (/tmp, /var/tmp, /dev/shm, /run/user, hidden directories) whose parent is PID 1 (init/systemd). This is the signature of a double-fork or daemon() call that orphans the payload and breaks the original process tree (T1036.009), as used by BPFDoor and XorDdos-style implants. Detection is based on process lineage and execution location, not command-line content, so it complements existing command-line rules."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.009"
    mitre_technique_name = "Masquerading: Break Process Trees"
    log_prerequisites = "Linux EDR or auditd (execve) telemetry normalised to UDM PROCESS_LAUNCH, with principal.process.pid (parent PID) and target.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package installers or self-extracting installers that daemonize from /tmp; CI/CD runners and build agents; container runtimes or user-level systemd units (/run/user/<uid>) launching helper binaries; admin or RMM scripts that use nohup/setsid from /tmp; legitimate daemons that are orphaned when their launcher exits."
    tuning_guidance = "Add approved tooling binary paths to %global_allowed_admin_tools, build and automation accounts to %global_allowed_service_accounts, and CI or build hosts to %global_allowed_script_hosts. If /run/user/<uid> produces noise from desktop or session services, remove that branch of the path regex for server fleets."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.pid = "1"
    $proc.target.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/shm|run\/user\/[0-9]+|var\/run\/user\/[0-9]+)\/|\/\.[^\/]+\/[^\/]+$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1036.009")
    $primary_entity = array_distinct($proc.principal.hostname)
    $orphaned_binary = array_distinct($proc.target.process.file.full_path)
    $executing_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
