/*
  MITRE Technique : T1027.001 - Binary Padding
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:39:09.196584+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_001_Mass_Executable_Modification_In_Writable_Paths {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of modifications to existing executable files (exe, dll, scr, sys) in user-writable locations on a single host within 10 minutes. Any one modification is benign. Bulk in-place rewriting of binaries by one non-allowlisted process is consistent with binary padding, where junk data is appended to payloads to change their on-disk representation, size and checksum. This is a behavioral proxy because file-size deltas are not reliably populated in UDM, and it complements existing command-line rules by using file telemetry."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.001"
    mitre_technique_name = "Obfuscated Files or Information: Binary Padding"
    log_prerequisites = "Requires Windows endpoint file-modification telemetry (EDR or Sysmon) normalised to UDM FILE_MODIFICATION with principal.process and target.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software updaters and installers rewriting binaries in AppData or ProgramData, developer build toolchains, packers or code-signing pipelines on engineering workstations, self-updating portable applications, RMM and patching agents."
    tuning_guidance = "Add approved patching and deployment binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Developer and build hosts can be raised to a higher threshold, for example #file >= 25, or scoped out per client. Raise or lower the #file threshold according to the environment's baseline."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\.(exe|dll|scr|sys)$/ nocase
    $file.target.file.full_path = /(\\users\\[^\\]+\\(appdata|downloads|desktop|documents)\\|\\programdata\\|\\users\\public\\|\\windows\\temp\\|\\temp\\)/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path = /\\(msiexec|TrustedInstaller|TiWorker|MsMpEng|MsSense|SenseIR|wuauclt|usoclient)\.exe$/ nocase

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.001")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $modified_files = array_distinct($file.target.file.full_path)
    $modifying_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 10
}
