/*
  MITRE Technique : T1074.001 - Local Data Staging
  Tactic(s)       : Collection
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:18:15.819505+00:00
  Reference       : https://attack.mitre.org/techniques/T1074/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_001_Archive_Staged_In_Common_Staging_Directory {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of an archive or compressed container (zip, rar, 7z, cab, tar, gz and similar) in a world-writable or rarely-used staging directory such as Users\\Public, ProgramData, Windows\\Temp, PerfLogs, the Recycle Bin, Windows\\Tasks or Windows\\Debug. Adversaries commonly consolidate collected data into one file in these locations before exfiltration. The rule works on the resulting file artifact, so it does not depend on command-line logging or on which tool built the archive."
    mitre_tactic = "Collection"
    mitre_technique = "T1074.001"
    mitre_technique_name = "Data Staged: Local Data Staging"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) that populates target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters unpacking cabinet or zip payloads in ProgramData or Windows\\Temp, Windows Error Reporting and diagnostic cabinet files, backup and imaging agents, RMM and patching tools, log-collection scripts run by administrators, and application vendors that cache downloaded packages in ProgramData."
    tuning_guidance = "Add backup agents to %global_allowed_backup_processes, patching and deployment tooling to %global_allowed_admin_tools, and EDR/AV agents to %global_allowed_security_tools. Add automation accounts that legitimately build archives to %global_allowed_service_accounts. If a client has a noisy vendor that writes archives under ProgramData, exclude that vendor's process by executable name through the lists above rather than by install path."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\public|programdata|windows\\temp|perflogs|\$recycle\.bin|windows\\tasks|windows\\debug)\\.*\.(zip|zipx|rar|7z|cab|tar|gz|tgz|bz2|xz)$/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|MpCmdRun|TiWorker|TrustedInstaller|msiexec|WerFault|wermgr|wuauclt|usoclient)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1074.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $staged_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
