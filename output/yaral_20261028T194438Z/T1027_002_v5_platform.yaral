/*
  MITRE Technique : T1027.002 - Software Packing
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:40:46.388399+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_002_Packed_PE_Rewritten_In_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an existing PE file (exe, dll, scr, sys) in a user-writable directory being modified in place by a process that is itself running from a user-writable directory. Executable packers and crypters such as UPX or MPRESS compress or encrypt a binary and rewrite it on disk, replacing the original content with a stub plus a packed payload. This rule uses FILE_MODIFICATION telemetry rather than process command lines, so it covers renamed packers and custom packing tools. Note: the request asked for an alternate platform, but the platform and log_source requirements fixed this rule to Windows endpoint telemetry. The additive coverage comes from the file-modification mechanism instead."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.002"
    mitre_technique_name = "Obfuscated Files or Information: Software Packing"
    log_prerequisites = "Requires EDR or Sysmon file telemetry that populates FILE_MODIFICATION events with principal.process.file.full_path and target.file.full_path (for example Sysmon file-modification and file-create events, or EDR file-write telemetry)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developer build output (compilers, linkers, installer builders) writing binaries into user directories; portable application self-updaters; software installers or updaters that run from Temp and patch binaries in AppData; game mod managers and patchers; legitimate use of packers by developers to compress their own software."
    tuning_guidance = "Add approved build or deployment tooling to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Add developer build hosts or approved script hosts to %global_allowed_script_hosts. If the rule is noisy on developer workstations, add the build tool executable names to the writer-name exclusion regex or scope the rule away from developer host groups."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.principal.hostname != ""
    $file.target.file.full_path = /\.(exe|dll|scr|sys)$/ nocase
    $file.target.file.full_path = /(\\users\\[^\\]+\\(appdata|downloads|desktop|documents)\\|\\users\\public\\|\\programdata\\|\\windows\\temp\\|\\temp\\)/ nocase
    $file.principal.process.file.full_path = /(\\users\\[^\\]+\\(appdata|downloads|desktop|documents)\\|\\users\\public\\|\\programdata\\|\\windows\\temp\\|\\temp\\)/ nocase
    not $file.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|msiexec|TrustedInstaller|TiWorker|svchost|setup|update|updater)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1027.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $modified_files = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
