/*
  MITRE Technique : T1566.004 - Spearphishing Voice
  Tactic(s)       : Initial Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:52:57.166695+00:00
  Reference       : https://attack.mitre.org/techniques/T1566/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1566_004_Perimeter_Outbound_Remote_Support_Session {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host opening an outbound connection to an external address on a remote-access or remote-support protocol port (RDP, VNC, and the TeamViewer and AnyDesk default ports). Voice-phishing callers typically talk the victim into starting such a session so the caller can take control of the machine. This is a network-layer detection that does not depend on process or command-line telemetry, so it complements any endpoint-based coverage. A firewall cannot identify the source operating system, so the rule covers the Windows endpoints behind the perimeter along with any other host."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1566.004"
    mitre_technique_name = "Phishing: Spearphishing Voice"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated for outbound traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Helpdesk and managed-service staff using approved remote support from internal hosts, administrators connecting to externally hosted servers over RDP or VNC, vendor support sessions, and cloud-hosted jump hosts."
    tuning_guidance = "Add approved helpdesk and jump-host source addresses to %global_allowed_mgmt_sources, and sanctioned vendor or support destinations to %global_allowed_domains. Where RDP to external addresses is normal for a client, remove 3389 from the port list for that tenant. Prioritise alerts for hosts belonging to non-administrative users."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 3389 or
      $net.target.port = 5900 or
      $net.target.port = 5938 or
      $net.target.port = 7070
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1566.004")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
