/*
  MITRE Technique : T1059.013 - Container CLI/API
  Tactic(s)       : Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:26:45.876768+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_013_Excessive_Container_Exec_API_Calls {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single identity issued a high volume of container exec or attach API calls (interactive command execution inside running pods) within ten minutes. One exec call is routine; a burst from one user suggests scripted command execution through the container API, as in post-compromise administration or discovery across many workloads."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.013"
    mitre_technique_name = "Container CLI/API"
    log_prerequisites = "Requires Kubernetes API server audit logging (Metadata level or higher, including the request URI) ingested and normalised to UDM. Managed cluster audit logs must be enabled."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "CI/CD pipelines and test harnesses running commands in pods, SRE or developers debugging an incident, operators and controllers performing health checks or database maintenance via exec, and automated backup jobs that exec into stateful workloads."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts and named platform administrators to %global_allowed_admin_users. The threshold in the condition (10 in 10m) is conservative; raise it for environments with heavy CI exec use and lower it for locked-down production clusters."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.target.url = /\/pods\/[^\/]+\/(exec|attach)/ nocase
    $cloud.principal.user.userid != ""
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(if($cloud.target.url = /command=(sh|bash|ash|dash)/ nocase, 80, 65))
    $event_count = count($cloud.metadata.id)
    $mitre_technique_id = array_distinct("T1059.013")
    $primary_entity = array_distinct($user)
    $target_pods = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    #cloud >= 10
}
