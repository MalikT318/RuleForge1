/*
  MITRE Technique : T1685.001 - Disable or Modify Windows Event Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:17:48.339757+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_001_EventLog_Config_Registry_Tampering_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Multiple registry modifications to Windows Event Log configuration on a single host within 10 minutes. This covers EventLog service and channel keys, WINEVT channel enable flags, and EventLog Autologger sessions. Changes to the Start, Enabled, MaxSize, Retention or File values are a registry-based way to disable, shrink or redirect logging without any suspicious command line. A single change is routine; several in a short window indicate defence impairment."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.001"
    mitre_technique_name = "Disable or Modify Windows Event Log"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon registry events) with the key path and value name populated, and the process that made the change."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy or MDM pushes that resize or retain logs, SIEM or log-forwarder agent installers, security agent installation or upgrade, imaging and golden-image build tasks, and administrators standardising log sizes."
    tuning_guidance = "Add approved config-management, deployment and log-agent binaries to %global_allowed_admin_tools. Add EDR and logging agents to %global_allowed_security_tools. Add automation accounts to %global_allowed_service_accounts. Raise the #reg threshold if GPO refreshes still produce noise. Servicing processes (TrustedInstaller, TiWorker) are already excluded by executable name."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(\\WINEVT\\Channels\\|\\Services\\EventLog(\\|$)|\\Control\\WMI\\Autologger\\EventLog)/ nocase
    $reg.target.registry.registry_value_name = /^(Enabled|Start|MaxSize|Retention|File)$/ nocase
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|MsMpEng)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    $reg.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($reg.target.registry.registry_value_name = /^(Enabled|Start)$/ nocase, 85, 65))
    $mitre_technique_id = array_distinct("T1685.001")
    $primary_entity = array_distinct($host)
    $event_count = count($reg.metadata.id)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $value_names = array_distinct($reg.target.registry.registry_value_name)
    $actor_processes = array_distinct($reg.principal.process.file.full_path)
    $actor_users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 3
}
