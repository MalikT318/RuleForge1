/*
  MITRE Technique : T1204.002 - Malicious File
  Tactic(s)       : Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:00:44.511247+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_002_Dropped_Executable_Launched_By_User_From_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A browser, mail client, chat client or archive utility writes an executable (exe/scr/pif/com) into a user-writable location (Downloads, Desktop, Documents, Temp, Outlook attachment cache). The same file is then launched from that exact path by the interactive shell or an archive utility within 10 minutes. This is the file-drop to user-execution chain typical of a user opening a malicious attachment or download. The rule joins file-write and execution events on host and file path and does not rely on command-line content."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.002"
    mitre_technique_name = "User Execution: Malicious File"
    log_prerequisites = "Requires EDR or Sysmon-equivalent telemetry for both file creation (with the writing process populated) and process launch (with the parent process populated) on Windows endpoints."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Users downloading and running legitimate installers or portable tools (browser download followed by double-click), self-extracting archives from known vendors, software updaters that stage through Temp, and developers running locally downloaded binaries."
    tuning_guidance = "Add approved deployment or updater tooling to %global_allowed_admin_tools (matched against the file-writing process path). Add trusted administrator accounts to %global_allowed_admin_users. Add approved remote support tooling to %global_allowed_remote_mgmt. For noisy environments, raise severity only when the executed file is also unsigned or has a rare prevalence, via downstream enrichment. File path equality is case-sensitive; if the EDR normalises path case differently across the two event types, add a strings.to_lower() placeholder on both sides."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(chrome|msedge|firefox|brave|opera|iexplore|outlook|olk|thunderbird|7zfm|7z|winrar|teams|ms-teams|slack|discord|telegram)\.exe$/ nocase
    $file.target.file.full_path = /\\users\\[^\\]+\\(downloads|desktop|documents|appdata\\local\\temp|appdata\\local\\microsoft\\windows\\inetcache\\content\.outlook)\\.*\.(exe|scr|pif|com)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_remote_mgmt
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $path

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(explorer|7zfm|winrar)\.exe$/ nocase
    not $proc.principal.user.userid in %global_allowed_admin_users
    $proc.principal.hostname = $hostname
    $proc.target.process.file.full_path = $path

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1204.002")
    $primary_entity = array_distinct($hostname)
    $executed_file = array_distinct($path)
    $dropper_process = array_distinct($file.principal.process.file.full_path)
    $launching_parent = array_distinct($proc.principal.process.file.full_path)
    $executing_user = array_distinct($proc.principal.user.userid)
    $event_count = count($proc.metadata.id)

  condition:
    $file and $proc
}
