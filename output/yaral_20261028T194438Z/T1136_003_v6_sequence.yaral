/*
  MITRE Technique : T1136.003 - Cloud Account
  Tactic(s)       : Persistence
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:11:50.481172+00:00
  Reference       : https://attack.mitre.org/techniques/T1136/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_003_Cloud_Account_Created_Then_Permissions_Granted {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a new cloud user account being created and then granted a role or permission change within ten minutes. The permission change must target the same account that was just created. Adversaries use this pattern to establish persistent, privileged secondary access."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136.003"
    mitre_technique_name = "Create Account: Cloud Account"
    log_prerequisites = "Requires unified audit logs ingested and normalised to UDM, with directory account creation as USER_CREATION and role or permission assignment as USER_CHANGE_PERMISSIONS. Both events must populate target.user.userid."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Joiner onboarding by HR or IT staff who create and license accounts and assign roles in one session. Identity governance and provisioning automation. Helpdesk creating shared or break-glass accounts. Tenant migrations and bulk onboarding projects."
    tuning_guidance = "Add automation and provisioning identities to %global_allowed_service_accounts. Add named onboarding administrators to %global_allowed_admin_users. If the permission-change description is not populated for a client, remove the metadata.description filter and rely on the join. To reduce noise during bulk onboarding, restrict the rule to accounts where the role change is privileged."

  events:
    $create.metadata.event_type = "USER_CREATION"
    $create.target.user.userid != ""
    $create.target.user.userid = $target_user
    not $create.principal.user.userid in %global_allowed_service_accounts
    not $create.principal.user.userid in %global_allowed_admin_users

    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.target.user.userid = $target_user
    $perm.metadata.description = /(role|admin|permission|privilege)/ nocase
    not $perm.principal.user.userid in %global_allowed_service_accounts

    $create.metadata.event_timestamp.seconds <= $perm.metadata.event_timestamp.seconds

  match:
    $target_user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1136.003")
    $primary_entity = array_distinct($target_user)
    $creating_actors = array_distinct($create.principal.user.userid)
    $permission_actors = array_distinct($perm.principal.user.userid)
    $source_ips = array_distinct($create.principal.ip)
    $permission_event_count = count($perm.metadata.id)

  condition:
    $create and $perm
}
