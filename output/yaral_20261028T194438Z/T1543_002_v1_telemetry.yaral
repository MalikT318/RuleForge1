/*
  MITRE Technique : T1543.002 - Systemd Service
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:53:40.919406+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_002_Systemd_Unit_File_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a systemd service or timer unit file in a system-level or user-level systemd unit directory by a process other than a package manager or approved administrative tool. Unit files are the persistence artifact of T1543.002, and this rule detects that artifact on disk rather than the commands used to create it, so it still fires when command-line logging is evaded."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.002"
    mitre_technique_name = "Create or Modify System Process: Systemd Service"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules (for example -w /etc/systemd/system -p wa) that populate FILE_CREATION events with target.file.full_path and the writing process."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package installs and upgrades not covered by the built-in package manager exclusion, configuration management agents (Ansible, Puppet, Chef, Salt), image build and provisioning scripts, container or application installers that register their own services, and administrators manually creating legitimate units."
    tuning_guidance = "Add the writer process path of approved deployment, RMM and configuration management tooling to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Extend the package manager regex if the client uses a distribution-specific installer. For golden-image build hosts, consider excluding the host through a client-specific tuning layer."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/(etc|usr\/lib|lib|usr\/local\/lib|run)\/systemd\/(system|user|system\.control)\/|\/(home\/[^\/]+|root)\/\.config\/systemd\/user\/).+\.(service|timer)$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|rpm|apt|apt-get|yum|dnf|zypper|pacman|apk|snapd|packagekitd|unattended-upgrade)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1543.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $unit_file_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
