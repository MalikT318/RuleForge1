/*
  MITRE Technique : T1550.003 - Pass the Ticket
  Tactic(s)       : Lateral Movement
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:41:16.525274+00:00
  Reference       : https://attack.mitre.org/techniques/T1550/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1550_003_Kerberos_Ticket_File_Written_To_Disk {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a Kerberos ticket export file (.kirbi or .ccache) on a Windows host. Pass-the-ticket tradecraft usually writes stolen TGT or service tickets to disk so they can be carried to another host and re-injected. This is file-creation telemetry, not process command-line matching, so it still fires when the tool is renamed, recompiled or run in memory and then saved. Variant 5 asked for a non-Windows pivot, but the mandatory target platform is Windows, so the additive angle is FILE_CREATION artifacts."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1550.003"
    mitre_technique_name = "Use Alternate Authentication Material: Pass the Ticket"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR file events or Sysmon Event ID 11) with target.file.full_path and the writing process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Security assessment and red team exercises, Kerberos troubleshooting by administrators (ticket export for diagnostics), Linux-interop or Impacket-based admin tooling run from Windows, and backup or forensic collection that copies ticket cache files."
    tuning_guidance = "Add approved EDR/AV agents to %global_allowed_security_tools and approved admin tooling to %global_allowed_admin_tools by the writing process path. Add authorised testers to %global_allowed_admin_users. Correlate with the same host's USER_LOGIN network logons shortly after the file appears to prioritise triage."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(kirbi|ccache)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1550.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $ticket_files = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
