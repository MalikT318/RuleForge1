/*
  MITRE Technique : T1110.002 - Password Cracking
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:05:33.616367+00:00
  Reference       : https://attack.mitre.org/techniques/T1110/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1110_002_IdP_Repeated_Failures_Then_Success_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects several failed identity provider sign-ins for one account from one source address, followed within ten minutes by a successful sign-in for the same account from the same external address. Offline hash cracking is not visible in identity logs, so this rule detects its observable result: a guessed or cracked weak credential being used. It complements endpoint command-line rules."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1110.002"
    mitre_technique_name = "Brute Force: Password Cracking"
    log_prerequisites = "Requires identity provider sign-in logs normalised to USER_LOGIN with principal.ip, target.user.userid and security_result.action populated (BLOCK for failures, ALLOW for successes)."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Users who mistype passwords repeatedly and then succeed from a home or mobile network, expired-password or password-reset flows, misconfigured mail or sync clients with stale credentials, shared NAT egress addresses, and authorised penetration tests."
    tuning_guidance = "Raise the #fail threshold (default 5) for noisy tenants. Add automation identities to %global_allowed_service_accounts, and add approved testing or scanning sources to %global_allowed_scanners. Add named administrators to %global_allowed_admin_users if they trigger frequently."

  events:
    $fail.metadata.event_type = "USER_LOGIN"
    $fail.security_result.action = "BLOCK"
    $fail.target.user.userid = $user
    $fail.principal.ip = $src_ip
    not $fail.target.user.userid in %global_allowed_service_accounts
    not $fail.principal.ip in %global_allowed_scanners
    not $fail.principal.ip in %rfc1918_internal

    $success.metadata.event_type = "USER_LOGIN"
    $success.security_result.action = "ALLOW"
    $success.target.user.userid = $user
    $success.principal.ip = $src_ip
    not $success.target.user.userid in %global_allowed_service_accounts
    not $success.principal.ip in %global_allowed_scanners
    not $success.principal.ip in %rfc1918_internal

    $fail.metadata.event_timestamp.seconds <= $success.metadata.event_timestamp.seconds

  match:
    $user, $src_ip over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1110.002")
    $primary_entity = array_distinct($user)
    $failure_count = count($fail.metadata.id)
    $source_address = array_distinct($src_ip)
    $first_success_time = min($success.metadata.event_timestamp.seconds)

  condition:
    #fail >= 5 and $success
}
