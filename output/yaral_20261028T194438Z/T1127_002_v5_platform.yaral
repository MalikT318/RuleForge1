/*
  MITRE Technique : T1127.002 - ClickOnce
  Tactic(s)       : Stealth, Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:39:27.008718+00:00
  Reference       : https://attack.mitre.org/techniques/T1127/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1127_002_ClickOnce_Cache_Write_By_NonDfsvc {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an executable, library, or ClickOnce manifest file created inside the per-user ClickOnce application cache (AppData\\Local\\Apps\\2.0) by a process other than the ClickOnce deployment service (dfsvc.exe). Legitimate ClickOnce installs and updates write to this store only through dfsvc.exe. A different writer suggests payload staging into the trusted ClickOnce cache, or a manually crafted ClickOnce deployment used to proxy execution. This file-creation rule complements process-launch command-line detections. It is written for Windows only, because the ClickOnce cache and dfsvc.exe are Windows constructs."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1127.002"
    mitre_technique_name = "Trusted Developer Utilities Proxy Execution: ClickOnce"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with the writing process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Endpoint security or backup agents restoring or scanning the ClickOnce cache, profile migration or user-state restore tools, software deployment agents that pre-seed ClickOnce applications, and developers publishing or debugging ClickOnce apps locally (for example Visual Studio or MSBuild)."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools, backup or restore tooling to %global_allowed_backup_processes, and deployment or developer tooling to %global_allowed_admin_tools. On developer-heavy tenants, scope the rule to non-developer asset groups."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\Users\\[^\\]+\\AppData\\Local\\Apps\\2\.0\\.+\.(exe|dll|application|manifest|appref-ms)$/ nocase
    not $file.principal.process.file.full_path = /\\dfsvc\.exe$/ nocase
    not $file.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1127.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $written_file = array_distinct($file.target.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
