/*
  MITRE Technique : T1217 - Browser Information Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:39:38.712342+00:00
  Reference       : https://attack.mitre.org/techniques/T1217
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1217_Browser_Data_Mass_Access_By_NonBrowser {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A non-browser process reads multiple browser profile data files (history, bookmarks, saved logins, cookies, web data) on a single host within ten minutes. One read is benign. Repeated reads by a process that is not the browser suggest browser information discovery or credential-store enumeration."
    mitre_tactic = "Discovery"
    mitre_technique = "T1217"
    mitre_technique_name = "Browser Information Discovery"
    log_prerequisites = "Requires EDR or Sysmon-equivalent file access telemetry (FILE_READ) with the initiating process path populated. Many EDR products only log reads of sensitive paths when a file-access policy is enabled for browser profile directories."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and imaging agents, endpoint security scanners, DLP and e-discovery tools, profile migration utilities, roaming-profile and user-state sync tools, and forensic or IT support tooling."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes, EDR/AV engines to %global_allowed_security_tools, IT tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Raise the #proc threshold on hosts with heavy profile-sync activity. Risk score rises when credential-bearing stores (saved logins, key databases) are touched."

  events:
    $proc.metadata.event_type = "FILE_READ"
    $proc.target.file.full_path = /\\(Google\\Chrome|Chromium|Microsoft\\Edge|BraveSoftware\\Brave-Browser|Opera Software|Vivaldi|Mozilla\\Firefox)\\.*\\(History|Login Data|Bookmarks|Web Data|Cookies|Favicons|Top Sites|places\.sqlite|logins\.json|key4\.db|formhistory\.sqlite)$/ nocase
    not $proc.principal.process.file.full_path = /\\(chrome|msedge|firefox|brave|opera|vivaldi|iexplore|msedgewebview2|chrome_proxy|MsMpEng|MsSense|SenseIR|NisSrv)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($proc.target.file.full_path = /(?i)(login data|logins\.json|key4\.db)/, 80, 55))
    $mitre_technique_id = array_distinct("T1217")
    $primary_entity = array_distinct($host)
    $event_count = count($proc.metadata.id)
    $accessed_files = array_distinct($proc.target.file.full_path)
    $reading_processes = array_distinct($proc.principal.process.file.full_path)
    $users = array_distinct($proc.principal.user.userid)

  condition:
    #proc >= 4
}
