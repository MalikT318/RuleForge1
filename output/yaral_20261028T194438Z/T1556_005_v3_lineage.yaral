/*
  MITRE Technique : T1556.005 - Reversible Encryption
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:21:11.083237+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_005_Reversible_Encryption_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, script interpreter or directory-management utility enabling reversible password encryption (AllowReversiblePasswordEncryption, ClearTextPassword, dsmod -reversiblepwd) when it was spawned by an unexpected parent: an Office application, web server, print spooler or database service. These parents never legitimately change AD account encryption properties or password policy, so this lineage points to exploitation or macro-driven post-compromise activity."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.005"
    mitre_technique_name = "Modify Authentication Process: Reversible Encryption"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and child command line (EDR, Sysmon Event ID 1 or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Identity management or provisioning web applications (for example self-service password portals hosted in IIS) that call PowerShell to modify AD accounts; database-driven HR or identity synchronisation jobs launched from SQL Server agent; legacy application installers that require reversible encryption (CHAP, Digest authentication) executed through an unusual parent."
    tuning_guidance = "Add approved identity-provisioning parent process paths to %global_allowed_admin_tools or %global_allowed_script_hosts. Review the $parent_process and $child_command_line outcome values before allowlisting. Do not allowlist Office or spooler parents."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|w3wp|httpd|nginx|php-cgi|tomcat[0-9]*|spoolsv|sqlservr|mysqld)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|powershell_ise|pwsh|wscript|cscript|mshta|dsmod)\.exe$/ nocase
    $proc.target.process.command_line = /(AllowReversiblePasswordEncryption|ClearTextPassword|reversiblepwd)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1556.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
