/*
  MITRE Technique : T1556.002 - Password Filter DLL
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:17:22.355770+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_002_Lsa_Notification_Packages_Repeated_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated modification of the LSA 'Notification Packages' registry value on a single host within 10 minutes. This value controls which password filter DLLs the LSA loads, so repeated writes suggest an adversary registering or adjusting a malicious password filter to harvest plain-text credentials. A single write can be benign, but a burst on one host is not."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.002"
    mitre_technique_name = "Modify Authentication Process: Password Filter DLL"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 13 equivalent) normalised to REGISTRY_MODIFICATION, with the registry key, value name and writing process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate password policy products (self-service password reset, password complexity or breach-check filters) during installation or upgrade, domain controller or server build automation, and admins deploying an approved filter such as a password-quality enforcement tool."
    tuning_guidance = "Add approved deployment or password-policy installer binaries to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. Raise the threshold if build or imaging pipelines write this value repeatedly. Consider alerting on a count of 1 on domain controllers only, via a separate rule scoped by asset."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control\\Lsa(\\|$)/ nocase
    (
      $reg.target.registry.registry_value_name = /Notification Packages/ nocase or
      $reg.target.registry.registry_key = /Notification Packages/ nocase
    )
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(#reg >= 4, 90, 75))
    $event_count = count($reg.metadata.id)
    $mitre_technique_id = array_distinct("T1556.002")
    $primary_entity = array_distinct($host)
    $writing_processes = array_distinct($reg.principal.process.file.full_path)
    $registry_values = array_distinct($reg.target.registry.registry_value_data)
    $users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 2
}
