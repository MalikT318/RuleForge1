/*
  MITRE Technique : T1113 - Screen Capture
  Tactic(s)       : Collection
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:13:58.200007+00:00
  Reference       : https://attack.mitre.org/techniques/T1113
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1113_Script_Interpreter_Writes_Screenshot_Image {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a scripting interpreter or proxy-execution binary writing an image file (PNG/JPG/BMP/GIF) into a user-writable staging location. This is the file artifact left by in-memory screen capture such as .NET CopyFromScreen followed by Bitmap.Save. It does not depend on command-line logging, so it covers capture code that is obfuscated, encoded or loaded reflectively."
    mitre_tactic = "Collection"
    mitre_technique = "T1113"
    mitre_technique_name = "Screen Capture"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent) with the writing process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin or report-generation scripts that export charts or images, documentation and helpdesk automation that saves screenshots, PowerShell-based imaging or monitoring tools, developer build scripts producing image assets, python-based data science tools writing plots to user folders."
    tuning_guidance = "Add approved automation host binaries to %global_allowed_script_hosts and approved IT tooling to %global_allowed_admin_tools. Add service accounts that legitimately generate images to %global_allowed_service_accounts. If volume is high, narrow the writer regex (for example drop python) or restrict to Desktop, Temp and Public paths."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(png|jpe?g|bmp|gif)$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata\\local\\temp|appdata\\roaming|desktop|pictures|downloads|documents)|users\\public|programdata|windows\\temp)\\/ nocase
    $file.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|msbuild|installutil|regasm|regsvcs|python[0-9.]*|pythonw[0-9.]*)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1113")
    $primary_entity = array_distinct($file.principal.hostname)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $image_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
