/*
  MITRE Technique : T1070.007 - Clear Network Connection History and Configurations
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:09:19.946305+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_007_Mgmt_Session_Then_Log_History_Cleared {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A network perimeter device receives a management-plane connection (SSH, Telnet, HTTPS admin, NETCONF) from a source outside the approved management sources, and within 10 minutes the same device records a configuration change that clears, deletes or disables logging, connection history or session records. This is the network-device form of clearing connection history to remove traces of an intrusion."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.007"
    mitre_technique_name = "Indicator Removal: Clear Network Connection History and Configurations"
    log_prerequisites = "Requires firewall or perimeter device connection logs that record inbound management-port sessions, plus management-plane audit or config-change logs from the same device, forwarded to Chronicle with consistent device hostname normalisation."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised administrators connecting from unlisted jump hosts or VPN pools and performing log rotation, log-level changes or syslog server migration; scheduled maintenance windows; automated config-management pushes that reset logging settings; device hardening or decommissioning work."
    tuning_guidance = "Add approved admin jump hosts and management subnets' source addresses to %global_allowed_mgmt_sources. Add named admins to %global_allowed_admin_users and automation identities to %global_allowed_service_accounts. If the device hostname appears in a different UDM field in your parser (for example target.hostname on config events), adjust the join variable fields. Extend the management port list if non-standard admin ports are used."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 443 or
      $net.target.port = 830 or
      $net.target.port = 8443
    )
    not $net.principal.ip in %global_allowed_mgmt_sources
    $net.target.hostname = $device

    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.metadata.description = /(clear|purge|erase|delete|truncate|disable|reset|no\s+logging).{0,40}(log|logging|syslog|history|audit|session)/ nocase
    not $cfg.principal.user.userid in %global_allowed_admin_users
    not $cfg.principal.user.userid in %global_allowed_service_accounts
    $cfg.principal.hostname = $device

    $net.metadata.event_timestamp.seconds <= $cfg.metadata.event_timestamp.seconds

  match:
    $device over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1070.007")
    $primary_entity = array_distinct($device)
    $mgmt_source_ips = array_distinct($net.principal.ip)
    $mgmt_ports = array_distinct($net.target.port)
    $config_users = array_distinct($cfg.principal.user.userid)
    $config_changes = array_distinct($cfg.metadata.description)
    $connection_count = count($net.metadata.id)

  condition:
    $net and $cfg
}
