/*
  MITRE Technique : T1574.013 - KernelCallbackTable
  Tactic(s)       : Stealth, Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:44:53.041934+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_013_KernelCallbackTable_GUI_Process_Handle_From_UserWritable {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process running from a user-writable location (AppData, Downloads, Desktop, Temp, ProgramData, Public) that opens a handle to a GUI process commonly abused as a KernelCallbackTable hijack target (shell, logon and desktop host processes). Opening a remote process handle is the prerequisite step for locating the PEB, duplicating the KernelCallbackTable, and overwriting a callback pointer such as fnCOPYDATA via WriteProcessMemory. The rule works at the PROCESS_OPEN layer, so it still fires when command-line logging is evaded."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.013"
    mitre_technique_name = "Hijack Execution Flow: KernelCallbackTable"
    log_prerequisites = "Requires EDR or Sysmon-equivalent process-access telemetry (Sysmon Event ID 10 or equivalent) normalised to PROCESS_OPEN with principal and target process paths populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Portable or per-user installed software that legitimately interacts with the shell (screen capture and recording tools, accessibility tools, clipboard managers, overlay and game utilities, per-user updaters), user-profile-installed security or remote-support agents, and developer debuggers started from a user profile."
    tuning_guidance = "Add approved agents and tools to %global_allowed_security_tools, %global_allowed_admin_tools and %global_allowed_backup_processes (match on full process path). If the PROCESS_OPEN feed exposes a granted-access mask, add a filter for VM_WRITE|VM_OPERATION rights to cut noise further. Extend the target process list with other GUI processes that are high value in the client environment."

  events:
    $proc.metadata.event_type = "PROCESS_OPEN"
    $proc.principal.process.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|programdata|users\\public|windows\\temp|temp)\\/ nocase
    $proc.target.process.file.full_path = /\\(explorer|winlogon|dwm|sihost|taskhostw|ctfmon|notepad|mspaint|calc|mstsc|snippingtool)\.exe$/ nocase
    $proc.principal.process.file.full_path != $proc.target.process.file.full_path
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|SenseCncProxy|NisSrv)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1574.013")
    $primary_entity = array_distinct($proc.principal.hostname)
    $source_process = array_distinct($proc.principal.process.file.full_path)
    $target_process = array_distinct($proc.target.process.file.full_path)
    $source_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
