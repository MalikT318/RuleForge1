/*
  MITRE Technique : T1001.001 - Junk Data
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:05:46.329864+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_001_Linux_Random_Data_Piped_To_Network_Tool {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux process launch whose command line combines a random-data source (/dev/urandom, /dev/random, openssl rand) with a network transfer sink (nc, ncat, socat, curl, wget, telnet, /dev/tcp, /dev/udp). Adversaries use this pattern to generate and send junk data that pads or obfuscates C2 traffic, which makes decoding and signature matching harder."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001.001"
    mitre_technique_name = "Data Obfuscation: Junk Data"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/execve records with the full command line, normalised to UDM PROCESS_LAUNCH with target.process.command_line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Network throughput or bandwidth tests (for example piping /dev/urandom to nc to measure link speed), load-testing and fuzzing scripts, admin scripts that send random padding or test payloads, and CI or QA jobs that generate random test data and upload it with curl."
    tuning_guidance = "Add approved admin and test tooling parent processes to %global_allowed_admin_tools. Add approved script runners or hosts, such as build and test servers, to %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts. If volume remains high, require an external destination in the command line or raise severity only when the parent is an interactive web or service process."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(\/dev\/u?random|openssl\s+rand|dd\s+if=\/dev\/u?random)/ nocase
    $proc.target.process.command_line = /(\bnc(at)?\b|\bsocat\b|\bcurl\b|\bwget\b|\btelnet\b|\/dev\/(tcp|udp)\/)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1001.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $command_lines = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
