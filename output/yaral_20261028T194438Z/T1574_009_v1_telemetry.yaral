/*
  MITRE Technique : T1574.009 - Path Interception by Unquoted Path
  Tactic(s)       : Stealth, Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:37:29.030354+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_009_Executable_Dropped_At_Unquoted_Path_Hijack_Location {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of an executable file in a location that Windows probes first when resolving an unquoted path containing spaces: the drive root (for example C:\\Program.exe) or directly in the root of Program Files or Program Files (x86) (for example C:\\Program Files\\Common.exe). Legitimate installers place binaries in per-vendor subdirectories, so an executable written at these locations is a strong indicator of unquoted service or shortcut path interception. The rule detects the resulting file artifact and does not depend on command-line logging."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.009"
    mitre_technique_name = "Hijack Execution Flow: Path Interception by Unquoted Path"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Poorly packaged legacy installers or self-extracting setup programs that write a launcher directly into the Program Files root or drive root; software deployment and RMM agents; some vendor updaters; developers or administrators manually copying executables to these locations."
    tuning_guidance = "Add approved deployment and installer tooling to %global_allowed_admin_tools and endpoint security agents to %global_allowed_security_tools. Review the writing process, the user and the filename. A name that matches the first space-delimited token of an existing directory (Program, Common, Microsoft, Windows) combined with a service whose ImagePath is unquoted should be treated as confirmed hijack staging. Correlate with REGISTRY_MODIFICATION on service ImagePath values if deeper coverage is needed."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^[a-z]:\\(program|documents|common|microsoft|windows|vmware|google)\.(exe|com|scr)$|^[a-z]:\\program files( \(x86\))?\\[^\\]+\.(exe|com|scr)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|MsMpEng)\.exe$/ nocase

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1574.009")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
