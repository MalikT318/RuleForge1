/*
  MITRE Technique : T1567.001 - Exfiltration to Code Repository
  Tactic(s)       : Exfiltration
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:55:32.361888+00:00
  Reference       : https://attack.mitre.org/techniques/T1567/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_001_Linux_Code_Repo_API_Write_Then_Bulk_Upload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a source host issuing a repository write request (git smart-HTTP push or a REST contents/blob/commit/snippet API call) to an external destination, followed within 10 minutes by a large HTTP upload to the same destination host. Matching on generic git protocol and repository API write patterns, with no named service, catches data staged and pushed to a code hosting service as an exfiltration channel."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567.001"
    mitre_technique_name = "Exfiltration Over Web Service: Exfiltration to Code Repository"
    log_prerequisites = "Requires proxy or perimeter logs that record full HTTP URLs and request methods (TLS inspection or an explicit proxy) and that populate network.sent_bytes. Without TLS inspection URL paths are not visible and the rule will not fire."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Developers and CI/CD build servers pushing to external git hosting, package or artifact publishing workflows, backup or config-management jobs that commit to a remote repository, and approved infrastructure-as-code pipelines."
    tuning_guidance = "Add sanctioned code hosting domains to %global_allowed_domains. If the proxy cannot populate network.sent_bytes, lower or remove the upload size threshold. Raise the byte threshold in noisy developer subnets. Internal destinations are already excluded through %rfc1918_internal."

  events:
    $api.metadata.event_type = "NETWORK_HTTP"
    $api.network.http.method = /^(POST|PUT|PATCH)$/ nocase
    $api.target.url = /(\/git-receive-pack|\/repos\/[^\/]+\/[^\/]+\/(contents|git\/(blobs|trees|commits))|\/api\/v[0-9]+\/projects\/[^\/]+\/repository\/(files|commits)|\/snippets|\/gists)/ nocase
    not $api.target.ip in %rfc1918_internal
    not $api.target.hostname in %global_allowed_domains
    $api.principal.ip = $src_ip
    $api.target.hostname = $dest_host

    $upload.metadata.event_type = "NETWORK_HTTP"
    $upload.network.http.method = /^(POST|PUT|PATCH)$/ nocase
    $upload.network.sent_bytes >= 1000000
    not $upload.target.ip in %rfc1918_internal
    not $upload.target.hostname in %global_allowed_domains
    $upload.principal.ip = $src_ip
    $upload.target.hostname = $dest_host

    $api.metadata.event_timestamp.seconds <= $upload.metadata.event_timestamp.seconds

  match:
    $src_ip, $dest_host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1567.001")
    $primary_entity = array_distinct($src_ip)
    $destination_hosts = array_distinct($dest_host)
    $repo_urls = array_distinct($api.target.url)
    $max_upload_bytes = max($upload.network.sent_bytes)
    $api_request_count = count($api.metadata.id)

  condition:
    $api and $upload
}
