/*
  MITRE Technique : T1485.001 - Lifecycle-Triggered Deletion
  Tactic(s)       : Impact
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:37:27.881200+00:00
  Reference       : https://attack.mitre.org/techniques/T1485/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1485_001_Bucket_Protection_Weakened_Then_Lifecycle_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "One cloud identity weakens storage bucket data protection (versioning, object lock or retention, replication, logging, or bucket policy) and then modifies the bucket lifecycle or management policy within 10 minutes. This sequence is typical of lifecycle-triggered mass deletion used for extortion or log destruction, and complements process-based detections by watching the control plane."
    mitre_tactic = "Impact"
    mitre_technique = "T1485.001"
    mitre_technique_name = "Data Destruction: Lifecycle-Triggered Deletion"
    log_prerequisites = "Cloud control-plane audit logs with storage configuration (management) events enabled and normalized to UDM with metadata.product_event_type and principal.user.userid populated. Storage data-plane and management-event logging must be enabled."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Storage lifecycle tuning for cost optimisation, infrastructure-as-code pipelines applying bucket baselines, compliance retention projects, and administrators migrating or re-architecting buckets."
    tuning_guidance = "Add IaC pipeline and automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named storage administrators to %global_allowed_admin_users. Widen or narrow the 10m window if change tickets show longer legitimate workflows. Consider adding a bucket-name join if the client's logs populate target.resource.name consistently."

  events:
    $guard.metadata.event_type = "SETTING_MODIFICATION"
    $guard.metadata.product_event_type = /(versioning|objectlock|object_lock|retention|softdelete|immutab|replication|bucketlogging|bucketpolicy|setiampolicy)/ nocase
    $guard.principal.user.userid = $user
    not $guard.principal.user.userid in %global_allowed_service_accounts
    not $guard.principal.user.userid in %global_allowed_cloud_principals
    not $guard.principal.user.userid in %global_allowed_admin_users

    $life.metadata.event_type = "SETTING_MODIFICATION"
    $life.metadata.product_event_type = /(lifecycle|managementpolic|storage\.buckets\.(update|patch))/ nocase
    $life.principal.user.userid = $user
    not $life.principal.user.userid in %global_allowed_service_accounts
    not $life.principal.user.userid in %global_allowed_cloud_principals
    not $life.principal.user.userid in %global_allowed_admin_users

    $guard.metadata.event_timestamp.seconds <= $life.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1485.001")
    $primary_entity = array_distinct($user)
    $guard_actions = array_distinct($guard.metadata.product_event_type)
    $lifecycle_actions = array_distinct($life.metadata.product_event_type)
    $affected_resources = array_distinct($life.target.resource.name)
    $source_ips = array_distinct($life.principal.ip)
    $first_seen = min($guard.metadata.event_timestamp.seconds)
    $last_seen = max($life.metadata.event_timestamp.seconds)

  condition:
    $guard and $life
}
