/*
  MITRE Technique : T1087.004 - Cloud Account
  Tactic(s)       : Discovery
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:57:22.563728+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_004_SaaS_Directory_Account_Enumeration_API {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects directory-level enumeration of cloud accounts, role members, groups or service principals recorded as an audit-log resource access event, issued by a scripted or programmatic HTTP client. This works at the SaaS audit/API layer rather than on endpoint command lines, so it still fires when the operator hides the CLI or PowerShell invocation, or runs from an unmanaged host."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.004"
    mitre_technique_name = "Account Discovery: Cloud Account"
    log_prerequisites = "Requires identity provider / SaaS directory audit logs that record read and list operations (not only write operations), normalised to USER_RESOURCE_ACCESS with metadata.product_event_type and network.http.user_agent populated."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Identity governance and access-review tooling, HR or provisioning sync connectors, SIEM or CMDB inventory collectors, help-desk automation, administrators running legitimate audit scripts, and onboarding or offboarding automation."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, approved administrators to %global_allowed_admin_users, and sanctioned authorised scanners to %global_allowed_scanners. If the tenant does not populate network.http.user_agent, remove the user-agent condition and raise the severity threshold or move the rule to a threshold variant. Extend the operation-name regex to match the product_event_type values the tenant actually emits."

  events:
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.metadata.product_event_type = /(list|enumerate|get|search|read|query)[\s._\-]*(all[\s._\-]*)?(users|accounts|members|role[\s._\-]*members|directory[\s._\-]*roles|service[\s._\-]*principals|groups)/ nocase
    $access.network.http.user_agent = /(powershell|python|curl|wget|go-http-client|okhttp|axios|node-fetch|java|ruby|libwww|httpclient)/ nocase
    $access.principal.user.userid != ""
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_admin_users
    not $access.principal.user.userid in %global_allowed_scanners

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1087.004")
    $primary_entity = array_distinct($access.principal.user.userid)
    $operations = array_distinct($access.metadata.product_event_type)
    $user_agents = array_distinct($access.network.http.user_agent)
    $source_ips = array_distinct($access.principal.ip)

  condition:
    $access
}
