/*
  MITRE Technique : T1090.003 - Multi-hop Proxy
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:30:27.920701+00:00
  Reference       : https://attack.mitre.org/techniques/T1090/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1090_003_DNS_Tor_Bootstrap_Then_Onion_Lookup {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A single client issues DNS lookups for Tor-style algorithmically generated relay hostnames (www.<16-30 char base32 label>.com/net/org) and then, within ten minutes, resolves a v2/v3-style .onion address or an onion-to-web gateway name. This sequence indicates a Windows host bootstrapping an onion-routing client, which is a multi-hop proxy chain for C2. The rule uses DNS telemetry only and no endpoint process fields."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1090.003"
    mitre_technique_name = "Proxy: Multi-hop Proxy"
    log_prerequisites = "Requires DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name and principal.ip populated. Windows clients must resolve through the logged resolver."
    platform = "Windows"
    log_source = "dns"
    false_positives = "Privacy-focused users or researchers running an onion-routing browser, security teams or threat-intel sandboxes browsing onion services through gateways, CDN or vendor hostnames that happen to use long random-looking labels, and dark-web monitoring tools."
    tuning_guidance = "Add known-good vendor or CDN domains to %global_allowed_domains, which is applied to both events. Exclude sandbox or research resolver client ranges by filtering them out at ingestion or with a client-specific copy of the rule. Consider raising severity to Critical on servers or in environments where onion routing is prohibited by policy."

  events:
    $dga.metadata.event_type = "NETWORK_DNS"
    $dga.network.dns.questions.name = /^(www\.)?[a-z2-7]{16,30}\.(com|net|org)$/ nocase
    not $dga.network.dns.questions.name in %global_allowed_domains
    $dga.principal.ip = $ip

    $onion.metadata.event_type = "NETWORK_DNS"
    $onion.network.dns.questions.name = /(^|\.)[a-z2-7]{16,56}\.onion(\.[a-z]{2,6})?$/ nocase
    not $onion.network.dns.questions.name in %global_allowed_domains
    $onion.principal.ip = $ip

    $dga.metadata.event_timestamp.seconds <= $onion.metadata.event_timestamp.seconds

  match:
    $ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1090.003")
    $primary_entity = array_distinct($ip)
    $relay_style_queries = array_distinct($dga.network.dns.questions.name)
    $onion_queries = array_distinct($onion.network.dns.questions.name)
    $relay_query_count = count($dga.metadata.id)
    $onion_query_count = count($onion.metadata.id)

  condition:
    $dga and $onion
}
