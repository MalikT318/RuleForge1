/*
  MITRE Technique : T1685.006 - Clear Linux or Mac System Logs
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:25:27.207741+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_006_Linux_Log_Clear_From_Service_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing service (web server, application server, database, print or cache daemon) spawning a shell, interpreter or file-destruction utility whose arguments target system log files, journals or login records. Service daemons do not normally clear logs, so this lineage suggests a webshell or exploited service operator is removing evidence."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.006"
    mitre_technique_name = "Clear Linux or Mac System Logs"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry normalised to PROCESS_LAUNCH with populated parent and child process paths and command lines."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Application-managed log rotation or cleanup hooks run by a service (for example tomcat or java housekeeping jobs), database maintenance scripts that purge their own logs, and web application admin panels that offer a clear-logs feature. Deployment hooks launched from a service wrapper can also trigger it."
    tuning_guidance = "Add legitimate service wrapper or maintenance parent paths to %global_allowed_script_hosts and automation accounts to %global_allowed_service_accounts. Narrow or extend the parent service list to match the client's stack. If rotation scripts are noisy, exclude their parent via %global_allowed_admin_tools."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(httpd|apache2|nginx|lighttpd|php-fpm[0-9.]*|php-cgi|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|smbd)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ash|ksh|python[0-9.]*|perl|ruby|php|truncate|shred|rm|unlink|journalctl|dd|sed|find)$/ nocase
    $proc.target.process.command_line = /(\/var\/log\/|\/var\/log$|\/run\/log\/journal|\/var\/log\/journal|\/var\/run\/utmp|\/run\/utmp|wtmp|btmp|lastlog)/ nocase
    $proc.target.process.command_line = /(\brm\b|\btruncate\b|\bshred\b|\bunlink\b|\bwipe\b|--vacuum|--rotate|\bdd\b|\bsed\s+-[a-z]*i|\/dev\/null|>\s*\/var\/|:\s*>)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1685.006")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
