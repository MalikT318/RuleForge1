/*
  MITRE Technique : T1555.005 - Password Managers
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:00:29.763463+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_005_Password_Manager_DB_Bulk_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several reads of password manager database or vault files on a single host within ten minutes by processes that are not approved backup, security or admin tools. A single read is normal. Repeated reads across vault files point to credential harvesting from password managers."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.005"
    mitre_technique_name = "Credentials from Password Stores: Password Managers"
    log_prerequisites = "Requires Windows endpoint file-read telemetry (EDR or Sysmon-equivalent) that produces FILE_READ events with target.file.full_path and principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Password manager applications opening their own vaults, cloud sync clients (OneDrive, Dropbox) re-reading vault files, backup or file-indexing agents not yet allowlisted, users migrating or exporting vaults, and DLP or content scanners."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes, EDR/AV agents to %global_allowed_security_tools, and sync or IT tooling to %global_allowed_admin_tools. If the password manager clients themselves are noisy, allowlist their executable paths in %global_allowed_admin_tools. Raise the #file threshold in the condition for environments with heavy vault sync activity."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /(\.(kdbx|kdb|psafe3|opvault|agilekeychain|1pux|1pif)$|\\appdata\\roaming\\bitwarden\\data\.json$)/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1555.005")
    $primary_entity = array_distinct($host)
    $accessed_files = array_distinct($file.target.file.full_path)
    $reading_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
