/*
  MITRE Technique : T1556.007 - Hybrid Identity
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:24:57.345631+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_007_Hybrid_Identity_Sync_Account_Logon_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A directory-synchronisation service account (default hybrid identity connector naming) generates a burst of logon events within ten minutes. These accounts normally authenticate only from the sync server on a predictable cadence. Repeated logons from workstations or other sources suggest credential theft or backdooring of the hybrid authentication path (PHS/PTA/federation), which also precedes DCSync-style replication abuse."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.007"
    mitre_technique_name = "Modify Authentication Process: Hybrid Identity"
    log_prerequisites = "Requires Windows Security logon events (4624/4625) from domain controllers and the identity synchronisation server, or normalised identity provider sign-in logs. Events must populate target.user.userid and principal.ip."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Sync server restarts or service re-installs, health-monitoring probes, administrators running a manual delta or full sync, password-expiry retry loops after a service account password rotation."
    tuning_guidance = "Add the sync server and approved management sources to %global_allowed_mgmt_sources. If the client uses a custom sync account naming convention, extend the userid regex. Raise the threshold for noisy environments. Use %global_allowed_admin_users to exclude named admins who operate the sync tooling."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.user.userid = /^(msol_|aad_|azureadssoacc)/ nocase
    $auth.target.user.userid = $user
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1556.007")
    $primary_entity = array_distinct($user)
    $logon_count = count($auth.metadata.id)
    $source_ips = array_distinct($auth.principal.ip)
    $source_hosts = array_distinct($auth.principal.hostname)
    $target_hosts = array_distinct($auth.target.hostname)

  condition:
    #auth >= 5
}
