/*
  MITRE Technique : T1027.009 - Embedded Payloads
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:52:03.856746+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_009_Linux_Service_Parent_Spawns_Staged_Payload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing or data-tier service process (web server, application runtime, database, print or file service) launching a child whose executable image sits in a world-writable or memory-backed location such as /tmp, /var/tmp, /dev/shm, /run/user or memfd. Services do not normally execute binaries from these locations. The pattern indicates a payload embedded in a web upload, script or document was extracted at runtime and executed. The rule keys on process lineage and image location, not on command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.009"
    mitre_technique_name = "Obfuscated Files or Information: Embedded Payloads"
    log_prerequisites = "Linux EDR or auditd (execve) telemetry normalised to UDM PROCESS_LAUNCH with principal.process.file.full_path (parent) and target.process.file.full_path (child) populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web applications or CMS plugins that run helper binaries from /tmp (image processors, PDF converters), CI/CD or build agents running under a java parent, database maintenance jobs, self-extracting installers launched by a service, and Java or Node based management consoles that unpack native helpers at start-up."
    tuning_guidance = "Add legitimate parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts. Add approved child helper binaries to %global_allowed_admin_tools. Remove java from the parent regex on hosts where build or application servers legitimately execute unpacked helpers from /tmp."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|php-fpm[0-9.]*|lighttpd|caddy|haproxy|java|mysqld|mariadbd|postgres|redis-server|mongod|cupsd|smbd)$/ nocase
    $proc.target.process.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/run\/user\/[0-9]+\/|memfd:|\/proc\/[0-9]+\/fd\/)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.009")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
