/*
  MITRE Technique : T1018 - Remote System Discovery
  Tactic(s)       : Discovery
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:28:10.907522+00:00
  Reference       : https://attack.mitre.org/techniques/T1018
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1018_Outbound_Windows_Discovery_Ports_To_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Perimeter observation of an internal Windows host opening an outbound connection to an external address on a Windows host-discovery or remote-enumeration port (RPC endpoint mapper 135, NetBIOS 137/139, SMB 445, WinRM 5985/5986). These protocols are used to enumerate and probe remote systems and should not cross the perimeter in normal operation. A hit suggests remote system discovery or scanning from a compromised host, or a firewall egress policy gap."
    mitre_tactic = "Discovery"
    mitre_technique = "T1018"
    mitre_technique_name = "Remote System Discovery"
    log_prerequisites = "Firewall, proxy or perimeter network logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs must record outbound connection attempts, including those the firewall denied."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Hybrid cloud file shares reached over SMB through the perimeter, approved external WinRM or remote management, authorised external vulnerability scanners or penetration tests, misconfigured clients or VPN split-tunnel routing, and legacy NetBIOS name resolution leaking to external addresses."
    tuning_guidance = "Add authorised scanner and test source addresses to %global_allowed_scanners. Add approved management sources to %global_allowed_mgmt_sources. Ensure %rfc1918_internal is populated for the tenant's internal ranges. If a client legitimately uses SMB over the perimeter, such as for cloud file services, consider narrowing the port set for that tenant."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 135 or
      $net.target.port = 137 or
      $net.target.port = 139 or
      $net.target.port = 445 or
      $net.target.port = 5985 or
      $net.target.port = 5986
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1018")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
