/*
  MITRE Technique : T1055.015 - ListPlanting
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:05:15.535509+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_015_ListView_Host_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side proxy for ListPlanting. A Windows GUI utility that hosts SysListView32 controls (registry editor, task manager, MMC, resource and performance monitors, event viewer) makes an outbound connection to a non-internal address. These binaries rarely initiate external connections, so this is consistent with injected code running under a hijacked list-view host process. It is a behavioural proxy: it observes the post-injection network activity, not the injection API calls. Explorer is deliberately excluded because its external traffic is too noisy for a single-event rule."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.015"
    mitre_technique_name = "Process Injection: ListPlanting"
    log_prerequisites = "Requires endpoint network telemetry that populates the initiating process path on NETWORK_CONNECTION events (EDR or Sysmon Event ID 3 equivalent)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "MMC snap-ins that fetch certificate revocation lists or OCSP responses, Event Viewer online help, Microsoft Management Console remote-computer management over routable address space, Task Manager or Resource Monitor invoked against remote systems, and EDR or admin tooling that attaches to these processes."
    tuning_guidance = "Add approved management and security agent process paths to %global_allowed_admin_tools and %global_allowed_security_tools. Add known-good vendor or update destinations to %global_allowed_domains. If mmc.exe is too noisy for a client, remove it from the process regex."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(regedit|taskmgr|mmc|perfmon|resmon|eventvwr|compmgmt)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1055.015")
    $primary_entity = array_distinct($net.principal.hostname)
    $host_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
