/*
  MITRE Technique : T1078.001 - Default Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:30:06.842939+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_001_Linux_Default_Account_External_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a successful login to a Linux host using a built-in or factory-default account (root, admin, guest, pi, vagrant and similar) from a non-internal source address. Direct remote use of default accounts indicates default or reused credentials, or stolen keys, and is a common initial access and persistence path. This rule uses authentication telemetry rather than process command lines."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.001"
    mitre_technique_name = "Valid Accounts: Default Accounts"
    log_prerequisites = "Requires Linux authentication telemetry (sshd, PAM, login or auditd USER_LOGIN records) normalised to UDM USER_LOGIN with target.user.userid and principal.ip populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators or break-glass procedures that log in as root remotely over a VPN or NAT egress address, cloud-image default accounts used by provisioning or automation, vulnerability scanners and authenticated compliance checks, jump hosts with public addresses."
    tuning_guidance = "Add approved bastion or management source addresses to %global_allowed_mgmt_sources, named administrators to %global_allowed_admin_users, automation accounts to %global_allowed_service_accounts, and authorised scanners to %global_allowed_scanners. Where PermitRootLogin is disabled fleet-wide, consider raising severity to Critical."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.user.userid = /^(root|toor|admin|administrator|guest|pi|vagrant|test)$/ nocase
    re.regex($auth.principal.ip, /.+/)
    not $auth.principal.ip in %rfc1918_internal
    not net.ip_in_range_cidr($auth.principal.ip, "127.0.0.0/8")
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.principal.ip in %global_allowed_scanners
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.target.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1078.001")
    $primary_entity = array_distinct($auth.target.hostname)
    $default_account = array_distinct($auth.target.user.userid)
    $source_ips = array_distinct($auth.principal.ip)

  condition:
    $auth
}
