/*
  MITRE Technique : T1098.005 - Device Registration
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:47:12.417273+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_005_Device_Registration_Join_Then_MDM_Enrollment_Keys {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a non-native process writing Entra ID / Workplace Join registration registry state and then, within ten minutes on the same host, writing MDM (Intune) enrollment registry state. This sequence indicates a device being registered or enrolled by a script or tool rather than by the OS enrollment components, as used to bypass conditional access or gain persistent access through a rogue registered device."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.005"
    mitre_technique_name = "Account Manipulation: Device Registration"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events, Event IDs 12/13/14 equivalent) with the writing process path populated for registry modifications under HKLM and HKCU."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Autopilot or Intune provisioning flows driven by deployment tooling, third-party MDM or RMM agents that enroll devices, helpdesk scripts performing hybrid join remediation, and imaging or OOBE processes that use non-standard binaries."
    tuning_guidance = "Add approved enrollment and provisioning tooling to %global_allowed_admin_tools, endpoint agents to %global_allowed_security_tools, and provisioning accounts to %global_allowed_service_accounts. Extend the native-binary name exclusion if additional OS enrollment components write these keys in your environment. If your EDR reports new-key writes as REGISTRY_CREATION rather than REGISTRY_MODIFICATION, clone the rule for that event type."

  events:
    $join.metadata.event_type = "REGISTRY_MODIFICATION"
    $join.target.registry.registry_key = /\\Microsoft\\Windows NT\\CurrentVersion\\WorkplaceJoin\\|\\Microsoft\\Windows\\CurrentVersion\\CloudDomainJoin\\JoinInfo\\/ nocase
    not $join.principal.process.file.full_path = /\\(dsregcmd|deviceenroller|omadmclient|svchost|musnotification|deviceenrollmentcommon|sihclient|wsqmcons|taskhostw)\.exe$/ nocase
    not $join.principal.process.file.full_path in %global_allowed_admin_tools
    not $join.principal.process.file.full_path in %global_allowed_security_tools
    not $join.principal.user.userid in %global_allowed_service_accounts
    $join.principal.hostname = $hostname

    $mdm.metadata.event_type = "REGISTRY_MODIFICATION"
    $mdm.target.registry.registry_key = /\\Microsoft\\Enrollments\\[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/ nocase
    not $mdm.principal.process.file.full_path = /\\(dsregcmd|deviceenroller|omadmclient|svchost|musnotification|deviceenrollmentcommon|sihclient|wsqmcons|taskhostw)\.exe$/ nocase
    not $mdm.principal.process.file.full_path in %global_allowed_admin_tools
    not $mdm.principal.process.file.full_path in %global_allowed_security_tools
    not $mdm.principal.user.userid in %global_allowed_service_accounts
    $mdm.principal.hostname = $hostname

    $join.metadata.event_timestamp.seconds <= $mdm.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1098.005")
    $primary_entity = array_distinct($join.principal.hostname)
    $join_processes = array_distinct($join.principal.process.file.full_path)
    $mdm_processes = array_distinct($mdm.principal.process.file.full_path)
    $join_keys = array_distinct($join.target.registry.registry_key)
    $mdm_keys = array_distinct($mdm.target.registry.registry_key)
    $acting_users = array_distinct($join.principal.user.userid)
    $join_event_count = count($join.metadata.id)
    $mdm_event_count = count($mdm.metadata.id)

  condition:
    $join and $mdm
}
