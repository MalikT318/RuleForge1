/*
  MITRE Technique : T1652 - Device Driver Discovery
  Tactic(s)       : Discovery
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:55:24.747458+00:00
  Reference       : https://attack.mitre.org/techniques/T1652
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1652_Linux_Driver_Enumeration_Sent_To_External_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux process whose command line combines kernel module / driver enumeration (lsmod, modinfo, /proc/modules, /sys/module) with a network transfer construct (pipe to a network utility or a /dev/tcp redirect) and which opens a connection to an external address. This is the network-side footprint of driver discovery results being sent off-host."
    mitre_tactic = "Discovery"
    mitre_technique = "T1652"
    mitre_technique_name = "Device Driver Discovery"
    log_prerequisites = "Requires Linux endpoint network telemetry (EDR or auditd socket/connect events) that populates the initiating process command line on NETWORK_CONNECTION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management or inventory scripts that report loaded kernel modules to an external SaaS endpoint, hardware/driver compatibility checks run by vendor support tooling, admins pasting module lists to external support portals, cloud-init or provisioning scripts."
    tuning_guidance = "Add approved inventory and configuration management binaries to %global_allowed_admin_tools, approved support tooling to %global_allowed_remote_mgmt, and automation accounts to %global_allowed_service_accounts. If the EDR does not populate principal.process.command_line on network events, this rule will not fire and the process-side variants should be relied on instead."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.command_line = /(\blsmod\b|\bmodinfo\b|\/proc\/modules|\/sys\/module|\bmodprobe\s+(-l|--list)\b)/ nocase
    $net.principal.process.command_line = /(\|\s*(nc|ncat|netcat|curl|wget|socat|openssl)\b|\/dev\/(tcp|udp)\/|(curl|wget)\b.*(-d|--data|--data-binary|-T|--upload-file)\s+@?-)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1652")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_command = array_distinct($net.principal.process.command_line)
    $initiating_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
