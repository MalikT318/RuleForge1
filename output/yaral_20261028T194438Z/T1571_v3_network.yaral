/*
  MITRE Technique : T1571 - Non-Standard Port
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:17:18.070103+00:00
  Reference       : https://attack.mitre.org/techniques/T1571
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1571_Linux_Firewall_Protocol_Port_Mismatch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Perimeter firewall or proxy application identification shows an outbound session where the identified protocol (SSH, HTTP or HTTPS) runs on a port not normally associated with it. This is the network-side signature of T1571 from Linux servers and workloads behind the perimeter. The rule uses only network-observable fields and carries no endpoint process context."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1571"
    mitre_technique_name = "Non-Standard Port"
    log_prerequisites = "Firewall, proxy or NGFW logs normalised to NETWORK_CONNECTION with application-layer identification populated in network.application_protocol (for example App-ID or DPI). Egress logging must be enabled. The rule does not fire on port-only firewalls that cannot identify the protocol."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Administrators running SSH on an alternate port (for example for Git hosting or jump hosts), HTTP/HTTPS application servers or APIs on ports such as 8000, 8888 or 9443, SaaS vendor agents using custom ports, package mirrors and container registries on non-default ports, and vulnerability scanners probing services."
    tuning_guidance = "Add approved scanner source addresses to %global_allowed_scanners and known-good external destinations to %global_allowed_domains. Add approved management or jump-host sources to %global_allowed_mgmt_sources. Extend the port exclusions in the events block for sanctioned alternate ports in a given client environment. Raise severity for servers that should never initiate outbound SSH or HTTP."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.direction = "OUTBOUND"
    $net.target.port > 0
    (
      (
        $net.network.application_protocol = "SSH" and
        $net.target.port != 22
      ) or
      (
        $net.network.application_protocol = "HTTP" and
        $net.target.port != 80 and
        $net.target.port != 8080
      ) or
      (
        $net.network.application_protocol = "HTTPS" and
        $net.target.port != 443 and
        $net.target.port != 8443
      )
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1571")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $observed_protocols = array_distinct($net.network.application_protocol)

  condition:
    $net
}
