/*
  MITRE Technique : T1069.002 - Domain Groups
  Tactic(s)       : Discovery
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:58:52.448964+00:00
  Reference       : https://attack.mitre.org/techniques/T1069/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1069_002_Linux_Kerberos_Then_LDAP_Directory_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A single source host authenticates to a directory server over Kerberos and then opens LDAP, LDAPS or Global Catalog connections to the same server within ten minutes. Linux hosts running ldapsearch-style tooling (for example with GSSAPI) produce this pattern when enumerating domain groups and their membership. The rule uses only perimeter or internal firewall telemetry, so it cannot see the initiating process and relies on the network pattern alone. Source hosts are expected to be Linux, but this is not verifiable from firewall logs."
    mitre_tactic = "Discovery"
    mitre_technique = "T1069.002"
    mitre_technique_name = "Permission Groups Discovery: Domain Groups"
    log_prerequisites = "Requires firewall or network-flow logs that record internal east-west traffic to directory servers, normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Domain-joined Linux servers using sssd or realmd for normal user and group lookups, identity management and PAM/NSS integrations, configuration management agents, directory sync tools, and admins running authorised audits."
    tuning_guidance = "Add approved source addresses to %global_allowed_mgmt_sources and authorised scanning or audit hosts to %global_allowed_scanners. To reduce noise from sssd-joined hosts, enforce an allowlist of identity infrastructure sources, or raise the LDAP connection count with a condition such as #ldap >= 3."

  events:
    $kerb.metadata.event_type = "NETWORK_CONNECTION"
    $kerb.target.port = 88
    $kerb.principal.ip = $src_ip
    $kerb.target.ip = $dc_ip
    not $kerb.principal.ip in %global_allowed_mgmt_sources
    not $kerb.principal.ip in %global_allowed_scanners

    $ldap.metadata.event_type = "NETWORK_CONNECTION"
    ($ldap.target.port = 389 or $ldap.target.port = 636 or $ldap.target.port = 3268 or $ldap.target.port = 3269)
    $ldap.principal.ip = $src_ip
    $ldap.target.ip = $dc_ip
    not $ldap.principal.ip in %global_allowed_mgmt_sources
    not $ldap.principal.ip in %global_allowed_scanners

    $kerb.metadata.event_timestamp.seconds <= $ldap.metadata.event_timestamp.seconds

  match:
    $src_ip, $dc_ip over 10m

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1069.002")
    $primary_entity = array_distinct($src_ip)
    $directory_server = array_distinct($dc_ip)
    $ldap_ports = array_distinct($ldap.target.port)
    $ldap_connection_count = count($ldap.metadata.id)
    $first_kerberos_seen = min($kerb.metadata.event_timestamp.seconds)

  condition:
    $kerb and $ldap
}
