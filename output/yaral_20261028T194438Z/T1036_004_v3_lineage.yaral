/*
  MITRE Technique : T1036.004 - Masquerade Task or Service
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:02:52.475141+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_004_Task_Service_Tooling_From_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Windows service control or task scheduler utilities (sc.exe, schtasks.exe) being launched by a parent process that should never manage services or tasks, such as an Office application, web server worker, database service, print spooler or script host. Masqueraded services and tasks are typically planted by exploited or abused applications, so the anomalous lineage is the signal rather than the task or service name."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.004"
    mitre_technique_name = "Masquerading: Masquerade Task or Service"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with populated parent and child process image paths (EDR, Sysmon Event ID 1 or Security Event 4688 with parent process logging)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Line-of-business or database applications that legitimately register services or tasks during install or upgrade, Office add-ins or macros used by IT for provisioning, web-based admin portals that manage scheduled jobs, print driver installers launched from the spooler, and software deployment scripts run through script hosts."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts, and add automation accounts to %global_allowed_service_accounts. If a specific application legitimately creates tasks, remove its image name from the parent regex only for that client via a rule override rather than editing the shared rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(sc|schtasks)\.exe$/ nocase
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|w3wp|httpd|nginx|tomcat[0-9]*|sqlservr|mysqld|spoolsv|mshta|wscript|cscript)\.exe$/ nocase
    $proc.target.process.command_line = /(create|config|change|\/tn|\/ru)/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1036.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
