/*
  MITRE Technique : T1496 - Resource Hijacking
  Tactic(s)       : Impact
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:49:46.387399+00:00
  Reference       : https://attack.mitre.org/techniques/T1496
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_Linux_Container_Cryptominer_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects execution of a cryptocurrency-mining workload inside a container or on a container host, based on mining-protocol and mining-parameter command-line semantics (stratum pool URI schemes, donation-level flags, proof-of-work algorithm or coin selectors) rather than binary names. Miners are routinely renamed, but they still need to be told which pool and algorithm to use."
    mitre_tactic = "Impact"
    mitre_technique = "T1496"
    mitre_technique_name = "Resource Hijacking"
    log_prerequisites = "Requires container runtime or Kubernetes node process-execution telemetry normalised to UDM PROCESS_LAUNCH, with target.process.command_line populated (runtime security sensor, auditd execve with arguments, or equivalent)."
    platform = "Linux"
    log_source = "container"
    false_positives = "Security researchers or red teams testing mining detections; blockchain or crypto development and testing containers; honeypots; admins running grep/cat/editors against files containing mining strings (partially excluded by viewer-utility exclusion); vulnerability or security tooling that echoes mining strings in command lines."
    tuning_guidance = "Add legitimate crypto-node or blockchain tooling parents to %global_allowed_admin_tools. Add EDR, scanner and runtime-security agents that embed detection strings in their command lines to %global_allowed_security_tools. If a client legitimately runs blockchain workloads, scope them out with the same lists rather than weakening the regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(stratum\+(tcp|ssl|tls|tcps)?:\/\/|--donate-level[= ]*[0-9]|--algo(rithm)?[= ]+(rx\/[0-9a-z]+|randomx|cryptonight[a-z0-9\-]*|kawpow|ethash|etchash|autolykos2?|yescrypt)|--coin[= ]+(monero|xmr|ethereum|etc|rvn|ravencoin))/ nocase
    not $proc.target.process.file.full_path = /\/(grep|egrep|fgrep|rg|less|more|cat|vi|vim|nano|man|find|echo)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1496")
    $primary_entity = array_distinct($proc.principal.hostname)
    $miner_process = array_distinct($proc.target.process.file.full_path)
    $miner_command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $executing_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
