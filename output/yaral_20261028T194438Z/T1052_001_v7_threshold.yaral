/*
  MITRE Technique : T1052.001 - Exfiltration over USB
  Tactic(s)       : Exfiltration
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:43:59.934403+00:00
  Reference       : https://attack.mitre.org/techniques/T1052/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1052_001_Linux_Bulk_File_Writes_To_Removable_Media {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a large number of files created under removable-media mount points (/media, /run/media) on a single Linux host within 10 minutes. Individual file writes to a USB device are benign, but bulk copying is consistent with data staging and exfiltration over a USB-connected device."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1052.001"
    mitre_technique_name = "Exfiltration Over Physical Medium: Exfiltration over USB"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-write events (FILE_CREATION) with principal.hostname, target.file.full_path and principal.process.file.full_path populated. Desktop auto-mounts must use the standard /media/<user>/ or /run/media/<user>/ locations."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Users legitimately copying photos or documents to personal USB drives, approved backup or imaging jobs that write to removable disks, software installers and OS imaging tools writing to USB media, and helpdesk staff creating bootable or recovery media."
    tuning_guidance = "Add approved backup and imaging tools to %global_allowed_backup_processes, approved IT tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Raise the #file threshold for hosts where heavy USB use is routine (for example, media workstations). If the environment mounts removable media elsewhere (for example, /mnt), extend the path regex accordingly. Escalate severity for hosts holding sensitive data."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(run\/)?media\/[^\/]+\/.+/
    not $file.target.file.full_path = /\/\.Trash-[^\/]*\// nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $file_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1052.001")
    $primary_entity = array_distinct($host)
    $users = array_distinct($file.principal.user.userid)
    $writing_processes = array_distinct($file.principal.process.file.full_path)
    $sample_paths = array_distinct($file.target.file.full_path)

  condition:
    #file >= 25
}
