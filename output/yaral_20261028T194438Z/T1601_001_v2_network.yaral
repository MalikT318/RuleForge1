/*
  MITRE Technique : T1601.001 - Patch System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:12:35.648548+00:00
  Reference       : https://attack.mitre.org/techniques/T1601/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_001_Perimeter_TFTP_To_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects TFTP (UDP/69) traffic crossing the network perimeter to or from a non-internal address. TFTP is a standard way to push or pull network device operating system images and configurations. It is unauthenticated and unencrypted, and it has almost no legitimate use across an internet boundary. An external TFTP exchange with a managed device is a strong network-side indicator of OS image tampering or staging."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1601.001"
    mitre_technique_name = "Modify System Image: Patch System Image"
    log_prerequisites = "Firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with populated principal.ip, target.ip and target.port. Requires the firewall to log permitted UDP sessions, not only denied traffic."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate vendor-directed firmware or config retrieval from an external TFTP server during a maintenance window, PXE or provisioning infrastructure hosted off-site, lab or staging networks routed through the perimeter, and misconfigured devices pointing at a legacy external TFTP host."
    tuning_guidance = "Add approved management or provisioning source addresses to %global_allowed_mgmt_sources. Verify that %rfc1918_internal covers all internal and private ranges at each client. Where external TFTP is routine, scope an exception to the specific source device addresses rather than disabling the rule. Consider raising severity if the source is a known network infrastructure device."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    $net.network.ip_protocol = "UDP"
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1601.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
