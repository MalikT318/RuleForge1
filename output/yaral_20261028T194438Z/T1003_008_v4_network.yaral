/*
  MITRE Technique : T1003.008 - /etc/passwd and /etc/shadow
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:51:03.635992+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_008_Linux_External_Connection_With_Credential_File_Argument {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux process opening a network connection to an external (non-internal) address while its own command line references /etc/shadow, /etc/gshadow, /etc/passwd or /etc/master.passwd. This is the network-side footprint of credential file contents being uploaded or streamed off-host for offline cracking, for example an HTTP/FTP/SCP client or a socket utility given the file as an upload argument. It complements process-creation rules because it requires an actual outbound connection and is independent of how the process was launched."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.008"
    mitre_technique_name = "OS Credential Dumping: /etc/passwd and /etc/shadow"
    log_prerequisites = "Requires Linux EDR or auditd-based network telemetry normalised to NETWORK_CONNECTION with principal.process.command_line and target.ip populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management or inventory agents that ship account databases to an external service, backup or migration tooling that copies /etc files to cloud or off-site storage, identity sync scripts run by admins, and support tooling collecting diagnostics (sosreport-style) that include passwd files."
    tuning_guidance = "Add approved tooling executables to %global_allowed_admin_tools or %global_allowed_backup_processes, EDR and security agents to %global_allowed_security_tools, automation accounts to %global_allowed_service_accounts, and known-good destination domains to %global_allowed_domains. Internal traffic is excluded through %rfc1918_internal."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.command_line = /(^|[\s=@<'"\/:])\/etc\/(shadow|gshadow|passwd|master\.passwd)(-)?($|[\s'";|&>])/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1003.008")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $source_command_line = array_distinct($net.principal.process.command_line)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
