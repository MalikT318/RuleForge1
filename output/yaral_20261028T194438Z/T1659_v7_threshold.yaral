/*
  MITRE Technique : T1659 - Content Injection
  Tactic(s)       : Initial Access, Command and Control
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:04:02.015808+00:00
  Reference       : https://attack.mitre.org/techniques/T1659
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1659_Linux_Cleartext_Executable_Content_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal host retrieves several executable or script-type objects (shell scripts, ELF binaries, shared objects, packages) over unencrypted HTTP from external servers within ten minutes. Cleartext delivery of executable content can be tampered with in transit, and repeated delivery is a network-observable sign of content injection used for payload delivery. A single download is benign. The volume is the signal."
    mitre_tactic = "Initial Access, Command and Control"
    mitre_technique = "T1659"
    mitre_technique_name = "Content Injection"
    log_prerequisites = "Requires firewall or web proxy logs normalised to UDM NETWORK_HTTP with principal.ip, target.url, target.ip and network.http.method populated. The proxy or firewall must perform HTTP inspection for plain-HTTP traffic. The source IP is the client, a Linux host in this deployment."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Linux hosts pulling package updates (deb/rpm) from plain-HTTP mirrors, configuration management or bootstrap scripts fetching .sh files over HTTP, container or image build hosts, vendor installers distributed over HTTP."
    tuning_guidance = "Add known-good mirror and vendor domains to %global_allowed_domains. Raise the #http threshold for build or patching subnets, or lower it for high-value servers. Internal destinations are already excluded through %rfc1918_internal."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET"
    $http.target.url = /^http:\/\// nocase
    $http.target.url = /\.(sh|elf|bin|so|deb|rpm|py|pl)(\?|$)/ nocase
    $http.network.http.response_code >= 200
    $http.network.http.response_code < 300
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    $http.principal.ip = $src_ip

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($http.metadata.id)
    $mitre_technique_id = array_distinct("T1659")
    $primary_entity = array_distinct($src_ip)
    $destination_ips = array_distinct($http.target.ip)
    $destination_hosts = array_distinct($http.target.hostname)

  condition:
    #http >= 3
}
