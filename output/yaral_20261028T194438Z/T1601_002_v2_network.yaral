/*
  MITRE Technique : T1601.002 - Downgrade System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:14:29.076292+00:00
  Reference       : https://attack.mitre.org/techniques/T1601/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_002_Downgrade_System_Image_External_TFTP_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects TFTP (UDP/69) traffic crossing the network perimeter to a non-internal address. TFTP is the standard protocol for pushing or pulling operating system images to and from network devices, and it has no authentication or encryption. An external TFTP transfer observed at the firewall is a strong network-side indicator that a device is retrieving an older system image for downgrade (T1601.002). This rule pivots to the network side and does not depend on device-level or endpoint telemetry."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1601.002"
    mitre_technique_name = "Downgrade System Image"
    log_prerequisites = "Firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Egress traffic from the management network must be logged."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised firmware upgrades fetched from a vendor-hosted or managed-service TFTP server, PXE or zero-touch provisioning that reaches an external boot server, and scheduled configuration backup or restore jobs that use TFTP."
    tuning_guidance = "Add approved management or jump host source addresses to %global_allowed_mgmt_sources. Add approved provisioning or backup tooling to %global_allowed_admin_tools if the log source populates the initiating process. Raise severity if the source is a known network device. Correlate hits with change-management windows."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1601.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $bytes_received = max($net.network.received_bytes)

  condition:
    $net
}
