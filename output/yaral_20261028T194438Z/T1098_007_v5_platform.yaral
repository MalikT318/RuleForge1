/*
  MITRE Technique : T1098.007 - Additional Local or Domain Groups
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:51:27.469321+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_007_Linux_Group_Or_Sudoers_File_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of Linux group membership and sudo privilege files (/etc/group, /etc/gshadow, /etc/sudoers, /etc/sudoers.d/*) by a process that is not an approved administration tool, package manager, or system-user generator. This is file-integrity coverage of the result of adding an account to a privileged group, independent of the command line used (usermod, gpasswd, adduser, vi, sed, echo redirection, or a script editing the file directly)."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.007"
    mitre_technique_name = "Account Manipulation: Additional Local or Domain Groups"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules (-w /etc/group -p wa, -w /etc/gshadow -p wa, -w /etc/sudoers -p wa, -w /etc/sudoers.d -p wa) normalised to UDM FILE_MODIFICATION with principal process and user populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management agents (Ansible, Puppet, Chef, Salt), cloud-init or provisioning at first boot, directory-integration tools (SSSD/realmd joins), legitimate sysadmin changes made with an editor or visudo, and OS upgrades that rewrite group files."
    tuning_guidance = "Add approved configuration-management and provisioning binaries to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and named administrators to %global_allowed_admin_users. Correlate with change tickets for sudoers.d changes. Review hits on /etc/sudoers and /etc/sudoers.d first because they grant privilege directly."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/(group|gshadow|sudoers)$|^\/etc\/sudoers\.d\/[^\/]+$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|rpm|apt|apt-get|dnf|yum|zypper|systemd-sysusers)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(if($file.target.file.full_path = /sudoers/ nocase, 85, 70))
    $mitre_technique_id = array_distinct("T1098.007")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_paths = array_distinct($file.target.file.full_path)
    $actor_process = array_distinct($file.principal.process.file.full_path)
    $actor_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
