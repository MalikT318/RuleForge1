/*
  MITRE Technique : T1496.001 - Compute Hijacking
  Tactic(s)       : Impact
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:53:08.108601+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_001_Miner_Pool_DNS_Then_Stratum_Port_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A Windows host resolves a mining-pool-style DNS name and, within 10 minutes, opens an outbound connection to an external address on a port commonly used for stratum mining traffic. This pairing is a network-observable sign of compute hijacking (cryptomining)."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.001"
    mitre_technique_name = "Resource Hijacking: Compute Hijacking"
    log_prerequisites = "Requires perimeter firewall or proxy DNS and connection logs normalised to UDM NETWORK_DNS and NETWORK_CONNECTION, with principal.ip populated for the internal source. Windows hosts must resolve DNS through, or be logged by, the perimeter device."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate software using connection-pool or mining-related hostnames, with a later connection on one of the listed ports. Authorised blockchain or crypto research hosts. Development or test systems running node software. Security sandboxes detonating miners."
    tuning_guidance = "Add known-good domains to %global_allowed_domains. Add approved scanner or sandbox source addresses to %global_allowed_scanners. If the stratum port list is too noisy, narrow it to the ports seen in your environment. Check that principal.ip is populated on both event types for the tenant. Adjust the pool keyword regex for local naming patterns."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(^|[.-])(xmr|monero|stratum|mining|miner|pool)[a-z0-9-]*\./ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.ip in %global_allowed_scanners
    $dns.principal.ip = $src_ip

    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 3333 or
      $net.target.port = 4444 or
      $net.target.port = 5555 or
      $net.target.port = 7777 or
      $net.target.port = 14433 or
      $net.target.port = 14444 or
      $net.target.port = 45560 or
      $net.target.port = 45700
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    $net.principal.ip = $src_ip

    $dns.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1496.001")
    $primary_entity = array_distinct($net.principal.ip)
    $queried_domains = array_distinct($dns.network.dns.questions.name)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $connection_count = count($net.metadata.id)

  condition:
    $dns and $net
}
