/*
  MITRE Technique : T1201 - Password Policy Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:52:33.259518+00:00
  Reference       : https://attack.mitre.org/techniques/T1201
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1201_SaaS_Password_Policy_Discovery_API {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an identity or administrative API call that reads the password, credential or sign-in policy configuration of a SaaS or cloud tenant (for example Get/Describe/List calls against password policy, credential requirements or password complexity settings). Adversaries use this to tailor password-spraying and brute-force attempts to the tenant's length, complexity and lockout rules. This rule covers the SaaS/cloud control plane and does not overlap with endpoint command-line detections."
    mitre_tactic = "Discovery"
    mitre_technique = "T1201"
    mitre_technique_name = "Password Policy Discovery"
    log_prerequisites = "Requires SaaS or cloud audit logs that record administrative and identity API reads, normalised to UDM USER_RESOURCE_ACCESS with metadata.product_event_type populated with the API or operation name. Read-type management events must be enabled (for example, data/read events in the audit configuration)."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Compliance and posture-management scanners, identity governance tooling, IT administrators reviewing policy during audits or onboarding, infrastructure-as-code drift detection, and help-desk portals that display password requirements to users."
    tuning_guidance = "Add automation and posture-scanning identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named administrators to %global_allowed_admin_users. Raise severity or add a Threshold variant if the same principal also shows failed logins shortly after the read. If the tenant's audit schema uses different operation names, extend the product_event_type regex."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /(get|describe|list|read|show).{0,20}(password|passwd|credential).{0,10}(polic|requirement|complexity|setting)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1201")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_operation = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)
    $target_resource = array_distinct($cloud.target.resource.name)

  condition:
    $cloud
}
