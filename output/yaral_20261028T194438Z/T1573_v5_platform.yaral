/*
  MITRE Technique : T1573 - Encrypted Channel
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:22:00.745269+00:00
  Reference       : https://attack.mitre.org/techniques/T1573
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1573_Perimeter_TLS_On_NonStandard_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound TLS/HTTPS-classified sessions from internal Windows hosts to external addresses on non-standard destination ports, as seen at the network perimeter. Encrypted C2 channels often run on unusual ports to avoid port-based egress policy. This is network-observable coverage that does not depend on process or command-line telemetry. The requested alternate-platform angle conflicts with the mandatory Windows platform requirement, so the rule is scoped to Windows-originated egress and uses only perimeter fields."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1573"
    mitre_technique_name = "Encrypted Channel"
    log_prerequisites = "Firewall or proxy logs with application-layer identification that populate network.application_protocol, plus target.ip, target.port and network.direction, normalised to UDM NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate SaaS or vendor services on alternate TLS ports, VPN and remote-access gateways, custom line-of-business applications, developer or test services, and software update channels on non-standard ports."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains. Add legitimate extra TLS ports to the port exclusions. Exclude approved remote tooling by adding its source hosts to %global_allowed_remote_mgmt. Raise severity for servers or critical assets that should never egress on unusual ports."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.direction = "OUTBOUND"
    $net.network.application_protocol = "HTTPS"
    $net.target.port != 443
    $net.target.port != 8443
    $net.target.port != 465
    $net.target.port != 587
    $net.target.port != 636
    $net.target.port != 853
    $net.target.port != 989
    $net.target.port != 990
    $net.target.port != 993
    $net.target.port != 995
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1573")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
