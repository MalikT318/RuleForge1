/*
  MITRE Technique : T1555.003 - Credentials from Web Browsers
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:56:46.805453+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_003_Linux_Browser_Credential_Store_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a non-browser process reading a Linux web browser credential store, such as Firefox logins.json, key3.db, key4.db or signons.sqlite, or the Chromium-family 'Login Data' SQLite database. This is file-access telemetry rather than command-line matching, so it also catches in-memory stealers, compiled tools and scripting-language readers that never expose a recognisable command line."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.003"
    mitre_technique_name = "Credentials from Password Stores: Credentials from Web Browsers"
    log_prerequisites = "Requires Linux file-read telemetry: EDR file-access events, or auditd watch rules (-w <path> -p r) on browser profile credential files, normalised to UDM FILE_READ with principal.process populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup and imaging agents copying home directories, endpoint security agents scanning profiles, browser-profile migration or sync utilities, forensic and DLP collectors, and desktop helpers launched by the browser under a different binary name."
    tuning_guidance = "Add backup agents to %global_allowed_backup_processes and EDR/AV agents to %global_allowed_security_tools. Add approved profile-management tooling to %global_allowed_admin_tools. Add known automation accounts to %global_allowed_service_accounts. The browser-name exclusion is by executable name only, so pair it with process-integrity detections to catch a stealer renamed to a browser name."

  events:
    $file.metadata.event_type = "FILE_READ"
    (
      $file.target.file.full_path = /\/\.mozilla\/firefox\/[^\/]+\/(logins\.json|key[34]\.db|signons\.sqlite)$/ nocase or
      $file.target.file.full_path = /\/(google-chrome|google-chrome-beta|chromium|microsoft-edge|BraveSoftware\/Brave-Browser|opera|vivaldi)(\/[^\/]+)?\/Login Data( For Account)?$/ nocase
    )
    not $file.principal.process.file.full_path = /\/(firefox|firefox-bin|firefox-esr|chrome|chromium|chromium-browser|brave|brave-browser|msedge|opera|vivaldi-bin|crashpad_handler)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $accessed_files = array_distinct($file.target.file.full_path)
    $reading_processes = array_distinct($file.principal.process.file.full_path)
    $acting_users = array_distinct($file.principal.user.userid)

  condition:
    $file
}
