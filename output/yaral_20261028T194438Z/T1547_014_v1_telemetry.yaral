/*
  MITRE Technique : T1547.014 - Active Setup
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:41:31.652727+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_014_Active_Setup_StubPath_Registry_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry modification that sets the StubPath value under an Active Setup Installed Components key (native or Wow6432Node). Windows runs StubPath at each user's next logon, so adversaries use it for persistence. The rule matches the resulting registry state change, not the command line, so it still fires if the writing tool, command syntax or logging of process arguments is evaded."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.014"
    mitre_technique_name = "Boot or Logon Autostart Execution: Active Setup"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR registry events or Sysmon Event ID 12/13) normalised to UDM REGISTRY_MODIFICATION with target.registry.registry_key and registry_value_name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate installers and MSI-based software (browsers, Office, runtimes, VPN and endpoint agents) that register Active Setup components to run per-user first-logon configuration; software deployment and patching tools; OS servicing and feature updates; golden-image build processes."
    tuning_guidance = "Add approved deployment and installer tooling to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Review hosts with frequent software rollouts and consider a temporary exclusion during deployment windows. Triage by checking the StubPath target for user-writable locations, script hosts or LOLBins, and unsigned binaries."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Software\\(Wow6432Node\\)?Microsoft\\Active Setup\\Installed Components\\/ nocase
    $reg.target.registry.registry_value_name = /^StubPath$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1547.014")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
