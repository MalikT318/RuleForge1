/*
  MITRE Technique : T1561.001 - Disk Content Wipe
  Tactic(s)       : Impact
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:04:12.320298+00:00
  Reference       : https://attack.mitre.org/techniques/T1561/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1561_001_Mgmt_Plane_Disk_Wipe_Request_From_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a state-changing HTTP request to a network device management plane that invokes a storage erase, format, zeroize or factory-reset function, originating from outside internal address space and outside approved management sources. This is the network-observable result of an adversary trying to wipe device storage remotely (T1561.001)."
    mitre_tactic = "Impact"
    mitre_technique = "T1561.001"
    mitre_technique_name = "Disk Wipe: Disk Content Wipe"
    log_prerequisites = "Requires firewall, proxy or perimeter logs that record HTTP method and full URL (for example SSL-inspected or reverse-proxied management traffic) and are normalised to UDM NETWORK_HTTP with principal.ip and target.url populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised remote administrators or MSP engineers performing a planned factory reset or RMA from an unlisted external address; device decommissioning workflows; cloud-managed device orchestration platforms that call reset APIs from public addresses; web applications whose URLs happen to contain format or erase keywords."
    tuning_guidance = "Add approved management or orchestration source addresses to %global_allowed_mgmt_sources and approved administrator tooling sources to %global_allowed_scanners. Add known-good vendor or orchestration destinations to %global_allowed_domains. If the client logs only the path, make sure target.url is mapped from the request URI. Raise severity to Critical for internet-facing management interfaces."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT|DELETE|PATCH)$/ nocase
    $net.target.url = /\/(erase|format|wipe|zeroize|secure[-_]?erase|factory[-_]?(reset|default)|reset[-_]?to[-_]?default|restore[-_]?factory)([\/?&=_.-]|$)/ nocase
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1561.001")
    $primary_entity = array_distinct($net.target.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $request_urls = array_distinct($net.target.url)
    $http_methods = array_distinct($net.network.http.method)

  condition:
    $net
}
