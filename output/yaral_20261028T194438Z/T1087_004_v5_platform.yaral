/*
  MITRE Technique : T1087.004 - Cloud Account
  Tactic(s)       : Discovery
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:58:19.027122+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_004_SaaS_Directory_Account_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a non-allowlisted identity performing a directory-wide listing, search, or export of user, member, account, or role-assignment objects through a SaaS or identity control plane API. This covers cloud account discovery (T1087.004) from the audit log side, independent of any endpoint command line."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.004"
    mitre_technique_name = "Account Discovery: Cloud Account"
    log_prerequisites = "Requires SaaS or identity provider audit logs normalised to UDM USER_RESOURCE_ACCESS, with metadata.product_event_type and principal.user.userid populated. Directory read or list auditing must be enabled in the tenant."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "HR or identity governance sync jobs, access review campaigns, SIEM or CMDB connectors, helpdesk staff searching for users, administrators running licence or role audits, onboarding and offboarding automation, and user-directory lookups made by sanctioned third-party integrations."
    tuning_guidance = "Add automation and connector identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Add named administrators to %global_allowed_admin_users. Tune the product_event_type regex to match the list, search, and export event names your tenants emit. To reduce noise further, convert to a Threshold rule grouped by principal.user.userid."

  events:
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.metadata.product_event_type = /(list|enumerate|search|export|download|get[-_ ]?all|read[-_ ]?all).*(users|members|accounts|directory|roles?[-_ ]?(members|assignments)|service[-_ ]?principals|groups?[-_ ]?members)/ nocase
    $access.principal.user.userid != ""
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_admin_users
    not $access.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1087.004")
    $primary_entity = array_distinct($access.principal.user.userid)
    $source_ips = array_distinct($access.principal.ip)
    $api_operations = array_distinct($access.metadata.product_event_type)
    $target_resources = array_distinct($access.target.resource.name)

  condition:
    $access
}
