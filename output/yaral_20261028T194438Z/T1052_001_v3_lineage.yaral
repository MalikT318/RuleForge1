/*
  MITRE Technique : T1052.001 - Exfiltration over USB
  Tactic(s)       : Exfiltration
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:42:55.861843+00:00
  Reference       : https://attack.mitre.org/techniques/T1052/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1052_001_Linux_Service_Parent_Spawns_Copy_To_USB_Mount {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server or database service process spawning a shell, script interpreter or file copy/archive utility whose command line references a removable-media mount point (/media, /run/media, /mnt). Server daemons should not stage data onto USB storage, so this lineage suggests exploited-service or webshell-driven exfiltration over a physical device."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1052.001"
    mitre_technique_name = "Exfiltration Over Physical Medium: Exfiltration over USB"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to PROCESS_LAUNCH with parent path, child path and full command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Database or application backup jobs launched by the service itself and writing to /mnt; NFS or cloud volumes mounted under /mnt or /media; admin-initiated maintenance from a service-owned shell; application dump or export features writing to an attached disk."
    tuning_guidance = "Add approved parent binaries to %global_allowed_script_hosts, backup agents to %global_allowed_backup_processes, and service accounts that legitimately export data to %global_allowed_service_accounts. If /mnt is used for network storage in a client environment, remove it from the mount-point regex for that client."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|php-cgi|tomcat[0-9]*|java|gunicorn|uwsgi|node|mysqld|mariadbd|postgres|mongod|redis-server)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ksh|python[0-9.]*|perl|ruby|cp|mv|rsync|tar|dd|zip|7z|7za|cat)$/ nocase
    $proc.target.process.command_line = /(^|\s|=|>|")(\/media|\/run\/media|\/mnt)\// nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.hostname in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1052.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
