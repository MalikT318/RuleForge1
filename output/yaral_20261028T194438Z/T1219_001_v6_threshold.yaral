/*
  MITRE Technique : T1219.001 - IDE Tunneling
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:07:26.709887+00:00
  Reference       : https://attack.mitre.org/techniques/T1219/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1219_001_Sustained_Repeated_Egress_Tunnel_Pattern {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source makes a high volume of outbound TCP/443 connections to one external destination within ten minutes. This is the network-observable pattern of an IDE remote-development tunnel (for example a CLI-established tunnel or an IDE remote server) that holds, reconnects and keeps alive an encrypted session to a relay service. No single connection is suspicious; the sustained volume to one destination is. The rule is a heuristic with no hardcoded domains, so it relies on exclusions for tuning."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1219.001"
    mitre_technique_name = "Remote Access Tools: IDE Tunneling"
    log_prerequisites = "Requires firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs should come from the egress perimeter so that Linux server and workstation traffic is visible."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Software update and package mirrors, cloud storage sync, SaaS API polling, CI/CD runners and build agents, monitoring or telemetry agents, legitimate developer remote-development use, and NAT gateways that aggregate many hosts behind one source IP."
    tuning_guidance = "Add known-good external destinations to %global_allowed_domains. Add authorised scanners or test sources to %global_allowed_scanners. Raise the #net threshold for noisy segments such as build networks or NAT egress. Use the destination_ips, destination_hostnames and total_sent_bytes outcome values to confirm long-lived, bidirectional sessions, then correlate with Linux endpoint telemetry to identify the tunnelling process."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 443
    $net.principal.ip = $src
    $net.target.ip = $dst
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src, $dst over 10m

  outcome:
    $risk_score = max(55)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1219.001")
    $primary_entity = array_distinct($src)
    $destination_ips = array_distinct($dst)
    $destination_hostnames = array_distinct($net.target.hostname)
    $total_sent_bytes = sum($net.network.sent_bytes)
    $total_received_bytes = sum($net.network.received_bytes)

  condition:
    #net >= 40
}
