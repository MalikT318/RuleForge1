/*
  MITRE Technique : T1199 - Trusted Relationship
  Tactic(s)       : Initial Access
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:49:10.983980+00:00
  Reference       : https://attack.mitre.org/techniques/T1199
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1199_IdP_Burst_Of_Privilege_Changes_By_Single_Actor {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single non-allowlisted identity performs several privilege or role-permission changes on other accounts within ten minutes. A compromised third-party, partner or delegated-administrator account abusing a trusted relationship typically escalates access in a burst like this. One permission change is routine; a rapid series by one actor is not."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1199"
    mitre_technique_name = "Trusted Relationship"
    log_prerequisites = "Requires identity provider directory audit logs normalised to UDM USER_CHANGE_PERMISSIONS with principal.user.userid (actor) and target.user.userid (affected account) populated."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Planned onboarding or offboarding waves, bulk role re-assignment projects, identity governance or access-review automation, helpdesk staff processing many requests, and managed-service staff performing approved delegated administration."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users, automation and provisioning identities to %global_allowed_service_accounts, and approved directory service principals to %global_allowed_cloud_principals. Raise the #perm threshold for tenants with heavy bulk provisioning. Lower it for high-security tenants."

  events:
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.principal.user.userid != ""
    $perm.principal.user.userid != $perm.target.user.userid
    $perm.principal.user.userid = $user
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_cloud_principals

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($perm.metadata.id)
    $affected_accounts = array_distinct($perm.target.user.userid)
    $source_ips = array_distinct($perm.principal.ip)
    $mitre_technique_id = array_distinct("T1199")
    $primary_entity = array_distinct($user)

  condition:
    #perm >= 4
}
