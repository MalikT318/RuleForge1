/*
  MITRE Technique : T1495 - Firmware Corruption
  Tactic(s)       : Impact
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:49:11.030971+00:00
  Reference       : https://attack.mitre.org/techniques/T1495
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1495_Firmware_Image_Download_Then_TFTP_Push {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A Windows source address downloads a firmware or BIOS-style image from an external web location and then, within 10 minutes, opens TFTP (UDP/69) sessions to internal addresses. This is the network-observable pattern of staging and pushing a firmware image to network devices or hardware that could be overwritten or bricked."
    mitre_tactic = "Impact"
    mitre_technique = "T1495"
    mitre_technique_name = "Firmware Corruption"
    log_prerequisites = "Requires perimeter firewall or proxy logs normalized to UDM NETWORK_HTTP (with full URL) and NETWORK_CONNECTION or NETWORK_FLOW (with source IP and destination port). Both log types must carry principal.ip for the same internal client."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Network engineers upgrading switch, router or access point firmware via TFTP from a Windows admin workstation; PXE or OS-deployment servers pulling boot images; hardware vendors' BIOS update tooling combined with provisioning workflows; lab and imaging networks."
    tuning_guidance = "Add authorised admin workstations and jump hosts to %global_allowed_mgmt_sources. Add vendor firmware download sites to %global_allowed_domains. If .bin or .img matches are too noisy in a client environment, narrow the extension regex for that client."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\.(rom|cap|fd|wph|bio|bin|img)(\?|$)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    $http.principal.ip = $src_ip

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    $net.principal.ip = $src_ip

    $http.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1495")
    $primary_entity = array_distinct($src_ip)
    $download_urls = array_distinct($http.target.url)
    $tftp_destinations = array_distinct($net.target.ip)
    $tftp_session_count = count($net.metadata.id)

  condition:
    $http and $net
}
