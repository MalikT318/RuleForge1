/*
  MITRE Technique : T1684.001 - Impersonation
  Tactic(s)       : Stealth
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:31:35.641537+00:00
  Reference       : https://attack.mitre.org/techniques/T1684/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1684_001_Mail_Office_Parent_Spawns_Script_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an email client or Office application spawning a command shell or script interpreter. This is the endpoint-visible consequence of a lure delivered by an impersonated sender (for example a fake executive or vendor message carrying a malicious attachment). It does not detect the impersonation itself, which is only visible in email and identity telemetry. Pivots on process lineage, not on the child's command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1684.001"
    mitre_technique_name = "Social Engineering: Impersonation"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry that includes parent process image path (EDR, Sysmon Event ID 1 or Windows Security Event 4688 with parent process and command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros or add-ins used by finance or ERP workflows that shell out (for example report exporters); Outlook rules or plugins that launch scripts; legitimate VBA automation in managed templates; IT-approved document-processing tools."
    tuning_guidance = "Add approved parent binaries or automation hosts to %global_allowed_script_hosts and approved management tooling to %global_allowed_admin_tools. If a specific business application is noisy, exclude it by parent executable name, not by install directory. Consider raising severity for hosts where the child command line contains encoded or download-style arguments."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(outlook|olk|hxoutlook|winword|excel|powerpnt|onenote|msaccess|mspub|visio)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|powershell_ise|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1684.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
