/*
  MITRE Technique : T1496.002 - Bandwidth Hijacking
  Tactic(s)       : Impact
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:55:12.418373+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_002_Cloud_Burst_Compute_Network_Resource_Provisioning {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single cloud identity provisions many compute instances, public IP addresses or NAT/egress resources within 10 minutes. Individual creations are routine, but bursts of this kind are typical of bandwidth hijacking: proxyjacking, botnet or torrent-seeding fleets, and internet-wide scanning infrastructure stood up with stolen credentials."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.002"
    mitre_technique_name = "Resource Hijacking: Bandwidth Hijacking"
    log_prerequisites = "Cloud provider control-plane audit logs (management or admin activity events) ingested and parsed into UDM with metadata.product_event_type and principal.user.userid populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Infrastructure-as-code pipelines, autoscaling groups and managed node pools, CI/CD runners, disaster-recovery or load-test environment builds, and migration projects."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, approved provisioning principals to %global_allowed_cloud_principals, and named platform engineers to %global_allowed_admin_users. Raise the #res threshold for tenants with heavy autoscaling. Lower it for tenants that rarely provision resources."

  events:
    $res.metadata.event_type = "RESOURCE_CREATION"
    $res.metadata.product_event_type = /(RunInstances|AllocateAddress|CreateNatGateway|virtualMachines\/write|publicIPAddresses\/write|natGateways\/write|instances\.(insert|bulkInsert)|addresses\.insert|routers\.insert)/ nocase
    $res.principal.user.userid = $user
    not $res.principal.user.userid in %global_allowed_service_accounts
    not $res.principal.user.userid in %global_allowed_cloud_principals
    not $res.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($res.metadata.id)
    $mitre_technique_id = array_distinct("T1496.002")
    $primary_entity = array_distinct($user)
    $api_calls = array_distinct($res.metadata.product_event_type)
    $source_ips = array_distinct($res.principal.ip)
    $created_resources = array_distinct($res.target.resource.name)

  condition:
    #res >= 10
}
