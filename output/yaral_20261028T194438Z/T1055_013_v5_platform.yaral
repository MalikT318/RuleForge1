/*
  MITRE Technique : T1055.013 - Process Doppelgänging
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:02:07.560212+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_013_Process_Doppelganging_Injection_Into_System_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process running from a user-writable location that injects into, or tampers with, a core Windows system process. This is the observable result of process doppelgänging, where a TxF-backed section is mapped into a legitimate-looking process. The alternate-platform angle does not apply because TxF is Windows-only, so this rule gives non-command-line coverage on Windows through injection telemetry."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.013"
    mitre_technique_name = "Process Injection: Process Doppelgänging"
    log_prerequisites = "Requires endpoint telemetry that reports cross-process injection or tampering events (EDR or Sysmon-equivalent) normalised to PROCESS_INJECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Security and EDR agents, application compatibility shims, software installers or updaters running from AppData or ProgramData, backup agents, accessibility and overlay software, and game anti-cheat or DRM components."
    tuning_guidance = "Add approved injecting binaries to %global_allowed_security_tools, %global_allowed_admin_tools or %global_allowed_backup_processes. If a client has noisy updaters that run from user-writable paths, add them to %global_allowed_admin_tools. Narrow or widen the target process list per client baseline."

  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.process.file.full_path = /\\(users\\[^\\]+\\appdata\\(local|roaming)|windows\\temp|programdata|users\\public|perflogs)\\/ nocase
    $inj.target.process.file.full_path = /\\(svchost|explorer|lsass|winlogon|services|spoolsv|dllhost|runtimebroker|wininit|csrss|taskhostw|sihost)\.exe$/ nocase
    $inj.principal.process.file.full_path != $inj.target.process.file.full_path
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes
    not $inj.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR)\.exe$/ nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.013")
    $primary_entity = array_distinct($inj.principal.hostname)
    $injector_path = array_distinct($inj.principal.process.file.full_path)
    $injected_target = array_distinct($inj.target.process.file.full_path)
    $acting_user = array_distinct($inj.principal.user.userid)

  condition:
    $inj
}
