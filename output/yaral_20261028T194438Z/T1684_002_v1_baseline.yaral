/*
  MITRE Technique : T1684.002 - Email Spoofing
  Tactic(s)       : Stealth
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:32:54.228199+00:00
  Reference       : https://attack.mitre.org/techniques/T1684/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1684_002_Linux_Mail_Sender_Address_Override {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a local mail submission binary (MTA or command-line mail client) launched on a Linux host with an explicit override of the sender identity, such as an envelope-sender flag, a From address option, or a custom From header. Forging the sender from a compromised host is the core mechanism of email spoofing. The rule matches the flag combination rather than any tool name, so it still fires if the binary is renamed or wrapped."
    mitre_tactic = "Stealth"
    mitre_technique = "T1684.002"
    mitre_technique_name = "Email Spoofing"
    log_prerequisites = "Requires Linux EDR or auditd EXECVE process telemetry with full command-line capture, normalised to UDM PROCESS_LAUNCH."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Monitoring and alerting scripts that set a fixed sender (cron jobs, Nagios-style checks), application servers sending notifications with a custom From address, backup and report mailers, mailing-list or ticketing software, and administrators testing mail flow."
    tuning_guidance = "Add approved automation accounts to %global_allowed_service_accounts. Add approved parent scripts or tooling to %global_allowed_admin_tools. Add hosts permitted to run scripted mail to %global_allowed_script_hosts if needed. Review the matched command line to check whether the sender domain is one the organisation owns. Mail relays and notification servers are the usual source of noise."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(sendmail|sendmail\.postfix|sendmail\.sendmail|mail|mailx|bsd-mailx|s-nail|nail|mutt|msmtp|ssmtp|exim|exim4)$/ nocase
    $proc.target.process.command_line = /(\s-[fr]\s*['"]?[^\s'"]+@[^\s'"]+|\s--(from|envelope-sender)[\s=]+['"]?[^\s'"]+@|\s-S\s*['"]?from=|my_hdr\s+From:|\s-a\s+['"]?From:)/ nocase
    not $proc.principal.process.file.full_path = /\/(master|pickup|qmgr|local|smtpd|exim|exim4)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1684.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $mail_binary = array_distinct($proc.target.process.file.full_path)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
