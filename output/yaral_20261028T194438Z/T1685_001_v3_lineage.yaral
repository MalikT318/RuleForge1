/*
  MITRE Technique : T1685.001 - Disable or Modify Windows Event Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:16:38.235478+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_001_Anomalous_Parent_Spawns_EventLog_Tampering {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an unexpected parent process (Office application, web server, print spooler, or database service) spawning a shell, script interpreter, or built-in utility that disables, clears, or reconfigures Windows Event Logging or audit policy. The rule pivots on process lineage: the parent is the primary signal, and a broad log-tampering indicator is a secondary confirmation."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.001"
    mitre_technique_name = "Disable or Modify Windows Event Log"
    log_prerequisites = "Requires EDR or Sysmon process-creation telemetry that populates both parent (principal.process) and child (target.process) image paths and the child command line, or Windows Event 4688 with command-line auditing and parent process name."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web-application administration or maintenance features that shell out to run log housekeeping, database maintenance jobs (SQL Agent) that rotate or clear event logs, Office macros in IT-authored automation, and print or driver installers that call sc or wevtutil during setup."
    tuning_guidance = "Add approved parent process paths to %global_allowed_admin_tools or %global_allowed_script_hosts. Add known maintenance accounts to %global_allowed_admin_users. Adjust the parent process regex to cover additional web or database server names used by the client."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Anomalous parent: Office, web server, print spooler, or database service
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|spoolsv|sqlservr|sqlagent|mysqld|postgres|oracle)\.exe$/ nocase

    // Child: shell, script interpreter, or built-in log/audit management utility
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|wevtutil|auditpol|sc|net|net1|reg|wmic)\.exe$/ nocase

    // Log-tampering behaviour in the child command line
    $proc.target.process.command_line = /(wevtutil(\.exe)?["']?\s+(cl|clear-log|sl|set-log)\b|clear-eventlog|remove-eventlog|limit-eventlog|\bclearlog\b|auditpol.*(\/clear|\/remove|\/set.*(success|failure):disable)|\bsc(\.exe)?["']?\s+(config|stop|delete)\s+["']?eventlog|net1?\s+stop\s+["']?eventlog|(stop|set|remove)-service.*eventlog|\/e:false|enabled:false|\\services\\eventlog|\\winevt\\channels)/ nocase

    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1685.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
