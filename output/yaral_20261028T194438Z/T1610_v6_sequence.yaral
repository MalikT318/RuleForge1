/*
  MITRE Technique : T1610 - Deploy Container
  Tactic(s)       : Execution
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:30:12.295883+00:00
  Reference       : https://attack.mitre.org/techniques/T1610
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1610_K8s_Interactive_Pod_Create_Then_Exec {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A human or non-allowlisted identity creates a pod through the Kubernetes API and then opens an exec or attach session into a pod within 10 minutes. This pattern is typical of an adversary deploying a container and running commands in it (Deploy Container, with possible follow-on Escape to Host)."
    mitre_tactic = "Execution"
    mitre_technique = "T1610"
    mitre_technique_name = "Deploy Container"
    log_prerequisites = "Requires Kubernetes API server audit logs ingested and normalised to UDM. Pod creation must map to RESOURCE_CREATION with target.resource.resource_type POD. Exec and attach requests must map to USER_RESOURCE_ACCESS with target.url populated from the request URI."
    platform = "Containers"
    log_source = "container"
    false_positives = "Developers or SREs running ad-hoc debug pods and exec'ing into them, CI/CD pipelines using named user accounts, break-glass troubleshooting, and training or lab clusters."
    tuning_guidance = "Add automation and pipeline identities to %global_allowed_service_accounts and approved administrators to %global_allowed_admin_users. Consider scoping the rule to production clusters through your SIEM tenant or label filtering. If the audit pipeline does not populate target.url, adjust the exec/attach match to the field that carries the request URI."

  events:
    $create.metadata.event_type = "RESOURCE_CREATION"
    $create.target.resource.resource_type = "POD"
    $create.principal.user.userid != ""
    not $create.principal.user.userid = /^system:/ nocase
    not $create.principal.user.userid in %global_allowed_service_accounts
    not $create.principal.user.userid in %global_allowed_admin_users
    $create.principal.user.userid = $user

    $exec.metadata.event_type = "USER_RESOURCE_ACCESS"
    $exec.target.url = /\/pods\/[^\/\?]+\/(exec|attach)/ nocase
    not $exec.principal.user.userid in %global_allowed_service_accounts
    not $exec.principal.user.userid in %global_allowed_admin_users
    $exec.principal.user.userid = $user

    $create.metadata.event_timestamp.seconds <= $exec.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1610")
    $primary_entity = array_distinct($create.principal.user.userid)
    $created_pods = array_distinct($create.target.resource.name)
    $exec_targets = array_distinct($exec.target.url)
    $source_ips = array_distinct($exec.principal.ip)
    $event_count = count($exec.metadata.id)

  condition:
    $create and $exec
}
