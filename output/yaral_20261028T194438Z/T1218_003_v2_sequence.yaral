/*
  MITRE Technique : T1218.003 - CMSTP
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:45:14.409476+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_003_CMSTP_INF_Drop_Then_Proxy_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An INF file is written to a user-writable location and, within 10 minutes on the same host, cmstp.exe spawns a script host, shell or proxy-execution LOLBin as a child process. This is the typical CMSTP abuse chain: a malicious INF is staged, then cmstp.exe is used to run its commands, DLLs or scriptlets. Detection is based on file staging and process lineage, not command-line matching."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.003"
    mitre_technique_name = "System Binary Proxy Execution: CMSTP"
    log_prerequisites = "Requires Windows endpoint telemetry that provides both FILE_CREATION events (with the creating process) and PROCESS_LAUNCH events with parent process lineage (EDR or Sysmon Event IDs 11 and 1)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "VPN or Connection Manager profile deployment by IT, software installers that drop INF files to temp folders and invoke cmstp.exe, packaging and deployment tooling, and admins testing Connection Manager profiles."
    tuning_guidance = "Add approved deployment tooling to %global_allowed_admin_tools (matched on the process that writes the INF). Add approved administrator accounts to %global_allowed_admin_users. Extend the staging-path regex if clients stage profiles in other user-writable locations."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|windows\\temp|programdata|users\\public)\\.*\.inf$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|TiWorker|TrustedInstaller)\.exe$/ nocase
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\cmstp\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|msiexec)\.exe$/ nocase
    not $proc.principal.user.userid in %global_allowed_admin_users
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.003")
    $primary_entity = array_distinct($hostname)
    $inf_paths = array_distinct($file.target.file.full_path)
    $inf_writers = array_distinct($file.principal.process.file.full_path)
    $child_processes = array_distinct($proc.target.process.file.full_path)
    $affected_users = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
