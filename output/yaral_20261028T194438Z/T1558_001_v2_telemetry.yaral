/*
  MITRE Technique : T1558.001 - Golden Ticket
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:39:34.188153+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_001_Kerberos_Ticket_File_Written_To_Disk {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a Kerberos ticket file (.kirbi KRB-CRED or .ccache credential cache) on a Windows host. Forged golden tickets, and TGTs extracted from LSASS memory, are commonly saved to disk in these formats before being injected into a logon session. This rule works on the resulting file artifact, so it does not depend on command-line logging and still fires if the attacker renames the tool. Tickets whose file path references krbtgt receive a higher risk score."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.001"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Golden Ticket"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon Event ID 11) that populates target.file.full_path and the principal process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Kerberos troubleshooting or interoperability testing by administrators, Kerberos and Active Directory security assessments or red-team exercises, security tooling that exports tickets for analysis, and developers working with MIT Kerberos or Linux interoperability tooling on Windows."
    tuning_guidance = "Add approved writer processes (EDR, forensic and assessment tools) to %global_allowed_security_tools. Add named administrators who legitimately troubleshoot Kerberos to %global_allowed_admin_users. If a client uses MIT Kerberos on Windows, review .ccache hits and narrow the extension regex to .kirbi for that tenant."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(kirbi|ccache)$/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(if($file.target.file.full_path = /krbtgt/ nocase, 95, 75))
    $mitre_technique_id = array_distinct("T1558.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $ticket_file_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
