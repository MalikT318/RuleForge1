/*
  MITRE Technique : T1001.002 - Steganography
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:08:07.713331+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_002_Linux_Scripted_Client_Image_Fetch_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects, from proxy or firewall HTTP telemetry, a Linux-style command-line or scripted HTTP client (curl, wget, python, Go, Perl and similar user agents) fetching an image file from an external destination. Steganographic C2 commonly hides tasking inside image files retrieved this way, whereas legitimate image downloads come from browsers."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001.002"
    mitre_technique_name = "Data Obfuscation: Steganography"
    log_prerequisites = "Requires web proxy or firewall NETWORK_HTTP logs with target.url, network.http.user_agent and network.http.method populated (TLS inspection needed for HTTPS visibility). Network-side observation only; no endpoint process fields are used."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Package managers or build pipelines fetching icons and images, CI/CD jobs pulling container or documentation assets, monitoring and health-check scripts, configuration management agents downloading branding assets, admins running curl or wget manually."
    tuning_guidance = "Add known-good CDN, vendor and update domains to %global_allowed_domains. Add approved scanner or automation source hosts to %global_allowed_scanners. If a client has noisy build servers, add their hostnames to %global_allowed_scanners or the user agent pattern can be narrowed. Raise severity if the same source repeats the fetch at regular intervals (beaconing)."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET"
    $http.target.url = /\.(jpe?g|png|gif|bmp|ico|webp|tiff?)(\?.*)?$/ nocase
    $http.network.http.user_agent = /(curl|wget|python-(urllib|requests)|aiohttp|libwww-perl|go-http-client|libcurl|httpie|lwp-request|ruby|java\/)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1001.002")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
