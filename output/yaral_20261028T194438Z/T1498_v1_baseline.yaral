/*
  MITRE Technique : T1498 - Network Denial of Service
  Tactic(s)       : Impact
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:07:47.787107+00:00
  Reference       : https://attack.mitre.org/techniques/T1498
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_Inbound_Reflection_Amplification_Flood {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a single inbound flow record in which an external source sends a very large volume of UDP traffic from a well-known reflection or amplification service port (DNS, NTP, SNMP, SSDP, CLDAP, memcached, chargen) to a cloud-hosted resource. This is the result of a reflection/amplification DDoS and is independent of attacker tooling, hosting or C2."
    mitre_tactic = "Impact"
    mitre_technique = "T1498"
    mitre_technique_name = "Network Denial of Service"
    log_prerequisites = "Requires perimeter firewall, cloud firewall or flow logs normalised to UDM NETWORK_FLOW with principal.ip, principal.port, target.ip, network.ip_protocol, network.direction and network.sent_bytes populated. Flow logging must be enabled on the perimeter protecting the IaaS workloads. Cloud control-plane audit logs alone do not record traffic volume and cannot support this detection."
    platform = "IaaS"
    log_source = "firewall"
    false_positives = "Large legitimate transfers from external DNS, NTP or SNMP servers, bulk zone transfers or large SNMP polling from third-party monitoring, internet-facing UDP services whose sources legitimately use these ports, and vulnerability or load-testing scans."
    tuning_guidance = "Add authorised scanners and load-test sources to %global_allowed_scanners and trusted peers or monitoring sources to %global_allowed_mgmt_sources. Adjust the network.sent_bytes threshold (10 MB per flow record) to match the flow aggregation interval and the typical inbound traffic profile of each client. Remove ports that are legitimately used as source ports by the client's services."

  events:
    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.network.direction = "INBOUND"
    $flow.network.ip_protocol = "UDP"
    (
      $flow.principal.port = 19 or
      $flow.principal.port = 53 or
      $flow.principal.port = 123 or
      $flow.principal.port = 161 or
      $flow.principal.port = 389 or
      $flow.principal.port = 1900 or
      $flow.principal.port = 11211
    )
    $flow.network.sent_bytes >= 10000000
    not $flow.principal.ip in %rfc1918_internal
    not $flow.principal.ip in %global_allowed_scanners
    not $flow.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1498")
    $primary_entity = array_distinct($flow.target.ip)
    $source_ips = array_distinct($flow.principal.ip)
    $source_ports = array_distinct($flow.principal.port)
    $max_bytes = max($flow.network.sent_bytes)

  condition:
    $flow
}
