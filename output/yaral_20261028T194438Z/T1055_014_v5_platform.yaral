/*
  MITRE Technique : T1055.014 - VDSO Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:03:51.878610+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_014_Linux_Proc_Mem_Write_Foreign_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a write to /proc/<pid>/mem for a numeric PID, the file-level primitive used to patch another live process's memory. VDSO hijacking uses this to overwrite the vDSO syscall stubs or GOT entries in a victim process so it maps and runs attacker code. The rule works at the file-modification layer and does not depend on process command lines or tool names. /proc/self/mem is deliberately excluded to cut noise from runtimes and JIT engines."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.014"
    mitre_technique_name = "Process Injection: VDSO Hijacking"
    log_prerequisites = "Linux EDR or auditd file-write telemetry that records writes to procfs paths (for example auditd watches on /proc/*/mem, or an EDR file-modification sensor with procfs coverage). Events must populate target.file.full_path and principal.process.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Interactive debuggers (gdb, lldb, strace-based tooling), crash dump and core capture utilities, live-patching and instrumentation agents, language runtime profilers, and EDR/AV agents that inspect or modify process memory."
    tuning_guidance = "Add approved debuggers, profilers and patching tools to %global_allowed_admin_tools. Add EDR and runtime-protection agents to %global_allowed_security_tools. Add backup or snapshot agents that touch process memory to %global_allowed_backup_processes. On developer or build hosts with heavy debugger use, consider raising severity only for writers running from /tmp, /dev/shm or /var/tmp."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/proc\/[0-9]+\/mem$/
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path = /\/(gdb|gdbserver|lldb|lldb-server|strace|ltrace)$/

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.014")
    $primary_entity = array_distinct($file.principal.hostname)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $target_proc_mem = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
