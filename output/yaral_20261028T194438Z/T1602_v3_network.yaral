/*
  MITRE Technique : T1602 - Data from Configuration Repository
  Tactic(s)       : Collection
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:16:37.547388+00:00
  Reference       : https://attack.mitre.org/techniques/T1602
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_External_Access_To_Device_Config_Services {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects connections from non-internal source addresses to well-known network-device configuration-repository services (SNMP 161, TFTP 69, and the vendor smart-install port 4786). These services expose device configurations, community strings and management data. External reachability is rarely legitimate and is a common way to harvest configuration data from managed devices."
    mitre_tactic = "Collection"
    mitre_technique = "T1602"
    mitre_technique_name = "Data from Configuration Repository"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with populated principal.ip, target.ip and target.port. Logs must record permitted traffic, not only denied traffic, to catch successful access."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Managed-service or ISP monitoring platforms polling SNMP from public addresses, external vulnerability or attack-surface scanners, remote-site NAT'd management stations, and cloud-hosted network monitoring SaaS."
    tuning_guidance = "Add approved monitoring and management source addresses to %global_allowed_mgmt_sources and authorised scanner addresses to %global_allowed_scanners. If a client legitimately uses a service such as SNMP from the internet, scope an exception by source rather than disabling the rule. Populate %rfc1918_internal with the client's internal address strings so internal traffic is excluded."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 161 or $net.target.port = 69 or $net.target.port = 4786)
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1602")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
