/*
  MITRE Technique : T1542 - Pre-OS Boot
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:40:29.938627+00:00
  Reference       : https://attack.mitre.org/techniques/T1542
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_Linux_External_Network_Boot_Protocol_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects perimeter-observed network-boot protocol traffic (TFTP on UDP/69 or PXE proxy service on 4011) sent to an external destination. Network boot is an internal-only provisioning function. Traffic leaving the network is a network-side indicator that a Linux host is fetching a bootloader, boot image or firmware payload from an untrusted source, which is a pre-OS boot persistence or tampering mechanism. Endpoint telemetry is assumed to cover the host-side activity."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542"
    mitre_technique_name = "Pre-OS Boot"
    log_prerequisites = "Requires firewall or perimeter NETWORK_CONNECTION events with populated principal.ip, target.ip and target.port. Egress traffic must be logged for UDP/69 and UDP/4011."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Branch or remote-site provisioning that uses a cloud-hosted TFTP/PXE service, vendor-managed hardware or firmware refresh over TFTP, lab networks routed through the perimeter, and misconfigured devices or scanners probing port 69."
    tuning_guidance = "Add approved provisioning, imaging and scanner source addresses to %global_allowed_mgmt_sources or %global_allowed_scanners. The 'not in' exclusions are strings. Review %rfc1918_internal to confirm it covers all internal and routed provisioning ranges for the client."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 69 or $net.target.port = 4011)
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1542")
    $primary_entity = array_distinct($net.principal.ip)
    $source_hostnames = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
