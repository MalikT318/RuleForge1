/*
  MITRE Technique : T1047 - Windows Management Instrumentation
  Tactic(s)       : Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:30:17.502301+00:00
  Reference       : https://attack.mitre.org/techniques/T1047
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1047_WMI_MOF_File_Written_To_Repository_Or_Staging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a WMI Managed Object Format (.mof) file in the WBEM directory tree or in a user-writable staging location by a process that is not a trusted installer or approved admin tool. MOF files are compiled into the WMI repository to register persistent event subscriptions, providers and classes, so the file artifact shows WMI abuse even when command-line logging is evaded or the compiler is invoked indirectly."
    mitre_tactic = "Execution"
    mitre_technique = "T1047"
    mitre_technique_name = "Windows Management Instrumentation"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent) with populated target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows servicing and cumulative updates (TrustedInstaller, TiWorker), MSI installers for management or monitoring software that ship MOF files (SCCM/MECM agents, hardware vendor management packs, SQL Server, Exchange), and administrators or developers authoring MOF files."
    tuning_guidance = "Add approved deployment or RMM tooling to %global_allowed_admin_tools. Add trusted installer or servicing binaries to the executable-name exclusion if your estate uses other update agents. Review the file path in outcome: a .mof in a Temp, AppData or Public path is higher fidelity than one under wbem written by a vendor installer."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(\\wbem\\([^\\]+\\)*[^\\]+\.mof$|\\(temp|appdata|users\\public|programdata|downloads)\\([^\\]+\\)*[^\\]+\.mof$)/ nocase
    not $file.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|msiexec|MoUsoCoreWorker|wuauclt|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1047")
    $primary_entity = array_distinct($file.principal.hostname)
    $mof_file_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
