/*
  MITRE Technique : T1027.018 - Invisible Unicode
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:08:11.043105+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/018
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_018_Invisible_Unicode_In_Outbound_URL {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP requests whose URL contains two or more consecutive percent-encoded invisible Unicode code points (zero-width, bidi control, word joiner, BOM, Hangul filler, variation selector, tag characters). This is the network-side trace of hidden content in phishing or script-delivery URLs. Consecutive runs are required, which excludes single emoji joiners and single variation selectors."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.018"
    mitre_technique_name = "Obfuscated Files or Information: Invisible Unicode"
    log_prerequisites = "Requires proxy or firewall HTTP logs with the full request URL (target.url) populated, normalised to NETWORK_HTTP. The URL must be logged in its raw percent-encoded form."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Web applications that embed zero-width characters in URL paths or queries for tracking or text formatting; non-Latin-script sites (Persian, Indic, Hangul) with consecutive joiners or non-joiners; URL shorteners or analytics redirectors; security-awareness or red-team phishing simulations."
    tuning_guidance = "Add known-good external destinations to %global_allowed_domains. If a proxy URL-decodes before logging, the percent-encoded pattern will not match and a raw-character variant is needed. To reduce noise, raise the {2,} repetition threshold to {3,}. Exclude authorised scanners by adding their source addresses to %global_allowed_scanners."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /(?i)(%E2%80%(8[B-F]|A[A-E])|%E2%81%(A[0-46-9])|%EF%BB%BF|%E3%85%A4|%EF%B8%8[0-9A-F]|%CD%8F|%F3%A0%[89AB][0-9A-F]%[89AB][0-9A-F]){2,}/
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.018")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
