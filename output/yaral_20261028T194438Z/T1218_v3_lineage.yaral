/*
  MITRE Technique : T1218 - System Binary Proxy Execution
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:40:34.511865+00:00
  Reference       : https://attack.mitre.org/techniques/T1218
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_Unexpected_Parent_Spawns_Proxy_Binary {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a signed Windows proxy-execution binary (rundll32, regsvr32, mshta, msbuild, installutil, regasm, regsvcs, cmstp, odbcconf and similar) launched by a parent that should never spawn one: an Office application, web server worker, database service or print spooler. This is a process-lineage detection that does not depend on command-line content. It covers renamed or obfuscated payloads that command-line rules miss."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218"
    mitre_technique_name = "System Binary Proxy Execution"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry (EDR or Sysmon Event ID 1) that populates both the parent and child process image paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office add-ins or document workflows that legitimately invoke rundll32 (e.g. print/preview handlers) or regsvr32 (COM registration during add-in install); web applications or IIS-hosted management tools that call msbuild or installutil during deployment; database installers or patching that run regsvr32 or regasm; print drivers installed via spoolsv that call rundll32; RMM or software deployment agents."
    tuning_guidance = "Add approved parent process paths to %global_allowed_admin_tools or %global_allowed_script_hosts. Add hosts that legitimately build or deploy software (e.g. build servers running msbuild under a web service) to %global_allowed_script_hosts. If rundll32 from spoolsv is noisy in a given environment, scope an exclusion to those hosts rather than removing it from the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat\d*|php-cgi|sqlservr|mysqld|postgres|oracle|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(rundll32|regsvr32|mshta|msbuild|installutil|regasm|regsvcs|cmstp|odbcconf|pcalua|forfiles|ieexec|syncappvpublishingserver)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
