/*
  MITRE Technique : T1025 - Data from Removable Media
  Tactic(s)       : Collection
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:47:14.372323+00:00
  Reference       : https://attack.mitre.org/techniques/T1025
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1025_Removable_Media_Enumeration_And_Collection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows shell or PowerShell command line that selects removable drives (DriveType 2, Removable volume or USB bus type) and in the same command lists, copies, searches or archives files. This is the direct behaviour of an adversary searching connected removable media for files of interest before exfiltration."
    mitre_tactic = "Collection"
    mitre_technique = "T1025"
    mitre_technique_name = "Data from Removable Media"
    log_prerequisites = "Requires EDR or Sysmon process creation telemetry with full command lines, or Windows Security Event 4688 with command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Endpoint DLP or device-control scripts, IT imaging and provisioning scripts, backup or data-migration scripts that target USB drives, and administrators or helpdesk staff copying files from a user's USB drive."
    tuning_guidance = "Add approved IT tooling parents to %global_allowed_admin_tools, backup and imaging software to %global_allowed_backup_processes, EDR and DLP agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. If a client runs scheduled USB-handling scripts, allowlist the script host through %global_allowed_script_hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd)\.exe$/ nocase
    $proc.target.process.command_line = /(drivetype\s*(=|==|-eq|-like)\s*['"]?(2|removable)\b|bustype\s*(=|==|-eq|-like)\s*['"]?usb)/ nocase
    $proc.target.process.command_line = /(copy-item|\bcopy\b|xcopy|robocopy|get-childitem|\bgci\b|\bdir\b|compress-archive|move-item|select-string|findstr)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1025")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
