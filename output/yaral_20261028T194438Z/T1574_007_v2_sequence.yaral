/*
  MITRE Technique : T1574.007 - Path Interception by PATH Environment Variable
  Tactic(s)       : Stealth, Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:34:04.181697+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_007_Linux_Writable_Dir_Binary_Shadow_Then_Exec {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a PATH-interception precursor on Linux. A file named after a common system command is created in a user-writable or hidden directory (/tmp, /var/tmp, /dev/shm, /run/user, hidden directories under /home), and the same file path is then executed on the same host within 10 minutes. Attackers use this to shadow legitimate binaries when a writable directory is placed ahead of /usr/bin in $PATH. The rule joins on host and exact file path, so it needs no command-line matching."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.007"
    mitre_technique_name = "Hijack Execution Flow: Path Interception by PATH Environment Variable"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that normalises file creation (FILE_CREATION) and process execution (PROCESS_LAUNCH) with full file paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers or build systems that compile or unpack tools named like system utilities (e.g. busybox-style wrappers, test fixtures for 'python3', 'git' or 'curl') in /tmp or hidden home directories; CI runners; package or container build jobs; software installers that stage binaries in /tmp before running them."
    tuning_guidance = "Add build, CI and deployment tooling to %global_allowed_admin_tools (matched against the creating and launching parent process paths). Add automation accounts to %global_allowed_service_accounts. Trim or extend the command-name alternation in the regex to match the environment. Exclude build hosts by adding their parent processes to %global_allowed_script_hosts."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/tmp|\/var\/tmp|\/dev\/shm|\/run\/user\/[0-9]+|\/home\/[^\/]+\/\.[^\/]+(\/[^\/]+)*)\/(ls|cat|ps|sudo|su|ssh|scp|curl|wget|grep|id|whoami|find|netstat|ss|systemctl|passwd|cp|mv|rm|tar|git|python3?|perl|bash|sh|apt|apt-get|yum|dnf|crontab|uname|hostname|ifconfig|ip)$/ nocase
    $file.target.file.full_path = $path
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = $path
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $host, $path over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1574.007")
    $primary_entity = array_distinct($host)
    $shadowed_binary_path = array_distinct($path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $launching_parent = array_distinct($proc.principal.process.file.full_path)
    $executing_user = array_distinct($proc.principal.user.userid)
    $exec_command_lines = array_distinct($proc.target.process.command_line)
    $launch_count = count($proc.metadata.id)

  condition:
    $file and $proc
}
