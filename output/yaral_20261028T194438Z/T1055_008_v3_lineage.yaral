/*
  MITRE Technique : T1055.008 - Ptrace System Calls
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:54:40.551337+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_008_Service_Parent_Spawns_Ptrace_Debugger {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing service or database daemon (web server, application server, PHP-FPM, database, print daemon) spawning a ptrace-capable debugger or tracer that attaches to an existing process by PID. Service processes have no legitimate reason to attach to other live processes, so this lineage points to ptrace-based injection or memory tampering after exploitation of the service."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.008"
    mitre_technique_name = "Process Injection: Ptrace System Calls"
    log_prerequisites = "Linux endpoint telemetry (EDR or auditd execve records) that populates parent process path, child process path and command line for process launches."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers or SREs debugging a service from a service-owned session, application performance monitoring agents that launch tracers from a service parent, crash-handling wrappers that launch gdb on a fault, and Java or Node applications that legitimately shell out to diagnostic tooling."
    tuning_guidance = "Add approved diagnostic wrappers and APM launchers to %global_allowed_admin_tools, and named engineers who debug production services to %global_allowed_admin_users. If the java or node parents are noisy in an environment, restrict the parent regex per client. Run in alert-only mode for a week on application servers to baseline."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|tomcat[0-9]*|java|node|mysqld|mariadbd|postgres|mongod|redis-server|cupsd)$/ nocase
    $proc.target.process.file.full_path = /\/(gdb|gdbserver|strace|ltrace)$/ nocase
    $proc.target.process.command_line = /(\s-p\s*[0-9]+|\s--pid[=\s]*[0-9]+|\s--attach|\sattach\s+[0-9]+)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.008")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
