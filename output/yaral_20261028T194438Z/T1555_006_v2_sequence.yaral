/*
  MITRE Technique : T1555.006 - Cloud Secrets Management Stores
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:01:04.790818+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_006_Secret_Policy_Change_Then_Secret_Retrieval {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A cloud identity changes the access policy or permissions on a secrets management store and then retrieves secret values within ten minutes. This pattern suggests an adversary with stolen cloud credentials is granting themselves access to a secret store before harvesting credentials."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.006"
    mitre_technique_name = "Credentials from Password Stores: Cloud Secrets Management Stores"
    log_prerequisites = "Requires cloud control-plane audit logs normalised to UDM, with data-plane secret access events enabled (for example data events for the secrets service, key vault diagnostic logs, or data access audit logs). metadata.product_event_type and principal.user.userid must be populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Infrastructure-as-code pipelines that update a secret's policy and then read it during deployment, platform engineers onboarding a new application to a secret store, break-glass administrators, and secret rotation automation running under a human-assumed role."
    tuning_guidance = "Add pipeline and automation identities to %global_allowed_service_accounts, trusted cloud service principals to %global_allowed_cloud_principals, and named administrators to %global_allowed_admin_users. If the policy-change event name is too broad in a given tenant, additionally constrain $perm.target.resource.name to the secret store naming convention."

  events:
    $perm.metadata.event_type = "RESOURCE_PERMISSIONS_CHANGE"
    $perm.metadata.product_event_type = /(PutResourcePolicy|secretmanager.*SetIamPolicy|KeyVault.*accessPolicies)/ nocase
    $perm.principal.user.userid != ""
    $perm.principal.user.userid = $user
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_cloud_principals
    not $perm.principal.user.userid in %global_allowed_admin_users

    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.metadata.product_event_type = /(GetSecretValue|BatchGetSecretValue|AccessSecretVersion|SecretGet|vaults\/secrets\/read)/ nocase
    $access.principal.user.userid = $user
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_cloud_principals
    not $access.principal.user.userid in %global_allowed_admin_users

    $perm.metadata.event_timestamp.seconds <= $access.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555.006")
    $primary_entity = array_distinct($user)
    $secret_access_count = count($access.metadata.id)
    $secret_resources = array_distinct($access.target.resource.name)
    $policy_actions = array_distinct($perm.metadata.product_event_type)
    $source_ips = array_distinct($access.principal.ip)

  condition:
    $perm and $access
}
