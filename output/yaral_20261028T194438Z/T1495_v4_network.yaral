/*
  MITRE Technique : T1495 - Firmware Corruption
  Tactic(s)       : Impact
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:48:36.583853+00:00
  Reference       : https://attack.mitre.org/techniques/T1495
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1495_Linux_Firmware_Image_Download_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux host fetching a firmware-style image (BIOS/UEFI/firmware/bootrom keywords combined with a flash-image file extension) from an external destination through a firewall or proxy. Staging a firmware image over the network is a precursor to overwriting or corrupting device firmware. The rule uses only network-observable fields (URL, destination host, source address) and no endpoint process fields."
    mitre_tactic = "Impact"
    mitre_technique = "T1495"
    mitre_technique_name = "Firmware Corruption"
    log_prerequisites = "Requires firewall or proxy logs normalised to UDM NETWORK_HTTP with target.url populated. TLS inspection or an explicit forward proxy is needed to see URLs for HTTPS traffic."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate vendor firmware, BIOS, or UEFI updates pulled by server or network engineering teams; Linux fleet firmware-update agents fetching from vendor mirrors not in the allowed domain list; lab or imaging hosts downloading appliance firmware; patch-management servers."
    tuning_guidance = "Add vendor and update CDN domains to %global_allowed_domains. Add approved patching and firmware-management source addresses to %global_allowed_mgmt_sources. If the proxy does not populate target.hostname, rely on target.url and extend the allowlist accordingly."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /(firmware|bios|uefi|bootrom|flash)/ nocase
    $net.target.url = /\.(rom|cap|fd|bin|img|trx|fw|bix)(\?.*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1495")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
