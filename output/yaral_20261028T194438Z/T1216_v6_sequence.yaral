/*
  MITRE Technique : T1216 - System Script Proxy Execution
  Tactic(s)       : Stealth
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:33:34.396181+00:00
  Reference       : https://attack.mitre.org/techniques/T1216
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1216_Signed_Script_Proxy_Then_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A Windows script host (wscript/cscript) runs a script from the protected System32/SysWOW64 directories with a remote script: moniker or remote URL/UNC argument, then the same host's script host process makes an outbound connection to a non-internal address. This pattern matches signed-script proxy execution, where a trusted Microsoft script is used to fetch and run attacker-controlled content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1216"
    mitre_technique_name = "System Script Proxy Execution"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with full command lines (EDR, Sysmon Event ID 1, or Security 4688 with command-line auditing) and network-connection telemetry attributed to the initiating process (e.g. Sysmon Event ID 3)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy logon or login scripts that run signed System32 scripts against remote shares, IT automation or RMM that uses cscript with remote arguments, and print-management scripts that legitimately reference remote print servers."
    tuning_guidance = "Add approved parent processes (software deployment, logon script launchers) to %global_allowed_script_hosts and approved automation accounts to %global_allowed_service_accounts. Add sanctioned external destinations to %global_allowed_domains. The 10m window and hostname join can be narrowed with additional process-level correlation if noisy."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(wscript|cscript)\.exe$/ nocase
    $proc.target.process.command_line = /\\windows\\(system32|syswow64)\\[^"]*\.(vbs|wsf|js)/ nocase
    $proc.target.process.command_line = /\bscript:\s*(https?:|\\\\)|\s(https?:\/\/|\\\\[a-z0-9])/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(wscript|cscript)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    $net.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1216")
    $primary_entity = array_distinct($hostname)
    $script_command_lines = array_distinct($proc.target.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $connection_count = count($net.metadata.id)

  condition:
    $proc and $net
}
