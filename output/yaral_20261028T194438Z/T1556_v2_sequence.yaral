/*
  MITRE Technique : T1556 - Modify Authentication Process
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:13:01.117537+00:00
  Reference       : https://attack.mitre.org/techniques/T1556
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_LSA_Auth_Package_Registry_After_DLL_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A DLL is written to the System32 directory and, within 10 minutes on the same host, the LSA Authentication Packages, Notification Packages or Security Packages registry value is modified. This pattern matches installation of a malicious password filter or authentication package that LSASS loads to capture credentials or bypass authentication."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556"
    mitre_technique_name = "Modify Authentication Process"
    log_prerequisites = "Requires EDR or Sysmon file creation and registry modification telemetry with the writing process populated in UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate installs of password policy or filter products (self-service password reset agents, password complexity enforcement, smart card or MFA credential providers), Windows servicing, and approved IT deployment tooling."
    tuning_guidance = "Add approved deployment and installer binaries to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. Confirm that any new DLL referenced by the registry change belongs to an approved authentication or password-filter product."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\windows\\system32\\[^\\]+\.dll$/ nocase
    not $file.principal.process.file.full_path = /\\(TiWorker|TrustedInstaller)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control\\Lsa$/ nocase
    $reg.target.registry.registry_value_name = /^(Notification Packages|Authentication Packages|Security Packages)$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1556")
    $primary_entity = array_distinct($reg.principal.hostname)
    $dropped_dlls = array_distinct($file.target.file.full_path)
    $dll_writer_processes = array_distinct($file.principal.process.file.full_path)
    $modified_values = array_distinct($reg.target.registry.registry_value_name)
    $registry_writer_processes = array_distinct($reg.principal.process.file.full_path)
    $acting_users = array_distinct($reg.principal.user.userid)

  condition:
    $file and $reg
}
