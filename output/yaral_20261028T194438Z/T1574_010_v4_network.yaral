/*
  MITRE Technique : T1574.010 - Services File Permissions Weakness
  Tactic(s)       : Stealth, Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:40:13.520762+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_010_SYSTEM_Service_From_Writable_Path_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Network-side detection of a hijacked service binary. A process running under a service identity (SYSTEM, LOCAL SERVICE or NETWORK SERVICE) from a user-writable location (user profile, ProgramData, Windows Temp, PerfLogs, Recycle Bin) opens a connection to an external address. Legitimate services rarely run from these paths, but an attacker who exploits weak service file or directory permissions to replace a service binary usually leaves it there and beacons out with elevated privileges."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.010"
    mitre_technique_name = "Hijack Execution Flow: Services File Permissions Weakness"
    log_prerequisites = "Requires EDR or Sysmon network telemetry (Sysmon Event ID 3 or equivalent) that populates principal.process.file.full_path, principal.user.userid and target.ip."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Third-party agents or line-of-business services installed under ProgramData or a user profile path, software installers or updaters running as SYSTEM from Windows\\Temp, RMM or backup agents that stage binaries in ProgramData, and security agents that run from ProgramData."
    tuning_guidance = "Add approved agent executables to %global_allowed_admin_tools or %global_allowed_security_tools, and known-good vendor destinations to %global_allowed_domains. If a service legitimately runs from ProgramData, allowlist it by executable name rather than by directory."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.user.userid = /^(nt authority\\)?(system|local service|network service)$/ nocase
    $net.principal.process.file.full_path = /\\(users\\|programdata\\|windows\\temp\\|perflogs\\|\$recycle\.bin\\)/ nocase
    $net.principal.process.file.full_path = /\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|MpCmdRun|NisSrv)\.exe$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1574.010")
    $primary_entity = array_distinct($net.principal.hostname)
    $service_binary = array_distinct($net.principal.process.file.full_path)
    $service_user = array_distinct($net.principal.user.userid)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
