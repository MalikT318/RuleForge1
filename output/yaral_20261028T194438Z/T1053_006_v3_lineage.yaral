/*
  MITRE Technique : T1053.006 - Systemd Timers
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:18:04.060963+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_006_Systemd_Timer_From_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, systemctl or systemd-run process referencing systemd timer or transient-timer activity when its parent is a network-facing service (web server, application server, database, print or file service). These parents should not manage systemd timers. This pattern indicates post-exploitation persistence through a systemd timer, typically after a web shell or service compromise."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.006"
    mitre_technique_name = "Scheduled Task/Job: Systemd Timers"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry that populates parent and child process paths and the child command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Application deployment or self-update hooks run by a web or application server, control-panel software (e.g. hosting panels) that manages timers, Java-based management agents, and database packages that run systemctl from maintainer scripts. Admin-launched restarts through application wrappers can also match."
    tuning_guidance = "Add legitimate parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts, and add known deployment or automation accounts to %global_allowed_service_accounts. Remove broad runtimes such as java or node from the parent regex if they are noisy for a client."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(httpd|apache2|nginx|lighttpd|php-fpm[0-9.]*|php[0-9.]*|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|smbd)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ash|ksh|systemctl|systemd-run)$/ nocase
    $proc.target.process.command_line = /(\.timer\b|systemd-run|systemctl|--on-(calendar|boot|active|startup|unit-active|unit-inactive)|OnCalendar|OnBootSec|OnUnitActiveSec)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1053.006")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
