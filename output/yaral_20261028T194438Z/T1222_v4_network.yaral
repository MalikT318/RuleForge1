/*
  MITRE Technique : T1222 - File and Directory Permissions Modification
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:16:30.769895+00:00
  Reference       : https://attack.mitre.org/techniques/T1222
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_Linux_Staging_Dir_Binary_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process executing from a world-writable staging directory (/tmp, /var/tmp, /dev/shm) that opens an outbound connection to a non-internal address. A binary dropped in these locations can only run after its permissions were changed to executable (chmod +x or equivalent, T1222), so this is the network-side result of that permission change. Typical cases are downloaded implants, miners and reverse shells. This is a proxy for T1222, not direct observation of the chmod call. Pair it with endpoint process telemetry for the chmod itself."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1222"
    mitre_technique_name = "File and Directory Permissions Modification"
    log_prerequisites = "Linux EDR or auditd-derived network telemetry that populates principal.process.file.full_path on NETWORK_CONNECTION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software installers or self-extracting updaters that run from /tmp and call out to vendor servers, CI/CD build agents that execute test binaries from /tmp, package managers using temporary scripts, and developer or admin tooling that is staged in /tmp."
    tuning_guidance = "Add approved tooling binaries to %global_allowed_admin_tools and EDR or agent binaries to %global_allowed_security_tools. Add known build or CI hosts to %global_allowed_script_hosts. Add vendor update domains to %global_allowed_domains if the telemetry carries a target hostname. Raise severity or add a count threshold if build servers are noisy."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    $net.target.ip != ""
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip = /^(127\.|169\.254\.|::1$)/
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1222")
    $primary_entity = array_distinct($net.principal.hostname)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $process_command_line = array_distinct($net.principal.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
