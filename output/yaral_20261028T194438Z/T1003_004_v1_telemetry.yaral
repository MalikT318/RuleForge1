/*
  MITRE Technique : T1003.004 - LSA Secrets
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:42:33.045590+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_004_LSA_Secrets_Hive_Export_File_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the file artifact left by an LSA secrets hive export. Either a file named like the SECURITY hive is created outside the native registry and backup locations, or the built-in registry utility writes a non-.reg file, which is the output of a hive save operation. Pivots on the resulting file creation rather than command-line telemetry."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.004"
    mitre_technique_name = "OS Credential Dumping: LSA Secrets"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon file create events) that populates the target file path and the creating process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and imaging software copying registry hives, administrators saving hives for offline troubleshooting or forensics, system migration and profile tools, and EDR or forensic collection agents."
    tuning_guidance = "Add approved backup, imaging and IT tooling process paths to %global_allowed_backup_processes and %global_allowed_admin_tools. Add EDR or forensic collectors to %global_allowed_security_tools. Extend the native-path exclusion if a client uses a custom registry backup location."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    (
      $file.target.file.full_path = /\\security(\.(hiv|hive|save|bak|dat|tmp|out|log))?$/ nocase
      or
      (
        $file.principal.process.file.full_path = /\\reg\.exe$/ nocase
        and not $file.target.file.full_path = /\.reg$/ nocase
      )
    )
    not $file.target.file.full_path = /\\windows\\(system32\\config|repair|servicing|winsxs)\\/ nocase
    not $file.target.file.full_path = /\\windows\.old\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1003.004")
    $primary_entity = array_distinct($file.principal.hostname)
    $dumped_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
