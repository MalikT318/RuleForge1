/*
  MITRE Technique : T1055.009 - Proc Memory
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:56:44.119515+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_009_Linux_Proc_Mem_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a write to /proc/<pid>/mem (or /proc/<pid>/task/<tid>/mem) on Linux. Writing to another process's memory file is the core mechanism of proc memory injection: the adversary reads /proc/<pid>/maps to locate the stack or gadgets, then overwrites that memory with a ROP payload, typically using dd. The rule keys on file-modification telemetry for the proc memory pseudo-file, so it fires whatever binary or interpreter performs the write and does not depend on command-line matching."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.009"
    mitre_technique_name = "Process Injection: Proc Memory"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry (for example, audit watch rules on /proc/*/mem or EDR file-modification events) normalised to UDM FILE_MODIFICATION with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Debuggers and tracers (gdb, strace-style tooling), live-patching and hot-fix agents, crash-dump and memory-forensics collectors, EDR/security agents, language runtimes or profilers that use /proc/<pid>/mem for self-inspection, and backup or checkpoint/restore tooling (for example CRIU)."
    tuning_guidance = "Add approved debuggers and patching agents to %global_allowed_admin_tools, EDR and forensic agents to %global_allowed_security_tools, checkpoint and backup tooling to %global_allowed_backup_processes, and automation accounts to %global_allowed_service_accounts. Where the sensor reports the writer PID, consider excluding self-writes (writer PID equals the /proc/<pid> in the path). Pair with alerting on preceding reads of /proc/<pid>/maps for higher fidelity."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/proc\/[0-9]+(\/task\/[0-9]+)?\/mem$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.009")
    $primary_entity = array_distinct($file.principal.hostname)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_command_line = array_distinct($file.principal.process.command_line)
    $target_proc_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
