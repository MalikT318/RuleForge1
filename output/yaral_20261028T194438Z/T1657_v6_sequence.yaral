/*
  MITRE Technique : T1657 - Financial Theft
  Tactic(s)       : Impact
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:01:30.929733+00:00
  Reference       : https://attack.mitre.org/techniques/T1657
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1657_Recovery_Inhibition_Then_Ransom_Note {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects a ransomware-style extortion sequence on one Windows host. Backup or recovery destruction commands (shadow copy deletion, backup catalog deletion, boot recovery disabled) are followed within 10 minutes by creation of a file whose name looks like a ransom or decryption note. Detects the behavioural result of extortion by ransomware, not a specific malware family."
    mitre_tactic = "Impact"
    mitre_technique = "T1657"
    mitre_technique_name = "Financial Theft"
    log_prerequisites = "Requires EDR or Sysmon process creation telemetry with command lines (Sysmon Event ID 1 or Windows Event 4688 with command-line auditing) and file creation telemetry (Sysmon Event ID 11 or EDR equivalent)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and imaging software that clears shadow copies or catalogs and then writes a restore or recovery report. Disaster-recovery testing, IT admins resetting boot configuration, and security tools writing quarantine or decryption-related text reports."
    tuning_guidance = "Add approved backup or imaging executables to %global_allowed_backup_processes and approved admin or deployment tooling to %global_allowed_admin_tools. Add EDR and AV agents that write remediation reports to %global_allowed_security_tools. If the note filename pattern is noisy for a client, require additional file extensions or add more specific terms."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(vssadmin|wmic|wbadmin|bcdedit)\.exe$/ nocase
    $proc.target.process.command_line = /(delete\s+shadows|shadowcopy\s+delete|delete\s+catalog|delete\s+systemstatebackup|recoveryenabled\s+no)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    $proc.principal.hostname = $hostname

    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\[^\\]*(decrypt|ransom|(recover|restore)[ _-]*(your|my)?[ _-]*files|how[ _-]*to[ _-]*(recover|restore|decrypt))[^\\]*\.(txt|hta|html?|rtf)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1657")
    $primary_entity = array_distinct($proc.principal.hostname)
    $recovery_commands = array_distinct($proc.target.process.command_line)
    $note_paths = array_distinct($file.target.file.full_path)
    $note_count = count($file.metadata.id)
    $affected_users = array_distinct($proc.principal.user.userid)

  condition:
    $proc and $file
}
