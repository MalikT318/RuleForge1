/*
  MITRE Technique : T1489 - Service Stop
  Tactic(s)       : Impact
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:38:39.973403+00:00
  Reference       : https://attack.mitre.org/techniques/T1489
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1489_ESXi_Login_Then_Service_Stop_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an interactive shell or SSH login to an ESXi host followed within ten minutes by a host configuration change that stops or disables a critical management or logging service (hostd, vpxa, vmsyslogd, ntpd, snmpd, sfcbd, slpd, lwsmd). This pattern precedes VM data destruction or encryption on hypervisors. It correlates authentication with a service-state setting change instead of matching process command lines."
    mitre_tactic = "Impact"
    mitre_technique = "T1489"
    mitre_technique_name = "Service Stop"
    log_prerequisites = "ESXi syslog (hostd, shell, vmkernel, auth) forwarded to Chronicle and parsed into UDM USER_LOGIN and SETTING_MODIFICATION events. Both event types must populate a hostname and metadata.description."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Planned maintenance windows where admins SSH in to restart hostd or vpxa; host patching and upgrade workflows; troubleshooting of management agents; monitoring agent reconfiguration that restarts snmpd or ntpd."
    tuning_guidance = "Add named administrators to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Narrow the service-name regex if a client routinely cycles a specific service. Suppress during approved change windows at the SOAR layer."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.metadata.description = /(ssh|shell)/ nocase
    $login.metadata.description = /(accepted|success|opened)/ nocase
    not $login.metadata.description = /(fail|invalid|denied|refused)/ nocase
    not $login.target.user.userid in %global_allowed_admin_users
    $login.target.hostname = $hostname

    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.description = /(hostd|vpxa|vmsyslogd|ntpd|snmpd|sfcbd|slpd|lwsmd)/ nocase
    $setting.metadata.description = /(stop|disable|policy.{0,20}off|uninstall)/ nocase
    not $setting.principal.user.userid in %global_allowed_service_accounts
    $setting.principal.hostname = $hostname

    $login.metadata.event_timestamp.seconds <= $setting.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1489")
    $primary_entity = array_distinct($hostname)
    $login_users = array_distinct($login.target.user.userid)
    $change_users = array_distinct($setting.principal.user.userid)
    $setting_events = count($setting.metadata.id)
    $first_login = min($login.metadata.event_timestamp.seconds)
    $last_change = max($setting.metadata.event_timestamp.seconds)

  condition:
    $login and $setting
}
