/*
  MITRE Technique : T1611 - Escape to Host
  Tactic(s)       : Privilege Escalation
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:32:34.352966+00:00
  Reference       : https://attack.mitre.org/techniques/T1611
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1611_ESXi_Host_Control_Command_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of hypervisor control-utility executions on a single ESXi host within ten minutes (VM process kills, power-off or unregister, kernel module loads, advanced setting changes, datastore manipulation). Any one command is routine administration. A high volume in a short window from the host shell indicates post-escape or hands-on-keyboard control of the hypervisor from a compromised guest, management session or stolen credentials."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1611"
    mitre_technique_name = "Escape to Host"
    log_prerequisites = "ESXi shell and hostd logging forwarded to Chronicle and parsed into UDM PROCESS_LAUNCH events with principal.hostname, principal.user.userid, target.process.file.full_path and target.process.command_line populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorised administrators performing maintenance (host evacuation, bulk VM power operations, patching, storage rescans), configuration management or automation scripts, backup and snapshot orchestration, and incident response activity."
    tuning_guidance = "Add approved automation parent processes to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and named administrators to %global_allowed_admin_users. Raise the threshold (#proc >= 8) on hosts with frequent bulk operations, or lower it for isolated hosts. Narrow the subcommand regex if a client scripts one of these routinely."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(esxcli|vim-cmd|vmkfstools|esxcfg-[a-z0-9]+|localcli)$/ nocase
    $proc.target.process.command_line = /(vm\s+process\s+kill|vmsvc\/(power\.(off|shutdown)|destroy|unregister)|system\s+module\s+(load|set)|system\s+settings\s+(advanced|kernel)\s+set|storage\s+(vmfs|filesystem)\s+(unmount|rescan)|vmkfstools\s+.*(-U|-i|-E)|network\s+firewall\s+(ruleset\s+set|unload)|system\s+(maintenanceMode|permission)\s+set)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1611")
    $primary_entity = array_distinct($host)
    $event_count = count($proc.metadata.id)
    $acting_users = array_distinct($proc.principal.user.userid)
    $observed_commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 6
}
