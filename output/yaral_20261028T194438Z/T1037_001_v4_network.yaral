/*
  MITRE Technique : T1037.001 - Logon Script (Windows)
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:20:11.899571+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_001_Logon_Script_Interpreter_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a scripting interpreter launched by userinit.exe at logon (the execution path for the HKCU\\Environment\\UserInitMprLogonScript logon script value) that makes an outbound connection to a non-internal address. Legitimate logon scripts mostly touch internal file shares, so external egress from this lineage suggests persistence-based payload retrieval or C2 beaconing."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.001"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Logon Script (Windows)"
    log_prerequisites = "Requires endpoint network telemetry that populates the parent process of the connecting process (principal.process.parent_process). Complements registry and process rules for the UserInitMprLogonScript value."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Corporate logon scripts that call cloud-hosted resources (SaaS drive mapping, software inventory or patch check-in, VPN or proxy auto-configuration scripts, license activation), and RMM or deployment tooling that uses userinit-launched scripts."
    tuning_guidance = "Add approved script-running hosts or parent processes to %global_allowed_script_hosts, approved tooling to %global_allowed_admin_tools, and known-good external destinations to %global_allowed_domains. Review the destination_ips and destination_ports outcome values before allowlisting. If the sensor does not populate parent_process on network events, pair this rule with the registry and process variants for this technique."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.parent_process.file.full_path = /\\userinit\.exe$/ nocase
    $net.principal.process.file.full_path = /\\(wscript|cscript|powershell|pwsh|cmd|mshta)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1037.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $user = array_distinct($net.principal.user.userid)
    $interpreter = array_distinct($net.principal.process.file.full_path)
    $interpreter_cmdline = array_distinct($net.principal.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
