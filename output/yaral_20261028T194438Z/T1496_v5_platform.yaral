/*
  MITRE Technique : T1496 - Resource Hijacking
  Tactic(s)       : Impact
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:50:48.177773+00:00
  Reference       : https://attack.mitre.org/techniques/T1496
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_Outbound_Mining_Pool_Port_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an outbound connection from an internal host to an external address on a TCP port conventionally used by cryptocurrency mining pool (stratum) services. This is network-observable evidence of resource hijacking from a Windows host behind the perimeter. The perimeter log does not record the OS or initiating process, so the rule identifies the source IP only. The 'alternate platform' angle was not applied because it conflicts with the mandatory Windows platform and firewall log source requirements, and a firewall log carries no cron, systemd, launchd or cloud audit fields."
    mitre_tactic = "Impact"
    mitre_technique = "T1496"
    mitre_technique_name = "Resource Hijacking"
    log_prerequisites = "Firewall, proxy or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated for allowed or established outbound sessions."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate services, games, or internal applications that use one of these ports; authorised security testing or red team exercises; developers or researchers working with mining software in a lab; vulnerability scanners probing common ports."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners. If a client has a legitimate service on one of these ports, remove that port from the condition for that tenant. Correlate hits with endpoint telemetry to confirm a mining process on the source host. Raise severity for hosts with repeated hits."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 3333 or
      $net.target.port = 14433 or
      $net.target.port = 14444 or
      $net.target.port = 45560 or
      $net.target.port = 45700
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1496")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
