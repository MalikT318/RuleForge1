/*
  MITRE Technique : T1547.009 - Shortcut Modification
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:35:59.704830+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_009_Startup_Folder_Process_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process that was launched from, or whose command line references, the Windows Startup folder and then makes an outbound connection to a non-internal address. Startup-folder shortcuts (.lnk) and payloads they point to run at logon, so the first outbound call from that process is the network-side sign of shortcut-based persistence (beaconing, payload staging, C2 check-in). This complements process-creation and command-line detections by observing the network consequence."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.009"
    mitre_technique_name = "Boot or Logon Autostart Execution: Shortcut Modification"
    log_prerequisites = "Requires Windows endpoint network telemetry that records the initiating process image path and command line (EDR network events or Sysmon Event ID 3) normalised to NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate per-user applications that autostart from the Startup folder and check for updates (chat clients, cloud-sync agents, VPN clients, vendor tray utilities); RMM agents installed through Startup shortcuts; admin logon scripts that call out to external sites."
    tuning_guidance = "Add approved autostart binaries to %global_allowed_admin_tools or %global_allowed_remote_mgmt, and security agents to %global_allowed_security_tools. Add approved script-launching parents to %global_allowed_script_hosts. Keep %rfc1918_internal current for each client's internal address space."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    (
      $net.principal.process.file.full_path = /\\Start Menu\\Programs\\Startup\\/ nocase or
      $net.principal.process.command_line = /\\Start Menu\\Programs\\Startup\\/ nocase
    )
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR)\.exe$/ nocase

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1547.009")
    $primary_entity = array_distinct($net.principal.hostname)
    $user = array_distinct($net.principal.user.userid)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $initiating_cmdline = array_distinct($net.principal.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
