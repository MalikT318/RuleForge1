/*
  MITRE Technique : T1027.012 - LNK Icon Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:58:00.542150+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_012_Explorer_Outbound_SMB_Icon_Fetch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects explorer.exe opening an outbound SMB/NetBIOS connection to an external (non-RFC1918) address. When a shortcut (.LNK) whose icon location points at a remote UNC path is rendered in a folder or on the desktop, Explorer fetches the icon over SMB. This leaks NTLM authentication and can pull attacker-hosted content, so it is a network-side result of LNK icon smuggling. It is not a command-line match. LNK icon smuggling is a Windows-only technique, so this rule stays on Windows and pivots from the process command line to the shell's network behaviour."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.012"
    mitre_technique_name = "Obfuscated Files or Information: LNK Icon Smuggling"
    log_prerequisites = "Requires Windows endpoint network telemetry with process attribution (EDR or Sysmon Event ID 3) populating principal.process.file.full_path, target.ip and target.port."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Users deliberately browsing to sanctioned cloud SMB shares (for example Azure Files over VPN or split tunnel), federated partner file shares, and misconfigured shortcuts pointing at legacy external file servers."
    tuning_guidance = "Add sanctioned external SMB server names to %global_allowed_domains. If the EDR does not resolve target.hostname for these flows, scope the exclusion by host or user via %global_allowed_service_accounts. Outbound 445/139 to the internet should be rare, so keep the rule broad otherwise."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\explorer\.exe$/ nocase
    ($net.target.port = 445 or $net.target.port = 139)
    not $net.target.ip in %rfc1918_internal
    not net.ip_in_range_cidr($net.target.ip, "127.0.0.0/8")
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.012")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $affected_users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
