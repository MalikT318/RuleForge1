/*
  MITRE Technique : T1546.012 - Image File Execution Options Injection
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:17:38.042267+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_012_IFEO_SilentProcessExit_Registry_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry-based IFEO persistence through the Silent Process Exit mechanism: a MonitorProcess value written under SilentProcessExit, or a GlobalFlag value written under an Image File Execution Options subkey (GFlags-style silent exit enablement). This is registry-telemetry coverage rather than process or command-line matching, so it catches changes made by API, script, or renamed tools. IFEO is a Windows-only mechanism, so this rule is written for Windows even though the requested angle was an alternate platform."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.012"
    mitre_technique_name = "Event Triggered Execution: Image File Execution Options Injection"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events 12/13) normalised to REGISTRY_MODIFICATION with registry key and value name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Application developers or QA staff enabling silent-exit monitoring or GFlags for debugging, crash-dump and diagnostics tooling (WER or Application Verifier), software deployment or RMM agents applying diagnostic configuration, and security agents configuring protected-process monitoring."
    tuning_guidance = "Add approved diagnostics or deployment tooling process names to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. Exclude developer or QA hosts by scoping the rule in the tenant. Review the value data in $monitor_value: a MonitorProcess pointing at a user-writable path, script host, or LOLBin is high confidence malicious."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      (
        $reg.target.registry.registry_key = /\\Microsoft\\Windows NT\\CurrentVersion\\SilentProcessExit\\[^\\]+/ nocase and
        $reg.target.registry.registry_value_name = /^MonitorProcess$/ nocase
      ) or
      (
        $reg.target.registry.registry_key = /\\Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options\\[^\\]+$/ nocase and
        $reg.target.registry.registry_value_name = /^GlobalFlag$/ nocase
      )
    )
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1546.012")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $modified_value_name = array_distinct($reg.target.registry.registry_value_name)
    $monitor_value = array_distinct($reg.target.registry.registry_value_data)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
