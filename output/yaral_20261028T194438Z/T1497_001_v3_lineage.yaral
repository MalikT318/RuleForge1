/*
  MITRE Technique : T1497.001 - System Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:01:51.276746+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_001_Unexpected_Parent_Spawns_VM_Sandbox_Check {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office application, browser-adjacent document reader, web or application server, database service, or print spooler spawning a shell, script interpreter, or WMI/registry utility whose command line queries hardware, BIOS, or registry artifacts for virtual machine or sandbox indicators. The unexpected parent-child lineage combined with VM-artifact enumeration indicates malware performing environment checks before deploying its payload."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1497.001"
    mitre_technique_name = "Virtualization/Sandbox Evasion: System Checks"
    log_prerequisites = "Requires Windows EDR process telemetry or Sysmon Event ID 1 / Security Event 4688 with command-line auditing enabled, normalised to UDM PROCESS_LAUNCH with parent process and command line populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Office macros or add-ins that inventory hardware for licensing or support tooling; web application admin or diagnostic pages that shell out to query system information; SQL Server maintenance jobs or agent steps running hardware inventory; software running on legitimately virtualised hosts that checks for hypervisor support; security assessment or sandbox-testing activity."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts and approved inventory or deployment tooling to %global_allowed_admin_tools. Extend the parent process regex with environment-specific line-of-business applications that should never spawn shells. If a client legitimately runs inventory scripts from a database or web service, exclude that specific parent path via the reference list rather than editing the regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|acrord32|acrobat|foxitreader|w3wp|httpd|nginx|tomcat\d*|php-cgi|sqlservr|mysqld|postgres|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|wmic|reg)\.exe$/ nocase
    $proc.target.process.command_line = /(win32_(computersystem|bios|baseboard|diskdrive|videocontroller|pnpentity|systemenclosure).*(vmware|virtualbox|vbox|qemu|xen|kvm|hyper-v|bochs|virtual)|msacpi_thermalzonetemperature|systembiosversion.*(vmware|virtualbox|vbox|qemu|xen|bochs|virtual)|(reg\s+query|get-itemproperty|get-childitem|get-item).*(vbox|vmware|vmci|vmhgfs|vmtools|qemu|virtualbox|vmmouse|vmusbmouse))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1497.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
