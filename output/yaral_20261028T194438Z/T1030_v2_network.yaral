/*
  MITRE Technique : T1030 - Data Transfer Size Limits
  Tactic(s)       : Exfiltration
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:51:30.437797+00:00
  Reference       : https://attack.mitre.org/techniques/T1030
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1030_ESXi_Outbound_Upload_Chunk_To_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a firewall-observed outbound connection from an ESXi host to an external address that carries a mid-sized, upload-only payload (roughly 512 KB to 10 MB sent, almost nothing returned). ESXi hosts rarely initiate internet connections beyond updates and NTP. A single connection of this shape is consistent with one fixed-size chunk of data being exfiltrated to stay under volume alerting thresholds. Repeated hits from the same host strengthen the signal."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1030"
    mitre_technique_name = "Data Transfer Size Limits"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.hostname, target.ip, target.port, network.sent_bytes and network.received_bytes populated. ESXi management interfaces must be identifiable by hostname in the perimeter logs (see tuning_guidance)."
    platform = "ESXi"
    log_source = "firewall"
    false_positives = "ESXi hosts uploading support bundles or logs to vendor support portals, hosts sending logs or backups to an external syslog, SIEM or cloud backup target, vCenter or cloud-connected license and telemetry services, host patch or VIB downloads that return little data, and hostnames that contain 'esx' but belong to non-ESXi systems."
    tuning_guidance = "Add known-good vendor, support and update domains to %global_allowed_domains. Hostname matching for ESXi (esx|vmhost) is a heuristic; adjust the regex per client naming convention, or replace it with an asset-based condition where asset labelling is available. Raise or lower the sent_bytes band to fit baseline egress from hypervisors. Because a single event cannot prove repetition, pair with a threshold or sequence variant that counts these hits per host."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname = /(esx|vmhost)/ nocase
    not $net.target.ip in %rfc1918_internal
    $net.network.sent_bytes >= 524288
    $net.network.sent_bytes <= 10485760
    $net.network.received_bytes < 4096
    $net.target.port != 53
    $net.target.port != 123
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1030")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
