/*
  MITRE Technique : T1546.016 - Installer Packages
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:21:56.496519+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_016_Linux_Package_Maintainer_Script_Tampering {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of an installed Debian-style package maintainer script (preinst, postinst, prerm, postrm, config) under /var/lib/dpkg/info/ by a process that is not a recognised package manager. Maintainer scripts run as root during package install, upgrade and removal, so tampering with them gives an adversary persistence and privilege escalation through the installer mechanism. This rule works at the file-artifact layer and does not depend on command-line logging."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.016"
    mitre_technique_name = "Event Triggered Execution: Installer Packages"
    log_prerequisites = "Requires Linux EDR file-event telemetry or auditd file-watch rules (for example -w /var/lib/dpkg/info -p wa) that populate target.file.full_path and principal.process.file.full_path for FILE_MODIFICATION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management agents patching maintainer scripts, administrators hand-editing a script to work around a broken package, distribution upgrade tooling not in the package-manager exclusion regex, image-build or container-build pipelines that rewrite dpkg metadata, and backup/restore jobs that restore /var/lib/dpkg."
    tuning_guidance = "Add approved configuration management or deployment binaries to %global_allowed_admin_tools. Add approved automation hosts to %global_allowed_script_hosts if they are the actor. Add backup agents to %global_allowed_backup_processes. Extend the package-manager executable-name regex if the distribution ships other legitimate package front-ends. Run in alert-only mode on golden-image build hosts first."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/var\/lib\/dpkg\/info\/[^\/]+\.(preinst|postinst|prerm|postrm|config)$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|dpkg-deb|dpkg-preconfigure|apt|apt-get|aptitude|apt\.systemd\.daily|unattended-upgrade|unattended-upgrades|packagekitd|snapd|dnf|yum|rpm|zypper)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1546.016")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_script = array_distinct($file.target.file.full_path)
    $actor_process = array_distinct($file.principal.process.file.full_path)
    $actor_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
