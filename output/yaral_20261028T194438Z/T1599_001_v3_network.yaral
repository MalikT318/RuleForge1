/*
  MITRE Technique : T1599.001 - Network Address Translation Traversal
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:02:04.655623+00:00
  Reference       : https://attack.mitre.org/techniques/T1599/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1599_001_External_To_Internal_Admin_Port_Via_NAT {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a connection from an external (non-internal) source to an internal-address host on a remote administration or lateral-movement port, as seen in perimeter flow or connection logs. Internal RFC1918 destinations are normally unreachable from the Internet unless a NAT or port-forward rule has been added on the border device. A new or modified NAT mapping that bridges untrusted and trusted networks therefore shows up as this traffic pattern."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1599.001"
    mitre_technique_name = "Network Boundary Bridging: Network Address Translation Traversal"
    log_prerequisites = "Requires firewall or perimeter connection logs that record the post-NAT (translated) destination address, normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimately published services such as a DMZ jump host, an approved VPN or bastion with a static port-forward, vulnerability scanners and penetration tests, and managed service provider remote access. Logging that records the pre-NAT destination as an internal address can also trigger the rule."
    tuning_guidance = "Add approved external administration sources to %global_allowed_mgmt_sources and authorised scanners to %global_allowed_scanners. Make sure %rfc1918_internal covers all internal address space for the client. If a port-forward is intentional, document it and exclude the source through the reference lists. Adjust the port set for the client's published services."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 445 or
      $net.target.port = 3389 or
      $net.target.port = 5900 or
      $net.target.port = 5985 or
      $net.target.port = 5986
    )
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1599.001")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
