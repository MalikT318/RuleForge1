/*
  MITRE Technique : T1036.006 - Space after Filename
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:06:42.331465+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_006_Linux_Trailing_Space_Binary_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux process whose executable path ends in one or more space characters (the T1036.006 'space after filename' masquerade) making an outbound network connection to a non-internal address. Legitimate Linux software almost never runs from, or beacons from, a binary whose filename ends in whitespace, so this catches the network-side result of the technique even if the launch command line was never inspected."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.006"
    mitre_technique_name = "Masquerading: Space after Filename"
    log_prerequisites = "Requires Linux EDR or auditd network telemetry (connect syscalls) normalised to NETWORK_CONNECTION with the originating process path populated in principal.process.file.full_path. The EDR or auditd pipeline must preserve trailing whitespace in process paths and not trim it during parsing."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Rare. Possible sources are user-created or mis-copied binaries or scripts with an accidental trailing space in the filename that make outbound connections, developer build or test artefacts, software deployed by an RMM or configuration management agent that generates oddly named files, and security agents that sandbox or detonate samples."
    tuning_guidance = "Add approved deployment, RMM or configuration management binaries to %global_allowed_admin_tools. Add security agents or sandboxing tools to %global_allowed_security_tools. Extend %rfc1918_internal if the client uses additional internal address space. Review the source process path and parent activity on the host, and check for a matching FILE_CREATION or FILE_MOVE event that created the trailing-space filename."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\/.*\S +$/
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1036.006")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process_path = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
