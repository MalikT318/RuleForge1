/*
  MITRE Technique : T1565.001 - Stored Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:38:57.261574+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_001_Linux_Database_Files_Modified_By_NonDB_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of on-disk database data files (MySQL/MariaDB, PostgreSQL, MongoDB, Redis, CouchDB data directories) by a process that is not the database engine, a backup tool or an approved admin tool. Direct writes to data files bypass the database engine's access controls, auditing and transaction logging, and indicate stored data manipulation. The rule works on the resulting file-modification artifact, not on command lines."
    mitre_tactic = "Impact"
    mitre_technique = "T1565.001"
    mitre_technique_name = "Data Manipulation: Stored Data Manipulation"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-write watches (-w on database data directories, -p wa) normalised to UDM FILE_MODIFICATION with principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package manager post-install or upgrade scripts, database upgrade and repair utilities (mysql_upgrade, pg_upgrade, myisamchk), snapshot or replication tooling not on the backup list, DBAs restoring data files by hand, and file-integrity or AV agents that touch files."
    tuning_guidance = "Add approved backup and snapshot binaries to %global_allowed_backup_processes. Add DBA tooling, upgrade helpers and config-management agents to %global_allowed_admin_tools. Add endpoint agents to %global_allowed_security_tools. Extend the data-directory regex for non-default data paths per client. If the telemetry does not populate principal.process.file.full_path, the rule will not fire, because an empty value is explicitly excluded."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/var\/lib\/(mysql|mariadb|pgsql|postgresql|mongodb|mongo|redis|couchdb)\// nocase
    not $file.target.file.full_path = /\.(log|pid|sock|lock|tmp|cnf)$/ nocase
    $file.principal.process.file.full_path != ""
    not $file.principal.process.file.full_path = /\/(mysqld|mysqld_safe|mariadbd|mariadbd-safe|postgres|postmaster|mongod|redis-server|redis-rdb-bgsave|couchdb|beam\.smp)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1565.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_files = array_distinct($file.target.file.full_path)
    $modifying_processes = array_distinct($file.principal.process.file.full_path)
    $modifying_users = array_distinct($file.principal.user.userid)

  condition:
    $file
}
