/*
  MITRE Technique : T1218.014 - MMC
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:01:02.989726+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_014_MMC_Anomalous_Process_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects anomalous process lineage around mmc.exe. Either mmc.exe spawns a shell, script interpreter or proxy-execution LOLBin, or mmc.exe is launched by an unexpected parent such as an Office application, browser, script host, web server, database service or print spooler. Both patterns indicate MMC being abused to proxy execution of malicious .msc consoles."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.014"
    mitre_technique_name = "System Binary Proxy Execution: MMC"
    log_prerequisites = "Requires Windows process launch telemetry with populated parent and child image paths (EDR, Sysmon Event ID 1, or Security Event 4688 with parent process logging)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators launching cmd or PowerShell from an MMC snap-in (for example Computer Management or Task Scheduler actions), management agents or RMM tooling that start mmc.exe from a service or script host, help-desk workflows that open .msc consoles from a browser or Office-based runbook, and database or web server maintenance scripts that open MMC consoles."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools and approved script or automation hosts to %global_allowed_script_hosts. If a client has benign admin workflows that spawn shells from MMC, restrict them by adding the parent path to the admin tools list rather than loosening the child regex. Review hits from named administrators first, as they are often benign. Consider also excluding accounts in %global_allowed_admin_users at the client level if noise persists."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $proc.principal.process.file.full_path = /\\mmc\.exe$/ nocase and
        $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|msbuild|installutil|wmic)\.exe$/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\\mmc\.exe$/ nocase and
        $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|onenote|acrord32|acrobat|wscript|cscript|mshta|powershell|pwsh|cmd|msedge|chrome|firefox|iexplore|w3wp|httpd|nginx|tomcat[0-9]*|java|sqlservr|spoolsv)\.exe$/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.014")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
