/*
  MITRE Technique : T1620 - Reflective Code Loading
  Tactic(s)       : Stealth
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:44:34.468389+00:00
  Reference       : https://attack.mitre.org/techniques/T1620
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1620_CLR_ETW_Disabled_Via_Environment_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of the .NET CLR ETW kill-switch environment variable (COMPlus_ETWEnabled / DOTNET_ETWEnabled) in a persistent Windows Environment registry key. Setting this variable blinds CLR runtime ETW telemetry, including Assembly.Load events, which is the visibility defenders rely on to see reflectively loaded .NET payloads. Detection is at the registry state-change layer, so it still fires if command-line logging is evaded or obfuscated."
    mitre_tactic = "Stealth"
    mitre_technique = "T1620"
    mitre_technique_name = "Reflective Code Loading"
    log_prerequisites = "Requires EDR or Sysmon registry value-set telemetry (Sysmon Event ID 13 equivalent) covering HKCU\\Environment, HKU\\<SID>\\Environment and HKLM Session Manager\\Environment, normalised to REGISTRY_MODIFICATION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developers or performance engineers deliberately disabling CLR ETW for profiling or troubleshooting; software installers or configuration management tooling that sets CLR environment variables; EDR or security agents managing CLR tracing."
    tuning_guidance = "Add approved deployment and configuration tooling to %global_allowed_admin_tools, add security agents to %global_allowed_security_tools, and add named admin accounts to %global_allowed_admin_users. Investigate any hit on a non-developer host, and look for follow-on in-memory .NET execution (powershell, wscript, or rundll32 hosting the CLR) on the same host."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Environment$/ nocase
    $reg.target.registry.registry_value_name = /^(complus|dotnet)_etwenabled$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1620")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
