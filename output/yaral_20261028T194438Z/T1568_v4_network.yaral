/*
  MITRE Technique : T1568 - Dynamic Resolution
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:03:27.905365+00:00
  Reference       : https://attack.mitre.org/techniques/T1568
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1568_ESXi_DGA_Like_DNS_Lookup {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi host resolving a domain whose second-level label looks algorithmically generated, either a very long alphanumeric label or a label with a long consonant-only run. Hypervisor hosts normally query a small, stable set of names (NTP, vCenter, update and depot services, internal infrastructure). Resolving random-looking names is characteristic of DGA-based dynamic resolution of command and control. Answers that resolve to internal address space are excluded, while NXDOMAIN responses stay in scope because DGA malware generates many unregistered names."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1568"
    mitre_technique_name = "Dynamic Resolution"
    log_prerequisites = "ESXi DNS resolution telemetry normalised to UDM NETWORK_DNS with principal.hostname, network.dns.questions.name and network.dns.answers.data populated, for example from a DNS-aware network sensor or resolver logs attributed to the host. Host syslog alone typically does not carry DNS queries."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Vendor or third-party update, telemetry and licensing services that use long hash-like or CDN-generated hostnames. Backup, replication and storage appliances reached by auto-generated names. Cloud-hosted management endpoints with randomised labels. Hosts with misconfigured search domains producing long concatenated names."
    tuning_guidance = "Add legitimate long-label external domains to %global_allowed_domains (the list matches the full queried name). Onboard approved update and depot endpoints there first. If a specific host class is noisy, raise the label-length threshold from 20 to 28 characters or the consonant run from 7 to 8. Pair with the endpoint-side rule to confirm which process on the host issued the query."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.principal.hostname != ""
    $dns.network.dns.questions.name = /^([a-z0-9-]+\.)*([a-z0-9]{20,}|[a-z0-9]*[bcdfghjklmnpqrstvwxz]{7,}[a-z0-9]*)\.[a-z]{2,24}\.?$/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.network.dns.answers.data in %rfc1918_internal

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1568")
    $primary_entity = array_distinct($dns.principal.hostname)
    $queried_domains = array_distinct($dns.network.dns.questions.name)
    $resolver_ips = array_distinct($dns.target.ip)

  condition:
    $dns
}
