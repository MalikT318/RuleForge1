/*
  MITRE Technique : T1055.005 - Thread Local Storage
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:52:33.026759+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_005_TLS_Callback_Injection_Open_Then_Inject {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A process running from a user-writable location opens a handle to a different process and then performs a cross-process injection into that same target on the same host within five minutes. This open-then-write-then-execute chain is the memory manipulation used by TLS callback injection to redirect a live process to attacker code before its legitimate entry point. It detects the injection behaviour and does not depend on command lines."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.005"
    mitre_technique_name = "Process Injection: Thread Local Storage"
    log_prerequisites = "Requires Windows endpoint telemetry that records process handle opens (PROCESS_OPEN) and cross-process injection (PROCESS_INJECTION), for example EDR sensors or Sysmon Event IDs 10 and 8."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters running from temp or ProgramData paths, game anti-cheat and overlay tools, accessibility and screen-reader software, application compatibility shims, and developer debuggers or profilers attaching to processes."
    tuning_guidance = "Add EDR/AV agents to %global_allowed_security_tools, imaging and backup agents to %global_allowed_backup_processes, and deployment or patching tooling to %global_allowed_admin_tools. If a specific update binary is noisy, add its full path to the matching list rather than widening the regex."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.process.file.full_path = /(?i)\\(users|programdata|temp|appdata|downloads|public)\\.*\.exe$/
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    $open.principal.hostname = $hostname
    $open.principal.process.file.full_path = $actor
    $open.target.process.file.full_path = $victim

    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.process.file.full_path = /(?i)\\(users|programdata|temp|appdata|downloads|public)\\.*\.exe$/
    $inj.principal.process.file.full_path != $inj.target.process.file.full_path
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    $inj.principal.hostname = $hostname
    $inj.principal.process.file.full_path = $actor
    $inj.target.process.file.full_path = $victim

    $open.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname, $actor, $victim over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.005")
    $primary_entity = array_distinct($hostname)
    $injecting_process = array_distinct($actor)
    $victim_process = array_distinct($victim)
    $injecting_user = array_distinct($inj.principal.user.userid)
    $open_count = count($open.metadata.id)
    $injection_count = count($inj.metadata.id)

  condition:
    $open and $inj
}
