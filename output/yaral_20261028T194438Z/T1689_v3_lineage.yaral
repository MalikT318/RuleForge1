/*
  MITRE Technique : T1689 - Downgrade Attack
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:37:15.456126+00:00
  Reference       : https://attack.mitre.org/techniques/T1689
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1689_Downgrade_PowerShell_V2_From_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects Windows PowerShell launched with the -Version 2 downgrade switch (or an abbreviation of it) by an unexpected parent process: an Office application, web server worker, print spooler, database service or script host. PowerShell 2.0 lacks Script Block Logging, AMSI and Constrained Language Mode support, so forcing it from an exploited or macro-driven parent is a strong defense-impairment signal."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1689"
    mitre_technique_name = "Downgrade Attack"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent and child image paths and full command lines (EDR, Sysmon Event ID 1 or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy line-of-business applications or compatibility tests that explicitly require PowerShell 2.0 and are launched by a database agent job, a web application, or an Office/VBA automation. Older SQL Agent or IIS-hosted admin scripts."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts and approved deployment or admin tooling to %global_allowed_admin_tools. Extend or narrow the parent process regex to match the client's server roles, for example removing sqlservr on hosts with legacy SQL Agent PowerShell jobs."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|onenote|visio|w3wp|httpd|nginx|tomcat\d*|php-cgi|spoolsv|sqlservr|sqlagent|mysqld|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\powershell\.exe$/ nocase
    $proc.target.process.command_line = /[\s\/\-]v(e(r(s(i(o(n)?)?)?)?)?)?[\s:=]+["']?2(\.0)?\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1689")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
