/*
  MITRE Technique : T1566.001 - Spearphishing Attachment
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:46:39.399393+00:00
  Reference       : https://attack.mitre.org/techniques/T1566/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1566_001_Linux_Proxy_DoubleExtension_Attachment_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux client fetching an external file whose URL path uses a document or image extension followed by an executable, script or archive extension (for example report.pdf.sh or invoice.docx.zip). This is a common social-engineering lure for spearphishing attachments and linked payload downloads. The rule observes the proxy or firewall side only and does not rely on endpoint process telemetry."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1566.001"
    mitre_technique_name = "Phishing: Spearphishing Attachment"
    log_prerequisites = "Requires firewall or web proxy logs with URL visibility (HTTP inspection or TLS decryption) normalised to NETWORK_HTTP, with target.url, network.http.method and network.http.user_agent populated."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Software mirrors or package repositories serving files with compound names, internal-style build artifacts hosted externally, document management or download portals that append archive extensions to exported files, and security awareness or phishing simulation platforms."
    tuning_guidance = "Add trusted vendor and update domains to %global_allowed_domains. Add authorised scanning or phishing-simulation sources to %global_allowed_scanners. If user-agent data is missing in a client's proxy logs, relax or remove the user-agent condition. Extend the extension lists to match local file-type policy."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.target.url = /\.(pdf|docx?|xlsx?|pptx?|rtf|odt|ods|txt|jpe?g|png|gif)\.(sh|bash|run|bin|elf|appimage|py|pl|jar|desktop|zip|iso|7z|rar|tar|gz)([?#]|$)/ nocase
    $net.network.http.user_agent = /(linux|x11|thunderbird|evolution|kmail|geary|curl|wget)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1566.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
