/*
  MITRE Technique : T1036.006 - Space after Filename
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:06:29.376415+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_006_Linux_Service_Parent_Spawns_Trailing_Space_Binary {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing or service parent process (web server, application server, database, print spooler, or cache/queue service) launching a child process whose executable path ends in a space or tab. A trailing space on a filename is used to disguise the true file type. This behaviour should not occur from service processes, and the lineage points to exploitation of the service or a web shell."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.006"
    mitre_technique_name = "Masquerading: Space after Filename"
    log_prerequisites = "Requires Linux EDR or auditd EXECVE/SYSCALL process telemetry that populates both the parent (principal.process.file.full_path) and child (target.process.file.full_path) executable paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Poorly written deployment or build scripts run by an application server that create files with accidental trailing whitespace; developer or test workloads on web or application servers; auditd records that pad the path field with trailing whitespace; Java-based CI/build agents running as a java parent."
    tuning_guidance = "Add legitimate parent executable paths to %global_allowed_script_hosts or %global_allowed_admin_tools. If the java or node parent is noisy in build environments, scope those hosts out through %global_allowed_script_hosts. Confirm that the sensor does not pad path fields with whitespace before deploying broadly."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|php-cgi|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|cups-browsed|smbd|vsftpd|proftpd)$/ nocase
    $proc.target.process.file.full_path = /\S[ \t]+$/
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1036.006")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
