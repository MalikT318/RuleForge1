/*
  MITRE Technique : T1528 - Steal Application Access Token
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:27:46.819325+00:00
  Reference       : https://attack.mitre.org/techniques/T1528
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1528_Cloud_Token_Issued_Then_Privilege_Change_From_New_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A cloud identity requests a temporary token, access key or impersonated credential, and within 10 minutes the same identity makes an IAM permission or policy change from a different source IP. This pattern indicates a stolen or newly minted application token being used from attacker infrastructure to escalate privileges."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1528"
    mitre_technique_name = "Steal Application Access Token"
    log_prerequisites = "Requires cloud control-plane audit logs (management or admin activity events) normalised to UDM, with principal.user.userid, principal.ip and metadata.product_event_type populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Administrators who obtain a session token on a laptop and then make IAM changes through a console, VPN or proxy with a different egress IP. CI/CD pipelines that assume roles and apply IAM changes from separate runners. Infrastructure-as-code tooling that applies policy changes through a different NAT gateway."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Add named administrators to %global_allowed_admin_users. Add known bastion, VPN and pipeline egress addresses to %global_allowed_mgmt_sources. Raise severity when the same user also appears in other credential-access alerts."

  events:
    $tok.metadata.event_type = "USER_RESOURCE_ACCESS"
    $tok.metadata.product_event_type = /(GetSessionToken|GetFederationToken|GetAccessToken|GenerateAccessToken|GenerateIdToken|CreateAccessKey)/ nocase
    $tok.principal.user.userid = $user
    not $tok.principal.user.userid in %global_allowed_service_accounts
    not $tok.principal.user.userid in %global_allowed_cloud_principals
    not $tok.principal.user.userid in %global_allowed_admin_users

    $use.metadata.event_type = "RESOURCE_PERMISSIONS_CHANGE"
    $use.metadata.product_event_type = /(AttachUserPolicy|AttachRolePolicy|PutUserPolicy|PutRolePolicy|CreatePolicyVersion|UpdateAssumeRolePolicy|SetIamPolicy|AddUserToGroup)/ nocase
    $use.principal.user.userid = $user
    not $use.principal.ip in %global_allowed_mgmt_sources

    $tok.principal.ip != $use.principal.ip
    $tok.metadata.event_timestamp.seconds <= $use.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1528")
    $primary_entity = array_distinct($user)
    $token_source_ips = array_distinct($tok.principal.ip)
    $change_source_ips = array_distinct($use.principal.ip)
    $token_apis = array_distinct($tok.metadata.product_event_type)
    $change_apis = array_distinct($use.metadata.product_event_type)
    $first_seen = min($tok.metadata.event_timestamp.seconds)
    $last_seen = max($use.metadata.event_timestamp.seconds)

  condition:
    $tok and $use
}
