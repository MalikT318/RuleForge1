/*
  MITRE Technique : T1556.001 - Domain Controller Authentication
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:15:29.459967+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_001_LSA_Protection_Disabled_On_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry change that sets the LSA protection value (RunAsPPL or RunAsPPLBoot) to 0 under the Lsa control key. Skeleton Key-style patching of LSASS on a domain controller needs LSASS to be unprotected. This rule uses registry telemetry rather than process command lines, so it adds coverage beyond command-line rules. T1556.001 is a Windows-only technique, so no Linux, macOS or cloud equivalent exists and the rule is written for Windows."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.001"
    mitre_technique_name = "Modify Authentication Process: Domain Controller Authentication"
    log_prerequisites = "Requires Windows registry modification telemetry (EDR or Sysmon event 13) that includes the registry value data, from domain controllers."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators deliberately turning off LSA protection for a legacy driver or authentication package, troubleshooting, or an image build. Security agent installers or uninstallers that change LSA settings. Group Policy or configuration-management rollbacks."
    tuning_guidance = "Add approved admin tooling or configuration-management binaries to %global_allowed_admin_tools, and named administrators to %global_allowed_admin_users. Add EDR or security agents that legitimately change LSA settings to %global_allowed_security_tools. Prioritise alerts from domain controllers by using asset context in the SOAR playbook, because a hardcoded DC naming convention would break multi-tenant portability."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control\\Lsa(\\|$)/ nocase
    (
      $reg.target.registry.registry_value_name = /^RunAsPPL(Boot)?$/ nocase or
      $reg.target.registry.registry_key = /\\RunAsPPL(Boot)?$/ nocase
    )
    $reg.target.registry.registry_value_data = /^(DWORD \(0x0+\)|0x0+|0)$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1556.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $modifying_user = array_distinct($reg.principal.user.userid)
    $registry_key = array_distinct($reg.target.registry.registry_key)

  condition:
    $reg
}
