/*
  MITRE Technique : T1542.005 - TFTP Boot
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:51:11.108532+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_005_Mgmt_Login_Then_Device_External_TFTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A network device receives an inbound management session (SSH or Telnet) from a source that is not an approved management source, then within ten minutes the same device initiates a TFTP transfer (port 69) to an external, non-allowlisted server. This pattern is consistent with an adversary reconfiguring the device to netboot an unauthorized OS image from a TFTP server."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.005"
    mitre_technique_name = "Pre-OS Boot: TFTP Boot"
    log_prerequisites = "Requires perimeter firewall connection or flow logs that see both management-plane traffic to the network device and traffic the device originates toward external networks. Source and destination IP and destination port must be populated in UDM."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorized firmware or image upgrades and configuration backups to an off-site or cloud-hosted TFTP server, engineers working from an unregistered jump host or VPN pool, and lab or staging devices that legitimately netboot."
    tuning_guidance = "Add jump hosts, bastion hosts, and management subnets to %global_allowed_mgmt_sources. That list also suppresses TFTP destinations, so add sanctioned external TFTP or image servers there. Use %global_allowed_scanners to exclude authorized scanners that probe management ports."

  events:
    $mgmt.metadata.event_type = "NETWORK_CONNECTION"
    ($mgmt.target.port = 22 or $mgmt.target.port = 23)
    $mgmt.target.ip = $device_ip
    not $mgmt.principal.ip in %global_allowed_mgmt_sources
    not $mgmt.principal.ip in %global_allowed_scanners

    $tftp.metadata.event_type = "NETWORK_CONNECTION"
    $tftp.target.port = 69
    $tftp.principal.ip = $device_ip
    not $tftp.target.ip in %rfc1918_internal
    not $tftp.target.ip in %global_allowed_mgmt_sources

    $mgmt.metadata.event_timestamp.seconds <= $tftp.metadata.event_timestamp.seconds

  match:
    $device_ip over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1542.005")
    $primary_entity = array_distinct($device_ip)
    $mgmt_sources = array_distinct($mgmt.principal.ip)
    $tftp_servers = array_distinct($tftp.target.ip)
    $tftp_event_count = count($tftp.metadata.id)

  condition:
    $mgmt and $tftp
}
