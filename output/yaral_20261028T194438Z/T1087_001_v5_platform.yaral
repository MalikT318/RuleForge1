/*
  MITRE Technique : T1087.001 - Local Account
  Tactic(s)       : Discovery
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:53:03.420837+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_001_Linux_Account_File_Read_From_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a process executing from a world-writable or volatile directory (/tmp, /var/tmp, /dev/shm, /run/user) reading local account databases (/etc/passwd, /etc/group, /etc/shadow, /etc/gshadow). This covers local account enumeration through file access rather than a command line, so it also catches enumeration by dropped binaries, scripts, or in-memory loaders that never run id, groups, or getent."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.001"
    mitre_technique_name = "Account Discovery: Local Account"
    log_prerequisites = "Requires Linux endpoint file-read telemetry from EDR or auditd with watch rules (-w /etc/passwd -p r, and likewise for /etc/group, /etc/shadow, /etc/gshadow) normalised to FILE_READ with the principal process path populated. Without read auditing on these files the rule will not fire."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Installers or package scripts that unpack and run helpers from /tmp, CI/CD runners and build agents working in /tmp or /var/tmp, configuration management agents running staged modules, self-extracting vendor installers, and containers that mount /tmp as their working directory."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools, %global_allowed_security_tools or %global_allowed_backup_processes (matched on the process path). Add automation accounts to %global_allowed_service_accounts. Add CI/CD and build hosts to %global_allowed_script_hosts. Narrow or extend the writable-directory regex to match the client's filesystem layout."

  events:
    $read.metadata.event_type = "FILE_READ"
    $read.target.file.full_path = /^\/etc\/(passwd|group|shadow|gshadow)$/ nocase
    $read.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/user\/[0-9]+)\// nocase
    not $read.principal.process.file.full_path in %global_allowed_admin_tools
    not $read.principal.process.file.full_path in %global_allowed_security_tools
    not $read.principal.process.file.full_path in %global_allowed_backup_processes
    not $read.principal.user.userid in %global_allowed_service_accounts
    not $read.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1087.001")
    $primary_entity = array_distinct($read.principal.hostname)
    $accessed_file = array_distinct($read.target.file.full_path)
    $reading_process = array_distinct($read.principal.process.file.full_path)
    $acting_user = array_distinct($read.principal.user.userid)

  condition:
    $read
}
