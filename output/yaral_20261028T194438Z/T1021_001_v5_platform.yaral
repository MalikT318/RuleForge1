/*
  MITRE Technique : T1021.001 - Remote Desktop Protocol
  Tactic(s)       : Lateral Movement
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:35:29.068297+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_001_RDP_Enabled_Via_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the registry change that enables inbound Remote Desktop (fDenyTSConnections set to 0) under the Terminal Server or Terminal Services policy keys. Adversaries enable RDP to prepare lateral movement with valid accounts. This is registry-based coverage that does not depend on process command lines, so it is additive to process-creation rules. The target platform is Windows, so the alternate-platform pivot was not applied."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.001"
    mitre_technique_name = "Remote Services: Remote Desktop Protocol"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon registry events) with registry key, value name and value data populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy or MDM enabling RDP for administration, golden-image and build pipelines, RMM or provisioning tooling, helpdesk staff enabling Remote Desktop on managed servers."
    tuning_guidance = "Add approved provisioning and configuration binaries to %global_allowed_admin_tools. Add approved RMM tooling to %global_allowed_remote_mgmt. Add named administrators to %global_allowed_admin_users. If your EDR does not populate registry_value_data, remove the value-data condition and expect extra hits when RDP is disabled."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(Control\\Terminal Server|Policies\\Microsoft\\Windows NT\\Terminal Services)$/ nocase
    $reg.target.registry.registry_value_name = "fDenyTSConnections" nocase
    $reg.target.registry.registry_value_data = /^(0|0x0{1,8}|DWORD \(0x0{8}\))$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1021.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $acting_user = array_distinct($reg.principal.user.userid)
    $acting_process = array_distinct($reg.principal.process.file.full_path)
    $registry_key = array_distinct($reg.target.registry.registry_key)

  condition:
    $reg
}
