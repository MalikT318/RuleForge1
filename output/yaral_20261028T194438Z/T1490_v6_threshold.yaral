/*
  MITRE Technique : T1490 - Inhibit System Recovery
  Tactic(s)       : Impact
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:41:47.349997+00:00
  Reference       : https://attack.mitre.org/techniques/T1490
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1490_Linux_Mass_HTTP_Delete_Backup_Snapshot_Endpoints {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single source (typically a Linux server or ESXi/container host) issues a high volume of HTTP DELETE requests to URLs that reference backups, snapshots, restore points, vaults or recovery objects within ten minutes. This is the network-observable result of an adversary purging cloud or object-storage backups and recovery points through REST APIs to inhibit recovery before data destruction or encryption. Uses perimeter or proxy telemetry only, so it is additive to process command-line detections."
    mitre_tactic = "Impact"
    mitre_technique = "T1490"
    mitre_technique_name = "Inhibit System Recovery"
    log_prerequisites = "Requires firewall or proxy logs with TLS inspection or explicit proxy visibility, normalised to UDM NETWORK_HTTP with network.http.method, target.url and principal.ip populated."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Backup lifecycle and retention jobs pruning expired snapshots, infrastructure-as-code teardown pipelines, CI/CD cleanup of ephemeral environments, storage administrators performing authorised bulk cleanup."
    tuning_guidance = "Add approved backup or orchestration destinations to %global_allowed_domains, approved automation accounts to %global_allowed_service_accounts, and approved admin or automation source addresses to %global_allowed_mgmt_sources. Raise the threshold (#net >= 20) for environments with heavy retention automation."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "DELETE" nocase
    $net.target.url = /(snapshot|backup|restore|recovery|vault|replica|archive)/ nocase
    $net.principal.ip = $src
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1490")
    $primary_entity = array_distinct($src)
    $delete_request_count = count($net.metadata.id)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $sample_urls = array_distinct($net.target.url)

  condition:
    #net >= 20
}
