/*
  MITRE Technique : T1505 - Server Software Component
  Tactic(s)       : Persistence
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:24:29.646971+00:00
  Reference       : https://attack.mitre.org/techniques/T1505
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_Linux_ServerDaemon_Spawns_Shell_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux web or application server daemon (Apache, nginx, PHP-FPM, lighttpd, uWSGI) spawning an interactive shell or script interpreter. This lineage is a strong indicator of a web shell or malicious server extension (module, plugin, script handler) executing commands through the server process. Detection is based on parent-child process lineage, not command-line content."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505"
    mitre_technique_name = "Server Software Component"
    log_prerequisites = "Requires Linux EDR or auditd (execve) telemetry normalised to UDM PROCESS_LAUNCH with populated parent (principal.process.file.full_path) and child (target.process.file.full_path) executable paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate CGI scripts or PHP code that calls system()/exec()/popen() (these run via sh -c); deployment, cache-warming or health-check hooks launched by the web server; web-based admin panels (e.g. hosting control panels, monitoring front-ends); log rotation or graceful-reload helpers invoked by the daemon; developer or staging servers."
    tuning_guidance = "Add approved parent daemon paths or hosts where CGI/shell invocation is expected (e.g. hosting platforms, dev/staging web servers) to %global_allowed_script_hosts. Add approved management binaries to %global_allowed_admin_tools. If the environment hosts additional server software (e.g. custom app servers), extend the parent regex accordingly."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|php-fpm[0-9.]*|php-cgi|lighttpd|uwsgi)$/ nocase
    $proc.target.process.file.full_path = /\/(bash|dash|sh|zsh|ksh|csh|tcsh|fish|perl|python[0-9.]*|ruby)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.hostname in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1505")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $running_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
