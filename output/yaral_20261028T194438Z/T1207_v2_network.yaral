/*
  MITRE Technique : T1207 - Rogue Domain Controller
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:14:27.060581+00:00
  Reference       : https://attack.mitre.org/techniques/T1207
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1207_Rogue_DC_AD_Replication_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects Active Directory RPC endpoint mapper (135) and LDAP/Global Catalog (389, 636, 3268, 3269) connections crossing the perimeter to non-internal addresses. DCShadow registers a rogue DC that must speak DRSUAPI replication (RPC over 135 plus dynamic ports) and LDAP. AD directory and replication protocols should never leave the internal address space, so egress on these ports from a source that is not an approved management or DC source indicates a rogue or externally hosted DC, or AD exposure."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1207"
    mitre_technique_name = "Rogue Domain Controller"
    log_prerequisites = "Requires firewall or perimeter NETWORK_CONNECTION events with principal.ip, target.ip and target.port populated, and traffic logging enabled for RPC and LDAP rules at the network edge or inter-zone boundary. Populate %global_allowed_mgmt_sources with legitimate DC and AD site-replication source addresses for each client."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate domain controllers replicating to remote or cloud-hosted DCs (for example, Azure-hosted DCs or DR sites reached through a public path), hybrid identity sync servers, third-party LDAP-based SaaS integrations on 389/636, and authorised AD migration or assessment tooling."
    tuning_guidance = "Add DC and replication partner source addresses to %global_allowed_mgmt_sources. Add authorised vulnerability scanner and assessment sources to the same list. If a client uses LDAPS to external SaaS, remove 636 and 3269 from the port set for that tenant. Raise severity when the source is a non-server asset."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 135 or
      $net.target.port = 389 or
      $net.target.port = 636 or
      $net.target.port = 3268 or
      $net.target.port = 3269
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1207")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_hostnames = array_distinct($net.principal.hostname)

  condition:
    $net
}
