/*
  MITRE Technique : T1531 - Account Access Removal
  Tactic(s)       : Impact
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:31:08.501732+00:00
  Reference       : https://attack.mitre.org/techniques/T1531
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1531_Linux_Scripted_Client_Account_Removal_API {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a scripted, non-browser HTTP client (curl, wget, python, Go and similar clients typical of Linux hosts) calling an external identity or account-management API to delete, deactivate, suspend, lock or reset credentials of a user account. This is the network-side signature of account access removal against SaaS or IaaS identity planes. It requires TLS-inspecting proxy or firewall HTTP telemetry. The destination is never hardcoded: the rule matches REST account-lifecycle URL patterns combined with an automation user agent."
    mitre_tactic = "Impact"
    mitre_technique = "T1531"
    mitre_technique_name = "Account Access Removal"
    log_prerequisites = "Requires firewall or proxy logs with TLS inspection that populate network.http.method, network.http.user_agent, target.url and target.ip as NETWORK_HTTP events. Without decrypted HTTP visibility the rule cannot evaluate."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Identity-lifecycle automation (joiner/mover/leaver scripts, SCIM provisioning jobs), HR-driven offboarding workflows, IT admins scripting user clean-up through curl or python, and IaC or CI jobs managing service-account lifecycle in SaaS or cloud IAM."
    tuning_guidance = "Add known provisioning and offboarding automation accounts to %global_allowed_service_accounts. Add trusted identity-provider and vendor API domains to %global_allowed_domains. Limit the scope to Linux server subnets via the log source's asset context if the firewall feed mixes client types. Raise severity for hosts that are not expected to administer identity systems."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /(curl|wget|python-requests|python-urllib|aiohttp|go-http-client|libwww-perl|okhttp|node-fetch|axios|ruby)/ nocase
    (
      (
        $net.network.http.method = "DELETE" nocase
        and $net.target.url = /\/(users?|accounts?|identities|members)\/[^\/?#]+\/?(\?.*)?$/ nocase
      )
      or
      (
        $net.network.http.method = /^(POST|PUT|PATCH)$/ nocase
        and $net.target.url = /\/(users?|accounts?)\/[^\/?#]+\/(lifecycle\/)?(deactivate|suspend|lock|disable|revoke|password|reset_password|credentials)\b/ nocase
      )
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1531")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $http_methods = array_distinct($net.network.http.method)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
