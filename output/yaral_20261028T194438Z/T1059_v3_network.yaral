/*
  MITRE Technique : T1059 - Command and Scripting Interpreter
  Tactic(s)       : Execution
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : IaaS
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:06:33.641349+00:00
  Reference       : https://attack.mitre.org/techniques/T1059
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_Interpreter_UserAgent_Script_Download_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an outbound HTTP request to an external destination in which a command-line or scripting interpreter user agent (curl, wget, Python, Perl, PowerShell) fetches a script-type resource. This is the network-side footprint of staging a script for execution on a cloud-hosted workload. It is observed at the perimeter without any endpoint process data."
    mitre_tactic = "Execution"
    mitre_technique = "T1059"
    mitre_technique_name = "Command and Scripting Interpreter"
    log_prerequisites = "Requires proxy or firewall web-inspection logs normalised to NETWORK_HTTP with network.http.user_agent and target.url populated, covering egress traffic from cloud (IaaS) workload subnets."
    platform = "IaaS"
    log_source = "firewall"
    false_positives = "Configuration management and bootstrap scripts (cloud-init, user-data, package or agent installers), CI/CD runners and build agents pulling scripts, admins downloading setup scripts, and monitoring agents that self-update."
    tuning_guidance = "Add known-good vendor and package domains to %global_allowed_domains. Add bootstrap, build and automation hosts to %global_allowed_script_hosts. If the proxy does not log the full URL path, confirm target.url is populated before deployment."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.network.http.user_agent = /^(curl|wget|python-requests|python-urllib|libwww-perl|windowspowershell|powershell)\b/ nocase
    $net.target.url = /\.(sh|bash|ps1|py|pl|rb|bat|vbs|js)(\?.*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1059")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
