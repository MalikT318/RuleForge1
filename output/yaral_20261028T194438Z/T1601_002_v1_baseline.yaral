/*
  MITRE Technique : T1601.002 - Downgrade System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:14:11.705753+00:00
  Reference       : https://attack.mitre.org/techniques/T1601/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_002_Network_Device_Image_Transfer_TFTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects TFTP (UDP/69) sessions seen at the network perimeter. TFTP is the standard way embedded network devices pull OS image files, so an unapproved session may be an adversary staging an older, weaker system image for a downgrade. The rule keys on the protocol and port, not on any image filename or vendor, so it still fires if the attacker renames the image or changes hosting. Sessions from approved provisioning or management sources are excluded."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1601.002"
    mitre_technique_name = "Modify System Image: Downgrade System Image"
    log_prerequisites = "Firewall or perimeter flow/connection logs that record UDP sessions with source, destination and destination port, including management-plane traffic from network devices. Management VLAN traffic must traverse a logging inspection point."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised firmware upgrades and rollbacks by network engineering, device provisioning and zero-touch staging, PXE or network boot servers, scheduled config backups that use TFTP, and lab or test networks."
    tuning_guidance = "Add approved TFTP/image repository addresses and provisioning sources to %global_allowed_mgmt_sources. Correlate hits with change-management windows. Consider raising severity when the source is a core router or firewall management address."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "UDP"
    $net.target.port = 69
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1601.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $source_hostnames = array_distinct($net.principal.hostname)

  condition:
    $net
}
