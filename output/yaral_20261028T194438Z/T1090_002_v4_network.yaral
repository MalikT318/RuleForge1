/*
  MITRE Technique : T1090.002 - External Proxy
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:29:13.286743+00:00
  Reference       : https://attack.mitre.org/techniques/T1090/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1090_002_Linux_Staged_Process_External_Proxy_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux process running from a world-writable staging directory (/tmp, /var/tmp, /dev/shm) that opens an outbound connection to a non-internal address on a port commonly used by SOCKS, HTTP proxy, or port-redirector services. This is the network-side signature of a dropped relay or port-forwarder tunnelling C2 traffic through an external proxy."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1090.002"
    mitre_technique_name = "Proxy: External Proxy"
    log_prerequisites = "Requires Linux endpoint network telemetry from EDR or auditd that normalises outbound connections to NETWORK_CONNECTION with the initiating process path populated (principal.process.file.full_path)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers or admins testing proxy-aware tools from /tmp, software installers or package self-tests that run from a temporary directory and fetch through a corporate or cloud proxy, CI/CD build agents using ephemeral work directories, and containers whose layers mount at /tmp or /dev/shm."
    tuning_guidance = "Add approved binaries to %global_allowed_admin_tools or %global_allowed_remote_mgmt, and EDR/agent binaries to %global_allowed_security_tools. If a client legitimately uses an egress proxy on one of these ports, exclude its address using a reference list or narrow the port set. CI/CD build hosts can be suppressed with a host-level exclusion at the tenant level."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/shm)\// nocase
    (
      $net.target.port = 1080 or
      $net.target.port = 3128 or
      $net.target.port = 3127 or
      $net.target.port = 8080 or
      $net.target.port = 8118 or
      $net.target.port = 8888 or
      $net.target.port = 9050 or
      $net.target.port = 9150
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1090.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_process = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
