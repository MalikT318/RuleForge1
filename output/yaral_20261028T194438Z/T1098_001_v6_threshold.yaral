/*
  MITRE Technique : T1098.001 - Additional Cloud Credentials
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:41:56.462346+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_001_Bulk_Credential_Additions_Per_Identity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single identity created or added several new credentials (access keys, client secrets, certificates, API keys or key pairs) within ten minutes. Each credential creation is usually routine, but a burst from one identity suggests an adversary seeding persistent backdoor credentials on accounts, applications or service principals."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.001"
    mitre_technique_name = "Account Manipulation: Additional Cloud Credentials"
    log_prerequisites = "Requires SaaS or cloud control-plane audit logs ingested and parsed to UDM RESOURCE_CREATION events, with metadata.product_event_type and principal.user.userid populated."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Identity or DevOps automation rotating secrets and keys, onboarding of many service accounts or applications, bulk credential rotation after an incident or audit, administrators provisioning credentials for a new project."
    tuning_guidance = "Add expected automation identities to %global_allowed_service_accounts, approved provisioning principals to %global_allowed_cloud_principals, and named administrators to %global_allowed_admin_users. Raise the #cred threshold for tenants with heavy automated rotation, or lower it to 2 for high-sensitivity tenants."

  events:
    $cred.metadata.event_type = "RESOURCE_CREATION"
    $cred.metadata.product_event_type = /(create|add|import|generate|upload|new).{0,40}(access.?key|credential|secret|key.?pair|api.?key|password|certificate|ssh.?key|app.?password)/ nocase
    $cred.principal.user.userid = $user
    not $cred.principal.user.userid in %global_allowed_service_accounts
    not $cred.principal.user.userid in %global_allowed_cloud_principals
    not $cred.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($cred.metadata.id)
    $mitre_technique_id = array_distinct("T1098.001")
    $primary_entity = array_distinct($user)
    $api_operations = array_distinct($cred.metadata.product_event_type)
    $target_resources = array_distinct($cred.target.resource.name)
    $source_ips = array_distinct($cred.principal.ip)

  condition:
    #cred >= 3
}
