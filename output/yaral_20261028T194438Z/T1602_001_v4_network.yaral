/*
  MITRE Technique : T1602.001 - SNMP (MIB Dump)
  Tactic(s)       : Collection
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:18:32.402209+00:00
  Reference       : https://attack.mitre.org/techniques/T1602/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_001_External_SNMP_Query_To_Device {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects SNMP (port 161) traffic from a non-internal source to a managed device, as seen at the network perimeter. SNMP should not be reachable from external address space. Such traffic usually means community-string guessing or an MIB dump to collect configuration, routing and interface data for network mapping."
    mitre_tactic = "Collection"
    mitre_technique = "T1602.001"
    mitre_technique_name = "Data from Configuration Repository: SNMP (MIB Dump)"
    log_prerequisites = "Requires firewall or perimeter connection logs with source IP and destination port populated (permitted and, ideally, denied traffic). The %rfc1918_internal list must be maintained for each client."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "External managed-service or NOC monitoring platforms polling devices over SNMP, third-party ISP or carrier monitoring of CPE devices, authorised external vulnerability scans, and cloud-hosted monitoring SaaS."
    tuning_guidance = "Add approved external monitoring and NOC source addresses to %global_allowed_mgmt_sources. Add authorised scanner addresses to %global_allowed_scanners. If the firewall logs only accepted traffic, expect fewer alerts. If denied traffic is also logged, consider raising severity only for permitted connections after confirming field coverage."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 161
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1602.001")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_hosts = array_distinct($net.target.hostname)

  condition:
    $net
}
