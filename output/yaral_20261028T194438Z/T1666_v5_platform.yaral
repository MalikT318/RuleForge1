/*
  MITRE Technique : T1666 - Modify Cloud Resource Hierarchy
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:07:11.301506+00:00
  Reference       : https://attack.mitre.org/techniques/T1666
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1666_Cloud_Org_Hierarchy_Detach_Or_Delete {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects control-plane API calls that sever, delete or cancel nodes of the cloud resource hierarchy (organization membership, organizational units, folders, projects, management groups, subscriptions). Adversaries use these calls to detach an account from central guardrails, logging and policy inheritance, or to hide resources from the victim organization."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1666"
    mitre_technique_name = "Modify Cloud Resource Hierarchy"
    log_prerequisites = "Requires cloud provider management-plane audit logs ingested and parsed to UDM, with the API/operation name populated in metadata.product_event_type and the caller in principal.user.userid. Organization-level or tenant-level audit trails must be enabled; account-level trails alone may miss hierarchy events."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Planned account decommissioning or merger/divestiture projects, cloud landing-zone automation that rebuilds organizational units or folders, project cleanup jobs, and sandbox or ephemeral project lifecycle tooling."
    tuning_guidance = "Add landing-zone and account-vending automation identities to %global_allowed_cloud_principals and named cloud administrators who run approved restructuring to %global_allowed_admin_users. If the parser maps these API calls to a different event type in a client tenant, clone the rule and adjust metadata.event_type for that tenant. Hierarchy deletions are rare, so tune by principal rather than by narrowing the API list."

  events:
    $cloud.metadata.event_type = "RESOURCE_DELETION"
    $cloud.metadata.product_event_type = /^(LeaveOrganization|RemoveAccountFromOrganization|DeleteOrganizationalUnit|DeleteOrganization|DeleteFolder|DeleteProject|.*managementGroups\/delete|.*subscriptions?\/cancel.*)$/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1666")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_call = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)
    $affected_resource = array_distinct($cloud.target.resource.name)

  condition:
    $cloud
}
