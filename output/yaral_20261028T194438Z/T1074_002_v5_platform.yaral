/*
  MITRE Technique : T1074.002 - Remote Data Staging
  Tactic(s)       : Collection
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:20:44.636757+00:00
  Reference       : https://attack.mitre.org/techniques/T1074/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_002_Large_Internal_SMB_Push_Staging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a single large outbound SMB flow from one internal host to another internal host. This is consistent with data being pushed to a remote file share used as a central staging location before exfiltration. Detection relies only on network-observable behaviour (internal-to-internal, SMB port, high transferred volume). No endpoint process fields are used."
    mitre_tactic = "Collection"
    mitre_technique = "T1074.002"
    mitre_technique_name = "Data Staged: Remote Data Staging"
    log_prerequisites = "Firewall or perimeter/internal-segmentation flow logs that record internal east-west SMB traffic and populate network.sent_bytes. If east-west traffic does not traverse a logging firewall, this rule will not fire."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Backup and imaging jobs writing to file servers, file server migrations, DFS replication, software distribution points, user profile or home-drive redirection sync, and scheduled large file copies by IT staff."
    tuning_guidance = "Add approved backup, migration and management source addresses to %global_allowed_mgmt_sources or %global_allowed_scanners. Adjust the sent_bytes threshold (default about 500 MB) per client based on normal file server traffic. Consider raising it for clients with large file-share workloads."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    $net.target.port = 445
    $net.network.sent_bytes > 524288000
    $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1074.002")
    $primary_entity = array_distinct($net.principal.ip)
    $staging_target_ips = array_distinct($net.target.ip)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
