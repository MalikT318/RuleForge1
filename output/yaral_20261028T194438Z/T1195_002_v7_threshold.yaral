/*
  MITRE Technique : T1195.002 - Compromise Software Supply Chain
  Tactic(s)       : Initial Access
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:43:34.177505+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_002_Windows_Repeated_Update_Binary_Downloads_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single Windows host downloaded several executable or installer payloads over HTTP from external, non-allowlisted destinations using update-style URL paths within 10 minutes. This can indicate a trojanized update or distribution mechanism delivering follow-on payloads. One update download is normal, but repeated binary pulls from unvetted sources are not."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.002"
    mitre_technique_name = "Supply Chain Compromise: Compromise Software Supply Chain"
    log_prerequisites = "Requires firewall or web proxy logs normalised to UDM NETWORK_HTTP with principal.hostname, target.url, target.hostname, network.http.user_agent and target.ip populated. TLS inspection is needed to see URL paths for HTTPS traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Third-party software updaters that fetch several installer packages in one run, patch management and deployment tools pulling from vendor CDNs, developer workstations downloading toolchain packages, and new-device provisioning or imaging."
    tuning_guidance = "Add vendor and update CDN domains to %global_allowed_domains. Raise the #net threshold for software distribution hosts, or lower it in high-security segments. Review the destination_hosts and download_urls outcome values to confirm whether the sources are sanctioned."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.principal.hostname = $host
    $net.network.http.user_agent = /(Windows NT|WinHTTP|WinINet)/ nocase
    $net.target.url = /\/[^\/?]*(update|upgrade|updater|patch|setup|install|latest|release)[^\/?]*\.(exe|msi|dll|msu|cab|zip)(\?|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  match:
    $host over 10m

  outcome:
    $risk_score = max(55)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1195.002")
    $primary_entity = array_distinct($host)
    $destination_hosts = array_distinct($net.target.hostname)
    $download_urls = array_distinct($net.target.url)

  condition:
    #net >= 5
}
