/*
  MITRE Technique : T1217 - Browser Information Discovery
  Tactic(s)       : Discovery
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:38:38.445312+00:00
  Reference       : https://attack.mitre.org/techniques/T1217
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1217_Linux_Service_Parent_Spawns_Interpreter_Browser_Data {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server or database service process spawning a shell or script interpreter whose command line references browser profile or credential-store locations. Server-side service processes have no legitimate reason to enumerate user browser data, so this lineage points to a web shell, injected code or exploited service doing browser information discovery."
    mitre_tactic = "Discovery"
    mitre_technique = "T1217"
    mitre_technique_name = "Browser Information Discovery"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry that populates both parent (principal.process) and child (target.process) image paths and the child command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Headless-browser automation or screenshot and PDF rendering services launched from a web application, CI or test runners started by an application server, admin-initiated maintenance scripts run under a service parent, and backup or migration scripts that copy user home directories."
    tuning_guidance = "Add legitimate parent binaries (headless-browser wrappers, deployment agents) to %global_allowed_script_hosts or %global_allowed_admin_tools. Extend the parent regex with site-specific service daemons if needed. Review the process command line and parent hostname before tuning out any web-server parent."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|uwsgi|gunicorn|tomcat[0-9]*|mysqld|mariadbd|postgres|mongod|redis-server)$/ nocase
    $proc.target.process.file.full_path = /\/(bash|dash|sh|zsh|ksh|csh|tcsh|fish|python[0-9.]*|perl|ruby|php[0-9.]*)$/ nocase
    $proc.target.process.command_line = /(\.mozilla\/|\.config\/(google-chrome|chromium|BraveSoftware|microsoft-edge|opera|vivaldi)|\/snap\/(firefox|chromium)\/|places\.sqlite|cookies\.sqlite|logins\.json|key4\.db|Login Data)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1217")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
