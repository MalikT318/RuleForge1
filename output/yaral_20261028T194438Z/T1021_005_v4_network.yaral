/*
  MITRE Technique : T1021.005 - VNC
  Tactic(s)       : Lateral Movement
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:42:16.914244+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_005_VNC_Port_Traffic_Across_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects firewall-observed connections on the standard VNC/RFB port range (TCP 5900-5909) that cross the network perimeter, meaning the destination is outside internal address space. Outbound VNC from a Windows estate to an external host indicates remote-control tooling or a reverse VNC session. This is a network-side detection that complements endpoint process and command-line rules and does not depend on the VNC binary name."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.005"
    mitre_technique_name = "Remote Services: VNC"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with target.ip, target.port and principal.ip populated. The %rfc1918_internal reference list must be populated for the tenant."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Sanctioned remote-support or vendor-managed VNC sessions to external hosts, cloud-hosted lab or jump systems that use VNC, and internet-facing scanners or research crawlers probing 5900-series ports on exposed assets."
    tuning_guidance = "Add approved source addresses (jump hosts, support gateways) to %global_allowed_mgmt_sources. Keep %rfc1918_internal current for each tenant so internal traffic stays excluded. If a client legitimately uses an external VNC service, scope that exception by source address rather than widening the port range."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port >= 5900
    $net.target.port <= 5909
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1021.005")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
