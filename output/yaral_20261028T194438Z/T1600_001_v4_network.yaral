/*
  MITRE Technique : T1600.001 - Reduce Key Space
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:07:00.054939+00:00
  Reference       : https://attack.mitre.org/techniques/T1600/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_001_Weak_Cipher_Negotiated_External_Session {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a perimeter-observed connection to an external destination that negotiated an export-grade, NULL, anonymous or otherwise key-space-reduced TLS cipher suite. This is the network-side result of a device or service having its encryption strength reduced, which makes traffic far easier to decrypt."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1600.001"
    mitre_technique_name = "Weaken Encryption: Reduce Key Space"
    log_prerequisites = "Firewall or proxy logs that record the negotiated TLS cipher suite (network.tls.cipher). Typically requires TLS inspection or a TLS-aware log profile, and UDM parsing that populates network.tls.cipher."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legacy applications, appliances or partner systems that still negotiate obsolete ciphers; authorised vulnerability scanners and security testing; misconfigured but benign third-party servers; lab and test networks."
    tuning_guidance = "Add authorised scanning sources to %global_allowed_scanners and known-good vendor or partner destinations to %global_allowed_domains. If legacy 3DES or RC4 usage is a known issue for a client, narrow the cipher regex to the export, NULL and anonymous suites. Confirm network.tls.cipher is populated for the client's firewall parser before deploying."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.tls.cipher = /(export|_null_|null-|_null$|rc4|rc2|des40|(^|[_-])3?des([_-]|$)|anon|adh)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1600.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $negotiated_ciphers = array_distinct($net.network.tls.cipher)

  condition:
    $net
}
