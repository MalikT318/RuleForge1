/*
  MITRE Technique : T1106 - Native API
  Tactic(s)       : Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:01:06.113193+00:00
  Reference       : https://attack.mitre.org/techniques/T1106
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1106_Native_API_Untrusted_Path_Process_Handle_To_Core_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process running from a user-writable location (AppData, Temp, Downloads, Desktop, Users\\Public) opening a handle to a core Windows process such as explorer, svchost, winlogon or spoolsv. Native API calls (NtOpenProcess/OpenProcess) are the precursor to injection, memory writes and remote thread creation. The rule detects the resulting handle request, not the command line, so it still fires if the attacker renames the binary or uses direct syscalls."
    mitre_tactic = "Execution"
    mitre_technique = "T1106"
    mitre_technique_name = "Native API"
    log_prerequisites = "Requires EDR or Sysmon-equivalent process access telemetry (Sysmon Event ID 10 or equivalent) normalised to PROCESS_OPEN, with principal and target process paths populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Self-updating user-profile applications (collaboration clients, browsers, cloud sync agents) that touch shell processes; developer tools and debuggers running from user directories; accessibility or screen-capture utilities installed per user; unlisted EDR/AV components."
    tuning_guidance = "Add approved agents to %global_allowed_security_tools, IT tooling to %global_allowed_admin_tools and imaging/backup software to %global_allowed_backup_processes. Extend the target process regex only if a client wants wider coverage. Review frequent legitimate per-user updaters by executable name and allowlist them."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.process.file.full_path = /^[a-z]:\\users\\([^\\]+\\(appdata|downloads|desktop)\\|public\\)|\\windows\\temp\\/ nocase
    $open.target.process.file.full_path = /\\(explorer|svchost|winlogon|spoolsv|services|dllhost|taskhostw|runtimebroker)\.exe$/ nocase
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    not $open.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|SenseCncProxy)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1106")
    $primary_entity = array_distinct($open.principal.hostname)
    $source_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $acting_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
