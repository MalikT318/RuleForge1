/*
  MITRE Technique : T1055.011 - Extra Window Memory Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:57:12.610417+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_011_Explorer_Handle_From_UserWritable_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process running from a user-writable location (profile, AppData, Temp, Downloads, ProgramData, Public, recycle bin) opening a handle to the Windows shell process (explorer). Explorer hosts the Shell_TrayWnd window class, which is the classic Extra Window Memory injection target. The EWM write and the SetWindowLong call have no direct telemetry, so the rule detects the process-handle request that precedes them. Detection is on the handle-open state change, not command-line content."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.011"
    mitre_technique_name = "Process Injection: Extra Window Memory Injection"
    log_prerequisites = "Requires endpoint telemetry that records process handle access (Sysmon Event ID 10 or an EDR equivalent) normalised to UDM PROCESS_OPEN, with principal.process.file.full_path and target.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-user installed software that interacts with the shell (some updaters, screen-capture or screen-recording tools, accessibility and overlay utilities, per-user VPN or productivity clients), software installers or uninstallers run from Temp or Downloads, and EDR/AV agents that scan from ProgramData."
    tuning_guidance = "Add security agents to %global_allowed_security_tools, imaging or backup tools to %global_allowed_backup_processes, and approved IT tooling to %global_allowed_admin_tools. Most FPs come from a small number of per-user applications, so tune by process name. If the access-mask field is reliably normalised for your tenant, add a filter for write/operation access rights (VM_WRITE, VM_OPERATION) to reduce noise. Consider widening the target regex to other GUI shell hosts only after baselining."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\explorer\.exe$/ nocase
    $open.principal.process.file.full_path = /(\\users\\[^\\]+\\|\\programdata\\|\\windows\\temp\\|\\users\\public\\|\\\$recycle\.bin\\|\\perflogs\\)/ nocase
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    not $open.principal.process.file.full_path = /\\explorer\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1055.011")
    $primary_entity = array_distinct($open.principal.hostname)
    $source_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $acting_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
