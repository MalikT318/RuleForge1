/*
  MITRE Technique : T1213.001 - Confluence
  Tactic(s)       : Collection
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:24:21.859291+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_001_Confluence_Bulk_Page_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single user accesses an unusually high number of Confluence wiki pages or spaces within ten minutes. Each page view is benign on its own, but bulk reading is consistent with an adversary using a compromised account to mine internal documentation, credentials, architecture diagrams and links to internal resources."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.001"
    mitre_technique_name = "Data from Information Repositories: Confluence"
    log_prerequisites = "Requires collaboration-platform audit logs, ingested into Chronicle and normalised to USER_RESOURCE_ACCESS. Events must populate principal.user.userid and either target.url or target.application."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Content migration or wiki restructuring by documentation owners, search indexers and sync or backup integrations using named accounts, new-hire onboarding reading, incident responders reviewing runbooks, and automated link-checkers or documentation crawlers."
    tuning_guidance = "Add automation and integration accounts to %global_allowed_service_accounts and documentation or wiki administrators to %global_allowed_admin_users. Raise or lower the #access threshold per client based on baseline page-view volume. Follow up on hits where the same user also shows new source IPs or an anomalous login."

  events:
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.principal.user.userid = $user
    $access.principal.user.userid != ""
    (
      $access.target.application = /confluence/ nocase or
      $access.target.url = /\/(wiki|display|pages\/viewpage\.action|spaces)\// nocase
    )
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1213.001")
    $primary_entity = array_distinct($user)
    $access_count = count($access.metadata.id)
    $accessed_urls = array_distinct($access.target.url)
    $source_ips = array_distinct($access.principal.ip)

  condition:
    #access >= 50
}
