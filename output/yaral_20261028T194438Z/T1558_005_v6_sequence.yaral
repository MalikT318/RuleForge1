/*
  MITRE Technique : T1558.005 - Ccache Files
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:48:54.311065+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_005_Ccache_Copied_Then_Reused_Via_KRB5CCNAME {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Kerberos credential cache (ccache) file being copied, archived, or staged by a generic file or transfer utility, followed within 10 minutes by a process on the same host that points KRB5CCNAME at a ccache file in a user-writable location. This sequence is consistent with ticket theft followed by pass-the-ticket reuse."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.005"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Ccache Files"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to UDM PROCESS_LAUNCH, with full command lines populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators backing up or migrating Kerberos caches, SSSD or Kerberos troubleshooting, automation that copies ccache files to batch or job hosts, and developers testing Kerberos authentication with a custom KRB5CCNAME."
    tuning_guidance = "Add approved admin and deployment tooling to %global_allowed_admin_tools, backup software to %global_allowed_backup_processes, and Kerberos-aware automation accounts to %global_allowed_service_accounts. Add trusted wrapper processes to %global_allowed_script_hosts. If a host legitimately copies ccache files, scope the exclusion by process rather than by directory."

  events:
    $copy.metadata.event_type = "PROCESS_LAUNCH"
    $copy.target.process.file.full_path = /\/(cp|cat|tar|base64|scp|rsync|xxd|dd|zip|curl|wget|nc|ncat|socat|mv)$/ nocase
    $copy.target.process.command_line = /(krb5cc_[0-9A-Za-z_]+|krb5\.ccache|\/krb5cc)/ nocase
    not $copy.principal.process.file.full_path in %global_allowed_admin_tools
    not $copy.principal.process.file.full_path in %global_allowed_backup_processes
    not $copy.principal.user.userid in %global_allowed_service_accounts
    $copy.principal.hostname = $hostname

    $use.metadata.event_type = "PROCESS_LAUNCH"
    $use.target.process.command_line = /KRB5CCNAME=(FILE:)?\/(tmp|var\/tmp|dev\/shm|home\/[^\/\s]+|root|mnt|media)\/\S+/ nocase
    not $use.principal.process.file.full_path in %global_allowed_script_hosts
    not $use.principal.user.userid in %global_allowed_service_accounts
    $use.principal.hostname = $hostname

    $copy.metadata.event_timestamp.seconds <= $use.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1558.005")
    $primary_entity = array_distinct($copy.principal.hostname)
    $copy_users = array_distinct($copy.principal.user.userid)
    $use_users = array_distinct($use.principal.user.userid)
    $copy_commands = array_distinct($copy.target.process.command_line)
    $use_commands = array_distinct($use.target.process.command_line)
    $copy_event_count = count($copy.metadata.id)
    $use_event_count = count($use.metadata.id)

  condition:
    $copy and $use
}
