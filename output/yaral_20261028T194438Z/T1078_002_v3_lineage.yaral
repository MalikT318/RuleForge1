/*
  MITRE Technique : T1078.002 - Domain Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:31:21.021723+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_002_Unexpected_Parent_Spawns_Shell_Under_Domain_Context {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, script interpreter or proxy-execution binary spawned by a parent that should never launch one (Office application, web server worker, print spooler, database service), running under a non-system, non-machine account. Domain service or user identities running in these processes are a strong sign of abused domain credentials, such as a hijacked app-pool identity, a phished user, or a compromised SQL service account. The rule keys on process lineage rather than command-line content."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.002"
    mitre_technique_name = "Valid Accounts: Domain Accounts"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with parent process path and user context populated (EDR, Sysmon Event ID 1, or Security Event 4688 with parent process logging)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros or add-ins in legitimate business workflows, IIS or Tomcat applications that shell out for maintenance tasks, SQL Server agent jobs or xp_cmdshell used by DBAs, print drivers and print management software launching helper scripts, and software deployment run from a database or web console."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts, approved admin tooling to %global_allowed_admin_tools, and known automation identities to %global_allowed_service_accounts. Where a client has a legitimate web or database workflow that spawns shells, scope the exclusion to that parent path or service account rather than disabling the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote)\.exe$|\\(w3wp|httpd|nginx|tomcat[0-9]*|php-cgi)\.exe$|\\(spoolsv|sqlservr|mysqld)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|runas|wmic)\.exe$/ nocase
    $proc.principal.user.userid != ""
    not $proc.principal.user.userid = /(\$$|^system$|^local service$|^network service$|^localservice$|^networkservice$)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1078.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)

  condition:
    $proc
}
