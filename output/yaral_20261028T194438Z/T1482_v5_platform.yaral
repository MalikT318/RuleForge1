/*
  MITRE Technique : T1482 - Domain Trust Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:29:58.350793+00:00
  Reference       : https://attack.mitre.org/techniques/T1482
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1482_DotNet_AD_Trust_Assembly_Load_By_Script_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a scripting host or living-off-the-land binary loading the .NET System.DirectoryServices.ActiveDirectory assembly, which exposes the Domain and Forest trust-enumeration methods (for example GetAllTrustRelationships). This is a module-load rule that complements command-line rules for nltest and dsquery. It catches in-memory PowerShell and .NET trust discovery that never spawns a discovery binary. The platform is Windows only, because the technique is Windows-specific."
    mitre_tactic = "Discovery"
    mitre_technique = "T1482"
    mitre_technique_name = "Domain Trust Discovery"
    log_prerequisites = "Requires EDR or Sysmon image-load telemetry (Sysmon Event ID 7 or equivalent) normalised to PROCESS_MODULE_LOAD, with the loaded module path in target.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrator PowerShell scripts for AD health or trust checks, AD migration and consolidation tooling, identity governance and inventory scripts, Exchange and SCCM maintenance scripts, and RMM or patching agents that host PowerShell."
    tuning_guidance = "Add approved IT tooling to %global_allowed_admin_tools, approved script hosts to %global_allowed_script_hosts, and automation accounts to %global_allowed_service_accounts or %global_allowed_admin_users. If the volume is high, scope to workstations or non-domain-controller hosts, or raise severity when the loading process is a LOLBin such as mshta, rundll32 or regsvr32."

  events:
    $mod.metadata.event_type = "PROCESS_MODULE_LOAD"
    $mod.target.file.full_path = /System\.DirectoryServices\.ActiveDirectory(\.ni)?\.dll$/ nocase
    $mod.principal.process.file.full_path = /\\(powershell|pwsh|powershell_ise|wscript|cscript|mshta|rundll32|regsvr32|installutil|regasm|msbuild)\.exe$/ nocase
    not $mod.principal.process.file.full_path in %global_allowed_admin_tools
    not $mod.principal.process.file.full_path in %global_allowed_script_hosts
    not $mod.principal.process.file.full_path in %global_allowed_security_tools
    not $mod.principal.user.userid in %global_allowed_service_accounts
    not $mod.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1482")
    $primary_entity = array_distinct($mod.principal.hostname)
    $loading_process = array_distinct($mod.principal.process.file.full_path)
    $loaded_module = array_distinct($mod.target.file.full_path)
    $acting_user = array_distinct($mod.principal.user.userid)

  condition:
    $mod
}
