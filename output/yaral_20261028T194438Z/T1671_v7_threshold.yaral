/*
  MITRE Technique : T1671 - Cloud Application Integration
  Tactic(s)       : Persistence
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:15:30.824934+00:00
  Reference       : https://attack.mitre.org/techniques/T1671
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1671_OAuth_App_Consent_Burst_Per_User {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single user account performs several OAuth application integration operations (consent grants, service principal creation, app role or delegated permission grants) within ten minutes. One consent is routine, but a burst from one identity suggests an adversary establishing persistent application access, for example by granting consent to multiple attacker-controlled or illicit apps from a compromised account."
    mitre_tactic = "Persistence"
    mitre_technique = "T1671"
    mitre_technique_name = "Cloud Application Integration"
    log_prerequisites = "Requires unified audit or directory audit logs ingested and parsed to UDM, with the operation name populated in metadata.product_event_type and the acting user in principal.user.userid."
    platform = "SaaS"
    log_source = "m365"
    false_positives = "Tenant administrators onboarding several approved applications in one session, application deployment or migration projects, identity governance automation, and pre-approved vendor integrations being rolled out to a user population."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and automation or provisioning identities to %global_allowed_service_accounts. Add sanctioned identity and integration principals to %global_allowed_cloud_principals. Raise the #oauth threshold for tenants with frequent integration onboarding."

  events:
    $oauth.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"
    $oauth.metadata.product_event_type = /(consent to application|add service principal|add app role assignment|add oauth2permissiongrant|add delegated permission grant|add application|update application.{0,20}certificates and secrets)/ nocase
    $oauth.principal.user.userid = $user
    not $oauth.principal.user.userid in %global_allowed_admin_users
    not $oauth.principal.user.userid in %global_allowed_service_accounts
    not $oauth.principal.user.userid in %global_allowed_cloud_principals

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($oauth.metadata.id)
    $operations = array_distinct($oauth.metadata.product_event_type)
    $target_apps = array_distinct($oauth.target.resource.name)
    $source_ips = array_distinct($oauth.principal.ip)
    $mitre_technique_id = array_distinct("T1671")
    $primary_entity = array_distinct($user)

  condition:
    #oauth >= 3
}
