/*
  MITRE Technique : T1115 - Clipboard Data
  Tactic(s)       : Collection
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:24:52.319956+00:00
  Reference       : https://attack.mitre.org/techniques/T1115
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1115_Repeated_Clipboard_Access_PowerShell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated PowerShell launches on a single host within 10 minutes whose command lines read clipboard contents (Get-Clipboard or the .NET Windows Forms Clipboard class). A single clipboard read is routine; repeated reads in a short window indicate clipboard-harvesting or polling by an implant or script."
    mitre_tactic = "Collection"
    mitre_technique = "T1115"
    mitre_technique_name = "Clipboard Data"
    log_prerequisites = "Requires EDR process telemetry, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled, normalised to UDM PROCESS_LAUNCH with target.process.command_line populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Productivity or accessibility scripts that read the clipboard, IT automation and RMM scripts, developer tooling and admin troubleshooting sessions, and user-installed clipboard-manager helpers implemented in PowerShell."
    tuning_guidance = "Add approved parent tooling to %global_allowed_admin_tools or %global_allowed_script_hosts, and automation identities to %global_allowed_service_accounts. Raise the #proc threshold if noisy hosts remain. Risk score rises for command lines using hidden-window, encoded or non-interactive flags."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
    $proc.target.process.command_line = /(\bget-clipboard\b|windows\.forms\.clipboard\]?\s*::\s*(gettext|getdataobject|getimage|getfiledroplist))/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(
      if($proc.target.process.command_line = /(-w(indowstyle)?\s+hidden|-(enc|encodedcommand)\b|-noni(nteractive)?\b|-nop(rofile)?\b)/ nocase, 70, 50)
    )
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1115")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 5
}
