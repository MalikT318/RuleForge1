/*
  MITRE Technique : T1546.013 - PowerShell Profile
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:19:15.492514+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_013_PowerShell_Profile_Interactive_Host_External_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side indicator of PowerShell profile persistence. A PowerShell host (console, ISE or pwsh) started bare, with no -Command, -File, -EncodedCommand or -NoProfile arguments, makes an outbound connection to a non-internal address. Bare launches load all profile scripts, so a malicious profile can beacon or stage a payload as soon as the user opens a session. Legitimate interactive sessions can look the same, so this is a hunting-grade, additive signal that complements command-line detections."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.013"
    mitre_technique_name = "Event Triggered Execution: PowerShell Profile"
    log_prerequisites = "Requires endpoint network connection telemetry that populates principal.process.command_line (EDR or Sysmon Event ID 3 with process command line enrichment)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators running interactive PowerShell sessions that legitimately reach the internet (Install-Module, Update-Help, Invoke-WebRequest, Azure or Microsoft 365 module sessions), legitimate profiles that check for module updates or sync dotfiles, developer workstations, and RMM tooling that opens bare PowerShell hosts."
    tuning_guidance = "Add service accounts to %global_allowed_service_accounts, jump hosts and admin workstations to %global_allowed_script_hosts, and approved launcher processes to %global_allowed_admin_tools. Consider excluding known-good update destinations by adding domains to %global_allowed_domains if NETWORK_HTTP or DNS enrichment is available. Correlate hits with FILE_MODIFICATION of profile.ps1 or Microsoft.PowerShell_profile.ps1 on the same host."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(powershell|powershell_ise|pwsh)\.exe$/ nocase
    $net.principal.process.command_line = /^"?([^"\s]*\\)?(powershell|powershell_ise|pwsh)(\.exe)?"?(\s+[-\/]noexit)?\s*$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.parent_process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1546.013")
    $primary_entity = array_distinct($net.principal.hostname)
    $user = array_distinct($net.principal.user.userid)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
