/*
  MITRE Technique : T1567.004 - Exfiltration Over Webhook
  Tactic(s)       : Exfiltration
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:02:12.119745+00:00
  Reference       : https://attack.mitre.org/techniques/T1567/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_004_ESXi_Excessive_External_HTTPS_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single ESXi host makes an unusual number of outbound HTTPS connections to non-internal addresses within ten minutes. Hypervisor management hosts normally make few external connections. A burst can indicate data being pushed to a webhook endpoint from the host shell or a scripted process. This rule counts connection volume and does not depend on command-line content."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567.004"
    mitre_technique_name = "Exfiltration Over Web Service: Exfiltration Over Webhook"
    log_prerequisites = "Requires ESXi host outbound connection records normalised to NETWORK_CONNECTION with principal.hostname, target.ip and target.port populated. Typical sources are host firewall or flow logging forwarded alongside hostd, vmkernel and shell logs."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Patch and update downloads from vendor repositories, host registration or licensing checks, third-party monitoring or backup agents calling out over HTTPS, admin-initiated offline bundle or log uploads to vendor support."
    tuning_guidance = "Add approved agent and tooling binaries to %global_allowed_admin_tools and %global_allowed_backup_processes. Add vendor update and support domains to %global_allowed_domains. Raise the #net threshold on hosts that legitimately talk to cloud services. Scale severity upward when distinct_destinations is low and connection_count is high, which suggests repeated posts to one endpoint."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 443
    $net.principal.hostname = $host
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_backup_processes

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $connection_count = count($net.metadata.id)
    $distinct_destinations = count_distinct($net.target.ip)
    $destination_ips = array_distinct($net.target.ip)
    $mitre_technique_id = array_distinct("T1567.004")
    $primary_entity = array_distinct($host)

  condition:
    #net >= 10
}
