/*
  MITRE Technique : T1055.002 - Portable Executable Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:47:33.326607+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_002_PE_Injection_Handle_Open_Then_Injection_Event {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A process running from a user-writable location opens a handle to a commonly injected Windows process, then the same source process generates a process injection event on the same host within five minutes. This sequence is consistent with PE injection (allocate, write, remote thread) and does not depend on command lines."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.002"
    mitre_technique_name = "Process Injection: Portable Executable Injection"
    log_prerequisites = "Requires EDR or Sysmon-equivalent telemetry that populates both process-handle-open (Sysmon EID 10) and remote thread or injection (Sysmon EID 8) events as PROCESS_OPEN and PROCESS_INJECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters running from temp or AppData, game anti-cheat or overlay software, accessibility tools, application-compatibility shims, developer debuggers and profilers, unlisted EDR or DLP agents."
    tuning_guidance = "Add legitimate EDR/AV agents to %global_allowed_security_tools and imaging or backup software to %global_allowed_backup_processes. Add approved deployment tooling to %global_allowed_admin_tools. If noise remains, narrow the victim process list or add service accounts to %global_allowed_service_accounts."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.process.file.full_path = /\\(users\\[^\\]+\\|appdata\\|temp\\|programdata\\|perflogs\\|downloads\\)/ nocase
    $open.target.process.file.full_path = /\\(explorer|svchost|notepad|spoolsv|dllhost|taskhostw|runtimebroker|searchindexer|winlogon|sihost|rundll32|regsvr32|werfault|msiexec)\.exe$/ nocase
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.user.userid in %global_allowed_service_accounts
    $open.principal.hostname = $hostname
    $open.principal.process.file.full_path = $src_proc

    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.process.file.full_path = /\\(users\\[^\\]+\\|appdata\\|temp\\|programdata\\|perflogs\\|downloads\\)/ nocase
    $inj.principal.process.file.full_path != $inj.target.process.file.full_path
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    $inj.principal.hostname = $hostname
    $inj.principal.process.file.full_path = $src_proc

    $open.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname, $src_proc over 5m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1055.002")
    $primary_entity = array_distinct($open.principal.hostname)
    $source_process = array_distinct($open.principal.process.file.full_path)
    $opened_victims = array_distinct($open.target.process.file.full_path)
    $injected_victims = array_distinct($inj.target.process.file.full_path)
    $source_users = array_distinct($open.principal.user.userid)
    $open_event_count = count($open.metadata.id)
    $injection_event_count = count($inj.metadata.id)

  condition:
    $open and $inj
}
