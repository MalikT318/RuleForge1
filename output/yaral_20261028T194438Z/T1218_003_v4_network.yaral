/*
  MITRE Technique : T1218.003 - CMSTP
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:45:44.384433+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_003_CMSTP_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Connection Manager Profile Installer (cmstp.exe) initiating a network connection to an external address. Legitimate profile installation is local, so outbound traffic from this binary indicates a remote scriptlet (SCT) or DLL being fetched, as in CMSTP proxy execution or a Squiblydoo-style bypass. This is network-side coverage that does not depend on command-line matching."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.003"
    mitre_technique_name = "System Binary Proxy Execution: CMSTP"
    log_prerequisites = "Requires Windows endpoint network telemetry that attributes each connection to its originating process (EDR network events or Sysmon Event ID 3) and normalises it to NETWORK_CONNECTION with principal.process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare. Possible sources are VPN or Connection Manager profile deployments that fetch phonebook or profile updates from an external vendor URL, and software packaging or testing hosts that install CM profiles from remote shares published via an external gateway."
    tuning_guidance = "Add known-good vendor destinations to %global_allowed_domains. Add deployment or automation accounts to %global_allowed_service_accounts. Confirm %rfc1918_internal covers all client internal address space, including any internal ranges outside RFC1918."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\cmstp\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $process_command_lines = array_distinct($net.principal.process.command_line)
    $affected_users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
