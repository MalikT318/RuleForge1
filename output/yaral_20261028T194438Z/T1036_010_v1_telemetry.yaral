/*
  MITRE Technique : T1036.010 - Masquerade Account Name
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:12:20.021701+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_010_K8s_Masquerading_ServiceAccount_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a Kubernetes ServiceAccount whose name mimics a trusted system, control-plane, or generic privileged identity (for example kube-*, system:*, admin, root, or cluster-admin-style names). The rule works on the resulting control-plane resource-creation record rather than any command line, so it still fires if the attacker uses kubectl, a client library, or a direct API call. It covers masquerading by newly created accounts that are meant to blend in with cluster-management or service identities."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.010"
    mitre_technique_name = "Masquerading: Masquerade Account Name"
    log_prerequisites = "Requires container orchestration control-plane audit logs (Kubernetes API audit) normalised to UDM RESOURCE_CREATION, with target.resource.name, target.resource.resource_subtype and principal.user.userid populated."
    platform = "Linux"
    log_source = "container"
    false_positives = "Helm charts, operators, and GitOps controllers that legitimately create ServiceAccounts with system-style or kube-prefixed names; cluster bootstrap and upgrade tooling; platform teams provisioning admin or monitoring service accounts through approved pipelines."
    tuning_guidance = "Add approved automation identities to %global_allowed_service_accounts and %global_allowed_cloud_principals, and named platform administrators to %global_allowed_admin_users. If the control plane does not populate resource_subtype in your tenant, validate field mapping before deployment. Extend or trim the name regex per client naming conventions."

  events:
    $res.metadata.event_type = "RESOURCE_CREATION"
    $res.target.resource.resource_subtype = /^serviceaccounts?$/ nocase
    $res.target.resource.name = /^(system[:\-_.].*|kube[-_.].*|k8s[-_.].*|kubernetes[-_.]?.*|cluster[-_]?admin.*|admin|administrator|root|superuser|sudo|support|helpdesk|backup|backups|monitoring|prometheus|master|controller|operator|node|kubelet|etcd|coredns)$/ nocase
    not $res.principal.user.userid in %global_allowed_service_accounts
    not $res.principal.user.userid in %global_allowed_cloud_principals
    not $res.principal.user.userid in %global_allowed_admin_users
    not $res.principal.user.userid = /^system:(kube-controller-manager|kube-scheduler|apiserver|serviceaccount:kube-system:.*)$/ nocase

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1036.010")
    $primary_entity = array_distinct($res.principal.user.userid)
    $account_name = array_distinct($res.target.resource.name)
    $source_ip = array_distinct($res.principal.ip)

  condition:
    $res
}
