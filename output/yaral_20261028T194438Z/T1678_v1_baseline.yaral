/*
  MITRE Technique : T1678 - Delay Execution
  Tactic(s)       : Stealth
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:23:55.333464+00:00
  Reference       : https://attack.mitre.org/techniques/T1678
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1678_Delay_Then_Execute_Command_Chain {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a shell or PowerShell command line that uses a native delay primitive (ping -n with a high count, timeout /t, choice /t, Start-Sleep) and then chains a delete, start or execute action. This 'sleep then run or self-delete' pattern is used by malware to outlast sandbox analysis windows and to remove the dropper after execution."
    mitre_tactic = "Stealth"
    mitre_technique = "T1678"
    mitre_technique_name = "Delay Execution"
    log_prerequisites = "Requires EDR or Sysmon process creation telemetry (or Windows Event 4688 with command-line auditing enabled) populating target.process.command_line."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy batch or installer scripts that wait with ping or timeout before restarting a service or launching an application. Software updaters that delete their own installer after a delay. Admin deployment scripts. Logon scripts that pause before launching an application."
    tuning_guidance = "Add approved deployment, RMM and patching binaries to %global_allowed_admin_tools. Add trusted parent processes or script hosts to %global_allowed_script_hosts. To reduce noise from legitimate wait loops, raise the minimum delay by changing \\d{2,} to \\d{3,}. To widen coverage, extend the action list after the chain operator."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|powershell_ise)\.exe$/ nocase
    $proc.target.process.command_line = /(\bping(\.exe)?\b.*\s-n\s+\d{2,}|\btimeout(\.exe)?\b.*\/t\s+-?\d{2,}|\bchoice(\.exe)?\b.*\/t\s+\d{2,}|\bstart-sleep\b\s+(-s(econds)?\s+)?\d{2,})/ nocase
    $proc.target.process.command_line = /([^>]&&?|;)\s*.*(\bdel\b|\berase\b|\bstart\b|\bcall\b|rundll32|regsvr32|mshta|wscript|cscript|invoke-expression|\biex\b|start-process|\.(exe|bat|cmd|vbs|js|ps1|dll)\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1678")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
