/*
  MITRE Technique : T1518 - Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:37:41.399038+00:00
  Reference       : https://attack.mitre.org/techniques/T1518
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_Linux_Rapid_Software_Inventory_Queries {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of package-manager and installed-software query commands (dpkg, rpm, apt, yum/dnf, snap, pip, pacman, apk, flatpak, zypper) on a single Linux host within ten minutes. One query is routine administration, but repeated enumeration from one host suggests automated software discovery used to identify security tooling or vulnerable software before follow-on actions."
    mitre_tactic = "Discovery"
    mitre_technique = "T1518"
    mitre_technique_name = "Software Discovery"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records normalised to UDM PROCESS_LAUNCH with command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management agents (inventory runs), patch and compliance scanners, vulnerability scanners with authenticated checks, admins troubleshooting packages, and CI/build hosts or provisioning scripts that check installed packages."
    tuning_guidance = "Add inventory, patching and configuration management binaries to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and approved provisioning hosts or parent shells to %global_allowed_script_hosts. Raise the #proc threshold on build or CI hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(dpkg|dpkg-query|rpm|apt|apt-get|apt-cache|yum|dnf|snap|pip|pip3|pacman|apk|flatpak|zypper)$/ nocase
    $proc.target.process.command_line = /(\s-(l|L|s|S|W|Q[a-z]*|q[a-zA-Z]*)(\s|$)|\s--(list|status|show|query|installed|get-selections)\b|\s(list|info|show|policy|freeze|repolist|search|se)(\s|$))/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(50)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1518")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $tools_used = array_distinct($proc.target.process.file.full_path)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)

  condition:
    #proc >= 6
}
