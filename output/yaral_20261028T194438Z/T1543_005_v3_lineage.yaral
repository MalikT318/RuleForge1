/*
  MITRE Technique : T1543.005 - Container Service
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:57:33.667503+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_005_Container_Mgmt_CLI_From_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a container runtime or Kubernetes client binary (docker, podman, nerdctl, crictl, ctr, kubectl) launched directly by a web server, application runtime or database process. Such services should never manage containers. This lineage points to remote code execution being used to create persistent or privileged containers, for example restart-always containers, host-mounted containers or DaemonSets. The rule keys on the parent-child relationship, not on command-line content."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.005"
    mitre_technique_name = "Create or Modify System Process: Container Service"
    log_prerequisites = "Requires container-aware EDR/runtime process telemetry (PROCESS_LAUNCH) with populated parent and child process paths, from inside containers or from the node. Linux auditd execve with parent process context also works."
    platform = "Containers"
    log_source = "container"
    false_positives = "CI/CD agents or build servers running on Java, Node or Python that legitimately call docker or kubectl (Jenkins, GitLab runners, Tekton steps). Self-service portals or operators that shell out to kubectl. Database backup or orchestration sidecars that call container CLIs. Admin troubleshooting in a debug container."
    tuning_guidance = "Add approved CI/CD and orchestration parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts. Add automation identities to %global_allowed_service_accounts. If build agents are noisy, scope them by host or namespace through the reference lists. Extend the parent regex with local application runtimes if needed. The rule only sees a direct parent; a web server that goes through an intermediate shell is not matched, so pair it with a shell-from-webserver rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|httpd|apache2|php-fpm[0-9.]*|php|tomcat[0-9]*|java|node|nodejs|gunicorn|uwsgi|ruby|puma|mysqld|mariadbd|postgres|mongod|redis-server|memcached)$/ nocase
    $proc.target.process.file.full_path = /\/(docker|podman|nerdctl|crictl|ctr|kubectl)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1543.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
