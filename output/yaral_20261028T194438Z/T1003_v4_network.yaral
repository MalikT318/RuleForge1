/*
  MITRE Technique : T1003 - OS Credential Dumping
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:36:21.567769+00:00
  Reference       : https://attack.mitre.org/techniques/T1003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_Linux_Credential_Store_Process_Outbound_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound connection to an external address made by a process whose command line references a Linux credential store (shadow/gshadow files, opasswd, process memory or maps, Kerberos keytab or ccache, SSSD secrets). This is the network-side signature of credential material being exfiltrated or a credential-dumping utility beaconing out. The rule keys on the network event rather than process creation, so it complements command-line rules."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003"
    mitre_technique_name = "OS Credential Dumping"
    log_prerequisites = "Requires Linux EDR or auditd network telemetry that normalises to NETWORK_CONNECTION and populates principal.process.command_line and principal.process.file.full_path on the connection event."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup and imaging agents reading /etc/shadow and sending it to remote storage; configuration management or compliance tooling that audits password files; Kerberos or SSSD maintenance utilities contacting a KDC outside RFC1918 space; authorised red team or pentest activity; admins copying files off-host by hand."
    tuning_guidance = "Add backup agent binaries to %global_allowed_backup_processes, config management and RMM binaries to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and authorised scanner or pentest source hosts to %global_allowed_scanners. Add known-good KDC or vendor destinations to %global_allowed_mgmt_sources if they sit outside the internal address list. If the rule is noisy, restrict the regex to the shadow and process-memory alternatives only."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.command_line = /(\/etc\/(shadow|gshadow|security\/opasswd)|\/proc\/[0-9]+\/(mem|maps)|\/var\/lib\/sss\/secrets|krb5\.keytab|\/krb5cc_[0-9a-z]+)/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_user = array_distinct($net.principal.user.userid)
    $connecting_process = array_distinct($net.principal.process.file.full_path)
    $connecting_command_line = array_distinct($net.principal.process.command_line)

  condition:
    $net
}
