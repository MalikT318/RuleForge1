/*
  MITRE Technique : T1685 - Disable or Modify Tools
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:15:08.747760+00:00
  Reference       : https://attack.mitre.org/techniques/T1685
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_ESXi_Syslog_Forwarding_To_External_Destination {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the ESXi syslog daemon opening a connection to an external (non-internal) destination on standard syslog ports (514, 1514, 6514). Adversaries who impair ESXi logging commonly redirect host logs to a non-corporate collector, or away from the SIEM pipeline, so that local and central visibility is reduced. This is a network-side view of defense impairment and complements endpoint command-line detections, because it fires on the resulting traffic whichever tool changed the syslog configuration."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685"
    mitre_technique_name = "Disable or Modify Tools"
    log_prerequisites = "Requires ESXi host or network flow telemetry normalised to NETWORK_CONNECTION with principal.hostname, target.ip, target.port and principal.process.file.full_path populated for the ESXi syslog daemon."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Legitimate log forwarding to a cloud-hosted SIEM or managed log collector reached by public IP; MSSP or vendor-operated syslog relays; newly onboarded log collectors during migration; hosts in a DMZ that forward logs across a public address."
    tuning_guidance = "Add known-good external collector domains to %global_allowed_domains (matched against target.hostname). Add approved security or logging agents to %global_allowed_security_tools. Confirm the ESXi syslog daemon path in the client's telemetry and adjust the process regex if the agent reports a different binary name. Verify %rfc1918_internal covers the client's internal ranges."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(vmsyslogd|syslogd|rsyslogd)$/ nocase
    (
      $net.target.port = 514 or
      $net.target.port = 1514 or
      $net.target.port = 6514
    )
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1685")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_process = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
