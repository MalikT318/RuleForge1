/*
  MITRE Technique : T1569 - System Services
  Tactic(s)       : Execution
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:09:22.035394+00:00
  Reference       : https://attack.mitre.org/techniques/T1569
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_Service_ImagePath_Registry_Suspicious_Binary {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows service ImagePath registry value being written with an interpreter or LOLBin invocation, a user-writable or staging path, or a remote admin share path. This is the registry state change left behind by service-based execution (for example PsExec-style remote service creation or 'sc create'), so it fires even when process command-line logging is evaded."
    mitre_tactic = "Execution"
    mitre_technique = "T1569"
    mitre_technique_name = "System Services"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event IDs 12/13/14 equivalent) covering HKLM\\SYSTEM\\CurrentControlSet\\Services, with registry value data populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters that register services running from ProgramData or Temp; RMM and deployment agents installing helper services; vendor driver or agent installers; admins creating services that wrap scripts; EDR agents self-updating."
    tuning_guidance = "Add approved deployment, RMM and patching binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Add automation accounts that legitimately register services to %global_allowed_service_accounts. If installers writing to ProgramData are noisy, narrow the path alternatives in the registry_value_data regex per client."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(CurrentControlSet|ControlSet\d{3})\\Services\\[^\\]+(\\ImagePath)?$/ nocase
    (
      $reg.target.registry.registry_value_name = "ImagePath" nocase or
      $reg.target.registry.registry_key = /\\ImagePath$/ nocase
    )
    $reg.target.registry.registry_value_data = /(cmd(\.exe)?"?\s+\/[ck]|%comspec%|powershell|pwsh|mshta|rundll32|regsvr32|wscript|cscript|\\users\\[^\\]+\\|\\appdata\\|\\temp\\|\\programdata\\[^\\]+\.exe|\\perflogs\\|\\windows\\debug\\|\\\\[^\\]+\\(admin|c|ipc)\$)/ nocase
    not $reg.principal.process.file.full_path = /\\(TiWorker|TrustedInstaller)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1569")
    $primary_entity = array_distinct($reg.principal.hostname)
    $service_registry_key = array_distinct($reg.target.registry.registry_key)
    $image_path_value = array_distinct($reg.target.registry.registry_value_data)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
