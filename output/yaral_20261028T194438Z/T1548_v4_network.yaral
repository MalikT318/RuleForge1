/*
  MITRE Technique : T1548 - Abuse Elevation Control Mechanism
  Tactic(s)       : Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:27:20.015033+00:00
  Reference       : https://attack.mitre.org/techniques/T1548
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_IdP_External_Privileged_Role_Assignment_API {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a successful state-changing HTTP API call (POST/PUT/PATCH) to identity-provider role-assignment or directory-role membership endpoints from an external source address. Adversaries who have obtained a session or token use these calls to grant themselves or another identity higher privileges. This is network-side observation of API traffic and complements endpoint and directory-audit coverage."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548"
    mitre_technique_name = "Abuse Elevation Control Mechanism"
    log_prerequisites = "Requires identity-provider API or directory-graph activity logs normalised to NETWORK_HTTP with principal.ip, principal.user.userid, target.url, network.http.method and network.http.response_code populated."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Administrators or privileged-identity-management workflows working remotely from home or VPN egress addresses, IAM governance and access-review automation, HR-driven provisioning tools, MSP or partner delegated administration, and cloud-hosted automation using public egress IPs."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users, provisioning and governance automation to %global_allowed_service_accounts, and approved application or service principals to %global_allowed_cloud_principals. Confirm that %rfc1918_internal covers corporate egress if clients route admin traffic through known NAT ranges. If the response-code field is not populated for a client, remove the response-code conditions."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT|PATCH)$/ nocase
    $net.target.url = /\/(roleManagement\/[^?]*roleAssignments|directoryRoles\/[^\/]+\/members\/\$ref|roleAssignmentScheduleRequests|roleEligibilityScheduleRequests|appRoleAssignments|administrators\/roles)/ nocase
    $net.network.http.response_code >= 200
    $net.network.http.response_code < 300
    $net.principal.user.userid != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.user.userid in %global_allowed_admin_users
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1548")
    $primary_entity = array_distinct($net.principal.user.userid)
    $source_ips = array_distinct($net.principal.ip)
    $requested_urls = array_distinct($net.target.url)
    $http_methods = array_distinct($net.network.http.method)

  condition:
    $net
}
