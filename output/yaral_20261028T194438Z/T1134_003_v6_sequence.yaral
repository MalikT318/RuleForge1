/*
  MITRE Technique : T1134.003 - Make and Impersonate Token
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:58:17.677735+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_003_Runas_Netonly_Then_Remote_Admin_Activity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the built-in runas utility invoked with /netonly, which creates a NewCredentials logon session (LogonUser with LOGON32_LOGON_NEW_CREDENTIALS) that carries alternate network credentials. It is followed within 10 minutes by remote administrative activity (admin-share UNC access, WMI /node, remote sc or schtasks) from the same host and user. This pairing indicates make-and-impersonate token behaviour used for lateral movement with supplied credentials."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.003"
    mitre_technique_name = "Access Token Manipulation: Make and Impersonate Token"
    log_prerequisites = "Requires EDR or Sysmon process creation telemetry (or Windows Event 4688 with command-line auditing enabled) populating principal.hostname, principal.user.userid and target.process.command_line."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators using runas /netonly to reach remote shares or servers in another domain, helpdesk and IT operations staff, and deployment or patching scripts that authenticate to remote hosts with alternate credentials."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and approved deployment or RMM parent processes to %global_allowed_admin_tools. If still noisy, exclude known jump hosts by hostname in the client environment."

  events:
    $runas.metadata.event_type = "PROCESS_LAUNCH"
    $runas.target.process.file.full_path = /\\runas\.exe$/ nocase
    $runas.target.process.command_line = /\/netonly/ nocase
    $runas.principal.hostname = $hostname
    $runas.principal.user.userid = $user
    not $runas.principal.user.userid in %global_allowed_admin_users

    $remote.metadata.event_type = "PROCESS_LAUNCH"
    $remote.target.process.file.full_path = /\\(net|net1|sc|schtasks|wmic|reg|cmd|powershell|pwsh)\.exe$/ nocase
    $remote.target.process.command_line = /(\\\\[^\\\s]+\\(admin\$|c\$|ipc\$)|\/node:|\bsc(\.exe)?\s+\\\\|\bschtasks(\.exe)?\s.*\s\/s\s)/ nocase
    $remote.principal.hostname = $hostname
    $remote.principal.user.userid = $user
    not $remote.principal.process.file.full_path in %global_allowed_admin_tools

    $runas.metadata.event_timestamp.seconds <= $remote.metadata.event_timestamp.seconds

  match:
    $hostname, $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1134.003")
    $primary_entity = array_distinct($hostname)
    $impersonating_user = array_distinct($user)
    $runas_command_lines = array_distinct($runas.target.process.command_line)
    $remote_command_lines = array_distinct($remote.target.process.command_line)
    $remote_event_count = count($remote.metadata.id)

  condition:
    $runas and $remote
}
