/*
  MITRE Technique : T1552.002 - Credentials in Registry
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:48:01.873957+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_002_Winlogon_AutoLogon_Password_Written_To_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a plaintext AutoLogon credential value (DefaultPassword or AltDefaultPassword) being written under the Winlogon registry key. This stages a recoverable cleartext credential in the registry that any local administrator or attacker can later harvest. It is registry-telemetry based and does not depend on process command lines, so it complements command-line rules for reg query. The Windows platform is mandated for this technique, so the alternate-platform angle was not applied because T1552.002 is Windows-registry specific."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.002"
    mitre_technique_name = "Unsecured Credentials: Credentials in Registry"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon registry value set events, normalised to REGISTRY_MODIFICATION) with registry key, value name and initiating process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Kiosk, digital-signage and lab build processes that deliberately configure AutoLogon; imaging and provisioning tools; Sysinternals Autologon run by administrators; GPO or MDM deployment of AutoLogon settings."
    tuning_guidance = "Add approved provisioning or deployment binaries to %global_allowed_admin_tools, approved administrators to %global_allowed_admin_users, and EDR agents to %global_allowed_security_tools. Kiosk fleets that legitimately use AutoLogon should be scoped out by the initiating process allowlist rather than by hostname."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon$/ nocase
    $reg.target.registry.registry_value_name = /^(Alt)?DefaultPassword$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1552.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $acting_user = array_distinct($reg.principal.user.userid)
    $acting_process = array_distinct($reg.principal.process.file.full_path)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value = array_distinct($reg.target.registry.registry_value_name)

  condition:
    $reg
}
