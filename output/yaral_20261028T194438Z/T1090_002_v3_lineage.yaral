/*
  MITRE Technique : T1090.002 - External Proxy
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:28:57.030603+00:00
  Reference       : https://attack.mitre.org/techniques/T1090/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1090_002_Server_Or_Office_Parent_Spawns_Proxy_Tunnel {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office application, web server, database service or print spooler process spawning a shell, netsh or an SSH client that is configured for port forwarding or proxying (portproxy, SSH remote or dynamic forwarding, SOCKS). These parents should never build traffic relays, so this lineage indicates a port redirector or external proxy being set up for C2."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1090.002"
    mitre_technique_name = "Proxy: External Proxy"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and child command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web or database applications that legitimately shell out to configure port proxies or SSH tunnels (for example deployment or maintenance scripts run by an IIS application pool), vendor installers launched from a database service, and developer or test servers running tunnelling helpers."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts or %global_allowed_admin_tools, and add automation accounts to %global_allowed_service_accounts. If a particular web application legitimately configures tunnels, scope it by adding its parent process path to the allowlist rather than loosening the child filter."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|w3wp|httpd|nginx|tomcat\d*|php-cgi|sqlservr|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(netsh|ssh|cmd|powershell|pwsh)\.exe$/ nocase
    $proc.target.process.command_line = /(portproxy|v[46]tov[46]|\bssh(\.exe)?\b.*\s-[rRdD]\s*\S*\d+|\bsocks[45]?\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1090.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
