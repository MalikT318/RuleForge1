/*
  MITRE Technique : T1613 - Container and Resource Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:36:18.871130+00:00
  Reference       : https://attack.mitre.org/techniques/T1613
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1613_Container_Exec_Shell_Then_Resource_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A shell is started inside a container by the container runtime (exec or attach), then within 10 minutes the same container or host runs container, cluster, or API discovery commands. These include orchestrator or runtime CLI listing and inspection, or HTTP requests to the orchestrator or runtime API for pods, nodes, namespaces, containers, or images. This sequence is typical of an adversary enumerating containers and cluster resources after gaining an interactive foothold."
    mitre_tactic = "Discovery"
    mitre_technique = "T1613"
    mitre_technique_name = "Container and Resource Discovery"
    log_prerequisites = "Requires container runtime or node-level process telemetry (PROCESS_LAUNCH with parent process, command line and hostname populated) from in-container or host process monitoring."
    platform = "Containers"
    log_source = "container"
    false_positives = "Platform engineers and SREs debugging pods with exec; CI/CD runners and deployment agents that query cluster state; GitOps or operator tooling running health checks; monitoring and inventory agents calling the orchestrator API; developer sandbox clusters."
    tuning_guidance = "Add approved tooling parent or binary paths to %global_allowed_admin_tools. Add automation identities to %global_allowed_service_accounts. Add build, bastion, and debug hosts to %global_allowed_script_hosts. Raise severity for production namespaces or when the discovery commands target secrets or nodes."

  events:
    $exec.metadata.event_type = "PROCESS_LAUNCH"
    $exec.principal.process.file.full_path = /\/(runc|containerd-shim[^\/]*|crio|conmon|dockerd|docker-init)$/ nocase
    $exec.target.process.file.full_path = /\/(sh|bash|ash|dash|zsh)$/ nocase
    $exec.principal.hostname = $hostname
    not $exec.principal.hostname in %global_allowed_script_hosts

    $disc.metadata.event_type = "PROCESS_LAUNCH"
    $disc.principal.hostname = $hostname
    (
      $disc.target.process.command_line = /\b(kubectl|docker|crictl|nerdctl|podman|ctr)\b.*\b(get|describe|ps|images|inspect|api-resources|cluster-info|top|ls|list)\b/ nocase or
      $disc.target.process.command_line = /\b(curl|wget)\b.*(\/api\/v1\/(pods|nodes|namespaces|services|secrets|configmaps)|\/apis\/(apps|batch)\/v1\/(deployments|daemonsets|jobs)|docker\.sock.*\/(containers|images|networks)\/json|\/v[0-9.]+\/(containers|images)\/json)/ nocase
    )
    not $disc.principal.process.file.full_path in %global_allowed_admin_tools
    not $disc.principal.user.userid in %global_allowed_service_accounts

    $exec.metadata.event_timestamp.seconds <= $disc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1613")
    $primary_entity = array_distinct($exec.principal.hostname)
    $exec_shells = array_distinct($exec.target.process.file.full_path)
    $discovery_commands = array_distinct($disc.target.process.command_line)
    $discovery_count = count($disc.metadata.id)
    $users = array_distinct($disc.principal.user.userid)

  condition:
    $exec and $disc
}
