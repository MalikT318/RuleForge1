/*
  MITRE Technique : T1573.001 - Symmetric Cryptography
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:23:30.805362+00:00
  Reference       : https://attack.mitre.org/techniques/T1573/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1573_001_Unclassified_Encrypted_Outbound_TCP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound TCP connections from internal hosts to external addresses on a high, non-standard port where the perimeter device could not identify the application protocol. Custom symmetric-encrypted C2 (AES, RC4, etc.) wrapped in a raw TCP channel has no recognisable protocol handshake, so it is typically classified as unknown. This is a network-side detection that complements endpoint command-line coverage."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1573.001"
    mitre_technique_name = "Encrypted Channel: Symmetric Cryptography"
    log_prerequisites = "Firewall or perimeter logs normalised to NETWORK_CONNECTION with network.direction, network.ip_protocol, network.application_protocol, target.ip and target.port populated. Application identification (L7 inspection) must be enabled on the device, otherwise application_protocol will not be reliable."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Proprietary line-of-business applications, game or VoIP clients, peer-to-peer software, VPN or tunnelling clients on custom ports, and database or messaging replication to external partners. Devices without L7 inspection may also label legitimate traffic as unknown."
    tuning_guidance = "Add known-good destination domains to %global_allowed_domains and known source hosts (for example scanners) to %global_allowed_scanners. Extend the port exclusions for approved custom-port applications. To reduce volume, enrich with first-seen destination logic or promote to a Threshold rule that groups by principal.ip."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.direction = "OUTBOUND"
    $net.network.ip_protocol = "TCP"
    $net.network.application_protocol = "UNKNOWN"
    $net.target.port > 1023
    $net.target.port != 8080
    $net.target.port != 8443
    $net.target.port != 8000
    $net.target.port != 8888
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1573.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
