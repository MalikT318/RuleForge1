/*
  MITRE Technique : T1134.003 - Make and Impersonate Token
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:56:40.345921+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_003_Make_Impersonate_Token_NewCredentials_Logon {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows logon session created with the NewCredentials logon type (Security Event 4624, logon type 9). This is the session type produced when LogonUser is called with LOGON32_LOGON_NEW_CREDENTIALS, or when runas /netonly is used. Adversaries use it to make a token for stolen credentials, then apply it to a thread with SetThreadToken or ImpersonateLoggedOnUser. The local identity stays the same while outbound network authentication uses the supplied credentials."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.003"
    mitre_technique_name = "Access Token Manipulation: Make and Impersonate Token"
    log_prerequisites = "Requires Windows Security Event 4624 (Audit Logon, success) collected and normalised to UDM USER_LOGIN with extensions.auth.mechanism populated, or equivalent EDR logon telemetry that distinguishes logon type 9."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators using runas /netonly, IT tooling and RMM agents that connect to remote shares with alternate credentials, SCCM or software deployment agents, backup agents, and developers testing cross-domain access. Some applications legitimately call LogonUser with NewCredentials to reach network resources."
    tuning_guidance = "Add approved service and automation accounts to %global_allowed_service_accounts. Add named administrators who legitimately use runas /netonly to %global_allowed_admin_users. Add approved deployment, RMM and management binaries to %global_allowed_admin_tools. If one host produces repeated benign hits, review the initiating application before excluding it."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.extensions.auth.mechanism = "NEW_CREDENTIALS"
    $auth.target.user.userid != ""
    not $auth.target.user.userid = /\$$/
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users
    not $auth.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1134.003")
    $primary_entity = array_distinct(strings.coalesce($auth.target.hostname, $auth.principal.hostname))
    $impersonated_account = array_distinct($auth.target.user.userid)
    $initiating_account = array_distinct($auth.principal.user.userid)
    $initiating_process = array_distinct($auth.principal.process.file.full_path)
    $source_ips = array_distinct($auth.principal.ip)

  condition:
    $auth
}
