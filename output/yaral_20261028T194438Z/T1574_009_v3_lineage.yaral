/*
  MITRE Technique : T1574.009 - Path Interception by Unquoted Path
  Tactic(s)       : Stealth, Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:38:01.602111+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_009_Services_Spawns_Intercepted_Path_Binary {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Windows Service Control Manager (services.exe) launching an executable that sits directly in a drive root or directly in the root of Program Files / Program Files (x86). This is the process-lineage result of unquoted service path interception: Windows resolves a truncated path such as C:\\Program.exe or C:\\Program Files\\Common.exe, so the service starts a planted binary rather than the intended one. Legitimate services install into their own subdirectory."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.009"
    mitre_technique_name = "Hijack Execution Flow: Path Interception by Unquoted Path"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path populated (EDR, Sysmon Event ID 1, or Security Event 4688 with parent process name)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Poorly packaged legacy software or in-house services that install a service binary directly into the drive root or the Program Files root; some vendor installers or updaters that run a stub from the Program Files root; admin test services."
    tuning_guidance = "Add verified legitimate service binaries to %global_allowed_admin_tools (matched on child full path) or %global_allowed_security_tools. Review the matching service's ImagePath. If it is unquoted and contains spaces, fix it by quoting the path and remove any planted binary. Per-client exclusions for known legacy in-house services belong in the reference lists, not in the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\system32\\services\.exe$/ nocase
    $proc.target.process.file.full_path = /^[a-z]:\\(program files( \(x86\))?\\)?[^\\]+\.exe$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1574.009")
    $primary_entity = array_distinct($proc.principal.hostname)
    $child_path = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
