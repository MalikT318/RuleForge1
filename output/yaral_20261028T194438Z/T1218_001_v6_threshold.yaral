/*
  MITRE Technique : T1218.001 - Compiled HTML File
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:43:06.061763+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_001_Burst_CHM_File_Drops_Per_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Multiple compiled HTML (.chm) files are written to user-writable or staging locations on a single host within ten minutes. One help file landing on disk is normal, but a burst suggests a phishing or archive-based delivery of CHM payloads for later execution through the HTML Help binary. This is file-creation telemetry, so it does not duplicate process command-line detections."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.001"
    mitre_technique_name = "System Binary Proxy Execution: Compiled HTML File"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with target.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers or updaters unpacking documentation, developers building help files, IT staff distributing help content, users extracting archives that contain legitimate .chm documentation."
    tuning_guidance = "Add approved deployment or documentation tooling to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Raise the #file threshold in condition for noisy developer or packaging hosts. Severity scales in outcome with volume."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.chm$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(downloads|desktop|documents|appdata\\local\\temp|appdata\\roaming)|windows\\temp|programdata|temp|perflogs)\\/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $file_count = count($file.metadata.id)
    $risk_score = max(if($file_count >= 10, 80, 55))
    $mitre_technique_id = array_distinct("T1218.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $chm_paths = array_distinct($file.target.file.full_path)
    $dropping_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
