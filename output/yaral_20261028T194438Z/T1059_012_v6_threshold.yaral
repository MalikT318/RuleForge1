/*
  MITRE Technique : T1059.012 - Hypervisor CLI
  Tactic(s)       : Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Command and Scripting Interpreter
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:25:16.307423+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_012_ESXi_Burst_Host_Configuration_Changes {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of security-relevant configuration changes (shell/SSH, syslog forwarding, firewall, lockdown, authentication and advanced settings) on a single ESXi host within 10 minutes. Individual changes are routine, but several in quick succession are consistent with an adversary using hypervisor CLIs (esxcli, vim-cmd, shell) to weaken defences, disable logging and prepare for follow-on impact. This is volume-based coverage on SETTING_MODIFICATION events and does not depend on process command-line matching."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.012"
    mitre_technique_name = "Command and Scripting Interpreter: Hypervisor CLI"
    log_prerequisites = "ESXi hostd and shell logs forwarded and parsed into UDM as SETTING_MODIFICATION events, with the setting name populated in target.resource.name and the acting account in principal.user.userid."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Planned host build or remediation, host profile and desired-state remediation, patching and upgrade workflows, vendor lifecycle tooling, and administrators changing several settings in a maintenance window."
    tuning_guidance = "Add automation and lifecycle accounts to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Raise the #setting threshold for hosts that undergo frequent scripted configuration, or lower it for high-value hosts. Review the setting names in $changed_settings to decide whether the burst is a planned change."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.principal.hostname = $host
    $setting.target.resource.name = /(Syslog|Firewall|UserVars|Shell|SSH|Lockdown|Security|Auth|Account|ScratchConfig|Config\.HostAgent|Net\.|Misc\.)/ nocase
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($setting.metadata.id)
    $mitre_technique_id = array_distinct("T1059.012")
    $primary_entity = array_distinct($host)
    $acting_users = array_distinct($setting.principal.user.userid)
    $changed_settings = array_distinct($setting.target.resource.name)

  condition:
    #setting >= 5
}
