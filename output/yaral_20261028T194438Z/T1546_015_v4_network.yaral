/*
  MITRE Technique : T1546.015 - Component Object Model Hijacking
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:20:59.454696+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_015_COM_Host_Process_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a COM-hosting or COM-registration Windows binary (COM Surrogate dllhost, regsvr32, rundll32) opening a network connection to an external address. A hijacked COM registration, such as an InprocServer32 or TypeLib entry pointing to a remote scriptlet or a loaded malicious DLL, causes these hosts to reach out to attacker infrastructure. These binaries rarely make outbound internet connections in normal operation. This is a network-side detection and complements endpoint registry and command-line rules."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.015"
    mitre_technique_name = "Event Triggered Execution: Component Object Model Hijacking"
    log_prerequisites = "Requires endpoint network telemetry with process attribution (EDR network events or Sysmon Event ID 3) normalised to NETWORK_CONNECTION, with principal.process.file.full_path and target.ip populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "rundll32 or regsvr32 invoked by legitimate installers, software updaters or certificate and licence checks; dllhost.exe hosting shell extensions or media and thumbnail handlers that fetch remote content; RMM and deployment tools that register components from internet-hosted sources."
    tuning_guidance = "Add approved installer or deployment binaries to %global_allowed_admin_tools and approved vendor or update domains to %global_allowed_domains. Add EDR and AV agents to %global_allowed_security_tools. Add approved remote management tooling to %global_allowed_remote_mgmt. Review the destination IPs and hostname in the outcome, then pivot to registry changes under HKCU or HKLM Software\\Classes\\CLSID and TypeLib on the same host."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(dllhost|regsvr32|rundll32)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546.015")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $source_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
