/*
  MITRE Technique : T1134.002 - Create Process with Token
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:55:37.494776+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_002_SYSTEM_Interpreter_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Network-side indicator of process creation with a borrowed token: a command interpreter or script host running in the SYSTEM security context opens an outbound connection to a non-internal address. Interactive shells and script hosts running as SYSTEM are typical output of CreateProcessWithTokenW or token-duplication tradecraft after privilege escalation. This is a heuristic that complements endpoint process-lineage detections."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.002"
    mitre_technique_name = "Access Token Manipulation: Create Process with Token"
    log_prerequisites = "Requires endpoint network telemetry (EDR or Sysmon Event ID 3 equivalent) that populates the principal process path and principal user for NETWORK_CONNECTION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "RMM and patching agents that spawn PowerShell or cmd as SYSTEM and download content; software deployment and configuration management scripts; endpoint security agents using script hosts for updates; Windows telemetry or update scripts run by SYSTEM scheduled tasks."
    tuning_guidance = "Add approved tooling binaries to %global_allowed_admin_tools and %global_allowed_remote_mgmt. Add hosts that legitimately run SYSTEM scripts to %global_allowed_script_hosts. Add expected vendor destinations to %global_allowed_domains if the log source populates target.hostname. Consider raising severity for servers and domain controllers."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $net.principal.user.userid = /^(nt authority\\system|system)$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1134.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $process_paths = array_distinct($net.principal.process.file.full_path)
    $process_command_lines = array_distinct($net.principal.process.command_line)

  condition:
    $net
}
