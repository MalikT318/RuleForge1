/*
  MITRE Technique : T1106 - Native API
  Tactic(s)       : Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:01:35.287658+00:00
  Reference       : https://attack.mitre.org/techniques/T1106
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1106_Unexpected_Parent_Spawns_Shell_Or_Script_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter launched by a parent process that should never spawn one: an Office application, web server worker, print spooler, or database service. This lineage is a strong indicator that the parent was abused to reach native process-creation APIs (CreateProcess/NtCreateUserProcess) through macros, web shells, exploited services, or injected code. Detection relies on process lineage only, not on command-line content."
    mitre_tactic = "Execution"
    mitre_technique = "T1106"
    mitre_technique_name = "Native API"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry that populates both parent (principal.process) and child (target.process) image paths, from any EDR, Sysmon Event ID 1, or Security Event 4688 with parent process logging."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "SQL Server Agent CmdExec jobs and xp_cmdshell use by DBAs; IIS-hosted applications that intentionally shell out (legacy ASP/CGI, deployment hooks, health checks); Office add-ins, VBA automation or document-conversion workflows that launch cmd or PowerShell; print-management and driver-installation software invoked through the spooler; ERP or line-of-business apps built on Office automation."
    tuning_guidance = "Add approved parent processes that legitimately launch interpreters to %global_allowed_script_hosts. Add EDR and AV agents to %global_allowed_security_tools. Add approved deployment or RMM tooling to %global_allowed_admin_tools. If one parent family is too noisy for a client (for example sqlagent on database servers), remove it from the parent regex in a client-specific copy of the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat\d*|php-cgi|spoolsv|sqlservr|sqlagent)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|powershell_ise|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1106")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
