/*
  MITRE Technique : T1218.015 - Electron Applications
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:03:32.637419+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_015_Electron_App_Resource_Tampering_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of modifications to Electron application resource files (app.asar, app.asar.unpacked, or unpacked app/ JavaScript) on a single Linux host within 10 minutes. A single write can be a normal app update. Several in a short window, from a process that is not a package manager or approved tool, suggests an adversary planting malicious JavaScript inside a trusted Electron app for stealthy code execution."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.015"
    mitre_technique_name = "System Binary Proxy Execution: Electron Applications"
    log_prerequisites = "Requires Linux EDR or auditd file-modification telemetry with principal.hostname, target.file.full_path and the writing process path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Electron application auto-updaters, package managers or software deployment tools updating applications, developers rebuilding or repacking Electron apps locally, and CI build agents."
    tuning_guidance = "Add approved deployment and update tooling to %global_allowed_admin_tools. Add EDR or backup agents that touch application directories to %global_allowed_security_tools or %global_allowed_backup_processes. Add known service accounts to %global_allowed_service_accounts. Raise the #file threshold on developer workstations or build hosts."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\/resources\/(app\.asar(\.unpacked\/.*)?|app\/.*\.(js|mjs|cjs|json))$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|dnf|yum|zypper|snapd|packagekitd|flatpak|pacman)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1218.015")
    $primary_entity = array_distinct($host)
    $modified_files = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
