/*
  MITRE Technique : T1552.008 - Chat Messages
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:58:04.742204+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_008_Bulk_Chat_Message_Access_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single user performs a high volume of chat and channel message retrieval operations within ten minutes. Individual reads are normal, but bulk retrieval is consistent with an adversary or a malicious integration harvesting credentials, API keys or tokens shared in chat. Severity should be raised for accounts that also show anomalous sign-in activity."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.008"
    mitre_technique_name = "Unsecured Credentials: Chat Messages"
    log_prerequisites = "Unified audit logs for the collaboration suite ingested and normalised to UDM as USER_RESOURCE_ACCESS, with metadata.product_event_type populated with the audit operation name. Chat/message audit operations must be enabled in the tenant."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Compliance and eDiscovery export jobs, backup and archiving integrations, helpdesk or HR staff reviewing conversations during investigations, chat migration projects, and power users restoring large chat history on a new client."
    tuning_guidance = "Add archiving, eDiscovery and compliance service identities to %global_allowed_service_accounts, and named investigators to %global_allowed_admin_users. Add approved integration principals to %global_allowed_cloud_principals. Raise the #chat threshold if noisy, or lower it for high-risk groups. Escalate severity manually or in SOAR when the same user has anomalous logins, new OAuth consents or mailbox forwarding rules."

  events:
    $chat.metadata.event_type = "USER_RESOURCE_ACCESS"
    $chat.metadata.product_event_type = /(ChatRetrieved|MessagesListed|MessageHostedContent|ChatMessageRead|MessageRead|MessagesExported)/ nocase
    $chat.principal.user.userid = $user
    not $chat.principal.user.userid in %global_allowed_service_accounts
    not $chat.principal.user.userid in %global_allowed_admin_users
    not $chat.principal.user.userid in %global_allowed_cloud_principals

  match:
    $user over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($chat.metadata.id)
    $operations = array_distinct($chat.metadata.product_event_type)
    $source_ips = array_distinct($chat.principal.ip)
    $mitre_technique_id = array_distinct("T1552.008")
    $primary_entity = array_distinct($user)

  condition:
    #chat >= 25
}
