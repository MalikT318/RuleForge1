/*
  MITRE Technique : T1546.008 - Accessibility Features
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:10:26.348323+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_008_Accessibility_IFEO_Hijack_Then_Logon_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects an Image File Execution Options Debugger value being set for an accessibility binary (sethc, utilman, osk, narrator, magnify, displayswitch, atbroker), followed within 10 minutes by a command shell or script host spawned by winlogon or an accessibility binary on the same host. This is the sticky-keys / Utilman logon-screen backdoor pattern, which gives unauthenticated SYSTEM access."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.008"
    mitre_technique_name = "Event Triggered Execution: Accessibility Features"
    log_prerequisites = "Requires EDR or Sysmon registry-modification telemetry (Sysmon Event ID 13) and process-creation telemetry with parent process path (Sysmon Event ID 1 or Windows Event 4688 with command-line and parent logging)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Application-compatibility or debugging tooling that sets IFEO Debugger values on accessibility binaries, accessibility software or assistive-technology deployments that legitimately launch helper scripts from the logon screen, and administrators testing accessibility configuration or recovering a locked machine."
    tuning_guidance = "Add approved deployment or debugging tooling to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. The same lists are applied to the process that writes the registry value and to the parent of the spawned shell. Add the hosts that run approved logon-screen scripts to %global_allowed_script_hosts."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Image File Execution Options\\(sethc|utilman|osk|narrator|magnify|displayswitch|atbroker)\.exe$/ nocase
    $reg.target.registry.registry_value_name = "Debugger" nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winlogon|sethc|utilman|osk|narrator|magnify|displayswitch|atbroker)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    $proc.principal.hostname = $hostname

    $reg.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(92)
    $mitre_technique_id = array_distinct("T1546.008")
    $primary_entity = array_distinct($reg.principal.hostname)
    $hijacked_registry_keys = array_distinct($reg.target.registry.registry_key)
    $debugger_values = array_distinct($reg.target.registry.registry_value_data)
    $registry_writer_processes = array_distinct($reg.principal.process.file.full_path)
    $spawned_shells = array_distinct($proc.target.process.file.full_path)
    $spawning_parents = array_distinct($proc.principal.process.file.full_path)
    $first_registry_write = min($reg.metadata.event_timestamp.seconds)
    $last_shell_launch = max($proc.metadata.event_timestamp.seconds)

  condition:
    $reg and $proc
}
