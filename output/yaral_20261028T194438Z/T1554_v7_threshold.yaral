/*
  MITRE Technique : T1554 - Compromise Host Software Binary
  Tactic(s)       : Persistence
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:12:28.353318+00:00
  Reference       : https://attack.mitre.org/techniques/T1554
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1554_Mass_Installed_Binary_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of modifications to executables and libraries under Program Files or System32 on a single host within 10 minutes, by a process that is not a known installer, servicing component or approved tool. Each write is benign on its own, but many in a short window suggest trojanised host software binaries (patched application EXEs/DLLs, replaced client binaries) used for persistence."
    mitre_tactic = "Persistence"
    mitre_technique = "T1554"
    mitre_technique_name = "Compromise Host Software Binary"
    log_prerequisites = "Requires EDR or Sysmon file modification telemetry (Sysmon Event ID 11/23 equivalent) with principal process and target file path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Third-party software updaters, application self-patching, software deployment and patch tools (SCCM/Intune agents, package managers), Windows servicing stack, developer or build activity writing into install directories, and AV/EDR engine or signature updates."
    tuning_guidance = "Add approved deployment and patching binaries to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, and update or automation accounts to %global_allowed_service_accounts. Raise the #file threshold on hosts with frequent self-updating software. Lower it on high-value servers."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^[a-z]:\\(program files( \(x86\))?|windows\\system32)\\.+\.(exe|dll|sys|ocx)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\\(msiexec|trustedinstaller|tiworker|wusa|dismhost|musnotification|mousocoreworker|wuauclt|usoclient|msmpeng|mssense|senseir|svchost|setup)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1554")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $distinct_binaries = count_distinct($file.target.file.full_path)
    $modified_paths = array_distinct($file.target.file.full_path)
    $modifying_processes = array_distinct($file.principal.process.file.full_path)
    $modifying_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 10
}
