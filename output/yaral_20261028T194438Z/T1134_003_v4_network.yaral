/*
  MITRE Technique : T1134.003 - Make and Impersonate Token
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:57:35.774966+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_003_External_Windows_Auth_Protocol_From_Script_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, script host or LOLBin process making an outbound connection to a non-internal address on a Windows authentication or remote-management port (SMB, RPC, Kerberos, LDAP, WinRM). Make-and-impersonate-token activity (LogonUser with alternate credentials, e.g. NewCredentials logon type 9 or runas /netonly) is invisible locally because the token only changes outbound network identity, so this rule looks at where the credentialed traffic goes. Credentialed Windows protocols leaving the network from a script or shell process indicate credential use against attacker-controlled or exposed infrastructure."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.003"
    mitre_technique_name = "Access Token Manipulation: Make and Impersonate Token"
    log_prerequisites = "Requires EDR or Sysmon-style network telemetry (Sysmon Event 3 or equivalent) that populates the initiating process path, destination IP and destination port in UDM NETWORK_CONNECTION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or scripts managing cloud-hosted Windows servers over WinRM or SMB (Azure Files on 445, hybrid AD or LDAPS to cloud directory services), approved RMM or remote-support tools, VPN-less remote administration to public-IP lab hosts, and penetration tests."
    tuning_guidance = "Add approved admin and RMM binaries to %global_allowed_admin_tools and %global_allowed_remote_mgmt. Add automation accounts to %global_allowed_service_accounts. If the client uses cloud file shares or hybrid directory services, restrict the port list or raise severity only for 88, 135 and 5985/5986. Confirm %rfc1918_internal covers all client private ranges."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|rundll32|runas|mshta|regsvr32|wmic|msbuild|installutil)\.exe$/ nocase
    (
      $net.target.port = 445 or
      $net.target.port = 139 or
      $net.target.port = 135 or
      $net.target.port = 88 or
      $net.target.port = 389 or
      $net.target.port = 636 or
      $net.target.port = 3268 or
      $net.target.port = 5985 or
      $net.target.port = 5986
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1134.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
