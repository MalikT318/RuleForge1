/*
  MITRE Technique : T1564.004 - NTFS File Attributes
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:20:17.278775+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_004_Excessive_Alternate_Data_Stream_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a single host creating several NTFS Alternate Data Streams (file path of the form drive:\\path\\file:streamname) within ten minutes, excluding the common Zone.Identifier and shell-metadata streams. Individual ADS creation is routine, but repeated creation of non-standard streams by one host indicates data or payload hiding in NTFS file attributes."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.004"
    mitre_technique_name = "Hide Artifacts: NTFS File Attributes"
    log_prerequisites = "Requires endpoint file-stream telemetry (for example Sysmon Event ID 15 FileCreateStreamHash or EDR equivalent) normalised to UDM FILE_CREATION with the stream name retained in target.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and imaging software, antivirus and EDR agents writing scan metadata streams, cloud sync clients (OneDrive, Dropbox), file-server and DFS replication, Office and browser download handling that writes custom streams, software installers and package managers."
    tuning_guidance = "Add legitimate writer processes to %global_allowed_backup_processes, %global_allowed_security_tools or %global_allowed_admin_tools. Raise the #file threshold in the condition for noisy file servers. Extend the benign stream-name exclusion regex with additional stream names that are common in the client environment."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^[a-z]:\\[^:]*:[^\\:]+/ nocase
    not $file.target.file.full_path = /:(Zone\.Identifier|SmartScreen|encryptable|favicon|\$CmdTcID)(:\$DATA)?$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1564.004")
    $primary_entity = array_distinct($host)
    $stream_event_count = count($file.metadata.id)
    $stream_paths = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 5
}
