/*
  MITRE Technique : T1685.002 - Disable or Modify Cloud Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Identity Provider
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:18:46.618394+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_002_IdP_Audit_Logging_Disabled_Or_Bypassed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a tenant-level or per-identity change to the audit logging configuration in the identity and collaboration control plane, such as turning off the unified admin audit log, adding a mailbox to the audit bypass association, or disabling auditing for an account. These actions limit the telemetry captured about later activity and are a common precursor to mailbox, data or privilege abuse."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.002"
    mitre_technique_name = "Disable or Modify Cloud Log"
    log_prerequisites = "Requires ingestion of the tenant unified audit log (admin and exchange workloads) normalised to UDM SETTING_MODIFICATION events, with the operation name populated in metadata.product_event_type and the acting identity in principal.user.userid."
    platform = "Identity Provider"
    log_source = "m365"
    false_positives = "Planned audit policy changes by the security or compliance team, onboarding of service or shared mailboxes that are intentionally exempted from auditing (for example high-volume journaling or monitoring mailboxes), tenant migrations, and licensing changes made through approved automation."
    tuning_guidance = "Add named administrators who legitimately manage audit policy to %global_allowed_admin_users, and approved automation or provisioning identities to %global_allowed_service_accounts. Narrow or extend the operation-name regex on metadata.product_event_type to match the operation naming your tenant emits. Confirm any hit against the change-management record before closing."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(AuditLogConfig|MailboxAuditBypassAssociation|AuditBypass|AuditConfig|AuditDisabled|DisableAudit|AuditEnabled)/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685.002")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $operation = array_distinct($setting.metadata.product_event_type)
    $affected_identity = array_distinct($setting.target.user.userid)
    $source_ip = array_distinct($setting.principal.ip)

  condition:
    $setting
}
