/*
  MITRE Technique : T1055.001 - Dynamic-link Library Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:46:57.726651+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_001_Mass_Process_Injection_Volume_Per_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of cross-process injection events (remote thread creation, memory write or module mapping into another process) on a single host within ten minutes. One injection event can be benign, but repeated injection by non-allowlisted processes into other processes is consistent with DLL injection, reflective loading or module stomping."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.001"
    mitre_technique_name = "Process Injection: Dynamic-link Library Injection"
    log_prerequisites = "Requires Windows endpoint telemetry that normalises remote-thread, memory-write or image-injection activity to PROCESS_INJECTION (EDR or Sysmon-equivalent, for example Sysmon Event ID 8 CreateRemoteThread)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Endpoint security agents and EDR sensors, application-compatibility shims, accessibility and input-method software, game overlays, screen-capture and remote-support tools, DRM or anti-cheat software, debuggers and developer profilers, and software deployment agents."
    tuning_guidance = "Add legitimate injecting binaries to %global_allowed_security_tools, %global_allowed_admin_tools or %global_allowed_backup_processes. Raise the #inj threshold on hosts with developer tooling or heavy overlay software. Lower it to 3 on servers where injection is not expected."

  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.hostname = $host
    $inj.principal.process.file.full_path != ""
    $inj.target.process.file.full_path != ""
    $inj.principal.process.file.full_path != $inj.target.process.file.full_path
    not $inj.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|csrss|wininit|services)\.exe$/ nocase
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes

  match:
    $host over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1055.001")
    $primary_entity = array_distinct($host)
    $injection_count = count($inj.metadata.id)
    $injecting_processes = array_distinct($inj.principal.process.file.full_path)
    $injected_targets = array_distinct($inj.target.process.file.full_path)
    $affected_users = array_distinct($inj.principal.user.userid)

  condition:
    #inj >= 5
}
