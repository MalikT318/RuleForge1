/*
  MITRE Technique : T1091 - Replication Through Removable Media
  Tactic(s)       : Lateral Movement, Initial Access
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:33:46.438234+00:00
  Reference       : https://attack.mitre.org/techniques/T1091
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1091_Autorun_Inf_Written_To_NonSystem_Drive_Root {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of an autorun.inf file at the root of a non-system drive letter. This is the file artifact used to abuse Autorun/AutoPlay for replication through removable media. Detection is based on the resulting file state change, not on command-line arguments, so it still fires when command-line logging is evaded or the dropping process is renamed."
    mitre_tactic = "Lateral Movement, Initial Access"
    mitre_technique = "T1091"
    mitre_technique_name = "Replication Through Removable Media"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) normalised to UDM FILE_CREATION with target.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers or media-authoring tools that write autorun.inf to optical or USB media, IT imaging and provisioning of USB drives, kiosk or training USB builds, and legacy vendor tools that create an autorun.inf on mapped network or secondary drives."
    tuning_guidance = "Add approved media-creation or deployment tooling to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. For environments that use secondary fixed data drives, review the drive-letter pattern. Consider suppressing known provisioning hosts through the downstream SOAR playbook."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^[a-z]:\\autorun\.inf$/ nocase
    not $file.target.file.full_path = /^c:\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1091")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
