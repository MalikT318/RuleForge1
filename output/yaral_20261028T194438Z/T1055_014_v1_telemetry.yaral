/*
  MITRE Technique : T1055.014 - VDSO Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:02:42.052773+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_014_Linux_SharedObject_Staged_In_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of an ELF shared object (.so) in a world-writable staging directory (/tmp, /var/tmp, /dev/shm) by a process that is not a known compiler, linker, package manager or approved tool. VDSO hijacking and other ptrace-based injection techniques need a malicious shared object on disk that the hijacked syscall stubs can open() and mmap() into a live process. This rule detects that file artifact instead of the injection command line. It is a proxy for the technique and not direct proof of VDSO patching."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.014"
    mitre_technique_name = "Process Injection: VDSO Hijacking"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-write/watch rules on /tmp, /var/tmp and /dev/shm that populate principal.process.file.full_path and target.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software builds and CI runners compiling native extensions, language runtime package installs (pip, npm, gem native modules), JIT or plugin frameworks that unpack libraries to /tmp, installers and self-extracting archives, and developer workstations."
    tuning_guidance = "Add legitimate build, deployment and packaging binaries to %global_allowed_admin_tools. Add EDR or AV agents that stage libraries to %global_allowed_security_tools. Extend the compiler/package-manager regex for client-specific build tooling. Consider scoping or suppressing known build-server hosts."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+\.so(\.[0-9]+)*$/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path = /\/(ld|ld\.bfd|ld\.gold|gcc|g\+\+|cc|c\+\+|cc1|cc1plus|collect2|as|clang|rustc|cargo|go|dpkg|apt|apt-get|rpm|yum|dnf|zypper|snapd|make|cmake|ninja)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1055.014")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
