/*
  MITRE Technique : T1686 - Disable or Modify System Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:26:29.280090+00:00
  Reference       : https://attack.mitre.org/techniques/T1686
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_Linux_External_Inbound_To_Exposed_Service_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side indicator of Linux host firewall tampering. An external source reaches an internal host on a service port that is normally blocked from the Internet by a host firewall or perimeter policy (remote desktop, telnet, container API, kubelet, databases, caches, NFS, rpcbind). Once an adversary flushes, disables or loosens iptables, nftables, ufw or firewalld rules, these previously filtered ports become reachable from outside. The rule observes the perimeter side of that change and does not use endpoint process fields."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686"
    mitre_technique_name = "Disable or Modify System Firewall"
    log_prerequisites = "Firewall, proxy or perimeter flow logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. The log must be taken at a point where the traffic from the external source to the internal host is visible."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Intentionally published services (databases, VNC, Docker or Kubernetes APIs exposed for partners), authorised external vulnerability scans or penetration tests, remote administrators connecting from unlisted source addresses, internet-wide scanners that reach a deliberately open honeypot or DMZ host."
    tuning_guidance = "Add approved administrative source addresses to %global_allowed_mgmt_sources and authorised scanner sources to %global_allowed_scanners. Where a port is legitimately published, scope it out by adding the port to the clause below, or run this rule only against log sources for segments where those ports should be closed. Correlate hits with endpoint rules for iptables, nftables, ufw or firewalld changes on the same target host for higher confidence."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 23 or
      $net.target.port = 111 or
      $net.target.port = 2049 or
      $net.target.port = 2375 or
      $net.target.port = 2376 or
      $net.target.port = 3306 or
      $net.target.port = 3389 or
      $net.target.port = 5432 or
      $net.target.port = 5900 or
      $net.target.port = 5901 or
      $net.target.port = 6379 or
      $net.target.port = 9200 or
      $net.target.port = 10250 or
      $net.target.port = 27017
    )
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1686")
    $primary_entity = array_distinct($net.target.ip)
    $external_sources = array_distinct($net.principal.ip)
    $exposed_ports = array_distinct($net.target.port)

  condition:
    $net
}
