/*
  MITRE Technique : T1648 - Serverless Execution
  Tactic(s)       : Execution
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:50:18.232147+00:00
  Reference       : https://attack.mitre.org/techniques/T1648
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1648_Automation_Workflow_Created_Then_Connection_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A user creates a serverless automation resource (workflow, script project or low-code flow) and then modifies a connector, trigger, webhook or OAuth consent setting within 10 minutes. This pattern is consistent with an adversary using a compromised account to build a persistent, event-triggered execution or exfiltration channel inside the tenant."
    mitre_tactic = "Execution"
    mitre_technique = "T1648"
    mitre_technique_name = "Serverless Execution"
    log_prerequisites = "Requires unified audit logs for workflow and automation resource creation and tenant or user setting changes, normalised to USER_RESOURCE_CREATION and SETTING_MODIFICATION with principal.user.userid and target.resource.name populated."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Citizen developers and business-process owners building legitimate automations, IT or automation teams deploying approved workflows, onboarding of new connectors by administrators, and migration projects that bulk-create flows."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and automation or deployment identities to %global_allowed_service_accounts. If the tenant has many citizen developers, narrow the second event by tightening the connector, webhook or consent regex, or raise severity only when the user is not in an approved list."

  events:
    $create.metadata.event_type = "USER_RESOURCE_CREATION"
    $create.target.resource.name = /(flow|workflow|automation|apps?[ _-]?script|logic[ _-]?app|macro|bot)/ nocase
    $create.principal.user.userid = $userid
    not $create.principal.user.userid in %global_allowed_admin_users
    not $create.principal.user.userid in %global_allowed_service_accounts

    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.target.resource.name = /(connector|connection|webhook|http|trigger|oauth|consent|api[ _-]?access|external[ _-]?sharing)/ nocase
    $setting.principal.user.userid = $userid
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

    $create.metadata.event_timestamp.seconds <= $setting.metadata.event_timestamp.seconds

  match:
    $userid over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1648")
    $primary_entity = array_distinct($userid)
    $created_resources = array_distinct($create.target.resource.name)
    $modified_settings = array_distinct($setting.target.resource.name)
    $source_ips = array_distinct($create.principal.ip)
    $event_count = count($setting.metadata.id)

  condition:
    $create and $setting
}
