/*
  MITRE Technique : T1134 - Access Token Manipulation
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:51:47.625328+00:00
  Reference       : https://attack.mitre.org/techniques/T1134
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_SYSTEM_Interpreter_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a script interpreter or proxy-execution LOLBin running in the SYSTEM security context that makes a network connection to a non-internal address. Token theft or impersonation is commonly used to move from administrator to SYSTEM. The resulting SYSTEM-context shell, script host, or proxy binary then reaches out for C2, tool download, or exfiltration. Interactive shells and script hosts rarely run as SYSTEM and talk to external destinations in normal operations."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134"
    mitre_technique_name = "Access Token Manipulation"
    log_prerequisites = "Requires endpoint network telemetry with process attribution (EDR or Sysmon Event ID 3) that populates principal.user.userid and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "RMM and patching agents that run PowerShell or cmd as SYSTEM, software deployment scripts that download packages, Azure/Intune or SCCM-driven scripts, cloud-init-style provisioning scripts, and backup or monitoring agents that use rundll32 or PowerShell as SYSTEM."
    tuning_guidance = "Add approved RMM, deployment, or patching binaries to %global_allowed_admin_tools. Add known build, golden-image, or automation hosts to %global_allowed_script_hosts. Add vendor update and CDN domains to %global_allowed_domains. Add EDR/AV agents to %global_allowed_security_tools. Consider narrowing the interpreter list per client if a sanctioned SYSTEM-level script is noisy."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.user.userid = /^(nt authority\\)?system$/ nocase
    $net.principal.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1134")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_user = array_distinct($net.principal.user.userid)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $source_command_line = array_distinct($net.principal.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
