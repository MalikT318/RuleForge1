/*
  MITRE Technique : T1666 - Modify Cloud Resource Hierarchy
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:07:32.803475+00:00
  Reference       : https://attack.mitre.org/techniques/T1666
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1666_Cloud_Hierarchy_Change_Then_Resource_Deployment {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a cloud identity modifying the resource hierarchy (leaving or being removed from an organization, moving accounts, creating or deleting organizational units, management groups or subscriptions) and then creating compute or serverless resources within 10 minutes. This pattern matches subscription hijacking and organization-detachment abuse, where an adversary evades central policy and logging before deploying resources."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1666"
    mitre_technique_name = "Modify Cloud Resource Hierarchy"
    log_prerequisites = "Cloud control-plane audit logs (management and administrative events) ingested and normalised to UDM, with metadata.product_event_type and principal.user.userid populated. Organization-level or tenant-level trails must be enabled so hierarchy API calls are captured."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Planned cloud landing-zone or account-vending automation, cloud platform team reorganisations, mergers and acquisitions that move accounts or subscriptions, and CI/CD pipelines that create accounts and then bootstrap compute."
    tuning_guidance = "Add approved automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named platform administrators to %global_allowed_admin_users. Narrow the product_event_type regexes to the hierarchy and deployment APIs relevant to each client's cloud provider. Raise severity if the principal is also not in any allowlist and the source is external."

  events:
    $hier.metadata.event_type = "USER_RESOURCE_ACCESS"
    $hier.metadata.product_event_type = /(LeaveOrganization|RemoveAccountFromOrganization|MoveAccount|CreateAccount|CloseAccount|InviteAccountToOrganization|CreateOrganizationalUnit|DeleteOrganizationalUnit|DeleteOrganization|DetachPolicy|managementGroups\/(write|delete|subscriptions)|Microsoft\.Subscription\/(aliases\/write|cancel|rename|changeTenantRequest)|SetOrganizationPolicy|MoveFolder|CreateFolder|DeleteFolder|MoveProject|projects\.move)/ nocase
    $hier.principal.user.userid = $user
    not $hier.principal.user.userid in %global_allowed_admin_users
    not $hier.principal.user.userid in %global_allowed_service_accounts
    not $hier.principal.user.userid in %global_allowed_cloud_principals

    $create.metadata.event_type = "RESOURCE_CREATION"
    $create.metadata.product_event_type = /(RunInstances|CreateFunction|CreateCluster|CreateStack|virtualMachines\/write|virtualMachineScaleSets\/write|sites\/write|containerGroups\/write|instances\.insert|functions\.create|clusters\.create)/ nocase
    $create.principal.user.userid = $user
    not $create.principal.user.userid in %global_allowed_admin_users
    not $create.principal.user.userid in %global_allowed_service_accounts
    not $create.principal.user.userid in %global_allowed_cloud_principals

    $hier.metadata.event_timestamp.seconds <= $create.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1666")
    $primary_entity = array_distinct($user)
    $hierarchy_actions = array_distinct($hier.metadata.product_event_type)
    $deployment_actions = array_distinct($create.metadata.product_event_type)
    $source_ips = array_distinct($hier.principal.ip)
    $hierarchy_targets = array_distinct($hier.target.resource.name)
    $created_resources = array_distinct($create.target.resource.name)
    $deployment_count = count($create.metadata.id)

  condition:
    $hier and $create
}
