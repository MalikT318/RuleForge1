/*
  MITRE Technique : T1115 - Clipboard Data
  Tactic(s)       : Collection
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:23:43.328588+00:00
  Reference       : https://attack.mitre.org/techniques/T1115
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1115_Clipboard_Access_From_Anomalous_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter spawned by an Office application, web server, database service or print spooler whose command line reads or pipes data to the Windows clipboard (Get-Clipboard, gcb, .NET Clipboard class, piping to clip). These parents do not normally touch the clipboard, so this pattern indicates post-exploitation or macro-driven collection of clipboard data."
    mitre_tactic = "Collection"
    mitre_technique = "T1115"
    mitre_technique_name = "Clipboard Data"
    log_prerequisites = "Requires Windows process launch telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros or add-ins that legitimately copy data to the clipboard through a script, IT automation or deployment scripts launched by a web or database service, and admin tooling that pipes output to clip.exe from a service context."
    tuning_guidance = "Add approved parent process paths to %global_allowed_admin_tools or %global_allowed_script_hosts. Add known automation accounts to %global_allowed_service_accounts. Raise the risk score for web server and database parents and lower it for Office parents if a client uses sanctioned macros."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|php-cgi|tomcat[0-9]*|sqlservr|mysqld|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(get-clipboard|\bgcb\b|windows\.forms\.clipboard|clipboard\]::gettext|\|\s*clip(\.exe)?(\s|$)|\bclip(\.exe)?\s*<)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1115")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
