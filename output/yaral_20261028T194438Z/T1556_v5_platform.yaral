/*
  MITRE Technique : T1556 - Modify Authentication Process
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:13:40.569434+00:00
  Reference       : https://attack.mitre.org/techniques/T1556
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_Tenant_Authentication_Policy_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects tenant-level changes to the authentication control plane in office-suite audit logs: domain federation or authentication-type changes, per-user strong (MFA) authentication being disabled, and conditional-access or authentication-method policy updates. Adversaries use these changes to bypass MFA, add a rogue identity provider that mints trusted tokens, or weaken sign-in requirements for persistent access. This is additive to endpoint process rules because it covers the SaaS identity layer."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556"
    mitre_technique_name = "Modify Authentication Process"
    log_prerequisites = "Unified audit logs ingested with admin and directory-management operations normalised to SETTING_MODIFICATION, with the operation name populated in metadata.product_event_type and the actor in principal.user.userid."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Planned identity migrations (federation cutover, SSO onboarding), administrators rolling out or tuning MFA and conditional-access policies, break-glass account maintenance, identity governance or provisioning automation, and MFA reset during user device replacement."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users, automation identities to %global_allowed_service_accounts, and approved service principals to %global_allowed_cloud_principals. During planned identity projects, temporarily widen the exclusion lists or suppress by change-ticket window. If per-user MFA resets are noisy, remove 'strong authentication' from the regex and keep the federation and policy operations."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(set\s+federation\s+settings|set\s+domain\s+authentication|domain\s+authentication|federation\s+setting|disable\s+strong\s+authentication|(update|delete|set|remove)\w*\s+conditional\s+access\s+policy|(update|set)\w*\s+authentication\s+method(s)?\s+policy|(update|set)\w*\s+authentication\s+(strength\s+)?polic)/ nocase
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1556")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $operation = array_distinct($setting.metadata.product_event_type)
    $source_ip = array_distinct($setting.principal.ip)
    $target_setting = array_distinct($setting.target.resource.name)

  condition:
    $setting
}
