/*
  MITRE Technique : T1560.001 - Archive via Utility
  Tactic(s)       : Collection
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:58:35.733430+00:00
  Reference       : https://attack.mitre.org/techniques/T1560/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1560_001_Mass_Archive_File_Creation_Per_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of archive or compressed container files (zip, 7z, rar, cab, tar, gz and similar) being written on a single Windows host within 10 minutes. Creating one archive is routine, but several in a short window can indicate collected data being compressed and staged before exfiltration. This works from file-creation telemetry, so it does not depend on which utility created the archives or on process command lines."
    mitre_tactic = "Collection"
    mitre_technique = "T1560.001"
    mitre_technique_name = "Archive Collected Data: Archive via Utility"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) normalised to UDM FILE_CREATION with target.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and imaging software, software installers and updaters that unpack cabinet files, developers building packages or releases, build servers, admins preparing log bundles, users saving multiple downloads, and RMM or deployment agents staging packages."
    tuning_guidance = "Add backup agents to %global_allowed_backup_processes and deployment or patching tooling to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Raise the #file threshold on build servers and file servers. Extend the system-path exclusion if other installer-managed directories generate noise."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(zip|7z|rar|cab|tar|gz|tgz|bz2|xz)$/ nocase
    $file.principal.hostname = $host
    not $file.target.file.full_path = /\\windows\\(winsxs|installer|softwaredistribution|servicing)\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1560.001")
    $primary_entity = array_distinct($host)
    $archive_paths = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 5
}
