/*
  MITRE Technique : T1490 - Inhibit System Recovery
  Tactic(s)       : Impact
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:40:22.088252+00:00
  Reference       : https://attack.mitre.org/techniques/T1490
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1490_IaaS_Backup_Recovery_Config_Tampering {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects control-plane configuration changes that weaken or disable cloud recovery capabilities: backup plan or policy updates, backup vault policy changes, protected-item and soft-delete settings, bucket versioning changes, and database backup or retention modifications. Adversaries make these changes before destroying data so that recovery is not possible. Detection is at the configuration-change layer (SETTING_MODIFICATION), not at the command line, so it fires whether the change was made through the console, CLI, SDK, or Terraform."
    mitre_tactic = "Impact"
    mitre_technique = "T1490"
    mitre_technique_name = "Inhibit System Recovery"
    log_prerequisites = "Cloud control-plane audit logging (management/admin write events) ingested and normalised to UDM with metadata.product_event_type populated for the cloud audit log source. Management events must be enabled for all regions and subscriptions/projects."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Planned backup policy or retention changes by cloud or platform teams, infrastructure-as-code pipelines applying backup configuration, routine database maintenance that modifies instance settings, and bucket versioning changes during storage lifecycle projects. ModifyDBInstance-style events are the noisiest, so review the changed parameters in the alert."
    tuning_guidance = "Add CI/CD, IaC and automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Add named cloud/platform administrators to %global_allowed_admin_users. If database modify events are too noisy, remove the database modification alternation from the regex for that client. Correlate hits with recent deletion or encryption activity from the same principal."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /(UpdateBackupPlan|PutBackupVaultAccessPolicy|DeleteBackupVaultAccessPolicy|PutBackupVaultNotifications|DeleteBackupVaultNotifications|PutBucketVersioning|DeleteBucketLifecycle|PutBucketLifecycle|PutBucketLifecycleConfiguration|ModifyDBInstance|ModifyDBCluster|UpdateRecoveryPointLifecycle|RECOVERYSERVICES\/VAULTS\/BACKUPCONFIG\/WRITE|RECOVERYSERVICES\/VAULTS\/BACKUPPOLICIES\/WRITE|RECOVERYSERVICES\/VAULTS\/BACKUPFABRICS\/PROTECTIONCONTAINERS\/PROTECTEDITEMS\/WRITE|RECOVERYSERVICES\/VAULTS\/BACKUPSTORAGECONFIG\/WRITE|RECOVERYSERVICES\/VAULTS\/WRITE|sql\.instances\.patch|sql\.instances\.update|sql\.backupRuns\.delete|storage\.buckets\.update|storage\.buckets\.patch)/ nocase
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1490")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_operations = array_distinct($cloud.metadata.product_event_type)
    $affected_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
