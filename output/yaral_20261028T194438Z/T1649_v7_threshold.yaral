/*
  MITRE Technique : T1649 - Steal or Forge Authentication Certificates
  Tactic(s)       : Credential Access
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:52:41.281772+00:00
  Reference       : https://attack.mitre.org/techniques/T1649
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1649_IdP_Excessive_Certificate_Authentication {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single identity authenticates with certificate-based credentials (client certificate, X.509, smart card or PKINIT style sign-ins) many times within ten minutes. A single certificate sign-in is routine. A burst of them for one account can indicate a stolen or forged authentication certificate being replayed or tested, or automated abuse of certificate-bound credentials."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1649"
    mitre_technique_name = "Steal or Forge Authentication Certificates"
    log_prerequisites = "Identity provider sign-in logs normalised to UDM USER_LOGIN, with the authentication method or detail recorded in extensions.auth.auth_details or security_result.description."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Smart card or passwordless users re-authenticating across many applications, kiosk or VDI pools using certificate sign-in, device-certificate based automation, and integration or service accounts using mutual TLS."
    tuning_guidance = "Add service and automation identities to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Raise the #auth threshold for tenants with heavy smart card or passwordless usage. Check the $source_ips outcome and prioritise alerts with multiple distinct source addresses."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    (
      $auth.extensions.auth.auth_details = /(certificate|x\.?509|smart\s?card|pkinit|client[_\-\s]?cert)/ nocase or
      $auth.security_result.description = /(certificate|x\.?509|smart\s?card|pkinit|client[_\-\s]?cert)/ nocase
    )
    $auth.principal.user.userid = $user
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($auth.metadata.id)
    $mitre_technique_id = array_distinct("T1649")
    $primary_entity = array_distinct($user)
    $source_ips = array_distinct($auth.principal.ip)
    $target_apps = array_distinct($auth.target.application)

  condition:
    #auth >= 10
}
