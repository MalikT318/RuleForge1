/*
  MITRE Technique : T1190 - Exploit Public-Facing Application
  Tactic(s)       : Initial Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:36:23.430845+00:00
  Reference       : https://attack.mitre.org/techniques/T1190
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1190_Linux_Container_AppService_Spawns_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Internet-facing application service (web server, application runtime, or database daemon) spawning a shell or script interpreter inside a container or on a container host. Service processes rarely launch interactive shells during normal operation, so this lineage anomaly is a strong post-exploitation indicator of a web shell, RCE, or SQL-to-OS command execution. The rule matches parent-child process lineage only, not command-line content."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1190"
    mitre_technique_name = "Exploit Public-Facing Application"
    log_prerequisites = "Container runtime or host-level process telemetry normalised to UDM PROCESS_LAUNCH, with populated parent (principal.process.file.full_path) and child (target.process.file.full_path) executable paths."
    platform = "Linux"
    log_source = "container"
    false_positives = "Application images that shell out by design (entrypoint or wrapper scripts, Java or Node apps invoking sh for build or maintenance tasks), container health-check or readiness scripts launched by the service, database maintenance or backup hooks, and admin debugging sessions via exec into the service container."
    tuning_guidance = "Add legitimate wrapper or supervisor parents to %global_allowed_script_hosts. Add approved admin or maintenance tooling to %global_allowed_admin_tools. Add automation identities to %global_allowed_service_accounts. If java or node parents are noisy in a given client, scope them out by adding their parent paths to %global_allowed_script_hosts rather than editing the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|caddy|php-fpm[0-9.]*|php-cgi|tomcat[0-9]*|java|node|gunicorn|uwsgi|puma|unicorn|mysqld|mariadbd|postgres|mongod|redis-server)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|ash|zsh|ksh|csh|tcsh|busybox|perl|python[0-9.]*)$/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1190")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
