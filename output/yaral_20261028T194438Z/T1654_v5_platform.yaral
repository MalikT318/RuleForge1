/*
  MITRE Technique : T1654 - Log Enumeration
  Tactic(s)       : Discovery
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:59:24.199171+00:00
  Reference       : https://attack.mitre.org/techniques/T1654
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

// NOTE: The "alternate platform" angle conflicts with the mandatory Windows platform and log_source. Windows is kept.
// The variant pivots on PowerShell/.NET log readers (Get-WinEvent, Get-EventLog, EventLogReader) instead of wevtutil.
rule MSSP_T1654_PowerShell_Windows_Event_Log_Harvesting {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects PowerShell reading Windows event logs through Get-WinEvent, Get-EventLog or the .NET EventLog reader classes. The command must target a sensitive log (Security, Sysmon, PowerShell/Operational, RDP/Terminal Services) and either filter on authentication event IDs or export the results. This is typical of adversaries mining logon records, finding remote hosts, or watching for incident response activity."
    mitre_tactic = "Discovery"
    mitre_technique = "T1654"
    mitre_technique_name = "Log Enumeration"
    log_prerequisites = "Requires EDR or Sysmon process-launch telemetry with full command-line capture, or Windows Event 4688 with command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators troubleshooting logons, SIEM or log-forwarding helper scripts, compliance and audit collection scripts, RMM health checks, and help-desk lockout investigations."
    tuning_guidance = "Add approved admin tooling to %global_allowed_admin_tools and trusted parent processes or hosts to %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts. Encoded commands (-enc) hide the cmdlet names, so pair this rule with a PowerShell script-block logging rule for full coverage."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|powershell_ise)\.exe$/ nocase
    $proc.target.process.command_line = /(get-winevent|get-eventlog|eventlogreader|system\.diagnostics\.eventlog)/ nocase
    $proc.target.process.command_line = /(logname|path|eventlogquery|eventlog)?.{0,40}(security|sysmon|powershell\/operational|windows powershell|terminalservices|rdpcorets)/ nocase
    $proc.target.process.command_line = /(4624|4625|4648|4672|4768|4769|4776|4778|4779|1149|export-csv|out-file|convertto-json|convertto-csv|set-content|export-clixml)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1654")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
