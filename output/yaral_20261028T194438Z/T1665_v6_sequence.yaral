/*
  MITRE Technique : T1665 - Hide Infrastructure
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:05:56.460937+00:00
  Reference       : https://attack.mitre.org/techniques/T1665
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1665_ESXi_Firewall_Change_Then_SSH_Tunnel {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an ESXi host firewall configuration change followed within ten minutes by an SSH client launched with port-forwarding or dynamic SOCKS flags (-R, -L, -D) on the same host. This pattern indicates an adversary opening egress paths and then building a tunnel or proxy through the hypervisor to hide C2 infrastructure."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1665"
    mitre_technique_name = "Hide Infrastructure"
    log_prerequisites = "ESXi shell and hostd logs forwarded to Chronicle with process command-line capture, normalised to PROCESS_LAUNCH events."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators legitimately tunnelling to internal management or jump hosts, backup or monitoring tooling that opens firewall rulesets and then forwards ports, and scripted host-provisioning or remediation workflows."
    tuning_guidance = "Add approved admin accounts to %global_allowed_admin_users and approved automation binaries to %global_allowed_admin_tools. Add approved scripted callers to %global_allowed_script_hosts. Narrow the firewall regex or lengthen the window if the environment frequently uses SSH tunnels."

  events:
    $fw.metadata.event_type = "PROCESS_LAUNCH"
    $fw.target.process.command_line = /esxcli\s+network\s+firewall\s+(set|ruleset\s+(set|allowedip\s+(add|remove)))/ nocase
    $fw.principal.hostname = $host
    not $fw.principal.user.userid in %global_allowed_admin_users
    not $fw.principal.process.file.full_path in %global_allowed_script_hosts

    $tun.metadata.event_type = "PROCESS_LAUNCH"
    $tun.target.process.file.full_path = /\/ssh$/ nocase
    $tun.target.process.command_line = /\s-[a-zA-Z]*[RDL][a-zA-Z]*\s+\S+/
    $tun.principal.hostname = $host
    not $tun.principal.user.userid in %global_allowed_admin_users
    not $tun.principal.process.file.full_path in %global_allowed_admin_tools

    $fw.metadata.event_timestamp.seconds <= $tun.metadata.event_timestamp.seconds

  match:
    $host over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1665")
    $primary_entity = array_distinct($host)
    $firewall_commands = array_distinct($fw.target.process.command_line)
    $tunnel_commands = array_distinct($tun.target.process.command_line)
    $actor_users = array_distinct($tun.principal.user.userid)
    $event_count = count($tun.metadata.id)

  condition:
    $fw and $tun
}
