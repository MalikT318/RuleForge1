/*
  MITRE Technique : T1036.010 - Masquerade Account Name
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:12:36.239393+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_010_IdP_Masquerade_Account_Created_Then_Privileged {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a new identity account whose name imitates a generic, administrative or service-style account (admin, root, help, svc, backup, etc.) and which receives a permission or role change within 10 minutes of creation. Masquerade names combined with immediate privilege assignment are a strong sign of a persistence or stealth account."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.010"
    mitre_technique_name = "Masquerading: Masquerade Account Name"
    log_prerequisites = "Requires identity provider directory audit logs normalised to UDM USER_CREATION and USER_CHANGE_PERMISSIONS, with target.user.userid populated on both events."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Legitimate provisioning of service, break-glass, shared-mailbox or helpdesk accounts by IT; automated onboarding or SCIM/HR-driven provisioning that assigns roles immediately after creation; migration or tenant-consolidation projects."
    tuning_guidance = "Add approved provisioning operators to %global_allowed_admin_users, and automation or provisioning identities to %global_allowed_service_accounts. The account-name keyword list in the regex can be extended per customer naming conventions. Use the creator and role-assigner fields in the outcome to triage quickly."

  events:
    $create.metadata.event_type = "USER_CREATION"
    $create.target.user.userid = /(^|[._-])(admin|administrator|root|help|helpdesk|support|backup|svc|service|sysadmin|system|security|scanner|noreply)([._@0-9-]|$)/ nocase
    $create.target.user.userid = $account
    not $create.principal.user.userid in %global_allowed_admin_users
    not $create.principal.user.userid in %global_allowed_service_accounts
    not $create.target.user.userid in %global_allowed_service_accounts

    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.target.user.userid = /(^|[._-])(admin|administrator|root|help|helpdesk|support|backup|svc|service|sysadmin|system|security|scanner|noreply)([._@0-9-]|$)/ nocase
    $perm.target.user.userid = $account
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_service_accounts

    $create.metadata.event_timestamp.seconds <= $perm.metadata.event_timestamp.seconds

  match:
    $account over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1036.010")
    $primary_entity = array_distinct($account)
    $account_creators = array_distinct($create.principal.user.userid)
    $permission_changers = array_distinct($perm.principal.user.userid)
    $source_ips = array_distinct($create.principal.ip)
    $permission_event_count = count($perm.metadata.id)

  condition:
    $create and $perm
}
