/*
  MITRE Technique : T1213.002 - Sharepoint
  Tactic(s)       : Collection
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:25:30.271822+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_002_SaaS_Sensitive_Document_Download_From_Collaboration_Site {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a user downloading or syncing a document from a collaboration site (SharePoint) whose name indicates network diagrams, architecture documentation, runbooks, or credentials. Adversaries with a compromised account mine these repositories for details on internal infrastructure and for stored secrets. This is a cloud audit log detection that covers the Office Suite control plane, not endpoint process activity."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.002"
    mitre_technique_name = "Data from Information Repositories: Sharepoint"
    log_prerequisites = "Requires Microsoft 365 unified audit logs with SharePoint file operations (FileDownloaded, FileSyncDownloadedFull, FileAccessed) ingested and normalised to USER_RESOURCE_ACCESS. metadata.product_event_type must carry the operation name, and target.file.full_path and target.url must be populated."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Network and infrastructure engineers legitimately opening diagrams and runbooks; IT onboarding and documentation reviews; security and audit teams; DR exercises; migration or backup tooling that syncs whole libraries; users whose documents merely contain words such as 'password' (e.g. password policy documents)."
    tuning_guidance = "Add automation and migration accounts to %global_allowed_service_accounts. Add network, infrastructure, and security engineers to %global_allowed_admin_users. For noisy tenants, narrow the keyword regex to the credential terms only, or raise severity after enrichment shows the user is outside the owning team or the sign-in came from an unmanaged location."

  events:
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.metadata.product_event_type = /^(FileDownloaded|FileSyncDownloadedFull|FileAccessed)$/ nocase
    $access.target.url = /\/(sites|teams)\// nocase
    $access.target.file.full_path = /(network[ _-]?(diagram|topology|map)|topology|architecture|as[ _-]?built|runbook|run[ _-]book|vpn|firewall[ _-]?(rules|config)|ip[ _-]?(plan|schema|addressing)|password|passwd|credential|secret|api[ _-]?key|service[ _-]?account|break[ _-]?glass)/ nocase
    $access.principal.user.userid != ""
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1213.002")
    $primary_entity = array_distinct($access.principal.user.userid)
    $accessed_files = array_distinct($access.target.file.full_path)
    $site_urls = array_distinct($access.target.url)
    $source_ips = array_distinct($access.principal.ip)
    $operations = array_distinct($access.metadata.product_event_type)

  condition:
    $access
}
