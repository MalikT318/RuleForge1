/*
  MITRE Technique : T1187 - Forced Authentication
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:32:33.959309+00:00
  Reference       : https://attack.mitre.org/techniques/T1187
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1187_Outbound_SMB_To_External_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an internal host opening an SMB connection (TCP 445 or 139) to an external, non-RFC1918 destination through the network perimeter. Windows hosts authenticate automatically to SMB servers, so this is the main network-observable result of forced authentication (for example UNC links in documents, LNK/SCF icon paths or template injection), which exposes the user's NTLM hash to an attacker-controlled server. SMB should not normally leave the perimeter."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1187"
    mitre_technique_name = "Forced Authentication"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION or NETWORK_FLOW, with target.ip and target.port populated for egress traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate cloud file services reached over SMB (for example Azure Files), site-to-site or hybrid storage access that is not tunnelled, external vulnerability scanners or pentest sources, and misconfigured NAT or routing that makes internal addresses look external."
    tuning_guidance = "Add known-good external storage or vendor FQDNs to %global_allowed_domains, and add authorised scanner or testing hosts to %global_allowed_scanners. If the firewall does not log target.hostname, consider deploying this rule only for egress zones. Confirm %rfc1918_internal covers all of the client's internal address space."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 445 or $net.target.port = 139)
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1187")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
