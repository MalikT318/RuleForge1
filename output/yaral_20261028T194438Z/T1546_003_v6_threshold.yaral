/*
  MITRE Technique : T1546.003 - Windows Management Instrumentation Event Subscription
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:05:07.071976+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_003_WMI_MOF_File_Burst_Outside_System_Wbem {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Several MOF (Managed Object Format) files are written to disk on a single host within ten minutes, outside the standard Windows WBEM directory and by a non-approved writer. Adversaries stage MOF files and compile them with the WMI MOF compiler to register permanent event filters, consumers and bindings for persistence. A single MOF write is usually benign; a burst of them is not. This is file-creation telemetry, not process command-line matching."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.003"
    mitre_technique_name = "Event Triggered Execution: Windows Management Instrumentation Event Subscription"
    log_prerequisites = "Requires EDR or Sysmon-equivalent file creation telemetry (e.g. Sysmon Event ID 11) populating target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and driver packages that stage MOF files in temp or program directories, WMI provider developers, RMM or patching tools deploying WMI classes, and security or inventory agents that register WMI classes."
    tuning_guidance = "Add approved deployment, RMM and patching binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Raise the #mof threshold for noisy developer or build hosts. Add trusted installer parents to %global_allowed_script_hosts if needed."

  events:
    $mof.metadata.event_type = "FILE_CREATION"
    $mof.target.file.full_path = /\.mof$/ nocase
    not $mof.target.file.full_path = /\\windows\\(system32|syswow64)\\wbem\\/ nocase
    $mof.principal.hostname = $host
    not $mof.principal.process.file.full_path in %global_allowed_admin_tools
    not $mof.principal.process.file.full_path in %global_allowed_security_tools
    not $mof.principal.process.file.full_path in %global_allowed_script_hosts

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546.003")
    $primary_entity = array_distinct($host)
    $mof_file_count = count($mof.metadata.id)
    $mof_paths = array_distinct($mof.target.file.full_path)
    $writer_processes = array_distinct($mof.principal.process.file.full_path)
    $users = array_distinct($mof.principal.user.userid)

  condition:
    #mof >= 3
}
