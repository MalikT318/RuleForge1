/*
  MITRE Technique : T1602.002 - Network Device Configuration Dump
  Tactic(s)       : Collection
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:19:36.301503+00:00
  Reference       : https://attack.mitre.org/techniques/T1602/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_002_Network_Device_Config_Dump_Mgmt_Protocols {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects network-observable attempts to pull configuration from a network device over configuration-exposing management protocols. Any source outside the approved management list reaching the Smart Install service port (TCP 4786) is flagged. Connections from external (non-internal) sources to SNMP (161) or TFTP (69) are flagged too. These protocols let an adversary read or export running or startup configuration containing network layout and credentials."
    mitre_tactic = "Collection"
    mitre_technique = "T1602.002"
    mitre_technique_name = "Data from Configuration Repository: Network Device Configuration Dump"
    log_prerequisites = "Requires perimeter or internal segmentation firewall connection and flow logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs must cover traffic destined to network device management interfaces."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised network management or monitoring systems polling SNMP; configuration backup servers using TFTP; approved vulnerability scanners probing management ports; managed-service provider NOC tooling connecting from unlisted addresses; zero-touch provisioning servers using Smart Install during device rollouts."
    tuning_guidance = "Add NOC, NMS and configuration backup server addresses to %global_allowed_mgmt_sources. Add authorised scanner source addresses to %global_allowed_scanners. If internal SNMP polling is noisy, the SNMP and TFTP branch already requires an external source. Where Smart Install is not used at all, keep the rule as is, since any hit is high value."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 4786 or
      (
        ($net.target.port = 161 or $net.target.port = 69) and
        not $net.principal.ip in %rfc1918_internal
      )
    )
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(if($net.target.port = 4786, 90, 75))
    $mitre_technique_id = array_distinct("T1602.002")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
