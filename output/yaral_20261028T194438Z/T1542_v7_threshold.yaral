/*
  MITRE Technique : T1542 - Pre-OS Boot
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:41:58.441084+00:00
  Reference       : https://attack.mitre.org/techniques/T1542
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_Pre_OS_Boot_External_TFTP_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source repeatedly connects to external destinations on the TFTP port (69) within ten minutes. Network boot (PXE/TFTP) fetches boot images or firmware before the OS loads, and it should stay inside the internal network. Repeated egress of this protocol points to network-boot abuse, firmware or boot image retrieval, or tooling that tampers with pre-OS boot components. This is a perimeter-observable proxy for T1542. It cannot see firmware or bootloader modification on the host itself."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542"
    mitre_technique_name = "Pre-OS Boot"
    log_prerequisites = "Requires firewall or perimeter logs with source IP, destination IP and destination port populated, normalised to NETWORK_CONNECTION. Logs must be collected at the egress boundary so that internal PXE/TFTP traffic is not the only traffic seen."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Hardware vendor firmware or BIOS update utilities, remote or branch-office PXE/imaging servers reached through the perimeter, network-device configuration backups over TFTP, lab and provisioning environments, vulnerability or port scanners probing UDP 69."
    tuning_guidance = "Add approved provisioning, imaging or management source addresses to %global_allowed_mgmt_sources and scanner addresses to %global_allowed_scanners. Raise the threshold in the condition for sites with remote PXE deployment. Lower it to #net >= 2 for high-security segments where TFTP egress is never expected."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners
    $net.principal.ip = $src_ip

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1542")
    $primary_entity = array_distinct($src_ip)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    #net >= 3
}
