/*
  MITRE Technique : T1556.004 - Network Device Authentication
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:19:56.129153+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_004_External_Mgmt_Plane_Access_Network_Device {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects connections from non-internal source addresses to network device management-plane ports (SSH, Telnet, NETCONF over SSH, NETCONF over TLS). Implanted-password backdoors on network device images (Synful Knock style) give an operator access from outside the trusted management network without using normal credentials. The only network-observable trace is management-protocol sessions from sources that are not approved management addresses. This rule is firewall and perimeter based, so it adds coverage that endpoint process rules cannot provide."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.004"
    mitre_technique_name = "Modify Authentication Process: Network Device Authentication"
    log_prerequisites = "Firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logging must cover traffic to network device management interfaces, either on the perimeter or on an internal segmentation firewall."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Third-party managed-service or ISP staff administering customer-premises equipment, remote administrators connecting from unlisted addresses (home, VPN egress, jump hosts), unlisted vulnerability scanners and external attack-surface monitoring, and Internet-wide scanners and brute-force noise if denied connections are also logged."
    tuning_guidance = "Add approved management source addresses (jump hosts, VPN egress, NOC and MSP ranges) to %global_allowed_mgmt_sources. Add authorised scanners to %global_allowed_scanners. If denied or dropped traffic is logged, pre-filter it in the parser or with a security_result filter to cut Internet scan noise. Extend the port list per client if devices use non-standard management ports. Correlate hits with USER_LOGIN events on the device for confirmation."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 22 or $net.target.port = 23 or $net.target.port = 830 or $net.target.port = 992)
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1556.004")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $dest_ports = array_distinct($net.target.port)

  condition:
    $net
}
