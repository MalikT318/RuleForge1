/*
  MITRE Technique : T1564 - Hide Artifacts
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:12:49.738999+00:00
  Reference       : https://attack.mitre.org/techniques/T1564
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_002_Hidden_User_Account_Registry_SpecialAccounts {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry write under the Winlogon SpecialAccounts\\UserList key, which hides a local account from the logon screen and user lists. Adversaries use this to conceal backdoor accounts. This rule uses registry telemetry rather than process command lines, so it also catches the change when it is made through APIs, scripts, or renamed binaries."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.002"
    mitre_technique_name = "Hide Artifacts: Hidden Users"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR registry-set events or Sysmon Event ID 13) normalised to UDM REGISTRY_MODIFICATION with target.registry.registry_key populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Enterprise provisioning or imaging tools that hide service or kiosk accounts, approved IT automation hiding built-in admin accounts, and golden-image build pipelines."
    tuning_guidance = "Add approved provisioning or deployment binaries to %global_allowed_admin_tools and approved EDR/AV agents to %global_allowed_security_tools. Add automation accounts to %global_allowed_service_accounts. For kiosk or lab fleets that legitimately hide accounts, scope the exclusion by writing process rather than by host."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Winlogon\\SpecialAccounts\\UserList/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1564.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $hidden_account_name = array_distinct($reg.target.registry.registry_value_name)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
