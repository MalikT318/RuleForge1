/*
  MITRE Technique : T1684.001 - Impersonation
  Tactic(s)       : Stealth
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:31:00.014127+00:00
  Reference       : https://attack.mitre.org/techniques/T1684/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1684_001_Email_Impersonation_ReplyTo_Mismatch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects inbound email that uses urgency or payment-themed social engineering language and carries a Reply-To domain different from the From domain. This is the classic business email compromise impersonation pattern: the message appears to come from a trusted sender while replies are silently redirected to attacker-controlled infrastructure."
    mitre_tactic = "Stealth"
    mitre_technique = "T1684.001"
    mitre_technique_name = "Impersonation"
    log_prerequisites = "Requires mail transaction audit or message trace telemetry normalised to UDM EMAIL_TRANSACTION, with network.email.from, network.email.reply_to, network.email.subject and network.direction populated."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate marketing, ticketing, CRM, invoicing and e-signature platforms that send on behalf of a brand with a different Reply-To domain; mailing lists; third-party vendors using shared support mailboxes; shared-service finance providers."
    tuning_guidance = "Add known-good Reply-To domains (bulk senders, SaaS notification platforms, trusted vendors) to %global_allowed_domains. If network.direction is not populated for a tenant, review ingestion parsing before removing that condition. Extend or narrow the subject keyword set to match client business language."

  events:
    $email.metadata.event_type = "EMAIL_TRANSACTION"
    $email.network.direction = "INBOUND"
    $email.network.email.from != ""
    $email.network.email.reply_to != ""
    $email.network.email.subject = /\b(urgent|immediate|asap|payment|wire|transfer|invoice|remittance|overdue|bank\s+details?|account\s+change|gift\s*card|confidential|request)\b/ nocase
    strings.to_lower(re.capture($email.network.email.from, "@([^>\\s]+)")) != strings.to_lower(re.capture($email.network.email.reply_to, "@([^>\\s]+)"))
    not re.capture($email.network.email.reply_to, "@([^>\\s]+)") in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1684.001")
    $primary_entity = array_distinct($email.network.email.to)
    $sender_address = array_distinct($email.network.email.from)
    $reply_to_address = array_distinct($email.network.email.reply_to)
    $subject = array_distinct($email.network.email.subject)

  condition:
    $email
}
