/*
  MITRE Technique : T1552.007 - Container API
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:56:12.990179+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_007_External_Client_Reads_Container_API_Secrets_Or_Logs {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an HTTP request from a non-internal source to a Kubernetes API server, kubelet or Docker daemon endpoint that reads cluster secrets or container logs. Both are common ways to harvest credentials through the container management APIs, for example from an exposed daemon or a stolen service-account token used from outside the cluster. This is the network-side view and does not depend on endpoint process telemetry."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.007"
    mitre_technique_name = "Unsecured Credentials: Container API"
    log_prerequisites = "Requires HTTP-level visibility of container management API traffic, such as API server or ingress/proxy logs, service mesh telemetry, or network sensors with TLS inspection, normalised to NETWORK_HTTP with target.url populated."
    platform = "Containers"
    log_source = "container"
    false_positives = "External CI/CD runners, GitOps controllers, SaaS Kubernetes posture or backup tools, and cloud-hosted admin consoles that legitimately read secrets or logs through the API. Unmanaged jump hosts and NAT egress addresses can also appear as non-internal sources."
    tuning_guidance = "Add approved management source addresses to %global_allowed_mgmt_sources and authorised security testing sources to %global_allowed_scanners. Add automation identities to %global_allowed_service_accounts. Populate %rfc1918_internal with the client's internal address strings so internal traffic is excluded."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /(\/api\/v1\/(namespaces\/[^\/]+\/)?secrets(\/|\?|$)|\/containers\/[^\/]+\/logs|\/containerLogs\/)/ nocase
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1552.007")
    $primary_entity = array_distinct($net.target.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $requested_urls = array_distinct($net.target.url)
    $http_methods = array_distinct($net.network.http.method)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
