/*
  MITRE Technique : T1619 - Cloud Storage Object Discovery
  Tactic(s)       : Discovery
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:43:59.441915+00:00
  Reference       : https://attack.mitre.org/techniques/T1619
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1619_Cloud_Storage_Object_Enumeration_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single cloud identity issues a high volume of storage object or bucket listing API calls within ten minutes. Individual list calls are routine, but sustained enumeration across many buckets or prefixes is consistent with automated discovery ahead of data collection or exfiltration."
    mitre_tactic = "Discovery"
    mitre_technique = "T1619"
    mitre_technique_name = "Cloud Storage Object Discovery"
    log_prerequisites = "Cloud control-plane audit logs with data-event or object-level logging enabled for storage services, normalised to USER_RESOURCE_ACCESS with metadata.product_event_type populated with the API name."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Backup and replication jobs, data-lake and analytics query engines, storage lifecycle and inventory tooling, CI/CD pipelines syncing artifacts, cloud storage browser or console use by administrators, and cost or compliance scanners that crawl buckets."
    tuning_guidance = "Add automation and application identities to %global_allowed_service_accounts, approved service principals to %global_allowed_cloud_principals, and named administrators to %global_allowed_admin_users. The threshold (#cloud >= 30) is deliberately conservative; raise it for tenants with heavy automated listing, or lower it for high-sensitivity environments. Review the buckets_listed and source_ips outcome values to triage."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /(ListObjects|ListObjectsV2|ListObjectVersions|ListBuckets|ListBlobs|ListContainers|storage\.objects\.list|storage\.buckets\.list)/ nocase
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($cloud.metadata.id)
    $mitre_technique_id = array_distinct("T1619")
    $primary_entity = array_distinct($user)
    $buckets_listed = array_distinct($cloud.target.resource.name)
    $api_calls = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    #cloud >= 30
}
