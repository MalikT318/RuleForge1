/*
  MITRE Technique : T1098.006 - Additional Container Cluster Roles
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:48:30.748375+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_006_K8s_RBAC_Binding_Created_By_Non_Approved_Principal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a Kubernetes RoleBinding or ClusterRoleBinding object by a principal that is not an approved administrator, automation account, or built-in control-plane component. The rule fires on the resulting RBAC configuration state change in the API server audit trail, not on kubectl or process command lines, so it still fires when the binding is created through direct API calls, client libraries, or a compromised service-account token."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.006"
    mitre_technique_name = "Account Manipulation: Additional Container Cluster Roles"
    log_prerequisites = "Kubernetes API server audit logging enabled at Metadata level or higher and ingested into UDM as RESOURCE_CREATION events with target.url (request URI) and principal.user.userid populated. Managed cluster control-plane audit logs must be enabled for the RBAC group."
    platform = "Containers"
    log_source = "container"
    false_positives = "GitOps controllers and CI/CD pipelines applying RBAC manifests, Helm or operator installs that ship RoleBindings, namespace onboarding automation, cluster add-ons (ingress, monitoring, service mesh) creating bindings at install time, and platform engineers during planned access changes."
    tuning_guidance = "Add GitOps, deployment, and operator service account identifiers to %global_allowed_service_accounts. Add named cluster administrators to %global_allowed_admin_users. Review the namespace and requester in the outcome. A binding created for a recently created account, or one that grants cluster-wide roles, should be escalated."

  events:
    $res.metadata.event_type = "RESOURCE_CREATION"
    $res.target.url = /\/apis\/rbac\.authorization\.k8s\.io\/v1\/(namespaces\/[^\/]+\/)?(cluster)?rolebindings/ nocase
    $res.principal.user.userid != ""
    not $res.principal.user.userid = /^system:(kube-controller-manager|kube-scheduler|apiserver|node:|serviceaccount:kube-system:(clusterrole-aggregation-controller|generic-garbage-collector|namespace-controller))/ nocase
    not $res.principal.user.userid in %global_allowed_service_accounts
    not $res.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1098.006")
    $primary_entity = array_distinct($res.principal.user.userid)
    $binding_name = array_distinct($res.target.resource.name)
    $request_uri = array_distinct($res.target.url)
    $source_ips = array_distinct($res.principal.ip)
    $cluster_host = array_distinct($res.target.hostname)

  condition:
    $res
}
