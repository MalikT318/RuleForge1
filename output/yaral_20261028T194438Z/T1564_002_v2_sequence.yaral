/*
  MITRE Technique : T1564.002 - Hidden Users
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:15:34.414691+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_002_Linux_Account_Change_Then_Login_Hiding_Config {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a modification of the local account databases (/etc/passwd or /etc/shadow) followed within ten minutes, on the same host, by a change to a login-screen visibility configuration (AccountsService user files or LightDM user configuration). This sequence indicates an account was created or altered and then hidden from login greeters. It is file-telemetry based and complements command-line detections."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.002"
    mitre_technique_name = "Hide Artifacts: Hidden Users"
    log_prerequisites = "Requires Linux EDR or auditd file-integrity telemetry (FILE_MODIFICATION) covering /etc, /var/lib/AccountsService and /etc/lightdm. Auditd needs watch rules on those paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate user provisioning on desktop Linux hosts, configuration management (Ansible, Puppet, Chef) enrolling users and setting greeter options, package installs or upgrades of display managers, and first-boot or imaging scripts."
    tuning_guidance = "Add provisioning and configuration management binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Server fleets without a graphical display manager rarely match the second event, so this rule is low-noise there. Consider extending the second-event path regex if the environment uses other display managers."

  events:
    $acct.metadata.event_type = "FILE_MODIFICATION"
    $acct.target.file.full_path = /^\/etc\/(passwd|shadow)$/ nocase
    not $acct.principal.process.file.full_path in %global_allowed_admin_tools
    not $acct.principal.user.userid in %global_allowed_service_accounts
    $acct.principal.hostname = $hostname

    $hidden.metadata.event_type = "FILE_MODIFICATION"
    $hidden.target.file.full_path = /^\/(var\/lib\/AccountsService\/users\/[^\/]+|etc\/lightdm\/users\.conf|etc\/lightdm\/lightdm\.conf\.d\/.+)$/ nocase
    not $hidden.principal.process.file.full_path in %global_allowed_admin_tools
    not $hidden.principal.user.userid in %global_allowed_service_accounts
    $hidden.principal.hostname = $hostname

    $acct.metadata.event_timestamp.seconds <= $hidden.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1564.002")
    $primary_entity = array_distinct($hostname)
    $account_db_files = array_distinct($acct.target.file.full_path)
    $hiding_config_files = array_distinct($hidden.target.file.full_path)
    $acting_users = array_distinct($hidden.principal.user.userid)
    $acting_processes = array_distinct($hidden.principal.process.file.full_path)

  condition:
    $acct and $hidden
}
