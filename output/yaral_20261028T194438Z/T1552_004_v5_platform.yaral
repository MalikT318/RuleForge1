/*
  MITRE Technique : T1552.004 - Private Keys
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:51:23.613367+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_004_Linux_CLI_Client_Uploading_Private_Key_Material {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound HTTP POST or PUT from a command-line client typical of Linux hosts (curl, wget, Python and Perl HTTP libraries) where the request URL references private key or certificate material, such as default SSH key filenames or key and certificate extensions. This is the network-observable result of harvesting and exfiltrating private keys from a Linux host. It complements endpoint command-line detections by working from perimeter telemetry alone."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.004"
    mitre_technique_name = "Unsecured Credentials: Private Keys"
    log_prerequisites = "Requires proxy or firewall logs normalised to NETWORK_HTTP with network.http.method, network.http.user_agent and target.url populated. Egress HTTP must be visible in plaintext or through TLS inspection. Firewalls that cannot see URLs or user agents will not produce matches."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Administrators or automation (configuration management, certificate lifecycle scripts, ACME clients) publishing public certificates or keys to external vendors or SaaS. Backup or sync scripts that use curl to push key directories to an external store. Developers uploading public keys (.pem or .asc) to code hosting or key servers."
    tuning_guidance = "Add sanctioned external destinations (certificate authorities, vendor portals, key servers) to %global_allowed_domains. Exclude known egress sources with approved certificate automation via the %global_allowed_mgmt_sources reference list. If public-key uploads are noisy, tighten the URL regex to private-key-specific indicators (id_rsa, id_ed25519, .key, .ppk, .p12, .pfx)."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT)$/ nocase
    $net.network.http.user_agent = /^(curl|wget|python-requests|python-urllib|libwww-perl)/ nocase
    $net.target.url = /(id_(rsa|dsa|ecdsa|ed25519)|\.(pem|key|ppk|p12|pfx|gpg|pgp|asc)([?&#;]|$))/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1552.004")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
