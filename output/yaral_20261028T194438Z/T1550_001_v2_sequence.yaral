/*
  MITRE Technique : T1550.001 - Application Access Token
  Tactic(s)       : Lateral Movement
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:37:08.454365+00:00
  Reference       : https://attack.mitre.org/techniques/T1550/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1550_001_K8s_Secret_Read_Then_ServiceAccount_Token_Use_Same_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A human (non-system) identity reads Kubernetes secrets, and within 10 minutes a service account identity makes sensitive API calls (secrets, exec, attach) from the same source IP. This pattern suggests a service account token was extracted from a secret and replayed from the operator's own host, rather than being used by a workload inside the cluster."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1550.001"
    mitre_technique_name = "Use Alternate Authentication Material: Application Access Token"
    log_prerequisites = "Requires Kubernetes API server audit logs at Metadata level or higher, ingested and normalised to UDM. The source IP (principal.ip), the authenticated username (principal.user.userid) and the requested resource (target.resource.name) must be populated. The audit policy must record 'get' and 'list' on secrets."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Administrators or CI/CD runners that run kubectl with a service account kubeconfig from the same NAT or egress address as their own interactive session; GitOps and deployment tooling that reads secrets and then acts as a service account behind a shared proxy; break-glass troubleshooting."
    tuning_guidance = "Add approved administrator identities to %global_allowed_admin_users. Add automation service account identities to %global_allowed_service_accounts. If a shared NAT or bastion IP causes noise, extend the exclusions with additional service account names or narrow the target.resource.name regex on the $use event. Consider raising the window only after reviewing true-positive timing."

  events:
    $read.metadata.event_type = "USER_RESOURCE_ACCESS"
    $read.target.resource.name = /(^|\/)secrets($|\/)/ nocase
    $read.principal.user.userid != ""
    not $read.principal.user.userid = /^system:/ nocase
    not $read.principal.user.userid in %global_allowed_admin_users
    $read.principal.ip = $src_ip

    $use.metadata.event_type = "USER_RESOURCE_ACCESS"
    $use.principal.user.userid = /^system:serviceaccount:/ nocase
    $use.target.resource.name = /(^|\/)(secrets|pods\/exec|pods\/attach|serviceaccounts\/token)($|\/)/ nocase
    not $use.principal.user.userid in %global_allowed_service_accounts
    $use.principal.ip = $src_ip

    $read.metadata.event_timestamp.seconds <= $use.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1550.001")
    $primary_entity = array_distinct($use.principal.user.userid)
    $reading_users = array_distinct($read.principal.user.userid)
    $replayed_service_accounts = array_distinct($use.principal.user.userid)
    $accessed_resources = array_distinct($use.target.resource.name)
    $secret_read_count = count($read.metadata.id)

  condition:
    $read and $use
}
