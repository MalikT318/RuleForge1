/*
  MITRE Technique : T1036.009 - Break Process Trees
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:10:54.698067+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_009_Temp_Dropped_Binary_Reparented_To_Init {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a file written to a world-writable staging directory (/tmp, /var/tmp, /dev/shm) that is then executed within 10 minutes as a process whose parent is PID 1 (init/systemd). This is the result of a double-fork or daemon() call that orphans the payload so it is adopted by init, breaking the process tree. The rule correlates the drop and the orphaned execution of the same path on the same host, so it does not depend on command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.009"
    mitre_technique_name = "Masquerading: Break Process Trees"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that populates FILE_CREATION (target.file.full_path) and PROCESS_LAUNCH with parent process PID (principal.process.pid) and target process path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software installers or updaters that unpack helpers into /tmp and then start them as daemons, CI/CD or build agents, configuration management runs (Ansible, Puppet, Chef, Salt), self-extracting installers, and container runtimes or init-adopted jobs started from temp directories."
    tuning_guidance = "Add approved deployment or patching binaries to %global_allowed_admin_tools, which is checked against both the process that wrote the file and the launched binary. Add CI/build hosts' tooling to the same list. If a fleet legitimately runs daemons from a temp path, exclude that process path by adding it to %global_allowed_admin_tools. Raise severity if the launched path is also under a hidden directory."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+/ nocase
    $file.target.file.full_path = $path
    $file.principal.hostname = $hostname
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = $path
    $proc.principal.process.pid = "1"
    $proc.principal.hostname = $hostname
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1036.009")
    $primary_entity = array_distinct($hostname)
    $dropped_path = array_distinct($path)
    $dropper_process = array_distinct($file.principal.process.file.full_path)
    $orphaned_process_user = array_distinct($proc.principal.user.userid)
    $orphaned_command_line = array_distinct($proc.target.process.command_line)
    $first_drop_time = min($file.metadata.event_timestamp.seconds)
    $last_launch_time = max($proc.metadata.event_timestamp.seconds)

  condition:
    $file and $proc
}
