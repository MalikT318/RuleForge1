/*
  MITRE Technique : T1112 - Modify Registry
  Tactic(s)       : Defense Impairment, Persistence
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:12:28.934057+00:00
  Reference       : https://attack.mitre.org/techniques/T1112
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1112_Defender_Tamper_Then_Run_Key_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a registry write that disables Microsoft Defender protections, followed within 10 minutes on the same host by a registry write to an autorun (Run/RunOnce) key. Pairing defense impairment with persistence is a strong sign of malware staging, and it avoids the noise of either event alone. This rule uses registry telemetry only and does not duplicate command-line detections."
    mitre_tactic = "Defense Impairment, Persistence"
    mitre_technique = "T1112"
    mitre_technique_name = "Modify Registry"
    log_prerequisites = "Requires EDR or Sysmon registry modification telemetry (Sysmon Event ID 13 equivalent) populating target.registry.registry_key, target.registry.registry_value_name and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Third-party AV or EDR installers that disable Defender and register their own autorun entries during deployment; golden image build or sysprep activity; administrators running hardening or migration scripts; software installers writing Run keys shortly after a legitimate Defender policy change."
    tuning_guidance = "Add third-party AV/EDR agent binaries to %global_allowed_security_tools. Add deployment, imaging and RMM tools to %global_allowed_admin_tools. If installer noise persists, extend the persistence-side exclusion with additional trusted writers from %global_allowed_admin_tools."

  events:
    $impair.metadata.event_type = "REGISTRY_MODIFICATION"
    $impair.target.registry.registry_key = /\\Windows Defender(\\Real-Time Protection)?$/ nocase
    $impair.target.registry.registry_value_name = /^(DisableAntiSpyware|DisableAntiVirus|DisableRealtimeMonitoring|DisableBehaviorMonitoring|DisableOnAccessProtection|DisableIOAVProtection|DisableScriptScanning)$/ nocase
    not $impair.principal.process.file.full_path in %global_allowed_security_tools
    not $impair.principal.process.file.full_path in %global_allowed_admin_tools
    $impair.principal.hostname = $hostname

    $persist.metadata.event_type = "REGISTRY_MODIFICATION"
    $persist.target.registry.registry_key = /\\CurrentVersion\\Run(Once)?(\\|$)/ nocase
    not $persist.principal.process.file.full_path in %global_allowed_admin_tools
    not $persist.principal.process.file.full_path in %global_allowed_security_tools
    $persist.principal.hostname = $hostname

    $impair.metadata.event_timestamp.seconds <= $persist.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1112")
    $primary_entity = array_distinct($hostname)
    $tamper_values = array_distinct($impair.target.registry.registry_value_name)
    $tamper_processes = array_distinct($impair.principal.process.file.full_path)
    $autorun_keys = array_distinct($persist.target.registry.registry_key)
    $autorun_values = array_distinct($persist.target.registry.registry_value_name)
    $autorun_processes = array_distinct($persist.principal.process.file.full_path)
    $acting_users = array_distinct($persist.principal.user.userid)
    $persist_event_count = count($persist.metadata.id)

  condition:
    $impair and $persist
}
