/*
  MITRE Technique : T1059.007 - JavaScript
  Tactic(s)       : Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:17:12.804945+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_007_Linux_Bulk_JS_Staging_In_Temp_Dirs {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of JavaScript files (.js/.mjs/.cjs) written to world-writable staging directories (/tmp, /var/tmp, /dev/shm) on a single Linux host within 10 minutes. One dropped script is common, but repeated creation in volatile paths suggests staging of Node.js payloads, a dropper unpacking a JS toolchain, or a web-shell-driven loader. This rule is based on file-creation volume, so it adds coverage beyond process command-line rules."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.007"
    mitre_technique_name = "Command and Scripting Interpreter: JavaScript"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry normalised to UDM FILE_CREATION with principal.hostname and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "npm/yarn/pnpm package installs or builds that unpack to temp directories, CI/CD runners, Electron or Node application installers and updaters, developer workstations, configuration-management runs that render JS templates."
    tuning_guidance = "Add build agents, package managers and deployment tooling to %global_allowed_admin_tools or %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts. Raise the #file threshold on developer or CI hosts. Extend the node_modules/package-cache path exclusion if other package layouts generate noise."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+\.(js|mjs|cjs)$/ nocase
    not $file.target.file.full_path = /\/(node_modules|\.npm|npm-cache|\.yarn|\.pnpm-store)\// nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1059.007")
    $primary_entity = array_distinct($file.principal.hostname)
    $file_count = count($file.metadata.id)
    $staged_paths = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 8
}
