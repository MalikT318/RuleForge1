/*
  MITRE Technique : T1003.004 - LSA Secrets
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:42:53.790529+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_004_LSASS_Access_Then_Credential_Artifact_Written {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A non-allowlisted process opens a handle to the LSASS process and the same process then writes a credential-dump style artifact (memory dump file or exported SECURITY/SAM/SYSTEM registry hive) on the same host within 10 minutes. This sequence indicates extraction of LSA secrets or credential material from memory or the registry hives. It does not depend on process command-line matching."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.004"
    mitre_technique_name = "OS Credential Dumping: LSA Secrets"
    log_prerequisites = "Requires endpoint telemetry that records process-handle access (PROCESS_OPEN, e.g. Sysmon Event ID 10 or equivalent EDR) and file creation events (e.g. Sysmon Event ID 11 or equivalent EDR) with populated principal process paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and imaging agents, EDR/AV agents and crash-dump collectors that touch LSASS and write dump files, administrators legitimately exporting registry hives for troubleshooting or forensics, and authorised red-team or penetration-test activity."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools and backup or imaging software to %global_allowed_backup_processes. Add RMM and admin tooling to %global_allowed_admin_tools. If the file-extension pattern is too noisy for a client, narrow it to .dmp and hive-named files only. Verify that the client's EDR populates PROCESS_OPEN telemetry for LSASS before deployment."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\lsass\.exe$/ nocase
    not $open.principal.process.file.full_path = /\\(lsass|csrss|wininit|services|svchost|smss|lsm|winlogon|MsMpEng|MsSense|SenseIR|taskmgr)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    $open.principal.hostname = $hostname
    $open.principal.process.file.full_path = $proc_path

    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(\.(dmp|hiv|hive|sav|save)$|\\(security|sam|system)$)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    $file.principal.hostname = $hostname
    $file.principal.process.file.full_path = $proc_path

    $open.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname, $proc_path over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1003.004")
    $primary_entity = array_distinct($hostname)
    $accessing_process = array_distinct($proc_path)
    $accessing_user = array_distinct($open.principal.user.userid)
    $written_files = array_distinct($file.target.file.full_path)
    $lsass_open_count = count($open.metadata.id)

  condition:
    $open and $file
}
