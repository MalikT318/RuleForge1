/*
  MITRE Technique : T1560.002 - Archive via Library
  Tactic(s)       : Collection
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:59:12.054882+00:00
  Reference       : https://attack.mitre.org/techniques/T1560/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1560_002_Linux_Interpreter_Reads_Sensitive_Data_Then_Writes_Archive {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A scripting runtime (Python, Perl, Ruby, PHP, Node) reads sensitive data and then, in the same process, creates a compressed archive file in a world-writable staging directory within 10 minutes. This behaviour is typical of in-process archiving through libraries such as zipfile, tarfile, zlib, bz2 or libzip. It does not spawn zip, tar or gzip, so command-line rules miss it."
    mitre_tactic = "Collection"
    mitre_technique = "T1560.002"
    mitre_technique_name = "Archive Collected Data: Archive via Library"
    log_prerequisites = "Requires Linux EDR or auditd file telemetry that populates FILE_READ and FILE_CREATION events with the acting process path and PID."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup or log-rotation scripts written in Python or Perl, configuration management agents, developer build or packaging scripts, application deployment tooling and support-bundle collectors."
    tuning_guidance = "Add approved backup tooling to %global_allowed_backup_processes, approved automation interpreters or parent paths to %global_allowed_admin_tools, and known script or automation hosts to %global_allowed_script_hosts. Extend or narrow the sensitive path regex per client data layout. If FILE_READ telemetry is sparse on the client, confirm EDR file-read auditing is enabled before deploying."

  events:
    $read.metadata.event_type = "FILE_READ"
    $read.principal.process.file.full_path = /\/(python[0-9.]*|perl|ruby|php[0-9.]*|node|nodejs)$/ nocase
    $read.target.file.full_path = /^\/(home\/[^\/]+|root)\/(Documents|Desktop|\.ssh|\.aws|\.gnupg|\.kube)\/|^\/etc\/(shadow|passwd|ssh)|^\/var\/(www|backups|lib\/mysql|lib\/postgresql)\// nocase
    not $read.principal.process.file.full_path in %global_allowed_backup_processes
    not $read.principal.process.file.full_path in %global_allowed_admin_tools
    not $read.principal.hostname in %global_allowed_script_hosts
    $read.principal.hostname = $hostname
    $read.principal.process.pid = $pid

    $create.metadata.event_type = "FILE_CREATION"
    $create.principal.process.file.full_path = /\/(python[0-9.]*|perl|ruby|php[0-9.]*|node|nodejs)$/ nocase
    $create.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.*\.(zip|tar|tar\.gz|tgz|tar\.bz2|tbz2|bz2|gz|xz|7z|rar)$/ nocase
    not $create.principal.process.file.full_path in %global_allowed_backup_processes
    not $create.principal.process.file.full_path in %global_allowed_admin_tools
    not $create.principal.hostname in %global_allowed_script_hosts
    $create.principal.hostname = $hostname
    $create.principal.process.pid = $pid

    $read.metadata.event_timestamp.seconds <= $create.metadata.event_timestamp.seconds

  match:
    $hostname, $pid over 10m

  outcome:
    $risk_score = max(72)
    $mitre_technique_id = array_distinct("T1560.002")
    $primary_entity = array_distinct($create.principal.hostname)
    $interpreter = array_distinct($create.principal.process.file.full_path)
    $files_read = count($read.target.file.full_path)
    $sensitive_paths = array_distinct($read.target.file.full_path)
    $archive_paths = array_distinct($create.target.file.full_path)
    $acting_user = array_distinct($create.principal.user.userid)

  condition:
    $read and $create
}
