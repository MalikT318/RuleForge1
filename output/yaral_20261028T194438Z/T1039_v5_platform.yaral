/*
  MITRE Technique : T1039 - Data from Network Shared Drive
  Tactic(s)       : Collection
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:25:50.680172+00:00
  Reference       : https://attack.mitre.org/techniques/T1039
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1039_Linux_Network_Share_Data_Staged_To_Local_Temp {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a copy, sync or archive utility on Linux that reads from a network-mounted share path (SMB/NFS/gvfs/automount) and writes to a local staging directory (/tmp, /var/tmp, /dev/shm). This is typical of an adversary collecting files of interest from network shared drives before exfiltration."
    mitre_tactic = "Collection"
    mitre_technique = "T1039"
    mitre_technique_name = "Data from Network Shared Drive"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records with full command lines, normalised to UDM PROCESS_LAUNCH."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup or sync jobs run by users or cron, administrators migrating data from NFS/SMB shares, developers pulling build artifacts from shared storage, software deployment scripts staging packages in /tmp."
    tuning_guidance = "Add backup agents and sync tooling to %global_allowed_backup_processes. Add automation accounts to %global_allowed_service_accounts. Add approved admin or deployment tooling to %global_allowed_admin_tools. If the client uses custom mount point naming, extend the mount path regex for that client's convention."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(tar|zip|7z|7za|7zr|rsync|cp|cpio)$/ nocase
    $proc.target.process.command_line = /(\/run\/user\/[0-9]+\/gvfs\/(smb-share|nfs|sftp|afp)|\/net\/[^\s\/]+\/|\/mnt\/(nfs|smb|cifs|share|shares|nas|public)|\/media\/[^\s\/]+\/(share|shares|nas))/ nocase
    $proc.target.process.command_line = /(^|\s|=)\/(tmp|var\/tmp|dev\/shm)\// nocase
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1039")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
