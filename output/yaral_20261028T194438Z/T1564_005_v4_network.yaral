/*
  MITRE Technique : T1564.005 - Hidden File System
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:21:25.084367+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_005_Disk_Image_Download_By_NonBrowser {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a non-browser Windows process fetching a virtual disk or raw partition image (VHD, VHDX, VMDK, VDI, IMG, QCOW2) over HTTP from an external destination. Adversaries stage a portable partition image as a hidden file system to conceal malicious components and their file I/O. This is the network-side delivery step of that technique."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.005"
    mitre_technique_name = "Hide Artifacts: Hidden File System"
    log_prerequisites = "Requires HTTP telemetry with process attribution (EDR network sensor, Sysmon network events enriched with URL, or an inline proxy with endpoint correlation). Events must populate target.url and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "VM and VDI administrators pulling base images, software deployment or imaging tools, hypervisor and lab tooling, backup or recovery agents, and developers fetching test images with scripts or CLI downloaders."
    tuning_guidance = "Add approved imaging, deployment and virtualization binaries to %global_allowed_admin_tools. Add trusted vendor or image-repository domains to %global_allowed_domains. Add backup software to %global_allowed_backup_processes, and expand the browser exclusion regex if other sanctioned download clients are in use."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\.(vhd|vhdx|vmdk|vdi|img|qcow2)([?#].*)?$/ nocase
    $net.principal.process.file.full_path = /\\[^\\]+\.exe$/ nocase
    not $net.principal.process.file.full_path = /\\(chrome|msedge|firefox|iexplore|brave|opera)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1564.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $downloaded_urls = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)
    $source_processes = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
