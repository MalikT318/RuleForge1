/*
  MITRE Technique : T1557.003 - DHCP Spoofing
  Tactic(s)       : Credential Access, Collection
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:33:46.619179+00:00
  Reference       : https://attack.mitre.org/techniques/T1557/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1557_003_Rogue_DHCP_Server_Then_Client_Dependency {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a probable rogue DHCP server on a Windows network. A host that is not an approved DHCP source sends DHCP server-to-client traffic (UDP source port 67 to destination port 68). Within 10 minutes, other internal hosts then use that same address as a DNS or web destination, which is consistent with clients adopting the rogue host as gateway or DNS server (adversary-in-the-middle)."
    mitre_tactic = "Credential Access, Collection"
    mitre_technique = "T1557.003"
    mitre_technique_name = "Adversary-in-the-Middle: DHCP Spoofing"
    log_prerequisites = "Requires firewall or perimeter/internal-segment flow logs that record UDP 67/68 DHCP traffic and internal DNS/HTTP(S) connections, normalised to NETWORK_CONNECTION. Logs must come from a sensor that sees the client VLAN east-west traffic, not only the internet edge."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate DHCP servers or relays not yet in the allowlist, secondary or failover DHCP servers, routers or firewalls with DHCP service enabled, Windows Internet Connection Sharing or mobile hotspot hosts, lab and virtualisation hosts running DHCP, new site or VLAN rollouts."
    tuning_guidance = "Add approved DHCP server and relay addresses to %global_allowed_mgmt_sources. Add authorised test sources to %global_allowed_scanners. If the sensor only sees traffic from routed segments, confirm that DHCP relay addresses are in the allowlist."

  events:
    $dhcp.metadata.event_type = "NETWORK_CONNECTION"
    $dhcp.principal.port = 67
    $dhcp.target.port = 68
    $dhcp.network.ip_protocol = "UDP"
    not $dhcp.principal.ip in %global_allowed_mgmt_sources
    $dhcp.principal.ip = $rogue_ip

    $clt.metadata.event_type = "NETWORK_CONNECTION"
    ($clt.target.port = 53 or $clt.target.port = 80 or $clt.target.port = 443)
    $clt.target.ip = $rogue_ip
    $clt.principal.ip != $rogue_ip
    not $clt.principal.ip in %global_allowed_scanners

    $dhcp.metadata.event_timestamp.seconds <= $clt.metadata.event_timestamp.seconds

  match:
    $rogue_ip over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1557.003")
    $primary_entity = array_distinct($dhcp.principal.ip)
    $victim_ips = array_distinct($clt.principal.ip)
    $victim_count = count_distinct($clt.principal.ip)
    $victim_ports = array_distinct($clt.target.port)

  condition:
    $dhcp and $clt
}
