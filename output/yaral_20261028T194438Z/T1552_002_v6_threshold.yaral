/*
  MITRE Technique : T1552.002 - Credentials in Registry
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:48:19.870560+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_002_Registry_Credential_Value_Write_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of registry value writes on a single host where the value name indicates stored credentials (password, passwd, pwd, secret, credential) within 10 minutes. One write is routine application behaviour. Repeated writes by a non-allowlisted process indicate plaintext credentials being planted or staged in the registry, for example AutoAdminLogon DefaultPassword, or harvested material saved for later retrieval."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.002"
    mitre_technique_name = "Unsecured Credentials: Credentials in Registry"
    log_prerequisites = "Requires registry value-set telemetry from an EDR or Sysmon (registry events) that populates target.registry.registry_value_name and the initiating process path. Registry read or query operations are not logged by most sources, so this rule covers credential writes only."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters that write Password or Secret named values, RMM and deployment agents, enterprise applications saving connection settings, and admins configuring AutoAdminLogon on kiosks or lab machines."
    tuning_guidance = "Add approved deployment and IT tooling to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Raise the #reg threshold in noisy environments. Review the registry_keys and value_names outcome fields to identify benign application families and exclude them by process name."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_value_name = /(password|passwd|pwd|secret|credential)/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path = /\\(msiexec|MsMpEng|MsSense|TrustedInstaller|TiWorker)\.exe$/ nocase

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1552.002")
    $primary_entity = array_distinct($host)
    $event_count = count($reg.metadata.id)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $value_names = array_distinct($reg.target.registry.registry_value_name)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 5
}
