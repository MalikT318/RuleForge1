/*
  MITRE Technique : T1048.001 - Exfiltration Over Symmetric Encrypted Non-C2 Protocol
  Tactic(s)       : Exfiltration
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:35:16.014465+00:00
  Reference       : https://attack.mitre.org/techniques/T1048/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1048_001_ESXi_Burst_Inbound_SSH_Sessions_Bulk_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of SSH logins to a single ESXi host from addresses outside the approved management sources within ten minutes. Each scp, sftp or ssh-piped transfer opens its own SSH session, so a high session count on one host indicates bulk data being pulled off the hypervisor (VM disks, datastore files, configs) over an encrypted non-C2 channel. A single login is benign; the volume is the signal."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1048.001"
    mitre_technique_name = "Exfiltration Over Alternative Protocol: Exfiltration Over Symmetric Encrypted Non-C2 Protocol"
    log_prerequisites = "ESXi shell/auth and hostd logs forwarded and parsed to UDM USER_LOGIN with principal.ip, target.hostname and network.application_protocol populated for SSH sessions."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Backup and replication tooling that connects over SSH or SCP, admins copying ISOs or VMs between hosts, automation and configuration-management runs, vulnerability scanners performing authenticated checks, and SSH brute-force or password-spray noise if failed logins are also normalised as USER_LOGIN."
    tuning_guidance = "Add jump hosts and management stations to %global_allowed_mgmt_sources. Add backup and automation accounts to %global_allowed_service_accounts and named admins to %global_allowed_admin_users. Add scanner source addresses to %global_allowed_scanners. Raise the #auth threshold for environments with heavy scripted SSH use. If failed logins are also normalised as USER_LOGIN, pair this rule with an authentication-failure rule and add a result filter."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.network.application_protocol = "SSH"
    $auth.target.hostname = $host
    $auth.principal.ip != ""
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.principal.ip in %global_allowed_scanners
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(count($auth.metadata.id) >= 50, 85, if(count($auth.metadata.id) >= 25, 70, 55)))
    $mitre_technique_id = array_distinct("T1048.001")
    $primary_entity = array_distinct($host)
    $session_count = count($auth.metadata.id)
    $source_ips = array_distinct($auth.principal.ip)
    $login_users = array_distinct($auth.target.user.userid)

  condition:
    #auth >= 15
}
