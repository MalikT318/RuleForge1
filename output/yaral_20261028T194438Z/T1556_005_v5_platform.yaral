/*
  MITRE Technique : T1556.005 - Reversible Encryption
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:21:41.372381+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_005_GPO_SecEdit_Template_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of a Group Policy security template (GptTmpl.inf under SYSVOL Policies\\{GUID}\\Machine\\Microsoft\\Windows NT\\SecEdit). This file holds the 'Store passwords using reversible encryption' (ClearTextPassword) setting that adversaries can enable at domain or OU scope. T1556.005 is Windows-only, so this variant stays on Windows and gains coverage through file-modification telemetry on the policy store instead of process command lines. The file event does not expose file content, so analysts must confirm whether ClearTextPassword = 1 was written."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.005"
    mitre_technique_name = "Modify Authentication Process: Reversible Encryption"
    log_prerequisites = "Requires EDR or Sysmon file telemetry (FILE_MODIFICATION) from domain controllers and admin workstations that covers the SYSVOL share path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate GPO edits by domain administrators (password, lockout, or user-rights policy changes), GPO backup/restore and migration tooling, and domain controller SYSVOL replication writes (DFSR/FRS)."
    tuning_guidance = "Add approved GPO management tooling to %global_allowed_admin_tools and named domain administrators to %global_allowed_admin_users. Add automation accounts to %global_allowed_service_accounts. On DCs where replication writes are noisy, confirm the replication process is in %global_allowed_admin_tools. Triage by checking the changed template for ClearTextPassword = 1."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\\policies\\\{[0-9a-f\-]+\}\\machine\\microsoft\\windows nt\\secedit\\gpttmpl\.inf$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1556.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)
    $acting_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
