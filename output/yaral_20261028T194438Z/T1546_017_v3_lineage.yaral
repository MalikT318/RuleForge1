/*
  MITRE Technique : T1546.017 - Udev Rules
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:24:27.307838+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/017
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_017_Udev_Rules_Anomalous_Parent_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter that references udev rule directories or udevadm reload/trigger actions and was spawned by a service parent that should never manage udev (web server, application runtime, database, print service). This lineage anomaly indicates a compromised service writing a udev RUN+= persistence rule."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1546.017"
    mitre_technique_name = "Event Triggered Execution: Udev Rules"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry normalised to UDM PROCESS_LAUNCH with populated parent process path (principal.process.file.full_path), child process path and command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Application installers or configuration-management hooks run from a service context (for example a Java or Node-based management agent that provisions device rules), database or print-server packages that install device rules during upgrades, and containerised deployment tooling that runs as a service parent."
    tuning_guidance = "Add legitimate provisioning agents to %global_allowed_admin_tools, approved automation parents to %global_allowed_script_hosts, and approved remote management tooling to %global_allowed_remote_mgmt. If the parent list is too noisy for a client, remove generic runtimes (java, node) from the parent regex locally."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|php-fpm[0-9.]*|lighttpd|caddy|tomcat[0-9]*|java|node|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|cups-browsed|smbd)$/ nocase
    $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|ash|python[0-9.]*|perl|ruby|php[0-9.]*)$/ nocase
    $proc.target.process.command_line = /(\/udev\/rules\.d\/|udevadm\s+(control|trigger|test))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1546.017")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
