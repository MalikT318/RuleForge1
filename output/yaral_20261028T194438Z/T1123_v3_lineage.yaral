/*
  MITRE Technique : T1123 - Audio Capture
  Tactic(s)       : Collection
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:29:30.004375+00:00
  Reference       : https://attack.mitre.org/techniques/T1123
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1123_Linux_Unexpected_Parent_Spawns_Audio_Capture {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a service-class process (web server, application server, database, print or cache service) spawning a shell, script interpreter or audio capture utility whose command line records from an ALSA, PulseAudio or OSS sound device. Server daemons have no legitimate reason to record microphone audio, so this lineage suggests a web shell or compromised service performing audio capture."
    mitre_tactic = "Collection"
    mitre_technique = "T1123"
    mitre_technique_name = "Audio Capture"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to UDM PROCESS_LAUNCH with parent path, child path and full command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Telephony, VoIP or call-recording servers that use a web or application server to launch recorders; speech-to-text or transcription services running under a Java or Node.js runtime; media or conferencing appliances; developer or QA hosts testing audio pipelines."
    tuning_guidance = "Add approved parent processes (for example a sanctioned call-recording service runtime) to %global_allowed_script_hosts, and add hosts that legitimately record audio to the same list. If Java or Node.js runtimes are noisy, narrow the parent regex on those hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|php-cgi|php[0-9.]*|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|cupsd)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ksh|python[0-9.]*|perl|ruby|arecord|parecord|parec|ffmpeg|sox|rec)$/ nocase
    $proc.target.process.command_line = /(\barecord\b|\bparecord\b|\bparec\b|\bffmpeg\b.*-f\s+(alsa|pulse|oss)|\bsox\b.*(-d\b|-t\s+(alsa|pulseaudio|oss))|\/dev\/snd\/|\/dev\/dsp|-D\s+(plug)?hw:[0-9])/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1123")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
