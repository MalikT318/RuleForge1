/*
  MITRE Technique : T1218.014 - MMC
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:00:27.307509+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_014_MSC_File_Dropped_User_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a Microsoft Management Console (.msc) file in a user-writable or staging location (user profile download/desktop/AppData folders, Public, ProgramData, Temp) by a process other than mmc.exe. Attackers stage custom .msc consoles in these locations before using mmc.exe to proxy execution of malicious snap-ins or embedded content. Detection is based on the resulting file artifact, so it is independent of command-line logging."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.014"
    mitre_technique_name = "System Binary Proxy Execution: MMC"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR file events or Sysmon Event ID 11) normalised to UDM FILE_CREATION with target.file.full_path and principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT administrators or deployment tooling copying custom admin consoles to user profiles or ProgramData; software installers that ship .msc consoles via Temp extraction; users saving legitimate .msc files from internal portals or email attachments; profile-migration and backup-restore tools."
    tuning_guidance = "Add approved deployment/RMM binaries to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. If a specific installer extracts .msc files to Temp regularly, add its executable to %global_allowed_admin_tools rather than excluding by path. Consider correlating with a subsequent mmc.exe launch on the same host for higher-fidelity alerting."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.msc$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(downloads|desktop|appdata)|users\\public|programdata|windows\\temp|temp)\\.*\.msc$/ nocase
    not $file.principal.process.file.full_path = /\\mmc\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1218.014")
    $primary_entity = array_distinct($file.principal.hostname)
    $msc_path = array_distinct($file.target.file.full_path)
    $creator_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
