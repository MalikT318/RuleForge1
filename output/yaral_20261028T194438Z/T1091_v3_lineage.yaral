/*
  MITRE Technique : T1091 - Replication Through Removable Media
  Tactic(s)       : Lateral Movement, Initial Access
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:34:04.357227+00:00
  Reference       : https://attack.mitre.org/techniques/T1091
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1091_Explorer_Spawns_Interpreter_Removable_Media_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Windows shell (explorer.exe) spawning a command or script interpreter whose command line points at a non-system drive letter, an autorun.inf reference, or the %cd% working-directory token. This lineage matches AutoRun-style execution and malicious shortcut (LNK) launchers on USB or other removable media, where the user double-clicks a file and the shell hands off to cmd, PowerShell, or a script host that runs a payload from the media."
    mitre_tactic = "Lateral Movement, Initial Access"
    mitre_technique = "T1091"
    mitre_technique_name = "Replication Through Removable Media"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Users running installers or batch files from legitimately attached USB drives, optical media, or mapped network drives; IT staff launching scripts from a USB toolkit; software deployed from mounted ISO images; login scripts on mapped drive letters launched via the shell."
    tuning_guidance = "Add approved tooling binaries to %global_allowed_admin_tools and admin accounts to %global_allowed_admin_users. Add hosts or parent processes that legitimately run scripts to %global_allowed_script_hosts. If mapped network drives cause noise, narrow the drive-letter range in the regex to the letters that are not used for network mappings at that client."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\explorer\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32)\.exe$/ nocase
    $proc.target.process.command_line = /(\b[d-z]:\\|autorun\.inf|%cd%)/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1091")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
