/*
  MITRE Technique : T1570 - Lateral Tool Transfer
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:14:40.664049+00:00
  Reference       : https://attack.mitre.org/techniques/T1570
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1570_Linux_Transfer_Daemon_Drops_Executable_In_Staging_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a native file-transfer service or utility (SFTP/SCP server, rsync, Samba, FTP/TFTP daemons) creating a script, binary, shared object or hidden file in a world-writable staging directory (/tmp, /var/tmp, /dev/shm). This is the file artifact left on the receiving host when a tool is pushed laterally. It works at the FILE_CREATION layer, so it still fires if command-line logging is evaded or the client binary is renamed on the sending host."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1570"
    mitre_technique_name = "Lateral Tool Transfer"
    log_prerequisites = "Linux EDR or auditd file-creation telemetry (e.g. watches on /tmp, /var/tmp, /dev/shm) that populates the creating process path (principal.process.file.full_path) and the created file path (target.file.full_path)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Admins or deployment pipelines pushing scripts through SFTP/rsync to /tmp for staged installs; configuration management and software distribution tools; backup or sync jobs using rsync with temp files; developers uploading test scripts; Samba shares exported from /tmp or /var/tmp."
    tuning_guidance = "Add approved deployment and automation accounts to %global_allowed_service_accounts. Add approved transfer or orchestration binaries to %global_allowed_admin_tools. If rsync or Samba is used legitimately for large sync jobs, restrict by account or host through these lists rather than removing the process from the rule."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(sftp-server|scp|rsync|smbd|vsftpd|proftpd|pure-ftpd|in\.tftpd|atftpd)$/ nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/(.*\.(sh|py|pl|rb|so|elf|bin|run|out)|(.*\/)?\.[^\/]+)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1570")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_files = array_distinct($file.target.file.full_path)
    $transfer_processes = array_distinct($file.principal.process.file.full_path)
    $acting_users = array_distinct($file.principal.user.userid)

  condition:
    $file
}
