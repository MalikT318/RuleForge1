/*
  MITRE Technique : T1197 - BITS Jobs
  Tactic(s)       : Stealth, Persistence, Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:46:56.536433+00:00
  Reference       : https://attack.mitre.org/techniques/T1197
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1197_BITS_Network_Executable_Download_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects HTTP traffic carrying the Microsoft BITS user agent from a Windows host to an external destination, where the requested URL points to an executable, script, installer or archive payload. This is the network-side footprint of BITS job abuse for ingress tool transfer or persistence. It complements process command-line detections by observing the transfer itself, which BITS performs through the service host rather than the tool that created the job."
    mitre_tactic = "Stealth, Persistence, Execution"
    mitre_technique = "T1197"
    mitre_technique_name = "BITS Jobs"
    log_prerequisites = "Requires NETWORK_HTTP telemetry with the HTTP user agent and URL populated, for example from a TLS-inspecting proxy, secure web gateway, network sensor, or EDR with HTTP visibility. Plain HTTP or decrypted HTTPS is needed to see the user agent."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software deployment and patching agents that fetch installers or MSI packages through BITS from vendor CDNs; Microsoft and third-party updaters that use BITS to download executables; endpoint management tools staging packages from external repositories."
    tuning_guidance = "Add known-good vendor and update hostnames to %global_allowed_domains. Add deployment and patching tooling to %global_allowed_admin_tools. Add automation identities to %global_allowed_service_accounts. If proxy logs do not populate the principal process, rely on the domain and user exclusions."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /Microsoft\s+BITS/ nocase
    $net.target.url = /\.(exe|dll|ps1|bat|cmd|vbs|vbe|js|jse|hta|scr|msi|msix|sct|zip|7z|iso)(\?.*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1197")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
