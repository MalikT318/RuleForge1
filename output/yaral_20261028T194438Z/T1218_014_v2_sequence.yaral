/*
  MITRE Technique : T1218.014 - MMC
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:00:44.162323+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_014_MMC_Dropped_MSC_Then_Shell_Child {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A .msc console file is written to a user-writable location and, within ten minutes on the same host, mmc.exe spawns a shell, script host or LOLBin child process. This sequence is consistent with an attacker staging a malicious console file and using MMC to proxy execution. It adds file-staging plus process-lineage coverage and does not depend on matching the mmc command line."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.014"
    mitre_technique_name = "System Binary Proxy Execution: MMC"
    log_prerequisites = "Requires endpoint file-creation telemetry (e.g. Sysmon Event ID 11 or EDR file events) and process-launch telemetry with populated parent process paths (e.g. Sysmon Event ID 1, Windows Event 4688 with parent info, or EDR process events)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators who download or save custom .msc consoles and launch tools from them; software installers that drop .msc shortcuts to ProgramData or Temp; IT deployment scripts that copy management consoles; helpdesk workflows that open a command prompt from an MMC snap-in."
    tuning_guidance = "Add approved deployment or RMM binaries to %global_allowed_admin_tools (matched against the file-writing process and the child process). Add named administrators to %global_allowed_admin_users. If a client legitimately stages .msc files in ProgramData, narrow the path regex for that tenant."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.msc$/ nocase
    $file.target.file.full_path = /\\users\\[^\\]+\\(appdata|downloads|desktop|documents)\\|\\windows\\temp\\|\\users\\public\\|\\programdata\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\mmc\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|wmic)\.exe$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1218.014")
    $primary_entity = array_distinct($proc.principal.hostname)
    $msc_files = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $child_processes = array_distinct($proc.target.process.file.full_path)
    $child_command_lines = array_distinct($proc.target.process.command_line)
    $affected_users = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
