/*
  MITRE Technique : T1564.001 - Hidden Files and Directories
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:15:03.711470+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_001_Explorer_Hidden_File_Settings_Tampering_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects several registry modifications to the Explorer Advanced view settings that control hidden-file visibility (Hidden, ShowSuperHidden, HideFileExt, SuperHidden). They are made by a non-Explorer process on a single host within 10 minutes. One such change can be benign. A burst of them from a script, installer or malware conceals hidden and system-hidden files from the user and weakens the user's ability to see attacker-staged files."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.001"
    mitre_technique_name = "Hide Artifacts: Hidden Files and Directories"
    log_prerequisites = "Requires Windows endpoint registry-modification telemetry (EDR or Sysmon registry events) populating target.registry.registry_key, target.registry.registry_value_name and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Corporate GPO or logon scripts that standardise Explorer view settings, user-profile provisioning and imaging tools, software installers that reset folder options, helpdesk or RMM scripts enabling hidden-file visibility for troubleshooting, and profile migration tools."
    tuning_guidance = "Add approved deployment, RMM and profile-management binaries to %global_allowed_admin_tools. Add named administrators to %global_allowed_admin_users. Raise the #reg threshold in noisy environments with logon-script-driven settings. Because explorer.exe is excluded, injection into Explorer is not covered; use a PROCESS_INJECTION rule for that."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced/ nocase
    $reg.target.registry.registry_value_name = /^(Hidden|ShowSuperHidden|SuperHidden|HideFileExt)$/ nocase
    not $reg.principal.process.file.full_path = /\\explorer\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_admin_users
    $reg.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(re.regex($reg.target.registry.registry_value_name, `(?i)^ShowSuperHidden$`), 75, 60))
    $event_count = count($reg.metadata.id)
    $mitre_technique_id = array_distinct("T1564.001")
    $primary_entity = array_distinct($host)
    $modified_values = array_distinct($reg.target.registry.registry_value_name)
    $modifying_processes = array_distinct($reg.principal.process.file.full_path)
    $affected_users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 3
}
