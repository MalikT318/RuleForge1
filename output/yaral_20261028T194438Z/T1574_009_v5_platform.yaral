/*
  MITRE Technique : T1574.009 - Path Interception by Unquoted Path
  Tactic(s)       : Stealth, Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:38:36.748650+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_009_Unquoted_Path_Executable_Dropped_In_Parent_Directory {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of an executable at a location Windows probes first when resolving an unquoted, space-containing service or shortcut path. These locations are the drive root (e.g. C:\\Program.exe) or directly inside the Program Files root. This is FILE_CREATION based coverage of the planted interception binary rather than the command line. Because the technique is Windows-only, no Linux, macOS or cloud equivalent exists."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.009"
    mitre_technique_name = "Hijack Execution Flow: Path Interception by Unquoted Path"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating target.file.full_path and the principal process."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Poorly written installers or self-extractors that unpack an executable into the drive root or the Program Files root, software deployment and patching tooling, and OS servicing processes."
    tuning_guidance = "Add approved deployment tools to %global_allowed_admin_tools and security agents to %global_allowed_security_tools. Add known-good service accounts to %global_allowed_service_accounts. Extend the drive-root name list with other first-token directory names used in your estate."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^[a-z]:\\(program|documents|common|program files)\.(exe|com|scr)$|^[a-z]:\\program files( \(x86\))?\\[^\\]+\.(exe|com|scr)$/ nocase
    not $file.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1574.009")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $creating_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
