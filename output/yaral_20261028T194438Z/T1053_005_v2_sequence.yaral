/*
  MITRE Technique : T1053.005 - Scheduled Task
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:16:04.740682+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_005_TaskCache_Registry_Then_Scheduler_Spawned_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a new scheduled task registered in the TaskCache registry hive, followed within one hour on the same host by the Task Scheduler service (svchost -s Schedule) launching a script interpreter or proxy-execution binary that references a user-writable location. This links task registration to task execution regardless of which tool created the task (schtasks, COM or .NET wrapper, WMI, PowerShell cmdlets), so it does not depend on schtasks command-line parsing."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.005"
    mitre_technique_name = "Scheduled Task/Job: Scheduled Task"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (key creation under HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Schedule\\TaskCache) and process launch telemetry that populates the parent process command line."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters that register a task and run a helper script from ProgramData or Temp, RMM and patching agents, admin deployment scripts, and application self-update tasks launching PowerShell or cmd from AppData."
    tuning_guidance = "Add approved deployment, RMM and patching binaries to %global_allowed_admin_tools. Add approved script-running parent processes to %global_allowed_script_hosts. If the parent command line is not populated by the EDR, validate that the svchost Schedule condition still matches before deploying. Task names under the Microsoft\\Windows path are not excluded, because attackers masquerade there; the execution-side filter keeps volume low."

  events:
    $reg.metadata.event_type = "REGISTRY_CREATION"
    $reg.target.registry.registry_key = /\\Schedule\\TaskCache\\Tree\\/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    $reg.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\svchost\.exe$/ nocase
    $proc.principal.process.command_line = /-s\s+Schedule/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|msiexec)\.exe$/ nocase
    $proc.target.process.command_line = /\\(Users|ProgramData|Temp|AppData|Public)\\|\\Windows\\Temp\\|-enc|-encodedcommand|downloadstring|frombase64string/ nocase
    not $proc.target.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $reg.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1053.005")
    $primary_entity = array_distinct($hostname)
    $task_registry_keys = array_distinct($reg.target.registry.registry_key)
    $registering_processes = array_distinct($reg.principal.process.file.full_path)
    $spawned_processes = array_distinct($proc.target.process.file.full_path)
    $spawned_command_lines = array_distinct($proc.target.process.command_line)
    $executing_users = array_distinct($proc.target.user.userid)
    $execution_count = count($proc.metadata.id)

  condition:
    $reg and $proc
}
