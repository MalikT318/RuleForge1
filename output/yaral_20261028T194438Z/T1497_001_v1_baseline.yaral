/*
  MITRE Technique : T1497.001 - System Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:01:09.237265+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_001_Windows_VM_Artifact_Query_CommandLine {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows query utility (reg, wmic, PowerShell, sc, tasklist) launched with a command line that looks for virtualization or sandbox artifacts such as hypervisor vendor strings, guest-tool services, or sandbox DLLs. Malware uses this check to decide whether to disengage in an analysis environment. The rule matches the combination of a query verb and a VM artifact reference, not a specific tool or payload."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1497.001"
    mitre_technique_name = "Virtualization/Sandbox Evasion: System Checks"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with full command-line capture (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled). PowerShell command lines are only visible if the interpreter is launched with inline commands."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT asset inventory and CMDB discovery scripts, RMM health checks, administrators checking whether a host is virtual, hypervisor guest-tools install or health scripts, vulnerability scanners, VDI image build and golden-image validation, malware analysts and sandbox engineers testing on lab hosts."
    tuning_guidance = "Add approved inventory, RMM and deployment parent processes to %global_allowed_admin_tools. Add EDR/AV agents that enumerate VM artifacts to %global_allowed_security_tools. In VDI or lab estates where VM checks are routine, scope the rule out for those hosts or raise the risk threshold in SOAR. Chain with follow-on events (process exit, sleep or delay, or no further activity) to raise confidence."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(reg|wmic|powershell|pwsh|cmd|sc|tasklist|wevtutil)\.exe$/ nocase
    $proc.target.process.command_line = /(\bquery\b|\bwmic\b|get-wmiobject|get-ciminstance|\bgwmi\b|\bgcim\b|get-itemproperty|get-childitem|get-service|get-process|\bgci\b|tasklist|findstr)/ nocase
    $proc.target.process.command_line = /(vmware|vmtools|vmmouse|vmhgfs|vmci|vboxguest|vboxservice|vboxmouse|vboxsf|virtualbox|\bvbox|qemu|xenservice|xen\s*pv|vmbus|vmicheartbeat|hyper-v|parallels|prl_(tg|fs|sf)|sbiedll|sandboxie|vpcbus|vmsrvc|vmusrvc)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1497.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
