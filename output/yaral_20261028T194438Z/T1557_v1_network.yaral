/*
  MITRE Technique : T1557 - Adversary-in-the-Middle
  Tactic(s)       : Credential Access, Collection
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:28:27.305572+00:00
  Reference       : https://attack.mitre.org/techniques/T1557
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1557_WPAD_Config_Fetched_From_External_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows client fetching a WPAD proxy auto-config file (wpad.dat) from a non-internal destination. Legitimate WPAD is served from inside the network. A fetch that leaves the perimeter indicates WPAD name-resolution hijacking, a rogue proxy configuration, or a DNS/LLMNR/NBT-NS poisoning outcome that steers the client's web traffic through an adversary-controlled system. This is network-side coverage and does not depend on endpoint command-line telemetry."
    mitre_tactic = "Credential Access, Collection"
    mitre_technique = "T1557"
    mitre_technique_name = "Adversary-in-the-Middle"
    log_prerequisites = "Requires proxy or firewall logs normalised to NETWORK_HTTP with target.url populated (URL-aware inspection or an explicit forward proxy). Destination IP or hostname should be populated for internal-address exclusion."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Roaming laptops on guest or hotel networks that pick up a local WPAD service. Cloud-delivered proxy or secure web gateway services that publish a PAC file externally. Misconfigured clients with a legitimate external PAC URL. Authorised red-team or vulnerability scanner activity."
    tuning_guidance = "Add sanctioned external PAC-hosting domains to %global_allowed_domains. Add authorised scanner or test-source addresses to %global_allowed_scanners. Confirm that %rfc1918_internal covers all of the client's internal address space. If the client uses a cloud proxy with an externally hosted PAC, expect to populate %global_allowed_domains before enabling alerting."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\/wpad\.dat/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1557")
    $primary_entity = array_distinct($net.principal.ip)
    $source_hostname = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
