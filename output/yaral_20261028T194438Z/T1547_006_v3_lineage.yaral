/*
  MITRE Technique : T1547.006 - Kernel Modules and Extensions
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:32:35.360187+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_006_Linux_Service_Or_Temp_Parent_Spawns_Module_Loader {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a kernel module loading utility (insmod, modprobe, kmod) launched directly by a parent process that should never load kernel modules: an internet-facing or data-tier service daemon (web server, application runtime, database, cache, print or file service) or a binary executing from a world-writable directory (/tmp, /var/tmp, /dev/shm). This lineage indicates a compromised service or dropped payload loading a rootkit LKM for persistence and privilege escalation. The rule pivots on parent-child lineage rather than command-line content."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.006"
    mitre_technique_name = "Boot or Logon Autostart Execution: Kernel Modules and Extensions"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records normalised to UDM PROCESS_LAUNCH with populated parent (principal.process) and child (target.process) file paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Database or application services that legitimately load helper modules at start (for example a storage or filesystem module triggered from a service wrapper), containerised workloads whose entrypoint is a service binary calling modprobe for network or storage features, software installers or DKMS builds run from a temp directory, and vendor driver installers executed from /tmp during maintenance windows."
    tuning_guidance = "Add approved parent binaries (DKMS, configuration management agents, driver installers) to %global_allowed_admin_tools and EDR or security agents that load modules to %global_allowed_security_tools. Add approved administrator accounts to %global_allowed_admin_users. Extend or narrow the parent daemon list in the regex to match daemons deployed in the client environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(insmod|modprobe|kmod)$/ nocase
    $proc.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/|\/(apache2|httpd|nginx|lighttpd|php|php-fpm[0-9.]*|tomcat[0-9]*|java|node|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|smbd)$/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1547.006")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
