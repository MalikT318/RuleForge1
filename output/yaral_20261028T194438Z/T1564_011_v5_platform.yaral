/*
  MITRE Technique : T1564.011 - Ignore Process Interrupts
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:30:36.076852+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_011_Logoff_Shutdown_Signal_Tolerance_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects registry changes to the Windows session and service termination controls (AutoEndTasks, WaitToKillAppTimeout, HungAppTimeout, WaitToKillServiceTimeout). Altering these values lets processes outlive logoff and shutdown termination signals. The rule uses registry telemetry rather than process command lines, so it complements command-line detections for ignore-interrupt behaviour. Note: the requested alternate-platform angle conflicts with the mandatory Windows platform and windows_endpoint log source, so this rule delivers the additive coverage on Windows through a non-process-launch event type."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.011"
    mitre_technique_name = "Hide Artifacts: Ignore Process Interrupts"
    log_prerequisites = "Requires EDR or Sysmon registry modification telemetry (Sysmon Event ID 13 or equivalent) covering HKCU\\Control Panel\\Desktop and HKLM\\SYSTEM\\CurrentControlSet\\Control."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy or MDM baselines that tune shutdown timeouts, VDI or terminal server image builds, application installers (databases, ERP, backup agents) that raise WaitToKillServiceTimeout, and administrators troubleshooting slow logoff or shutdown."
    tuning_guidance = "Add approved deployment and configuration tooling to %global_allowed_admin_tools, approved admin accounts to %global_allowed_admin_users, and service accounts to %global_allowed_service_accounts. Add EDR and security agents to %global_allowed_security_tools. If a client enforces these values by Group Policy, exclude the policy-applying process by name."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(Control Panel\\Desktop|CurrentControlSet\\Control)$/ nocase
    $reg.target.registry.registry_value_name = /^(AutoEndTasks|WaitToKillAppTimeout|HungAppTimeout|WaitToKillServiceTimeout)$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1564.011")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_value = array_distinct($reg.target.registry.registry_value_name)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
