/*
  MITRE Technique : T1104 - Multi-Stage Channels
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:59:01.745898+00:00
  Reference       : https://attack.mitre.org/techniques/T1104
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1104_Scripted_Download_And_Execute_Second_Stage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a PowerShell command line that fetches content over HTTP(S) and executes it in the same invocation. This is the typical first-stage loader behaviour that pulls a second-stage implant or RAT from separate infrastructure (multi-stage C2). The rule matches the combination of download primitive, remote URL and execution primitive, not a specific payload, tool name or host."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1104"
    mitre_technique_name = "Multi-Stage Channels"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command-line capture (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and bootstrap scripts (package managers, developer environments), RMM and deployment agents that download and run scripts, IT automation and admin one-liners, and endpoint management or onboarding scripts."
    tuning_guidance = "Add approved deployment or RMM parent processes to %global_allowed_admin_tools. Add approved script-hosting parent processes to %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts. If a client's packaging workflow is noisy, review the recurring parent process and add it to the appropriate list rather than loosening the command-line logic."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
    $proc.target.process.command_line = /(downloadstring|downloadfile|downloaddata|invoke-webrequest|invoke-restmethod|start-bitstransfer|net\.webclient|\biwr\b|\birm\b)/ nocase
    $proc.target.process.command_line = /https?:\/\// nocase
    $proc.target.process.command_line = /(\biex\b|invoke-expression|start-process|\bsaps\b|invoke-item|diagnostics\.process\]::start)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1104")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
