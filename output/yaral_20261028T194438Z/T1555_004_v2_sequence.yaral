/*
  MITRE Technique : T1555.004 - Windows Credential Manager
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:57:38.923361+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_004_Vault_File_Read_Then_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A non-system process reads Windows Credential Manager vault artefacts (.vcrd/.vpol files or DPAPI credential blobs under the Microsoft Vault/Credentials profile folders) and the same process then opens a connection to an external address on the same host within 10 minutes. This indicates credential locker harvesting followed by exfiltration or staging. It does not depend on process command lines."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.004"
    mitre_technique_name = "Credentials from Password Stores: Windows Credential Manager"
    log_prerequisites = "Requires EDR or Sysmon-equivalent file read/access telemetry (normalised to FILE_READ) covering user profile AppData paths, plus network connection telemetry with process attribution (NETWORK_CONNECTION)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and imaging agents, EDR/AV scanners reading profile folders, profile migration tools (USMT, roaming profile sync), enterprise password-sync or SSO agents, and browsers or Office components that legitimately touch the vault and then connect externally."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes, EDR/AV agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Extend the executable-name exclusion regex for any local profile-migration or SSO tooling. If FILE_READ volume is high, confirm the EDR only emits reads for protected paths."

  events:
    $vault.metadata.event_type = "FILE_READ"
    $vault.target.file.full_path = /\\Microsoft\\(Vault\\.*\.(vcrd|vpol)|Credentials\\[0-9a-f]{32})$/ nocase
    not $vault.principal.process.file.full_path = /\\(lsass|svchost|services|explorer|MsMpEng|MsSense|SenseIR|SearchIndexer|SearchProtocolHost|msedge|iexplore|credwiz|vaultsvc)\.exe$/ nocase
    not $vault.principal.process.file.full_path in %global_allowed_security_tools
    not $vault.principal.process.file.full_path in %global_allowed_backup_processes
    not $vault.principal.user.userid in %global_allowed_service_accounts
    $vault.principal.hostname = $hostname
    $vault.principal.process.file.full_path = $proc_path

    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    $net.principal.hostname = $hostname
    $net.principal.process.file.full_path = $proc_path

    $vault.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $proc_path over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1555.004")
    $primary_entity = array_distinct($vault.principal.hostname)
    $accessing_process = array_distinct($vault.principal.process.file.full_path)
    $vault_files_read = array_distinct($vault.target.file.full_path)
    $vault_read_count = count($vault.metadata.id)
    $destination_ips = array_distinct($net.target.ip)
    $acting_user = array_distinct($vault.principal.user.userid)

  condition:
    $vault and $net
}
