/*
  MITRE Technique : T1599 - Network Boundary Bridging
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:59:53.857286+00:00
  Reference       : https://attack.mitre.org/techniques/T1599
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1599_External_Access_To_Network_Device_Mgmt_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a perimeter or segmentation firewall logging a connection from a non-internal source address to a network-device management-plane port (SSH, Telnet, SNMP, NETCONF over SSH, Smart Install, vendor management APIs). External access to these services is a common precursor to compromising a boundary device so it can be reconfigured to bridge trust zones."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1599"
    mitre_technique_name = "Network Boundary Bridging"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logging must cover allowed connections, not only denied ones."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised remote administration by MSSP or vendor support from changing source addresses, external vulnerability scanners and attack-surface monitoring, ISP or carrier management access, monitoring platforms polling over SNMP via public addresses, and internet background scanning of exposed management ports (which should be blocked and treated as a hardening issue)."
    tuning_guidance = "Add approved administration source addresses to %global_allowed_mgmt_sources and scanner addresses to %global_allowed_scanners. Populate %rfc1918_internal to cover the client's internal and private address space. Extend or reduce the port set to match the management services exposed in each client environment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port >= 1
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 161 or
      $net.target.port = 830 or
      $net.target.port = 4786 or
      $net.target.port = 8291
    )
    $net.principal.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1599")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
