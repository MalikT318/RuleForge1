/*
  MITRE Technique : T1129 - Shared Modules
  Tactic(s)       : Execution
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:41:45.642327+00:00
  Reference       : https://attack.mitre.org/techniques/T1129
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1129_Outbound_SMB_To_External_UNC_Module_Load {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects outbound SMB (TCP 445/139) from an internal host to a non-internal destination as observed at the network perimeter. The Windows module loader can load DLLs directly from UNC paths (T1129), and SMB sessions to external hosts are a strong network-side indicator of remote payload or module retrieval. Perimeter logs carry no process context, so this is a behavioural indicator that needs endpoint correlation."
    mitre_tactic = "Execution"
    mitre_technique = "T1129"
    mitre_technique_name = "Shared Modules"
    log_prerequisites = "Requires firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with populated principal.ip, target.ip and target.port, covering egress traffic from Windows hosts."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Hybrid-cloud file shares (for example SMB over VPN or cloud file services), branch-office or partner SMB links that use public addresses, misconfigured clients, and authorised external vulnerability scanning. Outbound SMB from internal hosts is rarely legitimate."
    tuning_guidance = "Add known-good source addresses (jump hosts, authorised file gateways) to %global_allowed_mgmt_sources. Confirm %rfc1918_internal covers the client's internal address space. For clients with legitimate SMB to a cloud provider, add a destination-specific exclusion at tenant level. Correlate hits with endpoint module-load telemetry for the same source host."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 445 or $net.target.port = 139)
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1129")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
