/*
  MITRE Technique : T1539 - Steal Web Session Cookie
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:39:31.097944+00:00
  Reference       : https://attack.mitre.org/techniques/T1539
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1539_OfficeSuite_Token_Claim_MFA_Satisfied_External_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a successful cloud sign-in from an external address where the MFA requirement was satisfied by a claim carried in an existing token or session rather than a fresh interactive challenge. This pattern is consistent with replay of a stolen web session cookie or token, for example after adversary-in-the-middle phishing, and bypasses MFA without credentials."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1539"
    mitre_technique_name = "Steal Web Session Cookie"
    log_prerequisites = "Requires Microsoft 365 or Google Workspace sign-in and authentication audit logs ingested and normalised to USER_LOGIN, with authentication detail text populated in security_result.description."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate users on persistent sessions or registered devices whose primary refresh token satisfies MFA, such as travellers, remote workers on home networks, and mobile clients re-authenticating silently. Service and automation accounts, and admin staff working from remote locations."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts and named admins to %global_allowed_admin_users. Add corporate egress or VPN addresses to %global_allowed_mgmt_sources. Medium severity is deliberate: this is a weak signal alone, so triage it with a source-IP and user-agent review or a prior-login baseline. Consider raising severity if the same user also shows a new MFA method registration or inbox rule creation."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.security_result.description = /(mfa requirement satisfied by claim in the token|mfa.*satisfied by (a |an )?(existing )?(claim|token|session)|previously satisfied)/ nocase
    $auth.principal.user.userid != ""
    not $auth.principal.ip in %rfc1918_internal
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1539")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $source_ips = array_distinct($auth.principal.ip)
    $target_apps = array_distinct($auth.target.application)

  condition:
    $auth
}
