/*
  MITRE Technique : T1534 - Internal Spearphishing
  Tactic(s)       : Lateral Movement
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:32:23.268862+00:00
  Reference       : https://attack.mitre.org/techniques/T1534
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1534_Mail_Protection_Policy_Tampering_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification, disabling or removal of tenant mail-flow and phishing-protection configuration (transport rules, anti-phishing, safe links, safe attachments, content-filter policies). Attackers who control an internal account use these changes to let internal spearphishing lures bypass filtering and reach other users. The rule detects the resulting configuration state change, not a command line."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1534"
    mitre_technique_name = "Internal Spearphishing"
    log_prerequisites = "Requires the Microsoft 365 unified audit log (Exchange admin audit operations) ingested and parsed to UDM SETTING_MODIFICATION events with metadata.product_event_type populated."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Messaging administrators tuning mail-flow rules or phishing policies, approved change windows, security-awareness phishing simulation setup (simulation allow-listing), mail migration projects, and managed-service automation accounts."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users, automation identities to %global_allowed_service_accounts, and approved service principals to %global_allowed_cloud_principals. Correlate with change tickets. Narrow or extend the operation-name regex to match your tenant's policy estate."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /^(Set|Disable|Remove)-(TransportRule|AntiPhishPolicy|AntiPhishRule|SafeLinksPolicy|SafeLinksRule|SafeAttachmentPolicy|SafeAttachmentRule|HostedContentFilterPolicy|HostedContentFilterRule|PhishSimOverridePolicy)$/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1534")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $operations = array_distinct($setting.metadata.product_event_type)
    $source_ips = array_distinct($setting.principal.ip)
    $modified_objects = array_distinct($setting.target.resource.name)

  condition:
    $setting
}
