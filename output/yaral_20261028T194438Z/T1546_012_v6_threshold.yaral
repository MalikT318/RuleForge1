/*
  MITRE Technique : T1546.012 - Image File Execution Options Injection
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:17:56.186408+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_012_IFEO_Registry_Modification_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Multiple registry writes to Image File Execution Options or SilentProcessExit keys (Debugger, GlobalFlag, MonitorProcess values) on a single host within 10 minutes. One IFEO write can be legitimate developer or application-compatibility activity. Repeated writes across several executables indicate IFEO debugger hijacking, silent-process-exit persistence, or accessibility-binary backdooring."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.012"
    mitre_technique_name = "Event Triggered Execution: Image File Execution Options Injection"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event IDs 12/13/14 or equivalent) normalised to UDM REGISTRY_MODIFICATION with target.registry.registry_key populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Application verifier and debugging by developers, Windows Error Reporting or crash-dump tooling configuring SilentProcessExit, software installers and compatibility shims, endpoint security agents setting IFEO values for self-protection, and QA labs that enable GFlags on many binaries."
    tuning_guidance = "Add approved installers, deployment tools and developer tooling to %global_allowed_admin_tools. Add EDR or AV agents to %global_allowed_security_tools. Add automation accounts to %global_allowed_service_accounts. Raise the #reg threshold in developer-heavy or lab environments."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(Image File Execution Options|SilentProcessExit)\\[^\\]+/ nocase
    (
      $reg.target.registry.registry_value_name = /^(Debugger|GlobalFlag|MonitorProcess|ReportingMode|VerifierDlls)$/ nocase or
      $reg.target.registry.registry_key = /\\(Debugger|GlobalFlag|MonitorProcess)$/ nocase
    )
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($reg.target.registry.registry_value_name = /(?i)^(Debugger|MonitorProcess)$/, 85, 70))
    $mitre_technique_id = array_distinct("T1546.012")
    $primary_entity = array_distinct($host)
    $event_count = count($reg.metadata.id)
    $modified_keys = array_distinct($reg.target.registry.registry_key)
    $modified_values = array_distinct($reg.target.registry.registry_value_name)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 3
}
