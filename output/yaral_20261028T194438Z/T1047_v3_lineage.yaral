/*
  MITRE Technique : T1047 - Windows Management Instrumentation
  Tactic(s)       : Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:30:49.575585+00:00
  Reference       : https://attack.mitre.org/techniques/T1047
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1047_WmiPrvSE_Spawns_Shell_Or_Script_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the WMI provider host (WmiPrvSE) or the WMI script event consumer (scrcons) spawning a command shell, script interpreter, or common proxy-execution binary. This lineage is the signature of remote WMI execution (for example Win32_Process.Create over DCOM or WinRM) and WMI event-subscription persistence payloads. The rule keys on parent-child process lineage rather than command-line content, so it complements command-line rules for wmic.exe and similar tools."
    mitre_tactic = "Execution"
    mitre_technique = "T1047"
    mitre_technique_name = "Windows Management Instrumentation"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry that populates the parent process path (EDR, Sysmon Event ID 1, or Security Event 4688 with parent process name)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Endpoint management and monitoring agents that run commands through WMI (software deployment, patch, inventory, and health-check tooling), administrators running remote WMI commands, and legitimate WMI event consumers that launch scripts."
    tuning_guidance = "Add approved management tooling child binaries to %global_allowed_admin_tools, and add service accounts used by monitoring or deployment platforms to %global_allowed_service_accounts. If a client has noisy cmd.exe spawns from a known tool, tune on the tool's account rather than removing the child interpreter from the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(wmiprvse|scrcons)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|bitsadmin|certutil|msiexec)\.exe$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1047")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
