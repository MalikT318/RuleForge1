/*
  MITRE Technique : T1053.003 - Cron
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:15:23.319408+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_003_ESXi_Crontab_Repeated_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated modification of ESXi crontab files under /var/spool/cron/crontabs/ on a single host within one hour. ESXi has no crontab command, so jobs are added by editing the crontab file directly, and a legitimate edit is rare. Several writes to the file in a short window point to an adversary installing or iterating on a scheduled persistence job."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.003"
    mitre_technique_name = "Scheduled Task/Job: Cron"
    log_prerequisites = "Requires ESXi host file-integrity or audit telemetry (shell and hostd logs, or a forwarded file-change feed) normalised to UDM FILE_MODIFICATION events with target.file.full_path populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators legitimately editing root crontab entries (a single edit can produce several write events), configuration-management or host-hardening scripts that rewrite crontab at boot or on a schedule, and host profile remediation."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and approved automation binaries to %global_allowed_admin_tools. Raise the threshold if an editor generates many write events per save. Lower it to 2 in environments where crontab is never legitimately changed."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/var\/spool\/cron\/crontabs\// nocase
    $file.principal.hostname = $host
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  match:
    $host over 1h

  outcome:
    $risk_score = max(70)
    $event_count = count($file.metadata.id)
    $modified_files = array_distinct($file.target.file.full_path)
    $acting_users = array_distinct($file.principal.user.userid)
    $mitre_technique_id = array_distinct("T1053.003")
    $primary_entity = array_distinct($host)

  condition:
    #file >= 3
}
