/*
  MITRE Technique : T1036.008 - Masquerade File Type
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:09:48.231465+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_008_Linux_Script_Client_Fetches_Benign_Extension_Payload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a non-browser command-line or interpreter HTTP client on a Linux host retrieving content from an external server through a URL that ends in a benign-looking image or text extension (.jpg, .png, .gif, .txt and similar). Adversaries rename payloads such as scripts, web shells and ELF binaries to these extensions to evade file-type validation and proxy filtering during ingress tool transfer. This is a network-side detection that complements endpoint command-line rules."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.008"
    mitre_technique_name = "Masquerade File Type"
    log_prerequisites = "Requires NETWORK_HTTP telemetry with target.url and process attribution (principal.process.file.full_path) from a Linux EDR sensor, or proxy/egress logs enriched with process or user-agent data."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Automation or monitoring scripts that fetch images or text files (logos, favicons, status or version text files, license files), package or configuration bootstrap scripts using curl or wget, health checks, and developer tooling pulling assets from external CDNs or repositories."
    tuning_guidance = "Add approved automation parent processes to %global_allowed_script_hosts, vendor or CDN domains to %global_allowed_domains, deployment tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Consider raising severity when the same host also shows a PROCESS_LAUNCH from /tmp, /var/tmp or /dev/shm shortly after the download."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\.(jpe?g|png|gif|bmp|ico|webp|svg|txt)(\?.*)?$/ nocase
    (
      $http.principal.process.file.full_path = /\/(curl|wget|python[0-9.]*|perl|php[0-9.]*|ruby|bash|sh|dash|busybox|nc|ncat)$/ nocase or
      $http.network.http.user_agent = /^(curl|wget|python-(requests|urllib)|libwww-perl|go-http-client)/ nocase
    )
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.process.file.full_path in %global_allowed_admin_tools
    not $http.principal.process.parent_process.file.full_path in %global_allowed_script_hosts
    not $http.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1036.008")
    $primary_entity = array_distinct($http.principal.hostname)
    $requested_urls = array_distinct($http.target.url)
    $destination_ips = array_distinct($http.target.ip)
    $client_process = array_distinct($http.principal.process.file.full_path)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
