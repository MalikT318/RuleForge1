/*
  MITRE Technique : T1189 - Drive-by Compromise
  Tactic(s)       : Initial Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:35:05.839590+00:00
  Reference       : https://attack.mitre.org/techniques/T1189
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1189_Linux_Browser_External_NonStandard_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux desktop browser process opening an outbound TCP connection to an external address on a port other than the standard web ports. Drive-by compromise infrastructure (exploit kit landing pages, malvertising redirectors, payload hosts) often runs on non-standard ports, whereas normal browsing uses 80/443. This is a network-side observation of the connection and does not depend on process command lines."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1189"
    mitre_technique_name = "Drive-by Compromise"
    log_prerequisites = "Requires Linux endpoint network telemetry (EDR or auditd) that populates NETWORK_CONNECTION events with the originating process path, destination IP, destination port and IP protocol."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Internal or partner web applications hosted on external IPs with non-standard ports (8000-9999 dashboards, dev servers, cloud consoles); browser-based remote support or VPN portals; headless browser automation, scrapers and web-testing frameworks; WebRTC or streaming over TCP on high ports; web-based admin UIs for cloud-hosted appliances."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains. Add automation, CI and testing accounts to %global_allowed_service_accounts. Add approved remote-support tooling to %global_allowed_remote_mgmt. If a client legitimately uses a specific port (for example 8444 or 9443) for a business web app, add a port exclusion to the events block. Review the destination ports in the outcome to find recurring benign ports."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(firefox|firefox-bin|chrome|chromium|chromium-browser|brave|brave-browser|opera|vivaldi|vivaldi-bin|microsoft-edge|epiphany|midori)$/ nocase
    $net.network.ip_protocol = "TCP"
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 8080
    $net.target.port != 8443
    $net.target.port != 5228
    $net.target.port != 53
    $net.target.port > 0
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1189")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $browser_process = array_distinct($net.principal.process.file.full_path)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
