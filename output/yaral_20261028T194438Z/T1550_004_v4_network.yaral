/*
  MITRE Technique : T1550.004 - Web Session Cookie
  Tactic(s)       : Lateral Movement
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:42:31.607323+00:00
  Reference       : https://attack.mitre.org/techniques/T1550/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1550_004_Scripted_Client_Authenticated_SaaS_Session {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an authenticated, successful HTTP request to a SaaS or identity-protected application API from an external address using a scripted or headless HTTP client instead of an interactive browser. Replaying a stolen session cookie outside the victim's browser usually looks like this, because the adversary skips the interactive sign-in and MFA and calls the application directly with the imported cookie."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1550.004"
    mitre_technique_name = "Use Alternate Authentication Material: Web Session Cookie"
    log_prerequisites = "Requires NETWORK_HTTP telemetry (secure web gateway, reverse proxy or CASB, or SaaS access logs) with principal.ip, principal.user.userid, network.http.user_agent, target.url and network.http.response_code populated. Identity-provider session attribution is needed to resolve the user."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Sanctioned automation and integrations calling SaaS APIs with user-delegated sessions, developer or QA scripts, uptime and synthetic monitoring, mobile or desktop sync clients with non-browser user agents, and approved security testing."
    tuning_guidance = "Add known integration and automation accounts to %global_allowed_service_accounts. Add authorised scanner and testing sources to %global_allowed_scanners. Add approved vendor or corporate egress ranges to %global_allowed_mgmt_sources if they appear as external addresses. Review the user-agent and URL path regexes against client-specific API conventions."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.principal.user.userid != ""
    $http.network.http.user_agent = /(headlesschrome|phantomjs|python-requests|python-urllib|aiohttp|go-http-client|libwww-perl|okhttp|node-fetch|axios|java\/[0-9]|apache-httpclient|curl\/|wget\/)/ nocase
    $http.target.url = /\/(api|graphql|v[0-9]+|mail|messages|inbox|me|ews|drive|files)(\/|\?|$)/ nocase
    $http.network.http.response_code >= 200
    $http.network.http.response_code < 400
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1550.004")
    $primary_entity = array_distinct($http.principal.user.userid)
    $source_ips = array_distinct($http.principal.ip)
    $user_agents = array_distinct($http.network.http.user_agent)
    $target_urls = array_distinct($http.target.url)

  condition:
    $http
}
