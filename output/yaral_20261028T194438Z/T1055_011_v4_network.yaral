/*
  MITRE Technique : T1055.011 - Extra Window Memory Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:58:10.164595+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_011_GUI_Process_Unusual_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a native Windows GUI shell or utility process (for example explorer.exe, a common Extra Window Memory injection victim) opening an outbound connection to an external address on a non-web port. After EWM injection the host process typically carries the payload's C2 traffic, so a trusted GUI process making direct non-HTTP(S) external connections is anomalous. This is network-side coverage that complements endpoint process-creation rules."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.011"
    mitre_technique_name = "Process Injection: Extra Window Memory Injection"
    log_prerequisites = "Requires EDR or Sysmon network connection telemetry (Sysmon Event ID 3 or equivalent) with the initiating process path populated in UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Explorer-launched file transfers over non-web ports (FTP, SFTP, WebDAV on custom ports), cloud sync or VPN-integrated shell extensions, mapped network locations over VPN, and legitimate Notepad or Paint plugins that call home."
    tuning_guidance = "Add approved tooling to %global_allowed_remote_mgmt and %global_allowed_security_tools, and add known-good vendor destinations to %global_allowed_domains. If the client uses non-standard web ports, extend the port exclusions. Narrow or widen the host-process list to match the environment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(explorer|notepad|mspaint|calc|write|wordpad)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 53
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1055.011")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
