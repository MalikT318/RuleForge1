/*
  MITRE Technique : T1027 - Obfuscated Files or Information
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:36:16.598433+00:00
  Reference       : https://attack.mitre.org/techniques/T1027
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_ESXi_Login_Then_Decode_And_Execute_Pipeline {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an interactive login to an ESXi host followed within five minutes by a decode-and-execute pipeline in the host shell (for example base64, xxd, uudecode or gunzip output piped into sh, or eval of a decoded string). This sequence is typical of an operator who logs in and runs an obfuscated payload or staging script to evade defenders and file-based detection."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027"
    mitre_technique_name = "Obfuscated Files or Information"
    log_prerequisites = "ESXi host syslog (hostd, shell, auth) forwarded to Chronicle and parsed into UDM USER_LOGIN and PROCESS_LAUNCH events. ESXi shell command auditing must be enabled, and principal.hostname must be populated consistently on both event types."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators decoding base64 configuration blobs or unpacking compressed scripts during maintenance, vendor or automation tooling that deploys compressed installer scripts over SSH, and approved orchestration or backup jobs that log in and pipe decoded content to a shell."
    tuning_guidance = "Add automation and orchestration accounts to %global_allowed_service_accounts, named administrators to %global_allowed_admin_users, and approved jump hosts or management source addresses to %global_allowed_mgmt_sources. Add approved deployment tooling or parent shells to %global_allowed_script_hosts or %global_allowed_admin_tools. If the hostname is only populated in target.hostname for login events in your parser, change the $auth join field accordingly."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.hostname = $hostname
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.principal.ip in %global_allowed_mgmt_sources

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.hostname = $hostname
    $proc.target.process.command_line = /((base64\s+(-d|--decode)|xxd\s+-r|uudecode|zcat|gunzip|openssl\s+(enc|base64)\s[^|]*-d)[^|;]*\|\s*(\/bin\/)?(ba|a)?sh\b|(eval|exec)\s+.*base64\s+(-d|--decode))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    $auth.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027")
    $primary_entity = array_distinct($hostname)
    $login_users = array_distinct($auth.target.user.userid)
    $login_source_ips = array_distinct($auth.principal.ip)
    $decode_commands = array_distinct($proc.target.process.command_line)
    $event_count = count($proc.metadata.id)

  condition:
    $auth and $proc
}
