/*
  MITRE Technique : T1578.003 - Delete Cloud Instance
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:52:54.763584+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_003_Cloud_Instance_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects deletion or termination of a cloud compute instance or virtual machine through the cloud control plane API. Adversaries delete instances after malicious activity to destroy forensic artifacts and evade detection. Matches the provider-normalised delete/terminate operation names for VM instances and scale sets, not specific tools or resources."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578.003"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Delete Cloud Instance"
    log_prerequisites = "Cloud control-plane audit logging must be enabled and ingested with management/admin write events (AWS CloudTrail management events, Azure Activity Log, GCP Cloud Audit Admin Activity). metadata.product_event_type must be populated by the parser."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Autoscaling and spot or preemptible instance recycling, infrastructure-as-code pipelines (teardown of ephemeral environments), CI/CD ephemeral build agents, scheduled cost-saving shutdown automation, and planned decommissioning by cloud administrators."
    tuning_guidance = "Add automation and IaC identities to %global_allowed_service_accounts, approved cloud service principals (autoscalers, pipeline roles) to %global_allowed_cloud_principals, and named administrators to %global_allowed_admin_users. For higher fidelity in noisy tenants, raise severity only for deletions outside change windows or where the same principal also performed disabling of logging or snapshot deletion."

  events:
    $cloud.metadata.event_type = "RESOURCE_DELETION"
    $cloud.metadata.product_event_type = /^(terminateinstances|((v\d+|beta|alpha)\.)?compute\.instances\.(delete|bulkdelete)|microsoft\.compute\/virtualmachines\/delete|microsoft\.compute\/virtualmachinescalesets\/delete)$/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1578.003")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $deleted_resource = array_distinct($cloud.target.resource.name)
    $api_operation = array_distinct($cloud.metadata.product_event_type)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
