/*
  MITRE Technique : T1053 - Scheduled Task/Job
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:12:03.572250+00:00
  Reference       : https://attack.mitre.org/techniques/T1053
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_005_Excessive_Scheduled_Task_Creation_Per_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects an unusual volume of scheduled task creation events on a single Windows host within one hour. Creating one task is routine; several non-default tasks created in a short window suggest persistence staging, lateral movement tooling, or automated malware deployment. This rule uses scheduled task creation telemetry and does not duplicate process command-line detections."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.005"
    mitre_technique_name = "Scheduled Task/Job: Scheduled Task"
    log_prerequisites = "Requires Windows endpoint telemetry that normalises task registration into SCHEDULED_TASK_CREATION events (EDR, Sysmon-equivalent, or Windows Security Event 4698 / TaskScheduler Operational 106)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters registering several tasks, RMM and patching agents, golden-image or VDI build processes, enterprise deployment tooling, and administrators provisioning new servers."
    tuning_guidance = "Add approved automation accounts to %global_allowed_service_accounts and deployment or RMM binaries to %global_allowed_admin_tools. Raise the #task threshold on build, patching, or VDI hosts. Review the task_names and task_users outcome values to separate installers from suspicious bulk creation."

  events:
    $task.metadata.event_type = "SCHEDULED_TASK_CREATION"
    $task.principal.hostname = $host
    not $task.target.resource.name = /^\\Microsoft\\Windows\\/ nocase
    not $task.principal.user.userid in %global_allowed_service_accounts
    not $task.principal.process.file.full_path in %global_allowed_admin_tools

  match:
    $host over 1h

  outcome:
    $risk_score = max(65)
    $event_count = count($task.metadata.id)
    $mitre_technique_id = array_distinct("T1053.005")
    $primary_entity = array_distinct($host)
    $task_names = array_distinct($task.target.resource.name)
    $task_users = array_distinct($task.principal.user.userid)
    $creating_processes = array_distinct($task.principal.process.file.full_path)

  condition:
    #task >= 5
}
