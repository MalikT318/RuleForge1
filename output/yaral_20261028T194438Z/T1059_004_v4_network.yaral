/*
  MITRE Technique : T1059.004 - Unix Shell
  Tactic(s)       : Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:11:45.757135+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_004_ESXi_Shell_Interpreter_Outbound_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi host shell interpreter (ash, sh, bash, dash or the multi-call shell binary) itself initiating a network connection to an external address. Legitimate administration rarely makes the interpreter the network endpoint. This pattern is characteristic of reverse shells, shell-driven payload retrieval and interactive shells over a C2 channel. It is a network-side complement to endpoint command-line detections."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.004"
    mitre_technique_name = "Command and Scripting Interpreter: Unix Shell"
    log_prerequisites = "Requires ESXi host telemetry that records outbound network connections with the initiating process path, for example forwarded shell/syslog data parsed into NETWORK_CONNECTION events or host network sensor data. principal.process.file.full_path and target.ip must be populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators running shell-based scripts that call out to external patch depots, vendor support or time services; automation or configuration-management jobs run from the ESXi shell; approved remote support sessions."
    tuning_guidance = "Add approved automation binaries to %global_allowed_admin_tools, approved script parent processes to %global_allowed_script_hosts, and automation accounts to %global_allowed_service_accounts. Populate %rfc1918_internal with the internal ranges used by clients. Add approved vendor destinations to %global_allowed_mgmt_sources."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /(^|\/)(sh|ash|bash|dash|busybox)$/ nocase
    $net.principal.hostname != ""
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_script_hosts
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_user = array_distinct($net.principal.user.userid)
    $initiating_process = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
