/*
  MITRE Technique : T1053.007 - Container Orchestration Job
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:20:20.517024+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_007_K8s_CronJob_Created_By_NonApproved_Principal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a Kubernetes CronJob through the control-plane API by a principal that is not a built-in cluster component or an approved automation or admin identity. Adversaries create CronJobs to schedule malicious containers and to persist across the cluster. This rule uses Kubernetes audit telemetry, not in-container command lines."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.007"
    mitre_technique_name = "Scheduled Task/Job: Container Orchestration Job"
    log_prerequisites = "Requires Kubernetes API server audit logging at Metadata level or higher, covering create verbs on batch resources, ingested and normalised to RESOURCE_CREATION."
    platform = "Containers"
    log_source = "container"
    false_positives = "CI/CD pipelines and GitOps controllers deploying scheduled workloads, platform engineers deploying legitimate maintenance or backup CronJobs, operators and Helm charts that ship CronJobs (certificate rotation, log cleanup, database backups)."
    tuning_guidance = "Add CI/CD and GitOps service account identifiers to %global_allowed_service_accounts and platform engineer accounts to %global_allowed_admin_users. If the kube-system namespace is noisy in a given cluster, tune the namespace exclusion. Raise severity for production namespaces or when the creator is an end-user identity."

  events:
    $cron.metadata.event_type = "RESOURCE_CREATION"
    (
      $cron.target.resource.name = /(^|\/)cronjobs(\/|\?|$)/ nocase or
      $cron.target.url = /\/apis\/batch\/[^\/]+\/(namespaces\/[^\/]+\/)?cronjobs(\/|\?|$)/ nocase
    )
    $cron.principal.user.userid != ""
    not $cron.principal.user.userid = /^system:(node|kube-|serviceaccount:kube-system:)/ nocase
    not $cron.principal.user.userid in %global_allowed_service_accounts
    not $cron.principal.user.userid in %global_allowed_admin_users
    not $cron.target.url = /\/namespaces\/kube-system\// nocase

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1053.007")
    $primary_entity = array_distinct($cron.principal.user.userid)
    $source_ips = array_distinct($cron.principal.ip)
    $target_resources = array_distinct($cron.target.resource.name)
    $request_urls = array_distinct($cron.target.url)

  condition:
    $cron
}
