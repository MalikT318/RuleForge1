/*
  MITRE Technique : T1059.011 - Lua
  Tactic(s)       : Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:23:27.826204+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_011_Lua_Script_Retrieval_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a single internal source repeatedly retrieving Lua scripts (.lua URLs) or making HTTP requests with a Lua-runtime user agent to external destinations within ten minutes. This is network-observable staging of Lua payloads for Lua-based malware or loaders. A single request is benign; repeated retrieval of Lua content from external hosts is not."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.011"
    mitre_technique_name = "Command and Scripting Interpreter: Lua"
    log_prerequisites = "Requires firewall or web proxy logs with HTTP visibility (URL and user agent) normalised to UDM NETWORK_HTTP, with principal.ip and target.url populated. TLS inspection is needed to see URLs on encrypted traffic."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Game clients or game-server tooling that download Lua assets, embedded devices and IoT firmware that use Lua for configuration (OpenWrt, nginx/OpenResty health checks), developers pulling Lua packages from public repositories, and software update agents."
    tuning_guidance = "Add known-good vendor, CDN and package repository domains to %global_allowed_domains. Raise the threshold in the condition for environments with developer or game-server traffic. Review the destination hosts and URLs in the outcome to confirm the content is an unexpected script download."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    (
      $net.target.url = /\.lua([?#].*)?$/ nocase or
      $net.network.http.user_agent = /(luasocket|lua-resty|luacurl|lua[\/ _-]?http|\blua\b)/ nocase
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    $net.principal.ip = $src_ip

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1059.011")
    $primary_entity = array_distinct($src_ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    #net >= 3
}
