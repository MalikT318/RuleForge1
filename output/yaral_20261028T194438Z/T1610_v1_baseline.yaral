/*
  MITRE Technique : T1610 - Deploy Container
  Tactic(s)       : Execution
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:28:40.358081+00:00
  Reference       : https://attack.mitre.org/techniques/T1610
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1610_Privileged_Or_HostMounted_Container_Deploy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects deployment of a container through a container runtime CLI (run or create) combined with host-escape-enabling options: privileged mode, host PID namespace, dangerous capabilities, unconfined security profiles, or a bind mount of the host root or container runtime socket. Adversaries use such containers to execute payloads with weakened isolation and to escape to the host."
    mitre_tactic = "Execution"
    mitre_technique = "T1610"
    mitre_technique_name = "Deploy Container"
    log_prerequisites = "Requires process launch telemetry with full command lines from container hosts or Kubernetes nodes (EDR or auditd execve forwarded to Chronicle and normalised to PROCESS_LAUNCH)."
    platform = "Containers"
    log_source = "container"
    false_positives = "Platform engineers debugging nodes with privileged containers, CI/CD build agents running Docker-in-Docker, monitoring or logging agents that mount the runtime socket, and storage or networking tooling that legitimately needs host access."
    tuning_guidance = "Add approved deployment tooling parent processes to %global_allowed_admin_tools and CI or automation accounts to %global_allowed_service_accounts. Review hosts that repeatedly trigger and consider scoping exclusions to build-agent hosts only."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(docker|podman|nerdctl|ctr|crictl)$/ nocase
    $proc.target.process.command_line = /\b(run|create)\b/ nocase
    $proc.target.process.command_line = /(--privileged|--pid[=\s]+host|--cap-add[=\s]+(sys_admin|sys_ptrace|sys_module|all)|--security-opt[=\s]+(seccomp|apparmor)[=:]unconfined|(-v|--volume)[=\s]+\/:\/|(-v|--volume)[=\s]+\/var\/run\/(docker|containerd\/containerd)\.sock|--mount[=\s]+\S*(src|source)=\/(,|\s|$))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1610")
    $primary_entity = array_distinct($proc.principal.hostname)
    $deploying_user = array_distinct($proc.principal.user.userid)
    $deploy_command = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
