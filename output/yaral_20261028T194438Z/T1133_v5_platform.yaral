/*
  MITRE Technique : T1133 - External Remote Services
  Tactic(s)       : Persistence, Initial Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:50:15.910429+00:00
  Reference       : https://attack.mitre.org/techniques/T1133
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1133_External_Inbound_Windows_Remote_Services {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a connection from an external (non-internal) source address to Windows remote-access service ports (RDP, WinRM HTTP/HTTPS, VNC) as seen at the network perimeter. Inbound access to these services from the internet indicates an exposed external remote service that can be used for initial access or persistence. This is a network-layer rule using firewall telemetry and is intended to complement existing endpoint process-creation detections. No Linux, macOS or cloud variant is provided because the Windows platform requirement is mandatory."
    mitre_tactic = "Persistence, Initial Access"
    mitre_technique = "T1133"
    mitre_technique_name = "External Remote Services"
    log_prerequisites = "Requires firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with populated principal.ip, target.ip and target.port. Logs must record permitted inbound sessions from the internet. No endpoint process fields are used."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Approved vendor or MSP remote support over RDP, internet-facing RDP Gateway or WinRM endpoints that are intentionally published, authorised penetration tests and external vulnerability scans, and remote-worker access that does not go through a VPN."
    tuning_guidance = "Add approved management and support source addresses to %global_allowed_mgmt_sources and authorised scanner source addresses to %global_allowed_scanners. If %rfc1918_internal does not cover all of a client's private or carrier-grade NAT space, extend that list. For intentionally published gateways, scope the rule per client by excluding those hosts, or require a connection-volume threshold."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 3389 or
      $net.target.port = 5985 or
      $net.target.port = 5986 or
      $net.target.port = 5900
    )
    $net.principal.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1133")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
