/*
  MITRE Technique : T1557 - Adversary-in-the-Middle
  Tactic(s)       : Credential Access, Collection
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:29:46.208405+00:00
  Reference       : https://attack.mitre.org/techniques/T1557
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1557_Linux_Host_Direct_External_DNS_Resolver {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host sending DNS traffic (port 53, or DNS-over-TLS on 853) straight to an external resolver, bypassing the corporate resolvers. On Linux, adversaries who rewrite /etc/resolv.conf, systemd-resolved or NetworkManager settings to point at a rogue resolver cause exactly this perimeter pattern. This is a network-observable indicator of DNS-based adversary-in-the-middle. The rule never sees the host's process or file activity, so it provides coverage that process-creation rules cannot."
    mitre_tactic = "Credential Access, Collection"
    mitre_technique = "T1557"
    mitre_technique_name = "Adversary-in-the-Middle"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Egress DNS must pass through the logging firewall, and the client must have the %rfc1918_internal list populated."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Hosts or containers deliberately configured with a public resolver (developer workstations, cloud-hosted Linux VMs, CI runners). Internal DNS forwarders and recursive resolvers that legitimately query external servers. Container runtimes with a default public DNS fallback. Network monitoring probes."
    tuning_guidance = "Add the addresses of internal DNS forwarders and recursive resolvers to %global_allowed_mgmt_sources. Add approved test or scanning sources to %global_allowed_scanners. If the egress policy already blocks direct external DNS, raise severity, because any allowed hit then means a firewall policy gap or a deliberate bypass. If the asset inventory populates principal.platform, add a Linux filter to narrow the scope."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 53 or $net.target.port = 853)
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %rfc1918_internal_unused_placeholder_never_used
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1557")
    $primary_entity = array_distinct($net.principal.ip)
    $rogue_resolver = array_distinct($net.target.ip)
    $resolver_port = array_distinct($net.target.port)

  condition:
    $net
}
