/*
  MITRE Technique : T1574.012 - COR_PROFILER
  Tactic(s)       : Stealth, Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:44:13.154116+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_012_COR_PROFILER_Persistent_Env_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry writes that set .NET CLR profiler environment variables (COR_ENABLE_PROFILING, COR_PROFILER, COR_PROFILER_PATH and CORECLR equivalents) in the user or system Environment registry keys. This is the persistence and privilege-escalation form of COR_PROFILER hijacking, because the profiler DLL is loaded into every .NET process that starts afterwards. It is registry-based and complements command-line process-launch coverage. COR_PROFILER is a Windows-only .NET mechanism, so no Linux, macOS or cloud equivalent exists and the rule targets Windows."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.012"
    mitre_technique_name = "Hijack Execution Flow: COR_PROFILER"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 12/13/14 equivalent) populating target.registry.registry_key and target.registry.registry_value_name."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developers and performance engineers who legitimately enable .NET profiling on workstations or build servers; APM and profiler agents (application performance monitoring, code coverage, diagnostic tools) that register themselves through environment variables; endpoint management tools that push environment settings."
    tuning_guidance = "Add approved APM, profiler and deployment tooling executables to %global_allowed_admin_tools, and EDR/AV agents to %global_allowed_security_tools. Developer and build hosts that routinely profile .NET code can be scoped out by exclusion at the SIEM tenant level, or by adding the writing process to the allowlist."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Environment$/ nocase
    $reg.target.registry.registry_value_name = /^(COR_ENABLE_PROFILING|COR_PROFILER|COR_PROFILER_PATH|COR_PROFILER_PATH_32|COR_PROFILER_PATH_64|CORECLR_ENABLE_PROFILING|CORECLR_PROFILER|CORECLR_PROFILER_PATH|CORECLR_PROFILER_PATH_32|CORECLR_PROFILER_PATH_64)$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1574.012")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_name)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
