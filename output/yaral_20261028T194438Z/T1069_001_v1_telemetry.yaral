/*
  MITRE Technique : T1069.001 - Local Groups
  Tactic(s)       : Discovery
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:56:43.143513+00:00
  Reference       : https://attack.mitre.org/techniques/T1069/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1069_001_Linux_Group_Database_Read_From_Staging_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a binary running from a world-writable or hidden staging location (/tmp, /var/tmp, /dev/shm, /run/user, hidden directories under /home) reading the local group databases /etc/group or /etc/gshadow. This is the file-access artifact of local group discovery (T1069.001) and does not depend on command-line logging. Dropped enumeration tools, renamed utilities and in-memory interpreters running from staging paths are caught regardless of how they were invoked."
    mitre_tactic = "Discovery"
    mitre_technique = "T1069.001"
    mitre_technique_name = "Permission Groups Discovery: Local Groups"
    log_prerequisites = "Requires Linux endpoint file-access telemetry (EDR file-read events, or auditd with watch rules such as: -w /etc/group -p r -k group_read and -w /etc/gshadow -p r -k group_read) normalised to UDM FILE_READ with principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software installers or package builds that run from /tmp and resolve group names; containers or CI jobs executing from /tmp or /dev/shm; user-installed applications under hidden home directories (for example language version managers or portable apps) that call NSS group lookups; configuration management agents that unpack to /tmp."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, backup agents to %global_allowed_backup_processes, and automation accounts to %global_allowed_service_accounts. Where auditd watch rules are not deployed, deploy them on /etc/group and /etc/gshadow first, or the rule will never fire. Extend the staging path regex with client-specific writable directories if needed."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /^\/etc\/(group|gshadow)-?$/ nocase
    $file.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/user\/[0-9]+|home\/[^\/]+\/\.[^\/]+)\// nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1069.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $reading_process = array_distinct($file.principal.process.file.full_path)
    $group_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
