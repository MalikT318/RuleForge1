/*
  MITRE Technique : T1566 - Phishing
  Tactic(s)       : Initial Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:45:36.086988+00:00
  Reference       : https://attack.mitre.org/techniques/T1566
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1566_Linux_MailClient_Or_Office_Spawns_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux desktop mail client, document editor or document viewer spawning a shell, script interpreter or downloader. This parent-child lineage is rare in normal use and is typical of a phishing attachment or link being opened and executing code. It matches on process lineage only, not on command-line content."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1566"
    mitre_technique_name = "Phishing"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry normalised to PROCESS_LAUNCH with populated parent (principal.process) and child (target.process) executable paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Mail clients or office suites launching helper scripts such as xdg-open wrappers or desktop-integration shell scripts; LibreOffice or WPS macros and extensions that call approved scripts; PDF viewers invoking print or conversion filters through sh; developers using office suites with automation plugins."
    tuning_guidance = "Add approved parent binaries or hosts to %global_allowed_script_hosts and approved helper tooling to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. If xdg-open wrappers are noisy, add the wrapper path to %global_allowed_admin_tools. Raise severity on servers, where these parents should never run."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(thunderbird|thunderbird-bin|evolution|geary|kmail|claws-mail|balsa|sylpheed|trojita|soffice|soffice\.bin|oosplash|libreoffice|wps|onlyoffice-desktopeditors|DesktopEditors|abiword|gnumeric|evince|okular)$/ nocase
    $proc.target.process.file.full_path = /\/((ba|da|z|k|c|tc|a)?sh|python[0-9.]*|perl|ruby|php|node|lua|pwsh|curl|wget|nc|ncat|socat)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1566")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
