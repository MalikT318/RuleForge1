/*
  MITRE Technique : T1200 - Hardware Additions
  Tactic(s)       : Initial Access
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:50:57.539793+00:00
  Reference       : https://attack.mitre.org/techniques/T1200
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1200_Rogue_Device_Internal_Probe_Then_Outbound_Tunnel {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A single internal source address connects to Windows management and lateral-movement ports (SMB, RPC, RDP, WinRM) on internal hosts, then within ten minutes opens an outbound connection to an external destination on a tunnelling or remote-access port (SSH, OpenVPN, PPTP). This pattern is typical of a rogue hardware implant, drop box or unauthorised device that maps the internal network and then calls home. The rule uses only firewall-observable behaviour."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1200"
    mitre_technique_name = "Hardware Additions"
    log_prerequisites = "Firewall or perimeter logs that record source and destination IP, destination port and connection events for both east-west (internal) and egress traffic. East-west visibility requires an internal segmentation firewall or a logging core firewall."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Vulnerability scanners, asset discovery and inventory tools, admin jump hosts, network monitoring systems, IT staff using SSH or VPN clients from a workstation after file-share or RDP activity, and newly deployed legitimate servers or appliances."
    tuning_guidance = "Add authorised scanner and discovery source addresses to %global_allowed_scanners. Add approved admin or jump-host sources to %global_allowed_mgmt_sources. Add known-good external vendor or VPN domains to %global_allowed_domains. Raise the #scan threshold in the condition for noisy segments."

  events:
    $scan.metadata.event_type = "NETWORK_CONNECTION"
    (
      $scan.target.port = 445 or
      $scan.target.port = 135 or
      $scan.target.port = 139 or
      $scan.target.port = 3389 or
      $scan.target.port = 5985 or
      $scan.target.port = 5986
    )
    $scan.target.ip in %rfc1918_internal
    not $scan.principal.ip in %global_allowed_scanners
    not $scan.principal.ip in %global_allowed_mgmt_sources
    $scan.principal.ip = $src_ip

    $out.metadata.event_type = "NETWORK_CONNECTION"
    (
      $out.target.port = 22 or
      $out.target.port = 1194 or
      $out.target.port = 1723
    )
    not $out.target.ip in %rfc1918_internal
    not $out.target.hostname in %global_allowed_domains
    not $out.principal.ip in %global_allowed_scanners
    not $out.principal.ip in %global_allowed_mgmt_sources
    $out.principal.ip = $src_ip

    $scan.metadata.event_timestamp.seconds <= $out.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1200")
    $primary_entity = array_distinct($src_ip)
    $probed_targets = array_distinct($scan.target.ip)
    $probed_ports = array_distinct($scan.target.port)
    $external_destinations = array_distinct($out.target.ip)
    $external_ports = array_distinct($out.target.port)
    $probe_count = count($scan.metadata.id)

  condition:
    #scan >= 5 and $out
}
