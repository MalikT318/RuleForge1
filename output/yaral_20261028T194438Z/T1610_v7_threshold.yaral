/*
  MITRE Technique : T1610 - Deploy Container
  Tactic(s)       : Execution
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:30:28.179777+00:00
  Reference       : https://attack.mitre.org/techniques/T1610
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1610_Container_Workload_Creation_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single identity creates several container workloads (pods, deployments, daemonsets, jobs and similar) within ten minutes. Each creation is normal on its own, but a burst from one non-allowlisted user suggests adversary container deployment for execution, defense evasion, or node-level breakout."
    mitre_tactic = "Execution"
    mitre_technique = "T1610"
    mitre_technique_name = "Deploy Container"
    log_prerequisites = "Requires Kubernetes control-plane audit logs (or container runtime API audit logs) ingested and normalised to UDM RESOURCE_CREATION, with principal.user.userid and target.resource.resource_subtype populated."
    platform = "Containers"
    log_source = "container"
    false_positives = "CI/CD pipelines and GitOps controllers deploying releases under user identities, developers running load tests or scaling experiments, batch or ML workflow engines that create many jobs or pods, and cluster-autoscaler or operator identities not yet in the allowlists."
    tuning_guidance = "Add CI/CD, GitOps, and operator identities to %global_allowed_service_accounts, and trusted platform administrators to %global_allowed_admin_users. Add approved cloud or identity principals to %global_allowed_cloud_principals. Raise the #cloud threshold for noisy clusters. If the tenant's parser populates a different field for the Kubernetes resource kind, adjust the target.resource.resource_subtype filter."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.target.resource.resource_subtype = /^(pods?|deployments?|daemonsets?|replicasets?|statefulsets?|jobs?|cronjobs?|containers?)$/ nocase
    $cloud.principal.user.userid != ""
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid = /^system:(node|kube-|serviceaccount:kube-system)/ nocase
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  match:
    $user over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($cloud.metadata.id)
    $mitre_technique_id = array_distinct("T1610")
    $primary_entity = array_distinct($user)
    $created_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    #cloud >= 5
}
