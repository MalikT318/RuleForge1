/*
  MITRE Technique : T1552.003 - Shell History
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:49:11.447109+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_003_Linux_Shell_History_Network_Exfil {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux process that opens an outbound connection to a non-internal address while its own command line references a shell or interpreter history file (bash, zsh, sh, fish, zsh-style). This is the network-side view of shell history being uploaded, streamed or copied off-host, and complements process-creation rules because it only fires when the transfer reaches an external destination."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.003"
    mitre_technique_name = "Unsecured Credentials: Shell History"
    log_prerequisites = "Requires Linux EDR or auditd-based network telemetry that populates principal.process.command_line and target.ip on NETWORK_CONNECTION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup or configuration-sync agents that name history files explicitly, dotfile synchronisation tools, admins copying their own history to an external jump host, forensic or incident-response collection tooling, and DLP or EDR agents that upload file telemetry."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes, sanctioned sync or deployment tooling to %global_allowed_admin_tools, security agents to %global_allowed_security_tools, and approved remote management tools to %global_allowed_remote_mgmt. Add authorised forensic collection hosts or accounts to %global_allowed_admin_users."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.command_line = /(\.bash_history|\.zsh_history|\.zhistory|\.sh_history|\.histfile|fish_history)/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1552.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_user = array_distinct($net.principal.user.userid)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $process_command_line = array_distinct($net.principal.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
