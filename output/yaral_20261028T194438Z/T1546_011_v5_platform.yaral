/*
  MITRE Technique : T1546.011 - Application Shimming
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:15:35.377306+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_011_AppCompat_Shim_Database_Registry_Registration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry writes that register a custom application compatibility shim database under AppCompatFlags InstalledSDB or Custom. This is the persistence and privilege-escalation mechanism of application shimming. The rule keys on the registry artefact rather than the sdbinst command line, so it also covers shims registered by renamed installers, custom code or direct API calls. T1546.011 is a Windows-only technique, so the alternate-platform angle does not apply and this rule is written for Windows registry telemetry."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.011"
    mitre_technique_name = "Event Triggered Execution: Application Shimming"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR registry events or Sysmon Event ID 12/13/14) normalised to UDM REGISTRY_MODIFICATION with target.registry.registry_key populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate application compatibility fixes deployed by IT with the Compatibility Administrator, software installers that ship their own shim databases (legacy line-of-business apps), and enterprise deployment tooling."
    tuning_guidance = "Add approved deployment and packaging tools to %global_allowed_admin_tools, EDR and security agents to %global_allowed_security_tools, and named compatibility administrators to %global_allowed_admin_users. Review the shim database path in the registry value for any hit before suppressing."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\software\\(wow6432node\\)?microsoft\\windows nt\\currentversion\\appcompatflags\\(installedsdb|custom)(\\|$)/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1546.011")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_name)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
