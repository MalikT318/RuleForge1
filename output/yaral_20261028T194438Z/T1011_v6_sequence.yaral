/*
  MITRE Technique : T1011 - Exfiltration Over Other Network Medium
  Tactic(s)       : Exfiltration
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:21:00.026500+00:00
  Reference       : https://attack.mitre.org/techniques/T1011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1011_Windows_Host_Secondary_Channel_Bulk_Upload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Perimeter-observable approximation of exfiltration over a different medium than the C2 channel. A host first shows a low-volume external HTTPS session (beacon-like C2 baseline), then within 10 minutes pushes a large outbound transfer to a different external destination over a non-web port (separate channel or protocol). This is a heuristic: a firewall cannot see the physical medium (WiFi, cellular, Bluetooth), so a different destination and protocol is used as a proxy. Correlated by host."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1011"
    mitre_technique_name = "Exfiltration Over Other Network Medium"
    log_prerequisites = "Firewall or proxy connection and flow logs with principal.hostname (or asset-to-IP enrichment), target.ip, target.port and network.sent_bytes populated. Hostname resolution for Windows endpoints must be enabled in the parser."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Backup and replication jobs to offsite targets, cloud sync clients on non-standard ports, software or patch distribution uploads, large legitimate SFTP/FTPS transfers by IT or business users, and vulnerability scanner or pentest traffic."
    tuning_guidance = "Raise or lower the sent_bytes threshold per client baseline. Add known sync and backup source addresses to %global_allowed_mgmt_sources and known-good destination names to %global_allowed_domains. Add scanner hostnames to %global_allowed_scanners. Extend the excluded port list for client-approved services."

  events:
    $c2.metadata.event_type = "NETWORK_CONNECTION"
    $c2.target.port = 443
    $c2.network.sent_bytes > 0
    $c2.network.sent_bytes < 5000
    not $c2.target.ip in %rfc1918_internal
    not $c2.target.hostname in %global_allowed_domains
    $c2.principal.hostname = $hostname

    $exfil.metadata.event_type = "NETWORK_FLOW"
    $exfil.network.sent_bytes > 52428800
    $exfil.target.port != 443
    $exfil.target.port != 80
    $exfil.target.port != 53
    $exfil.target.port != 8080
    not $exfil.target.ip in %rfc1918_internal
    not $exfil.target.hostname in %global_allowed_domains
    not $exfil.principal.ip in %global_allowed_mgmt_sources
    not $exfil.principal.hostname in %global_allowed_scanners
    $exfil.principal.hostname = $hostname

    $c2.target.ip != $exfil.target.ip
    $c2.metadata.event_timestamp.seconds <= $exfil.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1011")
    $primary_entity = array_distinct($hostname)
    $c2_destinations = array_distinct($c2.target.ip)
    $exfil_destinations = array_distinct($exfil.target.ip)
    $exfil_ports = array_distinct($exfil.target.port)
    $max_bytes_sent = max($exfil.network.sent_bytes)

  condition:
    $c2 and $exfil
}
