/*
  MITRE Technique : T1072 - Software Deployment Tools
  Tactic(s)       : Execution, Lateral Movement
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:15:38.392512+00:00
  Reference       : https://attack.mitre.org/techniques/T1072
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1072_SaaS_Remote_Command_Via_Management_Plane {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a human or unrecognised identity invoking a remote command, script deployment, or interactive session API on a cloud or SaaS endpoint-management plane. Adversaries with administrative access to these centralised management services can execute code on every managed host or instance without touching the endpoint directly. The rule works on the control-plane audit record (API method name) and does not depend on process telemetry."
    mitre_tactic = "Execution, Lateral Movement"
    mitre_technique = "T1072"
    mitre_technique_name = "Software Deployment Tools"
    log_prerequisites = "Requires cloud control-plane audit logs (management-plane API activity) ingested and normalised to UDM with metadata.product_event_type and principal.user.userid populated. Management-event logging must be enabled for the endpoint-management and configuration-management services."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate administrators running patching or remediation scripts, CI/CD pipeline roles deploying configuration, break-glass troubleshooting sessions, automated compliance and inventory associations, and onboarding of new managed devices."
    tuning_guidance = "Add approved automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named administrators to %global_allowed_admin_users. Raise risk by correlating with a recent USER_LOGIN from a new location for the same principal. If the API name set is too noisy, remove the interactive-session names and keep only bulk command and script deployment methods."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /(SendCommand|StartSession|StartAutomationExecution|CreateAssociation|RunCommand|InvokeCommand|runCommand|deviceManagementScript|deviceShellScript|executeScript|CreateDeployment)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1072")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_method = array_distinct($cloud.metadata.product_event_type)
    $target_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
