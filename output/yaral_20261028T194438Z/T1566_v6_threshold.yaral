/*
  MITRE Technique : T1566 - Phishing
  Tactic(s)       : Initial Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:46:19.706114+00:00
  Reference       : https://attack.mitre.org/techniques/T1566
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1566_SaaS_Identity_External_Login_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of external-source sign-in events against a single identity within ten minutes. A large volume of logins for one account is consistent with the use of credentials or session tokens harvested by a phishing campaign (credential harvesting, adversary-in-the-middle replay, or follow-on access). Each login on its own is benign. The volume is the signal."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1566"
    mitre_technique_name = "Phishing"
    log_prerequisites = "Requires identity provider sign-in audit logs normalised to UDM USER_LOGIN with principal.user.userid and principal.ip populated."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Users behind corporate VPN or proxy egress addresses that are not internal ranges, shared or kiosk accounts, mobile clients that re-authenticate repeatedly, SSO-integrated applications that generate a sign-in per app, and unlisted monitoring or synthetic-login accounts."
    tuning_guidance = "Add automation and synthetic-login accounts to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Raise the #auth threshold for tenants with heavy SSO app fan-out, or lower it for high-risk groups such as executives and finance. Review the source_ips and applications outcome fields to separate a burst from one IP (likely noisy client) from a burst across many IPs (likely credential replay)."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid = $user
    $auth.principal.user.userid != ""
    $auth.principal.ip != ""
    not $auth.principal.ip in %rfc1918_internal
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1566")
    $primary_entity = array_distinct($user)
    $login_count = count($auth.metadata.id)
    $source_ips = array_distinct($auth.principal.ip)
    $applications = array_distinct($auth.target.application)

  condition:
    #auth >= 8
}
