/*
  MITRE Technique : T1036.005 - Match Legitimate Resource Name or Location
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:04:52.594452+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_005_ESXi_Daemon_Name_From_Writable_Path_Shell_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process that carries the name of a core ESXi daemon or utility (hostd, vpxa, sshd, vmx, crond, etc.) but is launched from a writable or persistent non-system location (/tmp, /var/tmp, /dev/shm, /scratch, /store, /var/run, /root, /vmfs/volumes) by an interactive shell or sshd parent. Genuine ESXi daemons start from /bin, /sbin or /usr/lib/vmware via init, watchdog or init scripts, never from a shell session or a user-writable path. This catches masquerading through lineage and location, independent of command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.005"
    mitre_technique_name = "Masquerading: Match Legitimate Resource Name or Location"
    log_prerequisites = "ESXi shell and process execution telemetry that populates parent and child process paths, forwarded to Chronicle and normalised to UDM PROCESS_LAUNCH. Requires principal.process.file.full_path (parent) and target.process.file.full_path (child)."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators running vendor VIB or driver tooling, health-check or support utilities staged in /tmp or on a datastore; patching or upgrade scripts that stage binaries in /scratch or /tmp; backup or monitoring agents deployed under /vmfs/volumes or /store; lab or test hosts."
    tuning_guidance = "Add approved parent shells or automation hosts to %global_allowed_script_hosts. Add approved staged tooling (full path) to %global_allowed_admin_tools. Extend the daemon-name list or writable-path list per client baseline. Review hits for the user (principal.user.userid) and the source of the SSH session."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(sshd|ash|sh|bash|dash)$/ nocase
    $proc.target.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|scratch|store|var\/run|root|vmfs\/volumes)\/(.*\/)?(hostd|vpxa|fdm|vmx|vmtoolsd|sshd|rhttpproxy|vobd|sfcbd|crond|ntpd|slpd|dcui|esxcli|vmkfstools|vmkeventd|syslogd|vmware-hostd|vmsyslogd|busybox|init|watchdog)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1036.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
