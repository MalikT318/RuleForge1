/*
  MITRE Technique : T1114 - Email Collection
  Tactic(s)       : Collection
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:15:47.823524+00:00
  Reference       : https://attack.mitre.org/techniques/T1114
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_Linux_Mail_Store_Archive_Or_Copy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an archive, copy or transfer utility launched with a local mail store (mbox spool, Maildir, Thunderbird or Evolution profile, PST/OST/mbox files) in its command line. This is the typical way an adversary stages user email for collection and exfiltration on Linux."
    mitre_tactic = "Collection"
    mitre_technique = "T1114"
    mitre_technique_name = "Email Collection"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to UDM PROCESS_LAUNCH with full command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Mail server backup jobs, mailbox migration or archival performed by administrators, user-initiated profile backups, MTA/MDA maintenance scripts, eDiscovery or legal-hold exports."
    tuning_guidance = "Add backup agents to %global_allowed_backup_processes, approved migration and admin tooling to %global_allowed_admin_tools, and mail automation accounts to %global_allowed_service_accounts. If a mail host produces regular noise, scope exclusions by parent process rather than by path."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(tar|zip|7z|7za|7zr|rsync|cp|scp|sftp|gzip|bzip2|xz|zstd|dd|base64|curl|wget|nc|ncat|socat)$/ nocase
    $proc.target.process.command_line = /(\/var\/(spool\/)?mail(\/|\s|$)|\.thunderbird|\.mozilla-thunderbird|snap\/thunderbird|\.local\/share\/evolution\/mail|\/Maildir(\/|\s|$)|\.mbox\b|\.pst\b|\.ost\b)/ nocase
    not $proc.principal.process.file.full_path = /\/(dovecot|postfix|master|exim4?|sendmail|procmail|logrotate)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.target.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1114")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $tool = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
