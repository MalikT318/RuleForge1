/*
  MITRE Technique : T1027.014 - Polymorphic Code
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:01:20.004763+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_014_Linux_Self_Modifying_Binary_In_Writable_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an executable that rewrites its own file on disk from a world-writable staging directory (/tmp, /var/tmp, /dev/shm, /run/user). Self-mutation of the running image is the core runtime behaviour of polymorphic and metamorphic malware, which regenerates its own body to change its signature between executions. This rule uses file-modification telemetry and process-to-file identity, not command-line matching."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.014"
    mitre_technique_name = "Obfuscated Files or Information: Polymorphic Code"
    log_prerequisites = "Linux EDR or auditd file-write telemetry (FILE_MODIFICATION) with both the writing process path and the target file path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Self-updating utilities or installers that stage in /tmp and overwrite themselves, developer build and test binaries that relink in place, and self-extracting packers used by legitimate software. Some EDR agents rewrite their own staging binaries."
    tuning_guidance = "Add the writing process path of approved updaters or deployment tools to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Exclude build or CI hosts through %global_allowed_script_hosts if developer workloads trigger the rule. Extend the directory regex if clients use other world-writable staging paths."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/user\/[0-9]+)\// 
    $file.principal.process.file.full_path != ""
    $file.principal.process.file.full_path = $file.target.file.full_path
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1027.014")
    $primary_entity = array_distinct($file.principal.hostname)
    $mutated_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
