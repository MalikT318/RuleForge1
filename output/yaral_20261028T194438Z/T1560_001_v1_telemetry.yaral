/*
  MITRE Technique : T1560.001 - Archive via Utility
  Tactic(s)       : Collection
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:57:17.022402+00:00
  Reference       : https://attack.mitre.org/techniques/T1560/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1560_001_Linux_Archive_Staged_In_Temp_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a compressed or encrypted archive file in a world-writable staging directory (/tmp, /var/tmp, /dev/shm) on Linux. This detects the resulting file artifact of archive-utility use (T1560.001) rather than the command line, so it still fires if command-line logging is evaded, the utility is renamed, or the archive is built by a script or library."
    mitre_tactic = "Collection"
    mitre_technique = "T1560.001"
    mitre_technique_name = "Archive Collected Data: Archive via Utility"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry that populates target.file.full_path and principal.process.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup and imaging agents, package managers and software installers unpacking or downloading to /tmp, log rotation or support-bundle collection scripts, developers and build pipelines, application crash or diagnostic dumpers, and admins collecting files for support cases."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes, approved admin and deployment tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. If /tmp is too noisy in a given environment, narrow the path regex to /dev/shm and /var/tmp only. Raise severity when the creating process is a shell or interpreter, or when the host is a database or file server."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(dev\/shm|var\/tmp|tmp)\/.*\.(tar|tar\.gz|tgz|tar\.bz2|tbz2|tar\.xz|txz|tar\.zst|zip|7z|rar|gz|bz2|xz|zst|gpg|enc)$/ nocase
    not $file.principal.process.file.full_path = /\/(apt|apt-get|dpkg|dnf|yum|rpm|packagekitd|snapd|unattended-upgrade|logrotate|systemd-coredump)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1560.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $archive_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
