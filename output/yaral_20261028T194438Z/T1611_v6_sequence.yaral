/*
  MITRE Technique : T1611 - Escape to Host
  Tactic(s)       : Privilege Escalation
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:32:16.831505+00:00
  Reference       : https://attack.mitre.org/techniques/T1611
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1611_Container_Breakout_Prep_Then_Host_Namespace_Entry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Within one container or node, a process first prepares a breakout (mounting a host block device, touching a container runtime socket, or manipulating a cgroup release_agent) and then enters host namespaces or pivots into a host-mounted root via nsenter or chroot within 10 minutes."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1611"
    mitre_technique_name = "Escape to Host"
    log_prerequisites = "Requires container runtime or node-level process telemetry (for example runtime security sensor or auditd execve) with command lines for in-container PROCESS_LAUNCH events, and a consistent principal.hostname across both events."
    platform = "Containers"
    log_source = "container"
    false_positives = "Node debugging via privileged debug pods, CI/CD build agents using Docker-in-Docker or a mounted runtime socket, storage or CSI driver pods that mount block devices, and SRE break-glass troubleshooting."
    tuning_guidance = "Add approved debug, build and storage tooling to %global_allowed_admin_tools, runtime monitoring agents to %global_allowed_security_tools, and break-glass accounts to %global_allowed_admin_users. If hostnames are node names rather than pod names in your environment, review the join scope."

  events:
    $prep.metadata.event_type = "PROCESS_LAUNCH"
    $prep.target.process.command_line = /(\bmount\b\s+(-\S+\s+)*\/dev\/(sd|nvme|xvd|vd|dm-)\S*|(docker|containerd|crio|cri-dockerd)\.sock|release_agent)/ nocase
    not $prep.principal.process.file.full_path in %global_allowed_admin_tools
    not $prep.principal.process.file.full_path in %global_allowed_security_tools
    not $prep.principal.user.userid in %global_allowed_admin_users
    $prep.principal.hostname = $hostname

    $esc.metadata.event_type = "PROCESS_LAUNCH"
    $esc.target.process.file.full_path = /\/(nsenter|chroot)$/ nocase
    $esc.target.process.command_line = /(nsenter\b.*(-t|--target)[ =]+1\b|chroot\s+(-\S+\s+)*\S*(host|hostfs|mnt|rootfs))/ nocase
    not $esc.principal.process.file.full_path in %global_allowed_admin_tools
    not $esc.principal.process.file.full_path in %global_allowed_security_tools
    not $esc.principal.user.userid in %global_allowed_admin_users
    $esc.principal.hostname = $hostname

    $prep.metadata.event_timestamp.seconds <= $esc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1611")
    $primary_entity = array_distinct($esc.principal.hostname)
    $prep_commands = array_distinct($prep.target.process.command_line)
    $escape_commands = array_distinct($esc.target.process.command_line)
    $users = array_distinct($esc.principal.user.userid)
    $event_count = count($esc.metadata.id)

  condition:
    $prep and $esc
}
