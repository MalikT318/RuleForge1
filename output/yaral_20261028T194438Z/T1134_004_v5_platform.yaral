/*
  MITRE Technique : T1134.004 - Parent PID Spoofing
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:00:27.419382+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_004_Core_System_Process_Spawns_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a script interpreter or LOLBin launched with a core Windows system process as its parent (lsass, winlogon, wininit, csrss, smss, spoolsv, dwm, fontdrvhost). These processes essentially never spawn interactive shells or proxy-execution binaries. This lineage is a strong indicator of parent PID spoofing, where an attacker passes a handle to a privileged process as the parent in CreateProcess to hide the real origin and blend in with system activity. Windows-only. Linux and macOS have no equivalent user-controllable PPID mechanism, so no rule is written for them."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.004"
    mitre_technique_name = "Access Token Manipulation: Parent PID Spoofing"
    log_prerequisites = "Requires EDR process-launch telemetry or Sysmon Event ID 1 with populated parent (principal.process) and child (target.process) image paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Accessibility-feature or recovery tooling launched from winlogon, printer drivers or print-management scripts spawning cmd from spoolsv, security agents that inject or spawn helpers from system processes, custom enterprise logon scripts, and EDR sensors that report a spoofed or reassigned parent for legitimate elevation helpers."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_security_tools. Add approved script-launching parents to %global_allowed_script_hosts. For print-server estates, review spoolsv-parented hits first and allowlist known driver-install workflows by parent path."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(lsass|winlogon|wininit|csrss|smss|spoolsv|dwm|fontdrvhost)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|powershell_ise|pwsh|rundll32|regsvr32|mshta|wscript|cscript|msbuild|installutil|regasm|regsvcs)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1134.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
