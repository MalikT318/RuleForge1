/*
  MITRE Technique : T1564.007 - VBA Stomping
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:25:10.825074+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_007_Linux_Macro_Doc_Rewritten_By_Runtime {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a macro-capable Office document (OLE or OOXML) being modified on a Linux host by a scripting or managed runtime process (mono, dotnet, python, perl, ruby, pwsh, wine). Linux has no native Office VBA host, so in-place rewriting of a macro document by a runtime is the way VBA stomping is performed on Linux. Stomping tools overwrite module source streams while leaving the p-code intact. This rule is file-modification based and does not overlap with command-line rules."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.007"
    mitre_technique_name = "Hide Artifacts: VBA Stomping"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd with file-write watches that populate principal.process.file.full_path and target.file.full_path on FILE_MODIFICATION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Document-automation pipelines (python-docx, openpyxl, Apache POI wrappers), mail gateways or sandboxes that sanitise attachments, DLP and CDR tooling, report-generation jobs that fill Office templates, and developers testing macro documents."
    tuning_guidance = "Add approved automation runtimes and wrapper scripts to %global_allowed_script_hosts. Add document-processing tooling to %global_allowed_admin_tools. If a host legitimately runs document pipelines, narrow the rule to staging paths (/tmp, /var/tmp, /dev/shm, /home) or raise the severity only for those paths."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\.(doc|docm|dot|dotm|xls|xlsm|xlt|xltm|xlam|ppt|pptm|potm|ppam)$/ nocase
    $file.principal.process.file.full_path = /\/(mono|mono-sgen|dotnet|python[0-9.]*|perl|ruby|pwsh|wine|wine64)$/ nocase
    not $file.principal.process.file.full_path = /\/(soffice|soffice\.bin|libreoffice|oosplash)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1564.007")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_documents = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
