/*
  MITRE Technique : T1685.002 - Disable or Modify Cloud Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:18:19.908607+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_002_M365_Audit_Logging_Tampering_Then_Data_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A user disables or modifies audit logging configuration (mailbox audit bypass, admin audit log config, unified audit ingestion) and then accesses or downloads files or mail items within ten minutes. This pattern indicates an adversary blinding audit collection before acting on objectives."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.002"
    mitre_technique_name = "Disable or Modify Cloud Log"
    log_prerequisites = "Requires unified audit logs ingested into UDM, including Exchange admin audit events (SETTING_MODIFICATION with metadata.product_event_type populated) and file or mailbox access events (USER_RESOURCE_ACCESS)."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Exchange administrators legitimately adding audit-bypass associations for service or journaling accounts and then using the same account to access content; compliance staff changing audit retention or config; tenant migration projects; break-glass admin testing."
    tuning_guidance = "Add approved admin accounts to %global_allowed_admin_users and automation or migration accounts to %global_allowed_service_accounts. Extend or narrow the product_event_type regexes to match how the tenant's parser populates the audit operation name. Lengthen or shorten the 10m window if needed."

  events:
    $audit.metadata.event_type = "SETTING_MODIFICATION"
    $audit.metadata.product_event_type = /(Set-MailboxAuditBypassAssociation|Set-AdminAuditLogConfig|AuditBypass|UnifiedAuditLogIngestion|Disable-.*Audit|Set-.*AuditLog)/ nocase
    $audit.principal.user.userid = $user
    not $audit.principal.user.userid in %global_allowed_admin_users
    not $audit.principal.user.userid in %global_allowed_service_accounts

    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.metadata.product_event_type = /(FileDownloaded|FileSyncDownloadedFull|FileCopied|MailItemsAccessed|FileAccessed)/ nocase
    $access.principal.user.userid = $user

    $audit.metadata.event_timestamp.seconds <= $access.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1685.002")
    $primary_entity = array_distinct($user)
    $audit_operations = array_distinct($audit.metadata.product_event_type)
    $access_operations = array_distinct($access.metadata.product_event_type)
    $access_count = count($access.metadata.id)
    $source_ips = array_distinct($audit.principal.ip)

  condition:
    $audit and $access
}
