/*
  MITRE Technique : T1542.003 - Bootkit
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:47:43.567910+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_003_ESP_Mount_Then_Boot_File_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a bootkit-style staging sequence on Windows: the EFI System Partition is mounted to a drive letter with the built-in volume mount utility, then an executable boot component (.efi, .sys, .dll, .exe, .bin) is created under the \\EFI\\ directory of a volume root on the same host within 10 minutes. Normal operation rarely writes boot binaries to the ESP from user-initiated processes."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.003"
    mitre_technique_name = "Pre-OS Boot: Bootkit"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with command lines and file-creation telemetry that includes the writing process (EDR or Sysmon Event IDs 1 and 11)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Firmware and BIOS update utilities, OEM recovery or imaging tools, OS servicing and feature updates, bcdboot-based repair, dual-boot and Linux installers, disk encryption and secure-boot management tooling, IT staff repairing boot configuration."
    tuning_guidance = "Add approved imaging, deployment, firmware-update and boot-repair binaries to %global_allowed_admin_tools. Add EDR/AV agents that scan the ESP to %global_allowed_security_tools. If the file-creation telemetry does not populate the writing process, the exclusions on that event are inert, so review the first alerts for servicing noise. Extend the 10m window only if the mount and the write are being split across a reboot."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\mountvol\.exe$/ nocase
    $proc.target.process.command_line = /\s[\/-]s(\s|$)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^([a-z]:|\\Device\\HarddiskVolume\d+)\\EFI\\.+\.(efi|sys|dll|exe|bin)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path = /\\(TiWorker|TrustedInstaller|SetupHost)\.exe$/ nocase
    $file.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1542.003")
    $primary_entity = array_distinct($hostname)
    $mount_command_lines = array_distinct($proc.target.process.command_line)
    $mount_parent_processes = array_distinct($proc.principal.process.file.full_path)
    $written_boot_files = array_distinct($file.target.file.full_path)
    $writing_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($proc.principal.user.userid)

  condition:
    $proc and $file
}
