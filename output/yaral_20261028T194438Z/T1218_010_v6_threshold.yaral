/*
  MITRE Technique : T1218.010 - Regsvr32
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:55:37.516874+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_010_Regsvr32_Repeated_External_Connections {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Regsvr32.exe makes repeated outbound connections to external addresses from a single host within ten minutes. Regsvr32 does not normally initiate network traffic, so repeated external connections suggest remote scriptlet or DLL retrieval (Squiblydoo-style proxy execution). Detection is based on network telemetry attributed to the process, not on its command line."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.010"
    mitre_technique_name = "System Binary Proxy Execution: Regsvr32"
    log_prerequisites = "Requires Windows endpoint network telemetry (EDR or Sysmon Event ID 3) with process attribution populated on NETWORK_CONNECTION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Installers or software updaters that register DLLs fetched from vendor CDNs, certificate revocation or signature validation traffic triggered during registration, and application packaging or deployment tooling run under service accounts."
    tuning_guidance = "Add expected service accounts to %global_allowed_service_accounts and known-good vendor destinations to %global_allowed_domains. Raise the #net threshold if a client runs frequent legitimate DLL registration over the network. Lower it to 1 for high-security environments."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\regsvr32\.exe$/ nocase
    $net.principal.hostname = $host
    not $net.target.ip in %rfc1918_internal
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.target.hostname in %global_allowed_domains

  match:
    $host over 10m

  outcome:
    $risk_score = max(75)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1218.010")
    $primary_entity = array_distinct($host)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $users = array_distinct($net.principal.user.userid)

  condition:
    #net >= 3
}
