/*
  MITRE Technique : T1059.011 - Lua
  Tactic(s)       : Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:22:50.154096+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_011_Lua_Script_Download_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal client retrieving a Lua script (.lua URL path) from an external destination over HTTP/HTTPS as seen by a proxy or firewall with URL visibility. Lua-based malware families commonly fetch scripts, modules or payloads from remote servers. This is network-side coverage that complements endpoint command-line detections and does not depend on process telemetry."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.011"
    mitre_technique_name = "Command and Scripting Interpreter: Lua"
    log_prerequisites = "Requires proxy or firewall logs normalised to NETWORK_HTTP with target.url populated (for example URL filtering or TLS-inspected web traffic). Without URL visibility this rule will not fire."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Games and game launchers or mod managers that download Lua scripts, developer package managers and build tooling (for example LuaRocks), embedded-Lua applications updating from vendor CDNs, network monitoring or web-server software that fetches Lua configuration, and legitimate developers browsing Lua repositories."
    tuning_guidance = "Add known-good vendor and CDN domains to %global_allowed_domains. Add approved internal scanner or testing sources to %global_allowed_scanners. Add approved developer or build egress sources to %global_allowed_mgmt_sources. Consider raising severity for server subnets where Lua downloads are never expected."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^GET$/ nocase
    $http.target.url = /\.lua($|\?|#)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1059.011")
    $primary_entity = array_distinct($http.principal.ip)
    $source_hostname = array_distinct($http.principal.hostname)
    $destination_host = array_distinct($http.target.hostname)
    $destination_ip = array_distinct($http.target.ip)
    $requested_url = array_distinct($http.target.url)

  condition:
    $http
}
