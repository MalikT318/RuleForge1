/*
  MITRE Technique : T1609 - Container Administration Command
  Tactic(s)       : Execution
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:27:15.228110+00:00
  Reference       : https://attack.mitre.org/techniques/T1609
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1609_Container_App_Service_Spawns_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter launched inside a container by a web server, application server or database service process. Services such as nginx, apache, php-fpm, tomcat, mysqld, postgres, mongod or redis rarely spawn shells in normal operation. This lineage typically indicates a web shell, remote command injection, or a command executed through an exposed container administration interface."
    mitre_tactic = "Execution"
    mitre_technique = "T1609"
    mitre_technique_name = "Container Administration Command"
    log_prerequisites = "Requires in-container process launch telemetry with parent and child process paths, for example a container runtime security sensor or a node-level EDR agent that normalises to UDM PROCESS_LAUNCH. Kubernetes audit logs alone do not carry process lineage."
    platform = "Containers"
    log_source = "container"
    false_positives = "Database or web server images whose entrypoint, health check, backup, or log-rotation scripts are invoked directly by the service; PHP applications that call shell_exec or system for legitimate tasks; database maintenance hooks (for example postgres archive_command or mysqld init scripts); CI/CD test containers; admin debugging via an app-owned process."
    tuning_guidance = "Add known-good parent process paths or container hostnames to %global_allowed_script_hosts. Add approved management tooling to %global_allowed_admin_tools. Extend the parent regex with java or node runtimes only if those images do not routinely shell out. Scope by image or namespace through the SIEM context if specific workloads legitimately spawn shells."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|httpd|apache2|php-fpm[0-9.]*|lighttpd|caddy|haproxy|tomcat[0-9]*|catalina|mysqld|mariadbd|postgres|mongod|redis-server|memcached)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|ash|zsh|ksh|csh|tcsh|busybox)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.hostname in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1609")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $run_as_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
