/*
  MITRE Technique : T1546.002 - Screensaver
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:02:36.029273+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_002_Screensaver_Executed_By_Anomalous_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a screensaver executable (.scr) launched by a parent process that should never start one, such as an Office application, script host, command interpreter, web server, database service, print spooler, WMI provider host or browser. In normal operation Winlogon launches screensavers on user inactivity, and users preview them through the Control Panel. A .scr started from any of these parents indicates the PE is being executed or staged as a persistence payload, or is a renamed binary using the screensaver extension. This is lineage-based and does not depend on command-line content or registry values."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.002"
    mitre_technique_name = "Event Triggered Execution: Screensaver"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with populated parent (principal.process) and child (target.process) image paths, from EDR, Sysmon Event ID 1 or Security Event 4688 with parent process logging."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or help-desk staff testing screensavers from cmd or PowerShell; login scripts or GPO scripts that preview or deploy corporate screensavers; software packaging or deployment tools that launch a .scr during install validation; some legacy line-of-business applications that spawn a .scr from a macro or script."
    tuning_guidance = "Add approved script-launching parent processes to %global_allowed_script_hosts and deployment or packaging tooling to %global_allowed_admin_tools. If cmd or PowerShell parents are noisy, remove them from the parent regex rather than excluding whole hosts. Pair with registry-based SCRNSAVE.EXE detections for full coverage."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\.scr$/ nocase
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|onenote|wscript|cscript|mshta|powershell|pwsh|cmd|wmiprvse|w3wp|httpd|nginx|tomcat\d*|java|sqlservr|spoolsv|chrome|msedge|firefox|iexplore|regsvr32|rundll32|msiexec)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1546.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
