/*
  MITRE Technique : T1071 - Application Layer Protocol
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:02:30.874960+00:00
  Reference       : https://attack.mitre.org/techniques/T1071
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_NonStandard_Port_HTTP_Then_Large_Outbound_Flow {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An internal host sends HTTP traffic to an external destination on a non-standard port, then sends a large volume of outbound data to the same external IP on a non-web port within five minutes. This pattern suggests application-layer C2 or tunnelling that avoids standard web port filtering."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071"
    mitre_technique_name = "Application Layer Protocol"
    log_prerequisites = "Requires firewall or proxy logs that populate NETWORK_HTTP (with target port) and NETWORK_FLOW (with sent bytes and source/destination IPs)."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Vendor update or telemetry services on custom ports, developer or test web servers on high ports, cloud backup or sync clients, internally approved SaaS agents using non-standard ports, vulnerability scanners."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains and scanner or authorised testing source IPs to %global_allowed_scanners. Adjust the sent_bytes threshold (100000) to match client traffic baselines. Extend the allowed port list if a client legitimately uses additional web ports."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.port > 0
    $http.target.port != 80
    $http.target.port != 443
    $http.target.port != 8080
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners
    $http.principal.ip = $src_ip
    $http.target.ip = $dst_ip

    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.network.sent_bytes > 100000
    $flow.target.port > 0
    $flow.target.port != 80
    $flow.target.port != 443
    not $flow.target.ip in %rfc1918_internal
    not $flow.principal.ip in %global_allowed_scanners
    $flow.principal.ip = $src_ip
    $flow.target.ip = $dst_ip

    $http.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $src_ip, $dst_ip over 5m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1071")
    $primary_entity = array_distinct($src_ip)
    $destination_ips = array_distinct($dst_ip)
    $http_ports = array_distinct($http.target.port)
    $flow_ports = array_distinct($flow.target.port)
    $total_sent_bytes = sum($flow.network.sent_bytes)

  condition:
    $http and $flow
}
