/*
  MITRE Technique : T1548.002 - Bypass User Account Control
  Tactic(s)       : Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:30:18.714056+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_002_UAC_Bypass_Registry_Hijack_Autoelevate {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects per-user registry modifications that hijack Windows auto-elevating handlers, used to bypass UAC without a prompt. Covers shell\\open\\command hijacks under the per-user Classes hive for handlers such as ms-settings, mscfile, exefile, Folder and AppX, plus the windir/systemroot environment variable override in HKCU\\Environment. Detection is based on the registry state change, so it still fires when command-line logging is evaded or the launcher binary is renamed."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.002"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Bypass User Account Control"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon registry events) with registry_key and registry_value_name populated, and principal process path where available."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers or user-level file association tools writing per-user shell handlers (e.g. Folder or exefile associations); developer tooling that sets a custom windir/systemroot environment variable; IT scripts customising per-user handlers; profile or settings migration tools."
    tuning_guidance = "Add approved deployment and IT tooling executables to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. If a client legitimately registers per-user handlers, add the writing process path to %global_allowed_admin_tools, or add the writing user to %global_allowed_admin_users. Review the registry_key and registry_data outcome fields before suppressing."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      $reg.target.registry.registry_key = /\\(software\\classes|[^\\]*_classes)\\(ms-settings|mscfile|exefile|folder|launcher\.systemsettings|appx[a-z0-9]+)\\shell\\open\\command$/ nocase
      or
      (
        $reg.target.registry.registry_key = /\\environment$/ nocase
        and $reg.target.registry.registry_value_name = /^(windir|systemroot)$/ nocase
      )
    )
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1548.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $registry_data = array_distinct($reg.target.registry.registry_value_data)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
