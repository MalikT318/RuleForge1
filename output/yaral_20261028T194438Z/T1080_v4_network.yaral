/*
  MITRE Technique : T1080 - Taint Shared Content
  Tactic(s)       : Lateral Movement
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:22:05.388819+00:00
  Reference       : https://attack.mitre.org/techniques/T1080
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1080_Outbound_SMB_To_External_Taint_Share {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows client making an SMB or NetBIOS session connection (TCP 445/139) to a non-internal address, as seen at the network perimeter. Tainted shared content, such as shortcut (.LNK), SCF or Office files with UNC icon or template paths planted on a share, makes every client that browses the folder reach out over SMB to an attacker-controlled host. File-sharing protocols are normally blocked at the egress boundary, so a permitted or attempted outbound connection is a strong network-side indicator of tainted shared content or of lateral-movement staging."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1080"
    mitre_technique_name = "Taint Shared Content"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs must cover egress traffic, including denied connections if the firewall records them."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate cloud file services reached over SMB (for example Azure Files over port 445), partner or vendor file shares across site-to-site links with public addressing, authorised external vulnerability scanning or penetration tests, and misconfigured clients mapping drives to public addresses."
    tuning_guidance = "Add authorised scanner and testing source addresses to %global_allowed_scanners. Add approved management or file-transfer source addresses to %global_allowed_mgmt_sources. Keep %rfc1918_internal current for each client's internal address space. If the client's firewall logs denied traffic and alert volume is high, consider raising severity only for connections the firewall allowed."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 445 or $net.target.port = 139)
    $net.principal.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1080")
    $primary_entity = array_distinct($net.principal.ip)
    $external_destinations = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
