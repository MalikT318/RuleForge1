/*
  MITRE Technique : T1218.002 - Control Panel
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:44:37.912944+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_002_Control_Panel_CPL_Registration_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several registry modifications under the Control Panel Cpls registration key occur on a single host within ten minutes. A single registration is routine for a driver or software install. A burst of them, especially from a script host or a LOLBin, suggests malicious CPL registration that is later launched through control.exe or the Control Panel loader, and it also gives persistence and application-allowlist bypass."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.002"
    mitre_technique_name = "System Binary Proxy Execution: Control Panel"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event IDs 12/13/14 or equivalent) mapped to UDM REGISTRY_MODIFICATION with target.registry.registry_key populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Hardware driver and utility installers (graphics, audio, printer, and OEM control panels), large software suite installs or upgrades, RMM and software deployment agents, and IT imaging or golden-image build processes."
    tuning_guidance = "Add deployment and patching tooling to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. Add known build or imaging service accounts to %global_allowed_service_accounts. Raise the #reg threshold if driver-heavy endpoints are noisy. Risk score is raised when the modifying process is a script host or LOLBin."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control Panel\\Cpls(\\|$)/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(re.regex($reg.principal.process.file.full_path, /(?i)\\(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32)\.exe$/), 85, 55))
    $event_count = count($reg.metadata.id)
    $mitre_technique_id = array_distinct("T1218.002")
    $primary_entity = array_distinct($host)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_name)
    $modifying_processes = array_distinct($reg.principal.process.file.full_path)
    $users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 3
}
