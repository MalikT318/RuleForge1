/*
  MITRE Technique : T1114.001 - Local Email Collection
  Tactic(s)       : Collection
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:18:37.487302+00:00
  Reference       : https://attack.mitre.org/techniques/T1114/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_001_Outlook_Data_File_Staged_By_NonOutlook {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of an Outlook data file (.pst or .ost) in a common staging location (Temp, Public, ProgramData, Recycle Bin, PerfLogs) by a process other than Outlook. This pattern indicates local mailbox data being copied or exported for collection and exfiltration. Platform note: the technique applies to Windows only, so the rule targets Windows file-creation telemetry."
    mitre_tactic = "Collection"
    mitre_technique = "T1114.001"
    mitre_technique_name = "Email Collection: Local Email Collection"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and migration tools, eDiscovery or mailbox export by IT, helpdesk profile migrations, user-initiated PST archiving through scripts, and DLP or forensic collection tools."
    tuning_guidance = "Add approved backup tooling to %global_allowed_backup_processes, migration and RMM tooling to %global_allowed_admin_tools, and approved admin accounts to %global_allowed_admin_users. Extend the staging directory regex if the environment uses other sanctioned export locations. Restrict to .pst only if .ost noise is high."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(temp|users\\public|programdata|\$recycle\.bin|perflogs)\\.*\.(pst|ost)$/ nocase
    not $file.principal.process.file.full_path = /\\(outlook|olk|scanpst|searchindexer)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1114.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $user = array_distinct($file.principal.user.userid)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $created_file = array_distinct($file.target.file.full_path)

  condition:
    $file
}
