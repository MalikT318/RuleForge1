/*
  MITRE Technique : T1059.012 - Hypervisor CLI
  Tactic(s)       : Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:24:59.064205+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_012_ESXi_Host_Config_Tampering_Via_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects ESXi host settings changes that CLI-driven hypervisor abuse typically produces: remote syslog forwarding altered, shell and SSH timeouts or warnings relaxed, firewall rulesets modified, lockdown or DCUI access changed, MOB enabled. It runs on host configuration-change telemetry (SETTING_MODIFICATION) rather than process or command-line matching, so it complements existing command-line detections."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.012"
    mitre_technique_name = "Command and Scripting Interpreter: Hypervisor CLI"
    log_prerequisites = "ESXi hostd and shell logs forwarded to the SIEM (syslog) and parsed into UDM SETTING_MODIFICATION events with the changed option or ruleset name in target.resource.name or metadata.description."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Planned host build or remediation by administrators, configuration-management or host-profile compliance remediation, central log-host migrations, scheduled maintenance windows that temporarily enable the shell or SSH, and vendor support sessions."
    tuning_guidance = "Add named administrators to %global_allowed_admin_users, automation accounts to %global_allowed_service_accounts, and approved management or jump-host addresses to %global_allowed_mgmt_sources. If a client rolls out host profiles frequently, narrow the regex to the syslog and lockdown settings only."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    (
      $setting.target.resource.name = /(Syslog\.global\.[a-z]+|Syslog\.loggers|UserVars\.(ESXiShellTimeOut|ESXiShellInteractiveTimeOut|SuppressShellWarning|DcuiTimeOut)|Config\.HostAgent\.plugins\.solo\.enableMob|Security\.Account(LockFailures|UnlockTime)|DCUI\.Access|lockdown|firewall|ruleset)/ nocase or
      $setting.metadata.description = /(Syslog\.global\.[a-z]+|syslog.*(config|reload)|UserVars\.(ESXiShellTimeOut|ESXiShellInteractiveTimeOut|SuppressShellWarning)|enableMob|lockdown\s*mode|firewall\s*(configuration|ruleset)|ruleset.*(enabled|disabled|allowedall))/ nocase
    )
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1059.012")
    $primary_entity = array_distinct($setting.principal.hostname)
    $acting_user = array_distinct($setting.principal.user.userid)
    $source_ips = array_distinct($setting.principal.ip)
    $changed_setting = array_distinct($setting.target.resource.name)

  condition:
    $setting
}
