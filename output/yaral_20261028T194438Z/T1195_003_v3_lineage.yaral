/*
  MITRE Technique : T1195.003 - Compromise Hardware Supply Chain
  Tactic(s)       : Initial Access
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:44:31.121480+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_003_Linux_Firmware_Tool_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects firmware, flash or boot-variable modification utilities launched with write, erase, install or boot-entry-change arguments by an unexpected parent such as a web server, application server or database service. Hardware supply chain implants cannot be observed directly in endpoint telemetry. This rule covers the post-deployment signal: firmware or boot-level persistence being written from a network-facing service lineage. Firmware tooling is normally run by an administrator shell, a package manager or a system updater, not by these services."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.003"
    mitre_technique_name = "Supply Chain Compromise: Compromise Hardware Supply Chain"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry normalised to PROCESS_LAUNCH with parent process path, child process path and full command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Orchestration or management web consoles that legitimately drive firmware updates (for example a BMC or fleet-update service running under a web server or Java runtime), vendor update agents wrapped in a Java or Node runtime, and lab or imaging systems that script firmware flashing."
    tuning_guidance = "Add approved update or fleet-management parent binaries to %global_allowed_admin_tools. Add approved automation parents to %global_allowed_script_hosts. Review the parent process and command line before triage, because any hit from a web or database service lineage is anomalous on most servers."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9.]*|tomcat[0-9]*|mysqld|mariadbd|postgres|redis-server|mongod|node|java)$/ nocase
    $proc.target.process.file.full_path = /\/(flashrom|fwupdmgr|fwupdtool|efibootmgr)$/ nocase
    $proc.target.process.command_line = /(flashrom.*\s(-w|--write|-E|--erase)\b|efibootmgr.*\s(-c|--create|-B|--delete-bootnum|-o|--bootorder)\b|fwupd(mgr|tool)\s+(install|update|flash))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1195.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
