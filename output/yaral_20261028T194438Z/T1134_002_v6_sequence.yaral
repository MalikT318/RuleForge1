/*
  MITRE Technique : T1134.002 - Create Process with Token
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:56:10.116069+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_002_Privileged_Process_Handle_Then_SYSTEM_Child {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A non-SYSTEM process opens a handle to a core SYSTEM process (winlogon, lsass, services, spoolsv, wininit) and, within 10 minutes, that same process launches a shell or script host running as SYSTEM. This is the behavioural result of token theft followed by CreateProcessWithTokenW or CreateProcessAsUser."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.002"
    mitre_technique_name = "Access Token Manipulation: Create Process with Token"
    log_prerequisites = "Requires EDR or Sysmon-equivalent telemetry with PROCESS_OPEN (handle access, Sysmon EID 10) and PROCESS_LAUNCH events. The target user field must be populated on process launch events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Security and EDR agents, backup software, remote support tools, software deployment agents, and legitimate admin utilities that deliberately launch SYSTEM-context shells (for example, sanctioned PsExec-style tooling). Debugging and crash-dump tools may also open handles to these processes."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools (handle-opening side) and approved admin or RMM tooling to %global_allowed_admin_tools (launching side). If the EDR does not populate target.user.userid on process launch, this rule will not fire. Widen or narrow the child process regex to match the client's environment."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\(winlogon|lsass|services|spoolsv|wininit)\.exe$/ nocase
    not $open.principal.user.userid = /(^|\\)(system|local service|network service)$/ nocase
    not $open.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|csrss|svchost|wininit|services|lsass|winlogon)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    $open.principal.hostname = $hostname
    $open.principal.process.pid = $pid

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|wmic)\.exe$/ nocase
    $proc.target.user.userid = /(^|\\)system$/ nocase
    not $proc.principal.user.userid = /(^|\\)(system|local service|network service)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname
    $proc.principal.process.pid = $pid

    $open.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $pid over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1134.002")
    $primary_entity = array_distinct($hostname)
    $opened_targets = array_distinct($open.target.process.file.full_path)
    $actor_process = array_distinct($open.principal.process.file.full_path)
    $actor_user = array_distinct($open.principal.user.userid)
    $child_processes = array_distinct($proc.target.process.file.full_path)
    $child_command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $open and $proc
}
