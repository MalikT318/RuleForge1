/*
  MITRE Technique : T1070.006 - Timestomp
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:08:11.132627+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_006_ESXi_Timestomp_Anomalous_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the touch utility invoked with timestamp-altering options (reference file, explicit time or date) where the parent process is an ESXi management daemon or a script interpreter rather than an interactive shell. Management services and interpreters do not normally rewrite file timestamps, so this lineage suggests a web-shell, a hijacked management service or a scripted implant hiding file changes."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.006"
    mitre_technique_name = "Indicator Removal: Timestomp"
    log_prerequisites = "ESXi shell and process execution logging forwarded with parent and child process paths populated (for example shell audit or a host agent). Requires the PROCESS_LAUNCH UDM event type with principal.process.file.full_path populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Vendor or in-house maintenance scripts run from python or perl that touch files with fixed timestamps; VIB or patch installation helpers; backup or configuration-sync scripts launched by management daemons; admin automation using interpreters."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts. Extend the parent regex with other daemons that should never spawn touch in your estate. Hosts that run approved automation can be handled through the same lists."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/touch$/ nocase
    $proc.target.process.command_line = /(^|\s)(-[a-z]*[rtd]|--reference|--date)(\s|=|$)/ nocase
    $proc.principal.process.file.full_path = /\/(hostd|vpxa|rhttpproxy|sfcbd|openwsmand|snmpd|python[0-9.]*|perl|lua)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1070.006")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $touch_command = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
