/*
  MITRE Technique : T1056.003 - Web Portal Capture
  Tactic(s)       : Collection, Credential Access
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:48:41.885411+00:00
  Reference       : https://attack.mitre.org/techniques/T1056/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1056_003_Portal_Host_Outbound_Credential_Post {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux-hosted web portal (VPN, SSO, webmail or remote-access gateway) sending an outbound HTTP POST to an external destination that either carries credential-style parameters in the URL or comes from a scripted HTTP client. A trojanised login page typically forwards captured credentials to attacker infrastructure this way. This is network-side coverage that does not depend on process or command-line telemetry."
    mitre_tactic = "Collection, Credential Access"
    mitre_technique = "T1056.003"
    mitre_technique_name = "Input Capture: Web Portal Capture"
    log_prerequisites = "Requires firewall or web proxy logs normalised to UDM NETWORK_HTTP with principal.hostname, network.http.method, network.http.user_agent, target.url, target.hostname and target.ip populated. Outbound traffic from portal servers must pass through the logging device."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Portal servers legitimately calling external APIs (SSO/IdP callbacks, license checks, SMS or MFA providers, webhook integrations, update or telemetry services), monitoring agents, and internal hosts whose names match the portal pattern."
    tuning_guidance = "Add known-good external API and vendor domains to %global_allowed_domains. Adjust the principal.hostname regex to match the client's portal naming convention. Confirm that %rfc1918_internal covers the client's internal ranges. If the scripted user-agent branch is too noisy, rely on the credential-parameter branch or add the expected integration destinations to %global_allowed_domains."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.principal.hostname = /(vpn|portal|gateway|sslvpn|webmail|owa|login|sso|remote|extranet)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    (
      $net.target.url = /(passw(or)?d|pwd|passwd|credential|secret|user(name)?|login)=/ nocase or
      $net.network.http.user_agent = /(curl|wget|python-requests|python-urllib|libwww-perl|go-http-client|php|okhttp|java)/ nocase
    )

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1056.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
