/*
  MITRE Technique : T1003.007 - Proc Filesystem
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:49:01.635732+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_007_Service_Parent_Spawns_Shell_Proc_Memory_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing or data-tier service process (web server, application runtime, database, print or file service) spawning a shell or script interpreter whose command line touches /proc/<pid>/mem or /proc/<pid>/maps. Pivots on the anomalous parent-child lineage, which is typical of a webshell or exploited service dumping process memory for credentials."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.007"
    mitre_technique_name = "OS Credential Dumping: Proc Filesystem"
    log_prerequisites = "Requires Linux EDR or auditd EXECVE/SYSCALL telemetry normalised to PROCESS_LAUNCH with populated parent process path, child process path and command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Application diagnostics or memory-profiling scripts launched by a service, APM or crash-handler agents invoked from a runtime, database administration scripts reading /proc maps for troubleshooting, and approved vulnerability or security tooling run under a service parent."
    tuning_guidance = "Add legitimate parent binaries to %global_allowed_script_hosts, approved admin or diagnostic tooling to %global_allowed_admin_tools, and EDR or security agents to %global_allowed_security_tools. Extend the parent regex with client-specific service binaries if needed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|php-cgi|tomcat[0-9]*|catalina|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|smbd)$/ nocase
    $proc.target.process.file.full_path = /\/((ba|da|z|k|a|c|tc)?sh|python[0-9.]*|perl|ruby|php[0-9.]*|node)$/ nocase
    $proc.target.process.command_line = /\/proc\/[^\s\/]+\/(mem|maps)\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1003.007")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
