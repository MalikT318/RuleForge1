/*
  MITRE Technique : T1102.001 - Dead Drop Resolver
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:54:25.322118+00:00
  Reference       : https://attack.mitre.org/techniques/T1102/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1102_001_ESXi_Mgmt_Daemon_Spawns_Fetch_Tool {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi management-plane or VM-host daemon (hostd, vpxa, rhttpproxy, vmx, CIM broker, etc.) spawning a web-fetch utility or script interpreter. These daemons do not normally retrieve external web content. This lineage anomaly is consistent with exploitation of a management service, or a compromised VM worker process, pulling a dead drop resolver page to learn the next-stage C2 location. Detection pivots on the parent-child relationship, not on command-line content."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1102.001"
    mitre_technique_name = "Web Service: Dead Drop Resolver"
    log_prerequisites = "ESXi shell/process execution logging forwarded to Chronicle and parsed to UDM PROCESS_LAUNCH with populated parent (principal.process.file.full_path) and child (target.process.file.full_path) paths."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Vendor or backup agents that run as children of hostd or vpxa and use curl/wget/python for health checks; management-agent patching or VIB install workflows; hardware vendor CIM providers invoked via the CIM broker; monitoring integrations."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts, and automation accounts to %global_allowed_service_accounts. Review hosts where the child is launched by a vmx process first, as that suggests a guest-escape or tampered VM process."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(hostd|hostd-worker|vpxa|rhttpproxy|vmx|sfcbd|sfcb-[a-z0-9_-]+|openwsmand|slpd|snmpd|vmware-fdm|fdm)$/ nocase
    $proc.target.process.file.full_path = /\/(wget|curl|python[0-9.]*|perl|nc|ncat|openssl)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1102.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
