/*
  MITRE Technique : T1553 - Subvert Trust Controls
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:59:29.472240+00:00
  Reference       : https://attack.mitre.org/techniques/T1553
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_003_SIP_Trust_Provider_Registry_Hijack {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modification of the Windows signature verification (Subject Interface Package) and trust provider FinalPolicy keys. Adversaries repoint these DLL/function values so that unsigned or malicious code validates as signed. The rule matches the OS trust-validation mechanism itself, not a specific tool or payload."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553"
    mitre_technique_name = "Subvert Trust Controls"
    log_prerequisites = "Requires endpoint registry modification telemetry (EDR or Sysmon registry events) that populates the registry key, value name and initiating process."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Third-party code-signing or document-signing software installers that register a custom SIP; some application installers and updaters; Windows servicing (TrustedInstaller) is already excluded by process name; authorized PKI or security-tooling deployments."
    tuning_guidance = "Add approved installers or deployment tooling to %global_allowed_admin_tools and endpoint security agents to %global_allowed_security_tools. Review the initiating process and the new DLL value before excluding, since legitimate changes to these keys are rare and should be tied to known software deployments."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Microsoft\\Cryptography\\(OID\\EncodingType 0\\CryptSIPDll(GetSignedDataMsg|PutSignedDataMsg|CreateIndirectData|VerifyIndirectData|RemoveSignedDataMsg)|Providers\\Trust\\FinalPolicy)\\/ nocase
    $reg.target.registry.registry_value_name = /^(dll|funcname|\$dll|\$function)$/ nocase
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1553")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_keys = array_distinct($reg.target.registry.registry_key)
    $modified_values = array_distinct($reg.target.registry.registry_value_data)
    $initiating_process = array_distinct($reg.principal.process.file.full_path)
    $initiating_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
