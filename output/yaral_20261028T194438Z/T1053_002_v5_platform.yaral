/*
  MITRE Technique : T1053.002 - At
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:13:25.077492+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_002_Linux_At_Job_Spool_File_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a job file in the Linux at(1) spool directories (/var/spool/at, /var/spool/atjobs, /var/spool/cron/atjobs). The at client writes a spool file for every job it schedules, so this fires on the persistence or deferred-execution artifact itself. It does not depend on process command-line matching and still catches at jobs submitted through wrappers, scripts, or renamed binaries."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.002"
    mitre_technique_name = "Scheduled Task/Job: At"
    log_prerequisites = "Linux endpoint telemetry that reports FILE_CREATION with target.file.full_path and principal.user.userid populated (EDR file events or auditd watch rules on the at spool directories, for example -w /var/spool/cron/atjobs -p wa and -w /var/spool/at -p wa)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators legitimately scheduling one-off maintenance with at; configuration management or patching tools that queue at jobs (for example deferred reboots or package post-install tasks); backup and batch-processing frameworks that use at for deferred runs; the atd daemon managing its own spool files."
    tuning_guidance = "Add approved scheduling tools to %global_allowed_admin_tools. Add automation or batch accounts to %global_allowed_service_accounts. If at is not used in the client environment, raise severity to High. Add or adjust spool path variants if a distribution uses a non-standard location."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/var\/spool\/(cron\/)?(at|atjobs)\/[^\/]+$/ nocase
    not $file.target.file.full_path = /\.SEQ$/ nocase
    not $file.principal.process.file.full_path = /\/atd$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1053.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $user = array_distinct($file.principal.user.userid)
    $job_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
