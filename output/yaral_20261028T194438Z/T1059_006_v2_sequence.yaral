/*
  MITRE Technique : T1059.006 - Python
  Tactic(s)       : Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:14:31.582169+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_006_ESXi_Remote_Login_Then_Interactive_Python {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a management-plane or shell login to an ESXi host followed within five minutes by a Python interpreter launched from an interactive shell on the same host. Python is rarely run by hand on a hypervisor, so this sequence points to hands-on-keyboard scripting after remote access. The rule keys on the login-to-interpreter sequence and the interpreter binary path, not on command-line content."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.006"
    mitre_technique_name = "Command and Scripting Interpreter: Python"
    log_prerequisites = "ESXi hostd, shell and auth logs forwarded to Chronicle and parsed into UDM USER_LOGIN and PROCESS_LAUNCH events with a populated host name on both. Shell command auditing must be enabled so interpreter launches are logged."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators running VMware support scripts or health-check tooling, approved automation that logs in over SSH and runs Python, and vendor troubleshooting sessions."
    tuning_guidance = "Add approved admin accounts to %global_allowed_admin_users, automation accounts to %global_allowed_service_accounts, jump hosts and management stations to %global_allowed_mgmt_sources, and approved shell parent processes to %global_allowed_script_hosts."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.hostname = $hostname
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.principal.ip in %global_allowed_mgmt_sources

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /(^|\/)python[0-9.]*$/ nocase
    $proc.principal.process.file.full_path = /\/(sh|ash|bash|busybox)$/ nocase
    $proc.principal.hostname = $hostname
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

    $auth.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1059.006")
    $primary_entity = array_distinct($hostname)
    $login_users = array_distinct($auth.target.user.userid)
    $login_source_ips = array_distinct($auth.principal.ip)
    $python_paths = array_distinct($proc.target.process.file.full_path)
    $python_users = array_distinct($proc.principal.user.userid)
    $python_launch_count = count($proc.metadata.id)

  condition:
    $auth and $proc
}
