/*
  MITRE Technique : T1078.002 - Domain Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:31:03.270091+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_002_ESXi_DomainAccount_Login_Then_HostConfig_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A domain-formatted account (DOMAIN\\user or user@domain.tld) authenticates to an ESXi host and the same account then modifies security-sensitive host settings within one hour. Examples are SSH or shell service enablement, shell timeouts, lockdown mode, the managed object browser, account lockout policy or remote syslog target. This sequence is typical of a compromised Active Directory account being used for hypervisor persistence or privilege escalation."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.002"
    mitre_technique_name = "Valid Accounts: Domain Accounts"
    log_prerequisites = "ESXi hostd and shell syslog forwarded to Chronicle and parsed into UDM USER_LOGIN and SETTING_MODIFICATION events. The host must be joined to Active Directory, or domain users must authenticate through vCenter or Active Directory-backed ESXi permissions, so domain-formatted user IDs appear in hostd logs."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Virtualization admins using their personal domain accounts for routine maintenance (temporarily enabling SSH for troubleshooting, changing syslog targets, patch or upgrade windows), lifecycle tooling running under domain service accounts, and automated host-profile remediation."
    tuning_guidance = "Add approved admin accounts to %global_allowed_admin_users and automation or service accounts to %global_allowed_service_accounts. Narrow or widen the setting-name regex to match how your parser populates target.resource.name. If domain accounts use a different naming convention, adjust the userid regex. Consider raising severity when the change occurs outside change windows."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.target.user.userid = /^([^\\\s]+\\[^\\\s]+|[^@\s]+@[^@\s]+\.[^@\s]+)$/
    not $login.target.user.userid in %global_allowed_admin_users
    not $login.target.user.userid in %global_allowed_service_accounts
    $login.target.hostname = $host
    $login.target.user.userid = $user

    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.target.resource.name = /(TSM|ESXiShell|SuppressShellWarning|ShellTimeOut|DcuiTimeOut|lockdown|enableMob|AccountLock|Syslog\.global|SSH)/ nocase
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    $setting.target.hostname = $host
    $setting.principal.user.userid = $user

    $login.metadata.event_timestamp.seconds <= $setting.metadata.event_timestamp.seconds

  match:
    $host, $user over 1h

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1078.002")
    $primary_entity = array_distinct($host)
    $domain_user = array_distinct($user)
    $login_source_ips = array_distinct($login.principal.ip)
    $modified_settings = array_distinct($setting.target.resource.name)
    $first_login_time = min($login.metadata.event_timestamp.seconds)
    $last_change_time = max($setting.metadata.event_timestamp.seconds)
    $setting_change_count = count($setting.metadata.id)

  condition:
    $login and $setting
}
