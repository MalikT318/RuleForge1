/*
  MITRE Technique : T1003.001 - LSASS Memory
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:37:09.856249+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_001_LSASS_SilentProcessExit_IFEO_Registry_Tampering {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modification of the SilentProcessExit or Image File Execution Options configuration for lsass.exe. Setting GlobalFlag, ReportingMode, MonitorProcess, LocalDumpFolder or DumpType for LSASS makes Windows Error Reporting write an LSASS memory dump when the process exits. This covers the silent process exit credential dumping technique at the registry state-change layer, independent of command-line logging or the tool used."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.001"
    mitre_technique_name = "OS Credential Dumping: LSASS Memory"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events 12/13) that populates target.registry.registry_key and target.registry.registry_value_name. Registry auditing must cover HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\SilentProcessExit and Image File Execution Options."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Authorised crash-dump debugging of LSASS by platform or support engineers, EDR/AV agents configuring their own self-protection or diagnostics, and Microsoft or OEM diagnostic tooling during troubleshooting. These are rare in normal operation."
    tuning_guidance = "Add approved EDR/AV agent binaries to %global_allowed_security_tools and sanctioned IT tooling to %global_allowed_admin_tools. Add named administrators to %global_allowed_admin_users only if they have a documented debugging process. Do not exclude by hostname across the whole tenant."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(SilentProcessExit|Image File Execution Options)\\lsass\.exe/ nocase
    $reg.target.registry.registry_value_name = /^(GlobalFlag|ReportingMode|MonitorProcess|LocalDumpFolder|DumpType)$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1003.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_name)
    $actor_process = array_distinct($reg.principal.process.file.full_path)
    $actor_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
