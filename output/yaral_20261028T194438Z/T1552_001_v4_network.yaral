/*
  MITRE Technique : T1552.001 - Credentials In Files
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:45:48.990768+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_001_Container_External_Credential_File_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an HTTP request from a non-internal source to a container or Kubernetes control-plane endpoint whose URL references a well-known credential file (kubeconfig, container registry auth, cloud CLI credentials, git/npm/netrc credentials, mounted service account token). This catches exposed file-serving endpoints, path traversal or file-read through an exposed service, and pod exec/attach/proxy requests that read credential files remotely. It is network-side coverage and does not depend on in-container command-line telemetry."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.001"
    mitre_technique_name = "Unsecured Credentials: Credentials In Files"
    log_prerequisites = "Cloud/Kubernetes audit or API gateway logs normalised to NETWORK_HTTP with target.url and principal.ip populated. The Kubernetes API server request URI, including exec command query parameters, must be captured in target.url."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Authorised engineers or CI/CD runners using kubectl exec or cp to inspect config files from an external or VPN egress address; security scanners and compliance tooling; managed-service control-plane callers whose addresses are not in the internal list."
    tuning_guidance = "Add CI/CD and automation identities to %global_allowed_service_accounts, named admins to %global_allowed_admin_users, and authorised scanner or pen-test source addresses to %global_allowed_scanners. Ensure %rfc1918_internal covers client VPN and NAT egress ranges that should count as internal."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(\.kube(\/|%2f)config|\.docker(\/|%2f)config\.json|\.aws(\/|%2f)credentials|\.git-credentials|\.netrc|\.npmrc|\.pypirc|serviceaccount(\/|%2f)token)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.user.userid in %global_allowed_service_accounts
    not $http.principal.user.userid in %global_allowed_admin_users
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1552.001")
    $primary_entity = array_distinct($http.principal.ip)
    $source_user = array_distinct($http.principal.user.userid)
    $target_host = array_distinct($http.target.hostname)
    $requested_url = array_distinct($http.target.url)

  condition:
    $http
}
