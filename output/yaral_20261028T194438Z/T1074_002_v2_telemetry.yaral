/*
  MITRE Technique : T1074.002 - Remote Data Staging
  Tactic(s)       : Collection
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:20:04.918779+00:00
  Reference       : https://attack.mitre.org/techniques/T1074/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_002_Linux_Remote_Archive_Written_To_Staging_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of an archive or compressed file in a world-writable staging directory (/tmp, /var/tmp, /dev/shm) by a process that receives files from remote systems (sftp-server, scp, rsync, smbd). This file artifact indicates data collected from other hosts is being staged centrally before exfiltration, and it does not depend on command-line logging."
    mitre_tactic = "Collection"
    mitre_technique = "T1074.002"
    mitre_technique_name = "Data Staged: Remote Data Staging"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-write/create rules (for example, watches on /tmp, /var/tmp and /dev/shm) with the creating process path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate file transfers by admins or deployment pipelines into /tmp, rsync-based backup or mirroring jobs that stage archives in /var/tmp, application installers or log collectors that receive bundles over SFTP, Samba shares exported from /tmp."
    tuning_guidance = "Add approved transfer or backup processes to %global_allowed_backup_processes and %global_allowed_admin_tools, and add automation accounts to %global_allowed_service_accounts. Add known administrators to %global_allowed_admin_users. Consider restricting to hosts that should never receive inbound file transfers, such as DMZ servers."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(sftp-server|scp|rsync|smbd)$/ nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+\.(tar|tgz|tbz2|txz|gz|bz2|xz|zst|zip|7z|rar)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1074.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $staged_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
