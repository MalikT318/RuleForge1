/*
  MITRE Technique : T1550.004 - Web Session Cookie
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:41:50.137936+00:00
  Reference       : https://attack.mitre.org/techniques/T1550/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1550_004_Session_Lifetime_Setting_Weakened {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a modification to identity-provider session or token lifetime controls (session timeout, token lifetime, sign-in frequency, persistent browser session, remember-device/MFA). Stolen web session cookies stay usable for as long as the session lifetime allows, so lengthening it or removing re-authentication is a way to extend a pass-the-cookie foothold. This detects the resulting configuration state change, not any command line or tool."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1550.004"
    mitre_technique_name = "Use Alternate Authentication Material: Web Session Cookie"
    log_prerequisites = "Requires identity provider directory/admin audit logs normalised to UDM SETTING_MODIFICATION, with target.resource.name populated with the setting or policy name, and principal.user.userid populated with the actor."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Planned identity or security hardening, conditional access or session policy reviews by IAM teams, onboarding of new applications with custom session settings, and tenant migrations or policy-as-code deployments."
    tuning_guidance = "Add approved IAM administrators to %global_allowed_admin_users and policy-automation or IaC identities to %global_allowed_service_accounts. If the client's identity provider names settings differently, extend the target.resource.name regex. Consider raising severity when the actor is not a named administrator."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.target.resource.name = /((session|token|cookie).{0,30}(lifetime|timeout|duration|expir|persist|idle|max.?age)|sign.?in.?frequency|persistent.?browser|remember.?(me|device|mfa))/ nocase
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1550.004")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $modified_settings = array_distinct($setting.target.resource.name)
    $source_ips = array_distinct($setting.principal.ip)

  condition:
    $setting
}
