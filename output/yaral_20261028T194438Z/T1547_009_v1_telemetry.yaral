/*
  MITRE Technique : T1547.009 - Shortcut Modification
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:35:12.352523+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_009_Startup_Folder_Shortcut_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a shortcut (.lnk or .url) inside a per-user or all-users Windows Startup folder by a process that is not an approved installer or admin tool. This is the file artifact left by shortcut-based persistence and does not depend on command-line logging."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.009"
    mitre_technique_name = "Boot or Logon Autostart Execution: Shortcut Modification"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with the target file path and the creating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters that add startup shortcuts, users creating startup shortcuts through Explorer, IT deployment and profile-provisioning scripts, and VDI or roaming-profile logon tooling."
    tuning_guidance = "Add approved deployment and installer binaries to %global_allowed_admin_tools, security agents to %global_allowed_security_tools, and provisioning accounts to %global_allowed_service_accounts. If Explorer-created shortcuts are noisy in a given client, review them first. Pair this rule with a FILE_MODIFICATION variant to cover edits to existing startup shortcuts."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\Start Menu\\Programs\\Startup\\[^\\]+\.(lnk|url)$/ nocase
    $file.principal.hostname = $hostname
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path = /\\(msiexec|TrustedInstaller|MsMpEng|MsSense|SenseIR)\.exe$/ nocase

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1547.009")
    $primary_entity = array_distinct($hostname)
    $shortcut_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $creating_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
