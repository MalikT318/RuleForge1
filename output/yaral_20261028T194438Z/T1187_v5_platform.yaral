/*
  MITRE Technique : T1187 - Forced Authentication
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:33:38.286227+00:00
  Reference       : https://attack.mitre.org/techniques/T1187
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1187_Outbound_SMB_Forced_Authentication_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an internal host opening an SMB or NetBIOS session (TCP 445/139) to an external address, as seen at the network perimeter. Windows clients authenticate automatically to UNC paths, so outbound SMB to the internet is the network-observable result of forced authentication, such as a malicious link, template injection or a planted .lnk/.scf file. It exposes the user's NTLM hash to an attacker-controlled listener. The rule uses only perimeter fields (destination port and address) and no endpoint process data."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1187"
    mitre_technique_name = "Forced Authentication"
    log_prerequisites = "Perimeter firewall or proxy logs that record allowed and attempted outbound connections with destination IP and port. Egress traffic on TCP 445/139 must be logged even when it is blocked, because the attempt alone still indicates the hash was offered."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Cloud file-share services reached over SMB (for example, managed file storage mounted directly from on-premises), site-to-site or VPN-less branch file access, authorised vulnerability or penetration-test scanners, misconfigured drive mappings or DFS referrals pointing at external hosts, and hosted-backup or migration tooling that uses SMB."
    tuning_guidance = "Add approved external SMB destinations (cloud file storage endpoints) to %global_allowed_domains where the log carries target.hostname. Add authorised scanner sources to %global_allowed_scanners. Add any source addresses that legitimately reach external SMB to %global_allowed_mgmt_sources. If outbound 445/139 is already blocked at the perimeter, treat each hit as a high-fidelity indicator that a host attempted to leak credentials, and investigate the originating user, document or link."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 445 or $net.target.port = 139)
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1187")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
