/*
  MITRE Technique : T1480.002 - Mutual Exclusion
  Tactic(s)       : Stealth
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:28:13.409624+00:00
  Reference       : https://attack.mitre.org/techniques/T1480/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1480_002_Linux_Mutex_Lock_File_Burst_From_Volatile_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A process running from a world-writable volatile directory (/tmp, /var/tmp, /dev/shm) creates several lock, pid or mutex marker files in volatile locations on one host within 10 minutes. Malware uses such files as single-instance mutexes (execution guardrails). One lock file is benign; repeated creation by an implant staged in a volatile path is not."
    mitre_tactic = "Stealth"
    mitre_technique = "T1480.002"
    mitre_technique_name = "Execution Guardrails: Mutual Exclusion"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry that populates principal.process.file.full_path and target.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Build and CI jobs running from /tmp, user-installed software or portable applications run from /tmp or /dev/shm, package manager post-install scripts, and containers with ephemeral working directories."
    tuning_guidance = "Add legitimate tooling to %global_allowed_admin_tools, %global_allowed_security_tools or %global_allowed_script_hosts (matched on the creating process path). Raise the #file threshold on build or CI hosts. Review the $lock_files and $creating_processes outcome values to identify the staged binary."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run|var\/run)\/(.*\/)?[^\/]*\.(lock|lck|pid|mutex|pidlock)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1480.002")
    $primary_entity = array_distinct($host)
    $lock_files = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 5
}
