/*
  MITRE Technique : T1547.005 - Security Support Provider
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:30:47.873870+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_005_SSP_Registry_Modified_By_Anomalous_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a modification of the LSA 'Security Packages' registry value (Lsa or Lsa\\OSConfig) by a process that should never configure Security Support Providers. This covers Office applications, script hosts and interpreters, browsers, web server, database and print spooler processes, and binaries running from user-writable paths. The rule pivots on the lineage and identity of the writing process rather than on command-line content. It also catches in-process registry writes with no suspicious command line, such as injected code, macros, web shells and API calls."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.005"
    mitre_technique_name = "Boot or Logon Autostart Execution: Security Support Provider"
    log_prerequisites = "Requires Windows endpoint telemetry that normalises registry value writes with the initiating process path (EDR or Sysmon Event ID 13). The registry_key and registry_value_name fields must be populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate installers of third-party authentication or credential-provider software (smart card middleware, MFA or SSO agents) run from a temporary extraction directory or user profile path. Administrators who run PowerShell or cmd to deliberately register a custom SSP, such as Mimikatz-style testing during an authorised red-team exercise. Software deployment tools that launch from a user-writable staging path."
    tuning_guidance = "Add approved deployment, packaging and RMM binaries to %global_allowed_admin_tools. Add EDR or AV agents to %global_allowed_security_tools. Add authorised red-team or testing sources to %global_allowed_scanners. If a vendor installer legitimately registers an SSP, allowlist its installer executable path in %global_allowed_admin_tools rather than loosening the registry match."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control\\Lsa(\\OSConfig)?(\\Security Packages)?$/ nocase
    (
      $reg.target.registry.registry_value_name = /^Security Packages$/ nocase or
      $reg.target.registry.registry_key = /\\Security Packages$/ nocase
    )
    (
      $reg.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|onenote|mspub|msaccess|mshta|wscript|cscript|powershell|powershell_ise|pwsh|cmd|rundll32|regsvr32|wmiprvse|w3wp|httpd|nginx|tomcat[0-9]*|java|php-cgi|sqlservr|spoolsv|chrome|msedge|firefox|iexplore|acrord32|acrobat)\.exe$/ nocase or
      $reg.principal.process.file.full_path = /\\(users|temp|appdata|downloads|perflogs)\\.*\.(exe|scr|com)$/ nocase
    )
    not $reg.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path in %global_allowed_scanners

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1547.005")
    $primary_entity = array_distinct($reg.principal.hostname)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $writer_command_line = array_distinct($reg.principal.process.command_line)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value = array_distinct($reg.target.registry.registry_value_data)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
