/*
  MITRE Technique : T1211 - Exploitation for Stealth
  Tactic(s)       : Stealth
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:18:46.145142+00:00
  Reference       : https://attack.mitre.org/techniques/T1211
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1211_LogMgmt_Utility_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows logging, audit or tracing utility (event log, audit policy, ETW trace, event forwarding, minifilter management) making an outbound connection to a non-internal address. These utilities are local-only administration tools and have no legitimate reason to talk to external hosts. Network activity from them indicates the process was exploited, injected into or hollowed so that attacker code runs inside a trusted logging component and avoids scrutiny (T1211)."
    mitre_tactic = "Stealth"
    mitre_technique = "T1211"
    mitre_technique_name = "Exploitation for Stealth"
    log_prerequisites = "Requires endpoint network telemetry with process attribution (EDR network events or Sysmon Event ID 3) normalised to NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Event forwarding or log collection run by an admin against a remote collector; remote wevtutil queries (/r:) against external-facing hosts; RMM or SIEM-agent scripts that wrap these utilities; EDR sensors that proxy their network traffic through a log utility."
    tuning_guidance = "Add approved vendor or collector domains to %global_allowed_domains. Add trusted EDR or monitoring agents to %global_allowed_security_tools. Add approved admin accounts to %global_allowed_admin_users. Keep %rfc1918_internal current for each client's address space."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(wevtutil|auditpol|wecutil|logman|eventcreate|tracerpt|fltmc)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1211")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
