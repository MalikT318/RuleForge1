/*
  MITRE Technique : T1078.004 - Cloud Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:33:56.397614+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_004_Identity_Auth_Policy_Setting_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change (SETTING_MODIFICATION) to identity-layer authentication controls such as MFA, conditional access, federation/SSO trust, trusted locations, or password and session policy, made by an account that is not an approved administrator, service account, or cloud principal. After compromising a valid cloud account, adversaries weaken these controls to persist, evade defenses, or widen access. The rule detects the resulting configuration state change instead of the commands or tooling used to make it."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.004"
    mitre_technique_name = "Valid Accounts: Cloud Accounts"
    log_prerequisites = "Identity provider directory/admin audit logs that record policy and setting changes, normalised to UDM SETTING_MODIFICATION with principal.user.userid and target.resource.name populated."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Legitimate IAM or security administrators not yet in the approved admin list, planned MFA or conditional access rollouts, SSO or federation onboarding for new applications, trusted-location updates after office moves, and identity governance automation."
    tuning_guidance = "Populate %global_allowed_admin_users, %global_allowed_service_accounts and %global_allowed_cloud_principals with the client's approved identity administrators and automation. Narrow or widen the target.resource.name keyword regex to match the client's setting naming. Raise severity for changes made outside change windows."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.principal.user.userid != ""
    $setting.target.resource.name = /(mfa|multi.?factor|conditional.?access|federat|single.?sign.?on|\bsso\b|authentication.?(policy|method|strength)|password.?policy|trusted.?(ip|location|network)|named.?location|session.?(policy|lifetime)|sign.?in.?(policy|risk))/ nocase
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1078.004")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $modified_setting = array_distinct($setting.target.resource.name)
    $source_ips = array_distinct($setting.principal.ip)

  condition:
    $setting
}
