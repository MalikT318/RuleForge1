/*
  MITRE Technique : T1027.016 - Junk Code Insertion
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:04:20.925212+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_016_Linux_Server_Daemon_Spawns_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux web server, application gateway or database daemon directly spawning a shell or script interpreter. Junk-code-padded or otherwise obfuscated payloads (web shells, injected scripts, database command-execution abuse) generally reach execution through this lineage, so the rule pivots on the anomalous parent-child relationship and not on script content or command-line obfuscation markers. It complements command-line rules for T1027.016 by catching padded payloads whose content evades pattern matching."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.016"
    mitre_technique_name = "Obfuscated Files or Information: Junk Code Insertion"
    log_prerequisites = "Requires Linux EDR or auditd (execve) process-launch telemetry with populated parent process path (principal.process.file.full_path) and child process path (target.process.file.full_path)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate CGI scripts or PHP applications that shell out; PostgreSQL archive_command or MySQL/MariaDB hooks that invoke sh; health-check or log-rotation wrappers launched by nginx/apache; Redis or MongoDB maintenance scripts; admin-configured web-based management panels."
    tuning_guidance = "Add approved parent binaries to %global_allowed_script_hosts or %global_allowed_admin_tools, and add hosts known to run CGI or shell-based web applications to %global_allowed_script_hosts. Narrow the parent regex to the daemons that actually exist in the client environment, or raise severity for internet-facing hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9.]*|mysqld|mariadbd|postgres|mongod|redis-server|memcached)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|ash|zsh|ksh|python[0-9.]*|perl|ruby|php[0-9.]*|lua)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1027.016")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $running_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
