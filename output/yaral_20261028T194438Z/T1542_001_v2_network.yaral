/*
  MITRE Technique : T1542.001 - System Firmware
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:42:29.047313+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_001_Firmware_Image_Download_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP request through the perimeter to an external destination for a file that looks like a firmware or UEFI/BIOS image (capsule, ROM, flash or EFI image extensions, or firmware/BIOS/UEFI-named flash packages). Windows hosts retrieving raw firmware images from outside the organisation outside approved vendor update domains may be staging a firmware modification for persistence."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.001"
    mitre_technique_name = "Pre-OS Boot: System Firmware"
    log_prerequisites = "Requires firewall or proxy logs normalised to NETWORK_HTTP with target.url populated. TLS inspection is needed to see URLs for HTTPS traffic. Endpoint coverage is assumed to exist separately."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate OEM BIOS/UEFI update downloads by IT or end users, driver and firmware management tools (OEM update utilities), hardware lab or imaging teams, and security researchers downloading firmware samples."
    tuning_guidance = "Add OEM and firmware vendor update domains to %global_allowed_domains. Internal destinations are excluded via %rfc1918_internal. Add sanctioned patch or update servers to %global_allowed_domains. Extend or narrow the extension list if the client environment generates noise."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    (
      $net.target.url = /\.(cap|rom|fd|efi|wph|bio|capsule)(\?|#|$)/ nocase or
      $net.target.url = /(firmware|bios|uefi)[^\/\?]*\.(bin|img|zip|exe|iso)(\?|#|$)/ nocase
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1542.001")
    $primary_entity = array_distinct($net.principal.ip)
    $source_hostname = array_distinct($net.principal.hostname)
    $destination_host = array_distinct($net.target.hostname)
    $destination_ip = array_distinct($net.target.ip)
    $requested_url = array_distinct($net.target.url)

  condition:
    $net
}
