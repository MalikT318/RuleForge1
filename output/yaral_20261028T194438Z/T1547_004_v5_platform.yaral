/*
  MITRE Technique : T1547.004 - Winlogon Helper DLL
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:29:30.569046+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_004_Winlogon_Helper_Registry_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modification of Winlogon helper values (Shell, Userinit, Taskman, AppSetup, GinaDLL, Notify DllName) to a non-default value. This is registry-telemetry coverage that complements process command-line detections. The technique only exists on Windows, so no non-Windows variant is possible and this rule targets Windows."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.004"
    mitre_technique_name = "Boot or Logon Autostart Execution: Winlogon Helper DLL"
    log_prerequisites = "Requires endpoint registry telemetry that populates registry key, value name and value data (EDR registry events or Sysmon Event ID 12/13 equivalent). Registry auditing of the Winlogon key is required if using native Windows Security logs."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software deployment or imaging tools that legitimately replace the shell or userinit value, kiosk or shell-replacement configurations, VDI or profile-management agents, and Group Policy custom shell settings."
    tuning_guidance = "Add approved deployment or management binaries to %global_allowed_admin_tools, EDR and security agents to %global_allowed_security_tools, and approved administrator accounts to %global_allowed_admin_users. For intentional kiosk or custom-shell estates, scope an exclusion by host group outside this rule or add the managing process to %global_allowed_admin_tools."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Windows NT\\CurrentVersion\\Winlogon(\\|$)/ nocase
    (
      (
        $reg.target.registry.registry_value_name = /^shell$/ nocase and
        not $reg.target.registry.registry_value_data = /^\s*explorer\.exe\s*$/ nocase
      ) or
      (
        $reg.target.registry.registry_value_name = /^userinit$/ nocase and
        not $reg.target.registry.registry_value_data = /^\s*([a-z]:\\windows\\system32\\)?userinit\.exe,?\s*$/ nocase
      ) or
      $reg.target.registry.registry_value_name = /^(taskman|appsetup|ginadll|dllname)$/ nocase
    )
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1547.004")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $modified_value_name = array_distinct($reg.target.registry.registry_value_name)
    $modified_value_data = array_distinct($reg.target.registry.registry_value_data)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $modifying_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
