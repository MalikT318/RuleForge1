/*
  MITRE Technique : T1546.003 - Windows Management Instrumentation Event Subscription
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:03:46.329579+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_003_WMI_MOF_File_Dropped_In_Autorecover_Directory {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a .mof file directly in the WMI MOF auto-recovery directory (System32\\wbem\\mof) by a process that is not a trusted installer, management or security tool. The WMI service (winmgmt) compiles any MOF dropped here at service start and moves it to the good or bad subfolder. This lets an adversary register a persistent WMI event filter, consumer and binding without running mofcomp.exe or leaving a command line. Detection is based on the resulting file artifact, not process command-line content."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.003"
    mitre_technique_name = "Event Triggered Execution: Windows Management Instrumentation Event Subscription"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR file events or Sysmon Event ID 11) with the full target path and the creating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers or drivers that register WMI providers by shipping MOF files (hardware vendor management agents, SQL Server, Exchange, System Center agents, OEM utilities); Windows servicing (TrustedInstaller/TiWorker) during updates; RMM or deployment tools pushing WMI classes."
    tuning_guidance = "Add approved deployment, patching or RMM binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Review the file path and creating process in the alert. Files that land directly in the mof directory and are not from a known installer are rare. Pair with a review of the WMI repository subscriptions (__EventFilter, __EventConsumer, __FilterToConsumerBinding) on the affected host."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\windows\\system32\\wbem\\mof\\[^\\]+\.mof$/ nocase
    not $file.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|MsMpEng|MsSense|SenseIR|WmiPrvSe)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1546.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $mof_file_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $creating_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
