/*
  MITRE Technique : T1547.005 - Security Support Provider
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:31:37.973369+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_005_LSA_Security_Packages_Repeated_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated registry modifications to the LSA 'Security Packages' value (Lsa or Lsa\\OSConfig) on a single host within ten minutes. Adversaries add a Security Support Provider DLL to both locations to get it loaded into LSASS at boot or via AddSecurityPackage, giving access to plaintext credentials. A single write can be benign, but repeated writes to these values on one host are rare and high risk."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.005"
    mitre_technique_name = "Boot or Logon Autostart Execution: Security Support Provider"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events 12/13/14) normalised to UDM REGISTRY_MODIFICATION with registry key and value name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Installation or upgrade of legitimate authentication software (smart card middleware, third-party SSO or credential providers, MFA agents), Windows servicing or feature updates, and security tooling that registers its own security package."
    tuning_guidance = "Add approved installer, deployment or patching process paths to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Raise the count threshold if software deployment frequently writes both keys, or lower it to 1 for high-security servers such as domain controllers."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control\\Lsa(\\OSConfig)?(\\|$)/ nocase
    (
      $reg.target.registry.registry_value_name = /^security packages$/ nocase or
      $reg.target.registry.registry_key = /\\Lsa(\\OSConfig)?\\Security Packages$/ nocase
    )
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.005")
    $primary_entity = array_distinct($host)
    $modification_count = count($reg.metadata.id)
    $modified_keys = array_distinct($reg.target.registry.registry_key)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $acting_users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 2
}
