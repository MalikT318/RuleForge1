/*
  MITRE Technique : T1199 - Trusted Relationship
  Tactic(s)       : Initial Access
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:48:39.436100+00:00
  Reference       : https://attack.mitre.org/techniques/T1199
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1199_External_Identity_Granted_Privileged_Role {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a privilege or role assignment to an external, guest or partner-style identity in the directory. Adversaries abusing a trusted third-party relationship, such as a compromised contractor or partner account, use this to gain administrative control. The rule uses identity-provider audit telemetry for a Windows/Active Directory-based estate rather than endpoint process data, so it complements existing Windows endpoint coverage."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1199"
    mitre_technique_name = "Trusted Relationship"
    log_prerequisites = "Requires identity provider directory audit logs normalised to USER_CHANGE_PERMISSIONS, with target.user.userid and target.user.attribute.roles.name populated. Guest and external accounts must be distinguishable by naming convention (external-user marker, or an ext/vendor/contractor/partner prefix or suffix)."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Legitimate onboarding of contractors, MSP technicians or partner administrators through an approved change process; delegated administration set up by the IAM team; guest accounts for project collaboration that need elevated roles."
    tuning_guidance = "Add approved IAM or onboarding automation accounts to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Adjust the external-account naming regex and privileged role regex to each client's convention. Correlate hits with change tickets before closing."

  events:
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.target.user.userid = /(#EXT#|^(ext|vendor|contractor|partner|msp)[._-]|[._-](ext|vendor|contractor|partner|msp)@)/ nocase
    $perm.target.user.attribute.roles.name = /(admin|owner|contributor|privileged|global|security|operator)/ nocase
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1199")
    $primary_entity = array_distinct($perm.target.user.userid)
    $granting_actor = array_distinct($perm.principal.user.userid)
    $granted_roles = array_distinct($perm.target.user.attribute.roles.name)

  condition:
    $perm
}
