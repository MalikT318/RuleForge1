/*
  MITRE Technique : T1203 - Exploitation for Client Execution
  Tactic(s)       : Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:56:36.820419+00:00
  Reference       : https://attack.mitre.org/techniques/T1203
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1203_Linux_Client_App_Drops_Executables_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single Linux host sees several script, shared-object or binary files created in world-writable staging directories (/tmp, /var/tmp, /dev/shm) by a client-facing application (browser, mail client, document viewer, office suite) within ten minutes. One such file can be benign. A burst of executable content written by a client application is a strong post-exploitation indicator that a vulnerability in the application was used to drop a payload."
    mitre_tactic = "Execution"
    mitre_technique = "T1203"
    mitre_technique_name = "Exploitation for Client Execution"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry that populates the principal process path and the target file path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Browser extensions or native messaging hosts unpacking helper scripts, office suite macros or add-ins writing temporary scripts, PDF viewers or browsers extracting plugin shared objects, developer workstations downloading and testing scripts through a browser, and automated UI testing frameworks driving a browser."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_security_tools. Raise the #file threshold on developer or QA hosts. Extend the extension list or staging directories to match local policy. Review the dropped_files and users outcome fields to confirm whether the files were subsequently executed."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(firefox|firefox-bin|chrome|chromium|chromium-browser|brave|brave-browser|opera|vivaldi|epiphany|thunderbird|evince|okular|atril|zathura|soffice\.bin|soffice|libreoffice|acroread)$/ nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.*\.(sh|bash|so|elf|bin|py|pl|rb|run|out)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1203")
    $primary_entity = array_distinct($host)
    $file_count = count($file.metadata.id)
    $dropped_files = array_distinct($file.target.file.full_path)
    $source_apps = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
