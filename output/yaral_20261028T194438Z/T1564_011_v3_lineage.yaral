/*
  MITRE Technique : T1564.011 - Ignore Process Interrupts
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:29:59.465871+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_011_Unexpected_Parent_Spawns_Interpreter_Ignoring_Errors {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a script interpreter or shell launched by a parent that should not spawn one (Office application, web server worker, print spooler, database service) where the command line sets error handling to SilentlyContinue or Ignore. This is the PowerShell equivalent of nohup: the payload keeps running through errors, session changes and failed C2. The detection pivots on process lineage, and the command-line qualifier only narrows the match to the T1564.011 behaviour."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.011"
    mitre_technique_name = "Ignore Process Interrupts"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with parent and child image paths and full command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Line-of-business Office macros or add-ins that call PowerShell with -ErrorAction SilentlyContinue, web applications that legitimately shell out for administration (for example IIS-hosted management portals), database maintenance jobs that run via xp_cmdshell, and print-management or driver-deployment tooling that launches scripts from the spooler."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts and approved management tooling to %global_allowed_admin_tools. If a specific web or database workload is known to shell out, allowlist its parent executable name rather than its install directory. The parent and child regexes can be extended with additional services if the client runs other server-side runtimes."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat[0-9]*|spoolsv|sqlservr|mysqld|postgres|php-cgi)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(erroraction(preference)?|\s-ea)\s*[:=\s]\s*['"]?(silentlycontinue|ignore)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1564.011")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
