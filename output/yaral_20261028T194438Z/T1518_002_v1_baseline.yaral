/*
  MITRE Technique : T1518.002 - Backup Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:21:47.683203+00:00
  Reference       : https://attack.mitre.org/techniques/T1518/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_002_Linux_Backup_Software_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux process that enumerates installed or running backup software. It combines a discovery utility (package manager query, service listing, process or file search) with a backup product keyword on the command line. Ransomware and data-destruction operators run this reconnaissance before they delete backups or inhibit recovery."
    mitre_tactic = "Discovery"
    mitre_technique = "T1518.002"
    mitre_technique_name = "Software Discovery: Backup Software Discovery"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records (execve syscall auditing) normalised to UDM PROCESS_LAUNCH, with full command lines populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup administrators verifying agent installs or service state, configuration management and inventory tooling (Ansible, Puppet, Chef, Salt), RMM and patching agents running package queries, vulnerability scanners, monitoring agents checking backup service health, and admins troubleshooting a backup job."
    tuning_guidance = "Add approved backup agents and schedulers to %global_allowed_backup_processes (matched on parent process path). Add inventory, patching and configuration management tooling to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Add approved scanner parents to %global_allowed_script_hosts. To reduce noise further, raise the risk score only when the activity is run by an interactive user or follows a first-seen login."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Backup product keyword anywhere in the command line
    $proc.target.process.command_line = /\b(veeam\w*|bacula\w*|bareos\w*|amanda|acronis\w*|commvault|rubrik|cohesity|netbackup|networker|avamar|backupexec|backup[-_ ]exec|beremote|urbackup|rsnapshot|restic|borgbackup|borgmatic|duplicity|duply|timeshift|cloudberry|storagecraft|datto|druva|veritas|crashplan|backblaze|idrive|dsmc)\b/ nocase

    // Discovery mechanism: package query, service/process listing, file search, or a shell wrapping them
    (
      (
        $proc.target.process.file.full_path = /\/(rpm|dpkg|dpkg-query|apt|apt-get|apt-cache|yum|dnf|zypper|snap|pacman|apk|systemctl|service|chkconfig|crontab)$/ nocase and
        $proc.target.process.command_line = /(\s-qa?\b|\s-l\b|\s-s\b|\s-S\b|\blist(-units|-unit-files|-timers)?\b|\bsearch\b|\bshow\b|\binfo\b|\bpolicy\b|\bstatus\b|\bquery\b|\bis-active\b|\bis-enabled\b|\bcat\b)/ nocase
      ) or
      $proc.target.process.file.full_path = /\/(grep|egrep|fgrep|pgrep|pidof|ps|locate|plocate|mlocate|find|which|whereis|ls|lsof)$/ nocase or
      (
        $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh)$/ nocase and
        $proc.target.process.command_line = /(rpm\s+-qa|dpkg\s+-l|dpkg-query|systemctl\s+list|service\s+--status-all|\bps\s+(-?a|-?e)|pgrep|\bfind\s|locate\s|which\s|whereis\s|\bls\s|grep)/ nocase
      )
    )

    $proc.principal.hostname = $hostname

    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1518.002")
    $primary_entity = array_distinct($hostname)
    $users = array_distinct($proc.principal.user.userid)
    $commands = array_distinct($proc.target.process.command_line)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
