/*
  MITRE Technique : T1218.004 - InstallUtil
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:47:01.984214+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_004_InstallUtil_Anomalous_Parent_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects InstallUtil.exe launched by a parent process that should never start it, such as an Office application, web server worker, database service, print spooler, WMI provider host, WinRM host, or script/proxy-execution host. Legitimate .NET installers are normally started by msiexec, setup bootstrappers, or an admin shell. InstallUtil spawned from these parents indicates document-, web shell-, or script-driven proxy execution of .NET code. The rule pivots on process lineage and does not depend on command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.004"
    mitre_technique_name = "System Binary Proxy Execution: InstallUtil"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with populated parent (principal.process) and child (target.process) image paths, from an EDR, Sysmon Event ID 1, or Security Event 4688 with parent process logging."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "SCCM or other software deployment pushed through WMI (wmiprvse.exe parent), remote administration over WinRM (wsmprovhost.exe), a web-based deployment or management portal that runs .NET service installers under w3wp.exe, and legacy line-of-business installers that call InstallUtil from a script host (wscript or cscript) during setup."
    tuning_guidance = "Add approved deployment and management parent binaries to %global_allowed_admin_tools. Add approved script-hosting parents to %global_allowed_script_hosts. To widen coverage, extend the parent regex with additional unexpected parents. To reduce noise from WMI or WinRM deployment, allowlist the specific parent paths in the reference lists rather than removing them from the regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\installutil\.exe$/ nocase
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|acrord32|acrobat|w3wp|httpd|nginx|tomcat\d*|php-cgi|sqlservr|spoolsv|wmiprvse|wsmprovhost|mshta|wscript|cscript|regsvr32|rundll32)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1218.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
