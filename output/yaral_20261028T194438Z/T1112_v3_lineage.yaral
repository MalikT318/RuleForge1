/*
  MITRE Technique : T1112 - Modify Registry
  Tactic(s)       : Defense Impairment, Persistence
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:12:48.084451+00:00
  Reference       : https://attack.mitre.org/techniques/T1112
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1112_Registry_Tool_Spawned_By_Anomalous_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a native registry modification utility (reg.exe or regedit.exe) launched with a modifying operation by a parent process that should never manage the registry: an Office application, web server or application server worker, print spooler, or database service. This lineage anomaly indicates macro, web shell, or service exploitation being used to modify the registry for persistence or defence impairment. Detection is driven by process lineage, not by specific registry keys or payloads."
    mitre_tactic = "Defense Impairment, Persistence"
    mitre_technique = "T1112"
    mitre_technique_name = "Modify Registry"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with populated parent process path (EDR, Sysmon Event ID 1, or Security Event 4688 with parent process logging)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy Office add-ins or macros that write configuration through reg.exe, vendor installers or patch tooling launched from a database or print service, web applications that intentionally configure IIS or application settings via reg.exe, and Office self-repair or click-to-run updaters."
    tuning_guidance = "Add approved parent process paths to %global_allowed_admin_tools or %global_allowed_script_hosts, and add known administrator accounts to %global_allowed_admin_users. If the Java or Tomcat parent produces noise in an environment with legitimate application-server management scripts, allowlist that parent path in %global_allowed_script_hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|spoolsv|sqlservr)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(reg|regedit)\.exe$/ nocase
    $proc.target.process.command_line = /\s(add|import|delete|copy|restore|load|unload)\s|\s[\/-]s(\s|$)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1112")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
