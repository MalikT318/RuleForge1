/*
  MITRE Technique : T1036.005 - Match Legitimate Resource Name or Location
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:05:48.700813+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_005_K8s_Workload_Creation_In_System_Namespace_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single non-allowlisted identity creates multiple workload resources (pods, deployments, daemonsets, jobs and similar) in trusted Kubernetes system namespaces within ten minutes. Adversaries hide backdoor workloads in kube-system and similar namespaces, or give them names that look like cluster components, so they blend in with legitimate infrastructure. One creation can be benign; repeated creation by one non-platform identity is not."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.005"
    mitre_technique_name = "Masquerading: Match Legitimate Resource Name or Location"
    log_prerequisites = "Kubernetes API server audit logging enabled at Metadata level or higher for create verbs, and ingested into Chronicle with the request URI populated in target.url and the caller in principal.user.userid."
    platform = "Containers"
    log_source = "container"
    false_positives = "Cluster bootstrap and upgrade tooling, GitOps or CI/CD controllers deploying add-ons (CNI, CSI, ingress, monitoring) into system namespaces, managed-Kubernetes control-plane identities, and cluster admins performing maintenance."
    tuning_guidance = "Add deployment pipelines and operator identities to %global_allowed_service_accounts, named cluster administrators to %global_allowed_admin_users, and cloud-managed control-plane identities to %global_allowed_cloud_principals. Raise the #k8s threshold in noisy clusters. Extend the namespace regex if the client uses additional trusted namespaces."

  events:
    $k8s.metadata.event_type = "RESOURCE_CREATION"
    $k8s.target.url = /\/namespaces\/(kube-system|kube-public|kube-node-lease)\/(pods|deployments|daemonsets|statefulsets|replicasets|cronjobs|jobs|replicationcontrollers)(\/|\?|$)/ nocase
    $k8s.principal.user.userid = $user
    not $k8s.principal.user.userid = /^system:(node:|kube-controller-manager|kube-scheduler|apiserver|serviceaccount:kube-system:(daemon-set-controller|deployment-controller|replicaset-controller|job-controller|cronjob-controller|statefulset-controller|replication-controller))/ nocase
    not $k8s.principal.user.userid in %global_allowed_service_accounts
    not $k8s.principal.user.userid in %global_allowed_admin_users
    not $k8s.principal.user.userid in %global_allowed_cloud_principals

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($k8s.metadata.id)
    $mitre_technique_id = array_distinct("T1036.005")
    $primary_entity = array_distinct($user)
    $created_resource_names = array_distinct($k8s.target.resource.name)
    $request_uris = array_distinct($k8s.target.url)
    $source_ips = array_distinct($k8s.principal.ip)

  condition:
    #k8s >= 3
}
