/*
  MITRE Technique : T1037 - Boot or Logon Initialization Scripts
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:17:56.796314+00:00
  Reference       : https://attack.mitre.org/techniques/T1037
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_ESXi_Boot_Init_Script_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell command on an ESXi host that writes to, copies into, or changes permissions on the boot initialization script locations /etc/rc.local and /etc/rc.local.d/ (local.sh). ESXi runs these scripts as root at every boot, so this is the most direct persistence mechanism for T1037 on the platform. Ransomware operators and other intruders use it to re-establish backdoors, SSH enablement, or payloads after a reboot."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037"
    mitre_technique_name = "Boot or Logon Initialization Scripts"
    log_prerequisites = "ESXi shell command logging (shell.log / ESXi Shell audit) forwarded via syslog and parsed to UDM PROCESS_LAUNCH with target.process.command_line populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators legitimately customising /etc/rc.local.d/local.sh (for example persisting NTP, advanced settings, or network tweaks); host provisioning and configuration-management scripts; vendor driver or agent install scripts that register boot hooks."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and approved deployment or configuration tooling to %global_allowed_admin_tools. Make sure ESXi shell logging is enabled, otherwise the rule has no data. Consider raising severity to Critical for hosts where interactive shell access is normally disabled."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(>>?|\btee\b|\bsed\s+(-\w+\s+)*-i|\b(cp|mv|ln|vi|vim|chmod|install|wget|curl|scp)\b).*\/etc\/rc\.local(\.d\b|\s|$|\/)/ nocase
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1037")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
