/*
  MITRE Technique : T1204.002 - Malicious File
  Tactic(s)       : Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:01:38.072238+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_002_Linux_Masqueraded_Executable_Dropped_In_User_Paths {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a file on Linux whose name uses a document or image extension followed by an executable or launcher extension (for example report.pdf.desktop, invoice.xlsx.sh, photo.jpg.AppImage). The file lands in a user-facing or world-writable staging location (Downloads, Desktop, Documents, /tmp, /var/tmp, /dev/shm). This is the typical result of a user downloading or extracting a social-engineered attachment that depends on the user opening it. Detection is file-creation based, so it adds coverage beside process command-line rules."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.002"
    mitre_technique_name = "User Execution: Malicious File"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-create events normalised to UDM FILE_CREATION with target.file.full_path and principal.process populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers saving or testing shell scripts with double extensions, software installers distributed as .run or .AppImage that are saved in Downloads, documentation tooling that generates files such as doc.txt.sh, and admin scripts staging files in /tmp."
    tuning_guidance = "Add software deployment and RMM tooling to %global_allowed_admin_tools, and automation or build accounts to %global_allowed_service_accounts. Add backup tooling that restores files to %global_allowed_backup_processes. To reduce noise on developer workstations, narrow the extension list or limit the path regex to Downloads and Desktop. To raise fidelity, require the creating process to be a browser, mail client or archive utility."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(home\/[^\/]+|root)\/(Downloads|Desktop|Documents)\/|^\/(tmp|var\/tmp|dev\/shm)\// nocase
    $file.target.file.full_path = /\/[^\/]+\.(pdf|docx?|xlsx?|pptx?|rtf|odt|ods|jpe?g|png|gif|txt|zip)\.(desktop|sh|run|appimage|bin|elf|py|pl|out)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1204.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file = array_distinct($file.target.file.full_path)
    $creator_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
