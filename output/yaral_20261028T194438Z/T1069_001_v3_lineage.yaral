/*
  MITRE Technique : T1069.001 - Local Groups
  Tactic(s)       : Discovery
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:57:24.098918+00:00
  Reference       : https://attack.mitre.org/techniques/T1069/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1069_001_Linux_ServiceParent_Spawns_Group_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects local group discovery (id, groups, getent group, reads of /etc/group) launched directly by a web server, application server, database or print service process. These service processes do not normally enumerate local groups. This pattern is typical of a web shell or injected service performing post-exploitation reconnaissance. Detection is based on the parent-child lineage anomaly rather than the discovery command alone."
    mitre_tactic = "Discovery"
    mitre_technique = "T1069.001"
    mitre_technique_name = "Permission Groups Discovery: Local Groups"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records normalised to UDM PROCESS_LAUNCH, with populated parent (principal.process) and child (target.process) executable paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web applications or CMS plugins that call id/groups for permission checks; Java or Node.js applications that shell out to check file ownership; database maintenance scripts launched by the database service; deployment hooks run from an application server; CUPS filters checking group membership."
    tuning_guidance = "Add approved parent binaries to %global_allowed_script_hosts and approved management tooling to %global_allowed_admin_tools. Narrow or extend the parent process regex for runtimes such as java or node on hosts where they legitimately shell out. For noisy application servers, review the parent path and child command line in the outcome fields before allowlisting."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|php[0-9.]*|tomcat[0-9]*|catalina|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|cupsd)$/ nocase
    (
      $proc.target.process.file.full_path = /\/(id|groups|lid|libuser-lid)$/ nocase
      or
      (
        $proc.target.process.file.full_path = /\/getent$/ nocase and
        $proc.target.process.command_line = /\bgroup\b/ nocase
      )
      or
      (
        $proc.target.process.file.full_path = /\/(ba|da|a|z|k|c|tc)?sh$/ nocase and
        $proc.target.process.command_line = /(\/etc\/group|getent\s+group|\bgroups\b|\blid\b|(^|[;&|\s])id(\s|;|$))/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1069.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
