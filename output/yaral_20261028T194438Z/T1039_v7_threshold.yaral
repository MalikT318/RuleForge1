/*
  MITRE Technique : T1039 - Data from Network Shared Drive
  Tactic(s)       : Collection
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:26:25.651967+00:00
  Reference       : https://attack.mitre.org/techniques/T1039
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1039_Linux_Network_Share_Bulk_Enumeration_Collection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of file search, listing, or copy/archive commands pointed at network-share mount locations (/mnt, /media, /net, /srv/nfs, gvfs) on a single Linux host within 10 minutes. A single access is routine; bulk enumeration and collection from mounted NFS/SMB shares suggests an adversary hunting for files of interest ahead of exfiltration."
    mitre_tactic = "Collection"
    mitre_technique = "T1039"
    mitre_technique_name = "Data from Network Shared Drive"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records normalised to UDM PROCESS_LAUNCH with command_line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup and sync jobs, administrators and users working with mounted NFS/CIFS shares, build and CI jobs reading shared artefact storage, data-processing pipelines, and media or indexing tools scanning removable or network media."
    tuning_guidance = "Add approved backup or sync tooling to %global_allowed_backup_processes, admin and automation binaries to %global_allowed_admin_tools, and service or batch accounts to %global_allowed_service_accounts. Raise the #proc threshold on hosts that routinely use shares heavily. If the tenant mounts shares at non-standard locations, extend the mount-path regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(find|ls|tree|du|locate|grep|egrep|cat|cp|rsync|tar|zip|7z|7za|scp|head|strings)$/ nocase
    $proc.target.process.command_line = /(^|\s|=|")\/(mnt|media|net|srv\/nfs|run\/media|run\/user\/[0-9]+\/gvfs)\// nocase
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($proc.target.process.file.full_path = /\/(cp|rsync|tar|zip|7z|7za|scp)$/ nocase, 75, 50))
    $mitre_technique_id = array_distinct("T1039")
    $primary_entity = array_distinct($host)
    $event_count = count($proc.metadata.id)
    $users = array_distinct($proc.principal.user.userid)
    $commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 15
}
