/*
  MITRE Technique : T1558.004 - AS-REP Roasting
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:46:29.911523+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_004_Preauth_Disabled_Via_Account_Control_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a command line that disables Kerberos preauthentication on an Active Directory account (DoesNotRequirePreAuth, DONT_REQ_PREAUTH, or a userAccountControl write that sets the 0x400000 bit). This makes the account AS-REP roastable and is a common precursor to offline hash cracking. This is a Windows-specific variant that focuses on the enabling step instead of the AS-REQ/AS-REP traffic itself. The platform requirement for this task is Windows, so it conflicts with the 'alternate platform' angle and the Windows requirement was followed."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.004"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: AS-REP Roasting"
    log_prerequisites = "Requires EDR process telemetry or Windows Event 4688 with command-line auditing enabled, and optionally PowerShell logging that surfaces the command line."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Domain administrators deliberately configuring legacy applications or service accounts that cannot use Kerberos preauthentication; identity-management or provisioning automation; lab and migration scripts."
    tuning_guidance = "Add approved admin accounts to %global_allowed_admin_users, provisioning accounts to %global_allowed_service_accounts, and approved automation parent processes to %global_allowed_admin_tools. Review any remaining hits as high-confidence misconfiguration or attacker preparation."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $proc.target.process.command_line = /DoesNotRequirePreAuth\s*[:=\s]\s*\(?\$?true/ nocase or
      $proc.target.process.command_line = /DONT_REQ_PREAUTH/ nocase or
      $proc.target.process.command_line = /userAccountControl.{0,60}(4194304|4194816|4194818|4260352)/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1558.004")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
