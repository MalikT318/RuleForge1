/*
  MITRE Technique : T1556.003 - Pluggable Authentication Modules
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:18:02.056634+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_003_PAM_Module_Download_Over_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux host fetching a PAM shared-object module (pam_*.so / libpam*.so) or a Linux-PAM source archive from an external destination over HTTP(S), as seen in proxy or firewall logs. Adversaries stage backdoored pam_unix.so replacements or download Linux-PAM source to compile a patched module that accepts arbitrary credentials or harvests passwords. This is a network-side view of module staging and is independent of endpoint command-line detections."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.003"
    mitre_technique_name = "Modify Authentication Process: Pluggable Authentication Modules"
    log_prerequisites = "Requires proxy or firewall logs with URL-level HTTP visibility (TLS inspection for HTTPS) normalised to NETWORK_HTTP with target.url populated. Source hosts must be identifiable by principal.hostname."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Administrators or developers building Linux-PAM from source, custom PAM module development pipelines, configuration management pulling approved PAM modules from an internal artifact mirror hosted externally, and vendor or distribution repositories serving .so files directly."
    tuning_guidance = "Add known-good vendor and mirror domains to %global_allowed_domains. Confirm %rfc1918_internal covers the client's internal address space so internal artifact servers are excluded. Without TLS inspection, HTTPS URLs are not visible and this rule will only fire on plain HTTP or inspected traffic."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET"
    $net.target.url = /(\/(lib)?pam_[a-z0-9_\-]+\.so(\.[0-9]+)*([?#]|$)|linux-pam[-_0-9.a-z]*\.(tar\.|tgz|zip))/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1556.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $requested_urls = array_distinct($net.target.url)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
