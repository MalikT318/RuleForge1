/*
  MITRE Technique : T1491.001 - Internal Defacement
  Tactic(s)       : Impact
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:44:47.733710+00:00
  Reference       : https://attack.mitre.org/techniques/T1491/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_001_ESXi_Host_Outbound_Fetch_Of_Defacement_Content {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an ESXi host using a command-line HTTP client (wget or curl) to fetch image, HTML or text content from an external destination. Ransomware and destructive operators use this to stage ransom notes, wallpaper or banner images and replacement login-page content, which they then use to replace the host login banner, message of the day or management UI landing page. Hypervisor hosts rarely retrieve this content type from the internet, so this is a network-side signal of internal defacement staging."
    mitre_tactic = "Impact"
    mitre_technique = "T1491.001"
    mitre_technique_name = "Defacement: Internal Defacement"
    log_prerequisites = "Requires ESXi host outbound HTTP telemetry that populates network.http.user_agent and target.url. Sources include a network sensor, proxy or firewall with host attribution, or an EDR or syslog pipeline on the host. The host name must be populated in principal.hostname."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators downloading patches, VIB or offline bundles, driver or firmware documentation pages, or scripts that fetch license or health-check text files from vendor sites; automated host provisioning and configuration-management pulls; legitimate host onboarding that downloads an HTML or text manifest."
    tuning_guidance = "Add approved vendor and update domains to %global_allowed_domains (matched against target.hostname). Add approved deployment and patching tooling to %global_allowed_admin_tools. Scope the rule to ESXi hosts through the client's asset context or log-source filtering. Narrow or widen the content-type extension regex based on the environment's baseline of host outbound traffic."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET"
    $net.network.http.user_agent = /(wget|curl)/ nocase
    $net.target.url = /\.(png|jpe?g|gif|bmp|html?|txt)(\?.*)?$/ nocase
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1491.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
