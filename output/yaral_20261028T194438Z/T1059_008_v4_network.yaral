/*
  MITRE Technique : T1059.008 - Network Device CLI
  Tactic(s)       : Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:18:13.746861+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_008_External_Telnet_To_Internal_Device_CLI {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a connection from an external (non-internal) source to a telnet management port (23 or 2323) on an internal host, as seen in perimeter logs. Telnet is the cleartext remote CLI of network devices, and external access to it indicates exposed management-plane CLI access, brute-force or botnet activity, or adversary use of the device CLI for execution."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.008"
    mitre_technique_name = "Command and Scripting Interpreter: Network Device CLI"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Best fidelity when the log source records permitted (allowed) sessions."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised third-party vendors or MSP staff using legacy telnet for device support, external vulnerability scanners and attack-surface monitoring, legacy out-of-band console servers or OT equipment that is intentionally reachable, and denied or blocked connection attempts if the firewall logs them as NETWORK_CONNECTION."
    tuning_guidance = "Add approved external management source addresses to %global_allowed_mgmt_sources and scanner sources to %global_allowed_scanners. Service account or vendor identities are not available in perimeter logs, so tune by source address. If blocked attempts are logged as NETWORK_CONNECTION, restrict ingestion or the parser to allowed sessions to reduce noise. Migrate any remaining telnet use to SSH."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 23 or $net.target.port = 2323)
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1059.008")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ports = array_distinct($net.target.port)
    $target_hostnames = array_distinct($net.target.hostname)

  condition:
    $net
}
