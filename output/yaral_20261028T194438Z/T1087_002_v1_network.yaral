/*
  MITRE Technique : T1087.002 - Domain Account
  Tactic(s)       : Discovery
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:53:46.201702+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_002_Perimeter_LDAP_Directory_Query_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects directory-service query traffic (LDAP, LDAPS, Global Catalog) crossing the network perimeter to a non-internal destination. Domain account enumeration depends on LDAP/GC queries. Seen at the perimeter, they indicate an internal host enumerating an externally reachable or attacker-controlled directory, or an external party querying an exposed domain controller. This is network-side coverage for domain account discovery and does not depend on process or command-line telemetry."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.002"
    mitre_technique_name = "Account Discovery: Domain Account"
    log_prerequisites = "Requires firewall, proxy, or perimeter connection logs normalised to UDM NETWORK_CONNECTION with target.ip and target.port populated. Logs must cover egress traffic, and ingress traffic if domain controllers are published."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Cloud-hosted or hybrid directory services (managed directory, cloud-based domain controllers in a public address range), SaaS applications using LDAPS for directory sync, partner or B2B federation links, authorised vulnerability scanners, and sites whose internal address space is missing from the reference list."
    tuning_guidance = "Confirm %rfc1918_internal covers all client private ranges. Add approved scanner source hosts to %global_allowed_scanners and known-good directory-sync or vendor destinations to %global_allowed_domains. For hybrid-identity clients, add the cloud directory hostnames to %global_allowed_domains. Raise severity if the source host is a workstation rather than a server."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 389 or
      $net.target.port = 636 or
      $net.target.port = 3268 or
      $net.target.port = 3269
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1087.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
