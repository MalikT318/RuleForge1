/*
  MITRE Technique : T1055.004 - Asynchronous Procedure Call
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:50:38.078567+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_004_APC_Injection_Handle_Open_UserWritable_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process running from a user-writable location (AppData, Temp, Downloads, Public, ProgramData) that requests a handle to a different, commonly injected Windows host process (explorer, svchost, winlogon, spoolsv, dllhost and similar). Opening the victim process or thread is the prerequisite step for APC injection, including Early Bird and thread-hijack variants. The rule works on the handle-request state change, so it does not depend on command-line logging and still fires if the binary is renamed."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.004"
    mitre_technique_name = "Process Injection: Asynchronous Procedure Call"
    log_prerequisites = "Requires EDR or Sysmon-equivalent process-access telemetry (for example Sysmon Event ID 10) normalised to UDM PROCESS_OPEN with principal and target process paths populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-user installed applications that legitimately interact with shell or host processes (collaboration clients, cloud-sync agents, updaters running from AppData); accessibility and screen-reader software; unsigned in-house tools or installers extracting to Temp; security or backup agents not yet in the allowlists."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools, imaging or backup software to %global_allowed_backup_processes, and IT or deployment tooling to %global_allowed_admin_tools. If the telemetry carries the granted access mask, consider tightening the rule to thread-related rights. Review the source_process outcome values for recurring benign per-user applications."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.process.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|users\\public|programdata|windows\\temp|temp)\\/ nocase
    $open.target.process.file.full_path = /\\(explorer|svchost|winlogon|spoolsv|dllhost|taskhostw|runtimebroker|searchindexer|sihost|ctfmon|wermgr|werfault)\.exe$/ nocase
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    not $open.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|NisSrv)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1055.004")
    $primary_entity = array_distinct($open.principal.hostname)
    $source_process = array_distinct($open.principal.process.file.full_path)
    $target_process = array_distinct($open.target.process.file.full_path)
    $source_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
