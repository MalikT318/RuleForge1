/*
  MITRE Technique : T1573.001 - Symmetric Cryptography
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:22:54.088177+00:00
  Reference       : https://attack.mitre.org/techniques/T1573/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1573_001_Sustained_Encrypted_Channel_NonStandard_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects the network-observable pattern of a custom symmetric-encrypted C2 channel. An internal host makes repeated connections to the same external IP and non-standard high port, then a bidirectional flow with small, beacon-sized payloads appears on the same tuple within ten minutes. Encrypted C2 that avoids standard TLS ports and has no recognisable protocol is typically seen this way at the perimeter. Intended for Windows client address space; the firewall cannot see the initiating process, so host attribution is by source IP."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1573.001"
    mitre_technique_name = "Encrypted Channel: Symmetric Cryptography"
    log_prerequisites = "Requires firewall or perimeter connection logs and flow logs with source IP, destination IP, destination port and byte counters, normalised to UDM NETWORK_CONNECTION and NETWORK_FLOW."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Custom line-of-business applications on high ports, VoIP/video conferencing, game clients, P2P or sync software, VPN and remote-access clients on non-standard ports, and software update agents."
    tuning_guidance = "Add known-good external destination domains to %global_allowed_domains, authorised scanner source addresses to %global_allowed_scanners, and approved management source addresses to %global_allowed_mgmt_sources. Adjust the byte-size bounds and the #conn threshold for the environment. Extend the excluded port list with ports legitimately used by client applications."

  events:
    $conn.metadata.event_type = "NETWORK_CONNECTION"
    $conn.principal.ip = $src_ip
    $conn.target.ip = $dst_ip
    $conn.target.port = $port
    $conn.target.port >= 1024
    not $conn.target.port = 8080
    not $conn.target.port = 8443
    not $conn.target.ip in %rfc1918_internal
    not $conn.target.hostname in %global_allowed_domains
    not $conn.principal.ip in %global_allowed_scanners
    not $conn.principal.ip in %global_allowed_mgmt_sources

    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.principal.ip = $src_ip
    $flow.target.ip = $dst_ip
    $flow.target.port = $port
    $flow.network.sent_bytes >= 100
    $flow.network.sent_bytes <= 10000
    $flow.network.received_bytes >= 100
    $flow.network.received_bytes <= 100000
    not $flow.target.ip in %rfc1918_internal
    not $flow.target.hostname in %global_allowed_domains

    $conn.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $src_ip, $dst_ip, $port over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1573.001")
    $primary_entity = array_distinct($src_ip)
    $destination_ips = array_distinct($dst_ip)
    $destination_ports = array_distinct($port)
    $connection_count = count($conn.metadata.id)
    $flow_count = count($flow.metadata.id)
    $total_sent_bytes = max($flow.network.sent_bytes)
    $total_received_bytes = max($flow.network.received_bytes)

  condition:
    #conn >= 3 and #flow >= 1
}
