/*
  MITRE Technique : T1484.002 - Trust Modification
  Tactic(s)       : Defense Impairment, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:34:41.670265+00:00
  Reference       : https://attack.mitre.org/techniques/T1484/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1484_002_Federation_Trust_Config_API_Call {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows host sending a state-changing HTTP request (POST/PUT/PATCH) to an external identity-provider API path that manages domain federation or trust configuration. This is the network-side signature of an adversary converting a domain to federated, adding a token-signing certificate, or modifying trust settings to forge tokens or bypass authentication. It is intended to complement process and command-line detections for the same technique."
    mitre_tactic = "Defense Impairment, Privilege Escalation"
    mitre_technique = "T1484.002"
    mitre_technique_name = "Domain or Tenant Policy Modification: Trust Modification"
    log_prerequisites = "Requires proxy, secure web gateway, or EDR network telemetry with TLS inspection (or an equivalent source) that populates network.http.method and target.url. Requires principal.hostname and principal.user.userid to be populated."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Authorised identity administrators converting or managing federated domains, hybrid identity sync and federation setup wizards, identity-governance or IaC automation (for example Terraform or deployment pipelines), tenant migration projects, and approved penetration tests."
    tuning_guidance = "Add named administrator accounts to %global_allowed_admin_users and automation or service accounts to %global_allowed_service_accounts. During planned federation or tenant migration work, expect a burst of expected alerts from the same admin hosts. Narrow or extend the URL path regex to match the HTTP API paths your proxy logs record."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT|PATCH)$/ nocase
    $net.target.url = /(?i)(federationconfiguration|domainfederation|setdomainauthentication|setfederationsettings|internaldomainfederation)/
    not $net.target.ip in %rfc1918_internal
    not $net.principal.user.userid in %global_allowed_admin_users
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1484.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $acting_user = array_distinct($net.principal.user.userid)
    $target_urls = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
