/*
  MITRE Technique : T1547.002 - Authentication Package
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:26:15.851495+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_002_LSA_Auth_Package_Repeated_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects multiple modifications to LSA package registry values (Authentication Packages, Security Packages, Notification Packages) on a single host within ten minutes. These values are rewritten only rarely, during installs or hardening changes, so repeated writes suggest an adversary staging or re-staging an LSA DLL for persistence and credential access."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.002"
    mitre_technique_name = "Boot or Logon Autostart Execution: Authentication Package"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 13) normalised to REGISTRY_MODIFICATION, with target.registry.registry_key and registry_value_name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Installers of smart-card, MFA, credential-provider or password-filter software (Notification Packages); RMM or GPO-driven LSA hardening; in-place OS upgrades; some EDR agents that register LSA components during installation."
    tuning_guidance = "Add the approved installer or deployment binary names to %global_allowed_admin_tools and trusted agent binaries to %global_allowed_security_tools. Raise the threshold in the condition if password-filter software churns the values in your environment, or lower it to 1 for high-security tiers."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control\\Lsa\\?$/ nocase
    $reg.target.registry.registry_value_name = /^(Authentication Packages|Security Packages|Notification Packages)$/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.002")
    $primary_entity = array_distinct($host)
    $modification_count = count($reg.metadata.id)
    $modified_values = array_distinct($reg.target.registry.registry_value_name)
    $modifying_processes = array_distinct($reg.principal.process.file.full_path)
    $modifying_users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 2
}
