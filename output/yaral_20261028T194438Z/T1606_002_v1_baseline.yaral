/*
  MITRE Technique : T1606.002 - SAML Tokens
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:25:00.939470+00:00
  Reference       : https://attack.mitre.org/techniques/T1606/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1606_002_IdP_Federation_Trust_Or_Signing_Cert_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of identity provider federation trust or SAML token-signing certificate settings by an account that is not an approved administrator or service account. Adding a rogue federation trust or replacing the signing certificate is the prerequisite for forging SAML tokens (Golden SAML) and for authenticating to federated services as any user."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1606.002"
    mitre_technique_name = "Forge Web Credentials: SAML Tokens"
    log_prerequisites = "Requires identity provider directory/admin audit logs normalized to UDM SETTING_MODIFICATION with metadata.product_event_type populated with the audit operation name (federation, domain authentication, token-signing or SAML certificate operations)."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Planned federation onboarding or migration projects, scheduled token-signing certificate rollover (auto-rollover or manual), new SSO application integrations performed by identity engineers, and MSP or tenant administrators changing domain authentication settings."
    tuning_guidance = "Add named administrators who own federation and SSO to %global_allowed_admin_users and automation or certificate-rollover identities to %global_allowed_service_accounts. During planned federation changes, suppress by actor and time window rather than disabling the rule. Narrow or widen the product_event_type regex to match the operation names produced by the client's identity provider."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(federat(ion|ed)|token.?signing|signing.?cert|saml.*(cert|signing|metadata)|set.?domain.?authentication|idp\.lifecycle\.(create|update))/ nocase
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1606.002")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $operation_names = array_distinct($setting.metadata.product_event_type)
    $target_resource = array_distinct($setting.target.resource.name)
    $source_ips = array_distinct($setting.principal.ip)

  condition:
    $setting
}
