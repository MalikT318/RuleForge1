/*
  MITRE Technique : T1564.003 - Hidden Window
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:17:16.206409+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_003_Console_WindowPosition_Registry_Then_Interpreter_Launch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a modification of the WindowPosition value under the per-user Console registry key, followed within ten minutes by a console interpreter launch on the same host. Pushing the console window off-screen via the registry is a known way to hide the window of a script or shell from the user. The rule keys on the registry change and the later launch, not on command-line switches such as -WindowStyle Hidden."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.003"
    mitre_technique_name = "Hide Artifacts: Hidden Window"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (value-set events, e.g. Sysmon Event ID 13) with registry key and value name populated, plus process launch telemetry (EDR or Windows Event 4688) from the same hosts."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Console host (conhost) persisting window layout after a user moves or resizes a console; admin or profile-customisation scripts that set console defaults; logon scripts and RMM tooling that deploy console settings; developers customising terminal layout."
    tuning_guidance = "Add approved deployment and customisation tooling to %global_allowed_admin_tools (registry writer) and approved parent processes or hosts to %global_allowed_script_hosts (interpreter parent). Extend the registry writer exclusion regex if a client has a legitimate console-layout management agent. Raise severity if the registry writer is a scripting engine or reg.exe."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Console(\\|$)/ nocase
    $reg.target.registry.registry_value_name = /^WindowPosition$/ nocase
    not $reg.principal.process.file.full_path = /\\(conhost|explorer|csrss)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    $reg.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    $proc.principal.hostname = $hostname

    $reg.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1564.003")
    $primary_entity = array_distinct($hostname)
    $registry_writers = array_distinct($reg.principal.process.file.full_path)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $launched_interpreters = array_distinct($proc.target.process.file.full_path)
    $launching_parents = array_distinct($proc.principal.process.file.full_path)
    $affected_users = array_distinct($proc.principal.user.userid)

  condition:
    $reg and $proc
}
