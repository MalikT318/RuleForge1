/*
  MITRE Technique : T1565 - Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:36:55.283715+00:00
  Reference       : https://attack.mitre.org/techniques/T1565
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_Hosts_File_Modified_By_Unapproved_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects modification of the Windows hosts file (name-resolution override) by a process that is not an approved admin or security tool. Attackers alter this file to redirect or block traffic, tamper with update and security-vendor lookups, or manipulate what applications resolve. The rule works on the resulting file-state change, so it fires regardless of how the edit was made (command line, script, API call or renamed tool)."
    mitre_tactic = "Impact"
    mitre_technique = "T1565"
    mitre_technique_name = "Data Manipulation"
    log_prerequisites = "Requires endpoint file-modification telemetry (EDR or Sysmon FileCreate/FileModify equivalent) that populates target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT administrators editing the hosts file manually, VPN and ZTNA clients that add entries, container/WSL tooling (for example Docker Desktop), developer tooling, endpoint-management or software-deployment agents, and security products that sinkhole or block domains."
    tuning_guidance = "Add approved admin or deployment binaries to %global_allowed_admin_tools and security agents to %global_allowed_security_tools. Add approved remote-management tooling to %global_allowed_remote_mgmt. If specific VPN or developer tools are noisy, add their executable paths to %global_allowed_admin_tools rather than excluding by install directory. Raise severity for servers or hosts in sensitive tiers."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\\windows\\system32\\drivers\\etc\\hosts$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $file.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|TrustedInstaller|TiWorker)\.exe$/ nocase

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1565")
    $primary_entity = array_distinct($file.principal.hostname)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $modifying_user = array_distinct($file.principal.user.userid)
    $modified_file = array_distinct($file.target.file.full_path)

  condition:
    $file
}
