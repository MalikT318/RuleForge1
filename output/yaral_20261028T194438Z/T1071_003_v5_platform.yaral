/*
  MITRE Technique : T1071.003 - Mail Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:08:31.213869+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_003_Firewall_Outbound_Mail_Protocol_To_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host opening an outbound connection to an external destination on a mail protocol port (SMTP, SMTPS/submission, POP3/S, IMAP/S) as seen by the network perimeter. Adversaries abuse mail protocols for C2 to blend with normal traffic. Most client hosts relay mail through an internal gateway and should never speak these protocols directly to the internet, so direct egress is anomalous. This rule is network-observable only and does not depend on endpoint process data."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.003"
    mitre_technique_name = "Application Layer Protocol: Mail Protocols"
    log_prerequisites = "Firewall, proxy or perimeter connection/flow logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Egress (internal-to-external) traffic must be logged."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Internal mail servers and secure mail gateways relaying directly to the internet, multifunction printers and scanners sending scan-to-email, applications and monitoring systems sending SMTP alerts, users with direct IMAP/POP3 clients to personal or hosted mail, and SaaS mail relay integrations."
    tuning_guidance = "Add known-good external mail provider or relay domains to %global_allowed_domains (matched against target.hostname). Add authorised scanner sources to %global_allowed_scanners. Exclude approved mail gateway hosts via %global_allowed_remote_mgmt. Consider raising severity for server-VLAN or user-workstation segments where direct mail egress is never expected."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 25 or
      $net.target.port = 465 or
      $net.target.port = 587 or
      $net.target.port = 110 or
      $net.target.port = 995 or
      $net.target.port = 143 or
      $net.target.port = 993
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_remote_mgmt
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1071.003")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
