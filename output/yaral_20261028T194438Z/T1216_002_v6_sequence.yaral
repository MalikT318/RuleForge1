/*
  MITRE Technique : T1216.002 - SyncAppvPublishingServer
  Tactic(s)       : Stealth
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:37:15.179552+00:00
  Reference       : https://attack.mitre.org/techniques/T1216/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1216_002_SyncAppvPublishingServer_Script_Spawns_PowerShell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Windows script host (wscript/cscript) executing SyncAppvPublishingServer.vbs, followed on the same host within 10 minutes by PowerShell launched with the script host as its parent. This sequence indicates the signed App-V script is being used to proxy PowerShell execution and bypass execution restrictions."
    mitre_tactic = "Stealth"
    mitre_technique = "T1216.002"
    mitre_technique_name = "System Script Proxy Execution: SyncAppvPublishingServer"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with full command lines and parent process paths (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate Microsoft App-V client publishing refresh (scheduled or logon-triggered) in environments that use App-V; software deployment or RMM tooling that invokes the App-V sync script; administrators testing App-V publishing servers."
    tuning_guidance = "Add approved deployment or management parent processes to %global_allowed_admin_tools or %global_allowed_script_hosts. Add App-V service accounts to %global_allowed_service_accounts. In environments with App-V not deployed, consider raising severity to Critical."

  events:
    $script.metadata.event_type = "PROCESS_LAUNCH"
    $script.target.process.file.full_path = /\\(wscript|cscript)\.exe$/ nocase
    $script.target.process.command_line = /SyncAppvPublishingServer/ nocase
    not $script.principal.process.file.full_path in %global_allowed_admin_tools
    not $script.principal.process.file.full_path in %global_allowed_script_hosts
    not $script.principal.user.userid in %global_allowed_service_accounts
    $script.principal.hostname = $hostname

    $ps.metadata.event_type = "PROCESS_LAUNCH"
    $ps.principal.process.file.full_path = /\\(wscript|cscript)\.exe$/ nocase
    $ps.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
    not $ps.principal.user.userid in %global_allowed_service_accounts
    $ps.principal.hostname = $hostname

    $script.metadata.event_timestamp.seconds <= $ps.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1216.002")
    $primary_entity = array_distinct($hostname)
    $script_command_lines = array_distinct($script.target.process.command_line)
    $powershell_command_lines = array_distinct($ps.target.process.command_line)
    $users = array_distinct($script.principal.user.userid)
    $powershell_launch_count = count($ps.metadata.id)

  condition:
    $script and $ps
}
