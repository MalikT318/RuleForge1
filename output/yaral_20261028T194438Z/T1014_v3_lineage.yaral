/*
  MITRE Technique : T1014 - Rootkit
  Tactic(s)       : Stealth
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:25:53.789176+00:00
  Reference       : https://attack.mitre.org/techniques/T1014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1014_Unexpected_Parent_Spawns_Driver_Load_Or_Signing_Tamper {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office application, web server, database service or print spooler spawning a shell or utility that installs or loads a kernel/filesystem driver, or that weakens driver signature enforcement. Rootkits are typically deployed this way after initial exploitation, and these parent processes should never manage drivers."
    mitre_tactic = "Stealth"
    mitre_technique = "T1014"
    mitre_technique_name = "Rootkit"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Database or web server installers and upgraders that register drivers (for example, bundled filter drivers or backup agents); print driver installation spawned by the spooler; Office-hosted vendor add-ins that install a driver on first run; developer or QA hosts running web server processes that test driver deployments."
    tuning_guidance = "Add approved deployment or patching parent binaries to %global_allowed_admin_tools and EDR/AV updater parents to %global_allowed_security_tools. Add automation accounts that legitimately install drivers to %global_allowed_service_accounts. If a specific parent is noisy, confirm it is a legitimate installer before allowlisting it, because the parent set was chosen to be one that should never manage drivers."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|w3wp|httpd|nginx|tomcat\d*|php-cgi|sqlservr|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(sc|fltmc|bcdedit|pnputil|cmd|powershell|pwsh)\.exe$/ nocase
    $proc.target.process.command_line = /(\bsc(\.exe)?\b.*\b(create|config)\b.*\btype\s*=\s*(kernel|filesys|adapter|recognizer)|\bfltmc(\.exe)?\s+load\b|\bbcdedit(\.exe)?\b.*(testsigning|nointegritychecks|ddisable_integrity_checks)|\bpnputil(\.exe)?\b.*(\/add-driver|\/install|-a\s|-i\s))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1014")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
