/*
  MITRE Technique : T1679 - Selective Exclusion
  Tactic(s)       : Stealth
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:26:45.662768+00:00
  Reference       : https://attack.mitre.org/techniques/T1679
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1679_Unexpected_Parent_Spawns_Shell_With_Extension_Exclusion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office application, web server, print spooler or database service spawning a shell or script interpreter whose command line enumerates files and deliberately excludes executable and system file types (exe, dll, lnk, sys). This is the selective-exclusion logic used by ransomware and destructive payloads to keep the host bootable while data is encrypted or tampered with. Detection pivots on the anomalous process lineage combined with the exclusion logic."
    mitre_tactic = "Stealth"
    mitre_technique = "T1679"
    mitre_technique_name = "Selective Exclusion"
    log_prerequisites = "Requires Windows endpoint process telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web applications or database jobs that legitimately shell out to run file maintenance, backup or cleanup scripts; Office macros or add-ins used for sanctioned document processing; print or deployment workflows invoking PowerShell file enumeration; developers testing scripts under IIS or SQL Server."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts, approved tooling to %global_allowed_admin_tools, and known automation accounts to %global_allowed_service_accounts. If a specific web application or SQL Agent job is noisy, allowlist its parent process path in %global_allowed_script_hosts rather than loosening the regexes."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|onenote|visio|w3wp|httpd|nginx|tomcat\d*|php-cgi|sqlservr|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(get-childitem|\bgci\b|\bdir\b|\bls\b|forfiles|robocopy|xcopy)/ nocase
    $proc.target.process.command_line = /(-exclude|-notmatch|-notlike|-notin|\/exclude|\/xf\b|-ne\b)/ nocase
    $proc.target.process.command_line = /\.(exe|dll|lnk|sys)\b.{1,40}\.(exe|dll|lnk|sys)\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1679")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
