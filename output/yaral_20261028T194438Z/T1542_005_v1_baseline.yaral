/*
  MITRE Technique : T1542.005 - TFTP Boot
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:50:00.614102+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_005_External_TFTP_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects TFTP (UDP/69) traffic from an internal source to a non-internal destination, observed at the network perimeter. Network devices configured to netboot from an unauthorized TFTP server, or to pull a modified image, must reach that server over TFTP. Legitimate TFTP boot servers sit on internal management networks, so TFTP crossing the perimeter is a strong signal of rogue boot configuration or image tampering."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.005"
    mitre_technique_name = "Pre-OS Boot: TFTP Boot"
    log_prerequisites = "Requires firewall, proxy or perimeter flow/connection logs normalised to UDM with target.port, target.ip and network.ip_protocol populated. Perimeter must log permitted and denied UDP sessions. Pair with device configuration-change auditing (boot system / netboot commands) for full coverage."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Managed-service or vendor-hosted TFTP/firmware servers used by approved device provisioning, cloud-hosted zero-touch provisioning, legitimate off-site configuration backup over TFTP, lab or migration activity, and scanners probing UDP/69."
    tuning_guidance = "Add approved external TFTP/provisioning server addresses and approved management source addresses to %global_allowed_mgmt_sources. Add authorised scanning sources to the exclusions if probe noise appears. Where the firewall sees only internal-to-internal TFTP, add a companion rule against management-plane configuration changes. Raise severity if the source is a known network device (router/switch) address."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    $net.network.ip_protocol = "UDP"
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1542.005")
    $primary_entity = array_distinct($net.principal.ip)
    $source_hostnames = array_distinct($net.principal.hostname)
    $tftp_server_ips = array_distinct($net.target.ip)

  condition:
    $net
}
