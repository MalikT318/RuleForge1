/*
  MITRE Technique : T1554 - Compromise Host Software Binary
  Tactic(s)       : Persistence
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:10:59.386355+00:00
  Reference       : https://attack.mitre.org/techniques/T1554
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1554_Linux_System_Binary_Modified_By_NonPackage_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of a file in a system binary directory (/bin, /sbin, /usr/bin, /usr/sbin, /usr/local/bin, /usr/local/sbin, OpenSSH helper directories) by a process that is not a package manager or approved administrative tool. Trojanised SSH clients and daemons, backdoored sudo/login binaries and patched system utilities all leave this file-modification artifact, whatever command line or tool was used to produce it."
    mitre_tactic = "Persistence"
    mitre_technique = "T1554"
    mitre_technique_name = "Compromise Host Software Binary"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file watches (-w on /bin, /sbin, /usr/bin, /usr/sbin, /usr/local/bin, /usr/local/sbin with -p wa) normalised to UDM FILE_MODIFICATION with principal.process populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers and update agents not covered by the built-in name list (custom or vendor installers), configuration management and deployment tooling writing binaries, in-place software upgrades run by admins, build or CI hosts that install into /usr/local/bin, and prelink or hardening tools."
    tuning_guidance = "Add approved deployment, patching and configuration-management binaries to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and EDR or integrity-monitoring agents to %global_allowed_security_tools. Consider scoping to specific hosts if build servers are noisy."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/((usr\/)?(local\/)?s?bin\/[^\/]+|usr\/lib(exec)?\/openssh\/[^\/]+)$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|dpkg-deb|apt|apt-get|aptitude|unattended-upgrade|unattended-upgrades|rpm|yum|dnf|microdnf|zypper|packagekitd|snapd|pacman|apk|rpm-ostree|ostree|needrestart|prelink)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1554")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_binary = array_distinct($file.target.file.full_path)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
