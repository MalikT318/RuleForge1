/*
  MITRE Technique : T1176.001 - Browser Extensions
  Tactic(s)       : Persistence
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:27:39.590760+00:00
  Reference       : https://attack.mitre.org/techniques/T1176/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_001_Browser_Extension_Package_Download_Untrusted_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows-hosted browser fetching a Chromium (.crx) or Firefox (.xpi) extension package, or a Chromium extension update-style request keyed by a 32-character extension ID, from an external host that is not a known-good domain. This indicates sideloaded extensions or a manipulated extension update URL, which adversaries use for browser-based persistence. Windows is the target platform, so the Linux/macOS/cloud pivot suggested for this variant was not applied. Only network-observable behaviour is used, so no endpoint process fields are involved."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176.001"
    mitre_technique_name = "Browser Extensions"
    log_prerequisites = "Requires proxy or perimeter logs normalised to UDM NETWORK_HTTP with target.url populated. For HTTPS, TLS inspection or URL-level logging must be enabled. Without it, only plain HTTP and categorised URL logs are visible."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Enterprise-hosted or self-hosted extension distribution (internal extension update servers, force-installed line-of-business extensions), developers downloading unpacked extensions or packages for testing, security teams analysing extensions, and vendor extension CDNs not yet in the allowlist."
    tuning_guidance = "Add approved extension update and distribution domains to %global_allowed_domains. If internal destinations are logged by hostname rather than IP, add those hostnames to %global_allowed_domains too. Scope to Windows clients at the proxy or policy layer if the log source does not provide a user-agent field. Raise severity for hosts that are not developer or test systems."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(\.(crx|xpi)([?#]|$))|([?&]x=id(%3d|=)[a-p]{32})/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1176.001")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_host = array_distinct($http.target.hostname)
    $requested_url = array_distinct($http.target.url)

  condition:
    $http
}
