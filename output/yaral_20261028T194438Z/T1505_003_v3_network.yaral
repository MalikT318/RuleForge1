/*
  MITRE Technique : T1505.003 - Web Shell
  Tactic(s)       : Persistence
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:30:00.387448+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_003_External_POST_To_Script_In_Static_Content_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a successful HTTP POST from an external client to a server-side script (php, jsp, aspx, etc.) located in a directory normally reserved for static or user-uploaded content (uploads, images, media, tmp, cache). Legitimate applications rarely execute dynamic scripts from these paths, but web shells dropped via upload flaws are typically controlled this way. Observed from the network side at the perimeter, independent of endpoint coverage."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.003"
    mitre_technique_name = "Server Software Component: Web Shell"
    log_prerequisites = "Requires firewall, proxy or web gateway logs normalised to NETWORK_HTTP with URL, HTTP method and response code populated (SSL inspection or reverse proxy / WAF visibility needed for HTTPS)."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "CMS or e-commerce plugins that legitimately execute scripts from upload or cache directories, image-resizing or thumbnail handlers, legacy applications serving dynamic content from media folders, authorised penetration tests and external vulnerability scanners."
    tuning_guidance = "Add authorised scanner and pen-test source addresses to %global_allowed_scanners. Add known application or CDN source addresses to %global_allowed_admin_tools or extend the URL regex exclusion for confirmed legitimate plugin paths. Consider raising severity for destinations that are internet-facing servers with no legitimate script execution in these directories."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.network.http.response_code >= 200
    $http.network.http.response_code <= 299
    $http.target.url = /\/(uploads?|images?|img|media|static|assets|files|tmp|temp|cache|fonts|css|js)\/[^?#\s]*\.(php[0-9]?|phtml|jspx?|aspx?|ashx|asmx|cfm|cgi)([?#]|$)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1505.003")
    $primary_entity = array_distinct($http.target.ip)
    $source_ips = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
