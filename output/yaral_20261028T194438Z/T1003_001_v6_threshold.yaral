/*
  MITRE Technique : T1003.001 - LSASS Memory
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:38:29.132936+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_001_LSASS_Repeated_Process_Access_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated handle-open (process access) events targeting the LSASS process on a single host within 10 minutes from processes that are not approved security, backup or admin tooling. A single handle to LSASS is common and benign; repeated access attempts indicate credential dumping, memory scraping or tool retries with varying access masks."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.001"
    mitre_technique_name = "OS Credential Dumping: LSASS Memory"
    log_prerequisites = "Requires EDR or Sysmon-equivalent process-access telemetry (Sysmon Event ID 10 or EDR handle-open events) normalised to PROCESS_OPEN with populated principal and target process paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Unlisted EDR/AV or DLP agents, backup and imaging agents, RMM and inventory tooling, performance and monitoring agents, Task Manager or Resource Monitor used by admins, credential-provider or SSO software that queries LSASS."
    tuning_guidance = "Add approved security agent binaries to %global_allowed_security_tools, backup agents to %global_allowed_backup_processes, and IT tooling to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Raise the #proc threshold on noisy hosts such as domain controllers or terminal servers; lower it for high-value servers."

  events:
    $proc.metadata.event_type = "PROCESS_OPEN"
    $proc.target.process.file.full_path = /\\lsass\.exe$/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path = /\\(lsass|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(75)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1003.001")
    $primary_entity = array_distinct($host)
    $accessing_processes = array_distinct($proc.principal.process.file.full_path)
    $accessing_users = array_distinct($proc.principal.user.userid)

  condition:
    #proc >= 5
}
