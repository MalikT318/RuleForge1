/*
  MITRE Technique : T1499.002 - Service Exhaustion Flood
  Tactic(s)       : Impact
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:19:08.772495+00:00
  Reference       : https://attack.mitre.org/techniques/T1499/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1499_002_Inbound_Volumetric_Service_Flood_Flow {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a single perimeter flow record in which an external source pushes an abnormally large volume of data to an internal web or DNS service port within a very short session. This is the volumetric signature of an HTTP/DNS service exhaustion flood, seen from the network side. Because it is a single-event rule it catches high-rate flows that the firewall summarises into one record. Low-and-slow floods spread across many records need a separate threshold rule."
    mitre_tactic = "Impact"
    mitre_technique = "T1499.002"
    mitre_technique_name = "Endpoint Denial of Service: Service Exhaustion Flood"
    log_prerequisites = "Firewall, proxy or perimeter flow logs normalised to UDM NETWORK_FLOW with network.sent_bytes and network.session_duration populated, and external source IPs preserved (no NAT masking of the client address). Protected servers are Linux hosts running web or DNS services."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "CDN or reverse-proxy origin pulls, large authorised file uploads to web services, offsite backup or replication into internal web endpoints, partner bulk data feeds, load or penetration tests not on the scanner allowlist."
    tuning_guidance = "Adjust the sent_bytes and session_duration thresholds to the customer's baseline (the defaults are 250 MB in 60 seconds or less). Add known partner, load-testing and scanner sources to %global_allowed_scanners. Add approved management or proxy source addresses to %global_allowed_mgmt_sources. Extend the port list for non-standard service ports. If the firewall does not populate session_duration, remove that condition and raise the byte threshold."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    (
      $net.target.port = 80 or
      $net.target.port = 443 or
      $net.target.port = 8080 or
      $net.target.port = 8443 or
      $net.target.port = 53
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources
    $net.network.sent_bytes >= 250000000
    $net.network.session_duration.seconds <= 60

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1499.002")
    $primary_entity = array_distinct($net.target.ip)
    $attacker_ips = array_distinct($net.principal.ip)
    $targeted_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
