/*
  MITRE Technique : T1218.015 - Electron Applications
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:02:24.459526+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_015_Linux_Electron_ASAR_Tamper_Then_Shell_Child {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An Electron application's resource bundle (app.asar or unpacked app JavaScript under a resources/ directory) is modified by a process that is not a package manager. Within 10 minutes a binary running from an application install location then spawns a shell, interpreter or download utility on the same host. This sequence indicates planted JavaScript in an Electron app, or abuse of the app as a trusted proxy for command execution."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.015"
    mitre_technique_name = "System Binary Proxy Execution: Electron Applications"
    log_prerequisites = "Requires Linux EDR or auditd with file modification telemetry (FILE_MODIFICATION with target.file.full_path populated) and process launch telemetry with parent process paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Electron apps with built-in updaters that rewrite app.asar and then run helper scripts; developers rebuilding or debugging Electron apps locally; AppImage or manual installs by administrators; applications that legitimately launch shell helpers (for example a code editor opening a terminal) after an update."
    tuning_guidance = "Add approved updater or deployment tooling paths to %global_allowed_admin_tools (file-writer side). Add approved parent applications to %global_allowed_script_hosts (spawn side). Extend the package-manager exclusion regex if the client uses other installers. Narrow the parent install-location regex if the client keeps Electron apps in a standard directory."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\/resources\/(app\.asar|app\/.+\.js)$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|rpm|dnf|yum|zypper|pacman|snapd|packagekitd|flatpak|unattended-upgr)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /^\/(opt|usr\/lib|usr\/lib64|usr\/share|snap\/[^\/]+\/[^\/]+|var\/lib\/flatpak\/app)\/.+/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|python3?|perl|curl|wget|nc|ncat)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1218.015")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_files = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $electron_parent = array_distinct($proc.principal.process.file.full_path)
    $spawned_children = array_distinct($proc.target.process.file.full_path)
    $event_count = count($proc.metadata.id)

  condition:
    $file and $proc
}
