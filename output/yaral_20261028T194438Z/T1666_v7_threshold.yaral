/*
  MITRE Technique : T1666 - Modify Cloud Resource Hierarchy
  Tactic(s)       : Defense Impairment
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:07:55.069608+00:00
  Reference       : https://attack.mitre.org/techniques/T1666
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1666_Cloud_Hierarchy_Modification_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single identity issues several cloud resource-hierarchy modification API calls within ten minutes. These include leaving or detaching an account from an organization, moving accounts, projects or subscriptions between parents, and creating, deleting or renaming organizational units, folders or management groups. Each call can be routine, but a burst from one principal suggests an adversary restructuring the hierarchy to escape inherited guardrails, logging and policy controls, or to hide resources in a new or detached container."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1666"
    mitre_technique_name = "Modify Cloud Resource Hierarchy"
    log_prerequisites = "Cloud control-plane audit logs (organization/management-plane events, management-group and subscription activity, folder and project administration events) must be ingested and normalised to UDM with principal.user.userid and metadata.product_event_type populated. Organization-level or management-plane trails must be enabled and forwarded."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Planned landing-zone or account vending automation, organization restructuring or migration projects, mergers and acquisitions onboarding, cloud governance or infrastructure-as-code pipelines creating many organizational units or folders, and sandbox account lifecycle tooling."
    tuning_guidance = "Add approved automation identities to %global_allowed_service_accounts, %global_allowed_cloud_principals or %global_allowed_admin_users. Raise the #cloud threshold for tenants with frequent account vending. The product_event_type regex can be extended with provider-specific hierarchy operations. If a client's parser maps these operations to a different event type, change metadata.event_type to match, keeping it to one type."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /(LeaveOrganization|RemoveAccountFromOrganization|MoveAccount|CreateOrganizationalUnit|DeleteOrganizationalUnit|UpdateOrganizationalUnit|CreateAccount|CloseAccount|InviteAccountToOrganization|managementGroups\/(write|delete|subscriptions)|Microsoft\.Subscription\/(aliases|cancel|rename|enable|changeDirectory)|MoveProject|MoveFolder|projects\.move|folders\.(move|create|delete|update)|UpdateFolder|DeleteFolder|CreateFolder)/ nocase
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(if($cloud.metadata.product_event_type = /(?i)(LeaveOrganization|RemoveAccountFromOrganization|changeDirectory)/, 90, 70))
    $mitre_technique_id = array_distinct("T1666")
    $primary_entity = array_distinct($user)
    $event_count = count($cloud.metadata.id)
    $api_calls = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)
    $target_resources = array_distinct($cloud.target.resource.name)

  condition:
    #cloud >= 3
}
