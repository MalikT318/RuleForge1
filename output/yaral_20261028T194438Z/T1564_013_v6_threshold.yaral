/*
  MITRE Technique : T1564.013 - Bind Mounts
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:34:29.909531+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_013_Repeated_Proc_Bind_Mounts_Per_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects several bind mounts over numeric /proc/<pid> directories on a single Linux host within ten minutes. A single bind mount can be benign, but repeated mounts onto process directories suggest an adversary masking multiple malicious processes from ps, top and other /proc readers."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.013"
    mitre_technique_name = "Hide Artifacts: Bind Mounts"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records normalised to UDM PROCESS_LAUNCH, with command lines populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Container runtimes and orchestration agents preparing sandboxes, chroot or build tooling, hardening scripts that remount /proc with hidepid, and admin troubleshooting or forensics tooling."
    tuning_guidance = "Add approved container, orchestration and configuration-management binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Raise the #proc threshold on container-heavy hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/mount$/ nocase
    $proc.target.process.command_line = /(\s-[a-zA-Z]*B\b|\s--r?bind\b|\s-o\s*\S*\br?bind\b)/ nocase
    $proc.target.process.command_line = /\/proc\/[0-9]+/
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(80)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1564.013")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $mount_commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
