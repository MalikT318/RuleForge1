/*
  MITRE Technique : T1218.001 - Compiled HTML File
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:42:50.508094+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_001_HTML_Help_Host_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the HTML Help host (hh.exe) making an outbound network connection to an external address. Legitimate CHM viewing is a local operation. External connections indicate a CHM or hh.exe URL argument pulling remote content, a remote payload, or a callback from embedded script/ActiveX. This rule uses network telemetry rather than process command-line matching, so it complements existing PROCESS_LAUNCH detections. CHM abuse is Windows-specific, so there is no Linux, macOS or cloud equivalent and this rule targets Windows only."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.001"
    mitre_technique_name = "System Binary Proxy Execution: Compiled HTML File"
    log_prerequisites = "Requires Windows endpoint network telemetry with process attribution (EDR network events or Sysmon Event ID 3) normalised to NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy applications whose online help is delivered through hh.exe and fetches content from vendor sites; users opening CHM files from UNC or WebDAV shares that resolve to external addresses; software vendors' help systems calling home for updated content."
    tuning_guidance = "Add known-good vendor help domains to %global_allowed_domains. Internal destinations are already excluded via %rfc1918_internal. If a specific business application legitimately uses hh.exe for online help, review the destination and add its domain to the allowlist rather than suppressing the rule."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\hh\.exe$/ nocase
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1218.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ports = array_distinct($net.target.port)
    $affected_users = array_distinct($net.principal.user.userid)
    $hh_command_line = array_distinct($net.principal.process.command_line)

  condition:
    $net
}
