/*
  MITRE Technique : T1559.001 - Component Object Model
  Tactic(s)       : Execution
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:51:37.212135+00:00
  Reference       : https://attack.mitre.org/techniques/T1559/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_001_PowerShell_COM_Object_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a PowerShell process whose command line instantiates a COM object (ComObject, ProgID/CLSID lookup, Activator, GetActiveObject) and also invokes a COM method that executes code or commands (ExecuteShellCommand, ShellExecute, DDEInitiate, ExecuteExcel4Macro, RegisterXLL, Exec, Run, or the MMC20/ShellWindows/ShellBrowserWindow objects). This is the core local COM execution behavior used for code execution, fileless execution and proxy execution through trusted COM servers."
    mitre_tactic = "Execution"
    mitre_technique = "T1559.001"
    mitre_technique_name = "Inter-Process Communication: Component Object Model"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command line capture (EDR, Sysmon Event ID 1, or Windows Security 4688 with command line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin and logon scripts that automate Office or the Windows shell through COM, software packaging and deployment scripts, RMM health checks, and developers automating Excel or Word. WScript.Shell Run and Shell.Application ShellExecute used inline by IT automation are the most common sources."
    tuning_guidance = "Add approved parent processes or hosts to %global_allowed_script_hosts, approved deployment and RMM binaries to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. If noise persists in a client, add the specific parent process of the recurring benign script to %global_allowed_script_hosts instead of loosening the regexes."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh)(_ise)?\.exe$/ nocase
    $proc.target.process.command_line = /(-comobject|gettypefromprogid|gettypefromclsid|\[activator\]::createinstance|getactiveobject)/ nocase
    $proc.target.process.command_line = /(executeshellcommand|shellexecute|ddeinitiate|executeexcel4macro|registerxll|\.document\.application|mmc20\.application|shellbrowserwindow|shellwindows|\.exec\s*\(|\.run\s*\()/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1559.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
