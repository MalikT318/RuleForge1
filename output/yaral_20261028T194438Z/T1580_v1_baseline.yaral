/*
  MITRE Technique : T1580 - Cloud Infrastructure Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:57:33.001825+00:00
  Reference       : https://attack.mitre.org/techniques/T1580
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1580_Cloud_Infrastructure_Discovery_API {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects control-plane API calls that enumerate compute instances, snapshots, volumes, databases or storage buckets (for example DescribeInstances, ListBuckets, HeadBucket, GetPublicAccessBlock, compute instances list, virtual machine read) made by an identity that is not an approved automation, scanner or administrator. These calls are the core mechanism of cloud infrastructure discovery and commonly follow credential theft."
    mitre_tactic = "Discovery"
    mitre_technique = "T1580"
    mitre_technique_name = "Cloud Infrastructure Discovery"
    log_prerequisites = "Cloud control-plane audit logs ingested and normalised to UDM USER_RESOURCE_ACCESS, with the API operation name in metadata.product_event_type and the caller in principal.user.userid and principal.ip. Read-only management events must be enabled, as they are often off by default."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Cloud posture and asset inventory tooling, FinOps and cost tools, infrastructure-as-code pipelines running plan or refresh, backup orchestration, CMDB sync jobs, administrators browsing the console, and new engineers exploring an account."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, named administrators to %global_allowed_admin_users, and authorised scanner or posture-tool source addresses to %global_allowed_scanners. Raise severity for identities that have never made these calls before, or pair this rule with a threshold or sequence rule to detect breadth of enumeration."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /^(DescribeInstances|DescribeInstanceStatus|DescribeSnapshots|DescribeVolumes|DescribeDBInstances|DescribeDBSnapshots|ListBuckets|HeadBucket|GetPublicAccessBlock|GetBucketPolicyStatus)$|^(compute\.(instances|snapshots|disks)\.(list|aggregatedlist)|storage\.buckets\.list)$|^microsoft\.compute\/(virtualmachines|snapshots|disks)\/read$/ nocase
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.ip in %global_allowed_scanners
    not $cloud.principal.ip in %rfc1918_internal

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1580")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_operations = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
