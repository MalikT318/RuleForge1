/*
  MITRE Technique : T1614 - System Location Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:36:56.222048+00:00
  Reference       : https://attack.mitre.org/techniques/T1614
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1614_Geolocation_Lookup_Scripted_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal Windows host making an outbound HTTP request to an external geolocation or IP-lookup style URL using a non-browser, scripting or library HTTP client. Malware commonly does this to infer the victim's country and decide whether to proceed (T1614). The rule uses only proxy and firewall HTTP telemetry: URL structure and client type, with no endpoint process fields and no specific lookup domains."
    mitre_tactic = "Discovery"
    mitre_technique = "T1614"
    mitre_technique_name = "System Location Discovery"
    log_prerequisites = "Requires firewall or proxy logs with HTTP inspection (URL and user-agent populated), for example TLS-inspecting perimeter or explicit proxy logs. Plain connection logs without URL or user-agent will not trigger this rule."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate software and scripts that geolocate for licensing, localisation, or compliance; IT inventory and RMM scripts that record public IP or site; developer and DevOps automation calling location APIs; SaaS agents that check the egress region."
    tuning_guidance = "Add known-good lookup or vendor domains to %global_allowed_domains. Add approved inventory or testing hosts to %global_allowed_scanners. Add known automation source addresses to %global_allowed_mgmt_sources. If the client estate has noisy developer subnets, scope them out via the allowlists, or raise severity only when this fires on servers."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /(?i)(geo[-_.]?(ip|locat|lookup|plugin|api|js)|ip[-_.]?(api|info|locat|geo|lookup|whois)|ip2(loc|country)|(my|what(is|s)(my)?)[-_.]?ip|country[-_]?code|get[-_]?(my[-_]?)?(ip|location|country))/
    $net.network.http.user_agent = /(?i)(powershell|winhttp|curl|wget|python|go-http-client|java\/|libwww|okhttp|urlmon|microsoft bits|^$)/
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1614")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
