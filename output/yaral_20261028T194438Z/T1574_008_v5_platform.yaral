/*
  MITRE Technique : T1574.008 - Path Interception by Search Order Hijacking
  Tactic(s)       : Stealth, Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:36:52.902243+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_008_System_Binary_Name_Dropped_Outside_System_Directories {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of an executable named after a commonly invoked Windows system utility (net, cmd, reg, sc, wmic, etc.) outside the trusted Windows system directories. Programs that call these utilities without a full path search their own directory first, so a planted look-alike executable is run in place of the real one. This rule uses file-creation telemetry (the planting step) and so complements process-launch and command-line detections."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.008"
    mitre_technique_name = "Hijack Execution Flow: Path Interception by Search Order Hijacking"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) that populates principal.process.file.full_path and target.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Portable developer toolchains and runtimes that bundle or copy cmd.exe or powershell.exe, software installers and updaters staging OS utilities, OS servicing or in-place upgrade staging directories, IT packaging and imaging workflows, and sandbox or build agents."
    tuning_guidance = "Add approved installers, packaging tools and deployment agents to %global_allowed_admin_tools. Add EDR and AV agents to %global_allowed_security_tools. Add approved build or script hosts to %global_allowed_script_hosts. If a client has a legitimate portable-tool directory, exclude the creating process by executable name rather than by path."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(net|net1|cmd|powershell|pwsh|wmic|reg|sc|schtasks|tasklist|taskkill|whoami|ipconfig|systeminfo|nslookup|netsh|ping|certutil|bitsadmin|rundll32|regsvr32|mshta|cscript|wscript|msiexec|find|findstr|attrib|icacls|vssadmin)\.exe$/ nocase
    not $file.target.file.full_path = /\\windows\\(system32|syswow64|sysnative|winsxs|servicing|softwaredistribution|microsoft\.net)\\/ nocase
    not $file.target.file.full_path = /(\\windows\.old\\|\\\$windows\.~(bt|ws)\\)/ nocase
    not $file.principal.process.file.full_path = /\\(TiWorker|TrustedInstaller|wuauclt|MoUsoCoreWorker|usoclient|MpCmdRun|MsMpEng|SenseIR)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1574.008")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $creating_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
