/*
  MITRE Technique : T1102.003 - One-Way Communication
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:58:26.661728+00:00
  Reference       : https://attack.mitre.org/techniques/T1102/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1102_003_Script_Host_Fetches_Remote_Text_Content {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "A Windows script host or interpreter (PowerShell, WScript, CScript, MSHTA) issues an HTTP GET to an external host for raw, paste or snippet style text content. This is a one-way dead-drop pattern: the implant pulls instructions from a legitimate web service and returns no output over that channel. Detection is on the network event, not process creation, so it complements command-line rules."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1102.003"
    mitre_technique_name = "Web Service: One-Way Communication"
    log_prerequisites = "Requires endpoint network telemetry that populates the originating process path, HTTP method and URL (EDR network events, Sysmon-equivalent with HTTP enrichment, or proxy logs joined to process context)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrative PowerShell scripts that download configuration or text files, package managers and module installers fetching raw content from code-hosting services, software deployment scripts, and developer workstations."
    tuning_guidance = "Add known-good external hosting domains to %global_allowed_domains. Add approved automation hosts or parent tooling to %global_allowed_script_hosts and approved deployment binaries to %global_allowed_admin_tools. Tighten or extend the URL path pattern per client if their proxy normalises URLs differently."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $net.network.http.method = "GET" nocase
    $net.target.url = /\/(raw|pastes?|snippets?)(\/|\?|$)/ nocase
    $net.target.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1102.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $remote_host = array_distinct($net.target.hostname)
    $requested_url = array_distinct($net.target.url)

  condition:
    $net
}
