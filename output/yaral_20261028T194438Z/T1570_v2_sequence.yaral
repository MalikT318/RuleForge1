/*
  MITRE Technique : T1570 - Lateral Tool Transfer
  Tactic(s)       : Lateral Movement
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:15:02.602403+00:00
  Reference       : https://attack.mitre.org/techniques/T1570
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1570_ESXi_SSH_Login_Then_Staged_File_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an SSH login to an ESXi host followed within ten minutes by creation of a script, binary or shared object in a world-writable staging location (/tmp, /var/tmp, /dev/shm, /scratch) or at the top level of a datastore volume. This pattern indicates a tool pushed to the hypervisor over scp/sftp or an interactive session for lateral movement. It is based on authentication and file-creation telemetry, not command-line matching, so it complements existing process-launch rules."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1570"
    mitre_technique_name = "Lateral Tool Transfer"
    log_prerequisites = "Requires ESXi authentication logs (SSH login events normalised to USER_LOGIN with network.application_protocol populated as SSH) and file-creation telemetry on the hypervisor (for example a host file-integrity or audit source forwarded as FILE_CREATION). Hostname must be populated consistently on both event types."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators uploading patch or driver bundles, support scripts or VIB staging files by scp; backup, monitoring and lifecycle automation that logs in over SSH and writes helper scripts; vendor support sessions."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Add approved management or patching binaries to %global_allowed_admin_tools. If the file source does not populate principal.process, remove the process exclusion. Narrow the path regex to match local staging conventions."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.network.application_protocol = "SSH"
    $login.principal.hostname = $host
    not $login.target.user.userid in %global_allowed_admin_users
    not $login.target.user.userid in %global_allowed_service_accounts

    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|scratch(\/[^\/]+)?)\/[^\/]+\.(sh|py|pl|elf|bin|so)$|^\/vmfs\/volumes\/[^\/]+\/[^\/]+\.(sh|py|pl|elf|bin)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    $login.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1570")
    $primary_entity = array_distinct($host)
    $login_users = array_distinct($login.target.user.userid)
    $source_ips = array_distinct($login.principal.ip)
    $created_files = array_distinct($file.target.file.full_path)
    $file_count = count($file.metadata.id)

  condition:
    $login and $file
}
