/*
  MITRE Technique : T1027.005 - Indicator Removal from Tools
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:46:18.429971+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_005_Rapid_Executable_Rebuild_In_Writable_Paths {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single host sees a burst of executable or library file creations (exe, dll, scr, com) in user-writable staging locations by the same non-allowlisted processes within ten minutes. One drop is benign, but repeated rebuild-and-redrop cycles match an adversary altering a tool to evade signature detection after it was quarantined (T1027.005). The rule uses file-creation telemetry rather than command-line matching, so it still fires if the tooling or filenames change."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.005"
    mitre_technique_name = "Obfuscated Files or Information: Indicator Removal from Tools"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with the principal process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters, developer build and compile workflows, CI agents on build hosts, browser or package-manager downloads of installers, patching and RMM deployment tools, and legitimate self-extracting archives."
    tuning_guidance = "Add approved deployment, patching and build tooling to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Add automation accounts to %global_allowed_service_accounts. Raise the #file threshold on developer or build hosts. Adjust the path regex to match local staging conventions."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\[^\\]+\\appdata\\(local|roaming)\\temp|users\\[^\\]+\\appdata\\local|users\\public|programdata|windows\\temp)\\.*\.(exe|dll|scr|com)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path = /\\(msiexec|trustedinstaller|tiworker|msmpeng|svchost|wuauclt|musnotification|usoclient)\.exe$/ nocase

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($file.target.file.full_path = /\.(scr|com)$/ nocase, 75, 60))
    $mitre_technique_id = array_distinct("T1027.005")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $created_files = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 6
}
