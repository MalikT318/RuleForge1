/*
  MITRE Technique : T1679 - Selective Exclusion
  Tactic(s)       : Stealth
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:27:12.069601+00:00
  Reference       : https://attack.mitre.org/techniques/T1679
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1679_Ransomware_Extension_Exclusion_Arguments {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process launched with an explicit exclusion or skip argument listing multiple system file types (dll, exe, lnk, sys, msi) alongside target, path or encryption-mode arguments. This is the command-line pattern of ransomware and destructive payloads configured to leave system components untouched so the host stays operational. The rule is written for Windows, as required for this log source and platform."
    mitre_tactic = "Stealth"
    mitre_technique = "T1679"
    mitre_technique_name = "Selective Exclusion"
    log_prerequisites = "Requires EDR or Sysmon process telemetry with full command lines, or Windows Security Event 4688 with command-line auditing enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup, archiving, or file-sync utilities with skip-extension options; software packaging or deployment scripts; antivirus or DLP scan jobs configured with extension skip lists; developer build tooling."
    tuning_guidance = "Add approved admin and deployment binaries to %global_allowed_admin_tools, backup and imaging software to %global_allowed_backup_processes, and approved script host parents to %global_allowed_script_hosts. If a client has an unusual legitimate tool that triggers the rule, exclude it by executable name, not by install path."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /\s(--?|\/)(exclude|skip|ignore|except|exempt|whitelist|avoid)[a-z_-]*[\s=:]+.{0,100}\.(dll|exe|lnk|sys|msi)\b.{0,50}\.(dll|exe|lnk|sys|msi)\b/ nocase
    $proc.target.process.command_line = /\s(--?|\/)(path|dir|folder|target|drive|enc[a-z]*|crypt[a-z]*|mode|lock[a-z]*|share|network)\b/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1679")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $process_path = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
