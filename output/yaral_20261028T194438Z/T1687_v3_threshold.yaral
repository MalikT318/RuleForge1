/*
  MITRE Technique : T1687 - Exploitation for Defense Impairment
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:34:39.214472+00:00
  Reference       : https://attack.mitre.org/techniques/T1687
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1687_Security_Admin_Group_Burst_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Identity-plane proxy for T1687. A single actor modifies membership of several security-tooling administration groups (endpoint protection, EDR, firewall, SIEM) within ten minutes. This pattern can follow exploitation of a directory or identity flaw that grants control over defensive tooling. It cannot observe exploitation of the security software itself."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1687"
    mitre_technique_name = "Exploitation for Defense Impairment"
    log_prerequisites = "Requires directory audit logs normalized to GROUP_MODIFICATION with principal.user.userid and target.group.group_display_name populated (for example AD security group change events 4728/4732/4756 or an equivalent identity provider directory audit feed)."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Planned onboarding or offboarding of SOC or security engineering staff, access reviews, identity governance automation, and bulk group clean-up projects."
    tuning_guidance = "Add approved identity administrators to %global_allowed_admin_users and automation or provisioning accounts to %global_allowed_service_accounts. The group-name regex is generic; extend or narrow it per client naming convention. Raise the #grp threshold for tenants with heavy governance automation."

  events:
    $grp.metadata.event_type = "GROUP_MODIFICATION"
    $grp.target.group.group_display_name = /(security|defender|endpoint|edr|firewall|siem|antivirus).*(admin|operator|manager|policy|console|owner)/ nocase
    $grp.principal.user.userid = $user
    not $grp.principal.user.userid in %global_allowed_admin_users
    not $grp.principal.user.userid in %global_allowed_service_accounts

  match:
    $user over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($grp.metadata.id)
    $mitre_technique_id = array_distinct("T1687")
    $primary_entity = array_distinct($user)
    $modified_groups = array_distinct($grp.target.group.group_display_name)
    $affected_users = array_distinct($grp.target.user.userid)

  condition:
    #grp >= 3
}
