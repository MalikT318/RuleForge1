/*
  MITRE Technique : T1546.005 - Trap
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:07:20.771189+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_005_Linux_Staged_Payload_Then_Shell_Trap_Persistence_File {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a file created in a world-writable staging directory (/tmp, /var/tmp, /dev/shm) followed within ten minutes by modification of a shell startup or logout file on the same host. Shell init and logout files (.bashrc, .profile, .bash_logout, /etc/profile.d) are where trap-based persistence is planted, so a trap handler can launch the staged payload on shell start, exit or signal. The rule uses file telemetry only, so it does not duplicate command-line rules for the trap builtin."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.005"
    mitre_technique_name = "Event Triggered Execution: Trap"
    log_prerequisites = "Requires Linux EDR or auditd file telemetry (FILE_CREATION and FILE_MODIFICATION) with principal.hostname and target.file.full_path populated, including watches on user home directories and /etc/profile*."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Users or admins editing their own .bashrc or .profile while installers or build tools write temp files; configuration management (Ansible, Puppet, Chef) rewriting profile files; package installers that create temp files and update /etc/profile.d; developer environment managers (nvm, pyenv, conda) that update shell rc files after downloading to /tmp."
    tuning_guidance = "Add approved configuration management and deployment binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Tighten the rc-file regex or the staging directory regex to match the client's environment and audit coverage."

  events:
    $stage.metadata.event_type = "FILE_CREATION"
    $stage.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/./ nocase
    not $stage.principal.process.file.full_path in %global_allowed_admin_tools
    not $stage.principal.user.userid in %global_allowed_service_accounts
    $stage.principal.hostname = $hostname

    $rc.metadata.event_type = "FILE_MODIFICATION"
    $rc.target.file.full_path = /(\/\.(bashrc|bash_profile|bash_login|profile|bash_logout|zshrc|zprofile|zlogin|zlogout)$|^\/etc\/(profile|bash\.bashrc|bashrc|bash\.bash_logout|zsh\/zshrc|zsh\/zshenv)$|^\/etc\/profile\.d\/[^\/]+\.sh$)/ nocase
    not $rc.principal.process.file.full_path in %global_allowed_admin_tools
    not $rc.principal.user.userid in %global_allowed_service_accounts
    $rc.principal.hostname = $hostname

    $stage.metadata.event_timestamp.seconds <= $rc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546.005")
    $primary_entity = array_distinct($hostname)
    $staged_files = array_distinct($stage.target.file.full_path)
    $modified_shell_files = array_distinct($rc.target.file.full_path)
    $modifying_processes = array_distinct($rc.principal.process.file.full_path)
    $modifying_users = array_distinct($rc.principal.user.userid)
    $stage_event_count = count($stage.metadata.id)

  condition:
    $stage and $rc
}
