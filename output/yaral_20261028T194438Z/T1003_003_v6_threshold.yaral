/*
  MITRE Technique : T1003.003 - NTDS
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:42:10.941090+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_003_NTDS_Artifact_Staging_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects multiple creation events for Active Directory database artifacts (ntds.dit, ESE edb log/checkpoint files, or registry hive exports in a 'registry' folder) outside the native Windows NTDS directory on a single host within 10 minutes. This is the file-system footprint of IFM/ntdsutil exports, shadow-copy extraction and offline AD database copying. A single such file can be benign, but several together indicate credential database staging."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.003"
    mitre_technique_name = "OS Credential Dumping: NTDS"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with target.file.full_path and principal.process populated, ideally from domain controllers and any server where AD backups are restored."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Authorised AD backup and restore operations, DC promotion (IFM media creation by administrators), AD disaster-recovery testing, and backup agents copying the AD database to staging locations."
    tuning_guidance = "Add approved backup software to %global_allowed_backup_processes and approved admin or DC-build tooling to %global_allowed_admin_tools. Raise the #file threshold on hosts used for DR testing. Add service accounts that run scheduled AD exports to %global_allowed_service_accounts."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(ntds\.dit|edb[0-9a-f]*\.(chk|log|jrs)|registry\\(system|security|sam))$/ nocase
    not $file.target.file.full_path = /\\windows\\ntds\\/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(80)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1003.003")
    $primary_entity = array_distinct($host)
    $staged_files = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
