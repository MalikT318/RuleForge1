/*
  MITRE Technique : T1216.002 - SyncAppvPublishingServer
  Tactic(s)       : Stealth
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:36:07.986889+00:00
  Reference       : https://attack.mitre.org/techniques/T1216/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1216_002_SyncAppvPublishingServer_Script_Staged_File {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a SyncAppvPublishingServer.vbs file by a process other than a Windows servicing or approved management process. The script is normally delivered only by Windows servicing. A copy dropped to a user-writable or staging location, or a re-written copy in the system directory, suggests staging for PowerShell proxy execution through the signed App-V script. Detection is on the file-artifact layer, so it holds even when command-line logging is evaded or obfuscated."
    mitre_tactic = "Stealth"
    mitre_technique = "T1216.002"
    mitre_technique_name = "System Script Proxy Execution: SyncAppvPublishingServer"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating target.file.full_path and the writing process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows servicing (cumulative updates, feature upgrades, DISM or SFC repair), image-building or golden-image tooling, backup or restore software recreating system files, and legitimate App-V client deployment or repair by IT software distribution tooling."
    tuning_guidance = "Add approved deployment, imaging or patching binaries to %global_allowed_admin_tools. Add EDR or AV agents that touch system files to %global_allowed_security_tools. Add backup or restore agents to %global_allowed_backup_processes. If servicing processes specific to the client's patching stack create noise, add them via these lists rather than editing the regex. Pair with a FILE_MODIFICATION variant if the client's telemetry reports overwrites as modifications."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\syncappvpublishingserver\.vbs$/ nocase
    not $file.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|poqexec|SetupHost|SetupPlatform|MoUsoCoreWorker|wuauclt|musNotification|msiexec)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1216.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
