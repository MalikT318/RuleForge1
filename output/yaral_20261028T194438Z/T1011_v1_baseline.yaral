/*
  MITRE Technique : T1011 - Exfiltration Over Other Network Medium
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:19:29.914165+00:00
  Reference       : https://attack.mitre.org/techniques/T1011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1011_Large_Outbound_Transfer_NonStandard_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a single large outbound flow from an internal source to an external address on a port other than standard web or DNS ports. This is the network-observable signature of bulk data leaving over a secondary egress path (tethered or cellular modem, alternate uplink, unmanaged gateway), which is the closest perimeter-visible proxy for T1011. A perimeter log cannot see the physical medium, so this rule detects the volume and destination pattern, not the medium itself."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1011"
    mitre_technique_name = "Exfiltration Over Other Network Medium"
    log_prerequisites = "Requires firewall, proxy or perimeter flow logs normalised to UDM NETWORK_FLOW with network.sent_bytes, principal.hostname or principal.ip, target.ip and target.port populated. Linux servers must be identifiable by source segment or asset inventory because the perimeter log carries no OS or process context."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Off-site backup and replication jobs on custom ports, database or object-store replication, software mirror syncs, large uploads to partner SFTP or FTPS endpoints, and vulnerability scanning or penetration testing sources."
    tuning_guidance = "Add known-good external destinations to %global_allowed_domains. Raise or lower the sent_bytes threshold (default 100 MB) per client baseline. Extend the excluded port list with approved custom service ports. Scope the rule to Linux server segments in the client deployment, because the firewall log has no OS context."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    $net.network.sent_bytes > 104857600
    $net.target.port != 443
    $net.target.port != 80
    $net.target.port != 53
    $net.target.port != 8080
    $net.target.port != 8443
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1011")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
