/*
  MITRE Technique : T1021.008 - Direct Cloud VM Connections
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:45:52.526199+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_008_Cloud_Serial_Console_Access_Enabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change that enables interactive serial console access to cloud virtual machines at the account, subscription or project level. Enabling this direct, out-of-band VM connection path is a common precursor to T1021.008 lateral movement. It bypasses network controls such as security groups and bastion hosts, and often grants root or SYSTEM-level console access. The rule detects the control-plane setting change rather than any command line, so it is not evaded by command-line obfuscation."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.008"
    mitre_technique_name = "Remote Services: Direct Cloud VM Connections"
    log_prerequisites = "Cloud control-plane audit logs (management or admin activity events) ingested and normalised to UDM SETTING_MODIFICATION with metadata.product_event_type populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Platform or cloud engineering teams enabling the serial console for break-glass troubleshooting; infrastructure-as-code pipelines applying account baseline settings; initial landing-zone or subscription provisioning; approved incident-response activity."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users. Add IaC and automation identities to %global_allowed_cloud_principals. Add pipeline service accounts to %global_allowed_service_accounts. If the serial console is disabled by policy in the client environment, raise severity to Critical."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /(EnableSerialConsoleAccess|SerialConsole.*(enable|default)|enableConsole)/ nocase
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1021.008")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $source_ips = array_distinct($cloud.principal.ip)
    $api_actions = array_distinct($cloud.metadata.product_event_type)
    $target_resources = array_distinct($cloud.target.resource.name)

  condition:
    $cloud
}
