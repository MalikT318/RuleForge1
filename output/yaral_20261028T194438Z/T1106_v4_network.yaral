/*
  MITRE Technique : T1106 - Native API
  Tactic(s)       : Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:01:52.428455+00:00
  Reference       : https://attack.mitre.org/techniques/T1106
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1106_Linux_External_Egress_From_Staging_Path_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound connection to a non-internal address initiated by a process whose executable image runs from a world-writable or memory-backed staging location (/tmp, /var/tmp, /dev/shm, /run/user, memfd, /proc/self/fd). Compiled implants and in-memory loaders that call socket()/connect() directly through libc or raw syscalls, without a standard interpreter or network utility, show up on the network side this way. Complements command-line rules by observing the resulting egress rather than the launch."
    mitre_tactic = "Execution"
    mitre_technique = "T1106"
    mitre_technique_name = "Native API"
    log_prerequisites = "Requires Linux endpoint network telemetry (EDR or auditd connect() syscall records) normalised to NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "CI/build hosts running freshly compiled test binaries, developer workstations, self-extracting installers or updaters that execute from /tmp, containers with an ephemeral /tmp-based entrypoint, and snap/AppImage-style launchers that unpack to /tmp or /run/user."
    tuning_guidance = "Add approved build and CI hosts to %global_allowed_script_hosts, sanctioned deployment or update binaries to %global_allowed_admin_tools, and EDR or agent binaries to %global_allowed_security_tools. Review recurring destinations and consider raising severity for memfd or deleted-binary matches."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^(\/(tmp|var\/tmp|dev\/shm|run\/shm|run\/user\/[0-9]+)\/|memfd:|\/proc\/self\/fd\/)/ nocase
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1106")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
