/*
  MITRE Technique : T1685.001 - Disable or Modify Windows Event Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:17:04.776994+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_001_Remote_EventLog_Mgmt_Tool_Network_Activity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Native Windows log and audit management utilities (wevtutil, auditpol, wecutil, sc) opening a network connection to a remote host on RPC, SMB or WinRM ports. These tools only touch the network when they are pointed at a remote machine, for example to clear remote event logs, change a remote audit policy or stop or disable the remote EventLog service. This is the network-side footprint of remote log tampering and complements command-line based detections."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.001"
    mitre_technique_name = "Disable or Modify Windows Event Log"
    log_prerequisites = "Requires endpoint network telemetry that records the initiating process path for outbound connections (EDR network events or Sysmon Event ID 3)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators remotely managing audit policy or event logs, RMM and patching tooling that uses sc.exe or wevtutil.exe against remote hosts, SIEM or log-collection onboarding scripts that configure remote event subscriptions with wecutil, and GPO or compliance remediation scripts."
    tuning_guidance = "Add approved management tooling parent paths to %global_allowed_admin_tools, and named admin accounts to %global_allowed_admin_users. Add automation accounts to %global_allowed_service_accounts. The internal address space is deliberately NOT excluded: remote event log tampering is almost always lateral (internal) activity, so excluding %rfc1918_internal would remove the primary use case. If a client is noisy, tune by allowlisting the initiating account or tool instead of the destination range."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(wevtutil|auditpol|wecutil|sc)\.exe$/ nocase
    (
      $net.target.port = 135 or
      $net.target.port = 445 or
      $net.target.port = 5985 or
      $net.target.port = 5986
    )
    $net.target.ip != ""
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_admin_users
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1685.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $remote_targets = array_distinct($net.target.ip)
    $remote_ports = array_distinct($net.target.port)
    $initiating_user = array_distinct($net.principal.user.userid)
    $initiating_process = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
