/*
  MITRE Technique : T1046 - Network Service Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:28:49.536743+00:00
  Reference       : https://attack.mitre.org/techniques/T1046
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1046_K8s_Service_Enumeration_Then_Pod_Exec {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a single identity enumerating cluster services, endpoints or endpoint slices through the Kubernetes API and then opening an exec, attach or port-forward session into a pod within ten minutes. This is the API-level pattern of an adversary mapping reachable network services in a cluster and then pivoting into a workload to probe them. It is deliberately not based on in-container command-line matching."
    mitre_tactic = "Discovery"
    mitre_technique = "T1046"
    mitre_technique_name = "Network Service Discovery"
    log_prerequisites = "Requires Kubernetes API server audit logs ingested and normalised to UDM USER_RESOURCE_ACCESS, with target.resource.name populated with the resource and subresource (for example services, endpoints, pods/exec), metadata.product_event_type carrying the request verb, and principal.user.userid populated. Audit policy must record at least Metadata level for services, endpoints, endpointslices and pods/exec."
    platform = "Containers"
    log_source = "container"
    false_positives = "Platform engineers and SREs debugging connectivity, service mesh and ingress controllers, GitOps and deployment tooling that lists services and then execs for smoke tests, monitoring and service-discovery agents, and developers using port-forward on a dev cluster."
    tuning_guidance = "Add automation and controller identities to %global_allowed_service_accounts, and named platform administrators to %global_allowed_admin_users. Both exclusions apply to both events. If the audit pipeline places the verb or resource in other fields, adjust the product_event_type and target.resource.name regexes for that tenant. Raise or lower the 10m window per environment."

  events:
    $list.metadata.event_type = "USER_RESOURCE_ACCESS"
    $list.metadata.product_event_type = /(^|[\.\/:\s])(list|watch)$/ nocase
    $list.target.resource.name = /(^|\/)(services|endpoints|endpointslices)(\/|$)/ nocase
    $list.principal.user.userid = $user
    not $list.principal.user.userid in %global_allowed_service_accounts
    not $list.principal.user.userid in %global_allowed_admin_users

    $exec.metadata.event_type = "USER_RESOURCE_ACCESS"
    $exec.target.resource.name = /pods\/(exec|attach|portforward)/ nocase
    $exec.principal.user.userid = $user
    not $exec.principal.user.userid in %global_allowed_service_accounts
    not $exec.principal.user.userid in %global_allowed_admin_users

    $list.metadata.event_timestamp.seconds <= $exec.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1046")
    $primary_entity = array_distinct($user)
    $list_event_count = count($list.metadata.id)
    $exec_event_count = count($exec.metadata.id)
    $enumerated_resources = array_distinct($list.target.resource.name)
    $exec_targets = array_distinct($exec.target.resource.name)
    $source_ips = array_distinct($exec.principal.ip)

  condition:
    $list and $exec
}
