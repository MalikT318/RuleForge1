/*
  MITRE Technique : T1049 - System Network Connections Discovery
  Tactic(s)       : Discovery
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:39:44.684105+00:00
  Reference       : https://attack.mitre.org/techniques/T1049
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1049_External_Source_Probing_Connection_Enumeration_Services {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a non-internal source opening connections to services used to enumerate network connections, sessions and neighbours on a device or host: SNMP (161, which exposes connection and ARP tables) and the NetBIOS session and SMB/RPC family (135, 139, 445, used by net use and net session style queries). Observed from the network side at the perimeter, so it complements endpoint command-line detections."
    mitre_tactic = "Discovery"
    mitre_technique = "T1049"
    mitre_technique_name = "System Network Connections Discovery"
    log_prerequisites = "Firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION, with principal.ip, target.ip and target.port populated. The %rfc1918_internal reference list must be populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Internet-wide scanners and research crawlers, authorised external vulnerability scans, third-party monitoring or NMS platforms polling SNMP over a VPN or public path, managed service provider tooling, and misconfigured partner systems."
    tuning_guidance = "Add authorised scanner and monitoring source addresses to %global_allowed_scanners and approved management or NMS sources to %global_allowed_mgmt_sources. Services that are legitimately exposed should be handled by narrowing the port list. For noisy perimeters, consider promoting this to a threshold variant keyed on principal.ip."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 161 or
      $net.target.port = 135 or
      $net.target.port = 139 or
      $net.target.port = 445
    )
    $net.principal.ip != ""
    $net.target.ip != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1049")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
