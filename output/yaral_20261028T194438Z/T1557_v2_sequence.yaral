/*
  MITRE Technique : T1557 - Adversary-in-the-Middle
  Tactic(s)       : Credential Access, Collection
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:28:51.605063+00:00
  Reference       : https://attack.mitre.org/techniques/T1557
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1557_Linux_DNS_Bypass_Then_Cleartext_Auth_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects an internal Linux host that sends DNS queries directly to an external resolver on port 53 and then, within 10 minutes, opens connections to external cleartext credential-bearing services (FTP, Telnet, POP3, IMAP, LDAP). This is the network-observable pattern of DNS settings manipulated to redirect name resolution (AiTM positioning), followed by interceptable credential traffic. It is firewall-side coverage and does not depend on process command lines."
    mitre_tactic = "Credential Access, Collection"
    mitre_technique = "T1557"
    mitre_technique_name = "Adversary-in-the-Middle"
    log_prerequisites = "Requires firewall, proxy or perimeter flow logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. The firewall must see egress traffic from the Linux host subnet."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Hosts or containers deliberately configured to use public DNS resolvers; legacy FTP, POP3 or IMAP integrations to external vendors; VPN or split-tunnel clients; DNS troubleshooting by admins; vulnerability scanners and authorised testing sources."
    tuning_guidance = "Add authorised scanner or test source addresses to %global_allowed_scanners. If the environment forbids direct external DNS, consider raising severity. Restrict the rule to server subnets at the log-source level if developer workstations are noisy. Review legacy cleartext integrations and remove the port from the rule if it is a known business dependency."

  events:
    $dns.metadata.event_type = "NETWORK_CONNECTION"
    $dns.target.port = 53
    not $dns.target.ip in %rfc1918_internal
    not $dns.principal.ip in %global_allowed_scanners
    $dns.principal.ip = $src_ip

    $clr.metadata.event_type = "NETWORK_CONNECTION"
    (
      $clr.target.port = 21 or
      $clr.target.port = 23 or
      $clr.target.port = 110 or
      $clr.target.port = 143 or
      $clr.target.port = 389
    )
    not $clr.target.ip in %rfc1918_internal
    not $clr.principal.ip in %global_allowed_scanners
    $clr.principal.ip = $src_ip

    $dns.metadata.event_timestamp.seconds <= $clr.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1557")
    $primary_entity = array_distinct($src_ip)
    $external_resolvers = array_distinct($dns.target.ip)
    $cleartext_destinations = array_distinct($clr.target.ip)
    $cleartext_ports = array_distinct($clr.target.port)
    $dns_event_count = count($dns.metadata.id)
    $cleartext_event_count = count($clr.metadata.id)

  condition:
    $dns and $clr
}
