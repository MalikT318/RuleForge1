/*
  MITRE Technique : T1027.003 - Steganography
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:41:37.034466+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_003_Script_Host_Image_Drop_Then_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A script interpreter (PowerShell, WSH or mshta) writes an image file to a user-writable location and then reads the same file back within five minutes. This pattern is consistent with a steganography loader (for example the Invoke-PSImage technique) that retrieves or stages an image carrying an embedded payload and then extracts it. The rule uses file telemetry only and does not duplicate command-line detections."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.003"
    mitre_technique_name = "Obfuscated Files or Information: Steganography"
    log_prerequisites = "Requires endpoint file telemetry with both file-creation and file-read events including the acting process path. FILE_READ coverage varies by EDR sensor policy and may need to be enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin or build scripts that download and process images (report generation, wallpaper or branding deployment, thumbnail and image-resize scripts), login scripts that stage logos, and RMM or software-deployment tooling that runs PowerShell."
    tuning_guidance = "Add approved deployment and RMM binaries to %global_allowed_admin_tools and approved script parents or hosts to %global_allowed_script_hosts. If a specific legitimate script produces repeated alerts, add its interpreter parent to %global_allowed_script_hosts. Extend the extension list or path scope per client if needed."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $file.target.file.full_path = /\.(png|jpe?g|bmp|gif)$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|programdata|windows\\temp|temp)\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $path

    $read.metadata.event_type = "FILE_READ"
    $read.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $read.target.file.full_path = /\.(png|jpe?g|bmp|gif)$/ nocase
    not $read.principal.process.file.full_path in %global_allowed_admin_tools
    not $read.principal.process.file.full_path in %global_allowed_script_hosts
    $read.principal.hostname = $hostname
    $read.target.file.full_path = $path

    $file.metadata.event_timestamp.seconds <= $read.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 5m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $image_path = array_distinct($path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $reader_process = array_distinct($read.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)
    $read_count = count($read.metadata.id)

  condition:
    $file and $read
}
