/*
  MITRE Technique : T1021.001 - Remote Desktop Protocol
  Tactic(s)       : Lateral Movement
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:35:43.600460+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_001_RDP_Logon_Burst_Single_User {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single account completes five or more RemoteInteractive (RDP, logon type 10) logons within ten minutes. One RDP logon is routine. A burst from one account suggests valid-account abuse, credential spraying that succeeded, or hopping between hosts. The outcome lists the distinct target hosts and source addresses so analysts can tell fan-out from repeated reconnects."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.001"
    mitre_technique_name = "Remote Services: Remote Desktop Protocol"
    log_prerequisites = "Windows Security event 4624 (logon type 10) or equivalent EDR logon telemetry normalised to USER_LOGIN with extensions.auth.mechanism = REMOTE_INTERACTIVE."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or help desk staff working across many servers, RDP session reconnects after network drops, jump-host or RDS gateway accounts, and terminal server farms with session brokers."
    tuning_guidance = "Add automation and jump-host accounts to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Raise the #auth threshold in noisy RDS or Citrix environments. Review $distinct_target_count and $source_hosts in the outcome to separate fan-out across many hosts from repeated reconnects to one host."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.extensions.auth.mechanism = "REMOTE_INTERACTIVE"
    $auth.target.user.userid = $user
    not $auth.target.user.userid = /\$$/
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1021.001")
    $primary_entity = array_distinct($user)
    $login_count = count($auth.metadata.id)
    $target_hosts = array_distinct($auth.target.hostname)
    $source_hosts = array_distinct($auth.principal.hostname)
    $source_ips = array_distinct($auth.principal.ip)

  condition:
    #auth >= 5
}
