/*
  MITRE Technique : T1552.004 - Private Keys
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:50:36.482726+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_004_Linux_Private_Key_Web_Fetch_Then_SSH {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An external source successfully requests a Linux private key location through a proxy or perimeter HTTP log, then opens an SSH connection from the same source within 10 minutes. The requested paths are SSH user keys, SSH host keys, or private key directories under /etc/ssl and /etc/pki. This pattern suggests a key disclosed through a web flaw or misconfiguration and then used for access."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.004"
    mitre_technique_name = "Unsecured Credentials: Private Keys"
    log_prerequisites = "Requires firewall, proxy or WAF HTTP logs normalised to NETWORK_HTTP with target.url populated, plus perimeter connection logs normalised to NETWORK_CONNECTION with target.port populated. HTTP response codes are used when present."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Authorised vulnerability or penetration-test scanners, admins who publish public keys over HTTP and then SSH in from the same address, and configuration-management or bastion sources that fetch key material and connect over SSH."
    tuning_guidance = "Add scanner source addresses to %global_allowed_scanners and approved SSH or bastion source addresses to %global_allowed_mgmt_sources. Requests with a 4xx or 5xx response are excluded. If the proxy does not populate response codes, the rule still evaluates because an unset code counts as below 400. Review the URL pattern against your organisation's published public key paths."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(\/|%2f)(\.ssh(\/|%2f)(id_[a-z0-9]+|identity)|etc(\/|%2f)ssh(\/|%2f)ssh_host_[a-z0-9_]+_key|etc(\/|%2f)(ssl|pki)(\/|%2f)private)(\?|$|&|%00)/ nocase
    $http.network.http.response_code < 400
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    $http.principal.ip = $src

    $ssh.metadata.event_type = "NETWORK_CONNECTION"
    $ssh.target.port = 22
    not $ssh.principal.ip in %rfc1918_internal
    not $ssh.principal.ip in %global_allowed_mgmt_sources
    not $ssh.principal.ip in %global_allowed_scanners
    $ssh.principal.ip = $src

    $http.metadata.event_timestamp.seconds <= $ssh.metadata.event_timestamp.seconds

  match:
    $src over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1552.004")
    $primary_entity = array_distinct($http.target.ip)
    $source_ip = array_distinct($src)
    $requested_urls = array_distinct($http.target.url)
    $ssh_targets = array_distinct($ssh.target.ip)
    $ssh_connection_count = count($ssh.metadata.id)

  condition:
    $http and $ssh
}
