/*
  MITRE Technique : T1125 - Video Capture
  Tactic(s)       : Collection
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:33:39.203894+00:00
  Reference       : https://attack.mitre.org/techniques/T1125
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1125_Outbound_Video_Streaming_Protocol_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host opening an outbound connection to an external address on a dedicated video streaming port (RTSP 554/8554 or RTMP 1935). Malware that captures webcam or video-call footage on a Windows host may stream it to external infrastructure over these protocols. The rule observes only network-side behaviour and does not depend on the capturing tool, its name, or its hash."
    mitre_tactic = "Collection"
    mitre_technique = "T1125"
    mitre_technique_name = "Video Capture"
    log_prerequisites = "Firewall or perimeter NETWORK_CONNECTION logs with populated principal host or IP, target.ip and target.port. Internal-to-external traffic must be logged with the pre-NAT source address."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Corporate live-streaming or broadcasting from approved workstations (RTMP to a streaming service), IP camera or CCTV cloud-relay clients, marketing or events staff, video-conferencing or telepresence systems using RTSP, and IoT or media devices on user VLANs."
    tuning_guidance = "Add known-good streaming or vendor domains to %global_allowed_domains (this works when the firewall populates target.hostname). Review the destination IPs and source hosts in the outcome. If a site legitimately streams video, scope the exclusion to that site rather than disabling the rule. Add further non-standard streaming ports to the port condition if your environment uses them."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 554 or
      $net.target.port = 8554 or
      $net.target.port = 1935
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1125")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
