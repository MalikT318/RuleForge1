/*
  MITRE Technique : T1553.003 - SIP and Trust Provider Hijacking
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:02:33.848820+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_003_SIP_Trust_Provider_Registry_Hijack {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of the registry state that maps Subject Interface Packages (SIPs) and trust providers to DLLs and functions, specifically CryptSIPDll* entries under Cryptography\\OID\\EncodingType 0 and Providers\\Trust\\* policy entries. Redirecting these to an attacker-controlled DLL lets malicious code pass Authenticode signature validation. Detection is on the registry state change, so it holds regardless of how the change was made (reg.exe, PowerShell, API calls, or a renamed tool)."
    mitre_tactic = "Defense Impairment, Defense Evasion"
    mitre_technique = "T1553.003"
    mitre_technique_name = "Subvert Trust Controls: SIP and Trust Provider Hijacking"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR registry-write events or Sysmon Event ID 12/13) that populates target.registry.registry_key and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows servicing and cumulative updates, installers of code-signing or PKI software (document signing, smart card middleware, PowerShell or MSI signing tools), legitimate security agents registering a custom trust provider, and IT packaging teams testing catalog or SIP registration."
    tuning_guidance = "Add approved deployment and signing-software installer binaries to %global_allowed_admin_tools, and EDR/AV agents that touch these keys to %global_allowed_security_tools. Review hits with a non-system Dll value or a DLL path outside System32. If Windows servicing is noisy, confirm the servicing exclusion matches the client's OS builds."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Microsoft\\Cryptography\\(OID\\EncodingType 0\\(CryptSIPDll(GetSignedDataMsg|PutSignedDataMsg|RemoveSignedDataMsg|CreateIndirectData|VerifyIndirectData|IsMyFileType2?)|CryptSIPDllIsMyFileType2?)|Providers\\Trust\\(FinalPolicy|Certification|Initialization|Message|Signature|Cleanup|DiagnosticPolicy))\\/ nocase
    not $reg.principal.process.file.full_path = /\\Windows\\servicing\\(TrustedInstaller|TiWorker)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1553.003")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
