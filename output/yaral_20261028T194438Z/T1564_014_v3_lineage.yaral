/*
  MITRE Technique : T1564.014 - Extended Attributes
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:35:24.368120+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_014_Service_Parent_Spawns_Xattr_Tool_Linux {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server, database, or print service process spawning an extended-attribute utility (setfattr/getfattr/attr), either directly or via a shell. Server-side services do not normally read or write file xattrs. This lineage points to a web shell or compromised service staging or retrieving a payload hidden in the user. or trusted. xattr namespace."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.014"
    mitre_technique_name = "Hide Artifacts: Extended Attributes"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to PROCESS_LAUNCH with populated parent and child process paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup or snapshot agents run from a service context, application installers or package post-install scripts that set SELinux or capability xattrs, file-sync or content-management apps that store metadata in xattrs, and Java or Node applications that legitimately call xattr tools."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools and backup or imaging agents to %global_allowed_backup_processes. If java or node parents are noisy in an environment, narrow the parent regex for that tenant. Review the parent process and child command line in the outcome fields before escalating."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|php[0-9.]*-fpm|tomcat[0-9]*|catalina|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|java|node)$/ nocase
    (
      $proc.target.process.file.full_path = /\/(setfattr|getfattr|attr)$/ nocase
      or
      (
        $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ksh)$/ nocase
        and $proc.target.process.command_line = /\b(setfattr|getfattr)\b/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1564.014")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
