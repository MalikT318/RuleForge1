/*
  MITRE Technique : T1119 - Automated Collection
  Tactic(s)       : Collection
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:26:05.917675+00:00
  Reference       : https://attack.mitre.org/techniques/T1119
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1119_Office_Suite_App_Granted_Bulk_Data_Read_Scope {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an application, service principal or OAuth client being granted tenant-wide or mailbox/file bulk-read permissions (mail, files, sites, drive) through the identity provider's directory audit log. Such grants let an adversary collect mail and documents automatically through cloud APIs with no endpoint process activity, which a process-creation rule cannot see."
    mitre_tactic = "Collection"
    mitre_technique = "T1119"
    mitre_technique_name = "Automated Collection"
    log_prerequisites = "Requires identity provider directory/admin audit logs normalised to UDM USER_CHANGE_PERMISSIONS, with metadata.product_event_type and metadata.description populated (consent, app role assignment and delegated permission grant events)."
    platform = "Office Suite"
    log_source = "identity"
    false_positives = "Sanctioned onboarding of backup, archiving, eDiscovery, DLP, CASB, migration or CRM/helpdesk integrations that legitimately need mailbox or file read access; IT-led enterprise app rollouts; admin consent granted during approved projects."
    tuning_guidance = "Add approved integration app names or IDs to %global_allowed_cloud_principals, approved administrators to %global_allowed_admin_users, and automation identities to %global_allowed_service_accounts. If the scope text lands in a different field for a given client, adjust metadata.description accordingly."

  events:
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.metadata.product_event_type = /(consent to application|add app role assignment|add delegated permission grant|add oauth2permissiongrant|authorize api client|grant.*scope)/ nocase
    $perm.metadata.description = /(mail\.read|mail\.readwrite|files\.read\.all|files\.readwrite\.all|sites\.read\.all|sites\.fullcontrol\.all|mailboxsettings\.read|full_access_as_app|gmail\.readonly|mail\.google\.com|auth\/drive)/ nocase
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.target.application in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1119")
    $primary_entity = array_distinct($perm.principal.user.userid)
    $granted_application = array_distinct($perm.target.application)
    $source_ip = array_distinct($perm.principal.ip)
    $grant_event = array_distinct($perm.metadata.product_event_type)

  condition:
    $perm
}
