/*
  MITRE Technique : T1542.005 - TFTP Boot
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:50:26.194700+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_005_External_TFTP_Boot_Server_Traffic {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects UDP traffic to TFTP (port 69) on a destination outside internal address space, as observed at the network perimeter. Network devices configured to netboot from an unauthorized external TFTP server fetch their boot image this way. This is the network-side footprint of TFTP Boot abuse, often paired with a modified system image. TFTP is unauthenticated and unencrypted, so legitimate use across the perimeter is rare."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.005"
    mitre_technique_name = "Pre-OS Boot: TFTP Boot"
    log_prerequisites = "Firewall, proxy or perimeter logs that record allowed and denied connections with source IP, destination IP, destination port and IP protocol. Egress traffic from the management and infrastructure network segments must be visible."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorized offsite or cloud-hosted TFTP and image-distribution servers for branch or remote-site device provisioning. Vendor-managed zero-touch provisioning or staging workflows. Lab and test networks. Network engineers copying configurations or images to or from an external server during maintenance windows."
    tuning_guidance = "Add source addresses of devices or provisioning servers that are approved to use external TFTP to %global_allowed_mgmt_sources. Make sure %rfc1918_internal covers all internal and private address space for the client. If the client has a legitimate external TFTP provisioning service, scope it with an allowlisted source rather than disabling the rule. Raise severity for core routers, switches and firewalls by using the principal.ip outcome in SOAR enrichment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    $net.network.ip_protocol = "UDP"
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1542.005")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
