/*
  MITRE Technique : T1098.004 - SSH Authorized Keys
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:46:26.166567+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_004_Cloud_SSH_Key_Changes_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single identity registers, imports or modifies SSH public keys or key pairs repeatedly within 10 minutes. This pattern fits an adversary planting persistent SSH access on cloud instances or on login profiles. A single key change is routine, but a burst from one account is not."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.004"
    mitre_technique_name = "Account Manipulation: SSH Authorized Keys"
    log_prerequisites = "Requires cloud provider audit and identity logs ingested and normalised to UDM with metadata.product_event_type and principal.user.userid populated. Admin-activity or management-plane audit logging must be enabled."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Infrastructure-as-code pipelines and automation that rotate keys, onboarding of several engineers or fleets, break-glass key rotation after an incident, and migration or re-imaging projects that re-register many keys."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named administrators to %global_allowed_admin_users. Raise the #key threshold for tenants with heavy provisioning. Confirm that product_event_type is populated for the tenant's cloud audit parser."

  events:
    $key.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $key.metadata.product_event_type = /(ssh.{0,20}key|key.?pair|authorized.?keys|os.?login.{0,20}key)/ nocase
    $key.principal.user.userid = $user
    not $key.principal.user.userid in %global_allowed_service_accounts
    not $key.principal.user.userid in %global_allowed_cloud_principals
    not $key.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(if(count($key.metadata.id) >= 10, 85, 60))
    $key_change_count = count($key.metadata.id)
    $mitre_technique_id = array_distinct("T1098.004")
    $primary_entity = array_distinct($user)
    $api_actions = array_distinct($key.metadata.product_event_type)
    $target_resources = array_distinct($key.target.resource.name)
    $source_ips = array_distinct($key.principal.ip)

  condition:
    #key >= 3
}
