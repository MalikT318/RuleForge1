/*
  MITRE Technique : T1027.018 - Invisible Unicode
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:07:27.110323+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/018
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_018_Invisible_Unicode_URL_Then_Script_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a Windows client requesting an external URL that contains percent-encoded or literal invisible Unicode characters (zero-width, bidirectional control, BOM, variation selector, filler characters), followed within five minutes by a script or loader-type file download from the same client. This pattern matches obfuscated phishing and redirect chains that hide payload content in invisible characters. It is observed at the proxy or firewall layer, so it adds network coverage beyond process command-line rules."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.018"
    mitre_technique_name = "Obfuscated Files or Information: Invisible Unicode"
    log_prerequisites = "Requires firewall, secure web gateway, or proxy logs normalized to UDM NETWORK_HTTP with target.url and principal.ip populated. TLS inspection is needed for full URL visibility on HTTPS traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Internationalized URLs that legitimately use ZWJ/ZWNJ (Persian, Indic and other scripts), emoji variation selectors in shared links, URLs with a BOM from misconfigured web apps, and marketing or tracking redirects that embed encoded characters. The second event can also match normal script downloads by developers and IT staff."
    tuning_guidance = "Add known-good external domains (CDNs, vendors, localized services) to %global_allowed_domains. If a client has many legitimate non-Latin sites, narrow the lure regex to bidirectional controls and zero-width characters only. Raise severity if the destination domain is newly seen or uncategorized."

  events:
    $lure.metadata.event_type = "NETWORK_HTTP"
    $lure.target.url = /%E2%80%(8[B-F]|A[A-E])|%E2%81%A[0-4]|%EF%BB%BF|%CD%8F|%E3%85%A4|%EF%BE%A0|%EF%B8%8[0-9A-F]|[\x{200B}-\x{200F}\x{202A}-\x{202E}\x{2060}-\x{2064}\x{FEFF}\x{034F}\x{3164}\x{FFA0}]/ nocase
    not $lure.target.ip in %rfc1918_internal
    not $lure.target.hostname in %global_allowed_domains
    $lure.principal.ip = $src_ip

    $payload.metadata.event_type = "NETWORK_HTTP"
    $payload.target.url = /\.(js|jse|vbs|vbe|hta|wsf|ps1|lnk|iso|img|svg|html?)(\?|#|$)/ nocase
    not $payload.target.ip in %rfc1918_internal
    not $payload.target.hostname in %global_allowed_domains
    $payload.principal.ip = $src_ip

    $lure.metadata.id != $payload.metadata.id
    $lure.metadata.event_timestamp.seconds <= $payload.metadata.event_timestamp.seconds

  match:
    $src_ip over 5m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1027.018")
    $primary_entity = array_distinct($src_ip)
    $lure_urls = array_distinct($lure.target.url)
    $lure_hosts = array_distinct($lure.target.hostname)
    $payload_urls = array_distinct($payload.target.url)
    $payload_hosts = array_distinct($payload.target.hostname)
    $request_count = count($payload.metadata.id)

  condition:
    $lure and $payload
}
