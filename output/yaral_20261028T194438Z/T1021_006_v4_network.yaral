/*
  MITRE Technique : T1021.006 - Windows Remote Management
  Tactic(s)       : Lateral Movement
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:43:52.273051+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_006_WinRM_Perimeter_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects WinRM (TCP 5985 HTTP / 5986 HTTPS) connections observed at the network perimeter where either the source or the destination is outside internal address space. WinRM exposed to, or initiated toward, external networks is a strong indicator of remote administration abuse with valid accounts (lateral movement or initial remote access). Network-side coverage that complements endpoint command-line detections."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.006"
    mitre_technique_name = "Remote Services: Windows Remote Management"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with populated principal.ip, target.ip and target.port. Perimeter must see inbound and outbound traffic; the %rfc1918_internal reference list must be maintained."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Approved MSP or vendor remote administration over WinRM from known external addresses; cloud-hosted Windows management or automation reaching on-premises hosts; hybrid-cloud management planes; authorised penetration tests or vulnerability scans; admin jump hosts hosted outside the internal ranges."
    tuning_guidance = "Add known-good management source addresses to %global_allowed_mgmt_sources and authorised scanner addresses to %global_allowed_scanners. Keep %rfc1918_internal current for the client's internal ranges. If WinRM is only permitted internally for a client, raise severity to Critical for inbound-from-external hits."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 5985 or $net.target.port = 5986)
    (not $net.principal.ip in %rfc1918_internal or not $net.target.ip in %rfc1918_internal)
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1021.006")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
