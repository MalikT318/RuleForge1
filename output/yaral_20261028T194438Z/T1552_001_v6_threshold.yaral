/*
  MITRE Technique : T1552.001 - Credentials In Files
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:46:36.747999+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_001_Linux_Container_Credential_File_Read_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of file reads against well-known credential and secret stores (cloud CLI credentials, kubeconfig, container registry auth, service-account tokens, .netrc, .pgpass, .git-credentials, SSH private keys, .env files) on a single container or container host within 10 minutes. A single read is normal for applications and agents, but repeated reads of several credential locations indicate credential harvesting. This is file-access volume detection, not command-line matching, so it complements process-creation rules."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.001"
    mitre_technique_name = "Unsecured Credentials: Credentials In Files"
    log_prerequisites = "Container runtime sensor or Linux auditd/EDR file-access telemetry normalised to UDM FILE_READ with principal.hostname, target.file.full_path and principal.process.file.full_path populated. File-open or read auditing must be enabled on credential paths."
    platform = "Linux"
    log_source = "container"
    false_positives = "Backup agents, configuration management and deployment tooling, CI/CD runners, cloud CLI and SDK wrappers running in loops, application start-up that reads the service-account token or .env repeatedly, developer shells on build hosts."
    tuning_guidance = "Add legitimate readers to %global_allowed_backup_processes, %global_allowed_security_tools or %global_allowed_admin_tools (by executable path), and automation identities to %global_allowed_service_accounts. Raise the #file threshold on noisy build or CI hosts. Review the credential_paths outcome to decide whether a path pattern is too broad for a given client."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /(\/\.aws\/(credentials|config)|\/\.docker\/config\.json|\/\.kube\/config|\/\.git-credentials|\/\.netrc|\/\.pgpass|\/\.my\.cnf|\/\.ssh\/id_[a-z0-9_]+|\/var\/run\/secrets\/kubernetes\.io\/serviceaccount\/token|\/\.env)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $file_count = count($file.metadata.id)
    $risk_score = max(if($file_count >= 15, 85, 65))
    $mitre_technique_id = array_distinct("T1552.001")
    $primary_entity = array_distinct($host)
    $credential_paths = array_distinct($file.target.file.full_path)
    $reading_processes = array_distinct($file.principal.process.file.full_path)
    $reading_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 5
}
