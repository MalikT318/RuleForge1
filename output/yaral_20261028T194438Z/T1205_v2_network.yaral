/*
  MITRE Technique : T1205 - Traffic Signaling
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:08:06.092399+00:00
  Reference       : https://attack.mitre.org/techniques/T1205
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_Inbound_External_Access_To_Windows_Mgmt_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Firewall-observed inbound TCP connection from an external source to a Windows remote-administration port (RDP, WinRM, SMB, SSH, VNC). Port knocking and other traffic signaling usually end by exposing one of these services, so external reachability of them can mean a signal-opened or hidden listener. Detection is network-side and uses no endpoint process fields."
    mitre_tactic = "Stealth, Persistence, Command and Control"
    mitre_technique = "T1205"
    mitre_technique_name = "Traffic Signaling"
    log_prerequisites = "Perimeter firewall or proxy logs normalised to UDM NETWORK_CONNECTION with network.direction, principal.ip, target.ip and target.port populated, and a tenant-populated %rfc1918_internal list."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Intentionally published RDP/WinRM/SSH gateways, vendor or MSP remote support over approved paths, external vulnerability scans, cloud-hosted management servers, VPN concentrators that forward to Windows hosts, and inbound connections that the firewall logged but denied."
    tuning_guidance = "Add approved external admin and jump-host sources to %global_allowed_mgmt_sources, authorised scanners to %global_allowed_scanners, and approved support tooling to %global_allowed_remote_mgmt. If the firewall logs denied traffic as NETWORK_CONNECTION, add a filter on the allow action for that tenant. Remove ports from the list that a tenant legitimately exposes."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.direction = "INBOUND"
    $net.network.ip_protocol = "TCP"
    (
      $net.target.port = 3389 or
      $net.target.port = 5985 or
      $net.target.port = 5986 or
      $net.target.port = 445 or
      $net.target.port = 22 or
      $net.target.port = 5900
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1205")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
