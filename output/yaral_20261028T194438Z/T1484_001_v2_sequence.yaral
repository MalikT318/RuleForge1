/*
  MITRE Technique : T1484.001 - Group Policy Modification
  Tactic(s)       : Defense Impairment, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:32:29.148388+00:00
  Reference       : https://attack.mitre.org/techniques/T1484/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1484_001_GPO_Payload_Created_Then_Version_Bumped {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a new policy payload file (scheduled task, service, group, script, security template or registry policy) created inside a GPO folder under SYSVOL, followed within 10 minutes by a modification of that GPO's GPT.INI version file. The GPT.INI version bump is how a GPO change is made to replicate and apply to clients. The sequence is typical of GPO abuse tooling and of manual GPO backdooring that pushes tasks, services or local group changes domain-wide. It does not rely on process command lines."
    mitre_tactic = "Defense Impairment, Privilege Escalation"
    mitre_technique = "T1484.001"
    mitre_technique_name = "Domain or Tenant Policy Modification: Group Policy Modification"
    log_prerequisites = "Requires file creation and modification telemetry from domain controllers (EDR or Sysmon file events, or Windows Security object-access auditing on SYSVOL) with principal.hostname, principal.user.userid and target.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate GPO edits by domain administrators through GPMC, scripted GPO deployment, GPO backup restore or import, and security baseline rollouts."
    tuning_guidance = "Add approved GPO management tooling to %global_allowed_admin_tools, named GPO administrators to %global_allowed_admin_users, and automation accounts to %global_allowed_service_accounts. Run in a monitor-only mode first to learn the change-window baseline. Raise severity when the writing process is not a known management binary."

  events:
    $gpo.metadata.event_type = "FILE_CREATION"
    $gpo.target.file.full_path = /\\sysvol\\.+\\policies\\\{[0-9a-f-]{36}\}\\(machine|user)\\.*((scheduledtasks|services|groups|datasources|files)\.xml|gpttmpl\.inf|registry\.pol|\\scripts\\.+)$/ nocase
    $gpo.principal.hostname = $host
    $gpo.principal.user.userid = $user
    not $gpo.principal.process.file.full_path in %global_allowed_admin_tools
    not $gpo.principal.user.userid in %global_allowed_admin_users
    not $gpo.principal.user.userid in %global_allowed_service_accounts

    $ver.metadata.event_type = "FILE_MODIFICATION"
    $ver.target.file.full_path = /\\sysvol\\.+\\policies\\\{[0-9a-f-]{36}\}\\gpt\.ini$/ nocase
    $ver.principal.hostname = $host
    $ver.principal.user.userid = $user
    not $ver.principal.process.file.full_path in %global_allowed_admin_tools
    not $ver.principal.user.userid in %global_allowed_admin_users
    not $ver.principal.user.userid in %global_allowed_service_accounts

    $gpo.metadata.event_timestamp.seconds <= $ver.metadata.event_timestamp.seconds

  match:
    $host, $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1484.001")
    $primary_entity = array_distinct($host)
    $acting_user = array_distinct($user)
    $payload_files = array_distinct($gpo.target.file.full_path)
    $version_files = array_distinct($ver.target.file.full_path)
    $writer_processes = array_distinct($gpo.principal.process.file.full_path)
    $payload_count = count($gpo.metadata.id)

  condition:
    $gpo and $ver
}
