/*
  MITRE Technique : T1134.003 - Make and Impersonate Token
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:57:15.494303+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_003_Anomalous_Parent_Spawns_Alt_Credential_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office application, web server, database service or print spooler spawning a shell, script interpreter or runas utility with alternate-credential arguments (netonly, savecred, explicit user, PSCredential, LogonUser). This lineage indicates an adversary creating a new logon session and token to impersonate another user (Make and Impersonate Token) from an exploited or abused service process."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.003"
    mitre_technique_name = "Access Token Manipulation: Make and Impersonate Token"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Line-of-business Office macros or add-ins that launch helper tools under a service identity; web applications or SQL Agent jobs that legitimately run commands as another account; print management scripts; administrators testing from a web-hosted management console."
    tuning_guidance = "Add approved parent binaries to %global_allowed_script_hosts or %global_allowed_admin_tools. Add known automation identities to %global_allowed_service_accounts. Review the parent path and command line in the outcome fields to confirm the credential source."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|onenote|w3wp|httpd|nginx|tomcat\d*|php-cgi|sqlservr|mysqld|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(runas|cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(\/netonly|\/savecred|\/user:|-credential\b|pscredential|logonuser|-netonly)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1134.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
