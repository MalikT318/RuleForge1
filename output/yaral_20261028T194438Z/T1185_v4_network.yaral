/*
  MITRE Technique : T1185 - Browser Session Hijacking
  Tactic(s)       : Collection
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:31:23.557977+00:00
  Reference       : https://attack.mitre.org/techniques/T1185
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1185_Browser_Process_Unusual_External_Port_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a web browser process making an outbound connection to an external address on a port other than the standard web ports. Browser pivot and proxy-injection tooling (man-in-the-browser) typically relays the attacker's traffic through the victim's browser over a separate channel back to attacker infrastructure. Legitimate browser traffic is almost entirely on TCP 80/443."
    mitre_tactic = "Collection"
    mitre_technique = "T1185"
    mitre_technique_name = "Browser Session Hijacking"
    log_prerequisites = "Requires endpoint network telemetry that populates the initiating process path (EDR network events or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Browsers using WebRTC/STUN/TURN (video conferencing), Chrome push messaging, QUIC/alt-svc on non-standard ports, web apps hosted on custom ports (dev/test portals, vendor consoles, IP cameras), browser-based remote support tools, user-configured proxies or VPN extensions on non-standard ports."
    tuning_guidance = "Add known-good destination domains to %global_allowed_domains. Add approved remote support or conferencing tooling to %global_allowed_remote_mgmt. If specific legitimate ports are noisy for a client (for example 8443 or 3478), add additional port exclusions per tenant. Review %rfc1918_internal to confirm it covers the client's internal ranges."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(chrome|msedge|firefox|brave|opera|vivaldi|iexplore)\.exe$/ nocase
    $net.target.port > 0
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 5228
    $net.target.port != 5229
    $net.target.port != 5230
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip = /^(127\.|0\.0\.0\.0$|::1$|169\.254\.)/
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    $net.principal.hostname != ""

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1185")
    $primary_entity = array_distinct($net.principal.hostname)
    $browser_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
