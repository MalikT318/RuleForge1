/*
  MITRE Technique : T1110.001 - Password Guessing
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:03:58.747839+00:00
  Reference       : https://attack.mitre.org/techniques/T1110/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1110_001_IdP_Lockout_Protection_Setting_Weakened {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change to identity provider account-lockout, smart-lockout, brute-force protection, or password-guessing throttling settings made by an account that is not an approved administrator or service account. Password guessing depends on weak or absent lockout and throttling controls, so tampering with them often precedes or accompanies a guessing campaign. This detects the resulting configuration state change rather than the failed-login stream or any command line."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1110.001"
    mitre_technique_name = "Brute Force: Password Guessing"
    log_prerequisites = "Requires identity provider directory/admin audit logs normalised to UDM SETTING_MODIFICATION with the setting name in target.resource.name or metadata.description, and the actor in principal.user.userid."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Planned security hardening or policy tuning by identity administrators not yet in the allowlist, tenant onboarding or migration projects, and automated configuration-as-code pipelines running under unlisted service accounts."
    tuning_guidance = "Add named identity administrators to %global_allowed_admin_users, automation and IaC accounts to %global_allowed_service_accounts, and approved service principals to %global_allowed_cloud_principals. Narrow the setting-name regex if the tenant uses broader policy names that cause noise."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    (
      $setting.target.resource.name = /(smart.?lockout|account.?lockout|lockout.?(threshold|duration|policy)|brute.?force|password.?spray|login.?(throttl|protection|rate.?limit)|failed.?(sign.?in|login|attempt).?(threshold|limit|count)|authentication.?rate.?limit)/ nocase or
      $setting.metadata.description = /(smart.?lockout|account.?lockout|lockout.?(threshold|duration|policy)|brute.?force|password.?spray|login.?(throttl|protection|rate.?limit)|failed.?(sign.?in|login|attempt).?(threshold|limit|count)|authentication.?rate.?limit)/ nocase
    )
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1110.001")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $setting_name = array_distinct($setting.target.resource.name)
    $source_ip = array_distinct($setting.principal.ip)

  condition:
    $setting
}
