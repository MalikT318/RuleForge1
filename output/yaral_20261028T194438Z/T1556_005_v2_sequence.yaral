/*
  MITRE Technique : T1556.005 - Reversible Encryption
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:20:54.845383+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_005_Reversible_Encryption_Enabled_Then_Password_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An account is modified to store its password using reversible encryption (Security event 4738, UserAccountControl change), and a password change or reset is then recorded for the same account within 10 minutes. Passwords set after the flag is enabled are stored in a recoverable form, so the plaintext can be extracted from Active Directory. This covers the account-attribute and password-change path, not process command lines."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.005"
    mitre_technique_name = "Modify Authentication Process: Reversible Encryption"
    log_prerequisites = "Requires Windows Security event logs from domain controllers with Audit User Account Management enabled (4738 for account changes, 4723/4724 for password change/reset), normalised to UDM with the UserAccountControl change text available in security_result.description or metadata.description."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy applications or protocols that require reversible encryption (CHAP/RADIUS, Digest authentication, some Mac/Citrix integrations) being onboarded by administrators; identity management or provisioning tools that set the flag and the initial password together."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and provisioning or IAM automation accounts to %global_allowed_service_accounts. Review any legitimate legacy use of reversible encryption and exclude its approved actors."

  events:
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.metadata.product_event_type = "4738"
    (
      $perm.security_result.description = /reversible/ nocase or
      $perm.metadata.description = /reversible/ nocase
    )
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_service_accounts
    $perm.target.user.userid = $user

    $pwd.metadata.event_type = "USER_CHANGE_PASSWORD"
    $pwd.metadata.product_event_type = /^(4723|4724)$/
    not $pwd.principal.user.userid in %global_allowed_service_accounts
    $pwd.target.user.userid = $user

    $perm.metadata.event_timestamp.seconds <= $pwd.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1556.005")
    $primary_entity = array_distinct($user)
    $modifying_accounts = array_distinct($perm.principal.user.userid)
    $password_changed_by = array_distinct($pwd.principal.user.userid)
    $domain_controllers = array_distinct($perm.principal.hostname)
    $first_seen = min($perm.metadata.event_timestamp.seconds)
    $last_seen = max($pwd.metadata.event_timestamp.seconds)

  condition:
    $perm and $pwd
}
