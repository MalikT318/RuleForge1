/*
  MITRE Technique : T1542.002 - Component Firmware
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:44:56.607569+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_002_Linux_Firmware_Image_Download_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux host using a command-line downloader or scripting runtime to fetch a firmware-style image (BIOS, option ROM, NIC, SSD, NVMe, BMC or flash images with .bin/.rom/.fw/.cap/.img/.hex/.fwu/.pkg extensions) from an external destination. Retrieving a component firmware image outside a vendor update channel is a staging step for component firmware modification (T1542.002). The rule is network-side and complements endpoint coverage of the flashing step."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.002"
    mitre_technique_name = "Pre-OS Boot: Component Firmware"
    log_prerequisites = "Requires HTTP/proxy or EDR network telemetry normalised to NETWORK_HTTP with target.url and principal.process.file.full_path populated. Without process attribution on HTTP events, the process condition will not match."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators manually downloading vendor firmware for servers, NICs, SSDs, NVMe drives or BMCs; provisioning and imaging scripts; hardware lab and embedded-development hosts; vendor-hosted update mirrors not in the domain allowlist."
    tuning_guidance = "Add known-good vendor and update CDN domains to %global_allowed_domains. Add approved patching and deployment tooling paths to %global_allowed_admin_tools. Exclude hardware lab or firmware-engineering hosts by scoping the rule at deployment. Extend or narrow the filename keyword group in the url regex to suit the estate."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.principal.process.file.full_path = /\/(curl|wget|python[0-9.]*|perl|ruby|busybox|aria2c|lwp-download)$/ nocase
    $http.target.url = /(firmware|flash|vbios|oprom|option[_-]?rom|bmc|nvme|ssd|hdd|nic[_-]?fw|bios)[^\/?#]*\.(bin|rom|fw|cap|img|hex|fwu|pkg)(\?|#|$)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.process.file.full_path in %global_allowed_admin_tools
    not $http.principal.process.file.full_path = /\/(fwupd|fwupdmgr|packagekitd|apt|apt-get|dnf|yum|zypper)$/ nocase

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1542.002")
    $primary_entity = array_distinct($http.principal.hostname)
    $downloaded_urls = array_distinct($http.target.url)
    $destination_ips = array_distinct($http.target.ip)
    $downloader_process = array_distinct($http.principal.process.file.full_path)

  condition:
    $http
}
