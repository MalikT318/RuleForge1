/*
  MITRE Technique : T1569.003 - Systemctl
  Tactic(s)       : Execution
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:12:50.668177+00:00
  Reference       : https://attack.mitre.org/techniques/T1569/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_003_Systemctl_Unit_From_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects systemctl being used to link, enable, start or restart a service or timer unit file that lives in a world-writable or user-controlled location (/tmp, /var/tmp, /dev/shm, /home, /run/user). Legitimate units are installed under /etc/systemd, /usr/lib/systemd or /lib/systemd, so referencing a unit from a writable path is a strong indicator of an adversary using systemctl to execute a payload as a systemd service."
    mitre_tactic = "Execution"
    mitre_technique = "T1569.003"
    mitre_technique_name = "System Services: Systemctl"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records with full command line populated and normalised to UDM PROCESS_LAUNCH."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers or CI runners testing unit files from /tmp or home directories; configuration management or deployment tooling that stages units in /tmp before installation; container or image build pipelines; admins running a one-off unit test."
    tuning_guidance = "Add approved deployment, configuration management and RMM binaries to %global_allowed_admin_tools (matched on the parent process path). Add automation accounts to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. If developer hosts are noisy, scope the rule down by severity routing for those hosts rather than widening the path regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/systemctl$/ nocase
    $proc.target.process.command_line = /\b(link|enable|reenable|start|restart|reload-or-restart|try-restart)\s+(--?[a-z-]+(=\S+)?\s+)*(\/tmp|\/var\/tmp|\/dev\/shm|\/home\/[^\/\s]+|\/run\/user\/\d+)\/\S*\.(service|timer|socket)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1569.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
