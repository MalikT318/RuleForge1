/*
  MITRE Technique : T1556.002 - Password Filter DLL
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:16:49.442676+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_002_LSASS_Outbound_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the LSA process (lsass.exe) initiating a network connection to an external address. A malicious password filter DLL runs inside lsass.exe and receives plain-text passwords, so staging or exfiltrating them over the network appears as outbound traffic from lsass.exe. Legitimate lsass.exe traffic is almost entirely internal (Kerberos, LDAP, SMB, RPC to domain controllers)."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.002"
    mitre_technique_name = "Modify Authentication Process: Password Filter DLL"
    log_prerequisites = "Requires Windows endpoint network telemetry that attributes connections to the originating process (EDR network events or Sysmon Event ID 3) and is normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Entra ID / Azure AD joined or hybrid-joined hosts where lsass.exe contacts cloud identity endpoints; domain controllers reaching external time sources, cloud-hosted domain controllers, or trusted partner forests over public addressing; OCSP/CRL or certificate-based authentication lookups; EDR network telemetry that misattributes the process."
    tuning_guidance = "Add known-good identity and vendor domains to %global_allowed_domains (matched against target.hostname). Confirm that internal and cloud-peered address space is covered by %rfc1918_internal. Pivot from hits to REGISTRY_MODIFICATION on the LSA 'Notification Packages' value and to new DLLs in System32 on the same host."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\lsass\.exe$/ nocase
    $net.principal.hostname != ""
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1556.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $destination_hosts = array_distinct($net.target.hostname)

  condition:
    $net
}
