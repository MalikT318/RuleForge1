/*
  MITRE Technique : T1204 - User Execution
  Tactic(s)       : Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:57:55.055754+00:00
  Reference       : https://attack.mitre.org/techniques/T1204
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_Container_Direct_Pod_Creation_By_Human {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a human (non-system) identity creating a bare pod directly through the container orchestration API, the audit-log footprint of a user manually running an image (for example kubectl run). Pods in managed workloads are created by controller identities, so a direct create by a person suggests a user was tricked into running, or deliberately ran, an untrusted image (T1204.003 Malicious Image). Complements process-command-line detections by working at the control plane."
    mitre_tactic = "Execution"
    mitre_technique = "T1204"
    mitre_technique_name = "User Execution"
    log_prerequisites = "Requires container orchestration audit logs (Kubernetes API audit, with create verbs on pods logged at Metadata level or higher) ingested into Chronicle and normalized to UDM RESOURCE_CREATION."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Developers and SREs running debug or test pods in non-production clusters, CI/CD runners using personal credentials, break-glass troubleshooting, and training or lab clusters."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users, automation identities to %global_allowed_service_accounts, and approved cloud or identity principals to %global_allowed_cloud_principals. If non-production clusters are noisy, scope the rule per client by adding a target.resource name condition. Raise severity for production clusters."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /(^|\.)pods\.create$/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid = /^system:/ nocase
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1204")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $pod_name = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
