/*
  MITRE Technique : T1686.003 - Windows Host Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:33:29.577287+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_003_Firewall_Profile_Disabled_Via_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry write that disables a Windows Defender Firewall profile (EnableFirewall under the Domain, Standard/Private or Public profile key, in either the local FirewallPolicy store or the Group Policy store). This is a telemetry-level complement to command-line rules because it also catches API, WMI, COM, reg.exe, script and in-memory changes that never show a recognisable command line. Note: the requested 'alternate platform' angle was not applied because T1686.003 is Windows-specific; additive coverage is delivered through registry telemetry on Windows."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.003"
    mitre_technique_name = "Impair Defenses: Windows Host Firewall"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon registry events) covering HKLM\\SYSTEM\\CurrentControlSet\\Services\\SharedAccess\\Parameters\\FirewallPolicy and HKLM\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy or MDM changes to firewall state, RMM and deployment tooling, security agents that toggle the firewall during install or upgrade, administrators temporarily disabling the firewall for troubleshooting, and lab or imaging builds. Because registry value data formats differ between sensors, explicit 'enabled' writes are excluded but writes with empty data will still alert."
    tuning_guidance = "Add approved writer process paths to %global_allowed_admin_tools, %global_allowed_security_tools or %global_allowed_remote_mgmt. Add approved build or imaging hosts via %global_allowed_script_hosts only if hostnames are stored there in your tenant. If the sensor populates registry_value_data reliably, tighten the rule to require a zero value."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(Services\\SharedAccess\\Parameters\\FirewallPolicy|Policies\\Microsoft\\WindowsFirewall)\\(Domain|Standard|Private|Public)Profile$/ nocase
    $reg.target.registry.registry_value_name = /^EnableFirewall$/ nocase
    not $reg.target.registry.registry_value_data = /^(1|0x0*1|DWORD \(0x0*1\))$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1686.003")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
