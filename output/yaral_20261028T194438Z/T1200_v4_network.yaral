/*
  MITRE Technique : T1200 - Hardware Additions
  Tactic(s)       : Initial Access
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:50:17.471192+00:00
  Reference       : https://attack.mitre.org/techniques/T1200
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1200_Unmanaged_Device_Outbound_Tunnel_Firewall {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal source with no resolved hostname (typical of an unmanaged or rogue hardware implant such as a dropbox, rogue AP or implant board) initiating an outbound connection to an external address on a remote-access or tunnelling port (SSH, Telnet, OpenVPN, WireGuard, PPTP). Rogue hardware additions commonly phone home through reverse tunnels to give the adversary a foothold inside the network."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1200"
    mitre_technique_name = "Hardware Additions"
    log_prerequisites = "Requires firewall, proxy or perimeter NETWORK_CONNECTION logs with source IP populated. Hostname enrichment (DHCP, DNS or asset correlation) should be active in the SIEM so that managed endpoints resolve to a principal.hostname."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Unmanaged but legitimate devices (printers, IoT, VoIP phones, guest or BYOD devices, lab equipment), network appliances with outbound SSH or VPN for vendor support, and environments where hostname enrichment is incomplete. Approved admin jump hosts that have no hostname in the logs may also trigger."
    tuning_guidance = "Add approved management or jump-host source addresses to %global_allowed_mgmt_sources. Add known vendor or support destinations to %global_allowed_domains. If hostname enrichment is poor in a tenant, validate coverage before deployment and consider raising severity only for sources not seen in the asset inventory."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname = ""
    $net.principal.ip != ""
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 1194 or
      $net.target.port = 1723 or
      $net.target.port = 51820
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1200")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
