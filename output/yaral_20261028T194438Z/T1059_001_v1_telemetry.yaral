/*
  MITRE Technique : T1059.001 - PowerShell
  Tactic(s)       : Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:07:39.380285+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_001_PowerShell_ExecutionPolicy_Weakened_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a registry state change that sets the PowerShell ExecutionPolicy to Bypass or Unrestricted, either per-user, per-machine or through the policy hive. This is the persistent result of Set-ExecutionPolicy or direct registry edits, and it removes a guardrail on PowerShell script execution. Detection is based on the registry change rather than command-line text, so it still fires if the command line is obfuscated, encoded or not logged."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.001"
    mitre_technique_name = "Command and Scripting Interpreter: PowerShell"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events) that populates registry key, value name and value data. The Sysmon registry events and the equivalent EDR registry-write events both need to be enabled for the ShellIds and Policies PowerShell keys."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developers and administrators setting a relaxed execution policy on workstations, software installers and deployment tooling (SCCM, Intune, Chocolatey, RMM agents) that configure PowerShell, and GPO or configuration-management baselines that deliberately set Bypass or Unrestricted."
    tuning_guidance = "Add approved deployment and RMM binaries to %global_allowed_admin_tools and named administrators to %global_allowed_admin_users. If the environment sets Bypass by GPO, exclude the policy-writing process through %global_allowed_admin_tools rather than loosening the registry or value patterns. Raise severity for servers and for non-interactive or service accounts."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      $reg.target.registry.registry_key = /\\Microsoft\\PowerShell\\1\\ShellIds\\[^\\]+(\\ExecutionPolicy)?$/ nocase or
      $reg.target.registry.registry_key = /\\Policies\\Microsoft\\Windows\\PowerShell(\\ExecutionPolicy)?$/ nocase or
      $reg.target.registry.registry_key = /\\PowerShell\\.*\\ExecutionPolicy$/ nocase
    )
    $reg.target.registry.registry_value_name = /^ExecutionPolicy$/ nocase
    $reg.target.registry.registry_value_data = /^(bypass|unrestricted)$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1059.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $policy_values = array_distinct($reg.target.registry.registry_value_data)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
