/*
  MITRE Technique : T1553.005 - Mark-of-the-Web Bypass
  Tactic(s)       : Defense Impairment
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:06:53.895083+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_005_Unexpected_Parent_MOTW_Removal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an unexpected parent process (Office application, script host, PDF reader, web server, print spooler or database service) spawning a shell or script interpreter whose command line strips or bypasses Mark-of-the-Web. This covers Zone.Identifier stream removal, Unblock-File, and mounting of disk images, which removes MOTW from the files inside. The rule keys on process lineage combined with MOTW-bypass command-line semantics, not on any specific payload or tool name."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.005"
    mitre_technique_name = "Subvert Trust Controls: Mark-of-the-Web Bypass"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros or add-ins in legitimate business workflows that unblock downloaded templates; IT deployment or packaging scripts launched from a script host; developer or build tooling on web or database servers that unblocks or mounts images; software installers that mount ISO or VHD media from an interpreter."
    tuning_guidance = "Add approved parent process paths or script hosts to %global_allowed_script_hosts, approved IT tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. To reduce noise on servers that routinely mount images, narrow the command-line regex to the Zone.Identifier and Unblock-File terms only."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|onenote|msaccess|mspub|acrord32|acrobat|foxitreader|wscript|cscript|mshta|w3wp|httpd|nginx|tomcat\d*|spoolsv|sqlservr)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(unblock-file|zone\.identifier|mount-diskimage|mount-vhd)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1553.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
