/*
  MITRE Technique : T1611 - Escape to Host
  Tactic(s)       : Privilege Escalation
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:31:38.084287+00:00
  Reference       : https://attack.mitre.org/techniques/T1611
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1611_Windows_Container_Mgmt_API_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows host process opening a network connection to a non-internal address on a container management API port (Docker Engine API 2375/2376 or kubelet API 10250). Container-escape tooling and Container Administration Command abuse use these APIs to start privileged containers with host bind mounts or to exec into containers on other nodes. Internal address space and approved management sources are excluded."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1611"
    mitre_technique_name = "Escape to Host"
    log_prerequisites = "Requires EDR or Sysmon-equivalent network connection telemetry (Sysmon Event ID 3 or equivalent) that populates principal process path, target IP and target port."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developers or DevOps engineers running docker or kubectl clients against cloud-hosted build or container hosts; CI/CD agents managing remote Docker hosts; container orchestration agents and monitoring tools polling the kubelet; authorised security testing."
    tuning_guidance = "Add approved admin and DevOps client binaries to %global_allowed_admin_tools. Add sanctioned container host addresses to %global_allowed_mgmt_sources. Add CI/CD runner hosts to %global_allowed_script_hosts or service accounts to %global_allowed_service_accounts if they generate recurring matches. Add scanners to %global_allowed_scanners."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 2375 or
      $net.target.port = 2376 or
      $net.target.port = 10250
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1611")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $source_user = array_distinct($net.principal.user.userid)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
