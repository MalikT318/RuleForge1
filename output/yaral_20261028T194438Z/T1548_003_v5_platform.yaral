/*
  MITRE Technique : T1548.003 - Sudo and Sudo Caching
  Tactic(s)       : Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:33:12.422342+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_003_Linux_Sudoers_File_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of /etc/sudoers or a /etc/sudoers.d/ drop-in file by a process that is not an approved admin tool or package manager. Adversaries edit sudoers to grant themselves passwordless or unrestricted sudo, for example NOPASSWD entries, and so escalate privileges persistently. This detects the file-integrity result of the change, not the command line that caused it, so it complements process-creation rules."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.003"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Sudo and Sudo Caching"
    log_prerequisites = "Linux file-integrity telemetry from EDR or auditd (watch rules on /etc/sudoers and /etc/sudoers.d/ with write and attribute-change permissions) normalised to UDM FILE_MODIFICATION with principal process and target file path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators editing sudoers with visudo, configuration management (Ansible, Puppet, Chef, Salt) pushing sudoers drop-ins, package installs that ship sudoers.d files, and cloud-init or provisioning scripts at first boot."
    tuning_guidance = "Add configuration-management and provisioning binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Add named administrators to %global_allowed_admin_users. Companion rule: clone this rule with metadata.event_type = FILE_CREATION to cover newly created sudoers.d drop-ins. Consider a suppression window during the first boot of new hosts."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/sudoers(\.d\/[^\/]+)?$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|rpm|apt|apt-get|yum|dnf|zypper|unattended-upgrade)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1548.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $modifying_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
