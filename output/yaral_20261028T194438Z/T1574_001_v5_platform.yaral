/*
  MITRE Technique : T1574.001 - DLL
  Tactic(s)       : Stealth, Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:29:36.234107+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

// NOTE: The brief's "alternate platform" angle conflicts with its mandatory Windows platform and windows_endpoint log source. The mandatory constraints win. Additive coverage comes from module-load telemetry instead of PROCESS_LAUNCH command lines.
rule MSSP_T1574_001_Sideload_System_DLL_Name_From_User_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process loading a DLL whose file name matches a commonly hijacked Windows system library (search-order, phantom or side-loading targets) from a user-writable directory such as AppData, ProgramData, Public or Temp. Genuine copies of these libraries live in System32, SysWOW64 or WinSxS. A copy in a user-writable path indicates DLL search order hijacking or side-loading. The rule uses module-load telemetry and does not depend on command lines."
    mitre_tactic = "Persistence, Privilege Escalation, Defense Evasion, Execution"
    mitre_technique = "T1574.001"
    mitre_technique_name = "Hijack Execution Flow: DLL"
    log_prerequisites = "Requires EDR or Sysmon module-load telemetry (Sysmon Event ID 7 or equivalent) normalised to PROCESS_MODULE_LOAD with target.file.full_path populated. Module-load logging is often filtered by default and may need to be enabled for user-writable paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Portable applications and per-user installers (Electron, Squirrel and ClickOnce apps) that ship their own copy of a system-named DLL in AppData. Software deployment agents staging DLLs in ProgramData or Temp. Security or backup agents that unpack libraries into Temp. Developer build output directories."
    tuning_guidance = "Add loading processes of known-good per-user applications to %global_allowed_admin_tools, and security or backup agents to %global_allowed_security_tools. Extend the DLL name list per environment if a customer has additional commonly hijacked libraries. Remove names that generate noise from legitimately bundled copies."

  events:
    $mod.metadata.event_type = "PROCESS_MODULE_LOAD"
    $mod.target.file.full_path = /\\(version|winhttp|wtsapi32|cryptsp|cryptbase|dwmapi|mscms|msimg32|profapi|wlbsctrl|cscapi|tapi32|ntmarta|userenv|uxtheme|netutils|samcli|srvcli|wkscli|dhcpcsvc|fxsapi|bcrypt|propsys)\.dll$/ nocase
    $mod.target.file.full_path = /\\(Users\\[^\\]+\\AppData\\|ProgramData\\|Users\\Public\\|Windows\\Temp\\|Temp\\)/ nocase
    $mod.principal.hostname != ""
    not $mod.principal.process.file.full_path in %global_allowed_admin_tools
    not $mod.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1574.001")
    $primary_entity = array_distinct($mod.principal.hostname)
    $loading_process = array_distinct($mod.principal.process.file.full_path)
    $loaded_dll = array_distinct($mod.target.file.full_path)
    $user = array_distinct($mod.principal.user.userid)

  condition:
    $mod
}
