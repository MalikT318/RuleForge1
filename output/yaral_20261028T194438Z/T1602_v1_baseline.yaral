/*
  MITRE Technique : T1602 - Data from Configuration Repository
  Tactic(s)       : Collection
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:16:08.476746+00:00
  Reference       : https://attack.mitre.org/techniques/T1602
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_External_Access_To_Device_Config_Services {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a connection from outside internal address space to network-device configuration-repository services: SNMP (161), TFTP (69), Cisco Smart Install (4786) and NETCONF over SSH (830). These services expose device configurations, routing tables and credentials, and are commonly abused to pull configuration data. They should never be reachable from untrusted sources."
    mitre_tactic = "Collection"
    mitre_technique = "T1602"
    mitre_technique_name = "Data from Configuration Repository"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs must include allowed traffic. Requires %rfc1918_internal to be populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "External managed-service or NOC monitoring platforms polling SNMP; ISP or vendor remote monitoring; authorised vulnerability scans or penetration tests; zero-touch provisioning over TFTP from a cloud or partner source; misrouted internal traffic that uses non-RFC1918 internal address space."
    tuning_guidance = "Add approved monitoring and management source addresses to %global_allowed_mgmt_sources. Add authorised scan sources to %global_allowed_scanners. If a client uses public or non-RFC1918 internal ranges, extend %rfc1918_internal for that tenant. Raise severity to Critical when the destination is a known network device and the connection was allowed."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 161 or
      $net.target.port = 69 or
      $net.target.port = 4786 or
      $net.target.port = 830
    )
    not $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1602")
    $primary_entity = array_distinct($net.principal.ip)
    $target_devices = array_distinct($net.target.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
