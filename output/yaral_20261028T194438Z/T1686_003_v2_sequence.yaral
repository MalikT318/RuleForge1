/*
  MITRE Technique : T1686.003 - Windows Host Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:32:04.924039+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_003_Firewall_Profile_Disabled_Then_Inbound_Allow_Rule_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a registry-level change that disables a Windows Firewall profile (EnableFirewall set to 0), followed within 10 minutes on the same host by registry creation of an inbound Allow firewall rule. This catches firewall impairment made through the registry, PowerShell/WMI/COM APIs or direct API calls, independent of process command lines."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.003"
    mitre_technique_name = "Impair Defenses: Windows Host Firewall"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon event IDs 12/13/14 or equivalent) covering the SharedAccess FirewallPolicy keys, with registry value name and value data populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers that open inbound ports after temporarily disabling a profile, endpoint security or VPN agents reconfiguring the firewall, golden-image or build pipelines, and administrators changing firewall policy through approved tooling."
    tuning_guidance = "Add approved deployment, security and firewall-management binaries to %global_allowed_admin_tools and %global_allowed_security_tools. Add named admins to %global_allowed_admin_users. Add automation accounts to %global_allowed_service_accounts. If a client uses Group Policy to manage the firewall, exclude the policy engine's writer process or account through these lists."

  events:
    $fwoff.metadata.event_type = "REGISTRY_MODIFICATION"
    $fwoff.target.registry.registry_key = /\\(SharedAccess\\Parameters\\FirewallPolicy|Policies\\Microsoft\\WindowsFirewall)\\(Standard|Domain|Public)Profile(\\|$)/ nocase
    $fwoff.target.registry.registry_value_name = /^EnableFirewall$/ nocase
    $fwoff.target.registry.registry_value_data = /^(dword \()?(0x0+|0)\)?$/ nocase
    not $fwoff.principal.process.file.full_path in %global_allowed_admin_tools
    not $fwoff.principal.process.file.full_path in %global_allowed_security_tools
    not $fwoff.principal.user.userid in %global_allowed_admin_users
    not $fwoff.principal.user.userid in %global_allowed_service_accounts
    $fwoff.principal.hostname = $hostname

    $fwrule.metadata.event_type = "REGISTRY_MODIFICATION"
    $fwrule.target.registry.registry_key = /\\SharedAccess\\Parameters\\FirewallPolicy\\FirewallRules$/ nocase
    $fwrule.target.registry.registry_value_data = /Action=Allow/ nocase
    $fwrule.target.registry.registry_value_data = /Dir=In/ nocase
    not $fwrule.principal.process.file.full_path in %global_allowed_admin_tools
    not $fwrule.principal.process.file.full_path in %global_allowed_security_tools
    not $fwrule.principal.user.userid in %global_allowed_admin_users
    not $fwrule.principal.user.userid in %global_allowed_service_accounts
    $fwrule.principal.hostname = $hostname

    $fwoff.metadata.event_timestamp.seconds <= $fwrule.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1686.003")
    $primary_entity = array_distinct($fwoff.principal.hostname)
    $disabling_processes = array_distinct($fwoff.principal.process.file.full_path)
    $rule_writing_processes = array_distinct($fwrule.principal.process.file.full_path)
    $disabled_profile_keys = array_distinct($fwoff.target.registry.registry_key)
    $added_rule_names = array_distinct($fwrule.target.registry.registry_value_name)
    $acting_users = array_distinct($fwoff.principal.user.userid)
    $event_count = count($fwrule.metadata.id)

  condition:
    $fwoff and $fwrule
}
