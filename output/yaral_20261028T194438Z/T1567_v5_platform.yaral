/*
  MITRE Technique : T1567 - Exfiltration Over Web Service
  Tactic(s)       : Exfiltration
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:54:28.701138+00:00
  Reference       : https://attack.mitre.org/techniques/T1567
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_ESXi_Outbound_Web_Firewall_Ruleset_Enabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an ESXi host firewall change that enables the outbound web client ruleset (httpClient). This is rarely enabled on production hypervisors, and it opens the outbound HTTP/HTTPS path that an adversary needs to push data from the host or its datastores to an external web service. This rule detects the enabling step that precedes exfiltration, not the data transfer itself."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567"
    mitre_technique_name = "Exfiltration Over Web Service"
    log_prerequisites = "ESXi hostd/vobd firewall configuration change messages (for example 'Firewall configuration has changed. Operation enable for rule set httpClient succeeded') forwarded to Chronicle and parsed to SETTING_MODIFICATION with the message text in metadata.description."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators temporarily enabling httpClient to install or update VIBs or patch bundles from an online depot; lifecycle or patch-management automation; backup or monitoring integrations that pull content over HTTPS; host build and provisioning scripts."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Correlate hits with a maintenance or change window, and escalate when the change comes from an unexpected user or shortly follows SSH or shell enablement on the same host."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.description = /firewall configuration has changed.*operation\s+'?enable'?\s+for\s+rule\s*set\s+'?httpClient/ nocase
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1567")
    $primary_entity = array_distinct($setting.principal.hostname)
    $acting_user = array_distinct($setting.principal.user.userid)

  condition:
    $setting
}
