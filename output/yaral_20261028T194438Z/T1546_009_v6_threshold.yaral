/*
  MITRE Technique : T1546.009 - AppCert DLLs
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:12:38.092027+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_009_AppCertDLLs_Registry_Repeated_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated registry modifications to the Session Manager AppCertDLLs key on a single host within ten minutes. Values under this key are loaded into every process that calls CreateProcess-family APIs, so repeated writes suggest an adversary staging, testing or replacing a persistence/privilege-escalation DLL. This rule is registry-based and complements process command-line detections."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.009"
    mitre_technique_name = "Event Triggered Execution: AppCert DLLs"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 13/14 equivalent) normalised to UDM REGISTRY_MODIFICATION with target.registry.registry_key populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare. Legitimate sources include software installers or security products that register an AppCert provider, and administrators performing authorised configuration or troubleshooting. Golden-image and sysprep builds may also write to this key."
    tuning_guidance = "Add approved installers or deployment tooling to %global_allowed_admin_tools and security agents to %global_allowed_security_tools. Add automation identities to %global_allowed_service_accounts. Raise the threshold only if a known product legitimately writes this key several times. Do not exclude by install directory."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control\\Session Manager\\AppCertDLLs/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(80)
    $event_count = count($reg.metadata.id)
    $mitre_technique_id = array_distinct("T1546.009")
    $primary_entity = array_distinct($host)
    $modifying_processes = array_distinct($reg.principal.process.file.full_path)
    $modified_values = array_distinct($reg.target.registry.registry_value_name)
    $acting_users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 2
}
