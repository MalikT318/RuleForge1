/*
  MITRE Technique : T1651 - Cloud Administration Command
  Tactic(s)       : Execution
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:54:00.082491+00:00
  Reference       : https://attack.mitre.org/techniques/T1651
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1651_Cloud_Permission_Change_Then_Remote_Command_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A cloud identity changes permissions or policy assignments and, within 10 minutes, uses the same identity to run a remote command or open a remote session on a virtual machine through the cloud management plane. This pattern fits an adversary who escalates privileges and then abuses VM agents to execute code."
    mitre_tactic = "Execution"
    mitre_technique = "T1651"
    mitre_technique_name = "Cloud Administration Command"
    log_prerequisites = "Cloud control-plane audit logs ingested with management/administrative events enabled, including permission changes and VM command-execution API calls. Requires metadata.product_event_type and principal.user.userid to be populated by the parser."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Cloud administrators granting access and then immediately running maintenance scripts; DevOps pipelines and automation roles that assign roles and run commands in one workflow; break-glass or incident-response activity; onboarding of new workloads or managed-service providers."
    tuning_guidance = "Add expected administrators to %global_allowed_admin_users, automation identities to %global_allowed_service_accounts, and approved service principals to %global_allowed_cloud_principals. Add approved source addresses to %global_allowed_mgmt_sources. Narrow or widen the product_event_type regexes to match the permission-change and command-execution operations your clients actually use."

  events:
    $perm.metadata.event_type = "RESOURCE_PERMISSIONS_CHANGE"
    $perm.metadata.product_event_type = /(Attach|Put|Create).*(Policy|PolicyVersion)|AddUserToGroup|AssumeRole|roleAssignments\/write|setIamPolicy|UpdateAssumeRolePolicy/ nocase
    $perm.principal.user.userid = $user
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_cloud_principals

    $cmd.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cmd.metadata.product_event_type = /(^|\/)(SendCommand|StartSession|StartAutomationExecution)$|virtualMachines\/runCommand\/action|virtualMachines\/runCommands\/write|invokeCommand|runbooks\/draft\/write|compute\.instances\.osLogin/ nocase
    $cmd.principal.user.userid = $user
    not $cmd.principal.user.userid in %global_allowed_admin_users
    not $cmd.principal.user.userid in %global_allowed_service_accounts
    not $cmd.principal.user.userid in %global_allowed_cloud_principals
    not $cmd.principal.ip in %global_allowed_mgmt_sources

    $perm.metadata.event_timestamp.seconds <= $cmd.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1651")
    $primary_entity = array_distinct($user)
    $permission_operations = array_distinct($perm.metadata.product_event_type)
    $command_operations = array_distinct($cmd.metadata.product_event_type)
    $source_ips = array_distinct($cmd.principal.ip)
    $target_resources = array_distinct($cmd.target.resource.name)
    $command_event_count = count($cmd.metadata.id)

  condition:
    $perm and $cmd
}
