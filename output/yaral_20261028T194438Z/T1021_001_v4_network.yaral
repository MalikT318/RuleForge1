/*
  MITRE Technique : T1021.001 - Remote Desktop Protocol
  Tactic(s)       : Lateral Movement
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:35:11.847834+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_001_Outbound_RDP_To_External_Address {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows host establishing an outbound RDP connection (TCP/3389) to a non-internal address. Legitimate RDP lateral movement normally stays inside internal address space, so an external destination suggests RDP over a tunnel or VPN exit, direct access to an exposed host, or use of valid accounts against an externally reachable system. The rule works from network-side telemetry and does not depend on process command lines."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.001"
    mitre_technique_name = "Remote Services: Remote Desktop Protocol"
    log_prerequisites = "Requires Windows endpoint network telemetry (EDR or Sysmon network-connection events) normalised to UDM NETWORK_CONNECTION with target.ip and target.port populated. The %rfc1918_internal reference list must be populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or vendors supporting systems over approved external RDP gateways, cloud-hosted jump hosts or lab VMs with public addresses, managed service provider remote support, and authorised penetration tests or scanners."
    tuning_guidance = "Add approved remote support tooling to %global_allowed_remote_mgmt, approved gateway or jump-host addresses to %global_allowed_mgmt_sources, and authorised scanning hosts to %global_allowed_scanners. Confirm that %rfc1918_internal covers all of the client's internal ranges to avoid noise."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 3389
    $net.target.ip != ""
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1021.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $source_processes = array_distinct($net.principal.process.file.full_path)
    $source_users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
