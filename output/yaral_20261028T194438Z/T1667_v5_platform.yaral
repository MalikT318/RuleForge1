/*
  MITRE Technique : T1667 - Email Bombing
  Tactic(s)       : Impact
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:09:12.768283+00:00
  Reference       : https://attack.mitre.org/techniques/T1667
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

// Note: the request pairs an "alternate platform" angle with a mandatory Windows target. The mandatory Windows platform and log_source take precedence, so this variant pivots on the mechanism instead: script-driven mass mail generation from a Windows host.
rule MSSP_T1667_Scripted_Bulk_Mail_Send_Loop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a PowerShell process whose command line combines a mail-sending API (Send-MailMessage, SmtpClient, Outlook COM automation) with a loop or large-range construct. This is the scripted mass-mail pattern used to flood mailboxes (email bombing) or to generate bulk messages from a compromised Windows host."
    mitre_tactic = "Impact"
    mitre_technique = "T1667"
    mitre_technique_name = "Email Bombing"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 / Windows Event 4688 with command-line auditing enabled. PowerShell must be launched with the script inline or as an encoded or visible command line."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin notification scripts, monitoring or reporting jobs that email many recipients, helpdesk bulk-communication scripts, and legitimate marketing or automation tooling run from PowerShell."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts or %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Raise severity when the host is a workstation outside the IT or messaging admin population."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
    $proc.target.process.command_line = /(send-mailmessage|net\.mail\.smtpclient|system\.net\.mail|outlook\.application|\.createitem\s*\()/ nocase
    $proc.target.process.command_line = /(\bforeach\b|\bfor\s*\(|\bwhile\s*\(|\b\d+\s*\.\.\s*\d{2,}|\|\s*%\s*\{)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1667")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
