/*
  MITRE Technique : T1668 - Exclusive Control
  Tactic(s)       : Persistence
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:11:02.826963+00:00
  Reference       : https://attack.mitre.org/techniques/T1668
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1668_Patching_Binary_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side view of exclusive-control activity: a Windows installer or patching binary (msiexec, wusa, dism, pnputil, expand) opens a connection to an external address. Adversaries who have compromised a host may fetch and apply a patch or installer to close the vulnerability they used, preventing rival actors from re-entering. These binaries rarely reach the internet directly on managed endpoints, because patches normally come from update agents, WSUS, or deployment tooling. This is a proxy for the behaviour rather than proof of it, so triage should check the command line and the patch or package that was installed."
    mitre_tactic = "Persistence"
    mitre_technique = "T1668"
    mitre_technique_name = "Exclusive Control"
    log_prerequisites = "Requires EDR or Sysmon-equivalent network connection telemetry (Sysmon Event ID 3 or equivalent) with the initiating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software deployment or patching agents that call msiexec directly with a remote package URL, admins installing MSI packages from a vendor site, and driver or hotfix installs fetching from vendor CDNs."
    tuning_guidance = "Add approved deployment tooling to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and trusted vendor or update destinations to %global_allowed_domains. If msiexec network use is common in a client estate, scope the rule to non-service accounts or raise severity only when the parent process is an interpreter."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(msiexec|wusa|dism|pnputil|expand)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1668")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
