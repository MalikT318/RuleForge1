/*
  MITRE Technique : T1070.004 - File Deletion
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:06:29.253298+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_004_Mass_Staging_Artifact_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a single Windows host where many executable, script or archive files are deleted from user-writable staging locations (Temp, ProgramData, Public, AppData) within ten minutes. One such deletion is routine; a burst by a non-allowlisted process suggests an adversary or malware removing dropped tools and payloads. This rule uses FILE_DELETION telemetry, not process command lines."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.004"
    mitre_technique_name = "Indicator Removal: File Deletion"
    log_prerequisites = "Requires EDR or Sysmon-equivalent file deletion telemetry (for example Sysmon Event ID 23/26) normalised to UDM FILE_DELETION with principal.process.file.full_path and target.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters cleaning extracted payloads, browser and collaboration-app auto-updates, endpoint agents, build and CI jobs on developer workstations, RMM or patching tools, disk cleanup utilities."
    tuning_guidance = "Add approved deployment and cleanup tooling to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, and approved backup or imaging software to %global_allowed_backup_processes. Raise the #file threshold on build servers or developer hosts. Extend the deleter-name exclusion regex for client-specific updaters."

  events:
    $file.metadata.event_type = "FILE_DELETION"
    $file.principal.hostname = $host
    $file.target.file.full_path = /\\(windows\\temp|programdata|users\\public|users\\[^\\]+\\appdata\\(local|roaming))\\/ nocase
    $file.target.file.full_path = /\.(exe|dll|scr|sys|ps1|psm1|bat|cmd|vbs|vbe|js|jse|hta|wsf|zip|7z|rar|cab)$/ nocase
    not $file.principal.process.file.full_path = /\\(msiexec|trustedinstaller|tiworker|msmpeng|setup[^\\]*|[^\\]*update[^\\]*|[^\\]*installer[^\\]*|chrome|msedge|firefox|teams|onedrive)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($file.target.file.full_path = /(?i)\.(exe|dll|scr|sys)$/, 70, 55))
    $deleted_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1070.004")
    $primary_entity = array_distinct($host)
    $deleting_processes = array_distinct($file.principal.process.file.full_path)
    $deleting_users = array_distinct($file.principal.user.userid)
    $sample_deleted_files = array_distinct($file.target.file.full_path)

  condition:
    #file >= 15
}
