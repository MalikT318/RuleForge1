/*
  MITRE Technique : T1496.001 - Compute Hijacking
  Tactic(s)       : Impact
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:53:26.145339+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_001_Container_Cryptominer_Cmdline_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated process launches on a single Linux container host or node within 10 minutes whose command lines carry cryptocurrency-mining behaviour: mining-pool protocol URIs or mining-specific CPU, algorithm and donation options. One such launch can be a test or a false match. Repeated launches indicate a miner running or being redeployed across containers on the host."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.001"
    mitre_technique_name = "Resource Hijacking: Compute Hijacking"
    log_prerequisites = "Container runtime process telemetry or Kubernetes node-level process events normalised to UDM PROCESS_LAUNCH, with principal.hostname and target.process.command_line populated."
    platform = "Linux"
    log_source = "container"
    false_positives = "Authorised cryptocurrency or blockchain research workloads, performance and benchmarking containers, security red-team exercises, and CI jobs that test mining-detection tooling."
    tuning_guidance = "Add approved benchmarking or blockchain tooling binaries to %global_allowed_admin_tools. Add EDR or runtime-security agents to %global_allowed_security_tools. Add authorised testing sources to %global_allowed_scanners. Raise the threshold from 3 for noisy clusters, or lower it to 2 for high-security namespaces."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(stratum(2)?(\+(tcp|ssl|tls))?:\/\/|--donate-level|--cpu-priority|--max-cpu-usage|--coin[= ]|--algo(rithm)?[= ]\s*(rx|randomx|cn|kawpow|ethash|etchash|argon2|yespower)|--(randomx|cuda|opencl)(-|\s|=)|\s--?(o|url)\s+\S+:[0-9]{3,5}\s.*\s--?(u|user)\s)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_scanners

  match:
    $host over 10m

  outcome:
    $risk_score = max(80)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1496.001")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $miner_processes = array_distinct($proc.target.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
