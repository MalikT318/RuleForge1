/*
  MITRE Technique : T1095 - Non-Application Layer Protocol
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:37:22.813909+00:00
  Reference       : https://attack.mitre.org/techniques/T1095
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1095_ESXi_Raw_Socket_Utility_Listener_Or_Exec {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a raw socket relay utility (netcat/socat-style) launched on an ESXi host with listen, UDP, or command-execution options, or any process whose command line uses relay address syntax (TCP-LISTEN, UDP-CONNECT, EXEC:, SOCKS). These are direct non-application-layer C2 channels, reverse shells, or tunnels from the hypervisor shell. They bypass hostd/management-plane logging and are rarely used by legitimate ESXi administration."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1095"
    mitre_technique_name = "Non-Application Layer Protocol"
    log_prerequisites = "ESXi shell command auditing (shell.log / syslog forwarding of executed commands) parsed into UDM PROCESS_LAUNCH events with target.process.command_line populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators using nc to test port reachability or storage/vMotion network connectivity from the ESXi shell (usually -z or -w only, which this rule ignores, but some use -l or -u), vendor support troubleshooting sessions, and approved automation that uses socat or nc for backup or monitoring relays."
    tuning_guidance = "Add approved parent processes or automation wrappers to %global_allowed_admin_tools and named administrator accounts to %global_allowed_admin_users. Review the user and parent shell for each hit. Confirm whether SSH was recently enabled on the host and whether the destination is outside management networks."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $proc.target.process.file.full_path = /\/(nc|ncat|netcat|socat)$/ nocase and
        $proc.target.process.command_line = /\s-[a-z]*[luec][a-z]*(\s|$)|\s--(listen|udp|exec|sh-exec)/ nocase
      )
      or
      $proc.target.process.command_line = /\b(tcp|udp)[46]?-(listen|l|connect):|\bexec:|\bsocks[45]a?:/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1095")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $process_path = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
