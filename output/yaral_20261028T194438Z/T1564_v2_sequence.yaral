/*
  MITRE Technique : T1564 - Hide Artifacts
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:12:14.164705+00:00
  Reference       : https://attack.mitre.org/techniques/T1564
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_Linux_Hidden_Drop_Then_LdPreload_Tamper {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a hidden (dot-prefixed) file created in a world-writable staging directory (/tmp, /var/tmp, /dev/shm), followed within 10 minutes by a modification of /etc/ld.so.preload on the same host. This pattern is typical of userland rootkits that stage a shared object and then preload it to hide files, processes and network activity from system tools. The rule uses file telemetry only and does not rely on command lines."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564"
    mitre_technique_name = "Hide Artifacts"
    log_prerequisites = "Requires Linux EDR or auditd file telemetry that populates FILE_CREATION and FILE_MODIFICATION events with target.file.full_path and principal.hostname. auditd needs a watch on /etc/ld.so.preload and on the temp directories."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software installers or hardening and performance tools that legitimately use LD_PRELOAD (some memory allocators, APM agents, security agents). Build and CI systems that create hidden temp files and also configure preload libraries. Admins manually configuring a preload library."
    tuning_guidance = "Add approved installers, configuration management and deployment binaries to %global_allowed_admin_tools. Add EDR, APM and security agent binaries to %global_allowed_security_tools. Raise the risk score if the process that modifies ld.so.preload is also the process that created the hidden file."

  events:
    $drop.metadata.event_type = "FILE_CREATION"
    $drop.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/(.+\/)?\.[^\/.][^\/]*$/ nocase
    not $drop.target.file.full_path = /\/\.(X11-unix|ICE-unix|font-unix|XIM-unix|Test-unix)\// nocase
    not $drop.principal.process.file.full_path in %global_allowed_admin_tools
    not $drop.principal.process.file.full_path in %global_allowed_security_tools
    $drop.principal.hostname = $hostname

    $preload.metadata.event_type = "FILE_MODIFICATION"
    $preload.target.file.full_path = /^\/etc\/ld\.so\.preload$/ nocase
    not $preload.principal.process.file.full_path in %global_allowed_admin_tools
    not $preload.principal.process.file.full_path in %global_allowed_security_tools
    $preload.principal.hostname = $hostname

    $drop.metadata.event_timestamp.seconds <= $preload.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1564")
    $primary_entity = array_distinct($hostname)
    $hidden_files = array_distinct($drop.target.file.full_path)
    $dropping_process = array_distinct($drop.principal.process.file.full_path)
    $preload_modifier = array_distinct($preload.principal.process.file.full_path)
    $preload_user = array_distinct($preload.principal.user.userid)
    $hidden_file_count = count($drop.metadata.id)

  condition:
    $drop and $preload
}
