/*
  MITRE Technique : T1027.008 - Stripped Payloads
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:50:39.008930+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_008_Stripped_Payload_Binary_Download_NonBrowser {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a successful HTTP download of a Windows executable payload (PE-type file extension) from an external host by a scripting or programmatic HTTP client rather than a browser. Stripped, compiled payloads (for example, symbol-stripped Go or native binaries) are commonly fetched this way by loaders and droppers. The rule observes the network behaviour only and does not depend on process or command-line telemetry."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.008"
    mitre_technique_name = "Obfuscated Files or Information: Stripped Payloads"
    log_prerequisites = "Requires proxy or perimeter firewall logs with HTTP inspection that populate target.url, network.http.user_agent, network.http.method and network.http.response_code. TLS inspection is needed to see HTTPS URLs. Reference lists %rfc1918_internal and %global_allowed_domains must be populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Software deployment and patching tools that fetch installers with programmatic HTTP clients, developer or CI workstations downloading build artefacts, package managers, vendor update services not yet in the allowlist, and admin PowerShell scripts that download approved installers."
    tuning_guidance = "Add known-good vendor and update domains to %global_allowed_domains. Confirm %rfc1918_internal covers all internal ranges for the client. If CI or build servers generate noise, exclude them at ingestion or by a client-specific copy of this rule. Extend or trim the user-agent and extension lists per client."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.network.http.response_code = 200
    $net.target.url = /\.(exe|dll|scr|sys|cpl|msi)(\?.*)?$/ nocase
    $net.network.http.user_agent = /(go-http-client|python-requests|python-urllib|winhttp|powershell|curl|wget|libwww|java\/|okhttp)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1027.008")
    $primary_entity = array_distinct($net.principal.ip)
    $download_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
