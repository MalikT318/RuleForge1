/*
  MITRE Technique : T1574 - Hijack Execution Flow
  Tactic(s)       : Stealth, Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:27:15.938497+00:00
  Reference       : https://attack.mitre.org/techniques/T1574
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_Windows_System_Binary_Outside_System_Paths_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a core Windows system binary (svchost, dllhost, taskhostw, spoolsv, wmiprvse and similar) making an outbound connection to an external address while running from outside the Windows system directories. Legitimate copies of these binaries only run from System32, SysWOW64 or WinSxS. Network activity from a copy in any other location indicates a planted binary, search-order or PATH hijack, or sideloaded execution that is now beaconing."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574"
    mitre_technique_name = "Hijack Execution Flow"
    log_prerequisites = "Requires endpoint network telemetry with the initiating process path populated (EDR network events or Sysmon Event ID 3), normalised to UDM NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Unusual image paths during servicing or in-place upgrades, offline-image or WinPE tooling, application-bundled copies of native binaries, and security or deployment tools that stage system binaries in non-standard locations."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools and deployment or imaging tooling to %global_allowed_admin_tools, matched on process path. Extend the binary-name list for client-specific environments. Review hosts that fire repeatedly, since a legitimate application bundling its own copy will recur consistently."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(svchost|dllhost|taskhostw|spoolsv|wmiprvse|conhost|searchindexer|sihost|runtimebroker|smss|csrss|wininit|services|lsass|winlogon|audiodg)\.exe$/ nocase
    not $net.principal.process.file.full_path = /\\windows\\(system32|syswow64|winsxs)\\/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1574")
    $primary_entity = array_distinct($net.principal.hostname)
    $process_paths = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
