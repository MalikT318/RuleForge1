/*
  MITRE Technique : T1620 - Reflective Code Loading
  Tactic(s)       : Stealth
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:45:22.382212+00:00
  Reference       : https://attack.mitre.org/techniques/T1620
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1620_Linux_Exec_From_Anonymous_Memory_File {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux process launched from an anonymous in-memory file (memfd_create) or from a /proc/<pid>/fd/<n> file descriptor path. This is the standard fileless-ELF reflective loading pattern, where a payload is written to RAM and executed through fexecve or execve on a descriptor path, so no file-backed binary exists on disk."
    mitre_tactic = "Stealth"
    mitre_technique = "T1620"
    mitre_technique_name = "Reflective Code Loading"
    log_prerequisites = "Linux EDR or auditd (execve records with resolved executable path) normalised to UDM PROCESS_LAUNCH with target.process.file.full_path and target.process.command_line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Container runtimes (runc/crun) re-executing a sealed memfd copy of themselves during container start, some software packagers and installers that stage binaries in memfd, JIT or sandbox frameworks that fexecve from descriptors, and legitimate security or EDR agents."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools and endpoint security agents to %global_allowed_security_tools. If container hosts are noisy, confirm the runtime exclusion regex matches your runtime binary names. Enrich with the parent process and user to separate container start-up from interactive shell execution."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $proc.target.process.file.full_path = /^\/(memfd:|proc\/(self|\d+)\/fd\/\d+)/ nocase or
      $proc.target.process.command_line = /^\/(memfd:|proc\/(self|\d+)\/fd\/\d+)/ nocase
    )
    not $proc.target.process.file.full_path = /^\/memfd:runc/ nocase
    not $proc.principal.process.file.full_path = /\/(runc|crun|containerd-shim[^\/]*|conmon)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1620")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $executed_path = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
