/*
  MITRE Technique : T1204.001 - Malicious Link
  Tactic(s)       : Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:00:06.634982+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_001_Linux_Browser_Bulk_Executable_Downloads {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a browser process writing several executable or script-type files (shell scripts, AppImages, .run installers, packages, ELF/binary blobs, Python/Perl scripts, shared objects) to user download or temporary locations on one Linux host within 10 minutes. A single download is routine, but a burst of executable content from a browser is consistent with a user following a malicious link that delivers payloads, which is the precursor to user-driven execution. This is file-creation based and does not overlap with process command-line detections."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.001"
    mitre_technique_name = "User Execution: Malicious Link"
    log_prerequisites = "Linux EDR or auditd file-creation telemetry with the creating process path populated and normalized to UDM FILE_CREATION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers or admins downloading several installers, packages or scripts in one session; software vendors distributing multi-file installers via the browser; training or lab environments; browser extensions or updaters that write helper binaries to /tmp."
    tuning_guidance = "Add named admin or developer accounts to %global_allowed_admin_users and security or EDR agents to %global_allowed_security_tools. Raise the threshold (#file >= 3) on developer-heavy hosts, or narrow the extension list. If your telemetry records browser-temporary names such as .part or .crdownload, tune the extension regex or add FILE_MOVE coverage separately."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(firefox|firefox-bin|chrome|google-chrome|chromium|chromium-browser|brave|brave-browser|opera|vivaldi|msedge|microsoft-edge)(-stable|-bin)?$/ nocase
    $file.target.file.full_path = /^(\/home\/[^\/]+\/(Downloads|Desktop)\/|\/root\/Downloads\/|\/tmp\/|\/var\/tmp\/|\/dev\/shm\/)/ nocase
    $file.target.file.full_path = /\.(sh|run|appimage|bin|elf|deb|rpm|py|pl|jar|so)$/ nocase
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($file.target.file.full_path = /\.(sh|run|appimage|elf|bin)$/ nocase, 75, 60))
    $mitre_technique_id = array_distinct("T1204.001")
    $primary_entity = array_distinct($host)
    $file_count = count($file.metadata.id)
    $created_files = array_distinct($file.target.file.full_path)
    $users = array_distinct($file.principal.user.userid)
    $browser_processes = array_distinct($file.principal.process.file.full_path)

  condition:
    #file >= 3
}
