/*
  MITRE Technique : T1564.012 - File/Path Exclusions
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:31:50.750670+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_012_Server_Parent_Shell_AV_Excluded_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server or database service process spawning a shell or script interpreter whose command line stages or executes content in directories commonly excluded from AV and file scanning on Linux (/dev/shm, /proc, container and database data directories, spool and cache paths). Service daemons should not spawn interpreters that work in scanner-excluded paths, so this lineage anomaly points to a payload being hidden in an exclusion zone after service exploitation or webshell use."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.012"
    mitre_technique_name = "Hide Artifacts: File/Path Exclusions"
    log_prerequisites = "Linux EDR or auditd process execution telemetry that populates both the parent (principal.process) and child (target.process) executable paths and the child command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Database maintenance or backup hooks run from mysqld/postgres (for example archive_command or logrotate-style scripts), CMS or PHP applications that shell out to handle uploads or cache files, Tomcat or Java-based deployment scripts, and container or orchestration agents that legitimately use /var/lib/docker paths."
    tuning_guidance = "Add approved parent processes and hosts to %global_allowed_script_hosts and approved tooling binaries to %global_allowed_admin_tools. Extend the parent daemon regex with site-specific service binaries. Narrow the excluded-path regex to match the exclusion paths actually configured in the client's AV or scanning policy (for example ClamAV ExcludePath entries)."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|php-fpm[0-9.]*|lighttpd|tomcat[0-9]*|mysqld|mariadbd|postgres|mongod|redis-server)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ash|ksh|python[0-9.]*|perl|ruby|php[0-9.]*)$/ nocase
    $proc.target.process.command_line = /(\/dev\/shm|\/proc\/[0-9]+|\/var\/lib\/(docker|containerd|mysql|postgresql|clamav|lxcfs)|\/var\/cache|\/var\/spool|\/run\/user)\// nocase
    $proc.target.process.command_line = /(chmod|curl|wget|\bcp\b|\bmv\b|\btee\b|\bdd\b|base64|>>?\s*\S|nohup)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.hostname in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1564.012")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
