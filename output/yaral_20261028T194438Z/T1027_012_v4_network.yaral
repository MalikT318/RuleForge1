/*
  MITRE Technique : T1027.012 - LNK Icon Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:57:39.051346+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_012_LNK_Icon_Fetch_Explorer_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the network side of LNK icon smuggling: the Windows shell (explorer.exe) making an HTTP request to an external host for a binary, library, or icon-type resource. Opening or rendering a shortcut whose IconLocation points at a remote URL makes the shell fetch that resource. Legitimate shell activity rarely requests these file types directly from the internet."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.012"
    mitre_technique_name = "Obfuscated Files or Information: LNK Icon Smuggling"
    log_prerequisites = "Requires endpoint telemetry (EDR or Sysmon-equivalent) that records the originating process on HTTP requests, populating principal.process.file.full_path, target.url, and target.hostname. Proxy logs without process attribution will not match."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Users browsing or opening files from web-based shares through the shell; software installers or updaters launched from Explorer that fetch .exe or .dll files; Office or shell add-ins retrieving remote icons from vendor CDNs not yet in the allowlist; remote-hosted corporate shortcuts."
    tuning_guidance = "Add known-good vendor and CDN domains to %global_allowed_domains. Make sure %rfc1918_internal covers all internal address space for the client. If a specific extension is noisy for a client, remove it from the URL regex. Consider also alerting separately on SMB or WebDAV icon paths where the data source supports them."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.principal.process.file.full_path = /\\explorer\.exe$/ nocase
    $net.target.url = /^https?:\/\/[^\/]+\/.*\.(ico|dll|exe|cpl|scr|dat|bin)(\?.*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.012")
    $primary_entity = array_distinct($net.principal.hostname)
    $requested_urls = array_distinct($net.target.url)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $affected_users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
