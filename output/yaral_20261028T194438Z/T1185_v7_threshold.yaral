/*
  MITRE Technique : T1185 - Browser Session Hijacking
  Tactic(s)       : Collection
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:32:20.624776+00:00
  Reference       : https://attack.mitre.org/techniques/T1185
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1185_Browser_Process_Handle_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single host shows repeated handle-open activity from non-browser, non-security processes against browser processes within 10 minutes. A single process open is routine. Volume suggests browser pivoting, injection staging, or session and cookie theft (Man-in-the-Browser) of the kind used for browser session hijacking."
    mitre_tactic = "Collection"
    mitre_technique = "T1185"
    mitre_technique_name = "Browser Session Hijacking"
    log_prerequisites = "Requires Windows endpoint process-access telemetry (EDR or Sysmon process access, normalised to PROCESS_OPEN) with populated principal and target process paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Accessibility and screen-reader software, screen-sharing and remote-support agents, password managers, DLP and EDR agents not yet allowlisted, browser updaters and installers, UI automation and test frameworks (e.g. Selenium helpers, RPA bots), and developer debugging tools."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools, RMM and support tooling to %global_allowed_admin_tools, and backup agents to %global_allowed_backup_processes. Raise the #open threshold for hosts running RPA or UI-automation workloads. Lower it on high-value hosts such as admin workstations and jump servers."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\(chrome|msedge|firefox|brave|opera|vivaldi|iexplore)\.exe$/ nocase
    not $open.principal.process.file.full_path = /\\(chrome|msedge|firefox|brave|opera|vivaldi|iexplore|chrome_proxy|msedgewebview2|csrss|wininit|services|svchost|lsass|MsMpEng|MsSense|SenseIR|taskmgr|werfault)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    $open.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $open_count = count($open.metadata.id)
    $mitre_technique_id = array_distinct("T1185")
    $primary_entity = array_distinct($host)
    $source_processes = array_distinct($open.principal.process.file.full_path)
    $targeted_browsers = array_distinct($open.target.process.file.full_path)
    $users = array_distinct($open.principal.user.userid)

  condition:
    #open >= 8
}
