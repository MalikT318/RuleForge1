/*
  MITRE Technique : T1606 - Forge Web Credentials
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:22:17.136480+00:00
  Reference       : https://attack.mitre.org/techniques/T1606
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1606_IaaS_Federation_Trust_Or_Token_Signing_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of identity federation trust settings, SAML/WS-Fed identity provider configuration, or token-signing certificates in the cloud control plane. Adversaries use these changes to mint forged SAML assertions or tokens (Golden SAML style) that are accepted as valid credentials for cloud and web resources. Cloud-native detection that does not depend on endpoint process telemetry."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1606"
    mitre_technique_name = "Forge Web Credentials"
    log_prerequisites = "Requires cloud identity/directory audit logs (federation, domain authentication and token-signing configuration changes) ingested and normalised to UDM SETTING_MODIFICATION with metadata.product_event_type populated."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Planned federation onboarding or migration projects, scheduled token-signing certificate rotation, M&A domain integration, authorised identity engineering changes, and IaC pipelines managing identity provider configuration."
    tuning_guidance = "Add approved identity administrators to %global_allowed_admin_users and automation or IaC identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Validate that the client's audit logs map federation changes to SETTING_MODIFICATION. If they map to another event type, clone the rule for that type rather than OR-ing event types. Correlate with change-management tickets before escalation."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(set|update|add|create|new|modify|change|replace|rollover).{0,30}(federat|domain authentication|token.?signing|signing.?cert|trusted.?realm|saml.?(idp|provider|config)|identity.?provider|sso.?config)/ nocase
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1606")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $change_action = array_distinct($setting.metadata.product_event_type)
    $source_ips = array_distinct($setting.principal.ip)
    $target_resources = array_distinct($setting.target.resource.name)

  condition:
    $setting
}
