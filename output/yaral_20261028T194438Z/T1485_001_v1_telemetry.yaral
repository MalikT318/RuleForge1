/*
  MITRE Technique : T1485.001 - Lifecycle-Triggered Deletion
  Tactic(s)       : Impact
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:37:07.723894+00:00
  Reference       : https://attack.mitre.org/techniques/T1485/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1485_001_Bucket_Lifecycle_Policy_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change to an object storage bucket's lifecycle or retention-management policy via the cloud control plane. Adversaries with lifecycle-edit permission can apply an expiration rule that deletes every object in a bucket within a day, destroying data for extortion or wiping log buckets. This rule alerts on the resulting policy state change, not on any CLI or process activity."
    mitre_tactic = "Impact"
    mitre_technique = "T1485.001"
    mitre_technique_name = "Data Destruction: Lifecycle-Triggered Deletion"
    log_prerequisites = "Requires cloud control-plane audit logs with storage management API calls (bucket lifecycle and management-policy writes) normalized to UDM SETTING_MODIFICATION, with metadata.product_event_type populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Storage or platform teams tuning cost-optimisation tiering and expiration rules; infrastructure-as-code pipelines applying bucket configuration; initial bucket provisioning by automation; on some providers, generic bucket update calls that change unrelated bucket settings."
    tuning_guidance = "Add CI/CD, IaC and storage-governance identities to %global_allowed_service_accounts, and approved cloud automation roles to %global_allowed_cloud_principals. Add named storage administrators to %global_allowed_admin_users. Because the rule cannot see the expiration value, review the target bucket and actor in triage. Prioritise alerts on log-archive and backup buckets, and on actors with no history of lifecycle changes."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /(PutBucketLifecycle|storage\.buckets\.(update|patch)|managementPolicies\/write)/ nocase
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1485.001")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_calls = array_distinct($cloud.metadata.product_event_type)
    $target_buckets = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
