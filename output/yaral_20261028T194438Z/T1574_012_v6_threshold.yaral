/*
  MITRE Technique : T1574.012 - COR_PROFILER
  Tactic(s)       : Stealth, Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:44:34.442545+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_012_COR_PROFILER_Registry_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Multiple registry writes to .NET profiler environment variables (COR_ENABLE_PROFILING, COR_PROFILER, COR_PROFILER_PATH and CoreCLR equivalents) under an Environment key on a single host within 10 minutes. A single write may be a developer action, but setting the enable flag, profiler CLSID and DLL path together indicates COR_PROFILER hijacking for persistence or privilege escalation."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.012"
    mitre_technique_name = "Hijack Execution Flow: COR_PROFILER"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events 12/13/14) normalised to REGISTRY_MODIFICATION, with registry_key populated for the Environment keys (HKCU\\Environment and HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Environment)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developers or performance engineers configuring .NET profilers locally; APM and observability agents (application performance monitoring, code-coverage tools, memory profilers) that register a profiler at install time; IDE or debugger installers; software deployment tooling setting machine-wide environment variables."
    tuning_guidance = "Add approved APM, deployment or profiling tool binaries to %global_allowed_admin_tools and security agents to %global_allowed_security_tools. Add change-managed administrator accounts to %global_allowed_admin_users. Raise the threshold above 2 in environments with frequent developer profiling, or lower it to 1 on locked-down servers. Machine-wide (HKLM) writes on production servers should be reviewed first."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      $reg.target.registry.registry_key = /\\Environment\\(COR_ENABLE_PROFILING|COR_PROFILER|COR_PROFILER_PATH(_32|_64)?|CORECLR_ENABLE_PROFILING|CORECLR_PROFILER|CORECLR_PROFILER_PATH(_32|_64)?)$/ nocase or
      (
        $reg.target.registry.registry_key = /\\Environment$/ nocase and
        $reg.target.registry.registry_value_name = /^(COR_ENABLE_PROFILING|COR_PROFILER|COR_PROFILER_PATH(_32|_64)?|CORECLR_ENABLE_PROFILING|CORECLR_PROFILER|CORECLR_PROFILER_PATH(_32|_64)?)$/ nocase
      )
    )
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($reg.target.registry.registry_key = /PROFILER_PATH/ nocase or $reg.target.registry.registry_value_name = /PROFILER_PATH/ nocase, 90, 75))
    $event_count = count($reg.metadata.id)
    $mitre_technique_id = array_distinct("T1574.012")
    $primary_entity = array_distinct($host)
    $modified_keys = array_distinct($reg.target.registry.registry_key)
    $modified_values = array_distinct($reg.target.registry.registry_value_name)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $actor_users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 2
}
