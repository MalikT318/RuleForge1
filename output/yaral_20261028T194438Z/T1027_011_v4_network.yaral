/*
  MITRE Technique : T1027.011 - Fileless Storage
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:55:50.829103+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_011_Linux_Network_Conn_From_Shared_Memory_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound connection to an external address made by a process whose executable image lives in a Linux fileless-storage location (/dev/shm, /run/shm, /var/run, /var/lock) or in an anonymous memfd mapping. Payloads staged in RAM-backed directories and then beaconing out, downloading, or joining a botnet are a common result of fileless storage abuse. This is a network-side view and does not depend on command-line matching."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.011"
    mitre_technique_name = "Obfuscated Files or Information: Fileless Storage"
    log_prerequisites = "Requires Linux endpoint network telemetry (EDR or auditd socket/connect events) that populates principal.process.file.full_path on NETWORK_CONNECTION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software that legitimately runs helper binaries from /run or /var/run (some container runtimes, snap/flatpak helpers, init-time agents), JIT or self-extracting installers that stage in /dev/shm, and in-memory backup or deployment tooling that executes from memfd."
    tuning_guidance = "Add approved agent and deployment binaries to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, and backup agents to %global_allowed_backup_processes. Internal destinations are excluded via %rfc1918_internal. Review hosts running container runtimes first, as they are the most likely source of noise, and then tune by process path."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\/(dev\/shm|run\/shm|var\/run|var\/lock)\/|^\/memfd:/ nocase
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.011")
    $primary_entity = array_distinct($net.principal.hostname)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
