/*
  MITRE Technique : T1611 - Escape to Host
  Tactic(s)       : Privilege Escalation
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:30:43.678847+00:00
  Reference       : https://attack.mitre.org/techniques/T1611
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1611_Privileged_Container_Host_Access_Launch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a container runtime CLI launching a container with --privileged combined with a host root bind mount, host PID namespace, or a mounted container management socket. This is the most direct precondition for escaping to the underlying host, for example chroot into the mounted root, writing host cron or systemd units, or loading kernel modules."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1611"
    mitre_technique_name = "Escape to Host"
    log_prerequisites = "Requires Linux process launch telemetry with full command lines (EDR or auditd execve) from container hosts or Kubernetes nodes, normalised to PROCESS_LAUNCH."
    platform = "Linux"
    log_source = "container"
    false_positives = "Legitimate privileged system containers (CNI/CSI plugins, node monitoring agents, Docker-in-Docker CI runners), platform engineers debugging nodes, and image build or bootstrap scripts run by configuration management."
    tuning_guidance = "Add approved automation parents or CI tooling to %global_allowed_admin_tools, approved service accounts to %global_allowed_service_accounts, and node security agents to %global_allowed_security_tools. Review recurring hits per host and allowlist the launching parent, not the command line."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(docker|podman|nerdctl|ctr)$/ nocase
    $proc.target.process.command_line = /\b(run|create)\b/ nocase
    $proc.target.process.command_line = /--privileged/ nocase
    $proc.target.process.command_line = /((-v|--volume)(=|\s+)\/:|(source|src)=\/(,|\s|$)|--pid(=|\s+)host|docker\.sock|containerd\.sock)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1611")
    $primary_entity = array_distinct($proc.principal.hostname)
    $launching_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
