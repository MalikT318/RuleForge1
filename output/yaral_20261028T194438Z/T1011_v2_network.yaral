/*
  MITRE Technique : T1011 - Exfiltration Over Other Network Medium
  Tactic(s)       : Exfiltration
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:19:50.873079+00:00
  Reference       : https://attack.mitre.org/techniques/T1011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1011_Large_Outbound_Transfer_Nonstandard_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Perimeter log shows an internal host sending a large volume of data to an external destination on a non-web, non-DNS port with almost no response data. This one-sided bulk upload is characteristic of data leaving over an alternate channel such as a tethered or secondary uplink, or a non-C2 egress path. A firewall cannot see the physical medium, so the rule detects the network-observable result. Scope it to Windows host address ranges per client."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1011"
    mitre_technique_name = "Exfiltration Over Other Network Medium"
    log_prerequisites = "Firewall, proxy or perimeter logs normalised to UDM NETWORK_CONNECTION with target.ip, target.port, network.sent_bytes and network.received_bytes populated. Session-end or byte-count logging must be enabled on the firewall."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Offsite backup and replication jobs, cloud sync clients on custom ports, software and OS update distribution, large SFTP or FTP transfers by IT or business partners, video conferencing or streaming uplinks over UDP, developer pushes to external repositories on alternate ports."
    tuning_guidance = "Add known-good destination domains to %global_allowed_domains. Raise or lower the sent_bytes threshold per client baseline. Extend the excluded port list for client-approved services. Scope the rule to Windows host address ranges where asset context exists."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip in %rfc1918_internal
    not $net.target.ip in %rfc1918_internal
    $net.target.port > 0
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 53
    $net.target.port != 8080
    $net.target.port != 8443
    $net.network.sent_bytes >= 52428800
    $net.network.received_bytes < 1048576
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1011")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
