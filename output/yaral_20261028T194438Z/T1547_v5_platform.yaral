/*
  MITRE Technique : T1547 - Boot or Logon Autostart Execution
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:22:31.101764+00:00
  Reference       : https://attack.mitre.org/techniques/T1547
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_Winlogon_LSA_SessionMgr_Registry_Autostart {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modification of boot and logon autostart hooks that run code in privileged contexts: Winlogon Shell/Userinit/Taskman/AppSetup, LSA Authentication, Security and Notification Packages, Session Manager BootExecute/SetupExecute/PlatformExecute, and W32Time TimeProvider DllName. This is registry-based and does not duplicate command-line rules. The brief's alternate-platform angle conflicts with the mandatory Windows target, so the platform stays Windows and the angle is applied as a different telemetry source (registry modification instead of process creation)."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547"
    mitre_technique_name = "Boot or Logon Autostart Execution"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event IDs 12/13 or equivalent) normalised to REGISTRY_MODIFICATION with target.registry.registry_key and registry_value_name populated. Registry auditing must cover HKLM\\SYSTEM\\CurrentControlSet\\Control and HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows servicing (TrustedInstaller/TiWorker) updating Session Manager values, enterprise security or credential-provider products registering LSA notification or authentication packages, password-filter installs (for example password policy enforcement tools), domain time-sync tooling changing W32Time providers, and IT deployment tooling that legitimately customises the Winlogon shell."
    tuning_guidance = "Add approved installers and deployment tools to %global_allowed_admin_tools and security agents to %global_allowed_security_tools. Approved administrators can be added to %global_allowed_admin_users. If a client uses a custom shell (kiosk) or an approved LSA package, exclude on principal process name rather than on the value data."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      (
        $reg.target.registry.registry_key = /\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon$/ nocase and
        $reg.target.registry.registry_value_name = /^(Shell|Userinit|Taskman|AppSetup|GinaDLL)$/ nocase and
        not $reg.target.registry.registry_value_data = /^(([a-z]:\\windows\\system32\\)?userinit\.exe,?|explorer\.exe)$/ nocase
      ) or
      (
        $reg.target.registry.registry_key = /\\Control\\Lsa$/ nocase and
        $reg.target.registry.registry_value_name = /^(Authentication Packages|Security Packages|Notification Packages)$/ nocase
      ) or
      (
        $reg.target.registry.registry_key = /\\Control\\Session Manager$/ nocase and
        $reg.target.registry.registry_value_name = /^(BootExecute|SetupExecute|PlatformExecute|S0InitialCommand)$/ nocase
      ) or
      (
        $reg.target.registry.registry_key = /\\Services\\W32Time\\TimeProviders\\[^\\]+$/ nocase and
        $reg.target.registry.registry_value_name = /^DllName$/ nocase
      )
    )
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $modified_value_name = array_distinct($reg.target.registry.registry_value_name)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
