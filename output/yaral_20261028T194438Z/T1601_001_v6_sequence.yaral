/*
  MITRE Technique : T1601.001 - Patch System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:13:38.249553+00:00
  Reference       : https://attack.mitre.org/techniques/T1601/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_001_Mgmt_Login_Then_Image_Transfer_Protocol {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A network device receives an SSH or Telnet management session from a source that is not an approved management source, then within 10 minutes initiates a TFTP or FTP transfer. This pattern matches an operator pulling a replacement OS image onto the device, as in system image patching. Visibility is limited to what the perimeter or firewall logs show: the management session and the file-transfer protocol flow."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1601.001"
    mitre_technique_name = "Modify System Image: Patch System Image"
    log_prerequisites = "Firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. The network device's own management-plane traffic must traverse or be logged by the sensor. Rule is blind to out-of-band console access and to transfers that bypass the logging sensor."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Planned firmware upgrades by network engineers connecting from jump hosts not yet in the approved list; automated configuration or backup tooling that uses TFTP/FTP to push or pull configs; zero-touch provisioning of new devices; vulnerability scanners probing management ports."
    tuning_guidance = "Add jump hosts, bastions and NMS source addresses to %global_allowed_mgmt_sources. This list also suppresses approved image or config servers on the transfer leg. Add scanner sources to %global_allowed_scanners. Suppress planned maintenance windows through client-side exceptions. Widen or narrow the 10m window per client change-management practice."

  events:
    $mgmt.metadata.event_type = "NETWORK_CONNECTION"
    ($mgmt.target.port = 22 or $mgmt.target.port = 23)
    not $mgmt.principal.ip in %global_allowed_mgmt_sources
    not $mgmt.principal.ip in %global_allowed_scanners
    $mgmt.target.ip = $device

    $xfer.metadata.event_type = "NETWORK_CONNECTION"
    ($xfer.target.port = 69 or $xfer.target.port = 21)
    not $xfer.target.ip in %global_allowed_mgmt_sources
    $xfer.principal.ip = $device

    $mgmt.metadata.event_timestamp.seconds <= $xfer.metadata.event_timestamp.seconds

  match:
    $device over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1601.001")
    $primary_entity = array_distinct($device)
    $mgmt_sources = array_distinct($mgmt.principal.ip)
    $transfer_servers = array_distinct($xfer.target.ip)
    $transfer_ports = array_distinct($xfer.target.port)
    $transfer_count = count($xfer.metadata.id)

  condition:
    $mgmt and $xfer
}
