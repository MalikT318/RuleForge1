/*
  MITRE Technique : T1137.001 - Office Template Macros
  Tactic(s)       : Persistence
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:14:45.689726+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_001_Office_Remote_Template_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Microsoft Office application fetching a macro-capable template or add-in file (.dotm, .dot, .xltm, .xlam, .xla, .potm, .ppam) over HTTP(S) from an external host. This is the network side of Office template persistence and remote template injection: a shared or global template location is redirected to attacker-controlled infrastructure, so each Office start pulls and loads a macro-enabled template."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.001"
    mitre_technique_name = "Office Application Startup: Office Template Macros"
    log_prerequisites = "Requires NETWORK_HTTP events carrying the full URL, from a web proxy, secure web gateway, or EDR network telemetry. The principal process path or the HTTP user agent must be populated to identify Office as the client."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Organisations that host corporate templates or add-ins on an external SharePoint or SaaS tenant, Office add-in deployment from vendor CDNs, and legitimate template galleries that serve .dotm or .xltm files."
    tuning_guidance = "Add known-good template and add-in hosting domains (corporate SharePoint or vendor CDNs) to %global_allowed_domains. Make sure %rfc1918_internal covers internal template shares. If the proxy does not populate the principal process, rely on the user-agent branch."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\.(dotm|dot|xltm|xlam|xla|potm|ppam)(\?|#|$)/ nocase
    (
      $net.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess)\.exe$/ nocase or
      $net.network.http.user_agent = /Microsoft Office|ms-office|MSOffice/ nocase
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1137.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $template_urls = array_distinct($net.target.url)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $affected_users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
