/*
  MITRE Technique : T1564.014 - Extended Attributes
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:34:48.217580+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_014_Linux_Xattr_Write_File_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects file-level modification events caused by writing extended attributes (setxattr/fsetxattr/lsetxattr syscalls, or the setfattr/attr utilities acting as the writing process) on Linux. Adversaries hide second-stage payloads in user.* xattrs of legitimate files. The rule pivots on the resulting FILE_MODIFICATION artifact rather than process command lines, so it still fires if the command line is obfuscated or logging of arguments is absent."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.014"
    mitre_technique_name = "Hide Artifacts: Extended Attributes"
    log_prerequisites = "Linux EDR file telemetry or auditd with syscall rules for setxattr, fsetxattr and lsetxattr (for example: -a always,exit -F arch=b64 -S setxattr,fsetxattr,lsetxattr -k xattr_write), normalised to FILE_MODIFICATION with the syscall or writing process populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "SELinux relabelling (restorecon, setfiles), package managers (rpm, dpkg, apt, dnf) setting file capabilities or security.* attributes, backup and restore tools preserving xattrs (rsync -X, tar --xattrs, cp -a), container runtimes and overlay filesystems (trusted.overlay.*), file indexers and desktop tagging services, and admin scripts that set ACL or tagging attributes."
    tuning_guidance = "Add legitimate xattr-writing binaries to %global_allowed_admin_tools, backup and restore tools to %global_allowed_backup_processes, and EDR or security agents to %global_allowed_security_tools. Add approved automation accounts to %global_allowed_service_accounts. If the auditd parser does not populate metadata.description with the syscall name, confirm the field mapping per client; otherwise the rule relies on the writing process path only. Consider scoping to non-root users or writable paths such as /tmp, /var/tmp and /dev/shm for noisy estates."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    (
      $file.principal.process.file.full_path = /\/(setfattr|attr)$/ nocase or
      $file.metadata.description = /\b(f|l)?setxattr\b/ nocase
    )
    not $file.principal.process.file.full_path = /\/(restorecon|setfiles|rpm|dpkg|dnf|yum|apt|apt-get|rsync|tar|systemd|dockerd|containerd|runc)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1564.014")
    $primary_entity = array_distinct($file.principal.hostname)
    $target_files = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
