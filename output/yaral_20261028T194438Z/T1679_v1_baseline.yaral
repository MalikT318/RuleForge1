/*
  MITRE Technique : T1679 - Selective Exclusion
  Tactic(s)       : Stealth
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:25:59.629649+00:00
  Reference       : https://attack.mitre.org/techniques/T1679
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1679_Exclusion_Args_For_Executable_Extensions {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process launched with an exclusion-style argument (exclude, skip, ignore, whitelist, avoid) that lists two or more system or executable file extensions (dll, exe, lnk, sys). Ransomware and destructive payloads use this pattern to avoid corrupting binaries and keep the host operable enough to show the ransom note. Common file utilities and approved admin and backup tooling are excluded."
    mitre_tactic = "Stealth"
    mitre_technique = "T1679"
    mitre_technique_name = "Selective Exclusion"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command-line capture (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup, sync and deployment utilities with exclusion switches (robocopy /XF, rsync, archivers) not already allowlisted; build and packaging scripts (MSBuild, installer builders); antivirus or DLP scan configuration scripts; admin scripts that copy or clean directories while excluding binaries."
    tuning_guidance = "Add approved file-handling or deployment tooling to %global_allowed_admin_tools (by parent or launching process path) and backup software to %global_allowed_backup_processes. Add trusted automation hosts to %global_allowed_script_hosts. Extend the utility-name exclusion regex for client-specific build or copy tools. Raise severity when the same host also shows mass file modification or shadow copy deletion."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /[\s\/\-](exclude|excl|skip|ignore|except|whitelist|avoid|noenc|noencrypt)\w*[\s=:]+.*\.(dll|exe|lnk|sys)\b.*\.(dll|exe|lnk|sys)\b/ nocase
    not $proc.target.process.file.full_path = /\\(robocopy|xcopy|rsync|7z|7za|7zg|winrar|rar|tar|msbuild|dotnet|git|msiexec|wsusutil|dism|cleanmgr|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1679")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $process_path = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
