/*
  MITRE Technique : T1556.004 - Network Device Authentication
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:19:21.595033+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_004_External_Mgmt_Plane_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a connection from an external (non-internal) source address to a network device management-plane service (Telnet, SSH, NETCONF-over-SSH or SNMP). Network-side signal for T1556.004: a device with a patched system image accepts a hard-coded backdoor password, so the adversary must reach the management plane from outside trusted management sources. The rule observes the connection itself, whether it was allowed or denied, and does not depend on authentication outcome."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.004"
    mitre_technique_name = "Modify Authentication Process: Network Device Authentication"
    log_prerequisites = "Firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with populated principal.ip, target.ip and target.port. Logs must cover traffic inbound to internal network device management interfaces."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Remote administrators or MSP engineers connecting from unlisted addresses, third-party network monitoring (SNMP polling), external vulnerability scans not yet in the scanner list, and misconfigured NAT or hairpin traffic that exposes internal addresses."
    tuning_guidance = "Add approved administrative jump hosts and monitoring sources to %global_allowed_mgmt_sources. Add authorised scanning sources to %global_allowed_scanners. Management interfaces should be reachable only from approved sources, so persistent hits indicate exposure that should be fixed with an ACL. Correlate with USER_LOGIN events from the same source on the device for confirmation."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 161 or
      $net.target.port = 830
    )
    not $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1556.004")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
