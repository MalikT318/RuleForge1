/*
  MITRE Technique : T1080 - Taint Shared Content
  Tactic(s)       : Lateral Movement
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:21:45.311237+00:00
  Reference       : https://attack.mitre.org/techniques/T1080
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1080_OfficeSuite_Executable_Content_Written_To_Shared_Library {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an executable, script, or shortcut-type file being uploaded, modified, copied or moved into cloud shared document storage. Document libraries normally hold documents, not launchable content. Writing such a file there is a common way to taint shared content so that colleagues who open or sync it run attacker code. This rule works at the file-artifact layer of the unified audit log (resulting content change), so it does not depend on endpoint command-line logging."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1080"
    mitre_technique_name = "Taint Shared Content"
    log_prerequisites = "Requires Microsoft 365 or Google Workspace unified audit logs for file activity (upload, modify, copy, move) ingested and normalised to UDM USER_RESOURCE_UPDATE_CONTENT with target.file.full_path and metadata.product_event_type populated."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Developers or IT staff storing scripts, installers or tooling in team sites; software packaging and deployment teams; automation or migration jobs bulk-uploading content; users sharing legitimate shortcuts (.url/.lnk) or macro-enabled templates."
    tuning_guidance = "Add approved automation and migration accounts to %global_allowed_service_accounts, administrators who publish tooling to %global_allowed_admin_users, and approved application principals to %global_allowed_cloud_principals. Narrow or widen the extension list to match the client's policy. Consider raising severity for external or guest users, or when the file is written to a broadly shared site."

  events:
    $file.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"
    $file.metadata.product_event_type = /^(FileUploaded|FileModified|FileSyncUploadedFull|FileCopied|FileMoved)$/ nocase
    $file.target.file.full_path = /\.(lnk|url|scf|vbs|vbe|js|jse|wsf|wsh|hta|ps1|psm1|bat|cmd|scr|com|exe|dll|msi|jar|iso|img|xll|wll|docm|xlsm|pptm|sh|py)$/ nocase
    $file.principal.user.userid != ""
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1080")
    $primary_entity = array_distinct($file.principal.user.userid)
    $tainted_files = array_distinct($file.target.file.full_path)
    $source_ips = array_distinct($file.principal.ip)
    $operations = array_distinct($file.metadata.product_event_type)

  condition:
    $file
}
