/*
  MITRE Technique : T1027.009 - Embedded Payloads
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:52:23.346845+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_009_Embedded_Payload_Host_Process_External_Beacon {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound connection to an external address from a Windows process that normally has no network activity: a basic GUI utility or a proxy-execution binary used by .NET and COM. Embedded payloads (overlay data, nested content, shellcode carried in a benign file) are often unpacked or injected into such hosts and then beacon out. This is the network-side view. It does not depend on process-creation or command-line content, so it still fires when the dropper and its arguments are obfuscated."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.009"
    mitre_technique_name = "Obfuscated Files or Information: Embedded Payloads"
    log_prerequisites = "Requires endpoint network telemetry that records the initiating process path (EDR network events or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rundll32 or regsvr32 loading legitimate vendor DLLs that call home, msbuild or regasm used by developer tooling and CI agents, notepad or wordpad opening remote content, and software-deployment or RMM tooling that uses these binaries."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools, %global_allowed_remote_mgmt or %global_allowed_security_tools. Add known-good vendor destinations to %global_allowed_domains. Make sure %rfc1918_internal is populated for each client. Edit the process-name regex to fit the environment, for example to drop msbuild on build servers."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(notepad|calc|mspaint|wordpad|write|rundll32|regsvr32|msbuild|installutil|regasm|regsvcs)\.exe$/ nocase
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1027.009")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $affected_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
