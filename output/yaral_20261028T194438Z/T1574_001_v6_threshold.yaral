/*
  MITRE Technique : T1574.001 - DLL
  Tactic(s)       : Stealth, Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:29:55.027212+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_001_Burst_DLL_Drops_User_Writable_Paths {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of DLL file creations in user-writable or staging directories (AppData, Temp, ProgramData, Users\\Public) on a single host within 10 minutes. Staging several DLLs in these locations is typical of DLL side-loading and search-order hijacking preparation, where a payload DLL is planted next to a legitimate executable. A single DLL write is benign, but the volume is not."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.001"
    mitre_technique_name = "Hijack Execution Flow: DLL"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) normalised to UDM FILE_CREATION with target.file.full_path and principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and self-updaters (Electron-based apps, collaboration clients, browsers), developer build output in user profile directories, portable application extraction, package managers, and RMM or patching agents unpacking components."
    tuning_guidance = "Add approved deployment and patching binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Extend the creator-name exclusion regex for noisy per-client updaters. Raise the #file threshold in condition for developer-heavy hosts. Review $dll_paths and $creator_processes in the outcome to confirm whether the creator is an unsigned or unexpected binary."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.dll$/ nocase
    $file.target.file.full_path = /(\\users\\[^\\]+\\appdata\\(local|roaming)\\|\\users\\public\\|\\programdata\\|\\windows\\temp\\|\\users\\[^\\]+\\downloads\\)/ nocase
    not $file.principal.process.file.full_path = /\\(msiexec|TrustedInstaller|TiWorker|MsMpEng|MsSense|SenseIR|OneDrive|OneDriveSetup|msedge|chrome|firefox)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $dll_count = count($file.metadata.id)
    $risk_score = if($dll_count >= 15, 85, 60)
    $mitre_technique_id = array_distinct("T1574.001")
    $primary_entity = array_distinct($host)
    $creator_processes = array_distinct($file.principal.process.file.full_path)
    $dll_paths = array_distinct($file.target.file.full_path)
    $affected_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 5
}
