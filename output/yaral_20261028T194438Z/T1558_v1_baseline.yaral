/*
  MITRE Technique : T1558 - Steal or Forge Kerberos Tickets
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:37:15.002726+00:00
  Reference       : https://attack.mitre.org/techniques/T1558
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_Linux_Kerberos_Ccache_Keytab_Theft {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux process that copies, reads, encodes, archives or transfers Kerberos credential material: ticket caches (krb5cc_*, SSSD ccache_*, /run/user/<uid>/krb5cc*), the SSSD secrets store, or keytab files. Stolen ccache or keytab files allow Pass-the-Ticket and ticket forging from another host or session."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558"
    mitre_technique_name = "Steal or Forge Kerberos Tickets"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to UDM PROCESS_LAUNCH with full command-line capture."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup and imaging agents reading /etc/krb5.keytab or SSSD stores; configuration management (Ansible, Puppet, Chef) distributing keytabs; sysadmins rotating or deploying service keytabs; users copying their own ticket cache during troubleshooting; Kerberised service installers."
    tuning_guidance = "Add approved backup tooling to %global_allowed_backup_processes, deployment and configuration-management binaries to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Add EDR or security agents to %global_allowed_security_tools. For environments that routinely distribute keytabs, scope exclusions by parent process rather than loosening the path regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(cp|mv|cat|head|tail|less|more|dd|tar|zip|gzip|7z|base64|xxd|od|hexdump|strings|scp|sftp|rsync|nc|ncat|socat|curl|wget|openssl|python[0-9.]*|perl|ruby)$/ nocase
    $proc.target.process.command_line = /(\/krb5cc|\/ccache_|\/sss\/secrets\/|\/krb5\.keytab|\.keytab\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1558")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
