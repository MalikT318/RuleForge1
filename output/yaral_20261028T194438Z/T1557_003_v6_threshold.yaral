/*
  MITRE Technique : T1557.003 - DHCP Spoofing
  Tactic(s)       : Credential Access, Collection
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:35:01.921471+00:00
  Reference       : https://attack.mitre.org/techniques/T1557/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1557_003_Rogue_DHCP_Server_Responses_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single source address sends repeated DHCP server-to-client traffic (UDP source port 67 to destination port 68) within ten minutes. The source is not an approved DHCP or management source. One DHCP response is normal; sustained responses from an unapproved host indicate a rogue DHCP server redirecting Windows clients' gateway or DNS settings for adversary-in-the-middle collection."
    mitre_tactic = "Credential Access, Collection"
    mitre_technique = "T1557.003"
    mitre_technique_name = "Adversary-in-the-Middle: DHCP Spoofing"
    log_prerequisites = "Requires perimeter or internal segmentation firewall logs that record UDP flows on ports 67/68 and populate principal.ip, principal.port, target.port and network.ip_protocol. Firewalls that drop or do not log broadcast DHCP traffic will not produce these events."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate DHCP servers or relay agents not yet allowlisted, new or migrated DHCP servers, DHCP failover pairs, lab or guest networks that run their own DHCP, and consumer-grade routers or access points deployed by branch offices."
    tuning_guidance = "Add the addresses of all approved DHCP servers and relays to %global_allowed_mgmt_sources. Raise the #net threshold on very busy segments. Review the $client_count outcome: a single unapproved source answering many distinct clients is higher confidence."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "UDP"
    $net.principal.port = 67
    $net.target.port = 68
    $net.principal.ip = $src
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($net.metadata.id)
    $client_count = count_distinct($net.target.ip)
    $mitre_technique_id = array_distinct("T1557.003")
    $primary_entity = array_distinct($src)
    $client_ips = array_distinct($net.target.ip)

  condition:
    #net >= 5
}
