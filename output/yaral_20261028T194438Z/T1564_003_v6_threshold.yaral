/*
  MITRE Technique : T1564.003 - Hidden Window
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:18:20.631385+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_003_Console_Window_Registry_Tampering_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated modification of console window registry values (WindowPosition, WindowSize, ScreenBufferSize, ShowWindow) under the Console registry key on a single host within ten minutes. A single change is normal user behaviour. A burst of changes from non-console processes indicates window geometry being manipulated so console windows are moved off-screen, shrunk or hidden."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.003"
    mitre_technique_name = "Hide Artifacts: Hidden Window"
    log_prerequisites = "Requires Windows endpoint registry modification telemetry (EDR or Sysmon registry events) normalised to UDM REGISTRY_MODIFICATION with target.registry.registry_key and target.registry.registry_value_name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Users customising console or terminal properties, profile or logon scripts that deploy console defaults, golden-image or VDI provisioning, RMM or GPO-driven console configuration, and accessibility tooling."
    tuning_guidance = "Add deployment and configuration tooling to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Raise the #reg threshold on hosts with heavy console customisation. Inspect $writer_processes in the outcome to identify the writing process."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Console(\\|$)/ nocase
    $reg.target.registry.registry_value_name = /^(WindowPosition|WindowSize|ScreenBufferSize|ShowWindow)$/ nocase
    not $reg.principal.process.file.full_path = /\\(conhost|explorer|OpenConsole|WindowsTerminal)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    $reg.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1564.003")
    $primary_entity = array_distinct($host)
    $reg_count = count($reg.metadata.id)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $modified_keys = array_distinct($reg.target.registry.registry_key)
    $affected_users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 3
}
