/*
  MITRE Technique : T1055.003 - Thread Execution Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:50:04.990566+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_003_Remote_Thread_Injection_Into_Common_Host_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects cross-process injection telemetry (remote thread creation, APC queueing or thread context manipulation) where a binary running from a user-writable location injects into a commonly hijacked Windows host process. Uses process-injection telemetry rather than command-line matching, so it complements existing PROCESS_LAUNCH rules. Platform note: T1055.003 is a Windows-only technique, so this rule is written for Windows."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.003"
    mitre_technique_name = "Process Injection: Thread Execution Hijacking"
    log_prerequisites = "Requires endpoint telemetry that emits process-injection events (remote thread creation / thread context changes) with populated principal and target process paths and PIDs."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Security agents and DLP/EDR hooking, backup and imaging agents, application compatibility shims, accessibility and input-method software, RMM and remote-support tools, and developer debuggers or profilers."
    tuning_guidance = "Add approved injector binaries to %global_allowed_security_tools, %global_allowed_backup_processes, %global_allowed_admin_tools or %global_allowed_remote_mgmt. Add automation accounts to %global_allowed_service_accounts. Widen or narrow the victim process regex to suit the client estate."

  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.process.file.full_path = /(?i)\\(users\\[^\\]+\\|programdata\\|windows\\temp\\|temp\\|appdata\\|downloads\\|public\\)/
    $inj.target.process.file.full_path = /\\(explorer|svchost|notepad|winlogon|spoolsv|dllhost|taskhostw?|runtimebroker|searchindexer|rundll32|werfault|sihost|ctfmon)\.exe$/ nocase
    $inj.principal.process.pid != $inj.target.process.pid
    not $inj.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|SenseCncProxy)\.exe$/ nocase
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $inj.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.003")
    $primary_entity = array_distinct($inj.principal.hostname)
    $injector_process = array_distinct($inj.principal.process.file.full_path)
    $victim_process = array_distinct($inj.target.process.file.full_path)
    $acting_user = array_distinct($inj.principal.user.userid)

  condition:
    $inj
}
