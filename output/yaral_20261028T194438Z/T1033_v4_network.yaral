/*
  MITRE Technique : T1033 - System Owner/User Discovery
  Tactic(s)       : Discovery
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:54:06.279138+00:00
  Reference       : https://attack.mitre.org/techniques/T1033
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1033_Linux_Outbound_Connection_Embedding_User_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux network client or interpreter making an outbound connection to an external address while its own command line embeds user-discovery output (command substitution of whoami/id/logname, $USER/$LOGNAME variables, or whoami piped into a network tool). This pattern shows an adversary sending system owner or user identity to remote infrastructure, which is typical of staging, beaconing, or exfiltration scripts. It is observed on the network side, so it is complementary to process-creation command-line detections."
    mitre_tactic = "Discovery"
    mitre_technique = "T1033"
    mitre_technique_name = "System Owner/User Discovery"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that produces NETWORK_CONNECTION events with the originating process path and command line populated (principal.process.*)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Admin or provisioning scripts that register a host with an external inventory or licensing service using $(whoami) or $USER; CI/CD runners and build agents posting the build user to external services; monitoring or telemetry scripts that tag check-ins with the username; developers testing APIs from the shell."
    tuning_guidance = "Add approved tooling binaries to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and known script-running hosts to %global_allowed_script_hosts. Internal destinations are already excluded through %rfc1918_internal. If CI runners are noisy, add the runner parent binary to %global_allowed_admin_tools."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(curl|wget|nc|ncat|netcat|socat|python[0-9.]*|perl|ruby|php|bash|sh|dash|zsh)$/ nocase
    (
      $net.principal.process.command_line = /\$\(\s*(whoami|id|logname|users|who)\b/ nocase or
      $net.principal.process.command_line = /\x60\s*(whoami|id|logname|users|who)\b[^\x60]*\x60/ nocase or
      $net.principal.process.command_line = /\$\{?(USER|LOGNAME|USERNAME)\b/ or
      $net.principal.process.command_line = /\b(whoami|logname|id\s+-un?)\b[^|;&]*\|\s*(curl|wget|nc|ncat|netcat|socat)\b/ nocase
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1033")
    $primary_entity = array_distinct($net.principal.hostname)
    $user = array_distinct($net.principal.user.userid)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $process_path = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
