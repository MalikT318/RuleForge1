/*
  MITRE Technique : T1036.001 - Invalid Code Signature
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:56:36.975628+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_001_Signature_Validation_Weakened_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modification of Windows code-signature validation settings (the WinVerifyTrust 'Wintrust\\Config' EnableCertPaddingCheck value and the 'Software Publishing' trust-provider State value). Changing these relaxes signature checking, so binaries with tampered, mimicked, or invalid signatures are more likely to be treated as legitimate by the OS and by security tooling. This is a state-change (registry) detection and does not depend on command-line logging."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.001"
    mitre_technique_name = "Masquerading: Invalid Code Signature"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 12/13) populating target.registry.registry_key and target.registry.registry_value_name."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or GPO/MDM deploying the Microsoft CVE-2013-3900 hardening (EnableCertPaddingCheck), software installers or packaging tools that adjust trust-provider State, security hardening baselines, and endpoint management agents."
    tuning_guidance = "Add approved deployment, GPO, and hardening tooling to %global_allowed_admin_tools, and EDR/AV agents to %global_allowed_security_tools. If registry value data is populated in your tenant, restrict to values that disable the check, since enabling EnableCertPaddingCheck is benign hardening. Use %global_allowed_admin_users for named administrators who legitimately perform baseline changes."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(Cryptography\\Wintrust\\Config|WinTrust\\Trust Providers\\Software Publishing)$/ nocase
    $reg.target.registry.registry_value_name = /^(EnableCertPaddingCheck|State)$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1036.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
