/*
  MITRE Technique : T1550.003 - Pass the Ticket
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:40:09.035881+00:00
  Reference       : https://attack.mitre.org/techniques/T1550/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1550_003_Kerberos_Ticket_File_Artifact_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of Kerberos ticket export files (KRB-CRED .kirbi or MIT credential cache .ccache) on a Windows endpoint. These files are the on-disk artifact of ticket extraction from LSASS memory or of ticket format conversion, which precedes pass-the-ticket reuse. The rule detects the resulting file state rather than command-line text, so it still fires when command-line logging is evaded or the extraction binary is renamed."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1550.003"
    mitre_technique_name = "Use Alternate Authentication Material: Pass the Ticket"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Kerberos and security researchers or red teams, authorised penetration tests, AD administrators troubleshooting Kerberos with ticket exports, and cross-platform Kerberos tooling (MIT Kerberos for Windows, WSL or Linux interop) that writes credential cache files."
    tuning_guidance = "Add approved admin or testing tooling to %global_allowed_admin_tools, EDR or security agents to %global_allowed_security_tools, and authorised testers to %global_allowed_admin_users. Add sanctioned scanner hosts to %global_allowed_scanners. If MIT Kerberos for Windows is deployed, review .ccache creation and allow the owning process through %global_allowed_admin_tools."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(kirbi|ccache)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1550.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $ticket_file_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
