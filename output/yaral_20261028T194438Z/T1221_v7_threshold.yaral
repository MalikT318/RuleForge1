/*
  MITRE Technique : T1221 - Template Injection
  Tactic(s)       : Stealth
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:15:15.201196+00:00
  Reference       : https://attack.mitre.org/techniques/T1221
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1221_Office_Remote_Template_Cache_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "An Office application writes several template-type files (.dot, .dotx, .dotm, .xltm, .potm and similar) into browser/network cache or temp locations on one host within ten minutes. A single write is normal, but repeated writes suggest documents are pulling remote templates (template injection) that are cached before load or execution."
    mitre_tactic = "Stealth"
    mitre_technique = "T1221"
    mitre_technique_name = "Template Injection"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent) with the writing process path and target file path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Users opening several documents based on corporate templates hosted on SharePoint or a file share, template-deployment or document-management add-ins, mail-merge and document-automation jobs, and bulk opening of legacy template-based documents."
    tuning_guidance = "Add approved deployment tooling to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Raise the #file threshold in noisy environments that use heavily templated documents. Correlate hits with outbound network connections from the same Office process before escalating."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(winword|excel|powerpnt|visio|msaccess|mspub)\.exe$/ nocase
    $file.target.file.full_path = /\\users\\[^\\]+\\appdata\\local\\(microsoft\\windows\\inetcache|temp)\\.*\.(dot|dotx|dotm|xlt|xltx|xltm|pot|potx|potm)$/ nocase
    not $file.target.file.full_path = /\\~\$[^\\]*$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1221")
    $primary_entity = array_distinct($host)
    $office_processes = array_distinct($file.principal.process.file.full_path)
    $template_files = array_distinct($file.target.file.full_path)
    $affected_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
