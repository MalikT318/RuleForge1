/*
  MITRE Technique : T1614.001 - System Language Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:39:13.193218+00:00
  Reference       : https://attack.mitre.org/techniques/T1614/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1614_001_Language_Locale_Registry_State_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects modification of Windows system language, locale or keyboard-layout registry values (Nls\\Language, Nls\\Locale, Control Panel\\International, Keyboard Layout\\Preload/Substitutes) by a script interpreter, LOLBin or a binary running from a user-writable location. Sysmon-style telemetry does not record registry reads, so this detects the state-change layer around language discovery rather than the query itself. Malware that performs language-based geofencing may spoof or alter these values to test or evade the check, and operators may add a keyboard layout as a 'vaccination' against such malware. Coverage is partial: pure read-only language checks will not be seen by this rule."
    mitre_tactic = "Discovery"
    mitre_technique = "T1614.001"
    mitre_technique_name = "System Location Discovery: System Language Discovery"
    log_prerequisites = "Requires Windows registry modification telemetry from an EDR or Sysmon (registry value set events) with the initiating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT deployment scripts or imaging/provisioning tasks that set regional settings, language pack installers launched from temp or ProgramData paths, user-driven regional changes scripted via PowerShell (Set-WinUserLanguageList, Set-Culture), RMM-driven localisation for new hires."
    tuning_guidance = "Add approved provisioning or localisation tooling to %global_allowed_admin_tools, approved interpreter parents to %global_allowed_script_hosts, and EDR/AV agents to %global_allowed_security_tools. If imaging workflows are noisy, scope exclusions by the initiating process rather than the registry key."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(Control\\Nls\\(Language|Locale)|Control Panel\\International|Keyboard Layout\\(Preload|Substitutes))/ nocase
    $reg.principal.process.file.full_path = /(\\(powershell|pwsh|cmd|wscript|cscript|mshta|reg|regedit)\.exe$|\\(Users|ProgramData|Temp|AppData)\\)/ nocase
    not $reg.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|TiWorker|msiexec|SystemSettings|winlogon|userinit|LogonUI|ctfmon|explorer)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1614.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_name)
    $initiating_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
