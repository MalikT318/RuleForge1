/*
  MITRE Technique : T1546 - Event Triggered Execution
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:59:55.673557+00:00
  Reference       : https://attack.mitre.org/techniques/T1546
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_Office_Suite_Mass_Mailbox_Rule_Changes {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single user creates or modifies several mailbox inbox rules within ten minutes. Inbox rules are event-triggered actions that run on every incoming message, and adversaries abuse them for persistence, forwarding, and hiding security mail after an account takeover. One rule change is routine, but a burst from one account suggests scripted or malicious rule staging."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546"
    mitre_technique_name = "Event Triggered Execution"
    log_prerequisites = "Requires unified audit logs with Exchange mailbox audit and admin audit events ingested and normalized to UDM SETTING_MODIFICATION, with metadata.product_event_type populated with the operation name."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Users bulk-organizing mail with several rules at once, mailbox migrations, help-desk staff configuring rules for users, onboarding automation, and mail clients that resync rules (rule updates generated by client sync)."
    tuning_guidance = "Add automation and migration accounts to %global_allowed_service_accounts and help-desk or administrator accounts to %global_allowed_admin_users. Raise the #audit threshold if client-sync noise is high. Lower it to 3 for high-value accounts such as executives and finance."

  events:
    $audit.metadata.event_type = "SETTING_MODIFICATION"
    $audit.metadata.product_event_type = /^(New-InboxRule|Set-InboxRule|Enable-InboxRule|UpdateInboxRules)$/ nocase
    $audit.principal.user.userid = $user
    not $audit.principal.user.userid in %global_allowed_service_accounts
    not $audit.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($audit.metadata.id)
    $mitre_technique_id = array_distinct("T1546")
    $primary_entity = array_distinct($user)
    $source_ips = array_distinct($audit.principal.ip)
    $operations = array_distinct($audit.metadata.product_event_type)

  condition:
    #audit >= 5
}
