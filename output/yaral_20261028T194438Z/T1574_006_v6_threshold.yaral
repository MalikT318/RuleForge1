/*
  MITRE Technique : T1574.006 - Dynamic Linker Hijacking
  Tactic(s)       : Stealth, Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:33:26.884127+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_006_Shared_Object_Drops_In_Writable_Dirs_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several shared-object (.so) files are created in world-writable staging directories (/tmp, /var/tmp, /dev/shm) on a single Linux host within 10 minutes. One .so drop is often benign, but repeated drops in these locations match the preparation of malicious libraries for LD_PRELOAD or LD_LIBRARY_PATH dynamic linker hijacking. This rule is file-creation based and complements process command-line detections."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.006"
    mitre_technique_name = "Hijack Execution Flow: Dynamic Linker Hijacking"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry normalised to UDM FILE_CREATION with principal.hostname, target.file.full_path and principal.process.file.full_path populated. Coverage of /tmp, /var/tmp and /dev/shm must be enabled in the sensor or audit rules."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software builds and compilers writing temporary shared objects, language runtimes (JVM, Python, Node.js native addons) unpacking native libraries into /tmp, CI/CD runners, package installation or upgrade scripts, developer workstations testing LD_PRELOAD debugging shims."
    tuning_guidance = "Add build, CI and deployment tooling to %global_allowed_admin_tools, trusted automation accounts to %global_allowed_service_accounts, and EDR or AV agents to %global_allowed_security_tools. Raise the #file threshold on build servers or developer hosts. Consider a separate rule for single creations in /dev/shm if the environment is clean."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.*\.so(\.[0-9]+)*$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|yum|dnf|unattended-upgr)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($file.target.file.full_path = /^\/dev\/shm\// nocase, 80, 60))
    $mitre_technique_id = array_distinct("T1574.006")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $dropped_files = array_distinct($file.target.file.full_path)
    $dropping_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
