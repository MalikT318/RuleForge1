/*
  MITRE Technique : T1565.003 - Runtime Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:44:28.601578+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_003_Linux_Display_Utility_Modified_Then_Executed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a system data-display or reporting utility (ps, top, ls, netstat, ss, df, who, last, lsof and similar) in a system binary directory being modified by a non-package-manager process, then executed from the same path within 10 minutes. This pattern is consistent with trojanized binaries that alter the data shown to administrators and users, such as hiding processes, connections or logins."
    mitre_tactic = "Impact"
    mitre_technique = "T1565.003"
    mitre_technique_name = "Data Manipulation: Runtime Data Manipulation"
    log_prerequisites = "Requires Linux EDR or auditd file-modification telemetry (watches on /bin, /sbin, /usr/bin, /usr/sbin, /usr/local/bin) and process launch telemetry with full executable paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package manager or OS upgrades not covered by the built-in exclusion, configuration management agents (Ansible, Puppet, Chef, Salt) that replace binaries, in-house build and deployment pipelines, live patching or binary hardening tools, admins manually replacing utilities with a newer version and testing it."
    tuning_guidance = "Add approved patching and deployment binaries to %global_allowed_admin_tools. Add EDR or file-integrity agents to %global_allowed_security_tools. Extend or trim the utility name list to match the client's monitored baseline. If the file-modification telemetry is noisy, ensure the sensor only records writes under the listed system binary directories."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/(usr\/(local\/)?)?s?bin\/(ps|top|htop|ls|netstat|ss|ifconfig|ip|df|du|who|w|last|lastlog|lsof|uptime|free|cat|grep|find|dmesg|journalctl|mount)$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|yum|dnf|rpm|zypper|pacman|apk|snapd|unattended-upgrade)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.target.file.full_path = $path
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /^\/(usr\/(local\/)?)?s?bin\/(ps|top|htop|ls|netstat|ss|ifconfig|ip|df|du|who|w|last|lastlog|lsof|uptime|free|cat|grep|find|dmesg|journalctl|mount)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.target.process.file.full_path = $path
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1565.003")
    $primary_entity = array_distinct($hostname)
    $modified_binary = array_distinct($path)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $modifying_user = array_distinct($file.principal.user.userid)
    $executing_user = array_distinct($proc.principal.user.userid)
    $execution_count = count($proc.metadata.id)

  condition:
    $file and $proc
}
