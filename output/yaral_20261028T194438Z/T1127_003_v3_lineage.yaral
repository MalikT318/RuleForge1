/*
  MITRE Technique : T1127.003 - JamPlus
  Tactic(s)       : Stealth, Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:40:35.339422+00:00
  Reference       : https://attack.mitre.org/techniques/T1127/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1127_003_JamPlus_Unexpected_Parent_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the JamPlus build utility (or any process handed a .jam build script) launched by a parent that should never start a developer build tool: Office applications, browsers, mail clients, script hosts, web server workers, database services, the print spooler or WMI provider host. Attackers abuse JamPlus to proxy script execution through a trusted developer binary, and the unusual parent-child lineage is the signal, not the command itself."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1127.003"
    mitre_technique_name = "Trusted Developer Utilities Proxy Execution: JamPlus"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with parent process path populated (EDR or Sysmon Event ID 1)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developer workstations where a build is triggered from a browser-based or editor-embedded script host; CI/build agents running as web server or database service workers; software packaging tools that invoke build utilities through script hosts; legitimate game or asset build pipelines that launch jam from a scripted wrapper."
    tuning_guidance = "Add approved parent binaries (build agents, packaging tools) to %global_allowed_admin_tools, and approved script-hosting parents to %global_allowed_script_hosts. Narrow the parent regex if developer scripting from wscript or cscript is normal in a given client environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Unexpected parent: document, browser, mail, script host, server-side or service process
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|onenote|visio|mspub|chrome|msedge|firefox|iexplore|wscript|cscript|mshta|w3wp|httpd|nginx|tomcat\d*|sqlservr|spoolsv|wmiprvse)\.exe$/ nocase

    // Child is the JamPlus binary (including a renamed copy handed a .jam script)
    (
      $proc.target.process.file.full_path = /\\jam(plus)?\.exe$/ nocase or
      $proc.target.process.command_line = /\.jam(["'\s]|$)/ nocase
    )

    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1127.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
