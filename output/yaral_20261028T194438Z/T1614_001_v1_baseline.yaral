/*
  MITRE Technique : T1614.001 - System Language Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:38:50.307393+00:00
  Reference       : https://attack.mitre.org/techniques/T1614/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1614_001_Linux_System_Language_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a shell or script interpreter on Linux querying the system language or locale. Signals include locale, localectl status, setxkbmap -query, reading locale and keyboard config files under /etc, and echoing or grepping LANG/LC_* variables. Malware and droppers use these checks to infer a host's geography before deciding whether to run."
    mitre_tactic = "Discovery"
    mitre_technique = "T1614.001"
    mitre_technique_name = "System Location Discovery: System Language Discovery"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records that populate the full command line and the parent process path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Installer and configuration scripts, locale-aware application launchers, cloud-init and provisioning scripts, admin troubleshooting of locale or keyboard settings, configuration management agents, and developer build scripts that print the locale."
    tuning_guidance = "Add approved automation parents to %global_allowed_script_hosts and approved tooling to %global_allowed_admin_tools. Add service and provisioning accounts to %global_allowed_service_accounts. Raise severity or correlate with download, execution from /tmp or /dev/shm, or outbound connections for higher fidelity."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|csh|tcsh|ash|python[0-9.]*|perl|ruby|node|php)$/ nocase
    $proc.target.process.command_line = /(\blocalectl\s+status\b|\bsetxkbmap\s+-(query|print)\b|(^|[\s\/;|&])locale(\s+-[a-z]+)*(\s|$)|\b(cat|less|more|head|tail|grep|awk|sed|strings)\s+[^|;&]*\/etc\/(default\/locale|locale\.conf|locale\.gen|vconsole\.conf|sysconfig\/i18n|sysconfig\/keyboard|default\/keyboard)|\b(echo|printenv)\s+["']?\$?\{?(LANG|LC_ALL|LC_CTYPE|LANGUAGE)\b|\benv\b[^|]*\|\s*grep\s+(-[a-z]+\s+)?["']?(LANG|LC_))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1614.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
