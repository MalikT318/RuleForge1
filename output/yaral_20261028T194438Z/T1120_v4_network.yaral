/*
  MITRE Technique : T1120 - Peripheral Device Discovery
  Tactic(s)       : Discovery
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:27:37.007707+00:00
  Reference       : https://attack.mitre.org/techniques/T1120
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1120_Linux_External_Printer_Protocol_Probe {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux host opening an outbound connection to a non-internal address on a peripheral-service port (IPP/CUPS 631, raw JetDirect 9100, LPD 515). Legitimate printing stays on internal address space, so printer-protocol traffic leaving it points to a process enumerating or probing printers and other network peripherals, or a misconfigured or compromised print stack."
    mitre_tactic = "Discovery"
    mitre_technique = "T1120"
    mitre_technique_name = "Peripheral Device Discovery"
    log_prerequisites = "Requires Linux endpoint network telemetry (EDR or auditd socket/connect events) normalised to NETWORK_CONNECTION with principal.process.file.full_path, principal.hostname, target.ip and target.port populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Cloud or hosted print services reached over IPP (e.g. remote print gateways), VPN-routed printers whose addresses are not in the internal list, managed print vendors, vulnerability and asset scanners, and administrators testing printer connectivity."
    tuning_guidance = "Add approved print or management tooling to %global_allowed_admin_tools, scanning hosts to %global_allowed_scanners, and approved print-gateway hosts to %global_allowed_remote_mgmt. Make sure %rfc1918_internal covers all internal and VPN-routed ranges for the client. To reduce noise further, raise severity only when the initiating process is a shell, interpreter or a binary in /tmp, /dev/shm or /var/tmp."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\// 
    (
      $net.target.port = 631 or
      $net.target.port = 9100 or
      $net.target.port = 515
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path = /\/(cupsd|cups-browsed|cupsfilter|lpd|lpr|lp)$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.hostname in %global_allowed_scanners
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1120")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
