/*
  MITRE Technique : T1673 - Virtual Machine Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:17:10.181631+00:00
  Reference       : https://attack.mitre.org/techniques/T1673
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1673_Linux_VM_Discovery_Followed_By_VM_Stop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a hypervisor CLI (esxcli, vim-cmd, virsh, VBoxManage) enumerating virtual machines, followed within 10 minutes on the same host by a command that kills, powers off or removes a VM. This sequence is typical of pre-encryption or pre-sabotage activity on ESXi, KVM and VirtualBox hosts."
    mitre_tactic = "Discovery"
    mitre_technique = "T1673"
    mitre_technique_name = "Virtual Machine Discovery"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry that populates full process command lines, from hypervisor hosts (ESXi shell, KVM, VirtualBox) or Linux hosts with hypervisor CLIs installed."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Virtualization administrators doing maintenance or decommissioning, patching or host-evacuation scripts, orchestration and cloud-management agents, backup software that quiesces VMs, and lab or test automation."
    tuning_guidance = "Add approved RMM, patching and orchestration binaries to %global_allowed_admin_tools. Add automation and hypervisor-management accounts to %global_allowed_service_accounts. If a client runs scheduled VM power cycling, exclude the parent process through %global_allowed_admin_tools or narrow the follow-on regex."

  events:
    $disc.metadata.event_type = "PROCESS_LAUNCH"
    $disc.target.process.file.full_path = /\/(esxcli|vim-cmd|virsh|VBoxManage)$/ nocase
    $disc.target.process.command_line = /(vm\s+process\s+list|vmsvc\/getallvms|virsh.*\blist\b|list\s+(vms|runningvms))/ nocase
    not $disc.principal.process.file.full_path in %global_allowed_admin_tools
    not $disc.principal.user.userid in %global_allowed_service_accounts
    $disc.principal.hostname = $hostname

    $act.metadata.event_type = "PROCESS_LAUNCH"
    $act.target.process.file.full_path = /\/(esxcli|vim-cmd|virsh|VBoxManage)$/ nocase
    $act.target.process.command_line = /(vm\s+process\s+kill|vmsvc\/power\.(off|shutdown)|vmsvc\/destroy|virsh.*\b(destroy|shutdown|undefine)\b|controlvm\s+\S+\s+poweroff)/ nocase
    not $act.principal.process.file.full_path in %global_allowed_admin_tools
    not $act.principal.user.userid in %global_allowed_service_accounts
    $act.principal.hostname = $hostname

    $disc.metadata.event_timestamp.seconds <= $act.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1673")
    $primary_entity = array_distinct($disc.principal.hostname)
    $discovery_commands = array_distinct($disc.target.process.command_line)
    $follow_on_commands = array_distinct($act.target.process.command_line)
    $users = array_distinct($act.principal.user.userid)
    $discovery_count = count($disc.metadata.id)
    $follow_on_count = count($act.metadata.id)

  condition:
    $disc and $act
}
