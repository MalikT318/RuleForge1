/*
  MITRE Technique : T1542.001 - System Firmware
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:43:50.622504+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_001_Firmware_Transfer_Protocol_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated TFTP (UDP/69) connections from a single source within ten minutes. TFTP is the standard unauthenticated transport for pushing or pulling network device firmware and boot images, so a burst of it from a host outside approved management sources may indicate an attempt to stage or replace device firmware for persistence. A single TFTP transfer is routine; sustained volume from an unapproved source is not."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.001"
    mitre_technique_name = "Pre-OS Boot: System Firmware"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip and target.port populated. TFTP traffic must traverse a logging enforcement point."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Planned firmware upgrades or configuration backups by network engineers, zero-touch provisioning and PXE or network boot services, automated configuration backup tooling that uses TFTP, and lab or staging networks."
    tuning_guidance = "Add approved network management stations, TFTP servers and backup hosts to %global_allowed_mgmt_sources. Raise the threshold (#net >= 3) for environments with heavy PXE or provisioning traffic. Correlate hits with change-management windows and device configuration-change logs."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    $net.principal.ip = $src_ip
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1542.001")
    $primary_entity = array_distinct($src_ip)
    $event_count = count($net.metadata.id)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    #net >= 3
}
