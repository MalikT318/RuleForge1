/*
  MITRE Technique : T1027.009 - Embedded Payloads
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:52:55.816393+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_009_Embedded_Payload_Mass_Drop_To_Writable_Paths {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single host sees several executable or script files created in user-writable staging locations within ten minutes by non-installer processes. This volume pattern fits a carrier file extracting embedded payloads (overlay or resource extraction, self-extracting droppers, nested script payloads). One file drop is benign; a burst is not."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.009"
    mitre_technique_name = "Obfuscated Files or Information: Embedded Payloads"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent) populating principal.process.file.full_path and target.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and self-extracting setup packages, application auto-updaters (browsers, collaboration tools), developer build and packaging tools, RMM and patching agents, portable-app launchers that unpack to AppData."
    tuning_guidance = "Add approved deployment and RMM binaries to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Raise the #file threshold in noisy developer or VDI estates. Add updater executable names to the writer-process regex exclusion if one product dominates alerts."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(exe|dll|scr|com|cpl|ps1|vbs|vbe|js|jse|hta|wsf|bat|cmd)$/ nocase
    $file.target.file.full_path = /\\(appdata\\(local|roaming)|programdata|windows\\temp|users\\public)\\/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\\(msiexec|trustedinstaller|tiworker|wuauclt|usoclient|musnotification|svchost|msmpeng|mssense|senseir|sdbinst|dism|dismhost)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(re.regex($file.target.file.full_path, /(?i)\.(exe|dll|scr|com|cpl)$/), 70, 50))
    $mitre_technique_id = array_distinct("T1027.009")
    $primary_entity = array_distinct($host)
    $dropped_file_count = count($file.metadata.id)
    $dropped_files = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 6
}
