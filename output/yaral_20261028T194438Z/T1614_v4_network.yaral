/*
  MITRE Technique : T1614 - System Location Discovery
  Tactic(s)       : Discovery
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:37:37.117855+00:00
  Reference       : https://attack.mitre.org/techniques/T1614
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1614_Network_Geolocation_Lookup_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound web requests whose URL matches IP-geolocation or public-IP lookup patterns (geoip, geolocation, ip-to-country, whatismyip, country code queries). Malware uses these lookups to infer the victim's location and decide whether to continue infection. Rule matches generic URL semantics, not specific providers, and excludes internal destinations and known-good domains by reference list."
    mitre_tactic = "Discovery"
    mitre_technique = "T1614"
    mitre_technique_name = "System Location Discovery"
    log_prerequisites = "Requires proxy or firewall logs with URL visibility (TLS inspection or explicit proxy) normalised to NETWORK_HTTP with target.url populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate applications performing geo-IP or public-IP checks (VPN clients, SaaS agents, software licensing, dynamic DNS updaters, browsers on user-initiated lookups, web developers testing geo services), security awareness tools."
    tuning_guidance = "Add approved vendor and geolocation service domains to %global_allowed_domains. Narrow the URL keyword regex if broad terms such as myip or checkip are noisy. Raise severity or correlate with endpoint telemetry when requests come from servers or hosts that never browse the web."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(geo-?ip|geo-?locat(e|ion)|ip-?(to-?)?(country|location|geo)|ip2(country|location)|whatismyip|myip|ip-?lookup|checkip|country[_-]?code)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1614")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $requested_urls = array_distinct($http.target.url)

  condition:
    $http
}
