/*
  MITRE Technique : T1480 - Execution Guardrails
  Tactic(s)       : Stealth
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:23:25.320833+00:00
  Reference       : https://attack.mitre.org/techniques/T1480
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1480_Linux_Scripted_External_IP_Geo_Lookup {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux host using a command-line or scripting HTTP client (curl, wget, python, Go, libwww) to query an external IP-address or geolocation lookup endpoint. Malware commonly does this as an execution guardrail, checking the victim's public IP, country or organisation and continuing only if it matches the intended target. The rule matches the lookup pattern (scripted client user-agent, short lookup-style URL path, external destination), not specific service domains."
    mitre_tactic = "Stealth"
    mitre_technique = "T1480"
    mitre_technique_name = "Execution Guardrails"
    log_prerequisites = "Requires NETWORK_HTTP telemetry with URL and user-agent populated (e.g. EDR network sensor, forward proxy, or TLS-inspecting gateway) for Linux hosts and servers. Plain-text or inspected HTTP(S) only."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Provisioning and cloud-init scripts that look up the public IP, dynamic DNS updaters, monitoring and inventory agents, configuration-management runs (Ansible, Puppet, Chef), developer shell scripts, container entrypoints that check egress IP, and VPN or health-check scripts."
    tuning_guidance = "Add approved lookup services to %global_allowed_domains. Add automation, provisioning and jump hosts to %global_allowed_script_hosts. Add approved inventory and agent binaries to %global_allowed_admin_tools. Raise severity when the same host also runs recon commands or spawns a payload shortly after the lookup."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.user_agent = /^(curl|wget|python-requests|python-urllib|aiohttp|go-http-client|libwww-perl|lwp|okhttp|php|ruby|node-fetch|axios)/ nocase
    $http.target.url = /\/(ip|myip|getip|checkip|ipinfo|ipgeo|geoip|geo|country|city|whoami|ifconfig|json)(\.(json|php|txt))?\/?(\?[^\/]*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_script_hosts
    not $http.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1480")
    $primary_entity = array_distinct($http.principal.hostname)
    $lookup_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)
    $destination_ips = array_distinct($http.target.ip)

  condition:
    $http
}
