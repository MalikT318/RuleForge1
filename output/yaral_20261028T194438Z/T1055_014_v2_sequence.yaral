/*
  MITRE Technique : T1055.014 - VDSO Hijacking
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:02:59.626981+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_014_Linux_Staged_SO_Then_Process_Injection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a shared object written to a world-writable staging directory (/tmp, /var/tmp, /dev/shm) followed within five minutes by a cross-process injection event on the same host. This is the staging-then-inject pattern used in VDSO hijacking, where a malicious .so is mapped into a live process through patched syscall stubs or GOT entries."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.014"
    mitre_technique_name = "Process Injection: VDSO Hijacking"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that produces FILE_CREATION events and PROCESS_INJECTION events (ptrace or process_vm_writev style activity) with principal process paths populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Debuggers and tracers (gdb, strace, ltrace) used by developers or SREs; APM and profiling agents that inject instrumentation libraries; JIT or language runtimes that unpack native libraries to /tmp; crash dump and live-patching tooling."
    tuning_guidance = "Add approved debugging, deployment and patching tooling to %global_allowed_admin_tools (applied to the file-writing process). Add EDR, APM and profiling agents to %global_allowed_security_tools (applied to the injecting process). If runtime-unpacked libraries in /tmp are noisy for a client, add the parent runtime to %global_allowed_admin_tools."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.*\.so(\.[0-9]+)*$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.process.file.full_path != ""
    $inj.target.process.file.full_path != ""
    $inj.principal.process.pid != $inj.target.process.pid
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    $inj.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.014")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_files = array_distinct($file.target.file.full_path)
    $dropper_processes = array_distinct($file.principal.process.file.full_path)
    $injecting_processes = array_distinct($inj.principal.process.file.full_path)
    $injected_targets = array_distinct($inj.target.process.file.full_path)
    $injection_count = count($inj.metadata.id)

  condition:
    $file and $inj
}
