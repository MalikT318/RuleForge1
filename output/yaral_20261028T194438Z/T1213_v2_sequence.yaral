/*
  MITRE Technique : T1213 - Data from Information Repositories
  Tactic(s)       : Collection
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:21:42.803309+00:00
  Reference       : https://attack.mitre.org/techniques/T1213
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_Cloud_Repo_Permission_Change_Then_Bulk_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an identity changing access permissions or policies on a cloud data repository (object storage, secret store, or code or document repository) and then making repeated read or list calls against repositories within 10 minutes. This pattern is consistent with an adversary granting themselves or another principal access and then mining the repository for sensitive information."
    mitre_tactic = "Collection"
    mitre_technique = "T1213"
    mitre_technique_name = "Data from Information Repositories"
    log_prerequisites = "Cloud control-plane audit logs, including data-access events (object, secret and parameter reads), ingested and normalised to UDM. metadata.product_event_type must be populated with the API operation name, and principal.user.userid with the calling identity."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Data engineering or CI/CD pipelines that update bucket or secret policies and then read from them, administrators during migrations or onboarding, backup and discovery jobs running under human identities, and infrastructure-as-code runs that apply policy and then validate it."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, trusted federated or workload principals to %global_allowed_cloud_principals, and named administrators to %global_allowed_admin_users. Raise the #access threshold in the condition for busy environments, or tighten the permission and access regexes to the repository services in scope. Where logs reliably carry the same resource name on both events, additionally join on target.resource.name."

  events:
    $perm.metadata.event_type = "RESOURCE_PERMISSIONS_CHANGE"
    $perm.metadata.product_event_type = /(Put|Set|Update|Modify|Add|Create|Attach).*(Policy|Acl|RoleAssignment|Permission|IamBinding)/ nocase
    $perm.principal.user.userid = $user
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_cloud_principals
    not $perm.principal.user.userid in %global_allowed_admin_users

    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.metadata.product_event_type = /(GetObject|ListObjects|ListBucket|GetSecretValue|ListSecrets|GetParameter|AccessSecretVersion|objects\.(get|list)|ListBlobs|GetBlob|ReadSecret|GetFile|GetRepository|BatchGetRepositories)/ nocase
    $access.principal.user.userid = $user
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_cloud_principals
    not $access.principal.user.userid in %global_allowed_admin_users

    $perm.metadata.event_timestamp.seconds <= $access.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1213")
    $primary_entity = array_distinct($user)
    $access_count = count($access.metadata.id)
    $permission_operations = array_distinct($perm.metadata.product_event_type)
    $access_operations = array_distinct($access.metadata.product_event_type)
    $accessed_resources = array_distinct($access.target.resource.name)
    $source_ips = array_distinct($access.principal.ip)

  condition:
    $perm and #access >= 3
}
