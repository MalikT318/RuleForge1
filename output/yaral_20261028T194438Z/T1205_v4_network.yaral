/*
  MITRE Technique : T1205 - Traffic Signaling
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:08:47.091292+00:00
  Reference       : https://attack.mitre.org/techniques/T1205
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_Inbound_Allowed_NonStandard_HighPort {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external source holding an inbound TCP connection to an internal host on a non-standard high port that the perimeter did not block. This is the network-side result of traffic signaling: after a port-knock or magic-packet sequence, a hidden listener is exposed and the operator connects to it. The rule does not detect the knock sequence itself. Endpoint coverage is assumed to correlate the listening process."
    mitre_tactic = "Stealth, Persistence, Command and Control"
    mitre_technique = "T1205"
    mitre_technique_name = "Traffic Signaling"
    log_prerequisites = "Firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip, target.port and network.direction populated. Allowed (accepted) sessions must be logged."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimately published non-standard services (VPN or SSL-VPN on custom ports, VoIP/SIP/RTP, game or media servers, custom web apps on high ports), peer-to-peer or passive-mode FTP data channels, vendor remote-support tools, and unlisted external vulnerability scanners."
    tuning_guidance = "Add approved external scanner sources to %global_allowed_scanners and approved management or partner source addresses to %global_allowed_mgmt_sources. Extend the excluded port list with the client's published high-port services. Raise the lower port bound or restrict to unexpected internal targets if volume is high. Pair with a threshold variant for multi-port knock sequences."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.direction = "INBOUND"
    $net.network.ip_protocol = "TCP"
    $net.target.port > 1024
    $net.target.port != 8080
    $net.target.port != 8443
    $net.target.port != 8000
    $net.target.port != 8888
    not $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    not $net.security_result.action = "BLOCK"
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1205")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
