/*
  MITRE Technique : T1027.002 - Software Packing
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:40:05.679732+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_002_Packed_Loader_Spawns_DotNet_Host_Bare {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process running from a user-writable location (Temp, AppData, Downloads, Desktop, ProgramData, Public) that spawns a built-in .NET or compiler host binary with no arguments. This lineage is typical of packed or crypted loaders that unpack in memory and then hollow or inject into a signed Microsoft binary. It detects the lineage anomaly, not a specific packer or file name."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.002"
    mitre_technique_name = "Obfuscated Files or Information: Software Packing"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and child command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Portable developer tools or build scripts run from user profile folders that call MSBuild or a compiler with no arguments; per-user software installers or updaters that launch from AppData and invoke .NET registration utilities (RegAsm, RegSvcs, InstallUtil); legitimate self-extracting installers staged in Temp."
    tuning_guidance = "Add approved deployment or build tooling to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools (matched on the parent process path). If a client has developer workstations that build from user directories, add the parent build tool to %global_allowed_admin_tools. Exclude trusted hosts through %global_allowed_script_hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop)|programdata|windows\\temp|users\\public)\\.*\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(regasm|regsvcs|msbuild|installutil|applaunch|jsc|vbc|cvtres|aspnet_compiler|caspol|ieexec)\.exe$/ nocase
    $proc.target.process.command_line = /^\s*"?[a-z]:\\[^"]*\.exe"?\s*$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
