/*
  MITRE Technique : T1489 - Service Stop
  Tactic(s)       : Impact
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:39:42.488042+00:00
  Reference       : https://attack.mitre.org/techniques/T1489
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1489_IaaS_Cloud_Service_Stop_Disable {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects cloud control-plane API calls that disable a cloud service integration or stop a compute or database service (AWS DisableAPIServiceAccess, StopInstances, StopDBInstance, StopDBCluster; Azure VM deallocate and power-off; GCP instance and Cloud SQL stop). Adds IaaS audit-log coverage for service stop, which process command-line rules cannot see."
    mitre_tactic = "Impact"
    mitre_technique = "T1489"
    mitre_technique_name = "Service Stop"
    log_prerequisites = "Requires cloud provider audit logs (AWS CloudTrail management events, Azure Activity Log, GCP Cloud Audit Admin Activity) normalised to UDM with metadata.product_event_type and principal.user.userid populated. NOTE: log_source was supplied as macos_endpoint, but this rule consumes cloud audit telemetry and will never match macOS endpoint events. Confirm the log_source mapping before deployment."
    platform = "IaaS"
    log_source = "macos_endpoint"
    false_positives = "Autoscaling and cost-optimisation schedulers stopping dev/test instances, infrastructure-as-code pipelines, planned maintenance and patch windows, DBA stop/start of non-production databases, administrators decommissioning services."
    tuning_guidance = "Add automation and pipeline identities to %global_allowed_service_accounts, %global_allowed_cloud_principals or %global_allowed_admin_users. Raise the score or severity for production-tagged resources. If Stop* events are too noisy, narrow the regex to DisableAPIServiceAccess and the database stop actions. Verify the log_source label (see log_prerequisites)."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /^(DisableAPIServiceAccess|StopInstances|StopDBInstance|StopDBCluster|.*virtualMachines\/(deallocate|powerOff)\/action|.*compute\.instances\.stop|.*sql\.instances\.(stop|delete))$/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1489")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_action = array_distinct($cloud.metadata.product_event_type)
    $target_resource = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
