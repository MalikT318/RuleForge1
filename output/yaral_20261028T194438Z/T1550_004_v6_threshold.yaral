/*
  MITRE Technique : T1550.004 - Web Session Cookie
  Tactic(s)       : Lateral Movement
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:43:12.289127+00:00
  Reference       : https://attack.mitre.org/techniques/T1550/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1550_004_Cookie_Replay_Multi_Source_Mass_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single user account generates a high volume of resource-access events within ten minutes from two or more distinct source IP addresses. Any one access event is benign. The combination of volume and a split source is characteristic of a stolen web session cookie replayed from attacker infrastructure while the legitimate session is still active, which bypasses MFA."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1550.004"
    mitre_technique_name = "Use Alternate Authentication Material: Web Session Cookie"
    log_prerequisites = "Unified audit logs from the collaboration suite ingested with UDM USER_RESOURCE_ACCESS events that populate principal.user.userid and principal.ip (file, mail and site access audit records)."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Users moving between networks (office to VPN, Wi-Fi to mobile), users behind load-balanced or carrier-grade NAT egress, corporate proxies or CASB services that rotate egress IPs, sync clients and mobile apps running alongside a browser, and bulk-access automation run under a user identity."
    tuning_guidance = "Add automation and sync identities to %global_allowed_service_accounts and named administrators who legitimately work from multiple locations to %global_allowed_admin_users. Raise the #access threshold (default 25) or the $distinct_ips threshold (default 2) for tenants with heavy VPN or mobile use. Triage by checking $user_agents for differing client strings and by comparing source IP geolocation with the user's baseline."

  events:
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.principal.user.userid != ""
    $access.principal.user.userid = $user
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1550.004")
    $primary_entity = array_distinct($user)
    $access_count = count($access.metadata.id)
    $distinct_ips = count_distinct($access.principal.ip)
    $source_ips = array_distinct($access.principal.ip)
    $user_agents = array_distinct($access.network.http.user_agent)
    $resources_accessed = array_distinct($access.target.resource.name)

  condition:
    #access >= 25 and $distinct_ips >= 2
}
