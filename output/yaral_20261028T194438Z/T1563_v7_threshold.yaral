/*
  MITRE Technique : T1563 - Remote Service Session Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:07:52.616945+00:00
  Reference       : https://attack.mitre.org/techniques/T1563
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_Linux_SSH_Telnet_Session_Fanout_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single source opens an unusually high number of SSH or Telnet connections within ten minutes, as seen in firewall or perimeter logs. Each connection is benign on its own, but this volume from one source suggests session hijacking or lateral movement through remote shell services on Linux hosts, for example reuse of multiplexed SSH sessions or agent-forwarded credentials. The rule sees only network metadata and cannot confirm that a session was hijacked. Treat it as a hunting lead and pivot to host auditd/EDR on the destinations. Severity is scaled in outcome by connection volume."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1563"
    mitre_technique_name = "Remote Service Session Hijacking"
    log_prerequisites = "Firewall, proxy or network perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. The firewall must see east-west or inter-segment traffic to Linux hosts."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Bastion/jump hosts, configuration management and orchestration servers (automation over SSH), backup and monitoring systems polling over SSH, CI/CD runners, vulnerability scanners and administrators doing fleet maintenance."
    tuning_guidance = "Add bastion, automation and management source addresses to %global_allowed_mgmt_sources and scanner sources to %global_allowed_scanners. Raise the #net threshold on environments with heavy SSH automation, or lower it on tightly segmented networks. Tune the 30-connection severity step in outcome to local baselines."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 22 or $net.target.port = 23)
    $net.principal.ip = $src
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src over 10m

  outcome:
    $risk_score = max(if(count($net.metadata.id) >= 30, 80, 55))
    $mitre_technique_id = array_distinct("T1563")
    $primary_entity = array_distinct($src)
    $event_count = count($net.metadata.id)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 10
}
