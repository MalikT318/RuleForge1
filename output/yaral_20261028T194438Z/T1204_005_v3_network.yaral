/*
  MITRE Technique : T1204.005 - Malicious Library
  Tactic(s)       : Execution
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:06:28.631077+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_005_Package_Manager_Fetch_From_Unapproved_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a package-manager client (pip, npm, yarn, pnpm, NuGet, Poetry) downloading a package archive over HTTP(S) from an external host that is not in the approved domain list. This is the network-side footprint of a user or build job installing a malicious or typosquatted library from an unapproved registry, mirror, or code-hosting endpoint. The rule uses no process fields."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.005"
    mitre_technique_name = "User Execution: Malicious Library"
    log_prerequisites = "Requires proxy or perimeter firewall logs normalised to NETWORK_HTTP with network.http.user_agent, target.url, target.hostname and target.ip populated. TLS-inspecting proxy or equivalent visibility is needed for HTTPS traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Developers or CI/build hosts legitimately installing from official public registries or vendor mirrors that are missing from the approved domain list; internal artifact repositories reached through an external address; package-manager self-update checks; data-science workstations pulling wheels from vendor-hosted indexes."
    tuning_guidance = "Populate %global_allowed_domains with the official registries, CDNs and internal artifact mirrors for each client. Add trusted build servers and developer jump hosts to %global_allowed_script_hosts to suppress expected install activity. If the proxy does not log the full URL, drop the target.url condition and rely on user agent plus domain."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /(^|\s|\()(pip|npm|yarn|pnpm|poetry|setuptools|nuget)[\/\s]|NuGet/ nocase
    $net.target.url = /\.(whl|tgz|tar\.gz|nupkg|egg|zip)(\?|$)|\/(simple|packages|-\/package)\// nocase
    $net.target.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1204.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $user_agents = array_distinct($net.network.http.user_agent)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
