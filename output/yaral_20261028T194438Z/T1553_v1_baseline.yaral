/*
  MITRE Technique : T1553 - Subvert Trust Controls
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:58:25.992945+00:00
  Reference       : https://attack.mitre.org/techniques/T1553
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_003_SIP_Trust_Provider_Registry_Hijack {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of Windows Cryptography registry keys that control Subject Interface Package (SIP) handlers and trust provider verification (CryptSIPDll* and Providers\\Trust\\FinalPolicy). Adversaries repoint these to a malicious DLL so that unsigned or tampered binaries validate as trusted, which subverts Authenticode signature validation."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.003"
    mitre_technique_name = "Subvert Trust Controls: SIP and Trust Provider Hijacking"
    log_prerequisites = "Requires EDR or Sysmon registry value-set telemetry (Sysmon Event ID 13 equivalent) normalised to REGISTRY_MODIFICATION, with target.registry.registry_key and principal.process.file.full_path populated. The Cryptography OID and Providers\\Trust keys must be included in registry monitoring."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows servicing (TrustedInstaller, TiWorker) and cumulative updates; installers for legitimate code-signing or document-signing products that register their own SIP (PDF, MSIX, driver packaging tools); security agents re-registering trust handlers; enterprise PKI or software deployment tooling."
    tuning_guidance = "Add approved installer or deployment binaries to %global_allowed_admin_tools and security agents to %global_allowed_security_tools. The Windows servicing binaries are already excluded by executable name. If a client has a legitimate signing product that registers a SIP, allowlist its installer process rather than the registry path. Registry creation of a brand-new SIP subkey may surface as REGISTRY_CREATION in some EDRs; deploy a sibling rule on that event type if it is required."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Microsoft\\Cryptography\\(OID\\EncodingType 0\\CryptSIPDll[a-z]+|Providers\\Trust\\FinalPolicy)/ nocase
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1553.003")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
