/*
  MITRE Technique : T1047 - Windows Management Instrumentation
  Tactic(s)       : Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:31:08.742698+00:00
  Reference       : https://attack.mitre.org/techniques/T1047
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1047_Outbound_WMI_DCOM_WinRM_To_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Network-side detection of remote WMI traffic leaving the environment. A Windows host opens a connection to a non-internal address on TCP 135 (DCOM/WMI RPC endpoint mapper) or 5985/5986 (WinRM/WS-Management, the WMI-over-WinRM transport). Legitimate WMI and WinRM use is almost entirely internal, so the same traffic toward external address space suggests remote WMI execution against internet-exposed hosts, tunnelled or proxied WMI lateral movement, or tooling misuse."
    mitre_tactic = "Execution"
    mitre_technique = "T1047"
    mitre_technique_name = "Windows Management Instrumentation"
    log_prerequisites = "Requires endpoint network telemetry (EDR or Sysmon Event ID 3) or host firewall logs normalised to UDM NETWORK_CONNECTION with target.ip, target.port and principal.hostname populated. Process attribution on the connection is preferred."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or MSP tooling managing cloud-hosted or DMZ Windows servers over WinRM; cloud automation and hybrid-management agents using WinRM; authorised external vulnerability scanning that probes port 135; misrouted traffic from split-tunnel VPN clients."
    tuning_guidance = "Add approved management tooling to %global_allowed_remote_mgmt or %global_allowed_admin_tools. Add authorised scanner or jump-host source addresses to %global_allowed_scanners or %global_allowed_mgmt_sources. Ensure %rfc1918_internal reflects the client's internal address space. If a client legitimately manages internet-hosted Windows servers, restrict the port logic to 135 only or add the managing process to the allowlists."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 135 or
      $net.target.port = 5985 or
      $net.target.port = 5986
    )
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1047")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $initiating_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
