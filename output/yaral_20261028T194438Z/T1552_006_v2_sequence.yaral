/*
  MITRE Technique : T1552.006 - Group Policy Preferences
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:53:53.905153+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_006_GPP_SYSVOL_Read_Then_External_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A non-system process reads Group Policy Preferences XML files (Groups, Services, ScheduledTasks, DataSources, Printers, Drives) from SYSVOL, then the same process on the same host makes an external network connection within 10 minutes. This suggests GPP cpassword harvesting followed by exfiltration or use of the credentials. File-access telemetry detects it, so it adds coverage beyond command-line rules."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.006"
    mitre_technique_name = "Unsecured Credentials: Group Policy Preferences"
    log_prerequisites = "Requires EDR or Sysmon-equivalent file-read telemetry (including SMB/UNC file access) and process-attributed network connection telemetry, normalised to UDM FILE_READ and NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin or audit scripts that read GPP XML files and then call external services such as cloud inventory or ticketing APIs. Authorised GPO audit and migration tools. Vulnerability scanners that check for cpassword exposure. Backup agents that copy SYSVOL."
    tuning_guidance = "Add approved audit and admin tooling to %global_allowed_admin_tools, scanners to %global_allowed_security_tools, and named admin accounts to %global_allowed_admin_users. If FILE_READ over SMB is noisy on domain controllers, exclude the DC hostnames or the system-level reader processes already filtered by the rule. Shorten the window or require specific file names to raise precision."

  events:
    $read.metadata.event_type = "FILE_READ"
    $read.target.file.full_path = /\\sysvol\\.+\\preferences\\.+\\(groups|services|scheduledtasks|datasources|printers|drives)\.xml$/ nocase
    not $read.principal.process.file.full_path = /\\(svchost|System|lsass|services|MsMpEng|MsSense|SenseIR)(\.exe)?$/ nocase
    not $read.principal.process.file.full_path in %global_allowed_admin_tools
    not $read.principal.process.file.full_path in %global_allowed_security_tools
    not $read.principal.user.userid in %global_allowed_admin_users
    $read.principal.hostname = $hostname
    $read.principal.process.file.full_path = $procpath

    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    $net.principal.hostname = $hostname
    $net.principal.process.file.full_path = $procpath

    $read.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $procpath over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1552.006")
    $primary_entity = array_distinct($hostname)
    $gpp_files_read = array_distinct($read.target.file.full_path)
    $gpp_read_count = count($read.metadata.id)
    $destination_ips = array_distinct($net.target.ip)
    $acting_user = array_distinct($read.principal.user.userid)

  condition:
    $read and $net
}
