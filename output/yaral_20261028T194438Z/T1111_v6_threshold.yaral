/*
  MITRE Technique : T1111 - Multi-Factor Authentication Interception
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:11:50.131861+00:00
  Reference       : https://attack.mitre.org/techniques/T1111
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1111_Linux_Repeated_MFA_Challenge_Failures_Per_User {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated failed second-factor (OTP/TOTP/token/PAM MFA module) authentication events for a single account within ten minutes on Linux hosts. A single failure is benign, but a burst indicates MFA code guessing, OTP replay with a captured or keylogged PIN, or push/prompt fatigue after the password has been obtained."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1111"
    mitre_technique_name = "Multi-Factor Authentication Interception"
    log_prerequisites = "Linux authentication telemetry (PAM/sshd via auditd, syslog or EDR) normalised to USER_LOGIN with the raw message text preserved in metadata.description. PAM MFA modules (google-authenticator, oath, duo, u2f, radius) must log failures."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Users mistyping or desynchronised TOTP codes, clock drift on token devices, newly enrolled users, misconfigured automation using interactive MFA-protected accounts, helpdesk token resync activity."
    tuning_guidance = "Add automation accounts to %global_allowed_service_accounts and authorised testing or jump hosts to %global_allowed_scanners. Raise the #auth threshold for environments with high token desync rates. Extend the message regex if the PAM MFA module in use logs different wording."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.metadata.description = /(pam_google_authenticator|pam_oath|pam_duo|pam_u2f|pam_radius|pam_yubico|verification code|one[- ]?time|totp|otp|token|mfa|2fa|second factor).*(fail|invalid|incorrect|denied|rejected|timeout|timed out|error)/ nocase
    $auth.target.user.userid = $user
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.principal.hostname in %global_allowed_scanners

  match:
    $user over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($auth.metadata.id)
    $mitre_technique_id = array_distinct("T1111")
    $primary_entity = array_distinct($user)
    $source_ips = array_distinct($auth.principal.ip)
    $target_hosts = array_distinct($auth.target.hostname)

  condition:
    #auth >= 5
}
