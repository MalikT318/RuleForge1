/*
  MITRE Technique : T1611 - Escape to Host
  Tactic(s)       : Privilege Escalation
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:31:54.681427+00:00
  Reference       : https://attack.mitre.org/techniques/T1611
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1611_Linux_Nsenter_Host_Namespace_Entry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects nsenter targeting PID 1 (the host init process) while joining one or more host namespaces (mount, pid, net, uts, ipc). From a privileged container or one sharing the host PID namespace, this is a well-known escape to a root shell on the underlying node. The rule matches the combination of a PID 1 target and namespace-join flags rather than a specific payload."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1611"
    mitre_technique_name = "Escape to Host"
    log_prerequisites = "Container runtime or node-level process telemetry (EDR, auditd execve) that populates PROCESS_LAUNCH with full command line, principal.hostname and principal.user.userid. Process events from inside containers must be forwarded with the node or container hostname."
    platform = "Linux"
    log_source = "container"
    false_positives = "Platform engineers running node-debug sessions (for example kubectl debug node or a privileged debug pod), break-glass troubleshooting by SRE teams, CSI or node-maintenance agents that enter host namespaces, and container security or forensics tooling that inspects host namespaces."
    tuning_guidance = "Add approved debug and node-maintenance binaries to %global_allowed_admin_tools, break-glass admin accounts to %global_allowed_admin_users, and EDR or runtime security agents to %global_allowed_security_tools. If node debugging is routine on a client, scope the exclusion to the debug parent process rather than disabling the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/nsenter$/ nocase
    $proc.target.process.command_line = /(\s-t\s*1(\s|$)|\s--target(=|\s+)1(\s|$))/ nocase
    $proc.target.process.command_line = /(\s--(mount|pid|net|uts|ipc|all)\b|\s-[a-zA-Z]*[maupin][a-zA-Z]*(\s|$))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1611")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
