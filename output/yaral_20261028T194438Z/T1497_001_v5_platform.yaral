/*
  MITRE Technique : T1497.001 - System Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:02:35.257118+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_001_VM_Artifact_Query_Commandline {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows process launch whose command line combines a system-query mechanism (WMI/CIM, registry query, or systeminfo) with virtualization or sandbox artifact strings (hypervisor vendor names, guest-tool services, virtual hardware identifiers). Malware and droppers use this check to decide whether to detonate or exit inside an analysis environment. The Windows platform requirement overrode the 'alternate platform' angle, so this variant covers the WMI/registry/CLI VM-artifact query path on Windows."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1497.001"
    mitre_technique_name = "Virtualization/Sandbox Evasion: System Checks"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 / Windows Event 4688 with command-line auditing enabled, normalised to UDM PROCESS_LAUNCH with target.process.command_line populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Virtualization or VDI administrators inventorying guest tools, hardware inventory and asset-management scripts, RMM health checks, IT staff troubleshooting VM guest additions, and software installers that detect virtual hosts for licensing."
    tuning_guidance = "Add approved inventory, RMM and deployment tooling to %global_allowed_admin_tools and EDR or security agents to %global_allowed_security_tools. For environments that are mostly virtualized, tighten the artifact regex to require two or more distinct VM indicators, or add script-host parents to %global_allowed_script_hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /\b(wmic|get-wmiobject|get-ciminstance|gwmi|gcim|reg(\.exe)?\s+query|systeminfo|Win32_(BIOS|ComputerSystem|BaseBoard|DiskDrive|VideoController|PnPEntity|NetworkAdapter|Processor))\b/ nocase
    $proc.target.process.command_line = /(vmware|vmtools|vmhgfs|vmmouse|vmci|virtualbox|vbox(service|guest|mouse|video)?|vbox__|qemu|kvm|xen(service)?|hyper-?v|vmbus|virtual\s?machine|parallels|bochs|sandboxie|cuckoo|sbiedll)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1497.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
