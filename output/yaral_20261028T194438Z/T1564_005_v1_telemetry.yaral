/*
  MITRE Technique : T1564.005 - Hidden File System
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:20:32.591602+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_005_Linux_Disk_Image_Dropped_In_Volatile_Or_Hidden_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a disk image, loopback filesystem or encrypted container file (img, qcow2, vmdk, squashfs, ext4, luks and similar) in a volatile world-writable location (/tmp, /var/tmp, /dev/shm) or inside a hidden dot-directory. Adversaries drop portable partition images and mount them via loop devices to keep payloads and file I/O outside the normal, monitored file system. This rule works on the resulting file artifact, not the command line, so it still fires when the mount or image-creation commands are obfuscated or not logged."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.005"
    mitre_technique_name = "Hide Artifacts: Hidden File System"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-write events (watches on /tmp, /var/tmp, /dev/shm and home directories) normalised to UDM FILE_CREATION with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers and CI runners building VM, container or firmware images in /tmp; package builders (squashfs, initramfs); backup and imaging jobs staging images in scratch space; live-USB or ISO creation by admins; forensic acquisition performed by IR staff."
    tuning_guidance = "Add approved image-building or imaging binaries to %global_allowed_admin_tools or %global_allowed_backup_processes, and named build or IR accounts to %global_allowed_admin_users. Add CI and build runner accounts to %global_allowed_service_accounts. Narrow the extension list if a client regularly produces specific image types in /tmp."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^(\/(tmp|var\/tmp|dev\/shm)\/|\/(home\/[^\/]+|root)\/\.[^\/]+\/|\/var\/lib\/\.[^\/]+\/).*\.(img|raw|qcow2?|vhdx?|vmdk|luks|squashfs|sqsh|ext[234])$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1564.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $image_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
