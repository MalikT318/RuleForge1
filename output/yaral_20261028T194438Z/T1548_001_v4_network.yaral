/*
  MITRE Technique : T1548.001 - Setuid and Setgid
  Tactic(s)       : Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:29:14.963129+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_001_Root_Context_Writable_Path_Process_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Network-side proxy for setuid/setgid abuse: a process running as root from a user-writable location (/tmp, /var/tmp, /dev/shm, /run/user, or a home directory) opens an outbound connection to an external address. Binaries that gain root through a planted setuid/setgid bit usually stay in the directory where the attacker dropped them, so their callbacks, tool downloads or reverse shells show up as root-owned traffic from a writable path. This does not observe the setuid bit itself. It detects the privileged network behaviour that follows, and it complements chmod and command-line rules."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.001"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Setuid and Setgid"
    log_prerequisites = "Linux EDR or auditd-based telemetry that produces NETWORK_CONNECTION events with principal process path and principal user populated, and the target IP populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package builds or installers run with sudo from a home or /tmp directory (pip, npm, cargo, go, make install); self-extracting vendor installers run as root; RMM or deployment agents staging into /tmp; containers or CI runners executing as root from a workspace."
    tuning_guidance = "Add approved tooling binary paths to %global_allowed_admin_tools and EDR or security agent binaries to %global_allowed_security_tools. Add approved automation hosts or parents to %global_allowed_script_hosts. Extend the internal-address exclusion through %rfc1918_internal. Remove the home-directory branch of the path regex on build servers where root builds run from user directories."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.user.userid = /^(root|0)$/ nocase
    $net.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/user\/[^\/]+|home\/[^\/]+)\// nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1548.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
