/*
  MITRE Technique : T1686.003 - Windows Host Firewall
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:31:42.148363+00:00
  Reference       : https://attack.mitre.org/techniques/T1686/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1686_003_Firewall_Profile_Disabled_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Windows Defender Firewall EnableFirewall registry value being set to 0 for the Domain, Standard (Private) or Public profile, in either the local SharedAccess FirewallPolicy hive or the Group Policy WindowsFirewall hive. This catches the resulting state change however it was made (netsh, PowerShell, reg.exe, direct API calls, custom malware), independent of command-line logging."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1686.003"
    mitre_technique_name = "Windows Host Firewall"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon Event ID 12/13) with registry key, value name and value data populated in UDM. The SharedAccess and WindowsFirewall policy keys must not be excluded from registry collection."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy or MDM changes applied by the OS during policy refresh; software installers and lab/imaging tools that temporarily disable the firewall; RMM or endpoint hardening tools toggling profiles; administrators troubleshooting connectivity; VDI/golden image build processes."
    tuning_guidance = "Add approved management and deployment binaries to %global_allowed_admin_tools and EDR/hardening agents to %global_allowed_security_tools. If the writer is a policy-processing service host that generates noise on the Policies key, scope an exception per customer rather than globally. If a source does not populate registry_value_data, remove the value-data condition and compensate with host allowlisting."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(SharedAccess\\Parameters\\FirewallPolicy|Policies\\Microsoft\\WindowsFirewall)\\(DomainProfile|StandardProfile|PrivateProfile|PublicProfile)$/ nocase
    $reg.target.registry.registry_value_name = "EnableFirewall" nocase
    $reg.target.registry.registry_value_data = /^(0|0x0+|0x00000000|dword:0+|0\s*\(0x0\))$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1686.003")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
