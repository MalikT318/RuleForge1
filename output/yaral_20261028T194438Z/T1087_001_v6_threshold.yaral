/*
  MITRE Technique : T1087.001 - Local Account
  Tactic(s)       : Discovery
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:53:30.254885+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_001_ESXi_Local_Account_Enumeration_Auth_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single source attempts authentication to several distinct local accounts on one ESXi host within ten minutes. This pattern indicates local account discovery or username probing through the management plane (SSH, DCUI or host client). Each login event is benign alone; the number of distinct account names is the signal. It complements command-line rules for esxcli account listing by covering authentication telemetry."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.001"
    mitre_technique_name = "Account Discovery: Local Account"
    log_prerequisites = "ESXi hostd and shell authentication logs forwarded and parsed into UDM USER_LOGIN events, with target.hostname, target.user.userid and principal.ip populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Vulnerability scanners and compliance checks that try many accounts, monitoring or inventory tools that rotate service accounts, automation that logs in as several accounts from a jump host, administrators troubleshooting access after a password policy change."
    tuning_guidance = "Add known jump hosts and management stations to %global_allowed_mgmt_sources. Add automation identities to %global_allowed_service_accounts. Add authorised scanners to %global_allowed_scanners. Raise the #auth and distinct account thresholds in the condition if the environment has many shared management hosts."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.hostname = $host
    $auth.principal.ip = $src
    $auth.target.user.userid != ""
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.principal.ip in %global_allowed_scanners

  match:
    $host, $src over 10m

  outcome:
    $risk_score = max(if($auth.security_result.action = "BLOCK", 70, 55))
    $mitre_technique_id = array_distinct("T1087.001")
    $primary_entity = array_distinct($host)
    $login_count = count($auth.metadata.id)
    $distinct_accounts = count_distinct($auth.target.user.userid)
    $attempted_accounts = array_distinct($auth.target.user.userid)
    $source_addresses = array_distinct($src)

  condition:
    #auth >= 8 and $distinct_accounts >= 4
}
