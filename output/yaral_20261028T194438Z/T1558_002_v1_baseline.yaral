/*
  MITRE Technique : T1558.002 - Silver Ticket
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:41:28.546244+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_002_Kerberos_Network_Logon_Null_LogonGuid {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a successful Kerberos network logon to a host or service whose Logon GUID is all zeros. A genuine Kerberos logon is tied to a ticket issued by the KDC and carries a non-null Logon GUID. A forged service ticket (silver ticket) is built offline from the service account hash without contacting the KDC, so the resulting logon commonly has a null GUID. Machine accounts and anonymous logons are excluded."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.002"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Silver Ticket"
    log_prerequisites = "Requires Windows Security event 4624 from servers and domain controllers, normalised to USER_LOGIN. The authentication package must be mapped to extensions.auth.auth_details and the Logon GUID must be preserved in additional.fields under the key LogonGuid. Confirm the parser exposes both before deployment."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Kerberos constrained delegation (S4U2Proxy/S4U2Self) logons, some service-to-service and web-tier delegation flows, cross-forest or cross-realm trust authentication, and clients or parsers that omit or zero the Logon GUID."
    tuning_guidance = "Add known delegation and service accounts to %global_allowed_service_accounts, and named administrators to %global_allowed_admin_users. If the parser does not populate additional.fields LogonGuid or auth_details, adjust the field mapping before enabling. Review a baseline of hits per client for 7 days first. High volume from a single account usually indicates delegation rather than forgery."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.extensions.auth.mechanism = "NETWORK"
    $auth.extensions.auth.auth_details = /kerberos/ nocase
    $auth.additional.fields["LogonGuid"] = /^\{?0{8}-0{4}-0{4}-0{4}-0{12}\}?$/
    $auth.target.user.userid != ""
    not $auth.target.user.userid = /\$$/
    not $auth.target.user.userid = /^(anonymous logon|-)$/ nocase
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1558.002")
    $primary_entity = array_distinct($auth.target.hostname)
    $logon_user = array_distinct($auth.target.user.userid)
    $source_ips = array_distinct($auth.principal.ip)

  condition:
    $auth
}
