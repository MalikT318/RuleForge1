/*
  MITRE Technique : T1546.011 - Application Shimming
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:15:05.268415+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_011_Shim_Installer_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Windows application compatibility shim installer (sdbinst.exe) launched by a parent process that should never install shim databases: an Office application, web server or application server, print spooler, database service, or script host. Shim database installation from these parents indicates exploitation or a malicious document or script establishing persistence or privilege escalation through application shimming. This is a lineage-based detection and does not depend on command-line content."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.011"
    mitre_technique_name = "Event Triggered Execution: Application Shimming"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry that populates both parent (principal.process) and child (target.process) image paths, from an EDR agent, Sysmon Event ID 1, or Security Event 4688 with parent process logging."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy line-of-business application installers or compatibility fixes launched by a script host (wscript/cscript) during deployment; software packaging or deployment tooling that wraps sdbinst.exe in a script; application compatibility testing by IT staff using a script-based harness; database or web application installers that register shims for legacy components."
    tuning_guidance = "Add approved deployment, packaging, and RMM parent binaries to %global_allowed_admin_tools. Add sanctioned script-host parents used for compatibility remediation to %global_allowed_script_hosts. If a client legitimately deploys shims from a script host, scope the exclusion to that parent path rather than removing the script-host alternatives from the regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\sdbinst\.exe$/ nocase
    (
      $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote)\.exe$/ nocase or
      $proc.principal.process.file.full_path = /\\(w3wp|httpd|nginx|tomcat[0-9]*|java|php|php-cgi|iisexpress)\.exe$/ nocase or
      $proc.principal.process.file.full_path = /\\spoolsv\.exe$/ nocase or
      $proc.principal.process.file.full_path = /\\(sqlservr|mysqld|postgres|oracle)\.exe$/ nocase or
      $proc.principal.process.file.full_path = /\\(wscript|cscript|mshta)\.exe$/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1546.011")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
