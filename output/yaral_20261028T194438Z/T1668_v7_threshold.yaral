/*
  MITRE Technique : T1668 - Exclusive Control
  Tactic(s)       : Persistence
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:11:57.433402+00:00
  Reference       : https://attack.mitre.org/techniques/T1668
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1668_Linux_Exclusive_Control_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of 'close the door' commands on a single Linux host within 10 minutes. The commands stop, disable or mask services, add firewall drop/reject rules, make files immutable with chattr, lock accounts, or force-kill processes. Any one command is routine administration. A cluster of them from a non-approved source suggests an intruder removing competing access or malware, or hardening a compromised host for exclusive use."
    mitre_tactic = "Persistence"
    mitre_technique = "T1668"
    mitre_technique_name = "Exclusive Control"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records normalised to UDM PROCESS_LAUNCH with populated command_line, principal.hostname and parent process path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package manager maintenance scripts (service restarts during upgrades), configuration management runs (Ansible, Puppet, Chef, Salt), system hardening or CIS remediation scripts, incident responders isolating a host, container or orchestration node drains, admins decommissioning services."
    tuning_guidance = "Add approved automation and deployment binaries to %global_allowed_admin_tools. Add named administrators to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Raise the #proc threshold for noisy environments, or lower it for high-value servers. Hosts that run regular hardening jobs should have their parent process paths added to the allowlist."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /\b(systemctl|service)\b.*\b(stop|disable|mask)\b|\b(iptables|ip6tables|nft|ufw)\b.*\b(drop|reject|deny)\b|\bchattr\b.*\s\+[a-z]*i|\busermod\b.*\s-L|\bpasswd\b.*\s-l|\b(pkill|killall)\b.*\s-(9|kill)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path = /\/(dpkg|apt|apt-get|yum|dnf|rpm|snapd|unattended-upgrade)$/ nocase

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1668")
    $primary_entity = array_distinct($host)
    $event_count = count($proc.metadata.id)
    $users = array_distinct($proc.principal.user.userid)
    $commands = array_distinct($proc.target.process.command_line)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)

  condition:
    #proc >= 6
}
