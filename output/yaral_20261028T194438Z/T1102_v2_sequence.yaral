/*
  MITRE Technique : T1102 - Web Service
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:52:19.959092+00:00
  Reference       : https://attack.mitre.org/techniques/T1102
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1102_ESXi_SSH_Login_Then_Egress_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an interactive SSH/shell login to an ESXi host from a source outside the approved management addresses, followed within 10 minutes by a change to the host's proxy or firewall configuration. Relaying C2 through an external web service from a hypervisor needs outbound HTTP/S egress. Attackers who lack it often alter the host's proxy or firewall settings right after gaining shell access. This detects the configuration change that enables web-service C2, not the process command line."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1102"
    mitre_technique_name = "Web Service"
    log_prerequisites = "ESXi hostd, shell and auth logs forwarded to Chronicle and parsed into USER_LOGIN and SETTING_MODIFICATION events. The setting event must populate target.resource.name with the changed setting or ruleset."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators connecting from jump hosts not yet in the allowlist and adjusting proxy settings for patching or update-manager access. Automated host-profile or configuration-management remediation. Initial host build and onboarding."
    tuning_guidance = "Add jump hosts and management subnets' addresses to %global_allowed_mgmt_sources. Add administrator accounts to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Narrow the target.resource.name regex if the environment legitimately changes firewall rulesets often."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.target.application = /(ssh|shell)/ nocase
    not $login.principal.ip in %global_allowed_mgmt_sources
    not $login.target.user.userid in %global_allowed_admin_users
    not $login.target.user.userid in %global_allowed_service_accounts
    $login.principal.hostname = $hostname

    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.target.resource.name = /(proxy|firewall|ruleset)/ nocase
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    $setting.principal.hostname = $hostname

    $login.metadata.event_timestamp.seconds <= $setting.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1102")
    $primary_entity = array_distinct($hostname)
    $login_users = array_distinct($login.target.user.userid)
    $login_source_ips = array_distinct($login.principal.ip)
    $changed_settings = array_distinct($setting.target.resource.name)
    $login_count = count($login.metadata.id)
    $setting_change_count = count($setting.metadata.id)

  condition:
    $login and $setting
}
