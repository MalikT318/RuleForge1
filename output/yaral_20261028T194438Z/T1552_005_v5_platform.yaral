/*
  MITRE Technique : T1552.005 - Cloud Instance Metadata API
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:52:55.801310+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_005_Instance_Identity_Sensitive_Cloud_API_Use {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a compute-instance identity session (session name in the form i-<hex instance id>) calling control-plane APIs for IAM enumeration, credential creation or secret retrieval. Workloads rarely make these calls. They are typical of temporary credentials stolen from the instance metadata service, via SSRF or host compromise, and then replayed through the cloud API."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.005"
    mitre_technique_name = "Unsecured Credentials: Cloud Instance Metadata API"
    log_prerequisites = "Cloud control-plane audit logs (management events) ingested and normalised to UDM USER_RESOURCE_ACCESS, with principal.user.userid and metadata.product_event_type populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Infrastructure-as-code or configuration-management agents running on instances with broad roles; secrets-fetching bootstrap scripts at boot; backup or inventory agents that enumerate IAM or list secrets; admins testing instance roles."
    tuning_guidance = "Add approved instance-role session identifiers to %global_allowed_cloud_principals or %global_allowed_service_accounts. Add approved automation and scanner identities to %global_allowed_scanners. Narrow or widen the API-name regex per client. Consider raising severity when the source IP is outside the client's known egress ranges."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.principal.user.userid = /(^|[:\/])i-[0-9a-f]{8,17}$/ nocase
    $cloud.metadata.product_event_type = /^(ListRoles|ListUsers|ListGroups|ListAccessKeys|ListAttachedRolePolicies|ListAttachedUserPolicies|GetAccountAuthorizationDetails|CreateAccessKey|CreateLoginProfile|UpdateLoginProfile|GetSecretValue|ListSecrets|GetPasswordData|GetParametersByPath|GetSessionToken|GetFederationToken)$/ nocase
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_scanners

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1552.005")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_actions = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)
    $user_agents = array_distinct($cloud.network.http.user_agent)

  condition:
    $cloud
}
