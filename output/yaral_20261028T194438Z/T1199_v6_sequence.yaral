/*
  MITRE Technique : T1199 - Trusted Relationship
  Tactic(s)       : Initial Access
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:48:56.853688+00:00
  Reference       : https://attack.mitre.org/techniques/T1199
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1199_Linux_External_Login_Then_Persistence_File_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an interactive login to a Linux host from a non-internal source address, followed within 10 minutes on the same host by modification of an authentication or privilege persistence file (SSH authorized_keys, sudoers, passwd/shadow). This pattern is consistent with a third-party or supplier account abusing a trusted relationship to establish durable access."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1199"
    mitre_technique_name = "Trusted Relationship"
    log_prerequisites = "Requires Linux endpoint telemetry (EDR or auditd) with USER_LOGIN events carrying the source IP and FILE_MODIFICATION events for /etc and ~/.ssh paths. auditd watch rules on authorized_keys, sudoers and passwd/shadow must be enabled."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Contractor or MSP engineers legitimately provisioning SSH keys or sudo rules during onboarding; configuration management or deployment tooling run over SSH; password changes by approved administrators connecting remotely; remote-access jump hosts that appear as non-internal sources."
    tuning_guidance = "Add approved vendor/automation accounts to %global_allowed_service_accounts and %global_allowed_admin_users. Add trusted jump hosts or VPN egress addresses to %global_allowed_mgmt_sources. Add approved configuration management binaries to %global_allowed_admin_tools. If EDR records sudo-elevated file writes as root, correlate the user in the SOAR playbook using the $login_users outcome."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.target.hostname = $hostname
    $login.target.user.userid != ""
    not $login.principal.ip in %rfc1918_internal
    not $login.principal.ip in %global_allowed_mgmt_sources
    not $login.target.user.userid in %global_allowed_service_accounts
    not $login.target.user.userid in %global_allowed_admin_users

    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.principal.hostname = $hostname
    $file.target.file.full_path = /(\/\.ssh\/authorized_keys2?$|^\/etc\/sudoers(\.d\/[^\/]+)?$|^\/etc\/(passwd|shadow)$)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

    $login.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1199")
    $primary_entity = array_distinct($file.principal.hostname)
    $login_users = array_distinct($login.target.user.userid)
    $source_ips = array_distinct($login.principal.ip)
    $modified_files = array_distinct($file.target.file.full_path)
    $modifying_processes = array_distinct($file.principal.process.file.full_path)
    $event_count = count($file.metadata.id)

  condition:
    $login and $file
}
