/*
  MITRE Technique : T1546.003 - Windows Management Instrumentation Event Subscription
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:04:04.104445+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_003_MOF_Dropped_Then_Compiled_WMI_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a .mof file written to a user-writable location followed within 10 minutes by mofcomp.exe launching on the same host. This sequence is the standard way to register a malicious WMI event filter, consumer and binding, which persists and later executes as SYSTEM through WmiPrvSe. It correlates a file-write event with a process-launch event and does not rely on command-line matching."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.003"
    mitre_technique_name = "Event Triggered Execution: Windows Management Instrumentation Event Subscription"
    log_prerequisites = "Requires endpoint file-creation telemetry and process-launch telemetry (EDR or Sysmon Event IDs 11 and 1) with parent process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and hardware or management agents that compile their own WMI providers from temp or ProgramData paths; admins testing WMI classes; SCCM/Intune or RMM deployment of MOF files; some monitoring agents registering WMI providers during install."
    tuning_guidance = "Add approved installers, deployment agents and RMM binaries to %global_allowed_admin_tools (matched against the file-writing process and the mofcomp parent process). Add the parent of mofcomp.exe for approved application installs. If a vendor repeatedly compiles MOFs from a specific staging directory, tune the path regex."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.mof$/ nocase
    $file.target.file.full_path = /\\(temp|tmp|appdata|programdata|users\\public|downloads|perflogs)\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\mofcomp\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1546.003")
    $primary_entity = array_distinct($hostname)
    $mof_files = array_distinct($file.target.file.full_path)
    $mof_writer_processes = array_distinct($file.principal.process.file.full_path)
    $mofcomp_parent_processes = array_distinct($proc.principal.process.file.full_path)
    $mofcomp_command_lines = array_distinct($proc.target.process.command_line)
    $acting_users = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
