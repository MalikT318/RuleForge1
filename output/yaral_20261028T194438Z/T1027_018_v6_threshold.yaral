/*
  MITRE Technique : T1027.018 - Invisible Unicode
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:08:56.985248+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/018
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_018_Invisible_Unicode_In_Outbound_URL_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a single internal source making repeated outbound web requests whose URLs contain invisible or non-printing Unicode characters (zero-width, bidirectional control, word-joiner, BOM, soft-hyphen), raw or percent-encoded. A single such request can be benign. A burst within 10 minutes points to scripted retrieval of Unicode-obfuscated payloads, phishing-kit resources or hidden-text staging."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.018"
    mitre_technique_name = "Obfuscated Files or Information: Invisible Unicode"
    log_prerequisites = "Requires perimeter proxy or firewall HTTP logging that records the full request URL (NETWORK_HTTP with target.url populated). URL-level visibility needs TLS inspection for HTTPS traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Web applications or CDNs that use percent-encoded zero-width characters or soft hyphens in legitimate URLs, internationalised sites (some RTL or Indic scripts use joiners and non-joiners), copy-pasted links containing stray invisible characters, and web crawlers or security scanners."
    tuning_guidance = "Add known-good external domains to %global_allowed_domains. Raise the count threshold in the condition for noisy proxies. Raise it for environments with heavy internationalised web usage, or remove the 200C/200D (joiner) code points from the regex."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /(?i)(%e2%80%(8[b-f]|a[a-e])|%e2%81%(a[0-4]|a[6-9])|%ef%bb%bf|%c2%ad|[\x{200B}-\x{200F}\x{202A}-\x{202E}\x{2060}-\x{2064}\x{2066}-\x{2069}\x{FEFF}\x{00AD}])/
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    $http.principal.ip = $src_ip

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($http.metadata.id)
    $mitre_technique_id = array_distinct("T1027.018")
    $primary_entity = array_distinct($src_ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)

  condition:
    #http >= 5
}
