/*
  MITRE Technique : T1113 - Screen Capture
  Tactic(s)       : Collection
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:15:11.379576+00:00
  Reference       : https://attack.mitre.org/techniques/T1113
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1113_Script_Host_Writes_Image_To_Staging_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a scripting host (PowerShell, WSH, mshta) creating an image file (png/jpg/bmp/gif) in a user-writable staging location such as Temp, Public or ProgramData. This is the file-write artifact of scripted screen capture, for example .NET CopyFromScreen followed by Bitmap.Save. It is additive to command-line rules because it keys on FILE_CREATION telemetry, so it still fires when the command line is obfuscated or encoded. Windows is the mandatory target platform for this rule, so the alternate-platform angle was not applied."
    mitre_tactic = "Collection"
    mitre_technique = "T1113"
    mitre_technique_name = "Screen Capture"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent) with the creating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin or report-generation scripts that export charts or images, IT documentation and helpdesk scripts, software packaging or deployment scripts that unpack image assets, and monitoring or kiosk tooling that takes legitimate screenshots."
    tuning_guidance = "Add approved script-running tooling to %global_allowed_script_hosts and %global_allowed_admin_tools. Extend the staging-path or extension regex if clients use other drop locations. Consider raising severity when the same host also shows outbound transfers shortly afterwards."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\appdata\\local\\temp|users\\public|programdata|windows\\temp)\\(.*\\)?[^\\]+\.(png|jpe?g|bmp|gif)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1113")
    $primary_entity = array_distinct($file.principal.hostname)
    $user = array_distinct($file.principal.user.userid)
    $image_paths = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
