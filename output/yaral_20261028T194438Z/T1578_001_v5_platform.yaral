/*
  MITRE Technique : T1578.001 - Create Snapshot
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:50:35.068688+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_001_Cloud_Snapshot_Created_By_Unapproved_Principal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation or copying of a compute volume, disk, or database snapshot in a cloud control plane by an identity that is not an approved automation, backup, or administrative principal. Adversaries create snapshots to copy data or to mount the copy on an attacker-controlled instance, bypassing restrictions on the original infrastructure."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578.001"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Create Snapshot"
    log_prerequisites = "Cloud control-plane audit logs (management and admin activity) ingested and normalised to UDM RESOURCE_CREATION with metadata.product_event_type populated with the API operation name and principal.user.userid populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Backup and disaster-recovery automation, snapshot lifecycle policies, infrastructure-as-code pipelines, migration projects, administrators taking a manual snapshot before a change, and golden-image build workflows."
    tuning_guidance = "Add backup and lifecycle automation identities to %global_allowed_service_accounts, approved IaC and cloud service principals to %global_allowed_cloud_principals, and named administrators who legitimately snapshot to %global_allowed_admin_users. Review the $snapshot_name and $source_ips outcome values and correlate with later instance creation or snapshot sharing by the same principal."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /(^|\.)(CreateSnapshots?|CopySnapshot|CreateDBSnapshot|CreateDBClusterSnapshot|snapshots\.insert|disks\.createSnapshot)$|Microsoft\.Compute\/snapshots\/write/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1578.001")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_operation = array_distinct($cloud.metadata.product_event_type)
    $snapshot_name = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
