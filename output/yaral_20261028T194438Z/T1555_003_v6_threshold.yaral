/*
  MITRE Technique : T1555.003 - Credentials from Web Browsers
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:57:04.713830+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_003_Browser_Credential_Store_Bulk_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated reads of web browser credential stores (Chromium Login Data / Web Data, Firefox logins.json / key3.db / key4.db) by a process that is not a browser, on one host within 10 minutes. A single read can be benign (sync, backup, AV scan). Repeated reads by a non-browser process are consistent with credential-stealer behaviour."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.003"
    mitre_technique_name = "Credentials from Password Stores: Credentials from Web Browsers"
    log_prerequisites = "Requires EDR or Sysmon-equivalent file-read (file access) telemetry normalised to UDM FILE_READ with principal.process.file.full_path and target.file.full_path populated. Many EDR products only log file reads for sensitive paths. Confirm that browser profile directories are covered."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and imaging agents, enterprise browser-migration or profile-roaming tools, DLP and EDR file scanners, forensic or eDiscovery collection, IT profile-migration scripts, password-manager import utilities."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes, EDR/AV agents to %global_allowed_security_tools, and migration or deployment tooling to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Raise the #file threshold in condition if profile-sync tooling is noisy. Lower it to 3 for high-value hosts."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /\\AppData\\(Local|Roaming)\\.*(\\User Data\\.*\\(Login Data|Web Data)|\\Mozilla\\Firefox\\Profiles\\.*\\(logins\.json|key4\.db|key3\.db))$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\\(chrome|msedge|firefox|brave|opera|vivaldi|iexplore|msedgewebview2|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($file.target.file.full_path = /(?i)(login data|logins\.json|key4\.db|key3\.db)$/, 80, 65))
    $mitre_technique_id = array_distinct("T1555.003")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $reading_processes = array_distinct($file.principal.process.file.full_path)
    $accessed_files = array_distinct($file.target.file.full_path)
    $affected_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 4
}
