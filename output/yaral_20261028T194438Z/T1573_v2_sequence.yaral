/*
  MITRE Technique : T1573 - Encrypted Channel
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:21:03.167435+00:00
  Reference       : https://attack.mitre.org/techniques/T1573
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1573_Linux_Host_TLS_Then_NonStandard_Port_Same_ExternalIP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects an internal host that opens a connection to an external IP on the standard TLS port (443) and then, within 10 minutes, connects to the same external IP on a non-standard high port. This pattern is consistent with implants that use a custom or bespoke encrypted protocol (or a fallback channel) on an unusual port to the same C2 server. Detection relies only on perimeter network telemetry. It cannot see the initiating process, so it covers Linux servers and workloads by egress behaviour rather than by command line."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1573"
    mitre_technique_name = "Encrypted Channel"
    log_prerequisites = "Requires firewall, proxy or perimeter NETWORK_CONNECTION logs with principal.hostname, target.ip, target.port and network.direction populated. Hostname must be resolved or enriched on the source side."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Software update and package mirrors, SaaS or API endpoints that expose both 443 and a high management port, VPN or remote-access gateways, game or media servers, CDN endpoints, and backup or replication agents that use a custom port alongside HTTPS."
    tuning_guidance = "Add expected vendor or update domains to %global_allowed_domains. Add scanners or testing hosts to %global_allowed_scanners. Add known remote-management hosts to %global_allowed_remote_mgmt. Extend the excluded port list (8080, 8443, etc.) to match local standards. Raise the severity for crown-jewel server hosts and lower it for developer workstations."

  events:
    $tls.metadata.event_type = "NETWORK_CONNECTION"
    $tls.network.direction = "OUTBOUND"
    $tls.target.port = 443
    not $tls.target.ip in %rfc1918_internal
    not $tls.target.hostname in %global_allowed_domains
    not $tls.principal.hostname in %global_allowed_scanners
    $tls.principal.hostname = $host
    $tls.target.ip = $ext_ip

    $custom.metadata.event_type = "NETWORK_CONNECTION"
    $custom.network.direction = "OUTBOUND"
    $custom.target.port > 1024
    $custom.target.port != 8080
    $custom.target.port != 8443
    not $custom.target.ip in %rfc1918_internal
    not $custom.target.hostname in %global_allowed_domains
    not $custom.principal.hostname in %global_allowed_scanners
    $custom.principal.hostname = $host
    $custom.target.ip = $ext_ip

    $tls.metadata.event_timestamp.seconds <= $custom.metadata.event_timestamp.seconds

  match:
    $host, $ext_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1573")
    $primary_entity = array_distinct($host)
    $destination_ips = array_distinct($ext_ip)
    $nonstandard_ports = array_distinct($custom.target.port)
    $tls_connection_count = count($tls.metadata.id)
    $custom_connection_count = count($custom.metadata.id)

  condition:
    $tls and $custom
}
