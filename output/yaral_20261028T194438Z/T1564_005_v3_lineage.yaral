/*
  MITRE Technique : T1564.005 - Hidden File System
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:21:10.175554+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_005_Linux_Service_Parent_Spawns_Filesystem_Utility {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application runtime, or database service process directly spawning a filesystem-construction or mounting utility (mount, loop device, device-mapper, FUSE, or mkfs tooling). Service processes do not normally attach or build filesystems. This lineage is consistent with a compromised service (for example via a web shell) staging a hidden or virtual file system, such as a loopback image, encrypted container, or FUSE overlay, to conceal payloads and I/O from the host's normal view."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.005"
    mitre_technique_name = "Hide Artifacts: Hidden File System"
    log_prerequisites = "Linux endpoint process telemetry (EDR or auditd execve) populating both the parent process path (principal.process.file.full_path) and the child process path (target.process.file.full_path)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Database or application services that legitimately mount volumes through helper scripts, for example snapshot or backup hooks run by a database service account. Container or PaaS agents that run under a Java or Node runtime and attach storage. Web hosting control panels that create per-site quota or loopback filesystems. Self-managed encrypted-volume workflows launched by an application runtime."
    tuning_guidance = "Add approved parent binaries (e.g. management agents running under a Java or Node runtime) to %global_allowed_admin_tools. Add approved database or snapshot tooling to %global_allowed_backup_processes. Extend the parent regex with client-specific service binaries if needed. Consider raising severity on internet-facing web servers."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php|php-cgi|php-fpm[0-9.]*|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server)$/ nocase
    $proc.target.process.file.full_path = /\/(mount|losetup|cryptsetup|dmsetup|fusermount3?|mount\.fuse3?|mount\.ntfs-3g|ntfs-3g|squashfuse|encfs|bindfs|mkfs|mkfs\.[a-z0-9]+|mke2fs|mkntfs)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1564.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
