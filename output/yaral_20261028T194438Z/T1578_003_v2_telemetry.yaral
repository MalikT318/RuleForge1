/*
  MITRE Technique : T1578.003 - Delete Cloud Instance
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:53:11.902861+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_003_Instance_Deletion_Protection_Disabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a control-plane configuration change that removes the safeguards preventing a cloud instance from being deleted (termination or deletion protection disabled, or a management lock removed). Adversaries make this change just before destroying an instance to erase forensic evidence. Detecting the configuration change catches the preparation step even when the later delete call is performed by a different identity or tool."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578.003"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Delete Cloud Instance"
    log_prerequisites = "Cloud control-plane audit logs ingested and normalised to UDM as SETTING_MODIFICATION with metadata.product_event_type populated. Management-plane write and configuration events must be enabled."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Planned decommissioning and instance rebuilds by platform teams, infrastructure-as-code pipelines replacing instances, autoscaling or lifecycle automation, and change-window lock removal by cloud administrators. Generic instance-attribute modifications unrelated to termination protection can also match."
    tuning_guidance = "Add IaC pipeline and automation identities to %global_allowed_service_accounts, named cloud administrators to %global_allowed_admin_users, and approved federated or workload principals to %global_allowed_cloud_principals. If the instance-attribute pattern is too noisy, restrict the regex to termination-protection specific operations for your provider. Correlate hits with subsequent instance deletion events for the same principal."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /(DisableApiTermination|ModifyInstanceAttribute|setDeletionProtection|DeletionProtection|locks\/delete)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1578.003")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_operations = array_distinct($cloud.metadata.product_event_type)
    $target_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
