/*
  MITRE Technique : T1559.002 - Dynamic Data Exchange
  Tactic(s)       : Execution
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:54:15.407595+00:00
  Reference       : https://attack.mitre.org/techniques/T1559/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_002_Office_Parent_Spawns_Shell_DDE {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Microsoft Office application (Word, Excel, PowerPoint, Outlook, Access, Publisher, Visio) directly spawning a command shell or script interpreter. This lineage is the characteristic result of Dynamic Data Exchange (DDE/DDEAUTO) abuse in poisoned documents, spreadsheets or emails. It also covers other Office-to-shell execution chains, because Office applications rarely launch interpreters in normal use."
    mitre_tactic = "Execution"
    mitre_technique = "T1559.002"
    mitre_technique_name = "Inter-Process Communication: Dynamic Data Exchange"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with parent and child process paths and command line (EDR, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing), normalised to UDM PROCESS_LAUNCH."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office add-ins or VSTO solutions that shell out to cmd or PowerShell; finance or reporting workbooks with legacy macro or DDE integrations; document management or ERP plug-ins; Outlook rules or add-ins launching scripts; IT-approved automation run from Office."
    tuning_guidance = "Add approved parent Office hosts or automation parents to %global_allowed_script_hosts. Add approved automation accounts to %global_allowed_service_accounts. Add sanctioned deployment or RMM tooling to %global_allowed_admin_tools. Review recurring hits per host and per document workflow before excluding anything."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|powershell_ise|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1559.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
