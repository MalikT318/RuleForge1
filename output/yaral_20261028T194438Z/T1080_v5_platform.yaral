/*
  MITRE Technique : T1080 - Taint Shared Content
  Tactic(s)       : Lateral Movement
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:22:19.797378+00:00
  Reference       : https://attack.mitre.org/techniques/T1080
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1080_Linux_Script_Or_Launcher_Modified_On_Shared_Mount {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of an executable script, desktop launcher or self-contained executable bundle stored on a Linux shared-storage mount path (NFS/CIFS/SMB mounts under /mnt, /media, /srv, /net, /run/media or Samba usershares). Tainting shared content by appending or replacing code in files other users will execute is a lateral movement technique. The .desktop launcher is the Linux analogue of the Windows .LNK directory-share pivot. This is the Linux variant of the technique; Windows coverage is assumed to exist elsewhere."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1080"
    mitre_technique_name = "Taint Shared Content"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-write watches on mounted share paths, normalised to UDM FILE_MODIFICATION with principal.process and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers and admins editing scripts directly on shared team mounts, deployment or configuration-management jobs that publish scripts to NFS/CIFS shares, backup or sync agents writing restored files, and CI runners writing build artifacts to shared storage."
    tuning_guidance = "Add approved deployment and publishing tools to %global_allowed_admin_tools, backup and sync software to %global_allowed_backup_processes, and automation accounts to %global_allowed_service_accounts. If a client mounts shares outside the default paths, extend the mount-path regex. If shared script repositories are edited constantly, restrict to non-interactive writers or raise the severity threshold per client."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/(mnt|media|srv|net|run\/media\/[^\/]+|var\/lib\/samba\/usershares)\/.+\.(sh|bash|py|pl|rb|php|desktop|appimage|run|bin)$/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1080")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
