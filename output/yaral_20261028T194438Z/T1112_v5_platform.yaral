/*
  MITRE Technique : T1112 - Modify Registry
  Tactic(s)       : Defense Impairment, Persistence
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:13:22.005043+00:00
  Reference       : https://attack.mitre.org/techniques/T1112
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1112_Credential_Protection_Registry_Weakened {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modifications that weaken Windows credential protections: enabling WDigest plaintext credential caching (UseLogonCredential set to 1) or disabling LSA protected process mode (RunAsPPL set to 0). Based on REGISTRY_MODIFICATION telemetry, so it complements process command-line rules and also catches changes made through APIs, scripts or remote registry. The target platform is fixed to Windows, so the non-Windows pivot was not applied; this rule adds registry-event coverage instead."
    mitre_tactic = "Defense Impairment, Persistence"
    mitre_technique = "T1112"
    mitre_technique_name = "Modify Registry"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 13) with registry key, value name and value data populated in UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Security baseline or hardening tooling (GPO or MDM pushing RunAsPPL changes), legacy applications that need WDigest and have an approved exception, lab or test hosts, administrators changing LSA settings during troubleshooting."
    tuning_guidance = "Add approved configuration management and hardening tooling to %global_allowed_admin_tools and EDR or security agents to %global_allowed_security_tools. If value data is not populated for a client, remove the registry_value_data conditions and tune on the writing process instead."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      (
        $reg.target.registry.registry_key = /\\Control\\SecurityProviders\\WDigest$/ nocase and
        $reg.target.registry.registry_value_name = /^UseLogonCredential$/ nocase and
        $reg.target.registry.registry_value_data = /(^1$|0x0*1\)?$)/ nocase
      ) or
      (
        $reg.target.registry.registry_key = /\\Control\\Lsa$/ nocase and
        $reg.target.registry.registry_value_name = /^RunAsPPL$/ nocase and
        $reg.target.registry.registry_value_data = /(^0$|0x0+\)?$)/ nocase
      )
    )
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1112")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $modified_value = array_distinct($reg.target.registry.registry_value_name)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
