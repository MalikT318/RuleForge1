/*
  MITRE Technique : T1053 - Scheduled Task/Job
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:11:27.438701+00:00
  Reference       : https://attack.mitre.org/techniques/T1053
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_Container_Service_Parent_Spawns_Scheduler {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an in-container process lineage anomaly in which a network-facing service or application runtime (web server, PHP/Java/Node runtime, database, cache) directly spawns a job-scheduling utility (crontab, at, batch, systemd-run). Application-tier processes do not normally create scheduled jobs, so this lineage is a strong indicator of web-shell, RCE or injection-based persistence. Detection uses only parent and child executable lineage, not command-line content."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053"
    mitre_technique_name = "Scheduled Task/Job"
    log_prerequisites = "Requires container runtime or node-level process telemetry (PROCESS_LAUNCH for in-container execution) with populated parent and child process paths."
    platform = "Containers"
    log_source = "container"
    false_positives = "Application images with built-in maintenance or backup features that install cron entries at startup, CMS or PHP applications with self-managed cron setup, database containers running scheduled maintenance via entrypoint scripts, and init or entrypoint wrappers that run the application runtime as a parent of crontab."
    tuning_guidance = "Add approved parent runtimes or entrypoint binaries to %global_allowed_script_hosts, approved automation or deployment tooling to %global_allowed_admin_tools, and service accounts expected to manage scheduled jobs to %global_allowed_service_accounts. Extend the parent regex to cover additional application runtimes used by the client."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|httpd|apache2|lighttpd|caddy|php|php-fpm[0-9.]*|php-cgi|tomcat[0-9]*|java|node|gunicorn|uwsgi|ruby|puma|python[0-9.]*|dotnet|mysqld|mariadbd|postgres|mongod|redis-server|memcached)$/ nocase
    $proc.target.process.file.full_path = /\/(crontab|at|batch|atd|systemd-run)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1053")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
