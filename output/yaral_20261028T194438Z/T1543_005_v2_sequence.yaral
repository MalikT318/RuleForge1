/*
  MITRE Technique : T1543.005 - Container Service
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:57:18.656761+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_005_K8s_Secret_Access_Then_DaemonSet_Create {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects one identity reading Kubernetes secrets or requesting service-account tokens and then creating a DaemonSet within ten minutes. A DaemonSet runs a workload on every node, including nodes added later, so this pattern suggests credential access followed by cluster-wide persistence or privilege escalation."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.005"
    mitre_technique_name = "Create or Modify System Process: Container Service"
    log_prerequisites = "Requires Kubernetes API server audit logs at Metadata level or higher, covering secrets, serviceaccounts/token and daemonsets, normalized to UDM with principal.user.userid and target.url (request URI) populated."
    platform = "Containers"
    log_source = "container"
    false_positives = "GitOps and CD controllers deploying DaemonSets (CNI, logging, monitoring agents), cluster operators and Helm installs, platform admins rotating secrets and then deploying node agents, security tooling that reads secrets."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts and named platform administrators to %global_allowed_admin_users. Both events are excluded for identities on these lists. Raise severity for non-kube-system namespaces, or require a service-account principal, if the environment is noisy."

  events:
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.target.url = /\/api\/v1\/namespaces\/[^\/]+\/(secrets|serviceaccounts\/[^\/]+\/token)/ nocase
    $access.principal.user.userid = $user
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_admin_users
    not $access.principal.user.userid = /^system:(node|kube-|apiserver)/ nocase

    $create.metadata.event_type = "RESOURCE_CREATION"
    $create.target.url = /\/apis\/apps\/v1\/namespaces\/[^\/]+\/daemonsets(\?|$)/ nocase
    $create.principal.user.userid = $user
    not $create.principal.user.userid in %global_allowed_service_accounts
    not $create.principal.user.userid in %global_allowed_admin_users

    $access.metadata.event_timestamp.seconds <= $create.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1543.005")
    $primary_entity = array_distinct($user)
    $accessed_resources = array_distinct($access.target.url)
    $created_daemonsets = array_distinct($create.target.url)
    $source_ips = array_distinct($create.principal.ip)
    $access_count = count($access.metadata.id)

  condition:
    $access and $create
}
