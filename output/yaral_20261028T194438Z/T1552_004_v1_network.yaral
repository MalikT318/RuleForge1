/*
  MITRE Technique : T1552.004 - Private Keys
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:50:06.305999+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_004_Private_Key_File_Upload_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an HTTP upload (POST/PUT) to an external destination where the requested URL references a private key or certificate-bundle file (.pfx, .p12, .ppk, .pem, .key, or default SSH key names such as id_rsa). This is the network-side signature of private keys being staged or exfiltrated to external storage, paste, or file-sharing services after discovery on a Windows host. Public-certificate extensions (.cer, .crt, .p7b) are deliberately excluded to reduce noise. Coverage is limited to uploads where the filename appears in the URL path or query; multipart POSTs that carry the filename only in the body are not visible to this rule."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.004"
    mitre_technique_name = "Unsecured Credentials: Private Keys"
    log_prerequisites = "Requires web proxy or perimeter firewall logs normalised to NETWORK_HTTP with network.http.method and target.url populated. HTTPS destinations require TLS inspection to expose the full URL path."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Administrators uploading certificates to approved PKI, key-vault, or certificate-management portals; DevOps pipelines pushing signing certificates to SaaS CI/CD or code-signing services; vendor support uploads of PEM bundles; MDM or device-enrolment services receiving PFX files."
    tuning_guidance = "Add approved certificate-management and vendor destinations to %global_allowed_domains. Review the source principal.ip and map it to the owning Windows host for triage. If noise persists, narrow the extension list to .pfx, .p12 and .ppk, or add known egress sources to %global_allowed_mgmt_sources."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT)$/ nocase
    $net.target.url = /(\.(pfx|p12|ppk|pem|key)|id_(rsa|dsa|ecdsa|ed25519))([?#;&]|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1552.004")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
