/*
  MITRE Technique : T1574.011 - Services Registry Permissions Weakness
  Tactic(s)       : Stealth, Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:42:11.522647+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_011_Service_Binary_From_Writable_Path_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Network-side observation of Services Registry Permissions Weakness abuse. A process launched directly by the Service Control Manager (services.exe parent) from a user-writable location makes an outbound connection to a non-internal address. When a service ImagePath is redirected to an attacker-controlled executable, that payload runs as a service child, usually from a staging directory, and calls out. This detects the result of the hijack rather than the registry or sc.exe command line."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.011"
    mitre_technique_name = "Hijack Execution Flow: Services Registry Permissions Weakness"
    log_prerequisites = "Requires endpoint network telemetry (EDR or Sysmon Event ID 3) that populates the initiating process path and its parent process path, normalised to NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Third-party agents or line-of-business services installed under ProgramData or a user profile, portable or self-updating services run from Temp, software installers that briefly register a service from a staging folder, and legitimate vendor services in non-standard install paths."
    tuning_guidance = "Add approved service binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. If a client has many ProgramData-hosted services, add those binaries to the allowlist by executable name. Optionally extend with %global_allowed_domains once a destination domain field is reliably populated for the client."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.parent_process.file.full_path = /\\services\.exe$/ nocase
    $net.principal.process.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|users\\public|windows\\temp|programdata|perflogs|windows\\tasks|temp)\\.+\.exe$/ nocase
    not $net.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|NisSrv)\.exe$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.target.ip in %rfc1918_internal

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1574.011")
    $primary_entity = array_distinct($net.principal.hostname)
    $service_binary = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
