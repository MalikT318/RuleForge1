/*
  MITRE Technique : T1559 - Inter-Process Communication
  Tactic(s)       : Execution
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:50:35.755820+00:00
  Reference       : https://attack.mitre.org/techniques/T1559
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_001_DCOM_Embedding_Parent_Spawns_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a COM/DCOM-activated host process (launched with the -Embedding switch) spawning a command or script interpreter. This pattern is typical of COM/DCOM abuse such as MMC20.Application or ShellWindows remote execution and Office COM automation, where the interpreter's parent is the COM server rather than an interactive shell lineage."
    mitre_tactic = "Execution"
    mitre_technique = "T1559.001"
    mitre_technique_name = "Inter-Process Communication: Component Object Model"
    log_prerequisites = "Requires EDR or Sysmon process creation telemetry (or Windows Event 4688 with command-line auditing) that populates both the parent process command line and the child process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate administration scripts that drive MMC snap-ins or Office applications via COM automation, software deployment and RMM agents using COM, line-of-business add-ins that launch helper scripts, and explorer shell extensions that start a command interpreter."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts, and add named administrator accounts to %global_allowed_admin_users. If Office automation is noisy in a client environment, remove the Office parents from the parent regex for that client and keep mmc and explorer."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(mmc|explorer|excel)\.exe$/ nocase
    $proc.principal.process.command_line = /[-\/]Embedding\b/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1559.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
