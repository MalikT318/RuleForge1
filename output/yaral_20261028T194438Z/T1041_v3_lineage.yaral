/*
  MITRE Technique : T1041 - Exfiltration Over C2 Channel
  Tactic(s)       : Exfiltration
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:59:31.861811+00:00
  Reference       : https://attack.mitre.org/techniques/T1041
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1041_ESXi_Mgmt_Daemon_Spawns_Shell_Or_Transfer_Tool {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi management-plane daemon (host agent, reverse proxy, vCenter agent, CIM broker, WS-Man) spawning a shell, script interpreter, or network transfer utility. These daemons do not normally launch interactive shells or outbound transfer tools. Such lineage indicates a compromised management service or an injected C2 implant staging or exfiltrating data over its existing channel. The rule matches on process lineage only, not on command-line content."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1041"
    mitre_technique_name = "Exfiltration Over C2 Channel"
    log_prerequisites = "ESXi shell and process-execution telemetry forwarded to Chronicle and normalised to PROCESS_LAUNCH with populated principal.process.file.full_path (parent) and target.process.file.full_path (child). Requires a syslog or agent pipeline that records process lineage on the host."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Vendor-supplied health-check or support-bundle scripts launched by hostd or vpxa; lifecycle or patching tooling invoked through the host agent; backup or monitoring integrations that call CLI helpers via the management service; legitimate vendor diagnostics run during a support case."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts. If a specific daemon-to-child pair is legitimate in an environment, narrow the parent or child regex for that client rather than disabling the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(hostd|rhttpproxy|vpxa|fdm|sfcbd|sfcb-[a-z0-9_-]+|openwsman|slpd|vobd|vmsyslogd)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|ash|bash|busybox|python[0-9.]*|perl|curl|wget|nc|ncat|netcat|scp|sftp|ssh)$/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1041")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
