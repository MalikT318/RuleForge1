/*
  MITRE Technique : T1213.001 - Confluence
  Tactic(s)       : Collection
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:23:45.751828+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_001_External_Bulk_Wiki_Content_Retrieval_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects HTTP requests from an external source address to a wiki collaboration platform's content, space or search REST API that request bulk or full-body retrieval (large page limits, body expansion), or that call page and space export actions. This is network-side evidence of an adversary mining documentation repositories for credentials, architecture diagrams and internal links."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.001"
    mitre_technique_name = "Data from Information Repositories: Confluence"
    log_prerequisites = "Requires HTTP request telemetry for the collaboration SaaS tenant (reverse proxy, CASB, secure web gateway or SaaS access logs) normalised to NETWORK_HTTP with target.url and principal.ip populated."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Approved integrations and sync connectors, backup or migration tools, search indexers, authorised documentation export jobs, remote staff on VPN split-tunnel paths, and security assessment scanners."
    tuning_guidance = "Add approved integration accounts to %global_allowed_service_accounts, authorised scanner and export-job source addresses to %global_allowed_scanners, and named administrators to %global_allowed_admin_users. Raise the limit threshold in the regex if API-heavy integrations are noisy."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/rest\/api\/(content|space|search)[^ ]*(expand=[^&]*body|limit=[0-9]{3,})|\/(exportword|pdfpageexport)\.action|\/spaces\/(flyingpdf|exportspace)/ nocase
    $http.principal.ip != ""
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.user.userid in %global_allowed_service_accounts
    not $http.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1213.001")
    $primary_entity = array_distinct($http.principal.ip)
    $source_user = array_distinct($http.principal.user.userid)
    $requested_urls = array_distinct($http.target.url)
    $request_count = count($http.metadata.id)

  condition:
    $http
}
