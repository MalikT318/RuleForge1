/*
  MITRE Technique : T1688 - Safe Mode Boot
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:36:31.058772+00:00
  Reference       : https://attack.mitre.org/techniques/T1688
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1688_SafeBoot_Registry_Minimal_Network_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Several registry value writes under the SafeBoot Minimal or Network keys on a single host within 10 minutes. Adversaries add services, drivers or COM objects to these keys so their payload still loads after a forced safe mode boot, when EDR and other defenses may not start. A single write can be benign, for example a driver install. A burst of writes from one host is not typical."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1688"
    mitre_technique_name = "Safe Mode Boot"
    log_prerequisites = "Requires Windows registry value-set telemetry (EDR registry events or Sysmon registry events) normalised to REGISTRY_MODIFICATION with target.registry.registry_key populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Driver and security-product installers registering safe-mode-capable services, disk encryption and backup agent installs or upgrades, imaging or golden-image build processes, and IT staff intentionally configuring safe mode services."
    tuning_guidance = "Add approved installers and deployment tooling to %global_allowed_admin_tools, security agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Raise the #reg threshold if software deployment windows cause noise. Lower it to 1 on high-security assets."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control\\SafeBoot\\(Minimal|Network)(\\|$)/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    not $reg.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|TrustedInstaller)\.exe$/ nocase

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1688")
    $primary_entity = array_distinct($host)
    $event_count = count($reg.metadata.id)
    $modified_keys = array_distinct($reg.target.registry.registry_key)
    $acting_users = array_distinct($reg.principal.user.userid)
    $acting_processes = array_distinct($reg.principal.process.file.full_path)

  condition:
    #reg >= 3
}
