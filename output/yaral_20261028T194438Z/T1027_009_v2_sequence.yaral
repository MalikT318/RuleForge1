/*
  MITRE Technique : T1027.009 - Embedded Payloads
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:51:42.877814+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_009_Embedded_Payload_Dropped_Then_Executed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A document viewer, Office application or script host writes an executable or DLL into a user-writable location, and that same file is launched on the same host within five minutes. This sequence is typical of a payload embedded in a document or script being extracted and run."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.009"
    mitre_technique_name = "Obfuscated Files or Information: Embedded Payloads"
    log_prerequisites = "Requires EDR or Sysmon FILE_CREATION events (Sysmon Event ID 11) with the creating process populated, plus PROCESS_LAUNCH events with the full image path (Sysmon Event ID 1 or Windows Event 4688 with process creation auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office add-ins or macros that legitimately unpack helper executables, PDF reader plugin or updater components, installers launched from script hosts, and software packaging or deployment scripts that run through wscript or cscript."
    tuning_guidance = "Add approved deployment and packaging tools to %global_allowed_admin_tools, and EDR or AV agents to %global_allowed_security_tools. Add known-good script hosts to %global_allowed_script_hosts. If a client has line-of-business Office add-ins that drop binaries, narrow the dropper process regex or the target directory regex for that client."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|onenote|msaccess|acrord32|acrobat|foxitreader|foxitpdfreader|wscript|cscript|mshta)\.exe$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|programdata|users\\public|windows\\temp)\\.*\.(exe|dll|scr|com|cpl)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $path

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\.(exe|scr|com)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    $proc.principal.hostname = $hostname
    $proc.target.process.file.full_path = $path

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.009")
    $primary_entity = array_distinct($hostname)
    $dropped_file = array_distinct($path)
    $dropper_process = array_distinct($file.principal.process.file.full_path)
    $executed_command_line = array_distinct($proc.target.process.command_line)
    $affected_user = array_distinct($file.principal.user.userid)

  condition:
    $file and $proc
}
