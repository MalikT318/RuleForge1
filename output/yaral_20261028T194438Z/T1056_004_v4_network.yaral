/*
  MITRE Technique : T1056.004 - Credential API Hooking
  Tactic(s)       : Collection, Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:51:32.481365+00:00
  Reference       : https://attack.mitre.org/techniques/T1056/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1056_004_Linux_Auth_Process_External_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux authentication-path process (sshd, sudo, su, login, passwd, unix_chkpwd, polkit helper, display-manager session worker) opening a network connection to a non-internal address. These binaries rarely make external connections. Outbound traffic from them is characteristic of a hooked or preloaded library, or a malicious PAM module, sending captured credentials to an external collector."
    mitre_tactic = "Collection, Credential Access"
    mitre_technique = "T1056.004"
    mitre_technique_name = "Input Capture: Credential API Hooking"
    log_prerequisites = "Requires Linux EDR or auditd-based network connection telemetry (connect syscall events) that populates principal.process.file.full_path and target.ip."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "sshd with TCP port forwarding or ProxyJump enabled; PAM stacks that call external LDAP, RADIUS, Kerberos, or SSO/MFA services; display-manager session workers using cloud identity; passwd or chage against remote directory services."
    tuning_guidance = "Add known external auth endpoints (identity providers, MFA, RADIUS/LDAP over WAN) to %global_allowed_domains. Add service accounts that legitimately proxy through these binaries to %global_allowed_service_accounts. Add approved remote-access tooling paths to %global_allowed_remote_mgmt. Hosts that legitimately act as SSH jump hosts may need a host-level exception or a lower severity."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(sshd|sudo|su|login|passwd|unix_chkpwd|chage|polkit-agent-helper-1|gdm-session-worker)$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1056.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $auth_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
