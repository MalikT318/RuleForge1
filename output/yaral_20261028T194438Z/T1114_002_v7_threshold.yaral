/*
  MITRE Technique : T1114.002 - Remote Email Collection
  Tactic(s)       : Collection
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:20:47.442171+00:00
  Reference       : https://attack.mitre.org/techniques/T1114/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_002_Mass_Mailbox_Item_Access_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single user account generates a high volume of mailbox item access audit events within ten minutes. A single mailbox read is benign, but bulk access from one identity is consistent with automated mailbox harvesting using stolen credentials or tokens."
    mitre_tactic = "Collection"
    mitre_technique = "T1114.002"
    mitre_technique_name = "Email Collection: Remote Email Collection"
    log_prerequisites = "Requires unified audit logs with mailbox auditing enabled (mailbox item access events), ingested into UDM as USER_RESOURCE_ACCESS with metadata.product_event_type populated."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Email archiving and eDiscovery tools, migration projects, backup and journaling connectors, shared or delegated mailbox users, mail clients doing an initial full sync or cache rebuild, and security or compliance scanning of mail content."
    tuning_guidance = "Add service and automation accounts to %global_allowed_service_accounts and compliance or eDiscovery administrators to %global_allowed_admin_users. The threshold of 50 is conservative: raise it for tenants with heavy delegated-mailbox or sync activity, and lower it for high-value mailboxes. Correlate the source IPs in the outcome with sign-in telemetry to prioritise alerts from unfamiliar locations."

  events:
    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.metadata.product_event_type = /^(MailItemsAccessed|MessageBind)$/ nocase
    $access.principal.user.userid != ""
    $access.principal.user.userid = $user
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($access.metadata.id)
    $mitre_technique_id = array_distinct("T1114.002")
    $primary_entity = array_distinct($user)
    $source_ips = array_distinct($access.principal.ip)
    $operations = array_distinct($access.metadata.product_event_type)

  condition:
    #access >= 50
}
