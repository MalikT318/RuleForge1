/*
  MITRE Technique : T1036.012 - Browser Fingerprint
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:17:42.357912+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_012_Legacy_Browser_UserAgent_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source sends a burst of outbound HTTP requests to external destinations using an obsolete browser or OS user-agent (for example MSIE 6-9 or Windows NT 5.x and earlier). A single request is benign, but sustained volume suggests an implant spoofing a browser identity to blend in with web traffic."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.012"
    mitre_technique_name = "Masquerading: Browser Fingerprint"
    log_prerequisites = "Requires proxy or firewall logs with HTTP inspection that populate network.http.user_agent, principal.ip and target.ip (TLS inspection needed for HTTPS traffic)."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legacy line-of-business applications or embedded clients that hardcode old user-agents, legacy OT/kiosk systems, outdated update agents, web-compatibility test tools, and automation that intentionally uses old compatible user-agents."
    tuning_guidance = "Add known-good external destinations to %global_allowed_domains and legacy-application or scanner source IPs to %global_allowed_scanners. Raise the #http threshold in noisy environments. Review for beacon-like periodicity and a single external destination."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.user_agent = /^Mozilla\/[0-4]\.\d+ \(compatible; MSIE [1-9]\.\d|Windows NT [1-5]\.\d/ nocase
    $http.principal.ip = $src_ip
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(55)
    $event_count = count($http.metadata.id)
    $mitre_technique_id = array_distinct("T1036.012")
    $primary_entity = array_distinct($src_ip)
    $user_agents = array_distinct($http.network.http.user_agent)
    $destination_ips = array_distinct($http.target.ip)
    $destination_hosts = array_distinct($http.target.hostname)

  condition:
    #http >= 10
}
