/*
  MITRE Technique : T1037 - Boot or Logon Initialization Scripts
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:18:35.459511+00:00
  Reference       : https://attack.mitre.org/techniques/T1037
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_Linux_Network_Init_Script_Download_Via_CLI_Agent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux host retrieving a shell script from an external destination over HTTP using a command-line downloader user agent (curl/wget). Persistence via boot or logon initialization scripts (rc.local, init.d, systemd units, profile.d, cron @reboot) is commonly staged this way: a small bootstrap fetches the real payload script on every boot or logon. This is the network-side view and complements endpoint file-modification detections."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037"
    mitre_technique_name = "Boot or Logon Initialization Scripts"
    log_prerequisites = "Requires proxy or perimeter firewall logs with HTTP inspection (URL and user agent) normalised to UDM NETWORK_HTTP. Source hosts must be attributable via principal.hostname. Populate %rfc1918_internal with internal address space."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Configuration management bootstrap (cloud-init, provisioning scripts), package or installer one-liners from vendor sites, developer and CI hosts that pipe install scripts, monitoring agent installers, authorised admin automation."
    tuning_guidance = "Add known-good vendor and repository domains to %global_allowed_domains. Add build, CI and provisioning hosts to %global_allowed_script_hosts. Raise severity for servers that should never download scripts directly from the internet. Ensure %rfc1918_internal is populated or internal mirrors will alert."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /^(curl|wget|fetch)\// nocase
    $net.target.url = /\.(sh|bash)(\?.*)?$/ nocase
    $net.network.http.method = "GET" nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1037")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
