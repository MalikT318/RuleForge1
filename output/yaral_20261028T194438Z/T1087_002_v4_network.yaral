/*
  MITRE Technique : T1087.002 - Domain Account
  Tactic(s)       : Discovery
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:54:49.088839+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_002_Linux_LDAP_Directory_Query_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux host opening a network connection to LDAP, LDAPS or Active Directory Global Catalog ports (389, 636, 3268, 3269) from a process that is not a known directory-service client or daemon. Interactive LDAP clients, scripts and implants enumerate domain users and groups this way. Internal address space is deliberately NOT excluded, because domain controllers are normally internal hosts. Noise is controlled by excluding expected directory clients by executable name and by reference-list allowlists."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.002"
    mitre_technique_name = "Account Discovery: Domain Account"
    log_prerequisites = "Requires Linux endpoint network telemetry (EDR or auditd socket/connect events) that populates the initiating process path and the destination port."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Identity-integration software (SSSD, Winbind, realmd and similar), PAM/NSS LDAP lookups, sudo or SSH LDAP integrations, backup or inventory agents that query the directory, IT automation and RMM tooling, and authorised administrators running directory queries."
    tuning_guidance = "Add approved tooling executables to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and authorised scanner hosts to %global_allowed_scanners. If a client's directory client uses a custom binary name, extend the executable-name regex. Events with no initiating process path are skipped by design; remove that condition if the client's telemetry never populates it and a broader rule is acceptable."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 389 or $net.target.port = 636 or $net.target.port = 3268 or $net.target.port = 3269)
    $net.principal.process.file.full_path = /.+/
    not $net.principal.process.file.full_path = /\/(sssd|sssd_be|sssd_nss|sssd_pam|winbindd|nslcd|slapd|ns-slapd|realmd|adcli|smbd|nmbd|samba|oddjobd|krb5kdc|sshd|sudo|ipa[a-z_-]*|dirsrv[a-z_-]*)$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1087.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $source_user = array_distinct($net.principal.user.userid)
    $directory_servers = array_distinct($net.target.ip)
    $directory_ports = array_distinct($net.target.port)

  condition:
    $net
}
