/*
  MITRE Technique : T1538 - Cloud Service Dashboard
  Tactic(s)       : Discovery
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:38:21.223228+00:00
  Reference       : https://attack.mitre.org/techniques/T1538
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1538_Cloud_Console_Rapid_Dashboard_Sessions {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single identity establishes an unusually high number of interactive sign-ins to a cloud management console, portal or dashboard within ten minutes. One console sign-in is benign, but repeated sessions can indicate stolen credentials or tokens being used to browse the dashboard and enumerate services, resources and security findings."
    mitre_tactic = "Discovery"
    mitre_technique = "T1538"
    mitre_technique_name = "Cloud Service Dashboard"
    log_prerequisites = "Requires identity provider or cloud console sign-in audit logs normalized to USER_LOGIN with target.application populated with the console or portal application name."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Administrators or engineers with short-lived console sessions that re-authenticate frequently, SSO session timeouts and MFA re-prompts, role switching across many accounts, shared NOC or SOC dashboard users, and approved cloud posture or inventory tooling that signs in interactively."
    tuning_guidance = "Add automation and break-glass identities to %global_allowed_service_accounts, named administrators to %global_allowed_admin_users, and approved bastion or VPN egress addresses to %global_allowed_mgmt_sources. Raise the #auth threshold for tenants with aggressive session timeouts. Review source_ips and login_count in the outcome to separate a single admin from multi-IP credential abuse."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.application = /(console|portal|dashboard|command center)/ nocase
    $auth.principal.user.userid = $user
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users
    not $auth.principal.ip in %global_allowed_mgmt_sources

  match:
    $user over 10m

  outcome:
    $risk_score = max(55)
    $login_count = count($auth.metadata.id)
    $source_ips = array_distinct($auth.principal.ip)
    $console_apps = array_distinct($auth.target.application)
    $mitre_technique_id = array_distinct("T1538")
    $primary_entity = array_distinct($user)

  condition:
    #auth >= 5
}
