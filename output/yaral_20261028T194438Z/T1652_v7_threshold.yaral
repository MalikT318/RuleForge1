/*
  MITRE Technique : T1652 - Device Driver Discovery
  Tactic(s)       : Discovery
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:56:24.649468+00:00
  Reference       : https://attack.mitre.org/techniques/T1652
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1652_Rapid_Driver_Enumeration_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects multiple device-driver enumeration commands (driver listing utilities, PnP driver enumeration, filter driver listing, driver service queries, WMI/CIM system driver queries) executed on a single Windows host within 10 minutes. A single command is common administrative activity; repeated enumeration in a short window suggests adversary discovery of security tooling, virtualization drivers or vulnerable drivers."
    mitre_tactic = "Discovery"
    mitre_technique = "T1652"
    mitre_technique_name = "Device Driver Discovery"
    log_prerequisites = "Requires EDR process telemetry, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled, normalised to UDM PROCESS_LAUNCH with target.process.command_line populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT inventory and asset-management agents, RMM health checks, driver and patch deployment tooling, helpdesk troubleshooting of hardware or driver issues, endpoint security agents auditing loaded filter drivers, and vulnerability or compliance scanners."
    tuning_guidance = "Add approved inventory and RMM parent processes to %global_allowed_admin_tools, security agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Raise the #proc threshold for noisy environments. Review the command_lines outcome to confirm distinct enumeration methods were used."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /\bdriverquery\b|\bpnputil(\.exe)?\b.*(\/enum-drivers|\/e\b|-e\b|\/enum-devices)|\benum-drivers\b|\bfltmc(\.exe)?\b.*\bfilters\b|\bsc(\.exe)?\b.*\bquery\b.*type=\s*(driver|kernel)|win32_systemdriver|win32_pnpsigneddriver|\bget-windowsdriver\b|\bwmic\b.*\bsysdriver\b/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(55)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1652")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
