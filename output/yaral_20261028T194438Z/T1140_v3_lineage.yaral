/*
  MITRE Technique : T1140 - Deobfuscate/Decode Files or Information
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : ESXi
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:09:48.197253+00:00
  Reference       : https://attack.mitre.org/techniques/T1140
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1140_ESXi_MgmtDaemon_Spawns_Decoder_Or_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi management or network-facing daemon (hostd, vpxa, rhttpproxy, openwsman, sfcb, snmpd, slpd) directly spawning a shell, scripting interpreter or decode/decompress utility. These daemons do not normally launch decoders. This lineage is characteristic of remote exploitation or management-plane abuse followed by payload deobfuscation (T1140). Detection is based on process lineage, not on command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1140"
    mitre_technique_name = "Deobfuscate/Decode Files or Information"
    log_prerequisites = "Requires ESXi process-execution telemetry (shell and hostd logs forwarded and normalised to UDM PROCESS_LAUNCH with populated principal.process.file.full_path and target.process.file.full_path). NOTE: this rule was requested with platform ESXi and log_source macos_endpoint. The lineage logic is ESXi-specific (vmkernel and hostd daemons) and will not match native macOS telemetry. Confirm the client log source mapping before deployment."
    platform = "ESXi"
    log_source = "macos_endpoint"
    false_positives = "VMware/vendor plugins or VIBs that shell out from hostd or vpxa during patching or host-profile remediation; monitoring agents invoked via sfcb/CIM providers; vendor health-check scripts; hardware-vendor management integrations; backup or orchestration tooling that runs scripts through the management agents."
    tuning_guidance = "Add approved parent daemons or helper processes to %global_allowed_script_hosts and approved management tooling to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Review hits on the first run to baseline legitimate hostd/vpxa-spawned scripts per client. If noise is high, restrict the child regex to decoders only (base64|openssl|xxd|uudecode|gunzip|zcat)."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(hostd|vpxa|fdm|rhttpproxy|openwsmand|sfcbd|sfcb-[a-z0-9_-]+|snmpd|slpd)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|ash|bash|dash|busybox|python|python3|perl|base64|openssl|xxd|uudecode|gunzip|zcat)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1140")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
