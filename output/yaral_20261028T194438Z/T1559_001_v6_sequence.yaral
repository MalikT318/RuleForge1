/*
  MITRE Technique : T1559.001 - Component Object Model
  Tactic(s)       : Execution
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:53:10.197056+00:00
  Reference       : https://attack.mitre.org/techniques/T1559/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_001_COM_Hijack_Registry_Then_COM_Host_Spawns_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A script host or LOLBin writes a per-user COM server registration (InprocServer32 or LocalServer32 under Software\\Classes\\CLSID), and within 10 minutes a COM surrogate or MMC host (dllhost.exe, mmc.exe) on the same host spawns a shell, script interpreter or proxy-execution binary. This pattern indicates COM hijacking or COM object abuse for local code execution."
    mitre_tactic = "Execution"
    mitre_technique = "T1559.001"
    mitre_technique_name = "Inter-Process Communication: Component Object Model"
    log_prerequisites = "Requires EDR or Sysmon registry modification telemetry (Sysmon Event ID 12/13) and process creation telemetry with parent process paths (Sysmon Event ID 1 or Windows Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters that register per-user COM servers via scripts or reg.exe, developers registering test COM components, Office or shell extensions registered at first run, admin scripts that use mmc.exe snap-ins to launch cmd or PowerShell, and legitimate dllhost.exe-hosted components that start helper scripts."
    tuning_guidance = "Add approved installer, deployment and packaging tools to %global_allowed_admin_tools (matched against the registry writer process path). Add automation accounts to %global_allowed_service_accounts. Add approved parent hosts for script execution to %global_allowed_script_hosts. Add EDR and AV agents to %global_allowed_security_tools. If the hijack and the trigger regularly occur more than 10 minutes apart in the environment, deploy a companion single-event rule on the registry write alone."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Software\\Classes\\CLSID\\\{[^\\]+\}\\(InprocServer32|LocalServer32)$/ nocase
    $reg.principal.process.file.full_path = /\\(powershell|pwsh|reg|cmd|wscript|cscript|mshta|regsvr32|rundll32)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    $reg.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(dllhost|mmc)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    $proc.principal.hostname = $hostname

    $reg.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1559.001")
    $primary_entity = array_distinct($hostname)
    $com_registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_writer_processes = array_distinct($reg.principal.process.file.full_path)
    $com_host_processes = array_distinct($proc.principal.process.file.full_path)
    $spawned_processes = array_distinct($proc.target.process.file.full_path)
    $spawned_command_lines = array_distinct($proc.target.process.command_line)
    $affected_users = array_distinct($reg.principal.user.userid)

  condition:
    $reg and $proc
}
