/*
  MITRE Technique : T1548.001 - Setuid and Setgid
  Tactic(s)       : Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:28:57.210956+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_001_Service_Parent_Spawns_Setuid_Chmod {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing or data-service daemon (web server, application server, database, print or file service) launching chmod to set the setuid or setgid bit. These daemons have no legitimate reason to create privileged binaries. This usually indicates a web shell, injected code, or exploited service planting a persistent SUID backdoor."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.001"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Setuid and Setgid"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry normalised to UDM PROCESS_LAUNCH with populated parent process path (principal.process.file.full_path), child process path and command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package or application installers and update hooks run by a service daemon, CMS or plugin installers invoked by a web server, database packaging or maintenance scripts that adjust helper binary permissions, and containerised applications that set permissions at start-up."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools and approved administrator accounts to %global_allowed_admin_users. Extend the parent regex with additional local service daemons (for example java application servers) where the environment justifies it. Where interpreters such as sh or bash sit between the daemon and chmod, correlate in a separate rule or review the process tree during triage."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|caddy|php-fpm[0-9.]*|php-cgi|uwsgi|gunicorn|tomcat[0-9]*|mysqld|mariadbd|postgres|mongod|redis-server|memcached|cupsd|smbd|vsftpd|proftpd|sshd-session)$/ nocase
    $proc.target.process.file.full_path = /\/chmod$/ nocase
    $proc.target.process.command_line = /(\s|,)(0?[2-7][0-7]{3}|[ugoa]*[+=][rwxXt]*s)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1548.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
