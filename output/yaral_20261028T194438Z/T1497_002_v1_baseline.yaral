/*
  MITRE Technique : T1497.002 - User Activity Based Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:03:39.442155+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_002_Linux_User_Activity_Sandbox_Check {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects Linux processes that probe for signs of a real interactive user, as used for sandbox and VM evasion. Probes include querying mouse position or X idle time, reading raw input devices or keyboard and mouse interrupt counters, and counting files in user Desktop, Documents, Downloads or browser profile directories, or counting shell history entries. Malware uses these checks to decide whether to detonate or stay dormant."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1497.002"
    mitre_technique_name = "Virtualization/Sandbox Evasion: User Activity Based Checks"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records with full command-line arguments, normalised to UDM PROCESS_LAUNCH."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Desktop automation and accessibility tooling, screen lockers and idle-based power management scripts, kiosk or VDI session monitors, user-profile or home-directory inventory scripts, backup and quota scripts that count files, admins troubleshooting input devices."
    tuning_guidance = "Add approved parent processes (inventory, VDI session agents) to %global_allowed_admin_tools, and approved automation hosts to %global_allowed_script_hosts. Add service and automation accounts to %global_allowed_service_accounts. Add EDR and security agents that enumerate user directories to %global_allowed_security_tools. On developer workstations, consider raising severity only when the parent process is a non-interactive shell, cron, or a process launched from /tmp or /dev/shm."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $proc.target.process.command_line = /(xdotool\s+getmouselocation|xprintidle|xinput\s+(test|test-xi2)\b|\bcat\s+\/dev\/input\/(mice|mouse\d*|event\d+)|\/proc\/interrupts.*(i8042|keyboard|mouse))/ nocase or
      $proc.target.process.command_line = /\b(ls|find)\b[^|]*\/(Desktop|Documents|Downloads|\.mozilla|\.config\/(google-chrome|chromium))[^|]*\|\s*wc\s+-l/ nocase or
      $proc.target.process.command_line = /\bwc\s+-l\s+[^|]*\.(bash|zsh)_history/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1497.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
