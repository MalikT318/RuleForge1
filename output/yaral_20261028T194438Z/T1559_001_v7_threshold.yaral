/*
  MITRE Technique : T1559.001 - Component Object Model
  Tactic(s)       : Execution
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:53:27.491858+00:00
  Reference       : https://attack.mitre.org/techniques/T1559/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_001_COM_Object_Instantiation_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several script-interpreter launches on one host within ten minutes instantiate execution-capable COM objects through command-line COM APIs (New-Object -ComObject, GetTypeFromProgID, Activator.CreateInstance, CreateObject). A single instantiation is common in administration, but repeated use points to COM-based local or DCOM lateral execution."
    mitre_tactic = "Execution"
    mitre_technique = "T1559.001"
    mitre_technique_name = "Inter-Process Communication: Component Object Model"
    log_prerequisites = "Requires EDR or Sysmon process-launch telemetry with full command lines (Sysmon Event ID 1 or Windows Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT automation and inventory scripts using WScript.Shell, Shell.Application or Schedule.Service; login scripts; Office automation and reporting scripts; software packaging and deployment tooling; administrators working interactively in PowerShell."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts or %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Raise the #proc threshold on hosts that run COM-heavy automation. Lower it to 2 for high-value servers."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(New-Object\s+(-ComObject|-Com)\b|GetTypeFromProgID|GetTypeFromCLSID|\[activator\]::CreateInstance|CreateObject\s*\()/ nocase
    $proc.target.process.command_line = /(MMC20\.Application|ShellWindows|ShellBrowserWindow|Excel\.Application|Outlook\.Application|Schedule\.Service|WScript\.Shell|Shell\.Application|InternetExplorer\.Application|htmlfile|MSXML2\.(Server)?XMLHTTP)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1559.001")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $interpreters = array_distinct($proc.target.process.file.full_path)
    $sample_command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
