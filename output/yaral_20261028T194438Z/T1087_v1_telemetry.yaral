/*
  MITRE Technique : T1087 - Account Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:50:15.160235+00:00
  Reference       : https://attack.mitre.org/techniques/T1087
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_IaaS_Directory_Visibility_Setting_Weakened {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a configuration change to tenant-wide directory or authorization settings that govern how much user and account information ordinary or guest identities can read, such as guest access restrictions, 'users can read other users' and default user permissions. Loosening these settings makes account enumeration possible with any low-privilege or compromised identity, and the setting change is the durable artifact of that preparation. This detects the state change, not an enumeration command or API call."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087"
    mitre_technique_name = "Account Discovery"
    log_prerequisites = "Identity provider directory audit logs ingested and normalised to UDM SETTING_MODIFICATION, with metadata.product_event_type populated with the audit activity name. Cloud control-plane audit logs must be ingested if tenant-level directory settings are managed there."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Planned tenant hardening or reconfiguration by identity administrators; guest or B2B collaboration onboarding projects; directory migration or merger work; infrastructure-as-code pipelines applying tenant settings; routine sync of directory policy objects."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation or IaC identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Narrow the product_event_type regex to the activity names your identity provider emits for directory and authorization policy updates. Correlate with a change-management ticket before escalating. Raise severity if the actor is a recently created or newly privileged identity."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(authorization.?polic|directory.?(setting|polic|property)|guest.?(user)?.?(access|role|permission|restrict|invite)|(user|member).?default.?(role|permission)|read.?other.?users|external.?collaboration|cross.?tenant.?access)/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1087")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $changed_setting = array_distinct($setting.metadata.product_event_type)
    $target_resource = array_distinct($setting.target.resource.name)
    $source_ip = array_distinct($setting.principal.ip)

  condition:
    $setting
}
