/*
  MITRE Technique : T1653 - Power Settings
  Tactic(s)       : Persistence
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:57:00.405220+00:00
  Reference       : https://attack.mitre.org/techniques/T1653
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1653_Linux_Power_Management_Config_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects modification of Linux power-management configuration files (systemd-logind, systemd sleep settings, UPower) by a process that is not a package manager or an approved admin tool. Adversaries edit these files to stop a compromised host from suspending, hibernating or idling into a dormant state, which extends their access. Detection is on the resulting file state change, not the command line, so it still fires when the edit is made with an editor, a script, shell redirection or a renamed binary."
    mitre_tactic = "Persistence"
    mitre_technique = "T1653"
    mitre_technique_name = "Power Settings"
    log_prerequisites = "Linux EDR file telemetry or auditd file-watch rules (-w on /etc/systemd/logind.conf, /etc/systemd/sleep.conf and their .conf.d directories) normalised to UDM FILE_MODIFICATION with principal process populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management agents (Ansible, Puppet, Chef, Salt) enforcing power policy; OS image builds and first-boot provisioning; administrators tuning laptops or workstations; desktop environment settings daemons; package upgrades that rewrite default configs that are not caught by the package-manager exclusion."
    tuning_guidance = "Add configuration management and provisioning binaries to %global_allowed_admin_tools. Add automation identities to %global_allowed_service_accounts. Servers and VMs normally never need these files changed, so keep the rule strict there. Where EDR reports new drop-in files as FILE_CREATION rather than FILE_MODIFICATION, deploy a copy of this rule with that event type. Do not combine both types in one rule."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/(etc|run|usr\/lib|lib)\/systemd\/(logind|sleep)\.conf(\.d\/[^\/]+\.conf)?$|^\/etc\/UPower\/UPower\.conf$/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|yum|dnf|zypper|snapd|packagekitd|pacman)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1653")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $modifying_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
