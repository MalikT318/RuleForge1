/*
  MITRE Technique : T1021.004 - SSH
  Tactic(s)       : Lateral Movement
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:41:13.868591+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_004_ESXi_SSH_Login_Volume_Per_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a high volume of SSH logins to a single ESXi host within ten minutes. Each login is benign on its own. A burst of logins suggests credential stuffing against a valid account, or an adversary or automation using valid accounts to move laterally through the hypervisor layer."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.004"
    mitre_technique_name = "Remote Services: SSH"
    log_prerequisites = "ESXi host authentication logs (sshd entries from the shell/auth logs) forwarded and parsed into UDM USER_LOGIN events with target.hostname and target.application populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Backup and orchestration tooling that opens many short SSH sessions, configuration management and patching runs, monitoring scripts that poll via SSH, administrators working through many maintenance tasks, and approved vulnerability scanners."
    tuning_guidance = "Add management jump hosts and orchestration sources to %global_allowed_mgmt_sources. Add automation accounts to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Raise the #auth threshold for environments with heavy automation. Lower it for hosts that should only be accessed during change windows."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.application = /ssh/ nocase
    $auth.target.hostname = $host
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1021.004")
    $primary_entity = array_distinct($host)
    $login_count = count($auth.metadata.id)
    $source_ips = array_distinct($auth.principal.ip)
    $accounts_used = array_distinct($auth.target.user.userid)

  condition:
    #auth >= 10
}
