/*
  MITRE Technique : T1185 - Browser Session Hijacking
  Tactic(s)       : Collection
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:31:39.375093+00:00
  Reference       : https://attack.mitre.org/techniques/T1185
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1185_Browser_Remote_Debugging_Launch_By_NonBrowser {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows browser launched with a remote debugging port or pipe by a parent process that is not itself a browser. This exposes the DevTools protocol, which lets a local or remote process read cookies, inherit authenticated sessions and drive the browser as a pivot. Scope note: the request asked for a non-Windows pivot, but the mandatory platform requirement is Windows, so this rule covers a Windows-only behavior (command-line enablement of browser remote control) distinct from injection-based variants."
    mitre_tactic = "Collection"
    mitre_technique = "T1185"
    mitre_technique_name = "Browser Session Hijacking"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command lines (EDR, Sysmon Event ID 1 or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web developers and QA engineers using DevTools remote debugging, browser test automation (Selenium, Puppeteer, Playwright), headless rendering or PDF-generation services, and IT tooling that scripts browsers."
    tuning_guidance = "Add approved automation parents and developer tooling to %global_allowed_script_hosts or %global_allowed_admin_tools. Scope noisy developer or build hosts through the same lists. Consider raising severity if the launching user is not a developer or the parent is a script interpreter or Office application."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(chrome|msedge|brave|vivaldi|opera|firefox)\.exe$/ nocase
    $proc.target.process.command_line = /\s--?remote-debugging-(port|pipe)/ nocase
    not $proc.principal.process.file.full_path = /\\(chrome|msedge|brave|vivaldi|opera|firefox|chrome_proxy|msedgewebview2)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1185")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $browser_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
