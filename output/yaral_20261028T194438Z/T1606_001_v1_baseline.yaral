/*
  MITRE Technique : T1606.001 - Web Cookies
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:23:12.716992+00:00
  Reference       : https://attack.mitre.org/techniques/T1606/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1606_001_Forged_Web_Cookie_Construction_Script {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a script interpreter whose command line builds forged authentication cookies or tickets. It matches either ASP.NET forms-authentication ticket or machine-key encryption APIs, or a cookie object paired with the name of an authentication or session cookie. This is the Windows-side signal of forging session cookies from stolen key material."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1606.001"
    mitre_technique_name = "Forge Web Credentials: Web Cookies"
    log_prerequisites = "Requires EDR process telemetry, Sysmon Event ID 1, or Windows Event 4688 with command-line auditing enabled. PowerShell script-block text is only visible here when it is passed on the command line."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web developers and QA engineers testing ASP.NET forms authentication from PowerShell. Load-testing or synthetic-monitoring scripts that set session cookies. Web farm administrators validating machineKey configuration. Authorised red-team and pen-test activity."
    tuning_guidance = "Add approved automation hosts or parent processes to %global_allowed_script_hosts. Add approved developer or test accounts to %global_allowed_admin_users. Add approved tooling to %global_allowed_admin_tools. If synthetic-monitoring noise remains, raise the severity only for servers that host identity providers or web front ends."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|wscript|cscript)\.exe$/ nocase
    (
      $proc.target.process.command_line = /(FormsAuthenticationTicket|FormsAuthentication[\]\.:]+Encrypt|MachineKey[\]\.:]+(Protect|Encode))/ nocase or
      (
        $proc.target.process.command_line = /(Net\.Cookie\b|CookieContainer|Set-Cookie|Add-Cookie)/ nocase and
        $proc.target.process.command_line = /(ESTSAUTH|\.ASPXAUTH|RefreshTokenCredential|SAMLResponse|wresult)/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1606.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
