/*
  MITRE Technique : T1195.002 - Compromise Software Supply Chain
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:41:50.258789+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_002_Plaintext_HTTP_Software_Installer_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a successful unencrypted HTTP (port 80) download of an installer, update package, or executable payload from an external destination. Supply chain compromises of update and distribution mechanisms (hijacked update channels, tampered release downloads) are commonly delivered over plaintext transport that can be intercepted or substituted. Legitimate vendors almost always deliver installers over TLS, so a plaintext executable fetch is a high-value signal."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.002"
    mitre_technique_name = "Supply Chain Compromise: Compromise Software Supply Chain"
    log_prerequisites = "Requires firewall or web proxy logs normalised to UDM NETWORK_HTTP with target.url, target.port, network.http.method and network.http.response_code populated. TLS inspection is not required, because the rule only covers plaintext HTTP."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legacy vendor update clients that still use plaintext HTTP, OS or driver repositories served over HTTP, internal-facing software mirrors behind NAT with public addresses, and admins or developers downloading installers manually."
    tuning_guidance = "Add known-good vendor and update distribution domains to %global_allowed_domains. Internal address space is already excluded through %rfc1918_internal. Adjust the file extension list to the client's software deployment practices. Before tuning out a source, confirm that the update client validates package signatures."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET"
    $net.network.http.response_code = 200
    $net.target.port = 80
    $net.target.url = /\.(exe|msi|msp|msix|appx|dll|cab|scr)(\?|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1195.002")
    $primary_entity = array_distinct($net.principal.ip)
    $download_urls = array_distinct($net.target.url)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
