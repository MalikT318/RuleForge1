/*
  MITRE Technique : T1489 - Service Stop
  Tactic(s)       : Impact
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:38:58.975368+00:00
  Reference       : https://attack.mitre.org/techniques/T1489
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1489_Service_Stop_Unexpected_Parent_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a service-control or process-kill utility (sc, net, net1, taskkill, PowerShell) launched by an unexpected parent: an Office application, web server worker, database engine or print spooler. Those parents have no legitimate reason to stop, disable or kill services. This usually indicates exploitation, a webshell or a malicious macro preparing for data destruction or encryption. The rule keys on lineage and requires only a minimal stop/disable/kill qualifier on the child."
    mitre_tactic = "Impact"
    mitre_technique = "T1489"
    mitre_technique_name = "Service Stop"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry (EDR, Sysmon Event ID 1, or Security Event 4688 with parent process and command-line auditing) populating both parent and child process paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Database maintenance jobs where sqlservr.exe or an agent spawns net stop/start for patching; web applications that deliberately restart application services via w3wp.exe (some legacy admin panels); print-management software that restarts the spooler via a spoolsv.exe child; Office-hosted deployment or licensing add-ins that recycle services (rare)."
    tuning_guidance = "Add legitimate parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts. Add known automation accounts to %global_allowed_service_accounts. For noisy web or database servers, add the specific parent process path of the approved maintenance tool to the allowlist rather than removing the parent from the regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|onenote|visio|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|sqlservr|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(sc|net|net1|taskkill|powershell|pwsh)\.exe$/ nocase
    $proc.target.process.command_line = /(\bstop\b|\bpause\b|start=\s*disabled|-startuptype\s+disabled|\bstop-service\b|\bstop-process\b|\bset-service\b|\/(im|pid)\s)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1489")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
