/*
  MITRE Technique : T1005 - Data from Local System
  Tactic(s)       : Collection
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:12:49.220041+00:00
  Reference       : https://attack.mitre.org/techniques/T1005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1005_NetDevice_Config_Exfil_Via_TFTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects TFTP (UDP/69) traffic from an internal network device or host to an external destination. TFTP is the classic channel for copying running or startup configuration and other local device files off a network device (for example, a 'copy running-config tftp:' style transfer). Adversaries use it to collect sensitive local data such as credentials, ACLs and VPN settings before exfiltration. TFTP has no authentication and is rarely legitimate across the perimeter."
    mitre_tactic = "Collection"
    mitre_technique = "T1005"
    mitre_technique_name = "Data from Local System"
    log_prerequisites = "Firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Egress TFTP traffic must traverse a logging inspection point."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Approved config-backup jobs to an off-site TFTP server, network engineers staging firmware or config images on a cloud lab server, ZTP/provisioning workflows pointed at an external provisioning host, and vulnerability scanners probing UDP/69."
    tuning_guidance = "Add approved config-backup and provisioning source addresses to %global_allowed_mgmt_sources and authorised scanner sources to the same list. If a client legitimately backs up configs externally, add the source device addresses to %global_allowed_mgmt_sources, or raise severity and keep the rule enabled only for the egress perimeter."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    $net.network.ip_protocol = "UDP"
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1005")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $source_hostnames = array_distinct($net.principal.hostname)

  condition:
    $net
}
