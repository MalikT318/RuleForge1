/*
  MITRE Technique : T1070.009 - Clear Persistence
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:12:02.568344+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_009_Persistence_Registry_Value_Deleted_By_Untrusted_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects deletion of autostart persistence registry entries (Run, RunOnce, Winlogon Shell/Userinit, Policies Explorer Run) by a process running from a user-writable location or by a script host or registry utility. This catches an adversary removing persistence after use, regardless of how the command was issued, because it keys on the resulting registry state change rather than the command line."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.009"
    mitre_technique_name = "Indicator Removal: Clear Persistence"
    log_prerequisites = "Requires Windows endpoint registry telemetry that records key and value deletions (EDR registry events or Sysmon Event IDs 12/13 normalised to REGISTRY_DELETION). Registry auditing must cover the HKLM and HKCU Run keys."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software uninstallers and updaters that remove their own Run entries from a temp or ProgramData path, installer bootstrappers, RunOnce self-cleanup after first-run tasks, RMM or deployment tooling, and admins cleaning up startup items with reg.exe or PowerShell."
    tuning_guidance = "Add approved deployment and RMM binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Add vetted script-running parents or hosts to %global_allowed_script_hosts. If RunOnce self-cleanup is noisy, remove RunOnce from the key regex."

  events:
    $reg.metadata.event_type = "REGISTRY_DELETION"
    $reg.target.registry.registry_key = /\\(CurrentVersion\\(Run|RunOnce|RunServices|RunServicesOnce)|CurrentVersion\\Policies\\Explorer\\Run|CurrentVersion\\Winlogon)(\\|$)/ nocase
    $reg.principal.process.file.full_path = /(\\(appdata|temp|programdata|users\\public|perflogs)\\|\\(reg|powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32|wmic)\.exe$)/ nocase
    not $reg.principal.process.file.full_path = /\\(msiexec|TrustedInstaller|TiWorker|MsMpEng|MsSense|SenseIR|svchost|explorer)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1070.009")
    $primary_entity = array_distinct($reg.principal.hostname)
    $deleted_registry_key = array_distinct($reg.target.registry.registry_key)
    $deleted_value_name = array_distinct($reg.target.registry.registry_value_name)
    $deleting_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
