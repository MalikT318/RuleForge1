/*
  MITRE Technique : T1569.003 - Systemctl
  Tactic(s)       : Execution
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:14:25.666459+00:00
  Reference       : https://attack.mitre.org/techniques/T1569/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_003_Systemctl_Rapid_Service_Control {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of systemctl state-changing subcommands (start, restart, enable, link, daemon-reload, and similar) on a single Linux host within ten minutes. A single invocation is routine administration. Repeated service control in a short window can indicate an adversary using systemd to execute payloads or persist them as services."
    mitre_tactic = "Execution"
    mitre_technique = "T1569.003"
    mitre_technique_name = "System Services: Systemctl"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records that populate command line and process path in UDM PROCESS_LAUNCH events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management runs (Ansible, Puppet, Chef, Salt), package installs and upgrades that restart services, container host bootstrap scripts, cloud-init at first boot, and admins performing maintenance."
    tuning_guidance = "Add approved automation and deployment binaries to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Raise the #proc threshold for hosts that routinely run provisioning. Review hosts where 'enable' or 'link' is among the observed subcommands first."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/systemctl$/ nocase
    $proc.target.process.command_line = /\b(start|restart|reload-or-restart|enable|reenable|link|daemon-reload|unmask|isolate)\b/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($proc.target.process.command_line = /\b(enable|reenable|link)\b/ nocase, 75, 55))
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1569.003")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 5
}
