/*
  MITRE Technique : T1176.002 - IDE Extensions
  Tactic(s)       : Persistence
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:30:19.738851+00:00
  Reference       : https://attack.mitre.org/techniques/T1176/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_002_Linux_Bulk_IDE_Extension_Install {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects several distinct VS Code-family IDE extensions being written to a user's extensions directory on one Linux host within ten minutes. A single extension install is routine. Bulk or scripted installs outside normal developer workflow can indicate side-loading of malicious extensions for persistence, because the extension code runs every time the IDE starts."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176.002"
    mitre_technique_name = "Software Extensions: IDE Extensions"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules on user home extension directories, normalised to UDM FILE_CREATION with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers setting up a new workstation or dev container, settings-sync restoring extensions, remote-development servers bootstrapping extensions on first connect, and configuration-management or onboarding scripts that preinstall extension sets."
    tuning_guidance = "Add provisioning and deployment tooling to %global_allowed_admin_tools, and automation or build accounts to %global_allowed_service_accounts. Raise the #file threshold on developer-heavy or CI hosts. Lower it on servers where IDEs should not be installed. Consider wider scoping by host group for remote-dev servers."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\/\.(vscode|vscode-server|vscode-oss|vscode-insiders)\/extensions\/[^\/]+\/package\.json$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1176.002")
    $primary_entity = array_distinct($host)
    $extension_count = count($file.metadata.id)
    $extension_manifests = array_distinct($file.target.file.full_path)
    $installing_users = array_distinct($file.principal.user.userid)
    $installing_processes = array_distinct($file.principal.process.file.full_path)

  condition:
    #file >= 3
}
