/*
  MITRE Technique : T1216 - System Script Proxy Execution
  Tactic(s)       : Stealth
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:33:13.904099+00:00
  Reference       : https://attack.mitre.org/techniques/T1216
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1216_Script_Host_Proxy_System_Script_Remote_Argument {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows script host (cscript/wscript) running a script from a native Windows system directory (System32/SysWOW64) while the command line also carries a remote location argument (URL, UNC path or script: prefix). This is the signature of proxying execution of a remote payload through a trusted, Microsoft-signed script, as in the pubprn.vbs 'script:' abuse and similar signed-script techniques. The rule matches the combination of a system-directory script and a remote argument, so it still fires if the attacker changes the payload, host or script name."
    mitre_tactic = "Stealth"
    mitre_technique = "T1216"
    mitre_technique_name = "System Script Proxy Execution"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command line capture (EDR, Sysmon Event ID 1 or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Print-management or inventory scripts that legitimately pass a UNC print server path to built-in Windows scripts, RMM or deployment tooling that calls system scripts with network arguments, and admin troubleshooting of printer or BitLocker scripts against a file server."
    tuning_guidance = "Add approved RMM and deployment parent processes to %global_allowed_admin_tools, approved script-hosting parents to %global_allowed_script_hosts, and automation accounts to %global_allowed_service_accounts. If UNC usage is common in a client environment, remove the UNC branch of the remote-argument regex and keep the URL and script: branches."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(cscript|wscript)\.exe$/ nocase
    $proc.target.process.command_line = /\\(system32|syswow64)\\[^"]*\.(vbs|wsf|js|vbe|jse)\b/ nocase
    $proc.target.process.command_line = /(https?:\/\/|\\\\[a-z0-9_.\-]+\\|\bscript:)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1216")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
