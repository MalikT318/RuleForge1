/*
  MITRE Technique : T1612 - Build Image on Host
  Tactic(s)       : Stealth
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:34:31.098167+00:00
  Reference       : https://attack.mitre.org/techniques/T1612
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1612_Container_Image_Build_Volume_On_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of container image build activity on a single host within 10 minutes. This covers CLI builds through common container build front-ends and raw build requests sent to the container runtime socket. A single build is routine. Repeated builds on one runtime host can indicate an adversary building custom images locally to avoid registry-based image scanning before deploying a container."
    mitre_tactic = "Stealth"
    mitre_technique = "T1612"
    mitre_technique_name = "Build Image on Host"
    log_prerequisites = "Requires container runtime or node-level process telemetry that records command lines for PROCESS_LAUNCH events on container hosts, normalised to UDM with principal.hostname and target.process.command_line populated."
    platform = "Containers"
    log_source = "container"
    false_positives = "CI/CD build agents, developer workstations or shared build nodes, image-baking pipelines, and in-cluster build jobs. Automated base-image refresh jobs may also trigger the rule."
    tuning_guidance = "Add approved build tooling or its parent processes to %global_allowed_admin_tools. Add CI/CD and pipeline service accounts to %global_allowed_service_accounts. Raise the #proc threshold on shared build nodes. Lower it on production runtime nodes, where builds should be rare."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(\b(docker|podman|nerdctl)\s+(image\s+|buildx\s+)?build\b|\bbuildah\s+(bud|build)\b|docker\.sock\S*\s.*\/build\b)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1612")
    $primary_entity = array_distinct($host)
    $event_count = count($proc.metadata.id)
    $users = array_distinct($proc.principal.user.userid)
    $build_commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 5
}
