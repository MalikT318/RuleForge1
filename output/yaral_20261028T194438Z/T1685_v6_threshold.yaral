/*
  MITRE Technique : T1685 - Disable or Modify Tools
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:15:36.544456+00:00
  Reference       : https://attack.mitre.org/techniques/T1685
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_Linux_K8s_Security_Tooling_Mass_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single identity deletes several Kubernetes or container-runtime resources whose names indicate security, audit, or logging agents (runtime sensors, log shippers, audit collectors) within ten minutes. One deletion is routine (rollouts, restarts). A burst from one user suggests an attempt to blind runtime detection and log forwarding on Linux nodes before follow-on activity."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685"
    mitre_technique_name = "Disable or Modify Tools"
    log_prerequisites = "Kubernetes API audit logs or container runtime control-plane logs normalised to UDM USER_RESOURCE_DELETION with principal.user.userid and target.resource.name populated, covering Linux worker nodes."
    platform = "Linux"
    log_source = "container"
    false_positives = "Cluster upgrades, GitOps controllers or CI/CD pipelines redeploying monitoring stacks, namespace teardown in ephemeral test clusters, platform engineers rotating logging agents, autoscaler-driven node replacement."
    tuning_guidance = "Add GitOps, CI/CD and operator identities to %global_allowed_service_accounts and platform administrators to %global_allowed_admin_users. Raise the #res threshold for clusters with frequent redeployments. Extend the target.resource.name regex with client-specific agent naming conventions if needed."

  events:
    $res.metadata.event_type = "USER_RESOURCE_DELETION"
    $res.target.resource.name = /(falco|auditd?|fluent|filebeat|promtail|osquery|runtime[-_]?security|edr|sensor|siem|log(ging)?[-_]?(agent|collector|shipper|forwarder)|security[-_]?agent|monitoring[-_]?agent)/ nocase
    $res.principal.user.userid != ""
    $res.principal.user.userid = $user
    not $res.principal.user.userid in %global_allowed_service_accounts
    not $res.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1685")
    $primary_entity = array_distinct($user)
    $deleted_count = count($res.metadata.id)
    $deleted_resources = array_distinct($res.target.resource.name)
    $source_ips = array_distinct($res.principal.ip)

  condition:
    #res >= 5
}
