/*
  MITRE Technique : T1574.006 - Dynamic Linker Hijacking
  Tactic(s)       : Stealth, Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:32:01.448485+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_006_Linux_LD_SO_Preload_File_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of /etc/ld.so.preload, the system-wide file the Linux dynamic linker reads to force-load shared libraries into every dynamically linked process. The file does not exist on a default install, and legitimate changes are rare. Writes to it are a strong indicator of userland rootkit installation or persistent dynamic linker hijacking. This rule works from the resulting file state change rather than command-line content, so it still fires when the write comes from a script, an interpreter, a renamed binary or an obfuscated command."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.006"
    mitre_technique_name = "Hijack Execution Flow: Dynamic Linker Hijacking"
    log_prerequisites = "Linux EDR file telemetry or auditd file-watch rules (e.g. a write/attribute watch on /etc/ld.so.preload) normalised to UDM FILE_MODIFICATION with target.file.full_path and principal.process populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Approved security or performance tooling that injects a library system-wide (APM or profiling agents, memory-allocator preloads such as jemalloc), configuration management (Ansible, Puppet, Chef) deploying an approved preload, and administrators debugging library interposition on test hosts."
    tuning_guidance = "Add approved agents and config-management binaries to %global_allowed_admin_tools and EDR or security agents to %global_allowed_security_tools. Pair this rule with a FILE_CREATION variant, because the file normally does not exist and the first write is often reported as a creation. Review the modifying process and the library path in the file content when triaging."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/ld\.so\.preload$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1574.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $modifying_process = array_distinct($file.principal.process.file.full_path)
    $modifying_user = array_distinct($file.principal.user.userid)
    $modified_file = array_distinct($file.target.file.full_path)

  condition:
    $file
}
