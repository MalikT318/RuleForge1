/*
  MITRE Technique : T1546.001 - Change Default File Association
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:01:26.247182+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_001_File_Association_Handler_Registry_Hijack {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry write to a file-association handler command (shell\\<verb>\\command) whose value launches a script interpreter, a living-off-the-land binary or a user-writable path. This is registry-telemetry coverage for file-association hijacking and does not depend on process command lines. T1546.001 is Windows-only in ATT&CK, so the alternate-platform angle cannot be met; this rule therefore pivots on registry telemetry for Windows."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.001"
    mitre_technique_name = "Event Triggered Execution: Change Default File Association"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon registry events) that populates target.registry.registry_key and registry_value_data for HKCR, HKLM\\Software\\Classes and HKCU\\Software\\Classes."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters that register or repair file handlers (PDF readers, archivers, text editors, scripting runtimes), RMM and deployment tools, and developers registering script handlers."
    tuning_guidance = "Add legitimate installer or deployment binaries to %global_allowed_admin_tools and EDR or security agents to %global_allowed_security_tools. If a client's approved software registers handlers from user-writable paths, tune the value-data regex for that client or exclude the writing process."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(\\classes\\[^\\]+|^hkey_classes_root\\[^\\]+|^hkcr\\[^\\]+|_classes\\[^\\]+)\\shell\\[^\\]+\\command$/ nocase
    $reg.target.registry.registry_value_data = /(powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|cmd(\.exe)?"?\s+\/[ck]|\\appdata\\|\\temp\\|\\users\\public\\|\\programdata\\|\\downloads\\)/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $handler_commands = array_distinct($reg.target.registry.registry_value_data)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
