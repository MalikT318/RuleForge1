/*
  MITRE Technique : T1021 - Remote Services
  Tactic(s)       : Lateral Movement
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:34:04.042588+00:00
  Reference       : https://attack.mitre.org/techniques/T1021
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_Linux_Excessive_Remote_Logins_Per_User {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single account has an unusually high number of remote SSH logins within ten minutes. Each login is benign on its own. A burst of them under one identity suggests valid-account abuse for lateral movement, such as credential reuse across hosts or scripted hopping."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021"
    mitre_technique_name = "Remote Services"
    log_prerequisites = "Requires Linux auditd (USER_LOGIN records) or EDR/syslog authentication telemetry from sshd normalised to UDM USER_LOGIN, with target.user.userid populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management and orchestration tools (Ansible-style automation), CI/CD runners, backup and monitoring agents that SSH to many hosts, jump hosts and bastions, administrators running fleet-wide maintenance, and SFTP/rsync batch jobs."
    tuning_guidance = "Add automation and deployment accounts to %global_allowed_service_accounts, named admins to %global_allowed_admin_users, and bastion or management source addresses to %global_allowed_mgmt_sources. Raise or lower the #auth threshold per customer based on baseline login volume. Consider a lower threshold for high-value servers."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    (
      $auth.network.application_protocol = "SSH" or
      $auth.target.port = 22 or
      $auth.principal.process.file.full_path = /\/sshd$/ nocase
    )
    $auth.target.user.userid != ""
    $auth.target.user.userid = $user
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.principal.ip in %global_allowed_mgmt_sources

  match:
    $user over 10m

  outcome:
    $risk_score = max(60)
    $login_count = count($auth.metadata.id)
    $mitre_technique_id = array_distinct("T1021")
    $primary_entity = array_distinct($user)
    $source_ips = array_distinct($auth.principal.ip)
    $source_hosts = array_distinct($auth.principal.hostname)
    $target_hosts = array_distinct($auth.target.hostname)

  condition:
    #auth >= 10
}
