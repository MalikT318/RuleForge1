/*
  MITRE Technique : T1556.001 - Domain Controller Authentication
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:15:45.446530+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_001_LSASS_Repeated_Handle_Access_DC_Auth_Patching {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Repeated process-handle opens against lsass.exe on a single host within ten minutes by non-allowlisted processes. A single handle open is routine on Windows, but sustained volume from unexpected processes is consistent with in-memory patching of the domain controller authentication process (Skeleton Key style) or the staging and retry behaviour of tooling that injects false credentials into LSASS."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.001"
    mitre_technique_name = "Modify Authentication Process: Domain Controller Authentication"
    log_prerequisites = "Requires endpoint telemetry that records process handle access (PROCESS_OPEN), such as EDR or Sysmon Event ID 10, with the target process path populated. Deploy on domain controllers first."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "EDR/AV agents not yet in the allowlist, backup and imaging agents, credential-provider or SSO/MFA agents, monitoring and inventory agents, and system processes that legitimately query LSASS."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools, backup agents to %global_allowed_backup_processes, and IT tooling to %global_allowed_admin_tools. Raise the #open threshold on noisy hosts. Prioritise alerts on domain controllers."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\lsass\.exe$/ nocase
    $open.principal.hostname = $host
    not $open.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|csrss|wininit|winlogon|services|lsass|smss)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_admin_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1556.001")
    $primary_entity = array_distinct($host)
    $open_count = count($open.metadata.id)
    $source_processes = array_distinct($open.principal.process.file.full_path)
    $source_users = array_distinct($open.principal.user.userid)

  condition:
    #open >= 10
}
