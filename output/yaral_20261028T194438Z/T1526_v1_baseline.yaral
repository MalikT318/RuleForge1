/*
  MITRE Technique : T1526 - Cloud Service Discovery
  Tactic(s)       : Discovery
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:25:53.283501+00:00
  Reference       : https://attack.mitre.org/techniques/T1526
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1526_SaaS_Cloud_Service_Enumeration_Via_Directory_API {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an identity or directory API request that enumerates tenant-level cloud services, such as applications, service principals, subscriptions, directory roles, or tenant configuration. Legitimate users rarely list these collections. Adversaries who have obtained a foothold use these calls to map the services available to a compromised identity."
    mitre_tactic = "Discovery"
    mitre_technique = "T1526"
    mitre_technique_name = "Cloud Service Discovery"
    log_prerequisites = "Requires identity provider and directory audit or API activity logs normalised to UDM USER_RESOURCE_ACCESS. Either target.url or metadata.product_event_type must be populated with the API operation. network.http.user_agent is used for enrichment only, when present."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Cloud administrators and IAM engineers reviewing applications or subscriptions; CSPM, inventory, and governance tooling using named service identities; application owners checking their own registrations; onboarding of new integrations; audit and compliance reviews."
    tuning_guidance = "Add automation and inventory identities to %global_allowed_service_accounts and %global_allowed_cloud_principals. Add named cloud administrators to %global_allowed_admin_users. For tenants with heavy inventory automation, consider promoting this to a Threshold rule per user. Review the $user_agent outcome to separate scripted clients from interactive portal use."

  events:
    $api.metadata.event_type = "USER_RESOURCE_ACCESS"
    (
      $api.target.url = /\/(servicePrincipals|applications|oauth2PermissionGrants|appRoleAssignments|directoryRoles|subscribedSkus|subscriptions|managementGroups|policyDefinitions|resourceGroups|organization|domains|tenants)(\/?$|\/?\?|\/delta|\/microsoft\.)/ nocase
      or $api.metadata.product_event_type = /(list|enumerate|get).{0,30}(service.?principal|applications?|subscriptions?|management.?group|directory.?role|oauth.?grant|tenant|policy.?definition)/ nocase
    )
    $api.principal.user.userid != ""
    not $api.principal.user.userid in %global_allowed_service_accounts
    not $api.principal.user.userid in %global_allowed_cloud_principals
    not $api.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1526")
    $primary_entity = array_distinct($api.principal.user.userid)
    $source_ips = array_distinct($api.principal.ip)
    $target_urls = array_distinct($api.target.url)
    $api_operations = array_distinct($api.metadata.product_event_type)
    $user_agent = array_distinct($api.network.http.user_agent)

  condition:
    $api
}
