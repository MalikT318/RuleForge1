/*
  MITRE Technique : T1499.003 - Application Exhaustion Flood
  Tactic(s)       : Impact
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:20:41.860728+00:00
  Reference       : https://attack.mitre.org/techniques/T1499/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1499_003_Linux_AppErrorLog_Burst_Then_CoreDump {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a burst of writes to a web or application server error log followed by creation of a core dump or crash file for a server process on the same Linux host within 10 minutes. This pattern indicates application resource exhaustion (connection or worker exhaustion, out-of-memory) that crashed the service, consistent with an application exhaustion flood. The detection is file-based and does not rely on process command lines."
    mitre_tactic = "Impact"
    mitre_technique = "T1499.003"
    mitre_technique_name = "Endpoint Denial of Service: Application Exhaustion Flood"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file watch rules (-w on /var/log/<app>/ and on core dump directories) normalised to FILE_MODIFICATION and FILE_CREATION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate application bugs that crash under normal load, load testing in pre-production, deployments or upgrades that restart services, administrators deliberately triggering a core dump with gcore or kill -ABRT, and noisy debug-level logging during troubleshooting."
    tuning_guidance = "Add approved load-test and deployment tooling paths to %global_allowed_admin_tools and vulnerability or load scanners to %global_allowed_scanners. Raise the #log threshold on hosts with chatty error logs. Extend the application name list in the regex if the client runs other server stacks."

  events:
    $log.metadata.event_type = "FILE_MODIFICATION"
    $log.target.file.full_path = /^\/var\/log\/(nginx|apache2|httpd|tomcat[0-9]*|haproxy|php[0-9.]*-fpm|gunicorn|uwsgi)\/[^\/]*error[^\/]*\.log$/ nocase
    not $log.principal.process.file.full_path = /\/(logrotate|rsyslogd|journald|systemd-journald)$/ nocase
    not $log.principal.process.file.full_path in %global_allowed_admin_tools
    $log.principal.hostname = $hostname

    $core.metadata.event_type = "FILE_CREATION"
    $core.target.file.full_path = /^\/(var\/lib\/systemd\/coredump|var\/crash|var\/lib\/apport\/coredump|var\/core|tmp)\/([^\/]*\/)*core[._-]?[^\/]*(nginx|apache2|httpd|java|node|php|gunicorn|uwsgi|haproxy|tomcat)[^\/]*$/ nocase
    not $core.principal.process.file.full_path in %global_allowed_admin_tools
    $core.principal.hostname = $hostname

    $log.metadata.event_timestamp.seconds <= $core.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1499.003")
    $primary_entity = array_distinct($hostname)
    $error_log_writes = count($log.metadata.id)
    $error_logs = array_distinct($log.target.file.full_path)
    $crash_files = array_distinct($core.target.file.full_path)
    $first_log_write = min($log.metadata.event_timestamp.seconds)
    $last_crash_file = max($core.metadata.event_timestamp.seconds)

  condition:
    #log >= 5 and #core >= 1
}
