/*
  MITRE Technique : T1496 - Resource Hijacking
  Tactic(s)       : Impact
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:50:29.424424+00:00
  Reference       : https://attack.mitre.org/techniques/T1496
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_Container_Outbound_Stratum_Mining_Pool_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a container or Kubernetes workload opening an outbound connection to an external address on a TCP port conventionally used by the Stratum cryptocurrency mining protocol. Internal address space is excluded through a reference list. This is a network-side indicator of resource hijacking (cryptojacking) that works regardless of the miner binary name, hash or pool infrastructure."
    mitre_tactic = "Impact"
    mitre_technique = "T1496"
    mitre_technique_name = "Resource Hijacking"
    log_prerequisites = "Requires container or Kubernetes cluster network flow or connection telemetry (for example cloud VPC/virtual network flow logs enriched with pod or node identity) delivered through the cloud audit/control-plane pipeline and normalised to UDM NETWORK_CONNECTION with principal.hostname and target.ip/target.port populated."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Legitimate services listening on commonly reused ports (3333, 4444, 5555, 7777), such as developer tooling, Android debug bridge, internal-facing SaaS integrations resolved to public IPs, and sanctioned vulnerability or penetration-test sources. Authorised crypto or blockchain node workloads that deliberately connect to mining pools."
    tuning_guidance = "Add authorised scanning or testing workloads to %global_allowed_scanners, and known-good external destinations or vendor endpoints to %global_allowed_domains (matched on target.hostname). If a client legitimately uses the broader ports (4444, 5555), remove them from the port list for that tenant and rely on the remaining Stratum-specific ports. Confirm internal address ranges are present in %rfc1918_internal."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 3333 or
      $net.target.port = 4444 or
      $net.target.port = 5555 or
      $net.target.port = 7777 or
      $net.target.port = 14433 or
      $net.target.port = 14444 or
      $net.target.port = 45560 or
      $net.target.port = 45700
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1496")
    $primary_entity = array_distinct($net.principal.hostname)
    $workload = array_distinct($net.principal.resource.name)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
