/*
  MITRE Technique : T1547.009 - Shortcut Modification
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:35:45.353013+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_009_Anomalous_Parent_Spawns_Shell_Startup_Shortcut {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process that should not normally launch interpreters (Office application, web server, print spooler, database service) spawning a shell or script host whose command line references the Startup folder or shortcut creation. This is a lineage-based indicator of shortcut persistence being planted by a compromised or exploited parent."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.009"
    mitre_technique_name = "Boot or Logon Autostart Execution: Shortcut Modification"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and child command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros or add-ins from legitimate business workflows that create shortcuts; web or database applications with admin functions that create shortcuts for users; software installers launched from Office or web-based deployment portals; print or document-management tools that write shortcuts to the Startup folder."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts and approved deployment or RMM binaries to %global_allowed_admin_tools. Review the parent_process and child_command_line outcome values to identify recurring benign workflows before excluding them. Do not exclude by install directory; use executable names or the reference lists."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|onenote|visio|mspub|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|spoolsv|sqlservr|mysqld|postgres)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(\\startup\\|\\startup\b|shell:(common )?startup|createshortcut)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.009")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $affected_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
