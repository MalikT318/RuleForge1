/*
  MITRE Technique : T1087 - Account Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:50:39.145664+00:00
  Reference       : https://attack.mitre.org/techniques/T1087
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_ESXi_Login_Then_Account_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A remote shell or SSH login to an ESXi host is followed within 10 minutes by local account or permission enumeration (esxcli account/permission listing, vimsvc permission queries, or reads of the local passwd/shadow files) by the same user on the same host. The detection is the login-then-discovery sequence, not the command alone, so routine one-off commands do not trigger it."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087"
    mitre_technique_name = "Account Discovery"
    log_prerequisites = "ESXi hostd, shell and auth logs forwarded via syslog and parsed to UDM. USER_LOGIN events must populate the target user, the source IP and the target application (sshd or shell). Shell command logging must be enabled so PROCESS_LAUNCH events carry the command line. Both event types must use the same hostname field."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators auditing local accounts after SSH login, permission audits before or after joining a directory domain, host-hardening or compliance scripts (CIS checks), configuration-management or automation tooling run over SSH, and support engineers troubleshooting access."
    tuning_guidance = "Add approved admin accounts to %global_allowed_admin_users, automation accounts to %global_allowed_service_accounts, approved jump hosts and management stations to %global_allowed_mgmt_sources, and audit or compliance tooling to %global_allowed_admin_tools. If the parser populates target.hostname instead of principal.hostname for login events, adjust the join field accordingly. If target.application is not populated for logins in your environment, relax or remove that filter."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.target.application = /ssh|shell/ nocase
    $auth.principal.hostname = $hostname
    $auth.target.user.userid = $user
    not $auth.principal.ip in %global_allowed_mgmt_sources
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(esxcli\s+system\s+(account|permission)\s+list|vim-cmd\s+vimsvc\/auth\/(entity_permissions|permissions)|\b(cat|less|more|grep|head|tail|vi|awk|sed)\b[^|;&]*\/etc\/(passwd|shadow))/ nocase
    $proc.principal.hostname = $hostname
    $proc.principal.user.userid = $user
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

    $auth.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $user over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1087")
    $primary_entity = array_distinct($proc.principal.hostname)
    $login_source_ips = array_distinct($auth.principal.ip)
    $enumeration_commands = array_distinct($proc.target.process.command_line)
    $enumeration_count = count($proc.metadata.id)

  condition:
    $auth and $proc
}
