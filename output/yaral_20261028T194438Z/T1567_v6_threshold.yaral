/*
  MITRE Technique : T1567 - Exfiltration Over Web Service
  Tactic(s)       : Exfiltration
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:54:45.530491+00:00
  Reference       : https://attack.mitre.org/techniques/T1567
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_Windows_Volumetric_Web_Upload_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single internal source sends several large HTTP POST/PUT uploads (1 MB or more each) to external destinations outside the known-good domain list within ten minutes. Any single upload is routine, but repeated large uploads from one host suggest staged data leaving through a legitimate web service (cloud storage, paste sites, collaboration APIs). Uses perimeter telemetry only, so it complements endpoint command-line rules. Intended for Windows client hosts behind the monitored perimeter."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567"
    mitre_technique_name = "Exfiltration Over Web Service"
    log_prerequisites = "Proxy or firewall logs with HTTP inspection (SSL decryption or explicit proxy) that populate network.http.method, network.sent_bytes, principal.ip and target.hostname. Without TLS inspection, method and hostname may be absent and the rule will not fire."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Approved cloud backup and sync clients, software or telemetry uploads, crash-dump submission, large email or file-share attachments through web gateways, developer artifact pushes, video-conferencing or collaboration uploads, NAT gateways or proxies that aggregate many users behind one source IP."
    tuning_guidance = "Add sanctioned SaaS and vendor domains to %global_allowed_domains. Raise the sent_bytes floor or the #net count for noisy sources. Group by user instead of source IP where the proxy supplies authenticated identity. Review the risk_score step (50 MB per event) against client baselines."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = /^(POST|PUT)$/ nocase
    $net.network.sent_bytes >= 1048576
    $net.principal.ip = $src_ip
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(if($net.network.sent_bytes >= 52428800, 85, 65))
    $mitre_technique_id = array_distinct("T1567")
    $primary_entity = array_distinct($src_ip)
    $event_count = count($net.metadata.id)
    $total_sent_bytes = sum($net.network.sent_bytes)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    #net >= 5
}
