/*
  MITRE Technique : T1195.001 - Compromise Software Dependencies and Development Tools
  Tactic(s)       : Initial Access
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:41:34.419637+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_001_Linux_Package_Manager_Child_Download_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of network-fetch, decode or permission-change utilities spawned directly by a package manager or language runtime (npm, node, yarn, pnpm, pip, python, gem, ruby) on a single Linux host within 10 minutes. Each launch is benign on its own. Repeated launches carrying URLs, staging paths or decode and chmod arguments indicate a malicious install-time script (a trojanised dependency) fetching and staging a second-stage payload."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.001"
    mitre_technique_name = "Supply Chain Compromise: Compromise Software Dependencies and Development Tools"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records normalised to UDM PROCESS_LAUNCH, with parent process path and command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "CI/CD build agents, developer workstations, native-module builds (node-gyp, pip wheels) that download prebuilt binaries, Docker image builds, and configuration-management runs installing packages."
    tuning_guidance = "Add approved build and deployment parents to %global_allowed_admin_tools. Add CI runner and build hosts to %global_allowed_script_hosts. Raise the #proc threshold on developer-heavy hosts. Treat hits on production servers, where installs are rare, as higher priority."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(npm|node|nodejs|yarn|pnpm|pip|pip3|python[0-9.]*|gem|ruby)$/ nocase
    $proc.target.process.file.full_path = /\/(curl|wget|nc|ncat|socat|base64|openssl|chmod)$/ nocase
    $proc.target.process.command_line = /(https?:\/\/|\/tmp\/|\/dev\/shm\/|\/var\/tmp\/|base64\s+(-d|--decode)|chmod\s+(\+x|[0-7]*7[0-7]*))/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.hostname in %global_allowed_script_hosts

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1195.001")
    $primary_entity = array_distinct($host)
    $event_count = count($proc.metadata.id)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $child_commands = array_distinct($proc.target.process.command_line)
    $users = array_distinct($proc.principal.user.userid)

  condition:
    #proc >= 3
}
