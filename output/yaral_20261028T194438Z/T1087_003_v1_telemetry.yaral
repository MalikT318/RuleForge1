/*
  MITRE Technique : T1087.003 - Email Account
  Tactic(s)       : Discovery
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:55:52.157490+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_003_Address_List_Config_Change_Exchange_Online {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation or modification of address list, global address list, offline address book or address book policy objects in the mail tenant. Adversaries with a privileged session can build or alter address lists (for example, a list with a broad recipient filter) so that email accounts across the organisation can be enumerated or exported. Detection is at the configuration-change layer of the unified audit log, not at command-line level, so it still fires if the cmdlets are run through remote sessions, API calls or renamed tooling."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.003"
    mitre_technique_name = "Account Discovery: Email Account"
    log_prerequisites = "Mail admin audit logging must be enabled and ingested through the unified audit log. The operation name must be populated in metadata.product_event_type. Read-only enumeration cmdlets are not audited by default, so this rule covers only the configuration changes that support enumeration."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate mail administrators building departmental address lists, running address book policy projects for multi-tenant or education scenarios, tenant migrations and mergers, scheduled GAL or offline address book updates run by automation, and onboarding or offboarding tooling."
    tuning_guidance = "Add named administrators to %global_allowed_admin_users and automation or migration identities to %global_allowed_service_accounts. During planned migrations, temporarily widen the exclusions per client instead of disabling the rule. If the client's parser maps these audit records to SETTING_CREATION rather than SETTING_MODIFICATION, deploy a cloned copy of this rule on that event type. Do not combine the two event types in one rule."

  events:
    $set.metadata.event_type = "SETTING_MODIFICATION"
    $set.metadata.product_event_type = /^(New|Set|Update)-(GlobalAddressList|AddressList|OfflineAddressBook|AddressBookPolicy)$/ nocase
    $set.principal.user.userid != ""
    not $set.principal.user.userid in %global_allowed_admin_users
    not $set.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1087.003")
    $primary_entity = array_distinct($set.principal.user.userid)
    $operations = array_distinct($set.metadata.product_event_type)
    $source_ips = array_distinct($set.principal.ip)
    $event_count = count($set.metadata.id)

  condition:
    $set
}
