/*
  MITRE Technique : T1114 - Email Collection
  Tactic(s)       : Collection
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:16:24.161944+00:00
  Reference       : https://attack.mitre.org/techniques/T1114
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_Linux_Script_Interpreter_External_Mailbox_Protocol {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux shell, scripting interpreter or generic transfer utility opening an outbound connection to an external host on a mailbox-retrieval port (POP3/IMAP, plain or TLS). Legitimate mail clients and sync daemons are not interpreters. When a script talks IMAP/POP3 directly to an external server, it often indicates bulk mailbox collection or exfiltration of email into attacker-controlled infrastructure."
    mitre_tactic = "Collection"
    mitre_technique = "T1114"
    mitre_technique_name = "Email Collection"
    log_prerequisites = "Requires Linux EDR or auditd network connection telemetry that populates the principal process path, target IP and target port for outbound connections."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrator or user scripts that poll external mailboxes (monitoring checks, mail migration jobs, backup of hosted mail), cron-driven mail-to-ticket integrations, and connectivity tests run by admins with nc/openssl against hosted mail providers."
    tuning_guidance = "Add approved migration, monitoring and mail-integration tooling to %global_allowed_admin_tools. Add automation accounts that legitimately poll mailboxes to %global_allowed_service_accounts. Add approved scan sources to %global_allowed_scanners. If mail relay hosts are known, treat them as internal via %rfc1918_internal. For noisy hosts, restrict the process list in the regex."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 110 or
      $net.target.port = 143 or
      $net.target.port = 993 or
      $net.target.port = 995
    )
    $net.principal.process.file.full_path = /\/(python[0-9.]*|perl|ruby|php[0-9.]*|node|bash|sh|dash|zsh|curl|wget|openssl|nc|ncat|netcat|socat|busybox|telnet)$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1114")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_user = array_distinct($net.principal.user.userid)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $process_command_line = array_distinct($net.principal.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
