/*
  MITRE Technique : T1027.005 - Indicator Removal from Tools
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:45:28.826933+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_005_Linux_Service_Parent_Spawns_Binary_Modifier {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing service process (web server, application server, database, or cache) spawning a binary-modification utility such as a symbol stripper, ELF editor, or executable packer. Legitimate services do not rework executables, so this lineage suggests an adversary altering a tool to remove detectable indicators and evade signature-based detection."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.005"
    mitre_technique_name = "Obfuscated Files or Information: Indicator Removal from Tools"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry populating parent and child process paths for PROCESS_LAUNCH events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Application deployment or plugin build hooks run from a web or application server (for example Jenkins or Tomcat-hosted CI), Java or Node build steps invoked by a service, database extension compilation (for example PostgreSQL contrib builds), and developer or staging hosts where services legitimately compile software."
    tuning_guidance = "Add approved build or deployment parent binaries and build hosts to %global_allowed_script_hosts, and sanctioned tooling to %global_allowed_admin_tools. Extend the parent process regex with client-specific service daemons if needed. If the child list is too noisy on build servers, exclude those hosts via %global_allowed_script_hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(httpd|apache2|nginx|php-fpm[0-9.]*|php-cgi|lighttpd|caddy|tomcat[0-9]*|catalina|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|memcached|smbd|cupsd)$/ nocase
    $proc.target.process.file.full_path = /\/(strip|sstrip|objcopy|patchelf|upx|eu-strip|llvm-strip|llvm-objcopy)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.hostname in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
