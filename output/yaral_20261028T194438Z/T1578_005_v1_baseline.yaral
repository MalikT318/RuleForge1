/*
  MITRE Technique : T1578.005 - Modify Cloud Compute Configurations
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:55:58.200620+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_005_Cloud_Compute_Quota_Or_Region_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects control-plane API calls that raise or modify compute service quotas or limits, or that enable additional deployment regions. Adversaries make these changes after compromising a cloud account so they can run more compute (for example resource hijacking) without exhausting the victim's existing quota. They can also use them to deploy into regions the victim does not monitor."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578.005"
    mitre_technique_name = "Modify Cloud Compute Configurations"
    log_prerequisites = "Cloud control-plane audit logs (management/admin activity) ingested and normalised to UDM with metadata.product_event_type populated. Quota, limit, and region-opt-in API calls must be logged."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate capacity planning by cloud or platform teams, infrastructure-as-code pipelines raising quotas for new projects, planned expansion into new regions, and cloud-governance automation that manages limits."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users. Add pipeline and automation identities to %global_allowed_service_accounts and %global_allowed_cloud_principals. Review the product_event_type values in your tenant and extend or narrow the regex if your provider uses different quota or region API names. For high-volume environments, raise severity only when the actor is not a known change-management identity."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    (
      (
        $cloud.metadata.product_event_type = /(quota|servicelimit|limit)/ nocase and
        $cloud.metadata.product_event_type = /(request|increase|update|put|set|modify|change|associate|create)/ nocase
      ) or
      $cloud.metadata.product_event_type = /(enable|opt.?in).*region|region.*(enable|opt.?in)/ nocase
    )
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1578.005")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_actions = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)
    $target_resources = array_distinct($cloud.target.resource.name)

  condition:
    $cloud
}
