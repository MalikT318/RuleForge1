/*
  MITRE Technique : T1056.002 - GUI Input Capture
  Tactic(s)       : Collection, Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:48:08.868329+00:00
  Reference       : https://attack.mitre.org/techniques/T1056/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1056_002_Script_Host_Loads_Credential_UI_Module {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a scripting host (PowerShell, WSH, MSHTA) loading the Windows credential prompt library (credui.dll). This is the module-level result of a script spawning a native-looking credential dialog, for example Get-Credential or a CredUI API call used to spoof a legitimate prompt. It is based on PROCESS_MODULE_LOAD, not on process-creation command lines, so it adds coverage beyond command-line rules. The requested alternate-platform angle conflicts with the mandatory Windows target and the windows_endpoint log source, so the angle is delivered as a different Windows telemetry type (module load) and the platform stays Windows."
    mitre_tactic = "Collection, Credential Access"
    mitre_technique = "T1056.002"
    mitre_technique_name = "Input Capture: GUI Input Capture"
    log_prerequisites = "Requires Windows endpoint telemetry that records image/module loads (Sysmon Event ID 7 or an EDR equivalent) normalised to PROCESS_MODULE_LOAD, with the loaded module path in target.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin or helpdesk PowerShell scripts that legitimately call Get-Credential, login or provisioning scripts that prompt for credentials, PowerShell ISE sessions where an administrator is testing, and RMM or deployment scripts that request alternate credentials."
    tuning_guidance = "Add approved admin or RMM binaries to %global_allowed_admin_tools, hosts or parent script hosts that legitimately run interactive scripts to %global_allowed_script_hosts, and named administrators to %global_allowed_admin_users. Raise severity where the loading process was launched from a user-writable path or by an Office or browser parent. Ensure module-load telemetry is enabled for scripting hosts only if volume is a concern."

  events:
    $mod.metadata.event_type = "PROCESS_MODULE_LOAD"
    $mod.target.file.full_path = /\\(credui|wincredui)\.dll$/ nocase
    $mod.principal.process.file.full_path = /\\(powershell|pwsh|powershell_ise|wscript|cscript|mshta)\.exe$/ nocase
    not $mod.principal.process.file.full_path in %global_allowed_admin_tools
    not $mod.principal.hostname in %global_allowed_script_hosts
    not $mod.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1056.002")
    $primary_entity = array_distinct($mod.principal.hostname)
    $loading_process = array_distinct($mod.principal.process.file.full_path)
    $user = array_distinct($mod.principal.user.userid)

  condition:
    $mod
}
