/*
  MITRE Technique : T1027.014 - Polymorphic Code
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:00:47.151999+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_014_Linux_Server_Daemon_Spawns_Staged_Binary {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server, or database service process spawning a child whose executable runs from a world-writable staging location (/tmp, /var/tmp, /dev/shm) or from an in-memory file descriptor (/proc/<pid>/fd, memfd). Polymorphic or mutating payloads are typically written or generated at runtime in these locations and executed by a compromised service. Detection is based on process lineage and the child's execution location, not on command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.014"
    mitre_technique_name = "Obfuscated Files or Information: Polymorphic Code"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry normalised to PROCESS_LAUNCH with populated parent (principal.process.file.full_path) and child (target.process.file.full_path) executable paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web applications that legitimately execute helper binaries from /tmp (image or document converters, PHP or Node build and upload handlers), database maintenance or extension scripts that unpack binaries to /tmp, self-updating application servers, and CI or deployment agents running under a service daemon."
    tuning_guidance = "Add approved parent daemons or hosts to %global_allowed_script_hosts and approved helper or deployment binaries to %global_allowed_admin_tools. Extend the parent regex with client-specific service binaries if needed. Consider a lower severity for hosts known to run converters from /tmp."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9.]*|uwsgi|gunicorn|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|tomcat[0-9]*|catalina)$/ nocase
    $proc.target.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/shm)\/|^\/proc\/(self|[0-9]+)\/fd\/|^\/memfd:/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1027.014")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
