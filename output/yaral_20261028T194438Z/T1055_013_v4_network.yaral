/*
  MITRE Technique : T1055.013 - Process Doppelgänging
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:01:48.919572+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_013_Doppelganging_NonNetwork_Native_Binary_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound connection to a non-internal address from a native Windows utility that has no legitimate reason to initiate network traffic (for example notepad, calc, mspaint, wordpad). Process Doppelgänging (TxF transacted section) runs attacker code under the identity of a benign-looking image, so network activity from such a process is a strong behavioural sign that the image has been replaced in memory. This is a network-side detection and does not rely on process-creation or command-line content."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.013"
    mitre_technique_name = "Process Injection: Process Doppelgänging"
    log_prerequisites = "Requires EDR or Sysmon-equivalent network connection telemetry (NETWORK_CONNECTION) with the initiating process image path populated in principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Recent Windows 10/11 builds of notepad or wordpad that contact cloud or update services, Office or store-integrated components launched through these binaries, legitimate software that hosts or launches these utilities with embedded web content, and RMM or support tooling that proxies traffic through them."
    tuning_guidance = "Add approved tooling executable paths to %global_allowed_admin_tools and approved EDR or security agent paths to %global_allowed_security_tools. If a client's Windows build shows noisy cloud-integrated utilities, remove that binary from the regex or exclude known-good destination domains. Internal traffic is excluded via %rfc1918_internal."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(notepad|calc|mspaint|wordpad|winver|charmap|snippingtool|write)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1055.013")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $affected_users = array_distinct($net.principal.user.userid)

  condition:
    $net
}
