/*
  MITRE Technique : T1480.002 - Mutual Exclusion
  Tactic(s)       : Stealth
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:27:20.963799+00:00
  Reference       : https://attack.mitre.org/techniques/T1480/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1480_002_Linux_ServiceParent_Spawns_Lockfile_Mutex {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network-facing service or database process (web server, PHP-FPM, database daemon) spawning a shell, interpreter or flock that takes a non-blocking or exclusive lock on a lock file in a world-writable or runtime directory. Malware on Linux uses lock files as a mutex so only one instance runs. A service parent spawning this is anomalous lineage and suggests a web shell or a compromised service process guarding its payload against re-execution."
    mitre_tactic = "Stealth"
    mitre_technique = "T1480.002"
    mitre_technique_name = "Execution Guardrails: Mutual Exclusion"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records (with full command line) normalised to UDM PROCESS_LAUNCH, with principal.process.file.full_path populated for the parent."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web applications or CMS cron-style jobs that legitimately wrap tasks in flock (for example PHP-FPM workers or database maintenance scripts using flock -n /var/run/*.lock), and backup or housekeeping scripts launched by a database daemon."
    tuning_guidance = "Add legitimate service parents or wrapper scripts to %global_allowed_script_hosts, and approved tooling that uses flock to %global_allowed_admin_tools. If a specific application uses flock heavily, exclude by parent binary name rather than by lock file path. Extend the parent regex with additional service daemons used in the client estate."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php-fpm[0-9.]*|php-cgi|mysqld|mariadbd|postgres|mongod|redis-server)$/ nocase
    $proc.target.process.file.full_path = /\/(flock|sh|bash|dash|zsh|ash|python[0-9.]*|perl|ruby)$/ nocase
    $proc.target.process.command_line = /\bflock\b/ nocase
    $proc.target.process.command_line = /(\s-[a-zA-Z]*[nx][a-zA-Z]*\b|--nonblock|--exclusive|--conflict-exit-code)/ nocase
    $proc.target.process.command_line = /(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/var\/run\/|\/run\/)[^\s'"]*/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1480.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
