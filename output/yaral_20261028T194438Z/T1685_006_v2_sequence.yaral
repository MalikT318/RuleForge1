/*
  MITRE Technique : T1685.006 - Clear Linux or Mac System Logs
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:25:09.871745+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_006_Linux_System_Log_Tamper_Modify_Then_Delete {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a core Linux system or authentication log under /var/log being modified (for example truncated or overwritten) and a core log file then being deleted on the same host within ten minutes, by processes other than the native logging and rotation daemons. This file-activity sequence is characteristic of an adversary clearing logs to hide intrusion evidence. It does not depend on command-line matching."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.006"
    mitre_technique_name = "Clear Linux or Mac System Logs"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules on /var/log, normalised to FILE_MODIFICATION and FILE_DELETION with principal process and hostname populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Custom log-rotation or log-cleanup scripts, disk-space housekeeping jobs run by admins, configuration-management agents, container or package-install scripts that reset logs, and imaging or golden-image preparation."
    tuning_guidance = "Add approved housekeeping and rotation tooling to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and approved maintenance scripts to %global_allowed_script_hosts. Extend the native-daemon regex if a distribution uses a different logging daemon."

  events:
    $mod.metadata.event_type = "FILE_MODIFICATION"
    $mod.target.file.full_path = /^\/var\/log\/(auth\.log|secure|messages|syslog|kern\.log|cron(\.log)?|maillog|mail\.log|wtmp|btmp|lastlog|audit\/audit\.log)$/ nocase
    not $mod.principal.process.file.full_path = /\/(logrotate|rsyslogd|syslog-ng|systemd-journald|auditd|journalctl|sshd|login|systemd)$/ nocase
    not $mod.principal.process.file.full_path in %global_allowed_admin_tools
    not $mod.principal.user.userid in %global_allowed_service_accounts
    $mod.principal.hostname = $hostname

    $del.metadata.event_type = "FILE_DELETION"
    $del.target.file.full_path = /^\/var\/log\/(auth\.log|secure|messages|syslog|kern\.log|cron(\.log)?|maillog|mail\.log|wtmp|btmp|lastlog|audit\/audit\.log|httpd\/.+|apache2\/.+|nginx\/.+)(\.[0-9]+|\.gz)?$/ nocase
    not $del.principal.process.file.full_path = /\/(logrotate|rsyslogd|syslog-ng|systemd-journald|auditd|journalctl|systemd)$/ nocase
    not $del.principal.process.file.full_path in %global_allowed_admin_tools
    not $del.principal.user.userid in %global_allowed_service_accounts
    $del.principal.hostname = $hostname

    $mod.metadata.event_timestamp.seconds <= $del.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685.006")
    $primary_entity = array_distinct($hostname)
    $modified_logs = array_distinct($mod.target.file.full_path)
    $deleted_logs = array_distinct($del.target.file.full_path)
    $actor_users = array_distinct($del.principal.user.userid)
    $actor_processes = array_distinct($del.principal.process.file.full_path)
    $deletion_count = count($del.metadata.id)

  condition:
    $mod and $del
}
