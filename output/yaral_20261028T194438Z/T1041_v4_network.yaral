/*
  MITRE Technique : T1041 - Exfiltration Over C2 Channel
  Tactic(s)       : Exfiltration
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:59:45.887222+00:00
  Reference       : https://attack.mitre.org/techniques/T1041
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1041_Large_Outbound_Transfer_Over_Common_C2_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side detection of a single outbound connection from an internal Windows host that sends a very large volume of data to an external destination over a web or common C2 port (80, 443, 8080, 8443). This is characteristic of bulk data exfiltration over an existing C2 channel that blends in with normal web traffic. It uses only perimeter telemetry (destination, port and bytes sent) and does not depend on endpoint process fields."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1041"
    mitre_technique_name = "Exfiltration Over C2 Channel"
    log_prerequisites = "Requires firewall or proxy perimeter logs normalised to UDM NETWORK_CONNECTION with network.sent_bytes populated (bytes from client to server) and target.ip populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Cloud backup and file-sync uploads (OneDrive, SharePoint, other cloud storage), software or telemetry uploads to vendors, video conferencing and screen sharing, large legitimate web uploads by users, crash dump submission, and authorised off-site replication or migration jobs."
    tuning_guidance = "Add known-good external destinations (cloud storage, vendor upload endpoints) to %global_allowed_domains. Raise or lower the sent_bytes threshold (default about 50 MB) per client baseline. Extend %rfc1918_internal if the client uses additional private or CGNAT ranges that appear as external. Consider a second, lower-threshold variant for low-bandwidth environments."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.sent_bytes > 52428800
    (
      $net.target.port = 443 or
      $net.target.port = 80 or
      $net.target.port = 8080 or
      $net.target.port = 8443
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1041")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
