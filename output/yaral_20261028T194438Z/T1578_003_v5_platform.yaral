/*
  MITRE Technique : T1578.003 - Delete Cloud Instance
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:53:34.663515+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_003_Cloud_Instance_Deletion_Control_Plane {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a virtual machine or compute instance being deleted or terminated through the cloud control plane API by an identity that is not an approved automation or administrative principal. Adversaries delete instances after use to destroy forensic evidence. The rule matches the delete/terminate API action on audit-log resource deletion events, so it applies to any IaaS provider that normalises to UDM."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578.003"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Delete Cloud Instance"
    log_prerequisites = "Cloud provider management-plane audit logging enabled for all regions and subscriptions/projects, with write/delete activity ingested and normalised to RESOURCE_DELETION with metadata.product_event_type populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Autoscaling groups and scale-in events, infrastructure-as-code pipelines tearing down ephemeral environments, CI/CD test fleets, spot or preemptible instance reclamation, FinOps clean-up jobs, administrators decommissioning servers during approved change windows."
    tuning_guidance = "Add automation, IaC and autoscaling identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named administrators to %global_allowed_admin_users. For clients with heavy ephemeral workloads, consider also correlating with a prior suspicious-activity detection on the same identity, or raise severity only when the deleted instance was recently created by the same principal."

  events:
    $cloud.metadata.event_type = "RESOURCE_DELETION"
    $cloud.metadata.product_event_type = /(TerminateInstances|instances\.delete|virtualMachines\/delete)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1578.003")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_action = array_distinct($cloud.metadata.product_event_type)
    $deleted_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
