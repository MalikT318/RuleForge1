/*
  MITRE Technique : T1550.002 - Pass the Hash
  Tactic(s)       : Lateral Movement
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:38:29.216693+00:00
  Reference       : https://attack.mitre.org/techniques/T1550/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1550_002_Lsass_Access_Then_NewCredentials_Logon {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a likely pass-the-hash or overpass-the-hash sequence on one host. An untrusted process opens a handle to LSASS, then within 10 minutes a NewCredentials (logon type 9) authentication event is recorded on the same host. This is the pattern left when stolen hashes are injected into a new logon session, for example by 'sekurlsa::pth'-style tooling. It is based on process-access and authentication telemetry, not on command lines."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1550.002"
    mitre_technique_name = "Use Alternate Authentication Material: Pass the Hash"
    log_prerequisites = "Requires EDR or Sysmon process-access telemetry (Sysmon Event ID 10 equivalent) normalised to PROCESS_OPEN, and Windows Security Event 4624 normalised to USER_LOGIN with extensions.auth.mechanism populated (NEW_CREDENTIALS = logon type 9)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or scripts using 'runas /netonly', and RMM or deployment tooling that legitimately creates NewCredentials sessions. Security, EDR or backup agents that read LSASS memory and are not yet allowlisted. Software-inventory agents."
    tuning_guidance = "Add EDR/AV agents to %global_allowed_security_tools and backup or imaging software to %global_allowed_backup_processes. Add approved automation accounts to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Add approved RMM binaries to %global_allowed_admin_tools. Widen or narrow the 10m window in the match block if needed."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\lsass\.exe$/ nocase
    not $open.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|csrss|wininit|services|svchost|lsass)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    $open.principal.hostname = $host

    $login.metadata.event_type = "USER_LOGIN"
    $login.extensions.auth.mechanism = "NEW_CREDENTIALS"
    not $login.target.user.userid in %global_allowed_service_accounts
    not $login.target.user.userid in %global_allowed_admin_users
    not $login.target.user.userid = /\$$/
    $login.target.hostname = $host

    $open.metadata.event_timestamp.seconds <= $login.metadata.event_timestamp.seconds

  match:
    $host over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1550.002")
    $primary_entity = array_distinct($host)
    $accessing_processes = array_distinct($open.principal.process.file.full_path)
    $logon_users = array_distinct($login.target.user.userid)
    $open_event_count = count($open.metadata.id)

  condition:
    $open and $login
}
