/*
  MITRE Technique : T1558.003 - Kerberoasting
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:43:24.083360+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_003_Kerberos_Ticket_Export_File_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a Kerberos ticket export file (.kirbi) on a Windows endpoint. Kerberoasting tooling writes requested TGS service tickets to disk in this format for offline cracking or pass-the-ticket use. This rule watches the resulting file artifact rather than the command line, so it still fires when command-line logging is evaded or the tool is renamed."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.003"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Kerberoasting"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with the full target file path and the creating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Authorised red team and penetration test exercises, internal security assessment tooling, Kerberos troubleshooting by administrators, and identity-security or AD auditing products that export tickets."
    tuning_guidance = "Add approved assessment and AD auditing tooling to %global_allowed_admin_tools or %global_allowed_scanners, EDR and security agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Because ticket export is rare in normal operations, tune by the creating process or account rather than by file path."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.kirbi$/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_scanners
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1558.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $user = array_distinct($file.principal.user.userid)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $ticket_file = array_distinct($file.target.file.full_path)

  condition:
    $file
}
