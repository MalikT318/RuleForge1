/*
  MITRE Technique : T1685.006 - Clear Linux or Mac System Logs
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:25:50.876491+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_006_Linux_System_Log_File_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects deletion of active Linux system, authentication, login-record, audit, web server or journal log files under /var/log or the runtime journal directory by a process other than the log management stack. Uses file-deletion telemetry rather than command-line matching, so it fires whatever tool or syscall (rm, shred, unlink from a script or binary) removed the file."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.006"
    mitre_technique_name = "Clear Linux or Mac System Logs"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd rules watching /var/log (unlink/unlinkat syscalls) normalised to FILE_DELETION with the acting process populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers or configuration management removing and recreating logs during software uninstall or reinstall; admins manually resetting logs on build or golden-image preparation; container or cleanup tooling wiping logs on ephemeral hosts; custom log rotation scripts not named logrotate."
    tuning_guidance = "Add approved admin and cleanup tooling to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and backup or imaging agents to %global_allowed_backup_processes. Extend the process-name exclusion for custom rotation tools. On ephemeral or image-build hosts, scope the rule out by host group."

  events:
    $file.metadata.event_type = "FILE_DELETION"
    $file.target.file.full_path = /^\/var\/log\/(messages|secure|syslog|auth\.log|kern\.log|cron|cron\.log|maillog|mail\.log|wtmp|btmp|utmp|lastlog|faillog|audit\/audit\.log|(httpd|apache2|nginx)\/(access|error)[_.]log|journal\/.+\.journal~?)$|^\/run\/log\/journal\/.+\.journal~?$/ nocase
    not $file.principal.process.file.full_path = /\/(logrotate|rsyslogd|syslog-ng|systemd-journald|journalctl|auditd|dpkg|rpm|apt|apt-get|yum|dnf|packagekitd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $deleted_log_files = array_distinct($file.target.file.full_path)
    $acting_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
