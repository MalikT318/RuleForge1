/*
  MITRE Technique : T1569.002 - Service Execution
  Tactic(s)       : Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:12:36.725325+00:00
  Reference       : https://attack.mitre.org/techniques/T1569/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_002_Burst_Service_ImagePath_Registry_Writes {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of service ImagePath registry writes under the Services key on a single host within 10 minutes. A single service install is normal, but several in a short window matches PsExec-style or scripted remote service execution and lateral tooling. Uses registry telemetry rather than process command-line matching, so it still fires when the service is created through the SCM API and sc.exe is never launched."
    mitre_tactic = "Execution"
    mitre_technique = "T1569.002"
    mitre_technique_name = "System Services: Service Execution"
    log_prerequisites = "Requires registry modification telemetry from an EDR or Sysmon (Sysmon Event ID 13 equivalent) covering HKLM\\SYSTEM\\CurrentControlSet\\Services."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters, driver installations, endpoint agent deployments, RMM and patching tools, golden-image build or provisioning scripts, and administrators deploying multiple services at once."
    tuning_guidance = "Add approved deployment and RMM binaries to %global_allowed_admin_tools. Add installer or automation accounts to %global_allowed_service_accounts. Raise the #reg threshold on build or provisioning hosts. Extend the installer exclusion regex for client-specific servicing processes."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(CurrentControlSet|ControlSet\d{3})\\Services\\[^\\]+/ nocase
    $reg.target.registry.registry_value_name = "ImagePath" nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|msiexec|MsMpEng)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1569.002")
    $primary_entity = array_distinct($host)
    $write_count = count($reg.metadata.id)
    $service_keys = array_distinct($reg.target.registry.registry_key)
    $writer_processes = array_distinct($reg.principal.process.file.full_path)
    $writer_users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 3
}
