/*
  MITRE Technique : T1684.001 - Impersonation
  Tactic(s)       : Stealth
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:31:52.410223+00:00
  Reference       : https://attack.mitre.org/techniques/T1684/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1684_001_Interpreter_Direct_External_SMTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux scripting interpreter or raw socket utility opening an outbound connection to an external host on an SMTP port (25, 465, 587). Impersonation (T1684.001) is a social-engineering technique and is not directly observable on a Linux endpoint. This rule instead covers the network-side proxy: a compromised or attacker-controlled host sending spoofed or impersonating mail directly to an external mail server from a script, bypassing the organisation's mail relay. Treat it as a lead for review, not proof of impersonation."
    mitre_tactic = "Stealth"
    mitre_technique = "T1684.001"
    mitre_technique_name = "Impersonation"
    log_prerequisites = "Requires Linux EDR or auditd network telemetry that populates the connecting process path (principal.process.file.full_path), target.ip and target.port on NETWORK_CONNECTION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Monitoring or alerting scripts that email directly to an external provider, cron-driven report mailers written in Python, Perl or PHP, web applications (PHP or Node) sending transactional mail via an external SMTP service, and administrators testing mail connectivity with openssl or nc."
    tuning_guidance = "Add approved script runtimes or application paths to %global_allowed_script_hosts. Add approved scripting or application hosts to the same list by hostname. Because the rule requires an external destination, make sure %rfc1918_internal is populated for each client so internal relays are excluded. If a client uses an external SMTP smarthost, consider raising the severity only for hosts that are not expected to send mail."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 25 or $net.target.port = 465 or $net.target.port = 587)
    $net.principal.process.file.full_path = /\/(python[0-9.]*|perl|ruby|php[0-9.]*|node|nodejs|bash|dash|sh|zsh|nc|ncat|netcat|socat|openssl|curl|telnet)$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_script_hosts
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1684.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $process_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
