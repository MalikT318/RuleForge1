/*
  MITRE Technique : T1102.002 - Bidirectional Communication
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:56:54.510580+00:00
  Reference       : https://attack.mitre.org/techniques/T1102/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1102_002_ESXi_Host_Outbound_Web_Service_CLI_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi hypervisor host making outbound web requests through a perimeter proxy or firewall using a scripting or command-line HTTP client user agent (curl, wget, Python, Go and similar) to an external destination outside the known-good domain list. ESXi management hosts normally talk to internal vCenter and update infrastructure with vendor user agents. A shell-driven HTTP client on the hypervisor reaching a public web service is consistent with using a legitimate web service for bidirectional C2: fetching commands and posting results."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1102.002"
    mitre_technique_name = "Web Service: Bidirectional Communication"
    log_prerequisites = "Requires proxy or firewall HTTP logging (with user agent and destination hostname) that is normalised to UDM NETWORK_HTTP, with ESXi management interfaces egressing through that device. TLS inspection is needed to see user agents on HTTPS traffic. The source hostname must be populated and ESXi hosts must follow a naming convention containing 'esx' or 'vmhost'."
    platform = "ESXi"
    log_source = "firewall"
    false_positives = "Administrators running curl or wget from the ESXi shell to download patches, VIBs, ISOs or offline bundles; backup, monitoring or inventory scripts hosted on the hypervisor; hardware vendor health-check or firmware tooling; hosts whose names match the ESXi pattern but are not hypervisors."
    tuning_guidance = "Add legitimate vendor, patch and mirror domains to %global_allowed_domains. Adjust the principal.hostname regex to the client's ESXi naming convention, or replace it with an asset-based match if asset context is available. Extend the vendor user agent exclusion if the client uses custom tooling that sets its own user agent. Consider raising severity if the ESXi shell is not expected to be enabled."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.principal.hostname = /(esx|vmhost)/ nocase
    $net.network.http.user_agent = /^(curl|wget|python|go-http-client|libwww-perl|java|busybox|urllib)/ nocase
    not $net.network.http.user_agent = /(vmware|esxupdate|vsphere|vmw)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1102.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $user_agents = array_distinct($net.network.http.user_agent)
    $http_methods = array_distinct($net.network.http.method)

  condition:
    $net
}
