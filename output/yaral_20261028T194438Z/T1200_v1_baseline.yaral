/*
  MITRE Technique : T1200 - Hardware Additions
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:49:27.028028+00:00
  Reference       : https://attack.mitre.org/techniques/T1200
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1200_Rogue_DHCP_Server_Offer_From_Unapproved_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects DHCP server-to-client traffic (UDP source port 67 to destination port 68) from a source address that is not an approved DHCP server or relay. A physically introduced device, such as a Linux-based implant, rogue router or access point, commonly hands out DHCP leases to steer clients through itself for adversary-in-the-middle or to gain a foothold on the network. This is observed at the network perimeter or internal firewall rather than on the endpoint."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1200"
    mitre_technique_name = "Hardware Additions"
    log_prerequisites = "Requires firewall or network perimeter logs that record UDP flows on internal segments, including DHCP (ports 67/68), normalised to NETWORK_CONNECTION with principal.ip, principal.port, target.port and network.ip_protocol. DHCP traffic must traverse an inspected interface or a span or relay point."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Newly deployed or migrated legitimate DHCP servers or relays, failover DHCP peers, DHCP services on hypervisors or lab networks, consumer routers in branch or test segments, and Linux hosts running dnsmasq for PXE or provisioning."
    tuning_guidance = "Add approved DHCP server and relay source addresses to %global_allowed_mgmt_sources. Scope the rule to segments where DHCP is expected to come only from known infrastructure. Review sources that repeat across many client addresses first, as these are the most likely rogue servers."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "UDP"
    $net.principal.port = 67
    $net.target.port = 68
    $net.principal.ip != ""
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1200")
    $primary_entity = array_distinct($net.principal.ip)
    $client_ips = array_distinct($net.target.ip)
    $client_count = count_distinct($net.target.ip)

  condition:
    $net
}
