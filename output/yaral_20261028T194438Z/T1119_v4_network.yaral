/*
  MITRE Technique : T1119 - Automated Collection
  Tactic(s)       : Collection
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:25:49.676112+00:00
  Reference       : https://attack.mitre.org/techniques/T1119
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1119_Linux_Cron_Spawned_Transfer_Tool_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side detection of automated collection or staging on Linux: a file-transfer or raw-socket utility (curl, wget, scp, sftp, rsync, ftp, nc and similar) launched by a scheduler (cron, anacron, atd) opens a connection to an external, non-allowlisted destination. Scheduled outbound transfers are characteristic of scripted, recurring data collection and exfiltration. Complements command-line based detections by observing the resulting network behaviour."
    mitre_tactic = "Collection"
    mitre_technique = "T1119"
    mitre_technique_name = "Automated Collection"
    log_prerequisites = "Requires Linux EDR or auditd-derived network telemetry that populates NETWORK_CONNECTION with the initiating process path and its parent process path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Scheduled backups and offsite syncs (rsync/scp jobs), package or repository mirroring via cron, monitoring and inventory agents that curl a SaaS endpoint, certificate renewal jobs, log shipping scripts, and cron-based health checks."
    tuning_guidance = "Add approved backup tools to %global_allowed_backup_processes, sanctioned automation binaries to %global_allowed_admin_tools, and known-good vendor and update endpoints to %global_allowed_domains. If parent process is not populated for a client, this rule will not fire for that source; verify telemetry coverage first. Consider adding destination hosts that are approved offsite backup targets to %global_allowed_domains."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.parent_process.file.full_path = /\/(cron|crond|anacron|atd)$/ nocase
    $net.principal.process.file.full_path = /\/(curl|wget|scp|sftp|rsync|ftp|lftp|nc|ncat|netcat|socat)$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1119")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $transfer_tool = array_distinct($net.principal.process.file.full_path)
    $scheduler = array_distinct($net.principal.process.parent_process.file.full_path)

  condition:
    $net
}
