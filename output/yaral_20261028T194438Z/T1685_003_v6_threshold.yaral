/*
  MITRE Technique : T1685.003 - Modify or Spoof Tool UI
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:21:08.363930+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_003_Security_Center_Notification_Suppression_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of registry modifications on a single host that suppress or hide Windows Security Center / Defender notifications, tray icon and UI status (notification disable, tray hiding, UI lockdown, AV/firewall/update notify suppression). Adversaries use this after disabling defences so the security UI keeps showing a healthy state and users and defenders are not alerted. The individual registry write can be benign; several distinct suppression writes within 10 minutes on one host are not."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.003"
    mitre_technique_name = "Modify or Spoof Tool UI"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (REGISTRY_MODIFICATION) with populated registry key, value name and initiating process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy or MDM baselines that deliberately suppress Security Center notifications (kiosks, VDI golden images, managed-AV environments where a third-party AV takes over the Security Center), software installers registering a third-party AV, and IT hardening scripts."
    tuning_guidance = "Add deployment, GPO and imaging tooling to %global_allowed_admin_tools, approved security agents to %global_allowed_security_tools, and automation identities to %global_allowed_service_accounts. Raise the threshold in #reg for environments with frequent AV product transitions."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(Windows Defender Security Center\\(Notifications|Systray|Virus and threat protection|Account protection|App and Browser protection|Family options|Device security)|Microsoft\\Security Center)(\\|$)/ nocase
    $reg.target.registry.registry_value_name = /^(DisableNotifications|DisableEnhancedNotifications|UILockdown|HideSystray|AntiVirusDisableNotify|FirewallDisableNotify|UpdatesDisableNotify|AntiSpywareDisableNotify|DisableAvCheck)$/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    not $reg.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|TrustedInstaller|MpCmdRun)\.exe$/ nocase

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1685.003")
    $primary_entity = array_distinct($host)
    $suppression_write_count = count($reg.metadata.id)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $value_names = array_distinct($reg.target.registry.registry_value_name)
    $initiating_processes = array_distinct($reg.principal.process.file.full_path)
    $users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 3
}
