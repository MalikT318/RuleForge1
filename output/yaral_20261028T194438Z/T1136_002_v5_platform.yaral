/*
  MITRE Technique : T1136.002 - Domain Account
  Tactic(s)       : Persistence
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:10:16.991784+00:00
  Reference       : https://attack.mitre.org/techniques/T1136/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_002_Linux_Domain_Account_Creation_CLI {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a directory/domain account from a Linux host using native identity-management CLIs (Samba AD, FreeIPA, adcli, net ads/rpc). Adversaries with sufficient privileges can create a domain account for persistent, credentialed access that does not need a deployed remote access tool. The rule matches the combination of identity tool and account-creation subcommand, not a specific payload or account name."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136.002"
    mitre_technique_name = "Create Account: Domain Account"
    log_prerequisites = "Linux EDR process telemetry or auditd EXECVE/SYSCALL records with full command line populated (PROCESS_LAUNCH) on domain controllers, IdM servers and domain-joined Linux hosts."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Identity administrators provisioning accounts from a DC or IdM server, HR/IAM onboarding automation, configuration management (Ansible, Puppet) managing directory users, lab and build environments that join and create test accounts."
    tuning_guidance = "Add approved provisioning tooling or parent processes to %global_allowed_admin_tools, onboarding automation accounts to %global_allowed_service_accounts, and named identity administrators to %global_allowed_admin_users. Restrict deployment to hosts that are not expected to administer the directory if noise remains."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(samba-tool|ipa|net|adcli)$/ nocase
    $proc.target.process.command_line = /(samba-tool\s+user\s+(create|add)\b|\bipa\s+(stageuser|user)-add\b|\bnet\s+(ads|rpc)\s+user\s+add\b|\badcli\s+create-user\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1136.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
