/*
  MITRE Technique : T1216.002 - SyncAppvPublishingServer
  Tactic(s)       : Stealth
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:37:32.121383+00:00
  Reference       : https://attack.mitre.org/techniques/T1216/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1216_002_SyncAppvPublishingServer_Proxy_Execution_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated invocation of the App-V publishing script or binary (SyncAppvPublishingServer) with a semicolon-delimited inline PowerShell payload on a single host within 10 minutes. Legitimate App-V sync calls use simple switches and no inline commands, so repeated payload-style invocations indicate proxy execution of PowerShell."
    mitre_tactic = "Stealth"
    mitre_technique = "T1216.002"
    mitre_technique_name = "System Script Proxy Execution: SyncAppvPublishingServer"
    log_prerequisites = "Requires EDR or Sysmon-equivalent process creation telemetry with full command lines (Sysmon Event ID 1 or Windows Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators testing App-V publishing configuration, App-V client management or sync scripts that pass unusual arguments, software packaging and deployment tooling, and lab or red-team exercises."
    tuning_guidance = "Add approved deployment or App-V management parent processes to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Raise the #proc threshold in noisy environments, or lower it to 1 where App-V is not deployed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /SyncAppvPublishingServer(\.vbs|\.exe)?["']?\s+["']?[^"'\r\n]*;/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(re.regex($proc.target.process.command_line, /(?i)(iex|invoke-expression|downloadstring|downloadfile|-enc|encodedcommand|bypass|hidden|frombase64string|net\.webclient)/), 90, 70))
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1216.002")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)

  condition:
    #proc >= 3
}
