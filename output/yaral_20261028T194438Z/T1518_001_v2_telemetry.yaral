/*
  MITRE Technique : T1518.001 - Security Software Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:19:38.202854+00:00
  Reference       : https://attack.mitre.org/techniques/T1518/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1518_001_Untrusted_Process_Handle_To_Security_Agent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a process running from a user-writable location (user profile, Temp, ProgramData, Public) that opens a handle to an endpoint security agent process. Handle requests against AV/EDR service processes are a state-level artifact of security software discovery, where malware checks whether defensive tooling is running. The rule works at the PROCESS_OPEN layer, so it does not depend on command-line logging, which attackers can evade."
    mitre_tactic = "Discovery"
    mitre_technique = "T1518.001"
    mitre_technique_name = "Software Discovery: Security Software Discovery"
    log_prerequisites = "Requires endpoint telemetry that records process handle access (Sysmon Event ID 10 or equivalent EDR process-open events) normalised to PROCESS_OPEN with populated principal and target process paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Portable admin or diagnostic utilities run from user folders (Process Explorer, Process Hacker, Task Manager replacements), software installers or updaters staged in Temp or ProgramData that check for or reconfigure an existing AV agent, backup agents, vendor uninstall or cleanup tools, and security product self-update stubs."
    tuning_guidance = "Add approved security agent, uninstaller and updater binaries to %global_allowed_security_tools. Add IT diagnostic tooling to %global_allowed_admin_tools. Add backup agents to %global_allowed_backup_processes. Add automation accounts to %global_allowed_service_accounts. Extend the target process-name regex with the security products deployed at the client. If it is too noisy, narrow the principal path regex to \\Users and \\Temp only."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|SenseCncProxy|NisSrv|SecurityHealthService|CSFalconService|CSFalconContainer|SentinelAgent|SentinelServiceHost|CylanceSvc|SophosHealth|SophosFS|ccSvcHst|bdservicehost|avp|mcshield|TaniumClient|elastic-agent|elastic-endpoint|sysmon|sysmon64|xagt|ekrn|coreServiceShell|ntrtscan|wazuh-agent|cbdefense|RepMgr)\.exe$/ nocase
    $open.principal.process.file.full_path = /\\(Users\\[^\\]+\\(AppData|Downloads|Desktop|Documents)|Windows\\Temp|Temp|ProgramData|Users\\Public|PerfLogs)\\/ nocase
    not $open.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|SenseCncProxy|NisSrv|SecurityHealthService|CSFalconService|SentinelAgent|SentinelServiceHost|CylanceSvc|elastic-agent|elastic-endpoint|sysmon|sysmon64|MpCmdRun|MpDefenderCoreService|MsMpEngCP)\.exe$/ nocase
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1518.001")
    $primary_entity = array_distinct($open.principal.hostname)
    $source_process = array_distinct($open.principal.process.file.full_path)
    $targeted_agent = array_distinct($open.target.process.file.full_path)
    $acting_user = array_distinct($open.principal.user.userid)

  condition:
    $open
}
