/*
  MITRE Technique : T1552.001 - Credentials In Files
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:46:16.843131+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_001_Web_Request_Successful_Credential_File_Retrieval {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a successful (HTTP 200) request from an external source for a well-known credential or secrets file path, such as cloud CLI credentials, container registry auth, kubeconfig, dotenv files, SSH private keys or Terraform state. A 200 response means the web tier served a credential file to an outside client, which is the network-observable result of insecurely stored credentials in files (T1552.001). This is a network-perimeter detection that complements endpoint command-line rules. It was written for Linux, container and cloud-hosted web workloads, where these file conventions are native. The firewall or proxy log cannot identify the host OS, so the platform value reflects the targeted file conventions."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.001"
    mitre_technique_name = "Unsecured Credentials: Credentials In Files"
    log_prerequisites = "Requires firewall, proxy or web gateway logs normalised to NETWORK_HTTP with target.url, principal.ip and network.http.response_code populated. TLS inspection or reverse-proxy visibility is needed for HTTPS traffic."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Authorised external vulnerability or attack-surface scanners, penetration tests, bug-bounty researchers, honeypot or canary files intentionally served, and misconfigured deployment pipelines fetching dotenv or config files over HTTP from a public address."
    tuning_guidance = "Add approved scanner source addresses to %global_allowed_scanners. Add trusted management or CI/CD source addresses to %global_allowed_mgmt_sources. Extend the path regex with organisation-specific secret file names if needed. Any hit with a 200 response should be treated as confirmed credential exposure: rotate the secrets and remove the file from the web root."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.response_code = 200
    $http.target.url = /(\/|%2f)\.?(aws\/credentials|docker\/config\.json|kube\/config|git-credentials|npmrc|pgpass|netrc|ssh\/(id_rsa|id_ed25519|id_ecdsa)|env(\.(local|prod|production|backup|bak|old))?|terraform\.tfstate(\.backup)?|credentials\.json|secrets\.(json|ya?ml))([?#]|$)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1552.001")
    $primary_entity = array_distinct($http.target.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
