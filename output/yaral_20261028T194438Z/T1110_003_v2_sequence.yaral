/*
  MITRE Technique : T1110.003 - Password Spraying
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:06:55.503812+00:00
  Reference       : https://attack.mitre.org/techniques/T1110/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1110_003_IaaS_Password_Spray_Then_Success {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects password spraying against cloud console or identity sign-in: one source IP fails authentication against many distinct accounts, then the same source IP completes a successful login within 10 minutes. The failure-then-success sequence from one source indicates a probable valid credential guess."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1110.003"
    mitre_technique_name = "Brute Force: Password Spraying"
    log_prerequisites = "Requires cloud and identity sign-in audit logs normalised to USER_LOGIN with principal.ip, target.user.userid and security_result.action populated (BLOCK for failed, ALLOW for successful authentication)."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Shared NAT or corporate egress IPs where many users mistype passwords (e.g. after a forced password reset or a Monday-morning surge), misconfigured SSO or federation connectors retrying with stale credentials, authorised penetration tests and vulnerability scanners, and helpdesk or onboarding tooling testing many accounts."
    tuning_guidance = "Add authorised scanner and pentest source IPs to %global_allowed_scanners. Add automation and federation accounts to %global_allowed_service_accounts. Raise the distinct-user threshold in the condition for tenants behind large shared NAT egress. Widen the match window if the tenant sees low-and-slow spraying."

  events:
    $fail.metadata.event_type = "USER_LOGIN"
    $fail.security_result.action = "BLOCK"
    $fail.principal.ip = $src_ip
    $fail.target.user.userid != ""
    not $fail.target.user.userid in %global_allowed_service_accounts
    not $fail.principal.ip in %global_allowed_scanners

    $succ.metadata.event_type = "USER_LOGIN"
    $succ.security_result.action = "ALLOW"
    $succ.principal.ip = $src_ip
    $succ.target.user.userid != ""
    not $succ.target.user.userid in %global_allowed_service_accounts
    not $succ.principal.ip in %global_allowed_scanners

    $fail.metadata.event_timestamp.seconds <= $succ.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1110.003")
    $primary_entity = array_distinct($src_ip)
    $distinct_failed_users = count_distinct($fail.target.user.userid)
    $failed_attempts = count($fail.metadata.id)
    $targeted_users = array_distinct($fail.target.user.userid)
    $successful_users = array_distinct($succ.target.user.userid)

  condition:
    $fail and $succ and $distinct_failed_users >= 5
}
