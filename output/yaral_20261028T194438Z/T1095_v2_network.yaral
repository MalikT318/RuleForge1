/*
  MITRE Technique : T1095 - Non-Application Layer Protocol
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:37:36.022199+00:00
  Reference       : https://attack.mitre.org/techniques/T1095
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1095_Firewall_Outbound_ICMP_Large_Payload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound ICMP traffic from an internal Windows host to an external address where the bytes sent in the connection far exceed normal echo request sizes. This is characteristic of ICMP tunnelling or ICMP-based C2 (T1095), where data is carried in the ICMP payload. Detection is based purely on perimeter-observed protocol, direction and volume."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1095"
    mitre_technique_name = "Non-Application Layer Protocol"
    log_prerequisites = "Requires firewall or perimeter logs that record ICMP sessions with network.ip_protocol and network.sent_bytes populated, normalised to NETWORK_CONNECTION. The perimeter device must log ICMP, which some default policies do not."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Network monitoring and uptime probes using large ICMP payloads, MTU or path-discovery testing by administrators, long-running continuous pings summarised into one flow record, and approved vulnerability scanners."
    tuning_guidance = "Add monitoring and scanner source addresses to %global_allowed_scanners and approved management sources to %global_allowed_mgmt_sources. If the firewall aggregates many pings into one session record, raise the sent_bytes threshold per client. Lower it where per-packet logging is available."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "ICMP"
    $net.network.sent_bytes > 5000
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1095")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
