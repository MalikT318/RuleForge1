/*
  MITRE Technique : T1114.001 - Local Email Collection
  Tactic(s)       : Collection
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:17:34.388485+00:00
  Reference       : https://attack.mitre.org/techniques/T1114/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1114_001_Local_Mail_Store_Copy_Or_Archive {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a copy, move or archive utility (cmd copy/xcopy/robocopy, PowerShell Copy-Item/Compress-Archive, esentutl, archivers) launched with a command line that references an Outlook offline or personal data file (.ost/.pst). This is the most direct signal of local mailbox collection ahead of staging or exfiltration. Outlook itself is excluded."
    mitre_tactic = "Collection"
    mitre_technique = "T1114.001"
    mitre_technique_name = "Email Collection: Local Email Collection"
    log_prerequisites = "Requires EDR or Sysmon process-creation telemetry with full command line (Sysmon Event 1, Windows Event 4688 with command-line auditing, or equivalent EDR)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup and imaging agents, user profile migration and device refresh tooling, mailbox archiving or eDiscovery utilities, helpdesk staff relocating PST files, and Outlook data-file repair by IT."
    tuning_guidance = "Add approved backup binaries to %global_allowed_backup_processes. Add migration and IT tooling to %global_allowed_admin_tools. Add approved service accounts to %global_allowed_service_accounts. Add EDR/AV to %global_allowed_security_tools. Raise severity if the user is not an administrator or the destination is a removable drive or network share."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /\b(copy|xcopy|robocopy|move|copy-item|move-item|compress-archive|esentutl|makecab|tar|rar|7z|7za|certutil)(\.exe)?\b.*\.(pst|ost)\b/ nocase
    not $proc.target.process.file.full_path = /\\(outlook|olk|scanpst|searchindexer|searchprotocolhost)\.exe$/ nocase
    not $proc.principal.process.file.full_path = /\\(outlook|olk)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.target.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1114.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)

  condition:
    $proc
}
