/*
  MITRE Technique : T1602.001 - SNMP (MIB Dump)
  Tactic(s)       : Collection
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:18:08.908343+00:00
  Reference       : https://attack.mitre.org/techniques/T1602/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_001_External_SNMP_MIB_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a perimeter-observed connection from a non-internal source address to the SNMP agent port (161) of a managed device. Adversaries use external SNMP queries or walks to dump the MIB (running configuration, routing table, interface and system details) and build network maps for later exploitation. Internet-sourced SNMP polling of managed devices is rarely legitimate."
    mitre_tactic = "Collection"
    mitre_technique = "T1602.001"
    mitre_technique_name = "Data from Configuration Repository: SNMP (MIB Dump)"
    log_prerequisites = "Firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated, including allowed and denied connection attempts. The %rfc1918_internal list must contain the client's internal address space."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "External managed-service or NMS polling over WAN links, ISP or carrier monitoring of customer edge devices, third-party vulnerability or exposure scanners, and cloud-hosted monitoring platforms polling branch devices."
    tuning_guidance = "Add approved external monitoring or NMS source addresses to %global_allowed_mgmt_sources and authorised scanner sources to %global_allowed_scanners. Confirm %rfc1918_internal covers the client's private and carrier-NAT ranges. Where hits are noisy, restrict SNMP at the perimeter with ACLs and treat remaining alerts as exposure findings."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 161
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1602.001")
    $primary_entity = array_distinct($net.principal.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ips = array_distinct($net.target.ip)
    $target_hosts = array_distinct($net.target.hostname)

  condition:
    $net
}
