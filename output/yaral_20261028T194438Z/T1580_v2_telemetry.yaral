/*
  MITRE Technique : T1580 - Cloud Infrastructure Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:57:55.667415+00:00
  Reference       : https://attack.mitre.org/techniques/T1580
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1580_Cloud_Infrastructure_Discovery_API_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects control-plane API calls that enumerate cloud infrastructure: storage buckets and their access-block posture, compute instances, volumes, snapshots and database instances. The rule works on the resource-access audit record, not on any CLI or command-line artifact, so it fires whether the caller used a CLI, an SDK, or raw API requests. Calls made by principals outside the approved service, admin and cloud-principal lists are flagged."
    mitre_tactic = "Discovery"
    mitre_technique = "T1580"
    mitre_technique_name = "Cloud Infrastructure Discovery"
    log_prerequisites = "Cloud control-plane audit logs with read/management API events enabled and normalised to UDM USER_RESOURCE_ACCESS. Requires metadata.product_event_type (API operation name) and principal.user.userid to be populated. Read-only management events must be enabled; they are often off by default in some providers."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Cloud posture and inventory tooling, asset-management and CMDB sync jobs, FinOps and cost tools, infrastructure-as-code plan and refresh runs, backup and DR orchestration, and engineers browsing the console or running inventory scripts."
    tuning_guidance = "Add known automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named administrators to %global_allowed_admin_users. Narrow the API regex to the higher-signal operations (storage listing, public-access-block and snapshot enumeration) if DescribeInstances-style calls are too noisy for a client. For stronger fidelity, pair this rule with a threshold or sequence variant that counts distinct API names per principal."

  events:
    $cloud.metadata.event_type = "USER_RESOURCE_ACCESS"
    $cloud.metadata.product_event_type = /^(ListBuckets|HeadBucket|GetPublicAccessBlock|GetBucketPolicyStatus|DescribeInstances|DescribeSnapshots|DescribeVolumes|DescribeDBInstances|DescribeDBSnapshots|storage\.buckets\.list|compute\.instances\.(list|aggregatedList)|compute\.snapshots\.list|compute\.disks\.list|.*(virtualMachines|storageAccounts|snapshots|disks)\/read)$/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1580")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_operations = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)
    $target_resources = array_distinct($cloud.target.resource.name)

  condition:
    $cloud
}
