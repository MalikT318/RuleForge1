/*
  MITRE Technique : T1491 - Defacement
  Tactic(s)       : Impact
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:43:16.814497+00:00
  Reference       : https://attack.mitre.org/techniques/T1491
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_Static_Web_Content_Written_Then_Served {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An external source writes to a static web content URL with PUT or POST (HTML, image, CSS or JS) and the same source then successfully fetches that same URL within 10 minutes. This write-then-verify pattern is typical of web defacement against Windows-hosted web servers, where the attacker replaces visual content and checks that it is live."
    mitre_tactic = "Impact"
    mitre_technique = "T1491"
    mitre_technique_name = "Defacement"
    log_prerequisites = "Requires firewall, reverse proxy or WAF logs normalised to UDM NETWORK_HTTP, with network.http.method, network.http.response_code, target.url and principal.ip populated. TLS inspection or reverse-proxy visibility is needed to see HTTP methods and URLs."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "CMS or web publishing tools that upload static assets over HTTP from external locations, WebDAV-based content authoring by remote administrators or contractors, CI/CD pipelines deploying front-end assets through an external gateway, and external vulnerability scanners probing write methods."
    tuning_guidance = "Add publishing, deployment and administrator source addresses to %global_allowed_mgmt_sources and approved scanners to %global_allowed_scanners. If the web tier sits behind a proxy that masks the client address, confirm that principal.ip holds the real client IP. Extend or narrow the static content extension list to match the environment."

  events:
    $write.metadata.event_type = "NETWORK_HTTP"
    $write.network.http.method = /^(PUT|POST)$/ nocase
    $write.target.url = /\.(html?|jpe?g|png|gif|bmp|svg|css|js)(\?.*)?$/ nocase
    $write.network.http.response_code >= 200
    $write.network.http.response_code < 300
    not $write.principal.ip in %rfc1918_internal
    not $write.principal.ip in %global_allowed_mgmt_sources
    not $write.principal.ip in %global_allowed_scanners
    $write.principal.ip = $src_ip
    $write.target.url = $url

    $read.metadata.event_type = "NETWORK_HTTP"
    $read.network.http.method = /^GET$/ nocase
    $read.network.http.response_code >= 200
    $read.network.http.response_code < 300
    $read.principal.ip = $src_ip
    $read.target.url = $url

    $write.metadata.event_timestamp.seconds <= $read.metadata.event_timestamp.seconds

  match:
    $src_ip, $url over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1491")
    $primary_entity = array_distinct(strings.coalesce($write.target.hostname, $url))
    $source_ips = array_distinct($src_ip)
    $modified_urls = array_distinct($url)
    $write_count = count($write.metadata.id)
    $read_count = count($read.metadata.id)

  condition:
    $write and $read
}
