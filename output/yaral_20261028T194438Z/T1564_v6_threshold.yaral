/*
  MITRE Technique : T1564 - Hide Artifacts
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:13:04.052400+00:00
  Reference       : https://attack.mitre.org/techniques/T1564
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_Linux_Hidden_File_Burst_Temp_Dirs {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of dot-prefixed (hidden) files created in world-writable staging locations (/tmp, /var/tmp, /dev/shm) on a single Linux host within 10 minutes. One hidden temp file is routine; many in a short window suggests malware or an operator staging payloads, working files or persistence artifacts out of sight."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564"
    mitre_technique_name = "Hide Artifacts"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry normalized to UDM FILE_CREATION with target.file.full_path and principal.hostname populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Editors creating swap or backup files (.swp), package managers and installers, language runtime and build tools creating hidden temp files, desktop sessions, browsers, CI runners, container runtimes, and configuration management agents."
    tuning_guidance = "Add legitimate creating process paths to %global_allowed_admin_tools or %global_allowed_backup_processes. Raise the count threshold on build servers or CI hosts, or extend the benign-name exclusion regex for noisy local software."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/(.+\/)?\.[^\/]+$/
    not $file.target.file.full_path = /\/\.(X11-unix|ICE-unix|font-unix|XIM-unix|Test-unix)(\/|$)/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1564")
    $primary_entity = array_distinct($file.principal.hostname)
    $hidden_paths = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 10
}
