/*
  MITRE Technique : T1542.005 - TFTP Boot
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:50:55.144350+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_005_TFTP_Outbound_To_External_Server {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects TFTP (UDP/69) traffic from an internal source to a non-internal destination, observed at the network perimeter. Network devices configured to netboot, or to pull images or configs over TFTP, from an external server can be loaded with an attacker-controlled operating system image. TFTP is unauthenticated and unencrypted and has almost no legitimate reason to cross the perimeter."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.005"
    mitre_technique_name = "Pre-OS Boot: TFTP Boot"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with target.port, target.ip and network.ip_protocol populated. The firewall must log permitted UDP/69 sessions."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legacy network device or VoIP phone provisioning against a vendor or cloud-hosted TFTP server, branch routers pulling approved images from a central server reached via public address space or a WAN, authorised firmware upgrades by network engineers, and vulnerability scanners probing UDP/69."
    tuning_guidance = "Add approved management or provisioning source addresses to %global_allowed_mgmt_sources. Add authorised scanner sources to %global_allowed_scanners. The destination exclusion uses %rfc1918_internal, so sessions to internal TFTP servers are not alerted; review the internal TFTP server inventory separately. Consider a companion rule on device configuration changes (SETTING_MODIFICATION) that set a boot or TFTP server."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "UDP"
    $net.target.port = 69
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1542.005")
    $primary_entity = array_distinct($net.principal.ip)
    $source_hostnames = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
