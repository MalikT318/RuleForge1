/*
  MITRE Technique : T1213.001 - Confluence
  Tactic(s)       : Collection
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:24:05.645844+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_001_SaaS_Wiki_Bulk_Export_Or_Attachment_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a user exporting or downloading wiki space or page content, or bulk-pulling attachments, from a collaboration/wiki SaaS application. Adversaries with a compromised account use these functions to harvest architecture documents, credentials and network diagrams in one step instead of browsing page by page. Detection is based on the audit action name or the export and download URL path. It does not depend on a vendor name, IP or user."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.001"
    mitre_technique_name = "Data from Information Repositories: Confluence"
    log_prerequisites = "SaaS application audit logs for the wiki/collaboration platform ingested and normalised to UDM USER_RESOURCE_ACCESS, with metadata.product_event_type and/or target.url populated, and principal.user.userid populated."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Documentation owners exporting spaces to PDF/Word for audits or offline review; scheduled backup or migration service accounts; compliance and eDiscovery exports; legitimate admins during platform migration; employees downloading attachments in normal work."
    tuning_guidance = "Add automation and migration identities to %global_allowed_service_accounts, named admins to %global_allowed_admin_users, and approved integration principals to %global_allowed_cloud_principals. A single-event rule cannot count volume. Pair it with a threshold rule on the same user to prioritise bursts of exports. Review product_event_type values in your tenant and widen or narrow the regex to match the platform's audit action names."

  events:
    $acc.metadata.event_type = "USER_RESOURCE_ACCESS"
    $acc.principal.user.userid != ""
    (
      $acc.metadata.product_event_type = /(space|page|wiki|content|attachment).*(export|download|archive)|(export|download|archive).*(space|page|wiki|content|attachment)/ nocase or
      $acc.target.url = /\/(flyingpdf|exportword|export\/|download\/attachments|download\/temp|rest\/api\/space\/[^\/]+\/(export|archive))/ nocase
    )
    not $acc.principal.user.userid in %global_allowed_service_accounts
    not $acc.principal.user.userid in %global_allowed_admin_users
    not $acc.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1213.001")
    $primary_entity = array_distinct($acc.principal.user.userid)
    $source_ips = array_distinct($acc.principal.ip)
    $accessed_urls = array_distinct($acc.target.url)
    $audit_actions = array_distinct($acc.metadata.product_event_type)

  condition:
    $acc
}
