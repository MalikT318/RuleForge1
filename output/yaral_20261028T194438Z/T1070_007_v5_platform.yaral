/*
  MITRE Technique : T1070.007 - Clear Network Connection History and Configurations
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:10:00.047294+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_007_Network_Device_Log_History_Clearing {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects management-plane configuration or command-accounting events on a network or perimeter device showing log or history clearing, such as clearing the logging buffer, wiping audit or command history, removing remote syslog destinations, or disabling logging. Adversaries with device access use these actions to erase traces of their sessions and connection activity. This is the network-device counterpart to host-based command-line detections."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.007"
    mitre_technique_name = "Indicator Removal: Clear Network Connection History and Configurations"
    log_prerequisites = "Requires the firewall or perimeter device to forward management-plane audit or command-accounting logs (configuration changes and CLI commands) to Chronicle, normalised to SETTING_MODIFICATION with the command or change text in metadata.description. Flow and connection logs alone cannot show this behaviour."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Planned log rotation or buffer resets by network engineers, migration of syslog servers (old destination removed), device decommissioning or factory reset, troubleshooting sessions that clear the local log buffer, and automation that rotates logging configuration."
    tuning_guidance = "Add automation and orchestration identities to %global_allowed_service_accounts. If maintenance jumpboxes are well controlled, consider also excluding their addresses with %global_allowed_mgmt_sources. Review hits against change tickets, since legitimate syslog migrations will match the 'no logging host' pattern. Confirm the parser populates metadata.description with the command text; if it uses a different field for a client, tune the match accordingly."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.description = /\b(clear\s+(logging|log|logs|audit|history)|erase\s+(log|logs|history)|(delete|remove)\s+(log|logs|history)|no\s+logging\s+(host|server|buffered|on|trap|console|monitor|enable)|logging\s+(disable|off)|(terminal\s+)?history\s+size\s+0|no\s+history|history\s+clear)\b/ nocase
    $setting.principal.hostname != ""
    not $setting.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1070.007")
    $primary_entity = array_distinct($setting.principal.hostname)
    $actor = array_distinct($setting.principal.user.userid)
    $source_ip = array_distinct($setting.principal.ip)
    $change_detail = array_distinct($setting.metadata.description)

  condition:
    $setting
}
