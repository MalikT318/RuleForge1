/*
  MITRE Technique : T1601 - Modify System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:11:50.840986+00:00
  Reference       : https://attack.mitre.org/techniques/T1601
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_Mgmt_Session_Then_Device_Image_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a management-plane session (SSH or Telnet) into a network device from a source outside the approved management sources, followed within 10 minutes by that same device initiating an outbound TFTP or FTP connection. This pattern is consistent with an operator pulling a replacement or modified operating system image onto the device, which is a network-observable sign of system image modification."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1601"
    mitre_technique_name = "Modify System Image"
    log_prerequisites = "Requires firewall or perimeter connection logs that record both inbound management sessions to network devices and the devices' own outbound connections, normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Planned firmware upgrades by administrators connecting from jump hosts not yet in the management source list; automated configuration backup or restore jobs that use TFTP or FTP; zero-touch provisioning and device replacement or staging; vendor support sessions during maintenance windows."
    tuning_guidance = "Add approved jump hosts and management stations to %global_allowed_mgmt_sources. Schedule firmware upgrades and suppress during change windows. If the environment relies on internal TFTP/FTP servers for backup, consider adding a not-in-%rfc1918_internal condition on $xfer.target.ip to focus on external image sources, accepting reduced coverage of internal staging."

  events:
    $mgmt.metadata.event_type = "NETWORK_CONNECTION"
    ($mgmt.target.port = 22 or $mgmt.target.port = 23)
    not $mgmt.principal.ip in %global_allowed_mgmt_sources
    $mgmt.target.ip = $dev

    $xfer.metadata.event_type = "NETWORK_CONNECTION"
    ($xfer.target.port = 69 or $xfer.target.port = 21)
    $xfer.principal.ip = $dev

    $mgmt.metadata.event_timestamp.seconds <= $xfer.metadata.event_timestamp.seconds

  match:
    $dev over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1601")
    $primary_entity = array_distinct($dev)
    $mgmt_sources = array_distinct($mgmt.principal.ip)
    $transfer_servers = array_distinct($xfer.target.ip)
    $transfer_ports = array_distinct($xfer.target.port)
    $mgmt_session_count = count($mgmt.metadata.id)
    $transfer_count = count($xfer.metadata.id)

  condition:
    $mgmt and $xfer
}
