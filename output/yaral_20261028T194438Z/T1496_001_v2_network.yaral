/*
  MITRE Technique : T1496.001 - Compute Hijacking
  Tactic(s)       : Impact
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:52:03.161228+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_001_Network_Mining_Pool_Port_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound connections from internal hosts to external destinations on TCP ports commonly used by cryptocurrency mining pool (stratum) protocols. Observed at the network perimeter, so it works regardless of the process name or tool the attacker uses on the Windows endpoint."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.001"
    mitre_technique_name = "Resource Hijacking: Compute Hijacking"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with populated principal.ip and target.ip, target.port. Populate %rfc1918_internal with the tenant's internal address space."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate use of the same ports by other services: remote debugging or development tooling, game servers, Android Debug Bridge, custom internal applications published externally, and authorised penetration tests or red-team activity. Sanctioned mining or blockchain research hosts will also match."
    tuning_guidance = "Add authorised scanner or test hosts to %global_allowed_scanners (matched on principal.hostname). Add approved source addresses to %global_allowed_mgmt_sources. Confirm %rfc1918_internal covers all internal ranges. Prune the port list for tenants where a listed port carries legitimate business traffic, or raise severity when combined with endpoint CPU or miner process alerts."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 3333 or
      $net.target.port = 4444 or
      $net.target.port = 5555 or
      $net.target.port = 7777 or
      $net.target.port = 14433 or
      $net.target.port = 14444 or
      $net.target.port = 45560 or
      $net.target.port = 45700
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_scanners
    not $net.principal.hostname in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1496.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_hostnames = array_distinct($net.principal.hostname)

  condition:
    $net
}
