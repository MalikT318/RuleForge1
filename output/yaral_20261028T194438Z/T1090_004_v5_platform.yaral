/*
  MITRE Technique : T1090.004 - Domain Fronting
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:33:18.133045+00:00
  Reference       : https://attack.mitre.org/techniques/T1090/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1090_004_Linux_SNI_Host_Mismatch_Suspicious_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux process making an outbound HTTP(S) request where the TLS SNI differs from the HTTP Host (target hostname), the defining signature of domain fronting. Limited to processes running from world-writable staging directories (/tmp, /var/tmp, /dev/shm) or common scripting and transfer utilities, which cuts the browser connection-coalescing noise. This is network-telemetry coverage, not a process command-line rule."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1090.004"
    mitre_technique_name = "Proxy: Domain Fronting"
    log_prerequisites = "Requires Linux host or egress-proxy telemetry normalised to NETWORK_HTTP with network.tls.client.server_name (SNI), target.hostname (HTTP Host) and principal.process.file.full_path populated. HTTPS Host visibility needs TLS inspection or an SSL-library-aware sensor. Without this, the rule will not fire."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate CDN or multi-tenant services where SNI and Host differ by design (API gateways, cloud storage endpoints), package managers or update agents using mirror redirection, HTTP/2 connection coalescing in scripted clients, and internal service meshes."
    tuning_guidance = "Add known-good CDN and vendor domains to %global_allowed_domains and approved tooling binaries to %global_allowed_admin_tools. Add automation hosts to %global_allowed_script_hosts or service identities to %global_allowed_service_accounts if they are noisy. Review $sni_value against $host_header_value in the outcome to confirm unrelated registrable domains."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.tls.client.server_name != ""
    $net.target.hostname != ""
    $net.network.tls.client.server_name != $net.target.hostname
    $net.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/|\/(curl|wget|python[0-9.]*|perl|ruby|socat|ncat|nc|bash|sh)$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.network.tls.client.server_name in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1090.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $sni_value = array_distinct($net.network.tls.client.server_name)
    $host_header_value = array_distinct($net.target.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
