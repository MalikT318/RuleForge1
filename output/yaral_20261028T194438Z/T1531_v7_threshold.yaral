/*
  MITRE Technique : T1531 - Account Access Removal
  Tactic(s)       : Impact
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:31:50.787178+00:00
  Reference       : https://attack.mitre.org/techniques/T1531
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1531_IaaS_Mass_Account_Access_Removal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single actor performs many access-removal operations (revoke, remove, disable, delete, detach, suspend or lock) against different accounts in a cloud tenant within 10 minutes. One removal is routine administration. A burst across many accounts is consistent with an adversary or ransomware operator locking legitimate users out to impair recovery."
    mitre_tactic = "Impact"
    mitre_technique = "T1531"
    mitre_technique_name = "Account Access Removal"
    log_prerequisites = "Requires cloud identity and directory audit logs (IAM, role, permission and group-membership changes) ingested and normalised to UDM USER_CHANGE_PERMISSIONS, with metadata.product_event_type, principal.user.userid and target.user.userid populated."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Bulk offboarding by HR or IAM governance workflows, scheduled access reviews and recertification campaigns, identity lifecycle automation, role clean-up projects, tenant migrations, and break-glass drills."
    tuning_guidance = "Add expected automation and lifecycle accounts to %global_allowed_service_accounts, approved cloud principals to %global_allowed_cloud_principals, and named administrators who run bulk offboarding to %global_allowed_admin_users. Raise or lower the #perm threshold per client based on normal offboarding volume. Review the product_event_type regex against the event names the client's audit logs actually emit."

  events:
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.metadata.product_event_type = /(remove|revoke|delete|detach|disable|deactivate|suspend|lock)/ nocase
    $perm.principal.user.userid != ""
    $perm.target.user.userid != ""
    $perm.principal.user.userid != $perm.target.user.userid
    $perm.principal.user.userid = $actor
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_admin_users
    not $perm.principal.user.userid in %global_allowed_cloud_principals

  match:
    $actor over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1531")
    $primary_entity = array_distinct($actor)
    $removal_count = count($perm.metadata.id)
    $affected_accounts = array_distinct($perm.target.user.userid)
    $operations = array_distinct($perm.metadata.product_event_type)
    $source_ips = array_distinct($perm.principal.ip)

  condition:
    #perm >= 10
}
