/*
  MITRE Technique : T1550.001 - Application Access Token
  Tactic(s)       : Lateral Movement
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:37:49.926379+00:00
  Reference       : https://attack.mitre.org/techniques/T1550/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1550_001_Cloud_Token_Auth_Burst_Per_User {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single identity produces a burst of token-based authentication events (OAuth, refresh, bearer or access-token grants) within ten minutes. A stolen application access token replayed to reach cloud resources shows up as repeated token authentications, often from several source addresses, without interactive credential entry. One token grant is routine; a high volume for one user is not."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1550.001"
    mitre_technique_name = "Use Alternate Authentication Material: Application Access Token"
    log_prerequisites = "Requires identity provider or cloud IAM sign-in and token-grant audit logs normalised to USER_LOGIN, with principal.user.userid populated and the authentication or grant type described in metadata.description."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Automation and CI/CD pipelines that refresh tokens frequently, monitoring and SaaS integrations polling with refresh tokens, mobile and desktop clients that renew tokens in the background, and users on flaky networks that trigger repeated silent token renewals."
    tuning_guidance = "Add known automation identities to %global_allowed_service_accounts and approved service principals to %global_allowed_cloud_principals. Raise or lower the #auth threshold per client baseline. Review the source_ips and target_apps outcome fields to separate legitimate refresh churn from token replay across multiple addresses."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.metadata.description = /(oauth|access[_ -]?token|refresh[_ -]?token|bearer|token[_ -]?(grant|exchange|issued|auth))/ nocase
    $auth.principal.user.userid = $user
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_cloud_principals
    not $auth.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($auth.metadata.id)
    $mitre_technique_id = array_distinct("T1550.001")
    $primary_entity = array_distinct($user)
    $source_ips = array_distinct($auth.principal.ip)
    $target_apps = array_distinct($auth.target.application)

  condition:
    #auth >= 10
}
