/*
  MITRE Technique : T1016 - System Network Configuration Discovery
  Tactic(s)       : Discovery
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:43:45.243713+00:00
  Reference       : https://attack.mitre.org/techniques/T1016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_External_Mgmt_Protocol_Config_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects connections from a non-internal, non-approved source to network-device management ports that expose configuration, interface and routing data: SNMP (161) and the legacy switch configuration-director protocol (TCP 4786). These protocols are used to retrieve interface addresses, routing tables and running configuration, which is network-side System Network Configuration Discovery of network devices. Because the rule reads perimeter logs, it fires whether the connection was allowed or blocked."
    mitre_tactic = "Discovery"
    mitre_technique = "T1016"
    mitre_technique_name = "System Network Configuration Discovery"
    log_prerequisites = "Firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip and target.port populated. Logging must include inbound traffic to management and device address space, including denied traffic if possible."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Managed-service or ISP monitoring platforms polling SNMP over public addresses, third-party network monitoring SaaS, authorised external vulnerability scans, and a partner or carrier NMS that polls customer-edge devices."
    tuning_guidance = "Add approved monitoring and NMS source addresses to %global_allowed_mgmt_sources and authorised scanner sources to %global_allowed_scanners. Populate %rfc1918_internal with the client's internal address space so internal polling is excluded. If the client uses these ports internally, keep this rule scoped to perimeter firewall logs only."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 161 or $net.target.port = 4786)
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1016")
    $primary_entity = array_distinct($net.principal.ip)
    $targeted_devices = array_distinct($net.target.ip)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    $net
}
