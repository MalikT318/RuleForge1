/*
  MITRE Technique : T1685.005 - Clear Windows Event Logs
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:23:03.341157+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_005_EVTX_Log_File_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects deletion of Windows Event Log (.evtx) files from the winevt\\Logs directory. Adversaries delete the stored log files directly to destroy evidence and avoid the wevtutil, PowerShell and Event Viewer clearing methods. This rule fires on the resulting file-deletion artifact rather than on command lines, so it still catches renamed utilities, custom tooling and API-based deletion."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.005"
    mitre_technique_name = "Clear Windows Event Logs"
    log_prerequisites = "Requires endpoint file-deletion telemetry (EDR or Sysmon Event ID 23/26 equivalent) with the winevt\\Logs directory in monitoring scope and populated principal process paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Log-management or archival scripts that purge old archived .evtx files, imaging and sysprep/golden-image preparation, backup or forensic collection tooling that moves or removes logs, and administrators clearing logs during rebuilds or troubleshooting."
    tuning_guidance = "Add approved log-maintenance and imaging tooling to %global_allowed_admin_tools, backup agents to %global_allowed_backup_processes, EDR/AV agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. If archived-log cleanup is noisy, restrict the filename pattern to the Security, System and Application logs only. Review any exclusion of the EventLog service host (svchost) carefully before adding it."

  events:
    $file.metadata.event_type = "FILE_DELETION"
    $file.target.file.full_path = /\\windows\\system32\\winevt\\logs\\[^\\]+\.evtx$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $deleted_log_file = array_distinct($file.target.file.full_path)
    $deleting_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
