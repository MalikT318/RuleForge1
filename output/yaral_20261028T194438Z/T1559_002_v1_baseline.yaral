/*
  MITRE Technique : T1559.002 - Dynamic Data Exchange
  Tactic(s)       : Execution
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:53:43.722199+00:00
  Reference       : https://attack.mitre.org/techniques/T1559/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_002_Office_DDE_Spawns_Shell_Or_LOLBin {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Microsoft Office application (Word, Excel, Outlook, Access, Publisher, PowerPoint, OneNote) spawning a command interpreter or script-capable LOLBin. This is the main execution artifact of Dynamic Data Exchange abuse, such as DDEAUTO fields in documents, Excel DDE formulas, and CSV injection. The DDE command runs as a direct child of the Office process and does not need macros."
    mitre_tactic = "Execution"
    mitre_technique = "T1559.002"
    mitre_technique_name = "Inter-Process Communication: Dynamic Data Exchange"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with parent process path and child command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office add-ins or legacy line-of-business macros and templates that shell out to cmd or PowerShell; ERP or reporting integrations driven from Excel or Access; IT-authored document automation; software installers launched through msiexec from Office; Office-hosted help or update workflows."
    tuning_guidance = "Add approved parent Office hosts or automation to %global_allowed_script_hosts. Add approved child tooling to %global_allowed_admin_tools. If a known add-in is noisy, exclude it by parent or child executable name, not by install directory. For higher fidelity, raise severity when the child command line contains download or encoded-command patterns."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|onenote|visio)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|mshta|wscript|cscript|regsvr32|rundll32|certutil|bitsadmin|msiexec|forfiles|pcalua)\.exe$/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1559.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
