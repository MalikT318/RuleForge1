/*
  MITRE Technique : T1573.002 - Asymmetric Cryptography
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:25:06.732465+00:00
  Reference       : https://attack.mitre.org/techniques/T1573/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1573_002_TLS_No_SNI_NonStandard_Port_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a TLS/SSL session observed by a network security appliance to an external destination on a non-standard port with no Server Name Indication. Public-key-negotiated encrypted sessions without SNI on uncommon ports are characteristic of custom C2 channels that use asymmetric cryptography for key exchange rather than a normal web service."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1573.002"
    mitre_technique_name = "Encrypted Channel: Asymmetric Cryptography"
    log_prerequisites = "IPS or network security appliance with TLS inspection or metadata logging that populates network.tls.version and network.tls.client.server_name, normalised to NETWORK_CONNECTION."
    platform = "Network Devices"
    log_source = "ips"
    false_positives = "Legitimate non-HTTPS TLS services on custom ports (database replication, MQTT/IoT brokers, VPN or SD-WAN tunnels, mail relays on custom ports), TLS clients that do not send SNI (embedded devices, legacy applications, direct-to-IP API clients), and vulnerability scanners."
    tuning_guidance = "Add sanctioned scanner or management source addresses to %global_allowed_scanners and %global_allowed_mgmt_sources. Extend the standard-port list in the rule for services known to be in use at the client. Use %global_allowed_domains for SNI-based exclusions if the rule is later relaxed to include SNI. Raise severity for hosts that also trigger beaconing or threat-intel detections."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.tls.version != ""
    $net.network.tls.client.server_name = ""
    $net.target.port > 0
    $net.target.port != 443
    $net.target.port != 8443
    $net.target.port != 993
    $net.target.port != 995
    $net.target.port != 465
    $net.target.port != 587
    $net.target.port != 636
    $net.target.port != 853
    $net.target.port != 989
    $net.target.port != 990
    $net.target.port != 5061
    $net.target.port != 8883
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1573.002")
    $primary_entity = array_distinct(strings.coalesce($net.principal.hostname, $net.principal.ip))
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
