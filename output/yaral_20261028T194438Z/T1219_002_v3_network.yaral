/*
  MITRE Technique : T1219.002 - Remote Desktop Software
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:08:25.826770+00:00
  Reference       : https://attack.mitre.org/techniques/T1219/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1219_002_Linux_Outbound_Remote_Desktop_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound connections from an internal host to external addresses on ports used by remote desktop and remote support protocols (VNC, TeamViewer, AnyDesk, RDP). Observed from the network perimeter, this suggests remote desktop software is being used as an interactive C2 channel from a Linux system. Complements endpoint command-line detections by catching renamed or portable binaries."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1219.002"
    mitre_technique_name = "Remote Access Software: Remote Desktop Software"
    log_prerequisites = "Firewall, proxy or perimeter NETWORK_CONNECTION logs with populated principal.ip, target.ip and target.port. Source IP must be attributable to Linux server or workstation subnets; scope the rule to those subnets in the SIEM or with %global_allowed_mgmt_sources."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Approved IT support and RMM sessions, administrators using VNC or RDP to external or cloud-hosted systems, vendor remote support sessions, and cloud-hosted lab or jump hosts reached over VNC or RDP."
    tuning_guidance = "Add approved support-workstation and jump-host source addresses to %global_allowed_mgmt_sources. Confirm %rfc1918_internal covers every internal range for the tenant. Restrict the rule to Linux server subnets if the firewall log cannot identify the operating system. Raise severity for server subnets that should never initiate outbound remote desktop traffic."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      ($net.target.port >= 5900 and $net.target.port <= 5910) or
      $net.target.port = 5500 or
      $net.target.port = 5938 or
      $net.target.port = 6568 or
      $net.target.port = 7070 or
      $net.target.port = 3389
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1219.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
