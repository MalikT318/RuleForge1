/*
  MITRE Technique : T1027.004 - Compile After Delivery
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:43:53.409549+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_004_Linux_Source_Code_Download_Via_CLI_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external HTTP request from a non-browser command-line or scripting HTTP client for a raw source-code file (C/C++, Go, Rust, Java, C#, assembly and similar). Payloads delivered as uncompiled code are later built on the host with a native compiler. This rule observes the delivery on the network side, independent of endpoint process telemetry."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.004"
    mitre_technique_name = "Obfuscated Files or Information: Compile After Delivery"
    log_prerequisites = "Requires proxy or firewall logs with URL inspection (HTTP or TLS-decrypted) that populate network.http.user_agent and target.url. Plain connection-only firewall logs will not populate these fields."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Developers and CI/build servers fetching source or dependencies with curl or wget; package or source mirrors; DevOps automation pulling Go or Rust sources; vendor driver or module builds (DKMS) that download source files."
    tuning_guidance = "Add build servers and developer jump hosts to %global_allowed_script_hosts. Add trusted source mirrors and vendor repositories to %global_allowed_domains. Extend the extension list or user-agent list per client toolchain. Consider raising severity when the source host is a recently seen or rare destination."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /(?i)^(curl|wget|python-requests|python-urllib|libwww-perl|go-http-client|lwp-trivial|aiohttp|fetch)\b/
    $net.target.url = /(?i)\.(c|cc|cpp|cxx|go|rs|java|cs|asm|nim|zig|swift)(\?[^\/]*)?$/
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1027.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
