/*
  MITRE Technique : T1669 - Wi-Fi Networks
  Tactic(s)       : Initial Access
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : IDS / IPS / network security appliance
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:13:47.407034+00:00
  Reference       : https://attack.mitre.org/techniques/T1669
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1669_Windows_Wlan_Profile_Connect_Then_IPS_Alert {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A Windows host uses netsh to add a Wi-Fi profile or connect to a wireless network, then within ten minutes the same host triggers an IPS/network-security signature on an internal connection. This pattern is consistent with a device joining a new wireless network and immediately generating hostile or anomalous internal traffic, such as scanning or exploitation."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1669"
    mitre_technique_name = "Wi-Fi Networks"
    log_prerequisites = "Requires EDR process telemetry or Windows Event 4688 with command line auditing, plus IPS/network security appliance events normalised to UDM with principal.hostname populated (asset or DHCP enrichment) and security_result.rule_name populated."
    platform = "Windows"
    log_source = "ips"
    false_positives = "Laptops of mobile users or IT staff joining a corporate or guest SSID while an IPS signature fires on normal traffic. Provisioning scripts that push Wi-Fi profiles during device imaging. Authorised vulnerability scanning or penetration tests run from a Windows host."
    tuning_guidance = "Add approved provisioning and RMM parent processes to %global_allowed_admin_tools. Add scanner and pen-test hosts to %global_allowed_scanners. If the IPS does not populate principal.hostname, enrich the events with asset data or change the join key to principal.ip. Consider limiting to high-severity signatures if volume is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\netsh\.exe$/ nocase
    $proc.target.process.command_line = /\bwlan\s+(connect|add\s+profile)\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.security_result.rule_name != ""
    $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_scanners
    $net.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1669")
    $primary_entity = array_distinct($hostname)
    $wlan_commands = array_distinct($proc.target.process.command_line)
    $ips_signatures = array_distinct($net.security_result.rule_name)
    $internal_targets = array_distinct($net.target.ip)
    $ips_event_count = count($net.metadata.id)

  condition:
    $proc and $net
}
