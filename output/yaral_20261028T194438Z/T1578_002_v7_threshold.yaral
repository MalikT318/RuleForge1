/*
  MITRE Technique : T1578.002 - Create Cloud Instance
  Tactic(s)       : Defense Impairment
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:52:39.602776+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_002_Burst_Cloud_Instance_Creation_By_Single_Identity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single cloud identity created five or more compute instances or VMs within 10 minutes. Each creation is routine on its own, but a burst from one principal can indicate an adversary building new instances to bypass existing firewall rules and permissions, for example to mount stolen snapshots, stage data, or run mining or attack tooling. Risk is scaled in outcome by volume."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578.002"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Create Cloud Instance"
    log_prerequisites = "Cloud control-plane audit logs with management or write events enabled, ingested and normalised to UDM RESOURCE_CREATION with metadata.product_event_type and principal.user.userid populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Auto-scaling groups and managed instance groups scaling out, infrastructure-as-code pipelines (Terraform, CloudFormation, Bicep, Deployment Manager) deploying fleets, CI/CD runners provisioning build agents, batch or HPC and data-processing clusters, and legitimate DR or migration exercises."
    tuning_guidance = "Add automation, pipeline and scaling identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named platform engineers to %global_allowed_admin_users. Raise the #cloud threshold for tenants with large routine fleet deployments. Lower it for tenants with a small, static footprint."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /(RunInstances|instances\.(insert|bulkInsert)|virtualMachines\/write|virtualMachineScaleSets\/write|CreateInstance|CreateVirtualMachine)/ nocase
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $event_count = count($cloud.metadata.id)
    $risk_score = max(if($event_count >= 15, 85, 60))
    $mitre_technique_id = array_distinct("T1578.002")
    $primary_entity = array_distinct($user)
    $source_ips = array_distinct($cloud.principal.ip)
    $created_resources = array_distinct($cloud.target.resource.name)
    $api_calls = array_distinct($cloud.metadata.product_event_type)

  condition:
    #cloud >= 5
}
