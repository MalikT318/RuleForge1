/*
  MITRE Technique : T1684 - Social Engineering
  Tactic(s)       : Stealth
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:29:56.938090+00:00
  Reference       : https://attack.mitre.org/techniques/T1684
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1684_Linux_Proxy_CLI_Downloader_Script_Fetch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side observation of a socially engineered 'copy and paste this command' lure (e.g. fake fix or install instructions) on Linux. A command-line downloader user agent (curl or wget) fetches a shell or scripting-language file from an external destination through a proxy or firewall with HTTP inspection. Endpoint process data is not used, because perimeter logs do not carry it."
    mitre_tactic = "Stealth"
    mitre_technique = "T1684"
    mitre_technique_name = "Social Engineering"
    log_prerequisites = "Requires proxy or firewall logs with HTTP inspection that populate network.http.user_agent and target.url, normalised to NETWORK_HTTP. Plain NETWORK_CONNECTION or NETWORK_FLOW logs without URL or user-agent data cannot support this rule."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate package installers and bootstrap scripts (e.g. vendor install one-liners), configuration management and CI/CD agents, developers pulling setup scripts, and monitoring agents that self-update via script."
    tuning_guidance = "Add trusted vendor and repository domains to %global_allowed_domains. Add build servers, jump hosts and automation hosts to %global_allowed_script_hosts. Raise severity when the destination is rare in the environment or the URL host is a bare IP. Check the matched host's endpoint telemetry to confirm what the user ran."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.user_agent = /^(curl|wget)\// nocase
    $http.target.url = /\.(sh|bash|py|pl)(\?.*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1684")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_urls = array_distinct($http.target.url)

  condition:
    $http
}
