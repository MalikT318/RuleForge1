/*
  MITRE Technique : T1098.004 - SSH Authorized Keys
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:45:29.977850+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_004_Cloud_Login_Then_SSH_Key_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A principal signs in from an external address and, within 10 minutes, registers, uploads or pushes an SSH public key, or changes instance or project metadata, through the cloud control plane. Adversaries use this pattern to add their own SSH keys to cloud VMs or IAM users for persistence without touching a process or command line on the host."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.004"
    mitre_technique_name = "Account Manipulation: SSH Authorized Keys"
    log_prerequisites = "Requires identity sign-in events normalised to USER_LOGIN. Requires cloud control-plane audit events for SSH key and instance metadata APIs, normalised to USER_CHANGE_PERMISSIONS with metadata.product_event_type populated. Both feeds must carry the same principal.user.userid."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Administrators or DevOps engineers who sign in and then rotate their own SSH keys. Break-glass access. Infrastructure automation run under a human identity. Onboarding of new engineers. Routine instance metadata updates unrelated to SSH keys, because setMetadata calls do not always carry SSH key content."
    tuning_guidance = "Add automation and pipeline identities to %global_allowed_service_accounts. Add sanctioned cloud principals to %global_allowed_cloud_principals. Add named administrators to %global_allowed_admin_users. If instance metadata updates are noisy, remove the setMetadata and setCommonInstanceMetadata alternatives from the product_event_type regex. Consider raising severity when the sign-in has no MFA or comes from a new geography."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid = $user
    $auth.principal.user.userid != ""
    not $auth.principal.ip in %rfc1918_internal
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users

    $key.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $key.metadata.product_event_type = /(?i)(UploadSSHPublicKey|UpdateSSHPublicKey|SendSSHPublicKey|ImportSshPublicKey|ImportKeyPair|compute\.instances\.setMetadata|compute\.projects\.setCommonInstanceMetadata|SetCommonInstanceMetadata)/
    $key.principal.user.userid = $user
    not $key.principal.user.userid in %global_allowed_service_accounts
    not $key.principal.user.userid in %global_allowed_cloud_principals

    $auth.metadata.event_timestamp.seconds <= $key.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1098.004")
    $primary_entity = array_distinct($user)
    $login_source_ips = array_distinct($auth.principal.ip)
    $key_api_calls = array_distinct($key.metadata.product_event_type)
    $key_target_resources = array_distinct($key.target.resource.name)
    $key_event_count = count($key.metadata.id)

  condition:
    $auth and $key
}
