/*
  MITRE Technique : T1205.002 - Socket Filters
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:12:49.798983+00:00
  Reference       : https://attack.mitre.org/techniques/T1205/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_002_Inbound_External_To_Unusual_High_Port {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side indicator of a socket-filter (WinPcap/libpcap style) passive backdoor on a Windows host. An external source sends a TCP connection to an internal host on a non-standard high port, which is typical of a crafted trigger packet to a port with no legitimate listener. Excludes internal source space and approved scanners and management sources via reference lists."
    mitre_tactic = "Stealth, Persistence, Command and Control"
    mitre_technique = "T1205.002"
    mitre_technique_name = "Traffic Signaling: Socket Filters"
    log_prerequisites = "Firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip, and target.port populated, and with the firewall positioned to log inbound traffic from external sources to internal hosts. Pair with endpoint telemetry for packet-capture driver installation."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Inbound NAT or port-forwarded application services on non-standard ports, VoIP and video conferencing media ports, game or peer-to-peer software, VPN or remote-access gateways on custom ports, return traffic logged as a new connection, and external vulnerability scans from unlisted sources."
    tuning_guidance = "Add approved external scanners to %global_allowed_scanners and approved management or partner source addresses to %global_allowed_mgmt_sources. Add further sanctioned service ports as extra 'not $net.target.port = N' lines. Raise the port floor if the environment publishes many high-port services. Consider alerting only on hosts that have no published services."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "TCP"
    $net.target.port >= 1024
    not $net.target.port = 3389
    not $net.target.port = 8080
    not $net.target.port = 8443
    not $net.target.port = 5985
    not $net.target.port = 5986
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1205.002")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)
    $target_hosts = array_distinct($net.target.hostname)

  condition:
    $net
}
