/*
  MITRE Technique : T1027.016 - Junk Code Insertion
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:04:01.194295+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_016_Oversized_Script_Dropped_Then_Executed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects an abnormally large script file (over 1 MB) written to a user-writable location, followed within five minutes by a Windows script host or PowerShell launch on the same host that references a script file. Scripts padded with junk or dead code are typically far larger than hand-written or legitimate admin scripts. The size attribute on the file-creation event is the primary signal, which keeps this rule distinct from command-line-only detections."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.016"
    mitre_technique_name = "Obfuscated Files or Information: Junk Code Insertion"
    log_prerequisites = "Requires EDR or Sysmon-equivalent FILE_CREATION telemetry with target.file.size populated, plus PROCESS_LAUNCH telemetry with command lines. If the sensor does not populate file size, this rule will not fire."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers or build pipelines that stage large bundled or minified JavaScript, PowerShell modules or data-embedded scripts in temp folders, developer workstations, and RMM or deployment tooling that unpacks large scripts."
    tuning_guidance = "Add the writing process to %global_allowed_admin_tools or the launching parent to %global_allowed_script_hosts. Raise or lower the size threshold per client baseline. Exclude developer hosts through the allowlists."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop)|windows\\temp|programdata|temp)\\.*\.(js|jse|vbs|vbe|wsf|hta|ps1)$/ nocase
    $file.target.file.size > 1000000
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(wscript|cscript|mshta|powershell|pwsh)\.exe$/ nocase
    $proc.target.process.command_line = /\.(js|jse|vbs|vbe|wsf|hta|ps1)\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1027.016")
    $primary_entity = array_distinct($hostname)
    $dropped_script_paths = array_distinct($file.target.file.full_path)
    $max_script_size_bytes = max($file.target.file.size)
    $dropper_processes = array_distinct($file.principal.process.file.full_path)
    $script_host_command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $file and $proc
}
