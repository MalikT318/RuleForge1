/*
  MITRE Technique : T1563.001 - SSH Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:08:08.626935+00:00
  Reference       : https://attack.mitre.org/techniques/T1563/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_001_Internal_SSH_Lateral_Session_Firewall {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects internal-to-internal SSH (TCP/22) connections observed at the network perimeter or inter-zone firewall that originate from a host not in the approved management-source list. Hijacking an SSH agent socket or session lets an adversary pivot to trusted peers over key-based trust, so the network-visible result is an unexpected host-to-host SSH connection. Firewall telemetry cannot see the agent socket or process, so this is a network-level lateral-movement signal and needs analyst follow-up on the source host."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1563.001"
    mitre_technique_name = "Remote Service Session Hijacking: SSH Hijacking"
    log_prerequisites = "Requires firewall or network perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated, covering east-west (inter-zone or inter-VLAN) traffic."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Administrators and jump hosts not yet in the management-source list, configuration management and orchestration servers, backup and file-transfer jobs over SFTP/rsync, CI/CD runners deploying over SSH, Git over SSH, and vulnerability scanners."
    tuning_guidance = "Add jump hosts, bastions and automation servers to %global_allowed_mgmt_sources. Add authorised scanners to %global_allowed_scanners. Scope the rule to inter-zone firewall logs where possible to reduce volume. Alert on a source host reaching many distinct SSH targets through a separate threshold rule."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 22
    $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1563.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
