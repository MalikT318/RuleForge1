/*
  MITRE Technique : T1021.001 - Remote Desktop Protocol
  Tactic(s)       : Lateral Movement
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:34:39.287225+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_001_RDP_Enabled_Then_Remote_Interactive_Logon {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the registry setting that permits inbound Remote Desktop connections being changed to enabled on a host, followed within ten minutes by a remote interactive (RDP) logon to the same host. This pattern suggests an adversary exposing RDP and then using valid accounts to log in for lateral movement. It relies on registry and authentication telemetry, not process command lines."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.001"
    mitre_technique_name = "Remote Services: Remote Desktop Protocol"
    log_prerequisites = "Requires endpoint registry modification telemetry (EDR or Sysmon Event ID 13) including registry value data, and Windows Security logon events (4624 logon type 10) normalised to USER_LOGIN with extensions.auth.mechanism = REMOTE_INTERACTIVE."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators legitimately enabling RDP on new builds or servers and then logging in; GPO or DSC-driven RDP enablement during provisioning; helpdesk or RMM tooling enabling RDP for remote support; golden-image deployment pipelines."
    tuning_guidance = "Add approved deployment or RMM binaries to %global_allowed_admin_tools, which excludes the registry writer. Add named administrators to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts, which excludes the logon account. If registry value data is not populated in your EDR, remove the registry_value_data condition and expect more noise."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\CurrentControlSet\\Control\\Terminal Server$/ nocase
    $reg.target.registry.registry_value_name = /^fDenyTSConnections$/ nocase
    $reg.target.registry.registry_value_data = /^(0|0x0+|DWORD \(0x0+\))$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    $reg.principal.hostname = $hostname

    $login.metadata.event_type = "USER_LOGIN"
    $login.extensions.auth.mechanism = "REMOTE_INTERACTIVE"
    not $login.target.user.userid in %global_allowed_admin_users
    not $login.target.user.userid in %global_allowed_service_accounts
    $login.target.hostname = $hostname

    $reg.metadata.event_timestamp.seconds <= $login.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1021.001")
    $primary_entity = array_distinct($hostname)
    $logon_users = array_distinct($login.target.user.userid)
    $source_ips = array_distinct($login.principal.ip)
    $registry_writers = array_distinct($reg.principal.process.file.full_path)
    $login_count = count($login.metadata.id)

  condition:
    $reg and $login
}
