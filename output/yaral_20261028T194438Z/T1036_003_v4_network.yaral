/*
  MITRE Technique : T1036.003 - Rename Legitimate Utilities
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:01:11.391399+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_003_Renamed_Utility_Network_UserAgent_Mismatch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects outbound HTTP(S) requests carrying the built-in network user-agent of a Windows utility (certutil URL agent, Windows PowerShell WinHTTP/.NET user-agent) where the originating process image is NOT that utility. The user-agent is emitted by the OS component regardless of filename, so a renamed or relocated copy of certutil or powershell making external requests is exposed from the network side without relying on process-creation command lines."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.003"
    mitre_technique_name = "Masquerading: Rename Legitimate Utilities"
    log_prerequisites = "Requires NETWORK_HTTP telemetry with network.http.user_agent and principal.process.file.full_path populated (EDR network sensor, Sysmon-equivalent with HTTP enrichment, or a TLS-inspecting proxy that attributes the originating process). Events without a process path are ignored."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Custom or third-party applications that embed the PowerShell engine (System.Management.Automation hosts, RMM agents, deployment and monitoring tools), PowerShell-based management consoles, and legitimate software that shells out to a bundled copy of certutil or PowerShell under a different name."
    tuning_guidance = "Add legitimate embedded-PowerShell hosts and RMM agent binaries to %global_allowed_admin_tools, approved script-hosting parents to %global_allowed_script_hosts, and known-good vendor or update destinations to %global_allowed_domains. If a specific customer runs a PowerShell-hosting application, add its executable path to %global_allowed_admin_tools rather than loosening the user-agent regex."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /(CertUtil URL Agent|WindowsPowerShell\/\d|\bPowerShell\/\d+\.\d+)/ nocase
    $net.principal.process.file.full_path = /\\[^\\]+\.exe$/ nocase
    not $net.principal.process.file.full_path = /\\(certutil|powershell|powershell_ise|pwsh)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_script_hosts
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1036.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $user_agent = array_distinct($net.network.http.user_agent)
    $destination_ips = array_distinct($net.target.ip)
    $destination_host = array_distinct($net.target.hostname)

  condition:
    $net
}
