/*
  MITRE Technique : T1564.007 - VBA Stomping
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:24:22.079159+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_007_Office_Macro_Trust_Then_Payload_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the behavioural outcome of a VBA-stomped document. An Office application writes a Trusted Documents TrustRecords registry value (the user clicked Enable Content), then the same host's Office process drops an executable, library or script file within 10 minutes. Stomped documents hide their VBA source, so this rule keys on the execution result (registry trust grant plus payload drop) rather than macro source inspection or command lines."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.007"
    mitre_technique_name = "Hide Artifacts: VBA Stomping"
    log_prerequisites = "Requires EDR or Sysmon registry modification telemetry (Sysmon EID 13) and file creation telemetry (Sysmon EID 11) with populated principal process paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate macro-enabled workbooks or documents that export or generate scripts, DLL add-ins or installers; Office add-in updaters; VSTO deployments; finance or engineering macro templates that write helper files."
    tuning_guidance = "Add approved deployment or add-in tooling to %global_allowed_admin_tools. Add known-good hosts and parent processes that run approved macros to %global_allowed_script_hosts. Narrow the dropped-file extension list per client if a business macro legitimately writes .bat or .vbs files."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.principal.process.file.full_path = /\\(winword|excel|powerpnt)\.exe$/ nocase
    $reg.target.registry.registry_key = /\\Office\\[0-9.]+\\(Word|Excel|PowerPoint)\\Security\\Trusted Documents\\TrustRecords/ nocase
    $reg.principal.hostname = $hostname

    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(winword|excel|powerpnt)\.exe$/ nocase
    $file.target.file.full_path = /\.(exe|dll|scr|js|jse|vbs|vbe|hta|ps1|bat|cmd|wsf)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.hostname in %global_allowed_script_hosts
    $file.principal.hostname = $hostname

    $reg.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1564.007")
    $primary_entity = array_distinct($hostname)
    $trust_record_keys = array_distinct($reg.target.registry.registry_key)
    $dropped_files = array_distinct($file.target.file.full_path)
    $office_processes = array_distinct($file.principal.process.file.full_path)
    $affected_users = array_distinct($file.principal.user.userid)
    $dropped_file_count = count($file.metadata.id)

  condition:
    $reg and $file
}
