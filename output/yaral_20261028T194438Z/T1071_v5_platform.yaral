/*
  MITRE Technique : T1071 - Application Layer Protocol
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:03:24.551876+00:00
  Reference       : https://attack.mitre.org/techniques/T1071
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_Linux_CLI_HTTP_Client_To_Raw_IP_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP(S) requests, as seen at a proxy or perimeter, from Linux-native command-line HTTP clients (curl, wget, python, perl, Go) to an external destination addressed by a raw IP literal rather than a domain name. Linux implants, cron or systemd-launched beacons and reverse-shell stagers commonly use these clients to blend into web traffic (T1071.001). Legitimate automation normally targets named hosts. This is network-side coverage and is additive to endpoint command-line rules."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071"
    mitre_technique_name = "Application Layer Protocol"
    log_prerequisites = "Proxy or perimeter firewall logs with HTTP inspection that populate network.http.user_agent and target.url. Internal-address exclusion relies on %rfc1918_internal."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Vendor appliance or agent health checks that call IP-addressed endpoints, cloud metadata or monitoring probes through the proxy, internal tooling talking to IP-addressed external partners, and admins running curl or wget against known IP-only hosts."
    tuning_guidance = "Add approved automation or jump hosts to %global_allowed_script_hosts (by hostname) and approved scanners or monitoring sources to %global_allowed_scanners (by source IP). The user-agent can be spoofed, so pair this rule with endpoint and DNS coverage. Raise severity for server subnets that should have no direct outbound web access."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /^(curl|wget|python-requests|python-urllib|libwww-perl|go-http-client|lwp-trivial)(\/|\s|$)/ nocase
    $net.target.url = /^(https?:\/\/)?\d{1,3}(\.\d{1,3}){3}(:\d+)?(\/|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1071")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
