/*
  MITRE Technique : T1614 - System Location Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:38:13.128462+00:00
  Reference       : https://attack.mitre.org/techniques/T1614
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1614_Cloud_Location_Discovery_Then_Resource_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A single cloud identity runs region, availability-zone or location enumeration API calls and then creates compute or serverless resources within 10 minutes. Attackers use this sequence to choose where to deploy follow-on infrastructure such as cryptomining or staging hosts. Legitimate IaC and deployment tooling that enumerates locations before provisioning also produces it."
    mitre_tactic = "Discovery"
    mitre_technique = "T1614"
    mitre_technique_name = "System Location Discovery"
    log_prerequisites = "Cloud control-plane audit logs ingested and normalised to UDM, with metadata.product_event_type and principal.user.userid populated. Read-only (management) API events must be enabled for the location enumeration calls to be logged."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Infrastructure-as-code pipelines, CI/CD deployment roles, cloud console users browsing regions before launching an instance, FinOps or inventory tooling, and new engineers onboarding."
    tuning_guidance = "Add automation and pipeline identities to %global_allowed_service_accounts, approved service principals to %global_allowed_cloud_principals, and named platform engineers to %global_allowed_admin_users. If console region pickers are noisy, raise severity only when the creation event comes from a different source IP than normal, or narrow the creation regex to the resource types relevant to the client."

  events:
    $disc.metadata.event_type = "USER_RESOURCE_ACCESS"
    $disc.metadata.product_event_type = /(DescribeRegions|DescribeAvailabilityZones|ListLocations|regions\.(list|get)|zones\.(list|get)|locations\/read)/ nocase
    $disc.principal.user.userid = $user
    not $disc.principal.user.userid in %global_allowed_service_accounts
    not $disc.principal.user.userid in %global_allowed_cloud_principals
    not $disc.principal.user.userid in %global_allowed_admin_users

    $create.metadata.event_type = "RESOURCE_CREATION"
    $create.metadata.product_event_type = /(RunInstances|CreateFunction|instances\.insert|virtualMachines\/write|functions\.create)/ nocase
    $create.principal.user.userid = $user
    not $create.principal.user.userid in %global_allowed_service_accounts
    not $create.principal.user.userid in %global_allowed_cloud_principals
    not $create.principal.user.userid in %global_allowed_admin_users

    $disc.metadata.event_timestamp.seconds <= $create.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1614")
    $primary_entity = array_distinct($user)
    $discovery_event_count = count($disc.metadata.id)
    $discovery_apis = array_distinct($disc.metadata.product_event_type)
    $creation_apis = array_distinct($create.metadata.product_event_type)
    $created_resources = array_distinct($create.target.resource.name)
    $source_ips = array_distinct($disc.principal.ip)

  condition:
    $disc and $create
}
