/*
  MITRE Technique : T1059.012 - Hypervisor CLI
  Tactic(s)       : Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:23:44.052205+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_012_ESXi_Hypervisor_CLI_Config_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects hypervisor host configuration changes that are the typical result of hypervisor CLI abuse: remote logging redirected or disabled, host firewall rulesets disabled, shell and SSH services enabled, shell timeouts removed, lockdown mode disabled, or the managed object browser enabled. Detection is based on the resulting setting change, not on the command line."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.012"
    mitre_technique_name = "Command and Scripting Interpreter: Hypervisor CLI"
    log_prerequisites = "Requires hypervisor host management and configuration-change logs (hostd and shell audit) forwarded and parsed into UDM as SETTING_MODIFICATION, with the change text in metadata.description."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Planned host build or remediation, host profile or desired-state remediation, authorised syslog collector migrations, patching windows that temporarily enable SSH or the shell, and break-glass troubleshooting by administrators."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation accounts (configuration management, host profile remediation) to %global_allowed_service_accounts. If the change text is carried in a different UDM field in your parser, adjust the field in the regex condition. Narrow the regex alternatives if a specific setting is routinely changed by approved workflows."

  events:
    $set.metadata.event_type = "SETTING_MODIFICATION"
    $set.metadata.description = /(Syslog\.global\.(logHost|logDir|defaultRotate)|ESXiShell(Interactive)?TimeOut|UserVars\.(ESXiShell|SuppressShellWarning|DcuiTimeOut)|Config\.HostAgent\.plugins\.solo\.enableMob|lockdown\s*mode|firewall.*(disabled|enabled\s*(=|:)?\s*false|allowedall)|TSM(-SSH)?\b.*(start|enable|running)|(SSH|ESXi\s*Shell)\s+(service\s+)?(started|enabled))/ nocase
    $set.principal.hostname != ""
    not $set.principal.user.userid in %global_allowed_admin_users
    not $set.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1059.012")
    $primary_entity = array_distinct($set.principal.hostname)
    $acting_user = array_distinct($set.principal.user.userid)
    $change_detail = array_distinct($set.metadata.description)

  condition:
    $set
}
