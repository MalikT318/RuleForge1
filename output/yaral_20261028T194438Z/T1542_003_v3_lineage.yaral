/*
  MITRE Technique : T1542.003 - Bootkit
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:46:50.431319+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_003_Linux_Service_Parent_Spawns_Boot_Modifier {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server or database service process directly spawning a boot-sector or bootloader modification utility. This covers raw writes to a disk device with dd, or bootloader and EFI boot-entry tools such as grub-install, update-grub and efibootmgr. Service processes have no legitimate reason to alter the MBR, VBR, ESP or UEFI boot configuration, so this lineage indicates post-exploitation bootkit persistence."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.003"
    mitre_technique_name = "Pre-OS Boot: Bootkit"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to PROCESS_LAUNCH, with parent process path, child process path and full command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Appliance-style or custom-packaged products where an application service runs as a privileged helper and invokes grub-install or efibootmgr. Database or application-server backup and imaging jobs launched directly by the service that use dd against a disk device. Automated image-build or provisioning workflows triggered by a web-based management console."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_backup_processes. Add approved administrator accounts to %global_allowed_admin_users. Add automation identities to %global_allowed_service_accounts. Extend or narrow the parent service regex to match the middleware deployed in each client environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Unexpected parent: web server, application server, or database service
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|php|php-fpm[0-9.]*|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server)$/ nocase

    // Child: raw write to a whole-disk device, or a bootloader / EFI boot management tool
    (
      (
        $proc.target.process.file.full_path = /\/dd$/ nocase and
        $proc.target.process.command_line = /\bof=\/dev\/(sd[a-z]+|vd[a-z]+|xvd[a-z]+|hd[a-z]+|nvme[0-9]+n[0-9]+|mmcblk[0-9]+)\b/ nocase
      ) or
      $proc.target.process.file.full_path = /\/(grub-install|grub2-install|update-grub2?|grub2?-mkconfig|efibootmgr|bootctl)$/ nocase
    )

    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1542.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
