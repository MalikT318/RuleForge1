/*
  MITRE Technique : T1565.001 - Stored Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:38:40.586601+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_001_SQL_Client_Destructive_DML_CommandLine {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a command-line database client or PowerShell SQL cmdlet launched with an inline data-modifying statement (UPDATE ... SET, DELETE FROM, TRUNCATE TABLE, DROP TABLE/DATABASE). Running these non-interactively from a process command line is a direct way to alter stored data at rest. Matching on command-line content and flags, not on a specific binary name, keeps the rule effective if the client is renamed."
    mitre_tactic = "Impact"
    mitre_technique = "T1565.001"
    mitre_technique_name = "Data Manipulation: Stored Data Manipulation"
    log_prerequisites = "Requires process-launch telemetry with full command-line capture (EDR, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "DBA maintenance scripts, application installers and upgraders running schema or data migrations, scheduled data-purge or archival jobs, CI/CD deployment agents, and developers working on test databases."
    tuning_guidance = "Add approved DBA and deployment tooling parent processes to %global_allowed_admin_tools. Add service accounts that run scheduled data-maintenance jobs to %global_allowed_service_accounts. Add approved automation hosts to %global_allowed_script_hosts. If DELETE or TRUNCATE is too noisy in a client's environment, remove it from the statement regex and keep UPDATE and DROP."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /\b(update\s+\S+\s+set\s|delete\s+from\s|truncate\s+table\s|drop\s+(table|database)\s)/ nocase
    $proc.target.process.command_line = /(\s-[qQ]\s|\s-e\s|\s--execute|\s-c\s|\s--command|invoke-sqlcmd|\s-query\s|sqlcmd|osql|sqlite3|mysql|psql)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1565.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
