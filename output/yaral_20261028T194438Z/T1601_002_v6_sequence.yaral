/*
  MITRE Technique : T1601.002 - Downgrade System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:15:36.416658+00:00
  Reference       : https://attack.mitre.org/techniques/T1601/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_002_Network_Device_Mgmt_Access_Then_Image_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an unapproved source opening a management session (SSH/Telnet) to a network device, followed within ten minutes by that same device initiating an outbound TFTP or FTP transfer. This pattern is consistent with an operator staging an older system image on the device, which is how a system image downgrade is carried out on embedded devices."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1601.002"
    mitre_technique_name = "Modify System Image: Downgrade System Image"
    log_prerequisites = "Requires firewall or perimeter connection logs that record both inbound management-plane sessions to the device and outbound sessions the device itself initiates, with source and destination IP and destination port populated. The device must have a consistent IP across both views."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Planned firmware upgrades or rollbacks by network engineers from an unlisted jump host, configuration backup jobs that use TFTP/FTP, and zero-touch provisioning of newly deployed devices. Both events fall within a change window in these cases."
    tuning_guidance = "Add approved jump hosts, bastions, and image or backup server addresses to %global_allowed_mgmt_sources. Add authorised scanner addresses to %global_allowed_scanners. Suppress during approved change windows. If the environment uses only SSH, remove port 23 from the management-session filter."

  events:
    $mgmt.metadata.event_type = "NETWORK_CONNECTION"
    ($mgmt.target.port = 22 or $mgmt.target.port = 23)
    not $mgmt.principal.ip in %global_allowed_mgmt_sources
    not $mgmt.principal.ip in %global_allowed_scanners
    $mgmt.target.ip = $device_ip

    $xfer.metadata.event_type = "NETWORK_CONNECTION"
    ($xfer.target.port = 69 or $xfer.target.port = 21)
    not $xfer.target.ip in %global_allowed_mgmt_sources
    $xfer.principal.ip = $device_ip

    $mgmt.metadata.event_timestamp.seconds <= $xfer.metadata.event_timestamp.seconds

  match:
    $device_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1601.002")
    $primary_entity = array_distinct($device_ip)
    $mgmt_source_ips = array_distinct($mgmt.principal.ip)
    $mgmt_ports = array_distinct($mgmt.target.port)
    $transfer_destination_ips = array_distinct($xfer.target.ip)
    $transfer_ports = array_distinct($xfer.target.port)
    $mgmt_session_count = count($mgmt.metadata.id)
    $transfer_count = count($xfer.metadata.id)

  condition:
    $mgmt and $xfer
}
