/*
  MITRE Technique : T1554 - Compromise Host Software Binary
  Tactic(s)       : Persistence
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:12:11.305506+00:00
  Reference       : https://attack.mitre.org/techniques/T1554
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1554_ESXi_Relaxed_Acceptance_Then_Unsigned_VIB_Install {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an ESXi host whose software acceptance level is lowered to a community or partner level, followed within ten minutes by a software bundle (VIB) install or update that forces installation or skips signature checking. This sequence is a known way to persist a trojanised or backdoored host software package on a hypervisor."
    mitre_tactic = "Persistence"
    mitre_technique = "T1554"
    mitre_technique_name = "Compromise Host Software Binary"
    log_prerequisites = "ESXi shell and hostd command logging forwarded to Chronicle and parsed into PROCESS_LAUNCH events with command_line and principal.hostname populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators installing third-party drivers, vendor agents or lab and test packages that need a lower acceptance level; patching and lifecycle tooling run from an admin shell."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and approved patching or lifecycle tooling to %global_allowed_admin_tools. If a client legitimately uses community-supported packages, restrict the rule to hosts outside that change window or raise the force and no-sig-check requirement."

  events:
    $accept.metadata.event_type = "PROCESS_LAUNCH"
    $accept.target.process.command_line = /software\s+acceptance\s+set/ nocase
    $accept.target.process.command_line = /--level[=\s]+(CommunitySupported|PartnerSupported)/ nocase
    not $accept.principal.user.userid in %global_allowed_admin_users
    not $accept.principal.process.file.full_path in %global_allowed_admin_tools
    $accept.principal.hostname = $hostname

    $vib.metadata.event_type = "PROCESS_LAUNCH"
    $vib.target.process.command_line = /software\s+vib\s+(install|update)/ nocase
    $vib.target.process.command_line = /\s(--force|--no-sig-check)(\s|=|$)/ nocase
    not $vib.principal.user.userid in %global_allowed_admin_users
    not $vib.principal.process.file.full_path in %global_allowed_admin_tools
    $vib.principal.hostname = $hostname

    $accept.metadata.event_timestamp.seconds <= $vib.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1554")
    $primary_entity = array_distinct($hostname)
    $acceptance_commands = array_distinct($accept.target.process.command_line)
    $vib_commands = array_distinct($vib.target.process.command_line)
    $acting_users = array_distinct($vib.principal.user.userid)
    $first_seen = min($accept.metadata.event_timestamp.seconds)
    $last_seen = max($vib.metadata.event_timestamp.seconds)

  condition:
    $accept and $vib
}
