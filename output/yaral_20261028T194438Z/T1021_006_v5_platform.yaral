/*
  MITRE Technique : T1021.006 - Windows Remote Management
  Tactic(s)       : Lateral Movement
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:44:08.355804+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_006_WinRM_Internal_Lateral_Connection_Firewall {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a perimeter or internal-segment firewall connection from an internal host to another internal host on the WinRM service ports (5985 HTTP, 5986 HTTPS), from a source that is not an approved management source or scanner. WinRM between ordinary workstations and servers is a common lateral movement path for valid-account abuse. This is network-layer coverage that complements process and command-line detections and works without endpoint telemetry."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.006"
    mitre_technique_name = "Remote Services: Windows Remote Management"
    log_prerequisites = "Firewall or network flow logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. East-west traffic must pass through a logged inspection point, such as an internal segmentation firewall."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Admin jump hosts and PAM gateways, RMM and patching servers, SCCM or Intune management points, monitoring and inventory collectors, and configuration management servers that manage Windows hosts over WinRM, such as Ansible, DSC and Azure Automation hybrid workers."
    tuning_guidance = "Add approved jump host, PAM and automation source addresses to %global_allowed_mgmt_sources. Add authorised scanner addresses to %global_allowed_scanners. If east-west WinRM is routine in a client environment, convert this to a Threshold rule that counts distinct target.ip values per source over 10m."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 5985 or $net.target.port = 5986)
    $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1021.006")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
