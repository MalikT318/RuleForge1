/*
  MITRE Technique : T1059.007 - JavaScript
  Tactic(s)       : Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:16:39.173725+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_007_Linux_NodeJS_External_Connection_Eval_Or_TempScript {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux JavaScript runtime (Node.js, Deno, Bun) opening an outbound network connection to a non-internal address while running inline code (-e/--eval/-p/--print) or a script staged in a world-writable directory (/tmp, /var/tmp, /dev/shm). Observes the network side of JavaScript execution: reverse shells, stagers and C2 beacons written in JS."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.007"
    mitre_technique_name = "Command and Scripting Interpreter: JavaScript"
    log_prerequisites = "Requires Linux endpoint telemetry (EDR or auditd with connect syscall auditing) that populates NETWORK_CONNECTION events with the initiating process path and command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers running one-off node -e snippets that call external APIs, CI/CD runners and build agents executing temporary scripts from /tmp, npm lifecycle scripts fetching packages, serverless or container test harnesses, and monitoring agents written in Node.js."
    tuning_guidance = "Add build servers and developer jump hosts to %global_allowed_script_hosts, approved JS-based tooling binaries to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Add vendor update destinations to %global_allowed_domains if domain telemetry is populated. Consider restricting by target.port if noisy."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(node|nodejs|deno|bun)$/ nocase
    (
      $net.principal.process.command_line = /(^|\s)(-e|--eval|-p|--print)(\s|=|$)/ nocase or
      $net.principal.process.command_line = /(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/)\S*\.(js|mjs|cjs)/ nocase
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1059.007")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $process_command_lines = array_distinct($net.principal.process.command_line)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
