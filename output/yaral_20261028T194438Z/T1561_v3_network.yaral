/*
  MITRE Technique : T1561 - Disk Wipe
  Tactic(s)       : Impact
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:02:49.253145+00:00
  Reference       : https://attack.mitre.org/techniques/T1561
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1561_Outbound_SMB_Wiper_Propagation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an internal host making an SMB or NetBIOS session connection (TCP 445/139) to a non-internal destination as seen at the network perimeter. Worm-like disk wipers use SMB and Windows Admin Shares to propagate, and egress SMB to external address space is a strong indicator of wiper or worm scanning activity, or of exposed or misrouted SMB. Internal address space is excluded through a reference list."
    mitre_tactic = "Impact"
    mitre_technique = "T1561"
    mitre_technique_name = "Disk Wipe"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Egress SMB traffic must be logged, not silently dropped before logging."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate SMB over the internet to cloud file services (for example Azure Files over 445), site-to-site flows where the remote subnet is not covered by %rfc1918_internal (for example CGNAT or public address space used internally), authorised external vulnerability scanners, and misconfigured clients attempting SMB to external hosts."
    tuning_guidance = "Add approved scanner sources to %global_allowed_scanners. Add approved management or jump-host sources to %global_allowed_mgmt_sources. Make sure %rfc1918_internal covers all private ranges used by the client. Corroborate hits with endpoint telemetry (raw disk writes, MBR modification) on the source host. Consider routing alerts to higher priority when one source triggers many distinct destinations."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 445 or $net.target.port = 139)
    $net.principal.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1561")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
