/*
  MITRE Technique : T1556.006 - Multi-Factor Authentication
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:23:03.767151+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_006_Outbound_RADIUS_MFA_To_External_Destination {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows host sending RADIUS authentication or accounting traffic (UDP/TCP 1812, 1813, 1645, 1646) to a non-internal destination. RADIUS is the protocol commonly used to relay MFA challenges to an NPS or MFA server. Sending it outside the organisation can mean the MFA path has been redirected to an adversary-controlled server (for example by editing the hosts file, DNS, or MFA agent configuration) so that authentication fails open or is approved by the attacker. This is a network-side detection and does not depend on process command lines."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.006"
    mitre_technique_name = "Modify Authentication Process: Multi-Factor Authentication"
    log_prerequisites = "Requires endpoint or host-based network telemetry normalised to UDM NETWORK_CONNECTION, with target.ip, target.port and principal.hostname populated. Identity or authentication infrastructure (NPS, MFA agents, VPN concentrators) must be in scope. Process path fields improve allowlisting but are optional."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Legitimate cloud-hosted MFA or RADIUS-as-a-service providers reached directly from NPS or MFA proxy servers; VPN or NAC appliances authenticating to a hosted RADIUS service; approved remote-management or testing tools probing RADIUS."
    tuning_guidance = "Add the NPS or MFA proxy service binary to %global_allowed_admin_tools and approved remote tooling to %global_allowed_remote_mgmt. Populate %rfc1918_internal so internal RADIUS servers are excluded. Add authorised testing sources to %global_allowed_scanners. If the client uses a hosted MFA RADIUS service, scope by allowlisting the NPS server process rather than disabling the rule."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 1812 or
      $net.target.port = 1813 or
      $net.target.port = 1645 or
      $net.target.port = 1646
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1556.006")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_process = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
