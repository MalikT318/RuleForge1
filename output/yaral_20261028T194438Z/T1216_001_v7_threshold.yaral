/*
  MITRE Technique : T1216.001 - PubPrn
  Tactic(s)       : Stealth
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:35:34.351123+00:00
  Reference       : https://attack.mitre.org/techniques/T1216/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1216_001_PubPrn_Remote_Script_Moniker_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Repeated script-host executions of the PubPrn printer-publishing script with a script: moniker argument on a single host within ten minutes. This is the signed-script proxy execution pattern used to load remote scriptlets and bypass application control. A single instance is rare, and repeated attempts suggest an adversary iterating on payloads or delivery."
    mitre_tactic = "Stealth"
    mitre_technique = "T1216.001"
    mitre_technique_name = "System Script Proxy Execution: PubPrn"
    log_prerequisites = "Requires EDR process telemetry, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled, normalised to PROCESS_LAUNCH with populated target.process.command_line."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate printer publishing to Active Directory by print administrators (normally uses LDAP:// rather than script:), print-server deployment or migration scripts, and security validation or red-team exercises."
    tuning_guidance = "Add approved deployment and print-management parent processes to %global_allowed_admin_tools. Add approved automation hosts or parents to %global_allowed_script_hosts. Raise the #proc threshold if print-admin tooling is noisy. Lower it to 1 for high-security tenants, since script: usage with pubprn.vbs is rarely legitimate."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.hostname = $host
    $proc.target.process.file.full_path = /\\(cscript|wscript)\.exe$/ nocase
    $proc.target.process.command_line = /pubprn(\.vbs)?"?\s+\S+\s+"?script:/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  match:
    $host over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1216.001")
    $primary_entity = array_distinct($host)
    $event_count = count($proc.metadata.id)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 2
}
