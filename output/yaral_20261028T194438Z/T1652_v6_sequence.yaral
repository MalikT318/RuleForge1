/*
  MITRE Technique : T1652 - Device Driver Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:56:07.451801+00:00
  Reference       : https://attack.mitre.org/techniques/T1652
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1652_Linux_Driver_Enum_Then_Kernel_Recon {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a user enumerating loaded kernel modules or drivers on a Linux host (lsmod, modinfo, or reads of /proc/modules), followed within ten minutes by kernel version or kernel log reconnaissance (uname -r/-a, /proc/version, dmesg) from the same user on the same host. Together these steps are typical of host profiling for security tooling, sandbox evasion, or kernel exploit selection."
    mitre_tactic = "Discovery"
    mitre_technique = "T1652"
    mitre_technique_name = "Device Driver Discovery"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records normalised to UDM PROCESS_LAUNCH with command_line, parent process path, hostname and user populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "System administrators troubleshooting drivers, configuration management and inventory agents, hardware diagnostic scripts, driver installers (DKMS, GPU or VPN client installs), and container or kernel developers testing modules."
    tuning_guidance = "Add approved inventory, patching and diagnostic parent binaries to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. If volume is high on developer or build hosts, exclude those hosts' users via %global_allowed_admin_users or shorten the window."

  events:
    $drv.metadata.event_type = "PROCESS_LAUNCH"
    $drv.target.process.command_line = /(^|\/|\s)(lsmod|modinfo)(\s|$)|\/proc\/modules/ nocase
    $drv.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ash|ksh)$/ nocase
    not $drv.principal.process.file.full_path in %global_allowed_admin_tools
    not $drv.principal.user.userid in %global_allowed_service_accounts
    $drv.principal.hostname = $host
    $drv.principal.user.userid = $user

    $ker.metadata.event_type = "PROCESS_LAUNCH"
    $ker.target.process.command_line = /(^|\/|\s)uname\s+-[a-z]*[ar][a-z]*(\s|$)|\/proc\/version|(^|\/|\s)dmesg(\s|$)/ nocase
    $ker.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ash|ksh)$/ nocase
    not $ker.principal.process.file.full_path in %global_allowed_admin_tools
    not $ker.principal.user.userid in %global_allowed_service_accounts
    $ker.principal.hostname = $host
    $ker.principal.user.userid = $user

    $drv.metadata.event_timestamp.seconds <= $ker.metadata.event_timestamp.seconds

  match:
    $host, $user over 10m

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1652")
    $primary_entity = array_distinct($host)
    $acting_user = array_distinct($user)
    $driver_commands = array_distinct($drv.target.process.command_line)
    $kernel_commands = array_distinct($ker.target.process.command_line)
    $event_count = count($drv.metadata.id)

  condition:
    $drv and $ker
}
