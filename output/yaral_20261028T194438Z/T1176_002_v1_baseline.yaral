/*
  MITRE Technique : T1176.002 - IDE Extensions
  Tactic(s)       : Persistence
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:28:34.749854+00:00
  Reference       : https://attack.mitre.org/techniques/T1176/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_002_Linux_IDE_Extension_Package_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an IDE client on a Linux host retrieving or querying extension packages (.vsix archives, marketplace gallery/extension-query APIs, IDE plugin download endpoints) through a proxy or firewall with HTTP inspection. Malicious or side-loaded IDE extensions persist by running whenever the IDE launches, and the package fetch is the network-observable moment of installation. The rule matches URL path structure and an IDE-plus-Linux user agent, not specific domains or tool names."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176.002"
    mitre_technique_name = "Software Extensions: IDE Extensions"
    log_prerequisites = "Proxy or firewall logs normalised to UDM NETWORK_HTTP with network.http.user_agent and target.url populated (TLS inspection required for HTTPS URL visibility). Without inspection, URL paths are not visible and this rule will not fire."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Developers legitimately installing or updating IDE extensions on workstations or build hosts, automated IDE or devcontainer provisioning, remote development servers that auto-update extensions, and internal extension mirrors."
    tuning_guidance = "Add sanctioned marketplace or internal mirror hostnames to %global_allowed_domains. Add developer or provisioning accounts to %global_allowed_admin_users. Consider restricting to server or non-developer subnets in per-client tuning, where any IDE extension fetch is anomalous. Review hosts seen repeatedly or fetching extensions outside working hours first."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /(vscode|vscodium|code-oss|\bcode\/|jetbrains|intellij|pycharm|goland|eclipse|theia|code-server)/ nocase
    $net.network.http.user_agent = /(linux|x11)/ nocase
    $net.target.url = /(\.vsix(\?|$)|\/vsextensions\/|\/extensionquery|\/_apis\/public\/gallery|\/plugin\/download|\/pluginManager\/|\/api\/plugins\/.*\/download)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1176.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
