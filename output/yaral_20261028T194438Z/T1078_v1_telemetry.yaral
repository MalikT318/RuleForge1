/*
  MITRE Technique : T1078 - Valid Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:27:01.901829+00:00
  Reference       : https://attack.mitre.org/techniques/T1078
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_SaaS_IdP_Authentication_Policy_Setting_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change to an identity provider authentication-control setting (MFA, conditional or sign-on policy, authentication methods, password or session policy, trusted network or location definitions). Adversaries holding valid accounts modify these controls to weaken access requirements, exempt their own accounts or locations, and keep persistent access. Detection is at the configuration state-change layer, not the command line."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078"
    mitre_technique_name = "Valid Accounts"
    log_prerequisites = "Requires identity provider directory/admin audit logs ingested and parsed to UDM SETTING_MODIFICATION with principal.user.userid and target.resource.name populated."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Planned MFA rollouts or enforcement changes, conditional access tuning by the identity team, password policy updates driven by compliance, trusted-location updates after office or VPN egress changes, and infrastructure-as-code or identity governance automation."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation or IaC identities to %global_allowed_service_accounts. Add approved cloud or identity service principals to %global_allowed_cloud_principals. Correlate with change tickets during triage. Narrow the target.resource.name regex if a client uses non-standard policy naming."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.target.resource.name = /(mfa|multi.?factor|two.?factor|2fa|conditional.?access|sign.?on.?polic|authentication.?(polic|method|strength)|password.?polic|session.?polic|trusted.?(location|network|ip)|named.?location)/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1078")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $changed_setting = array_distinct($setting.target.resource.name)
    $source_ip = array_distinct($setting.principal.ip)

  condition:
    $setting
}
