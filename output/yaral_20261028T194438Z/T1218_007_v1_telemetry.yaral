/*
  MITRE Technique : T1218.007 - Msiexec
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:49:30.051273+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_007_AlwaysInstallElevated_Policy_Enabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modification that sets the Windows Installer AlwaysInstallElevated policy. When enabled, msiexec.exe runs any MSI with SYSTEM privileges, so this is a common prerequisite for privilege escalation and for proxying malicious payloads through msiexec. The rule detects the resulting registry state change rather than msiexec command lines, so it still fires if command-line logging is evaded or obfuscated."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1218.007"
    mitre_technique_name = "System Binary Proxy Execution: Msiexec"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events) that normalises to REGISTRY_MODIFICATION with target.registry.registry_key populated. Value name or value data population improves precision but is not required."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy software deployment or packaging workflows that deliberately enable AlwaysInstallElevated, Group Policy refresh or management agents writing the policy, and lab or build systems configured by administrators. Explicit writes of the value 0 are excluded."
    tuning_guidance = "Add approved GPO, RMM or deployment tooling executables to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Named administrators performing sanctioned changes can be added to %global_allowed_admin_users. If the first creation of the value is logged as REGISTRY_CREATION in your environment, deploy a cloned variant for that event type. The value-data exclusion only applies when registry_value_data is populated."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      (
        $reg.target.registry.registry_value_name = "AlwaysInstallElevated" nocase and
        $reg.target.registry.registry_key = /\\Policies\\Microsoft\\Windows\\Installer$/ nocase
      ) or
      $reg.target.registry.registry_key = /\\Policies\\Microsoft\\Windows\\Installer\\AlwaysInstallElevated$/ nocase
    )
    not $reg.target.registry.registry_value_data = /^(0|0x0+|dword \(0x0+\))$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.007")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $modifying_user = array_distinct($reg.principal.user.userid)
    $registry_key = array_distinct($reg.target.registry.registry_key)

  condition:
    $reg
}
