/*
  MITRE Technique : T1049 - System Network Connections Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:40:28.669789+00:00
  Reference       : https://attack.mitre.org/techniques/T1049
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1049_Windows_Mgmt_Port_Connection_Enumeration_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single source address makes a high volume of connections within ten minutes to the Windows remote-enumeration service ports (RPC 135, NetBIOS 139, SMB 445, WinRM 5985/5986). This is the network-observable footprint of remote session and connection discovery (net session, net use, remote service queries) across multiple systems. Any single connection is routine. The volume from one source is not. Severity scales with the number of distinct destinations."
    mitre_tactic = "Discovery"
    mitre_technique = "T1049"
    mitre_technique_name = "System Network Connections Discovery"
    log_prerequisites = "Firewall, proxy or perimeter flow logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Requires east-west (internal segment) visibility on the firewall to observe internal enumeration."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Domain-joined clients talking to domain controllers and file servers, file-share migrations, backup and patching servers, vulnerability scanners, monitoring and inventory systems, RMM and SCCM-style management servers, administrators running remote management."
    tuning_guidance = "Add scanner and inventory source addresses to %global_allowed_scanners and management or jump host addresses to %global_allowed_mgmt_sources. Raise the #net threshold on busy segments (for example file-server or domain-controller subnets), or lower it for high-value server VLANs. Review $distinct_targets: a high distinct-destination count is far more suspicious than many connections to one server."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 135 or
      $net.target.port = 139 or
      $net.target.port = 445 or
      $net.target.port = 5985 or
      $net.target.port = 5986
    )
    $net.principal.ip = $src
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src over 10m

  outcome:
    $event_count = count($net.metadata.id)
    $distinct_targets = count_distinct($net.target.ip)
    $risk_score = max(if($distinct_targets >= 20, 80, 50))
    $mitre_technique_id = array_distinct("T1049")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 25
}
