/*
  MITRE Technique : T1552.007 - Container API
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:56:43.468373+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_007_K8s_Secrets_Bulk_Read_By_Single_Identity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single identity issues a high volume of get/list requests against the Kubernetes secrets API within ten minutes. Each request is benign on its own. Bulk reads indicate credential harvesting with a stolen user credential or a compromised pod service-account token."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.007"
    mitre_technique_name = "Unsecured Credentials: Container API"
    log_prerequisites = "Kubernetes API server audit logging enabled at Metadata level or higher, covering the secrets resource, and ingested into UDM as USER_RESOURCE_ACCESS with the request verb in metadata.product_event_type and the request URI in target.url."
    platform = "Containers"
    log_source = "container"
    false_positives = "GitOps and secret-sync controllers, certificate managers, CI/CD deployers, backup and disaster-recovery tooling, secret-injection operators, and admins running audits or migrations."
    tuning_guidance = "Add expected automation identities to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Raise or lower the #k8s threshold per environment. Core control-plane identities (system:node, system:kube-*, system:serviceaccount:kube-system) are excluded by regex; extend the regex if other platform components are noisy."

  events:
    $k8s.metadata.event_type = "USER_RESOURCE_ACCESS"
    $k8s.metadata.product_event_type = /^(get|list|watch)$/ nocase
    $k8s.target.url = /\/api\/v1\/(namespaces\/[^\/]+\/)?secrets(\/|\?|$)/ nocase
    $k8s.principal.user.userid = $user
    not $k8s.principal.user.userid = /^system:(node:|kube-|serviceaccount:kube-system:)/ nocase
    not $k8s.principal.user.userid in %global_allowed_service_accounts
    not $k8s.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1552.007")
    $primary_entity = array_distinct($user)
    $event_count = count($k8s.metadata.id)
    $secret_endpoints = array_distinct($k8s.target.url)
    $source_ips = array_distinct($k8s.principal.ip)

  condition:
    #k8s >= 10
}
