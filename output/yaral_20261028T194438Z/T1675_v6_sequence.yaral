/*
  MITRE Technique : T1675 - ESXi Administration Command
  Tactic(s)       : Execution
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:21:25.073773+00:00
  Reference       : https://attack.mitre.org/techniques/T1675
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1675_ESXi_Login_Then_Guest_Operation_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a login to an ESXi host from a source outside the approved management sources, followed within 10 minutes on the same host by guest-operation or VMware Tools command execution activity (StartProgramInGuest, ListProcessesInGuest, InitiateFileTransferFromGuest and similar). This sequence indicates an adversary abusing ESXi administration services to run commands inside hosted guest VMs."
    mitre_tactic = "Execution"
    mitre_technique = "T1675"
    mitre_technique_name = "ESXi Administration Command"
    log_prerequisites = "ESXi hostd, shell and auth logs forwarded to Chronicle and parsed into UDM USER_LOGIN and PROCESS_LAUNCH events, with principal.hostname populated consistently across both event types."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Approved backup or image-level tooling using guest operations, patch and configuration management that uses VMware Tools quiesce or script hooks, monitoring or inventory agents that list guest processes, and administrators working from jump hosts not yet in the allowlist."
    tuning_guidance = "Add jump hosts and management addresses to %global_allowed_mgmt_sources. Add named administrators to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Add backup and management binaries to %global_allowed_backup_processes or %global_allowed_admin_tools through the parent process path."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.principal.hostname = $hostname
    not $login.principal.user.userid in %global_allowed_admin_users
    not $login.principal.user.userid in %global_allowed_service_accounts
    not $login.principal.ip in %global_allowed_mgmt_sources

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(StartProgramInGuest|ListProcessesInGuest|ListFilesInGuest|ListFileInGuest|InitiateFileTransferFromGuest|InitiateFileTransferToGuest|TerminateProcessInGuest|vmware-toolbox-cmd|guestOps)/ nocase
    $proc.principal.hostname = $hostname
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

    $login.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1675")
    $primary_entity = array_distinct($hostname)
    $login_users = array_distinct($login.principal.user.userid)
    $login_source_ips = array_distinct($login.principal.ip)
    $guest_commands = array_distinct($proc.target.process.command_line)
    $guest_command_count = count($proc.metadata.id)

  condition:
    $login and $proc
}
