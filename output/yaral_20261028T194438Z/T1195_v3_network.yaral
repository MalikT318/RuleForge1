/*
  MITRE Technique : T1195 - Supply Chain Compromise
  Tactic(s)       : Initial Access
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:38:04.237663+00:00
  Reference       : https://attack.mitre.org/techniques/T1195
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_Cleartext_Software_Update_Download_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows client fetching an installer, update or patch package (exe, msi, msix, msp, cab, dll, zip) over unencrypted HTTP from an external destination that is not on the known-good domain list. Cleartext software-update retrieval can be tampered with in transit, and a rogue or hijacked update channel is a common supply chain compromise delivery path."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195"
    mitre_technique_name = "Supply Chain Compromise"
    log_prerequisites = "Requires firewall or proxy logs normalised to UDM NETWORK_HTTP with target.url and target.hostname populated. HTTPS traffic needs TLS inspection to be visible to this rule."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legacy vendor updaters that still use HTTP, internal or third-party software mirrors, OS and driver update delivery over HTTP not yet in the allowed-domain list, and application installers fetched by IT staff."
    tuning_guidance = "Add legitimate vendor update and CDN domains to %global_allowed_domains. Make sure %rfc1918_internal covers the client's internal address space. If the proxy does not populate target.hostname, tune the URL regex for that client."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.target.url = /^http:\/\/[^\/]+\/.*(update|upgrade|patch|setup|install|release|download)[^?]*\.(exe|msi|msix|msp|cab|dll|zip)(\?.*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1195")
    $primary_entity = array_distinct($net.principal.ip)
    $download_urls = array_distinct($net.target.url)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)

  condition:
    $net
}
