/*
  MITRE Technique : T1550.002 - Pass the Hash
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:38:07.562593+00:00
  Reference       : https://attack.mitre.org/techniques/T1550/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1550_002_LocalAccountTokenFilterPolicy_Enabled {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry change to LocalAccountTokenFilterPolicy under the Policies\\System key. Setting it to a non-zero value disables remote UAC token filtering, so local administrator accounts can authenticate over the network with a full admin token. This is a common precondition for pass-the-hash lateral movement with local account hashes. The rule detects the resulting configuration state rather than any command line, so it still fires when the change is made through reg.exe, PowerShell, WMI, a custom API call or a renamed tool."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1550.002"
    mitre_technique_name = "Use Alternate Authentication Material: Pass the Hash"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon Event ID 13) that populates target.registry.registry_key and target.registry.registry_value_name. registry_value_data is used only for exclusion, so the rule still evaluates if it is empty."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Deliberate enablement by administrators or deployment tooling that needs remote local-admin access (legacy imaging, RMM onboarding, workgroup management scripts). Group Policy or configuration management applying this value as a baseline. Some vulnerability remediation or lab build scripts."
    tuning_guidance = "Add approved deployment and RMM binaries to %global_allowed_admin_tools and approved change-making accounts to %global_allowed_admin_users. Allow-list GPO or config-management service accounts via %global_allowed_service_accounts. If the baseline legitimately sets this value on specific build hosts, scope the exclusion to those hosts after review. Writes of 0 (the secure default) are already excluded."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Microsoft\\Windows\\CurrentVersion\\Policies\\System$/ nocase
    $reg.target.registry.registry_value_name = /^LocalAccountTokenFilterPolicy$/ nocase
    not $reg.target.registry.registry_value_data = /^(0|0x0+|0x00000000)$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_admin_users
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1550.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $modifying_user = array_distinct($reg.principal.user.userid)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_data = array_distinct($reg.target.registry.registry_value_data)

  condition:
    $reg
}
