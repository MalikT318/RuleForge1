/*
  MITRE Technique : T1090 - Proxy
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:25:31.156976+00:00
  Reference       : https://attack.mitre.org/techniques/T1090
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1090_Linux_Egress_To_Proxy_Service_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound connections from internal hosts to external destinations on ports characteristic of connection-proxy and anonymising-relay services (SOCKS, Tor relay/directory/SOCKS, HTTP forward-proxy and Privoxy-style listeners). Adversaries use these services to relay C2 traffic through intermediaries. This is a network-side detection that complements endpoint command-line coverage. It uses only firewall-visible fields (destination IP and port) and no process data."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1090"
    mitre_technique_name = "Proxy"
    log_prerequisites = "Firewall, proxy or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Egress traffic from Linux server segments must traverse the logging device."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Sanctioned corporate forward proxies or Squid and Privoxy upstreams reached on non-standard external ports, approved Tor or privacy research hosts, developer or CI hosts using external SOCKS proxies, cloud vendor services that happen to listen on 3128 or 9001, and applications using the same ports for unrelated purposes."
    tuning_guidance = "Add approved external proxy domains to %global_allowed_domains. Scope deployment to Linux server egress segments in the firewall feed, since the firewall does not report the endpoint OS. Remove port 3128 from the list if the client already uses it legitimately. Raise severity for hosts that should never initiate outbound connections, such as database or domain-internal servers."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 1080 or
      $net.target.port = 9050 or
      $net.target.port = 9150 or
      $net.target.port = 9001 or
      $net.target.port = 9030 or
      $net.target.port = 8118 or
      $net.target.port = 3128
    )
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1090")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
