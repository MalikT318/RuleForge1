/*
  MITRE Technique : T1558.004 - AS-REP Roasting
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:46:51.371436+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_004_ASREP_Roast_Enum_Then_Kerberos_From_Script_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects AS-REP roasting preparation and execution on one Windows host within 10 minutes. First, a process command line enumerates accounts with Kerberos preauthentication disabled (the DONT_REQ_PREAUTH flag, UAC bit 4194304, or the DoesNotRequirePreAuth property). Then an interpreter or user-writable-path process connects to Kerberos port 88, which is where AS-REQ messages for those accounts are sent."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.004"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: AS-REP Roasting"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with full command lines (EDR, Sysmon Event 1 or Security 4688 with command-line auditing) AND endpoint network-connection telemetry that includes the initiating process path (e.g. Sysmon Event 3 or an EDR network sensor)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Identity-hygiene and AD audit scripts that search for accounts without preauthentication and then query a DC using PowerShell; security assessment and purple-team exercises; IT admins troubleshooting Kerberos from a PowerShell session; identity-governance tooling running from ProgramData or user-profile paths."
    tuning_guidance = "Add approved AD audit tooling to %global_allowed_admin_tools, authorised assessment and scanning hosts to %global_allowed_script_hosts, and EDR/identity agents to %global_allowed_security_tools. If network telemetry lacks process paths, the network leg will not match and the rule needs a different second-stage signal. Pair with Windows Event 4768 (pre-auth type 0, RC4 0x17) detections on the DC."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(4194304|DoesNotRequirePreAuth|DONT_REQ_PREAUTH)/ nocase
    $proc.target.process.command_line = /(userAccountControl|Get-ADUser|Get-ADObject|DirectorySearcher|ldapsearch|dsquery|Get-DomainUser|adfind|samaccountname|DoesNotRequirePreAuth)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.hostname in %global_allowed_script_hosts
    $proc.principal.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 88
    $net.principal.process.file.full_path = /(\\(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32|msbuild|installutil)\.exe$|\\users\\[^\\]+\\|\\programdata\\|\\temp\\)/ nocase
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    $net.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1558.004")
    $primary_entity = array_distinct($hostname)
    $enum_commands = array_distinct($proc.target.process.command_line)
    $enum_users = array_distinct($proc.principal.user.userid)
    $kerberos_processes = array_distinct($net.principal.process.file.full_path)
    $kdc_ips = array_distinct($net.target.ip)
    $kerberos_connection_count = count($net.metadata.id)

  condition:
    $proc and $net
}
