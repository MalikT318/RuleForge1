/*
  MITRE Technique : T1497.001 - System Checks
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:02:58.407427+00:00
  Reference       : https://attack.mitre.org/techniques/T1497/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_001_Linux_VM_Check_Then_Staged_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A script or interpreter runs virtualization or sandbox artifact checks (DMI/SMBIOS data, hypervisor sysfs entries, virtualization-detection utilities) and, within 10 minutes on the same host and user, a binary executes from a world-writable staging directory (/tmp, /var/tmp, /dev/shm). This matches malware that fingerprints the environment for VM or sandbox indicators and then drops and runs its next stage only if the checks pass."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1497.001"
    mitre_technique_name = "Virtualization/Sandbox Evasion: System Checks"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records normalised to UDM PROCESS_LAUNCH with populated parent process path, command line and principal.user.userid."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management and inventory scripts (hardware or virtualization inventory), cloud-init and provisioning scripts, installers that probe the platform and then run helpers from /tmp, CI build agents, and administrators troubleshooting VMs."
    tuning_guidance = "Add approved inventory and provisioning tooling to %global_allowed_admin_tools, trusted script parents to %global_allowed_script_hosts, and automation accounts to %global_allowed_service_accounts. If CI/build hosts are noisy, exclude their service accounts via %global_allowed_service_accounts."

  events:
    $vmchk.metadata.event_type = "PROCESS_LAUNCH"
    $vmchk.principal.process.file.full_path = /\/(sh|bash|dash|zsh|ash|python[0-9.]*|perl|ruby)$/ nocase
    $vmchk.target.process.command_line = /(dmidecode|systemd-detect-virt|virt-what|\/sys\/class\/dmi\/id\/(product_name|sys_vendor|bios_vendor|board_vendor|product_version)|\/sys\/hypervisor|\/proc\/scsi\/scsi)/ nocase
    not $vmchk.principal.process.file.full_path in %global_allowed_script_hosts
    not $vmchk.principal.user.userid in %global_allowed_service_accounts
    $vmchk.principal.hostname = $host
    $vmchk.principal.user.userid = $user

    $drop.metadata.event_type = "PROCESS_LAUNCH"
    $drop.target.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    not $drop.principal.process.file.full_path in %global_allowed_admin_tools
    not $drop.principal.user.userid in %global_allowed_service_accounts
    $drop.principal.hostname = $host
    $drop.principal.user.userid = $user

    $vmchk.metadata.event_timestamp.seconds <= $drop.metadata.event_timestamp.seconds

  match:
    $host, $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1497.001")
    $primary_entity = array_distinct($host)
    $acting_user = array_distinct($user)
    $check_commands = array_distinct($vmchk.target.process.command_line)
    $staged_binaries = array_distinct($drop.target.process.file.full_path)
    $check_count = count($vmchk.metadata.id)

  condition:
    $vmchk and $drop
}
