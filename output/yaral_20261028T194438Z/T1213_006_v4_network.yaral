/*
  MITRE Technique : T1213.006 - Databases
  Tactic(s)       : Collection
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:31:04.055000+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_006_SaaS_Database_Query_API_Scripted_External_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects HTTP requests from an external source address to a data-warehouse or database query/export API endpoint made by a scripting or automation HTTP client library rather than an interactive browser. This is the network-side signature of bulk database collection through stolen SaaS credentials."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.006"
    mitre_technique_name = "Data from Information Repositories: Databases"
    log_prerequisites = "Requires SaaS or cloud-hosted database HTTP/API request telemetry normalised to NETWORK_HTTP, with target.url, network.http.user_agent, network.http.method, principal.ip and principal.user.userid populated. Ingested via the cloud audit pipeline."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate data engineering and ETL pipelines, BI connectors, analytics notebooks, CI/CD jobs and partner integrations that query database APIs with scripted HTTP clients from external or cloud-hosted addresses."
    tuning_guidance = "Add known pipeline and integration identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Add approved scanner or testing source addresses to %global_allowed_scanners. Add approved egress addresses to %global_allowed_mgmt_sources. Tighten the URL regex to the client's database API paths if noise remains."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /\/(sql|query|queries|statements|export)(\/|\?|$)/ nocase
    $http.network.http.user_agent = /(curl|wget|python|go-http-client|java|okhttp|libwww|axios|node-fetch|powershell)/ nocase
    $http.principal.user.userid != ""
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.user.userid in %global_allowed_service_accounts
    not $http.principal.user.userid in %global_allowed_cloud_principals
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1213.006")
    $primary_entity = array_distinct($http.principal.user.userid)
    $source_ips = array_distinct($http.principal.ip)
    $queried_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
