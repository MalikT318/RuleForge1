/*
  MITRE Technique : T1553.005 - Mark-of-the-Web Bypass
  Tactic(s)       : Defense Impairment
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:08:05.359306+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_005_Mass_MOTW_Stripping_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated commands on a single host that remove or bypass the Zone.Identifier Mark-of-the-Web stream (Unblock-File, direct Zone.Identifier ADS access or deletion) within 10 minutes. One unblock is routine, but repeated stripping suggests payloads extracted from container files are being prepared to run without SmartScreen or Protected View."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.005"
    mitre_technique_name = "Subvert Trust Controls: Mark-of-the-Web Bypass"
    log_prerequisites = "Requires EDR process telemetry, Sysmon Event ID 1, or Windows Event 4688 with command-line auditing enabled. PowerShell script-block logging is recommended as a complement."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or developers unblocking batches of downloaded scripts or installers, software packaging and deployment pipelines, RMM or patching tools that clear Zone.Identifier streams, and build servers that handle downloaded artifacts."
    tuning_guidance = "Add approved deployment and packaging tools to %global_allowed_admin_tools, trusted automation accounts to %global_allowed_service_accounts, and approved parent interpreters or hosts to %global_allowed_script_hosts. Raise the #proc threshold on developer workstations or build servers that unblock many files routinely."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(\bunblock-file\b|-stream\s+["']?zone\.identifier|:zone\.identifier)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1553.005")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 5
}
