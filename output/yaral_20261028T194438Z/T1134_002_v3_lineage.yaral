/*
  MITRE Technique : T1134.002 - Create Process with Token
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:55:23.230856+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_002_Unexpected_Parent_Spawns_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter launched by a parent process that should never spawn one: an Office application, web server worker, print spooler or database service. Token-based process creation (CreateProcessWithTokenW, runas-style abuse) commonly follows exploitation or compromise of these services. The rule pivots on the anomalous parent-child lineage rather than on the token API call."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.002"
    mitre_technique_name = "Access Token Manipulation: Create Process with Token"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with parent process path populated (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros or add-ins from approved line-of-business apps that call cmd or PowerShell; web applications such as legacy ASP/PHP that shell out for admin functions; print drivers or print management software that launch helper scripts from the spooler; SQL Server Agent jobs or xp_cmdshell used by approved DBA maintenance; IIS-hosted deployment or health-check scripts."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts and approved management tooling to %global_allowed_admin_tools. Add known service accounts that legitimately run these chains to %global_allowed_service_accounts. If a client uses a specific web or database stack that shells out legitimately, narrow the parent regex for that tenant rather than disabling the rule."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|spoolsv|sqlservr|sqlagent|mysqld|postgres|oracle)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|powershell_ise|pwsh|wscript|cscript|mshta|wmic|runas)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1134.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
