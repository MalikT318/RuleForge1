/*
  MITRE Technique : T1036 - Masquerading
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:54:59.371812+00:00
  Reference       : https://attack.mitre.org/techniques/T1036
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_ESXi_Login_Then_SystemDaemon_Name_From_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an interactive login to an ESXi host followed within 10 minutes by execution of a binary named after a core ESXi system daemon or utility (for example hostd, vpxa, sshd, busybox) from a world-writable or datastore location instead of its legitimate system path. This is name-versus-location masquerading and does not rely on command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036"
    mitre_technique_name = "Masquerading"
    log_prerequisites = "ESXi shell and auth logs forwarded via syslog and parsed to UDM, with USER_LOGIN events and PROCESS_LAUNCH events that include the executed image path (target.process.file.full_path). The hostname must be populated consistently in principal.hostname on both event types."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators staging troubleshooting or support binaries under /tmp or /scratch, vendor support bundles or patch scripts that run helper binaries from /tmp during upgrades, and backup or monitoring agents installed on a datastore that share a daemon name."
    tuning_guidance = "Add approved admin and deployment tooling to %global_allowed_admin_tools and EDR or monitoring agents to %global_allowed_security_tools. Add known bastion or jump-host addresses to %global_allowed_mgmt_sources and named administrators to %global_allowed_admin_users. If datastore paths are noisy, remove vmfs/volumes from the path regex."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.principal.hostname = $hostname
    not $login.principal.ip in %global_allowed_mgmt_sources
    not $login.target.user.userid in %global_allowed_admin_users

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.hostname = $hostname
    $proc.target.process.file.full_path = /^\/(tmp|var\/tmp|scratch|dev\/shm|vmfs\/volumes)\/(.*\/)?(hostd|vpxa|fdm|vobd|vmkeventd|rhttpproxy|vmware-vmx|sshd|crond|syslogd|busybox|esxcli|vmkfstools|init)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools

    $login.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1036")
    $primary_entity = array_distinct($hostname)
    $masquerading_paths = array_distinct($proc.target.process.file.full_path)
    $login_users = array_distinct($login.target.user.userid)
    $login_sources = array_distinct($login.principal.ip)
    $launch_count = count($proc.metadata.id)

  condition:
    $login and $proc
}
