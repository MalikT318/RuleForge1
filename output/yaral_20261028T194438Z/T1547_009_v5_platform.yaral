/*
  MITRE Technique : T1547.009 - Shortcut Modification
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:36:16.459314+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_009_Startup_Folder_Shortcut_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a .lnk shortcut inside a per-user or all-users Windows Startup folder by a process that is not on an approved tooling list. This is file-creation based coverage of shortcut persistence (T1547.009) and does not depend on process command lines. The platform stays Windows because the Startup folder is a Windows-only mechanism, so the rule is additive by event type (FILE_CREATION) rather than by operating system."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.009"
    mitre_technique_name = "Boot or Logon Autostart Execution: Shortcut Modification"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with the writing process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters that add a startup shortcut (msiexec, setup bootstrappers, VPN, collaboration and chat clients), RMM or deployment agents, user profile migration tools, and users manually dragging a shortcut into the Startup folder."
    tuning_guidance = "Add approved deployment and RMM binaries to %global_allowed_admin_tools or %global_allowed_remote_mgmt, and EDR or AV agents to %global_allowed_security_tools. Scope noisy installer hosts out with %global_allowed_script_hosts only if a client confirms they are managed build or packaging systems. Review writers that are scripting engines, Office applications, or processes running from user-writable directories first."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\Start Menu\\Programs\\Startup\\[^\\]+\.lnk$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1547.009")
    $primary_entity = array_distinct($file.principal.hostname)
    $shortcut_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
