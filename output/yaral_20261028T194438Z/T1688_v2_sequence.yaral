/*
  MITRE Technique : T1688 - Safe Mode Boot
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:35:22.416581+00:00
  Reference       : https://attack.mitre.org/techniques/T1688
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1688_SafeBoot_Registry_Then_AutoLogon_Config {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a registry write under the SafeBoot Minimal or Network key (registering a service or driver to load in safe mode), followed within 10 minutes on the same host by a change to the Winlogon AutoAdminLogon or DefaultPassword values. This combination prepares a host to reboot into safe mode and log in unattended, with EDR and other defenses not running. It is registry-based and does not depend on bcdedit command lines."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1688"
    mitre_technique_name = "Safe Mode Boot"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event IDs 12/13, or equivalent) populating target.registry.registry_key and target.registry.registry_value_name for HKLM\\SYSTEM and HKLM\\SOFTWARE."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate security or backup agents registering a safe-mode service or driver; Sysinternals Autologon or kiosk and lab provisioning tools that set autologon; golden-image build pipelines; IT staff troubleshooting boot issues."
    tuning_guidance = "Add approved installers, imaging and provisioning tools to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Kiosk or shared-device fleets that legitimately use autologon may need additional exclusions by process or host. Chronological order is SafeBoot write first, then autologon change; if the attacker order is reversed in your environment, create a mirrored variant."

  events:
    $safeboot.metadata.event_type = "REGISTRY_MODIFICATION"
    $safeboot.target.registry.registry_key = /\\Control\\SafeBoot\\(Minimal|Network)(\\|$)/ nocase
    $safeboot.principal.hostname = $hostname
    not $safeboot.principal.process.file.full_path in %global_allowed_admin_tools
    not $safeboot.principal.process.file.full_path in %global_allowed_security_tools

    $logon.metadata.event_type = "REGISTRY_MODIFICATION"
    $logon.target.registry.registry_key = /\\Windows NT\\CurrentVersion\\Winlogon/ nocase
    $logon.target.registry.registry_value_name = /^(AutoAdminLogon|DefaultPassword)$/ nocase
    $logon.principal.hostname = $hostname
    not $logon.principal.process.file.full_path in %global_allowed_admin_tools
    not $logon.principal.process.file.full_path in %global_allowed_security_tools

    $safeboot.metadata.event_timestamp.seconds <= $logon.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1688")
    $primary_entity = array_distinct($hostname)
    $safeboot_keys = array_distinct($safeboot.target.registry.registry_key)
    $safeboot_writers = array_distinct($safeboot.principal.process.file.full_path)
    $logon_values = array_distinct($logon.target.registry.registry_value_name)
    $logon_writers = array_distinct($logon.principal.process.file.full_path)
    $acting_users = array_distinct($safeboot.principal.user.userid)

  condition:
    $safeboot and $logon
}
