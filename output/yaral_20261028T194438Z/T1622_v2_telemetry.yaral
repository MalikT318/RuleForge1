/*
  MITRE Technique : T1622 - Debugger Evasion
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:47:56.992432+00:00
  Reference       : https://attack.mitre.org/techniques/T1622
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1622_Debugger_Registry_Hook_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects modification of the Windows post-mortem (AeDebug) and .NET JIT debugger registry settings. Adversaries change these values to control how a debugger attaches to, or is launched against, their crashing or analysed payload. Pivots on the registry state change rather than the command line that caused it."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1622"
    mitre_technique_name = "Debugger Evasion"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon registry events, or Windows registry auditing) normalised to REGISTRY_MODIFICATION with target.registry.registry_key and registry_value_name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developer workstations installing or reconfiguring a JIT debugger (IDE installers, WinDbg or ProcDump post-mortem registration), crash-dump collection tooling, software installers and repair operations, endpoint security agents configuring crash handling."
    tuning_guidance = "Add approved debugger installers and crash-dump tooling to %global_allowed_admin_tools, and EDR or AV agents to %global_allowed_security_tools. Consider raising severity on non-developer servers. Review the registry value data on any hit to confirm the debugger command points to an unexpected binary."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(Windows NT\\CurrentVersion\\AeDebug|\.NET Framework)$/ nocase
    $reg.target.registry.registry_value_name = /^(Debugger|Auto|DbgManagedDebugger|DbgJITDebugLaunchSetting)$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1622")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_keys = array_distinct($reg.target.registry.registry_key)
    $modified_values = array_distinct($reg.target.registry.registry_value_name)
    $acting_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
