/*
  MITRE Technique : T1125 - Video Capture
  Tactic(s)       : Collection
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:33:00.885163+00:00
  Reference       : https://attack.mitre.org/techniques/T1125
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1125_Outbound_Video_Streaming_Protocol_Firewall {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows-subnet host opening an outbound connection to an external destination on a standard video-streaming control or ingest port (RTMP 1935, RTSP 554, RTSP alternate 8554). Workstations and servers rarely push or pull raw camera streams to the internet, so this is a network-side indicator of webcam or video-capture output being streamed off-host. It is a coarse, protocol-based detection and does not identify the capturing process. Correlate with endpoint telemetry for camera-device access."
    mitre_tactic = "Collection"
    mitre_technique = "T1125"
    mitre_technique_name = "Video Capture"
    log_prerequisites = "Perimeter firewall or proxy logs normalised to UDM NETWORK_CONNECTION with principal.hostname (or principal.ip), target.ip and target.port populated. Source host name resolution (DHCP/asset enrichment) improves $primary_entity quality."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Authorised live-streaming or broadcast workstations (RTMP to streaming platforms), IP camera and CCTV/NVR systems, video conferencing or telepresence appliances using RTSP, media production and marketing teams, and digital signage clients."
    tuning_guidance = "Add known-good streaming and vendor domains to %global_allowed_domains. Per client, scope the rule away from broadcast or CCTV subnets and approved streaming hosts. If a client legitimately uses RTMP/RTSP, raise severity only when combined with endpoint camera-access telemetry."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 1935 or
      $net.target.port = 554 or
      $net.target.port = 8554
    )
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1125")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
