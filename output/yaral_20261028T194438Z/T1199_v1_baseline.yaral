/*
  MITRE Technique : T1199 - Trusted Relationship
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:47:56.972510+00:00
  Reference       : https://attack.mitre.org/techniques/T1199
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1199_IdP_Partner_Or_External_Account_Privilege_Grant {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a permission or role change in the identity provider that establishes or elevates a third-party trust relationship. This covers delegated administrator or partner/reseller relationship grants, cross-tenant trust or access grants, and administrative role assignments to external (guest/B2B) accounts. These changes give an outside organisation privileged access to the directory and are the pivot point of trusted-relationship abuse."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1199"
    mitre_technique_name = "Trusted Relationship"
    log_prerequisites = "Requires identity provider directory/audit logs ingested and normalised to UDM USER_CHANGE_PERMISSIONS, with metadata.description populated with the audit operation name and principal.user.userid / target.user.userid populated."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Legitimate onboarding of an MSP, reseller or contractor; planned delegated administration set-up by IT; approved guest or B2B collaboration with role assignment; identity governance or access-request automation granting roles to external accounts."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation or provisioning identities to %global_allowed_cloud_principals. Validate each alert against a change ticket for the third-party onboarding. If external accounts in a tenant do not use the '#EXT#' UPN marker, adjust the guest-account regex on target.user.userid to that tenant's convention."

  events:
    $iam.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    (
      $iam.metadata.description = /(delegated\s+admin|granular\s+delegated|partner\s+(relationship|link|admin|access)|reseller|cross[- ]tenant\s+(access|trust|policy)|b2b\s+(collaboration|direct))/ nocase
      or
      (
        $iam.target.user.userid = /#EXT#/ nocase
        and $iam.metadata.description = /(add|assign|grant|elevat).*(role|admin|privilege)/ nocase
      )
    )
    not $iam.principal.user.userid in %global_allowed_admin_users
    not $iam.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1199")
    $primary_entity = array_distinct($iam.target.user.userid)
    $acting_user = array_distinct($iam.principal.user.userid)
    $source_ips = array_distinct($iam.principal.ip)
    $operation = array_distinct($iam.metadata.description)

  condition:
    $iam
}
