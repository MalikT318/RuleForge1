/*
  MITRE Technique : T1547.003 - Time Providers
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:26:32.648955+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_003_Time_Provider_DllName_Registry_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a modification of the DllName value under a W32Time TimeProviders subkey where the DLL is not a stock Windows time provider in System32. Registering a time provider DLL gives boot-time persistence that runs as Local Service. The rule detects the registry state change itself, so it still fires when command-line logging is evaded or the registration is done through API calls, scripts or renamed tooling."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.003"
    mitre_technique_name = "Boot or Logon Autostart Execution: Time Providers"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry value set events, Event ID 13) that populates target.registry.registry_key and target.registry.registry_value_name. Registry auditing must cover HKLM\\SYSTEM\\CurrentControlSet\\Services\\W32Time\\TimeProviders."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows servicing and feature updates touching W32Time, hypervisor integration tooling (virtual machine guest additions) registering a time provider, third-party NTP or precision-time agents (for example PTP or GPS clock software), and admin deployment tools or GPO scripts reconfiguring time providers."
    tuning_guidance = "Add approved installer, deployment and RMM binaries to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. Vendor time provider DLLs seen across the estate can be reviewed and added to the DLL allowlist regex. This rule covers REGISTRY_MODIFICATION only; if the telemetry emits first-time value writes as REGISTRY_CREATION, deploy a sibling rule with that event type. Investigate by resolving the DLL path in registry_value_data and checking for a recent FILE_CREATION of that DLL."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\services\\w32time\\timeproviders\\[^\\]+$/ nocase
    $reg.target.registry.registry_value_name = /^dllname$/ nocase
    not $reg.target.registry.registry_value_data = /^(?:(?:%systemroot%|%windir%|[a-z]:\\windows)\\system32\\)?(?:w32time|vmictimeprovider)\.dll$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.003")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $dll_value = array_distinct($reg.target.registry.registry_value_data)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
