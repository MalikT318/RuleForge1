/*
  MITRE Technique : T1036.009 - Break Process Trees
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:11:09.949187+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_009_Linux_Init_Adopted_Exec_From_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process launched directly by init/systemd (PID 1) whose image resides in a world-writable staging directory (/tmp, /var/tmp, /dev/shm, /run/user). A double-fork or daemon() call orphans the payload so init adopts it, breaking the original process tree. Legitimate services almost never execute binaries from these locations, so this lineage anomaly indicates a possible detached payload."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.009"
    mitre_technique_name = "Masquerading: Break Process Trees"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry with populated parent (principal.process) and child (target.process) image paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Transient systemd units or timers that run staged scripts or binaries from /tmp or /var/tmp, CI/CD and build agents, container runtimes, software installers and self-updaters that unpack to /tmp and are re-parented to init, developers testing daemons, and RMM or deployment agents."
    tuning_guidance = "Add approved deployment, update and RMM binaries to %global_allowed_admin_tools, and approved scripting parents or hosts to %global_allowed_script_hosts. Exclude build or CI hosts via %global_allowed_script_hosts. Consider adding approved service accounts to %global_allowed_service_accounts after review."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /(^|\/)(init|systemd)$/ nocase
    $proc.target.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/user\/[0-9]+)\// nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1036.009")
    $primary_entity = array_distinct($proc.principal.hostname)
    $child_image = array_distinct($proc.target.process.file.full_path)
    $parent_image = array_distinct($proc.principal.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
