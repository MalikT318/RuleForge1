/*
  MITRE Technique : T1137.003 - Outlook Forms
  Tactic(s)       : Persistence
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:17:25.204436+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_003_Outlook_Forms_Security_Registry_Then_Form_File_Drop {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A non-Outlook process modifies the Outlook Security registry settings that govern custom form script and unsafe item behaviour, then writes an Outlook form artifact (.oft template or a file in the Microsoft Forms directory) on the same host within 10 minutes. This sequence is consistent with an adversary enabling custom form code execution and planting a malicious form for persistence. It relies on registry and file telemetry rather than process command lines."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.003"
    mitre_technique_name = "Office Application Startup: Outlook Forms"
    log_prerequisites = "Requires Windows endpoint telemetry that normalises registry modification and file creation events with the initiating process path (EDR or Sysmon event IDs 12/13/14 and 11)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy or Intune/MDM pushing Office security settings, Office deployment and upgrade tooling, legitimate Outlook form developers, helpdesk scripts that migrate or restore forms, and profile-migration tools."
    tuning_guidance = "Add approved deployment and configuration tooling to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, and approved remote management tools to %global_allowed_remote_mgmt. If a client has Outlook form developers, consider narrowing by user or raising the registry value-name specificity."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Office\\[0-9.]+\\Outlook\\Security/ nocase
    $reg.target.registry.registry_value_name = /(script|form|unsafe|level)/ nocase
    not $reg.principal.process.file.full_path = /\\outlook\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path in %global_allowed_remote_mgmt
    $reg.principal.hostname = $hostname

    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(\\Microsoft\\Forms\\[^\\]+|\.oft)$/ nocase
    not $file.principal.process.file.full_path = /\\outlook\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_remote_mgmt
    $file.principal.hostname = $hostname

    $reg.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1137.003")
    $primary_entity = array_distinct($hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_name)
    $registry_writers = array_distinct($reg.principal.process.file.full_path)
    $form_files = array_distinct($file.target.file.full_path)
    $file_writers = array_distinct($file.principal.process.file.full_path)
    $affected_users = array_distinct($file.principal.user.userid)

  condition:
    $reg and $file
}
