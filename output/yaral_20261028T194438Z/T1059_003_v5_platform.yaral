/*
  MITRE Technique : T1059.003 - Windows Command Shell
  Tactic(s)       : Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:10:22.087536+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_003_CMD_AutoRun_Registry_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a non-empty AutoRun value being written under the Command Processor registry key (HKLM or HKCU). Windows runs this value every time cmd.exe starts, so the setting turns any interactive or scripted shell launch into a covert execution and persistence trigger. This rule watches registry telemetry rather than process command lines, so it complements existing PROCESS_LAUNCH detections for T1059.003."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.003"
    mitre_technique_name = "Command and Scripting Interpreter: Windows Command Shell"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (registry value set events, Sysmon Event ID 13) normalised to UDM REGISTRY_MODIFICATION with registry key, value name and principal process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy logon or environment scripts that set a cmd AutoRun for console customisation (doskey macros, prompt settings), developer toolchains that configure the command prompt (for example Visual Studio or Anaconda initialisation), and IT configuration management or GPO preference deployments."
    tuning_guidance = "Add approved configuration and deployment tooling to %global_allowed_admin_tools and approved administrator accounts to %global_allowed_admin_users. Add endpoint security agents to %global_allowed_security_tools. Review the autorun_value outcome; benign values are usually doskey or prompt customisations, while values that call scripts from user-writable paths, interpreters or download utilities should be escalated."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Microsoft\\Command Processor$/ nocase
    $reg.target.registry.registry_value_name = /^AutoRun$/ nocase
    $reg.target.registry.registry_value_data != ""
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1059.003")
    $primary_entity = array_distinct($reg.principal.hostname)
    $acting_user = array_distinct($reg.principal.user.userid)
    $acting_process = array_distinct($reg.principal.process.file.full_path)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $autorun_value = array_distinct($reg.target.registry.registry_value_data)

  condition:
    $reg
}
