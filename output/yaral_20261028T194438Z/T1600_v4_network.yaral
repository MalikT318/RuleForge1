/*
  MITRE Technique : T1600 - Weaken Encryption
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:04:41.708129+00:00
  Reference       : https://attack.mitre.org/techniques/T1600
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_Cleartext_Legacy_Mgmt_Protocol_Across_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects connections crossing the network perimeter to destinations outside internal address space on cleartext legacy remote-management ports (telnet, rexec, rlogin). Network devices whose encryption has been weakened or disabled (T1600), or whose management plane has been forced to fall back to cleartext, expose credentials and configuration in transit. This is the network-side view of that downgrade, complementing endpoint and device-config coverage."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1600"
    mitre_technique_name = "Weaken Encryption"
    log_prerequisites = "Firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legacy OT/ICS or embedded equipment that only supports telnet, authorised vulnerability scanning or penetration tests, out-of-band console servers, lab environments, and vendor support sessions to legacy gear."
    tuning_guidance = "Add approved management or jump-host source addresses to %global_allowed_mgmt_sources and authorised scanners to %global_allowed_scanners. Review recurring sources and migrate them to SSH. To widen coverage, add further cleartext management ports to the port condition."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 23 or
      $net.target.port = 512 or
      $net.target.port = 513
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1600")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
