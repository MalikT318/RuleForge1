/*
  MITRE Technique : T1552 - Unsecured Credentials
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:43:51.154339+00:00
  Reference       : https://attack.mitre.org/techniques/T1552
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_IdP_Credential_Reset_Then_External_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A password or credential change on an account is performed by a different identity, and the same account then signs in from a non-internal source address within 10 minutes. This pattern fits credentials recovered from insecure storage (such as secrets in vaults, tickets, scripts or repositories) being used to reset and take over an account."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552"
    mitre_technique_name = "Unsecured Credentials"
    log_prerequisites = "Requires identity provider directory audit logs (password change or reset events) and sign-in logs normalised to UDM USER_CHANGE_PASSWORD and USER_LOGIN, with principal.user.userid, target.user.userid and principal.ip populated."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Help-desk password resets followed by the user signing in from home or mobile networks, self-service password reset flows performed through a delegated portal, onboarding of new hires with admin-set initial passwords, and automated identity-governance tooling rotating credentials."
    tuning_guidance = "Add help-desk and IAM administrator accounts to %global_allowed_admin_users. Add identity-governance and rotation automation to %global_allowed_service_accounts. Consider excluding accounts managed by credential vaulting through %global_allowed_service_accounts. Sign-in outcome fields vary by source, so if failed sign-ins create noise, add a client-specific success filter."

  events:
    $pwd.metadata.event_type = "USER_CHANGE_PASSWORD"
    $pwd.target.user.userid = $user
    $pwd.principal.user.userid != ""
    $pwd.principal.user.userid != $pwd.target.user.userid
    not $pwd.principal.user.userid in %global_allowed_admin_users
    not $pwd.principal.user.userid in %global_allowed_service_accounts

    $login.metadata.event_type = "USER_LOGIN"
    $login.principal.user.userid = $user
    not $login.principal.ip in %rfc1918_internal
    not $login.principal.user.userid in %global_allowed_service_accounts

    $pwd.metadata.event_timestamp.seconds <= $login.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1552")
    $primary_entity = array_distinct($user)
    $changed_by = array_distinct($pwd.principal.user.userid)
    $login_source_ips = array_distinct($login.principal.ip)
    $login_count = count($login.metadata.id)

  condition:
    $pwd and $login
}
