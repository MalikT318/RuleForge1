/*
  MITRE Technique : T1134.005 - SID-History Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:02:01.886102+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_005_SID_History_Manipulation_From_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects a shell or script interpreter spawned by an unexpected parent (Office application, web server worker, print spooler, or database service) with a command line that references SID-History manipulation. Legitimate SID-History changes come from administrative sessions, not from these parents, so the lineage is a strong sign of exploitation or webshell activity attempting privilege escalation through SID-History injection."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.005"
    mitre_technique_name = "Access Token Manipulation: SID-History Injection"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Authorised AD domain migration tooling launched through a web-based admin portal or a database-driven automation job; IT automation hosted on an IIS or SQL Server host that legitimately calls SID-History APIs during a migration project; security testing exercises."
    tuning_guidance = "Add approved migration or admin tooling parent paths to %global_allowed_admin_tools, approved automation hosts or parents to %global_allowed_script_hosts, and named migration administrators to %global_allowed_admin_users. During a planned domain migration, temporarily scope the exclusions to the migration hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Unexpected parent: Office, web server, print spooler, database service
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|onenote|visio|w3wp|httpd|nginx|php-cgi|tomcat[0-9]*|spoolsv|sqlservr)\.exe$/ nocase

    // Child: shell or script interpreter
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase

    // SID-History manipulation indicators (AD attribute and API names)
    $proc.target.process.command_line = /(sid[-_ ]?history|DsAddSidHistory|AddSidHistory)/ nocase

    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1134.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
