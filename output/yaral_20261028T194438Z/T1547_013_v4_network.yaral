/*
  MITRE Technique : T1547.013 - XDG Autostart Entries
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:40:48.771495+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_013_XDG_Autostart_Child_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an outbound connection to a non-internal address from a process that runs out of a user-writable or staging location (/tmp, /var/tmp, /dev/shm, ~/.config, ~/.local, ~/.cache) and was spawned by a desktop session manager or autostart launcher. This is the network footprint of a malicious XDG Autostart (.desktop) entry calling out at user login, e.g. for C2 beaconing or payload retrieval."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.013"
    mitre_technique_name = "Boot or Logon Autostart Execution: XDG Autostart Entries"
    log_prerequisites = "Requires Linux endpoint network telemetry (EDR or auditd socket/connect events) that populates the initiating process path and its parent process path on NETWORK_CONNECTION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "User-installed per-user applications that legitimately autostart from ~/.local or ~/.config (chat clients, cloud sync agents, AppImages, VPN clients); developer tooling run from /tmp by an IDE session; vendor updaters started by the desktop session; IT-deployed RMM or inventory agents launched at login."
    tuning_guidance = "Add approved autostart binaries to %global_allowed_admin_tools or %global_allowed_remote_mgmt, and EDR/AV agents to %global_allowed_security_tools. Pair this rule with file-creation detections on .desktop files in /etc/xdg/autostart and ~/.config/autostart for context. On servers without a desktop environment this rule should be near-silent, so any hit there is high priority. The systemd parent alternative covers systemd-xdg-autostart-generator launches; remove it if it is noisy in a given environment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.parent_process.file.full_path = /(^|\/)(gnome-session-binary|gnome-session|gnome-session-autostart|xfce4-session|ksmserver|startplasma-x11|startplasma-wayland|plasma-session|lxsession|mate-session|cinnamon-session|budgie-session|dex|xdg-autostart|systemd)$/ nocase
    $net.principal.process.file.full_path = /^(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/|\/(home\/[^\/]+|root)\/\.(config|local|cache)\/)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1547.013")
    $primary_entity = array_distinct($net.principal.hostname)
    $user = array_distinct($net.principal.user.userid)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $parent_process = array_distinct($net.principal.process.parent_process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
