/*
  MITRE Technique : T1609 - Container Administration Command
  Tactic(s)       : Execution
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:27:48.088866+00:00
  Reference       : https://attack.mitre.org/techniques/T1609
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1609_K8s_Pod_Exec_Attach_Interactive_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Kubernetes API server audit event in which an identity opens an exec or attach session into a running pod (kubectl exec / attach equivalent). This is the control-plane mechanism adversaries use to run commands inside containers. Built for the Kubernetes control plane, as an alternative to endpoint-based Windows process rules."
    mitre_tactic = "Execution"
    mitre_technique = "T1609"
    mitre_technique_name = "Container Administration Command"
    log_prerequisites = "Kubernetes API server audit logging enabled at Metadata level or higher for the pods/exec and pods/attach subresources, and ingested into Chronicle. The parser must map the audit objectRef resource/subresource to target.resource.name (for example 'pods/exec') and the requesting identity to principal.user.userid."
    platform = "Containers"
    log_source = "container"
    false_positives = "Engineers and SREs debugging workloads, break-glass troubleshooting, CI/CD or GitOps tooling that runs commands in pods, platform operators and health-check automation, and security or diagnostic tooling that attaches to pods."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts and named platform administrators to %global_allowed_admin_users. Add approved CI/CD or diagnostic identities to %global_allowed_service_accounts. Consider raising severity for production namespaces or for identities that do not normally use exec."

  events:
    $audit.metadata.event_type = "USER_RESOURCE_ACCESS"
    $audit.target.resource.name = /pods\/(exec|attach)/ nocase
    $audit.principal.user.userid != ""
    not $audit.principal.user.userid = /^system:(node|kube-|serviceaccount:kube-system)/ nocase
    not $audit.principal.user.userid in %global_allowed_service_accounts
    not $audit.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1609")
    $primary_entity = array_distinct($audit.principal.user.userid)
    $target_resources = array_distinct($audit.target.resource.name)
    $source_ips = array_distinct($audit.principal.ip)

  condition:
    $audit
}
