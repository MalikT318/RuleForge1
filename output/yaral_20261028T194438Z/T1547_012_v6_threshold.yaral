/*
  MITRE Technique : T1547.012 - Print Processors
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:39:38.889822+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_012_Print_Processor_Registry_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated registry modifications beneath the Print Processors key of the Print Environments hive on a single host within 10 minutes. A single write can be a legitimate printer driver install, but a burst of writes to this persistence location suggests that a print processor DLL is being registered for loading by the print spooler service."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.012"
    mitre_technique_name = "Boot or Logon Autostart Execution: Print Processors"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event IDs 12/13/14 or equivalent) normalised to UDM REGISTRY_MODIFICATION, with target.registry.registry_key populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Printer driver and print-management software installs or upgrades, Windows servicing (TrustedInstaller, TiWorker), print server migrations, and IT deployment tooling that provisions print queues."
    tuning_guidance = "Add approved deployment or print-management binaries to %global_allowed_admin_tools. Raise the #reg threshold on print servers, where installs are frequent. Review the $registry_keys and $writing_processes outcomes to confirm that the Driver value points to a DLL in the print-processor directory."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control\\Print\\Environments\\[^\\]+\\Print Processors\\/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|MsMpEng|MsSense|SenseIR)\.exe$/ nocase

  match:
    $host over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1547.012")
    $primary_entity = array_distinct($host)
    $event_count = count($reg.metadata.id)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $writing_processes = array_distinct($reg.principal.process.file.full_path)
    $users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 3
}
