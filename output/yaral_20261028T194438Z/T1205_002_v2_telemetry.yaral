/*
  MITRE Technique : T1205.002 - Socket Filters
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:12:33.237816+00:00
  Reference       : https://attack.mitre.org/techniques/T1205/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_002_Linux_Volatile_Dir_Process_Creates_Runtime_Pid_Lock {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process executing from a volatile, world-writable directory (/dev/shm, /tmp, /var/tmp) that creates a PID or lock file in /run or /var/run. Passive socket-filter backdoors (libpcap pcap_setfilter or setsockopt SO_ATTACH_FILTER) typically run from memory-backed paths and use a runtime PID or lock file as a single-instance marker. The rule detects this file artifact instead of command-line activity, so it still fires when process command-line logging is evaded or the binary is renamed."
    mitre_tactic = "Stealth, Persistence, Command and Control"
    mitre_technique = "T1205.002"
    mitre_technique_name = "Traffic Signaling: Socket Filters"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-write (watch rules on /run and /var/run) that populates the principal process path and target file path for FILE_CREATION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Self-extracting or AppImage-style applications that run from /tmp, developer and CI build jobs, software installers that stage and run binaries from /tmp or /var/tmp, containers or test harnesses that start daemons from temporary directories."
    tuning_guidance = "Add approved installer, deployment or build-agent binaries to %global_allowed_admin_tools. Add EDR or security agent binaries to %global_allowed_security_tools. For hosts that legitimately run daemons from temporary paths (CI runners), scope them out by host at the SOAR or exclusion layer. Review the primary process path and the created file path before escalating."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /^\/(dev\/shm|tmp|var\/tmp)\// nocase
    $file.target.file.full_path = /^\/(var\/)?run\/[^\/]+\.(pid|lock)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1205.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $process_path = array_distinct($file.principal.process.file.full_path)
    $created_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
