/*
  MITRE Technique : T1491.001 - Internal Defacement
  Tactic(s)       : Impact
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:43:52.547110+00:00
  Reference       : https://attack.mitre.org/techniques/T1491/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_001_ESXi_Login_Banner_Defacement {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of the ESXi pre-login and post-login messages, which ransomware and destructive actors use for internal defacement and ransom notes. Covers shell writes to /etc/motd and /etc/issue, and esxcli changes to the DCUI/console welcome message (system welcomemsg set, or the Annotations/WelcomeMessage advanced setting)."
    mitre_tactic = "Impact"
    mitre_technique = "T1491.001"
    mitre_technique_name = "Defacement: Internal Defacement"
    log_prerequisites = "ESXi shell command auditing forwarded to Chronicle and parsed into PROCESS_LAUNCH events with target.process.command_line populated. Requires shell.log or hostd command logging."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators legitimately setting a corporate login banner or legal notice. Configuration management and host-profile or automation tooling that pushes a standard MOTD. Initial host build and provisioning scripts."
    tuning_guidance = "Add approved automation and provisioning binaries to %global_allowed_admin_tools and named administrators to %global_allowed_admin_users. After the baseline banner is deployed, the rule should be near-silent. Any later change to the banner outside a change window is high-fidelity."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(esxcli\s+system\s+welcomemsg\s+set|esxcli\s+system\s+settings\s+advanced\s+set.*Annotations\/WelcomeMessage|(>|>>|\btee\b(\s+-a)?|\bsed\s+-i\b[^|;&]*)\s*[^|;&]*\/etc\/(motd|issue)(\.net)?(\s|$|;|&|\|)|\b(cp|mv)\s+\S+\s+\/etc\/(motd|issue)(\.net)?(\s|$))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1491.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
