/*
  MITRE Technique : T1571 - Non-Standard Port
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:17:54.172175+00:00
  Reference       : https://attack.mitre.org/techniques/T1571
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1571_HTTPS_On_NonStandard_Port_Firewall {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Perimeter firewall application identification classifies an outbound connection as HTTPS while the destination port is neither 443 nor 8443. This protocol/port mismatch is how adversaries tunnel C2 over TLS on unexpected ports to evade port-based filtering. The rule uses only perimeter-observable fields, so it covers Windows client egress without endpoint process fields. The request's 'alternate platform' angle conflicts with its mandatory Windows platform requirement, so the mandatory Windows platform was applied."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1571"
    mitre_technique_name = "Non-Standard Port"
    log_prerequisites = "Firewall or proxy logs with deep-packet or application identification populating network.application_protocol, plus target.ip and target.port, normalised to NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Vendor software or SaaS agents using TLS on custom ports (for example 8088, 9443, 4443), VPN and remote-access gateways, management consoles on alternate HTTPS ports, and application-ID misclassification of non-HTTP TLS services."
    tuning_guidance = "Add known-good destination domains to %global_allowed_domains and approved scanner or testing sources to %global_allowed_scanners. If a client legitimately uses another HTTPS port such as 4443 or 9443, add a matching target.port != <port> line. Use %global_allowed_mgmt_sources to exclude approved management sources. Raise severity for servers that should never initiate outbound HTTPS on odd ports."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.application_protocol = "HTTPS"
    $net.target.port > 0
    $net.target.port != 443
    $net.target.port != 8443
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1571")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
