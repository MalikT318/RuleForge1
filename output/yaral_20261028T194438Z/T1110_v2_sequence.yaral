/*
  MITRE Technique : T1110 - Brute Force
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:02:57.855672+00:00
  Reference       : https://attack.mitre.org/techniques/T1110
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1110_Linux_Failed_Logins_Then_Success {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a burst of failed Linux logins against one account on one host, followed by a successful login for the same account on the same host within 10 minutes. This pattern indicates a password-guessing or brute-force attempt that succeeded."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1110"
    mitre_technique_name = "Brute Force"
    log_prerequisites = "Requires Linux authentication telemetry (sshd, PAM, login, or auditd USER_LOGIN records, or EDR login events) normalised to USER_LOGIN with security_result.action populated as BLOCK for failures and ALLOW for successes, and with target.user.userid and target.hostname populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Users who mistype passwords repeatedly and then log in correctly, expired or rotated credentials on automation, misconfigured scripts or monitoring agents retrying with stale passwords, and authorised penetration tests or scanners."
    tuning_guidance = "Add service and automation accounts to %global_allowed_service_accounts. Add vulnerability scanners and authorised testing sources to %global_allowed_scanners. Raise or lower the failure count in the condition (#fail >= 5) to fit the client's baseline. Narrow the join further by adding principal.ip as a second placeholder if clients have noisy shared bastions."

  events:
    $fail.metadata.event_type = "USER_LOGIN"
    $fail.security_result.action = "BLOCK"
    $fail.target.user.userid != ""
    $fail.target.user.userid = $user
    $fail.target.hostname = $hostname
    not $fail.target.user.userid in %global_allowed_service_accounts
    not $fail.principal.ip in %global_allowed_scanners

    $success.metadata.event_type = "USER_LOGIN"
    $success.security_result.action = "ALLOW"
    $success.target.user.userid != ""
    $success.target.user.userid = $user
    $success.target.hostname = $hostname
    not $success.target.user.userid in %global_allowed_service_accounts

    $fail.metadata.event_timestamp.seconds <= $success.metadata.event_timestamp.seconds

  match:
    $user, $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1110")
    $primary_entity = array_distinct($hostname)
    $targeted_user = array_distinct($user)
    $failed_login_count = count($fail.metadata.id)
    $failed_source_ips = array_distinct($fail.principal.ip)
    $success_source_ips = array_distinct($success.principal.ip)
    $first_failure_time = min($fail.metadata.event_timestamp.seconds)
    $success_time = max($success.metadata.event_timestamp.seconds)

  condition:
    #fail >= 5 and #success >= 1
}
