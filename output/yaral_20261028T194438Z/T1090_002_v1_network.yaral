/*
  MITRE Technique : T1090.002 - External Proxy
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:28:20.460672+00:00
  Reference       : https://attack.mitre.org/techniques/T1090/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1090_002_External_Proxy_Port_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an internal host opening an outbound connection through the perimeter to an external destination on a TCP port conventionally used by SOCKS and HTTP proxy or port-redirector services (1080, 1081, 3128, 3129, 8118, 9050, 9150). Internal clients should normally reach the internet through the sanctioned egress path, so a direct connection to an external proxy service can indicate an external proxy relaying C2 traffic."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1090.002"
    mitre_technique_name = "Proxy: External Proxy"
    log_prerequisites = "Firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Requires %rfc1918_internal to be populated for the tenant."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Corporate or sanctioned web-proxy and secure web gateway egress on 3128 or 1080, developer or QA use of proxy services, privacy-browser or Tor use that is permitted by policy, security testing and scanning sources, and cloud-hosted proxy or CASB services."
    tuning_guidance = "Add known-good proxy and gateway destination names to %global_allowed_domains, add authorised scanner source addresses to %global_allowed_scanners, and add approved remote-management source addresses to %global_allowed_mgmt_sources. Extend or trim the port list per customer if the sanctioned egress proxy uses one of these ports."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 1080 or
      $net.target.port = 1081 or
      $net.target.port = 3128 or
      $net.target.port = 3129 or
      $net.target.port = 8118 or
      $net.target.port = 9050 or
      $net.target.port = 9150
    )
    $net.principal.ip in %rfc1918_internal
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1090.002")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
