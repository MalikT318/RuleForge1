/*
  MITRE Technique : T1685.005 - Clear Windows Event Logs
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:23:21.731507+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_005_EventLog_Disable_Then_EVTX_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a host where Windows Event Log configuration is tampered with in the registry (EventLog service or channel Start/Enabled values) and, within ten minutes, the stored .evtx log files under winevt\\Logs are deleted. This pairing indicates log clearing by direct file removal and logging suppression, and does not depend on wevtutil or PowerShell command lines."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.005"
    mitre_technique_name = "Clear Windows Event Logs"
    log_prerequisites = "Requires EDR or Sysmon-equivalent registry modification telemetry and file deletion telemetry (for example Sysmon event IDs 13 and 23/26) with a populated principal process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Log management or hardening tools changing channel settings and rotating logs, GPO-driven event log reconfiguration, imaging or sysprep workflows, the Windows Event Log service removing archived logs under a retention policy, and admins decommissioning servers."
    tuning_guidance = "Add approved admin, hardening and log-management binaries to %global_allowed_admin_tools and EDR or security agents to %global_allowed_security_tools. If the Windows Event Log service's own archive cleanup causes noise, validate that the deleting process is the expected service host for the log service and allowlist it through a tenant-specific entry."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(Services\\EventLog(\\(Security|System|Application))?|WINEVT\\Channels\\[^\\]+)$/ nocase
    $reg.target.registry.registry_value_name = /^(Start|Enabled)$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $hostname

    $file.metadata.event_type = "FILE_DELETION"
    $file.target.file.full_path = /\\winevt\\logs\\[^\\]+\.evtx$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    $reg.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1685.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $deleted_log_files = array_distinct($file.target.file.full_path)
    $deleted_file_count = count($file.metadata.id)
    $modified_registry_keys = array_distinct($reg.target.registry.registry_key)
    $reg_actor_processes = array_distinct($reg.principal.process.file.full_path)
    $delete_actor_processes = array_distinct($file.principal.process.file.full_path)
    $acting_users = array_distinct($file.principal.user.userid)

  condition:
    $reg and $file
}
