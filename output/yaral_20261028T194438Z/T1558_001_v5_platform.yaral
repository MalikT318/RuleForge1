/*
  MITRE Technique : T1558.001 - Golden Ticket
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:40:26.085053+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_001_Golden_Ticket_Forge_CommandLine_Flags {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Critical"
    description = "Detects a process launch whose command line combines the parameters needed to forge a Kerberos TGT: a domain SID (S-1-5-21-*), a KRBTGT-derived RC4 or AES key, and ticket-forging or injection options such as ticket output, pass-the-ticket or lifetime settings. This matches the argument combination rather than any tool filename, so it survives binary renames and recompiles."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.001"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Golden Ticket"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command-line capture (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Authorised red-team or purple-team exercises, internal Kerberos security testing, and incident-response or AD-recovery staff validating KRBTGT reset procedures. Legitimate administrative tools almost never pass a domain SID together with a raw KRBTGT key and ticket options."
    tuning_guidance = "Add authorised testing sources to %global_allowed_scanners and approved security tooling to %global_allowed_security_tools. Treat any hit outside a scheduled engagement as a confirmed compromise: reset the KRBTGT password twice and investigate for credential dumping on domain controllers."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /[\/-]sid:\s*"?S-1-5-21-[0-9-]+/ nocase
    $proc.target.process.command_line = /[\/-](krbtgt|rc4|aes256|aes128):\s*"?[0-9a-f]{32,64}/ nocase
    $proc.target.process.command_line = /[\/-](ptt|ticket|endin|renewmax)(:|=|\s|$)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_scanners
    not $proc.target.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1558.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $forging_process = array_distinct($proc.target.process.file.full_path)

  condition:
    $proc
}
