/*
  MITRE Technique : T1056.002 - GUI Input Capture
  Tactic(s)       : Collection, Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:46:51.684043+00:00
  Reference       : https://attack.mitre.org/techniques/T1056/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1056_002_Script_Host_Writes_Credential_Capture_File {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a script interpreter (PowerShell, WSH, MSHTA) writing a credential-named data file into a user-writable location. Fake credential prompts (for example Get-Credential or a spoofed dialog) usually save the captured username and password to disk before exfiltration. This rule works on the resulting file artifact, so it still fires when command-line logging is evaded or obfuscated."
    mitre_tactic = "Collection, Credential Access"
    mitre_technique = "T1056.002"
    mitre_technique_name = "Input Capture: GUI Input Capture"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon Event ID 11) that populates the writing process path and the target file path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrator scripts that export credential objects for automation (Export-Clixml), password-manager or onboarding scripts, IT provisioning tooling, and developer scripts writing test credential files."
    tuning_guidance = "Add approved script hosts and parent tooling to %global_allowed_script_hosts, deployment and RMM binaries to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. If a client has a sanctioned credential-export workflow, narrow the file-name keyword group or add that user to %global_allowed_admin_users."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(powershell|pwsh|powershell_ise|wscript|cscript|mshta)\.exe$/ nocase
    $file.target.file.full_path = /\\(Users\\[^\\]+\\(AppData|Desktop|Documents|Downloads)|Users\\Public|ProgramData|Windows\\Temp)\\.*[^\\]*(cred|passw|pwd|logon|login|secret|captured|harvest)[^\\]*\.(txt|xml|log|dat|json|csv|tmp)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1056.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $user = array_distinct($file.principal.user.userid)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $created_file = array_distinct($file.target.file.full_path)

  condition:
    $file
}
