/*
  MITRE Technique : T1069.003 - Cloud Groups
  Tactic(s)       : Discovery
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:00:39.220972+00:00
  Reference       : https://attack.mitre.org/techniques/T1069/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1069_003_SaaS_Login_Then_Group_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A user logs in from an external source and, within ten minutes, makes at least three API calls that list or describe groups, roles, memberships or attached policies. This pattern matches post-compromise cloud permission group discovery by an adversary using a freshly authenticated session."
    mitre_tactic = "Discovery"
    mitre_technique = "T1069.003"
    mitre_technique_name = "Permission Groups Discovery: Cloud Groups"
    log_prerequisites = "Requires cloud or SaaS control-plane audit logs normalised to UDM, with USER_LOGIN and USER_RESOURCE_ACCESS events. metadata.product_event_type must be populated with the API or operation name, and principal.user.userid must be populated on both event types."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "IAM or access-review tooling, identity governance and audit platforms, administrators doing role clean-up after login, onboarding and offboarding automation, and compliance scanners that enumerate groups and roles."
    tuning_guidance = "Add expected automation identities to %global_allowed_service_accounts, %global_allowed_cloud_principals or %global_allowed_admin_users. Add authorised scanner identities to %global_allowed_scanners. Raise or lower the #access threshold in the condition to fit the client's baseline. Tighten the operation-name regex if a client's audit log uses non-standard operation names."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.principal.user.userid = $user
    not $login.principal.ip in %rfc1918_internal
    not $login.principal.user.userid in %global_allowed_service_accounts
    not $login.principal.user.userid in %global_allowed_admin_users
    not $login.principal.user.userid in %global_allowed_cloud_principals

    $access.metadata.event_type = "USER_RESOURCE_ACCESS"
    $access.principal.user.userid = $user
    $access.metadata.product_event_type = /((list|get|describe|enumerate)[_\.\-]?[a-z_\.\-]{0,30}(group|role|member|polic)|(group|role|member)s?[_\.\-]?(list|get))/ nocase
    not $access.principal.user.userid in %global_allowed_service_accounts
    not $access.principal.user.userid in %global_allowed_admin_users
    not $access.principal.user.userid in %global_allowed_cloud_principals
    not $access.principal.user.userid in %global_allowed_scanners

    $login.metadata.event_timestamp.seconds <= $access.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1069.003")
    $primary_entity = array_distinct($user)
    $login_source_ips = array_distinct($login.principal.ip)
    $enumeration_calls = array_distinct($access.metadata.product_event_type)
    $enumeration_count = count($access.metadata.id)

  condition:
    $login and #access >= 3
}
