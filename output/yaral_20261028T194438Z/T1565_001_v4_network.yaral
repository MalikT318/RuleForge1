/*
  MITRE Technique : T1565.001 - Stored Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:39:37.963203+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_001_Linux_Shell_Or_DB_Client_To_External_Database {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux shell or command-line database client opening an outbound connection to an external (non-internal) address on a well-known database port (MySQL, PostgreSQL, MSSQL, Oracle, MongoDB, Redis). Hands-on use of a CLI client to reach a remote datastore is a network-side indicator of data being inserted, altered or deleted at rest. It is a heuristic: the connection alone does not prove data was changed, so correlate with endpoint file and process telemetry and the database audit log."
    mitre_tactic = "Impact"
    mitre_technique = "T1565.001"
    mitre_technique_name = "Data Manipulation: Stored Data Manipulation"
    log_prerequisites = "Requires Linux endpoint network telemetry (EDR or auditd socket/connect events) that populates principal.process.file.full_path, target.ip and target.port on NETWORK_CONNECTION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "DBAs and developers using CLI clients against cloud-managed or off-site databases (RDS, Cloud SQL, managed Redis); backup, migration or replication scripts run from a shell; legitimate third-party or SaaS-hosted database endpoints; CI/CD jobs running integration tests against external databases."
    tuning_guidance = "Add approved client binaries or wrapper scripts to %global_allowed_admin_tools, automation and DBA accounts to %global_allowed_service_accounts or %global_allowed_admin_users, and approved source hosts to %global_allowed_mgmt_sources. Extend the port list for client-specific database services. Raise severity for hosts that hold production data."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|mysql|mariadb|psql|redis-cli|mongo|mongosh|sqlplus|sqlcmd|sqlite3)$/ nocase
    (
      $net.target.port = 3306 or
      $net.target.port = 5432 or
      $net.target.port = 1433 or
      $net.target.port = 1521 or
      $net.target.port = 27017 or
      $net.target.port = 6379
    )
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1565.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $client_process = array_distinct($net.principal.process.file.full_path)
    $client_user = array_distinct($net.principal.user.userid)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
