/*
  MITRE Technique : T1555.003 - Credentials from Web Browsers
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:55:43.516688+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_003_Browser_Credential_Store_Read_Then_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A non-browser process reads a browser credential store (Chromium-family Login Data, Web Data or Local State, or Firefox logins.json or key4.db) and the same process then connects to an external address within 10 minutes. This pattern is typical of credential stealers that harvest browser secrets and exfiltrate them. It complements command-line rules by relying on file-access and network telemetry."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.003"
    mitre_technique_name = "Credentials from Password Stores: Credentials from Web Browsers"
    log_prerequisites = "Requires EDR file-read (file access) telemetry that records the accessing process, plus network connection telemetry with process attribution, from the same endpoint sensor."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Browser profile migration or sync utilities, enterprise backup and imaging agents, endpoint security or DLP agents scanning profile data, password manager import tools, helpdesk profile-repair tools that read the profile and then call home."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools, backup software to %global_allowed_backup_processes, and approved IT tooling to %global_allowed_admin_tools. If browser helper or updater binaries not in the built-in exclusion regex generate noise, add them to %global_allowed_admin_tools. Raise the risk score or require additional context if a client runs profile-migration tooling regularly."

  events:
    $read.metadata.event_type = "FILE_READ"
    $read.target.file.full_path = /\\(User Data\\([^\\]+\\)?(Login Data( For Account)?|Web Data|Local State)|Mozilla\\Firefox\\Profiles\\[^\\]+\\(logins\.json|key4\.db))$/ nocase
    not $read.principal.process.file.full_path = /\\(chrome|msedge|firefox|brave|opera|vivaldi|chromium|iexplore|msedgewebview2|GoogleUpdate|MicrosoftEdgeUpdate|elevation_service|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $read.principal.process.file.full_path in %global_allowed_security_tools
    not $read.principal.process.file.full_path in %global_allowed_backup_processes
    not $read.principal.process.file.full_path in %global_allowed_admin_tools
    $read.principal.hostname = $hostname
    $read.principal.process.file.full_path = $proc_path

    $net.metadata.event_type = "NETWORK_CONNECTION"
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    $net.principal.hostname = $hostname
    $net.principal.process.file.full_path = $proc_path

    $read.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname, $proc_path over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1555.003")
    $primary_entity = array_distinct($read.principal.hostname)
    $accessing_process = array_distinct($read.principal.process.file.full_path)
    $credential_files = array_distinct($read.target.file.full_path)
    $user = array_distinct($read.principal.user.userid)
    $destination_ips = array_distinct($net.target.ip)
    $read_count = count($read.metadata.id)

  condition:
    $read and $net
}
