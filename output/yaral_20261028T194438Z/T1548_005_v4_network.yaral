/*
  MITRE Technique : T1548.005 - Temporary Elevated Cloud Access
  Tactic(s)       : Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:34:22.437255+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_005_External_Privileged_Role_Activation_Or_Impersonation_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects state-changing HTTP API calls (POST/PUT/PATCH) from a non-internal source address to identity or IAM endpoints that activate eligible roles, elevate access, assume roles, or mint impersonation tokens. This is the network-side view of temporary elevated cloud access abuse. The rule keys on the API path semantics, not on a specific actor, tool or host."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.005"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Temporary Elevated Cloud Access"
    log_prerequisites = "Requires proxy, CASB, API gateway or cloud control-plane HTTP telemetry normalised to NETWORK_HTTP with network.http.method, target.url and principal.ip populated."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Legitimate administrators activating just-in-time roles from home or travel, break-glass procedures, CI/CD pipelines and automation using workload identities to assume roles or request tokens, and sanctioned third-party identity governance or privileged access management platforms."
    tuning_guidance = "Add approved admin accounts to %global_allowed_admin_users, automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and corporate egress or VPN addresses to %rfc1918_internal if they are represented as plain strings. Tighten the URL regex if the environment uses additional impersonation endpoints."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(POST|PUT|PATCH)$/ nocase
    $http.target.url = /(roleAssignmentScheduleRequests|roleEligibilityScheduleRequests|elevateAccess|privilegedAccess\/.*\/(roleAssignmentRequests|activate)|generateAccessToken|generateIdToken|signJwt|signBlob|implicitDelegation|AssumeRole|GetFederationToken|iam\/assignees|users\/[^\/]+\/roles|impersonat)/ nocase
    $http.principal.user.userid != ""
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.user.userid in %global_allowed_admin_users
    not $http.principal.user.userid in %global_allowed_service_accounts
    not $http.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1548.005")
    $primary_entity = array_distinct($http.principal.user.userid)
    $source_ips = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $http_methods = array_distinct($http.network.http.method)

  condition:
    $http
}
