/*
  MITRE Technique : T1552.007 - Container API
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:55:17.938187+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_007_K8s_Secrets_API_Read {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a get or list request against the Kubernetes API for Secret objects by an identity that is not an approved service account or administrator. This is the API-level audit artifact of credential harvesting through the Container API, for example a compromised pod service account token enumerating cluster secrets. It does not depend on command-line logging inside the container."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.007"
    mitre_technique_name = "Unsecured Credentials: Container API"
    log_prerequisites = "Requires Kubernetes API server audit logging at Metadata level or higher, with the request verb mapped to metadata.product_event_type and the resource or request URI mapped to target.resource.name or target.url."
    platform = "Containers"
    log_source = "container"
    false_positives = "GitOps controllers, secret-sync operators, ingress and certificate controllers, service meshes, backup tooling and cluster administrators legitimately reading secrets. CI/CD deployers that mount or read secrets during rollouts."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts and named cluster administrators to %global_allowed_admin_users. Add approved backup identities to %global_allowed_backup_processes if they appear as the principal userid. For noisy controllers, tune on the userid pattern or on principal.ip."

  events:
    $acc.metadata.event_type = "USER_RESOURCE_ACCESS"
    $acc.metadata.product_event_type = /^(get|list)$/ nocase
    (
      $acc.target.resource.name = /(^|\/)secrets?(\/|$)/ nocase or
      $acc.target.url = /\/api\/v1\/(namespaces\/[^\/]+\/)?secrets(\/|\?|$)/ nocase
    )
    $acc.principal.user.userid != ""
    not $acc.principal.user.userid = /^system:(node|kube-|apiserver|serviceaccount:kube-system)/ nocase
    not $acc.principal.user.userid in %global_allowed_service_accounts
    not $acc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1552.007")
    $primary_entity = array_distinct($acc.principal.user.userid)
    $source_ips = array_distinct($acc.principal.ip)
    $secret_resources = array_distinct($acc.target.resource.name)
    $request_verbs = array_distinct($acc.metadata.product_event_type)

  condition:
    $acc
}
