/*
  MITRE Technique : T1553.006 - Code Signing Policy Modification
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:09:19.983386+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_006_Signing_Policy_Tamper_Process_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows shell or script host whose own command line contains code signing policy modification arguments (test-signing, integrity-check bypass, Code Integrity or driver blocklist changes) and which makes an external network connection. This pattern is typical of a staged script that weakens driver or code signature enforcement and then pulls down or beacons to external infrastructure, for example to load an unsigned or vulnerable driver. Coverage is limited to the network side of the technique and depends on the EDR populating the process command line on network events."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.006"
    mitre_technique_name = "Subvert Trust Controls: Code Signing Policy Modification"
    log_prerequisites = "Requires Windows endpoint telemetry (EDR or Sysmon Event ID 3 equivalent) that populates principal.process.command_line and principal.process.file.full_path on NETWORK_CONNECTION events. Pair with the endpoint registry and process rules for this technique for full coverage."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Driver developers and kernel debugging labs enabling test-signing from a script that also downloads symbols or tooling; OEM or hardware vendor installers that adjust Code Integrity settings; software deployment or imaging scripts that run bcdedit and fetch packages in the same shell; security hardening scripts that change the vulnerable driver blocklist and check in with a management server."
    tuning_guidance = "Add approved deployment, imaging and driver-lab tooling executables to %global_allowed_admin_tools. Add known driver development or build hosts to %global_allowed_script_hosts. Internal destinations are excluded through %rfc1918_internal. If the EDR does not populate command lines on network events, this rule will not fire and the process-launch variant should be relied on instead."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta)\.exe$/ nocase
    $net.principal.process.command_line = /(testsigning|nointegritychecks|ddisable_integrity_checks|disable_integrity_checks|DisableIntegrityChecks|VulnerableDriverBlocklistEnable|CodeIntegrity\\Config|Control\\CI\\(Policy|Config)|Hypervisor(Enforced)?CodeIntegrity)/ nocase
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1553.006")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $process_command_lines = array_distinct($net.principal.process.command_line)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
