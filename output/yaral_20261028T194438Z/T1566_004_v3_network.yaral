/*
  MITRE Technique : T1566.004 - Spearphishing Voice
  Tactic(s)       : Initial Access
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:52:31.849649+00:00
  Reference       : https://attack.mitre.org/techniques/T1566/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1566_004_Linux_Outbound_Remote_Access_Ports_Vishing {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux host making an outbound connection to an external address on a well-known interactive remote-access port (VNC, RDP/xrdp, or remote-support relay ports). In voice-phishing (vishing) intrusions the victim is talked into installing or launching a remote access tool, which then connects out to an external relay or controller. This rule observes that network behaviour at the perimeter without relying on process or command-line data, so it complements endpoint rules."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1566.004"
    mitre_technique_name = "Phishing: Spearphishing Voice"
    log_prerequisites = "Firewall, proxy, or perimeter flow logs normalised to UDM NETWORK_CONNECTION with principal.hostname or principal.ip, target.ip, target.port. Egress traffic from Linux server and workstation segments must pass the logging device."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Approved IT remote support, cloud-hosted jump hosts reached over RDP or VNC, developers using remote desktops on external lab or cloud VMs, managed-service remote tooling not yet allow-listed."
    tuning_guidance = "Add approved remote support destinations to %global_allowed_remote_mgmt and %global_allowed_domains, and approved source addresses to %global_allowed_mgmt_sources. Keep internal ranges in %rfc1918_internal. Firewall logs rarely identify the OS, so scope the rule to Linux segments through log routing, or add a principal.platform = \"LINUX\" condition if the client populates that field. Adjust the port list to the client's remote-access baseline."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 5900 or
      $net.target.port = 5901 or
      $net.target.port = 5902 or
      $net.target.port = 3389 or
      $net.target.port = 5938 or
      $net.target.port = 6568
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_remote_mgmt
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1566.004")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
