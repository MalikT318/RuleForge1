/*
  MITRE Technique : T1578.005 - Modify Cloud Compute Configurations
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:56:39.329265+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_005_Cloud_Compute_Quota_Region_Policy_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects control-plane changes that expand the compute capacity or deployment footprint of a cloud account: service quota increase requests or updates, enabling additional or opt-in regions, and writes to organization or tenant policies that govern compute size, location, image or external-IP restrictions. Adversaries use these changes to prepare for resource hijacking without exhausting the victim's existing quota, and to deploy compute in regions that are not monitored."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578.005"
    mitre_technique_name = "Modify Cloud Compute Configurations"
    log_prerequisites = "Cloud control-plane audit logs ingested and parsed into UDM with metadata.product_event_type (API operation name) and target.resource.name populated. Management and admin activity logs must be enabled for all accounts, subscriptions and projects, and for all regions."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Legitimate capacity planning by cloud platform teams, approved quota increase tickets for new workloads or seasonal scaling, planned expansion into new regions, infrastructure-as-code pipelines applying policy baselines, and landing-zone or governance automation updating organization policies."
    tuning_guidance = "Add pipeline and automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named cloud administrators to %global_allowed_admin_users. Correlate hits with change tickets. If quota requests are normalized to a different event type in a tenant's parser, clone the rule for that event type. Review the API-name regex against the operation names the client's parser emits in product_event_type."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    (
      $cloud.metadata.product_event_type = /(RequestServiceQuotaIncrease|PutServiceQuotaIncreaseRequestIntoTemplate|AssociateServiceQuotaTemplate|EnableRegion|quota.*(write|update|create|preference|increase)|quotas?\/(write|action))/ nocase
      or
      (
        $cloud.metadata.product_event_type = /(SetOrgPolicy|SetOrganizationPolicy|policyAssignments\/write|policyDefinitions\/write|policySetDefinitions\/write|UpdatePolicy)/ nocase
        and $cloud.target.resource.name = /(compute|vmSize|vm-size|allowedLocations|allowed-locations|resourceLocations|trustedImage|vmExternalIpAccess|instance-type|instanceType)/ nocase
      )
    )
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1578.005")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $api_operations = array_distinct($cloud.metadata.product_event_type)
    $target_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
