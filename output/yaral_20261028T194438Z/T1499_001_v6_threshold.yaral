/*
  MITRE Technique : T1499.001 - OS Exhaustion Flood
  Tactic(s)       : Impact
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:18:05.646525+00:00
  Reference       : https://attack.mitre.org/techniques/T1499/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1499_001_External_Source_Connection_Flood_To_Single_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single external source opens an abnormally high number of TCP connections to one internal destination within ten minutes. This pattern is consistent with a SYN, ACK or connection-state exhaustion flood against the host operating system's connection table. Each connection is benign on its own; the volume from one source to one destination is the signal."
    mitre_tactic = "Impact"
    mitre_technique = "T1499.001"
    mitre_technique_name = "Endpoint Denial of Service: OS Exhaustion Flood"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and network.ip_protocol populated. Logs must record the original external source address, so capture them before any upstream NAT or load balancer rewrites it. The protected servers are Linux hosts behind the perimeter."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Uptime or synthetic monitoring services, CDN or reverse-proxy egress nodes, partner API clients with bursty polling, penetration tests and external scanners not yet allowlisted, large NAT gateways that aggregate many users behind one address."
    tuning_guidance = "Add authorised external scanners to %global_allowed_scanners and approved external sources to %global_allowed_mgmt_sources. Raise or lower the #net threshold per client to match the baseline connection rate of internet-facing Linux services. Where firewall logs are sampled or summarised, adjust the threshold to the sampling ratio."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "TCP"
    $net.principal.ip = $src_ip
    $net.target.ip = $dst_ip
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src_ip, $dst_ip over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1499.001")
    $primary_entity = array_distinct($dst_ip)
    $source_ips = array_distinct($src_ip)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    #net >= 1500
}
