/*
  MITRE Technique : T1505.002 - Transport Agent
  Tactic(s)       : Persistence
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:28:13.652587+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_002_Linux_MTA_Spawns_Shell_Or_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux mail transport or mail-filter process (Postfix, Exim, Sendmail, milters, content filters, LDA/LMTP) spawning a shell, script interpreter or raw network utility. Linux has no Exchange transport agents, so this covers the equivalent persistence and abuse pattern: a malicious pipe/alias/transport, milter or filter hook, or a compromised MTA that executes attacker code when mail is processed. The detection pivots on process lineage (parent MTA, child shell or interpreter) rather than on command-line content."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.002"
    mitre_technique_name = "Server Software Component: Transport Agent"
    log_prerequisites = "Linux EDR or auditd execve telemetry normalised to UDM PROCESS_LAUNCH with populated parent (principal.process.file.full_path) and child (target.process.file.full_path) paths. Requires coverage on mail servers and relays."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate Postfix pipe or Exim transports that call wrapper shell scripts (procmail, maildrop, dovecot-lda sieve pipe actions, mailman or list-manager aliases), spam and AV filter wrappers (amavis, spamassassin, clamav) that run helper scripts, helpdesk ticket-by-email piping aliases, and mail-server health or maintenance hooks."
    tuning_guidance = "Add approved MTA wrapper parents to %global_allowed_script_hosts. Add known mail-service accounts to %global_allowed_service_accounts. Add approved admin or deployment tooling to %global_allowed_admin_tools. Review the alert on mail relays first, because any shell spawned by smtpd or a milter is rarely legitimate there."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(postfix\/([a-z]+\/)?(master|smtpd|smtp|qmgr|pickup|local|pipe|virtual|cleanup|lmtp)|exim4?|sendmail(\.sendmail)?|sm-mta|opendkim|opendmarc|amavisd(-new)?|spamd|clamd|dovecot|dovecot-lda|lmtp|opensmtpd|smtpd)$/ nocase
    $proc.target.process.file.full_path = /\/((ba|da|a|z|k|c|tc|fi)?sh|python[0-9.]*|perl|ruby|php[0-9.]*|node|lua|nc|ncat|netcat|socat)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1505.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
