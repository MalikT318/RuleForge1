/*
  MITRE Technique : T1486 - Data Encrypted for Impact
  Tactic(s)       : Impact
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:01:00.409118+00:00
  Reference       : https://attack.mitre.org/techniques/T1486
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1486_Mass_Document_Rename_With_Ransom_Note {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Critical"
    description = "Detects ransomware-style encryption activity. One process creates many files that keep a user-document extension and add a second appended extension (for example report.docx.<newext>), and the same process drops a ransom-note style file (decrypt, recover or restore instructions) on the same host within one hour."
    mitre_tactic = "Impact"
    mitre_technique = "T1486"
    mitre_technique_name = "Data Encrypted for Impact"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon Event ID 11) with the acting process path populated on FILE_CREATION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup, sync and archiving agents that append extensions to documents; document management or DLP encryption tools; software packaging or deployment tools; browsers and download managers writing partial files; security training or ransomware simulation exercises."
    tuning_guidance = "Add legitimate backup agents to %global_allowed_backup_processes, EDR/AV agents to %global_allowed_security_tools, and deployment or encryption tooling to %global_allowed_admin_tools. Raise or lower the #mod threshold (default 20 files) per client file-server activity. Extend the temporary-extension exclusion list if a client has an in-house tool that uses a benign double extension."

  events:
    // Event 1: files renamed or created with an appended extension after a document extension
    $mod.metadata.event_type = "FILE_CREATION"
    $mod.target.file.full_path = /\.(docx?|xlsx?|pptx?|pdf|txt|rtf|csv|jpe?g|png|bmp|mp3|mp4|avi|mov|zip|rar|7z|sql|mdb|accdb|bak|vmdk|vhdx|psd|dwg|odt|ods|pst)\.[a-z0-9_\-]{3,12}$/ nocase
    not $mod.target.file.full_path = /\.(tmp|temp|crdownload|part|partial|download|bak|old|lnk|log|url|swp|lock|~[a-z0-9]*|[0-9]+)$/ nocase
    $mod.principal.hostname = $hostname
    $mod.principal.process.file.full_path = $proc_path
    not $mod.principal.process.file.full_path in %global_allowed_backup_processes
    not $mod.principal.process.file.full_path in %global_allowed_security_tools
    not $mod.principal.process.file.full_path in %global_allowed_admin_tools

    // Event 2: ransom-note style file dropped by the same process on the same host
    $note.metadata.event_type = "FILE_CREATION"
    $note.target.file.full_path = /\\[^\\]*(decrypt|restore[-_ ]?(your[-_ ]?)?files|recover[-_ ]?(your[-_ ]?)?files|how[-_ ]?to[-_ ]?(back|recover|restore|decrypt|unlock)|ransom|files[-_ ]?(are[-_ ]?)?encrypted)[^\\]*\.(txt|html?|hta)$/ nocase
    $note.principal.hostname = $hostname
    $note.principal.process.file.full_path = $proc_path
    not $note.principal.process.file.full_path in %global_allowed_backup_processes
    not $note.principal.process.file.full_path in %global_allowed_security_tools
    not $note.principal.process.file.full_path in %global_allowed_admin_tools

    $mod.metadata.event_timestamp.seconds <= $note.metadata.event_timestamp.seconds

  match:
    $hostname, $proc_path over 1h

  outcome:
    $risk_score = max(95)
    $mitre_technique_id = array_distinct("T1486")
    $primary_entity = array_distinct($hostname)
    $encrypting_process = array_distinct($proc_path)
    $renamed_file_count = count_distinct($mod.target.file.full_path)
    $sample_renamed_files = array_distinct($mod.target.file.full_path)
    $ransom_note_paths = array_distinct($note.target.file.full_path)
    $affected_users = array_distinct($mod.principal.user.userid)

  condition:
    $mod and $note and #mod >= 20
}
