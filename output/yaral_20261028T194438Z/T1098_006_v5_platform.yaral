/*
  MITRE Technique : T1098.006 - Additional Container Cluster Roles
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:49:39.205295+00:00
  Reference       : https://attack.mitre.org/techniques/T1098/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_006_K8s_RBAC_Binding_Created_By_Unapproved_Identity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a Kubernetes RoleBinding or ClusterRoleBinding through the API server audit log by an identity that is not an approved administrator, service account, or cloud principal, and not a built-in control-plane component. Adversaries create bindings to give a controlled user or service account persistent, elevated cluster permissions. This is audit-log based, not process or command-line based, so it also catches bindings made with kubectl, client libraries, or direct API calls."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098.006"
    mitre_technique_name = "Account Manipulation: Additional Container Cluster Roles"
    log_prerequisites = "Kubernetes API server audit logging enabled at Metadata level or higher for the rbac.authorization.k8s.io API group (including managed cluster control-plane audit logs) and ingested into Chronicle with UDM normalization."
    platform = "Containers"
    log_source = "container"
    false_positives = "GitOps controllers and CI/CD pipelines applying RBAC manifests, Helm or operator installs that ship RoleBindings, cluster bootstrap and upgrade activity, platform engineers onboarding teams or namespaces, and cloud-managed add-ons that create bindings."
    tuning_guidance = "Add GitOps, CI/CD and operator identities to %global_allowed_service_accounts, named platform administrators to %global_allowed_admin_users, and cloud-managed identities to %global_allowed_cloud_principals. Extend the system: identity regex if your distribution uses additional control-plane user names. If the target.url field is not populated in your parser mapping, the resource_subtype alternative covers the same API resources."

  events:
    $k8s.metadata.event_type = "RESOURCE_CREATION"
    (
      $k8s.target.url = /rbac\.authorization\.k8s\.io\/v1\/(namespaces\/[^\/]+\/)?(cluster)?rolebindings/ nocase or
      $k8s.target.resource.resource_subtype = /^(cluster)?rolebindings?$/ nocase
    )
    $k8s.principal.user.userid != ""
    not $k8s.principal.user.userid = /^system:(node|kube-|serviceaccount:kube-system:|apiserver|masters)/ nocase
    not $k8s.principal.user.userid in %global_allowed_service_accounts
    not $k8s.principal.user.userid in %global_allowed_admin_users
    not $k8s.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1098.006")
    $primary_entity = array_distinct($k8s.principal.user.userid)
    $binding_name = array_distinct($k8s.target.resource.name)
    $source_ips = array_distinct($k8s.principal.ip)
    $api_path = array_distinct($k8s.target.url)

  condition:
    $k8s
}
