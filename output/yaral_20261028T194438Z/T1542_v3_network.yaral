/*
  MITRE Technique : T1542 - Pre-OS Boot
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:40:44.159604+00:00
  Reference       : https://attack.mitre.org/techniques/T1542
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_Outbound_TFTP_Netboot_Firmware_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network device or internal host opening a TFTP connection (destination port 69) to an external address. TFTP is the transport used to network-boot or pull boot images and firmware on network devices (for example ROMMON or bootloader images), and it is unauthenticated and unencrypted. It should not cross the perimeter in normal operation, so outbound TFTP is a strong network-side signal of a boot image or firmware being staged or replaced, as in Pre-OS Boot persistence."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542"
    mitre_technique_name = "Pre-OS Boot"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with target.ip and target.port populated, and logging enabled for permitted UDP/69 traffic."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate vendor-supported firmware or configuration retrieval over TFTP from an external staging server, managed service provider or ISP provisioning of customer-premises equipment, remote-site PXE or zero-touch provisioning pointing at an external boot server, and authorised lab or penetration-test activity."
    tuning_guidance = "Add approved management or provisioning source addresses to %global_allowed_mgmt_sources. Add approved scanners or test sources to %global_allowed_scanners. Make sure %rfc1918_internal covers all internal address space for the client. If outbound TFTP is confirmed legitimate for a client, scope an exclusion to the specific source rather than disabling the rule."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 69
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1542")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $source_hostnames = array_distinct($net.principal.hostname)

  condition:
    $net
}
