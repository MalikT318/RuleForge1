/*
  MITRE Technique : T1659 - Content Injection
  Tactic(s)       : Initial Access, Command and Control
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:03:06.845240+00:00
  Reference       : https://attack.mitre.org/techniques/T1659
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1659_Cleartext_HTTP_Executable_Payload_Windows_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows-native client (update, BITS, CryptoAPI, WinHTTP or WinINet user agent) fetching an executable, installer, script or cabinet payload over unencrypted HTTP from an external host. Cleartext delivery of code to Windows system components is the channel abused by on-path and on-side content injection, where a fake update or download response is injected into the traffic. This rule observes the network side only and uses no endpoint process fields."
    mitre_tactic = "Initial Access, Command and Control"
    mitre_technique = "T1659"
    mitre_technique_name = "Content Injection"
    log_prerequisites = "Requires firewall or web proxy logs normalised to UDM NETWORK_HTTP with target.url, network.http.method and network.http.user_agent populated. Plain HTTP must be visible (not blind TLS tunnelling)."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate Windows Update, Delivery Optimization or driver downloads served over HTTP from vendor CDNs not yet in the allowlist; software deployment tools using BITS against external vendor mirrors; certificate revocation or CTL downloads (.cab, .crl); legacy line-of-business updaters that use HTTP."
    tuning_guidance = "Add vendor update and CDN domains to %global_allowed_domains (matched against target.hostname). Confirm %rfc1918_internal covers client address plans. If the proxy does not log the URL scheme, adjust the scheme match or replace it with target.port = 80. Review user-agent coverage per client proxy."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^GET$/ nocase
    $http.target.url = /^http:\/\// nocase
    $http.target.url = /\.(exe|msi|msu|msp|dll|scr|ps1|vbs|js|hta|bat|cmd|cab|zip)([?#;].*)?$/ nocase
    $http.network.http.user_agent = /(Microsoft-CryptoAPI|Windows-Update-Agent|Microsoft BITS|WinHttp|WinINet|Microsoft-Delivery-Optimization)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1659")
    $primary_entity = array_distinct($http.principal.ip)
    $source_hostname = array_distinct($http.principal.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $destination_host = array_distinct($http.target.hostname)
    $requested_url = array_distinct($http.target.url)
    $user_agent = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
