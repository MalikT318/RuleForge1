/*
  MITRE Technique : T1498.001 - Direct Network Flood
  Tactic(s)       : Impact
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:11:05.846294+00:00
  Reference       : https://attack.mitre.org/techniques/T1498/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_001_Linux_Inbound_Stateless_Volumetric_Flow {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a single perimeter flow record in which an external source sends an abnormally large volume of stateless traffic (UDP or ICMP) to an internal address. This is typical of volumetric direct network floods and reflection/amplification floods against internet-facing Linux services (DNS, NTP, web, game, and VPN servers). Detection relies only on network-observable attributes (protocol, direction, byte volume), with no endpoint process data."
    mitre_tactic = "Impact"
    mitre_technique = "T1498.001"
    mitre_technique_name = "Network Denial of Service: Direct Network Flood"
    log_prerequisites = "Requires perimeter firewall or flow logs normalised to UDM NETWORK_FLOW with network.ip_protocol, network.sent_bytes, principal.ip and target.ip populated. Flow records must be exported with byte counters at an interval short enough (for example 1 minute or less) that a flood is not diluted into long-lived sessions."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Inbound UDP-based bulk transfers to Linux hosts (backup or replication over UDP, media or video ingest, QUIC or VPN tunnel concentrators receiving large uploads), authorised load or stress tests, vulnerability scanners and capacity-testing partners, and long-lived flow records whose cumulative byte counters cross the threshold during legitimate sessions."
    tuning_guidance = "Add authorised load-test and scanner source addresses to %global_allowed_scanners. Adjust the sent_bytes threshold (default 100000000 bytes per flow record) to match the customer's flow export interval and normal inbound baseline, and lower it for small-bandwidth sites. For VPN, media or UDP-heavy Linux services, raise the threshold or add a port-specific exclusion. Internal address space comes from %rfc1918_internal."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    $net.network.ip_protocol = /^(UDP|ICMP)$/ nocase
    $net.network.sent_bytes > 100000000
    not $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1498.001")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)
    $protocols = array_distinct($net.network.ip_protocol)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
