/*
  MITRE Technique : T1012 - Query Registry
  Tactic(s)       : Discovery
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:23:31.779600+00:00
  Reference       : https://attack.mitre.org/techniques/T1012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1012_Registry_Export_File_Artifact_Staged {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects the file artifact left by registry querying. A native registry utility (reg or regedit) writes a registry export or hive file (.reg, .hiv, .hive) into a user-writable staging location. This catches registry discovery and collection from the resulting file creation, so it still fires when command-line logging is evaded, obfuscated or absent."
    mitre_tactic = "Discovery"
    mitre_technique = "T1012"
    mitre_technique_name = "Query Registry"
    log_prerequisites = "Requires endpoint file-creation telemetry that populates the principal (writing) process path and the target file path, from any EDR or Sysmon (file create events)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators or helpdesk staff exporting registry keys for backup or troubleshooting, software installers and migration tools exporting settings, configuration management or RMM scripts, and developers testing registry changes."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools, add named administrators to %global_allowed_admin_users, and add automation accounts to %global_allowed_service_accounts. If export-to-Desktop or Documents is noisy for a client, narrow the staging-path regex to Temp, Public, ProgramData and PerfLogs only."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(reg|regedit)\.exe$/ nocase
    $file.target.file.full_path = /\.(reg|hiv|hive)$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata\\local\\temp|downloads|desktop|documents)|users\\public|programdata|windows\\temp|perflogs)\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1012")
    $primary_entity = array_distinct($file.principal.hostname)
    $exported_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)
    $writing_process = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
