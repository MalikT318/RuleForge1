/*
  MITRE Technique : T1564.010 - Process Argument Spoofing
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:27:55.652276+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_010_Spawned_Process_Memory_Tampered_By_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the behavioural pattern of process argument spoofing (PEB command-line overwrite). A parent launches a commonly abused native Windows binary, then within 10 minutes the same parent process performs a cross-process memory write or injection into that exact child PID on the same host. Legitimate parents rarely modify the memory of a child they just created, whereas spoofing tooling does this to replace benign launch-time arguments with malicious ones after the sensor has logged the process creation. The rule joins on host, parent PID and child PID, and does not rely on command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.010"
    mitre_technique_name = "Hide Artifacts: Process Argument Spoofing"
    log_prerequisites = "Requires endpoint telemetry with process creation (PROCESS_LAUNCH) and cross-process memory write or remote thread telemetry (PROCESS_INJECTION) populating principal and target process PIDs and file paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Application compatibility shims, software protection or DRM agents, debuggers and developer tooling, EDR or DLP agents not yet in the allowlist, and installers or packers that patch a freshly spawned helper process."
    tuning_guidance = "Add EDR/AV agents to %global_allowed_security_tools, deployment and debugging tooling to %global_allowed_admin_tools, and approved automation hosts or parents to %global_allowed_script_hosts. If PIDs are not populated for a client's EDR, the rule will not fire for that client and a different join key is needed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|rundll32|regsvr32|svchost|mshta|wscript|cscript|msbuild|dllhost|conhost|notepad)\.exe$/ nocase
    $proc.principal.hostname = $hostname
    $proc.principal.process.pid = $parent_pid
    $proc.target.process.pid = $child_pid
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.target.process.file.full_path = /\\(cmd|powershell|pwsh|rundll32|regsvr32|svchost|mshta|wscript|cscript|msbuild|dllhost|conhost|notepad)\.exe$/ nocase
    $inj.principal.hostname = $hostname
    $inj.principal.process.pid = $parent_pid
    $inj.target.process.pid = $child_pid
    $inj.principal.process.pid != $inj.target.process.pid
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools

    $proc.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname, $parent_pid, $child_pid over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1564.010")
    $primary_entity = array_distinct($hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $spawned_process = array_distinct($proc.target.process.file.full_path)
    $launch_command_line = array_distinct($proc.target.process.command_line)
    $injecting_process = array_distinct($inj.principal.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc and $inj
}
