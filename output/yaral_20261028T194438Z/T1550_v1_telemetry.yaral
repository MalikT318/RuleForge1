/*
  MITRE Technique : T1550 - Use Alternate Authentication Material
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:35:14.158153+00:00
  Reference       : https://attack.mitre.org/techniques/T1550
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1550_002_NTLM_Network_Logon_Pass_The_Hash {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a successful remote network logon to a Windows host authenticated with NTLM by a non-machine, non-anonymous account. This is the authentication artifact left by pass-the-hash and other alternate-authentication-material lateral movement, where the attacker holds an NT hash but not the plaintext password. It works at the authentication-event layer, so it fires regardless of which tool is used or whether command-line logging exists."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1550.002"
    mitre_technique_name = "Use Alternate Authentication Material: Pass the Hash"
    log_prerequisites = "Windows Security event 4624 (logon type 3) ingested from domain controllers and member servers and normalised to USER_LOGIN. Requires the authentication package to be populated in extensions.auth.auth_details."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Legacy applications and devices that only support NTLM, access by IP address instead of hostname (which forces NTLM fallback), file-share and print access from non-domain systems, vulnerability scanners and inventory tooling, backup agents using service accounts, and administrators using approved remote management."
    tuning_guidance = "Add expected NTLM-dependent service accounts to %global_allowed_service_accounts, named administrators to %global_allowed_admin_users, and scanner or management source hosts to %global_allowed_scanners. Baseline per client first. Where NTLM is widely used, raise severity only when the same user also has NTLM logons to multiple hosts, or route to a threshold variant."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.extensions.auth.mechanism = "NETWORK"
    $auth.extensions.auth.auth_details = /ntlm/ nocase
    $auth.target.user.userid != ""
    $auth.principal.hostname != $auth.target.hostname
    not $auth.target.user.userid = /\$$/ nocase
    not $auth.target.user.userid = /^(anonymous logon|-)$/ nocase
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1550.002")
    $primary_entity = array_distinct($auth.target.hostname)
    $logon_user = array_distinct($auth.target.user.userid)
    $source_host = array_distinct($auth.principal.hostname)
    $source_ip = array_distinct($auth.principal.ip)

  condition:
    $auth
}
