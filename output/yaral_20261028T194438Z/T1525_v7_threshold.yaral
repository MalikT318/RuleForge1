/*
  MITRE Technique : T1525 - Implant Internal Image
  Tactic(s)       : Persistence
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:25:33.807723+00:00
  Reference       : https://attack.mitre.org/techniques/T1525
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1525_Container_Image_Push_Burst_By_Identity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single identity creates or pushes an unusually high number of container or machine image artifacts to registries within ten minutes. Each push is normally benign, but a burst from one principal can indicate image implantation or backdooring of images that infrastructure automation pulls as 'latest'."
    mitre_tactic = "Persistence"
    mitre_technique = "T1525"
    mitre_technique_name = "Implant Internal Image"
    log_prerequisites = "Cloud control plane audit logs that record container registry and image API activity, normalised to RESOURCE_CREATION with metadata.product_event_type and principal.user.userid populated."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "CI/CD pipelines and build automation pushing many tags, release days with multi-image or multi-architecture publishes, image mirroring or replication jobs, platform engineers rebuilding base images after a vulnerability patch."
    tuning_guidance = "Add CI/CD and build identities to %global_allowed_service_accounts, approved automation principals to %global_allowed_cloud_principals, and named platform engineers to %global_allowed_admin_users. Raise the #img threshold for tenants with busy pipelines. Pair alerts with a review of the image repositories listed in $repositories."

  events:
    $img.metadata.event_type = "RESOURCE_CREATION"
    $img.metadata.product_event_type = /(PutImage|CreateImage|RegisterImage|CopyImage|ImportImage|CreateImageVersion|images\.insert|manifests\.put|push\/write|ImageManifest)/ nocase
    $img.principal.user.userid = $user
    not $img.principal.user.userid in %global_allowed_service_accounts
    not $img.principal.user.userid in %global_allowed_admin_users
    not $img.principal.user.userid in %global_allowed_cloud_principals

  match:
    $user over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($img.metadata.id)
    $mitre_technique_id = array_distinct("T1525")
    $primary_entity = array_distinct($user)
    $repositories = array_distinct($img.target.resource.name)
    $source_ips = array_distinct($img.principal.ip)
    $api_calls = array_distinct($img.metadata.product_event_type)

  condition:
    #img >= 10
}
