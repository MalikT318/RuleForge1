/*
  MITRE Technique : T1498 - Network Denial of Service
  Tactic(s)       : Impact
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:08:06.980178+00:00
  Reference       : https://attack.mitre.org/techniques/T1498
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_Container_Ingress_UDP_Reflection_Flood {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a single large inbound UDP flow from an external source whose source port is a well-known reflection/amplification service (CharGen, NTP, SNMP, CLDAP, SSDP, WS-Discovery, Memcached) toward an internal destination such as a container ingress, node or load balancer. Large unsolicited responses from these ports are the network signature of a reflection DDoS (T1498) against containerised workloads. Uses only perimeter flow telemetry and no endpoint process fields."
    mitre_tactic = "Impact"
    mitre_technique = "T1498"
    mitre_technique_name = "Network Denial of Service"
    log_prerequisites = "Firewall, proxy or perimeter flow logs normalised to UDM NETWORK_FLOW with principal.ip, principal.port, network.ip_protocol and network.sent_bytes populated. The logs must cover traffic in front of the Kubernetes or container hosting network (ingress, NodePort or load balancer). Populate %rfc1918_internal and %global_allowed_scanners for each client."
    platform = "Containers"
    log_source = "firewall"
    false_positives = "Legitimate bulk transfers from external NTP, SNMP, LDAP or SSDP peers; Memcached or CLDAP integrations with a partner or SaaS provider; authorised load tests or vulnerability scans; and aggregated flow records that merge many small packets into one oversized record."
    tuning_guidance = "Add authorised external peers and scanners to %global_allowed_scanners. If the firewall exports aggregated or long-lived flow records, raise the sent_bytes threshold (default 500000). To tighten, remove noisier source ports such as 123 or 389. Run in a pilot period first to baseline the largest legitimate UDP flows per client."

  events:
    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.network.ip_protocol = "UDP"
    (
      $flow.principal.port = 19 or
      $flow.principal.port = 123 or
      $flow.principal.port = 161 or
      $flow.principal.port = 389 or
      $flow.principal.port = 1900 or
      $flow.principal.port = 3702 or
      $flow.principal.port = 11211
    )
    $flow.network.sent_bytes > 500000
    not $flow.principal.ip in %rfc1918_internal
    not $flow.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1498")
    $primary_entity = array_distinct($flow.target.ip)
    $reflector_ips = array_distinct($flow.principal.ip)
    $reflector_ports = array_distinct($flow.principal.port)
    $max_flow_bytes = max($flow.network.sent_bytes)

  condition:
    $flow
}
