/*
  MITRE Technique : T1491.002 - External Defacement
  Tactic(s)       : Impact
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:46:29.963877+00:00
  Reference       : https://attack.mitre.org/techniques/T1491/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_002_External_Web_Content_Write_Via_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external (non-internal) client successfully using HTTP content-write methods (PUT, MOVE, COPY, MKCOL, PROPPATCH) against web page or script resources on a web server. This is the network-observable mechanism of remote website defacement through WebDAV or misconfigured write-enabled web servers."
    mitre_tactic = "Impact"
    mitre_technique = "T1491.002"
    mitre_technique_name = "Defacement: External Defacement"
    log_prerequisites = "Requires proxy, WAF or firewall logs with HTTP inspection that populate network.http.method, network.http.response_code and target.url (reverse proxy or SSL-inspecting perimeter)."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate WebDAV publishing, CMS or deployment tooling that pushes content over HTTP PUT from external locations, third-party web agencies updating sites, authorised vulnerability scanners and penetration tests."
    tuning_guidance = "Add authorised publisher and management source addresses to %global_allowed_mgmt_sources and approved scanners to %global_allowed_scanners. Review the primary_entity (the targeted web server) and the source_ips outcome field. Confirm that the response is a 2xx write to a public-facing page."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(PUT|MOVE|COPY|MKCOL|PROPPATCH)$/ nocase
    $http.target.url = /\.(html?|php|aspx?|jsp|jspx|js|css|cshtml)(\?.*)?$|\/(index|default|home)(\.[a-z0-9]+)?(\?.*)?$/ nocase
    $http.network.http.response_code >= 200
    $http.network.http.response_code < 300
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_mgmt_sources
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1491.002")
    $primary_entity = array_distinct($http.target.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $http_methods = array_distinct($http.network.http.method)
    $targeted_urls = array_distinct($http.target.url)

  condition:
    $http
}
