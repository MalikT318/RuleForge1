/*
  MITRE Technique : T1498.002 - Reflection Amplification
  Tactic(s)       : Impact
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:13:08.052197+00:00
  Reference       : https://attack.mitre.org/techniques/T1498/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_002_Inbound_UDP_Amplification_Response {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a large UDP flow from an external host with a well-known amplification-service source port (DNS, chargen, SNMP, NTP, CLDAP, SSDP, memcached) to an internal address. A response of this size with no matching outbound request is characteristic of a reflection amplification DoS in which the external host acts as the reflector and the internal host is the spoofed victim."
    mitre_tactic = "Impact"
    mitre_technique = "T1498.002"
    mitre_technique_name = "Network Denial of Service: Reflection Amplification"
    log_prerequisites = "Perimeter firewall or flow logs normalised to UDM NETWORK_FLOW, with UDP protocol, principal/target IP and port, and byte counters (network.sent_bytes) populated. The flow must be logged from the first-packet initiator perspective, so the reflector appears as principal."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Internal Linux servers or DNS forwarders receiving large legitimate responses (DNSSEC, EDNS0, TXT-heavy lookups) from external resolvers; NTP or SNMP polling of external appliances; SSDP/UPnP discovery on routed segments; authorised scanners and monitoring probes; memcached or CLDAP traffic over inter-site links that use public addressing."
    tuning_guidance = "Add known external resolvers, time sources, monitoring probes and scanners to %global_allowed_scanners. Add approved management sources to %global_allowed_mgmt_sources. If the client forwards DNS to public resolvers, raise the byte threshold or remove port 53 for that tenant. Lower the threshold only where firewall flows are per-packet rather than session-aggregated."

  events:
    $flow.metadata.event_type = "NETWORK_FLOW"
    $flow.network.ip_protocol = "UDP"
    (
      $flow.principal.port = 19 or
      $flow.principal.port = 53 or
      $flow.principal.port = 123 or
      $flow.principal.port = 161 or
      $flow.principal.port = 389 or
      $flow.principal.port = 1900 or
      $flow.principal.port = 11211
    )
    $flow.network.sent_bytes >= 5000
    not $flow.principal.ip in %rfc1918_internal
    $flow.target.ip in %rfc1918_internal
    not $flow.principal.ip in %global_allowed_scanners
    not $flow.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1498.002")
    $primary_entity = array_distinct($flow.target.ip)
    $reflector_ips = array_distinct($flow.principal.ip)
    $reflector_ports = array_distinct($flow.principal.port)
    $max_flow_bytes = max($flow.network.sent_bytes)

  condition:
    $flow
}
