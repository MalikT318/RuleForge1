/*
  MITRE Technique : T1685.002 - Disable or Modify Cloud Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:19:02.183583+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_002_Office_Suite_Audit_Config_Tampering_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single user performs several audit-logging configuration changes within 10 minutes, such as mailbox audit bypass, audit log configuration changes, or removal of audit or retention policies. One such change can be routine administration, but a burst from one identity suggests an adversary blinding tenant logging before further activity."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.002"
    mitre_technique_name = "Disable or Modify Cloud Log"
    log_prerequisites = "Requires collaboration-suite unified audit logs (admin and exchange-style operations) ingested and parsed to UDM SETTING_MODIFICATION, with the operation name in metadata.product_event_type and the actor in principal.user.userid."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Compliance or messaging administrators performing planned audit-policy changes, tenant migrations or onboarding scripts, eDiscovery or retention project work, and automation that bulk-applies audit bypass or retention settings."
    tuning_guidance = "Add expected administrators to %global_allowed_admin_users and automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Raise the #setting threshold if planned bulk changes recur. Extend the operation regex if the tenant uses additional audit-related operation names."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /(AuditBypass|AdminAuditLogConfig|AuditConfigurationPolicy|AuditConfigurationRule|AuditLogRetentionPolicy|AuditLogIngestion|Disable-.*Audit|Set-.*AuditEnabled)/ nocase
    $setting.principal.user.userid = $user
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  match:
    $user over 10m

  outcome:
    $risk_score = max(75)
    $event_count = count($setting.metadata.id)
    $operations = array_distinct($setting.metadata.product_event_type)
    $source_ips = array_distinct($setting.principal.ip)
    $mitre_technique_id = array_distinct("T1685.002")
    $primary_entity = array_distinct($user)

  condition:
    #setting >= 3
}
