/*
  MITRE Technique : T1565 - Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:38:22.383211+00:00
  Reference       : https://attack.mitre.org/techniques/T1565
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_Linux_Mass_InPlace_Data_Edit_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a high volume of in-place data-editing commands (sed -i, perl -i, truncate -s) run against files under application data, web, or log directories on a single Linux host within 10 minutes. Each command is benign on its own, but mass in-place rewriting or truncation of records and logs is consistent with data manipulation to alter business records or hide activity."
    mitre_tactic = "Impact"
    mitre_technique = "T1565"
    mitre_technique_name = "Data Manipulation"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records normalised to UDM PROCESS_LAUNCH with full command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management and deployment tooling (Ansible, Puppet, Chef) templating files, application installers or upgrade scripts, log rotation or log scrubbing jobs, data migration and ETL scripts, administrators running bulk find/replace during maintenance."
    tuning_guidance = "Add approved automation parents to %global_allowed_script_hosts or %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Raise the #proc threshold (default 15) for hosts with heavy batch processing. Narrow the data-path regex to the application directories that matter for the client."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(sed|perl|truncate)$/ nocase
    $proc.target.process.command_line = /(\s--in-place|\s-[a-z]*i[a-z]*(\.\S*)?\s|\btruncate\s+(-s|--size))/ nocase
    $proc.target.process.command_line = /\/(var\/lib|var\/www|var\/log|srv|opt|data|home)\/\S+/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($proc.target.process.command_line = /\/var\/lib\// nocase, 80, 65))
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1565")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $editing_binaries = array_distinct($proc.target.process.file.full_path)
    $sample_commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 15
}
