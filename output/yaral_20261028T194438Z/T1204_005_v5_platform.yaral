/*
  MITRE Technique : T1204.005 - Malicious Library
  Tactic(s)       : Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:07:04.056014+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_005_Package_Manager_Download_From_Unapproved_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows developer or build host whose package-manager HTTP client (npm, pip, NuGet) downloads a library archive from an external host that is not on the known-good domain list. This is network-side coverage for a user installing a malicious or typosquatted library from an unofficial index, mirror, or raw file host. It complements endpoint command-line detection and does not rely on process fields."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.005"
    mitre_technique_name = "User Execution: Malicious Library"
    log_prerequisites = "Requires proxy or perimeter logs with NETWORK_HTTP events that populate network.http.user_agent, target.url and target.hostname. TLS inspection or an explicit proxy is needed to see the user agent and URL for HTTPS traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Developers using legitimate but unlisted registries or mirrors, vendor-hosted private package feeds, CI/CD build agents pulling dependencies from new CDNs, and newly onboarded SaaS package hosts."
    tuning_guidance = "Add legitimate registries, mirrors and CDNs to %global_allowed_domains. Add build and developer hosts that are expected to pull from many sources to %global_allowed_script_hosts. Internal artifact repositories are excluded through %rfc1918_internal."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /(\bnpm\/[0-9][^ ]* .*win32|\bpip\/[0-9]|\bnuget\b)/ nocase
    $net.target.url = /\.(tgz|whl|tar\.gz|zip|nupkg|egg)(\?|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1204.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $download_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
