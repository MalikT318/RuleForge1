/*
  MITRE Technique : T1098 - Account Manipulation
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:40:43.196045+00:00
  Reference       : https://attack.mitre.org/techniques/T1098
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1098_IdP_Bulk_Permission_Changes_By_Single_Actor {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single identity-provider actor performs five or more permission or role changes on other accounts within ten minutes. Each change is routine on its own, but a burst from one actor suggests account manipulation to persist or escalate access, such as a compromised admin session granting roles in bulk."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1098"
    mitre_technique_name = "Account Manipulation"
    log_prerequisites = "Requires identity provider directory audit logs normalised to USER_CHANGE_PERMISSIONS with principal.user.userid (the actor) and target.user.userid populated."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Joiner/mover/leaver onboarding batches, HR-driven provisioning, identity governance access reviews, delegated helpdesk admins processing a queue, and planned role restructures or migrations."
    tuning_guidance = "Add provisioning and automation accounts to %global_allowed_service_accounts and named administrators who run bulk changes to %global_allowed_admin_users. Raise the #perm threshold for tenants with heavy onboarding. Lower it to 3 for tenants with few administrators."

  events:
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.principal.user.userid != ""
    $perm.principal.user.userid != $perm.target.user.userid
    $perm.principal.user.userid = $actor
    not $perm.principal.user.userid in %global_allowed_service_accounts
    not $perm.principal.user.userid in %global_allowed_admin_users

  match:
    $actor over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1098")
    $primary_entity = array_distinct($actor)
    $event_count = count($perm.metadata.id)
    $affected_accounts = array_distinct($perm.target.user.userid)
    $source_ips = array_distinct($perm.principal.ip)

  condition:
    #perm >= 5
}
