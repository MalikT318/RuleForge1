/*
  MITRE Technique : T1027.013 - Encrypted/Encoded File
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:59:54.380574+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_013_Linux_Bulk_Encoded_Files_In_Staging_Dirs {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of files with encrypted or encoded artifact extensions (enc, gpg, pgp, aes, b64, crypt, age) created in world-writable staging directories (/tmp, /var/tmp, /dev/shm) on a single Linux host within 10 minutes. One such file is routine, but bulk creation suggests payload, configuration or staged-data obfuscation before later decoding and execution. The rule uses FILE_CREATION telemetry and does not depend on process command lines."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.013"
    mitre_technique_name = "Obfuscated Files or Information: Encrypted/Encoded File"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry with target.file.full_path populated, normalised to UDM FILE_CREATION."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup and archive jobs staging encrypted output in /tmp, GPG-based package or repository signing, configuration management or deployment tooling that decrypts and re-encrypts secrets, developers or admins running bulk encryption tasks, and log shippers writing base64 spool files."
    tuning_guidance = "Add legitimate backup agents to %global_allowed_backup_processes, deployment and RMM tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Raise the #file threshold for noisy hosts, or extend the extension list for the client environment."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.*\.(enc|gpg|pgp|aes|b64|crypt|crypted|age|locked)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1027.013")
    $primary_entity = array_distinct($host)
    $created_files = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 5
}
