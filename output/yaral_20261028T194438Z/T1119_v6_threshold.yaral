/*
  MITRE Technique : T1119 - Automated Collection
  Tactic(s)       : Collection
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:26:21.823805+00:00
  Reference       : https://attack.mitre.org/techniques/T1119
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1119_SaaS_Automated_SignOn_Volume_Per_User {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single user identity produces an unusually high volume of application sign-on or token-issuance events in ten minutes. This pattern suggests scripted or API-driven access, such as a stolen session or token being used to enumerate and harvest data across SaaS applications. Each sign-on is benign on its own; the volume per user is the signal."
    mitre_tactic = "Collection"
    mitre_technique = "T1119"
    mitre_technique_name = "Automated Collection"
    log_prerequisites = "Identity provider sign-in and application access audit logs normalised to UDM USER_LOGIN, with principal.user.userid and target.application populated."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Automation and integration accounts that authenticate frequently, SSO portal refresh storms, users with many browser tabs or apps reauthenticating after a session policy change, mobile mail clients retrying after a password change, and load or synthetic-monitoring tests."
    tuning_guidance = "Add known automation identities to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. The threshold (#auth >= 30) is deliberately conservative. Raise it for tenants with heavy SSO usage, or lower it for high-security tenants. Review the distinct applications in the outcome to judge breadth."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid != ""
    $auth.target.application != ""
    $auth.principal.user.userid = $user
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($auth.metadata.id)
    $mitre_technique_id = array_distinct("T1119")
    $primary_entity = array_distinct($user)
    $applications = array_distinct($auth.target.application)
    $source_ips = array_distinct($auth.principal.ip)

  condition:
    #auth >= 30
}
