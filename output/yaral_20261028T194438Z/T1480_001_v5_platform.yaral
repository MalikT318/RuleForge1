/*
  MITRE Technique : T1480.001 - Environmental Keying
  Tactic(s)       : Stealth
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:25:52.910400+00:00
  Reference       : https://attack.mitre.org/techniques/T1480/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1480_001_PowerShell_Environment_Derived_Key_Decrypt_Execute {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a PowerShell command line that combines three behaviours in one invocation: collecting host-specific environment values (domain, computer name, volume serial, machine GUID, WMI system identity), deriving or applying a cryptographic key or hash, and executing the decrypted result in memory. This pattern is characteristic of environmentally keyed payloads that only decrypt on the intended victim. The rule keys on the combination of behaviours rather than on any specific payload, tool name or key value."
    mitre_tactic = "Stealth"
    mitre_technique = "T1480.001"
    mitre_technique_name = "Execution Guardrails: Environmental Keying"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command-line capture (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate PowerShell deployment or licensing scripts that bind to a machine identity and decrypt secrets; configuration-management bootstrap scripts; admin scripts using ConvertTo-SecureString with a key; software packagers that use machine-bound encryption."
    tuning_guidance = "Add approved deployment and automation parent processes to %global_allowed_script_hosts and approved IT tooling to %global_allowed_admin_tools. If a specific management agent still triggers, add it to %global_allowed_admin_tools by executable path. Do not relax the three-part requirement (environment value, crypto routine, in-memory execution), because it is what keeps the rule low-noise."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
    $proc.target.process.command_line = /(userdnsdomain|userdomain|computername|\[environment\]::(machinename|userdomainname|username)|win32_volume|volumeserialnumber|win32_computersystem|win32_bios|machineguid|getcomputerdomain|gethostentry)/ nocase
    $proc.target.process.command_line = /(rfc2898derivebytes|computehash|sha256managed|sha256\]::create|aesmanaged|aes\]::create|createdecryptor|cryptostream|transformfinalblock|convertto-securestring.*-key)/ nocase
    $proc.target.process.command_line = /(invoke-expression|\biex\b|\[scriptblock\]::create|assembly\]::load|\.invoke\()/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1480.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
