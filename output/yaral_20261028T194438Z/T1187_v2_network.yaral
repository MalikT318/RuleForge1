/*
  MITRE Technique : T1187 - Forced Authentication
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:32:48.858086+00:00
  Reference       : https://attack.mitre.org/techniques/T1187
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1187_Outbound_SMB_To_External_Forced_Auth {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an internal host making an outbound SMB/NetBIOS session (TCP 445 or 139) to an external address. Windows hosts authenticate automatically when they reach an SMB resource, so this network pattern is characteristic of forced authentication. Typical triggers are a UNC link in a phishing document, template injection, or a crafted shortcut that makes the victim send NTLM credentials to an attacker-controlled server. Perimeter policy normally blocks this traffic, so any attempt, allowed or denied, is worth review."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1187"
    mitre_technique_name = "Forced Authentication"
    log_prerequisites = "Firewall, proxy or perimeter logs normalised to UDM NETWORK_CONNECTION with populated principal.ip, target.ip and target.port. Egress SMB attempts must be logged, including denied ones, for full coverage."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Windows hosts using cloud file shares over SMB (e.g. Azure Files), site-to-site or VPN-routed traffic whose destination appears as a public address, authorised external penetration tests or vulnerability scans, and misconfigured split-tunnel VPN clients reaching corporate file servers via public NAT addresses."
    tuning_guidance = "Add authorised scanner or test source IPs to %global_allowed_scanners. Add known-good SMB cloud storage domains to %global_allowed_domains where the log carries target.hostname. Confirm %rfc1918_internal covers all internal and VPN ranges for the client. Investigate the source host for recent document opens, email attachments or browser activity around the connection time."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 445 or $net.target.port = 139)
    $net.principal.ip in %rfc1918_internal
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1187")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
