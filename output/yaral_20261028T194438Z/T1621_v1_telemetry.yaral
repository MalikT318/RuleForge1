/*
  MITRE Technique : T1621 - Multi-Factor Authentication Request Generation
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:46:06.746290+00:00
  Reference       : https://attack.mitre.org/techniques/T1621
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1621_MFA_Push_Hardening_Setting_Weakened {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change in the identity provider that weakens MFA push protections (number matching, additional context, verified push, MFA enforcement or policy exclusions). These settings are what make MFA fatigue / push bombing ineffective, so disabling or relaxing them is the state change that enables T1621. This detection works at the configuration layer rather than on sign-in volume or command lines."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1621"
    mitre_technique_name = "Multi-Factor Authentication Request Generation"
    log_prerequisites = "Requires identity provider admin/directory audit logs that are normalised to SETTING_MODIFICATION with target.resource.name (or the policy name) and metadata.description populated."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Planned MFA policy migrations (for example moving authentication methods), identity team rollouts of new authenticator types, break-glass or emergency access exclusions, and tenant onboarding or tuning by approved administrators."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users, automation and provisioning identities to %global_allowed_service_accounts, and approved identity automation principals to %global_allowed_cloud_principals. If the vendor logs policy names differently, widen or narrow the keyword groups on target.resource.name and metadata.description."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.target.resource.name = /(number.?match|additional.?context|app.?context|geo.?context|verified.?push|push.?notification|push.?verification|mfa|multi.?factor|authenticator|authentication.?method|sign.?on.?polic)/ nocase
    $setting.metadata.description = /(disabl|turn(ed)?.?off|remov|exclu|bypass|downgrad|reduc|relax|not.?required|unenforc|opt.?out)/ nocase
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1621")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $changed_setting = array_distinct($setting.target.resource.name)
    $source_ips = array_distinct($setting.principal.ip)

  condition:
    $setting
}
