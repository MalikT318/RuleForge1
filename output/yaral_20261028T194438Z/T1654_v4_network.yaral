/*
  MITRE Technique : T1654 - Log Enumeration
  Tactic(s)       : Discovery
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:59:03.107185+00:00
  Reference       : https://attack.mitre.org/techniques/T1654
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1654_ESXi_Log_Exfil_Utility_To_External_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi host opening an outbound connection to a non-internal address from a native transfer utility (scp, sftp, ssh, curl, wget, nc, python) whose command line references ESXi log files or directories (/var/log, /var/run/log, /scratch/log, hostd, vmkernel, vobd, auth.log, shell.log). This is the network-side signature of bulk log collection and export for offline analysis."
    mitre_tactic = "Discovery"
    mitre_technique = "T1654"
    mitre_technique_name = "Log Enumeration"
    log_prerequisites = "ESXi shell or process telemetry that populates NETWORK_CONNECTION events with principal.process.file.full_path and principal.process.command_line (for example, a host agent or syslog-forwarded process and connection data). Requires %rfc1918_internal to be populated for the tenant."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators manually copying logs or support bundles to a vendor support portal or an external jump host; scheduled log-archival scripts that push to an off-site collector; diagnostic uploads during an approved support case."
    tuning_guidance = "Add approved admin tooling paths to %global_allowed_admin_tools, approved administrator accounts to %global_allowed_admin_users, and backup or archival processes to %global_allowed_backup_processes. Add known vendor and log-collector domains to %global_allowed_domains. Ensure %rfc1918_internal covers all internal ranges of the tenant."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\/(scp|sftp|ssh|curl|wget|nc|ncat|netcat|python[0-9.]*)$/ nocase
    $net.principal.process.command_line = /(\/var\/(run\/)?log\/|\/scratch\/log|\bhostd\b|\bvmkernel\b|\bvobd\b|\bauth\.log\b|\bshell\.log\b|\bfdm\.log\b)/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.principal.user.userid in %global_allowed_admin_users
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1654")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $transfer_process = array_distinct($net.principal.process.file.full_path)
    $transfer_command = array_distinct($net.principal.process.command_line)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
