/*
  MITRE Technique : T1027.001 - Binary Padding
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:37:46.011027+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_001_Linux_Oversized_Staged_Binary_Artifact {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of an abnormally large file (100 MB or more) in world-writable Linux staging directories (/tmp, /var/tmp, /dev/shm) that does not carry a common data, archive, or log extension. Binary padding appends junk data to a payload to defeat hash blocklists and push it past scanner size limits. This rule detects the resulting oversized file artifact rather than the command that produced it, so it still fires when command-line logging is evaded."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.001"
    mitre_technique_name = "Obfuscated Files or Information: Binary Padding"
    log_prerequisites = "Requires Linux EDR or auditd file-creation telemetry that populates target.file.full_path and target.file.size. If the sensor does not populate file size, the rule will not fire."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup and imaging jobs staging temporary files, package managers or container tooling unpacking large images in /tmp, database export or core-dump utilities, software installers extracting large payloads, developers building large binaries in temp directories."
    tuning_guidance = "Add approved installers, deployment agents and build tooling to %global_allowed_admin_tools. Add backup and imaging software to %global_allowed_backup_processes. Add legitimate automation accounts to %global_allowed_service_accounts. Raise the size threshold (currently 104857600 bytes) for environments with heavy temp-directory use, or extend the extension exclusion regex for client-specific data formats."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// nocase
    $file.target.file.size >= 104857600
    not $file.target.file.full_path = /\.(tar|gz|tgz|bz2|xz|zst|zip|7z|iso|img|qcow2|vmdk|vdi|log|bak|sql|dump|core|db|deb|rpm|part|crdownload|swp|tmp)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $file_path = array_distinct($file.target.file.full_path)
    $file_size = max($file.target.file.size)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
