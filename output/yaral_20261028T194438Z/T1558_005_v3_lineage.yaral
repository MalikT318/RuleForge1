/*
  MITRE Technique : T1558.005 - Ccache Files
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:48:00.049474+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_005_Ccache_Access_From_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, script interpreter or file-copy utility that references Kerberos credential cache (ccache) files and was spawned by a web server, application server, database, or print service parent. These parents should not touch user Kerberos tickets. This lineage indicates a web shell, injected service or exploited daemon being used to steal tickets for Pass-the-Ticket."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.005"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Ccache Files"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE/SYSCALL records normalised to PROCESS_LAUNCH with parent process path and full command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Kerberos-integrated web applications (SPNEGO/GSSAPI) whose helper scripts call klist or kinit against a service ccache; database or application-server maintenance jobs that manage their own service-account tickets; Java or Node.js based admin tooling that legitimately shells out to inspect Kerberos state."
    tuning_guidance = "Add approved parent binaries to %global_allowed_script_hosts, approved tooling to %global_allowed_admin_tools, and Kerberos-aware service accounts to %global_allowed_service_accounts. If the parent list is too noisy for a client, remove generic runtimes (java, node) from the parent regex for that tenant."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|php-cgi|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|cupsd|smbd)$/ nocase
    $proc.target.process.file.full_path = /\/(ba|da|z|k|c|tc|a)?sh$|\/(python[0-9.]*|perl|ruby|php[0-9.]*|lua|cp|cat|base64|tar|scp|nc|ncat|xxd|dd)$/ nocase
    $proc.target.process.command_line = /(krb5cc_|krb5\.ccache|KRB5CCNAME|\/var\/lib\/sss\/db\/ccache_|\/run\/user\/[0-9]+\/krb5cc|\/tmp\/krb5cc)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1558.005")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
