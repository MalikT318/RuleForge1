/*
  MITRE Technique : T1546.015 - Component Object Model Hijacking
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:20:06.339208+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_015_COM_Hijack_User_Hive_Registry_Redirect {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry write to a per-user COM class registration (InprocServer32, LocalServer32, TreatAs) under the user's HKCU/HKU classes hive where the value points to a user-writable location or a script moniker. Per-user COM registrations take precedence over HKLM, so this redirects a legitimate COM object to attacker code. The rule works at the registry state-change layer and does not depend on command-line logging."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.015"
    mitre_technique_name = "Event Triggered Execution: Component Object Model Hijacking"
    log_prerequisites = "Requires endpoint registry telemetry (EDR or Sysmon registry events 12/13) that populates target.registry.registry_key and target.registry.registry_value_data."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-user application installers and updaters that register COM servers under HKCU (collaboration clients, cloud sync clients, Squirrel-style updaters, browser plug-ins), developer tooling registering test COM components, and MSI self-registration in a user context."
    tuning_guidance = "Add approved installer or deployment binaries to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Extend the process-name exclusion with software that is known to register per-user COM servers in the client environment. Review the value path and writing process first; legitimate registrations normally point to Program Files or System32, not to user-writable folders."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /^(HKU|HKEY_USERS|HKCU|HKEY_CURRENT_USER)\\/ nocase
    $reg.target.registry.registry_key = /(\\software\\classes|_classes)\\clsid\\\{[0-9a-f\-]+\}\\(inprocserver32|localserver32|treatas)/ nocase
    $reg.target.registry.registry_value_data = /(\\users\\[^\\]+\\|\\appdata\\|\\temp\\|\\programdata\\|\\public\\|\\downloads\\|^script:|scrobj\.dll|^https?:)/ nocase
    not $reg.principal.process.file.full_path = /\\(OneDrive|OneDriveSetup|Teams|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546.015")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value = array_distinct($reg.target.registry.registry_value_data)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
