/*
  MITRE Technique : T1074.002 - Remote Data Staging
  Tactic(s)       : Collection
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:21:16.695403+00:00
  Reference       : https://attack.mitre.org/techniques/T1074/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1074_002_Cloud_Bulk_Snapshot_Or_Object_Staging {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single cloud identity creates a high volume of snapshot, image, disk-copy or storage-object resources within ten minutes. Each API call is benign on its own, but the volume suggests data collected from multiple systems is being staged in one location before exfiltration."
    mitre_tactic = "Collection"
    mitre_technique = "T1074.002"
    mitre_technique_name = "Data Staged: Remote Data Staging"
    log_prerequisites = "Cloud control-plane audit logs (management and data-event audit trails) ingested and normalised to UDM RESOURCE_CREATION with metadata.product_event_type and principal.user.userid populated. Object-level write events require data-event logging to be enabled."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Backup and disaster-recovery automation, CI/CD pipelines publishing artefacts, data-lake ingestion jobs, migration projects, and administrators running scheduled snapshot or image-baking jobs."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts, approved service principals to %global_allowed_cloud_principals, and named administrators to %global_allowed_admin_users. Raise the #cloud threshold for environments with heavy artefact publishing. Narrow the product_event_type regex if object-level writes are too noisy."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /(snapshot|copyobject|putobject|createimage|copyimage|createdisk|copyblob|putblob|images\.insert|disks\.insert)/ nocase
    $cloud.principal.user.userid != ""
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($cloud.metadata.id)
    $mitre_technique_id = array_distinct("T1074.002")
    $primary_entity = array_distinct($user)
    $staged_resources = array_distinct($cloud.target.resource.name)
    $api_calls = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    #cloud >= 10
}
