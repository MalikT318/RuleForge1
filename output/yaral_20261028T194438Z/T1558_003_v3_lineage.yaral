/*
  MITRE Technique : T1558.003 - Kerberoasting
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:44:02.313249+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_003_Kerberoast_Anomalous_Parent_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, script interpreter or SPN enumeration binary spawned by an unexpected parent (Office application, web server, database service or print spooler) with command-line content that enumerates SPNs or requests Kerberos service tickets. Legitimate Kerberos service-ticket enumeration almost never originates from these parents, so this is a strong sign of post-exploitation Kerberoasting."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.003"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Kerberoasting"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry (EDR, Sysmon Event ID 1 or Security Event 4688 with command-line auditing enabled) with parent process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web or database applications that legitimately shell out to run SPN or Kerberos diagnostics, Office macros or add-ins used by IT for AD inventory, and administrator troubleshooting through a web-based management console."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts. Add named administrators to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Extend or trim the parent process list to match the client's server estate."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|sqlservr|spoolsv)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|setspn)\.exe$/ nocase
    $proc.target.process.command_line = /(KerberosRequestorSecurityToken|System\.IdentityModel\.Tokens|\bsetspn(\.exe)?\b.*\s-[qt]\b|\bsetspn(\.exe)?\b.*\*\/\*|\(servicePrincipalName=|servicePrincipalName\s*-like|servicePrincipalName=\*)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1558.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
