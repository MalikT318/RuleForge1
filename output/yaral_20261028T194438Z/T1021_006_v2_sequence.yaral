/*
  MITRE Technique : T1021.006 - Windows Remote Management
  Tactic(s)       : Lateral Movement
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:43:20.877799+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_006_WinRM_Chained_Hop_Firewall {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a chained WinRM lateral movement hop seen at the network perimeter. One internal host connects to the WinRM ports (5985/5986) of a pivot host, and within 10 minutes that pivot host opens its own WinRM connection to a third host. Admins rarely chain WinRM sessions this way, but attackers do when moving through a network with valid accounts."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.006"
    mitre_technique_name = "Remote Services: Windows Remote Management"
    log_prerequisites = "Requires firewall, proxy or network flow logs that cover east-west (internal segment) traffic and are normalised to UDM NETWORK_CONNECTION events with principal.ip, target.ip and target.port populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Jump-host or bastion administration workflows, RMM or patching servers that relay WinRM sessions, orchestration and automation platforms (configuration management, SCCM-style deployment), and authorised vulnerability scanners probing WinRM ports."
    tuning_guidance = "Add approved admin, jump-host and orchestration source addresses to %global_allowed_mgmt_sources. Add scanner addresses to %global_allowed_scanners. If the firewall only sees north-south traffic, deploy this rule only for clients with internal segmentation firewall logging."

  events:
    // Hop 1: any source connects to WinRM (HTTP 5985 / HTTPS 5986) on the pivot host
    $hop1.metadata.event_type = "NETWORK_CONNECTION"
    $hop1.target.port >= 5985
    $hop1.target.port <= 5986
    $hop1.target.ip = $pivot
    $hop1.principal.ip != $hop1.target.ip
    not $hop1.principal.ip in %global_allowed_mgmt_sources
    not $hop1.principal.ip in %global_allowed_scanners

    // Hop 2: the pivot host itself connects to WinRM on a different host
    $hop2.metadata.event_type = "NETWORK_CONNECTION"
    $hop2.target.port >= 5985
    $hop2.target.port <= 5986
    $hop2.principal.ip = $pivot
    $hop2.target.ip != $hop2.principal.ip
    not $hop2.principal.ip in %global_allowed_mgmt_sources
    not $hop2.principal.ip in %global_allowed_scanners

    // The chain must go onward, not loop back to the original source
    $hop1.principal.ip != $hop2.target.ip

    // Chronological order
    $hop1.metadata.event_timestamp.seconds < $hop2.metadata.event_timestamp.seconds

  match:
    $pivot over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1021.006")
    $primary_entity = array_distinct($hop2.principal.ip)
    $initial_sources = array_distinct($hop1.principal.ip)
    $final_targets = array_distinct($hop2.target.ip)
    $winrm_ports_used = array_distinct($hop2.target.port)
    $hop_event_count = count($hop2.metadata.id)

  condition:
    $hop1 and $hop2
}
