/*
  MITRE Technique : T1204.004 - Malicious Copy and Paste
  Tactic(s)       : Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:04:16.998088+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_004_ClickFix_Lure_Then_Scripted_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the network footprint of a ClickFix-style lure. A browser requests a fake CAPTCHA or human-verification page on an external site, then the same source address makes an external HTTP request with a scripting-client user agent (PowerShell, curl, Wget, mshta) within 10 minutes. This is consistent with a user pasting a command that fetches a second-stage payload. Uses proxy/firewall HTTP telemetry only, so it complements process command-line detections."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.004"
    mitre_technique_name = "User Execution: Malicious Copy and Paste"
    log_prerequisites = "Requires firewall or web proxy logs normalised to NETWORK_HTTP, with network.http.user_agent, target.url, and principal.ip populated. TLS inspection is needed to see URLs and user agents on HTTPS traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Legitimate sites with human-verification pages followed by admin scripts or package managers (PowerShell-based installers, curl in developer workflows) from the same host. Vendor onboarding and CAPTCHA flows in SaaS portals. NAT or shared proxy egress addresses can join unrelated users."
    tuning_guidance = "Add known-good vendor and update domains to %global_allowed_domains. Add scanner and automation sources to %global_allowed_scanners. Add approved management sources to %global_allowed_mgmt_sources. If clients egress through a shared NAT address, consider excluding that address or joining on a per-user identifier where available."

  events:
    $lure.metadata.event_type = "NETWORK_HTTP"
    $lure.network.http.user_agent = /(Chrome|Firefox|Edg|Safari)\// nocase
    $lure.target.url = /(captcha|verify[-_]?(you|human|yourself)|not[-_]?a[-_]?robot|human[-_]?verif|are[-_]?you[-_]?human)/ nocase
    not $lure.target.ip in %rfc1918_internal
    not $lure.target.hostname in %global_allowed_domains
    $lure.principal.ip = $src_ip

    $stage.metadata.event_type = "NETWORK_HTTP"
    $stage.network.http.user_agent = /(WindowsPowerShell|PowerShell\/|curl\/|Wget\/|mshta|Windows Script Host)/ nocase
    not $stage.target.ip in %rfc1918_internal
    not $stage.target.hostname in %global_allowed_domains
    not $stage.principal.ip in %global_allowed_scanners
    $stage.principal.ip = $src_ip

    $lure.target.hostname != $stage.target.hostname
    $lure.metadata.event_timestamp.seconds <= $stage.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1204.004")
    $primary_entity = array_distinct($src_ip)
    $lure_urls = array_distinct($lure.target.url)
    $stage_urls = array_distinct($stage.target.url)
    $stage_user_agents = array_distinct($stage.network.http.user_agent)
    $stage_destination_ips = array_distinct($stage.target.ip)

  condition:
    $lure and $stage
}
