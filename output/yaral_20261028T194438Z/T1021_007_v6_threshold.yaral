/*
  MITRE Technique : T1021.007 - Cloud Services
  Tactic(s)       : Lateral Movement
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:45:37.145776+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_007_Burst_Cloud_App_Logins_Single_User {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single federated identity records a burst of logins to cloud applications within ten minutes, from non-internal source addresses. A user normally signs in a handful of times in that window. A burst suggests valid or federated credentials, or stolen application tokens, being used to reach cloud services, such as scripted CLI or PowerShell sign-ins sweeping across applications."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.007"
    mitre_technique_name = "Remote Services: Cloud Services"
    log_prerequisites = "Identity provider sign-in audit logs normalised to UDM USER_LOGIN, with principal.user.userid, principal.ip and target.application populated."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Users with many SSO tiles that reauthenticate after a session or token expiry, password-manager or browser autofill loops, monitoring or synthetic login checks, mobile clients retrying with stale tokens, shared kiosk accounts, and integration accounts not yet in the allowlists."
    tuning_guidance = "Add automation and integration accounts to %global_allowed_service_accounts, and named administrators to %global_allowed_admin_users. Add known scanner or test sources to %global_allowed_scanners. Raise the #auth threshold (default 10) for tenants with heavy SSO use, or lower it for high-security tenants. Review the distinct_apps and source_ips outcome values to separate token-refresh noise from real sweeping."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid = $user
    $auth.target.application != ""
    not $auth.principal.ip in %rfc1918_internal
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users
    not $auth.principal.ip in %global_allowed_scanners

  match:
    $user over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1021.007")
    $primary_entity = array_distinct($user)
    $login_count = count($auth.metadata.id)
    $distinct_apps = array_distinct($auth.target.application)
    $source_ips = array_distinct($auth.principal.ip)

  condition:
    #auth >= 10
}
