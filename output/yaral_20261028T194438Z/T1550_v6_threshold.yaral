/*
  MITRE Technique : T1550 - Use Alternate Authentication Material
  Tactic(s)       : Lateral Movement
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:36:26.784736+00:00
  Reference       : https://attack.mitre.org/techniques/T1550
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1550_Cloud_Identity_Token_Replay_Login_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single cloud identity produces a burst of sign-in or token-based authentication events from external source addresses within ten minutes. Replay of stolen session cookies, access tokens or refresh tokens, and automated pass-the-token tooling, produce many authentications for one account without the interactive pattern of a normal user. Each sign-in is benign on its own, and the volume for one user is what indicates abuse."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1550"
    mitre_technique_name = "Use Alternate Authentication Material"
    log_prerequisites = "Requires cloud control-plane and identity sign-in audit logs normalised to USER_LOGIN with principal.user.userid and principal.ip populated. Examples are IaaS console and API authentication and federated or SSO sign-in events."
    platform = "IaaS"
    log_source = "identity"
    false_positives = "Unlisted CI/CD pipelines, automation or monitoring accounts that re-authenticate frequently. SSO or federation clients that refresh tokens aggressively. Users behind corporate egress or VPN addresses not covered by the internal list. Mobile clients that retry on poor connectivity. Penetration tests or red team exercises."
    tuning_guidance = "Add service and automation identities to %global_allowed_service_accounts and %global_allowed_cloud_principals. Add approved administrator accounts to %global_allowed_admin_users. Raise the #auth threshold if a client has chatty SSO refresh behaviour. If the logs carry a successful-outcome field, add that filter per client. Review $source_ips in the outcome: many distinct addresses for one user strongly indicates token replay."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid = $user
    $auth.principal.user.userid != ""
    not $auth.principal.ip in %rfc1918_internal
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_cloud_principals
    not $auth.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $login_count = count($auth.metadata.id)
    $mitre_technique_id = array_distinct("T1550")
    $primary_entity = array_distinct($user)
    $source_ips = array_distinct($auth.principal.ip)
    $target_apps = array_distinct($auth.target.application)

  condition:
    #auth >= 15
}
