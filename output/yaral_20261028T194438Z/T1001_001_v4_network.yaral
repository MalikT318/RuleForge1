/*
  MITRE Technique : T1001.001 - Junk Data
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:06:25.919771+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_001_Linux_Junk_Data_HTTP_Padding {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux process that is either a script interpreter, shell or relay utility, or is running from a world-writable directory such as /tmp, /var/tmp or /dev/shm. The process makes an outbound HTTP request to an external destination whose URL carries a very long, random-looking token in the query string or path. This is consistent with junk or padding data added to C2 traffic to defeat simple decoding and signature inspection."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001.001"
    mitre_technique_name = "Data Obfuscation: Junk Data"
    log_prerequisites = "Requires Linux endpoint network telemetry or a network sensor that attributes HTTP requests to the originating process (principal.process.file.full_path) and populates target.url, target.hostname and target.ip."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers or installers fetching signed or tokenised URLs, CI/CD runners and build scripts calling cloud storage with pre-signed URLs, monitoring or telemetry agents using long opaque tokens, OAuth or SSO callbacks made by scripts, and developer tooling run from /tmp."
    tuning_guidance = "Add known-good destination domains to %global_allowed_domains, approved tooling binaries to %global_allowed_admin_tools, and approved script-hosting binaries to %global_allowed_script_hosts. If pre-signed cloud storage URLs are noisy, add those storage domains to %global_allowed_domains. To tighten the rule, raise the token length thresholds in the URL regex."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/|\/(python[0-9.]*|perl|ruby|php|node|bash|sh|dash|zsh|nc|ncat|socat)$/ nocase
    $net.target.url = /[?&;][^=&\s]{0,64}=[A-Za-z0-9+\/_%-]{150,}|\/[A-Za-z0-9+_-]{120,}(\/|\?|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1001.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $source_process = array_distinct($net.principal.process.file.full_path)

  condition:
    $net
}
