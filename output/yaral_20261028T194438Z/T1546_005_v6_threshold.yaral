/*
  MITRE Technique : T1546.005 - Trap
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:08:23.947715+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_005_Shell_Startup_File_Modification_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of modifications to shell startup and logout files (.bashrc, .bash_profile, .profile, .bash_logout, .zshrc, /etc/profile, /etc/profile.d/*, /etc/bash.bashrc) on a single Linux host within 10 minutes. Trap-based persistence is planted in these files so the handler runs on shell start, exit or interrupt. One edit is routine, but repeated edits in a short window suggest scripted implantation. Complements command-line rules by using file telemetry."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.005"
    mitre_technique_name = "Event Triggered Execution: Trap"
    log_prerequisites = "Requires Linux EDR or auditd file-modification telemetry (watches on shell startup files and /etc/profile.d) normalised to UDM FILE_MODIFICATION with principal.hostname, target.file.full_path and principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management (Ansible, Puppet, Chef, Salt) pushing shell profiles, package managers updating /etc/profile.d scripts, admins editing dotfiles, dotfile-sync tools, and user provisioning or onboarding scripts."
    tuning_guidance = "Add config-management and provisioning binaries to %global_allowed_admin_tools and trusted admin accounts to %global_allowed_admin_users. Raise the #file threshold on hosts with frequent legitimate profile changes. Review hits for trap statements in the modified files."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /(^|\/)\.(bashrc|bash_profile|bash_login|profile|bash_logout|zshrc|zprofile|zlogin|zlogout)$|^\/etc\/(profile|bash\.bashrc|bashrc|zshrc|zlogout|bash\.bash_logout)$|^\/etc\/profile\.d\/[^\/]+$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|yum|dnf|zypper|snapd)$/ nocase

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($file.metadata.id)
    $modified_files = array_distinct($file.target.file.full_path)
    $modifying_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)
    $mitre_technique_id = array_distinct("T1546.005")
    $primary_entity = array_distinct($host)

  condition:
    #file >= 3
}
