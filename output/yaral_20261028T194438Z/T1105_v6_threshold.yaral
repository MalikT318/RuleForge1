/*
  MITRE Technique : T1105 - Ingress Tool Transfer
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:13:52.245532+00:00
  Reference       : https://attack.mitre.org/techniques/T1105
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1105_Perimeter_Bulk_Executable_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source retrieves several executable, script, installer or archive-type files over HTTP from external destinations within ten minutes. One download is routine, but repeated retrieval of payload-type files from outside the network indicates tool staging (ingress tool transfer). The rule uses only proxy or firewall URL telemetry and does not depend on the initiating process."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1105"
    mitre_technique_name = "Ingress Tool Transfer"
    log_prerequisites = "Requires firewall or web proxy logs normalised to NETWORK_HTTP with target.url populated (URL-aware inspection or TLS decryption for HTTPS)."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Software deployment and patching from vendor CDNs, developer and build workstations pulling packages, IT staff downloading installers, update services not yet in the allowed domain list."
    tuning_guidance = "Add known-good vendor and update domains to %global_allowed_domains. Add approved deployment, patching and management source addresses to %global_allowed_mgmt_sources. Raise the #http threshold for build or developer subnets."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\.(exe|dll|msi|msix|ps1|bat|cmd|vbs|vbe|js|jse|hta|scr|jar|cab|iso|img|zip|7z|rar)([?#].*)?$/ nocase
    $http.principal.ip = $src
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_mgmt_sources

  match:
    $src over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1105")
    $primary_entity = array_distinct($src)
    $download_count = count($http.metadata.id)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $downloaded_urls = array_distinct($http.target.url)

  condition:
    #http >= 5
}
