/*
  MITRE Technique : T1027.010 - Command Obfuscation
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:54:28.232419+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_010_Linux_Obfuscated_Artifact_Name_In_Temp_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a file in a world-writable Linux staging directory (/tmp, /var/tmp, /dev/shm) whose name contains two or more shell metacharacters (for example $, &, ;, |, backticks, braces, quotes, globs). Globbing and special-character path tricks are a documented command-obfuscation technique, and obfuscation frameworks drop payloads, wrappers and staging directories with names like this. This is a file-artifact detection and does not depend on command-line matching."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.010"
    mitre_technique_name = "Obfuscated Files or Information: Command Obfuscation"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd (PATH/CREATE records) normalised to UDM FILE_CREATION with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Build systems and CI runners that generate temp files with special characters, desktop applications and browsers writing temp files, language runtimes or package managers using templated temp names, and admin scripts that deliberately use special-character names."
    tuning_guidance = "Add approved build, packaging and automation parent binaries to %global_allowed_admin_tools and approved hosts or interpreters to %global_allowed_script_hosts. Raise the metacharacter repeat count from 2 to 3 for noisy environments. Add service accounts that legitimately generate such files to %global_allowed_service_accounts."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/(?:[^\/]*\/)*([^\/]*[\$&;\|`\{\}<>!\\'"*?]){2,}[^\/]*$/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.010")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_paths = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
