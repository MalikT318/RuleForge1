/*
  MITRE Technique : T1003.006 - DCSync
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:48:10.183688+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_006_DCSync_RPC_Endpoint_Mapper_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Network-layer indicator of possible DCSync preparation: a single internal source opens an unusually high number of connections to the Windows RPC endpoint mapper (TCP/135) within ten minutes. DCSync (DRSUAPI replication) starts with an endpoint-mapper lookup followed by a dynamic high-port RPC bind to a domain controller, so a non-infrastructure host generating repeated RPC mapper traffic is a lead for review. Individual connections are benign. This is a low-fidelity, volume-based hunting signal for segmented networks where the perimeter or internal firewall sees workstation-to-server traffic. It complements, and does not replace, endpoint and Windows Security event (4662) detections."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.006"
    mitre_technique_name = "OS Credential Dumping: DCSync"
    log_prerequisites = "Firewall or network perimeter logs that record allowed internal east-west connections (source IP, destination IP, destination port) and are normalised to UDM NETWORK_CONNECTION. Traffic between user and server network segments must traverse the logging firewall."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Domain-joined hosts with heavy legitimate RPC/DCOM use (WMI, remote Event Log, SCCM/MECM, backup agents), Active Directory and Exchange servers, vulnerability scanners, monitoring systems, domain migration and replication tooling, and identity or admin jump hosts."
    tuning_guidance = "Add known management, monitoring and jump-host source addresses to %global_allowed_mgmt_sources and approved scanner addresses to %global_allowed_scanners. Raise the #fw threshold in noisy environments, or scope firewall log ingestion to user-to-server segments only. Review the destination IPs in the outcome and prioritise sources that connect to domain controllers but are not themselves servers or admin hosts."

  events:
    $fw.metadata.event_type = "NETWORK_CONNECTION"
    $fw.target.port = 135
    $fw.principal.ip = $src
    not $fw.principal.ip in %global_allowed_mgmt_sources
    not $fw.principal.ip in %global_allowed_scanners

  match:
    $src over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1003.006")
    $primary_entity = array_distinct($src)
    $event_count = count($fw.metadata.id)
    $destination_ips = array_distinct($fw.target.ip)

  condition:
    #fw >= 10
}
