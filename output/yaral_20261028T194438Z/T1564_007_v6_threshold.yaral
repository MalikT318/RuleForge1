/*
  MITRE Technique : T1564.007 - VBA Stomping
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:25:27.300475+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_007_Office_Macro_Security_Registry_Tampering_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several Microsoft Office Trust Center (Security) registry values, such as AccessVBOM, VBAWarnings and Protected View settings, are modified on one host within ten minutes. VBA stomping tooling needs programmatic access to the VBA project object model, and macro delivery chains typically relax macro and Protected View controls so the stomped p-code will run. One change can be benign. A burst of changes across these keys is a strong precursor to VBA stomping or macro-based payload staging."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.007"
    mitre_technique_name = "Hide Artifacts: VBA Stomping"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events 12/13/14) normalised to UDM REGISTRY_MODIFICATION with target.registry.registry_key and registry_value_name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy or MDM enforcement of Office security baselines, Office installation or upgrade, enterprise macro-signing or document-automation deployments, developers or admins enabling VBA object model access for legitimate add-ins, Office profile migration tools."
    tuning_guidance = "Add deployment and configuration tooling to %global_allowed_admin_tools, EDR and security agents to %global_allowed_security_tools, and baseline-enforcing admin accounts to %global_allowed_admin_users. Raise the #reg threshold on estates with frequent GPO refreshes. Severity and risk score are raised in outcome when AccessVBOM is among the modified values."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Software\\Microsoft\\Office\\[0-9.]+\\(Word|Excel|PowerPoint|Access|Publisher|Common)\\Security/ nocase
    $reg.target.registry.registry_value_name = /^(AccessVBOM|VBAWarnings|BlockContentExecutionFromInternet|DisableInternetFilesInPV|DisableAttachementsInPV|DisableUnsafeLocationsInPV|DisableDDEServerLaunch)$/ nocase
    $reg.principal.hostname = $host
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(strings.to_lower($reg.target.registry.registry_value_name) = "accessvbom", 80, 55))
    $event_count = count($reg.metadata.id)
    $modified_values = array_distinct($reg.target.registry.registry_value_name)
    $modifying_processes = array_distinct($reg.principal.process.file.full_path)
    $affected_users = array_distinct($reg.principal.user.userid)
    $mitre_technique_id = array_distinct("T1564.007")
    $primary_entity = array_distinct($host)

  condition:
    #reg >= 3
}
