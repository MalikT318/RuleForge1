/*
  MITRE Technique : T1205.001 - Port Knocking
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:10:50.217454+00:00
  Reference       : https://attack.mitre.org/techniques/T1205/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_001_Inbound_Port_Knock_Sequence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects the network signature of port knocking against a Windows host. A single external source makes a short, bounded burst of 3 to 10 connection attempts to one internal destination within two minutes, which matches a knock sequence. The upper bound separates knocking from broad port scans, which hit far more ports. A true single-event rule cannot see a sequence, so this uses a threshold window on one event type."
    mitre_tactic = "Stealth, Persistence, Command and Control"
    mitre_technique = "T1205.001"
    mitre_technique_name = "Traffic Signaling: Port Knocking"
    log_prerequisites = "Requires perimeter or host firewall connection logs, including denied and dropped attempts, normalised to NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Closed-port attempts must be logged for the knock sequence to be visible."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Unauthorised or authorised port scanners, vulnerability assessment tools, internet background scanning, application retry storms against unavailable services, VPN or remote access clients probing several ports, and monitoring probes."
    tuning_guidance = "Add approved scanner sources to %global_allowed_scanners and trusted management source addresses to %global_allowed_mgmt_sources. Adjust the lower and upper count bounds per client based on firewall logging volume. If only allowed traffic is logged, coverage is limited and the rule needs denied-traffic logging enabled. Extend the excluded common-service port list as needed."

  events:
    $fw.metadata.event_type = "NETWORK_CONNECTION"
    $fw.principal.ip = $src_ip
    $fw.target.ip = $dst_ip
    $fw.target.port != 80
    $fw.target.port != 443
    $fw.target.port != 53
    $fw.target.port != 123
    not $fw.principal.ip in %rfc1918_internal
    not $fw.principal.ip in %global_allowed_scanners
    not $fw.principal.ip in %global_allowed_mgmt_sources

  match:
    $src_ip, $dst_ip over 2m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1205.001")
    $primary_entity = array_distinct($fw.target.ip)
    $source_ips = array_distinct($fw.principal.ip)
    $knock_ports = array_distinct($fw.target.port)
    $attempt_count = count($fw.metadata.id)

  condition:
    #fw >= 3 and #fw <= 10
}
