/*
  MITRE Technique : T1547.008 - LSASS Driver
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:34:27.685927+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_008_LSASS_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Local Security Authority process (lsass.exe) initiating an outbound network connection to a non-internal address. lsass.exe normally talks only to domain controllers, DNS and other internal infrastructure. A malicious LSA driver, authentication package or notification package loaded into lsass.exe for persistence (T1547.008) will often beacon or exfiltrate from inside this process, which shows up as external traffic with lsass.exe as the source."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.008"
    mitre_technique_name = "Boot or Logon Autostart Execution: LSASS Driver"
    log_prerequisites = "Requires Windows endpoint network telemetry that attributes outbound connections to the initiating process (EDR network events or Sysmon Event ID 3), normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Domain controllers or AD CS servers fetching CRL/OCSP/AIA data during certificate validation; hybrid-identity (Entra ID/Azure AD) pass-through or seamless SSO traffic from lsass.exe; Kerberos or LDAP traffic to external or cloud-hosted domain controllers over VPN or public addressing; EDR agents that attribute connections to lsass.exe incorrectly."
    tuning_guidance = "Add known-good cloud identity or certificate endpoints to %global_allowed_domains. Add security agents that attribute traffic to lsass.exe to %global_allowed_security_tools. Make sure %rfc1918_internal covers every internal range in the tenant (loopback, link-local and routed private ranges), including cloud-hosted domain controllers. Where cloud-hosted domain controllers use public addressing, scope those hosts out through a tenant-level exclusion."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\lsass\.exe$/ nocase
    $net.principal.hostname != ""
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.008")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $destination_hosts = array_distinct($net.target.hostname)

  condition:
    $net
}
