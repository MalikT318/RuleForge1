/*
  MITRE Technique : T1569.002 - Service Execution
  Tactic(s)       : Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:11:03.296440+00:00
  Reference       : https://attack.mitre.org/techniques/T1569/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_002_Service_ImagePath_Set_To_Suspicious_Command {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows service ImagePath registry value being written with an interpreter or LOLBin command, a user-writable or temp location, or a UNC admin-share path. This is the state change left by service-based execution (PsExec-style temporary services, sc.exe create/config, direct SCM API abuse), and it fires regardless of how the service was created or whether command-line logging is available."
    mitre_tactic = "Execution"
    mitre_technique = "T1569.002"
    mitre_technique_name = "System Services: Service Execution"
    log_prerequisites = "Requires Windows registry modification telemetry from an EDR or Sysmon (Event ID 13) with the registry key and value data populated in UDM. Registry auditing of HKLM\\SYSTEM\\CurrentControlSet\\Services must be enabled."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and updaters that register services from ProgramData or AppData; RMM and deployment agents; vulnerability scanners and remote administration tools that install temporary services; legitimate admin scripts that wrap a service in cmd.exe or powershell.exe."
    tuning_guidance = "Add approved installer, RMM and deployment binaries to %global_allowed_admin_tools. Add EDR/AV agents to %global_allowed_security_tools. Add authorised scanners that install temporary services to %global_allowed_scanners. Add approved remote management tooling to %global_allowed_remote_mgmt. Extend the vendor-engine exclusion on ImagePath by executable name if a known-good service runs from a user-writable path."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      $reg.target.registry.registry_key = /\\(CurrentControlSet|ControlSet00\d)\\Services\\[^\\]+\\ImagePath$/ nocase or
      (
        $reg.target.registry.registry_key = /\\(CurrentControlSet|ControlSet00\d)\\Services\\[^\\]+$/ nocase and
        $reg.target.registry.registry_value_name = "ImagePath" nocase
      )
    )
    $reg.target.registry.registry_value_data = /(%comspec%|\bcmd(\.exe)?\s+\/[ck]|\b(powershell|pwsh|mshta|rundll32|regsvr32|wscript|cscript|msiexec|certutil|bitsadmin)(\.exe)?\b|\\(temp|tmp|appdata|downloads)\\|\\users\\public\\|\\programdata\\|\\windows\\debug\\|\\\\[^\\]+\\(admin|c|ipc)\$)/ nocase
    not $reg.target.registry.registry_value_data = /\\(MsMpEng|NisSrv|MsSense|SenseIR)\.exe/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path in %global_allowed_scanners
    not $reg.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1569.002")
    $primary_entity = array_distinct($reg.principal.hostname)
    $service_registry_key = array_distinct($reg.target.registry.registry_key)
    $image_path = array_distinct($reg.target.registry.registry_value_data)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
