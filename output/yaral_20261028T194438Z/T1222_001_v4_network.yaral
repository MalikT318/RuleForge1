/*
  MITRE Technique : T1222.001 - Windows Permissions
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:18:49.485412+00:00
  Reference       : https://attack.mitre.org/techniques/T1222/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1222_001_Permission_Tool_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a native Windows file-permission or attribute utility (icacls, cacls, xcacls, takeown, attrib) making a network connection to a non-internal address. These utilities are local-only and do not normally initiate external connections. External traffic from them suggests a renamed or hollowed process, injected code running under a trusted permission-modifying binary, or a wrapper tool using one of them to tamper with ACLs and stage or exfiltrate files."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1222.001"
    mitre_technique_name = "File and Directory Permissions Modification: Windows File and Directory Permissions Modification"
    log_prerequisites = "Requires endpoint network telemetry that records the initiating process path (Sysmon Event ID 3 or equivalent EDR network connection events) normalised to UDM NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Proxy-aware or VPN-routed environments where the endpoint agent attributes the egress connection to the wrong process; EDR or sensor attribution quirks; software deployment or RMM tooling that wraps these utilities and is not yet in the admin tools list; certificate revocation or telemetry lookups triggered by signed-binary validation."
    tuning_guidance = "Add approved deployment or RMM binaries to %global_allowed_admin_tools. Make sure %rfc1918_internal covers all client internal address space, including any CGNAT or private ranges in use. If the sensor misattributes proxy traffic, review the principal process attribution settings in the endpoint agent for the affected client."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(icacls|cacls|xcacls|takeown|attrib)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1222.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $initiating_command_line = array_distinct($net.principal.process.command_line)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
