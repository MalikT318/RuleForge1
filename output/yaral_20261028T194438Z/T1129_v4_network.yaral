/*
  MITRE Technique : T1129 - Shared Modules
  Tactic(s)       : Execution
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:42:18.379754+00:00
  Reference       : https://attack.mitre.org/techniques/T1129
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1129_Outbound_SMB_To_External_UNC_Module_Load {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an internal host opening an SMB connection (TCP 445 or 139) to an external, non-RFC1918 address. The Windows module loader can load DLLs from arbitrary UNC paths, so an outbound SMB session to the internet is the network-observable footprint of a remote shared module being pulled into a process (LoadLibrary on a UNC path). It is also a strong indicator of credential leakage and remote payload staging. The rule uses only perimeter fields (source, destination, port) and no endpoint process data."
    mitre_tactic = "Execution"
    mitre_technique = "T1129"
    mitre_technique_name = "Shared Modules"
    log_prerequisites = "Requires firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated for egress traffic. Egress SMB must be logged, including denied or allowed sessions where the log source reports them as connection events."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Hosts with legitimately routed SMB to cloud-hosted file services (for example SMB over VPN or ExpressRoute-style links that appear with public addresses), split-tunnel VPN clients, misconfigured internal subnets that are not covered by the internal address list, authorised external penetration tests or vulnerability scans, and partner or B2B file exchange that uses SMB."
    tuning_guidance = "Confirm %rfc1918_internal covers all internal and private-link address space for the client. Add authorised scanner and testing source addresses to %global_allowed_scanners. For clients with a legitimate SMB-to-cloud design, scope exclusions by source address through %global_allowed_scanners or a client-specific suppression, rather than widening the port list."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 445 or $net.target.port = 139)
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1129")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $source_hostnames = array_distinct($net.principal.hostname)

  condition:
    $net
}
