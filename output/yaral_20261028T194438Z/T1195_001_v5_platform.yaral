/*
  MITRE Technique : T1195.001 - Compromise Software Dependencies and Development Tools
  Tactic(s)       : Initial Access
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:40:57.889287+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_001_Linux_Package_Manager_Spawns_Download_Execute_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux shell launched by a language package manager or runtime (npm, node, yarn, pnpm, pip, python, gem, composer, cargo, go) whose command line downloads and executes content: curl/wget piped to a shell, base64-decoded payload piped to a shell, or a download staged in /tmp, /var/tmp or /dev/shm and made executable. This is the typical result of a malicious install or postinstall hook in a trojanised or typosquatted dependency."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.001"
    mitre_technique_name = "Supply Chain Compromise: Compromise Software Dependencies and Development Tools"
    log_prerequisites = "Linux EDR or auditd (execve) telemetry normalised to UDM PROCESS_LAUNCH with populated parent process path and child command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developer or CI tooling whose install scripts legitimately bootstrap via curl|sh (version managers, Rust/Node toolchain installers, native binary downloaders in postinstall hooks), internal build systems that stage helper binaries in /tmp, and configuration management run through python."
    tuning_guidance = "Add approved build and CI parent binaries to %global_allowed_script_hosts and sanctioned deployment tooling to %global_allowed_admin_tools. Review hosts that are developer workstations or build runners first, as these are the most likely sources of both true and benign hits. If CI runners are noisy, scope them via the allowed lists rather than weakening the command-line logic."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(npm|npx|node|nodejs|yarn|pnpm|pip[0-9.]*|pipx|python[0-9.]*|gem|bundle|composer|cargo|go)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ash)$/ nocase
    (
      $proc.target.process.command_line = /(curl|wget)\b.*\|\s*(sudo\s+)?(ba|z|da|a)?sh\b/ nocase or
      $proc.target.process.command_line = /base64\s+(-d|--decode)\b.*\|\s*(sudo\s+)?(ba|z|da|a)?sh\b/ nocase or
      $proc.target.process.command_line = /(curl|wget)\b.*(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/).*chmod\s+(\+|[0-7]*7)[ugoarwx]*/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1195.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
