/*
  MITRE Technique : T1137.003 - Outlook Forms
  Tactic(s)       : Persistence
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:17:00.532477+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_003_Outlook_Custom_Form_Mailbox_Audit {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or update of an Outlook custom form definition (forms description item or form template .oft) in a mailbox, as recorded by the unified audit log. Malicious custom forms are a persistence and code-execution mechanism that runs when Outlook loads the form or when a crafted message of that form class is received. This rule works from the mailbox audit state change and does not depend on endpoint command-line logging."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.003"
    mitre_technique_name = "Office Application Startup: Outlook Forms"
    log_prerequisites = "Requires Microsoft 365 unified audit logging with Exchange mailbox auditing enabled (Create and Update actions audited for owner, delegate and admin logon types), ingested into Chronicle."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Business users or developers who legitimately publish custom Outlook forms (for example HR, helpdesk or workflow templates), organisational forms library maintenance by Exchange administrators, and migration tools that copy mailbox associated items between mailboxes."
    tuning_guidance = "Add expected form publishers to %global_allowed_admin_users or %global_allowed_service_accounts. Add migration and automation principals to %global_allowed_cloud_principals. If the tenant's parser places the message class in a different field, adjust the target field regex accordingly. Review any hit where the form was written by a delegate or a non-owner logon."

  events:
    $form.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"
    $form.metadata.product_event_type = /^(Create|Update)$/ nocase
    (
      $form.target.resource.name = /IPM\.Microsoft\.FolderDesign\.FormsDescription|IPM\.Microsoft\.OutlookForm|\.oft$/ nocase or
      $form.target.file.full_path = /IPM\.Microsoft\.FolderDesign\.FormsDescription|IPM\.Microsoft\.OutlookForm|\.oft$/ nocase
    )
    not $form.principal.user.userid in %global_allowed_service_accounts
    not $form.principal.user.userid in %global_allowed_admin_users
    not $form.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1137.003")
    $primary_entity = array_distinct($form.principal.user.userid)
    $source_ips = array_distinct($form.principal.ip)
    $form_item = array_distinct(strings.coalesce($form.target.resource.name, $form.target.file.full_path))

  condition:
    $form
}
