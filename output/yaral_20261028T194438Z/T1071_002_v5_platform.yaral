/*
  MITRE Technique : T1071.002 - File Transfer Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:06:43.398435+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_002_Linux_Staging_Dir_Process_File_Transfer_Protocol_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux process running from a world-writable staging directory (/tmp, /var/tmp, /dev/shm) that opens an outbound connection to an external host on a file-transfer protocol port (FTP, FTPS, TFTP, SMB). Legitimate software rarely makes these connections from volatile staging paths, so this pattern points to implant C2 or staging over file-transfer protocols. The rule uses network telemetry and process path, so it adds coverage beyond command-line matching."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.002"
    mitre_technique_name = "Application Layer Protocol: File Transfer Protocols"
    log_prerequisites = "Requires Linux endpoint network connection telemetry (EDR or auditd connect() events) that populates the initiating process path, destination IP and destination port."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrator scripts or installers run from /tmp that fetch packages over FTP or TFTP, PXE/network-boot provisioning tooling, backup or migration utilities unpacked to /tmp or /var/tmp, and software self-extractors that pull data from vendor FTP/SMB servers."
    tuning_guidance = "Add approved provisioning, deployment and RMM binaries to %global_allowed_admin_tools and backup or imaging binaries to %global_allowed_backup_processes. Known-good scanner or management sources can be added to %global_allowed_scanners. If SMB lateral traffic to internal hosts is in scope for a client, remove the %rfc1918_internal exclusion for port 445 only."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/shm)\// nocase
    (
      $net.target.port = 21 or
      $net.target.port = 69 or
      $net.target.port = 445 or
      $net.target.port = 989 or
      $net.target.port = 990
    )
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1071.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
