/*
  MITRE Technique : T1221 - Template Injection
  Tactic(s)       : Stealth
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:13:56.849457+00:00
  Reference       : https://attack.mitre.org/techniques/T1221
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1221_Office_Cache_Remote_Template_Payload_File {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an Office application writing a macro-capable template or executable/script-type file into a browser or WebDAV cache location. This is the file artifact left when a document with an injected remote template reference (attachedTemplate / .rels external target) fetches its payload on open. Pivots on the resulting file state change rather than command-line activity."
    mitre_tactic = "Stealth"
    mitre_technique = "T1221"
    mitre_technique_name = "Template Injection"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent) with the initiating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Enterprise-managed remote or global templates hosted on SharePoint or web servers that legitimately cache .dotm/.dot files; Office add-ins that download .xll/.wll components; software deployment via Office add-in stores."
    tuning_guidance = "Add approved add-in or deployment tooling process paths to %global_allowed_admin_tools, EDR agents to %global_allowed_security_tools, and administrator accounts to %global_allowed_admin_users. If the client uses centrally hosted templates, narrow the extension list to remove dotm/dot for those environments."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(winword|excel|powerpnt|visio|msaccess|mspub)\.exe$/ nocase
    $file.target.file.full_path = /\\(INetCache|Content\.Word|Content\.MSO|Content\.Outlook|DavWWWRoot|WebDAV)\\/ nocase
    $file.target.file.full_path = /\.(dotm|dot|wll|xll|xlam|xla|sct|hta|dll|exe|vbs|vbe|js|jse|ps1|cpl|scr)(\[\d+\])?$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1221")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_files = array_distinct($file.target.file.full_path)
    $office_processes = array_distinct($file.principal.process.file.full_path)
    $affected_users = array_distinct($file.principal.user.userid)

  condition:
    $file
}
