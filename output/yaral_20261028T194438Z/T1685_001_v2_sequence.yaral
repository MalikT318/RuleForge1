/*
  MITRE Technique : T1685.001 - Disable or Modify Windows Event Log
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:16:18.429606+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_001_EventLog_Config_Tamper_Then_EVTX_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a registry change that disables the Windows EventLog service or an event log channel (Start or Enabled value set to a disabling value), followed within ten minutes on the same host by deletion of .evtx log files from the winevt Logs directory. Together these indicate deliberate impairment of Windows logging and removal of existing evidence. The rule uses registry and file telemetry rather than command-line matching, so it is independent of the tool used."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.001"
    mitre_technique_name = "Disable or Modify Windows Event Log"
    log_prerequisites = "Requires endpoint telemetry that populates REGISTRY_MODIFICATION (with registry key, value name and value data) and FILE_DELETION events with the acting process path and hostname."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Image-build or hardening scripts that reconfigure logging, GPO or configuration-management agents changing channel settings, log-rotation or cleanup utilities, disk-cleanup and imaging/sysprep workflows, and administrators decommissioning or re-baselining a host."
    tuning_guidance = "Add approved configuration-management, hardening and cleanup binaries to %global_allowed_admin_tools. Add named administrators to %global_allowed_admin_users. Add automation accounts to %global_allowed_service_accounts. If channel Enabled changes are noisy in a client environment, narrow the registry key regex to the Services\\EventLog branch only."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(CurrentControlSet|ControlSet\d+)\\Services\\EventLog(\\|$)|\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\/ nocase
    $reg.target.registry.registry_value_name = /^(Start|Enabled)$/ nocase
    $reg.target.registry.registry_value_data = /^(0|4|(DWORD \()?0x0*[04]\)?)$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_admin_users
    not $reg.principal.user.userid in %global_allowed_service_accounts
    $reg.principal.hostname = $hostname

    $file.metadata.event_type = "FILE_DELETION"
    $file.target.file.full_path = /\\System32\\winevt\\Logs\\[^\\]+\.evtx$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname

    $reg.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1685.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_registry_keys = array_distinct($reg.target.registry.registry_key)
    $modified_value_names = array_distinct($reg.target.registry.registry_value_name)
    $deleted_log_files = array_distinct($file.target.file.full_path)
    $deleted_log_count = count_distinct($file.target.file.full_path)
    $registry_actor_processes = array_distinct($reg.principal.process.file.full_path)
    $deletion_actor_processes = array_distinct($file.principal.process.file.full_path)
    $actor_users = array_distinct($reg.principal.user.userid)

  condition:
    $reg and $file
}
