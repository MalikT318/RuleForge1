/*
  MITRE Technique : T1003.006 - DCSync
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:46:30.601865+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_006_DCSync_RPC_From_NonInternal_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a firewall-observed connection to the RPC endpoint mapper (TCP/135) or RPC over HTTP (TCP/593) of an internal host from a source outside internal address space. DCSync (DRSUAPI/DRSGetNCChanges) begins with an RPC endpoint-mapper lookup on the domain controller before moving to a dynamic port. A replication-capable client outside internal space (internet, unmanaged VPN pool or partner link) is not a legitimate domain replication path. This is perimeter-side coverage for remote or tunnelled DCSync, complementing endpoint process rules. Firewall logs carry no process or RPC interface data, so the rule cannot confirm DRSUAPI itself; treat it as a high-signal precursor."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.006"
    mitre_technique_name = "OS Credential Dumping: DCSync"
    log_prerequisites = "Firewall, proxy or perimeter connection logs normalised to NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. The firewall must sit on the path between remote or VPN segments and the internal directory servers."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Internet-facing vulnerability or attack-surface scanners; site-to-site or VPN address pools that are not RFC1918 but host legitimate domain-joined systems; branch domain controllers on public or carrier-assigned address space; cloud-hosted domain controllers in hybrid AD replicating over non-RFC1918 addresses; authorised penetration tests; internet background scanning of exposed port 135."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners. Add legitimate non-RFC1918 replication or VPN source addresses to %global_allowed_mgmt_sources. Ensure %rfc1918_internal covers every internal range of the client. Where the firewall only logs allowed traffic, alert volume is low. If denied traffic is also logged, consider pairing with a threshold variant to suppress internet noise."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 135 or $net.target.port = 593)
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1003.006")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
