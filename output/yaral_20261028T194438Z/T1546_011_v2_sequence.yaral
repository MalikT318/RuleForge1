/*
  MITRE Technique : T1546.011 - Application Shimming
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:14:48.616911+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_011_Shim_Database_Dropped_Then_Registered {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A shim database (.sdb) file is created in the AppPatch custom database directory and, within ten minutes on the same host, a registry modification is made under AppCompatFlags InstalledSDB or Custom. This file-then-registry sequence is the result of installing a custom application shim for persistence or privilege escalation. It does not depend on process command lines."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.011"
    mitre_technique_name = "Event Triggered Execution: Application Shimming"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon EID 11) and registry-modification telemetry (Sysmon EID 12/13/14) normalised to UDM FILE_CREATION and REGISTRY_MODIFICATION, with the writing process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate compatibility fixes deployed by IT through the Application Compatibility Toolkit, software installers that ship their own shims, enterprise legacy-application remediation, and OS servicing or upgrade activity."
    tuning_guidance = "Add approved deployment and compatibility tooling to %global_allowed_admin_tools and endpoint security agents to %global_allowed_security_tools. If a client regularly deploys custom shims, scope the exclusion to the writing process rather than disabling the rule."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\AppPatch\\(AppPatch64\\)?Custom\\([^\\]+\\)*[^\\]+\.sdb$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    $file.principal.hostname = $hostname

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Microsoft\\Windows NT\\CurrentVersion\\AppCompatFlags\\(InstalledSDB|Custom)(\\|$)/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    $reg.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1546.011")
    $primary_entity = array_distinct($hostname)
    $sdb_files = array_distinct($file.target.file.full_path)
    $file_writers = array_distinct($file.principal.process.file.full_path)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_writers = array_distinct($reg.principal.process.file.full_path)
    $users = array_distinct($reg.principal.user.userid)

  condition:
    $file and $reg
}
