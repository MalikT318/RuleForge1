/*
  MITRE Technique : T1563.002 - RDP Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:11:42.730714+00:00
  Reference       : https://attack.mitre.org/techniques/T1563/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_002_RDP_Session_Hijack_Activity_Threshold {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated RDP session hijacking activity on a single host within 10 minutes. This is a combination of tscon.exe launches that take over a numeric session ID, and session enumeration (qwinsta, quser, query session/user) that usually precedes the takeover. A single enumeration command is routine admin activity, but several in a short window, including a tscon session takeover, is consistent with an adversary identifying and stealing a disconnected or active session."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1563.002"
    mitre_technique_name = "Remote Service Session Hijacking: RDP Hijacking"
    log_prerequisites = "Requires EDR process telemetry, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing enabled. The target.process.command_line field must be populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Helpdesk or administrators using quser/qwinsta/query session to troubleshoot terminal servers or RDS session hosts, RMM health checks, session-management scripts on RDS or VDI farms, and administrators legitimately using tscon to reconnect sessions."
    tuning_guidance = "Add approved RMM and inventory tooling to %global_allowed_admin_tools (matched against the parent process path). Add named helpdesk and server administrator accounts to %global_allowed_admin_users. Raise the #proc threshold on RDS or VDI session hosts where enumeration is frequent."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(\btscon(\.exe)?"?\s+(\d+|%[a-z_]+%)\b|\b(qwinsta|quser)(\.exe)?\b|\bquery(\.exe)?\s+(session|user)\b)/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1563.002")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)

  condition:
    #proc >= 3
}
