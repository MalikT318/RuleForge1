/*
  MITRE Technique : T1565.002 - Transmitted Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:42:33.216322+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_002_Linux_Traffic_Redirection_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of packet-filter or traffic-control commands on a single Linux host that redirect, rewrite, mirror or divert network traffic to user space (REDIRECT, DNAT, TPROXY, NFQUEUE, TEE, NETMAP, tc mirred redirect). Each command is routine on its own. Several in 10 minutes outside approved tooling can indicate an adversary setting up an interception or man-in-the-middle position to alter data in transit."
    mitre_tactic = "Impact"
    mitre_technique = "T1565.002"
    mitre_technique_name = "Data Manipulation: Transmitted Data Manipulation"
    log_prerequisites = "Linux EDR or auditd execve telemetry normalised to UDM PROCESS_LAUNCH, with target.process.command_line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Container runtimes and orchestration network proxies programming NAT rules, host firewall managers reloading rulesets, VPN or gateway provisioning scripts, load-balancer or transparent-proxy setup by administrators, and configuration management runs that re-apply firewall policy."
    tuning_guidance = "Add approved parent processes (firewall managers, container runtimes, config management agents) to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Raise the #proc threshold on gateway or container hosts that legitimately program many NAT rules."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(iptables|ip6tables|iptables-nft|iptables-legacy|ip6tables-legacy|nft|tc)$/ nocase
    $proc.target.process.command_line = /(-j\s+(REDIRECT|DNAT|TPROXY|NFQUEUE|TEE|NETMAP)\b|\b(dnat|redirect|tproxy|queue)\s+to\b|\bnfqueue\b|mirred\s+egress\s+(redirect|mirror))/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1565.002")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
