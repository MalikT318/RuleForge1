/*
  MITRE Technique : T1110.001 - Password Guessing
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:04:44.684862+00:00
  Reference       : https://attack.mitre.org/techniques/T1110/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1110_001_Container_Mgmt_Port_Password_Guessing {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects password guessing against container-hosting management planes by volume. One external source opens many connections to the same destination on SSH, the Kubernetes API server, kubelet, Docker remote API or etcd ports within ten minutes. A single connection event cannot show guessing, so this rule uses one event variable with a count threshold. It is based on perimeter telemetry only, so it is additive to process or command-line rules."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1110.001"
    mitre_technique_name = "Brute Force: Password Guessing"
    log_prerequisites = "Firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. The perimeter must see traffic to container hosts and cluster endpoints."
    platform = "Containers"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and penetration tests, external CI/CD or GitOps controllers polling the Kubernetes API, remote monitoring agents polling kubelet or API endpoints, load balancer health checks from public addresses, and NAT gateways aggregating many legitimate users behind one source IP."
    tuning_guidance = "Add scanner and test sources to %global_allowed_scanners. Add approved bastion, CI/CD and management source addresses to %global_allowed_mgmt_sources. Raise or lower the #net threshold per client based on baseline API polling volume. Remove ports that clients do not expose externally."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 22 or
      $net.target.port = 2375 or
      $net.target.port = 2376 or
      $net.target.port = 2379 or
      $net.target.port = 6443 or
      $net.target.port = 10250
    )
    $net.principal.ip = $src
    $net.target.ip = $dst
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src, $dst over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1110.001")
    $primary_entity = array_distinct($dst)
    $source_ips = array_distinct($src)
    $targeted_ports = array_distinct($net.target.port)
    $attempt_count = count($net.metadata.id)

  condition:
    #net >= 20
}
