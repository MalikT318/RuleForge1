/*
  MITRE Technique : T1110 - Brute Force
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:03:23.753659+00:00
  Reference       : https://attack.mitre.org/techniques/T1110
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1110_SaaS_Valid_Credentials_Blocked_By_Access_Policy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a SaaS or identity provider sign-in that failed because a conditional access, location, or risk policy blocked it. This pattern typically means the password was already correct, which suggests successful password guessing, spraying, or use of stolen credentials from an untrusted location. It is a high-confidence brute-force outcome signal for SaaS and cloud identity control planes."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1110"
    mitre_technique_name = "Brute Force"
    log_prerequisites = "Requires identity provider or SaaS sign-in audit logs normalised to USER_LOGIN, with the failure or policy-block reason populated in security_result.summary or security_result.description."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Legitimate users travelling or on VPN or mobile networks outside permitted locations, unmanaged or non-compliant devices attempting sign-in, users who mistype a password and are blocked by policy, and misconfigured service or automation accounts."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Adjust the policy-block regex to match the wording your identity provider uses in the failure reason. Raise severity for privileged targets, or for accounts that have multiple hits in a short period."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    (
      $auth.security_result.summary = /(conditional access|blocked by (a )?(policy|location|risk)|location (is )?(not allowed|denied|restricted)|access (denied|blocked) (by|due to) (policy|location|network zone)|network zone|valid (credentials|password)|correct password|device (is )?not (compliant|trusted|managed))/ nocase or
      $auth.security_result.description = /(conditional access|blocked by (a )?(policy|location|risk)|location (is )?(not allowed|denied|restricted)|access (denied|blocked) (by|due to) (policy|location|network zone)|network zone|valid (credentials|password)|correct password|device (is )?not (compliant|trusted|managed))/ nocase
    )
    $auth.target.user.userid != ""
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1110")
    $primary_entity = array_distinct($auth.target.user.userid)
    $source_ips = array_distinct($auth.principal.ip)
    $target_apps = array_distinct($auth.target.application)

  condition:
    $auth
}
