/*
  MITRE Technique : T1219.001 - IDE Tunneling
  Tactic(s)       : Command and Control
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:06:36.259004+00:00
  Reference       : https://attack.mitre.org/techniques/T1219/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1219_001_IDE_Tunnel_DNS_Then_Outbound_TLS {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Linux host that resolves a tunnel-relay style hostname and then opens an outbound connection to an external address on 443 within ten minutes. This network-side sequence is characteristic of IDE remote-development tunnels (for example CLI-initiated dev tunnels) establishing a relayed command and control channel. It uses perimeter DNS and connection telemetry only, with no process command-line matching."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1219.001"
    mitre_technique_name = "Remote Access Tools: IDE Tunneling"
    log_prerequisites = "Requires perimeter or DNS-resolver logs normalised to NETWORK_DNS with principal.ip and dns question names, plus firewall or proxy logs normalised to NETWORK_CONNECTION with principal.ip, target.ip and target.port. Both sources must expose the same internal client IP, so DNS must be logged per client and not only at a forwarder."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Sanctioned developer workstations or build servers using remote-development tunnels, corporate VPN or zero-trust clients whose relay hostnames contain 'tunnel', and cloud vendor tunnelling agents used by engineering or operations teams."
    tuning_guidance = "Add approved relay or vendor domains to %global_allowed_domains. Scope the rule to server and production network segments through client-specific retrohunt or log-source filtering, because developer subnets will be noisy. Confirm the DNS source reports the original client IP rather than a resolver address."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(^|[.-])(dev)?tunnels?([.-]|$)/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    $dns.principal.ip = $src_ip

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 443
    not $net.target.ip in %rfc1918_internal
    $net.principal.ip = $src_ip

    $dns.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1219.001")
    $primary_entity = array_distinct($src_ip)
    $queried_domains = array_distinct($dns.network.dns.questions.name)
    $destination_ips = array_distinct($net.target.ip)
    $connection_count = count($net.metadata.id)

  condition:
    $dns and $net
}
