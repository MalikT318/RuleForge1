/*
  MITRE Technique : T1599 - Network Boundary Bridging
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:00:48.872494+00:00
  Reference       : https://attack.mitre.org/techniques/T1599
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1599_Perimeter_Mgmt_Access_Then_Inbound_Lateral_Flow {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An external source connects to a perimeter device management port (SSH, Telnet, alternate HTTPS admin, SNMP) and, within ten minutes, the same source is observed sending traffic across the boundary to internal hosts on lateral-movement or remote-admin ports (SMB, RDP, SSH, WinRM, MSSQL). This pattern suggests a compromised or reconfigured boundary device being used to bridge a trust boundary and pass normally prohibited traffic."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1599"
    mitre_technique_name = "Network Boundary Bridging"
    log_prerequisites = "Firewall or perimeter connection and flow logs with populated principal.ip, target.ip and target.port. Both inbound management-plane connections and forwarded traffic must be logged."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Remote administrators or MSSP engineers who log in to the device and then use a VPN or jump host to reach internal systems; authorised penetration tests; vulnerability scanners probing management and internal ports; NAT or VPN concentrators that present one source address for many users."
    tuning_guidance = "Add approved administrator and MSSP source addresses to %global_allowed_mgmt_sources, and authorised scanners to %global_allowed_scanners. Adjust the management port set and lateral port set to match the client's device management configuration. Shorten or lengthen the match window to fit the client's change-window behaviour."

  events:
    $mgmt.metadata.event_type = "NETWORK_CONNECTION"
    (
      $mgmt.target.port = 22 or
      $mgmt.target.port = 23 or
      $mgmt.target.port = 161 or
      $mgmt.target.port = 8443 or
      $mgmt.target.port = 4443
    )
    not $mgmt.principal.ip in %rfc1918_internal
    not $mgmt.principal.ip in %global_allowed_mgmt_sources
    not $mgmt.principal.ip in %global_allowed_scanners
    $mgmt.principal.ip = $src_ip

    $flow.metadata.event_type = "NETWORK_FLOW"
    (
      $flow.target.port = 445 or
      $flow.target.port = 3389 or
      $flow.target.port = 22 or
      $flow.target.port = 5985 or
      $flow.target.port = 5986 or
      $flow.target.port = 1433
    )
    $flow.target.ip in %rfc1918_internal
    not $flow.principal.ip in %rfc1918_internal
    not $flow.principal.ip in %global_allowed_mgmt_sources
    not $flow.principal.ip in %global_allowed_scanners
    $flow.principal.ip = $src_ip

    $mgmt.metadata.event_timestamp.seconds <= $flow.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1599")
    $primary_entity = array_distinct($src_ip)
    $mgmt_ports = array_distinct($mgmt.target.port)
    $mgmt_targets = array_distinct($mgmt.target.ip)
    $internal_targets = array_distinct($flow.target.ip)
    $lateral_ports = array_distinct($flow.target.port)
    $flow_count = count($flow.metadata.id)

  condition:
    $mgmt and $flow
}
