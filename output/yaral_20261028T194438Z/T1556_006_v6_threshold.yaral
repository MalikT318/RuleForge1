/*
  MITRE Technique : T1556.006 - Multi-Factor Authentication
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:23:25.355340+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_006_IdP_Burst_MFA_Method_Changes {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of MFA-related changes (method registration, reset, removal or disablement) against a single user account within 10 minutes. One change is routine. Several in a short window suggest an adversary stripping or replacing MFA factors on a compromised account to keep persistent access."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.006"
    mitre_technique_name = "Modify Authentication Process: Multi-Factor Authentication"
    log_prerequisites = "Requires identity provider directory/audit logs ingested and normalised to UDM USER_CHANGE_PERMISSIONS, with metadata.product_event_type populated with the native audit activity name and target.user.userid set to the affected account."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "New-hire onboarding or MFA enrolment campaigns, helpdesk bulk MFA resets after a device-loss event, users replacing a phone and re-registering several factors, and identity governance automation provisioning authentication methods."
    tuning_guidance = "Add helpdesk and IAM administrators to %global_allowed_admin_users and provisioning or automation accounts to %global_allowed_service_accounts. Raise the threshold if enrolment campaigns cause noise. Lower it to 2 for privileged accounts. If the product_event_type naming differs, adjust the two regexes to match local audit activity names."

  events:
    $auth.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $auth.metadata.product_event_type = /(mfa|multi.?factor|factor|security.?info|strong.?auth|authenticator)/ nocase
    $auth.metadata.product_event_type = /(delet|deactivat|reset|disabl|remov|regist|enrol|add|updat|chang)/ nocase
    $auth.target.user.userid = $user
    not $auth.principal.user.userid in %global_allowed_admin_users
    not $auth.principal.user.userid in %global_allowed_service_accounts

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1556.006")
    $primary_entity = array_distinct($user)
    $event_count = count($auth.metadata.id)
    $acting_users = array_distinct($auth.principal.user.userid)
    $source_ips = array_distinct($auth.principal.ip)
    $change_types = array_distinct($auth.metadata.product_event_type)

  condition:
    #auth >= 3
}
