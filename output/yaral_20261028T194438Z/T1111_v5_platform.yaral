/*
  MITRE Technique : T1111 - Multi-Factor Authentication Interception
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:11:32.766913+00:00
  Reference       : https://attack.mitre.org/techniques/T1111
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1111_Windows_Credential_Provider_Or_Auth_Package_Registration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry changes that register a Windows credential provider, credential provider filter, or LSA authentication, security, or notification package. A rogue provider or package can intercept smart card PINs, OTP entry and passwords at logon, which is a registry-based route to MFA interception. This rule is built on registry telemetry rather than process command lines, so it complements any PROCESS_LAUNCH detection for T1111. The brief asked for an alternate platform, but its mandatory platform requirement is Windows, so this rule targets Windows."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1111"
    mitre_technique_name = "Multi-Factor Authentication Interception"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry value-set events) covering HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Authentication and HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate MFA or smart card vendor agent installs and upgrades (such as VPN, SSO or OTP logon agents), biometric or Windows Hello for Business components, endpoint security agents, OS feature updates, and enterprise software deployment."
    tuning_guidance = "Add approved MFA and credential provider installer binaries to %global_allowed_admin_tools and security agents to %global_allowed_security_tools. If the client deploys MFA agents via msiexec, restrict by adding the deployment tooling to %global_allowed_admin_tools rather than excluding msiexec globally. Add named deployment accounts to %global_allowed_service_accounts."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      $reg.target.registry.registry_key = /\\Windows\\CurrentVersion\\Authentication\\Credential Provider(s|\s+Filters)\\/ nocase
      or
      (
        $reg.target.registry.registry_key = /\\Control\\Lsa$/ nocase
        and $reg.target.registry.registry_value_name = /^(Authentication|Security|Notification) Packages$/ nocase
      )
    )
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1111")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_name)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
