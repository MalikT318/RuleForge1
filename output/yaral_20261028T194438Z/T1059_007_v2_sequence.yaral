/*
  MITRE Technique : T1059.007 - JavaScript
  Tactic(s)       : Execution
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Command and Scripting Interpreter
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:16:10.798106+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_007_Linux_JS_Dropped_Then_Executed_From_Temp {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A JavaScript file is created in a world-writable staging directory (/tmp, /var/tmp, /dev/shm) and a JavaScript runtime is then launched against a script in one of those directories on the same host within 5 minutes. This drop-then-execute pattern is common for web-shell follow-on activity, malicious npm install scripts, and downloader stagers."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.007"
    mitre_technique_name = "Command and Scripting Interpreter: JavaScript"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that produces both FILE_CREATION (with principal process context) and PROCESS_LAUNCH events with command lines."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers and CI runners that generate and run build or test scripts in /tmp; package managers and installers that unpack JS helpers to temp directories; configuration management agents; application self-update routines written in Node.js."
    tuning_guidance = "Add approved deployment and build tooling to %global_allowed_admin_tools (file creators) and approved parent processes or CI hosts to %global_allowed_script_hosts (runtime launchers). Extend the package-manager exclusion regex if a client uses other installers. Raise severity for servers that should not run Node.js."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+\.(js|mjs|cjs)$/ nocase
    not $file.principal.process.file.full_path = /\/(npm|yarn|pnpm|dpkg|apt|apt-get|rpm|dnf|yum)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(node|nodejs|bun|deno|rhino)$/ nocase
    $proc.target.process.command_line = /\/(tmp|var\/tmp|dev\/shm)\/\S+\.(js|mjs|cjs)\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1059.007")
    $primary_entity = array_distinct($hostname)
    $dropped_files = array_distinct($file.target.file.full_path)
    $dropper_processes = array_distinct($file.principal.process.file.full_path)
    $runtime_commands = array_distinct($proc.target.process.command_line)
    $launching_parents = array_distinct($proc.principal.process.file.full_path)
    $executing_users = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
