/*
  MITRE Technique : T1558.005 - Ccache Files
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:48:18.398352+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_005_Linux_External_Kerberos_Traffic_NonStandard_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux host opening a Kerberos (TCP/88) connection to a non-internal address from a process that is not a standard Kerberos client or daemon. Kerberos KDCs normally sit on internal address space. Ticket reuse from stolen ccache files (Pass-the-Ticket) via custom scripts, interpreters or tunnelled and proxied tooling shows up as unusual Kerberos traffic leaving the host. Complements endpoint detections for ccache file access."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.005"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Ccache Files"
    log_prerequisites = "Requires Linux EDR or auditd network connection telemetry (connect syscalls) normalised to UDM NETWORK_CONNECTION with principal process path, target IP and target port populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Hosts that legitimately use an external or cloud-hosted KDC or managed directory (hybrid or SaaS Kerberos realms); VPN or site-to-site topologies where the KDC has a public address; non-standard but approved Kerberos-aware agents or custom SSO helpers; vulnerability scanners and authorised red-team activity."
    tuning_guidance = "Add approved Kerberos-aware tooling to %global_allowed_admin_tools or %global_allowed_security_tools. Add service accounts that legitimately authenticate to external realms to %global_allowed_service_accounts. Maintain %rfc1918_internal so it covers all internal KDC ranges for the tenant. If the tenant uses an external managed KDC, extend the standard-client binary regex or add the process to an allow list."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 88
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path = /\/(kinit|klist|kvno|kdestroy|kadmin|kadmind|krb5kdc|k5start|sshd|sssd|sssd_be|sssd_krb5|adcli|realm|realmd|winbindd|smbd|nmbd|msktutil|gssproxy|ldapsearch|ldapwhoami|nscd)$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1558.005")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $source_users = array_distinct($net.principal.user.userid)
    $source_processes = array_distinct($net.principal.process.file.full_path)
    $process_command_lines = array_distinct($net.principal.process.command_line)

  condition:
    $net
}
