/*
  MITRE Technique : T1207 - Rogue Domain Controller
  Tactic(s)       : Defense Impairment
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:15:58.402290+00:00
  Reference       : https://attack.mitre.org/techniques/T1207
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1207_Rogue_DC_Replication_Port_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source generates a high volume of connections to the RPC endpoint mapper, LDAP, LDAPS and Global Catalog ports within ten minutes. This is the network footprint of DCShadow-style rogue domain controller registration and replication: the attacker host talks heavily to directory services and RPC, and real DCs then replicate with it. Each connection is benign on its own; the sustained volume from a non-DC, non-management source is not."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1207"
    mitre_technique_name = "Rogue Domain Controller"
    log_prerequisites = "Requires firewall or perimeter logs with internal east-west traffic (including to the domain controller segment) normalised to UDM NETWORK_CONNECTION, with principal.ip, target.ip and target.port populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Domain controllers and member servers replicating or authenticating, domain-joined workstations with heavy LDAP use (directory-integrated apps, identity sync, Exchange), vulnerability scanners, IT inventory and RMM tooling."
    tuning_guidance = "Add domain controller, identity-sync and management source addresses to %global_allowed_mgmt_sources and approved scanners to %global_allowed_scanners. Raise the #net threshold in noisy environments. Increase severity when the source is a workstation segment that does not normally query directory services."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 135 or
      $net.target.port = 389 or
      $net.target.port = 636 or
      $net.target.port = 3268 or
      $net.target.port = 3269
    )
    $net.principal.ip = $src
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1207")
    $primary_entity = array_distinct($src)
    $connection_count = count($net.metadata.id)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 30
}
