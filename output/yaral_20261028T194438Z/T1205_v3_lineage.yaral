/*
  MITRE Technique : T1205 - Traffic Signaling
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:08:26.900213+00:00
  Reference       : https://attack.mitre.org/techniques/T1205
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_Linux_Service_Parent_Spawns_Firewall_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server or database service process spawning a firewall utility (directly or through a shell) to add an allow/accept rule or open a port. Server daemons do not normally change host firewall state. This lineage anomaly matches the 'open a closed port after a magic signal' stage of traffic signaling (T1205), where a backdoored service or web shell opens a hidden listener for C2."
    mitre_tactic = "Stealth, Persistence, Command and Control"
    mitre_technique = "T1205"
    mitre_technique_name = "Traffic Signaling"
    log_prerequisites = "Linux EDR or auditd (execve) process-launch telemetry with parent process path and full command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Fail2ban-style or WAF plugins run under a web or application service, self-configuring database appliances, container or application installers that open ports on first start, and admin scripts invoked through a web control panel."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Extend or narrow the parent regex to match the daemons deployed in the client environment. If a legitimate control panel changes firewall rules, allowlist its parent path rather than loosening the command-line logic."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|php-fpm[0-9.]*|php-cgi|lighttpd|caddy|tomcat[0-9]*|mysqld|mariadbd|postgres|redis-server|mongod|gunicorn|uwsgi)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ksh|iptables|ip6tables|iptables-nft|iptables-legacy|nft|ufw|firewall-cmd)$/ nocase
    $proc.target.process.command_line = /\b(iptables|ip6tables|nft|ufw|firewall-cmd)\b/ nocase
    $proc.target.process.command_line = /(\s-j\s+ACCEPT|\s-I\s|\s-A\s|add\s+rule|\ballow\b|--add-port|--add-rich-rule|--add-service|dport)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1205")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
