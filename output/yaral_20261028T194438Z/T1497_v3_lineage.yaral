/*
  MITRE Technique : T1497 - Virtualization/Sandbox Evasion
  Tactic(s)       : Stealth, Discovery
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:59:32.505779+00:00
  Reference       : https://attack.mitre.org/techniques/T1497
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1497_Linux_Service_Parent_Spawns_VM_Detection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application runtime, or database service process spawning a shell or utility that performs virtualization or sandbox artifact checks (DMI/SMBIOS data, hypervisor flags in /proc/cpuinfo, virtualization-detection utilities). Service daemons do not normally profile the hypervisor. This lineage typically indicates a web shell or exploited service performing environment awareness checks before staging a payload."
    mitre_tactic = "Stealth, Discovery"
    mitre_technique = "T1497"
    mitre_technique_name = "Virtualization/Sandbox Evasion"
    log_prerequisites = "Requires Linux EDR or auditd EXECVE/SYSCALL process-launch telemetry with parent process path and full child command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web or database application health checks and installers that read hardware or virtualization info, configuration management or monitoring agents launched via a service parent, cloud-init or inventory scripts invoked by an application, and database installers or tuning scripts that check for virtualization."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools. Add hosts or parents that legitimately run scripts, such as build or app servers, to %global_allowed_script_hosts. Extend the parent regex with in-house service daemons if needed. If the rule is noisy for monitoring-agent children, narrow the child regex to require VM vendor strings."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|php-fpm[0-9.]*|php[0-9.]*|lighttpd|mysqld|mariadbd|postgres|mongod|redis-server|gunicorn|uwsgi|node)$/ nocase
    $proc.target.process.file.full_path = /\/(ba|da|z|k|c|a)?sh$|\/(dmidecode|systemd-detect-virt|virt-what|lscpu|lspci|python[0-9.]*|perl)$/ nocase
    $proc.target.process.command_line = /(systemd-detect-virt|virt-what|dmidecode|\/sys\/class\/dmi\/id\/(product_name|sys_vendor|bios_vendor|board_vendor|product_version)|\/proc\/cpuinfo.*hypervisor|hypervisor|lscpu.*(vmware|virtualbox|kvm|qemu|xen)|(vmware|virtualbox|vbox|qemu|kvm|xen|bochs|parallels))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1497")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
