/*
  MITRE Technique : T1132 - Data Encoding
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:44:31.846540+00:00
  Reference       : https://attack.mitre.org/techniques/T1132
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1132_Linux_Base64_Encoded_Payload_In_Outbound_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP requests, seen at a proxy or firewall, from a command-line HTTP client (curl, wget, Python or Go HTTP libraries, Perl LWP) to an external destination where the URL carries a long Base64-style encoded blob in a query parameter or path segment. This is the network-side signature of C2 beaconing or data staging encoded with Base64 or a similar binary-to-text scheme. It complements endpoint command-line detections by observing the traffic itself."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1132"
    mitre_technique_name = "Data Encoding"
    log_prerequisites = "Requires proxy, secure web gateway or firewall HTTP-inspection logs normalised to NETWORK_HTTP, with target.url, network.http.user_agent and target.ip populated. TLS inspection is needed to see URLs on HTTPS traffic."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Package managers and software updaters passing signed tokens or opaque IDs in URLs, cloud storage pre-signed URLs, telemetry and licensing agents, OAuth or JWT tokens in query strings, CI/CD runners and monitoring agents on Linux servers, and legitimate internal scripts that call external APIs with Base64 parameters."
    tuning_guidance = "Add known-good vendor and update domains to %global_allowed_domains. Add vulnerability scanners and approved automation hosts to %global_allowed_scanners. Raise the {100,} length threshold to cut noise from long tokens, or lower it to {64,} for more sensitivity. Review the matched URL and user agent before escalating."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.user_agent = /^(curl|wget|python-requests|python-urllib|go-http-client|libwww-perl)/ nocase
    $http.target.url = /[?&\/=][A-Za-z0-9+\/_%-]{100,}(={0,2}|%3D{1,2})?(&|$)/
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1132")
    $primary_entity = array_distinct($http.principal.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $destination_ips = array_distinct($http.target.ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
