/*
  MITRE Technique : T1140 - Deobfuscate/Decode Files or Information
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:10:18.605749+00:00
  Reference       : https://attack.mitre.org/techniques/T1140
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1140_Linux_Decoder_Utility_Drops_Payload_In_Staging_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a native Linux decode, decrypt or decompress utility (base64, xxd, uudecode, openssl, gpg, 7z, unzip and similar) writing a file into a world-writable staging directory (/tmp, /var/tmp, /dev/shm). The output is extensionless, a hidden dotfile, or has an executable or script extension. This is the on-disk result of deobfuscating a staged payload. The rule uses FILE_CREATION telemetry, so it does not duplicate process command-line detections."
    mitre_tactic = "Stealth"
    mitre_technique = "T1140"
    mitre_technique_name = "Deobfuscate/Decode Files or Information"
    log_prerequisites = "Linux EDR or auditd file-creation telemetry that records the writing process (principal.process.file.full_path) and the created file path, normalised to UDM FILE_CREATION."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package and configuration management (Ansible, Puppet, Chef) unpacking archives in /tmp; installers that decrypt or unzip bundles into /tmp; backup or restore jobs using gpg or openssl; developers and CI runners extracting build artifacts; admins decoding certificates or keys."
    tuning_guidance = "Add approved deployment, CI and configuration-management binaries to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Add trusted script-launching parents to %global_allowed_script_hosts. If archive extraction in /tmp is too noisy, remove unzip and 7z from the process regex."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(base64|base32|basenc|xxd|uudecode|openssl|gpg|gpg2|7z|7za|7zr|7zz|unzip)$/ nocase
    $file.target.file.full_path = /^\/(dev\/shm|tmp|var\/tmp)\/(.*\/)?([^\/.]+|\.[^\/]+|[^\/]+\.(sh|so|elf|bin|py|pl|ko|out))$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1140")
    $primary_entity = array_distinct($file.principal.hostname)
    $decoder_process = array_distinct($file.principal.process.file.full_path)
    $dropped_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
