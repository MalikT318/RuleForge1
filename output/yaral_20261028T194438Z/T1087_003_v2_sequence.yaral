/*
  MITRE Technique : T1087.003 - Email Account
  Tactic(s)       : Discovery
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:56:10.156269+00:00
  Reference       : https://attack.mitre.org/techniques/T1087/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_003_Identity_Login_Then_Address_List_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a user authenticating from a non-internal source address and, within 10 minutes, accessing a global address list, address book or directory address-list resource. This pattern is typical of an adversary using a freshly obtained authenticated session to harvest email addresses and accounts. It is identity and directory audit coverage and does not rely on process command-line matching."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087.003"
    mitre_technique_name = "Account Discovery: Email Account"
    log_prerequisites = "Requires identity provider or directory sign-in logs normalised to USER_LOGIN with principal.ip populated, and directory or mailbox audit logs normalised to USER_RESOURCE_ACCESS with target.resource.name populated for address list and address book reads."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Remote or travelling staff using mail clients that sync the address book after sign-in; mail migration and directory synchronisation tooling; helpdesk staff working remotely; new device enrolment that triggers an offline address book download."
    tuning_guidance = "Add automation and sync accounts to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Extend the resource-name regex if the tenant uses different address list naming. For tenants with many remote users, consider raising severity only when the account is privileged or the source address is new for that user."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.principal.user.userid = $user
    $auth.principal.ip != ""
    not $auth.principal.ip in %rfc1918_internal
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_admin_users

    $acc.metadata.event_type = "USER_RESOURCE_ACCESS"
    $acc.principal.user.userid = $user
    $acc.target.resource.name = /(global[ _-]?address[ _-]?list|address[ _-]?list|address[ _-]?book|offline[ _-]?address)/ nocase
    not $acc.principal.user.userid in %global_allowed_service_accounts
    not $acc.principal.user.userid in %global_allowed_admin_users

    $auth.metadata.event_timestamp.seconds <= $acc.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1087.003")
    $primary_entity = array_distinct($user)
    $source_ips = array_distinct($auth.principal.ip)
    $accessed_resources = array_distinct($acc.target.resource.name)
    $access_count = count($acc.metadata.id)

  condition:
    $auth and $acc
}
