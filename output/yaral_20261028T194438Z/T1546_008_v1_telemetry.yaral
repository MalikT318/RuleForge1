/*
  MITRE Technique : T1546.008 - Accessibility Features
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:10:06.003077+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_008_IFEO_Debugger_On_Accessibility_Binary {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry modification that sets an Image File Execution Options 'Debugger' value on a Windows accessibility binary (sticky keys, Utilman, On-Screen Keyboard, Narrator, Magnifier, and similar). This redirects the pre-logon accessibility feature to an attacker-chosen program that runs as SYSTEM from the logon screen. The rule detects the resulting registry state change, so it still fires when command-line logging is evaded or the tooling is renamed."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.008"
    mitre_technique_name = "Event Triggered Execution: Accessibility Features"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event ID 12/13, or EDR registry-write events) normalised to REGISTRY_MODIFICATION, with target.registry.registry_key and registry_value_name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developers or QA staff attaching a debugger to accessibility binaries, application compatibility or accessibility testing tools, EDR or security agents that legitimately set IFEO values, and rare software deployment tooling."
    tuning_guidance = "Add approved security agents to %global_allowed_security_tools. Add approved deployment and IT tooling to %global_allowed_admin_tools. Add named administrators to %global_allowed_admin_users. Review the writing process, which is returned in $writer_process, before adding exclusions."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Image File Execution Options\\(sethc|utilman|osk|narrator|magnify|displayswitch|atbroker)\.exe$/ nocase
    $reg.target.registry.registry_value_name = "Debugger" nocase
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1546.008")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $debugger_value = array_distinct($reg.target.registry.registry_value_data)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
