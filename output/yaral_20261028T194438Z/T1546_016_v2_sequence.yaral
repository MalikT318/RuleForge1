/*
  MITRE Technique : T1546.016 - Installer Packages
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:22:15.564723+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/016
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_016_MSI_Drop_Then_Persistence_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Windows Installer (msiexec) writes an executable or script into a user-writable or Startup location, then the same host's msiexec modifies an autostart or execution-hijack registry key within 10 minutes. This indicates a trojanised or malicious installer package using custom actions to establish persistence with inherited elevated rights."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.016"
    mitre_technique_name = "Event Triggered Execution: Installer Packages"
    log_prerequisites = "Requires EDR or Sysmon file-creation (Sysmon EID 11) and registry-modification (Sysmon EID 12/13) telemetry with the initiating process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installers that drop helper executables into ProgramData or Temp and register a Run key for an auto-start tray application (collaboration clients, browsers, updaters, VPN clients). Software deployment platforms pushing MSI packages."
    tuning_guidance = "Add deployment or packaging service accounts to %global_allowed_service_accounts. Add approved installer or deployment binaries to %global_allowed_admin_tools. If a vendor installer is noisy, narrow the registry regex or restrict it to Startup-folder drops."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\msiexec\.exe$/ nocase
    $file.target.file.full_path = /\\(appdata\\local\\temp|programdata|users\\public|appdata\\roaming\\microsoft\\windows\\start menu\\programs\\startup)\\.*\.(exe|dll|scr|bat|cmd|ps1|vbs|js|hta)$/ nocase
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.principal.process.file.full_path = /\\msiexec\.exe$/ nocase
    $reg.target.registry.registry_key = /\\(CurrentVersion\\(Run|RunOnce)|Winlogon|Image File Execution Options|Windows NT\\CurrentVersion\\Windows)(\\|$)/ nocase
    not $reg.principal.user.userid in %global_allowed_service_accounts
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    $reg.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1546.016")
    $primary_entity = array_distinct($hostname)
    $dropped_files = array_distinct($file.target.file.full_path)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_name)
    $installer_users = array_distinct($file.principal.user.userid)
    $dropped_file_count = count($file.metadata.id)

  condition:
    $file and $reg
}
