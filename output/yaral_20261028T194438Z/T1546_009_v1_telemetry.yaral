/*
  MITRE Technique : T1546.009 - AppCert DLLs
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:11:31.153277+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/009
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_009_AppCertDLLs_Registry_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry modification to the AppCertDLLs value under the Session Manager key. DLLs registered here are loaded into every process that calls CreateProcess-family APIs, giving attackers both persistence and privilege escalation. The rule detects the resulting registry state change rather than command-line activity, so it fires regardless of the tool or method used to write the value."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.009"
    mitre_technique_name = "Event Triggered Execution: AppCert DLLs"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events 12/13/14) populating target.registry.registry_key and the principal process path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Very rare. Legacy application compatibility or security products that register an AppCert DLL during installation, and authorised software deployment or imaging tooling that sets the value. Any legitimate change should be a known, one-off event."
    tuning_guidance = "Add approved installer or deployment binaries to %global_allowed_admin_tools and security agent binaries to %global_allowed_security_tools. Add known service accounts to %global_allowed_service_accounts. Review and baseline any hit before allowlisting, as the AppCertDLLs value is almost never legitimately used on modern Windows."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control\\Session Manager\\AppCertDLLs/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1546.009")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
