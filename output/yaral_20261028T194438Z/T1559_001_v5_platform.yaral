/*
  MITRE Technique : T1559.001 - Component Object Model
  Tactic(s)       : Execution
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:52:47.428777+00:00
  Reference       : https://attack.mitre.org/techniques/T1559/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_001_COM_Hijack_CLSID_Server_Registration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects per-user COM server registration (InprocServer32 or LocalServer32 under a user-writable CLSID hive) pointing to a user-writable path, script host, or LOLBin. This is the registry mechanism behind COM hijacking and COM-based code execution. COM exists only on Windows, so the requested non-Windows pivot does not apply and this variant covers the Windows registry-based COM hijack angle."
    mitre_tactic = "Execution"
    mitre_technique = "T1559.001"
    mitre_technique_name = "Inter-Process Communication: Component Object Model"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (Sysmon Event IDs 12/13 or equivalent) that populates target.registry.registry_key and target.registry.registry_value_data."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-user software installers and updaters (collaboration clients, browsers, Office add-ins, developer tools) that register COM servers under the user's classes hive; legitimate in-house COM development; packaging tools that register per-user components."
    tuning_guidance = "Add approved installer or deployment binaries to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, and known provisioning accounts to %global_allowed_admin_users. Review recurring benign registrations by value data and exclude the writing process by executable name."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(software\\classes|[^\\]+_classes)\\clsid\\\{[0-9a-f-]{36}\}\\(inprocserver32|localserver32)$/ nocase
    $reg.target.registry.registry_value_data = /(\\users\\[^\\]+\\|\\appdata\\|\\temp\\|\\programdata\\|\\users\\public\\|scrobj\.dll|\\(mshta|wscript|cscript|powershell|pwsh|rundll32|regsvr32|cmd)\.exe)/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_admin_users
    not $reg.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR)\.exe$/ nocase

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1559.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
