/*
  MITRE Technique : T1055.015 - ListPlanting
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:04:39.276812+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_015_ListPlanting_Handle_Then_Injection_ListView_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a ListPlanting-style injection sequence: a process opens a handle to a built-in Windows application that hosts a SysListView32 list-view control (Explorer, Task Manager, Registry Editor, MMC and similar), then the same source process performs a process injection into a list-view host within five minutes. This catches the memory-write and callback-hijack behaviour rather than command lines."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.015"
    mitre_technique_name = "Process Injection: ListPlanting"
    log_prerequisites = "Requires endpoint telemetry that records process handle access (PROCESS_OPEN, for example Sysmon Event 10) and cross-process injection or remote thread/memory write activity (PROCESS_INJECTION, for example Sysmon Event 8)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Accessibility and screen-reader software, UI automation and test frameworks, application-compatibility shims, remote support and RMM agents, shell extensions or desktop customisation tools that hook Explorer, and EDR or DLP agents not yet in the allowlists."
    tuning_guidance = "Add approved EDR/AV agents to %global_allowed_security_tools, RMM and deployment tools to %global_allowed_admin_tools, and imaging or backup agents to %global_allowed_backup_processes. Widen or narrow the list-view host regex to suit the client estate. Review the source process path in $primary_entity and $source_process before tuning."

  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.target.process.file.full_path = /\\(explorer|taskmgr|regedit|mmc|msconfig|perfmon|resmon|control)\.exe$/ nocase
    $open.principal.process.file.full_path != $open.target.process.file.full_path
    not $open.principal.process.file.full_path in %global_allowed_security_tools
    not $open.principal.process.file.full_path in %global_allowed_admin_tools
    not $open.principal.process.file.full_path in %global_allowed_backup_processes
    not $open.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|csrss|wininit|services|lsass|svchost)\.exe$/ nocase
    $open.principal.hostname = $hostname
    $open.principal.process.file.full_path = $src

    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.target.process.file.full_path = /\\(explorer|taskmgr|regedit|mmc|msconfig|perfmon|resmon|control)\.exe$/ nocase
    $inj.principal.process.file.full_path != $inj.target.process.file.full_path
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes
    $inj.principal.hostname = $hostname
    $inj.principal.process.file.full_path = $src

    $open.metadata.event_timestamp.seconds <= $inj.metadata.event_timestamp.seconds

  match:
    $hostname, $src over 5m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.015")
    $primary_entity = array_distinct($hostname)
    $source_process = array_distinct($src)
    $opened_targets = array_distinct($open.target.process.file.full_path)
    $injected_targets = array_distinct($inj.target.process.file.full_path)
    $source_user = array_distinct($inj.principal.user.userid)
    $injection_count = count($inj.metadata.id)

  condition:
    $open and $inj
}
