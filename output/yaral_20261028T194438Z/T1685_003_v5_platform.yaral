/*
  MITRE Technique : T1685.003 - Modify or Spoof Tool UI
  Tactic(s)       : Defense Impairment
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:20:51.320256+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_003_Linux_Security_Agent_Status_File_Tampering {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, scripting interpreter, or binary running from a world-writable or user-controlled path that modifies a status, health, or heartbeat file inside a security agent directory on Linux. Adversaries who have disabled an EDR, AV, or logging agent can forge these state files so local status tooling, dashboards, and health checks keep reporting a healthy agent (Modify or Spoof Tool UI). This rule is file-telemetry based and does not depend on process command lines."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.003"
    mitre_technique_name = "Modify or Spoof Tool UI"
    log_prerequisites = "Linux EDR file telemetry or auditd file-watch rules (write/attr on security agent state directories) normalised to UDM FILE_MODIFICATION with principal process path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration-management runs (Ansible, Puppet, Chef, Salt) that rewrite agent state during deployment, admin wrapper scripts that reset health files, custom monitoring scripts that legitimately update heartbeat files, and agent upgrade scripts invoked through a shell."
    tuning_guidance = "Add legitimate agent updaters and management binaries to %global_allowed_security_tools or %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. If a client's agent directory naming differs, extend the directory keyword group in target.file.full_path. Run in alert-only mode for 7 days to baseline wrapper scripts."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/(opt|var\/lib|var\/opt|var\/run|run|etc|usr\/local)\/([^\/]+\/)*[^\/]*(edr|antivirus|anti-virus|endpoint|sensor|agent|malware|defend|protect|secur)[^\/]*\/([^\/]+\/)*[^\/]*(status|health|heartbeat|uptime)[^\/]*$/ nocase
    $file.principal.process.file.full_path = /(^\/(tmp|var\/tmp|dev\/shm|home|root)\/)|(\/(bash|sh|dash|zsh|ksh|python[0-9.]*|perl|ruby|node)$)/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1685.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_file = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
