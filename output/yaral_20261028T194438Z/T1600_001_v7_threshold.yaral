/*
  MITRE Technique : T1600.001 - Reduce Key Space
  Tactic(s)       : Defense Impairment
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:08:04.824335+00:00
  Reference       : https://attack.mitre.org/techniques/T1600/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_001_Weak_TLS_Cipher_Volume_Per_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single source host repeatedly negotiates deliberately weak or export-grade cipher suites (NULL, EXPORT, anonymous, RC4, RC2, single DES) within ten minutes. This is the network-observable result of key-space reduction on a device, or of a downgrade attack. A single weak negotiation is common and benign. Sustained volume from one source is not."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1600.001"
    mitre_technique_name = "Weaken Encryption: Reduce Key Space"
    log_prerequisites = "Requires firewall or perimeter logs that populate network.tls.cipher, such as logs with TLS inspection or session metadata enabled. Rules will not fire on logs without TLS cipher detail."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legacy applications, appliances or embedded devices that only support old cipher suites. Authorised vulnerability scanners and compliance testing. Legacy printers, IoT or OT systems."
    tuning_guidance = "Add authorised scanner source addresses to %global_allowed_scanners and approved management sources to %global_allowed_mgmt_sources. Raise the threshold in the condition for environments with many legacy clients. Review network.tls.cipher values to extend or narrow the weak-cipher regex."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.tls.cipher = /(?i)(^|[_-])(NULL|EXP|EXPORT|ANON|ADH|AECDH|RC4|RC2|DES|DES40|DES_CBC)([_-]|$)/
    $net.principal.ip = $src_ip
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($net.metadata.id)
    $weak_ciphers = array_distinct($net.network.tls.cipher)
    $destination_ips = array_distinct($net.target.ip)
    $mitre_technique_id = array_distinct("T1600.001")
    $primary_entity = array_distinct($src_ip)

  condition:
    #net >= 5
}
