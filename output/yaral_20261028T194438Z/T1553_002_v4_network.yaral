/*
  MITRE Technique : T1553.002 - Code Signing
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:01:22.203194+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_002_Timestamp_Authority_Request_From_Endpoint {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an outbound HTTP POST to an external RFC 3161 style timestamp or TSA endpoint from a non-browser process on a Windows host. Code-signing workflows (signing a binary with a stolen or acquired certificate) contact a timestamp authority so the signature stays valid after the certificate expires. On hosts that are not approved build or signing systems, this network pattern indicates that executables are being signed locally. The rule matches the URL structure of timestamp services rather than any specific vendor domain."
    mitre_tactic = "Defense Evasion"
    mitre_technique = "T1553.002"
    mitre_technique_name = "Subvert Trust Controls: Code Signing"
    log_prerequisites = "Requires NETWORK_HTTP events with target.url, network.http.method and the originating process path populated, for example from EDR network telemetry, a TLS-inspecting proxy, or Sysmon-equivalent data. HTTPS timestamp requests are only visible where traffic is inspected. Plain HTTP timestamp requests are the most common and are visible without inspection."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software build servers and developer workstations, CI/CD agents signing release artifacts, release engineering and packaging teams, and IT staff signing internal scripts or installers."
    tuning_guidance = "Add approved build and signing hosts to %global_allowed_script_hosts, and add approved signing or packaging tools to %global_allowed_admin_tools. Add endpoint security agents to %global_allowed_security_tools. Known-good timestamp domains can be added to %global_allowed_domains if this list is populated with them. Raise severity for hosts in non-engineering business units."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.target.url = /(?i)(\/(rfc3161|tsa|timestamp|timestamper|timestampserver|tsaserver)(\/|\?|$)|\/\/(timestamp|tsa|ts|timestamper)[0-9]*\.)/
    $net.principal.hostname != ""
    not $net.principal.process.file.full_path = /\\(chrome|msedge|firefox|iexplore|brave|opera)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1553.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $timestamp_urls = array_distinct($net.target.url)
    $destination_ips = array_distinct($net.target.ip)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
