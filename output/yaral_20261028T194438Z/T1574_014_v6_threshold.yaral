/*
  MITRE Technique : T1574.014 - AppDomainManager
  Tactic(s)       : Stealth, Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:48:08.456123+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_014_AppDomainManager_Config_Drop_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Several .NET application configuration files (*.exe.config) are created in user-writable locations on a single host within ten minutes by a non-installer process. A single config drop is routine; repeated drops in staging directories are consistent with AppDomainManager hijacking, where a config file instructs a benign .NET binary to load an attacker-supplied assembly. Complements process command-line rules by using file-creation telemetry."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.014"
    mitre_technique_name = "Hijack Execution Flow: AppDomainManager"
    log_prerequisites = "Requires EDR or Sysmon-style file creation telemetry (Sysmon Event ID 11 equivalent) populating target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software installers and self-updaters unpacking .NET apps into AppData or ProgramData, developer build output, portable .NET tool extraction, RMM or deployment agents staging applications."
    tuning_guidance = "Add approved deployment, build, and updater binaries to %global_allowed_admin_tools. Add approved automation or build accounts to %global_allowed_service_accounts. Raise the #file threshold in noisy developer environments. Confirm hits by checking whether a .NET binary was subsequently launched from the same directory."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents|music|pictures|videos)|users\\public|programdata|windows\\temp|temp|perflogs)\\.*\.exe\.config$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path = /\\(msiexec|trustedinstaller|tiworker|wuauclt|musnotification|musnotifyicon|devenv|msbuild|dotnet)\.exe$/ nocase

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(count($file.metadata.id) >= 10, 85, 60))
    $mitre_technique_id = array_distinct("T1574.014")
    $primary_entity = array_distinct($host)
    $file_count = count($file.metadata.id)
    $config_paths = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
