/*
  MITRE Technique : T1070 - Indicator Removal
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:03:00.489423+00:00
  Reference       : https://attack.mitre.org/techniques/T1070
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_Linux_Container_Log_Mass_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of file deletions against log and shell-history artifacts (system logs, audit logs, container runtime and Kubernetes pod logs, shell history files) on a single Linux or container host within 10 minutes. A single deletion is routine log housekeeping, but many in a short window by a non-approved process indicates selective indicator removal."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070"
    mitre_technique_name = "Indicator Removal"
    log_prerequisites = "Requires container runtime or host-level file telemetry that emits FILE_DELETION events with principal process and target file path populated. Applies to container nodes and containers where file events are collected."
    platform = "Linux"
    log_source = "container"
    false_positives = "logrotate and journald vacuuming, systemd-tmpfiles cleanup, kubelet and container runtime garbage collection of terminated pod logs, node autoscaling or pod churn, backup and log-shipping agents that purge after upload, admins performing disk-space cleanup."
    tuning_guidance = "Add approved log management, cleanup and orchestration binaries to %global_allowed_admin_tools, and EDR or log-shipping agents to %global_allowed_security_tools. Add automation accounts to %global_allowed_service_accounts. Raise the #file threshold on busy container nodes with high pod churn."

  events:
    $file.metadata.event_type = "FILE_DELETION"
    $file.target.file.full_path = /^\/(var\/log\/|var\/lib\/docker\/containers\/|var\/lib\/containerd\/.*\/(log|logs)\/|run\/log\/journal\/|root\/\.(bash|zsh|sh)_history$|home\/[^\/]+\/\.(bash|zsh|sh)_history$)/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\/(logrotate|systemd-tmpfiles|systemd-journald|journalctl|kubelet|containerd|dockerd|crond|anacron)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(count($file.metadata.id) >= 25, 85, 65))
    $mitre_technique_id = array_distinct("T1070")
    $primary_entity = array_distinct($host)
    $deletion_count = count($file.metadata.id)
    $deleted_paths = array_distinct($file.target.file.full_path)
    $acting_users = array_distinct($file.principal.user.userid)
    $acting_processes = array_distinct($file.principal.process.file.full_path)

  condition:
    #file >= 10
}
