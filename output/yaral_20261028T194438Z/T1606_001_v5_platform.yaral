/*
  MITRE Technique : T1606.001 - Web Cookies
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:24:04.844159+00:00
  Reference       : https://attack.mitre.org/techniques/T1606/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1606_001_Web_Cookie_Forging_MachineKey_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects process launches that export or read ASP.NET/IIS machineKey secrets (validationKey/decryptionKey) or export the IIS configuration RSA key container. These secrets are the cryptographic seed material needed to forge valid web session cookies and authentication tickets, which bypasses MFA. This variant covers the Windows web-server key-material staging step, not cookie theft from browsers."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1606.001"
    mitre_technique_name = "Forge Web Credentials: Web Cookies"
    log_prerequisites = "Requires Windows process launch telemetry with full command lines (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing) from IIS and ASP.NET servers."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web administrators migrating or load-balancing IIS farms (machineKey synchronisation), deployment pipelines that set machineKey values, application owners rotating keys, and configuration management agents that read IIS config."
    tuning_guidance = "Add approved deployment and configuration tooling to %global_allowed_admin_tools and named web administrators to %global_allowed_admin_users. Scope the rule to IIS and web-tier hosts if client telemetry volume is high."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(aspnet_regiis(\.exe)?["']?\s+.*\s-px\s|(validationkey|decryptionkey).*machinekey|machinekey.*(validationkey|decryptionkey))/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1606.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
