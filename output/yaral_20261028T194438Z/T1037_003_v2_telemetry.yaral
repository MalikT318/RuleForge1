/*
  MITRE Technique : T1037.003 - Network Logon Script
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:21:29.257453+00:00
  Reference       : https://attack.mitre.org/techniques/T1037/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1037_003_Logon_Script_Dropped_In_Netlogon_Sysvol {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of an executable or script file in a NETLOGON or SYSVOL share, or of a GPO scripts.ini/psscripts.ini file. Adversaries drop logon or startup scripts there so they run on every host or user the script is assigned to. This is the file artifact left by network logon script persistence, so it is independent of the command line used to create it."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1037.003"
    mitre_technique_name = "Boot or Logon Initialization Scripts: Network Logon Script"
    log_prerequisites = "Requires endpoint file-creation telemetry (EDR or Sysmon Event ID 11) from domain controllers and file servers hosting SYSVOL/NETLOGON, with the target file path and the creating process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Domain admins legitimately publishing or updating logon scripts and GPO script settings, GPO management consoles, DFSR/FRS replication between domain controllers, software deployment or RMM tooling that stages scripts in NETLOGON, identity-management automation that provisions scripts."
    tuning_guidance = "Add approved script-publishing tools to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and named administrators to %global_allowed_admin_users. DFSR/FRS replication processes are excluded by executable name. Run on domain controllers and file servers only, to limit volume on other endpoints. Consider a companion rule on FILE_MODIFICATION for edits to existing scripts."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(\\(sysvol|netlogon)\\.*\.(bat|cmd|ps1|vbs|vbe|js|jse|wsf|hta|exe|dll|scr|lnk)$)|(\\policies\\\{[0-9a-f\-]+\}\\(user|machine)\\scripts\\.*\.(bat|cmd|ps1|vbs|vbe|js|jse|wsf|hta|exe|dll)$)|(\\policies\\\{[0-9a-f\-]+\}\\(user|machine)\\scripts\\(scripts|psscripts)\.ini$)/ nocase
    not $file.target.file.full_path = /\\dfsrprivate\\/ nocase
    not $file.principal.process.file.full_path = /\\(dfsrs|dfsr|ntfrs|lsass|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1037.003")
    $primary_entity = array_distinct($file.principal.hostname)
    $script_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $creating_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
