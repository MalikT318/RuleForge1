/*
  MITRE Technique : T1036.012 - Browser Fingerprint
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:16:18.222497+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_012_UserAgent_OS_Inconsistency_Windows_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a single Windows client sending outbound HTTP requests within 10 minutes whose User-Agent strings claim a Windows OS in one request and a different OS (macOS, Linux, Android, iOS, ChromeOS) in another. A genuine browser does not change its claimed operating system, so this indicates User-Agent spoofing by malware or tooling blending into web traffic."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.012"
    mitre_technique_name = "Masquerading: Browser Fingerprint"
    log_prerequisites = "Requires proxy or perimeter firewall logs with HTTP inspection that populate network.http.user_agent, principal.ip and target.ip (NETWORK_HTTP). TLS inspection is needed for HTTPS traffic."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "NAT or shared egress where Windows and non-Windows devices share one source IP, guest or BYOD Wi-Fi segments, VDI or terminal servers fronting mixed clients, Windows hosts running Android emulators or WSL tooling, browser developer tools or privacy extensions that deliberately spoof the User-Agent, and web crawlers or security scanners."
    tuning_guidance = "Add scanner and testing sources to %global_allowed_scanners, trusted destinations to %global_allowed_domains, and approved egress or NAT addresses to %global_allowed_mgmt_sources. If the source IP is a NAT gateway, scope the rule to proxy logs that carry per-client identity, or raise the severity only when the source is a known single-client segment."

  events:
    $win.metadata.event_type = "NETWORK_HTTP"
    $win.network.http.user_agent = /^Mozilla\/\d.*Windows NT/ nocase
    not $win.target.ip in %rfc1918_internal
    not $win.target.hostname in %global_allowed_domains
    not $win.principal.ip in %global_allowed_scanners
    $win.principal.ip = $src_ip

    $other.metadata.event_type = "NETWORK_HTTP"
    $other.network.http.user_agent = /^Mozilla\/\d.*(Macintosh|Mac OS X|X11;|Linux|Android|iPhone|iPad|CrOS)/ nocase
    not $other.network.http.user_agent = /Windows NT/ nocase
    not $other.target.ip in %rfc1918_internal
    not $other.target.hostname in %global_allowed_domains
    not $other.principal.ip in %global_allowed_scanners
    $other.principal.ip = $src_ip

    $win.metadata.event_timestamp.seconds <= $other.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1036.012")
    $primary_entity = array_distinct($src_ip)
    $windows_user_agents = array_distinct($win.network.http.user_agent)
    $conflicting_user_agents = array_distinct($other.network.http.user_agent)
    $destination_hosts = array_distinct($other.target.hostname)
    $destination_ips = array_distinct($other.target.ip)
    $conflicting_request_count = count($other.metadata.id)

  condition:
    $win and $other
}
