/*
  MITRE Technique : T1205.002 - Socket Filters
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:13:58.366348+00:00
  Reference       : https://attack.mitre.org/techniques/T1205/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_002_Socket_Filter_Inbound_Trigger_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a high volume of inbound connections from external sources to high, non-standard ports on a single Windows host within ten minutes. Passive backdoors that use socket filters (WinPcap/Npcap-style packet filters) wait for crafted trigger packets, so the network-observable signal is repeated external contact with ports that have no normal listener. The perimeter cannot see the filter itself, so this rule detects the trigger and probing pattern."
    mitre_tactic = "Stealth, Persistence, Command and Control"
    mitre_technique = "T1205.002"
    mitre_technique_name = "Traffic Signaling: Socket Filters"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs must include allowed and denied inbound sessions."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Internet-facing services on high ports (VoIP/SIP media, game servers, VPN or RDP gateways on custom ports, peer-to-peer software), external vulnerability scanners and monitoring probes, internet background scanning noise against exposed hosts."
    tuning_guidance = "Add authorised scanner and monitoring sources to %global_allowed_scanners and approved management sources to %global_allowed_mgmt_sources. Raise the #net threshold on internet-exposed hosts with known high-port services. Review the distinct source and port outcome fields to separate scanning (many ports) from repeated trigger attempts (few ports, repeated)."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.ip = $dst
    $net.target.port > 1024
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $dst over 10m

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1205.002")
    $primary_entity = array_distinct($dst)
    $event_count = count($net.metadata.id)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    #net >= 25
}
