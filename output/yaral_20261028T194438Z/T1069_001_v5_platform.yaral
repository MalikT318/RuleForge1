/*
  MITRE Technique : T1069.001 - Local Groups
  Tactic(s)       : Discovery
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:57:52.484693+00:00
  Reference       : https://attack.mitre.org/techniques/T1069/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1069_001_Linux_Group_File_Read_By_Utility_Or_Staged_Binary {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Low"
    description = "Detects a read of the local group database (/etc/group or /etc/gshadow) by a text-processing or lookup utility, or by any binary running from a world-writable staging directory (/tmp, /var/tmp, /dev/shm). This is file-access-based local group discovery. It covers cases where the group listing is done by reading the file directly (cat, grep, awk, getent) or by a dropped implant, rather than by a 'groups' or 'id' command line."
    mitre_tactic = "Discovery"
    mitre_technique = "T1069.001"
    mitre_technique_name = "Permission Groups Discovery: Local Groups"
    log_prerequisites = "Requires Linux EDR file-read telemetry or auditd with read watches on /etc/group and /etc/gshadow (for example auditctl -w /etc/group -p r -k group_read) normalised to UDM FILE_READ."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Admin or configuration-management scripts that grep or cat /etc/group, user-provisioning and compliance or audit scripts, backup or inventory jobs, and interactive troubleshooting of group membership by sysadmins."
    tuning_guidance = "Add approved admin and inventory binaries to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and EDR or audit agents to %global_allowed_security_tools. If auditd read watches are too noisy, keep the staging-directory branch and drop the utility branch of the regex. Raise severity when the reading process runs from /tmp, /var/tmp or /dev/shm."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /^\/etc\/(group|gshadow)$/ nocase
    $file.principal.process.file.full_path = /^(\/(tmp|var\/tmp|dev\/shm)\/.+|.*\/(cat|grep|egrep|fgrep|awk|gawk|mawk|sed|cut|head|tail|less|more|getent|sort|strings))$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(35)
    $mitre_technique_id = array_distinct("T1069.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $reading_process = array_distinct($file.principal.process.file.full_path)
    $accessed_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
