/*
  MITRE Technique : T1553.005 - Mark-of-the-Web Bypass
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:07:49.434477+00:00
  Reference       : https://attack.mitre.org/techniques/T1553/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1553_005_Archive_Extracted_Payload_Executed_No_MOTW {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An archive utility writes an executable, script, or shortcut into a user-writable directory, and that same file is launched on the same host within 10 minutes. Files extracted from container formats often lose the Zone.Identifier Mark-of-the-Web stream, so SmartScreen and Protected View are skipped. The rule joins on host and exact file path."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1553.005"
    mitre_technique_name = "Subvert Trust Controls: Mark-of-the-Web Bypass"
    log_prerequisites = "Requires EDR or Sysmon file creation telemetry (Sysmon Event 11) with the creating process populated, and process launch telemetry (Sysmon Event 1 or Windows Event 4688 with command line)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Users who legitimately extract and run portable applications or installers from archives, software developers and testers unpacking build artifacts, IT staff unpacking vendor tools, and software deployment scripts that extract and execute installers."
    tuning_guidance = "Add approved deployment or packaging tools to %global_allowed_admin_tools (matched against both the extracting process and the launching parent). Add approved automation hosts or parents to %global_allowed_script_hosts. Extend the archiver or directory regex to match client-specific tooling. Consider raising severity if the launched process makes an external connection."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(7z|7zg|7zfm|winrar|unrar|peazip|bandizip|tar)\.exe$/ nocase
    $file.target.file.full_path = /\\users\\[^\\]+\\(downloads|desktop|documents|appdata\\local\\temp)\\.*\.(exe|dll|scr|msi|js|jse|vbs|vbe|wsf|hta|lnk|bat|cmd|ps1)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname
    $file.target.file.full_path = $path

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = $path
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1553.005")
    $primary_entity = array_distinct($hostname)
    $extracted_file = array_distinct($path)
    $extractor_process = array_distinct($file.principal.process.file.full_path)
    $launch_command_line = array_distinct($proc.target.process.command_line)
    $launching_parent = array_distinct($proc.principal.process.file.full_path)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $file and $proc
}
