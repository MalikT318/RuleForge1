/*
  MITRE Technique : T1204.004 - Malicious Copy and Paste
  Tactic(s)       : Execution
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:04:34.989290+00:00
  Reference       : https://attack.mitre.org/techniques/T1204/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_004_Linux_ClickFix_Shell_Fetch_Proxy_Observed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the network footprint of a Linux ClickFix-style paste-and-run command: an HTTP request from a command-line downloader (curl, wget, or a scripting-library user agent) to an external destination, for a script-type resource or a bare IP-literal host. This is the staged-payload fetch that follows a user pasting a one-liner such as 'curl ... | bash' into a terminal. It is observed purely from firewall or proxy HTTP telemetry and does not depend on endpoint process data."
    mitre_tactic = "Execution"
    mitre_technique = "T1204.004"
    mitre_technique_name = "User Execution: Malicious Copy and Paste"
    log_prerequisites = "Requires firewall, secure web gateway, or proxy logs normalised to NETWORK_HTTP with network.http.user_agent and target.url populated. TLS inspection is needed for HTTPS traffic to expose the URL and user agent."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Administrators and DevOps staff fetching install scripts; CI/CD runners and build agents; configuration management bootstrap scripts; cloud-init and user-data bootstrapping from external locations; legitimate vendor one-line installers; developer workstations pulling dependencies."
    tuning_guidance = "Add known-good vendor, repository, and CDN domains to %global_allowed_domains. Add build servers and automation hosts to %global_allowed_script_hosts. Add service identities to %global_allowed_service_accounts. Review the matched URLs and gradually tighten or extend the script-type regex to fit client conventions."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.user_agent = /^(curl|wget|libwww-perl|python-requests|python-urllib|go-http-client)\b/ nocase
    $net.target.url = /(\.(sh|bash|py|pl)(\?.*)?$)|(^https?:\/\/\d{1,3}(\.\d{1,3}){3}([:\/]|$))/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1204.004")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
