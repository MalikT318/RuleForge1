/*
  MITRE Technique : T1021.001 - Remote Desktop Protocol
  Tactic(s)       : Lateral Movement
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:35:00.127464+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_001_RDP_Unexpected_Parent_Lineage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects RDP-related process lineage anomalies. Branch 1: the RDP client (mstsc.exe) launched by an Office application, web server, database service, print spooler or script host, which suggests scripted or exploited initiation of lateral movement. Branch 2: a shell or script interpreter spawned by an RDP session component (rdpclip.exe) or by a logon-screen accessibility binary (sethc, utilman, osk, narrator, magnify, displayswitch), a pattern seen in RDP clipboard abuse and RDP-reachable accessibility-feature backdoors."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.001"
    mitre_technique_name = "Remote Services: Remote Desktop Protocol"
    log_prerequisites = "Windows endpoint process launch telemetry with parent process path populated (EDR, Sysmon Event ID 1, or Security Event 4688 with parent process)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Admin-built Office macros or Access/Excel tools that launch mstsc.exe for helpdesk workflows; IT portals or web apps that legitimately launch the RDP client; RMM or jump-host tooling; accessibility features such as Narrator or Magnifier launching help content via a shell; legacy line-of-business apps launched from rdpclip."
    tuning_guidance = "Add approved parent process paths to %global_allowed_remote_mgmt, %global_allowed_admin_tools or %global_allowed_script_hosts. Add named administrators to %global_allowed_admin_users. Add service accounts to %global_allowed_service_accounts. Consider narrowing the parent regex per environment if Office-driven helpdesk tooling is in use."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $proc.target.process.file.full_path = /\\mstsc\.exe$/ nocase and
        $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|onenote|msaccess|mspub|visio|w3wp|httpd|nginx|tomcat[0-9]*|sqlservr|spoolsv|wscript|cscript|mshta|wmiprvse|regsvr32|rundll32)\.exe$/ nocase
      ) or
      (
        $proc.principal.process.file.full_path = /\\(rdpclip|sethc|utilman|osk|narrator|magnify|displayswitch)\.exe$/ nocase and
        $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
      )
    )
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1021.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
