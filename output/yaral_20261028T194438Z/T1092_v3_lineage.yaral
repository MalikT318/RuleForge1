/*
  MITRE Technique : T1092 - Communication Through Removable Media
  Tactic(s)       : Command and Control
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:35:56.482899+00:00
  Reference       : https://attack.mitre.org/techniques/T1092
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1092_Removable_Media_Parent_Spawns_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a process running from a non-system drive letter (typical of removable media such as USB drives) spawning a shell or script interpreter whose command line also references a non-system drive path. This lineage is consistent with command relay between hosts over removable media, where an implant on the media or a staged loader launches interpreters to read or execute commands."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1092"
    mitre_technique_name = "Communication Through Removable Media"
    log_prerequisites = "Requires EDR process telemetry, Sysmon Event ID 1 or Windows Security Event 4688 with command-line auditing, normalised to UDM PROCESS_LAUNCH with parent and child process paths populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Portable administrative tools or installers run from USB by IT staff, software launched from secondary fixed data volumes (D: or E: on servers), portable development environments, and legitimate application suites installed on non-system drives."
    tuning_guidance = "Add approved portable tooling to %global_allowed_admin_tools, trusted parents on secondary data volumes to %global_allowed_script_hosts, and automation accounts to %global_allowed_service_accounts. If a client installs applications on a fixed D: volume, narrow the drive letter ranges in the regexes (for example to [f-z]) or require the command-line condition on the interpreter only."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /^[d-z]:\\/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase
    $proc.target.process.command_line = /(^|[\s"'=])[d-z]:\\/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1092")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
