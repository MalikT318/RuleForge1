/*
  MITRE Technique : T1602 - Data from Configuration Repository
  Tactic(s)       : Collection
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:17:38.671490+00:00
  Reference       : https://attack.mitre.org/techniques/T1602
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_Config_Repository_Protocol_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single source makes a high volume of connections within 10 minutes to protocols used to read or transfer device configuration data (SNMP, TFTP, NETCONF). This pattern is consistent with sweeping network devices for configuration repositories. One connection is benign; the volume from one source is the signal."
    mitre_tactic = "Collection"
    mitre_technique = "T1602"
    mitre_technique_name = "Data from Configuration Repository"
    log_prerequisites = "Requires firewall or perimeter connection logs that populate principal.ip, target.ip and target.port, with logging enabled on rules that permit or inspect management-protocol traffic."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Network monitoring and NMS polling (SNMP), configuration backup and compliance tools, device provisioning over TFTP, authorised vulnerability scanners and network discovery jobs."
    tuning_guidance = "Add monitoring, backup and provisioning source addresses to %global_allowed_mgmt_sources. Add authorised scanner addresses to %global_allowed_scanners. Raise the threshold in the condition (currently 25) for environments with large polling estates, or lower it for small environments."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 161 or
      $net.target.port = 69 or
      $net.target.port = 830
    )
    $net.principal.ip = $src_ip
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(if($net.target.port = 69, 70, 55))
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1602")
    $primary_entity = array_distinct($src_ip)
    $targeted_devices = array_distinct($net.target.ip)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    #net >= 25
}
