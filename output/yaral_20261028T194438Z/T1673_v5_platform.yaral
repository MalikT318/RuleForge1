/*
  MITRE Technique : T1673 - Virtual Machine Discovery
  Tactic(s)       : Discovery
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:16:51.684899+00:00
  Reference       : https://attack.mitre.org/techniques/T1673
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1673_Windows_Host_VM_Enumeration_Commands {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows host launching a process whose command line enumerates virtual machines. It covers Hyper-V PowerShell and CIM/WMI virtualization queries, desktop hypervisor CLIs (list-VM verbs), and ESXi CLI enumeration commands (esxcli vm process list, vim-cmd vmsvc/getallvms) run from a Windows admin host over SSH/plink. Adversaries use this discovery to pick VMs for follow-on service stop or encryption."
    mitre_tactic = "Discovery"
    mitre_technique = "T1673"
    mitre_technique_name = "Virtual Machine Discovery"
    log_prerequisites = "Requires Windows process creation telemetry with full command line (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Hyper-V and virtualization administrators, VDI and lab management scripts, backup and DR tooling that inventories VMs, monitoring agents, and developers using local hypervisors."
    tuning_guidance = "Add approved administration or inventory tooling to %global_allowed_admin_tools and named virtualization admins to %global_allowed_admin_users. Suppress known hypervisor-management jump hosts by adding their parent processes to %global_allowed_admin_tools. Raise severity when the host is not a known virtualization host or when the user is not an administrator."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(esxcli\s+(--\S+\s+)*vm\s+process\s+list|vim-cmd\s+vmsvc\/(getallvms|get\.summary)|vboxmanage(\.exe)?"?\s+list\s+(running)?vms|vmrun(\.exe)?"?\s+(-\w+\s+)*list\b|\bget-vm\b|msvm_computersystem|root\\virtualization)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1673")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
