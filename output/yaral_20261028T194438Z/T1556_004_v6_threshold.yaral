/*
  MITRE Technique : T1556.004 - Network Device Authentication
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:20:12.968675+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_004_Network_Device_Mgmt_Plane_Connection_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source opens a high volume of connections to the same device on management-plane ports (SSH, Telnet, NETCONF) within ten minutes. Each connection is benign on its own. A burst of them is consistent with repeated login attempts against a network device whose authentication has been bypassed or backdoored, such as an implanted hard-coded password in a patched system image. It is also consistent with guessing that password."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.004"
    mitre_technique_name = "Modify Authentication Process: Network Device Authentication"
    log_prerequisites = "Requires firewall or perimeter connection/flow logs that populate principal.ip, target.ip and target.port, with management-plane traffic to network devices logged. Populate %global_allowed_mgmt_sources with jump hosts, NMS and bastion addresses."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Network monitoring and configuration-backup systems polling devices over SSH, vulnerability scanners, authorised penetration tests, automation or orchestration platforms, administrators on a VPN or NAT egress who open many sessions, and misconfigured scripts retrying failed connections."
    tuning_guidance = "Add legitimate management sources (NMS, bastion, jump hosts, config-backup servers) to %global_allowed_mgmt_sources and approved scanners to %global_allowed_scanners. Raise the #net threshold in noisy environments. Lower it for devices that should never be reachable from external space. Extend the port list if the device class uses other management ports."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 830
    )
    $net.principal.ip = $src_ip
    $net.target.ip = $dst_ip
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src_ip, $dst_ip over 10m

  outcome:
    $risk_score = max(65)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1556.004")
    $primary_entity = array_distinct($dst_ip)
    $source_ips = array_distinct($src_ip)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    #net >= 20
}
