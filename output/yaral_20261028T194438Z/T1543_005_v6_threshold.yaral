/*
  MITRE Technique : T1543.005 - Container Service
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:58:21.108130+00:00
  Reference       : https://attack.mitre.org/techniques/T1543/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1543_005_Container_Persistent_Workload_Creation_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single identity creates several persistent workload controllers (DaemonSets, Deployments, StatefulSets, CronJobs) through the Kubernetes API within ten minutes. Each creation is routine, but a burst from one user can indicate an adversary seeding restart-persistent containers across nodes, as in DaemonSet-based persistence. Severity is scaled in outcome when DaemonSets are involved."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1543.005"
    mitre_technique_name = "Create or Modify System Process: Container Service"
    log_prerequisites = "Requires Kubernetes API server audit logs ingested and normalised to RESOURCE_CREATION, with the request URI populated in target.url and the caller in principal.user.userid."
    platform = "Containers"
    log_source = "container"
    false_positives = "CI/CD pipelines and GitOps controllers deploying many workloads at once, platform engineers bootstrapping a namespace or cluster, Helm or operator installs that create several controllers, and cluster autoscaler or add-on managers."
    tuning_guidance = "Add automation identities to %global_allowed_service_accounts and named platform administrators to %global_allowed_admin_users. Raise the #cloud threshold for clusters with heavy deployment activity. Lower it to 3 for locked-down production clusters where workload creation is rare."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.target.url = /\/(daemonsets|deployments|statefulsets|cronjobs)(\/|\?|$)/ nocase
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(if(re.regex($cloud.target.url, /(?i)\/daemonsets/), 80, 60))
    $mitre_technique_id = array_distinct("T1543.005")
    $primary_entity = array_distinct($user)
    $event_count = count($cloud.metadata.id)
    $created_resources = array_distinct($cloud.target.url)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    #cloud >= 5
}
