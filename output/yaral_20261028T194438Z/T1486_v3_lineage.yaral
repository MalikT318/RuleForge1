/*
  MITRE Technique : T1486 - Data Encrypted for Impact
  Tactic(s)       : Impact
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:01:17.177241+00:00
  Reference       : https://attack.mitre.org/techniques/T1486
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1486_Linux_Service_Parent_Spawns_Shell_Or_Crypto_Utility {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux web server, application server or database service process spawning a shell, script interpreter or file-encryption utility. This lineage is anomalous for these services and is a common precursor to ransomware staging and bulk file encryption after webshell or service exploitation."
    mitre_tactic = "Impact"
    mitre_technique = "T1486"
    mitre_technique_name = "Data Encrypted for Impact"
    log_prerequisites = "Linux EDR or auditd execve telemetry normalised to UDM PROCESS_LAUNCH with populated parent (principal.process) and child (target.process) executable paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "PHP applications calling sh for mail or image handling, database maintenance and backup hooks (for example PostgreSQL COPY PROGRAM, MySQL UDF or backup scripts), application health-check scripts, web hosting control panels, CI/CD or deployment hooks running under a web service account."
    tuning_guidance = "Add legitimate parent service paths or wrapper scripts to %global_allowed_script_hosts, and approved admin or backup tooling to %global_allowed_admin_tools. If a specific application legitimately launches shells, exclude its parent path rather than widening the child match. Tighten or loosen the parent service regex to match the web and database stacks present at the client."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|php-fpm[0-9.]*|lighttpd|tomcat[0-9]*|mysqld|mariadbd|postgres|mongod|redis-server)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ksh|python[0-9.]*|perl|ruby|php[0-9.]*|openssl|gpg2?|ccrypt|7z|7za|7zr|zip)$/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1486")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
