/*
  MITRE Technique : T1029 - Scheduled Transfer
  Tactic(s)       : Exfiltration
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:49:40.735962+00:00
  Reference       : https://attack.mitre.org/techniques/T1029
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1029_Offhours_Large_Outbound_Transfer_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a large outbound transfer to an external destination during off-hours, as seen in firewall or proxy connection logs. Adversaries schedule exfiltration for quiet periods to blend in with normal traffic. This rule observes the network side of that behaviour only and does not depend on endpoint process fields."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1029"
    mitre_technique_name = "Scheduled Transfer"
    log_prerequisites = "Requires firewall, proxy or perimeter connection logs normalised to NETWORK_CONNECTION with network.sent_bytes populated, plus a populated %rfc1918_internal list."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Scheduled offsite backups and cloud sync jobs, overnight software or patch distribution, log shipping and telemetry uploads to SaaS, overnight batch or ETL transfers to partners, and users in a different time zone from the UTC window."
    tuning_guidance = "Add known-good destinations to %global_allowed_domains. The off-hours window is evaluated in UTC (01:00-04:59), so adjust the hour bounds, or change the timezone argument of timestamp.get_hour() to the client's local zone, to match local business hours. Raise or lower the sent_bytes threshold (currently about 50 MB per connection) to match the client's baseline egress volume. Hosts that regularly run overnight transfers can be reviewed and their destinations added to the allowlist."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.sent_bytes > 52428800
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    timestamp.get_hour($net.metadata.event_timestamp.seconds, "UTC") >= 1
    timestamp.get_hour($net.metadata.event_timestamp.seconds, "UTC") < 5

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1029")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $max_sent_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
