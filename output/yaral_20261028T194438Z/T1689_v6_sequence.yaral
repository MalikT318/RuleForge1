/*
  MITRE Technique : T1689 - Downgrade Attack
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:38:22.999729+00:00
  Reference       : https://attack.mitre.org/techniques/T1689
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1689_Linux_Security_Package_Downgrade_Then_Config_Weakening {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a forced downgrade of a security-relevant package (crypto, SSH, sudo, PAM, audit, MAC frameworks) via a Linux package manager, followed within 10 minutes on the same host by a modification of SSH, crypto-policy, OpenSSL, SELinux or audit configuration by a non-package-manager process. This pattern indicates an attacker reverting to a vulnerable or less-secure version and then loosening the related configuration to enable weaker protocols or disable auditing."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1689"
    mitre_technique_name = "Downgrade Attack"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry with full command lines (execve) and file modification telemetry for /etc paths, normalized to UDM."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators rolling back a faulty security update and then re-tuning sshd or crypto settings; configuration management agents (Ansible, Puppet, Chef, Salt) performing pinned-version installs and config pushes; compatibility changes for legacy clients; image-build or patch-rollback pipelines."
    tuning_guidance = "Add approved patching, deployment and configuration-management binaries to %global_allowed_admin_tools and approved admin accounts to %global_allowed_admin_users. Narrow or extend the security package and config path regexes per client estate. Consider scoping out build or golden-image hosts whose names follow a client convention."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(apt|apt-get|dpkg|rpm|yum|dnf|zypper)$/ nocase
    $proc.target.process.command_line = /(--allow-downgrades|--allow-downgrade|--oldpackage|--force-downgrade|\bdowngrade\b)/ nocase
    $proc.target.process.command_line = /(openssl|openssh|libssl|gnutls|sudo|polkit|auditd?|libpam|pam|selinux|apparmor|crypto-policies|ca-certificates|gnupg|sssd)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users
    $proc.principal.hostname = $hostname

    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/(ssh\/(sshd_config|ssh_config)(\.d\/.*)?|crypto-policies\/config|ssl\/openssl\.cnf|pki\/tls\/openssl\.cnf|selinux\/config|audit\/(auditd\.conf|rules\.d\/.*|audit\.rules))$/ nocase
    not $file.principal.process.file.full_path = /\/(apt|apt-get|dpkg|rpm|yum|dnf|zypper|unattended-upgr[a-z]*)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1689")
    $primary_entity = array_distinct($hostname)
    $downgrade_commands = array_distinct($proc.target.process.command_line)
    $downgrade_users = array_distinct($proc.principal.user.userid)
    $modified_files = array_distinct($file.target.file.full_path)
    $modifying_processes = array_distinct($file.principal.process.file.full_path)

  condition:
    $proc and $file
}
