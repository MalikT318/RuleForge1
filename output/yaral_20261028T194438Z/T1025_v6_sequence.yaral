/*
  MITRE Technique : T1025 - Data from Removable Media
  Tactic(s)       : Collection
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:48:36.290211+00:00
  Reference       : https://attack.mitre.org/techniques/T1025
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1025_Linux_Removable_Media_Enum_Then_Stage {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Linux host where a process enumerates a removable media mount point (find, ls, tree or du under /media, /run/media or a USB/CD-style /mnt path), and within 10 minutes a copy or archive utility moves data between that mount point and a local staging directory (/tmp, /var/tmp, /dev/shm). This sequence of discovery followed by collection is typical of staging data from USB or optical media before exfiltration."
    mitre_tactic = "Collection"
    mitre_technique = "T1025"
    mitre_technique_name = "Data from Removable Media"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records normalised to UDM PROCESS_LAUNCH with populated command_line, principal.hostname and target.process.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Users or admins legitimately copying files from a USB stick via the terminal, backup or forensic imaging jobs, software installation from optical media, desktop auto-import scripts, and IT staff provisioning workstations."
    tuning_guidance = "Add approved backup and imaging tools to %global_allowed_backup_processes, IT provisioning tools to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Extend the removable-mount regex if the environment uses custom mount points. Consider raising severity on servers where USB use is not expected."

  events:
    $disc.metadata.event_type = "PROCESS_LAUNCH"
    $disc.target.process.file.full_path = /\/(find|ls|tree|du)$/ nocase
    $disc.target.process.command_line = /(\/run\/media\/|\/media\/|\/mnt\/(usb|cdrom|flash|removable|sd[a-z]))/ nocase
    not $disc.principal.process.file.full_path in %global_allowed_backup_processes
    not $disc.principal.process.file.full_path in %global_allowed_admin_tools
    not $disc.principal.user.userid in %global_allowed_service_accounts
    $disc.principal.hostname = $host

    $stage.metadata.event_type = "PROCESS_LAUNCH"
    $stage.target.process.file.full_path = /\/(cp|mv|rsync|tar|zip|7z|7za|7zr)$/ nocase
    $stage.target.process.command_line = /((\/run\/media\/|\/media\/|\/mnt\/(usb|cdrom|flash|removable|sd[a-z])).*(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/)|(\/tmp\/|\/var\/tmp\/|\/dev\/shm\/).*(\/run\/media\/|\/media\/|\/mnt\/(usb|cdrom|flash|removable|sd[a-z])))/ nocase
    not $stage.principal.process.file.full_path in %global_allowed_backup_processes
    not $stage.principal.process.file.full_path in %global_allowed_admin_tools
    not $stage.principal.user.userid in %global_allowed_service_accounts
    $stage.principal.hostname = $host

    $disc.metadata.event_timestamp.seconds <= $stage.metadata.event_timestamp.seconds

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1025")
    $primary_entity = array_distinct($host)
    $users = array_distinct($stage.principal.user.userid)
    $discovery_commands = array_distinct($disc.target.process.command_line)
    $staging_commands = array_distinct($stage.target.process.command_line)
    $staging_event_count = count($stage.metadata.id)

  condition:
    $disc and $stage
}
