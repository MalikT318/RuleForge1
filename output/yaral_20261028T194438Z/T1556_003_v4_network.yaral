/*
  MITRE Technique : T1556.003 - Pluggable Authentication Modules
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:18:20.311345+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_003_PAM_Module_Download_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a non-browser HTTP client fetching a PAM shared object (pam_*.so, libpam*.so) or Linux-PAM source tarball from an external destination. Adversaries commonly stage a patched pam_unix.so or the Linux-PAM source to compile a credential-harvesting or backdoor module. This is network-side coverage that complements endpoint file and command-line detections. It uses URL path and user-agent only, because perimeter logs carry no process context. Detection depends on the proxy or firewall logging cleartext HTTP URLs (or TLS-inspected traffic)."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.003"
    mitre_technique_name = "Modify Authentication Process: Pluggable Authentication Modules"
    log_prerequisites = "Requires proxy or firewall HTTP logs with URL and user-agent populated (TLS inspection or cleartext HTTP). Without URL visibility the rule cannot fire."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Administrators or build pipelines downloading Linux-PAM source or PAM modules from upstream project or vendor sites, custom distribution packaging, and third-party MFA vendors that distribute pam_*.so modules (for example SSH MFA or smart card modules)."
    tuning_guidance = "Add legitimate vendor and distribution mirror domains to %global_allowed_domains. If build or packaging hosts regularly fetch PAM sources, scope them out by adding a host-based exclusion on a new tenant-specific condition or allowlist the destination domain. Raise severity if the source host is a production server that is not a build system."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\/(pam_[a-z0-9_\-]+\.so|libpam[a-z0-9_\-\.]*\.so[0-9\.]*|Linux-PAM-[0-9][0-9\.]*\.tar\.(gz|xz|bz2))(\?.*)?$/ nocase
    $net.network.http.user_agent = /(curl|wget|python|go-http-client|libwww|aiohttp|fetch)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1556.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $requested_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
