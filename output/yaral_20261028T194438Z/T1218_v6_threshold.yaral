/*
  MITRE Technique : T1218 - System Binary Proxy Execution
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:41:37.950785+00:00
  Reference       : https://attack.mitre.org/techniques/T1218
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_Linux_Trusted_Wrapper_Repeated_Shell_Spawn {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single Linux host sees repeated shell or interpreter launches whose parent is a trusted coreutils-style wrapper binary (split, nice, stdbuf, timeout, setsid, flock, etc.). These wrappers can proxy execution of arbitrary commands, for example split --filter spawning a shell per output chunk. One launch is benign; a burst within ten minutes suggests proxy execution through a trusted binary. The rule uses parent/child process lineage and volume, not command-line content."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218"
    mitre_technique_name = "System Binary Proxy Execution"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry normalised to PROCESS_LAUNCH with populated parent (principal.process) and child (target.process) file paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Build and CI systems, cron or backup wrapper scripts using timeout/nice/flock around shell scripts, data-processing pipelines using split --filter, and configuration management runs."
    tuning_guidance = "Add approved wrapper parents to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and build or CI hosts to %global_allowed_script_hosts. Raise the #proc threshold on noisy hosts. The split parent receives a higher risk score."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(split|nice|ionice|stdbuf|timeout|setsid|flock|taskset|chrt|unshare|nsenter)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ksh|python[0-9.]*|perl|ruby)$/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.hostname in %global_allowed_script_hosts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($proc.principal.process.file.full_path = /\/split$/ nocase, 80, 60))
    $mitre_technique_id = array_distinct("T1218")
    $primary_entity = array_distinct($host)
    $event_count = count($proc.metadata.id)
    $wrapper_binaries = array_distinct($proc.principal.process.file.full_path)
    $spawned_children = array_distinct($proc.target.process.file.full_path)
    $users = array_distinct($proc.principal.user.userid)

  condition:
    #proc >= 5
}
