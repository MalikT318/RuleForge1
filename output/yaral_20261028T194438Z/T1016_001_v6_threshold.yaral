/*
  MITRE Technique : T1016.001 - Internet Connection Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:46:24.200848+00:00
  Reference       : https://attack.mitre.org/techniques/T1016/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1016_001_Internet_Connectivity_Check_DNS_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of DNS lookups on a single host from command-line network utilities and script hosts (ping, tracert, nslookup, curl, PowerShell, script interpreters and similar). Each lookup is benign on its own. Many lookups in ten minutes from these non-browser processes indicate automated Internet connectivity checks, such as probing reachability before C2 contact or mapping routes and proxies. The rule uses DNS telemetry rather than process command lines, so it adds coverage beyond process-creation rules."
    mitre_tactic = "Discovery"
    mitre_technique = "T1016.001"
    mitre_technique_name = "System Network Configuration Discovery: Internet Connection Discovery"
    log_prerequisites = "Requires endpoint DNS telemetry with process attribution (EDR DNS events or Sysmon-equivalent DNS query logging) normalised to NETWORK_DNS with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IT inventory and health-check scripts, RMM and monitoring agents, software deployment and patching scripts, admins troubleshooting connectivity with ping, nslookup or tracert, and developer or build tooling using curl or PowerShell."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools, script-hosting parents to %global_allowed_script_hosts, and update or vendor domains to %global_allowed_domains. Raise the #dns threshold for noisy environments. Review the distinct domains and process paths in the outcome during triage."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.principal.process.file.full_path = /\\(ping|tracert|pathping|nslookup|curl|wget|certutil|bitsadmin|powershell|pwsh|mshta|wscript|cscript)\.exe$/ nocase
    $dns.principal.hostname = $host
    not $dns.principal.process.file.full_path in %global_allowed_admin_tools
    not $dns.principal.process.file.full_path in %global_allowed_security_tools
    not $dns.network.dns.questions.name in %global_allowed_domains

  match:
    $host over 10m

  outcome:
    $risk_score = max(45)
    $event_count = count($dns.metadata.id)
    $queried_domains = array_distinct($dns.network.dns.questions.name)
    $source_processes = array_distinct($dns.principal.process.file.full_path)
    $mitre_technique_id = array_distinct("T1016.001")
    $primary_entity = array_distinct($host)

  condition:
    #dns >= 6
}
