/*
  MITRE Technique : T1566.003 - Spearphishing via Service
  Tactic(s)       : Initial Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:51:21.928232+00:00
  Reference       : https://attack.mitre.org/techniques/T1566/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1566_003_Linux_Client_Payload_Download_Via_Webmail_Referrer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux desktop client (browser user-agent) downloading an executable or installable Linux payload (shell script, ELF, AppImage, .run, .deb, .rpm) from an external host where the HTTP referrer is a webmail or messaging-style service. This is the network-observable result of spearphishing via a third-party service, where a personal webmail or chat link delivers a payload to a work Linux workstation. Detection is perimeter-based and does not depend on endpoint process or command-line telemetry."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1566.003"
    mitre_technique_name = "Phishing: Spearphishing via Service"
    log_prerequisites = "Requires forward-proxy or secure web gateway logs normalised to NETWORK_HTTP with network.http.user_agent, network.http.referral_url and target.url populated. TLS inspection is needed to see full URLs and referrers on HTTPS traffic."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Developers or administrators downloading legitimate packages or installer scripts from a link in webmail or a chat or ticketing tool. Vendor software announcements delivered by email with a direct installer link. Internal software portals with 'mail' or 'chat' in the referrer hostname."
    tuning_guidance = "Add known-good vendor, repository and update domains to %global_allowed_domains. Add authorised scanner or testing hosts to %global_allowed_scanners. If TLS inspection is unavailable, expect reduced coverage on HTTPS. Narrow the referrer keywords or extension list to fit the client's software-distribution habits."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET"
    $http.network.http.user_agent = /X11;.*(Linux|Ubuntu|Fedora)/ nocase
    $http.target.url = /\.(sh|run|elf|appimage|deb|rpm)(\?.*)?$/ nocase
    $http.network.http.referral_url = /^https?:\/\/[^\/]*(webmail|mail|inbox|messag|chat)[^\/]*(\/|$)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1566.003")
    $primary_entity = array_distinct(strings.coalesce($http.principal.hostname, $http.principal.user.userid))
    $client_ips = array_distinct($http.principal.ip)
    $download_urls = array_distinct($http.target.url)
    $referrer_urls = array_distinct($http.network.http.referral_url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
