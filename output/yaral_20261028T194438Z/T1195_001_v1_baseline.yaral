/*
  MITRE Technique : T1195.001 - Compromise Software Dependencies and Development Tools
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:39:41.007360+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_001_Linux_Package_Manager_Spawns_Download_Exec {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a package manager or language runtime (npm, yarn, pnpm, pip, gem, composer, node, python) spawning a shell that downloads and executes a payload, decodes base64 into a shell, opens a /dev/tcp reverse shell, or stages a download in a world-writable directory and makes it executable. This is the typical result of a malicious install or lifecycle script in a compromised or typosquatted dependency."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.001"
    mitre_technique_name = "Supply Chain Compromise: Compromise Software Dependencies and Development Tools"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records normalised to UDM PROCESS_LAUNCH, with parent process path and full command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate install scripts that fetch binaries and pipe them to a shell (rustup, nvm, Homebrew-style bootstrappers, node-gyp or prebuilt-binary downloaders); CI/CD build agents; developer workstations bootstrapping toolchains; configuration management runs that invoke pip or npm."
    tuning_guidance = "Add approved build tooling or parent process paths to %global_allowed_admin_tools and approved CI runners or script-hosting parents to %global_allowed_script_hosts. Expect higher volume on build servers, so consider routing those to lower-priority triage. Do not widen the parent regex to generic shells."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(npm|npx|yarn|pnpm|pip|pip3|pipx|gem|bundle|composer|node|python[0-9.]*)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ash)$/ nocase
    $proc.target.process.command_line = /((curl|wget)\s[^|;]*\|\s*(\S*\/)?(ba|da|z)?sh(\s|$)|base64\s+(-d|--decode)[^|]*\|\s*(\S*\/)?(ba|da|z)?sh(\s|$)|\/dev\/tcp\/|(curl|wget)\s[^;&]*\/(tmp|dev\/shm|var\/tmp)\/[^;&]*(;|&&)\s*chmod\s+\+?x)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1195.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
