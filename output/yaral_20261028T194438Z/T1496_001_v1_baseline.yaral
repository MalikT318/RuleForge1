/*
  MITRE Technique : T1496.001 - Compute Hijacking
  Tactic(s)       : Impact
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:51:45.059085+00:00
  Reference       : https://attack.mitre.org/techniques/T1496/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1496_001_Container_Workload_Created_By_Anonymous_Or_External_Principal {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a container workload (pod, deployment, daemonset, statefulset, replicaset, job or cronjob) through the cluster control plane by an anonymous/unauthenticated identity, or by a non-allowlisted principal connecting from an external (non-RFC1918) address. Abuse of exposed or weakly authenticated container APIs to deploy workloads at scale is the dominant delivery path for container compute hijacking (cryptomining)."
    mitre_tactic = "Impact"
    mitre_technique = "T1496.001"
    mitre_technique_name = "Resource Hijacking: Compute Hijacking"
    log_prerequisites = "Requires Kubernetes/container control-plane audit logging enabled at request level (create verbs on workload resources) and ingested into UDM with principal.user.userid, principal.ip and target.resource.name populated."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "CI/CD pipelines or GitOps controllers deploying from external runners, administrators working remotely over a public IP or via a NAT/proxy, managed cluster autoscalers and operators, developers deploying test workloads from home networks, and misconfigured health-check tooling using unauthenticated access."
    tuning_guidance = "Add CI/CD and automation identities to %global_allowed_service_accounts, named cluster admins to %global_allowed_admin_users, and approved cloud/identity principals to %global_allowed_cloud_principals. Add approved management or scanner source addresses to %global_allowed_mgmt_sources and %global_allowed_scanners. Anonymous-identity hits should rarely be tuned out; investigate the exposed API endpoint instead."

  events:
    $cloud.metadata.event_type = "RESOURCE_CREATION"
    $cloud.metadata.product_event_type = /create/ nocase
    $cloud.target.resource.name = /(^|\/)(pods|deployments|daemonsets|statefulsets|replicasets|jobs|cronjobs)(\/|$)/ nocase
    (
      $cloud.principal.user.userid = /^system:(anonymous|unauthenticated)$/ nocase
      or
      (
        $cloud.principal.ip != ""
        and not $cloud.principal.ip in %rfc1918_internal
      )
    )
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.ip in %global_allowed_mgmt_sources
    not $cloud.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1496.001")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $source_ips = array_distinct($cloud.principal.ip)
    $created_resources = array_distinct($cloud.target.resource.name)

  condition:
    $cloud
}
