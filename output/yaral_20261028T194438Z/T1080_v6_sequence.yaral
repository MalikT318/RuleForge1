/*
  MITRE Technique : T1080 - Taint Shared Content
  Tactic(s)       : Lateral Movement
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:22:35.058067+00:00
  Reference       : https://attack.mitre.org/techniques/T1080
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1080_Shared_Content_Tainted_Then_Accessed_By_Other_User {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A user uploads or modifies an executable, script, shortcut, or macro-enabled file in shared cloud storage, and a different user accesses the same file within 10 minutes. This is the delivery and execution pattern of tainted shared content used for lateral movement."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1080"
    mitre_technique_name = "Taint Shared Content"
    log_prerequisites = "Requires Microsoft 365 or Google Workspace unified audit logs with file upload, modify and access events (SharePoint, OneDrive, Drive) normalised to UDM, with target.file.full_path and principal.user.userid populated."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Developers or IT staff sharing scripts, installers, or macro-enabled templates through team sites; software distribution libraries; automated document workflows that write macro-enabled files; legitimate collaboration where a colleague opens a shared script file."
    tuning_guidance = "Add automation and sync accounts to %global_allowed_service_accounts. Add IT and packaging administrators to %global_allowed_admin_users. Narrow or extend the extension list to suit the client's file-sharing norms. Consider raising severity if the accessing user is privileged."

  events:
    $upd.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"
    $upd.target.file.full_path = /\.(lnk|url|js|jse|vbs|vbe|wsf|hta|ps1|bat|cmd|scr|exe|dll|msi|iso|img|docm|xlsm|pptm|xlam|dotm)$/ nocase
    $upd.target.file.full_path = $filepath
    $upd.principal.user.userid != ""
    not $upd.principal.user.userid in %global_allowed_service_accounts
    not $upd.principal.user.userid in %global_allowed_admin_users

    $acc.metadata.event_type = "USER_RESOURCE_ACCESS"
    $acc.target.file.full_path = /\.(lnk|url|js|jse|vbs|vbe|wsf|hta|ps1|bat|cmd|scr|exe|dll|msi|iso|img|docm|xlsm|pptm|xlam|dotm)$/ nocase
    $acc.target.file.full_path = $filepath
    $acc.principal.user.userid != ""
    not $acc.principal.user.userid in %global_allowed_service_accounts

    $upd.principal.user.userid != $acc.principal.user.userid
    $upd.metadata.event_timestamp.seconds <= $acc.metadata.event_timestamp.seconds

  match:
    $filepath over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1080")
    $primary_entity = array_distinct($upd.principal.user.userid)
    $accessing_users = array_distinct($acc.principal.user.userid)
    $tainted_files = array_distinct($filepath)
    $access_count = count($acc.metadata.id)

  condition:
    $upd and $acc
}
