/*
  MITRE Technique : T1677 - Poisoned Pipeline Execution
  Tactic(s)       : Execution
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:22:20.449323+00:00
  Reference       : https://attack.mitre.org/techniques/T1677
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1677_Pipeline_Security_Setting_Weakened {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change (SETTING_MODIFICATION) in the audit trail of a CI/CD or workflow platform that weakens pipeline trust boundaries. Examples: enabling fork or pull-request-triggered workflows with secret access, relaxing run approval requirements, widening default workflow token permissions, changing secret or variable scope, or removing branch protection. These changes are the configuration-level precondition for Direct, Indirect and Public Pipeline Execution. The rule pivots on the resulting setting change, not on commands or process creation."
    mitre_tactic = "Execution"
    mitre_technique = "T1677"
    mitre_technique_name = "Poisoned Pipeline Execution"
    log_prerequisites = "Requires SaaS or cloud audit logs from the source-control and CI/CD platform, normalised to UDM SETTING_MODIFICATION with metadata.product_event_type and principal.user.userid populated. Organisation and repository admin audit streaming must be enabled."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Platform or DevOps engineers legitimately changing workflow permissions, approval policies or secret scope; repository onboarding and migration; infrastructure-as-code automation applying repository settings; scheduled security hardening that tightens settings but shares the same event names."
    tuning_guidance = "Add approved DevOps administrators to %global_allowed_admin_users and settings-automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. If product_event_type naming differs for a client, adjust the two regexes in this rule per tenant. Consider raising severity when the change is made by a user who has never changed pipeline settings before."

  events:
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    $cfg.metadata.product_event_type = /(workflow|pipeline|actions|ci_cd|cicd|build|runner)/ nocase
    $cfg.metadata.product_event_type = /(fork|pull_request|approval|permission|secret|variable|protect|trigger|required_check|allow_)/ nocase
    $cfg.principal.user.userid != ""
    not $cfg.principal.user.userid in %global_allowed_admin_users
    not $cfg.principal.user.userid in %global_allowed_service_accounts
    not $cfg.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1677")
    $primary_entity = array_distinct($cfg.principal.user.userid)
    $changed_setting = array_distinct($cfg.metadata.product_event_type)
    $target_resource = array_distinct($cfg.target.resource.name)
    $source_ips = array_distinct($cfg.principal.ip)

  condition:
    $cfg
}
