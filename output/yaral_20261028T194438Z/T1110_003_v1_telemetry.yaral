/*
  MITRE Technique : T1110.003 - Password Spraying
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:06:36.921850+00:00
  Reference       : https://attack.mitre.org/techniques/T1110/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1110_003_SaaS_Lockout_Throttle_Setting_Changed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change to identity-provider account lockout, smart lockout, sign-in throttling or banned-password protection settings. Attackers who gain admin access, and insiders preparing a campaign, weaken these controls so that low-and-slow password spraying against many accounts goes unblocked. This rule covers the configuration state change that enables spraying, not the failed-login pattern itself, and complements existing process and command-line detections."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1110.003"
    mitre_technique_name = "Brute Force: Password Spraying"
    log_prerequisites = "Identity provider directory and admin audit logs normalised to UDM SETTING_MODIFICATION, with the changed policy or setting name populated in target.resource.name."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Planned security-baseline or password-policy reviews by identity administrators, tenant onboarding or migration projects, infrastructure-as-code pipelines applying identity policy, and temporary lockout changes during help-desk incidents."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users, automation and IaC identities to %global_allowed_service_accounts, and approved service principals to %global_allowed_cloud_principals. If the identity provider names these settings differently, extend the target.resource.name regex. Correlate hits with failed USER_LOGIN activity from the same source in the following hours."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.target.resource.name = /(account.?lockout|smart.?lockout|lockout.?(threshold|duration|policy)|password.?protection|banned.?password|custom.?banned|sign.?in.?throttl|login.?throttl|brute.?force.?protect|failed.?(login|sign.?in).?(limit|threshold))/ nocase
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1110.003")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $changed_setting = array_distinct($setting.target.resource.name)
    $source_ip = array_distinct($setting.principal.ip)

  condition:
    $setting
}
