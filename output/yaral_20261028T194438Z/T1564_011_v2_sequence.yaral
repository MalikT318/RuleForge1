/*
  MITRE Technique : T1564.011 - Ignore Process Interrupts
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:29:43.304682+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_011_Linux_Staged_File_Then_Nohup_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "Detects a file written to a world-writable staging directory (/tmp, /var/tmp, /dev/shm) followed within ten minutes by a nohup launch on the same host that references a staging path. This sequence indicates a dropped payload being made immune to hangup signals so it survives session logoff or loss of the C2 channel. It is correlated file-then-execution coverage and does not rely on command-line matching alone."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.011"
    mitre_technique_name = "Hide Artifacts: Ignore Process Interrupts"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that populates both FILE_CREATION (target.file.full_path) and PROCESS_LAUNCH (target.process.file.full_path, command_line) with a consistent principal.hostname."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators or developers running long-lived scripts or installers from /tmp under nohup; CI/CD runners and build agents; software deployment or RMM scripts that unpack to /tmp and detach; database or backup maintenance jobs staged in /var/tmp."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts and approved file-writing tools to %global_allowed_admin_tools. Add known automation accounts to %global_allowed_service_accounts. Extend the package-manager executable-name exclusion if other installers produce noise. Raise severity if the launching user is root or a web service account."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/([^\/]+\.(sh|elf|bin|py|pl)|[^\/.]+|\.[^\/]+)$/ nocase
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|aptitude|yum|dnf|rpm|snapd|unattended-upgrade)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/nohup$/ nocase
    $proc.target.process.command_line = /\/(tmp|var\/tmp|dev\/shm)\// nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1564.011")
    $primary_entity = array_distinct($proc.principal.hostname)
    $staged_files = array_distinct($file.target.file.full_path)
    $nohup_commands = array_distinct($proc.target.process.command_line)
    $launching_users = array_distinct($proc.principal.user.userid)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)

  condition:
    $file and $proc
}
