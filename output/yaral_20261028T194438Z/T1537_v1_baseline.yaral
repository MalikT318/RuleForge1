/*
  MITRE Technique : T1537 - Transfer Data to Cloud Account
  Tactic(s)       : Exfiltration
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:35:28.783104+00:00
  Reference       : https://attack.mitre.org/techniques/T1537
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1537_SaaS_Anonymous_Or_External_Share_Link_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of anonymous (anyone-with-the-link) or secure sharing links on cloud-hosted files and folders. Adversaries use these cloud-native sharing mechanisms to hand victim data to an account or recipient they control without moving it over an external network channel."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1537"
    mitre_technique_name = "Transfer Data to Cloud Account"
    log_prerequisites = "Requires Microsoft 365 unified audit logs (SharePoint/OneDrive file and sharing operations) ingested and normalised to UDM with metadata.product_event_type populated."
    platform = "SaaS"
    log_source = "m365"
    false_positives = "Users legitimately sharing documents with customers or partners, marketing or communications teams publishing public links, project sites that routinely collaborate with external guests, and sanctioned data-room or migration activity."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation or migration accounts to %global_allowed_service_accounts. If anonymous links are blocked tenant-wide, this rule should be near-silent and any hit is high priority. In collaboration-heavy tenants, consider raising severity only for sensitive sites after validating the baseline."

  events:
    $share.metadata.event_type = "USER_RESOURCE_ACCESS"
    $share.metadata.product_event_type = /^(AnonymousLinkCreated|SecureLinkCreated|AddedToSecureLink)$/ nocase
    $share.principal.user.userid != ""
    not $share.principal.user.userid in %global_allowed_admin_users
    not $share.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1537")
    $primary_entity = array_distinct($share.principal.user.userid)
    $shared_resource = array_distinct($share.target.file.full_path)
    $sharing_action = array_distinct($share.metadata.product_event_type)
    $source_ip = array_distinct($share.principal.ip)

  condition:
    $share
}
