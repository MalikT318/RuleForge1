/*
  MITRE Technique : T1216.002 - SyncAppvPublishingServer
  Tactic(s)       : Stealth
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:36:22.643186+00:00
  Reference       : https://attack.mitre.org/techniques/T1216/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1216_002_AppV_Publishing_Script_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows script host (wscript/cscript) executing the App-V publishing sync script when it was launched by an unexpected parent process such as an Office application, web server worker, database service, print spooler, WMI provider host or Java runtime. Legitimate App-V sync is normally started by the user shell, a scheduled task or management tooling, not by document, web or service processes. This lineage indicates proxied PowerShell execution to bypass execution restrictions."
    mitre_tactic = "Stealth"
    mitre_technique = "T1216.002"
    mitre_technique_name = "System Script Proxy Execution: SyncAppvPublishingServer"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with parent process path and full command line (EDR, Sysmon Event ID 1, or Windows Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Enterprise App-V deployments where a management agent or custom line-of-business application programmatically triggers publishing sync; software packaging or testing hosts; Office add-ins from a managed App-V environment; admin automation launched from a script host or RMM agent."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts. Add approved remote management tools to %global_allowed_remote_mgmt. If App-V is not deployed in a client environment, consider raising severity to Critical. Extend the parent-process regex with client-specific high-risk service processes if needed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(wscript|cscript)\.exe$/ nocase
    $proc.target.process.command_line = /SyncAppvPublishingServer(\.vbs)?/ nocase
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|acrord32|acrobat|foxitreader|w3wp|httpd|nginx|tomcat[0-9]*|java|sqlservr|spoolsv|wmiprvse|mshta)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1216.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
