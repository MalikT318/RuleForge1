/*
  MITRE Technique : T1069.002 - Domain Groups
  Tactic(s)       : Discovery
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:58:31.017915+00:00
  Reference       : https://attack.mitre.org/techniques/T1069/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1069_002_Outbound_LDAP_Directory_Query_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects LDAP, LDAPS or Global Catalog connections (TCP 389/636/3268/3269) that cross the network perimeter to a non-internal destination. Directory protocols are normally confined to internal domain controllers. Outbound directory queries can indicate domain group and permission enumeration (T1069.002) through a tunnel, proxy or externally reachable directory, or an attacker-controlled relay. This gives network-side coverage that complements endpoint command-line detections. Because it observes perimeter traffic, it does not see enumeration against internal domain controllers."
    mitre_tactic = "Discovery"
    mitre_technique = "T1069.002"
    mitre_technique_name = "Permission Groups Discovery: Domain Groups"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.hostname, target.ip and target.port populated, with outbound or egress policy traffic logged."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Hybrid-identity or cloud-hosted directory services reached over LDAPS (managed directory services), site-to-site or VPN-routed domain controllers presented with public or non-RFC1918 addressing, authorised vulnerability scanners and directory-integrated SaaS or appliance connectors, and admins using LDAP tooling against partner directories."
    tuning_guidance = "Add approved scanner and connector hosts to %global_allowed_scanners, approved cloud directory FQDNs to %global_allowed_domains, and directory sync or service accounts to %global_allowed_service_accounts. Ensure %rfc1918_internal covers all internal address space, including any non-RFC1918 internal ranges."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 389 or
      $net.target.port = 636 or
      $net.target.port = 3268 or
      $net.target.port = 3269
    )
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1069.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
