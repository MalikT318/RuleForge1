/*
  MITRE Technique : T1036.004 - Masquerade Task or Service
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:02:16.219188+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_004_Service_ImagePath_Masquerade_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry write to a Windows service ImagePath where the service key name imitates a well-known built-in or security Windows service, but the binary path points to a user-writable or staging location (Users, ProgramData, Temp, AppData, PerfLogs, Public). This catches service name masquerading from the resulting registry state change, regardless of whether the service was created with sc.exe, PowerShell, WMI, an API call or a custom tool, and does not depend on command-line logging."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.004"
    mitre_technique_name = "Masquerading: Masquerade Task or Service"
    log_prerequisites = "Requires Windows endpoint registry telemetry that populates the registry key and value data (EDR registry events, or Sysmon Event ID 13 SetValue) for HKLM\\SYSTEM\\*ControlSet*\\Services."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Third-party software that installs a service with a name resembling a Windows service (updaters, OEM utilities) and runs from ProgramData or a user profile; portable or per-user application installers; software deployment and RMM tooling; lab or developer machines installing test services."
    tuning_guidance = "Add approved deployment or installer processes to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Extend the legitimate-service-name alternation if a client uses vendor services with similar names, and extend the Microsoft ProgramData exclusion if other trusted vendor paths appear. Review hits by checking the writing process (principal.process) and the signer of the referenced binary."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\services\\(wuauserv|usosvc|windefend|wdnissvc|wdfilter|mpssvc|eventlog|dnscache|spooler|bits|winmgmt|schedule|themes|lanmanserver|lanmanworkstation|wscsvc|sense|trustedinstaller|cryptsvc|w32time|netlogon|plugplay|rpcss|termservice|audiosrv|sysmain|wersvc|windowsupdate|(windows|microsoft)[ _-]?(update|defender|security|time|audio|firewall|search|font|driver|installer|management|health)[^\\]*)(\\imagepath)?$/ nocase
    $reg.target.registry.registry_value_data = /(\\users\\|\\programdata\\|\\windows\\temp\\|\\temp\\|\\appdata\\|\\perflogs\\|\\\$recycle\.bin\\)/ nocase
    not $reg.target.registry.registry_value_data = /\\programdata\\microsoft\\(windows defender|windows\\applocker|windows security health)\\/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1036.004")
    $primary_entity = array_distinct($reg.principal.hostname)
    $service_key = array_distinct($reg.target.registry.registry_key)
    $service_image_path = array_distinct($reg.target.registry.registry_value_data)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
