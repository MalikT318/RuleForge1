/*
  MITRE Technique : T1204 - User Execution
  Tactic(s)       : Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:58:15.331193+00:00
  Reference       : https://attack.mitre.org/techniques/T1204
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1204_Burst_Executable_Downloads_Per_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal client downloads several Windows-executable or script-type files (executables, installers, scripts, shortcuts, disk images) from external web destinations within ten minutes. One download is routine, but a burst is consistent with a user being socially engineered into fetching and running payloads (T1204.002 follow-on from phishing, fake update or fake-installer lures). Detection uses only network-observable proxy and firewall HTTP telemetry and no endpoint process fields, so it complements process-creation rules."
    mitre_tactic = "Execution"
    mitre_technique = "T1204"
    mitre_technique_name = "User Execution"
    log_prerequisites = "Requires firewall or web-proxy logs normalised to NETWORK_HTTP with target.url and target.hostname populated (URL-aware inspection or proxy logging). Encrypted traffic without TLS inspection will not expose the URL."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Software deployment and patching workflows, developers or IT staff downloading installers and scripts, package managers, vendor update services not yet in the allowlist, legitimate download portals used by IT."
    tuning_guidance = "Add known-good vendor and update domains to %global_allowed_domains. Raise the #net threshold in the condition for noisy environments, or lower it to 2 for high-sensitivity clients. Review the dest_hosts and urls outcome fields to separate IT-driven downloads from lure-driven ones."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET" nocase
    $net.target.url = /\.(exe|msi|msix|appx|scr|hta|js|jse|vbs|vbe|wsf|bat|cmd|ps1|lnk|iso|img|jar|dll)([?#].*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    $net.principal.ip = $src

  match:
    $src over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1204")
    $primary_entity = array_distinct($src)
    $event_count = count($net.metadata.id)
    $dest_hosts = array_distinct($net.target.hostname)
    $urls = array_distinct($net.target.url)

  condition:
    #net >= 3
}
