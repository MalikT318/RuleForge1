/*
  MITRE Technique : T1547.012 - Print Processors
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:38:54.587759+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_012_Print_Spooler_Spawns_Shell_Or_LOLBin {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the print spooler service (spoolsv.exe) spawning a command shell, script interpreter or proxy-execution LOLBin. A malicious print processor DLL loads inside spoolsv.exe as SYSTEM, so child processes launched from it are a strong lineage signal of print processor abuse (or related spooler exploitation). The rule keys on the anomalous parent-child relationship rather than on command-line content."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.012"
    mitre_technique_name = "Boot or Logon Autostart Execution: Print Processors"
    log_prerequisites = "Requires EDR or Sysmon-equivalent process creation telemetry (or Windows Event 4688 with parent process name) populating principal.process.file.full_path and target.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy printer driver or vendor print-management installers that spawn cmd or script helpers from the spooler, print server maintenance scripts, and some third-party print-queue or secure-print software."
    tuning_guidance = "Add approved print management or deployment binaries to %global_allowed_admin_tools (matched on the child process path). Add dedicated print servers with known spooler helper behaviour to %global_allowed_script_hosts. Review the child command line in the outcome before whitelisting."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\spoolsv\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|wmic|certutil|bitsadmin|schtasks|reg|net|net1|sc)\.exe$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.012")
    $primary_entity = array_distinct($proc.principal.hostname)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $account = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
