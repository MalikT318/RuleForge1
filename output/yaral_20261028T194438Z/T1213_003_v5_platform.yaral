/*
  MITRE Technique : T1213.003 - Code Repositories
  Tactic(s)       : Collection
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:26:54.017787+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_003_SaaS_Code_Repo_Bulk_Collection_Action {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a user performing a bulk source-collection action (clone, archive/ZIP download, export, mirror) against a hosted code repository, as recorded in SaaS audit logs. Adversaries with stolen sessions or tokens use these operations to collect proprietary source code and embedded credentials in one step. This rule uses SaaS control-plane telemetry and does not depend on endpoint process or command-line data."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.003"
    mitre_technique_name = "Data from Information Repositories: Code Repositories"
    log_prerequisites = "Requires SaaS code-hosting audit logging that includes repository-level read and export events, normalised to USER_RESOURCE_ACCESS with metadata.product_event_type, principal.user.userid and target.resource.name populated. Enterprise or organisation-level audit log streaming must be enabled, and Git/clone events must be turned on where the platform makes them optional."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "CI/CD pipelines and build bots cloning repositories, developers onboarding or switching machines, approved repository migrations, backup and e-discovery exports, security scanning integrations, and legal-hold or M&A due-diligence exports."
    tuning_guidance = "Add build and automation identities to %global_allowed_service_accounts, approved migration and archive operators to %global_allowed_admin_users, and approved integration or app principals to %global_allowed_cloud_principals. Raise severity or add enrichment for repositories classed as sensitive. For volume-based alerting, build a companion Threshold rule per user."

  events:
    $acc.metadata.event_type = "USER_RESOURCE_ACCESS"
    $acc.metadata.product_event_type = /(repo|repositor|project|git|source|code)/ nocase
    $acc.metadata.product_event_type = /(clone|archive|download|zip|tarball|export|mirror|fetch_all|bulk)/ nocase
    $acc.principal.user.userid != ""
    not $acc.principal.user.userid in %global_allowed_service_accounts
    not $acc.principal.user.userid in %global_allowed_admin_users
    not $acc.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1213.003")
    $primary_entity = array_distinct($acc.principal.user.userid)
    $repositories = array_distinct($acc.target.resource.name)
    $actions = array_distinct($acc.metadata.product_event_type)
    $source_ips = array_distinct($acc.principal.ip)

  condition:
    $acc
}
