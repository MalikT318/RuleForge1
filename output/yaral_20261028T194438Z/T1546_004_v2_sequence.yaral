/*
  MITRE Technique : T1546.004 - Unix Shell Configuration Modification
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:05:43.893870+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_004_Shell_Config_Modified_After_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a shell startup or profile file (/etc/profile, /etc/profile.d/*, ~/.bashrc, ~/.bash_profile, ~/.profile, ~/.bash_logout, zsh equivalents) being modified by a scripting or transfer utility. The modification must follow an external network connection from a staging-directory process or download utility, on the same host and by the same user, within 10 minutes. This pattern matches a payload being fetched and then planted for persistence through shell configuration."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.004"
    mitre_technique_name = "Event Triggered Execution: Unix Shell Configuration Modification"
    log_prerequisites = "Requires Linux EDR or auditd file-modification telemetry with the writing process path and user populated, plus network connection telemetry with the originating process path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management agents (Ansible, Puppet, Chef, Salt) pulling content and rewriting /etc/profile.d. Admin provisioning scripts that download packages and then set environment variables. Developer tooling installers (nvm, pyenv, rustup, conda) that fetch binaries and append PATH entries to ~/.bashrc or ~/.profile."
    tuning_guidance = "Add approved config-management and provisioning binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Add provisioning hosts or parent shells to %global_allowed_script_hosts. Consider raising severity for modifications to /etc/profile and /etc/profile.d, which need root."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /(^\/(tmp|var\/tmp|dev\/shm)\/|\/(curl|wget|nc|ncat|socat)$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    $net.principal.hostname = $hostname
    $net.principal.user.userid = $user

    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /(^\/etc\/(profile|bash\.bashrc|bashrc|zshenv|zprofile|zshrc|zsh\/zshrc|zsh\/zshenv|zsh\/zprofile)$|^\/etc\/profile\.d\/[^\/]+$|^\/(root|home\/[^\/]+)\/\.(bashrc|bash_profile|bash_login|profile|bash_logout|zshrc|zprofile|zshenv|zlogin)$)/ nocase
    $file.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|python[0-9.]*|perl|ruby|curl|wget|tee|sed|cp|mv|dd)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $hostname
    $file.principal.user.userid = $user

    $net.metadata.event_timestamp.seconds <= $file.metadata.event_timestamp.seconds

  match:
    $hostname, $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1546.004")
    $primary_entity = array_distinct($hostname)
    $modified_files = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $network_processes = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $acting_user = array_distinct($user)

  condition:
    $net and $file
}
