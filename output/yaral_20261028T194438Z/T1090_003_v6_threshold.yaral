/*
  MITRE Technique : T1090.003 - Multi-hop Proxy
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : DNS query / resolver logs
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:31:44.203954+00:00
  Reference       : https://attack.mitre.org/techniques/T1090/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1090_003_DNS_Onion_Proxy_Resolution_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a single host issuing repeated DNS queries for onion-service style names (16 or 56 character base32 label under the .onion pseudo-TLD, including web gateways that append a suffix after .onion). Repeated lookups indicate a Tor client, an onion-routing proxy or a gateway being used to chain C2 traffic through multiple hops. A single lookup can be benign, but sustained volume from one host in ten minutes is not."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1090.003"
    mitre_technique_name = "Proxy: Multi-hop Proxy"
    log_prerequisites = "DNS query or resolver logs normalised to UDM NETWORK_DNS with network.dns.questions.name and principal.hostname populated for the querying client. Windows clients must send DNS through a logging resolver. No endpoint process fields are needed."
    platform = "Windows"
    log_source = "dns"
    false_positives = "Security researchers and threat-intel analysts browsing onion services, malware sandboxes and detonation hosts, authorised red-team or penetration-test hosts, privacy-focused users on BYOD or guest segments where Tor is permitted, and security tools that resolve onion names for URL reputation checks."
    tuning_guidance = "Add sandbox, analyst and scanner hostnames to %global_allowed_scanners. Add approved onion gateways or research domains to %global_allowed_domains. Raise the #dns threshold from 5 on noisy segments, or lower it to 3 for high-value server subnets. Always investigate hosts that also show Tor-like outbound connections on the endpoint or firewall telemetry."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(^|\.)[a-z2-7]{16}([a-z2-7]{40})?\.onion(\.[a-z]{2,6})?\.?$/ nocase
    $dns.principal.hostname = $host
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.hostname in %global_allowed_scanners

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($dns.metadata.id)
    $queried_names = array_distinct($dns.network.dns.questions.name)
    $mitre_technique_id = array_distinct("T1090.003")
    $primary_entity = array_distinct($host)

  condition:
    #dns >= 5
}
