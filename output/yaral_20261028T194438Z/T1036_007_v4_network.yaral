/*
  MITRE Technique : T1036.007 - Double File Extension
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:08:07.461444+00:00
  Reference       : https://attack.mitre.org/techniques/T1036/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1036_007_Double_Extension_Network_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an HTTP request to an external host for a file whose name pairs a benign document or media extension with a trailing executable or script extension (for example report.pdf.exe). This is the network-side delivery of a double-extension masquerading payload. It complements endpoint process-creation coverage by catching the download before execution."
    mitre_tactic = "Stealth"
    mitre_technique = "T1036.007"
    mitre_technique_name = "Masquerading: Double File Extension"
    log_prerequisites = "Requires NETWORK_HTTP events carrying the full requested URL in target.url, from a web proxy, secure web gateway, or EDR network telemetry normalised to UDM. Endpoint telemetry should be present for Windows hosts."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software vendors or internal build systems that distribute installers with versioned names such as setup.v2.msi or tool.x64.exe, or files named like readme.txt.exe in legitimate download portals. Security awareness phishing simulations and malware sandboxes that fetch test samples will also trigger."
    tuning_guidance = "Add known-good vendor and CDN domains to %global_allowed_domains. Add approved deployment or patching tools to %global_allowed_admin_tools. Add authorised sandbox or scanner sources to %global_allowed_scanners. Narrow or widen the decoy extension list as needed per client."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /\.(pdf|docx?|xlsx?|pptx?|txt|rtf|csv|jpe?g|png|gif|bmp|zip|mp3|mp4)\.(exe|scr|com|pif|bat|cmd|js|jse|vbs|vbe|wsf|hta|msi|ps1|lnk|jar)(\?|#|;|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1036.007")
    $primary_entity = array_distinct($net.principal.hostname)
    $requested_url = array_distinct($net.target.url)
    $destination_host = array_distinct($net.target.hostname)
    $destination_ip = array_distinct($net.target.ip)
    $source_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
