/*
  MITRE Technique : T1564.010 - Process Argument Spoofing
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:28:30.342041+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_010_Bare_CommandLine_Binary_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Network-side indicator of process argument spoofing or hollowing. A binary that normally cannot do anything without arguments (rundll32, regsvr32, mshta, msbuild, script hosts, svchost, dllhost) makes an external network connection while its recorded command line contains no arguments. This is consistent with a process spawned with blanked or benign arguments, or one whose PEB command line was overwritten after launch. Process-creation command-line rules do not catch this because the spoofed arguments look benign at launch."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.010"
    mitre_technique_name = "Hide Artifacts: Process Argument Spoofing"
    log_prerequisites = "Requires endpoint network telemetry that records the originating process path and its current command line (EDR or Sysmon Event ID 3 enriched with process data). Telemetry must be normalised to UDM NETWORK_CONNECTION with principal.process.* populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "EDR/AV agents that query process command lines differently; unusual legitimate service hosts launched without arguments by third-party software; software installers or RMM tools that start svchost, dllhost or rundll32 helpers without arguments; EDR sensors that truncate or omit command lines for some events."
    tuning_guidance = "Add approved tooling to %global_allowed_admin_tools, %global_allowed_remote_mgmt and %global_allowed_security_tools. Add known-good destination domains via %global_allowed_domains if the target.hostname field is populated. If the EDR does not populate principal.process.command_line for network events, the rule will not fire. Validate on a pilot host before broad deployment."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(rundll32|regsvr32|mshta|msbuild|installutil|regasm|regsvcs|wscript|cscript|svchost|dllhost)\.exe$/ nocase
    $net.principal.process.command_line = /^\s*(?:"[^"]+"|[^\s"]+)\s*$/
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1564.010")
    $primary_entity = array_distinct($net.principal.hostname)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $process_command_line = array_distinct($net.principal.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
