/*
  MITRE Technique : T1499.004 - Application or System Exploitation
  Tactic(s)       : Impact
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:23:33.658844+00:00
  Reference       : https://attack.mitre.org/techniques/T1499/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1499_004_Windows_Service_Port_Connection_Flood {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single external source opens a very high volume of connections to one internal host on a Windows-hosted service port (SMB, RPC, RDP, WinRM) within ten minutes. Each connection is benign on its own. Sustained volume against one service is consistent with repeated exploit attempts that crash or hang the service and deny availability."
    mitre_tactic = "Impact"
    mitre_technique = "T1499.004"
    mitre_technique_name = "Endpoint Denial of Service: Application or System Exploitation"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. The firewall must see inbound traffic to the Windows servers."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners or penetration tests not yet in the allow list, VPN concentrators or NAT gateways that aggregate many users behind one external address, partner or MSP links with legitimate high-rate SMB or RDP use, load balancer or monitoring health checks, and internet-exposed RDP being brute-forced (a different threat, but the same volume pattern)."
    tuning_guidance = "Add scanner and testing sources to %global_allowed_scanners. Raise or lower the #net threshold per client based on baseline firewall log volume. Extend the port list for client-specific Windows services. Internal traffic is already excluded through %rfc1918_internal. If firewall logs are sampled or aggregated, lower the threshold."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 445 or
      $net.target.port = 135 or
      $net.target.port = 139 or
      $net.target.port = 3389 or
      $net.target.port = 5985 or
      $net.target.port = 5986
    )
    $net.principal.ip = $src_ip
    $net.target.ip = $dst_ip
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src_ip, $dst_ip over 10m

  outcome:
    $risk_score = max(if($net.target.port = 3389 or $net.target.port = 445, 70, 55))
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1499.004")
    $primary_entity = array_distinct($dst_ip)
    $source_ips = array_distinct($src_ip)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    #net >= 200
}
