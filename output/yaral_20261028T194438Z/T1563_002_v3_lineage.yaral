/*
  MITRE Technique : T1563.002 - RDP Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:10:35.838793+00:00
  Reference       : https://attack.mitre.org/techniques/T1563/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_002_RDP_Hijack_Tscon_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the native Terminal Services console utility (tscon.exe) launched with a /dest: session-redirect argument by an unexpected parent process: a service host, WMI or WinRM provider, Office application, web server, database service, print spooler, or script interpreter. Legitimate session switching is normally done interactively by an administrator. Hijacking a session without credentials typically runs from SYSTEM through a service, scheduled task, or remote execution chain."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1563.002"
    mitre_technique_name = "Remote Service Session Hijacking: RDP Hijacking"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing) populating parent and child process paths and the child command line."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Helpdesk or RMM tooling that shadows or reconnects user sessions, administrators scripting session reconnection on terminal servers, session-management scripts run from scheduled tasks, VDI or RDS broker automation."
    tuning_guidance = "Add approved session-management tooling to %global_allowed_admin_tools or %global_allowed_remote_mgmt (parent process path). Add named administrators to %global_allowed_admin_users and automation accounts to %global_allowed_service_accounts. Terminal-server farms with scripted reconnects may need to exclude specific hosts or parent script hosts via %global_allowed_script_hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\tscon\.exe$/ nocase
    $proc.target.process.command_line = /\/dest:/ nocase
    $proc.principal.process.file.full_path = /\\(services|svchost|wmiprvse|wsmprovhost|taskeng|taskhostw|winword|excel|powerpnt|outlook|msaccess|w3wp|httpd|nginx|tomcat\d*|java|sqlservr|spoolsv|mshta|wscript|cscript|cmd|powershell|pwsh)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1563.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
