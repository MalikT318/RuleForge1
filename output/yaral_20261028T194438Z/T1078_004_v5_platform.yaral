/*
  MITRE Technique : T1078.004 - Cloud Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:34:43.844818+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_004_SaaS_Legacy_SingleFactor_External_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a cloud account authenticating from an external address using password-only or legacy/basic-auth protocols (IMAP, POP, SMTP AUTH, ActiveSync, EWS, single-factor). These paths bypass MFA and conditional access and are the usual route for using stolen or sprayed cloud credentials against a SaaS tenant. The rule matches the authentication mechanism, not a specific application or vendor."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.004"
    mitre_technique_name = "Valid Accounts: Cloud Accounts"
    log_prerequisites = "Requires identity provider or SaaS sign-in audit logs normalised to UDM USER_LOGIN, with extensions.auth.mechanism, extensions.auth.auth_details and principal.ip populated. Logs must record the authentication protocol or client type in auth_details."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Legacy mail clients, scanners/MFPs sending mail via SMTP AUTH, line-of-business apps still using basic authentication, service mailboxes, and users on break-glass or MFA-exempt accounts."
    tuning_guidance = "Add automation and shared mailbox accounts to %global_allowed_service_accounts and approved identity principals to %global_allowed_cloud_principals. If auth_details is not populated by the client's parser, adjust the regex to the protocol or client-type wording used in that log feed. Failed attempts are not excluded when the result field is unpopulated; if the feed reports results reliably, consider tightening to successful logins only."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.extensions.auth.mechanism = "USERNAME_PASSWORD"
    $auth.extensions.auth.auth_details = /(legacy|basic\s?auth|imap|pop3?|smtp|activesync|exchange web services|\bews\b|single.?factor)/ nocase
    not $auth.principal.ip in %rfc1918_internal
    not $auth.security_result.action = "BLOCK"
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1078.004")
    $primary_entity = array_distinct($auth.target.user.userid)
    $source_ips = array_distinct($auth.principal.ip)
    $auth_methods = array_distinct($auth.extensions.auth.auth_details)

  condition:
    $auth
}
