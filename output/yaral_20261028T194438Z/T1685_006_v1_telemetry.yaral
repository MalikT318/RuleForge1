/*
  MITRE Technique : T1685.006 - Clear Linux or Mac System Logs
  Tactic(s)       : Defense Impairment
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:24:51.500713+00:00
  Reference       : https://attack.mitre.org/techniques/T1685/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1685_006_Linux_System_Log_Modified_By_Shell_Or_Utility {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification (truncation or overwrite) of core Linux system, authentication, login-record, audit or web server logs under /var/log by a shell, interpreter or generic file utility rather than a logging daemon. The rule works on the resulting file-state change, so it still fires when command-line logging is evaded (for example, a shell redirect such as ': > /var/log/auth.log')."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1685.006"
    mitre_technique_name = "Clear Linux or Mac System Logs"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-write watches (-w /var/log -p wa) that populate FILE_MODIFICATION events with the acting process path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators manually truncating oversized logs during incident response or disk-space emergencies; logrotate postrotate scripts and configuration-management runs executed via a shell; application installers and uninstallers resetting logs; container or CI images that reset logs at build time."
    tuning_guidance = "Add approved maintenance and log-management tooling to %global_allowed_admin_tools and EDR or log-forwarding agents to %global_allowed_security_tools. Add automation accounts that legitimately reset logs to %global_allowed_service_accounts, and approved scripting parents to %global_allowed_script_hosts. Narrow or extend the log path regex to match local logging layouts."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/var\/(log\/(auth\.log|secure|messages|syslog|kern\.log|cron(\.log)?|maillog|mail\.log|wtmp|btmp|lastlog|faillog|audit\/audit\.log|(httpd|apache2|nginx)\/[^\/]+\.log)|run\/utmp)$/ nocase
    $file.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|csh|tcsh|fish|busybox|truncate|shred|dd|tee|cp|mv|cat|sed|echo|python[0-9.]*|perl|ruby|php[0-9.]*|node)$/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1685.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_logs = array_distinct($file.target.file.full_path)
    $actor_process = array_distinct($file.principal.process.file.full_path)
    $actor_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
