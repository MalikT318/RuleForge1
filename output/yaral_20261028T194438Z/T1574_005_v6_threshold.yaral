/*
  MITRE Technique : T1574.005 - Executable Installer File Permissions Weakness
  Tactic(s)       : Stealth, Execution
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:31:47.647842+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_005_Installer_Temp_Binary_Overwrite_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of executable or DLL file modifications inside per-installer subdirectories of a Temp folder on a single host within 10 minutes. This is consistent with an installer's unpacked binaries being overwritten or replaced (installer file permissions weakness). A single write is normal installer behaviour. Repeated overwrites of binaries in these weakly permissioned directories are not."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.005"
    mitre_technique_name = "Hijack Execution Flow: Executable Installer File Permissions Weakness"
    log_prerequisites = "Requires Windows endpoint file-modification telemetry (EDR or Sysmon file events) populating target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Self-extracting installers and software updaters that rewrite their own unpacked files, software deployment and patching agents, developer build tooling writing binaries under Temp, and AV or EDR scanners that quarantine or restore files."
    tuning_guidance = "Add deployment and patching binaries to %global_allowed_admin_tools, security agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Raise the #file threshold on hosts with heavy build or installer activity. The nocase regex matches any user profile Temp path, so no per-user edits are needed."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /\\temp\\[^\\]+\\.*\.(exe|dll|sys|msi|scr)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|TiWorker|TrustedInstaller|wuauclt|usoclient)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($file.target.file.full_path = /\\windows\\temp\\/ nocase, 80, 60))
    $mitre_technique_id = array_distinct("T1574.005")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $modified_files = array_distinct($file.target.file.full_path)
    $writer_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 8
}
