/*
  MITRE Technique : T1056.001 - Keylogging
  Tactic(s)       : Collection, Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:46:25.093847+00:00
  Reference       : https://attack.mitre.org/techniques/T1056/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1056_001_Keylog_Exfil_HTTP_POST_To_Raw_IP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an HTTP POST from an internal host to an external destination addressed by a raw IP literal instead of a domain name. This is a network-side indicator of captured keystroke data being exfiltrated by input-capture malware. Fidelity is moderate and best used as a hunting or triage signal alongside endpoint coverage."
    mitre_tactic = "Collection, Credential Access"
    mitre_technique = "T1056.001"
    mitre_technique_name = "Input Capture: Keylogging"
    log_prerequisites = "Requires firewall or proxy logs that populate HTTP method and URL (TLS inspection or an explicit proxy). Encrypted traffic without inspection will not produce NETWORK_HTTP events."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Embedded devices, IoT or OT systems that post telemetry to hard-coded IP addresses, legacy line-of-business applications, software update or licensing agents that call IP-addressed endpoints, and developer testing against public IPs."
    tuning_guidance = "Add known-good destination domains to %global_allowed_domains, approved scanners and test sources to %global_allowed_scanners, and approved source hosts to %global_allowed_mgmt_sources if needed. Consider adding a network.sent_bytes ceiling if the firewall reliably populates it, since keystroke exfiltration is typically small and periodic. Raise the severity for source hosts that are user workstations."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST" nocase
    $http.target.url = /^(https?:\/\/)?([0-9]{1,3}\.){3}[0-9]{1,3}(:[0-9]{1,5})?(\/|$)/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1056.001")
    $primary_entity = array_distinct($http.principal.ip)
    $destination_ips = array_distinct($http.target.ip)
    $destination_urls = array_distinct($http.target.url)

  condition:
    $http
}
