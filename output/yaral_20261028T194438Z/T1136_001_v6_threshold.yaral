/*
  MITRE Technique : T1136.001 - Local Account
  Tactic(s)       : Persistence
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:08:48.182224+00:00
  Reference       : https://attack.mitre.org/techniques/T1136/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_001_NetDev_MgmtPlane_Untrusted_Access_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Sustained connection volume from a single non-allowlisted external source to one destination on common network-device management-plane ports (SSH, Telnet, NETCONF, alternate HTTPS management) within 10 minutes. A firewall log cannot see account creation itself. This detects the network-observable precursor and delivery path for creating a rogue local or super-admin account on a network device or firewall management console (exploitation, credential guessing, then account creation). Treat hits as a trigger to review device configuration and audit logs for new local accounts."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136.001"
    mitre_technique_name = "Create Account: Local Account"
    log_prerequisites = "Firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs must cover traffic destined for device management interfaces. Pair with device management-plane audit logs for confirmation of account creation."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and penetration tests, external vendor or MSP remote support over SSH, automated configuration backup or monitoring tools reaching the device from outside address space, and misconfigured automation retrying connections."
    tuning_guidance = "Add approved management source addresses to %global_allowed_mgmt_sources and approved scanners to %global_allowed_scanners. Raise or lower the #net threshold per client based on baseline management-plane traffic. If management interfaces are never exposed externally, any hit is high-signal and the threshold can be lowered. Extend the port list for client-specific management ports."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 22 or
      $net.target.port = 23 or
      $net.target.port = 830 or
      $net.target.port = 4443 or
      $net.target.port = 8443
    )
    $net.principal.ip = $src
    $net.target.ip = $dst
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src, $dst over 10m

  outcome:
    $event_count = count($net.metadata.id)
    $risk_score = max(if($event_count >= 100, 85, if($event_count >= 50, 70, 55)))
    $mitre_technique_id = array_distinct("T1136.001")
    $primary_entity = array_distinct($src)
    $targeted_device_ips = array_distinct($dst)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    #net >= 20
}
