/*
  MITRE Technique : T1213.006 - Databases
  Tactic(s)       : Collection
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:30:48.206836+00:00
  Reference       : https://attack.mitre.org/techniques/T1213/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1213_006_Linux_WebServer_Spawns_DB_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web or application server process (nginx, apache, php-fpm, uwsgi and similar) directly spawning a database client or dump utility on Linux. Web-tier processes rarely launch these binaries themselves. When they do, it often means a web shell or exploited application is querying or dumping a database. The rule keys on parent-child lineage, not command-line content."
    mitre_tactic = "Collection"
    mitre_technique = "T1213.006"
    mitre_technique_name = "Data from Information Repositories: Databases"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records normalised to UDM PROCESS_LAUNCH, with parent (principal.process) and child (target.process) executable paths populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web-based DB admin tools, CMS backup or export plugins (for example WordPress or Magento backup jobs) that shell out to mysqldump or pg_dump, application health checks that call a DB client, and legacy CGI/PHP applications that invoke DB command-line utilities by design."
    tuning_guidance = "Add legitimate parent binaries to %global_allowed_script_hosts, approved DB tooling to %global_allowed_admin_tools, and backup software to %global_allowed_backup_processes. If an application is known to invoke a DB client, allowlist its parent path rather than loosening the child regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|caddy|php-fpm[0-9.]*|php-cgi|uwsgi|gunicorn|tomcat[0-9]*)$/ nocase
    $proc.target.process.file.full_path = /\/(mysql|mysqldump|mysqlsh|mariadb|mariadb-dump|psql|pg_dump|pg_dumpall|mongo|mongosh|mongodump|mongoexport|sqlite3|redis-cli|cqlsh)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1213.006")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
