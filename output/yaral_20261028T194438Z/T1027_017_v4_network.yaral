/*
  MITRE Technique : T1027.017 - SVG Smuggling
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:06:01.738987+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/017
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_017_Linux_Direct_External_SVG_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux client fetching an SVG file from an external, non-allowlisted host with a successful response and no referrer. A direct fetch with no referring page is typical of a user clicking a link in an email or chat message, or of a script downloading the file. SVGs embedded in normal web pages carry a referrer, so a direct fetch is more likely a smuggling delivery, where the SVG carries script or an embedded payload to evade content filters."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.017"
    mitre_technique_name = "Obfuscated Files or Information: SVG Smuggling"
    log_prerequisites = "Requires web proxy or perimeter firewall logs with URL inspection, normalised to NETWORK_HTTP with target.url, network.http.user_agent, network.http.referral_url, and network.http.response_code populated. TLS inspection is needed to see HTTPS URLs."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Users opening direct links to legitimate SVG assets such as logos, diagrams, or documentation images. Developers and package tooling (curl, wget) fetching SVG icons or badges. Design and content teams browsing public image repositories. CDN-hosted SVGs not yet in the allowed domains list."
    tuning_guidance = "Add known-good external hostnames (CDNs, vendor documentation, image hosting) to %global_allowed_domains. If curl/wget noise is high from build or CI hosts, remove those user agents from the regex or exclude the sources via %global_allowed_mgmt_sources. Tighten further by adding a webmail or chat-client referrer condition if your proxy records one."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET"
    $http.network.http.response_code = 200
    $http.target.url = /\.svg(\?[^\s]*)?$/ nocase
    $http.network.http.user_agent = /(X11;.*Linux|Linux (x86_64|aarch64)|Ubuntu|Fedora|Debian|wget|curl)/ nocase
    not $http.network.http.user_agent = /Android/ nocase
    $http.network.http.referral_url = ""
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1027.017")
    $primary_entity = array_distinct($http.principal.ip)
    $svg_urls = array_distinct($http.target.url)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
