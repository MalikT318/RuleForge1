/*
  MITRE Technique : T1566.002 - Spearphishing Link
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:48:30.991316+00:00
  Reference       : https://attack.mitre.org/techniques/T1566/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1566_002_Linux_Browser_Deceptive_Link_Payload_Fetch {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Network-side detection of the click-through stage of a spearphishing link. A Linux desktop browser, identified by its user agent, issues an HTTP request to an external destination whose URL has the structure of a phishing or malware-delivery link. The structures matched are a userinfo '@' that disguises the real host, a punycode (xn--) hostname, and a raw-IP host serving a script, binary or archive payload. It uses proxy or firewall HTTP telemetry only, so it complements endpoint command-line rules."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1566.002"
    mitre_technique_name = "Phishing: Spearphishing Link"
    log_prerequisites = "Requires proxy or firewall NETWORK_HTTP logs with target.url, network.http.user_agent and principal.hostname populated. TLS-inspecting proxy needed for HTTPS URL visibility."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Internationalised (punycode) domains visited legitimately; developers or admins downloading packages and scripts from IP-addressed internal-lab or cloud hosts; legacy URLs with embedded credentials; vendor update services using raw-IP mirrors."
    tuning_guidance = "Add known-good destination domains to %global_allowed_domains. Confirm %rfc1918_internal covers all internal address space for the client. If scanners or crawlers trigger the rule, filter their source hosts via %global_allowed_scanners. Restrict to user-subnet proxy logs if server egress is noisy."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "GET" nocase
    $http.network.http.user_agent = /Mozilla\/.*(X11;|Linux)/ nocase
    not $http.network.http.user_agent = /Android/ nocase
    $http.target.url = /^https?:\/\/([^\/?#]*@|[^\/?#]*xn--|(\d{1,3}\.){3}\d{1,3}(:\d+)?\/[^?#]*\.(sh|elf|run|appimage|deb|rpm|zip|tar|gz|tgz|bin|py)([?#]|$))/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1566.002")
    $primary_entity = array_distinct($http.principal.hostname)
    $requested_urls = array_distinct($http.target.url)
    $destination_ips = array_distinct($http.target.ip)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
