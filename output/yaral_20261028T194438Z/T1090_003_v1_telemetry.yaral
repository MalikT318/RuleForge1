/*
  MITRE Technique : T1090.003 - Multi-hop Proxy
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:30:03.602389+00:00
  Reference       : https://attack.mitre.org/techniques/T1090/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1090_003_ESXi_SSH_Forwarding_Or_Firewall_Config_Tampering {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of the ESXi SSH daemon configuration or a custom ESXi firewall ruleset definition. Adversaries make these file changes to enable TCP forwarding or open arbitrary outbound ports, turning a hypervisor into a hop in a multi-hop proxy chain. The rule pivots on the resulting configuration file artifact rather than on the command line that produced it."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1090.003"
    mitre_technique_name = "Proxy: Multi-hop Proxy"
    log_prerequisites = "Requires ESXi shell and file-integrity telemetry forwarded to Chronicle and normalised to FILE_MODIFICATION events with target.file.full_path populated (for example syslog forwarding plus a file-integrity or audit feed)."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorised hardening or baseline changes (host profiles, configuration-management or compliance remediation), vendor or third-party VIB installs that register firewall rulesets, administrators enabling SSH forwarding for approved troubleshooting, and ESXi patching or upgrades that rewrite sshd_config."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users, approved configuration-management or patching binaries to %global_allowed_admin_tools, and automation identities to %global_allowed_service_accounts. Correlate hits with change tickets and maintenance windows."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/etc\/(ssh\/sshd_config|vmware\/firewall\/[^\/]+\.xml)$/ nocase
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1090.003")
    $primary_entity = array_distinct(strings.coalesce($file.principal.hostname, $file.target.hostname))
    $modified_files = array_distinct($file.target.file.full_path)
    $acting_users = array_distinct($file.principal.user.userid)
    $acting_processes = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
