/*
  MITRE Technique : T1552.002 - Credentials in Registry
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:47:37.388815+00:00
  Reference       : https://attack.mitre.org/techniques/T1552/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1552_002_Unexpected_Parent_Registry_Credential_Query {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry-query tool or script interpreter (reg, cmd, PowerShell, script hosts) launched by a parent that should never be hunting the registry: an Office application, web server worker, database service, or print spooler. The child command line must also show registry querying or export combined with credential-hunting terms. This indicates credential harvesting from the registry, typically after exploitation or a malicious document."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1552.002"
    mitre_technique_name = "Unsecured Credentials: Credentials in Registry"
    log_prerequisites = "Requires Windows EDR or Sysmon process-creation telemetry (or Security Event 4688 with command-line auditing) populating parent and child process paths and the child command line."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate web or database applications that shell out to reg.exe for configuration checks; Office macros or add-ins in managed environments that read registry settings; installers or health-check scripts launched from a database service; vendor support tooling run under a service parent."
    tuning_guidance = "Add legitimate parent process paths to %global_allowed_script_hosts or %global_allowed_admin_tools. Add known service accounts that run approved scripts from these parents to %global_allowed_service_accounts. If a specific web or database application legitimately queries the registry, exclude its parent by executable name rather than install path."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"

    // Unexpected parent: Office, web server, database, print spooler
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|inetinfo|sqlservr|mysqld|postgres|oracle|spoolsv)\.exe$/ nocase

    // Child: registry tool or interpreter
    $proc.target.process.file.full_path = /\\(reg|cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$/ nocase

    // Registry query / export / read operation
    $proc.target.process.command_line = /(\breg(\.exe)?"?\s+(query|export|save)\b|get-itemproperty|get-itempropertyvalue|get-childitem|\bgci\b|\bgp\b)/ nocase

    // Credential-hunting indicators
    $proc.target.process.command_line = /(password|passwd|pwd|credential|secret|autoadminlogon|defaultpassword|winlogon|\s\/f\s)/ nocase

    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1552.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
