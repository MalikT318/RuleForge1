/*
  MITRE Technique : T1202 - Indirect Command Execution
  Tactic(s)       : Stealth
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:54:15.082041+00:00
  Reference       : https://attack.mitre.org/techniques/T1202
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1202_SSH_ProxyCommand_LocalCommand_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Windows OpenSSH client (ssh.exe) launched with the ProxyCommand, LocalCommand or PermitLocalCommand options set on the command line via -o. These options make ssh.exe run arbitrary local commands as a child process without invoking cmd.exe or PowerShell directly. Adversaries abuse this to sidestep controls that restrict command interpreters. Matching on the option combination, not on a payload, keeps the rule robust to renamed binaries and changed payloads. Rule written for Windows because the technique variant targets the Windows OpenSSH client; no non-Windows variant applies to this deliverable."
    mitre_tactic = "Stealth"
    mitre_technique = "T1202"
    mitre_technique_name = "Indirect Command Execution"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command-line capture (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing enabled)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developers and administrators who legitimately use ProxyCommand for SSH jump hosts or bastion access (for example ssh -o ProxyCommand to reach internal hosts), Git-for-Windows or IDE remote-development tooling that injects ProxyCommand, and automation or deployment scripts that tunnel through a proxy helper."
    tuning_guidance = "Add approved parent processes (IDE, deployment, or RMM tooling) to %global_allowed_admin_tools, approved script-host parents to %global_allowed_script_hosts, and named jump-host administrators to %global_allowed_admin_users. If ProxyCommand is common in a client estate, restrict the rule to LocalCommand/PermitLocalCommand or require an interpreter name inside the option value."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\ssh\.exe$/ nocase
    $proc.target.process.command_line = /(^|\s)-o\s*["']?\s*(ProxyCommand|LocalCommand|PermitLocalCommand)\s*[=\s]/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1202")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
