/*
  MITRE Technique : T1027.015 - Compression
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:02:10.072677+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_015_Linux_Staged_Archive_Then_Exec_From_Temp {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a compressed archive written to a world-writable staging directory (/tmp, /var/tmp, /dev/shm), followed within five minutes by a binary executing from one of those same directories on the same host. This pattern indicates a packed or compressed payload being dropped, unpacked and run. It is file-and-lineage based, not command-line based."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.015"
    mitre_technique_name = "Obfuscated Files or Information: Compression"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that produces both FILE_CREATION and PROCESS_LAUNCH events with populated principal.hostname, target.file.full_path and target.process.file.full_path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers and installers that unpack to /tmp and run helper binaries, CI/CD build agents, self-extracting software installers, developer build and test workflows, configuration management agents, and backup or deployment scripts staging in /tmp."
    tuning_guidance = "Add approved deployment, CI and configuration-management binaries to %global_allowed_admin_tools (archive writer) and trusted parent processes or build hosts to %global_allowed_script_hosts (executing parent). Extend the staging directory list or archive extensions per client if needed. Raise severity for hosts with no build or CI role."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+\.(zip|gz|tgz|bz2|xz|7z|rar|tar|zst)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+/
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1027.015")
    $primary_entity = array_distinct($hostname)
    $archive_paths = array_distinct($file.target.file.full_path)
    $executed_paths = array_distinct($proc.target.process.file.full_path)
    $archive_writers = array_distinct($file.principal.process.file.full_path)
    $exec_event_count = count($proc.metadata.id)

  condition:
    $file and $proc
}
