/*
  MITRE Technique : T1059.010 - AutoHotKey & AutoIT
  Tactic(s)       : Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:21:20.334094+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_010_AutoIt_AutoHotkey_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an AutoIt or AutoHotkey interpreter process making an outbound connection to a non-internal address. Legitimate automation scripts rarely initiate external network sessions. Adversaries use these interpreters to fetch second-stage payloads, run modular malware such as keyloggers, and beacon to C2 (as seen with DarkGate-style loaders). This is a network-side detection that complements process-creation rules."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.010"
    mitre_technique_name = "Command and Scripting Interpreter: AutoHotKey & AutoIT"
    log_prerequisites = "Requires endpoint network telemetry that populates the initiating process path (EDR network events or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate AutoIt or AutoHotkey automation that calls web services or licence servers, IT-authored deployment or login scripts that download files, and desktop macros that sync with SaaS applications."
    tuning_guidance = "Add approved automation hosts to %global_allowed_script_hosts and sanctioned interpreter or tooling paths to %global_allowed_admin_tools. Compiled scripts renamed to arbitrary executable names will not match the interpreter-name filter, so pair this rule with endpoint rules covering compiled AutoIt/AHK payloads."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(autoit3(_x64)?|autohotkey[a-z0-9_]*)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1059.010")
    $primary_entity = array_distinct($net.principal.hostname)
    $interpreter_path = array_distinct($net.principal.process.file.full_path)
    $process_command_line = array_distinct($net.principal.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
