/*
  MITRE Technique : T1564.006 - Run Virtual Instance
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:22:14.430294+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_006_ESXi_VM_Artifact_In_NonDatastore_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of virtual machine configuration or disk artifacts (.vmx, .vmdk, .vmsd, .nvram) in temporary, scratch or home-directory locations on an ESXi host instead of a datastore volume. Legitimate VMs live under the datastore mount (/vmfs/volumes/). Staging a VM outside it is consistent with an adversary registering a rogue virtual instance to run hidden workloads or tooling that host-level security tools cannot see into. This rule detects the resulting file artifact, not the command used to create it."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.006"
    mitre_technique_name = "Hide Artifacts: Run Virtual Instance"
    log_prerequisites = "ESXi host file-activity or audit telemetry that normalises to UDM FILE_CREATION with target.file.full_path populated (for example a host audit or file-integrity feed forwarded alongside hostd, vmkernel and shell logs)."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators importing or converting appliances and disks via a temporary staging directory; backup or restore jobs that rebuild VM files in scratch space; template deployment and migration tooling; support engineers collecting diagnostic bundles that contain VM config files."
    tuning_guidance = "Add approved staging or deployment accounts to %global_allowed_admin_users. Add restore and conversion tooling to %global_allowed_backup_processes or %global_allowed_admin_tools. Extend the path regex if the tenant legitimately stages VM files in other non-datastore locations."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|var\/run|root|scratch\/tmp|home\/[^\/]+)\/(.*\/)?[^\/]+\.(vmx|vmdk|vmsd|nvram)$/ nocase
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1564.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $created_file = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
