/*
  MITRE Technique : T1127.001 - MSBuild
  Tactic(s)       : Stealth, Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:37:59.146148+00:00
  Reference       : https://attack.mitre.org/techniques/T1127/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1127_001_MSBuild_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects MSBuild.exe making an outbound network connection to an external address. Malicious project files with inline C#/VB tasks commonly download payloads or beacon to C2 from inside the trusted MSBuild process. This detection is based on network telemetry, not process command lines, so it complements command-line rules for this technique. MSBuild is a Windows-only binary, so this rule targets Windows endpoints."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1127.001"
    mitre_technique_name = "Trusted Developer Utilities Proxy Execution: MSBuild"
    log_prerequisites = "Requires Windows endpoint network connection telemetry with the initiating process path populated (EDR network events or Sysmon Event ID 3)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Build servers and developer workstations restoring NuGet packages or fetching dependencies, CI/CD agents, Visual Studio builds that call external feeds, and software deployment pipelines."
    tuning_guidance = "Add build servers and CI agents to %global_allowed_script_hosts. Add known-good package feeds and vendor domains to %global_allowed_domains. Developer workstations that routinely build against external feeds may need to be added to the host list, or the rule can be scoped to non-developer asset groups."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\msbuild\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.hostname in %global_allowed_script_hosts
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1127.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
