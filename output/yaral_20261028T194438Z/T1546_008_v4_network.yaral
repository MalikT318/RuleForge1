/*
  MITRE Technique : T1546.008 - Accessibility Features
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:10:53.189503+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_008_Accessibility_Binary_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows accessibility feature binary (sticky keys, Utilman, On-Screen Keyboard, Narrator, Magnifier and similar) making an outbound network connection to a non-internal address. These binaries are local UI helpers that do not initiate external connections. Outbound traffic from them indicates the binary was replaced or hijacked (for example via an IFEO Debugger value or a binary swap) to run a backdoor or reverse shell reachable from the logon screen."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.008"
    mitre_technique_name = "Event Triggered Execution: Accessibility Features"
    log_prerequisites = "Requires endpoint network telemetry that populates the initiating process path (EDR network events or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Rare. Possible sources: security or EDR agents that inject into or proxy traffic through accessibility processes, accessibility or assistive-technology software that checks for updates or licensing, and Windows telemetry or Store components when Narrator or Magnifier is used with online features."
    tuning_guidance = "Add approved assistive-technology or security agent process paths to %global_allowed_security_tools or %global_allowed_admin_tools. Add known egress or management hosts to %global_allowed_remote_mgmt where the process is expected to carry remote-support sessions. Pair this alert with endpoint registry and file-modification detections for the same host to confirm tampering."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(sethc|utilman|osk|narrator|magnify|displayswitch|atbroker)\.exe$/ nocase
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1546.008")
    $primary_entity = array_distinct($net.principal.hostname)
    $accessibility_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $acting_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
