/*
  MITRE Technique : T1027.013 - Encrypted/Encoded File
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:58:51.383708+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_013_Linux_Encoded_File_Staged_Then_Executed_From_Temp {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an encoded or encrypted file (base64, encrypted-blob or cipher-style extension) written to a world-writable staging directory (/tmp, /var/tmp, /dev/shm), followed within 5 minutes on the same host by a shell or interpreter launching a binary or script from one of those directories. This pattern is consistent with a payload staged in obfuscated form and then decoded and run. It uses file-creation telemetry plus execution-location lineage rather than command-line matching."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.013"
    mitre_technique_name = "Obfuscated Files or Information: Encrypted/Encoded File"
    log_prerequisites = "Requires Linux EDR or auditd telemetry providing both FILE_CREATION events with file paths and PROCESS_LAUNCH events with parent and child process paths, with consistent principal.hostname."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup and archive tools writing encrypted blobs to /tmp; package installers or build systems that stage encrypted artifacts and run helper scripts from /tmp; CI runners; admin scripts decrypting secrets in /dev/shm; software self-extractors."
    tuning_guidance = "Add approved backup or encryption tooling paths to %global_allowed_backup_processes and approved deployment and automation tooling to %global_allowed_admin_tools. Add trusted CI or script-host parent processes to %global_allowed_script_hosts. Narrow or extend the extension list in the file creation regex per environment."

  events:
    $enc.metadata.event_type = "FILE_CREATION"
    $enc.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+\.(b64|base64|enc|aes|crypt|crypted|xor|rc4|encrypted)$/ nocase
    not $enc.principal.process.file.full_path in %global_allowed_backup_processes
    not $enc.principal.process.file.full_path in %global_allowed_admin_tools
    $enc.principal.hostname = $hostname

    $exec.metadata.event_type = "PROCESS_LAUNCH"
    $exec.target.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+/ nocase
    $exec.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|python[0-9.]*|perl|ruby)$/ nocase
    not $exec.principal.process.file.full_path in %global_allowed_script_hosts
    not $exec.principal.process.file.full_path in %global_allowed_admin_tools
    $exec.principal.hostname = $hostname

    $enc.metadata.event_timestamp.seconds <= $exec.metadata.event_timestamp.seconds

  match:
    $hostname over 5m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1027.013")
    $primary_entity = array_distinct($hostname)
    $encoded_files = array_distinct($enc.target.file.full_path)
    $writer_processes = array_distinct($enc.principal.process.file.full_path)
    $executed_from_temp = array_distinct($exec.target.process.file.full_path)
    $launcher_processes = array_distinct($exec.principal.process.file.full_path)

  condition:
    $enc and $exec
}
