/*
  MITRE Technique : T1547 - Boot or Logon Autostart Execution
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Network Devices
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:22:03.550967+00:00
  Reference       : https://attack.mitre.org/techniques/T1547
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_NetDevice_Outbound_Boot_Config_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a network device initiating an outbound TFTP or FTP connection to an external address. These cleartext file-transfer protocols are the usual way to pull a replacement startup configuration or boot image onto a router or switch. An adversary can use that to make the device run attacker-controlled code or config at boot, which is boot autostart persistence on network devices."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547"
    mitre_technique_name = "Boot or Logon Autostart Execution"
    log_prerequisites = "Requires network device connection or flow records normalised to NETWORK_CONNECTION with principal.hostname, target.ip and target.port populated. Device management-plane originated traffic must be logged, for example via control-plane logging or flow export."
    platform = "Network Devices"
    log_source = "macos_endpoint"
    false_positives = "Authorised firmware or configuration upgrades fetched from vendor or managed-service file servers, zero-touch provisioning, scheduled configuration backups pushed to an external FTP/TFTP server, lab or staging devices."
    tuning_guidance = "Add known-good vendor or update domains to %global_allowed_domains. Add approved external provisioning or backup server addresses to %global_allowed_mgmt_sources. Add managed-service automation accounts to %global_allowed_service_accounts if user context is present. Extend the port list if a client uses other file-transfer protocols for device image delivery."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 69 or $net.target.port = 21)
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1547")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
