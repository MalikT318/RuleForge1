/*
  MITRE Technique : T1556.008 - Network Provider DLL
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:25:15.341381+00:00
  Reference       : https://attack.mitre.org/techniques/T1556/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_008_Network_Provider_Registry_Registration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry changes that register a network provider DLL (the ProviderPath value under a service's NetworkProvider key) or alter the network provider load order (ProviderOrder). Adversaries use this to load a malicious credential manager DLL that receives cleartext credentials from mpnotify.exe at logon (NPPSPY-style). Detection is based on the registry state change, not on command lines, so it still fires when the change is made through APIs, scripts, or renamed tools."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556.008"
    mitre_technique_name = "Modify Authentication Process: Network Provider DLL"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon Event IDs 12/13/14) covering HKLM\\SYSTEM\\CurrentControlSet\\Services and HKLM\\SYSTEM\\CurrentControlSet\\Control\\NetworkProvider. Registry value data should be populated for best precision."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Installation or upgrade of legitimate network provider software (VPN and SSO clients, Citrix or VMware/VirtualBox shared-folder providers, WSL/Plan 9 provider, remote file system clients), Windows servicing, and software deployment tools."
    tuning_guidance = "Add approved installer and deployment executables to %global_allowed_admin_tools and endpoint security agents to %global_allowed_security_tools. Review the value data outcome and confirm the DLL is signed and located in a protected path. Use the default-provider DLL exclusion in the rule as a template for approved vendor providers."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(CurrentControlSet|ControlSet\d+)\\(Services\\[^\\]+\\NetworkProvider|Control\\NetworkProvider\\Order)$/ nocase
    $reg.target.registry.registry_value_name = /^(ProviderPath|ProviderOrder)$/ nocase
    not $reg.target.registry.registry_value_data = /^(%SystemRoot%|C:\\Windows)\\System32\\(ntlanman|davclnt|rdpnp)\.dll$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1556.008")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $registry_value_data = array_distinct($reg.target.registry.registry_value_data)
    $writing_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
