/*
  MITRE Technique : T1563.002 - RDP Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:10:01.887988+00:00
  Reference       : https://attack.mitre.org/techniques/T1563/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_002_RDP_Session_Hijack_Tscon {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects RDP session hijacking, where the built-in Terminal Services console utility (tscon) is launched with a target session ID or a /dest: session redirect. Run as SYSTEM, this lets an adversary take over another user's active or disconnected RDP session without credentials or a user prompt. The command line is matched, not only the binary path, so it also catches tscon wrapped in cmd.exe or a service binPath (the common sc create / net start hijack pattern). A renamed binary is still caught by the /dest:rdp-tcp#N redirect pattern."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1563.002"
    mitre_technique_name = "Remote Service Session Hijacking: RDP Hijacking"
    log_prerequisites = "Requires EDR or Sysmon process-creation telemetry (or Windows Security Event 4688 with command-line auditing enabled) normalised to PROCESS_LAUNCH with target.process.command_line populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Helpdesk or administrators using tscon to reconnect or switch disconnected sessions on terminal servers or VDI hosts; RMM or session-management tooling that wraps tscon; lab and training environments."
    tuning_guidance = "Add approved session-management or RMM parent processes to %global_allowed_admin_tools and named administrators to %global_allowed_admin_users. Tscon use is rare on workstations, so consider raising severity for non-server hosts. Review the service-creation events (sc create / binPath) on the same host around the alert time."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $proc.target.process.command_line = /\btscon(\.exe)?"?\s+\d+/ nocase or
      $proc.target.process.command_line = /\/dest:\s*(rdp-tcp#\d+|console)/ nocase
    )
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1563.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $acting_user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
