/*
  MITRE Technique : T1027.002 - Software Packing
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 5m
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:39:47.567304+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_002_Linux_SelfExtracting_Dropper_Executes_Payload {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A binary running from a world-writable staging directory (/tmp, /var/tmp, /dev/shm) writes a new file into a staging directory, and that same file is then executed within five minutes. This is the runtime behaviour of a packed or self-extracting loader that unpacks its real payload to disk and runs it. It does not depend on command-line strings, packer names, or hashes."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.002"
    mitre_technique_name = "Obfuscated Files or Information: Software Packing"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that populates FILE_CREATION (with the writing process) and PROCESS_LAUNCH (with the executed image path)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Self-extracting installers and vendor setup stubs run from /tmp, language runtime or build tooling that unpacks helper binaries to /tmp (CI runners, Go/Java/Python bundlers), AppImage or makeself archives, and software deployment agents that stage and run payloads."
    tuning_guidance = "Add approved deployment, build or installer binaries to %global_allowed_admin_tools (matched against the writing process path). Add approved parent processes or hosts, such as CI runners, to %global_allowed_script_hosts (matched against the launching parent path). For noisy build servers, scope exclusions to those hosts by adding their launcher to the lists rather than loosening the path filters."

  events:
    $drop.metadata.event_type = "FILE_CREATION"
    $drop.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\// 
    $drop.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\//
    $drop.principal.process.file.full_path != $drop.target.file.full_path
    not $drop.principal.process.file.full_path in %global_allowed_admin_tools
    $drop.principal.hostname = $hostname
    $drop.target.file.full_path = $payload_path

    $exec.metadata.event_type = "PROCESS_LAUNCH"
    $exec.target.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\//
    not $exec.principal.process.file.full_path in %global_allowed_script_hosts
    not $exec.principal.process.file.full_path in %global_allowed_admin_tools
    $exec.principal.hostname = $hostname
    $exec.target.process.file.full_path = $payload_path

    $drop.metadata.event_timestamp.seconds <= $exec.metadata.event_timestamp.seconds

  match:
    $hostname, $payload_path over 5m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1027.002")
    $primary_entity = array_distinct($hostname)
    $dropper_paths = array_distinct($drop.principal.process.file.full_path)
    $payload_paths = array_distinct($exec.target.process.file.full_path)
    $payload_command_lines = array_distinct($exec.target.process.command_line)
    $users = array_distinct($exec.principal.user.userid)

  condition:
    $drop and $exec
}
