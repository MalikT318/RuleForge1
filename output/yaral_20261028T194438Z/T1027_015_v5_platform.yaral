/*
  MITRE Technique : T1027.015 - Compression
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:03:04.204771+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_015_Script_Host_Creates_Archive_In_Staging_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a script interpreter or proxy-execution LOLBin writing a compressed archive (zip, 7z, rar, cab, gz and similar) into a world-writable staging location such as Temp, ProgramData, Public or PerfLogs. This uses FILE_CREATION telemetry rather than command-line matching. It complements process-creation rules by catching in-process compression (for example .NET System.IO.Compression from PowerShell, or COM-based zipping from WSH) that never launches an archiver binary. Variant note: the platform is fixed to Windows for this tenant, so the alternate-platform angle was not applied and a file-event pivot was used instead."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.015"
    mitre_technique_name = "Obfuscated Files or Information: Compression"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry (Sysmon Event ID 11 or equivalent) with the creating process path populated in UDM."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrative PowerShell scripts that package logs or diagnostics, software packaging and deployment scripts, support tooling that bundles troubleshooting data, and backup or export jobs run through scripts."
    tuning_guidance = "Add approved script-running parent or interpreter paths to %global_allowed_script_hosts, deployment and patching tooling to %global_allowed_admin_tools, and backup software to %global_allowed_backup_processes. If noise persists, narrow the staging path regex or require an additional correlation with outbound network activity."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32)\.exe$/ nocase
    $file.target.file.full_path = /\.(zip|7z|rar|cab|gz|tgz|bz2|xz)$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\appdata\\local\\temp|users\\public|programdata|windows\\temp|perflogs)\\/ nocase
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1027.015")
    $primary_entity = array_distinct($file.principal.hostname)
    $archive_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
