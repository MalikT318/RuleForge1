/*
  MITRE Technique : T1055.011 - Extra Window Memory Injection
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:57:54.110398+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_011_EWM_Injection_Host_Lineage_Anomaly {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects process lineage anomalies consistent with execution gained inside a host process, such as through Extra Window Memory injection. Two patterns are covered. (1) A document, web server, print spooler or database process spawns a shell or script interpreter. (2) The Windows shell (explorer.exe), the classic EWM injection target through its Shell_TrayWnd window class, spawns a proxy-execution or build LOLBin. EWM injection leaves no direct telemetry, so this rule detects the post-injection child process rather than the injection call."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.011"
    mitre_technique_name = "Process Injection: Extra Window Memory Injection"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with parent process path populated (EDR or Sysmon Event ID 1, or Security Event 4688 with parent process logging)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros or add-ins used by line-of-business workflows, IIS or Tomcat applications that legitimately shell out, SQL Server agent jobs running cmd (xp_cmdshell), print drivers or print management scripts, and users manually running build or registration tools from the shell (developers using msbuild, installers calling regsvr32)."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts, approved deployment tooling to %global_allowed_admin_tools, and service accounts that run scheduled SQL or web jobs to %global_allowed_service_accounts. For developer-heavy tenants, narrow the explorer.exe branch by removing msbuild from the child list."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|spoolsv|w3wp|sqlservr|httpd|nginx|tomcat[0-9]*)\.exe$/ nocase and
        $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32)\.exe$/ nocase
      )
      or
      (
        $proc.principal.process.file.full_path = /\\explorer\.exe$/ nocase and
        $proc.target.process.file.full_path = /\\(mshta|regsvr32|installutil|regasm|regsvcs|msbuild)\.exe$/ nocase
      )
    )
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.011")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
