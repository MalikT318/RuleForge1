/*
  MITRE Technique : T1556 - Modify Authentication Process
  Tactic(s)       : Defense Impairment, Persistence, Credential Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:12:45.004710+00:00
  Reference       : https://attack.mitre.org/techniques/T1556
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1556_Network_Device_Auth_Config_Setting_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a configuration change on a network device that alters its authentication path: AAA method lists, RADIUS/TACACS/LDAP server definitions, local authentication fallback, or enable/privileged credentials. Attackers who tamper with device authentication to bypass controls or persist leave this management-plane state change even when command-line logging is evaded. The change is detected at the SETTING_MODIFICATION layer, not at process or command-line level."
    mitre_tactic = "Defense Impairment, Persistence, Credential Access"
    mitre_technique = "T1556"
    mitre_technique_name = "Modify Authentication Process"
    log_prerequisites = "Network device management-plane or configuration-audit logs normalised to UDM SETTING_MODIFICATION, with the changed setting or config line populated in target.resource.name or metadata.description. Config-change logging (archive/commit/audit) must be enabled on the device."
    platform = "Network Devices"
    log_source = "cloud_audit"
    false_positives = "Planned AAA migrations, RADIUS/TACACS server rotation, certificate or shared-secret rotation, network automation and config-management pipelines, initial device provisioning, and break-glass local account updates during an approved change window."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users, automation and orchestration accounts to %global_allowed_service_accounts, and jump hosts or management subnets to %global_allowed_mgmt_sources. Suppress during change windows at the SOAR layer. Narrow the regex if the client's devices emit very verbose config-audit text."

  events:
    $set.metadata.event_type = "SETTING_MODIFICATION"
    (
      $set.target.resource.name = /\b(aaa\s+(authentication|authorization|accounting)|aaa[-_ ]?(method|group|server)|tacacs|radius|ldap[-_ ]?server|auth(entication)?[-_ ](method|order|server|provider|profile)|login\s+(local|authentication)|local[-_ ]?auth(entication)?|enable\s+(secret|password)|auth[-_ ]?fallback|pam[-_ ]?(module|config))\b/ nocase or
      $set.metadata.description = /\b(aaa\s+(authentication|authorization|accounting)|aaa[-_ ]?(method|group|server)|tacacs|radius|ldap[-_ ]?server|auth(entication)?[-_ ](method|order|server|provider|profile)|login\s+(local|authentication)|local[-_ ]?auth(entication)?|enable\s+(secret|password)|auth[-_ ]?fallback|pam[-_ ]?(module|config))\b/ nocase
    )
    not $set.principal.user.userid in %global_allowed_admin_users
    not $set.principal.user.userid in %global_allowed_service_accounts
    not $set.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1556")
    $primary_entity = array_distinct(strings.coalesce($set.target.hostname, $set.principal.hostname))
    $changed_by = array_distinct($set.principal.user.userid)
    $source_ips = array_distinct($set.principal.ip)
    $changed_setting = array_distinct($set.target.resource.name)

  condition:
    $set
}
