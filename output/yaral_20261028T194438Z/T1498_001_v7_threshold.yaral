/*
  MITRE Technique : T1498.001 - Direct Network Flood
  Tactic(s)       : Impact
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:11:44.602341+00:00
  Reference       : https://attack.mitre.org/techniques/T1498/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_001_Inbound_Connection_Flood_Windows_Service_Ports {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single external source generates a very high volume of connections to one internal host on commonly exposed Windows service ports within ten minutes. Each connection is benign on its own, but the volume indicates a direct network flood (DoS) against the Windows service."
    mitre_tactic = "Impact"
    mitre_technique = "T1498.001"
    mitre_technique_name = "Network Denial of Service: Direct Network Flood"
    log_prerequisites = "Requires perimeter firewall or proxy connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs must record permitted and denied connections to be effective."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners or load tests, misconfigured clients retrying aggressively, backup or replication jobs, busy NAT gateways or proxies that aggregate many users behind one source IP, and legitimate remote access gateways."
    tuning_guidance = "Add scanners and load-test sources to %global_allowed_scanners and approved management or NAT addresses to %global_allowed_mgmt_sources. Raise or lower the #net threshold per client based on baseline connection rates, and widen the port set if clients expose other Windows services."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src
    $net.target.ip = $dst
    (
      $net.target.port = 445 or
      $net.target.port = 139 or
      $net.target.port = 135 or
      $net.target.port = 3389 or
      $net.target.port = 5985 or
      $net.target.port = 5986 or
      $net.target.port = 80 or
      $net.target.port = 443
    )
    not $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src, $dst over 10m

  outcome:
    $event_count = count($net.metadata.id)
    $risk_score = max(if($event_count >= 20000, 90, if($event_count >= 8000, 75, 60)))
    $mitre_technique_id = array_distinct("T1498.001")
    $primary_entity = array_distinct($dst)
    $source_ips = array_distinct($src)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    #net >= 2000
}
