/*
  MITRE Technique : T1176.002 - IDE Extensions
  Tactic(s)       : Persistence
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:29:47.916330+00:00
  Reference       : https://attack.mitre.org/techniques/T1176/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_002_Linux_IDE_Extension_Sideload_By_NonIDE_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an IDE extension manifest (package.json) written into a per-user VS Code-family extensions directory on Linux by a shell, downloader, archiver or scripting interpreter rather than by the IDE's own installer. This pattern indicates side-loading of an extension for persistence, since the extension runs every time the IDE or its remote server starts. The rule matches the behaviour of dropping an extension by hand, not any specific extension or marketplace identity."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176.002"
    mitre_technique_name = "Software Extensions: IDE Extensions"
    log_prerequisites = "Requires Linux EDR or auditd file-write telemetry (FILE_CREATION) with the writing process path populated in principal.process.file.full_path. Home directories and remote-IDE server directories must be covered by file monitoring."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developer environment provisioning (Ansible, cloud-init, dotfile or bootstrap scripts), devcontainer or remote-development setup that unpacks extensions via shell or tar, CI images pre-baking IDE extensions, and developers manually unpacking a .vsix archive with unzip."
    tuning_guidance = "Add approved provisioning and configuration-management binaries to %global_allowed_admin_tools. Add automation accounts that bake developer images to %global_allowed_service_accounts. Raise severity on servers or hosts that have no developer role, where any IDE extension write is unexpected."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(home\/[^\/]+|root)\/\.(vscode|vscode-server|vscode-server-insiders|vscode-insiders|vscode-oss|cursor|cursor-server)\/extensions\/[^\/]+\/package\.json$/ nocase
    $file.principal.process.file.full_path = /\/(bash|sh|dash|zsh|curl|wget|unzip|tar|python[0-9.]*|perl|ruby|cp|mv|git)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1176.002")
    $primary_entity = array_distinct($file.principal.hostname)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $writing_command_line = array_distinct($file.principal.process.command_line)
    $extension_manifest = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
