/*
  MITRE Technique : T1027.004 - Compile After Delivery
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:43:37.003560+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_004_Source_Code_Download_Via_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a successful HTTP download of an uncompiled source code or build project file (C#, VB, IL, C/C++, MSBuild project) from an external destination. Adversaries deliver payloads as text-based source and compile them on the victim with native tools such as csc.exe, ilasm.exe, MSBuild or MinGW. This rule observes the delivery from the network side and does not rely on endpoint process telemetry."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.004"
    mitre_technique_name = "Obfuscated Files or Information: Compile After Delivery"
    log_prerequisites = "Requires proxy or firewall logs with HTTP URL visibility (TLS inspection or explicit proxy) normalised to NETWORK_HTTP, with target.url populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Developers and build servers pulling source from public repositories or vendor SDK sites, package restore operations, security researchers, and internal CI/CD systems fetching from external mirrors."
    tuning_guidance = "Add known-good code hosting and vendor domains to %global_allowed_domains. Add developer workstations and build hosts to %global_allowed_script_hosts. Review principal.ip of hits for non-developer endpoints. Corroborate against endpoint compiler launches (csc, vbc, ilasm, msbuild) on the same host."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "GET"
    $net.network.http.response_code = 200
    $net.target.url = /\/[^\/?#]+\.(cs|vb|il|cpp|c|csproj|vbproj|proj)(\?.*)?$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1027.004")
    $primary_entity = array_distinct($net.principal.ip)
    $source_hosts = array_distinct($net.principal.hostname)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $downloaded_urls = array_distinct($net.target.url)

  condition:
    $net
}
