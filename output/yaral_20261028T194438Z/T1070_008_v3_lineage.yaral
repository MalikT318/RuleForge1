/*
  MITRE Technique : T1070.008 - Clear Mailbox Data
  Tactic(s)       : Stealth
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:10:54.042887+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_008_Linux_Service_Parent_Spawns_Mail_Manipulation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server, or database service process spawning a mail management utility, or a shell that operates on local mail spool or mailbox storage. Service processes do not normally delete or manipulate mailbox data, so this lineage suggests post-exploitation cleanup of mail evidence."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.008"
    mitre_technique_name = "Indicator Removal: Clear Mailbox Data"
    log_prerequisites = "Requires Linux EDR or auditd execve telemetry normalised to PROCESS_LAUNCH with populated parent (principal.process) and child (target.process) executable paths and the child command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Web applications or CMS plugins that legitimately call mail/mailx for notifications, webmail or ticketing platforms that manage Maildir content, database maintenance jobs that call mail utilities for alerting, and Java-based mail archiving software."
    tuning_guidance = "Add approved parent processes to %global_allowed_script_hosts and approved mail or admin tooling to %global_allowed_admin_tools. If a mail-sending web application is common, restrict the child match to the destructive utilities and shell/spool branch only. Extend the parent regex with in-house service binaries as needed."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(apache2|httpd|nginx|lighttpd|php-fpm[0-9.]*|php-cgi|php[0-9.]*|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server|sshd-session-web)$/ nocase
    (
      $proc.target.process.file.full_path = /\/(mail|mailx|s-nail|mutt|neomutt|formail|doveadm|postsuper|maildirmake|fetchmail)$/ nocase
      or
      (
        $proc.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|ash)$/ nocase
        and $proc.target.process.command_line = /(\/var\/(spool\/)?mail\/|\/var\/spool\/postfix|\/var\/vmail|maildir|\.mbox|\/home\/[^\/ ]+\/mail\/)/ nocase
      )
    )
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1070.008")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
