/*
  MITRE Technique : T1574.014 - AppDomainManager
  Tactic(s)       : Stealth, Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:47:20.469408+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_014_AppDomainManager_Unexpected_Parent_DotNet_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a .NET Framework-hosted executable (a common AppDomainManager injection or assembly-hosting target) launched by a parent that should not start it: an Office application, web server worker, print spooler or database service. The rule pivots on process lineage rather than command-line content. Code execution from such parents through a managed host is consistent with AppDomainManager hijacking, where a malicious assembly is loaded into a trusted .NET process via config files or environment variables."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.014"
    mitre_technique_name = "Hijack Execution Flow: AppDomainManager"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with populated parent and child process image paths (EDR, Sysmon Event ID 1, or Security Event 4688 with parent process)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Web applications that legitimately invoke MSBuild or other .NET build tools from the web server worker; database jobs (for example SQL Server agent or CLR tasks) calling .NET utilities; Office add-ins or VSTO installers using regasm or regsvcs during registration; software deployment through installutil from a spooler or database host."
    tuning_guidance = "Add approved parent binaries to %global_allowed_admin_tools or %global_allowed_script_hosts. Add known automation accounts to %global_allowed_service_accounts. If a customer runs build or CI workloads under a web server or database parent, add that parent path to the allowlist rather than editing the child list. If a customer's .NET Framework is installed in a non-default location, adjust the path regex."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    // Unexpected parent: Office, web server, print spooler, database service
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|w3wp|httpd|nginx|tomcat[0-9]*|php-cgi|spoolsv|sqlservr|mysqld|postgres|oracle)\.exe$/ nocase
    // Child: .NET Framework-hosted binary that can load an arbitrary assembly
    $proc.target.process.file.full_path = /\\Microsoft\.NET\\Framework(64)?\\v[0-9.]+\\(msbuild|installutil|regasm|regsvcs|ieexec|aspnet_compiler)\.exe$/ nocase
    $proc.principal.hostname != ""
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1574.014")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
