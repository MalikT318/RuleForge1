/*
  MITRE Technique : T1547.010 - Port Monitors
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:37:20.979276+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_010_Spooler_Spawns_Shell_Or_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects the Windows print spooler service (spoolsv.exe) spawning a command shell, script interpreter or proxy-execution LOLBin. A malicious port monitor DLL (registered via AddMonitor or the Driver value under HKLM\\SYSTEM\\CurrentControlSet\\Control\\Print\\Monitors) is loaded into spoolsv.exe as SYSTEM. Child processes launched from the spooler are a strong indicator of that DLL executing code. The rule keys on process lineage rather than command-line content."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.010"
    mitre_technique_name = "Boot or Logon Autostart Execution: Port Monitors"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with populated parent process path (EDR, Sysmon Event ID 1, or Security Event 4688 with parent process logging)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy print-management or driver-installation scripts that run from the spooler, third-party print-server and rights-management software, vendor printer driver or port monitor installers, and print-job post-processing scripts on print servers."
    tuning_guidance = "Add known print servers with legitimate spooler-launched scripts to %global_allowed_script_hosts. Add approved vendor print tooling binaries to %global_allowed_admin_tools. Where the alert fires, check the Print\\Monitors registry subkeys for unfamiliar Driver values, and review recently written DLLs in the System32 directory."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\spoolsv\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|wmic|bitsadmin|certutil|msbuild|installutil|powershell_ise)\.exe$/ nocase
    not $proc.principal.hostname in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1547.010")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
