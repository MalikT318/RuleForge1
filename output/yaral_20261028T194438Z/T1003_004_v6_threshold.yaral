/*
  MITRE Technique : T1003.004 - LSA Secrets
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:44:01.135010+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_004_LSA_Secrets_Registry_Tampering_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects multiple registry modification events against the LSA secrets store (HKLM\\SECURITY\\Policy\\Secrets) on a single host within ten minutes, made by a process other than the LSA and service-control components. A single write can be benign, but repeated writes to the secrets store from an unexpected process indicate LSA secret tampering or extraction activity, typically following SYSTEM-level access."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.004"
    mitre_technique_name = "OS Credential Dumping: LSA Secrets"
    log_prerequisites = "Requires Windows endpoint registry telemetry that covers the SECURITY hive (for example Sysmon Event IDs 12/13/14 or EDR registry events) normalized to UDM REGISTRY_MODIFICATION with target.registry.registry_key populated. Telemetry that does not cover the SECURITY hive will not trigger this rule."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Security or endpoint protection agents that touch LSA policy keys, IT management and password-rotation tooling that updates service account secrets, domain join or unjoin operations, and software installers that register services running under a named account."
    tuning_guidance = "Add approved agents to %global_allowed_security_tools and approved management or deployment tools to %global_allowed_admin_tools. Raise the #reg threshold on hosts with frequent legitimate service credential changes. If the EDR logs the SECURITY hive with a different path prefix, extend the registry key regex accordingly."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /(HKLM|HKEY_LOCAL_MACHINE|\\REGISTRY\\MACHINE)\\SECURITY\\Policy\\Secrets/ nocase
    not $reg.principal.process.file.full_path = /\\(lsass|services|wininit)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    $reg.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(80)
    $event_count = count($reg.metadata.id)
    $mitre_technique_id = array_distinct("T1003.004")
    $primary_entity = array_distinct($host)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $acting_processes = array_distinct($reg.principal.process.file.full_path)
    $acting_users = array_distinct($reg.principal.user.userid)

  condition:
    #reg >= 3
}
