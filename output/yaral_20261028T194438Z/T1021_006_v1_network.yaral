/*
  MITRE Technique : T1021.006 - Windows Remote Management
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:43:04.684297+00:00
  Reference       : https://attack.mitre.org/techniques/T1021/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1021_006_WinRM_Port_Crossing_Perimeter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects WinRM traffic (TCP 5985 HTTP / 5986 HTTPS) crossing the network perimeter, where either the source or the destination is outside internal address space. WinRM is rarely exposed to or initiated toward the internet. Such a connection suggests an adversary using valid accounts for remote command execution or lateral movement, or an internet-exposed WinRM listener being abused."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1021.006"
    mitre_technique_name = "Remote Services: Windows Remote Management"
    log_prerequisites = "Requires firewall, proxy, or perimeter NETWORK_CONNECTION telemetry with populated principal.ip, target.ip, and target.port. Traffic must be logged at the perimeter or on the segment boundary."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Approved MSP or vendor remote administration over WinRM, cloud-hosted Windows management (for example automation or hybrid-join tooling), pen-test or vulnerability scanners probing 5985/5986, and branch-to-datacentre management traffic where the branch uses non-RFC1918 space."
    tuning_guidance = "Add approved management source or destination addresses to %global_allowed_mgmt_sources. Add scanner addresses to the same list or a scanner-specific exclusion. Raise severity or add a volume threshold variant if inbound internet-sourced WinRM is expected to be blocked at the firewall."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 5985 or $net.target.port = 5986)
    (not $net.target.ip in %rfc1918_internal or not $net.principal.ip in %rfc1918_internal)
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1021.006")
    $primary_entity = array_distinct($net.principal.ip)
    $source_ips = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
