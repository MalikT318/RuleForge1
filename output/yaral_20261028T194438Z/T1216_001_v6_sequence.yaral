/*
  MITRE Technique : T1216.001 - PubPrn
  Tactic(s)       : Stealth
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:35:18.102330+00:00
  Reference       : https://attack.mitre.org/techniques/T1216/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1216_001_PubPrn_Script_Moniker_Then_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects PubPrn.vbs proxy execution: cscript/wscript runs pubprn with a remote script: moniker (http/https/UNC), followed within 10 minutes by an external network connection from the same script host on the same machine. The sequence indicates a remote scriptlet was fetched and executed through a signed Microsoft script."
    mitre_tactic = "Stealth"
    mitre_technique = "T1216.001"
    mitre_technique_name = "System Script Proxy Execution: PubPrn"
    log_prerequisites = "Requires Windows endpoint process-launch telemetry with full command lines (EDR, Sysmon Event ID 1 or Security 4688 with command-line auditing) and network connection telemetry with process attribution (e.g. Sysmon Event ID 3 or EDR equivalent)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate printer publishing to Active Directory via pubprn.vbs normally uses an LDAP:// target rather than a script: moniker, so FPs are rare. Possible sources: IT admin scripts or print-management tooling that wrap cscript/wscript and fetch external content, and security testing or red-team exercises."
    tuning_guidance = "Add approved admin or deployment tooling parent processes to %global_allowed_admin_tools. Add approved script-hosting parent processes to %global_allowed_script_hosts. If the network event does not carry process attribution in a given environment, the correlation will not fire, so validate NETWORK_CONNECTION process fields during onboarding."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(cscript|wscript)\.exe$/ nocase
    $proc.target.process.command_line = /pubprn(\.vbs)?["']?\s/ nocase
    $proc.target.process.command_line = /script:\s*["']?(https?:|\\\\)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    $proc.principal.hostname = $hostname

    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(cscript|wscript)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    $net.principal.hostname = $hostname

    $proc.metadata.event_timestamp.seconds <= $net.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(90)
    $mitre_technique_id = array_distinct("T1216.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $pubprn_command_lines = array_distinct($proc.target.process.command_line)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $executing_users = array_distinct($proc.principal.user.userid)

  condition:
    $proc and $net
}
