/*
  MITRE Technique : T1078.001 - Default Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:28:51.323263+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_001_K8s_Default_ServiceAccount_RBAC_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an RBAC or permission change performed by the built-in 'default' service account of a container-orchestration namespace. The default account normally holds no meaningful API permissions, so a successful permission change made under its identity suggests a stolen pod token, an over-privileged default binding, or privilege escalation from a compromised workload. Detection is at the control-plane configuration-change layer, not at command-line or process telemetry."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.001"
    mitre_technique_name = "Valid Accounts: Default Accounts"
    log_prerequisites = "Requires Kubernetes/container control-plane audit logs ingested and normalised to UDM, with the authenticated identity populated in principal.user.userid (format system:serviceaccount:<namespace>:default) and RBAC changes mapped to RESOURCE_PERMISSIONS_CHANGE."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Legacy or poorly designed operators and Helm charts that run with the namespace default service account and manage their own RBAC; CI/CD controllers or GitOps tooling not yet migrated to a dedicated service account; lab and development clusters."
    tuning_guidance = "Add approved automation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals. Longer term, migrate those workloads to dedicated service accounts rather than widening the allowlist. Consider raising severity to Critical for production clusters."

  events:
    $rbac.metadata.event_type = "RESOURCE_PERMISSIONS_CHANGE"
    $rbac.principal.user.userid = /^system:serviceaccount:[^:]+:default$/ nocase
    not $rbac.principal.user.userid in %global_allowed_service_accounts
    not $rbac.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1078.001")
    $primary_entity = array_distinct($rbac.principal.user.userid)
    $changed_resources = array_distinct($rbac.target.resource.name)
    $source_ips = array_distinct($rbac.principal.ip)

  condition:
    $rbac
}
