/*
  MITRE Technique : T1547.005 - Security Support Provider
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:31:22.085994+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_005_LSA_Security_Packages_Registry_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a modification to the LSA 'Security Packages' registry value (Lsa or Lsa\\OSConfig), which registers a Security Support Provider DLL to be loaded into LSASS at boot or by AddSecurityPackage. This is a registry-telemetry rule, not command-line matching, so it also catches API-driven changes (for example a custom binary, in-memory PowerShell or a COM/WMI call) that never expose 'Security Packages' on a command line. SSP persistence is Windows-only, so no Linux, macOS or cloud equivalent exists and this rule targets Windows."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.005"
    mitre_technique_name = "Boot or Logon Autostart Execution: Security Support Provider"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR registry events or Sysmon Event ID 12/13) covering HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa. Registry value-level auditing must be enabled for the Lsa key."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows servicing and OS upgrades, legitimate installers of smart card, SSO or credential-provider software that registers an SSP, and approved endpoint security or IAM agents that register a security package."
    tuning_guidance = "Add approved installer or agent executable paths to %global_allowed_admin_tools or %global_allowed_security_tools. Add known-good deployment accounts to %global_allowed_service_accounts. Review registry_value_data in the outcome to confirm which package was added, and baseline expected packages per client before suppressing."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Control\\Lsa(\\OSConfig)?(\\Security Packages)?$/ nocase
    (
      $reg.target.registry.registry_value_name = /^Security Packages$/ nocase or
      $reg.target.registry.registry_key = /\\Security Packages$/ nocase
    )
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1547.005")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_data = array_distinct($reg.target.registry.registry_value_data)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $modifying_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
