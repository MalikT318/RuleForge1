/*
  MITRE Technique : T1539 - Steal Web Session Cookie
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:39:15.051488+00:00
  Reference       : https://attack.mitre.org/techniques/T1539
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1539_Linux_Cookie_Store_Process_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a non-browser Linux process whose command line references a browser cookie store (Firefox cookies.sqlite or Chromium-family Cookies database) and which opens an outbound connection to an external address. This is the network-side signature of session cookies being exfiltrated from disk to a remote host, such as an upload through an HTTP client or a copy over SSH or a raw socket."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1539"
    mitre_technique_name = "Steal Web Session Cookie"
    log_prerequisites = "Requires Linux EDR or auditd-derived network connection telemetry that populates principal.process.command_line and target.ip on NETWORK_CONNECTION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Approved backup or profile-sync tools that copy browser profiles off-host, IT scripts migrating user profiles, browser-testing automation or forensic collection run by administrators, and users syncing dotfiles to a personal remote."
    tuning_guidance = "Add approved backup agents to %global_allowed_backup_processes, approved IT tooling to %global_allowed_admin_tools, and trusted automation accounts to %global_allowed_service_accounts. Internal destinations are already excluded via %rfc1918_internal. If the command line is not populated on network events for a client, the rule will not fire for that client, so confirm field coverage first."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.command_line = /(\/\.mozilla\/firefox\/[^\s]*cookies\.sqlite|\/\.config\/(google-chrome|chromium|chrome|microsoft-edge|BraveSoftware)[^\s]*\/Cookies|\/snap\/[^\s]*\/(Default|Profile [0-9]+)\/(Network\/)?Cookies|\/\.var\/app\/[^\s]*\/(cookies\.sqlite|Cookies))/ nocase
    not $net.principal.process.file.full_path = /\/(firefox|firefox-bin|chrome|google-chrome|chromium|chromium-browser|brave|brave-browser|msedge|microsoft-edge)$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1539")
    $primary_entity = array_distinct($net.principal.hostname)
    $user = array_distinct($net.principal.user.userid)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $process_command_line = array_distinct($net.principal.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
