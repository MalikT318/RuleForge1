/*
  MITRE Technique : T1667 - Email Bombing
  Tactic(s)       : Impact
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:09:34.468283+00:00
  Reference       : https://attack.mitre.org/techniques/T1667
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1667_Linux_Shell_Loop_Mass_Mail_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a Linux shell launched with an inline loop that drives a mail-sending binary, followed by a burst of 20 or more mail-client launches from shell parents on the same host within 10 minutes. This pattern is consistent with scripted email bombing, where a compromised host floods a target mailbox or distribution list."
    mitre_tactic = "Impact"
    mitre_technique = "T1667"
    mitre_technique_name = "Email Bombing"
    log_prerequisites = "Requires Linux EDR or auditd process execution telemetry (execve) with command line, parent process path and user populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate cron or batch jobs sending notification or report mail in a loop, monitoring or alerting scripts (disk, backup, log-watch) that mail many recipients, newsletter or mailing-list scripts run by administrators, and mail server maintenance or queue-flush scripts."
    tuning_guidance = "Add known mail-relay or batch-job hosts to %global_allowed_script_hosts. Add service accounts that legitimately send bulk mail to %global_allowed_service_accounts. Raise or lower the #mail threshold (default 20) or the 10m window to match each client's normal notification volume."

  events:
    $shell.metadata.event_type = "PROCESS_LAUNCH"
    $shell.target.process.file.full_path = /\/(bash|sh|dash|zsh|ksh)$/ nocase
    $shell.target.process.command_line = /\b(for|while|until)\b.*\bdo\b.*\b(sendmail|mailx?|mutt|msmtp|ssmtp|s-nail)\b/ nocase
    $shell.principal.hostname = $hostname
    not $shell.principal.hostname in %global_allowed_script_hosts

    $mail.metadata.event_type = "PROCESS_LAUNCH"
    $mail.target.process.file.full_path = /\/(sendmail|mailx?|mutt|msmtp|ssmtp|s-nail)$/ nocase
    $mail.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh)$/ nocase
    $mail.principal.hostname = $hostname
    not $mail.principal.hostname in %global_allowed_script_hosts
    not $mail.principal.user.userid in %global_allowed_service_accounts

    $shell.metadata.event_timestamp.seconds <= $mail.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1667")
    $primary_entity = array_distinct($hostname)
    $mail_launch_count = count($mail.metadata.id)
    $sending_users = array_distinct($mail.principal.user.userid)
    $mail_binaries = array_distinct($mail.target.process.file.full_path)
    $loop_command_lines = array_distinct($shell.target.process.command_line)

  condition:
    $shell and #mail >= 20
}
