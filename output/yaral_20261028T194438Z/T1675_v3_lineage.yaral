/*
  MITRE Technique : T1675 - ESXi Administration Command
  Tactic(s)       : Execution
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:20:24.899812+00:00
  Reference       : https://attack.mitre.org/techniques/T1675
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1675_ESXi_Management_Daemon_Spawns_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell or script interpreter launched directly by an ESXi network-facing management daemon (CIM/WBEM broker, service location daemon, reverse proxy, host agent, or vCenter agent). These daemons do not normally spawn interactive shells or interpreters. A match indicates abuse of an ESXi administration service, or exploitation of one, to run commands on the host."
    mitre_tactic = "Execution"
    mitre_technique = "T1675"
    mitre_technique_name = "ESXi Administration Command"
    log_prerequisites = "ESXi shell and process execution logging forwarded to Chronicle and normalised to PROCESS_LAUNCH with parent (principal.process) and child (target.process) file paths populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Vendor-supplied health-check or hardware-monitoring scripts launched by the CIM broker; vendor VIB agents that wrap shell scripts; host-profile remediation or lifecycle tooling that runs shell commands through the host agent; vCenter agent upgrade scripts."
    tuning_guidance = "Add approved parent daemons or wrapper binaries to %global_allowed_admin_tools and approved script-launching parents to %global_allowed_script_hosts. If a specific hardware vendor's monitoring VIB is noisy, add its parent path to %global_allowed_admin_tools rather than loosening the regex. Narrow the parent list if hostd or vpxa remain noisy after tuning."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(slpd|openwsman|sfcbd|sfcb-[a-z0-9_-]+|rhttpproxy|hostd|vpxa)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|ash|bash|dash|python[0-9.]*|perl)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1675")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
