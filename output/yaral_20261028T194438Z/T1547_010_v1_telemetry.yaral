/*
  MITRE Technique : T1547.010 - Port Monitors
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:36:46.049063+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/010
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_010_Port_Monitor_Driver_Registry_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a write to the Driver value of a subkey under HKLM\\SYSTEM\\CurrentControlSet\\Control\\Print\\Monitors. The print spooler (spoolsv.exe) loads this DLL as SYSTEM at boot, so a new or changed value is a persistence and privilege escalation primitive. This is the registry state change produced by the AddMonitor API or by direct registry edits. It does not depend on command-line logging. Values pointing at the default Microsoft port monitor DLLs are excluded."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.010"
    mitre_technique_name = "Boot or Logon Autostart Execution: Port Monitors"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events 12/13, or equivalent) that populates target.registry.registry_key and target.registry.registry_value_name. Registry value data (target.registry.registry_value_data) is recommended for the default-DLL exclusion."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Third-party print or PDF software, print management and secure-print suites, and thin-client or virtual printing products that install a custom port monitor. Windows feature or cumulative updates that touch the built-in monitors. Fax or scan software installers."
    tuning_guidance = "Add approved installer and deployment binaries to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. Review the monitor DLL path in the alert. Legitimate monitors are normally signed and live in System32. If a vendor print monitor is widely deployed at a client, add its installer to the allowlist rather than loosening the key match. If registry_value_data is not populated for a client, the default-DLL exclusion simply does not apply and the rule becomes slightly noisier."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(CurrentControlSet|ControlSet\d+)\\Control\\Print\\Monitors\\[^\\]+$/ nocase
    $reg.target.registry.registry_value_name = "Driver" nocase
    not $reg.target.registry.registry_value_data = /^(localspl|tcpmon|usbmon|wsdmon|APMon|win32spl)\.dll$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1547.010")
    $primary_entity = array_distinct($reg.principal.hostname)
    $monitor_key = array_distinct($reg.target.registry.registry_key)
    $monitor_dll = array_distinct($reg.target.registry.registry_value_data)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
