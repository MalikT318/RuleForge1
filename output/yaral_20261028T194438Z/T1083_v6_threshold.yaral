/*
  MITRE Technique : T1083 - File and Directory Discovery
  Tactic(s)       : Discovery
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:24:19.108490+00:00
  Reference       : https://attack.mitre.org/techniques/T1083
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1083_Linux_High_Volume_File_Enumeration_Reads {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a high volume of file or directory read events from enumeration utilities (ls, find, tree, locate, du, stat) against user home, credential, web, log and mount locations on a single Linux host within ten minutes. Each read is benign on its own, but sustained bulk enumeration indicates automated file and directory discovery. The rule uses file-access telemetry, not command-line matching, so it complements process-creation rules."
    mitre_tactic = "Discovery"
    mitre_technique = "T1083"
    mitre_technique_name = "File and Directory Discovery"
    log_prerequisites = "Requires Linux EDR file-access telemetry or auditd watch rules on sensitive directories, normalised to UDM FILE_READ with principal.process.file.full_path and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup and imaging jobs, file indexers (updatedb/mlocate, tracker), antivirus or EDR scans, configuration management runs, log shippers, administrators running recursive find or du during housekeeping, and developer build tooling."
    tuning_guidance = "Add approved admin and inventory tooling to %global_allowed_admin_tools. Add backup agents to %global_allowed_backup_processes, security agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Raise the #file threshold on hosts that are file servers or build servers. Narrow the target path regex if the auditd watch scope is broad."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.principal.process.file.full_path = /\/(ls|find|tree|locate|mlocate|plocate|du|stat|dir|vdir)$/ nocase
    $file.target.file.full_path = /^\/(root|home\/[^\/]+|srv|mnt|media|opt|var\/(www|log|backups)|etc)(\/|$)/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($file.target.file.full_path = /\/\.(ssh|aws|gnupg|kube|docker)(\/|$)/ nocase, 80, 55))
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1083")
    $primary_entity = array_distinct($host)
    $users = array_distinct($file.principal.user.userid)
    $tools = array_distinct($file.principal.process.file.full_path)
    $sample_paths = array_distinct($file.target.file.full_path)

  condition:
    #file >= 100
}
