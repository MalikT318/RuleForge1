/*
  MITRE Technique : T1056.004 - Credential API Hooking
  Tactic(s)       : Collection, Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:50:53.950289+00:00
  Reference       : https://attack.mitre.org/techniques/T1056/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1056_004_Linux_Preload_Library_Drop_Then_LdPreload_Write {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a shared library written to a world-writable staging directory (/tmp, /var/tmp, /dev/shm, /run/user) followed within 10 minutes by a write to /etc/ld.so.preload on the same host. This is the classic Linux function-hooking setup for intercepting credential-handling libc and PAM calls system-wide. It uses file telemetry only and does not duplicate command-line rules."
    mitre_tactic = "Collection, Credential Access"
    mitre_technique = "T1056.004"
    mitre_technique_name = "Input Capture: Credential API Hooking"
    log_prerequisites = "Requires Linux EDR or auditd file telemetry (FILE_CREATION and FILE_MODIFICATION) with principal.hostname and target.file.full_path populated. Auditd needs a watch on /etc/ld.so.preload and on the staging directories."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software installers or build systems that unpack .so files in /tmp and then register a preload library; performance, profiling or memory-allocator tooling (e.g. a custom malloc library); legitimate security or monitoring agents that use ld.so.preload; configuration management runs."
    tuning_guidance = "Add approved installers, configuration management and deployment binaries to %global_allowed_admin_tools, and EDR or monitoring agents to %global_allowed_security_tools. If a client legitimately uses ld.so.preload, scope the exclusion by writer process path rather than by directory."

  events:
    $so.metadata.event_type = "FILE_CREATION"
    $so.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/user\/[0-9]+)\/.+\.so(\.[0-9.]+)?$/ nocase
    not $so.principal.process.file.full_path in %global_allowed_admin_tools
    not $so.principal.process.file.full_path in %global_allowed_security_tools
    $so.principal.hostname = $hostname

    $preload.metadata.event_type = "FILE_MODIFICATION"
    $preload.target.file.full_path = /^\/etc\/ld\.so\.preload$/ nocase
    not $preload.principal.process.file.full_path in %global_allowed_admin_tools
    not $preload.principal.process.file.full_path in %global_allowed_security_tools
    $preload.principal.hostname = $hostname

    $so.metadata.event_timestamp.seconds <= $preload.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1056.004")
    $primary_entity = array_distinct($hostname)
    $dropped_library_paths = array_distinct($so.target.file.full_path)
    $dropper_processes = array_distinct($so.principal.process.file.full_path)
    $preload_writer_processes = array_distinct($preload.principal.process.file.full_path)
    $acting_users = array_distinct($preload.principal.user.userid)

  condition:
    $so and $preload
}
