/*
  MITRE Technique : T1564.005 - Hidden File System
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:20:52.767495+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_005_Disk_Image_Dropped_Then_Volume_Mounted {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "A virtual disk or partition image file is created in a user-writable location and a new drive-letter volume mapping is registered on the same host within 10 minutes. This pattern matches an adversary dropping a portable file-system image and mounting it to hide payloads and file I/O from security tools."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.005"
    mitre_technique_name = "Hide Artifacts: Hidden File System"
    log_prerequisites = "Requires EDR or Sysmon FILE_CREATION telemetry (Sysmon event 11) and registry telemetry covering HKLM\\SYSTEM\\MountedDevices (Sysmon events 12/13). Registry coverage of MountedDevices may need to be enabled in the Sysmon or EDR configuration."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Users or developers mounting VHD/VHDX/ISO-style images from Downloads or Temp, Hyper-V and WSL tooling, VM lab builds, forensic imaging, software installers that stage disk images, and backup or recovery products restoring volumes."
    tuning_guidance = "Add approved imaging, virtualization and deployment binaries to %global_allowed_admin_tools and backup or imaging software to %global_allowed_backup_processes. Raise severity for hosts that are not expected to mount images, such as servers and kiosks. Extend the path regex if a client stages images in additional user-writable folders."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|users\\public|programdata|windows\\temp)\\.*\.(vhd|vhdx|img|vmdk|vdi)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    $file.principal.hostname = $hostname

    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\system\\mounteddevices$/ nocase
    $reg.target.registry.registry_value_name = /^\\DosDevices\\[A-Z]:$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_backup_processes
    $reg.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $reg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1564.005")
    $primary_entity = array_distinct($hostname)
    $image_paths = array_distinct($file.target.file.full_path)
    $creator_processes = array_distinct($file.principal.process.file.full_path)
    $mounted_drive_letters = array_distinct($reg.target.registry.registry_value_name)
    $creating_users = array_distinct($file.principal.user.userid)

  condition:
    $file and $reg
}
