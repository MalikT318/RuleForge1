/*
  MITRE Technique : T1687 - Exploitation for Defense Impairment
  Tactic(s)       : Defense Impairment
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Impair Defenses (formerly T1562)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:35:03.263907+00:00
  Reference       : https://attack.mitre.org/techniques/T1687
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1687_External_Exploit_Pattern_Against_Mgmt_Interface {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external source sending an HTTP request to a management, API or upload path with exploitation markers in the URL. The markers are path traversal, shell command substitution, or chained shell commands. This is the network-observable footprint of exploiting a vulnerable security or management service (EDR console, firewall or proxy admin UI, monitoring or log-collection server) to impair defenses."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1687"
    mitre_technique_name = "Exploitation for Defense Impairment"
    log_prerequisites = "Requires firewall, reverse-proxy or WAF perimeter logs normalised to UDM NETWORK_HTTP with target.url populated. TLS inspection or a termination point is needed to see URLs on encrypted traffic."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and penetration tests not yet in the scanner list, external admins or MSP staff on an unlisted management source, legitimate APIs that carry shell-like characters in query strings, and web crawlers hitting API paths."
    tuning_guidance = "Add approved scanner source IPs to %global_allowed_scanners and approved admin or MSP source addresses to %global_allowed_mgmt_sources. Add trusted partner or vendor addresses to the same lists. Narrow the management-path regex to the paths exposed by the security products in the client environment."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(admin|manage(ment)?|console|cgi-bin|api|rest|setup|config|agent|remote|update|upload|diag(nostics?)?)(\/|\?|$)/ nocase
    $http.target.url = /(\.\.\/|\.\.\\|%2e%2e(%2f|%5c|\/)|\$\(|%24%28|%60|`|\|\||%7c%7c|(;|%3b|%7c|\|)\s*(sh|bash|curl|wget|nc|chmod|python|perl)\b)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1687")
    $primary_entity = array_distinct($http.target.ip)
    $source_ips = array_distinct($http.principal.ip)
    $target_ports = array_distinct($http.target.port)
    $request_urls = array_distinct($http.target.url)

  condition:
    $http
}
