/*
  MITRE Technique : T1558.002 - Silver Ticket
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:41:57.948498+00:00
  Reference       : https://attack.mitre.org/techniques/T1558/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1558_002_Kerberos_Logon_FQDN_Domain_Forged_Service_Ticket {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Kerberos network logon whose account domain is an FQDN (contains a dot) rather than the NetBIOS domain name. Legitimate service-ticket logons record the NetBIOS domain, while forged service tickets (silver tickets) carry attacker-supplied PAC domain values, so this is a common artifact of ticket forgery. The rule works at the authentication-result layer on the identity side, and does not depend on process or command-line telemetry or on contacting the KDC. This is a heuristic indicator, not proof, and its reliability depends on how the client's log parser populates the domain field."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1558.002"
    mitre_technique_name = "Steal or Forge Kerberos Tickets: Silver Ticket"
    log_prerequisites = "Requires Windows Security logon events (4624) from domain controllers, member servers and service hosts, normalised to USER_LOGIN with auth mechanism, auth details and target.user.windows_domain populated."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Trust or cross-forest logons where the parser records the DNS domain name, parser variations that populate windows_domain with the DNS name for every logon, third-party Kerberos clients and appliances, and service accounts in non-standard configurations."
    tuning_guidance = "Validate in each tenant that normal Kerberos logons populate windows_domain with the NetBIOS name; if they do not, disable this rule or restrict it to specific servers. Add known service accounts to %global_allowed_service_accounts and administrator accounts to %global_allowed_admin_users. Machine accounts are already excluded."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.extensions.auth.mechanism = "NETWORK"
    $auth.extensions.auth.auth_details = /kerberos/ nocase
    $auth.target.user.windows_domain = /\./
    $auth.target.user.userid != ""
    not $auth.target.user.userid = /\$$/
    not $auth.target.user.userid = /^(anonymous logon|-)$/ nocase
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1558.002")
    $primary_entity = array_distinct($auth.target.hostname)
    $logon_accounts = array_distinct($auth.target.user.userid)
    $logon_domains = array_distinct($auth.target.user.windows_domain)
    $source_ips = array_distinct($auth.principal.ip)

  condition:
    $auth
}
