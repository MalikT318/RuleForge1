/*
  MITRE Technique : T1571 - Non-Standard Port
  Tactic(s)       : Command and Control
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:18:37.534267+00:00
  Reference       : https://attack.mitre.org/techniques/T1571
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1571_ESXi_Repeated_Port_Exposure_Or_Tunnel_Commands {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects repeated shell commands on a single ESXi host within 10 minutes that open or alter firewall rulesets, create SSH port-forward or SOCKS tunnels, or start netcat-style listeners and connections on explicit ports. Each command can be legitimate on its own. A burst of them on one hypervisor suggests an adversary exposing or tunnelling traffic over non-standard ports for command and control."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1571"
    mitre_technique_name = "Non-Standard Port"
    log_prerequisites = "ESXi shell command logging forwarded to Chronicle and parsed to UDM PROCESS_LAUNCH with target.process.command_line and principal.hostname populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators changing firewall rulesets during host build or hardening, backup or monitoring agent onboarding, support staff using SSH tunnels to reach management interfaces, and automation scripts that apply firewall configuration to many hosts."
    tuning_guidance = "Add approved admin accounts to %global_allowed_admin_users and approved tooling or parent binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Raise the threshold from 3 for noisy build or patch windows, or lower it where shell access is normally rare."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(esxcli\s+network\s+firewall\s+(ruleset|rule)\s+(set|add|allowedip)|\bssh\b.*\s-[LRD]\s*(\S+:)?\d{2,5}|\b(nc|ncat|netcat)\b.*\s-\w*[lp]\w*\s+\d{2,5})/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.user.userid in %global_allowed_admin_users
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1571")
    $primary_entity = array_distinct($host)
    $users = array_distinct($proc.principal.user.userid)
    $commands = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 3
}
