/*
  MITRE Technique : T1568 - Dynamic Resolution
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:03:49.740127+00:00
  Reference       : https://attack.mitre.org/techniques/T1568
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1568_Windows_DGA_Style_DNS_From_NonBrowser_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows process other than a browser or approved tool resolving a second-level domain whose name looks algorithmically generated: a long, random-looking label with long consonant runs or alternating digit/letter patterns. Malware using domain generation algorithms (DGA) for dynamic C2 resolution produces this pattern. The rule works on DNS query telemetry rather than process command lines, so it complements command-line detections."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1568"
    mitre_technique_name = "Dynamic Resolution"
    log_prerequisites = "Requires Windows endpoint DNS query telemetry that records the requesting process (Sysmon Event ID 22 or EDR DNS events) normalised to UDM NETWORK_DNS."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software update and telemetry services using hashed or random hostnames, CDN and cloud storage endpoints with long random labels, peer-to-peer or sync clients, developer tooling, and security products querying reputation services."
    tuning_guidance = "Add known-good domains to %global_allowed_domains, approved agents to %global_allowed_security_tools, and IT tooling to %global_allowed_admin_tools. If a vendor generates noisy random labels, add the exact queried domain to %global_allowed_domains. Lengthen the label minimum (16) or the consonant run (5) to reduce noise, or shorten them for more sensitivity."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.principal.process.file.full_path = /\.exe$/ nocase
    $dns.network.dns.questions.name = /^[a-z0-9]{16,}\.[a-z]{2,24}$/ nocase
    $dns.network.dns.questions.name = /[bcdfghjklmnpqrstvwxz]{5,}|[0-9][a-z][0-9][a-z][0-9]/ nocase
    not $dns.principal.process.file.full_path = /\\(chrome|msedge|firefox|iexplore|brave|opera|MsMpEng|MsSense|SenseIR|svchost)\.exe$/ nocase
    not $dns.principal.process.file.full_path in %global_allowed_security_tools
    not $dns.principal.process.file.full_path in %global_allowed_admin_tools
    not $dns.network.dns.questions.name in %global_allowed_domains

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1568")
    $primary_entity = array_distinct($dns.principal.hostname)
    $queried_domains = array_distinct($dns.network.dns.questions.name)
    $requesting_process = array_distinct($dns.principal.process.file.full_path)
    $requesting_user = array_distinct($dns.principal.user.userid)

  condition:
    $dns
}
