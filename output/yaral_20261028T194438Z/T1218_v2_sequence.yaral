/*
  MITRE Technique : T1218 - System Binary Proxy Execution
  Tactic(s)       : Stealth
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:40:15.996712+00:00
  Reference       : https://attack.mitre.org/techniques/T1218
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_Linux_Staged_File_Executed_Via_Proxy_Binary {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A file is created in a world-writable staging directory (/tmp, /var/tmp, /dev/shm) and, within ten minutes on the same host, that same file is executed by a trusted system utility such as split, xargs, find, awk or timeout acting as the parent process. This sequence indicates system binary proxy execution (GTFOBins-style) used to launch dropped content through a trusted binary."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218"
    mitre_technique_name = "System Binary Proxy Execution"
    log_prerequisites = "Requires Linux EDR or auditd telemetry that populates FILE_CREATION events (target.file.full_path) and PROCESS_LAUNCH events with parent process path and child process path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Build and CI jobs that compile into /tmp and run the output via xargs or find; package post-install scripts; configuration management agents staging helper scripts; developers testing scripts via find -exec or xargs."
    tuning_guidance = "Add approved automation binaries to %global_allowed_admin_tools, build and automation accounts to %global_allowed_service_accounts, and approved script hosts to %global_allowed_script_hosts. If build servers are noisy, scope them out by hostname via a customer-specific copy of the rule."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/.+/ nocase
    $file.target.file.full_path = $path
    $file.principal.hostname = $hostname
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|yum|dnf|snapd|unattended-upgrade)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(split|xargs|find|awk|gawk|mawk|timeout|flock|watch)$/ nocase
    $proc.target.process.file.full_path = $path
    $proc.principal.hostname = $hostname
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname, $path over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218")
    $primary_entity = array_distinct($hostname)
    $staged_file = array_distinct($path)
    $proxy_binaries = array_distinct($proc.principal.process.file.full_path)
    $executing_users = array_distinct($proc.principal.user.userid)
    $launch_command_lines = array_distinct($proc.target.process.command_line)
    $file_creators = array_distinct($file.principal.process.file.full_path)
    $first_file_creation = min($file.metadata.event_timestamp.seconds)
    $last_execution = max($proc.metadata.event_timestamp.seconds)

  condition:
    $file and $proc
}
