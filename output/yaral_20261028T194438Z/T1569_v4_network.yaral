/*
  MITRE Technique : T1569 - System Services
  Tactic(s)       : Execution
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:09:54.274004+00:00
  Reference       : https://attack.mitre.org/techniques/T1569
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1569_Service_Spawned_LOLBin_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a built-in interpreter or LOLBin (command shell, PowerShell, rundll32, mshta, regsvr32, script hosts, certutil, bitsadmin) launched by the Service Control Manager (services.exe) that makes an outbound connection to a non-internal address. This is the network footprint of a malicious service used for one-time execution or remote payload retrieval and C2. Legitimate services rarely run these binaries directly and then reach out to the internet."
    mitre_tactic = "Execution"
    mitre_technique = "T1569"
    mitre_technique_name = "System Services"
    log_prerequisites = "Requires Windows endpoint network telemetry with process context (EDR or Sysmon Event ID 3) that populates principal.process.file.full_path and principal.process.parent_process.file.full_path on NETWORK_CONNECTION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Vendor software whose service wrapper starts cmd or PowerShell to check in or update, RMM and patching agents running as services, backup agents calling out to cloud storage, and administrators running one-off PsExec-style maintenance that reaches an external repository."
    tuning_guidance = "Add approved RMM, deployment and patching binaries to %global_allowed_admin_tools and approved remote support tooling to %global_allowed_remote_mgmt. Keep %rfc1918_internal current for each client. If a vendor service wrapper is noisy, allowlist its child process path in %global_allowed_admin_tools rather than excluding by install directory."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.parent_process.file.full_path = /\\services\.exe$/ nocase
    $net.principal.process.file.full_path = /\\(cmd|powershell|pwsh|rundll32|mshta|regsvr32|wscript|cscript|certutil|bitsadmin|msiexec)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1569")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $service_child_process = array_distinct($net.principal.process.file.full_path)
    $service_child_cmdline = array_distinct($net.principal.process.command_line)

  condition:
    $net
}
