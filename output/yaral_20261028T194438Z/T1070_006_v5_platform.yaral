/*
  MITRE Technique : T1070.006 - Timestomp
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:08:35.685778+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_006_Linux_Touch_Reference_Timestamp_Tamper_File_Event {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects file attribute/modification events on Linux where the acting process is the native touch utility using reference-file or explicit-time options (-r, -t, -d, --reference, --date) against attacker-favoured locations: world-writable staging directories, cron and systemd persistence paths, SSH key directories, local binary directories and log files. This is the classic Linux timestomping pattern for making dropped files or edited persistence and logs blend in with neighbouring files. The rule works on file telemetry (auditd utimensat/attribute-change records or EDR file events) rather than process-creation command-line telemetry, so it complements existing PROCESS_LAUNCH detections."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.006"
    mitre_technique_name = "Indicator Removal: Timestomp"
    log_prerequisites = "Linux EDR file telemetry or auditd rules watching utimensat/utimes/futimesat and attribute changes on the monitored paths, normalised to UDM FILE_MODIFICATION with principal.process populated (file.full_path and command_line)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package managers and build systems that preserve timestamps (rsync, cp -p, tar, make, install), backup and restore jobs, configuration management agents, admins deliberately touching files in /tmp or log directories, and deployment scripts that normalise mtimes for reproducible builds."
    tuning_guidance = "Add approved deployment, build and config-management binaries to %global_allowed_admin_tools, automation accounts to %global_allowed_service_accounts, and approved script hosts to %global_allowed_script_hosts. If /var/log or /tmp is too noisy in build-heavy environments, narrow the target path regex. Keep the cron, systemd and SSH paths at higher priority."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.principal.process.file.full_path = /\/touch$/ nocase
    $file.principal.process.command_line = /\btouch\b.*\s(-[a-zA-Z]*[tdr][a-zA-Z]*(\s|$)|--(date|reference)\b)/ nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|var\/log|etc\/cron[^\/]*|var\/spool\/cron|etc\/systemd|usr\/lib\/systemd|etc\/profile\.d|usr\/local\/s?bin|root\/\.ssh|home\/[^\/]+\/\.ssh|home\/[^\/]+\/\.config\/systemd)(\/|$)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1070.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $acting_user = array_distinct($file.principal.user.userid)
    $modified_paths = array_distinct($file.target.file.full_path)
    $acting_command_line = array_distinct($file.principal.process.command_line)

  condition:
    $file
}
