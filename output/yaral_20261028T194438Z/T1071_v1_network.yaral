/*
  MITRE Technique : T1071 - Application Layer Protocol
  Tactic(s)       : Command and Control
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:02:13.113579+00:00
  Reference       : https://attack.mitre.org/techniques/T1071
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_Linux_Scripted_HTTP_Client_To_Raw_IP_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects outbound HTTP POST requests to an external raw IP address (no domain name in the URL) from a command-line or scripting-library HTTP client, based on the user-agent string. This pattern is typical of Linux implants and scripted C2 beacons that blend into web traffic. Detection is network-side only and complements endpoint process-creation rules."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071"
    mitre_technique_name = "Application Layer Protocol"
    log_prerequisites = "Requires forward proxy, secure web gateway, or firewall with HTTP inspection that populates network.http.user_agent, network.http.method and target.url. TLS-encrypted traffic is only visible if the perimeter device performs TLS inspection."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate Linux automation, monitoring agents, package or configuration management and backup scripts that POST to partner or vendor APIs by IP address; developer and CI/CD hosts; vulnerability scanners."
    tuning_guidance = "Add authorised scanner source IPs to %global_allowed_scanners and known-good external destinations to %global_allowed_domains. Exclude approved automation egress IPs using %global_allowed_mgmt_sources if appropriate. Extend or narrow the user-agent regex to match the client estate. Consider restricting to server subnets via a per-tenant copy of this rule."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.network.http.method = "POST" nocase
    $net.network.http.user_agent = /^(curl|wget|python-requests|python-urllib|go-http-client|libwww-perl|okhttp|apache-httpclient)/ nocase
    $net.target.url = /^(https?:\/\/)?[0-9]{1,3}(\.[0-9]{1,3}){3}(:[0-9]+)?(\/|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1071")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_urls = array_distinct($net.target.url)
    $user_agents = array_distinct($net.network.http.user_agent)

  condition:
    $net
}
