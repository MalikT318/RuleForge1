/*
  MITRE Technique : T1499.002 - Service Exhaustion Flood
  Tactic(s)       : Impact
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:18:43.728046+00:00
  Reference       : https://attack.mitre.org/techniques/T1499/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1499_002_Inbound_Web_Flood_Flow_And_HTTP_Surge {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A single external source opens a large number of connections to web ports on one internal destination and, within the same 10 minute window, also sends a high volume of HTTP requests to that destination. Correlating perimeter connection volume with HTTP request volume indicates an application-layer service exhaustion flood (HTTP flood) rather than a port scan or a single noisy client."
    mitre_tactic = "Impact"
    mitre_technique = "T1499.002"
    mitre_technique_name = "Endpoint Denial of Service: Service Exhaustion Flood"
    log_prerequisites = "Requires firewall or proxy perimeter logs normalised to UDM NETWORK_CONNECTION and NETWORK_HTTP events, with principal.ip, target.ip and target.port populated. HTTP events need a decrypting proxy, web gateway or WAF in the path."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Large legitimate crawlers or search engine bots, load testing from external partners, CDN or reverse proxy egress addresses that aggregate many users behind one IP, shared NAT gateways for large branch offices or universities, and flash-crowd events such as marketing campaigns."
    tuning_guidance = "Add authorised scanners and load testers to %global_allowed_scanners and approved external management sources to %global_allowed_mgmt_sources. Add CDN or reverse proxy source addresses to %global_allowed_cloud_principals if they appear as the client address. Adjust the #flow and #http thresholds in the condition to match the normal request rate of the protected web service (raise for high-traffic sites, lower for small internal portals)."

  events:
    $flow.metadata.event_type = "NETWORK_CONNECTION"
    ($flow.target.port = 80 or $flow.target.port = 443 or $flow.target.port = 8080 or $flow.target.port = 8443)
    not $flow.principal.ip in %rfc1918_internal
    $flow.target.ip in %rfc1918_internal
    not $flow.principal.ip in %global_allowed_scanners
    not $flow.principal.ip in %global_allowed_mgmt_sources
    $flow.principal.ip = $src_ip
    $flow.target.ip = $dst_ip

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(GET|POST|HEAD|PUT)$/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources
    $http.principal.ip = $src_ip
    $http.target.ip = $dst_ip

    $flow.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src_ip, $dst_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1499.002")
    $primary_entity = array_distinct($dst_ip)
    $attacker_ip = array_distinct($src_ip)
    $connection_count = count($flow.metadata.id)
    $http_request_count = count($http.metadata.id)
    $targeted_ports = array_distinct($flow.target.port)
    $user_agents = array_distinct($http.network.http.user_agent)
    $first_seen = min($flow.metadata.event_timestamp.seconds)
    $last_seen = max($http.metadata.event_timestamp.seconds)

  condition:
    #flow >= 300 and #http >= 150
}
