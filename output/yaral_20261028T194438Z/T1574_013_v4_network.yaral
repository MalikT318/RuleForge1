/*
  MITRE Technique : T1574.013 - KernelCallbackTable
  Tactic(s)       : Stealth, Execution
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:45:49.490587+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/013
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_013_GUI_Utility_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a built-in offline GUI utility (Notepad, Paint, Calculator, WordPad and similar) from the Windows system directories making a connection to an external address. These binaries load user32.dll and expose a KernelCallbackTable but have no normal need for outbound internet access. Outbound traffic from them is a network-side indicator that the process was hijacked, for example by overwriting a KernelCallbackTable entry such as fnCOPYDATA with injected code that then beacons or downloads a payload. This is a heuristic proxy, not direct observation of the table modification. It is intended to complement endpoint rules for process injection and command-line activity."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.013"
    mitre_technique_name = "Hijack Execution Flow: KernelCallbackTable"
    log_prerequisites = "Requires endpoint network telemetry that attributes each connection to the initiating process path (EDR network events or Sysmon Event ID 3), normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Notepad or WordPad opening a document from an external WebDAV or SMB share; Windows Error Reporting or telemetry helpers briefly attributed to these processes by some EDR sensors; proxy or VPN client software that attributes traffic to the foreground process; remote support tools that launch these utilities in a hijacked session context."
    tuning_guidance = "Add legitimate tooling that proxies traffic through these utilities to %global_allowed_admin_tools or %global_allowed_security_tools. Extend the process-name list if the client environment has other offline GUI utilities that should never reach the internet. Packaged Store versions of Notepad and Paint run from the WindowsApps directory and are intentionally out of scope. Add them to the regex if the EDR reports them from a Windows system path."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^[a-z]:\\windows\\(system32|syswow64)\\(notepad|mspaint|calc|wordpad|write|charmap|magnify|osk|winver|sndvol)\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1574.013")
    $primary_entity = array_distinct($net.principal.hostname)
    $hijacked_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $affected_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
