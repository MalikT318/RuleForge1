/*
  MITRE Technique : T1197 - BITS Jobs
  Tactic(s)       : Stealth, Persistence, Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:47:14.644244+00:00
  Reference       : https://attack.mitre.org/techniques/T1197
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1197_BITS_Service_Config_Tampering {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modification of the BITS service definition (ServiceDll/ImagePath) or of BITS policy values that extend job lifetime (JobInactivityTimeout/MaxDownloadTime). Adversaries hijack the service or lengthen job lifetimes so BITS jobs persist and keep executing or downloading. BITS is Windows-only and has no Linux, macOS or cloud equivalent, so this rule covers the Windows registry control surface instead of process command lines."
    mitre_tactic = "Stealth, Persistence, Execution"
    mitre_technique = "T1197"
    mitre_technique_name = "BITS Jobs"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry events) normalised to UDM REGISTRY_MODIFICATION with registry key and value name populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy or MDM applying BITS bandwidth and timeout policies, Windows servicing and update components, software deployment tools changing BITS policy, and administrators tuning BITS throttling."
    tuning_guidance = "Add approved deployment and configuration tooling to %global_allowed_admin_tools and EDR or AV agents to %global_allowed_security_tools. If the client applies BITS policy through Group Policy, add the policy-applying process to %global_allowed_admin_tools. Remove the JobInactivityTimeout and MaxDownloadTime value names if policy changes are frequent, and keep ServiceDll and ImagePath, which should almost never change."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\((ControlSet\d+|CurrentControlSet)\\Services\\BITS(\\Parameters)?|Policies\\Microsoft\\Windows\\BITS)$/ nocase
    $reg.target.registry.registry_value_name = /^(ServiceDll|ImagePath|JobInactivityTimeout|MaxDownloadTime)$/ nocase
    not $reg.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1197")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $modified_value = array_distinct($reg.target.registry.registry_value_name)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)

  condition:
    $reg
}
