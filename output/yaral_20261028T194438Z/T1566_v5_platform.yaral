/*
  MITRE Technique : T1566 - Phishing
  Tactic(s)       : Initial Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:46:02.311214+00:00
  Reference       : https://attack.mitre.org/techniques/T1566
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1566_M365_Mismatched_ReplyTo_Lure_Email {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a mail transaction where the Reply-To domain differs from the From domain and the subject carries a credential, payment or document-share lure. A mismatched reply path is a common sign of spoofed or lookalike phishing and business-email-compromise lures. It is detected from the mail audit record, with no endpoint telemetry."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1566"
    mitre_technique_name = "Phishing"
    log_prerequisites = "Microsoft 365 or Google Workspace mail audit or message-trace events normalised to UDM EMAIL_TRANSACTION, with network.email.from, network.email.reply_to and network.email.subject populated."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate marketing, ticketing, HR, payroll and invoicing platforms that send on behalf of a brand with a different Reply-To domain; mailing lists; shared-mailbox helpdesk workflows; sanctioned phishing-awareness simulations."
    tuning_guidance = "Add known-good sender domains (SaaS notification platforms, vendors) to %global_allowed_domains. Add phishing-simulation sender identifiers to %global_allowed_scanners. Extend or narrow the subject lure regex per client mail profile."

  events:
    $email.metadata.event_type = "EMAIL_TRANSACTION"
    $email.network.email.from != ""
    $email.network.email.reply_to != ""
    $email.network.email.subject = /\b(password|verify|verification|invoice|payment|wire|urgent|overdue|payroll|remittance|shared (a )?(document|file|folder) with you|account (suspended|locked|expired)|mailbox (full|quota)|action required|security alert|sign[- ]?in)\b/ nocase

    $from_domain = re.capture(strings.to_lower($email.network.email.from), "@([^>\\s;,]+)")
    $reply_domain = re.capture(strings.to_lower($email.network.email.reply_to), "@([^>\\s;,]+)")
    $from_domain != ""
    $reply_domain != ""
    $from_domain != $reply_domain

    not $from_domain in %global_allowed_domains
    not $reply_domain in %global_allowed_domains
    not $email.network.email.from in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1566")
    $primary_entity = array_distinct($email.network.email.to)
    $sender = array_distinct($email.network.email.from)
    $reply_to = array_distinct($email.network.email.reply_to)
    $subject = array_distinct($email.network.email.subject)

  condition:
    $email
}
