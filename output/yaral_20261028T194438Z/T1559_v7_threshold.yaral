/*
  MITRE Technique : T1559 - Inter-Process Communication
  Tactic(s)       : Execution
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:51:18.897381+00:00
  Reference       : https://attack.mitre.org/techniques/T1559
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_COM_Embedding_Parent_Spawns_Interpreter_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a burst of script interpreters or LOLBins launched on one host within 10 minutes by a parent process that was itself started as a COM/DCOM local server (command line containing -Embedding). This pattern is typical of COM and DCOM abuse such as MMC20.Application, Office automation, or ShellWindows execution, where a COM-activated process runs attacker commands. A single such launch can be benign, but repeated launches in a short window are not."
    mitre_tactic = "Execution"
    mitre_technique = "T1559"
    mitre_technique_name = "Inter-Process Communication"
    log_prerequisites = "Requires EDR process telemetry or Sysmon Event ID 1 / Windows Event 4688 with command-line auditing, with the parent process command line populated in UDM (principal.process.command_line)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office or line-of-business automation using COM (macros, report generators, document conversion services), RMM and deployment tooling that drives COM servers, administrators using MMC snap-ins that launch helper shells, and software installers that use COM-activated helpers."
    tuning_guidance = "Add approved automation parents to %global_allowed_admin_tools or %global_allowed_script_hosts, and service accounts to %global_allowed_service_accounts. Raise the #proc threshold from 3 for noisy hosts such as RDS or automation servers. Review the parent_processes and child_processes outcome values to identify recurring benign workflows."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.command_line = /(^|\s)[-\/]embedding(\s|"|$)/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32)\.exe$/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1559")
    $primary_entity = array_distinct($host)
    $parent_processes = array_distinct($proc.principal.process.file.full_path)
    $child_processes = array_distinct($proc.target.process.file.full_path)
    $users = array_distinct($proc.principal.user.userid)

  condition:
    #proc >= 3
}
