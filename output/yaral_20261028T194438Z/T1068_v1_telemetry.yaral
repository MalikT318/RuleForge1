/*
  MITRE Technique : T1068 - Exploitation for Privilege Escalation
  Tactic(s)       : Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:53:25.296158+00:00
  Reference       : https://attack.mitre.org/techniques/T1068
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1068_Driver_File_Dropped_In_User_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a kernel driver (.sys) file in a user-writable location such as a user profile, Temp, ProgramData or Public. Privilege escalation through a vulnerable or attacker-supplied signed driver (BYOVD) and kernel exploits requires the driver to be written to disk first. Legitimate drivers are normally installed by trusted servicing components into System32\\drivers or the DriverStore. The rule detects the resulting file artifact, so it still fires when command-line logging is evaded or the driver is renamed."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1068"
    mitre_technique_name = "Exploitation for Privilege Escalation"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) populating target.file.full_path and principal.process.file.full_path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Hardware vendor and peripheral installers that extract drivers to Temp before installing them, software installers and updaters that stage drivers (VPN, virtualization, anti-cheat, disk utilities), driver packages unpacked by IT during imaging, and developers building or testing drivers."
    tuning_guidance = "Add approved deployment or driver-packaging tooling to %global_allowed_admin_tools and security agents to %global_allowed_security_tools. If a vendor installer is noisy, allowlist its executable name there rather than a path. Review the dropped path and the writing process. A .sys file written by a script host, browser, Office application or archive utility, or followed by service creation or driver load, should be treated as high confidence."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(?i)^[a-z]:\\(users\\[^\\]+\\(appdata|downloads|desktop|documents|music|pictures|videos)|users\\public|programdata|windows\\temp|temp|perflogs|\$recycle\.bin)\\(.+\\)?[^\\]+\.sys$/
    not $file.principal.process.file.full_path = /(?i)\\(TiWorker|TrustedInstaller|DismHost|MsMpEng|MsSense|SenseIR)\.exe$/
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1068")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_driver_path = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
