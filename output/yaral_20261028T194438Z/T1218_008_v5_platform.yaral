/*
  MITRE Technique : T1218.008 - Odbcconf
  Tactic(s)       : Stealth
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:52:09.836185+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_008_Odbcconf_Loads_Module_From_Writable_Path {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects odbcconf.exe loading a DLL/OCX from a user-writable or network path. This is the result of the REGSVR/INSTALLDRIVER/CONFIGDSN proxy-execution abuse, observed through module-load telemetry instead of command-line matching. odbcconf.exe is Windows-only, so no Linux, macOS or cloud equivalent exists; the rule is written for Windows with a non-process-launch angle."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.008"
    mitre_technique_name = "System Binary Proxy Execution: Odbcconf"
    log_prerequisites = "Requires endpoint telemetry that records image/module loads (EDR module-load events or Sysmon Event ID 7) with the loading process and loaded module path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Developers or DBAs registering custom ODBC drivers from a build or staging directory, software installers that stage ODBC drivers under ProgramData or Temp, and packaging or deployment jobs using odbcconf to configure DSNs."
    tuning_guidance = "Add approved DBA and deployment accounts to %global_allowed_admin_users. If a vendor installer legitimately stages drivers in a writable path, narrow the path regex for that client or exclude the account running it. Confirm the module-load source populates the loaded DLL in target.file.full_path or target.process.file.full_path; the rule checks both."

  events:
    $mod.metadata.event_type = "PROCESS_MODULE_LOAD"
    $mod.principal.process.file.full_path = /\\odbcconf\.exe$/ nocase
    (
      $mod.target.file.full_path = /(\\(users|programdata|temp|perflogs|intel|recycler\$recycle\.bin)\\|^\\\\).*\.(dll|ocx)$/ nocase or
      $mod.target.process.file.full_path = /(\\(users|programdata|temp|perflogs|intel|recycler\$recycle\.bin)\\|^\\\\).*\.(dll|ocx)$/ nocase
    )
    not $mod.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1218.008")
    $primary_entity = array_distinct($mod.principal.hostname)
    $loading_user = array_distinct($mod.principal.user.userid)
    $loaded_module_file = array_distinct($mod.target.file.full_path)
    $loaded_module_process = array_distinct($mod.target.process.file.full_path)

  condition:
    $mod
}
