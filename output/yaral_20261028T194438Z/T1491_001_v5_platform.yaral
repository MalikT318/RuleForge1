/*
  MITRE Technique : T1491.001 - Internal Defacement
  Tactic(s)       : Impact
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:45:03.511610+00:00
  Reference       : https://attack.mitre.org/techniques/T1491/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1491_001_Logon_Banner_Policy_Modified {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects modification of the Windows interactive logon legal notice (caption or text) registry values by a process outside approved administrative tooling. Adversaries use this to deface internal systems with intimidating or misleading messages shown to every user at logon. Note: the requested alternate-platform angle conflicts with the mandatory Windows platform and log source, so this rule covers the Windows logon-message defacement mechanism, distinct from wallpaper-based variants."
    mitre_tactic = "Impact"
    mitre_technique = "T1491.001"
    mitre_technique_name = "Defacement: Internal Defacement"
    log_prerequisites = "Requires EDR or Sysmon registry telemetry (registry value set events) populated into UDM REGISTRY_MODIFICATION with target.registry fields."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Group Policy or MDM rollout of a legal or compliance logon banner, security hardening baselines (CIS/STIG) applied by configuration tooling, administrators manually setting a legitimate notice, golden-image build pipelines."
    tuning_guidance = "Add approved deployment and hardening tooling to %global_allowed_admin_tools and named admins to %global_allowed_admin_users. If banner changes are routinely pushed by management agents, add those agent executables to %global_allowed_admin_tools. Review the banner content in the original event during triage."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    (
      $reg.target.registry.registry_value_name = /^legalnotice(text|caption)$/ nocase or
      $reg.target.registry.registry_key = /\\legalnotice(text|caption)$/ nocase
    )
    $reg.target.registry.registry_key = /\\(Policies\\System|Windows NT\\CurrentVersion\\Winlogon)/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(50)
    $mitre_technique_id = array_distinct("T1491.001")
    $primary_entity = array_distinct($reg.principal.hostname)
    $actor_user = array_distinct($reg.principal.user.userid)
    $actor_process = array_distinct($reg.principal.process.file.full_path)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $modified_value = array_distinct($reg.target.registry.registry_value_name)

  condition:
    $reg
}
