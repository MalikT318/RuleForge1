/*
  MITRE Technique : T1559.002 - Dynamic Data Exchange
  Tactic(s)       : Execution
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:55:05.817255+00:00
  Reference       : https://attack.mitre.org/techniques/T1559/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1559_002_Office_DDE_Enabled_Then_Shell_Spawn {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an Office DDE-related registry setting being changed on a host, followed within ten minutes by an Office application spawning a command interpreter or script/LOLBin child process on the same host. This pairing indicates DDE being enabled and then used to execute commands (T1559.002)."
    mitre_tactic = "Execution"
    mitre_technique = "T1559.002"
    mitre_technique_name = "Inter-Process Communication: Dynamic Data Exchange"
    log_prerequisites = "Requires Windows endpoint telemetry with registry modification events (including HKCU/HKU Office Security and Options keys) and process launch events with parent process lineage and command lines."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy line-of-business Excel or Word workbooks that rely on DDE links and are enabled by administrators via GPO or login scripts, followed by macros or add-ins that legitimately launch helper processes. Software deployment tools that set Office security registry values. Power users enabling DDE for old reporting workflows."
    tuning_guidance = "Add approved Office configuration and deployment tooling to %global_allowed_admin_tools, approved admin accounts to %global_allowed_admin_users, and legitimate Office-spawned helper binaries to %global_allowed_script_hosts. If the registry event is too noisy, restrict the key regex to the specific Office applications in use."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Software\\(Policies\\)?Microsoft\\Office\\[0-9.]+\\(Word|Excel|Outlook|Common)\\(Security|Options)/ nocase
    $reg.target.registry.registry_value_name = /^(AllowDDE|DDEAllowed)$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_admin_users
    $reg.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|outlook|powerpnt)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|pwsh|mshta|wscript|cscript|rundll32|regsvr32|certutil|bitsadmin|msiexec)\.exe$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_admin_users
    $proc.principal.hostname = $hostname

    $reg.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1559.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $registry_keys = array_distinct($reg.target.registry.registry_key)
    $registry_values = array_distinct($reg.target.registry.registry_value_name)
    $office_parents = array_distinct($proc.principal.process.file.full_path)
    $child_processes = array_distinct($proc.target.process.file.full_path)
    $child_command_lines = array_distinct($proc.target.process.command_line)
    $affected_users = array_distinct($proc.principal.user.userid)

  condition:
    $reg and $proc
}
