/*
  MITRE Technique : T1574.005 - Executable Installer File Permissions Weakness
  Tactic(s)       : Stealth, Execution
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:31:31.447401+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_005_Installer_Binary_Overwrite_By_UserWritable_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an existing executable, DLL or driver under Program Files or ProgramData being overwritten by a process running from a user-writable staging location (user Temp, AppData, Downloads, Desktop, Public, Windows\\Temp). This is the file-write result of installer or binary-permission hijacking, where a weakly protected binary is replaced and later executed by a privileged installer or service. It is file-event based, so it complements existing process-creation and command-line coverage."
    mitre_tactic = "Persistence, Privilege Escalation, Defense Evasion"
    mitre_technique = "T1574.005"
    mitre_technique_name = "Hijack Execution Flow: Executable Installer File Permissions Weakness"
    log_prerequisites = "Requires Windows endpoint file-modification telemetry with the writing process path populated (EDR file-write events or Sysmon Event ID 11/23-equivalent, normalised to UDM FILE_MODIFICATION)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Self-extracting installers and application updaters that run from Temp or AppData and legitimately replace binaries under Program Files; per-user software updaters; software deployment or patching agents staging from Windows\\Temp; developer build outputs."
    tuning_guidance = "Add approved deployment, patching and updater executable paths to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. Review recurring hits by writing process name and target path, and suppress only vendor updaters confirmed as benign."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^[a-z]:\\(program files( \(x86\))?|programdata)\\.+\.(exe|dll|sys|ocx|scr)$/ nocase
    $file.principal.process.file.full_path = /(\\users\\[^\\]+\\(appdata\\(local\\temp|roaming|local)|downloads|desktop|documents)\\|\\users\\public\\|\\windows\\temp\\)/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1574.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_binary = array_distinct($file.target.file.full_path)
    $writing_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
