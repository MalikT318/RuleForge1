/*
  MITRE Technique : T1055.008 - Ptrace System Calls
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:55:14.672493+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_008_Linux_Proc_Mem_Write_Injection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process writing to another process's memory through the /proc/<pid>/mem pseudo-file. This is the file-based counterpart to ptrace injection (PTRACE_POKETEXT/POKEDATA) and is commonly paired with PTRACE_ATTACH and PTRACE_SETREGS to run code inside a live process. The rule keys on the OS mechanism (a write to the proc memory interface) rather than any command line, so it adds coverage beyond process-creation rules. Writes to /proc/self/mem do not match because the path requires a numeric PID."
    mitre_tactic = "Stealth, Defense Evasion, Privilege Escalation"
    mitre_technique = "T1055.008"
    mitre_technique_name = "Process Injection: Ptrace System Calls"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd with a write watch (-w) or syscall rules covering /proc/*/mem, normalised to UDM FILE_MODIFICATION with target.file.full_path and principal.process.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Interactive debuggers (gdb, lldb) and tracers run by developers or SREs; crash-dump, checkpoint/restore and live-patching tooling; runtime instrumentation and APM agents; EDR/AV agents inspecting processes; JIT or managed-runtime profilers."
    tuning_guidance = "Add approved debugger, profiler and patching binaries to %global_allowed_admin_tools, EDR/AV agents to %global_allowed_security_tools, and checkpoint or imaging tools to %global_allowed_backup_processes. Developer or build hosts that debug regularly can be handled with a per-client exclusion on principal.hostname. Review any hit where the writer is a shell, interpreter or a binary in /tmp, /dev/shm or /var/tmp."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/proc\/[0-9]+\/(task\/[0-9]+\/)?mem$/
    $file.principal.process.file.full_path != ""
    not $file.principal.process.file.full_path = /\/(gdb|gdbserver|lldb|lldb-server|strace|ltrace|rr|criu)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.008")
    $primary_entity = array_distinct($file.principal.hostname)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $target_mem_path = array_distinct($file.target.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
