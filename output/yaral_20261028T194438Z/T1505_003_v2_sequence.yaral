/*
  MITRE Technique : T1505.003 - Web Shell
  Tactic(s)       : Persistence
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:29:45.082215+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_003_WebShell_Inbound_Script_POST_Then_Outbound_Callback {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects the network footprint of a Linux web shell: an external client sends a successful POST to a server-side script (php, jsp, cgi, etc.) on an internal web server, and that same server then opens an outbound connection to an external address on a non-web port within 10 minutes. This pattern is consistent with web shell command execution followed by a reverse shell, tool download or C2 callback."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.003"
    mitre_technique_name = "Server Software Component: Web Shell"
    log_prerequisites = "Requires firewall, proxy or WAF logs normalised to NETWORK_HTTP (with URL, method and response code, e.g. from TLS-inspecting or reverse-proxy devices) and perimeter NETWORK_CONNECTION egress logs that include the internal server source IP."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Web applications that legitimately call external APIs, webhooks, payment gateways, SMTP relays or licensing servers on non-standard ports after a form POST; CMS plugin or update checks; monitoring or synthetic transaction tools that are not yet in the scanner list."
    tuning_guidance = "Add approved vulnerability scanners and testing sources to %global_allowed_scanners, known-good external destinations to %global_allowed_domains, and trusted management sources to %global_allowed_mgmt_sources. Extend the excluded outbound port list if a known application uses other standard ports. Narrow the script extension regex to match the frameworks in use."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = "POST"
    $http.network.http.response_code = 200
    $http.target.url = /\.(php[0-9]?|phtml|jsp|jspx|cgi|pl|py)(\?|$)/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources
    $http.target.ip = $server_ip

    $conn.metadata.event_type = "NETWORK_CONNECTION"
    not $conn.target.ip in %rfc1918_internal
    not $conn.target.hostname in %global_allowed_domains
    $conn.target.port != 80
    $conn.target.port != 443
    $conn.target.port != 53
    $conn.target.port != 123
    $conn.principal.ip = $server_ip

    $http.metadata.event_timestamp.seconds <= $conn.metadata.event_timestamp.seconds

  match:
    $server_ip over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1505.003")
    $primary_entity = array_distinct($server_ip)
    $attacker_ips = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)
    $callback_ips = array_distinct($conn.target.ip)
    $callback_ports = array_distinct($conn.target.port)
    $post_count = count($http.metadata.id)

  condition:
    $http and $conn
}
