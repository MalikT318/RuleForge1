/*
  MITRE Technique : T1602 - Data from Configuration Repository
  Tactic(s)       : Collection
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:17:05.336540+00:00
  Reference       : https://attack.mitre.org/techniques/T1602
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_Config_Repository_Protocol_From_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a firewall-observed connection from a non-internal source to a network-device configuration repository protocol: TFTP (69), SNMP (161) or Smart Install (4786). These services expose running configs, community strings and device inventory and should never be reachable from outside the management network. Variant 5 of 7: perimeter and flow telemetry on Network Devices, with no endpoint process fields."
    mitre_tactic = "Collection"
    mitre_technique = "T1602"
    mitre_technique_name = "Data from Configuration Repository"
    log_prerequisites = "Firewall or perimeter logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. Logs must include permitted traffic, not only denies."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Managed-service-provider or ISP monitoring platforms polling SNMP over the WAN, cloud-hosted network monitoring SaaS, authorised external vulnerability scans, remote-site TFTP firmware or config pushes via NAT, and Internet-wide scanners hitting exposed services (a finding in itself)."
    tuning_guidance = "Add approved monitoring, NMS and scanner source addresses to %global_allowed_mgmt_sources and %global_allowed_scanners. Make sure %rfc1918_internal covers all internal and VPN client ranges. If the firewall logs post-NAT addresses, review the source field mapping before enabling. Treat connections that were actually permitted as higher priority."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 69 or
      $net.target.port = 161 or
      $net.target.port = 4786
    )
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1602")
    $primary_entity = array_distinct($net.target.ip)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
